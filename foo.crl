struct foo {
    str boy;
    str girl;
    bool full;

    static foo new() {
        return foo {
            .boy = "gay",
            .girl = "gay gay",
            .full = true
        };
    }

    bool equals(foo other)
    {
        return self.boy == other.boy && self.girl == other.girl; 
    }
}

extend foo : @drop {
    void drop() {
        self.boy = "";
        self.girl = "";
    }
}


void main() {
    var c = foo::new();
    var d = foo::new();

    i32 a = 0;
    loop {
        if (c.equals(d)) break;
        if (a == 10) break;
    }
    d.full = false;
    
}