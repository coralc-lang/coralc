#[[no_drop_all]]
/* context/context.crl: AST context, arenas, interning, string ownership
 *
 * one place for everything the compiler allocates: interned strings,
 * uniqued types, AST nodes, plus a general `owned` list of pointers freed
 * at deinit. arenas grow geometrically (types/nodes via growStable so
 * cached entry pointers stay valid). index 0 of each arena is a reserved
 * sentinel (no type, no node, no string). Clang's ASTContext +
 * BumpPtrAllocator were the starting point; unlike that design this one
 * can grow.
 */

import std::mman { alloc, dealloc, realloc, zero };
import std::intrinsics { memcpy };
use ast {
    id { Str, SourceLoc, NodeId },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    decl { File, VariantVariant },
    stmt { SwitchCase }
};

pub struct InternEntry
{
    u8* ptr;
    usize len;
    u32 id;
    u32 hash;
}

/* one node of a type-index hash chain. `ty` is an index into the type
 * arena (the slot's content is what the verify reads, so a slot rewound
 * by a parser restore and reused is simply re-verified against its new
 * kind), `next` is an index into the same record array (0 = end, record
 * 0 is reserved as the nil node). */
pub struct TyIdxRec
{
    u32 ty;
    u32 next;
}

/* append-buffers for list-ish fields. append reallocs through ctx.grow;
 * Finish hands the block to ctx.track, and then the context owns it until
 * deinit (Finish deallocs it itself only when tracking fails). init just
 * clears. */
pub struct NodeListBuilder
{
    NodeId* data;
    u32 len;
    u32 cap;
}

pub struct StrListBuilder
{
    Str* data;
    u32 len;
    u32 cap;
}

pub struct TyListBuilder
{
    Ty* data;
    u32 len;
    u32 cap;
}

pub struct SwitchListBuilder
{
    SwitchCase* data;
    u32 len;
    u32 cap;
}

/* one `///` block captured by the parser, keyed to the declaration it
 * documents: fileId + the 1-based line of the decl's name. text is
 * interned, so it outlives the source buffer. */
pub struct DocBlock
{
    u32 fileId;
    u32 declLine;
    Str text;
}

pub struct VariantListBuilder
{
    VariantVariant* data;
    u32 len;
    u32 cap;
}

pub struct AstContext
{
    InternEntry* interns;
    u32 internsLen;
    u32 internsCap;
    u32* internIndex;
    u32 internIndexCap;
    TypeEntry* types;
    u32 typesLen;
    u32 typesCap;
    Node* nodes;
    u32 nodesLen;
    u32 nodesCap;
    rawptr* owned;
    u32 ownedLen;
    u32 ownedCap;
    u32 error;
    str targetArch;
    Str* flagNames;
    Str* flagValues;
    u32 flagsLen;
    DocBlock* docs;
    u32 docsLen;
    u32 docsCap;
    /* server (LSP) only: normal compiles never walk, intern, or store
     * doc comments — they are dropped with the rest of the comments */
    bool collectDocs;
    /* type-arena hash index (see the tyIdx* methods). buckets hash the
     * accessor-visible key — pure kinds by tag, Named by bare name,
     * Pointer/Const by base — and chains stay sorted ascending by ty so
     * the first live match equals what the old linear scans returned. */
    u32* tyIdxBuckets;
    u32 tyIdxCap;
    u32 tyIdxCount;
    TyIdxRec* tyIdxRecs;
    u32 tyIdxRecsLen;
    u32 tyIdxRecsCap;
    /* lazily interned builtin names: every namedType("str") /
     * ccharPtrType() used to re-intern its literal on every call */
    Str tyIdxStrLit;
    Str tyIdxCcharLit;
    Str tyIdxSliceLit;
    Str tyIdxRawptrLit;
    Str tyIdxSelfLit;

    void init(u32 internCap, u32 typeCap, u32 nodeCap)
    {
        // caps of 0 mean "don't preallocate; ensureX will grow on demand".
        // targetArch is resolved at compile time: x86_64 unless the build
        // was configured for arm64
        self = AstContext {
            .interns = null,
            .internsLen = 0,
            .internsCap = 0,
            .internIndex = null,
            .internIndexCap = 0,
            .types = null,
            .typesLen = 0,
            .typesCap = 0,
            .nodes = null,
            .nodesLen = 0,
            .nodesCap = 0,
            .owned = null,
            .ownedLen = 0,
            .ownedCap = 0,
            .error = 0,
            .targetArch = flag (arch) { x86_64 => { "x86_64" }, arm64 => { "arm64" }, else => { "x86_64" } },
            .flagNames = null,
            .flagValues = null,
            .flagsLen = 0,
            .docs = null,
            .docsLen = 0,
            .docsCap = 0,
            .collectDocs = false,
            .tyIdxBuckets = null,
            .tyIdxCap = 0,
            .tyIdxCount = 0,
            .tyIdxRecs = null,
            .tyIdxRecsLen = 0,
            .tyIdxRecsCap = 0,
            .tyIdxStrLit = 0,
            .tyIdxCcharLit = 0,
            .tyIdxSliceLit = 0,
            .tyIdxRawptrLit = 0,
            .tyIdxSelfLit = 0
        };

        if (internCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(internCap, @sizeof(InternEntry), &bytes))
            {
                self.interns = (InternEntry*)alloc<u8>(bytes);
                if (self.interns != null)
                {
                    zero<u8>((u8*)self.interns, bytes);
                    self.internsCap = internCap;
                    self.internsLen = 1;
                }
                else
                {
                    self.setError();
                }
            }
        }
        if (typeCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(typeCap, @sizeof(TypeEntry), &bytes))
            {
                self.types = (TypeEntry*)alloc<u8>(bytes);
                if (self.types != null) {
                    zero<u8>((u8*)self.types, bytes);
                    self.typesCap = typeCap;
                    self.typesLen = 1;
                }
                else {
                    self.setError();
                }
            }
        }
        if (nodeCap > 0)
        {
            usize bytes = 0;
            if (self.byteCount(nodeCap, @sizeof(Node), &bytes))
            {
                self.nodes = (Node*)alloc<u8>(bytes);
                if (self.nodes != null) {
                    zero<u8>((u8*)self.nodes, bytes);
                    self.nodesCap = nodeCap;
                    self.nodesLen = 1;
                }
                else {
                    self.setError();
                }
            }
        }
    }

    void deinit()
    {
        // every tracked pointer dies here, then the arenas themselves
        u32 i = 0;
        while (i < self.ownedLen)
        {
            if (self.owned[i] != null) dealloc<u8>((u8*)self.owned[i]);
            i++;
        }
        if (self.owned != null) dealloc<rawptr>(self.owned);
        if (self.interns != null) dealloc<InternEntry>(self.interns);
        if (self.internIndex != null) dealloc<u32>(self.internIndex);
        if (self.types != null) dealloc<TypeEntry>(self.types);
        if (self.nodes != null) dealloc<Node>(self.nodes);
        if (self.tyIdxBuckets != null) dealloc<u32>(self.tyIdxBuckets);
        if (self.tyIdxRecs != null) dealloc<TyIdxRec>(self.tyIdxRecs);
        
        self.interns = null;
        self.internsLen = 0;
        self.internsCap = 0;
        self.internIndex = null;
        self.internIndexCap = 0;
        self.types = null;
        self.typesLen = 0;
        self.typesCap = 0;
        self.nodes = null;
        self.nodesLen = 0;
        self.nodesCap = 0;
        self.tyIdxBuckets = null;
        self.tyIdxCap = 0;
        self.tyIdxCount = 0;
        self.tyIdxRecs = null;
        self.tyIdxRecsLen = 0;
        self.tyIdxRecsCap = 0;
        self.owned = null;
        self.ownedLen = 0;
        self.ownedCap = 0;
        self.error = 0;
    }

    /* ── type-arena hash index ─────────────────────────────────────────
     * find-by-scan accessors (boolType, namedType, slicePtrType, the
     * parser's internKind, ...) all ask "first entry matching this exact
     * shape". the index answers in O(1) with the same first-wins result:
     * chains hold ty values sorted ascending, verification is the query
     * predicate itself (range: t < typesLen — a slot rewound past
     * typesLen by a parser restore is dead and skipped), and a miss
     * falls back to the caller's original linear scan, which stays the
     * ground truth for anything the index does not cover. */

    bool tyIdxIdxable(TypeKind k)
    {
        if (k.tag == TypeKind::Named) return true;
        if (k.tag == TypeKind::Pointer) return true;
        if (k.tag == TypeKind::Const) return true;
        u32 t = (u32)k.tag;
        return t == (u32)TypeKind::Error || t == (u32)TypeKind::Void ||
               t == (u32)TypeKind::Bool || t == (u32)TypeKind::Char ||
               t == (u32)TypeKind::I8 || t == (u32)TypeKind::U8 ||
               t == (u32)TypeKind::I16 || t == (u32)TypeKind::U16 ||
               t == (u32)TypeKind::I32 || t == (u32)TypeKind::U32 ||
               t == (u32)TypeKind::I64 || t == (u32)TypeKind::U64 ||
               t == (u32)TypeKind::I128 || t == (u32)TypeKind::U128 ||
               t == (u32)TypeKind::F32 || t == (u32)TypeKind::F64 ||
               t == (u32)TypeKind::Isize || t == (u32)TypeKind::Usize ||
               t == (u32)TypeKind::Rawptr || t == (u32)TypeKind::Str;
    }

    u32 tyIdxHash(TypeKind k)
    {
        /* pure kinds carry an uninitialized payload in callers like
         * internKind (`TypeKind k; k.tag = ...`) — hash only the fields
         * each shape actually compares */
        u32 h = 2166136261;
        h = (h ^ (u32)k.tag) * 16777619;
        if (k.tag == TypeKind::Named) h = (h ^ k.payload.Named.name) * 16777619;
        else if (k.tag == TypeKind::Pointer) h = (h ^ k.payload.Pointer.base) * 16777619;
        else if (k.tag == TypeKind::Const) h = (h ^ k.payload.Const.base) * 16777619;
        return h;
    }

    bool tyIdxEq(TypeKind q, TypeKind e)
    {
        if (q.tag != e.tag) return false;
        if (q.tag == TypeKind::Named) return q.payload.Named.name == e.payload.Named.name;
        if (q.tag == TypeKind::Pointer) return q.payload.Pointer.base == e.payload.Pointer.base;
        if (q.tag == TypeKind::Const) return q.payload.Const.base == e.payload.Const.base;
        return true; /* pure: tag equality already held */
    }

    bool tyIdxEnsureRecs()
    {
        if (self.tyIdxRecsLen < self.tyIdxRecsCap) return true;
        u32 newCap = self.tyIdxRecsCap * 2;
        if (newCap == 0) newCap = 1024;
        TyIdxRec* raw = realloc<TyIdxRec>(self.tyIdxRecs, (usize)newCap);
        if (raw == null) return false;
        self.tyIdxRecs = raw;
        self.tyIdxRecsCap = newCap;
        if (self.tyIdxRecsLen == 0)
        {
            /* reserve record 0 as the chain terminator */
            self.tyIdxRecs[0].ty = 0;
            self.tyIdxRecs[0].next = 0;
            self.tyIdxRecsLen = 1;
        }
        return true;
    }

    bool tyIdxGrowBuckets()
    {
        u32 newCap = self.tyIdxCap * 2;
        if (newCap == 0) newCap = 1024;
        usize bytes = 0;
        if (!self.byteCount(newCap, @sizeof(u32), &bytes)) return false;
        u32* nb = (u32*)alloc<u8>(bytes);
        if (nb == null) return false;
        zero<u32>(nb, (usize)newCap);
        u32* ob = self.tyIdxBuckets;
        self.tyIdxBuckets = nb;
        self.tyIdxCap = newCap;
        if (ob != null) dealloc<u32>(ob);
        /* re-bucket every record against its slot's current kind, keeping
         * each chain sorted ascending by ty (chains are short; this runs
         * only when the bucket array doubles) */
        u32 r = 1;
        while (r < self.tyIdxRecsLen)
        {
            Ty t = self.tyIdxRecs[r].ty;
            if (t != 0 && t < self.typesCap)
            {
                u32 bi = self.tyIdxHash(self.types[t].kind) & (newCap - 1);
                u32 prev = 0;
                u32 cur = nb[bi];
                while (cur != 0 && self.tyIdxRecs[cur].ty < t)
                {
                    prev = cur;
                    cur = self.tyIdxRecs[cur].next;
                }
                if (!(cur != 0 && self.tyIdxRecs[cur].ty == t))
                {
                    self.tyIdxRecs[r].next = cur;
                    if (prev == 0) nb[bi] = r;
                    else self.tyIdxRecs[prev].next = r;
                }
                else
                {
                    /* duplicate record for the same slot: drop it from the
                     * rebuilt chains (r keeps a dead next; harmless) */
                    self.tyIdxRecs[r].next = 0;
                }
            }
            r++;
        }
        return true;
    }

    void tyIdxInsert(TypeKind q, Ty t)
    {
        /* only link records that actually match their own key: a tag-only
         * scan hit whose payload differs (e.g. a hypothetical non-pure
         * internKind call) must stay on the caller's scan path instead of
         * entering a chain where eq would never confirm it */
        if (t == 0 || t >= self.typesLen || !self.tyIdxIdxable(q)) return;
        if (!self.tyIdxEq(q, self.types[t].kind)) return;
        if (self.tyIdxBuckets == null)
        {
            if (!self.tyIdxGrowBuckets()) return;
        }
        else if (self.tyIdxCount >= self.tyIdxCap)
        {
            if (!self.tyIdxGrowBuckets()) return;
        }
        if (!self.tyIdxEnsureRecs()) return;
        u32 bi = self.tyIdxHash(q) & (self.tyIdxCap - 1);
        u32 prev = 0;
        u32 cur = self.tyIdxBuckets[bi];
        while (cur != 0 && self.tyIdxRecs[cur].ty < t)
        {
            prev = cur;
            cur = self.tyIdxRecs[cur].next;
        }
        if (cur != 0 && self.tyIdxRecs[cur].ty == t) return; /* already linked */
        u32 nr = self.tyIdxRecsLen;
        self.tyIdxRecs[nr].ty = t;
        self.tyIdxRecs[nr].next = cur;
        if (prev == 0) self.tyIdxBuckets[bi] = nr;
        else self.tyIdxRecs[prev].next = nr;
        self.tyIdxRecsLen++;
        self.tyIdxCount++;
    }

    /* first live entry structurally matching q (pure: tag, Named: name,
     * Pointer/Const: base), or 0 — callers fall back to their scan */
    Ty tyIdxFind(TypeKind q)
    {
        if (self.tyIdxBuckets == null || !self.tyIdxIdxable(q)) return 0;
        u32 bi = self.tyIdxHash(q) & (self.tyIdxCap - 1);
        u32 r = self.tyIdxBuckets[bi];
        while (r != 0)
        {
            Ty t = self.tyIdxRecs[r].ty;
            if (t < self.typesLen && self.tyIdxEq(q, self.types[t].kind)) return t;
            r = self.tyIdxRecs[r].next;
        }
        return 0;
    }

    /* namedType matches by bare name (args ignored — the documented
     * "first Named wins" quirk); ccharPtr additionally requires a bare
     * (argsLen == 0) entry. both walk the same name-keyed chain. */
    Ty tyIdxFindNamed(Str name, bool bareOnly)
    {
        if (self.tyIdxBuckets == null || name == 0) return 0;
        TypeKind q;
        q.tag = TypeKind::Named;
        q.payload.Named.name = name;
        q.payload.Named.genericArgs = null;
        q.payload.Named.genericArgsLen = 0;
        u32 bi = self.tyIdxHash(q) & (self.tyIdxCap - 1);
        u32 r = self.tyIdxBuckets[bi];
        while (r != 0)
        {
            Ty t = self.tyIdxRecs[r].ty;
            if (t < self.typesLen)
            {
                TypeEntry* e = self.types + t;
                if (e->kind.tag == (i32)TypeKind::Named &&
                    e->kind.payload.Named.name == name)
                {
                    if (!bareOnly || e->kind.payload.Named.genericArgsLen == 0)
                        return t;
                }
            }
            r = self.tyIdxRecs[r].next;
        }
        return 0;
    }

    Str tyIdxStrLit()
    {
        if (self.tyIdxStrLit == 0) self.tyIdxStrLit = self.intern("str");
        return self.tyIdxStrLit;
    }

    Str tyIdxCcharLit()
    {
        if (self.tyIdxCcharLit == 0) self.tyIdxCcharLit = self.intern("cchar");
        return self.tyIdxCcharLit;
    }

    /* builtin type/local names whose ids are recalculated in hot paths */
    Str tyIdxSliceLit2()
    {
        if (self.tyIdxSliceLit == 0) self.tyIdxSliceLit = self.intern("slice");
        return self.tyIdxSliceLit;
    }

    Str tyIdxRawptrLit2()
    {
        if (self.tyIdxRawptrLit == 0) self.tyIdxRawptrLit = self.intern("rawptr");
        return self.tyIdxRawptrLit;
    }

    Str tyIdxSelfLit2()
    {
        if (self.tyIdxSelfLit == 0) self.tyIdxSelfLit = self.intern("self");
        return self.tyIdxSelfLit;
    }

    bool streq(str a, str b)
    {
        if (a.len != b.len) return false;
        if (a.len == 0) return true;
        if (a.ptr == null || b.ptr == null) return false;
        usize i = 0;
        while (i < a.len)
        {
            if (a.ptr[i] != b.ptr[i]) return false;
            i++;
        }
        return true;
    }

    // sticky: once set, allocators short-circuit and intern/alloc return 0
    void setError()
    {
        self.error = 1;
    }

    bool hasError()
    {
        return self.error != 0;
    }

    // overflow guard: multiplication that would wrap instead sets error
    bool byteCount(u32 count, usize elementSize, usize* bytes)
    {
        usize maxSize = (usize)0 - 1;
        if (elementSize == 0 || (usize)count > maxSize / elementSize)
        {
            self.setError();
            return false;
        }
        *bytes = (usize)count * elementSize;
        return true;
    }

    /* plain moving (or in-place) realloc, cap doubling. only for buffers
     * nobody holds interior pointers into: owned, interns, builder arrays.
     * types/nodes go through growStable instead */
    rawptr grow(rawptr data, u32 oldCap, u32* newCap, usize elementSize)
    {
        if (self.error != 0) return null;
        u32 nextCap = 4;
        if (oldCap != 0)
        {
            if (oldCap > 2147483647)
            {
                self.setError();
                return null;
            }
            nextCap = oldCap * 2;
            if (nextCap <= oldCap)
            {
                self.setError();
                return null;
            }
        }
        usize bytes = 0;
        if (!self.byteCount(nextCap, elementSize, &bytes)) return null;
        rawptr result = realloc<u8>((u8*)data, bytes);
        if (result == null)
        {
            self.setError();
            return null;
        }
        *newCap = nextCap;
        return result;
    }

    /* ensureX: bring an arena up if init didn't preallocate it, and plant
     * the index-0 sentinel. growX: only called when len == cap */
    bool ensureInterns()
    {
        if (self.error != 0) return false;
        if (self.interns == null || self.internsCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.interns, self.internsCap, &newCap, @sizeof(InternEntry));
            if (raw == null) return false;
            self.interns = (InternEntry*)raw;
            self.internsCap = newCap;
        }
        if (self.internsLen == 0)
        {
            self.interns[0].ptr = null;
            self.interns[0].len = 0;
            self.interns[0].id = 0;
            self.interns[0].hash = 0;
            self.internsLen = 1;
        }
        return true;
    }

    bool ensureTypes()
    {
        if (self.error != 0) return false;
        if (self.types == null || self.typesCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.types, self.typesCap, &newCap, @sizeof(TypeEntry));
            if (raw == null) return false;
            self.types = (TypeEntry*)raw;
            self.typesCap = newCap;
        }
        if (self.typesLen == 0)
        {
            self.types[0].kind.tag = TypeKind::Error;
            self.types[0].loc.data = 0;
            self.typesLen = 1;
        }
        return true;
    }

    bool ensureNodes()
    {
        if (self.error != 0) return false;
        if (self.nodes == null || self.nodesCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.nodes, self.nodesCap, &newCap, @sizeof(Node));
            if (raw == null) return false;
            self.nodes = (Node*)raw;
            self.nodesCap = newCap;
        }
        if (self.nodesLen == 0)
        {
            self.nodes[0].kind.tag = NodeKind::Invalid;
            self.nodes[0].kind.payload.Invalid.flags = 0;
            self.nodes[0].loc.data = 0;
            self.nodesLen = 1;
        }
        return true;
    }

    bool ensureOwned()
    {
        if (self.error != 0) return false;
        if (self.owned == null || self.ownedCap == 0)
        {
            u32 newCap = 0;
            rawptr raw = self.grow((rawptr)self.owned, self.ownedCap, &newCap, @sizeof(rawptr));
            if (raw == null) return false;
            self.owned = (rawptr*)raw;
            self.ownedCap = newCap;
        }
        return true;
    }

    bool growInterns()
    {
        if (self.internsLen < self.internsCap) return true;
        u32 newCap = self.internsCap;
        rawptr raw = self.grow((rawptr)self.interns, self.internsCap, &newCap, @sizeof(InternEntry));
        if (raw == null) return false;
        self.interns = (InternEntry*)raw;
        self.internsCap = newCap;
        return true;
    }

    bool growTypes()
    {
        if (self.typesLen < self.typesCap) return true;
        u32 newCap = self.typesCap;
        rawptr raw = self.growStable((rawptr)self.types, self.typesCap, &newCap, @sizeof(TypeEntry));
        if (raw == null) return false;
        self.types = (TypeEntry*)raw;
        self.typesCap = newCap;
        return true;
    }

    bool growNodes()
    {
        if (self.nodesLen < self.nodesCap) return true;
        u32 newCap = self.nodesCap;
        rawptr raw = self.growStable((rawptr)self.nodes, self.nodesCap, &newCap, @sizeof(Node));
        if (raw == null) return false;
        self.nodes = (Node*)raw;
        self.nodesCap = newCap;
        return true;
    }

    /* grow, but into a fresh block with the old one left allocated (not
     * freed). Node and TypeEntry pointers are cached in locals all over
     * the evaluator; a moving realloc mid-evaluation leaves those stale
     * reads dangling the moment a nested instantiation grows the arena.
     * Keeping the old block alive (geometric growth, so under 2x waste
     * total) keeps stale pointers valid and content-identical. */
    rawptr growStable(rawptr data, u32 oldCap, u32* newCap, usize elementSize)
    {
        if (self.error != 0) return null;
        u32 nextCap = 4;
        if (oldCap != 0)
        {
            if (oldCap > 2147483647)
            {
                self.setError();
                return null;
            }
            nextCap = oldCap * 2;
            if (nextCap <= oldCap)
            {
                self.setError();
                return null;
            }
        }
        usize bytes = 0;
        if (!self.byteCount(nextCap, elementSize, &bytes)) return null;
        rawptr result = alloc<u8>(bytes);
        if (result == null)
        {
            self.setError();
            return null;
        }
        if (data != null && oldCap != 0)
        {
            usize oldBytes = 0;
            if (self.byteCount(oldCap, elementSize, &oldBytes))
                memcpy(result, data, oldBytes);
        }
        if (data != null && oldCap != 0)
        {
            /* stale-pointer safety keeps the old block alive for the rest
             * of the compile; deinit frees it through the owned list */
            self.track(data);
        }
        *newCap = nextCap;
        return result;
    }

    u32 hashStr(str s)
    {
        u32 h = 2166136261;
        usize i = 0;
        while (i < s.len)
        {
            h = (h ^ (u32)s.ptr[i]) * 16777619;
            i++;
        }
        return h;
    }

    /* compare an intern id against a precomputed FNV-1a 32 of the
     * literal — one load instead of re-hashing + probing the literal
     * through intern(). the hash constants live next to each call site
     * as  FNV("…") * so a hash-function change is grep-able. */
    pub bool internEqHash(Str id, u32 hash)
    {
        if (id == 0 || id >= self.internsLen) return false;
        return self.interns[id].hash == hash;
    }

    pub bool internEqHashLen(Str id, u32 hash, u32 len)
    {
        if (id == 0 || id >= self.internsLen) return false;
        InternEntry* e = self.interns + id;
        return e->hash == hash && (u32)e->len == len;
    }

    bool growInternIndex()
    {
        if (self.error != 0) return false;
        u32 oldCap = self.internIndexCap;
        u32 newCap = oldCap == 0 ? 16 : oldCap * 2;
        if (newCap <= oldCap)
        {
            self.setError();
            return false;
        }
        usize bytes = 0;
        if (!self.byteCount(newCap, @sizeof(u32), &bytes)) return false;
        u32* idx = (u32*)alloc<u8>(bytes);
        if (idx == null)
        {
            self.setError();
            return false;
        }
        zero<u8>((u8*)idx, bytes);

        u32 i = 1;
        u32 mask = newCap - 1;
        while (i < self.internsLen)
        {
            InternEntry* e = self.interns + i;
            u32 slot = e->hash & mask;
            while (idx[slot] != 0) slot = (slot + 1) & mask;
            idx[slot] = e->id;
            i++;
        }
        if (self.internIndex != null) dealloc<u32>(self.internIndex);
        self.internIndex = idx;
        self.internIndexCap = newCap;
        return true;
    }

    bool ensureInternIndex()
    {
        if (self.internIndex != null && self.internIndexCap != 0) return true;
        return self.growInternIndex();
    }

    /* id for a byte string; 0 means empty input or a failed context.
     * open-addressed index keeps lookup O(1) instead of scanning the
     * entire intern table for every identifier. */
    u32 intern(str s)
    {
        if (s.len == 0 || s.ptr == null) return 0;
        if (self.error != 0) return 0;
        if (!self.ensureInterns()) return 0;
        if (!self.ensureInternIndex()) return 0;

        u32 h = self.hashStr(s);
        u32 mask = self.internIndexCap - 1;
        u32 slot = h & mask;
        while (true)
        {
            u32 id = self.internIndex[slot];
            if (id == 0) break;
            InternEntry* e = self.interns + id;
            if (e->hash == h && e->len == s.len &&
                self.streq(str { .ptr = e->ptr, .len = e->len }, s))
            {
                return e->id;
            }
            slot = (slot + 1) & mask;
        }

        if (!self.growInterns()) return 0;
        if (self.internsLen == 4294967295) {
            self.setError();
            return 0;
        }
        if ((usize)(self.internsLen + 1) * 4 > (usize)self.internIndexCap * 3)
        {
            if (!self.growInternIndex()) return 0;
            mask = self.internIndexCap - 1;
        }
        /* copy the bytes: callers free their buffers after parsing
         * (lib loader candidate paths) while entries live as long as
         * the context, so the table must own its strings */
        u8* copy = alloc<u8>(s.len + 1);
        if (copy == null)
        {
            self.setError();
            return 0;
        }
        usize ci = 0;
        while (ci < s.len) { copy[ci] = s.ptr[ci]; ci++; }
        copy[s.len] = 0;
        if (!self.track((rawptr)copy))
        {
            dealloc<u8>(copy);
            return 0;
        }
        InternEntry* e = self.interns + self.internsLen;
        e->ptr = copy;
        e->len = s.len;
        e->id = self.internsLen;
        e->hash = h;
        self.internsLen++;

        slot = h & mask;
        while (self.internIndex[slot] != 0) slot = (slot + 1) & mask;
        self.internIndex[slot] = e->id;
        return e->id;
    }

    /* parser hook: remember the `///` block above a declaration whose
     * name is on `declLine` (1-based, within fileId). text is interned by
     * the caller. re-parses of the same line overwrite (speculation). */
    u64 docKey(u32 fileId, u32 declLine)
    {
        return ((u64)fileId << 32) | (u64)declLine;
    }

    void addDocBlock(u32 fileId, u32 declLine, Str text)
    {
        if (text == 0 || self.error != 0) return;
        u64 key = self.docKey(fileId, declLine);
        u32 lo = 0;
        u32 hi = self.docsLen;
        while (lo < hi)
        {
            u32 mid = lo + (hi - lo) / 2;
            u64 midKey = self.docKey(self.docs[mid].fileId, self.docs[mid].declLine);
            if (midKey < key) lo = mid + 1;
            else hi = mid;
        }
        if (lo < self.docsLen)
        {
            u64 atKey = self.docKey(self.docs[lo].fileId, self.docs[lo].declLine);
            if (atKey == key)
            {
                self.docs[lo].text = text;
                return;
            }
        }
        if (self.docs == null || self.docsLen >= self.docsCap)
        {
            u32 newCap = self.docsCap;
            rawptr raw = self.grow((rawptr)self.docs, self.docsCap, &newCap, @sizeof(DocBlock));
            if (raw == null) return;
            self.docs = (DocBlock*)raw;
            self.docsCap = newCap;
        }
        u32 i = self.docsLen;
        while (i > lo)
        {
            self.docs[i] = self.docs[i - 1];
            i--;
        }
        self.docs[lo].fileId = fileId;
        self.docs[lo].declLine = declLine;
        self.docs[lo].text = text;
        self.docsLen++;
    }

    /* interned text of the `///` block above the decl whose name is on
     * `declLine`; 0 when the declaration carries no docs */
    Str docFor(u32 fileId, u32 declLine)
    {
        u64 key = self.docKey(fileId, declLine);
        u32 lo = 0;
        u32 hi = self.docsLen;
        while (lo < hi)
        {
            u32 mid = lo + (hi - lo) / 2;
            u64 midKey = self.docKey(self.docs[mid].fileId, self.docs[mid].declLine);
            if (midKey < key) lo = mid + 1;
            else hi = mid;
        }
        if (lo < self.docsLen)
        {
            if (self.docKey(self.docs[lo].fileId, self.docs[lo].declLine) == key)
                return self.docs[lo].text;
        }
        return 0;
    }

    // remember a pointer for deinit to free; nulls are ignored
    bool track(rawptr ptr)
    {
        if (ptr == null) return true;
        if (self.error != 0) return false;
        if (!self.ensureOwned()) return false;
        if (self.ownedLen >= self.ownedCap)
        {
            u32 newCap = self.ownedCap;
            rawptr raw = self.grow((rawptr)self.owned, self.ownedCap, &newCap, @sizeof(rawptr));
            if (raw == null) return false;
            self.owned = (rawptr*)raw;
            self.ownedCap = newCap;
        }
        self.owned[self.ownedLen] = ptr;
        self.ownedLen++;
        return true;
    }

    void nodeListInit(NodeListBuilder* b)
    {
        b->data = null;
        b->len = 0;
        b->cap = 0;
    }

    bool nodeListAppend(NodeListBuilder* b, NodeId value)
    {
        if (self.error != 0) return false;
        if (b->len >= b->cap)
        {
            u32 newCap = b->cap;
            rawptr raw = self.grow((rawptr)b->data, b->cap, &newCap, @sizeof(NodeId));
            if (raw == null) return false;
            b->data = (NodeId*)raw;
            b->cap = newCap;
        }
        b->data[b->len] = value;
        b->len++;
        return true;
    }

    NodeId* nodeListFinish(NodeListBuilder* b)
    {
        NodeId* result = b->data;
        b->data = null;
        b->len = 0;
        b->cap = 0;
        if (result != null && !self.track((rawptr)result))
        {
            dealloc<NodeId>(result);
            return null;
        }
        return result;
    }

