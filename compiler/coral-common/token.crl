#[[no_drop_all]]
// common/token.crl: Token, TokenKind, IdentifierInfo
//
// TokenKind is the lexer's full vocabulary: literals, keywords, builtin
// types, operators, separators. the stray numeric comments inside it mark
// groups of same-length names (2-char keywords, 3-char keywords, …) from
// whoever first sorted the list; they are not values. Unknown is a real
// kind; Eof is the only sentinel.

import slice { Slice };

pub enum TokenKind
{
    Eof,
    Ident,
    
    // literals
    Dec,
    Hex,
    Bin,
    Oct,          // 3
    True,
    Null,
    Float,
    False,
    String,
    CString,       // C"..." C style string, null-terminated, no len
    CharLit,
    RawString,
    

    // keywords
    If,            // 2
    As,
    
    Mod,           // 3
    Pub,
    For,
    Asm,
    Var,

    Enum,          // 4
    Else,
    Loop,
    Flag,
    Self,

    While,         // 5
    Trait,
    Any,
    Const,
    Defer,
    Break,
    Union,

    Import,        // 6
    Static,
    Struct,
    Extern,
    Switch,
    Return,
    Extend,

    Typedef,
    Variant,

    // builtin types
    Void,
    Bool,
    Char,
    U8,
    I8,
    U16,
    I16,
    U32,
    I32,
    U64,
    I64,
    U128,
    I128, // these will be hidden behind a flag or not, but not all pltfroms support them
    F32,
    F64,
    Usize,
    Isize,
    Rawptr,
    Str,

    Distinct,     // 8
    Continue,
    Comptime,
    Volatile,

    // operators
    Plus,           // + // single char operators
    Minus,          // -
    Star,           // *
    Slash,          // /
    Percent,        // %
    Less,           // <
    Greater,        // >
    Neg,            // ~
    Not,            // !
    Colon,          // :
    Semicolon,      // ;
    Comma,          // ,
    Hash,           // #
    Dot,            // .
    Ampersand,      // &
    Caret,          // ^
    Pipe,           // |

    Equal,          // = // assign

    PlusEqual,      // +=  // compound(assigned)
    MinusEqual,     // -=
    StarEqual,      // *=
    SlashEqual,     // /=
    PercentEqual,   // %=
    EqualEqual,     // ==
    NotEqual,       // !=
    LessEqual,      // <=
    GreaterEqual,   // >=
    PipeEqual,      // |=
    CaretEqual,     // ^=
    AmpEqual,       // &=
    NegEqual,       // ~=
    ShlEqual,       // <<=
    ShrEqual,       // >>=

    FatArrow,       // => // compound(other)
    ColonColon,     // ::
    PlusPlus,       // ++
    MinusMinus,     // --
    And,            // &&
    Or,             // ||
    Shl,            // <<
    Shr,            // >>
    Arrow,          // ->
    Ellipsis,       // ...

    // separators
    LParen,         // (
    RParen,         // )
    LBrace,         // {
    RBrace,         // }
    LBracket,       // [
    RBracket,       // ]

    // builtin identifier
    BuiltinSizeof,
    BuiltinAssert,
    BuiltinAlignof,
    BuiltinTypeof,
    BuiltinAssertOut,

    At,             // @
    Question,       // ?
    Unknown         // invalid token (not Eof)
}

pub struct Token
{
    usize col;
    usize line;
    Slice data;      // the exact bytes; strings keep their quotes+escapes
    u64 number;
    TokenKind kind;
    IdentifierInfo* info;
    u8 numFlags;    // bit0 unsigned (255u), bit1 float (3.14f); bit2 marks
                    // long but nothing downstream reads it
}

pub struct IdentifierInfo
{
    str name;       // a view into the source buffer, never owned
    TokenKind kind;
    bool isKeyword;
}