#[[no_drop_all]]
// common/slice.crl: a borrowed view over bytes {ptr, len}
//
// no ownership anywhere: whoever handed you the pointer keeps it alive.
// `str` is the same thing; fromStr/asStr convert without copying

pub struct Slice
{
    u8* ptr;
    usize len;

    static Slice from(u8* p, usize len)
    {
        return Slice {
            .ptr = p,
            .len = len
        };
    }

    static Slice fromStr(str a)
    {
        return Slice {
            .ptr = a.ptr,
            .len = a.len
        };
    } 

    str asStr()
    {
        return str { .ptr = self.ptr, .len = self.len };
    }

    bool eq(Slice b) // may need to add some optimization hints later
    {
        if (self.len != b.len) return false;
        for (usize i = 0; i < self.len; i++) {
            if (self.ptr[i] != b.ptr[i]) return false; 
        }
        return true;
    }
}