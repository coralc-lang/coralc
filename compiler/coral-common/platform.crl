#[[no_drop_all]]
// Compile-time host platform, baked into the compiler when it is built.
// The build passes --flag {host=windows,arch=...} on Windows; the else
// arm keeps older bootstrap seeds and Linux builds on x86_64/linux.
// This is only the DEFAULT for std selection: a user can override it at
// compile time with --platform or --flag {platform=...}.

pub str hostOs()
{
    return flag (host) {
        windows => "windows",
        else => "linux",
    };
}

pub str hostArch()
{
    return flag (arch) {
        arm64 => "arm64",
        else => "x86_64",
    };
}
