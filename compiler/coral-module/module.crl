#[[no_drop_all]]
/* module/module.crl: module resolution for 3 use forms
 *
 * Per reason.crl spec:
 *   A. Local path:  use src/math/core.crl { square };
 *   B. Root use: use file::math::core { square };
 *   C. Global lib:  use std::math { pow };
 *
 * Re-exports:
 *   mod m = use path;
 *   pub mod m = use manifest::path;
 */

use ast::id { Str };
import std::mman { alloc, dealloc, zero };

pub struct ModuleId { u32 index; }

pub struct ModuleEntry
{
    Str path;
    Str manifest;
    u8 kind;
}

pub struct ModuleMap
{
    ModuleEntry* entries;
    u32 entriesLen;
    u32 entriesCap;
}

extend ModuleMap
{
    void init(u32 cap)
    {
        self.entries = null;
        self.entriesLen = 0;
        self.entriesCap = 0;
        if (cap == 0) return;
        self.entries = alloc<ModuleEntry>((usize)cap);
        if (self.entries != null)
        {
            zero<ModuleEntry>(self.entries, (usize)cap);
            self.entriesCap = cap;
            self.entriesLen = 1;
        }
    }

    void deinit()
    {
        if (self.entries != null) dealloc<ModuleEntry>(self.entries);
        self.entries = null;
        self.entriesLen = 0;
        self.entriesCap = 0;
    }

    ModuleId add(Str path, Str manifest, u8 kind)
    {
        ModuleId none;
        none.index = 0;
        if (self.entries == null || self.entriesLen == 0 || self.entriesLen >= self.entriesCap)
            return none;
        ModuleEntry* entry = self.entries + self.entriesLen;
        entry->path = path;
        entry->manifest = manifest;
        entry->kind = kind;
        ModuleId id;
        id.index = self.entriesLen;
        self.entriesLen++;
        return id;
    }

    ModuleId resolvePath(Str path)
    {
        u32 i = 1;
        while (i < self.entriesLen)
        {
            ModuleEntry* e = self.entries + i;
            if (e->path == path)
            {
                ModuleId m;
                m.index = i;
                return m;
            }
            i++;
        }
        ModuleId none;
        none.index = 0;
        return none;
    }

    ModuleId resolveLib(Str manifest)
    {
        u32 i = 1;
        while (i < self.entriesLen)
        {
            ModuleEntry* e = self.entries + i;
            if (e->manifest == manifest)
            {
                ModuleId m;
                m.index = i;
                return m;
            }
            i++;
        }
        ModuleId none;
        none.index = 0;
        return none;
    }

    bool isResolved(ModuleId m) { return m.index != 0; }
}
