#[[no_drop_all]]
/* diagnostics/engine.crl: diagnostic engine
 *
 * Owns the file table (file id -> path + buffer) and the error counters.
 * Every diagnostic funnels through error.crl, which owns the formatting.
 * Call sites report a stable ErrorCode + SourceLoc + message + optional
 * help line; the engine resolves the location against the right file.
 */

import std::mman { alloc, dealloc, realloc };
import std::vec { Vec };
import std::string { String };
import platform::libc { write };
use code { ErrorCode, codeStr, FixClass, fixClassFor };
use error { render, RenderInput, DiagLine };
use ast::id { SourceLoc, locFile, locLine, locCol };

/* structured copy of one diagnostic, for consumers that are not the
 * terminal (LSP publishDiagnostics). positions are 1-based byte
 * line/column; endCol is one past the last byte of the highlighted word
 * (col + 1 when the position is not on a word). */
pub struct DiagRecord
{
    String code;
    String level;
    String message;
    String file;
    String lineText;
    String help;
    u32 line;
    u32 col;
    u32 endCol;

    void dispose()
    {
        self.code.free();
        self.level.free();
        self.message.free();
        self.file.free();
        self.lineText.free();
        self.help.free();
    }
}

/* owning list of records; no drop trait on purpose — ownership moves
 * explicitly between engine and caller via moveRecordsTo/dispose */
pub struct DiagList
{
    DiagRecord* items;
    u32 len;
    u32 cap;

    void init()
    {
        self.items = null;
        self.len = 0;
        self.cap = 0;
    }

    void push(DiagRecord r)
    {
        if (self.len >= self.cap)
        {
            u32 nc = self.cap > 0 ? self.cap * 2 : 16;
            self.items = realloc<DiagRecord>(self.items, (usize)nc);
            self.cap = nc;
        }
        self.items[self.len] = r;
        self.len++;
    }

    void dispose()
    {
        u32 i = 0;
        while (i < self.len)
        {
            DiagRecord* it = self.items + i;
            it->dispose();
            i++;
        }
        dealloc<DiagRecord>(self.items);
        self.items = null;
        self.len = 0;
        self.cap = 0;
    }
}

u32 recordEndCol(str lineText, u32 col)
{
    if (col == 0) return 0;
    usize i = (usize)(col - 1);
    usize start = i;
    while (i < lineText.len)
    {
        u8 c = lineText.ptr[i];
        bool word = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
        if (!word) break;
        i++;
    }
    if (i == start) return col + 1;
    return (u32)i + 1;
}

pub struct DiagnosticEngine
{
    usize errors;
    usize warnings;
    usize errorLimit;
    bool limitNotified;
    // `-w`: suppress all diagnostic rendering (counters still track)
    bool silenced;
    // 0 auto, 1 always, 2 never
    u8 colorMode;
    usize lexerErrors;
    usize parserErrors;
    u8* bufStart;
    u8* bufEnd;
    Vec<str> filePaths;
    Vec<u8*> fileBufs;
    Vec<u8*> fileBufEnds;
    u32 fileCount;
    /* collect structured records alongside rendering (LSP mode); off by
     * default so normal compiles don't pay for the copies */
    bool collect;
    DiagList records;

    void init(u8* bufStart, u8* bufEnd)
    {
        // bufStart/bufEnd are the main file, used when a loc names no
        // known file. limit of 20 mirrors clang; silenced is -w
        self = DiagnosticEngine {
            .errors = 0,
            .warnings = 0,
            .errorLimit = 20,
            .limitNotified = false,
            .silenced = false,
            .colorMode = 0,
            .lexerErrors = 0,
            .parserErrors = 0,
            .bufStart = bufStart,
            .bufEnd = bufEnd,
            .filePaths = Vec<str>::new(),
            .fileBufs = Vec<u8*>::new(),
            .fileBufEnds = Vec<u8*>::new(),
            .fileCount = 0,
            .collect = false,
            .records = DiagList { .items = null, .len = 0, .cap = 0 },
        };
    }

    /* hand the collected records to `out` (taking ownership); with a null
     * `out` the records are dropped */
    void moveRecordsTo(DiagList* out)
    {
        if (out == null)
        {
            self.records.dispose();
            return;
        }
        *out = self.records;
        self.records.init();
    }

    /* release every table this engine owns. the source buffers recorded
     * in fileBufs/fileBufEnds belong to the compile unit, not the engine,
     * so only the path copies and the arrays go here */
    void deinit()
    {
        usize i = 0;
        while (i < self.filePaths.len)
        {
            str p = self.filePaths.at(i);
            if (p.ptr != null) dealloc<u8>((u8*)p.ptr);
            i++;
        }
        self.filePaths.dispose();
        self.fileBufs.dispose();
        self.fileBufEnds.dispose();
        self.records.dispose();
    }

    usize errorCount() { return self.errors; }
    usize warningCount() { return self.warnings; }
    usize lexerErrorCount() { return self.lexerErrors; }
    usize parserErrorCount() { return self.parserErrors; }
    bool hasErrors() { return self.errors > 0; }
    // -ferror-limit=N (0 = unlimited); stop rendering the N+1st error
    bool tooManyErrors() { return self.errorLimit != 0 && self.errors > self.errorLimit; }

    // register a source file; returns its file id
    u32 addFile(u8* path, usize pathLen, u8* bufStart, u8* bufEnd)
    {
        u32 id = self.fileCount;
        /* copy the path; the lib loader frees its candidate paths while
         * this table lives for the whole compile */
        u8* pcopy = alloc<u8>(pathLen + 1);
        if (pcopy != null)
        {
            usize pi = 0;
            while (pi < pathLen) { pcopy[pi] = path[pi]; pi++; }
            pcopy[pathLen] = 0;
            self.filePaths.push(str { .ptr = pcopy, .len = pathLen });
        }
        else
        {
            self.filePaths.push(str { .ptr = path, .len = pathLen });
        }
        self.fileBufs.push(bufStart);
        self.fileBufEnds.push(bufEnd);
        self.fileCount++;
        return id;
    }

    /* file id of an already-registered path (content compare); returns
     * fileCount when unknown. used by the loader to mark a prelude root
     * it loaded as somebody else's dependency */
    u32 fileIdForPath(u8* path, usize pathLen)
    {
        u32 i = 0;
        while (i < self.fileCount)
        {
            str p = self.filePaths.at((usize)i);
            if (p.len == pathLen && p.ptr != null && path != null)
            {
                bool eq = true;
                usize k = 0;
                while (k < pathLen)
                {
                    if (p.ptr[k] != path[k]) { eq = false; break; }
                    k++;
                }
                if (eq) return i;
            }
            i++;
        }
        return self.fileCount;
    }

    /* byte pointer for (line, col). walks the file from byte 0 on every
     * call; O(offset), but this only runs when a diagnostic renders, so
     * it's cold. line/col are 1-based; 0 means "don't bother" */
    u8* locPtr(SourceLoc loc)
    {
        u32 file = locFile(loc);
        u32 line = locLine(loc);
        u32 col = locCol(loc);
        if (file >= self.fileCount) return self.bufStart;
        u8* buf = self.fileBufs.at((usize)file);
        u8* end = self.fileBufEnds.at((usize)file);
        if (buf == null) return null;
        if (line == 0) return buf;
        u32 curLine = 1;
        u8* p = buf;
        while (p < end && curLine < line)
        {
            if (p[0] == 10) curLine++;
            p++;
        }
        if (col == 0) col = 1;
        u32 c = 1;
        while (p < end && c < col && p[0] != 10 && p[0] != 13)
        {
            p++;
            c++;
        }
        return p;
    }

    void emitError(ErrorCode code, SourceLoc loc, str msg, str help)
    {
        self.emitErrorRich(code, loc, msg, help, "", SourceLoc { .data = 0 }, "", "");
    }

    void emitErrorRich(ErrorCode code, SourceLoc loc, str msg, str label, str help,
                       SourceLoc refLoc, str refLabel, str fix)
    {
        self.emitErrorEdit(code, loc, msg, label, help, refLoc, refLabel, fix, "", 0, 0, 0, "");
    }

    /* like emitErrorRich, but also renders a diff for one edit: `editLen`
     * bytes at 1-based `editCol` on the primary line become `replacement` */
    void emitErrorEdit(ErrorCode code, SourceLoc loc, str msg, str label, str help,
                       SourceLoc refLoc, str refLabel, str fix, str fixExpr,
                       usize spanLen, u32 editCol, u32 editLen, str replacement)
    {
        self.errors++;
        if (self.tooManyErrors())
        {
            if (!self.limitNotified)
            {
                self.limitNotified = true;
                str note = "note: too many errors emitted, stopping now (use -ferror-limit=0 to disable)\n";
                write(2, (const cchar*)note.ptr, note.len);
            }
            return;
        }
        self.renderAtEdit(code, "error", loc, msg, label, help, refLoc, refLabel, fix, fixExpr,
                          spanLen, editCol, editLen, replacement);
    }

    void emitWarning(ErrorCode code, SourceLoc loc, str msg, str help)
    {
        self.emitWarningRich(code, loc, msg, help, "", SourceLoc { .data = 0 }, "", "");
    }

    void emitWarningRich(ErrorCode code, SourceLoc loc, str msg, str label, str help,
                         SourceLoc refLoc, str refLabel, str fix)
    {
        self.warnings++;
        if (self.tooManyErrors()) return;
        self.renderAtRich(code, "warning", loc, msg, label, help, refLoc, refLabel, fix);
    }

    /* report a diagnostic permitted by an escape-hatch flag (e.g.
     * --allow-int-ptr): rendered like an error but not counted, so the
     * build still succeeds; -w silences the rendering */
    void emitAllowed(ErrorCode code, SourceLoc loc, str msg, str help)
    {
        self.renderAt(code, "error", loc, msg, help);
    }

    void emitNote(ErrorCode code, SourceLoc loc, str msg, str help)
    {
        self.renderAt(code, "note", loc, msg, help);
    }

    void emitFatal(ErrorCode code, SourceLoc loc, str msg, str help)
    {
        self.errors++;
        self.renderAt(code, "fatal error", loc, msg, help);
    }

    void addRecord(str code, str level, str msg, str path, u32 line, u32 col, str lineText, str help)
    {
        self.records.push(DiagRecord {
            .code = String::from(code),
            .level = String::from(level),
            .message = String::from(msg),
            .file = String::from(path),
            .lineText = String::from(lineText),
            .help = String::from(help),
            .line = line,
            .col = col,
            .endCol = recordEndCol(lineText, col),
        });
    }

    void fillLine(SourceLoc loc, DiagLine* out)
    {
        out->path = "";
        out->line = 0;
        out->col = 0;
        out->text = "";
        out->label = "";
        out->spanLen = 0;

        u32 file = locFile(loc);
        if (file >= self.fileCount) return;
        u8* ptr = self.locPtr(loc);
        if (ptr == null) return;

        out->line = (usize)locLine(loc);
        out->col = (usize)locCol(loc);
        u8* fileBuf = self.fileBufs.at((usize)file);
        u8* fileEnd = self.fileBufEnds.at((usize)file);

        u8* lineStart = ptr;
        while (lineStart > fileBuf)
        {
            u8* prev = lineStart - 1;
            if (prev[0] == '\n') break;
            lineStart = prev;
        }

        u8* lineEnd = ptr;
        while (lineEnd < fileEnd)
        {
            if (lineEnd[0] == '\n') break;
            if (lineEnd[0] == '\r') break;
            lineEnd++;
        }

        out->text = str { .ptr = lineStart, .len = (usize)(lineEnd - lineStart) };
        out->path = self.filePaths.at((usize)file);
    }

    void renderAt(ErrorCode code, str level, SourceLoc loc, str msg, str help)
    {
        self.renderAtRich(code, level, loc, msg, help, "", SourceLoc { .data = 0 }, "", "");
    }

    void renderAtRich(ErrorCode code, str level, SourceLoc loc, str msg, str label, str help,
                      SourceLoc refLoc, str refLabel, str fix)
    {
        self.renderAtEdit(code, level, loc, msg, label, help, refLoc, refLabel, fix, "",
                          0, 0, 0, "");
    }

    void renderAtEdit(ErrorCode code, str level, SourceLoc loc, str msg, str label, str help,
                      SourceLoc refLoc, str refLabel, str fix, str fixExpr,
                      usize spanLen, u32 editCol, u32 editLen, str replacement)
    {
        // silenced: no textual rendering. with `collect` the position is
        // still resolved so structured records stay accurate in LSP mode.
        if (self.silenced && !self.collect) return;

        DiagLine primary;
        self.fillLine(loc, &primary);
        primary.label = label;
        primary.spanLen = spanLen;

        DiagLine reference;
        bool hasRef = refLoc.data != 0;
        self.fillLine(refLoc, &reference);
        reference.label = refLabel;

        String diffOld = String::new();
        String diffNew = String::new();
        bool hasDiff = false;
        if (!self.silenced && editLen > 0 && replacement.len > 0 &&
            primary.text.len > 0 && editCol > 0)
        {
            usize start = (usize)(editCol - 1);
            if (start <= primary.text.len)
            {
                usize end = start + (usize)editLen;
                if (end > primary.text.len) end = primary.text.len;
                diffOld = String::from(primary.text);
                diffNew = String::new();
                diffNew.pushView(str { .ptr = primary.text.ptr, .len = start });
                diffNew.pushView(replacement);
                diffNew.pushView(str { .ptr = primary.text.ptr + end, .len = primary.text.len - end });
                hasDiff = true;
            }
        }

        if (!self.silenced)
        {
            RenderInput in = RenderInput {
                .code = codeStr(code),
                .level = level,
                .msg = msg,
                .primary = primary,
                .reference = reference,
                .hasRef = hasRef,
                .help = help,
                .fix = fix,
                .fixExpr = fixExpr,
                .fixClass = fixClassFor(code),
                .hasDiff = hasDiff,
                .diffOld = diffOld.asView(),
                .diffNew = diffNew.asView(),
                .colorMode = self.colorMode,
                .ordinal = self.errors,
            };
            render(&in);
            if (hasDiff)
            {
                diffOld.free();
                diffNew.free();
            }
        }
        if (self.collect)
        {
            str recordHelp = help;
            if (recordHelp.len == 0) recordHelp = label;
            self.addRecord(codeStr(code), level, msg, primary.path,
                           (u32)primary.line, (u32)primary.col, primary.text, recordHelp);
        }
    }
}
