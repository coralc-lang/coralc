#[[no_drop_all]]
/* diagnostics/span.crl: source spans, labels, source map
 *
 * Span: file id + byte range.
 * Label: span + text + primary/secondary.
 * SourceMap: file table with line offsets for byte<->(line,col).
 *
 * all of it is a stub: addFile stores nothing (fileCount never moves, so
 * every file answers to id 0) and lineCol* hardcode 1:1. the real
 * file/line resolution lives in engine.crl's own table.
 */

import ast::id { Str };

pub struct Span
{
    u32 file;
    u32 start;
    u32 end;
}

pub struct Label
{
    Span span;
    u8* text;
    u8 kind;    // primary/secondary, pure convention; nothing builds a Label yet
}

pub struct FileEntry
{
    Str path;
    u8* bytes;
    usize len;
    u32* lineStarts;
    u32 lineCount;
}

pub struct SourceMap
{
    FileEntry* files;
    u32 filesLen;

    u32 addFile(Str path, u8* bytes, usize len)
    {
        // stub: returns 0 forever, stores nothing
        u32 id = self.filesLen;
        return id;
    }

    u32 lineColLine(u32 fileId, u32 offset)
    {
        return 1;
    }

    u32 lineColCol(u32 fileId, u32 offset)
    {
        return 1;
    }
}
