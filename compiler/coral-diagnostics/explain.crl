#[[no_drop_all]]
/* diagnostics/explain.crl: `coralc --explain CODE` long-form help.
 *
 * One entry per stable diagnostic code (see code.crl). Output goes to
 * stdout: a bold header, a short summary, then "why" and "how to fix"
 * sections. Unknown codes print the index of every code we know.
 */

import(lib) platform::libc { write };
import(lib) std::text::string { String };

// tiny helpers so the code table below reads like a mini DSL; exBufStr's
// empty guard is the only real logic here. the output goes to stdout (fd 1)

void exBufStr(String* b, str s)
{
    if (s.len == 0) return;
    b->pushView(s);
}

void exBufByte(String* b, u8 c)
{
    b->pushByte(c);
}

// alias for str.equals: keeps the giant if-chain below flavour-free
bool exEq(str a, str b)
{
    return a.equals(b);
}

void exTitle(String* b, str code, str summary)
{
    exBufByte(b, 27); exBufStr(b, "[1m");
    exBufStr(b, code);
    exBufByte(b, 27); exBufStr(b, "[0m");
    exBufStr(b, " — ");
    exBufStr(b, summary);
    exBufStr(b, "\n\n");
}

void exWhy(String* b, str s) { exBufStr(b, "why:  "); exBufStr(b, s); exBufStr(b, "\n"); }
void exFix(String* b, str s) { exBufStr(b, "fix:  "); exBufStr(b, s); exBufStr(b, "\n"); }

// returns true when the code was recognised
// one if per code; linear, but this runs once per --explain invocation,
// and staying data-in-code beats dragging in a hash table
bool exOne(String* b, str code)
{
    if (exEq(code, "L0001"))
    {
        exTitle(b, code, "unknown character");
        exWhy(b, "the lexer found a byte that cannot start any Coral token.");
        exFix(b, "delete the character, or quote it if it belongs in a string.");
        exFix(b, "watch for smart quotes/ dashes copied from documents, and for stray tabs in odd places.");
        return true;
    }
    if (exEq(code, "L0002"))
    {
        exTitle(b, code, "unterminated string literal");
        exWhy(b, "a '\"' opened a string that is never closed before the end of the line.");
        exFix(b, "add the closing quote; use \\n for a newline inside the string.");
        exFix(b, "for a string that must span lines, build it from pieces instead.");
        return true;
    }
    if (exEq(code, "L0003"))
    {
        exTitle(b, code, "unterminated character literal");
        exWhy(b, "a '\\'' opened a char literal that is never closed.");
        exFix(b, "char literals hold exactly one character: '\\n', 'a', '7'.");
        return true;
    }
    if (exEq(code, "L0004"))
    {
        exTitle(b, code, "unterminated block comment");
        exWhy(b, "a '/*' is missing its closing '*/'.");
        // heads up: skip_ws.crl stops at the first `*/`, so the "may nest"
        // part of this string is a lie, but the text is user-visible and
        // off-limits, so fix the lexer or the string together
        exFix(b, "close the comment; block comments may nest, so count the levels.");
        return true;
    }
    if (exEq(code, "L0005"))
    {
        exTitle(b, code, "invalid escape sequence");
        exWhy(b, "the backslash is followed by a character that has no meaning.");
        exFix(b, "valid escapes: \\n \\r \\t \\\\ \\' \\\" \\0 \\xNN");
        exFix(b, "for a literal backslash, write \\\\.");
        return true;
    }
    if (exEq(code, "L0006"))
    {
        exTitle(b, code, "invalid number literal");
        exWhy(b, "a digit sequence is not a well-formed number in its base.");
        exFix(b, "decimal: 42; hex: 0xFF; binary: 0b1010; octal: 0o755");
        exFix(b, "suffixes: 255u (unsigned), 12i32-style casts go on the outside.");
        return true;
    }
    if (exEq(code, "L0007"))
    {
        exTitle(b, code, "invalid character in token");
        exWhy(b, "this byte cannot appear where it was found.");
        exFix(b, "split the token, or move the character into a string literal.");
        return true;
    }
    if (exEq(code, "P0001"))
    {
        exTitle(b, code, "expected a specific token, found something else");
        exWhy(b, "the grammar requires a token here — usually ';', ')', '}' or '>'.");
        exWhy(b, "the location points at the token that was found instead.");
        exFix(b, "add the missing token; a missing ';' at the end of a statement is the usual cause.");
        exFix(b, "if the found token looks right, check the line above — an unclosed '(' or '{' earlier shifts everything.");
        return true;
    }
    if (exEq(code, "P0002"))
    {
        exTitle(b, code, "expected an expression");
        exWhy(b, "an operand was required here (after an operator, inside '()', ...).");
        exFix(b, "supply a value: a literal, identifier, call, or parenthesised expression.");
        return true;
    }
    if (exEq(code, "P0003"))
    {
        exTitle(b, code, "expected a type");
        exWhy(b, "a type name was required here (declaration, cast, or generic argument).");
        exFix(b, "use a primitive (i32, u8, bool, str, ...) or a declared struct/enum/trait name.");
        exFix(b, "if the type lives elsewhere, import its module first.");
        return true;
    }
    if (exEq(code, "P0004"))
    {
        exTitle(b, code, "expected a declaration");
        exWhy(b, "at file level, only declarations are valid.");
        exFix(b, "declarations are: var, const, struct, enum, trait, union, variant, typedef,");
        exFix(b, "distinct, import, mod, extend, extern, static, comptime, flag — each optionally");
        exFix(b, "after `pub`. a function has no keyword: `i32 name(i32 a) { ... }`.");
        return true;
    }
    if (exEq(code, "P0005"))
    {
        exTitle(b, code, "expected a statement");
        exWhy(b, "a statement was required in this block.");
        exFix(b, "statements start with: var, if, for, while, loop, switch, return,");
        exFix(b, "break, continue, defer, comptime, or an expression.");
        return true;
    }
    if (exEq(code, "P0006"))
    {
        exTitle(b, code, "unexpected end of file");
        exWhy(b, "input ended while a construct was still open.");
        exFix(b, "close every '{', '(' and '['; the file is most likely truncated.");
        return true;
    }
    if (exEq(code, "P0007"))
    {
        exTitle(b, code, "invalid assignment target");
        exWhy(b, "the left side of '=' is not something that can be stored into.");
        exFix(b, "assign to a variable, field, or dereferenced pointer; use '==' to compare.");
        return true;
    }
    if (exEq(code, "P0008"))
    {
        exTitle(b, code, "duplicate modifier");
        exWhy(b, "a modifier (pub, extern, static, ...) appears twice on one declaration.");
        exFix(b, "keep a single copy of each modifier.");
        return true;
    }
    if (exEq(code, "P0009"))
    {
        exTitle(b, code, "missing ';'");
        exWhy(b, "statements and simple declarations end with a semicolon.");
        exFix(b, "add ';' at the end of the line pointed at.");
        return true;
    }
    if (exEq(code, "P0010"))
    {
        exTitle(b, code, "assignment in condition");
        exWhy(b, "Coral rejects '=' inside an if/while condition to avoid the C 'if (x = y)' bug.");
        exFix(b, "use '==' to compare, or mark the declaration #[[condassign]] if the assignment is intended.");
        return true;
    }
    if (exEq(code, "P0011"))
    {
        exTitle(b, code, "invalid import path");
        exWhy(b, "an import path must be a bare name or a module path — a path element here is not a valid name.");
        exFix(b, "write `import name { ... };` for a sibling file, or `import mod::name { ... };` for a module item.");
        return true;
    }
    if (exEq(code, "T0001"))
    {
        exTitle(b, code, "unknown name");
        exWhy(b, "this identifier is not declared in scope, or its module was never imported.");
        exFix(b, "check spelling (Coral is case-sensitive) and that the declaring module is imported.");
        exFix(b, "for names from another file: pub mod m = import(lib) name; then qualify as m::name.");
        return true;
    }
    if (exEq(code, "T0002"))
    {
        exTitle(b, code, "type mismatch");
        exWhy(b, "the operand's type does not match what this position requires.");
        exFix(b, "Coral has no implicit conversions — convert explicitly: x as i64.");
        exFix(b, "widening (u8 → u32) still needs the cast to be written out.");
        return true;
    }
    if (exEq(code, "T0003"))
    {
        exTitle(b, code, "wrong number of arguments");
        exWhy(b, "the call passes a different number of arguments than the declaration accepts.");
        exFix(b, "match the parameter list; variadic functions (… params) accept a tail of extra arguments.");
        return true;
    }
    if (exEq(code, "T0004"))
    {
        exTitle(b, code, "duplicate declaration");
        exWhy(b, "this name is already declared in the same scope.");
        exFix(b, "rename one of them, or move one into another module.");
        return true;
    }
    if (exEq(code, "T0005"))
    {
        exTitle(b, code, "invalid cast");
        exWhy(b, "these two types have no legal conversion between them.");
        exFix(b, "convert through a common type, or rebuild the value from its parts.");
        return true;
    }
    if (exEq(code, "T0006"))
    {
        exTitle(b, code, "no such member or method");
        exWhy(b, "the type has no field/method with this name.");
        exFix(b, "check the spelling; declare the method with `extend Type { ... }` if it should exist.");
        return true;
    }
    if (exEq(code, "T0007"))
    {
        exTitle(b, code, "internal type-checker failure");
        exWhy(b, "the checker hit a state it does not handle — this is a compiler bug.");
        exFix(b, "minimise the input to the smallest file that still triggers it and report it.");
        return true;
    }
    if (exEq(code, "T0008"))
    {
        exTitle(b, code, "cannot assign to this");
        exWhy(b, "the left-hand side is not storage this statement may write to.");
        exWhy(b, "typical causes: the name is a `const`, a type, a function, or a `comptime` value.");
        exFix(b, "make the target a `var` if it must change, or compute a new value instead of overwriting it.");
        exFix(b, "a const local can be redeclared with `var`; a const global must be declared `var` at file scope.");
        return true;
    }
    if (exEq(code, "T0009"))
    {
        exTitle(b, code, "cannot assign an integer to a pointer");
        exWhy(b, "pointers and integers are distinct types; an integer value (including a literal `0`) does not convert to a pointer implicitly.");
        exFix(b, "use `null` for a null pointer, or write an explicit u8* cast.");
        exFix(b, "--allow-int-ptr permits the conversion but still reports this diagnostic; `-w` silences the rendering.");
        return true;
    }
    if (exEq(code, "L0009"))
    {
        exTitle(b, code, "homoglyph in source");
        exWhy(b, "a Unicode lookalike (e.g. a Cyrillic letter) sits where Coral expects an ASCII identifier character.");
        exFix(b, "retype the identifier with ASCII; copy-pasted code is the usual source.");
        return true;
    }
    if (exEq(code, "L0008"))
    {
        exTitle(b, code, "malformed raw string literal");
        exWhy(b, "the opening delimiter of a raw string is not spelled correctly.");
        exFix(b, "write `R\"delim( ... )delim\"`; the quote comes directly after `R`, then the optional delimiter, then `(`.");
        exFix(b, "for example, `R\"(hello)\"` is a raw string containing `hello` and no escapes are processed.");
        return true;
    }
    if (exEq(code, "P0022"))
    {
        exTitle(b, code, "attribute in the wrong place");
        exWhy(b, "`#[[...]]` is attached to something that cannot carry attributes.");
        exFix(b, "move the attribute to the declaration or statement it describes.");
        return true;
    }
    if (exEq(code, "P0012"))
    {
        exTitle(b, code, "unknown attribute name");
        exWhy(b, "`#[[...]]` names an attribute this compiler does not recognize.");
        exFix(b, "check the spelling; the diagnostic suggests the closest known attribute.");
        return true;
    }
    if (exEq(code, "P0013"))
    {
        exTitle(b, code, "explicit `self` parameter");
        exWhy(b, "`self` is an implicit receiver in methods; it must not appear in the parameter list, in any spelling (`self`, `self*`, `const self*`).");
        exWhy(b, "`self` is also reserved as a parameter name, including in free functions.");
        exFix(b, "remove it from the parameter list and use `self` in the method body; rename any ordinary parameter called `self`.");
        return true;
    }
    if (exEq(code, "T0010"))
    {
        exTitle(b, code, "integer literal overflows the declared type");
        exWhy(b, "the literal's value does not fit in the integer type it is being stored into.");
        exFix(b, "use a wider type, or a suffix that selects one (`300u16`), or reduce the value.");
        return true;
    }
    if (exEq(code, "T0011"))
    {
        exTitle(b, code, "non-void function can reach the end without returning");
        exWhy(b, "control can fall off the closing `}` of a function that promises a return value.");
        exFix(b, "add a `return` on every path, usually a final `return` after the last statement.");
        return true;
    }
    if (exEq(code, "T0012"))
    {
        exTitle(b, code, "unused variable");
        exWhy(b, "a local variable is declared and never read; this is a warning enabled by default.");
        exFix(b, "remove it, read it, annotate the declaration with `#[[maybe_unused]]` when it is deliberately unused.");
        return true;
    }
    if (exEq(code, "T0013"))
    {
        exTitle(b, code, "constant array index out of bounds");
        exWhy(b, "an index that the compiler can evaluate at comptime is outside the array's declared length.");
        exFix(b, "keep the index in `0 ..< len`, or grow the array.");
        return true;
    }
    if (exEq(code, "T0014"))
    {
        exTitle(b, code, "comptime evaluation error");
        exWhy(b, "a comptime block raised an error while the compiler was evaluating it (usually @compileError).");
        exFix(b, "the text above is the message from the comptime code; fix the call so that block takes its intended path.");
        return true;
    }
    if (exEq(code, "T0017"))
    {
        exTitle(b, code, "incomplete @iter implementation");
        exWhy(b, "the type advertises @iter but is missing a method the protocol requires.");
        exFix(b, "implement `usize count()` and `T at(usize i)` in `extend Type : @iter {}`.");
        exFix(b, "ranged for-in also needs `IterRange range(usize start, usize end)`.");
        return true;
    }
    if (exEq(code, "P0016"))
    {
        exTitle(b, code, "expected switch pattern");
        exWhy(b, "expected a pattern in this switch arm.");
        exFix(b, "write a pattern such as `Some { value }`, a literal, `_`, or `else`.");
        return true;
    }
    if (exEq(code, "P0017"))
    {
        exTitle(b, code, "no matching flag arm");
        exWhy(b, "no arm of this flag expression/statement matched and there is no `else`.");
        exFix(b, "add an `else` arm, or handle every flag value explicitly.");
        return true;
    }
    if (exEq(code, "P0018"))
    {
        exTitle(b, code, "malformed @sizeof");
        exWhy(b, "`sizeof` is spelled `@sizeof(T)`, with the `@` and a parenthesised type.");
        exFix(b, "write `@sizeof(T)`.");
        return true;
    }
    if (exEq(code, "P0019"))
    {
        exTitle(b, code, "invalid array size");
        exWhy(b, "an array size must be an integer literal, a `const` integer, or a generic parameter.");
        exFix(b, "use a literal, a `const` integer, or a generic parameter.");
        return true;
    }
    if (exEq(code, "P0020"))
    {
        exTitle(b, code, "malformed tuple type");
        exWhy(b, "Coral tuple types are written `struct(A, B)`, not with bare parentheses.");
        exFix(b, "write `struct(A, B)`.");
        return true;
    }
    if (exEq(code, "P0021"))
    {
        exTitle(b, code, "malformed expression after `str`");
        exWhy(b, "after `str`, write a path call such as `str::fromParts(...)` or a `str` value.");
        exFix(b, "use `str::name(...)` or a string literal.");
        return true;
    }
    if (exEq(code, "P0014"))
    {
        exTitle(b, code, "unexpected closing token");
        exWhy(b, "a `}`, `)` or `]` appears at top level with no matching opener in the current declaration.");
        exFix(b, "remove the closer, or restore the declaration or block it belongs to.");
        return true;
    }
    if (exEq(code, "P0015"))
    {
        exTitle(b, code, "too many for-in bindings");
        exWhy(b, "the loop binding list names more than 16 values in one `for (a, b, ... : iterable)` form.");
        exFix(b, "split the loop into nested loops or destructure fewer values.");
        return true;
    }
    if (exEq(code, "T0016"))
    {
        exTitle(b, code, "array size is not a compile-time constant");
        exWhy(b, "a fixed array length is part of the type, so it must be known while compiling; this name is a runtime value.");
        exFix(b, "use a literal or `const` length, make the length a generic parameter, or use a slice/runtime allocation.");
        return true;
    }
    if (exEq(code, "T0015"))
    {
        exTitle(b, code, "unknown constant in switch pattern");
        exWhy(b, "a switch over an integer, bool or char compares its arms against constants; this bare name does not resolve to a `const` declaration.");
        exFix(b, "fix the spelling, import the module that declares the constant, or write an `else` arm.");
        return true;
    }
    if (exEq(code, "P0023"))
    {
        exTitle(b, code, "documentation comment on a statement");
        exWhy(b, "`///` and `/** */` document declarations; this one is attached to executable code inside a block.");
        exFix(b, "move the comment above the declaration it documents, or use a plain `//` comment for code.");
        return true;
    }
    if (exEq(code, "T0018"))
    {
        exTitle(b, code, "unreachable code");
        exWhy(b, "a `return`, `break`, `continue` or noreturn call before this statement always leaves the block, so this statement can never run.");
        exFix(b, "delete the dead statements, or move the diverging statement after them.");
        return true;
    }
    if (exEq(code, "T0019"))
    {
        exTitle(b, code, "self-assignment has no effect");
        exWhy(b, "the assignment stores a value into the same binding it reads from, leaving the value unchanged.");
        exFix(b, "assign the intended new value, or remove the statement if it is deliberately a no-op.");
        return true;
    }
    if (exEq(code, "T0020"))
    {
        exTitle(b, code, "switch is not exhaustive");
        exWhy(b, "the scrutinee is an enum or variant, but one or more cases have no arm and there is no `else`.");
        exFix(b, "cover every case explicitly, or add an `else` arm for the remaining cases.");
        return true;
    }
    if (exEq(code, "T0021"))
    {
        exTitle(b, code, "unreachable switch case");
        exWhy(b, "an earlier unguarded arm already covers this value or variant, so this arm can never be selected.");
        exFix(b, "remove the duplicate arm, or add a guard if it is meant to handle a narrower condition.");
        return true;
    }
    if (exEq(code, "P0024"))
    {
        exTitle(b, code, "duplicate attribute");
        exWhy(b, "the same attribute is listed more than once on one item.");
        exFix(b, "remove the repeated attribute; one spelling is enough.");
        return true;
    }
    if (exEq(code, "P0026"))
    {
        exTitle(b, code, "keyword used as an identifier");
        exWhy(b, "the word at this position is a reserved keyword, so it cannot name a variable, constant or function.");
        exWhy(b, "`any` is special: it introduces a trait type — write `any Trait` (like Rust's `dyn Trait`).");
        exFix(b, "rename the item to a word that is not a keyword (if, while, str, any, ...).");
        return true;
    }
    if (exEq(code, "T0022"))
    {
        exTitle(b, code, "explicit drop is not allowed here");
        exWhy(b, "the value's type manages its own lifetime; dropping it by hand would double-free or use freed memory.");
        exFix(b, "remove the explicit drop; the compiler inserts it at scope exit.");
        return true;
    }
    if (exEq(code, "G0001"))
    {
        exTitle(b, code, "construct not supported by codegen");
        exWhy(b, "this construct has no lowering for the current target.");
        exFix(b, "rewrite it with supported constructs, or report the gap if the feature is documented.");
        return true;
    }
    if (exEq(code, "G0002"))
    {
        exTitle(b, code, "internal codegen failure");
        exWhy(b, "the backend hit a state it does not handle — this is a compiler bug.");
        exFix(b, "minimise the input and report it.");
        return true;
    }
    if (exEq(code, "D0001"))
    {
        exTitle(b, code, "file not found");
        exWhy(b, "the compiler could not open the given path.");
        exFix(b, "check the path spelling and that the file exists relative to the working directory.");
        return true;
    }
    if (exEq(code, "D0002"))
    {
        exTitle(b, code, "invalid flag");
        exWhy(b, "the command line contains an option coralc does not accept.");
        exFix(b, "run `coralc --help` for the list of accepted flags.");
        return true;
    }
    if (exEq(code, "D0003"))
    {
        exTitle(b, code, "out of memory");
        exWhy(b, "an allocation failed while compiling.");
        exFix(b, "close other programs and retry; report it if it reproduces on a small input.");
        return true;
    }
    return false;
}

// catch-all when exOne didn't recognise the code: point at the index
void exIndex(String* b)
{
    exBufStr(b, "No explanation available for this code.\n\nAvailable codes:\n");
    exBufStr(b, "  L0001 .. L0009   lexer\n");
    exBufStr(b, "  P0001 .. P0026   parser\n");
    exBufStr(b, "  T0001 .. T0022    type check / semantics\n");
    exBufStr(b, "  G0001  .. G0002    codegen\n");
    exBufStr(b, "  D0001 .. D0003   driver\n");
}

/* long-form help text for one code into `b`; unknown codes get the index.
 * the LSP calls this to answer "jump to explanation" without a terminal. */
pub void explainText(String* b, str code)
{
    if (!exOne(b, code)) exIndex(b);
}

pub void explain(str code)
{
    // build the whole thing, then one write; unknown codes fall through
    // to the index
    String b = String::new();
    explainText(&b, code);
    exBufByte(&b, 10);
    if (b.ptr != null) write(1, b.ptr, b.len);
}
