#[[no_drop_all]]
/* diagnostics/error.crl: the renderer.
 *
 * Every diagnostic funnels through here. The engine resolves SourceLocs to
 * source lines and passes a RenderInput with the primary span, an optional
 * reference span, labels, help, and a fix hint. The renderer picks one of
 * three layouts: full, compact, or short. Auto mode uses full for the first
 * few errors on a terminal, compact while the count is manageable, and short
 * for pipes, CI logs, and error floods.
 *
 * Output shape (stderr; colours only when enabled):
 *   error[T0006]: cannot use `.` to reach a field through a pointer
 *      ╭─▸ src/mu-backend/base.crl:60:27
 *      │
 *   12 │     Diag* diags;
 *      │     ┬────
 *      │     ╰─ reference: field declared as a pointer here
 *      ⋮
 *   60 │         return self.diags.errors > 0;
 *      │                          ┬─
 *      │                          ╰─ `.` can't see through `Diag*`
 *      │
 *      ╰─ docs: coralc --explain T0006
 */

import platform::libc { write, isatty };
import std::string { String };

// this file's own mini-printf, bolted onto String

extend String {
    void outBytes(str s)
    {
        if (s.len == 0) return;
        self.pushView(s);
    }

    void outUint(usize v)
    {
        if (v == 0) { self.pushByte(48); return; }
        // emit digits most-significant first: find the largest power of 10 <= v
        usize div = 1;
        while (v / div >= 10) div *= 10;
        while (div > 0)
        {
            usize d = (v / div) % 10;
            self.pushByte((u8)(48 + d));
            div /= 10;
        }
    }
    
    // right-align `v` in a field of width `w`
    void outPad(usize v, usize w)
    {
        usize d = 1;
        usize t = v;
        while (t >= 10) { t /= 10; d++; }
        while (d < w) { self.pushByte(32); d++; }
        self.outUint(v);
    }

    void colorOn(bool on, str seq)
    {
        if (!on) return;
        self.pushByte(27);
        self.pushView(seq);
    }
    
    void colorOff(bool on)
    {
        if (!on) return;
        self.pushByte(27);
        self.pushView("[0m");
    }
}

// digit count for field padding (outPad and the gutter both need it)
usize digits(usize v)
{
    usize d = 1;
    while (v >= 10) { v /= 10; d++; }
    return d;
}

// default help lines, keyed by the stable code string

pub str helpFor(str code)
{
    if (code.len == 0) return "";
    if (code.equals("L0001")) return "remove the stray character, or escape it if it belongs in a literal";
    if (code.equals("L0002")) return "close the string with a matching quote";
    if (code.equals("L0003")) return "close the character literal with a matching quote";
    if (code.equals("L0004")) return "close the comment with its terminator";
    if (code.equals("L0005")) return "valid escapes are \\n \\r \\t \\\\ \\' \\\" \\0 \\xNN";
    if (code.equals("L0006")) return "on digits in the matching base, then an optional suffix";
    if (code.equals("L0007")) return "this character cannot start a token";
    if (code.equals("L0008")) return "raw strings are spelled R\"delim( ... )delim\"";
    if (code.equals("P0001")) return "a closing delimiter or required token is missing; check the surrounding grammar";
    if (code.equals("P0002")) return "an expression is required at this position";
    if (code.equals("P0003")) return "a type name is required at this position";
    if (code.equals("P0004")) return "a declaration here must be a function, var, const, struct or a type";
    if (code.equals("P0005")) return "expected a statement";
    if (code.equals("P0006")) return "the file ended before this construct was closed";
    if (code.equals("P0007")) return "only variables, fields and paths can be assigned to";
    if (code.equals("P0008")) return "each modifier (pub, extern, ...) may appear only once";
    if (code.equals("P0009")) return "statements and declarations end with ';'";
    if (code.equals("P0010")) return "conditions must be explicit — move the assignment out of the condition";
    if (code.equals("P0011")) return "an import path is a bare name (sibling file) or a module path such as name::item";
    if (code.equals("P0012")) return "use a known attribute name; the diagnostic suggests the closest match";
    if (code.equals("P0013")) return "`self` is implicit in methods; remove it from the parameter list and use it in the body";
    if (code.equals("P0016")) return "expected a pattern in this switch arm";
    if (code.equals("P0017")) return "no arm of this flag expression/statement matched and there is no `else`";
    if (code.equals("P0018")) return "`sizeof` is spelled `@sizeof(T)`, with the `@` and a parenthesised type";
    if (code.equals("P0019")) return "an array size must be an integer literal, a `const` integer, or a generic parameter";
    if (code.equals("P0020")) return "Coral tuple types are written `struct(A, B)`, not with bare parentheses";
    if (code.equals("P0021")) return "after `str`, write a path call such as `str::fromParts(...)` or a `str` value";
    if (code.equals("P0014")) return "remove the stray closer, or add the declaration/block it was meant to close";
    if (code.equals("P0015")) return "split the loop into nested loops or destructure fewer values";
    if (code.equals("T0001")) return "check the spelling, or import the module that declares this name";
    if (code.equals("T0002")) return "convert one side with an explicit cast, or fix the operand types";
    if (code.equals("T0003")) return "check the number and types of arguments against the declaration";
    if (code.equals("T0004")) return "rename one of the duplicate declarations";
    if (code.equals("T0005")) return "this cast is not allowed between these types";
    if (code.equals("T0006")) return "the type has no member with this name";
    if (code.equals("T0007")) return "internal type-checker failure — please report this";
    if (code.equals("T0008")) return "assign only to variables, fields and elements — constants cannot be reassigned";
    if (code.equals("T0009")) return "an integer is not implicitly a pointer; cast with `as rawptr` or use a pointer value";
    if (code.equals("T0010")) return "the literal does not fit the target type; use a wider type or a smaller value";
    if (code.equals("T0011")) return "add a `return` on every path, or make the function return void";
    if (code.equals("T0012")) return "remove it, read it, annotate the declaration with `#[[maybe_unused]]`";
    if (code.equals("T0013")) return "the index is outside the array; check the bound or the index expression";
    if (code.equals("T0014")) return "the text above is the message from the comptime code that ran";
    if (code.equals("T0016")) return "array lengths must be integer literals, `const` integers, or generic parameters; use a slice or allocate at runtime";
    if (code.equals("T0017")) return "a type used in for-in must provide `usize count()`, `T at(usize)`, and (for ranged loops) `struct(usize, usize) range(usize, usize)`";
    if (code.equals("T0015")) return "a scalar switch pattern must name a `const`; check the spelling or import it";
    if (code.equals("T0018")) return "remove the unreachable statements, or move the diverging statement after them";
    if (code.equals("T0019")) return "assign a different value, or delete the statement if it was meant to be a no-op";
    if (code.equals("T0020")) return "cover every enum/variant case, or add an `else` arm";
    if (code.equals("T0021")) return "remove the duplicate arm, or guard it with a condition that can still match";
    if (code.equals("P0024")) return "remove the repeated attribute; one spelling is enough";
    if (code.equals("P0023")) return "documentation comments belong on declarations, not on statements inside a body";
    if (code.equals("L0009")) return "this character looks like an ASCII character but is not; replace it with the ASCII spelling";
    if (code.equals("P0022")) return "attributes must sit directly above a declaration, before its modifiers";
    if (code.equals("T0022")) return "the type has a drop method; let scope exit run it instead of calling drop explicitly";
    if (code.equals("T0023")) return "an import path is a module name, optionally dotted with `::` members, e.g. `std::fs`; import symbols are listed in braces after it";
    if (code.equals("T0024")) return "call it on a value (`obj.method(...)`), or declare the method `static` to keep the `Type::method(...)` form";
    if (code.equals("G0001")) return "this construct cannot be lowered to the current target";
    if (code.equals("G0002")) return "internal codegen failure — please report this";
    if (code.equals("D0001")) return "check the path, or pass an existing file";
    if (code.equals("D0002")) return "run `coralc --help` for the list of accepted flags";
    if (code.equals("D0003")) return "the compiler could not allocate memory";
    if (code.equals("404-0000")) return "internal diagnostic code; please report this";
    return "";
}

pub struct DiagLine
{
    str path;
    usize line;
    usize col;
    str text;
    str label;
}

pub struct RenderInput
{
    str code;
    str level;
    str msg;
    DiagLine primary;
    DiagLine reference;
    bool hasRef;
    str help;
    str fix;
    bool hasDiff;
    str diffOld;
    str diffNew;
    u8 format;      // 0 auto, 1 full, 2 compact, 3 short
    u8 colorMode;   // 0 auto, 1 always, 2 never
    usize ordinal;
}

bool diagIsWord(u8 c)
{
    return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

usize diagWordLen(str lineText, usize col)
{
    if (col == 0 || col - 1 >= lineText.len) return 1;
    usize i = col - 1;
    usize start = i;
    while (i < lineText.len)
    {
        if (!diagIsWord(lineText.ptr[i])) break;
        i++;
    }
    if (i == start) return 1;
    return i - start;
}

bool diagSame(str a, str b)
{
    if (a.len != b.len) return false;
    usize i = 0;
    while (i < a.len)
    {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

str diagBaseName(str path)
{
    usize i = path.len;
    while (i > 0)
    {
        u8 c = path.ptr[i - 1];
        if (c == 47 || c == 92) return str { .ptr = path.ptr + i, .len = path.len - i };
        i--;
    }
    return path;
}

void diagSpaces(String* o, usize n)
{
    if (n > 0) o->pushRepeat(32, n);
}

void diagDim(String* o, bool on, str s)
{
    o->colorOn(on, "[90m");
    o->outBytes(s);
    o->colorOff(on);
}

str diagLevelSeq(str level)
{
    if (level.len == 0) return "[1;31m";
    u8 c = level.ptr[0];
    if (c == 119) return "[1;33m";  // warning
    if (c == 101) return "[1;31m";  // error
    if (c == 102) return "[1;31m";  // fatal error
    return "[1;36m";                // note
}

u8 diagResolveFormat(u8 requested, usize ordinal, bool tty)
{
    if (requested != 0) return requested;
    if (!tty) return 3;
    if (ordinal <= 3) return 1;
    if (ordinal <= 20) return 2;
    return 3;
}

void diagHeader(String* o, bool on, str level, str code, str msg)
{
    if (on)
    {
        o->colorOn(true, diagLevelSeq(level));
        o->outBytes(level);
        o->colorOff(true);
    }
    else
    {
        o->outBytes(level);
    }
    if (code.len > 0)
    {
        o->colorOn(on, "[35m");
        o->pushByte(91);
        o->outBytes(code);
        o->pushByte(93);
        o->colorOff(on);
    }
    o->outBytes(": ");
    o->outBytes(msg);
    o->pushByte(10);
}

void diagLocation(String* o, bool on, usize numW, DiagLine* l)
{
    diagSpaces(o, numW);
    o->pushByte(32);
    o->colorOn(on, "[90m");
    o->outBytes("╭─▸ ");
    o->colorOff(on);
    o->outBytes(l->path);
    o->pushByte(58);
    o->outUint(l->line);
    o->pushByte(58);
    o->outUint(l->col);
    o->pushByte(10);
}

void diagBlank(String* o, bool on, usize numW)
{
    diagSpaces(o, numW);
    diagDim(o, on, " │");
    o->pushByte(10);
}

void diagFold(String* o, bool on, usize numW)
{
    diagSpaces(o, numW);
    diagDim(o, on, " ⋮");
    o->pushByte(10);
}

void diagSourceLine(String* o, bool on, usize numW, DiagLine* l)
{
    o->colorOn(on, "[90m");
    o->outPad(l->line, numW);
    o->colorOff(on);
    diagDim(o, on, " │ ");
    o->outBytes(l->text);
    o->pushByte(10);
}

void diagCaret(String* o, bool on, usize numW, DiagLine* l, bool primary, str prefix, str seq)
{
    usize col = l->col > 0 ? l->col - 1 : 0;
    diagSpaces(o, numW);
    diagDim(o, on, " │ ");
    diagSpaces(o, col);
    o->colorOn(on, primary ? seq : "[1;35m");
    o->outBytes("┬");
    usize n = diagWordLen(l->text, l->col);
    usize d = n > 1 ? n - 1 : 1;
    usize i = 0;
    while (i < d) { o->outBytes("─"); i++; }
    o->colorOff(on);
    o->pushByte(10);

    if (l->label.len == 0) return;
    diagSpaces(o, numW);
    o->pushByte(32);
    diagDim(o, on, "╰─ ");
    o->colorOn(on, primary ? "[36m" : "[35m");
    o->outBytes(prefix);
    o->outBytes(l->label);
    o->colorOff(on);
    o->pushByte(10);
}

void diagFooter(String* o, bool on, usize numW, str mark, str head, str text, str seq)
{
    diagSpaces(o, numW);
    diagDim(o, on, " ");
    diagDim(o, on, mark);
    o->pushByte(32);
    o->colorOn(on, seq);
    o->outBytes(head);
    o->outBytes(text);
    o->colorOff(on);
    o->pushByte(10);
}

void diagDiffLine(String* o, bool on, usize numW, DiagLine* l, bool plus, str text)
{
    diagSpaces(o, numW);
    diagDim(o, on, " │ ");
    o->colorOn(on, "[90m");
    o->outPad(l->line, numW);
    o->colorOff(on);
    diagDim(o, on, " │ ");
    o->colorOn(on, plus ? "[32m" : "[31m");
    o->outBytes(plus ? "+ " : "- ");
    o->outBytes(text);
    o->colorOff(on);
    o->pushByte(10);
}

void diagShort(String* o, bool on, RenderInput* in, str hint)
{
    DiagLine* p = &in->primary;
    str path = p->path;
    if (path.len > 0)
    {
        o->outBytes(path);
        o->pushByte(58);
        o->outUint(p->line);
        o->pushByte(58);
        o->outUint(p->col);
        o->outBytes("  ");
    }
    if (on)
    {
        o->colorOn(true, diagLevelSeq(in->level));
        o->outBytes(in->level);
        o->colorOff(true);
    }
    else
    {
        o->outBytes(in->level);
    }
    if (in->code.len > 0)
    {
        o->colorOn(on, "[35m");
        o->pushByte(91);
        o->outBytes(in->code);
        o->pushByte(93);
        o->colorOff(on);
    }
    o->outBytes("  ");
    o->outBytes(in->msg);
    if (hint.len > 0)
    {
        o->outBytes("  ");
        o->colorOn(on, "[36m");
        o->outBytes("fix: ");
        o->outBytes(hint);
        o->colorOff(on);
    }
    o->pushByte(10);
}

pub void render(RenderInput* in)
{
    if (in->msg.len == 0) in->msg = "diagnostic";
    if (in->level.len == 0) in->level = "error";

    bool tty = isatty(2) == 1;
    u8 fmt = diagResolveFormat(in->format, in->ordinal, tty);
    bool on = in->colorMode == 1 || (in->colorMode == 0 && tty);

    str fallback = helpFor(in->code);
    str label = in->primary.label;
    if (label.len == 0) label = in->help;
    if (label.len == 0) label = fallback;
    str helpBlock = in->help;
    if (diagSame(helpBlock, label)) helpBlock = "";
    in->primary.label = label;

    String o = String::new();

    if (fmt == 3)
    {
        str hint = in->fix;
        if (hint.len == 0) hint = label;
        diagShort(&o, on, in, hint);
        write(2, (const cchar*)o.ptr, o.len);
        return;
    }

    diagHeader(&o, on, in->level, in->code, in->msg);

    if (in->primary.path.len == 0)
    {
        if (label.len > 0)
        {
            o.colorOn(on, "[36m");
            o.outBytes(label);
            o.colorOff(on);
            o.pushByte(10);
        }
        if (in->code.len > 0)
        {
            diagDim(&o, on, "docs: coralc --explain ");
            diagDim(&o, on, in->code);
            o.pushByte(10);
        }
        write(2, (const cchar*)o.ptr, o.len);
        return;
    }

    usize numW = digits(in->primary.line);
    if (in->hasRef && in->reference.line > 0)
    {
        usize rw = digits(in->reference.line);
        if (rw > numW) numW = rw;
    }
    if (numW < 2) numW = 2;

    diagLocation(&o, on, numW, &in->primary);
    diagBlank(&o, on, numW);

    bool refFrame = fmt == 1 && in->hasRef && in->reference.path.len > 0 &&
                    in->reference.line > 0 && in->reference.line != in->primary.line;
    if (refFrame)
    {
        if (in->primary.line > in->reference.line + 1) diagFold(&o, on, numW);
        diagSourceLine(&o, on, numW, &in->reference);
        diagCaret(&o, on, numW, &in->reference, false, "reference: ", "[1;35m");
        diagBlank(&o, on, numW);
    }

    diagSourceLine(&o, on, numW, &in->primary);
    diagCaret(&o, on, numW, &in->primary, true, "", diagLevelSeq(in->level));

    if (fmt == 1)
    {
        bool hasDocs = in->code.len > 0;
        bool hasHelp = helpBlock.len > 0;
        bool hasDiff = in->hasDiff;
        if (hasHelp || hasDiff || hasDocs) diagBlank(&o, on, numW);
        if (hasHelp)
        {
            str mark = hasDocs || hasDiff ? "├─" : "╰─";
            diagFooter(&o, on, numW, mark, "help: ", helpBlock, "[36m");
            if (hasDocs || hasDiff) diagBlank(&o, on, numW);
        }
        if (hasDiff)
        {
            diagDiffLine(&o, on, numW, &in->primary, false, in->diffOld);
            diagDiffLine(&o, on, numW, &in->primary, true, in->diffNew);
            if (hasDocs) diagBlank(&o, on, numW);
        }
        if (hasDocs)
        {
            diagFooter(&o, on, numW, "╰─", "docs: coralc --explain ", in->code, "[90m");
        }
    }
    else if (in->hasRef && in->reference.path.len > 0)
    {
        diagSpaces(&o, numW);
        diagDim(&o, on, " ╰─ ");
        o.colorOn(on, "[35m");
        o.outBytes("ref: ");
        o.colorOff(on);
        o.outBytes(in->reference.label);
        o.outBytes(" at ");
        o.outBytes(diagBaseName(in->reference.path));
        o.pushByte(58);
        o.outUint(in->reference.line);
        o.pushByte(10);
    }

    write(2, (const cchar*)o.ptr, o.len);
}
