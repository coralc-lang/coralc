#[[no_drop_all]]
/* diagnostics/error.crl: the renderer.
 *
 * Every diagnostic funnels through here. The engine resolves a SourceLoc to
 * (file, line, col) via its file table, extracts the error line and the line
 * before it, and passes the pieces in with a stable code string, a level, a
 * message, and an optional help line. If no help is given, a default one is
 * looked up from the code.
 *
 * Output shape (stderr; colours only on a tty):
 *   error[SYN-1002]: expected ';', found '}'
 *     ┌─► g.c:3:1
 *     │
 *     │  2 │     l
 *     │  3 │ }
 *     |      ▲
 *     │      ╰─ a closing delimiter or required token is missing; check the surrounding grammar
 *     │      ╰─ try `coralc --explain SYN-1002` for more information
 */

import(lib) platform::libc { write, isatty };
import(lib) std::text::string { String };

// this file's own mini-printf, bolted onto String

extend String {
    void outBytes(str s)
    {
        if (self.len == 0) return;
        self.pushView(s);
    }

    void outUint(usize v)
    {
        if (v == 0) { self.pushByte(48); return; }
        // emit digits most-significant first: find the largest power of 10 <= v
        usize div = 1;
        while (v / div >= 10) div *= 10;
        while (div > 0)
        {
            usize d = (v / div) % 10;
            self.pushByte((u8)(48 + d));
            div /= 10;
        }
    }
    
    // right-align `v` in a field of width `w`
    void outPad(usize v, usize w)
    {
        usize d = 1;
        usize t = v;
        while (t >= 10) { t /= 10; d++; }
        while (d < w) { self.pushByte(32); d++; }
        self.outUint(v);
    }

    void colorOn(bool use, str seq)
    {
        if (!use) return;
        self.pushByte(27);
        self.pushView(seq);
    }
    
    void colorOff(bool use)
    {
        if (!use) return;
        self.pushByte(27);
        self.pushView("[0m");
    }
}

// digit count for field padding (outPad and the gutter both need it)
usize digits(usize v)
{
    usize d = 1;
    while (v >= 10) { v /= 10; d++; }
    return d;
}

// default help lines, keyed by the stable code string

pub str helpFor(str code)
{
    if (code.len == 0) return str::empty();
    if (code.equals("L0001")) return "remove the stray character, or escape it if it belongs in a literal";
    if (code.equals("L0002")) return "close the string with a matching quote";
    if (code.equals("L0003")) return "close the character literal with a matching quote";
    if (code.equals("L0004")) return "close the comment with its terminator";
    if (code.equals("L0005")) return "valid escapes are \\n \\r \\t \\\\ \\' \\\" \\0 \\xNN";
    if (code.equals("L0006")) return "use digits in the matching base, then an optional suffix";
    if (code.equals("L0007")) return "this character cannot start a token";
    if (code.equals("P0001")) return "a closing delimiter or required token is missing; check the surrounding grammar";
    if (code.equals("P0002")) return "an expression is required at this position";
    if (code.equals("P0003")) return "a type name is required at this position";
    if (code.equals("P0004")) return "a declaration here must be a function, var, const, struct or a type";
    if (code.equals("P0005")) return "expected a statement";
    if (code.equals("P0006")) return "the file ended before this construct was closed";
    if (code.equals("P0007")) return "only variables, fields and paths can be assigned to";
    if (code.equals("P0008")) return "each modifier (pub, extern, ...) may appear only once";
    if (code.equals("P0009")) return "statements and declarations end with ';'";
    if (code.equals("P0010")) return "conditions must be explicit — move the assignment out of the condition";
    if (code.equals("P0011")) return "an import path is a bare name (sibling file) or a module path such as name::item";
    if (code.equals("T0001")) return "check the spelling, or import the module that declares this name";
    if (code.equals("T0002")) return "convert one side with an explicit cast, or fix the operand types";
    if (code.equals("T0003")) return "check the number and types of arguments against the declaration";
    if (code.equals("T0004")) return "rename one of the duplicate declarations";
    if (code.equals("T0005")) return "this cast is not allowed between these types";
    if (code.equals("T0006")) return "the type has no member with this name";
    if (code.equals("T0007")) return "internal type-checker failure — please report this";
    if (code.equals("T0008")) return "assign only to variables, fields and elements — constants cannot be reassigned";
    if (code.equals("T0009")) return "an integer is not implicitly a pointer; cast with `as rawptr` or use a pointer value";
    if (code.equals("T0010")) return "the literal does not fit the target type; use a wider type or a smaller value";
    if (code.equals("T0011")) return "add a `return` on every path, or make the function return void";
    if (code.equals("T0012")) return "remove the local, use it, or name it `_name` to mark it intentionally unused";
    if (code.equals("T0013")) return "the index is outside the array; check the bound or the index expression";
    if (code.equals("E0103")) return "this character looks like an ASCII character but is not; replace it with the ASCII spelling";
    if (code.equals("E0104")) return "attributes must sit directly above a declaration, before its modifiers";
    if (code.equals("E1301")) return "the type has a drop method; let scope exit run it instead of calling drop explicitly";
    if (code.equals("G0001")) return "this construct cannot be lowered to the current target";
    if (code.equals("G0002")) return "internal codegen failure — please report this";
    if (code.equals("D0001")) return "check the path, or pass an existing file";
    if (code.equals("D0002")) return "run `coralc --help` for the list of accepted flags";
    if (code.equals("D0003")) return "the compiler could not allocate memory";
    if (code.equals("404-0000")) return "internal diagnostic code; please report this";
    return str::empty();
}

// the one entry point: format and dump to stderr

pub void render(str code, str level, str msg,
                str file, usize line, usize col,
                str prevText, usize prevLineNo,
                str lineText, str help)
{
    if (msg.len == 0) msg = "diagnostic";
    if (level.len == 0) level = "error";
    if (code.len == 0) code = "";
    bool hasLoc = file.len > 0;
    if (file.len == 0) file = "unknown";
    if (help.len == 0) help = helpFor(code);

    bool use = isatty(2) == 1;
    bool hasCode = code.len > 0;

    String o = String::new();

    // header: error[CODE]: message
    // cheap severity sniff off the level string's first byte: 'w'arning
    // yellow, 'e'rror red, anything else (note) cyan
    str lvlSeq = "[1;31m";
    if (level.ptr[0] == 119) lvlSeq = "[33m";       // w... = warning
    else if (level.ptr[0] != 101) lvlSeq = "[36m";  // note / other
    o.colorOn(use, lvlSeq);
    o.outBytes(level);
    o.colorOff(use);
    
    if (hasCode) {
        o.colorOn(use, "[35m");
        o.pushByte(91);
        o.outBytes(code);
        o.pushByte(93);
        o.colorOff(use);
    }
    
    o.outBytes(": ");
    o.outBytes(msg);
    o.pushByte(10);

    usize caretSpaces = 0;
    usize s = 0;

    // location line
    if (hasLoc)
    {
    o.colorOn(use, "[90m");
    o.outBytes("  ┌─► ");
    o.colorOff(use);
    o.outBytes(file);
    o.pushByte(58);
    o.outUint(line);
    o.pushByte(58);
    o.outUint(col);
    o.pushByte(10);

    // blank gutter
    o.colorOn(use, "[90m");
    o.outBytes("  │\n");
    o.colorOff(use);

    // source context: the line before (if any) and the error line
    usize numW = digits(line);
    if (prevLineNo != 0)
    {
        usize pw = digits(prevLineNo);
        if (pw > numW) numW = pw;
    }
    if (numW < 2) numW = 2;

    if (prevLineNo != 0 && prevText.len > 0)
    {
        o.colorOn(use, "[90m");
        o.outBytes("  │ ");
        o.colorOff(use);
        o.outPad(prevLineNo, numW);
        o.colorOn(use, "[90m");
        o.outBytes(" │ ");
        o.colorOff(use);
        o.outBytes(prevText);
        o.pushByte(10);
    }

    o.colorOn(use, "[90m");
    o.outBytes("  │ ");
    o.colorOff(use);
    o.outPad(line, numW);
    o.colorOn(use, "[90m");
    o.outBytes(" │ ");
    o.colorOff(use);
    if (lineText.len > 0) o.outBytes(lineText);
    o.pushByte(10);

    // caret under the error column; source text starts at 4 + numW + 3
    // ("  │ " gutter + right-aligned number + " │ "). col is 1-based, and
    // the -4 comps the caret line's "  |" being one column shorter
    usize prefixLen = 4 + numW + 3;
    if (prefixLen + col > 4) caretSpaces = prefixLen + col - 4;
    o.colorOn(use, "[90m");
    o.outBytes("  |");
    o.colorOff(use);
    s = 0;
    while (s < caretSpaces) { o.pushByte(32); s++; }
    o.colorOn(use, "[1;31m");
    o.outBytes("▲");
    o.colorOff(use);
    o.pushByte(10);
    }

    // help line
    if (help.len > 0)
    {
        if (hasLoc)
        {
            o.colorOn(use, "[90m");
            o.outBytes("  │");
            o.colorOff(use);
            s = 0;
            while (s < caretSpaces) { o.pushByte(32); s++; }
            o.colorOn(use, "[90m");
            o.outBytes("╰─ ");
            o.colorOff(use);
        }
        o.colorOn(use, "[36m");
        o.outBytes(help);
        o.colorOff(use);
        o.pushByte(10);
    }

    // explain line
    if (hasCode)
    {
        if (hasLoc)
        {
            o.colorOn(use, "[90m");
            o.outBytes("  │");
            o.colorOff(use);
            s = 0;
            while (s < caretSpaces) { o.pushByte(32); s++; }
            o.colorOn(use, "[90m");
            o.outBytes("╰─ ");
            o.colorOff(use);
        }
        o.colorOn(use, "[90m");
        o.outBytes("try `coralc --explain ");
        o.outBytes(code);
        o.outBytes("` for more information");
        o.colorOff(use);
        o.pushByte(10);
    }

    // straight to fd 2: no buffering, no logger dependency
    write(2, o.ptr, o.len);
}
