#[[no_drop_all]]
/* diagnostics/code.crl: ErrorCode enum and its stable string codes
 *
 * the enum's order is not a contract; nothing should depend on it. the
 * user-visible identity is the string from codeStr below ("P0001" etc.);
 * that's what diagnostics print and --explain matches. the old Clang-y
 * 1000-1999 numeric ranges were abandoned in favor of letters:
 * L lexer, P parser, T typecheck, G codegen, D driver.
 */

/* how a diagnostic is best fixed:
 *   Replace — one span can be rewritten; a diff is meaningful
 *   Advice  — add/remove/restructure; prose is the only honest fix
 *   None    — internal/fatal, no user fix
 * T0006 is the canonical Replace case (`->` replaces `.`); unknown
 * member/case names also belong here because the replacement is a name. */
pub enum FixClass
{
    None,
    Advice,
    Replace
}

pub enum ErrorCode
{
    // DiagXXXX entries are scaffolding; the intended descriptive name is in the trailing comment.
    // lexer
    LexUnknownChar,
    LexUnterminatedString,
    LexUnterminatedChar,
    LexUnterminatedComment,
    LexInvalidEscape,
    LexInvalidNumber,
    LexInvalidChar,
    LexHomoglyph,
