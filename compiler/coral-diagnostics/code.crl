/* every diagnostic belongs to one of the three classes above. Replace
 * means a concrete localized edit exists (insert, rewrite or delete the
 * highlighted span); Advice means the fix needs judgement or restructuring,
 * so prose is the honest form. Internal/fatal codes are None. */
pub FixClass fixClassFor(ErrorCode code)
{
    switch (code)
    {
        // Replace: a concrete token/name/expression edit at the span
        ErrorCode::LexInvalidEscape => { return FixClass::Replace; },
        ErrorCode::LexInvalidNumber => { return FixClass::Replace; },
        ErrorCode::LexHomoglyph => { return FixClass::Replace; },
        ErrorCode::ParseExpectedToken => { return FixClass::Replace; },
        ErrorCode::ParseDuplicateModifier => { return FixClass::Replace; },
        ErrorCode::ParseMissingSemicolon => { return FixClass::Replace; },
        ErrorCode::ParseCondAssign => { return FixClass::Replace; },
        ErrorCode::ParseUnknownAttr => { return FixClass::Replace; },
        ErrorCode::ParseExplicitSelfParam => { return FixClass::Replace; },
        ErrorCode::ParseUnexpectedClosingToken => { return FixClass::Replace; },
        ErrorCode::ParseExpectedSizeof => { return FixClass::Replace; },
        ErrorCode::ParseDuplicateAttr => { return FixClass::Replace; },
        ErrorCode::ParseKeywordAsIdent => { return FixClass::Replace; },
        ErrorCode::ParseUnsupportedFeature => { return FixClass::Replace; },
        ErrorCode::SemaUndeclaredIdent => { return FixClass::Replace; },
        ErrorCode::SemaUnknownMember => { return FixClass::Replace; },
        ErrorCode::SemaLiteralOverflow => { return FixClass::Replace; },
        ErrorCode::SemaIndexOutOfBounds => { return FixClass::Replace; },
        ErrorCode::DriverFileNotFound => { return FixClass::Replace; },
        ErrorCode::DriverInvalidFlag => { return FixClass::Replace; },

        // Advice: the fix is prose, or needs a structural change
        ErrorCode::LexUnknownChar => { return FixClass::Advice; },
        ErrorCode::LexUnterminatedString => { return FixClass::Advice; },
        ErrorCode::LexUnterminatedChar => { return FixClass::Advice; },
        ErrorCode::LexUnterminatedComment => { return FixClass::Advice; },
        ErrorCode::LexInvalidChar => { return FixClass::Advice; },
        ErrorCode::LexMalformedRawString => { return FixClass::Advice; },
        ErrorCode::ParseExpectedExpr => { return FixClass::Advice; },
        ErrorCode::ParseExpectedType => { return FixClass::Advice; },
        ErrorCode::ParseExpectedDecl => { return FixClass::Advice; },
        ErrorCode::ParseExpectedStmt => { return FixClass::Advice; },
        ErrorCode::ParseUnexpectedEof => { return FixClass::Advice; },
        ErrorCode::ParseInvalidAssignTarget => { return FixClass::Advice; },
        ErrorCode::ParseInvalidImportPath => { return FixClass::Advice; },
        ErrorCode::ParseMisplacedAttr => { return FixClass::Advice; },
        ErrorCode::ParseTooManyForBindings => { return FixClass::Advice; },
        ErrorCode::ParseExpectedSwitchPattern => { return FixClass::Advice; },
        ErrorCode::ParseNoFlagArm => { return FixClass::Advice; },
        ErrorCode::ParseExpectedArraySize => { return FixClass::Advice; },
        ErrorCode::ParseExpectedTupleType => { return FixClass::Advice; },
        ErrorCode::ParseExpectedStrExpr => { return FixClass::Advice; },
        ErrorCode::ParseDocCommentOnStmt => { return FixClass::Advice; },
        ErrorCode::ParseArrayDeclaratorRemoved => { return FixClass::Advice; },
        ErrorCode::SemaTypeMismatch => { return FixClass::Advice; },
        ErrorCode::SemaArityMismatch => { return FixClass::Advice; },
        ErrorCode::SemaDuplicateDecl => { return FixClass::Advice; },
        ErrorCode::SemaInvalidCast => { return FixClass::Advice; },
        ErrorCode::SemaInvalidAssignTarget => { return FixClass::Advice; },
        ErrorCode::SemaIntToPtr => { return FixClass::Advice; },
        ErrorCode::SemaExplicitDrop => { return FixClass::Advice; },
        ErrorCode::SemaMissingReturn => { return FixClass::Advice; },
        ErrorCode::SemaUnusedVar => { return FixClass::Advice; },
        ErrorCode::ComptimeError => { return FixClass::Advice; },
        ErrorCode::SemaNonConstArraySize => { return FixClass::Advice; },
        ErrorCode::SemaUnreachableCode => { return FixClass::Advice; },
        ErrorCode::SemaSelfAssign => { return FixClass::Advice; },
        ErrorCode::SemaNonExhaustiveSwitch => { return FixClass::Advice; },
        ErrorCode::SemaUnreachableSwitchCase => { return FixClass::Advice; },
        ErrorCode::SemaIterProtocol => { return FixClass::Advice; },
        ErrorCode::SemaUnknownSwitchConstant => { return FixClass::Advice; },
        ErrorCode::SemaNeedsReceiver => { return FixClass::Advice; },
        ErrorCode::SemaMalformedImportPath => { return FixClass::Advice; },
        ErrorCode::SemaBrokenDeclaration => { return FixClass::Advice; },
        ErrorCode::CodegenUnsupported => { return FixClass::Advice; },

        // None: compiler bugs / process failures, the user cannot fix them
        ErrorCode::SemaInternal => { return FixClass::None; },
        ErrorCode::CodegenInternal => { return FixClass::None; },
        ErrorCode::DriverOutOfMemory => { return FixClass::None; },

        else => { return FixClass::Advice; }
    }
}

/* stable diagnostic codes: call sites report one of these (plus a
 * location and an optional help line); error.crl renders everything.
 *   LXXXX  lexer
 *   PXXXX  parser
 *   TXXXX   type check / semantic analysis
 *   GXXXX   codegen
 *   DXXXX  driver
 */
 
pub str codeStr(ErrorCode code)
{
    switch (code)
    {
        ErrorCode::LexUnknownChar => { return "L0001"; },
        ErrorCode::LexUnterminatedString => { return "L0002"; },
        ErrorCode::LexUnterminatedChar => { return "L0003"; },
        ErrorCode::LexUnterminatedComment => { return "L0004"; },
        ErrorCode::LexInvalidEscape => { return "L0005"; },
        ErrorCode::LexInvalidNumber => { return "L0006"; },
        ErrorCode::LexInvalidChar => { return "L0007"; },
        ErrorCode::LexHomoglyph => { return "L0009"; },
        ErrorCode::LexMalformedRawString => { return "L0008"; },
        ErrorCode::DiagL0010 => { return "L0010"; },
        
        ErrorCode::ParseExpectedToken => { return "P0001"; },
        ErrorCode::ParseExpectedExpr => { return "P0002"; },
        ErrorCode::ParseExpectedType => { return "P0003"; },
        ErrorCode::ParseExpectedDecl => { return "P0004"; },
        ErrorCode::ParseExpectedStmt => { return "P0005"; },
        ErrorCode::ParseUnexpectedEof => { return "P0006"; },
        ErrorCode::ParseInvalidAssignTarget => { return "P0007"; },
        ErrorCode::ParseDuplicateModifier => { return "P0008"; },
        ErrorCode::ParseMissingSemicolon => { return "P0009"; },
        ErrorCode::ParseCondAssign => { return "P0010"; },
        ErrorCode::ParseInvalidImportPath => { return "P0011"; },
        ErrorCode::ParseMisplacedAttr => { return "P0022"; },
        ErrorCode::ParseUnknownAttr => { return "P0012"; },
        ErrorCode::ParseExplicitSelfParam => { return "P0013"; },
        ErrorCode::ParseUnexpectedClosingToken => { return "P0014"; },
        ErrorCode::ParseTooManyForBindings => { return "P0015"; },
        ErrorCode::ParseExpectedSwitchPattern => { return "P0016"; },
        ErrorCode::ParseNoFlagArm => { return "P0017"; },
        ErrorCode::ParseExpectedSizeof => { return "P0018"; },
        ErrorCode::ParseExpectedArraySize => { return "P0019"; },
        ErrorCode::ParseExpectedTupleType => { return "P0020"; },
        ErrorCode::ParseExpectedStrExpr => { return "P0021"; },
        ErrorCode::ParseDuplicateAttr => { return "P0024"; },
        ErrorCode::ParseDocCommentOnStmt => { return "P0023"; },
        ErrorCode::ParseArrayDeclaratorRemoved => { return "P0025"; },
        ErrorCode::ParseKeywordAsIdent => { return "P0026"; },
        ErrorCode::ParseUnsupportedFeature => { return "P0030"; },
        ErrorCode::DiagP0027 => { return "P0027"; },
        ErrorCode::DiagP0028 => { return "P0028"; },
        ErrorCode::DiagP0029 => { return "P0029"; },
        ErrorCode::DiagP0030 => { return "P0030"; },
        
        ErrorCode::SemaUndeclaredIdent => { return "T0001"; },
