#[[no_drop_all]]
/* diagnostics/code.crl: ErrorCode enum and its stable string codes
 *
 * the enum's order is not a contract; nothing should depend on it. the
 * user-visible identity is the string from codeStr below ("P0001" etc.);
 * that's what diagnostics print and --explain matches. the old Clang-y
 * 1000-1999 numeric ranges were abandoned in favor of letters:
 * L lexer, P parser, T typecheck, G codegen, D driver.
 */

pub enum ErrorCode
{
    // lexer
    LexUnknownChar,
    LexUnterminatedString,
    LexUnterminatedChar,
    LexUnterminatedComment,
    LexInvalidEscape,
    LexInvalidNumber,
    LexInvalidChar,
    LexHomoglyph,

    // parser
    ParseExpectedToken,
    ParseExpectedExpr,
    ParseExpectedType,
    ParseExpectedDecl,
    ParseExpectedStmt,
    ParseUnexpectedEof,
    ParseInvalidAssignTarget,
    ParseDuplicateModifier,
    ParseMissingSemicolon,
    ParseCondAssign,
    ParseInvalidImportPath,
    ParseMisplacedAttr,
    ParseUnknownAttr,
    ParseExplicitSelfParam,
    ParseUnexpectedClosingToken,
    ParseTooManyForBindings,
    ParseExpectedSwitchPattern,
    ParseNoFlagArm,
    ParseExpectedSizeof,
    ParseExpectedArraySize,
    ParseExpectedTupleType,
    ParseExpectedStrExpr,

    // semantics
    SemaUndeclaredIdent,
    SemaTypeMismatch,
    SemaArityMismatch,
    SemaDuplicateDecl,
    SemaInvalidCast,
    SemaUnknownMember,
    SemaInternal,
    SemaInvalidAssignTarget,
    SemaIntToPtr,
    SemaExplicitDrop,
    SemaLiteralOverflow,
    SemaMissingReturn,
    SemaUnusedVar,
    SemaIndexOutOfBounds,
    ComptimeError,
    SemaUnknownSwitchConstant,
    SemaNonConstArraySize,

    // codegen
    CodegenUnsupported,
    CodegenInternal,

    // driver
    DriverFileNotFound,
    DriverInvalidFlag,
    DriverOutOfMemory
}

/* stable diagnostic codes: call sites report one of these (plus a
 * location and an optional help line); error.crl renders everything.
 *   LXXXX  lexer
 *   PXXXX  parser
 *   TXXXX   type check / semantic analysis
 *   GXXXX   codegen
 *   DXXXX  driver
 */
 
str codeStr(ErrorCode code)
{
    switch (code)
    {
        ErrorCode::LexUnknownChar => { return "L0001"; },
        ErrorCode::LexUnterminatedString => { return "L0002"; },
        ErrorCode::LexUnterminatedChar => { return "L0003"; },
        ErrorCode::LexUnterminatedComment => { return "L0004"; },
        ErrorCode::LexInvalidEscape => { return "L0005"; },
        ErrorCode::LexInvalidNumber => { return "L0006"; },
        ErrorCode::LexInvalidChar => { return "L0007"; },
        ErrorCode::LexHomoglyph => { return "E0103"; },
        ErrorCode::ParseExpectedToken => { return "P0001"; },
        ErrorCode::ParseExpectedExpr => { return "P0002"; },
        ErrorCode::ParseExpectedType => { return "P0003"; },
        ErrorCode::ParseExpectedDecl => { return "P0004"; },
        ErrorCode::ParseExpectedStmt => { return "P0005"; },
        ErrorCode::ParseUnexpectedEof => { return "P0006"; },
        ErrorCode::ParseInvalidAssignTarget => { return "P0007"; },
        ErrorCode::ParseDuplicateModifier => { return "P0008"; },
        ErrorCode::ParseMissingSemicolon => { return "P0009"; },
        ErrorCode::ParseCondAssign => { return "P0010"; },
        ErrorCode::ParseInvalidImportPath => { return "P0011"; },
        ErrorCode::ParseMisplacedAttr => { return "E0104"; },
        ErrorCode::SemaUndeclaredIdent => { return "T0001"; },
        ErrorCode::SemaTypeMismatch => { return "T0002"; },
        ErrorCode::SemaArityMismatch => { return "T0003"; },
        ErrorCode::SemaDuplicateDecl => { return "T0004"; },
        ErrorCode::SemaInvalidCast => { return "T0005"; },
        ErrorCode::SemaUnknownMember => { return "T0006"; },
        ErrorCode::SemaInternal => { return "T0007"; },
        ErrorCode::SemaInvalidAssignTarget => { return "T0008"; },
        ErrorCode::SemaIntToPtr => { return "T0009"; },
        ErrorCode::SemaExplicitDrop => { return "E1301"; },
        ErrorCode::SemaLiteralOverflow => { return "T0010"; },
        ErrorCode::SemaMissingReturn => { return "T0011"; },
        ErrorCode::SemaUnusedVar => { return "T0012"; },
        ErrorCode::SemaIndexOutOfBounds => { return "T0013"; },
        ErrorCode::ComptimeError => { return "T0014"; },
        ErrorCode::SemaUnknownSwitchConstant => { return "T0015"; },
        ErrorCode::SemaNonConstArraySize => { return "T0016"; },
        ErrorCode::ParseUnknownAttr => { return "P0012"; },
        ErrorCode::ParseExplicitSelfParam => { return "P0013"; },
        ErrorCode::ParseUnexpectedClosingToken => { return "P0014"; },
        ErrorCode::ParseTooManyForBindings => { return "P0015"; },
        ErrorCode::ParseExpectedSwitchPattern => { return "P0016"; },
        ErrorCode::ParseNoFlagArm => { return "P0017"; },
        ErrorCode::ParseExpectedSizeof => { return "P0018"; },
        ErrorCode::ParseExpectedArraySize => { return "P0019"; },
        ErrorCode::ParseExpectedTupleType => { return "P0020"; },
        ErrorCode::ParseExpectedStrExpr => { return "P0021"; },

        ErrorCode::CodegenUnsupported => { return "G0001"; },
        ErrorCode::CodegenInternal => { return "G0002"; },
        ErrorCode::DriverFileNotFound => { return "D0001"; },
        ErrorCode::DriverInvalidFlag => { return "D0002"; },
        ErrorCode::DriverOutOfMemory => { return "D0003"; },
        // unreachable in practice; "404-0000" is the joke, not a real code
        else => { return "404-0000"; }
    }
}
