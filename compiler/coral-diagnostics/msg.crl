#[[no_drop_all]]
/* diagnostics/msg.crl: code -> default severity and message
 *
 * getSeverity/getFormat don't touch self; they're two lookup tables that
 * happen to hang off DiagInfo. the Clang-style %0/%1 placeholder plan
 * never materialized; formats are fixed strings and the interesting
 * wording lives at call sites or in helpFor() (error.crl).
 */

import code { ErrorCode };
import ast::id { Str };

pub enum Severity
{
    Ignored,
    Note,
    Warning,
    Error,
    Fatal
}

pub struct DiagInfo
{
    ErrorCode code;
    Severity severity;
    u8* format;

    /* duplicate modifiers are the one warning here; the else keeps any
     * code nobody listed at Error, which is the safe default */
    Severity getSeverity(ErrorCode code)
    {
        switch (code)
        {
            ErrorCode::LexUnknownChar => { return Severity::Error; },
            ErrorCode::LexUnterminatedString => { return Severity::Error; },
            ErrorCode::LexUnterminatedChar => { return Severity::Error; },
            ErrorCode::LexUnterminatedComment => { return Severity::Error; },
            ErrorCode::LexInvalidEscape => { return Severity::Error; },
            ErrorCode::LexInvalidNumber => { return Severity::Error; },
            ErrorCode::LexInvalidChar => { return Severity::Error; },
            ErrorCode::LexMalformedRawString => { return Severity::Error; },
            ErrorCode::ParseExpectedToken => { return Severity::Error; },
            ErrorCode::ParseExpectedExpr => { return Severity::Error; },
            ErrorCode::ParseExpectedType => { return Severity::Error; },
            ErrorCode::ParseExpectedDecl => { return Severity::Error; },
            ErrorCode::ParseUnexpectedClosingToken => { return Severity::Error; },
            ErrorCode::ParseTooManyForBindings => { return Severity::Error; },
            ErrorCode::ParseExpectedSwitchPattern => { return Severity::Error; },
            ErrorCode::ParseNoFlagArm => { return Severity::Error; },
            ErrorCode::ParseExpectedSizeof => { return Severity::Error; },
            ErrorCode::ParseExpectedArraySize => { return Severity::Error; },
            ErrorCode::ParseExpectedTupleType => { return Severity::Error; },
            ErrorCode::ParseExpectedStrExpr => { return Severity::Error; },
            ErrorCode::ParseDuplicateAttr => { return Severity::Warning; },
            ErrorCode::ParseDocCommentOnStmt => { return Severity::Warning; },
            ErrorCode::ParseArrayDeclaratorRemoved => { return Severity::Error; },
            ErrorCode::ParseKeywordAsIdent => { return Severity::Error; },
            ErrorCode::SemaUnreachableCode => { return Severity::Warning; },
            ErrorCode::SemaSelfAssign => { return Severity::Warning; },
            ErrorCode::SemaNonExhaustiveSwitch => { return Severity::Error; },
            ErrorCode::SemaUnreachableSwitchCase => { return Severity::Warning; },
            ErrorCode::SemaIterProtocol => { return Severity::Error; },

            ErrorCode::ParseExpectedStmt => { return Severity::Error; },
            ErrorCode::ParseUnexpectedEof => { return Severity::Error; },
            ErrorCode::ParseInvalidAssignTarget => { return Severity::Error; },
            ErrorCode::ParseDuplicateModifier => { return Severity::Warning; },
            ErrorCode::ParseMissingSemicolon => { return Severity::Error; },
            ErrorCode::SemaUndeclaredIdent => { return Severity::Error; },
            ErrorCode::SemaTypeMismatch => { return Severity::Error; },
            ErrorCode::SemaArityMismatch => { return Severity::Error; },
            ErrorCode::SemaDuplicateDecl => { return Severity::Error; },
            ErrorCode::SemaInvalidCast => { return Severity::Error; },
            ErrorCode::SemaUnknownMember => { return Severity::Error; },
            ErrorCode::CodegenUnsupported => { return Severity::Error; },
            ErrorCode::CodegenInternal => { return Severity::Fatal; },
            ErrorCode::DriverFileNotFound => { return Severity::Fatal; },
            ErrorCode::DriverInvalidFlag => { return Severity::Error; },
            ErrorCode::DriverOutOfMemory => { return Severity::Fatal; },
            else => { return Severity::Error; }
        }
    }

    // bare one-liners; names, paths and expectations are added by callers
    u8* getFormat(ErrorCode code)
    {
        switch (code)
        {
            ErrorCode::LexUnknownChar => { return "unknown character"; },
            ErrorCode::LexUnterminatedString => { return "unterminated string literal"; },
            ErrorCode::LexUnterminatedChar => { return "unterminated character literal"; },
            ErrorCode::LexUnterminatedComment => { return "unterminated block comment"; },
            ErrorCode::LexInvalidEscape => { return "invalid escape sequence"; },
            ErrorCode::LexInvalidNumber => { return "invalid numeric literal"; },
            ErrorCode::LexInvalidChar => { return "invalid character literal"; },
            ErrorCode::LexMalformedRawString => { return "malformed raw string literal"; },
            ErrorCode::ParseExpectedToken => { return "expected token"; },
            ErrorCode::ParseExpectedExpr => { return "expected expression"; },
            ErrorCode::ParseExpectedType => { return "expected type"; },
            ErrorCode::ParseExpectedDecl => { return "expected declaration"; },
            ErrorCode::ParseUnexpectedClosingToken => { return "unexpected closing token"; },
            ErrorCode::ParseTooManyForBindings => { return "too many for-in bindings"; },
            ErrorCode::ParseExpectedSwitchPattern => { return "expected switch pattern"; },
            ErrorCode::ParseNoFlagArm => { return "no matching flag arm"; },
            ErrorCode::ParseExpectedSizeof => { return "malformed @sizeof"; },
            ErrorCode::ParseExpectedArraySize => { return "invalid array size"; },
            ErrorCode::ParseExpectedTupleType => { return "malformed tuple type"; },
            ErrorCode::ParseExpectedStrExpr => { return "malformed expression after `str`"; },
            ErrorCode::ParseDuplicateAttr => { return "duplicate attribute"; },
            ErrorCode::ParseDocCommentOnStmt => { return "documentation comment on a statement"; },
            ErrorCode::ParseArrayDeclaratorRemoved => { return "invalid/unsupported array declaration syntax"; },
            ErrorCode::ParseKeywordAsIdent => { return "keyword used as an identifier"; },
            ErrorCode::SemaUnreachableCode => { return "unreachable code"; },
            ErrorCode::SemaSelfAssign => { return "self-assignment has no effect"; },
            ErrorCode::SemaNonExhaustiveSwitch => { return "switch is not exhaustive"; },
            ErrorCode::SemaUnreachableSwitchCase => { return "unreachable switch case"; },
            ErrorCode::SemaIterProtocol => { return "type does not fully implement @iter"; },

            ErrorCode::ParseExpectedStmt => { return "expected statement"; },
            ErrorCode::ParseUnexpectedEof => { return "unexpected end of file"; },
            ErrorCode::ParseInvalidAssignTarget => { return "invalid assignment target"; },
            ErrorCode::ParseDuplicateModifier => { return "duplicate modifier"; },
            ErrorCode::ParseMissingSemicolon => { return "expected ';'"; },
            ErrorCode::ParseCondAssign => { return "assignment in condition"; },
            ErrorCode::ParseInvalidImportPath => { return "invalid import path"; },
            ErrorCode::ParseMisplacedAttr => { return "misplaced attribute"; },
            ErrorCode::ParseUnknownAttr => { return "unknown attribute"; },
            ErrorCode::ParseExplicitSelfParam => { return "explicit `self` parameter"; },
            ErrorCode::LexHomoglyph => { return "homoglyph character"; },
            ErrorCode::SemaUndeclaredIdent => { return "use of undeclared identifier"; },
            ErrorCode::SemaTypeMismatch => { return "type mismatch"; },
            ErrorCode::SemaArityMismatch => { return "wrong number of arguments"; },
            ErrorCode::SemaDuplicateDecl => { return "redefinition"; },
            ErrorCode::SemaInvalidCast => { return "invalid cast"; },
            ErrorCode::SemaUnknownMember => { return "no member named"; },
            ErrorCode::SemaInternal => { return "internal type-checker error"; },
            ErrorCode::SemaInvalidAssignTarget => { return "invalid assignment target"; },
            ErrorCode::SemaIntToPtr => { return "integer to pointer"; },
            ErrorCode::SemaExplicitDrop => { return "explicit drop"; },
            ErrorCode::SemaLiteralOverflow => { return "literal out of range"; },
            ErrorCode::SemaMissingReturn => { return "missing return"; },
            ErrorCode::SemaUnusedVar => { return "unused local"; },
            ErrorCode::SemaNonConstArraySize => { return "array size is not a compile-time constant"; },
            ErrorCode::SemaIndexOutOfBounds => { return "index out of bounds"; },
            ErrorCode::ComptimeError => { return "comptime evaluation error"; },
            ErrorCode::CodegenUnsupported => { return "unsupported construct in codegen"; },
            ErrorCode::CodegenInternal => { return "internal codegen error"; },
            ErrorCode::DriverFileNotFound => { return "file not found"; },
            ErrorCode::DriverInvalidFlag => { return "invalid flag"; },
            ErrorCode::DriverOutOfMemory => { return "out of memory"; },
            else => { return "unknown error"; }
        }
    }
}
