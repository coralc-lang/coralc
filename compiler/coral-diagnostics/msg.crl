#[[no_drop_all]]
/* diagnostics/msg.crl: code -> default severity and message
 *
 * getSeverity/getFormat don't touch self; they're two lookup tables that
 * happen to hang off DiagInfo. the Clang-style %0/%1 placeholder plan
 * never materialized; formats are fixed strings and the interesting
 * wording lives at call sites or in helpFor() (error.crl).
 */

use code { ErrorCode };
use ast::id { Str };

pub enum Severity
{
    Ignored,
    Note,
    Warning,
    Error,
    Fatal
}

pub struct DiagInfo
{
    ErrorCode code;
    Severity severity;
    u8* format;

    /* duplicate modifiers are the one warning here; the else keeps any
     * code nobody listed at Error, which is the safe default */
    Severity getSeverity(ErrorCode code)
    {
        switch (code)
        {
            ErrorCode::LexUnknownChar => { return Severity::Error; },
            ErrorCode::LexUnterminatedString => { return Severity::Error; },
            ErrorCode::LexUnterminatedChar => { return Severity::Error; },
            ErrorCode::LexUnterminatedComment => { return Severity::Error; },
            ErrorCode::LexInvalidEscape => { return Severity::Error; },
            ErrorCode::LexInvalidNumber => { return Severity::Error; },
            ErrorCode::LexInvalidChar => { return Severity::Error; },
            ErrorCode::LexMalformedRawString => { return Severity::Error; },
            ErrorCode::ParseExpectedToken => { return Severity::Error; },
            ErrorCode::ParseExpectedExpr => { return Severity::Error; },
            ErrorCode::ParseExpectedType => { return Severity::Error; },
            ErrorCode::ParseExpectedDecl => { return Severity::Error; },
            ErrorCode::ParseUnexpectedClosingToken => { return Severity::Error; },
            ErrorCode::ParseTooManyForBindings => { return Severity::Error; },
            ErrorCode::ParseExpectedSwitchPattern => { return Severity::Error; },
            ErrorCode::ParseNoFlagArm => { return Severity::Error; },
            ErrorCode::ParseExpectedSizeof => { return Severity::Error; },
            ErrorCode::ParseExpectedArraySize => { return Severity::Error; },
            ErrorCode::ParseExpectedTupleType => { return Severity::Error; },
            ErrorCode::ParseExpectedStrExpr => { return Severity::Error; },
            ErrorCode::ParseDuplicateAttr => { return Severity::Warning; },
            ErrorCode::ParseDocCommentOnStmt => { return Severity::Warning; },
            ErrorCode::ParseArrayDeclaratorRemoved => { return Severity::Error; },
            ErrorCode::ParseKeywordAsIdent => { return Severity::Error; },
            ErrorCode::SemaUnreachableCode => { return Severity::Warning; },
            ErrorCode::SemaSelfAssign => { return Severity::Warning; },
            ErrorCode::SemaNonExhaustiveSwitch => { return Severity::Error; },
            ErrorCode::SemaUnreachableSwitchCase => { return Severity::Warning; },
            ErrorCode::SemaIterProtocol => { return Severity::Error; },
            ErrorCode::SemaBrokenDeclaration => { return Severity::Error; },

            ErrorCode::ParseExpectedStmt => { return Severity::Error; },
            ErrorCode::ParseUnexpectedEof => { return Severity::Error; },
            ErrorCode::ParseInvalidAssignTarget => { return Severity::Error; },
            ErrorCode::ParseDuplicateModifier => { return Severity::Warning; },
            ErrorCode::ParseMissingSemicolon => { return Severity::Error; },
            ErrorCode::SemaUndeclaredIdent => { return Severity::Error; },
            ErrorCode::SemaTypeMismatch => { return Severity::Error; },
            ErrorCode::SemaArityMismatch => { return Severity::Error; },
            ErrorCode::SemaDuplicateDecl => { return Severity::Error; },
            ErrorCode::SemaInvalidCast => { return Severity::Error; },
            ErrorCode::SemaUnknownMember => { return Severity::Error; },
            ErrorCode::CodegenUnsupported => { return Severity::Error; },
            ErrorCode::CodegenInternal => { return Severity::Fatal; },
            ErrorCode::DriverFileNotFound => { return Severity::Fatal; },
            ErrorCode::DriverInvalidFlag => { return Severity::Error; },
            ErrorCode::DriverOutOfMemory => { return Severity::Fatal; },
            ErrorCode::DiagL0010 => { return Severity::Error; },
            ErrorCode::DiagP0027 => { return Severity::Error; },
            ErrorCode::DiagP0028 => { return Severity::Error; },
            ErrorCode::DiagP0029 => { return Severity::Error; },
            ErrorCode::DiagT0026 => { return Severity::Error; },
            ErrorCode::DiagT0027 => { return Severity::Warning; },
            ErrorCode::DiagT0028 => { return Severity::Error; },
            ErrorCode::DiagT0029 => { return Severity::Error; },
            ErrorCode::DiagT0030 => { return Severity::Error; },
            ErrorCode::DiagT0031 => { return Severity::Error; },
            ErrorCode::DiagT0032 => { return Severity::Error; },
            ErrorCode::DiagT0033 => { return Severity::Error; },
            ErrorCode::DiagT0034 => { return Severity::Error; },
            ErrorCode::DiagT0035 => { return Severity::Error; },
            ErrorCode::DiagT0036 => { return Severity::Error; },
            ErrorCode::DiagT0037 => { return Severity::Error; },
            ErrorCode::DiagT0038 => { return Severity::Error; },
            ErrorCode::DiagT0039 => { return Severity::Error; },
            ErrorCode::DiagT0040 => { return Severity::Error; },
            ErrorCode::DiagT0041 => { return Severity::Error; },
            ErrorCode::DiagT0042 => { return Severity::Error; },
            ErrorCode::DiagT0043 => { return Severity::Error; },
            ErrorCode::DiagT0044 => { return Severity::Error; },
            ErrorCode::DiagT0045 => { return Severity::Error; },
            ErrorCode::DiagT0046 => { return Severity::Error; },
            ErrorCode::DiagT0047 => { return Severity::Error; },
            ErrorCode::DiagT0048 => { return Severity::Error; },
            ErrorCode::DiagT0049 => { return Severity::Error; },
            ErrorCode::DiagT0050 => { return Severity::Error; },
            ErrorCode::DiagT0051 => { return Severity::Error; },
            ErrorCode::DiagT0052 => { return Severity::Error; },
            ErrorCode::DiagT0053 => { return Severity::Error; },
            ErrorCode::DiagT0054 => { return Severity::Error; },
            ErrorCode::DiagT0055 => { return Severity::Error; },
            ErrorCode::DiagT0056 => { return Severity::Error; },
            ErrorCode::DiagT0057 => { return Severity::Error; },
            ErrorCode::DiagT0058 => { return Severity::Error; },
            ErrorCode::DiagT0059 => { return Severity::Error; },
            ErrorCode::DiagT0060 => { return Severity::Error; },
            ErrorCode::DiagT0061 => { return Severity::Error; },
            ErrorCode::DiagT0062 => { return Severity::Error; },
            ErrorCode::DiagT0063 => { return Severity::Error; },
            ErrorCode::DiagT0064 => { return Severity::Error; },
            ErrorCode::DiagT0065 => { return Severity::Error; },
            ErrorCode::DiagT0066 => { return Severity::Error; },
            ErrorCode::DiagT0067 => { return Severity::Error; },
            ErrorCode::DiagT0068 => { return Severity::Error; },
            ErrorCode::DiagT0069 => { return Severity::Error; },
            ErrorCode::DiagT0070 => { return Severity::Error; },
            ErrorCode::DiagT0071 => { return Severity::Error; },
            ErrorCode::DiagT0072 => { return Severity::Error; },
            ErrorCode::DiagT0073 => { return Severity::Error; },
            ErrorCode::DiagT0074 => { return Severity::Error; },
            ErrorCode::DiagT0075 => { return Severity::Error; },
            ErrorCode::DiagT0076 => { return Severity::Error; },
            ErrorCode::DiagT0077 => { return Severity::Error; },
            ErrorCode::DiagT0078 => { return Severity::Error; },
            ErrorCode::DiagT0079 => { return Severity::Error; },
            ErrorCode::DiagT0080 => { return Severity::Error; },
            ErrorCode::DiagT0081 => { return Severity::Error; },
            ErrorCode::DiagG0003 => { return Severity::Error; },
            ErrorCode::DiagD0004 => { return Severity::Error; },
            ErrorCode::DiagD0005 => { return Severity::Error; },
            ErrorCode::DiagD0006 => { return Severity::Error; },
            ErrorCode::DiagD0007 => { return Severity::Error; },
            ErrorCode::DiagW0001 => { return Severity::Warning; },
            ErrorCode::DiagW0002 => { return Severity::Warning; },
            ErrorCode::DiagW0003 => { return Severity::Warning; },
            ErrorCode::DiagW0004 => { return Severity::Warning; },
            ErrorCode::DiagW0005 => { return Severity::Warning; },
            ErrorCode::DiagW0006 => { return Severity::Warning; },
            ErrorCode::DiagW0007 => { return Severity::Warning; },
            ErrorCode::DiagW0008 => { return Severity::Warning; },
            ErrorCode::DiagW0009 => { return Severity::Warning; },
            ErrorCode::DiagW0010 => { return Severity::Warning; },
            ErrorCode::DiagW0011 => { return Severity::Warning; },
            ErrorCode::DiagW0012 => { return Severity::Warning; },
            ErrorCode::DiagW0013 => { return Severity::Warning; },
            ErrorCode::DiagW0014 => { return Severity::Warning; },
            ErrorCode::DiagW0015 => { return Severity::Warning; },
            ErrorCode::DiagW0016 => { return Severity::Warning; },
            ErrorCode::DiagW0017 => { return Severity::Warning; },
            ErrorCode::DiagW0018 => { return Severity::Warning; },
            ErrorCode::DiagW0019 => { return Severity::Warning; },
            ErrorCode::DiagW0020 => { return Severity::Warning; },
            ErrorCode::DiagW0021 => { return Severity::Warning; },
            ErrorCode::DiagW0022 => { return Severity::Warning; },
            ErrorCode::DiagW0023 => { return Severity::Warning; },
            ErrorCode::DiagW0024 => { return Severity::Warning; },
            ErrorCode::DiagW0025 => { return Severity::Warning; },
            ErrorCode::DiagW0026 => { return Severity::Warning; },
            ErrorCode::DiagW0027 => { return Severity::Warning; },
            ErrorCode::DiagW0028 => { return Severity::Warning; },
            ErrorCode::DiagW0029 => { return Severity::Warning; },
            ErrorCode::DiagW0030 => { return Severity::Warning; },
            ErrorCode::DiagW0031 => { return Severity::Warning; },
            ErrorCode::DiagW0032 => { return Severity::Warning; },
            ErrorCode::DiagW0033 => { return Severity::Warning; },
            ErrorCode::DiagW0034 => { return Severity::Warning; },
            ErrorCode::DiagW0035 => { return Severity::Warning; },
            ErrorCode::DiagW0036 => { return Severity::Warning; },
            ErrorCode::DiagW0037 => { return Severity::Warning; },
            ErrorCode::DiagW0038 => { return Severity::Warning; },
            ErrorCode::DiagW0039 => { return Severity::Warning; },
            ErrorCode::DiagW0040 => { return Severity::Warning; },
            ErrorCode::DiagW0042 => { return Severity::Warning; },
            else => { return Severity::Error; }
        }
    }

    // bare one-liners; names, paths and expectations are added by callers
    str getFormat(ErrorCode code)
    {
        switch (code)
        {
            ErrorCode::LexUnknownChar => { return "unknown character"; },
            ErrorCode::LexUnterminatedString => { return "unterminated string literal"; },
            ErrorCode::LexUnterminatedChar => { return "unterminated character literal"; },
            ErrorCode::LexUnterminatedComment => { return "unterminated block comment"; },
            ErrorCode::LexInvalidEscape => { return "invalid escape sequence"; },
            ErrorCode::LexInvalidNumber => { return "invalid numeric literal"; },
            ErrorCode::LexInvalidChar => { return "invalid character literal"; },
            ErrorCode::LexMalformedRawString => { return "malformed raw string literal"; },
            ErrorCode::ParseExpectedToken => { return "expected token"; },
            ErrorCode::ParseExpectedExpr => { return "expected expression"; },
            ErrorCode::ParseExpectedType => { return "expected type"; },
            ErrorCode::ParseExpectedDecl => { return "expected declaration"; },
            ErrorCode::ParseUnexpectedClosingToken => { return "unexpected closing token"; },
            ErrorCode::ParseTooManyForBindings => { return "too many for-in bindings"; },
            ErrorCode::ParseExpectedSwitchPattern => { return "expected switch pattern"; },
            ErrorCode::ParseNoFlagArm => { return "no matching flag arm"; },
            ErrorCode::ParseExpectedSizeof => { return "malformed @sizeof"; },
            ErrorCode::ParseExpectedArraySize => { return "invalid array size"; },
            ErrorCode::ParseExpectedTupleType => { return "malformed tuple type"; },
            ErrorCode::ParseExpectedStrExpr => { return "malformed expression after `str`"; },
            ErrorCode::ParseDuplicateAttr => { return "duplicate attribute"; },
            ErrorCode::ParseDocCommentOnStmt => { return "documentation comment on a statement"; },
            ErrorCode::ParseArrayDeclaratorRemoved => { return "invalid/unsupported array declaration syntax"; },
            ErrorCode::ParseKeywordAsIdent => { return "keyword used as an identifier"; },
            ErrorCode::SemaUnreachableCode => { return "unreachable code"; },
            ErrorCode::SemaSelfAssign => { return "self-assignment has no effect"; },
            ErrorCode::SemaNonExhaustiveSwitch => { return "switch is not exhaustive"; },
            ErrorCode::SemaUnreachableSwitchCase => { return "unreachable switch case"; },
            ErrorCode::SemaIterProtocol => { return "type does not fully implement @iter"; },

            ErrorCode::ParseExpectedStmt => { return "expected statement"; },
            ErrorCode::ParseUnexpectedEof => { return "unexpected end of file"; },
            ErrorCode::ParseInvalidAssignTarget => { return "invalid assignment target"; },
            ErrorCode::ParseDuplicateModifier => { return "duplicate modifier"; },
            ErrorCode::ParseMissingSemicolon => { return "expected ';'"; },
            ErrorCode::ParseCondAssign => { return "assignment in condition"; },
            ErrorCode::ParseInvalidImportPath => { return "invalid import path"; },
            ErrorCode::ParseMisplacedAttr => { return "misplaced attribute"; },
            ErrorCode::ParseUnknownAttr => { return "unknown attribute"; },
            ErrorCode::ParseExplicitSelfParam => { return "explicit `self` parameter"; },
            ErrorCode::LexHomoglyph => { return "homoglyph character"; },
            ErrorCode::SemaUndeclaredIdent => { return "use of undeclared identifier"; },
            ErrorCode::SemaTypeMismatch => { return "type mismatch"; },
            ErrorCode::SemaArityMismatch => { return "wrong number of arguments"; },
            ErrorCode::SemaDuplicateDecl => { return "redefinition"; },
            ErrorCode::SemaInvalidCast => { return "invalid cast"; },
            ErrorCode::SemaUnknownMember => { return "no member named"; },
            ErrorCode::SemaInternal => { return "internal type-checker error"; },
            ErrorCode::SemaInvalidAssignTarget => { return "invalid assignment target"; },
            ErrorCode::SemaIntToPtr => { return "integer to pointer"; },
            ErrorCode::SemaExplicitDrop => { return "explicit drop"; },
            ErrorCode::SemaLiteralOverflow => { return "literal out of range"; },
            ErrorCode::SemaMissingReturn => { return "missing return"; },
            ErrorCode::SemaUnusedVar => { return "unused local"; },
            ErrorCode::SemaNonConstArraySize => { return "array size is not a compile-time constant"; },
            ErrorCode::SemaIndexOutOfBounds => { return "index out of bounds"; },
            ErrorCode::SemaBrokenDeclaration => { return "broken declaration"; },
            ErrorCode::ComptimeError => { return "comptime evaluation error"; },
            ErrorCode::CodegenUnsupported => { return "unsupported construct in codegen"; },
            ErrorCode::CodegenInternal => { return "internal codegen error"; },
            ErrorCode::DriverFileNotFound => { return "file not found"; },
            ErrorCode::DriverInvalidFlag => { return "invalid flag"; },
            ErrorCode::DriverOutOfMemory => { return "out of memory"; },
            ErrorCode::DiagL0010 => { return "character is not valid in an identifier. This matters because the grammar says the Unicode ranges are hardcoded."; },
            ErrorCode::DiagP0027 => { return "conflicting modifiers (`extern static`, and so on; P0008 only covers repeats)"; },
            ErrorCode::DiagP0028 => { return "variadic `...` must be the last parameter"; },
            ErrorCode::DiagP0029 => { return "parameters mix named and unnamed forms"; },
            ErrorCode::DiagT0026 => { return "`{type}` cannot be assigned with a brace initializer (from earlier)"; },
            ErrorCode::DiagT0027 => { return "attribute `#[[x]]` is parsed but has no effect yet. Covers `inline`, `hot`, `cold` and the other attributes the grammar says are not honored."; },
            ErrorCode::DiagT0028 => { return "condition must be `bool`, found `{type}`"; },
            ErrorCode::DiagT0029 => { return "`return` value does not match the function's return type"; },
            ErrorCode::DiagT0030 => { return "`void` function returns a value, or non-void function has `return;`"; },
            ErrorCode::DiagT0031 => { return "`var` needs an initializer it can infer a type from (none, `null`, or an empty literal)"; },
            ErrorCode::DiagT0032 => { return "`break` or `continue` outside a loop"; },
            ErrorCode::DiagT0033 => { return "operator `{op}` is not defined for `{type}` (for example unary `-` on unsigned, `!` on non-bool, `+` on structs)"; },
            ErrorCode::DiagT0034 => { return "cannot dereference or use `->` on non-pointer `{type}`"; },
            ErrorCode::DiagT0035 => { return "cannot take the address of a non-lvalue"; },
            ErrorCode::DiagT0036 => { return "`{type}` cannot be indexed, or the index is not an integer"; },
            ErrorCode::DiagT0037 => { return "`{type}` is not callable"; },
            ErrorCode::DiagT0038 => { return "`++` or `--` needs an assignable numeric operand"; },
            ErrorCode::DiagT0039 => { return "constant division by zero or shift amount out of range"; },
            ErrorCode::DiagT0040 => { return "constant expression overflows `{type}` (T0010 only covers literals)"; },
            ErrorCode::DiagT0041 => { return "the branches of `? :`, `if` or `switch` expressions have different types"; },
            ErrorCode::DiagT0042 => { return "`if` expression used as a value has no `else`"; },
            ErrorCode::DiagT0043 => { return "block used as an expression has no final value"; },
            ErrorCode::DiagT0044 => { return "struct literal is missing field `{f}` or sets it twice (unknown field stays T0006)"; },
            ErrorCode::DiagT0045 => { return "array literal elements differ in type, or the length does not match the declared size"; },
            ErrorCode::DiagT0046 => { return "tuple arity mismatch or tuple index out of range"; },
            ErrorCode::DiagT0047 => { return "use of uninitialized variable `{a}`"; },
            ErrorCode::DiagT0048 => { return "destructuring in `for` has `{n}` names but the element has `{m}` fields"; },
            ErrorCode::DiagT0049 => { return "`const` method mutates `self` or a parameter"; },
            ErrorCode::DiagT0050 => { return "cannot call a non-const method on a const receiver"; },
            ErrorCode::DiagT0051 => { return "conversion discards `const`"; },
            ErrorCode::DiagT0052 => { return "`self` used in a `static` function"; },
            ErrorCode::DiagT0053 => { return "`const` initializer is not a constant expression"; },
            ErrorCode::DiagT0054 => { return "wrong number of generic arguments (expected `{n}`)"; },
            ErrorCode::DiagT0055 => { return "generic arguments on a non-generic type, or missing on a generic one"; },
            ErrorCode::DiagT0056 => { return "cannot infer generic parameter `{T}`"; },
            ErrorCode::DiagT0057 => { return "function with a `comptime T` parameter must contain a `comptime { }` block (the grammar says \"to be enforced\")"; },
            ErrorCode::DiagT0058 => { return "`comptime` parameter cannot be given explicitly at the call site"; },
            ErrorCode::DiagT0059 => { return "runtime value used in a comptime context, or comptime evaluation limit exceeded"; },
            ErrorCode::DiagT0060 => { return "unknown intrinsic `@{name}` (P0018 only covers `@sizeof` syntax)"; },
            ErrorCode::DiagT0061 => { return "generic instantiation depth exceeded (likely infinite recursion)"; },
            ErrorCode::DiagT0062 => { return "type `{T}` contains itself and has infinite size"; },
            ErrorCode::DiagT0063 => { return "`typedef` or `distinct` cycle"; },
            ErrorCode::DiagT0064 => { return "duplicate enum value, or the value is not a constant"; },
            ErrorCode::DiagT0065 => { return "`extend {S} : {Trait}` is missing required method `{m}`"; },
            ErrorCode::DiagT0066 => { return "method `{m}` does not match the trait's signature"; },
            ErrorCode::DiagT0067 => { return "conflicting implementation, or a method duplicates an existing one on this type"; },
            ErrorCode::DiagT0068 => { return "attribute `#[[x]]` does not apply to this declaration (`packed` on a fn, `noalias` on a non-pointer, `fallthrough` outside a switch)"; },
            ErrorCode::DiagT0069 => { return "attributes `{a}` and `{b}` cannot be combined"; },
            ErrorCode::DiagT0070 => { return "pattern kind does not match the subject type (`Enum` pattern on an integer)"; },
            ErrorCode::DiagT0071 => { return "variant pattern names unknown fields or the wrong number of them"; },
            ErrorCode::DiagT0072 => { return "alternatives in an or-pattern bind different names"; },
            ErrorCode::DiagT0073 => { return "arm after `else` or `_` is unreachable (T0021 only says \"duplicate\")"; },
            ErrorCode::DiagT0074 => { return "function has no body (only `extern` may omit it), or an `extern` function has one"; },
            ErrorCode::DiagT0075 => { return "missing, duplicate, or wrongly typed `main`"; },
            ErrorCode::DiagT0076 => { return "`extern(\"C\")` signature uses a non-C-ABI type (slice, tuple by value, generic, type with methods)"; },
            ErrorCode::DiagT0077 => { return "module `{m}` has no symbol `{s}` (currently reported as T0001, which is misleading)"; },
            ErrorCode::DiagT0078 => { return "`{s}` is not `pub` and cannot be imported (also for `pub mod` re-exporting a non-pub item)"; },
            ErrorCode::DiagT0079 => { return "import cycle: `a → b → a`"; },
            ErrorCode::DiagT0080 => { return "imported names `{x}` collide with an existing declaration"; },
            ErrorCode::DiagT0081 => { return "unknown library `{lib}` in `import(lib)`"; },
            ErrorCode::DiagG0003 => { return "`{construct}` cannot be lowered yet. Covers `defer`, `asm`, and `comptime {}` stubs."; },
            ErrorCode::DiagD0004 => { return "the C backend failed. The grammar mentions \"generated C\", so a missing or failing C compiler or linker needs a driver error."; },
            ErrorCode::DiagD0005 => { return "cannot write the output file"; },
            ErrorCode::DiagD0006 => { return "invalid build manifest (`build_sys.md`)"; },
            ErrorCode::DiagD0007 => { return "unknown target"; },
            ErrorCode::DiagW0001 => { return "local variable is never read"; },
            ErrorCode::DiagW0002 => { return "parameter is never used"; },
            ErrorCode::DiagW0003 => { return "imported symbol is never used"; },
            ErrorCode::DiagW0004 => { return "non-`pub` function, const, type or `mod` is never used"; },
            ErrorCode::DiagW0005 => { return "variable is assigned but never read afterwards (dead store)"; },
            ErrorCode::DiagW0006 => { return "unreachable code (was T0018)"; },
            ErrorCode::DiagW0007 => { return "unreachable switch arm after `else`"; },
            ErrorCode::DiagW0008 => { return "generic parameter is never used"; },
            ErrorCode::DiagW0009 => { return "`comptime` parameter or block has no effect"; },
            ErrorCode::DiagW0010 => { return "no-op assignment `a = a` (was T0019)"; },
            ErrorCode::DiagW0011 => { return "condition is always true or false (`u32 < 0`, `while (1)`)"; },
            ErrorCode::DiagW0012 => { return "empty body after `if`, `while` or `for` (`if (x);`)"; },
            ErrorCode::DiagW0013 => { return "value of a must-use call is discarded"; },
            ErrorCode::DiagW0014 => { return "comparing signed with unsigned"; },
            ErrorCode::DiagW0015 => { return "implicit narrowing (`i64` to `i32`, float to int)"; },
            ErrorCode::DiagW0016 => { return "float compared with `==` or `!=`"; },
            ErrorCode::DiagW0017 => { return "shift amount is at least the type width (non-constant)"; },
            ErrorCode::DiagW0018 => { return "returning or storing the address of a local"; },
            ErrorCode::DiagW0019 => { return "variable may be uninitialized on some path (T0047 is the definite case)"; },
            ErrorCode::DiagW0020 => { return "a `switch` arm falls through without `#[[fallthrough]]`"; },
            ErrorCode::DiagW0021 => { return "variable shadows an outer one"; },
            ErrorCode::DiagW0022 => { return "redundant cast to the same type"; },
            ErrorCode::DiagW0023 => { return "a non-`const` method never mutates `self` (pedantic)"; },
            ErrorCode::DiagW0024 => { return "large struct passed by value (pedantic)"; },
            ErrorCode::DiagW0025 => { return "explicit `0` or `null` used as a pointer where `rawptr` is expected"; },
            ErrorCode::DiagW0026 => { return "same symbol is imported twice"; },
            ErrorCode::DiagW0027 => { return "`import x { };` has an empty list"; },
            ErrorCode::DiagW0028 => { return "`pub mod` re-export is never used"; },
            ErrorCode::DiagW0029 => { return "empty `struct`, `enum` or `trait`"; },
            ErrorCode::DiagW0030 => { return "variant or enum value is never constructed or matched (pedantic)"; },
            ErrorCode::DiagW0031 => { return "`#[[no_drop]]` on a type with no drop method"; },
            ErrorCode::DiagW0032 => { return "`#[[no_drop_all]]` in a user file"; },
            ErrorCode::DiagW0033 => { return "variable that needs a drop may leak because of `#[[no_drop]]` and no explicit free"; },
            ErrorCode::DiagW0034 => { return "`defer` is accepted but ignored"; },
            ErrorCode::DiagW0035 => { return "attribute has no effect yet (`inline`, `hot`, `cold`, ...)"; },
            ErrorCode::DiagW0036 => { return "deprecated syntax or API"; },
            ErrorCode::DiagW0037 => { return "`comptime {}` or `asm {}` block is parsed but not lowered"; },
            ErrorCode::DiagW0038 => { return "lookalike character inside a string or comment (L0009 stays an error in code)"; },
            ErrorCode::DiagW0039 => { return "string literal spans a newline (interim for the lexer gap)"; },
            ErrorCode::DiagW0040 => { return "`/*` inside a block comment (comments don't nest)"; },
            ErrorCode::DiagW0042 => { return "numeric literal has a confusing form (leading zero like `0755`, ambiguous suffix)"; },
            else => { return "unknown error"; }
        }
    }
}
