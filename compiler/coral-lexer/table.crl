#[[no_drop_all]]
// lexer/table.crl: identifier intern table
//
// FNV-1a, open addressing with linear probing, geometric growth at 75%
// load. entries are individually heap-allocated and never move: tokens
// hold IdentifierInfo* into them (Token.info), so a grow may swap the
// slot array but the entries themselves must stay put. the stored hash
// rejects mismatches before the byte compare, and a null slot ends the
// search early (entries are never deleted).

use common::token { TokenKind, IdentifierInfo };
import std::mman { alloc, dealloc };

pub struct IdentEntry
{
    IdentifierInfo info;
    usize hash;
}

pub struct IdentifierTable
{
    IdentEntry** slots;
    usize capacity;
    usize count;

    void init(IdentEntry** buf, usize cap)
    {
        // null slot = empty; entries are stable and never removed, so
        // there is no stale-occupied state to hide anymore
        self.slots = buf;
        self.capacity = cap;
        self.count = 0;
        for (usize i = 0; i < cap; i++)
            self.slots[i] = null;
    }

    usize hashOf(str name)
    {
        usize h = 0xcbf29ce484222325;
        for (usize i = 0; i < name.len; i++)
        {
            h ^= (usize)name.ptr[i];
             h *= 0x100000001b3;
        }
        return h;
    }

    /* rehash into a doubled slot array; entries are re-placed by their
     * stored hash — no byte compares — and &entry->info pointers held by
     * live tokens stay valid because only the pointer array moves */
    bool grow()
    {
        if (self.capacity >= (1 << 26)) return false;
        usize newCap = self.capacity * 2;
        if (newCap == 0) newCap = 256;
        IdentEntry** ns = alloc<IdentEntry*>(newCap);
        if (ns == null) return false;
        for (usize i = 0; i < newCap; i++) ns[i] = null;
        for (usize i = 0; i < self.capacity; i++)
        {
            IdentEntry* e = self.slots[i];
            if (e == null) continue;
            usize pos = e->hash & (newCap - 1);
            while (ns[pos] != null) pos = (pos + 1) & (newCap - 1);
            ns[pos] = e;
        }
        if (self.slots != null) dealloc<IdentEntry*>(self.slots);
        self.slots = ns;
        self.capacity = newCap;
        return true;
    }

    /* despite the name this is lookup-OR-insert: a miss claims an empty
     * slot and hands back the new entry. bad capacity (not a power of
     * two) or an allocation failure both come back null */
    IdentifierInfo* get(str name)
    {
        if (self.slots == null || self.capacity == 0 || (self.capacity & (self.capacity - 1)) != 0)
            return null;
        /* grow before the search so the empty slot is guaranteed under
         * the final capacity (a lookup that crosses the line grows once
         * too — harmless, the next insert would have anyway) */
        if ((self.count + 1) * 4 >= self.capacity * 3)
        {
            if (!self.grow()) return null;
        }
        usize h = self.hashOf(name);
        usize idx = h & (self.capacity - 1);

        for (usize probe = 0; probe < self.capacity; probe++)
        {
            usize pos = (idx + probe) & (self.capacity - 1);
            IdentEntry* e = self.slots[pos];

            if (e == null)
            {
                e = alloc<IdentEntry>(1);
                if (e == null) return null;
                e->info.name = name;
                // nameLen used to be its own field; the slice carries it now
                e->info.kind = TokenKind::Ident;
                e->info.isKeyword = false;
                e->hash = h;
                self.slots[pos] = e;
                self.count++;
                return &e->info;
            }

            if (e->hash == h && e->info.name.len == name.len)
            {
                bool match = true;
                for (usize i = 0; i < name.len; i++)
                {
                    if ((u8)e->info.name[i] != name.ptr[i])
                    {
                        match = false;
                        break;
                    }
                }
                if (match) return &e->info;
            }
        }
        return null;
    }

    /* free every entry plus the slot array — replaces the old
     * dealloc<IdentEntry>(entries); tokens must be dead by then (the
     * same contract the direct buffer free had) */
    void deinit()
    {
        if (self.slots != null)
        {
            for (usize i = 0; i < self.capacity; i++)
            {
                if (self.slots[i] != null) dealloc<IdentEntry>(self.slots[i]);
            }
            dealloc<IdentEntry*>(self.slots);
        }
        self.slots = null;
        self.capacity = 0;
        self.count = 0;
    }

    void addKeyword(str name, TokenKind kind)
    {
        IdentifierInfo* info = self.get(name);
        if (info != null)
        {
            info->kind = kind;
            info->isKeyword = true;
        }
    }

    // every word the lexer treats as reserved, builtins included;
    // order is irrelevant, just keeps them in one place
    void addKeywords()
    {
        self.addKeyword("if", TokenKind::If);
        self.addKeyword("as", TokenKind::As);
        self.addKeyword("mod", TokenKind::Mod);
        self.addKeyword("pub", TokenKind::Pub);
        self.addKeyword("for", TokenKind::For);
        self.addKeyword("asm", TokenKind::Asm);
        self.addKeyword("var", TokenKind::Var);
        self.addKeyword("enum", TokenKind::Enum);
        self.addKeyword("else", TokenKind::Else);
        self.addKeyword("loop", TokenKind::Loop);
        self.addKeyword("flag", TokenKind::Flag);
        self.addKeyword("true", TokenKind::True);
        self.addKeyword("null", TokenKind::Null);
        self.addKeyword("self", TokenKind::Self);
        self.addKeyword("while", TokenKind::While);
        self.addKeyword("trait", TokenKind::Trait);
        self.addKeyword("const", TokenKind::Const);
        self.addKeyword("defer", TokenKind::Defer);
        self.addKeyword("break", TokenKind::Break);
        self.addKeyword("union", TokenKind::Union);
        self.addKeyword("import", TokenKind::Import);
        self.addKeyword("use", TokenKind::Use);
        self.addKeyword("static", TokenKind::Static);
        self.addKeyword("struct", TokenKind::Struct);
        self.addKeyword("extern", TokenKind::Extern);
        self.addKeyword("switch", TokenKind::Switch);
        self.addKeyword("return", TokenKind::Return);
        self.addKeyword("extend", TokenKind::Extend);
        self.addKeyword("typedef", TokenKind::Typedef);
        self.addKeyword("variant", TokenKind::Variant);
        self.addKeyword("distinct", TokenKind::Distinct);
        self.addKeyword("continue", TokenKind::Continue);
        self.addKeyword("comptime", TokenKind::Comptime);
        self.addKeyword("volatile", TokenKind::Volatile);
        self.addKeyword("false", TokenKind::False);
        self.addKeyword("void", TokenKind::Void);
        self.addKeyword("bool", TokenKind::Bool);
        self.addKeyword("char", TokenKind::Char);
        self.addKeyword("u8", TokenKind::U8);
        self.addKeyword("u16", TokenKind::U16);
        self.addKeyword("u32", TokenKind::U32);
        self.addKeyword("u64", TokenKind::U64);
        self.addKeyword("u128", TokenKind::U128);
        self.addKeyword("i8", TokenKind::I8);
        self.addKeyword("i16", TokenKind::I16);
        self.addKeyword("i32", TokenKind::I32);
        self.addKeyword("i64", TokenKind::I64);
        self.addKeyword("i128", TokenKind::I128);
        self.addKeyword("f32", TokenKind::F32);
        self.addKeyword("f64", TokenKind::F64);
        self.addKeyword("usize", TokenKind::Usize);
        self.addKeyword("isize", TokenKind::Isize);
        self.addKeyword("rawptr", TokenKind::Rawptr);
        self.addKeyword("str", TokenKind::Str);
        self.addKeyword("sizeof", TokenKind::BuiltinSizeof);
        self.addKeyword("assert", TokenKind::BuiltinAssert);
        self.addKeyword("alignof", TokenKind::BuiltinAlignof);
        self.addKeyword("typeof", TokenKind::BuiltinTypeof);
        self.addKeyword("assertOut", TokenKind::BuiltinAssertOut);
        self.addKeyword("any", TokenKind::Any);
    }
}
