#[[no_drop_all]]

// lexer/skip_ws.crl: whitespace and comments
//
// stops at the first byte that opens a token, cursor left on it. line and
// lineStart are kept current for every byte consumed here; block comments
// do not nest. an unterminated block comment reports at its opening `/*`.

import base { Lexer };
import diag::code { ErrorCode };

pub extend Lexer
{
    void skipWsCmts()
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            switch (c)
            {
                ' ' | '\r' | '\t' => { // the bootstrap uses, but the self host needs | 
                    self.cur++; // use a comma to separate.
                },
                '\n' => {
                    self.line++;
                    self.cur++;
                    self.lineStart = self.cur;
                },
                '/' => {
                    if (self.cur + 1 < self.bufEnd && self.cur[1] == '/') {
                        // line comment: stop AT the newline, the `\n` arm eats it
                        self.cur += 2;
                        while (!self.isAtEnd() && self.cur[0] != '\n') { self.cur++; }
                    }
                    else if (self.cur + 1 < self.bufEnd &&
                             self.cur[1] == '*')
                    {
                        // non-nesting: first `*/` closes, wherever it is
                        u8* commentStart = self.cur;
                        bool closed = false;
                        self.cur += 2;
                        while (!self.isAtEnd())
                        {
                            if (self.cur[0] == '\n')
                            {
                                self.line++;
                                self.cur++;
                                self.lineStart = self.cur;
                            }
                            else if (self.cur[0] == '*' &&
                                     self.cur + 1 < self.bufEnd &&
                                     self.cur[1] == '/')
                            {
                                self.cur += 2;
                                closed = true;
                                break;
                            } else {
                                self.cur++;
                            }
                        }
                        if (!closed)
                            self.reportErrorCode(ErrorCode::LexUnterminatedComment, self.bufStart, self.bufEnd, commentStart, "unterminated block comment");
                    } else {
                        return;
                    }
                },
                // a lone `/` is the start of a token, leave it for lexOperator
                else => { return; },
            }
        }
    }
}
