#[[no_drop_all]]
// lexer/number.crl: numeric literals
//
// 0x/0b/0o prefixes, decimal, and floats with exponents ("3.142E+12").
// `_` separators are allowed anywhere in digit runs. suffix bits ride on
// the token into IntLit/FloatLit .flags; sema reads bit0 (unsigned),
// bit1 (float), and bit2 (long, which selects a 64-bit integer type).

import common { token { TokenKind, Token }, slice { Slice } };
import base { Lexer };

pub extend Lexer
{
    /* digits are re-validated here rather than trusted from the scan;
     * `_` is skipped. bad digit or overflow reports and stops, returning
     * whatever accumulated so far */
    u64 parseInteger(Slice data, u32 base)
    {
        u64 value = 0;
        usize i = 0;
        while (i < data.len)
        {
            u8 c = data.ptr[i];
            u32 digit = 0;
            if (c >= '0' && c <= '9') digit = (u32)(c - '0');
            else if (c >= 'a' && c <= 'f') digit = (u32)(c - 'a') + 10;
            else if (c >= 'A' && c <= 'F') digit = (u32)(c - 'A') + 10;
            else if (c == '_') { i++; continue; }
            else {
                self.reportError(self.bufStart, self.bufEnd, data.ptr + i, "invalid integer literal");
                break;
            }
            if (digit >= base) {
                self.reportError(self.bufStart, self.bufEnd, data.ptr + i, "invalid digit for integer base");
                break;
            }
            u64 prod = value * (u64)base;
            // wrapped on multiply; the add-one check below catches the rest
            if (value != 0 && prod / (u64)base != value) {
                self.reportError(self.bufStart, self.bufEnd, data.ptr + i, "integer literal out of range");
                break;
            }
            u64 next = prod + (u64)digit;
            if (next < prod) {
                self.reportError(self.bufStart, self.bufEnd, data.ptr + i, "integer literal out of range");
                break;
            }
            value = next;
            i++;
        }
        return value;
    }

    /* true when p sits on a token boundary (a u/U here is an unsigned
     * suffix, not the start of an identifier like `u8` or `usize`) */
    bool numSuffixBoundary(u8* p)
    {
        if (p >= self.bufEnd) return true;
        u8 c = p[0];
        bool ident = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
        return !ident;
    }

    /* Consume a numeric literal suffix: u/U (unsigned), l/L/ll (long),
     * f/F (float). `ul`/`ull` etc. combine; `uf`/`lf` after digits are
     * kept separate by numSuffixBoundary. */
    u8 lexNumSuffix(bool isFloat)
    {
        u8 flags = 0;
        u8* sufStart = self.cur;
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == 'u' || c == 'U') { flags |= 1; self.cur++; }
            else if (c == 'f' || c == 'F') { flags |= 2; self.cur++; }
            else if (c == 'l' || c == 'L') { flags |= 4; self.cur++; }
            else break;
        }
        if (self.cur > sufStart && self.numSuffixBoundary(self.cur))
        {
            if ((flags & 1) != 0 && (flags & 2) != 0)
            {
                self.reportError(self.bufStart, self.bufEnd, sufStart, "invalid mix of float and unsigned suffix");
                return 0;
            }
            if ((flags & 2) != 0 && (flags & 4) != 0)
            {
                self.reportError(self.bufStart, self.bufEnd, sufStart, "invalid mix of float and long suffix");
                return 0;
            }
            if (!isFloat && (flags & 2) != 0)
            {
                self.cur = sufStart;
                self.reportError(self.bufStart, self.bufEnd, sufStart, "float suffix on an integer literal");
                return 0;
            }
            return flags;
        }
        self.cur = sufStart;
        return 0;
    }

    // prefix only counts right after a leading 0; `0x1F` yes, `10x` no
    Token lexNumber(u8* start)
    {
        if (!self.isAtEnd() && self.cur[0] == 'x' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexHex(start);
        }
        if (!self.isAtEnd() && self.cur[0] == 'b' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexBinary(start);
        }
        if (!self.isAtEnd() && self.cur[0] == 'o' &&
            (usize)(self.cur - start) == 1 && start[0] == '0')
        {
            self.cur++;
            return self.lexOctal(start);
        }
        return self.lexDecimal(start);
    }

    /* strips the 2-byte prefix off .data (digits only), then grabs the
     * suffix and converts. the #[[fallthrough]] switch just picks the
     * base; whatever comes back from parseInteger is already bounded */
    Token makePrefixedToken(TokenKind kind, u8* start)
    {
        Token token = self.makeToken(kind, start);
        token.data.ptr = start + 2;
        token.data.len = self.cur - (start + 2);
        token.numFlags = self.lexNumSuffix(false);
        u32 base = 0;
    
        #[[fallthrough]]
        switch (kind)
        {
            TokenKind::Hex => { base = 16; },
            TokenKind::Bin => { base = 2; },
            TokenKind::Oct => { base = 8; }
        }
        if (base != 0) token.number = self.parseInteger(token.data, base);
        return token;
    }

    Token lexHex(u8* start)
    {
        if (self.isAtEnd() || !((self.cur[0] >= '0' && self.cur[0] <= '9') ||
            (self.cur[0] >= 'a' && self.cur[0] <= 'f') ||
            (self.cur[0] >= 'A' && self.cur[0] <= 'F')))
        {
            // a bare `0x` still produces a Hex token, just empty
            self.reportError(self.bufStart, self.bufEnd, start, "hex literal has no digits");
            return self.makePrefixedToken(TokenKind::Hex, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if ((c >= '0' && c <= '9') ||
                (c >= 'a' && c <= 'f') ||
                (c >= 'A' && c <= 'F') ||
                c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makePrefixedToken(TokenKind::Hex, start);
    }

    Token lexBinary(u8* start)
    {
        if (self.isAtEnd() || (self.cur[0] != '0' && self.cur[0] != '1'))
        {
            self.reportError(self.bufStart, self.bufEnd, start, "binary literal has no digits");
            return self.makePrefixedToken(TokenKind::Bin, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == '0' || c == '1' || c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makePrefixedToken(TokenKind::Bin, start);
    }

    Token lexOctal(u8* start)
    {
        if (self.isAtEnd() || self.cur[0] < '0' || self.cur[0] > '7')
        {
            self.reportError(self.bufStart, self.bufEnd, start, "octal literal has no digits");
            return self.makePrefixedToken(TokenKind::Oct, start);
        }
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if ((c >= '0' && c <= '7') || c == '_')
            {
                self.cur++;
            } else {
                break;
            }
        }
        return self.makePrefixedToken(TokenKind::Oct, start);
    }

    Token lexDecimal(u8* start)
    {
        bool isFloat = false;
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c >= '0' && c <= '9') {
                self.cur++;
            } else if (c == '.' && !isFloat) {
                // a second dot means this was `..` (range), not a float
                if (self.cur + 1 < self.bufEnd && self.cur[1] == '.') {
                    break;
                }
                isFloat = true;
                self.cur++;
            }
            else if (c == 'e' || c == 'E')
            {
                // peek past the optional sign: only commit to an exponent
                // if real digits follow, so `3e` stays int 3 + ident `e`
                u8* digits = self.cur + 1;
                if (digits < self.bufEnd && (digits[0] == '+' || digits[0] == '-')) digits++;
                u8* firstDigit = digits;
                while (digits < self.bufEnd && (digits[0] >= '0' && digits[0] <= '9')) digits++;
                if (digits == firstDigit) break;
                isFloat = true;
                self.cur = digits;
            }
            else if (c == '_') {
                self.cur++;
            } else {
                break;
            }
        }
        Token token;
        if (isFloat) token = self.makeToken(TokenKind::Float, start);
        else token = self.makeToken(TokenKind::Dec, start);
        token.numFlags = self.lexNumSuffix(isFloat);
        if (!isFloat) token.number = self.parseInteger(token.data, 10);
        return token;
    }
}
