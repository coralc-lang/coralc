#[[no_drop_all]]
// lexer/escape.crl: escape sequence decoding
//
// one function, one escape: \n \r \t plus the C set, \xNN (exactly two
// hex digits), \uNNNN, \UNNNNNNNN. does not move any cursor; callers use
// bytesConsumed to skip what was read.

pub struct EscapeResult
{
    u32 codepoint;
    usize bytesConsumed;
    bool isValid;

    static EscapeResult decodeEscapeSequence(u8* ptr, u8* end)
    {
        // default shape: two bytes (`\` + char); failures trim or zero it
        EscapeResult esc = {
            .isValid = true,
            .bytesConsumed = 2,
            .codepoint = 0
        };

        if (ptr >= end || ptr[0] != '\\') {
            esc.isValid = false;
            esc.bytesConsumed = 0;
            return esc;
        }
        if (ptr + 1 >= end) {
            esc.isValid = false;
            esc.bytesConsumed = 1;
            return esc;
        }

        u8 next = ptr[1];
        
        switch (next)
        {
            'n' => { esc.codepoint = '\n'; },
            'r' => { esc.codepoint = '\r'; },
            't' => { esc.codepoint = '\t'; },
            // C escapes, numeric because stage-0 may not lex \f/\v
            'a' => { esc.codepoint = 7; },
            'b' => { esc.codepoint = 8; },
            'f' => { esc.codepoint = 12; },
            'v' => { esc.codepoint = 11; },
            '?' => { esc.codepoint = 63; },
            '\\' => { esc.codepoint = '\\'; },
            '\'' => { esc.codepoint = '\''; },
            '"' => { esc.codepoint = '"'; },
            // octal escapes are not supported; `\0` is the only numeric
            '0' => { esc.codepoint = '\0'; },
            
            'x' => {
                // C's "as many hex digits as follow" is not a thing here:
                // exactly two, or it's invalid
                if (ptr + 4 > end) {
                    esc.isValid = false; }
                else {
                    u8 h1 = ptr[2];
                    u8 h2 = ptr[3];

                    if (!((h1 >= '0' && h1 <= '9') || ((h1 | 0x20) >= 'a' && (h1 | 0x20) <= 'f')) ||
                        !((h2 >= '0' && h2 <= '9') || ((h2 | 0x20) >= 'a' && (h2 | 0x20) <= 'f'))) {
                        esc.isValid = false; }
                    else {
                        u8 hi = (h1 >= 'a') ? (h1 - 'a' + 10) : (h1 >= 'A') ? (h1 - 'A' + 10) : (h1 - '0');
                        u8 lo = (h2 >= 'a') ? (h2 - 'a' + 10) : (h2 >= 'A') ? (h2 - 'A' + 10) : (h2 - '0');
                        esc.codepoint = (u32)((hi << 4) | lo);
                        esc.bytesConsumed = 4;
                    }
                }
            },
            
            'u' => {
                if (ptr + 6 > end) {
                    esc.isValid = false; }
                else
                {
                    u32 cp = 0;
                    bool valid = true;
                    for (usize i = 0; i < 4; i++)
                    {
                        u8 h = ptr[2 + i];
                        u8 val;
                        if (h >= '0' && h <= '9') val = h - '0';
                        else if ((h | 0x20) >= 'a' && (h | 0x20) <= 'f') val = (h | 0x20) - 'a' + 10;
                        else { valid = false; break; }
                        cp = (cp << 4) | (u32)val;
                    }
                    if (!valid) {
                        esc.isValid = false; }
                    else if (cp >= 0xD800 && cp <= 0xDFFF)
                    {
                        esc.isValid = false;
                    }
                    else
                    {
                        esc.codepoint = cp;
                        esc.bytesConsumed = 6;
                    }
                }
            },
            
            'U' => {
                if (ptr + 10 > end) {
                    esc.isValid = false; }
                else {
                    u32 cp = 0;
                    bool valid = true;
                    for (usize i = 0; i < 8; i++)
                    {
                        u8 h = ptr[2 + i];
                        u8 val;
                        if (h >= '0' && h <= '9') val = h - '0';
                        else if ((h | 0x20) >= 'a' && (h | 0x20) <= 'f') val = (h | 0x20) - 'a' + 10;
                        else { valid = false; break; }
                        cp = (cp << 4) | (u32)val;
                    }
                    if (!valid) {
                        esc.isValid = false; }
                    else if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF))
                    {
                        esc.isValid = false;
                    }
                    else
                    {
                        esc.codepoint = cp;
                        esc.bytesConsumed = 10;
                    }
                }
            },
            else => {
                // unknown escape: keep the escaped char as the codepoint
                // (so callers can still render something) but say invalid
                esc.isValid = false;
                esc.codepoint = (u32)next;
            },
        }
        return esc;
    }
}
