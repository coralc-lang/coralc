#[[no_drop_all]]
// lexer/ident.crl: UTF-8 decoding and identifier classification
//
// decodeUtf8 rejects overlongs, surrogates and out-of-range codepoints
// (outLen 0 = malformed). isXidStart/isXidContinue are a hand-trimmed XID
// table, not full UAX #31; enough for the scripts this corpus sees.

import common::token { TokenKind, Token, IdentifierInfo };
import diag::code { ErrorCode };
import base { Lexer };

/* one codepoint. outLen gets the byte count, or 0 when the sequence is
 * malformed (bad continuation bytes, overlong encoding, surrogate half,
 * beyond U+10FFFF). callers treat len 0 as "not a character" */
pub u32 decodeUtf8(u8* buf, u8* bufEnd, usize* outLen)
{
    if (buf >= bufEnd) { outLen[0] = 0; return 0; }
    u8 b0 = buf[0];
    if (b0 < 0x80) { outLen[0] = 1; return (u32)b0; }
    if (b0 < 0xC0) { outLen[0] = 0; return 0; }
    if (b0 < 0xE0) {
        if (buf + 1 >= bufEnd) { outLen[0] = 0; return 0; }
        u8 b1 = buf[1];
        if ((b1 & 0xC0) != 0x80 || b0 < 0xC2) { outLen[0] = 0; return 0; }
        outLen[0] = 2;
        u32 cp = ((u32)(b0 & 0x1F) << 6) | ((u32)(b1 & 0x3F));
        if (cp < 0x80) { outLen[0] = 0; return 0; }
        return cp;
    }
    if (b0 < 0xF0) {
        if (buf + 2 >= bufEnd) { outLen[0] = 0; return 0; }
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80) { outLen[0] = 0; return 0; }
        outLen[0] = 3;
        u32 cp = ((u32)(b0 & 0x0F) << 12) | ((u32)(b1 & 0x3F) << 6) | ((u32)(b2 & 0x3F));
        if (cp < 0x800 || (cp >= 0xD800 && cp <= 0xDFFF)) { outLen[0] = 0; return 0; }
        return cp;
    }
    if (b0 < 0xF8) {
        if (buf + 3 >= bufEnd) { outLen[0] = 0; return 0; }
        u8 b1 = buf[1];
        u8 b2 = buf[2];
        u8 b3 = buf[3];
        
        if ((b1 & 0xC0) != 0x80 || (b2 & 0xC0) != 0x80 || (b3 & 0xC0) != 0x80) { outLen[0] = 0; return 0; }
        outLen[0] = 4;
        u32 cp = ((u32)(b0 & 0x07) << 18) | ((u32)(b1 & 0x3F) << 12) | ((u32)(b2 & 0x3F) << 6) | ((u32)(b3 & 0x3F));
        if (cp < 0x10000 || cp > 0x10FFFF || (b0 == 0xF4 && b1 > 0x8F)) { outLen[0] = 0; return 0; }
        return cp;
    }
    outLen[0] = 0;
    return 0;
}

// ranges picked by hand from the XID tables; ASCII is the only exact part
pub bool isXidStart(u32 cp)
{
    if (cp < 128) return (cp | 0x20) >= 'a' && (cp | 0x20) <= 'z' || cp == '_';
    if (cp >= 0x00C0 && cp <= 0x06FF) return true;
    if (cp >= 0x0700 && cp <= 0x07BF) return true;
    if (cp >= 0x0900 && cp <= 0x0D7F) return true;
    if (cp >= 0x0E00 && cp <= 0x0EFF) return true;
    if (cp >= 0x1000 && cp <= 0x137F) return true;
    if (cp >= 0x13A0 && cp <= 0x18AF) return true;
    if (cp >= 0x1900 && cp <= 0x1A1F) return true;
    if (cp >= 0x1B00 && cp <= 0x1C7F) return true;
    if (cp >= 0x1D00 && cp <= 0x1FFF) return true;
    if (cp >= 0x2E80 && cp <= 0x31BF) return true;
    if (cp >= 0x3200 && cp <= 0x9FFF) return true;
    if (cp >= 0xA000 && cp <= 0xD7FF) return true;
    if (cp >= 0xF900 && cp <= 0xFDFF) return true;
    if (cp >= 0xFE30 && cp <= 0xFE6F) return true;
    if (cp >= 0xFF00 && cp <= 0xFFEF) return true;
    if (cp >= 0x10000 && cp <= 0x105BF) return true;
    if (cp >= 0x10600 && cp <= 0x108AF) return true;
    if (cp >= 0x108E0 && cp <= 0x109FF) return true;
    if (cp >= 0x10A00 && cp <= 0x10BAF) return true;
    if (cp >= 0x10C00 && cp <= 0x10D3F) return true;
    if (cp >= 0x10E60 && cp <= 0x1173F) return true;
    if (cp >= 0x11800 && cp <= 0x11CBF) return true;
    if (cp >= 0x11D00 && cp <= 0x11EFF) return true;
    if (cp >= 0x11F00 && cp <= 0x11FAF) return true;
    return false;
}

// start chars, digits, combining marks (the 0x0300 etc blocks)
pub bool isXidContinue(u32 cp)
{
    if (isXidStart(cp)) return true;
    if (cp < 128) return cp >= '0' && cp <= '9';
    if (cp >= 0x0300 && cp <= 0x036F) return true;
    if (cp >= 0x1AB0 && cp <= 0x1AFF) return true;
    if (cp >= 0x1DC0 && cp <= 0x1DFF) return true;
    if (cp >= 0xFE20 && cp <= 0xFE2F) return true;
    if (cp >= 0xFE00 && cp <= 0xFE0F) return true;
    if (cp >= 0xFE10 && cp <= 0xFE1F) return true;
    if (cp >= 0x20DD && cp <= 0x20E0) return true;
    return false;
}

/* ASCII byte a non-ASCII codepoint is visually confusable with, 0 when
 * it isn't one. Cyrillic/Greek/fullwidth lookalikes of the Latin letters
 * that dominate identifiers (E0103) */
u32 homoglyphAscii(u32 cp)
{
    /* Cyrillic */
    if (cp == 0x0430 || cp == 0x03B1 || cp == 0xFF41) return 97;  // а α ａ -> a
    if (cp == 0x0410 || cp == 0x0391 || cp == 0xFF21) return 65;  // А Α Ａ -> A
    if (cp == 0x0435 || cp == 0x03B5 || cp == 0xFF45) return 101; // е ε ｅ -> e
    if (cp == 0x0415 || cp == 0x0395 || cp == 0xFF25) return 69;  // Е Ε Ｅ -> E
    if (cp == 0x043E || cp == 0x03BF || cp == 0xFF4F) return 111; // о ο ｏ -> o
    if (cp == 0x041E || cp == 0x039F || cp == 0xFF2F) return 79;  // О Ο Ｏ -> O
    if (cp == 0x0440 || cp == 0x03C1 || cp == 0xFF50) return 112; // р ρ ｐ -> p
    if (cp == 0x0420 || cp == 0x03A1 || cp == 0xFF30) return 80;  // Р Ρ Ｐ -> P
    if (cp == 0x0441 || cp == 0xFF43) return 99;                  // с ｃ -> c
    if (cp == 0x0421 || cp == 0xFF23) return 67;                  // С Ｃ -> C
    if (cp == 0x0445 || cp == 0x03C7 || cp == 0xFF58) return 120; // х χ ｘ -> x
    if (cp == 0x0425 || cp == 0x03A7 || cp == 0xFF38) return 88;  // Х Χ Ｘ -> X
    if (cp == 0x0443 || cp == 0x03B3 || cp == 0xFF59) return 121; // у γ ｙ -> y
    if (cp == 0x03A5 || cp == 0xFF39) return 89;                  // Υ Ｙ -> Y
    if (cp == 0x0456 || cp == 0x03B9 || cp == 0xFF49) return 105; // і ι ｉ -> i
    if (cp == 0x0406 || cp == 0x0399 || cp == 0xFF29) return 73;  // І Ι Ｉ -> I
    if (cp == 0x0458 || cp == 0xFF4A) return 106;                 // ј ｊ -> j
    if (cp == 0x0408 || cp == 0xFF2A) return 74;                  // Ј Ｊ -> J
    if (cp == 0x043A || cp == 0x03BA || cp == 0xFF4B) return 107; // к κ ｋ -> k
    if (cp == 0x041A || cp == 0x039A || cp == 0xFF2B) return 75;  // К Κ Ｋ -> K
    if (cp == 0x043C || cp == 0x03BC || cp == 0xFF4D) return 109; // м μ ｍ -> m
    if (cp == 0x041C || cp == 0x039C || cp == 0xFF2D) return 77;  // М Μ Ｍ -> M
    if (cp == 0x043D || cp == 0x03BD || cp == 0xFF4E) return 110; // н ν ｎ -> n
    if (cp == 0x041D || cp == 0x0397 || cp == 0xFF28) return 72;  // Н Η Ｈ -> H
    if (cp == 0x0455 || cp == 0xFF53) return 115;                 // ѕ ｓ -> s
    if (cp == 0x0405 || cp == 0xFF33) return 83;                  // Ѕ Ｓ -> S
    if (cp == 0x0442 || cp == 0x03C4 || cp == 0xFF54) return 116; // т τ ｔ -> t
    if (cp == 0x0422 || cp == 0x03A4 || cp == 0xFF34) return 84;  // Т Τ Ｔ -> T
    if (cp == 0x0412 || cp == 0x0392 || cp == 0xFF22) return 66;  // В Β Ｂ -> B
    if (cp == 0x03C5 || cp == 0xFF55) return 117;                 // υ ｕ -> u
    if (cp == 0x039D || cp == 0xFF2E) return 78;                  // Ν Ｎ -> N
    return 0;
}

usize putBytes(u8* dst, usize at, str s)
{
    usize i = 0;
    while (i < s.len) { dst[at + i] = s.ptr[i]; i++; }
    return at + s.len;
}

u8 hexNibble(u32 v) { return v < 10 ? (u8)(48 + v) : (u8)(55 + v); }

usize putHex4(u8* dst, usize at, u32 v)
{
    dst[at] = hexNibble((v >> 12) & 15);
    dst[at + 1] = hexNibble((v >> 8) & 15);
    dst[at + 2] = hexNibble((v >> 4) & 15);
    dst[at + 3] = hexNibble(v & 15);
    return at + 4;
}

pub extend Lexer
{
    /* scans XID_Continue codepoints, then looks the text up in the
     * identifier table: a hit turns keywords into their own TokenKind and
     * stashes the IdentifierInfo on the token. no table (tests, early
     * bootstrap) means every word stays a plain Ident */
    /* report the first non-ASCII lookalike codepoint of one identifier */
    void reportHomoglyph(u8* cpStart, u32 cp, bool* reported)
    {
        if (reported[0]) return;
        u32 mimic = homoglyphAscii(cp);
        if (mimic == 0) return;
        reported[0] = true;
        u8 mbuf[96];
        usize mn = 0;
        mn = putBytes(mbuf, mn, "identifier contains a non-ASCII lookalike character (U+");
        mn = putHex4(mbuf, mn, cp);
        mn = putBytes(mbuf, mn, ") that mimics ASCII '");
        mbuf[mn] = (u8)mimic;
        mn = mn + 1;
        mn = putBytes(mbuf, mn, "' (U+");
        mn = putHex4(mbuf, mn, mimic);
        mn = putBytes(mbuf, mn, ")");
        self.reportErrorCode(ErrorCode::LexHomoglyph, self.bufStart, self.bufEnd, cpStart,
                             str { .ptr = mbuf, .len = mn });
    }

    Token lexIdentifier(u8* start)
    {
        bool reported = false;
        /* the dispatcher already consumed the first byte: check it too
         * (a Cyrillic `а` can START an identifier) */
        {
            usize len0 = 0;
            u32 cp0 = decodeUtf8(start, self.bufEnd, &len0);
            if (len0 > 0 && cp0 >= 128) self.reportHomoglyph(start, cp0, &reported);
        }
        while (!self.isAtEnd())
        {
            usize len;
            u8* cpStart = self.cur;
            u32 cp = decodeUtf8(self.cur, self.bufEnd, &len);
            if (len == 0 || !isXidContinue(cp)) break;
            if (cp >= 128) self.reportHomoglyph(cpStart, cp, &reported);
            self.cur += len;
        }
        usize len = (usize)(self.cur - start);
        
        if (self.idents == null) {
            Token t = self.makeToken(TokenKind::Ident, start);
            return t;
        }
        
        IdentifierInfo* ii = self.idents.get(str { .ptr = start, .len = len });
        if (ii == null)
            return self.makeToken(TokenKind::Ident, start);
        Token t = self.makeToken(ii->kind, start);
        t.info = ii;
        return t;
    }
}
