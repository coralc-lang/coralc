#[[no_drop_all]]
// lexer/string.crl: string literals
//
// three flavors: "..." (escape-checked, raw text kept in the token),
// C"..." (NUL-terminated, no length), R"delim(...)delim" (no escapes at
// all). decoding escapes is the consumer's job; this only validates.

import common::token { TokenKind, Token };
import diag::code { ErrorCode };
import escape { EscapeResult };
import base { Lexer };

pub extend Lexer
{
    /* text between the quotes goes into the token verbatim, escapes and
     * all; they're only checked here. newlines are allowed and tracked */
    Token lexString(u8* start)
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == '\"') {
                self.cur++;
                return self.makeToken(TokenKind::String, start);
            }
            if (c == '\\') {
                EscapeResult esc = EscapeResult::decodeEscapeSequence(self.cur, self.bufEnd);
                if (!esc.isValid)
                    self.reportErrorCode(ErrorCode::LexInvalidEscape, self.bufStart, self.bufEnd, self.cur, "invalid escape sequence");
                // 0 bytes consumed means not even the backslash+char pair
                // parsed; step one byte so a lone `\` can't spin forever
                if (esc.bytesConsumed == 0) self.cur++;
                else self.cur += esc.bytesConsumed;
                continue;
            }
            if (c == '\n') {
                self.line++;
                self.lineStart = self.cur + 1;
            }
            self.cur++;
        }
        self.reportErrorCode(ErrorCode::LexUnterminatedString, self.bufStart, self.bufEnd, start, "unterminated string literal");
        return self.makeToken(TokenKind::String, start);
    }

    /* C"..." C-style string literal: escapes are decoded, the result is a
     * NUL-terminated byte string with no attached length. */
    Token lexCString(u8* start)
    {
        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == '\"') {
                self.cur++;
                return self.makeToken(TokenKind::CString, start);
            }
            if (c == '\\') {
                EscapeResult esc = EscapeResult::decodeEscapeSequence(self.cur, self.bufEnd);
                if (!esc.isValid)
                    self.reportErrorCode(ErrorCode::LexInvalidEscape, self.bufStart, self.bufEnd, self.cur, "invalid escape sequence");
                if (esc.bytesConsumed == 0) self.cur++;
                else self.cur += esc.bytesConsumed;
                continue;
            }
            if (c =='\n') {
                self.line++;
                self.lineStart = self.cur + 1;
            }
            self.cur++;
        }
        self.reportErrorCode(ErrorCode::LexUnterminatedString, self.bufStart, self.bufEnd, start, "unterminated C string literal");
        return self.makeToken(TokenKind::CString, start);
    }

    /* R"delim(raw)delim": delimiter is whatever sits between the quote
     * and `(` (often empty). no escapes; ends only at `)delim"` */
    Token lexRawString(u8* start)
    {
        if (self.isAtEnd() || self.cur[0] != '"') {
            self.reportErrorCode(ErrorCode::LexMalformedRawString, self.bufStart, self.bufEnd, start, "expected '\"' after `R` to open a raw string");
            return self.makeToken(TokenKind::RawString, start);
        }
        self.cur++;

        // delimiter scan stops at `(`; also skips line accounting, so a
        // delimiter containing a newline would desync the cursor's line
        u8* delimStart = self.cur;
        while (!self.isAtEnd() && self.cur[0] != '(') {
            self.cur++;
        }
        usize delimLen = (usize)(self.cur - delimStart);

        if (self.isAtEnd() || self.cur[0] != '(') {
            self.reportErrorCode(ErrorCode::LexMalformedRawString, self.bufStart, self.bufEnd, start, "expected '(' after the raw string delimiter");
            return self.makeToken(TokenKind::RawString, start);
        }
        self.cur++;

        while (!self.isAtEnd())
        {
            u8 c = self.cur[0];
            if (c == '\n') {
                self.line++;
                self.lineStart = self.cur + 1;
            }
            if (c == ')') {
                // hand-rolled bounds check: the delimiter can poke past
                // bufEnd, so every byte is tested against the limit first
                bool match = true;
                for (usize i = 0; i < delimLen; i++) {
                    usize idx = (usize)(self.cur + 1 + i - self.bufStart);
                    if (idx >= (usize)(self.bufEnd - self.bufStart)) {
                        match = false;
                        break;
                    }
                    if (self.bufStart[idx] != delimStart[i]) {
                        match = false;
                        break;
                    }
                }
                if (match) {
                    usize quoteIdx = (usize)(self.cur + 1 + delimLen - self.bufStart);
                    if (quoteIdx < (usize)(self.bufEnd - self.bufStart) && self.bufStart[quoteIdx] == '"') {
                        self.cur = (u8*)(self.bufStart + quoteIdx + 1);
                        return self.makeToken(TokenKind::RawString, start);
                    }
                }
            }
            self.cur++;
        }
        self.reportErrorCode(ErrorCode::LexUnterminatedString, self.bufStart, self.bufEnd, start, "unterminated raw string literal: missing `)delim\"` terminator");
        return self.makeToken(TokenKind::RawString, start);
    }
}
