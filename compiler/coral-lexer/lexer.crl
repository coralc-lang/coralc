#[[no_drop_all]]

// lexer/lexer.crl: the token pump
//
// nextToken() skips whitespace/comments, then classifies the next token by
// first byte: string prefixes (R" C" u" U" c" u8"), identifiers (ASCII and
// XID_Start UTF-8), numbers, char literals, operators. anything left comes
// back as TokenKind::Unknown so the parser can eat it and move on.
// comments are dropped on the floor; nothing downstream sees them.

import common::token { Token, TokenKind };
import diag::code { ErrorCode };

import ident { decodeUtf8, isXidStart };
import escape { EscapeResult };
import base { Lexer };

import skip_ws;
import number;
import string;
import operator;

pub extend Lexer
{
    Token nextToken()
    {
        if (self.isAtEnd()) return self.makeToken(TokenKind::Eof, self.cur);
        self.skipWsCmts();
        u8* start = self.cur;
        // re-check: the file can end in whitespace or an unterminated comment
        if (self.isAtEnd()) return self.makeToken(TokenKind::Eof, start);
        u8 c = self.cur[0];
        self.cur++;
        
        // string prefixes before the identifier rule can grab their letters
        if (c == 'R' && !self.isAtEnd() && self.cur[0] == '"') {
            self.cur++;
            return self.lexRawString(start);
        }
        if (c == 'C' && !self.isAtEnd() && self.cur[0] == '"') {
            self.cur++;
            return self.lexCString(start);
        }
        if ((c == 'u' || c == 'U' || c == 'c') && !self.isAtEnd() && self.cur[0] == '"') {
            self.cur++;
            return self.lexString(start);
        }
        if (c == 'u' && !self.isAtEnd() && self.cur[0] == '8' &&
            self.cur + 1 < self.bufEnd && self.cur[1] == '"')
        {
            self.cur += 2;
            return self.lexString(start);
        }
        // `(c | 0x20)` folds ASCII letters to lowercase: A-Z and a-z both hit
        if ((c | 0x20) >= 'a' && (c | 0x20) <= 'z' || c == '_')
            return self.lexIdentifier(start);
        if (c >= 0xC0 && c <= 0xFD) {
            // multibyte UTF-8 start; only XID_Start codepoints open an ident
            usize len;
            u32 cp = decodeUtf8(start, self.bufEnd, &len);
            if (len > 0 && isXidStart(cp))
            {
                self.cur = start + len;
                return self.lexIdentifier(start);
            }
        }
        if (c >= '0' && c <= '9') return self.lexNumber(start);
        if (c == '"') return self.lexString(start);
        if (c == '\'')
        {
            // scan to the closing quote, walking escapes (and multibyte
            // codepoints) whole; the VALUE is decoded later, in expr.crl
            bool terminated = false;
            while (!self.isAtEnd())
            {
                if (self.cur[0] == '\'')
                {
                    self.cur++;
                    terminated = true;
                    break;
                }
                if (self.cur[0] == '\n') break;
                if (self.cur[0] == '\\')
                {
                    EscapeResult esc = EscapeResult::decodeEscapeSequence(self.cur, self.bufEnd);
                    if (!esc.isValid)
                        self.reportErrorCode(ErrorCode::LexInvalidEscape, self.bufStart, self.bufEnd, self.cur, "invalid escape sequence");
                    if (esc.bytesConsumed == 0) self.cur++;
                    else self.cur += esc.bytesConsumed;
                } else {
                    usize len;
                    decodeUtf8(self.cur, self.bufEnd, &len);
                    if (len > 0) self.cur += len;
                    else self.cur++;
                }
            }
            if (!terminated)
                self.reportErrorCode(ErrorCode::LexUnterminatedChar, self.bufStart, self.bufEnd, start, "unterminated character literal");
            return self.makeToken(TokenKind::CharLit, start);
        }

        Token op = self.lexOperator(c, start);
        // always true: lexPunctuation never hands back an Eof kind, so the
        // unknown-char report below is dead. unknown bytes still come back
        // as TokenKind::Unknown and the parser quietly skips those
        if (op.kind != TokenKind::Eof) return op;

        self.reportErrorCode(ErrorCode::LexUnknownChar, self.bufStart, self.bufEnd, start, "unknown character");
        return self.makeToken(TokenKind::Unknown, start);
    }
}
