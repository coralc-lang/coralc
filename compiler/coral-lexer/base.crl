#[[no_drop_all]]
// lexer/base.crl: the Lexer struct the lex_*.crl files extend.
// owns a cursor into the source buffer (never a copy), the diag sink and
// the identifier table. the parser lexes each file once into a token
// array (F4/F5); getBufStart still serves doc-comment backward walks.

import common {
    slice { Slice },
    common::token { Token, TokenKind }
};
import diag {
    code { ErrorCode }, 
    engine { DiagnosticEngine }
};

import ast::id { makeLoc };
import table { IdentifierTable };

pub struct Lexer
{
    DiagnosticEngine* diag;
    IdentifierTable* idents;
    u32 fileId;
    usize line;
    u8* bufStart;
    u8* bufEnd;
    u8* cur;
    u8* lineStart;
    Token token;

    void init(Slice src, DiagnosticEngine* diag, IdentifierTable* idents)
    {

        // bufEnd is one-past-the-end; `token` is deliberately left zeroed
        self = Lexer {
            .bufStart = src.ptr,
            .cur = src.ptr,
            .bufEnd = (u8*)((usize)src.ptr + src.len),
            .line = 1,
            .lineStart = src.ptr,
            .diag = diag,
            .idents = idents
        };
    }

    bool isAtEnd() { return self.cur >= self.bufEnd; }

    // doc-comment scanning walks backwards from a token to the file start
    u8* getBufStart() { return self.bufStart; }

    // cursor plumbing for speculative-parse rewind (parser.crl save/restore)
    u8* getCur() { return self.cur; }
    void setCur(u8* c) { self.cur = c; }
    u8* getLineStart() { return self.lineStart; }
    void setLineStart(u8* c) { self.lineStart = c; }
    u32 getLine() { return (u32)self.line; }
    void setLine(u32 l) { self.line = (usize)l; }
    Token getToken() { return self.token; }
    void setToken(Token t) { self.token = t; }

    /* numeric-literal callers only; the distinct number diagnostics all
     * share L0006 (LexInvalidNumber), not L0007 (invalid character) */
    void reportError(u8* bufStart, u8* bufEnd, u8* errPtr, str msg)
    {
        self.reportErrorCode(ErrorCode::LexInvalidNumber, bufStart, bufEnd, errPtr, msg);
    }

    /* diag wants 1-based line/col. errPtr is normally within the token
     * just lexed, so the line falls out of the lexer's own line counter:
     * subtract the newlines between errPtr and cur (a token body at
     * most) instead of scanning from bufStart — O(token), not O(file)
     * (F10c). a full scan remains only for errPtr before the current
     * line start. col = bytes back to the start of that line, +1.
     * counts BYTES, not codepoints; tabs and UTF-8 shift what the user
     * sees */
    void reportErrorCode(ErrorCode code, u8* bufStart, u8* bufEnd, u8* errPtr, str msg) // changed from u8* to str
    {
        if (self.diag == null) return;
        if (errPtr == null) errPtr = self.cur;
        if (errPtr < bufStart) errPtr = bufStart;
        if (errPtr > bufEnd) errPtr = bufEnd;
        u32 line;
        if (errPtr >= self.lineStart)
        {
            u32 skipped = 0;
            u8* p = errPtr;
            while (p < self.cur && p < bufEnd)
            {
                if (p[0] == 10) skipped++;
                p++;
            }
            line = self.line >= (usize)skipped ? (u32)self.line - skipped : 1;
        }
        else
        {
            line = 1;
            u8* p = bufStart;
            while (p < errPtr)
            {
                if (p[0] == 10) line++;
                p++;
            }
        }
        u8* lineStart = errPtr;
        while (lineStart > bufStart && lineStart[-1] != 10)
            lineStart--;
        u32 col = (u32)(errPtr - lineStart) + 1;
        self.diag.emitError(code, makeLoc(self.fileId, line, col), msg, null);
    }

    /* token text is [start, cur); every lex_ function must leave the
     * cursor exactly past the token. line/col point at `start`, not cur */
    Token makeToken(TokenKind kind, u8* start)
    {
        return Token {
            .kind = kind,
            .data = Slice::from(start, (usize)(self.cur - start)),
            .number = 0,
            .line = self.line,
            .col = (usize)(start - self.lineStart) + 1,
            .info = null,
            .numFlags = 0
        };
    }
}
