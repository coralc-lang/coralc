#[[no_drop_all]]
// lexer/operator.crl: operators by longest match
//
// lexOperator peeks one byte ahead to catch two-char forms; the ones that
// share a prefix with a longer spelling (`<`/`<<`/`<<=`, `!`/`!=`) are
// ordered so the longer wins. everything single-char falls through to
// lexPunctuation, which returns Unknown for bytes it doesn't know.

import common::token { Token, TokenKind };
import base { Lexer };

pub extend Lexer
{
    // cur sits just past the first byte `c`; start points at it
    Token lexOperator(u8 c, u8* start)
    {
        if (!self.isAtEnd())
        {
            u8 next = self.cur[0];

            if (c == '+' && next == '+') { self.cur++; return self.makeToken(TokenKind::PlusPlus, start); }
            if (c == '-' && next == '-') { self.cur++; return self.makeToken(TokenKind::MinusMinus, start); }
            if (c == '=' && next == '=') { self.cur++; return self.makeToken(TokenKind::EqualEqual, start); }
            if (c == '!' && next == '=') { self.cur++; return self.makeToken(TokenKind::NotEqual, start); }
            if (c == '<' && next == '=') { self.cur++; return self.makeToken(TokenKind::LessEqual, start); }
            if (c == '>' && next == '=') { self.cur++; return self.makeToken(TokenKind::GreaterEqual, start); }
            if (c == '&' && next == '&') { self.cur++; return self.makeToken(TokenKind::And, start); }
            if (c == '|' && next == '|') { self.cur++; return self.makeToken(TokenKind::Or, start); }
            if (c == '+' && next == '=') { self.cur++; return self.makeToken(TokenKind::PlusEqual, start); }
            if (c == '-' && next == '=') { self.cur++; return self.makeToken(TokenKind::MinusEqual, start); }
            if (c == '*' && next == '=') { self.cur++; return self.makeToken(TokenKind::StarEqual, start); }
            if (c == '/' && next == '=') { self.cur++; return self.makeToken(TokenKind::SlashEqual, start); }
            if (c == '|' && next == '=') { self.cur++; return self.makeToken(TokenKind::PipeEqual, start); }
            if (c == '^' && next == '=') { self.cur++; return self.makeToken(TokenKind::CaretEqual, start); }
            if (c == '&' && next == '=') { self.cur++; return self.makeToken(TokenKind::AmpEqual, start); }
            if (c == '~' && next == '=') { self.cur++; return self.makeToken(TokenKind::NegEqual, start); }
            if (c == '%' && next == '=') { self.cur++; return self.makeToken(TokenKind::PercentEqual, start); }
            if (c == '<' && next == '<') {
                self.cur++;
                if (!self.isAtEnd() && self.cur[0] == '=') {
                    self.cur++;
                    return self.makeToken(TokenKind::ShlEqual, start);
                }
                return self.makeToken(TokenKind::Shl, start);
            }
            if (c == '>' && next == '>') {
                self.cur++;
                if (!self.isAtEnd() && self.cur[0] == '=')
                {
                    self.cur++;
                    return self.makeToken(TokenKind::ShrEqual, start);
                }
                return self.makeToken(TokenKind::Shr, start);
            }
            if (c == '-' && next == '>') { self.cur++; return self.makeToken(TokenKind::Arrow, start); }
            if (c == '=' && next == '>') { self.cur++; return self.makeToken(TokenKind::FatArrow, start); }
            if (c == ':' && next == ':') { self.cur++; return self.makeToken(TokenKind::ColonColon, start); }
            if (c == '.' && next == '.' && self.cur + 1 < self.bufEnd && self.cur[1] == '.')
            {
                self.cur += 2;
                return self.makeToken(TokenKind::Ellipsis, start);
            }
        }

        return self.lexPunctuation(c, start);
    }

    // single-char table; Unknown is the catch-all, not an error here
    Token lexPunctuation(u8 c, u8* start)
    {
        switch (c)
        {
            '+' => { return self.makeToken(TokenKind::Plus, start); },
            '-' => { return self.makeToken(TokenKind::Minus, start); },
            '*' => { return self.makeToken(TokenKind::Star, start); },
            '/' => { return self.makeToken(TokenKind::Slash, start); },
            '%' => { return self.makeToken(TokenKind::Percent, start); },
            '<' => { return self.makeToken(TokenKind::Less, start); },
            '>' => { return self.makeToken(TokenKind::Greater, start); },
            '~' => { return self.makeToken(TokenKind::Neg, start); },
            '!' => { return self.makeToken(TokenKind::Not, start); },
            ':' => { return self.makeToken(TokenKind::Colon, start); },
            ';' => { return self.makeToken(TokenKind::Semicolon, start); },
            ',' => { return self.makeToken(TokenKind::Comma, start); },
            '#' => { return self.makeToken(TokenKind::Hash, start); },
            '.' => { return self.makeToken(TokenKind::Dot, start); },
            '&' => { return self.makeToken(TokenKind::Ampersand, start); },
            '^' => { return self.makeToken(TokenKind::Caret, start); },
            '|' => { return self.makeToken(TokenKind::Pipe, start); },
            '=' => { return self.makeToken(TokenKind::Equal, start); },
            '(' => { return self.makeToken(TokenKind::LParen, start); },
            ')' => { return self.makeToken(TokenKind::RParen, start); },
            '{' => { return self.makeToken(TokenKind::LBrace, start); },
            '}' => { return self.makeToken(TokenKind::RBrace, start); },
            '[' => { return self.makeToken(TokenKind::LBracket, start); },
            ']' => { return self.makeToken(TokenKind::RBracket, start); },
            '@' => { return self.makeToken(TokenKind::At, start); },
            '?' => { return self.makeToken(TokenKind::Question, start); },
            else => { return self.makeToken(TokenKind::Unknown, start); },
        }
    }
}
