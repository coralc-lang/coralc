#[[no_drop_all]]
/* mono/lib.crl — monomorphization + generator expansion
 *
 * Pipeline: parse → generator expand → trait check → mono collect → codegen
 * per rustc collect_and_partition_mono_items.
 *
 * Attributes handled here:
 *   #[[generator(Debug, Clone, Serialize)]] — like Rust derive, only on struct/enum/variant/union/distinct.
 *     Expands before mono: registry function(TokenStream)->Decl, emits #[[generated]] on output.
 *     Duplicates merge. Unknown generator → diagnostic.
 *   Layout: #[[packed]] vs #[[reorder]] mutually exclusive, per mono instance.
 *   Codegen: #[[inline, inline_always, hot, cold, vectorise]] → LLVM attrs per instance.
 *
 * TODO:
 *   - generator registry: <type> registerGenerator(Str name, function-pointer callback)
 *   - mono collector:Stamp generic Fn/Type per concrete Ty, preserve attrs, CGU partitioning
 *   - comptime gen: run before mono, may emit generics
 */

pub mod mono = import mono;
pub mod collect = import collect;
pub mod instantiate = import instantiate;
pub mod comptime = import comptime;
