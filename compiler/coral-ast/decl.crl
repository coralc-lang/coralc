#[[no_drop_all]]
/* ast/decl.crl — declaration nodes
 *
 * Coral declaration syntax:
 *   pub <type> name(params) { body }
 *   Type name;              — field/param
 *   Type name = init;       — field with default
 *   pub struct Name<T> { fields methods }
 *   pub variant Name<T> { Variants { fields } }
 *   pub enum Name { A, B, C }
 *   pub trait Name { methods }
 *   extend Type { methods }
 *   extend Type : Trait { methods }
 *   distinct Name = Type;
 *   flag(PLATFORM) { label => stmts }  — else is default branch
 *   import path { symbols }
 *   import file::module { symbols }
 *   import(lib) package::module { symbols }
 *   pub mod alias = import path;
 *   pub mod alias = import(lib) package::path;
 *   comptime { decls }
 *
 * Attributes (double-bracket, comma-separated):
 *   #[[packed]]
 *   #[[noreturn]]
 *   #[[inline]]
 *   #[[reorder, packed]]  — composite attributes
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   Function pointer variable: T(T) callback;
 *
 * Clang-inspired performance principles:
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 *   - Str is u32 interned ID (4 bytes, O(1) equality)
 *   - Ty is u32 type ID (4 bytes, not 64-byte inline variant)
 *   - Flatten variants: split tag + data into parallel arrays
 */

import id { Str, SourceLoc, NodeId };
import types { Ty };

pub struct GenericParam
{
    Str name;
    NodeId* bounds;
    u32 boundsLen;
    u8 flags;
    /* bit 0 = comptime (generic parameter auto-deduced inside the
     * function's own `comptime { ... }` block, no caller-supplied arg) */
}

pub struct TraitBound
{
    Str traitName;
}

pub struct Param
{
    Str name;
    Ty typeNode;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = isSelf
     *   bit 1 = isMutSelf
     *   bit 2 = isConstSelf
     *   bit 4 = isVariadic (the `...` parameter)
     */
}

pub struct Field
{
    Str name;
    Ty typeNode;
    NodeId defaultValue;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = isPub
     *   bit 1 = hasDefault
     */
}

pub struct EnumVariant
{
    Str name;
    NodeId value;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = hasValue
     */
}

pub struct VariantVariant
{
    Str name;
    Str* fieldNames;
    Ty* fieldTypes;
    u32 fieldsLen;
    SourceLoc loc;
}

pub struct FlagBranch
{
    Str label;
    NodeId* stmts;
    u32 stmtsLen;
}

pub struct ImportSymbol
{
    Str name;
    Str alias;
    u8 flags;
    /* flags bits:
     *   bit 0 = hasAlias
     */
}

pub struct Attribute
{
    Str name;
    Str* args;
    u32 argsLen;
    SourceLoc loc;
}

pub variant DeclKind
{
    Import {
        Str path;
        ImportSymbol* symbols;
        u32 symbolsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isLib (import(lib))
         *   bit 1 = hasLibPath
         */
    },

    ModReexport {
        Str alias;
        Str path;
        ImportSymbol* symbols;
        u32 symbolsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isLib
         *   bit 1 = hasLibPath
         */
    },

    Struct {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* fields;
        u32 fieldsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Enum {
        Str name;
        Ty backingType;
        NodeId* variants;
        u32 variantsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = hasBacking
         *   bit 1 = isPub
         */
    },

    Variant {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        VariantVariant* variants;
        u32 variantsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Union {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* fields;
        u32 fieldsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Trait {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Extend {
        Ty selfType;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
    },

    ExtendTrait {
        Ty selfType;
        Str traitName;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
    },

    Func {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* params;
        u32 paramsLen;
        Ty returnType;
        NodeId body;
        u8 flags;
        /* flags bits:
         *   bit 0 (1)  = isPub
         *   bit 1 (2)  = isExtern
         *   bit 2 (4)  = isStatic
         *   bit 3 (8)  = hasBody
         *   bit 4 (16) = isConst — cannot mutate self/params
         */
    },

    Constant {
        Str name;
        Ty typeNode;
        NodeId value;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    TypeAlias {
        Str name;
        Ty target;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Distinct {
        Str name;
        Ty baseType;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Flag {
        Str flagName;
        NodeId* branches;
        u32 branchesLen;
    },

    Comptime {
        NodeId* decls;
        u32 declsLen;
    }
}

pub struct Decl
{
    DeclKind kind;
    SourceLoc loc;
    SourceLoc nameLoc;
    Attribute* attrs;
    u32 attrsLen;
}

pub struct File
{
    Str path;
    NodeId* decls;
    u32 declsLen;
    /* file-level attributes (`#[[no_drop_all]]` before the first decl) */
    Attribute* attrs;
    u32 attrsLen;
}
