#[[no_drop_all]]
/* ast/decl.crl — declaration nodes
 *
 * Coral declaration syntax:
 *   pub <type> name(params) { body }
 *   Type name;              — field/param
 *   Type name = init;       — field with default
 *   pub struct Name<T> { fields methods }
 *   pub variant Name<T> { Variants { fields } }
 *   pub enum Name { A, B, C }
 *   pub trait Name { methods }
 *   extend Type { methods }
 *   extend Type : Trait { methods }
 *   distinct Name = Type;
 *   flag(PLATFORM) { label => stmts }  — else is default branch
 *   use path { symbols }
 *   use file::module { symbols }
 *   use package::module { symbols }
 *   pub mod alias = use path;
 *   pub mod alias = use package::path;
 *   comptime { decls }
 *
 * Attributes (double-bracket, comma-separated):
 *   #[[packed]]
 *   #[[noreturn]]
 *   #[[inline]]
 *   #[[reorder, packed]]  — composite attributes
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   Function pointer variable: T(T) callback;
 *
 * Clang-inspired performance principles:
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 *   - Str is u32 interned ID (4 bytes, O(1) equality)
 *   - Ty is u32 type ID (4 bytes, not 64-byte inline variant)
 *   - Flatten variants: split tag + data into parallel arrays
 */

use id { Str, SourceLoc, NodeId };
use types { Ty };

pub struct GenericParam
{
    Str name;
    NodeId* bounds;
    u32 boundsLen;
    u8 flags;
    /* bit 0 = comptime (generic parameter auto-deduced inside the
     * function's own `comptime { ... }` block, no caller-supplied arg) */
}

pub struct TraitBound
{
    Str traitName;
}

pub struct Param
{
    Str name;
    Ty typeNode;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = isSelf
     *   bit 1 = isMutSelf
     *   bit 2 = isConstSelf
     *   bit 4 = isVariadic (the `...` parameter)
     */
}

pub struct Field
{
    Str name;
    Ty typeNode;
    NodeId defaultValue;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = isPub
     *   bit 1 = hasDefault
     */
}

pub struct EnumVariant
{
    Str name;
    NodeId value;
    SourceLoc loc;
    u8 flags;
    /* flags bits:
     *   bit 0 = hasValue
     */
}

pub struct VariantVariant
{
    Str name;
    Str* fieldNames;
    Ty* fieldTypes;
    u32 fieldsLen;
    SourceLoc loc;
}

pub struct FlagBranch
{
    Str label;
    NodeId* stmts;
    u32 stmtsLen;
}

pub struct ImportSymbol
{
    Str name;
    Str alias;
    u8 flags;
    /* flags bits:
     *   bit 0 = hasAlias
     */
}

pub struct Attribute
{
    Str name;
    Str* args;
    u32 argsLen;
    SourceLoc loc;
}

/* bit-packed attribute flags — one bit per recognized attribute so
 * queries are `(decl->attrBits & ATTR_X)` instead of re-interning the
 * attribute name and scanning the attrs array. bit 0 stays ATTR_CONST
 * (the parser's historical const bit). keep in sync with
 * parser::decl attrBitOf and the LSP attribute cards. */
pub const ATTR_CONST = 1;
pub const ATTR_CONDASSIGN = 2;
pub const ATTR_NO_DROP = 4;
pub const ATTR_NO_DROP_ALL = 8;
pub const ATTR_FALLTHROUGH = 16;
pub const ATTR_INLINE = 32;
pub const ATTR_INLINE_ALWAYS = 64;
pub const ATTR_HOT = 128;
pub const ATTR_COLD = 256;
pub const ATTR_VECTORISE = 512;
pub const ATTR_DEPRECATED = 1024;
pub const ATTR_PACKED = 2048;
pub const ATTR_NORETURN = 4096;
pub const ATTR_REORDER = 8192;
pub const ATTR_MAYBE_UNUSED = 16384;
pub const ATTR_GENERATE = 32768;
pub const ATTR_GENERATED = 65536;
pub const ATTR_GENERATOR = 131072;
pub const ATTR_NO_MANGLE = 262144;
pub const ATTR_NOALIAS = 524288;
pub const ATTR_THREADLOCAL = 1048576;
pub const ATTR_FREESTANDING = 2097152;
pub const ATTR_EXTERN = 4194304;
pub const ATTR_TEST = 8388608;
pub const ATTR_BENCH = 16777216;
pub const ATTR_CFG = 33554432;
pub const ATTR_LINK = 67108864;
pub const ATTR_SIMD = 134217728;
pub const ATTR_ALIGN = 268435456;
pub const ATTR_INLINE_NEVER = 536870912;
pub const ATTR_NAKED = 1073741824;
pub const ATTR_ENTRY = 2147483648u;

pub variant DeclKind
{
    Import {
        Str path;
        ImportSymbol* symbols;
        u32 symbolsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isLib (`import` keyword; `use` clears it)
         *   bit 1 = hasLibPath
         */
    },

    ModReexport {
        Str alias;
        Str path;
        ImportSymbol* symbols;
        u32 symbolsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isLib
         *   bit 1 = hasLibPath
         */
    },

    Struct {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* fields;
        u32 fieldsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Enum {
        Str name;
        Ty backingType;
        NodeId* variants;
        u32 variantsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = hasBacking
         *   bit 1 = isPub
         */
    },

    Variant {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        VariantVariant* variants;
        u32 variantsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Union {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* fields;
        u32 fieldsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Trait {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Extend {
        Ty selfType;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    ExtendTrait {
        Ty selfType;
        Str traitName;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* methods;
        u32 methodsLen;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Func {
        Str name;
        NodeId* genericParams;
        u32 genericParamsLen;
        NodeId* params;
        u32 paramsLen;
        Ty returnType;
        NodeId body;
        u8 flags;
        /* flags bits:
         *   bit 0 (1)  = isPub
         *   bit 1 (2)  = isExtern
         *   bit 2 (4)  = isStatic
         *   bit 3 (8)  = hasBody
         *   bit 4 (16) = isConst — cannot mutate self/params
         */
        Str externLib;
        /* from `extern("lib")` — the library/convention the symbol
         * binds (interned; 0 = bare extern). feeds wallvm's IrFunc
         * externLib for the import-table/linker registry. */
    },

    Constant {
        Str name;
        Ty typeNode;
        NodeId value;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    TypeAlias {
        Str name;
        Ty target;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Distinct {
        Str name;
        Ty baseType;
        u8 flags;
        /* flags bits:
         *   bit 0 = isPub
         */
    },

    Flag {
        Str flagName;
        NodeId* branches;
        u32 branchesLen;
    },

    Comptime {
        NodeId* decls;
        u32 declsLen;
    }
}

pub struct Decl
{
    DeclKind kind;
    SourceLoc loc;
    SourceLoc nameLoc;
    Attribute* attrs;
    u32 attrsLen;
    u32 attrBits;
}

pub struct File
{
    Str path;
    NodeId* decls;
    u32 declsLen;
    /* file-level attributes (`#[[no_drop_all]]`, `#[[noprelude]]`,
     * `#[[freestanding]]` before the first decl) */
    Attribute* attrs;
    u32 attrsLen;
    u32 attrBits;
}
