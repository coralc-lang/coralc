#[[no_drop_all]]
/* ast/expr.crl — expression nodes
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   e.g. void(rawptr, rawptr) free;
 *   e.g. T(T) callback;
 *
 * Builtins use @ prefix:
 *   @assert, @sizeof, @alignof, @typeof, @offsetof
 *
 * Struct literals use dot-prefix field syntax:
 *   Foo { .field = val, .field2 = val2 }
 *
 * Array literals use C-style syntax:
 *   Type { val, val2, val3 }
 *
 * Performance principles:
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 *   - Flatten variants: split tag + data into parallel arrays
 *   - Ty is u32 (4 bytes) not inline TypeKind variant (64 bytes)
 */

use id { Str, SourceLoc, NodeId };
use types { Ty };
use stmt { SwitchCase };

/* builtin call identities, assigned ONCE by the parser (builtinIdOf).
 * every consumer — sema, IR, codegen, mono — switches on this tag and
 * never re-matches the name string. */
pub const BUILTIN_NONE = 0;
pub const BUILTIN_ASSERT = 1;
pub const BUILTIN_ASSERTOUT = 2;
pub const BUILTIN_COMPILEERROR = 3;
pub const BUILTIN_ISFORMATLITERAL = 4;
pub const BUILTIN_TYPEOF = 5;
pub const BUILTIN_PANIC = 6;
pub const BUILTIN_UNREACHABLE = 7;
/* runtime family: the tag survives to the backend, which resolves the
 * core::error implementation decl from the module tree at the use site
 * (`@panic(msg)` → the resolved symbol of `__panic`). the implementation
 * names are Compiler-known; builtinImplHash carries their FNV hashes. */
pub const BUILTIN_REPORT = 8;
pub const BUILTIN_REPORTHEX = 9;
pub const BUILTIN_ABORTNOW = 10;
pub const BUILTIN_ASSERTEQ = 11;
pub const BUILTIN_ASSERTNE = 12;
pub const BUILTIN_ASSERTLT = 13;
pub const BUILTIN_ASSERTLE = 14;
pub const BUILTIN_ASSERTGT = 15;
pub const BUILTIN_ASSERTGE = 16;
pub const BUILTIN_ASSERTRANGE = 17;
pub const BUILTIN_ASSERTNONNULL = 18;
pub const BUILTIN_ASSERTALIGNED = 19;
pub const BUILTIN_BACKTRACETO = 20;

/* the core::error implementation behind a runtime error builtin, as the
 * precomputed FNV-1a 32 hash + length of its source name (`@panic` →
 * "__panic"). Backends scan the module tree with these and never intern
 * a probe string. false = not a runtime builtin (compile-time tags and
 * unknown ids). */
pub bool builtinImplHash(u32 bn, u32* outHash, u32* outLen)
{
    if (bn == BUILTIN_PANIC)        { *outHash = 0x2D70AED6; *outLen = 7;  return true; }
    if (bn == BUILTIN_UNREACHABLE)  { *outHash = 0x7784909B; *outLen = 13; return true; }
    if (bn == BUILTIN_ASSERT)       { *outHash = 0xF3B3ECB5; *outLen = 8;  return true; }
    if (bn == BUILTIN_ASSERTOUT)    { *outHash = 0x0C13ABCF; *outLen = 11; return true; }
    if (bn == BUILTIN_REPORT)       { *outHash = 0xF513F31D; *outLen = 8;  return true; }
    if (bn == BUILTIN_REPORTHEX)    { *outHash = 0xBDFF7912; *outLen = 11; return true; }
    if (bn == BUILTIN_ABORTNOW)     { *outHash = 0x78E785C9; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTEQ)     { *outHash = 0xFE964473; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTNE)     { *outHash = 0xF2B2080C; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTLT)     { *outHash = 0x17AC321D; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTLE)     { *outHash = 0x26AC49BA; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTGT)     { *outHash = 0x059ACCA6; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTGE)     { *outHash = 0x169AE769; *outLen = 10; return true; }
    if (bn == BUILTIN_ASSERTRANGE)  { *outHash = 0x38F21FA2; *outLen = 13; return true; }
    if (bn == BUILTIN_ASSERTNONNULL){ *outHash = 0x1E0F65A9; *outLen = 15; return true; }
    if (bn == BUILTIN_ASSERTALIGNED){ *outHash = 0x2EB2564F; *outLen = 15; return true; }
    if (bn == BUILTIN_BACKTRACETO)  { *outHash = 0x655B4B5C; *outLen = 13; return true; }
    return false;
}

pub variant ExprKind
{
    IntLit {
        u64 value;
        u8 flags;
        /* flags bits:
         *   bit 0 = unsigned suffix (`255u`)
         *   bit 2 = long/long-long suffix (`4L`, `1ULL`)
         */
    },

    FloatLit { Str value; u8 flags; },

    StringLit {
        Str value;
        u8 flags;
        /* flags bits:
         *   bit 0 = C-style literal (`C"..."`, NUL-terminated, no len);
         *           clear = len-carrying `str` literal
         */
    },

    CharLit { u32 value; },

    BoolLit {
        u8 flags;
        /* flags bits:
         *   bit 0 = value (true/false)
         */
    },

    NullLit,

    Ident { Str name; },

    TypeRef {
        Str name;
        Ty typeNode;
    },

    Path {
        NodeId* segments;
        u32 segmentsLen;
    },

    Call {
        NodeId callee;
        NodeId* args;
        u32 argsLen;
    },

    MethodCall {
        NodeId receiver;
        Str method;
        NodeId* args;
        u32 argsLen;
    },

    Field {
        NodeId obj;
        Str field;
    },

    DerefField {
        NodeId obj;
        Str field;
    },

    Index {
        NodeId obj;
        NodeId index;
    },

    StaticCall {
        Str typeName;
        Str method;
        NodeId* args;
        u32 argsLen;
    },

    Cast {
        NodeId expr;
        Ty targetType;
    },

    Sizeof { Ty targetType; },
    Alignof { Ty targetType; },
    Typeof { NodeId expr; },
    AddressOf { NodeId expr; },
    Deref { NodeId expr; },
    Neg { NodeId expr; },
    BitNot { NodeId expr; },
    Not { NodeId expr; },

    Add {
        NodeId left;
        NodeId right;
    },

    Sub {
        NodeId left;
        NodeId right;
    },

    Mul {
        NodeId left;
        NodeId right;
    },

    Div {
        NodeId left;
        NodeId right;
    },

    Mod {
        NodeId left;
        NodeId right;
    },

    Eq {
        NodeId left;
        NodeId right;
    },

    Ne {
        NodeId left;
        NodeId right;
    },

    Lt {
        NodeId left;
        NodeId right;
    },

    Le {
        NodeId left;
        NodeId right;
    },

    Gt {
        NodeId left;
        NodeId right;
    },

    Ge {
        NodeId left;
        NodeId right;
    },

    And {
        NodeId left;
        NodeId right;
    },

    Or {
        NodeId left;
        NodeId right;
    },

    BitAnd {
        NodeId left;
        NodeId right;
    },

    BitOr {
        NodeId left;
        NodeId right;
    },

    BitXor {
        NodeId left;
        NodeId right;
    },

    Shl {
        NodeId left;
        NodeId right;
    },

    Shr {
        NodeId left;
        NodeId right;
    },

    Assign {
        NodeId target;
        NodeId value;
    },

    AssignAdd {
        NodeId target;
        NodeId value;
    },

    AssignSub {
        NodeId target;
        NodeId value;
    },

    AssignMul {
        NodeId target;
        NodeId value;
    },

    AssignDiv {
        NodeId target;
        NodeId value;
    },

    AssignMod {
        NodeId target;
        NodeId value;
    },

    AssignBitAnd {
        NodeId target;
        NodeId value;
    },

    AssignBitOr {
        NodeId target;
        NodeId value;
    },

    AssignBitXor {
        NodeId target;
        NodeId value;
    },

    AssignShl {
        NodeId target;
        NodeId value;
    },

    AssignShr {
        NodeId target;
        NodeId value;
    },

    TupleField {
        NodeId obj;
        u32 index;
    },

    StructLiteral {
        Ty typeNode;
        Str variantName;
        /* variantName != 0: construction of variant `variantName` of the
         * variant decl named by typeNode (fields live in its union) */
        Str* fieldNames;
        NodeId* fieldValues;
        u32 fieldValuesLen;
    },

    ArrayLiteral {
        NodeId* elems;
        u32 elemsLen;
    },

    BuiltinCall {
        Str name;   // kept for diagnostics/LSP cards; logic uses builtin
        u32 builtin; // BUILTIN_* tag, set once at parse
        NodeId* args;
        u32 argsLen;
    },

    /* `...expr` in a call argument list — spreads a variadic pack */
    Spread {
        NodeId expr;
    },

    TupleExpr {
        NodeId* elems;
        u32 elemsLen;
    },

    BlockExpr {
        NodeId* stmts;
        u32 stmtsLen;
        NodeId result;
    },

    Ternary {
        NodeId cond;
        NodeId thenExpr;
        NodeId elseExpr;
    },

    PostInc { NodeId expr; },
    PostDec { NodeId expr; },
    PreInc { NodeId expr; },
    PreDec { NodeId expr; },

    IfExpr {
        NodeId cond;
        NodeId thenBody;
        NodeId elseBody;
    },

    SwitchExpr {
        NodeId expr;
        SwitchCase* cases;
        u32 casesLen;
    }
}

pub struct Expr
{
    ExprKind kind;
    SourceLoc loc;
    Ty resolvedType;
}
