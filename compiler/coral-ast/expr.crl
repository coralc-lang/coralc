#[[no_drop_all]]
/* ast/expr.crl — expression nodes
 *
 * Function pointers: ReturnType (ParamTypes) name
 *   e.g. rawptr(rawptr, usize) alloc;
 *   e.g. void(rawptr, rawptr) free;
 *   e.g. T(T) callback;
 *
 * Builtins use @ prefix:
 *   @assert, @sizeof, @alignof, @typeof, @offsetof
 *
 * Struct literals use dot-prefix field syntax:
 *   Foo { .field = val, .field2 = val2 }
 *
 * Array literals use C-style syntax:
 *   Type { val, val2, val3 }
 *
 * Performance principles:
 *   - Sentinel NodeId: index=0 means absent, no NodeId* heap allocs
 *   - Bit-pack booleans: u8 flags instead of scattered bools
 *   - Flatten variants: split tag + data into parallel arrays
 *   - Ty is u32 (4 bytes) not inline TypeKind variant (64 bytes)
 */

import id { Str, SourceLoc, NodeId };
import types { Ty };
import stmt { SwitchCase };

pub variant ExprKind
{
    IntLit {
        u64 value;
        u8 flags;
        /* flags bits:
         *   bit 0 = unsigned suffix (`255u`)
         *   bit 2 = long/long-long suffix (`4L`, `1ULL`)
         */
    },

    FloatLit { Str value; u8 flags; },

    StringLit {
        Str value;
        u8 flags;
        /* flags bits:
         *   bit 0 = C-style literal (`C"..."`, NUL-terminated, no len);
         *           clear = len-carrying `str` literal
         */
    },

    CharLit { u32 value; },

    BoolLit {
        u8 flags;
        /* flags bits:
         *   bit 0 = value (true/false)
         */
    },

    NullLit,

    Ident { Str name; },

    TypeRef {
        Str name;
        Ty typeNode;
    },

    Path {
        NodeId* segments;
        u32 segmentsLen;
    },

    Call {
        NodeId callee;
        NodeId* args;
        u32 argsLen;
    },

    MethodCall {
        NodeId receiver;
        Str method;
        NodeId* args;
        u32 argsLen;
    },

    Field {
        NodeId obj;
        Str field;
    },

    DerefField {
        NodeId obj;
        Str field;
    },

    Index {
        NodeId obj;
        NodeId index;
    },

    StaticCall {
        Str typeName;
        Str method;
        NodeId* args;
        u32 argsLen;
    },

    Cast {
        NodeId expr;
        Ty targetType;
    },

    Sizeof { Ty targetType; },
    Alignof { Ty targetType; },
    Typeof { NodeId expr; },
    AddressOf { NodeId expr; },
    Deref { NodeId expr; },
    Neg { NodeId expr; },
    BitNot { NodeId expr; },
    Not { NodeId expr; },

    Add {
        NodeId left;
        NodeId right;
    },

    Sub {
        NodeId left;
        NodeId right;
    },

    Mul {
        NodeId left;
        NodeId right;
    },

    Div {
        NodeId left;
        NodeId right;
    },

    Mod {
        NodeId left;
        NodeId right;
    },

    Eq {
        NodeId left;
        NodeId right;
    },

    Ne {
        NodeId left;
        NodeId right;
    },

    Lt {
        NodeId left;
        NodeId right;
    },

    Le {
        NodeId left;
        NodeId right;
    },

    Gt {
        NodeId left;
        NodeId right;
    },

    Ge {
        NodeId left;
        NodeId right;
    },

    And {
        NodeId left;
        NodeId right;
    },

    Or {
        NodeId left;
        NodeId right;
    },

    BitAnd {
        NodeId left;
        NodeId right;
    },

    BitOr {
        NodeId left;
        NodeId right;
    },

    BitXor {
        NodeId left;
        NodeId right;
    },

    Shl {
        NodeId left;
        NodeId right;
    },

    Shr {
        NodeId left;
        NodeId right;
    },

    Assign {
        NodeId target;
        NodeId value;
    },

    AssignAdd {
        NodeId target;
        NodeId value;
    },

    AssignSub {
        NodeId target;
        NodeId value;
    },

    AssignMul {
        NodeId target;
        NodeId value;
    },

    AssignDiv {
        NodeId target;
        NodeId value;
    },

    AssignMod {
        NodeId target;
        NodeId value;
    },

    AssignBitAnd {
        NodeId target;
        NodeId value;
    },

    AssignBitOr {
        NodeId target;
        NodeId value;
    },

    AssignBitXor {
        NodeId target;
        NodeId value;
    },

    AssignShl {
        NodeId target;
        NodeId value;
    },

    AssignShr {
        NodeId target;
        NodeId value;
    },

    TupleField {
        NodeId obj;
        u32 index;
    },

    StructLiteral {
        Ty typeNode;
        Str variantName;
        /* variantName != 0: construction of variant `variantName` of the
         * variant decl named by typeNode (fields live in its union) */
        Str* fieldNames;
        NodeId* fieldValues;
        u32 fieldValuesLen;
    },

    ArrayLiteral {
        NodeId* elems;
        u32 elemsLen;
    },

    BuiltinCall {
        Str name;
        NodeId* args;
        u32 argsLen;
    },

    /* `...expr` in a call argument list — spreads a variadic pack */
    Spread {
        NodeId expr;
    },

    TupleExpr {
        NodeId* elems;
        u32 elemsLen;
    },

    BlockExpr {
        NodeId* stmts;
        u32 stmtsLen;
        NodeId result;
    },

    Ternary {
        NodeId cond;
        NodeId thenExpr;
        NodeId elseExpr;
    },

    PostInc { NodeId expr; },
    PostDec { NodeId expr; },
    PreInc { NodeId expr; },
    PreDec { NodeId expr; },

    IfExpr {
        NodeId cond;
        NodeId thenBody;
        NodeId elseBody;
    },

    SwitchExpr {
        NodeId expr;
        SwitchCase* cases;
        u32 casesLen;
    }
}

pub struct Expr
{
    ExprKind kind;
    SourceLoc loc;
    Ty resolvedType;
}
