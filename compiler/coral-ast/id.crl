#[[no_drop_all]]
/* ast/id.crl — string interning and source locations
 *
 * Str is a u32 index into a global string intern table.
 * Equality is O(1) — just compare two u32 values.
 * The actual string data (ptr + len) lives in the intern table.
 *
 * SourceLoc is 32 bits — packed file ID + line + column.
 * Matches Clang's 32-bit SourceLocation design.
 *
 * NodeId is a 32-bit index into the AST node array.
 * index=0 is the sentinel for "absent" — no NodeId* heap allocs.
 */

/* String intern table index. 0 = empty string. */
pub typedef Str = u32;

pub struct SourceLoc
{
    u64 data;
}

/* 32-bit line/col with a 20-bit file id — matches Clang's 32-bit
 * SourceLocation design, extended so merged lib files resolve correctly.
 * layout: [fileId:20][line:22][col:22] */
SourceLoc makeLoc(u32 file, u32 line, u32 col)
{
    SourceLoc loc;
    loc.data = ((u64)file << 44) | ((u64)line << 22) | (u64)col;
    return loc;
}

u32 locFile(SourceLoc loc) { return (u32)(loc.data >> 44); }
u32 locLine(SourceLoc loc) { return (u32)((loc.data >> 22) & 0x3fffff); }
u32 locCol(SourceLoc loc) { return (u32)(loc.data & 0x3fffff); }

pub struct NodeId
{
    u32 index;
}
