#[[no_drop_all]]
/* ast/types.crl — type representation
 *
 * Ty is a u32 index into a global type table.
 * The actual TypeKind data lives in a parallel array.
 * This cuts every Ty from 64 bytes to 4 bytes.
 *
 * TypeKind variants are stored in type arena, not inline in Ty.
 * Only the kind tag + small inline data is stored per variant.
 * Large payloads (Named, FnPtr, Pointer, etc.) store references.
 */

pub typedef Ty = u32;

pub variant TypeKind
{
    Error,
    Void,
    Bool,
    Char,
    I8,
    U8,
    I16,
    U16,
    I32,
    U32,
    I64,
    U64,
    I128,
    U128,
    F32,
    F64,
    Isize,
    Usize,
    Rawptr,
    Str,

    Pointer { Ty base; },
    Const { Ty base; },
    Comptime { Ty base; },
    Slice { Ty base; },
    
    Named {
        Str name;
        Ty* genericArgs;
        u32 genericArgsLen;
    },

    Array {
        Ty base;
        u32 len;
        /* symbolic size `T data[N]` where N is a generic parameter:
         * sizeName holds the written name; rebindTypeParams sets
         * sizeParam to N's index in the owner's generic list.
         * 0xFFFFFFFF = the size is not a generic parameter */
        u32 sizeParam;
        Str sizeName;
    },

    FnPtr {
        Ty returnType;
        Ty* params;
        u32 paramsLen;
        Str name;
    },

    Tuple {
        Ty* elems;
        u32 elemsLen;
    },

    TypeParam {
        Str name;
        u32 index;
    },

    /* comptime value argument: `Arr<i32, 4>`'s `4`. The value lives in the
     * type table so generic instantiation, dedup and mangling all see it
     * (`Arr_int32_t_4`); codegen substitutes it where `N` is used */
    ValueInt {
        u64 value;
    }
}

pub struct TypeEntry
{
    TypeKind kind;
    SourceLoc loc;
}
