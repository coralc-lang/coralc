#[[no_drop_all]]
/* ast/pat.crl — pattern nodes
 *
 * Patterns are used in switch cases for matching.
 * Supports: wildcard, literal, identifier, type, variant,
 *           tuple, struct, or, guard, range patterns.
 *
 * Clang-inspired performance principles:
 *   - Flatten variants: split tag + data into parallel arrays
 *   - Str is u32 interned ID (4 bytes, O(1) equality)
 *   - Ty is u32 type ID (4 bytes, not 64-byte inline variant)
 */

import id { Str, SourceLoc, NodeId };
import types { Ty };

pub variant PatKind
{
    Wildcard,

    Lit { NodeId expr; },
    Ident { Str name; },
    Type { Ty typeNode; },

    Variant {
        Str typeName;
        Str variantName;
        Str* fieldNames;
        u32 fieldNamesLen;
    },

    Tuple {
        NodeId* elems;
        u32 elemsLen;
    },

    Struct {
        Str name;
        Str* fieldNames;
        u32 fieldNamesLen;
    },

    Or {
        NodeId* alternatives;
        u32 alternativesLen;
    },

    Guard {
        NodeId pattern;
        NodeId cond;
    },

    Range {
        NodeId start;
        NodeId end;
        u8 flags;
        /* flags bits:
         *   bit 0 = inclusive (..=)
         */
    }
}

pub struct Pat
{
    PatKind kind;
    SourceLoc loc;
}
