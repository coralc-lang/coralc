#[[no_drop_all]]
/* backend/codegen.crl: analyzed AST → flat C.
 *
 * Output shape: labels + gotos for control flow, three-address temporaries
 * for expression evaluation (declared at function entry). Types come from
 * Sema's resolvedType / the TypeKind table only: no name heuristics.
 *
 * The C is built into per-section Streams (all arena-owned) and assembled
 * once at the end by generateC; nothing is written to disk here.
 */
import context::context { AstContext, InternEntry };
import build::arena { Arena };
import common::slice { Slice };
import mono::mono { MonoContext, MonoSubstitution, MonoInstance, MonoInstanceKind };
import diag { engine { DiagnosticEngine }, code { ErrorCode } };
import sem {
    sema { Sema },
    scope { Symbol, ScopeStack }
};

import ast { 
    id { Str, NodeId, locFile, SourceLoc },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind, SwitchCase },
    decl { Decl, DeclKind, File, Param, Field, EnumVariant, VariantVariant },
    pat { Pat, PatKind }
};

import(lib) std::mman { alloc, dealloc, realloc, zero };
import(lib) platform::libc { printf };

// use platform libc, and then for allocations, i will refactor the whole allocator to use std::mman::alloc

pub struct CodegenResult
{
    Slice cCode;
    u32 errors;
}

/* append-only output buffer; every section of the generated C (typedefs,
 * prototypes, bodies, …) is one. All streams live in the codegen arena:
 * individual buffers are never freed, the whole arena dies at once.
 * NUL-terminated after every write, so stTail slices pass as C strings. */
pub struct Stream
{
    u8* p;
    usize len;
    usize cap;
    Arena* arena;
}

pub Stream stNew(Arena* a, usize cap)
{
    Stream s;
    s.arena = a;
    s.cap = cap;
    s.len = 0;
    s.p = (u8*)a.alloc(cap, 1);
    if (s.p == null) s.cap = 0;
    return s;
}

void stPut(Stream* s, u8* data, usize n)
{
    if (s.p == null || s.arena == null) return;
    if (s.len + n + 1 > s.cap)
    {
        usize nc = s.cap * 2;
        while (nc < s.len + n + 1) nc *= 2;
        u8* np = (u8*)s.arena.alloc(nc, 1);
        if (np == null) return;
        memcpy(np, s.p, s.len);
        s.p = np;
        s.cap = nc;
    }
    memcpy(s.p + s.len, data, n);
    s.len += n;
    s.p[s.len] = 0;
}

void stP(Stream* s, str text)
{
    if (text.ptr == null) return;
    stPut(s, text.ptr, text.len);
}

void stPS(Stream* s, Slice v)
{
    if (v.ptr == null) return;
    stPut(s, v.ptr, v.len);
}

void stCh(Stream* s, u8 c)
{
    stPut(s, &c, 1);
}

void stU64(Stream* s, u64 n)
{
    if (n == 0) {
        stCh(s, '0');
        return;
    }
    u64 div = 1;
    while (n / div >= 10) div *= 10;
    while (div > 0) {
        stCh(s, (u8)(48 + ((n / div) % 10)));
        div /= 10;
    }
}

void stI64(Stream* s, i64 n)
{
    if (n < 0) {
        stCh(s, '-');
        /* 0 - n, not -n: negating the most-negative i64 is UB */
        stU64(s, (u64)(0 - n));
    } else {
        stU64(s, (u64)n);
    }
}

/* slice of [start, len), valid only until the next write: growth
 * reallocates and every slice points into the old buffer */
Slice stTail(Stream* s, usize start)
{
    if (start > s.len) return Slice::from(null, 0);
    return Slice::from(s.p + start, s.len - start);
}

/* cut back to a length a caller recorded before speculatively emitting
 * statements (while/for condition probes). The mark is a length, not a
 * pointer, so a realloc in between is harmless. */
void stTrunc(Stream* s, usize n)
{
    if (n > s.len) return;
    s.len = n;
    s.p[s.len] = 0;
}

void stNL(Stream* s, u32 ind)
{
    stCh(s, '\n');
    u32 i = 0;
    while (i < ind) {
        stP(s, "    ");
        i++;
    }
}

/* stream roles: out = the assembled result; fwd = forward typedefs and
 * import-alias #defines; defs = type defs + file-scope constants;
 * protos = function prototypes; bodies = finished bodies; body = the
 * body currently being built (reset per function); ebuf = expression
 * text scratch; tybuf = C type text / mangled-name scratch; tdecl =
 * registered slice/tuple/fn-pointer typedefs */
/* one live local whose type declares `drop`: unwound innermost-first at
 * scope exit, on `return`, and on `break`/`continue` */
struct DropEntry
{
    Str name;
    Ty typeNode;
    NodeId mdef;
}

pub struct Codegen
{
    AstContext* ctx;
    File* file;
    MonoContext* mono;
    Sema* sema;
    Arena* arena;
    Stream out;
    Stream fwd;
    Stream defs;
    Stream protos;
    Stream bodies;
    Stream body;
    Stream ebuf;
    Stream tybuf;
    Stream tdecl;
    /* alias/distinct/enum typedefs — emitted before tdecl so fn-pointer
     * typedefs can name them */
    Stream typedefs;
    /* C-symbol registries for mono instances: alias-equal coral args
     * (`u32`, `Str`, `Ty`) spell one C type, so several instances can
     * compose the same symbol — emit it once per phase */
    Slice* protoFnNames;
    u32 protoFnLen;
    u32 protoFnCap;
    Slice* bodyFnNames;
    u32 bodyFnLen;
    u32 bodyFnCap;
    MonoSubstitution* subs;
    u32 subsLen;
    u32 errors;

    /* file-scope `var` globals whose initializer is not a C constant:
     * storage stays zero-initialized and coral_globals_init() — a C
     * constructor — assigns before main runs */
    NodeId* dynInits;
    u32 dynInitsLen;
    u32 dynInitsCap;
    /* recursion budget while folding `const` refs into initializers:
     * a self-referential const errors instead of looping */
    u32 foldDepth;

    /* per-function emission state: __L<labelSeq> gotos, __t<tempsLen>
     * temporaries (all declared at the function top) */
    u32 labelSeq;
    u32 tempSeq;
    /* per-temp result type + array length (tempArrs is parallel to
     * tempTys; only meaningful for array-typed temps) */
    Slice* tempTys;
    u32* tempArrs;
    u32 tempsCap;
    u32 tempsLen;

    u32 loopDepth;
    u32 loopCap;
    u32* breakKinds;
    u32* breakLabels;
    u32 breakDepth;
    u32 switchSeq;

    /* RAII unwinding: drops is a stack of live locals with a resolved
     * drop method; fnDropMark is its base for the current function,
     * loopDropMarks[k] / breakDropMarks[k] record the stack length at
     * the entry of loop k / breakable construct k so `break`/`continue`
     * unwind exactly the scopes they exit */
    DropEntry* drops;
    u32 dropsLen;
    u32 dropsCap;
    u32 fnDropMark;
    u32* loopDropMarks;
    u32* breakDropMarks;

    // small inline cache for cgFindDecl: the heaviest per-call scan
    Str* declCacheNames;
    u32* declCacheIds;
    u32* declCacheTags;
    u32 declCacheLen;

    /* names bound in the current function (params, locals, loop/pattern
     * binds): Ident refs to these stay raw, everything else goes
     * through cgResolveRef → cgMangle */
    Str* localNames;
    u32 localNamesLen;
    u32 localNamesCap;

    /* registry of emitted slice/tuple/fn-pointer typedef texts: cgRegName
     * dedups against these and emits dependencies first */
    Slice* regNames;
    u32 regLen;
    u32 regCap;

    u32 ind;
}

void cgError(Codegen* cg, str msg)
{
    cg.errors++;
    if (cg.sema != null)
    {
        SourceLoc loc;
        loc.data = 0;
        cg.sema.semaError(ErrorCode::CodegenInternal, loc, msg);
    }
}

/* codegen failure with a source position, so it renders like every other
 * diagnostic instead of surfacing as a gcc error in generated C */
void cgErrorAt(Codegen* cg, NodeId at, str msg)
{
    cg.errors++;
    if (cg.sema == null) return;
    if (at.index != 0)
    {
        cg.sema.semaErrorNode(ErrorCode::CodegenInternal, at, msg);
        return;
    }
    SourceLoc loc;
    loc.data = 0;
    cg.sema.semaError(ErrorCode::CodegenInternal, loc, msg);
}

/* G0001 instead of G0002: the language construct itself is fine, C's
 * file-scope rules just cannot express it as written */
void cgErrorUnsupported(Codegen* cg, NodeId at, str msg)
{
    cg.errors++;
    if (cg.sema == null) return;
    if (at.index != 0)
    {
        cg.sema.semaErrorNode(ErrorCode::CodegenUnsupported, at, msg);
        return;
    }
    SourceLoc loc;
    loc.data = 0;
    cg.sema.semaError(ErrorCode::CodegenUnsupported, loc, msg);
}

u32 cgLabel(Codegen* cg)
{
    cg.labelSeq++;
    return cg.labelSeq;
}

/* hand out the next temp slot. arrLen is vestigial: array declarators
 * are split at the first '[' in cgEmitFuncCommon instead. */
u32 cgNewTemp(Codegen* cg, Slice ty, u32 arrLen)
{
    if (cg.tempsLen >= cg.tempsCap) {
        cgError(cg, "temp capacity exceeded");
        return 0;
    }
    u32 t = cg.tempsLen;
    cg.tempTys[t] = ty;
    cg.tempArrs[t] = arrLen;
    cg.tempsLen++;
    return t;
}

Slice cgTempName(Codegen* cg, u32 t)
{
    usize start = cg.tybuf.len;
    stP(&cg.tybuf, "__t");
    stU64(&cg.tybuf, (u64)t);
    return stTail(&cg.tybuf, start);
}

void cgPopLoop(Codegen* cg)
{
    if (cg.loopDepth > 0) cg.loopDepth--;
    if (cg.breakDepth > 0) cg.breakDepth--;
}

/* mark = cg.dropsLen at the loop's entry; `continue`/`break` unwind to it */
void cgPushLoop(Codegen* cg, u32 mark)
{
    if (cg.loopDepth < 64) cg.loopDropMarks[cg.loopDepth] = mark;
    cg.loopDepth++;
    if (cg.breakDepth < 64)
    {
        cg.breakKinds[cg.breakDepth] = 0;
        cg.breakLabels[cg.breakDepth] = 0;
        cg.breakDropMarks[cg.breakDepth] = mark;
        cg.breakDepth++;
    }
}

void cgPushSwitch(Codegen* cg, u32 label, u32 mark)
{
    if (cg.breakDepth < 64)
    {
        cg.breakKinds[cg.breakDepth] = 1;
        cg.breakLabels[cg.breakDepth] = label;
        cg.breakDropMarks[cg.breakDepth] = mark;
        cg.breakDepth++;
    }
}

void cgPushDrop(Codegen* cg, Str name, Ty ty, NodeId mdef)
{
    if (cg.dropsLen >= cg.dropsCap)
    {
        cgError(cg, "too many live locals with drop methods");
        return;
    }
    DropEntry e;
    e.name = name;
    e.typeNode = ty;
    e.mdef = mdef;
    cg.drops[cg.dropsLen] = e;
    cg.dropsLen++;
}

void cgEmitDropEntry(Codegen* cg, DropEntry* e)
{
    Ty ty = cgTyUnwrap(cg, cgSubstTy(cg, e->typeNode));
    if (ty == 0) return;
    Slice owner = cgOwnerName(cg, ty);
    usize cs = cg.ebuf.len;
    stPS(&cg.ebuf, owner);
    stCh(&cg.ebuf, '_');
    stPS(&cg.ebuf, cgIntern(cg, cg.ctx.intern("drop")));
    Slice raw = stTail(&cg.ebuf, cs);
    Slice callee = cgMangleS(cg, e->mdef, raw, 0);
    stNL(&cg.body, cg.ind);
    stPS(&cg.body, callee);
    stP(&cg.body, "(&");
    stPS(&cg.body, cgIdent(cg, e->name));
    stP(&cg.body, ");");
}

/* emit `T_drop(&name);` for every live local above `mark`, innermost
 * first; the stack is popped as a side effect */
void cgEmitDropsTo(Codegen* cg, u32 mark)
{
    cgEmitDropsExcept(cg, mark, -1);
}

/* like cgEmitDropsTo but skips one stack slot (`skip` = moved-out local,
 * `return s;`): the skipped local transfers ownership to the caller */
void cgEmitDropsExcept(Codegen* cg, u32 mark, i32 skip)
{
    i32 i = (i32)cg.dropsLen - 1;
    while (i >= (i32)mark)
    {
        if (i != skip) cgEmitDropEntry(cg, &cg.drops[i]);
        i--;
    }
    /* scope end: pop the locals above `mark`. never raise: a branch that
     * already unwound (return/break/continue) leaves dropsLen below the
     * stale marks captured in enclosing scopes; restoring such a mark
     * would resurrect dead entries and later scope exits would emit
     * duplicate drops for live locals */
    if (cg.dropsLen > mark) cg.dropsLen = mark;
}

/* branch unwind: emits the drops for a return/break/continue but leaves
 * the live set alone. the statements after the branch still run on the
 * other paths and keep their registrations */
void cgEmitDropsBranch(Codegen* cg, u32 mark, i32 skip)
{
    i32 i = (i32)cg.dropsLen - 1;
    while (i >= (i32)mark)
    {
        if (i != skip) cgEmitDropEntry(cg, &cg.drops[i]);
        i--;
    }
}

/* index of the innermost live local named `name`, or -1 */
i32 cgFindDrop(Codegen* cg, Str name)
{
    if (name == 0) return -1;
    i32 i = (i32)cg.dropsLen - 1;
    while (i >= 0)
    {
        if (cg.drops[i].name == name) return i;
        i--;
    }
    return -1;
}

void cgRemoveDropAt(Codegen* cg, u32 idx)
{
    if (idx >= cg.dropsLen) return;
    u32 i = idx;
    while (i + 1 < cg.dropsLen)
    {
        cg.drops[i] = cg.drops[i + 1];
        i++;
    }
    cg.dropsLen--;
}

/* a bare identifier argument is passed by value: the callee takes
 * ownership, so the caller's pending drop is cancelled (same discipline
 * as `return s;` and `T x = y;` moves). Without this the caller would
 * drop a buffer the callee already owns (double free). */
void cgMoveArg(Codegen* cg, NodeId arg)
{
    Node* an = cgNode(cg, arg);
    if (an.kind.tag != NodeKind::Expr) return;
    if (an.kind.payload.Expr.value.kind.tag != ExprKind::Ident) return;
    i32 mv = cgFindDrop(cg, an.kind.payload.Expr.value.kind.payload.Ident.name);
    if (mv >= 0) cgRemoveDropAt(cg, (u32)mv);
}

/* consuming methods `x.dispose()` / `x.free()` release the receiver
 * immediately: cancel its pending drop so a later automatic drop at a
 * scope exit cannot free the same buffer twice */
void cgMoveDisposeRecv(Codegen* cg, Str methName, Node* recvNode)
{
    if (methName != cg.ctx.intern("dispose") && methName != cg.ctx.intern("free")) return;
    if (recvNode.kind.tag != NodeKind::Expr) return;
    if (recvNode.kind.payload.Expr.value.kind.tag != ExprKind::Ident) return;
    i32 ci = cgFindDrop(cg, recvNode.kind.payload.Expr.value.kind.payload.Ident.name);
    if (ci >= 0) cgRemoveDropAt(cg, (u32)ci);
}

void cgPopSwitch(Codegen* cg)
{
    if (cg.breakDepth > 0) cg.breakDepth--;
}

Slice cgIntern(Codegen* cg, Str s)
{
    if (s == 0) return Slice::from(null, 0);
    InternEntry* e = cg.ctx->interns + s;
    return Slice::from(e.ptr, e.len);
}

Slice cgTail(Codegen* cg, Stream* s, usize start)
{
    return stTail(s, start);
}

/* ── monomorphisation context ────────────────────────────────── */

/* Resolve a type through the current instance's substitutions
 * (mirrors mono findSubstitution: TypeParam by index/name, or a bare
 * Named whose name matches a generic parameter). Returns t if none. */
Ty cgSubstTy(Codegen* cg, Ty t)
{
    if (t == 0 || cg.subsLen == 0 || cg.subs == null) return t;
    TypeEntry* e = cg.ctx->types + t;
    if (e.kind.tag == TypeKind::TypeParam) {
        u32 i = 0;
        while (i < cg.subsLen) {
            if (cg.subs[i].index == e.kind.payload.TypeParam.index ||
                cg.subs[i].parameter == e.kind.payload.TypeParam.name)
                return cg.subs[i].typeNode;
            i++;
        }
        return t;
    }
    if (e.kind.tag == TypeKind::Named && e.kind.payload.Named.genericArgsLen == 0) {
        u32 i = 0;
        while (i < cg.subsLen) {
            if (cg.subs[i].parameter == e.kind.payload.Named.name)
                return cg.subs[i].typeNode;
            i++;
        }
    }
    return t;
}

/* Resolve a symbolic array size (`T data[N]`) through the current
 * instance substitutions; a ValueInt binding hands back its value,
 * anything else keeps `fallback`. Struct fields keep the written name
 * (the parser only rebinds funcs to a param index), so match by
 * sizeParam index first, then by sizeName — the same by-name idiom
 * cgSubstTy uses for a bare `T`. */
u64 cgSubsArrayLen(Codegen* cg, u32 sizeParam, Str sizeName, u64 fallback)
{
    if (cg.subs == null) return fallback;
    u32 i = 0;
    while (i < cg.subsLen)
    {
        bool match = (sizeParam != 4294967295 && cg.subs[i].index == sizeParam) ||
                     (sizeParam == 4294967295 && sizeName != 0 && cg.subs[i].parameter == sizeName);
        if (match)
        {
            TypeEntry* se = cg.ctx->types + cg.subs[i].typeNode;
            if (se->kind.tag == TypeKind::ValueInt) return se->kind.payload.ValueInt.value;
            return fallback;
        }
        i++;
    }
    return fallback;
}

/* Sanitize a C type spelling into a mangled identifier fragment.
 * tyStr almost always returns a slice of tybuf; in that case rewrite
 * in place (each input char maps to exactly one output char), so an
 * enclosing mangled name (cgInstanceName) sees only sanitized chars
 * and never the raw spelling. External slices (tyStr(0) returns a
 * literal) are sanitized into tybuf after the raw text. */
Slice cgMangleTy(Codegen* cg, Ty t)
{
    Slice s = tyStr(cg, t);
    bool inBuf = s.len > 0 && s.ptr >= cg.tybuf.p &&
                 (s.ptr + s.len) <= (cg.tybuf.p + cg.tybuf.len);
    usize i = 0;
    if (inBuf)
    {
        while (i < s.len)
        {
            u8 c = s.ptr[i];
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
            if (ok) { }
            else if (c == 42) s.ptr[i] = 112;
            else s.ptr[i] = 95;
            i++;
        }
        return s;
    }
    usize st = cg.tybuf.len;
    while (i < s.len)
    {
        u8 c = s.ptr[i];
        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
        if (ok) stCh(&cg.tybuf, c);
        else if (c == 42) stCh(&cg.tybuf, 112);
        else stCh(&cg.tybuf, 95);
        i++;
    }
    return stTail(&cg.tybuf, st);
}

// name + "_" + mangled arg types: the C name for a mono instance.
Slice cgInstanceName(Codegen* cg, Str name, Ty* args, u32 argsLen)
{
    usize st = cg.tybuf.len;
    stPS(&cg.tybuf, cgIntern(cg, name));
    u32 i = 0;
    while (i < argsLen)
    {
        stCh(&cg.tybuf, 95);
        cgMangleTy(cg, args[i]);
        i++;
    }
    return stTail(&cg.tybuf, st);
}

/* hex without leading zeros (0 → "0"): value keys end up inside mangled
 * C identifiers, where only [0-9a-zA-Z_] may appear */
void cgWriteHex(Stream* s, u64 v)
{
    str digits = "0123456789abcdef";
    i32 sh = 60;
    bool started = false;
    while (sh >= 0)
    {
        u32 d = (u32)((v >> (u64)sh) & 15);
        if (d != 0 || started || sh == 0)
        {
            stCh(s, digits.ptr[d]);
            started = true;
        }
        sh -= 4;
    }
}

/* instance name with the Zig-style value-specialization key appended:
 * `println` of "hello" and of "bye" are distinct C symbols; key 0 (no
 * recorded call-site values) keeps the plain name */
Slice cgInstanceNameV(Codegen* cg, Str name, Ty* args, u32 argsLen, u64 valueKey)
{
    usize st = cg.tybuf.len;
    stPS(&cg.tybuf, cgIntern(cg, name));
    u32 i = 0;
    while (i < argsLen)
    {
        stCh(&cg.tybuf, 95);
        cgMangleTy(cg, args[i]);
        i++;
    }
    if (valueKey != 0)
    {
        stP(&cg.tybuf, "_v");
        cgWriteHex(&cg.tybuf, valueKey);
    }
    return stTail(&cg.tybuf, st);
}

/* ── name mangling (coral-docs/mangle_asm.md; C keeps the `__
 *      separator instead of asm's `$`) ───────────────────────────
 *
 *   crl__<scope>__<seg…>[__<alias>]__<name>
 *
 * scope: `lib` for files under a lib/ tree, `loc` otherwise.
 * segs: lib → the path under lib/ (package root first); loc → the
 * parent-directory name, then the file stem. extern decls, `main`,
 * and CRT passthrough names emit raw. */

/* one path segment restricted to [A-Za-z0-9_]; a leading digit gets
 * a `_` prefix so every piece stays a valid C identifier fragment */
void cgMangleSeg(Stream* s, u8* p, usize len)
{
    if (p == null || len == 0) return;
    usize i = 0;
    while (i < len)
    {
        u8 c = p[i];
        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                  (c >= 48 && c <= 57) || c == 95;
        if (!ok) c = 95;
        if (i == 0 && c >= 48 && c <= 57) stCh(s, 95);
        stCh(s, c);
        i++;
    }
}

// declaring name of a decl: 0 for nameless kinds (Import, Extend, …)
Str cgDeclOwnName(Decl* dd)
{
    Str dn = 0;
    switch (dd.kind.tag)
    {
        DeclKind::Func => { dn = dd.kind.payload.Func.name; },
        DeclKind::Struct => { dn = dd.kind.payload.Struct.name; },
        DeclKind::Enum => { dn = dd.kind.payload.Enum.name; },
        DeclKind::Variant => { dn = dd.kind.payload.Variant.name; },
        DeclKind::Union => { dn = dd.kind.payload.Union.name; },
        DeclKind::TypeAlias => { dn = dd.kind.payload.TypeAlias.name; },
        DeclKind::Distinct => { dn = dd.kind.payload.Distinct.name; },
        DeclKind::Constant => { dn = dd.kind.payload.Constant.name; },
        else => {},
    }
    return dn;
}

/* extern decls, `main`, and CRT passthrough names keep their raw C
 * spelling (externs bind system symbols; main is the entry point) */
bool cgMangleExempt(Codegen* cg, NodeId declId, Slice name)
{
    if (name.ptr == null || name.len == 0) return true;
    if (slEqU8(name, "main")) return true;
    if (cgIsCrtFn(0, name)) return true;
    if (declId.index != 0)
    {
        Node* n = cgNode(cg, declId);
        if (n.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &n.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Func && (dd.kind.payload.Func.flags & 2) != 0) return true;
            if (dd.kind.tag == DeclKind::Constant && (dd.kind.payload.Constant.flags & 2) != 0) return true;
            /* a definition whose file also declares an extern("C") proto
             * of the same name is C-visible: calls bind the proto (which
             * is exempt), so the definition must spell bare as well. Only
             * same-source-file protos count: the merged unit holds every
             * file, so a libc extern("C") sleep must not strip the prefix
             * from concurrent::async's unrelated sleep */
            if (dd.kind.tag == DeclKind::Func && cg.file != null)
            {
                u32 defFid = locFile(n->loc);
                u32 fi = 0;
                while (fi < cg.file.declsLen)
                {
                    Node* fn = cg.ctx->nodes + cg.file.decls[fi].index;
                    if (fn.kind.tag == NodeKind::Decl)
                    {
                        Decl* fd = &fn.kind.payload.Decl.value;
                        if (fd.kind.tag == DeclKind::Func && (fd.kind.payload.Func.flags & 2) != 0 &&
                            locFile(fn->loc) == defFid &&
                            cgSliceEq(name, cgIntern(cg, fd.kind.payload.Func.name)))
                            return true;
                    }
                    fi++;
                }
            }
        }
    }
    return false;
}

/* mangled spelling: path segments from the declaring file, then an
 * optional import alias, then the declaring name; built into a fresh
 * arena stream so nested calls never clobber each other's tails */
Slice cgMangleS(Codegen* cg, NodeId declId, Slice name, Str alias)
{
    if (cgMangleExempt(cg, declId, name)) return name;
    u8* path = null;
    usize pathLen = 0;
    if (declId.index != 0 && cg.sema != null && cg.sema.diag != null)
    {
        Node* n = cgNode(cg, declId);
        u32 fid = locFile(n->loc);
        if (fid < cg.sema.diag.fileCount)
        {
            str fpath = cg.sema.diag.filePaths.at((usize)fid);
            if (fpath.ptr != null && fpath.len > 0)
            {
                path = (u8*)fpath.ptr;
                pathLen = fpath.len;
            }
        }
    }
    // drop a trailing ".crl"
    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&
        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)
        pathLen -= 4;
    Stream s = stNew(cg.arena, 96);
    stP(&s, "crl__");
    // a "/lib/" anywhere (or a leading "lib/") → lib + path under lib/
    bool isLib = false;
    usize libPos = 0;
    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)
    {
        isLib = true;
        libPos = 4;
    }
    usize q = 0;
    while (!isLib && q + 5 <= pathLen)
    {
        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&
            path[q + 3] == 98 && path[q + 4] == 47)
        {
            isLib = true;
            libPos = q + 5;
        }
        q++;
    }
    if (isLib)
    {
        stP(&s, "lib__");
        usize i = libPos;
        usize segStart = i;
        bool firstSeg = true;
        while (i <= pathLen)
        {
            if (i == pathLen || path[i] == 47)
            {
                if (i > segStart)
                {
                    if (!firstSeg) { stCh(&s, 95); stCh(&s, 95); }
                    cgMangleSeg(&s, path + segStart, i - segStart);
                    firstSeg = false;
                }
                segStart = i + 1;
            }
            i++;
        }
    }
    else
    {
        stP(&s, "loc__");
        // the last '/' splits the parent dir from the file stem
        usize lastSlash = pathLen;
        usize i = 0;
        while (i < pathLen)
        {
            if (path[i] == 47) lastSlash = i;
            i++;
        }
        usize prevSlash = 0;
        i = 0;
        while (i < lastSlash)
        {
            if (path[i] == 47) prevSlash = i + 1;
            i++;
        }
        bool firstSeg = true;
        if (lastSlash < pathLen && lastSlash > prevSlash)
        {
            cgMangleSeg(&s, path + prevSlash, lastSlash - prevSlash);
            firstSeg = false;
        }
        usize stemStart = pathLen;
        if (lastSlash < pathLen) stemStart = lastSlash + 1;
        if (pathLen > stemStart)
        {
            if (!firstSeg) { stCh(&s, 95); stCh(&s, 95); }
            cgMangleSeg(&s, path + stemStart, pathLen - stemStart);
        }
    }
    if (alias != 0)
    {
        Slice a = cgIntern(cg, alias);
        stCh(&s, 95);
        stCh(&s, 95);
        cgMangleSeg(&s, a.ptr, a.len);
    }
    stCh(&s, 95);
    stCh(&s, 95);
    cgMangleSeg(&s, name.ptr, name.len);
    return stTail(&s, 0);
}

// Str wrapper: exempt names keep the keyword escape
Slice cgMangle(Codegen* cg, NodeId declId, Str name, Str alias)
{
    if (name == 0) return cgIdent(cg, name);
    if (cgMangleExempt(cg, declId, cgIntern(cg, name))) return cgIdent(cg, name);
    return cgMangleS(cg, declId, cgIntern(cg, name), alias);
}

/* file-preferred decl lookup: match in refFile first, else the first
 * candidate (cgFindDecl's unqualified behaviour when refFile == 0) */
NodeId cgFindDeclFrom(Codegen* cg, Str name, u32 tag, u32 refFile)
{
    if (refFile == 0 || cg.file == null || name == 0) return cgFindDecl(cg, name, tag);
    NodeId first;
    first.index = 0;
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cg.ctx->nodes + cg.file.decls[i].index;
        if (d.kind.tag == NodeKind::Decl && (u32)d.kind.payload.Decl.value.kind.tag == tag)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (cgDeclOwnName(dd) == name)
            {
                if (locFile(d->loc) == refFile) return cg.file.decls[i];
                if (first.index == 0) first = cg.file.decls[i];
            }
        }
        i++;
    }
    return first;
}

/* the type-decl a Named type refers to (struct/union/variant/enum/
 * alias/distinct): prefers a decl in the type's own file: TypeEntry.loc
 * records where the name was spelled; else the first match by name */
NodeId cgFindTypeDecl(Codegen* cg, Str name, u32 refFile)
{
    NodeId none;
    none.index = 0;
    if (cg.file == null || name == 0) return none;
    /* resolve the way sema did: the binding visible from the spelling
     * site — `File` spelled in parser/file.crl binds to ast's struct,
     * not to the first same-named decl in the merged unit (lib's fs
     * distinct File) */
    if (cg.sema != null && refFile != 0)
    {
        ScopeStack* tyScopes = cg.sema.scopes;
        Symbol* sym = null;
        if (tyScopes != null) sym = tyScopes.lookupFrom(name, refFile);
        if (sym != null && sym->declaration.index != 0)
        {
            Node* sn = cgNode(cg, sym->declaration);
            if (sn.kind.tag == NodeKind::Decl)
            {
                u32 stag = (u32)sn.kind.payload.Decl.value.kind.tag;
                if (stag == DeclKind::Struct || stag == DeclKind::Enum ||
                    stag == DeclKind::Variant || stag == DeclKind::Union ||
                    stag == DeclKind::TypeAlias || stag == DeclKind::Distinct)
                    return sym->declaration;
            }
        }
    }
    NodeId first;
    first.index = 0;
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cg.ctx->nodes + cg.file.decls[i].index;
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            u32 tag = (u32)dd.kind.tag;
            bool isTy = tag == DeclKind::Struct || tag == DeclKind::Enum ||
                        tag == DeclKind::Variant || tag == DeclKind::Union ||
                        tag == DeclKind::TypeAlias || tag == DeclKind::Distinct;
            if (isTy && cgDeclOwnName(dd) == name)
            {
                if (refFile != 0 && locFile(d->loc) == refFile) return cg.file.decls[i];
                if (first.index == 0) first = cg.file.decls[i];
            }
        }
        i++;
    }
    return first;
}

/* resolve a plain-name reference the way sema did: the innermost
 * binding visible at refSite; *outAlias receives the use-site name when
 * it differs from the declaration's own (import `as` rename). A found
 * binding of the wrong kind shadows any outer decl → returns 0 (the
 * caller then emits the raw local name). wantKind 0 = Func or Constant. */
NodeId cgResolveRef(Codegen* cg, Str localName, u32 wantKind, NodeId refSite, Str* outAlias)
{
    NodeId none;
    none.index = 0;
    *outAlias = 0;
    if (localName == 0) return none;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = cgNode(cg, refSite);
        refFile = locFile(rn->loc);
    }
    if (cg.sema != null && cg.sema.scopes != null)
    {
        /* bind the receiver: a nested chain (`cg.sema.scopes.m(...)`)
         * lowers as field access: single-level receivers are fine */
        ScopeStack* scopes = cg.sema.scopes;
        Symbol* sym = scopes.lookupFrom(localName, refFile);
        if (sym != null)
        {
            if (sym->declaration.index == 0) return none;
            Node* sn = cgNode(cg, sym->declaration);
            if (sn.kind.tag != NodeKind::Decl) return none;
            Decl* sd = &sn.kind.payload.Decl.value;
            bool ok = false;
            if (wantKind == 0)
                ok = sd.kind.tag == DeclKind::Func || sd.kind.tag == DeclKind::Constant;
            else if ((u32)sd.kind.tag == wantKind) ok = true;
            if (!ok) return none;
            Str own = cgDeclOwnName(sd);
            if (own != 0 && localName != own) *outAlias = localName;
            return sym->declaration;
        }
    }
    // no scope binding (or no sema): fall back to a file-preferred scan
    NodeId d = cgFindDeclFrom(cg, localName, wantKind == 0 ? (u32)DeclKind::Func : wantKind, refFile);
    if (d.index == 0 && wantKind == 0)
        d = cgFindDeclFrom(cg, localName, (u32)DeclKind::Constant, refFile);
    return d;
}

/* ── the current function's bound names (locals stay raw) ────── */

void cgAddLocal(Codegen* cg, Str name)
{
    if (name == 0) return;
    u32 i = 0;
    while (i < cg.localNamesLen)
    {
        if (cg.localNames[i] == name) return;
        i++;
    }
    if (cg.localNamesLen >= cg.localNamesCap)
    {
        u32 nc = cg.localNamesCap == 0 ? 16 : cg.localNamesCap * 2;
        Str* np = realloc<Str>(cg.localNames, (usize)nc);
        if (np == null) return;
        cg.localNames = np;
        cg.localNamesCap = nc;
    }
    cg.localNames[cg.localNamesLen] = name;
    cg.localNamesLen++;
}

bool cgIsLocalName(Codegen* cg, Str name)
{
    u32 i = 0;
    while (i < cg.localNamesLen)
    {
        if (cg.localNames[i] == name) return true;
        i++;
    }
    return false;
}

/* ── method-decl resolution (owner_method → the method's own decl) ── */

bool cgSliceEq(Slice a, Slice b)
{
    if (a.len != b.len) return false;
    if (a.len == 0) return true;
    if (a.ptr == null || b.ptr == null) return false;
    usize i = 0;
    while (i < a.len)
    {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

bool cgStrFieldIs(Codegen* cg, Str s, str lit)
{
    Slice t = cgIntern(cg, s);
    if (t.len != lit.len) return false;
    usize i = 0;
    while (i < lit.len)
    {
        if (t.ptr[i] != lit.ptr[i]) return false;
        i++;
    }
    return true;
}

// `x.payload` access node inside a field chain
bool cgIsPayloadAccess(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* e = &n.kind.payload.Expr.value;
    if (e->kind.tag == ExprKind::Field)
        return cgStrFieldIs(cg, e->kind.payload.Field.field, "payload");
    if (e->kind.tag == ExprKind::DerefField)
        return cgStrFieldIs(cg, e->kind.payload.DerefField.field, "payload");
    return false;
}

NodeId cgFieldAccessObj(Codegen* cg, NodeId id)
{
    Node* n = cgNode(cg, id);
    Expr* e = &n.kind.payload.Expr.value;
    if (e->kind.tag == ExprKind::Field) return e->kind.payload.Field.obj;
    return e->kind.payload.DerefField.obj;
}

/* `V::Case` as a bare value: the C form is the ordinal of the case;
 * false when the path is not a variant case */
bool cgVariantCaseIdx(Codegen* cg, NodeId id, u64* outIdx)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* e = &n.kind.payload.Expr.value;
    if (e->kind.tag != ExprKind::Path) return false;
    if (e->kind.payload.Path.segmentsLen != 2) return false;
    Node* s0n = cgNode(cg, e->kind.payload.Path.segments[0]);
    Node* s1n = cgNode(cg, e->kind.payload.Path.segments[1]);
    if (s0n.kind.tag != NodeKind::Expr || s1n.kind.tag != NodeKind::Expr) return false;
    if (s0n.kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;
    if (s1n.kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;
    Str root = s0n.kind.payload.Expr.value.kind.payload.Ident.name;
    Str member = s1n.kind.payload.Expr.value.kind.payload.Ident.name;
    NodeId vd = cgFindDecl(cg, root, (u32)DeclKind::Variant);
    if (vd.index == 0) return false;
    Node* dn = cgNode(cg, vd);
    Decl* dd = &dn.kind.payload.Decl.value;
    u32 v = 0;
    while (v < dd.kind.payload.Variant.variantsLen)
    {
        if (dd.kind.payload.Variant.variants[v].name == member)
        {
            *outIdx = (u64)v;
            return true;
        }
        v++;
    }
    return false;
}

Slice cgU64Text(Codegen* cg, u64 v)
{
    usize s = cg.ebuf.len;
    stU64(&cg.ebuf, v);
    return stTail(&cg.ebuf, s);
}

/* assignment RHS: `x.tag = V::Case` writes the ordinal; other variant-case
 * uses keep the struct form */
Slice cgAssignValue(Codegen* cg, NodeId target, NodeId value)
{
    Node* tn = cgNode(cg, target);
    if (tn.kind.tag == NodeKind::Expr)
    {
        Expr* te = &tn.kind.payload.Expr.value;
        bool tagTarget = false;
        if (te->kind.tag == ExprKind::Field &&
            cgStrFieldIs(cg, te->kind.payload.Field.field, "tag")) tagTarget = true;
        if (te->kind.tag == ExprKind::DerefField &&
            cgStrFieldIs(cg, te->kind.payload.DerefField.field, "tag")) tagTarget = true;
        if (tagTarget)
        {
            u64 cidx = 0;
            if (cgVariantCaseIdx(cg, value, &cidx)) return cgU64Text(cg, cidx);
        }
    }
    return cgExpr(cg, value);
}

NodeId cgMethodsContain(Codegen* cg, NodeId* methods, u32 mlen, Str methName)
{
    NodeId none;
    none.index = 0;
    if (methods == null || methName == 0) return none;
    u32 m = 0;
    while (m < mlen)
    {
        Node* mn = cgNode(cg, methods[m]);
        if (mn.kind.tag == NodeKind::Decl && mn.kind.payload.Decl.value.kind.tag == DeclKind::Func &&
            mn.kind.payload.Decl.value.kind.payload.Func.name == methName)
            return methods[m];
        m++;
    }
    return none;
}

/* the method's declaring node for an owner spelling: the type's own
 * methods plus every extend whose owner text matches (cgEmitMethodSet /
 * cgEmitInstMethodList compose the same `owner_method` base) */

/* owner text as the definition side spells it: builtin `str` mangles by
 * its C typedef name (`_coral_str`), everything else by its ident */
Slice cgOwnerSpelling(Codegen* cg, Slice owner)
{
    if (cgSliceEq(owner, Slice::fromStr("str")))
        return Slice::fromStr("_coral_str");
    return owner;
}

NodeId cgFindMethodDeclOwner(Codegen* cg, Slice owner, Str methName)
{
    NodeId none;
    none.index = 0;
    if (owner.len == 0 || methName == 0 || cg.file == null) return none;
    /* the builtin `str` type is declared as `extend str` but its methods
     * mangle by the C typedef name: match the spelling the call site
     * produced (the coral type name) */
    owner = cgOwnerSpelling(cg, owner);
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cg.ctx->nodes + cg.file.decls[i].index;
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union ||
                dd.kind.tag == DeclKind::Variant || dd.kind.tag == DeclKind::Extend ||
                dd.kind.tag == DeclKind::ExtendTrait)
            {
                /* generic extends never match a concrete owner textually,
                 * and cgDeclOwner would tyStr an unresolved TypeParam */
                bool eligible = true;
                if (dd.kind.tag == DeclKind::Extend || dd.kind.tag == DeclKind::ExtendTrait)
                    if (cgOwnerGeneric(cg, dd)) eligible = false;
                if (eligible && cgSliceEq(cgDeclOwner(cg, dd), owner))
                {
                    NodeId* methods = null;
                    u32 mlen = 0;
                    switch (dd.kind.tag)
                    {
                        DeclKind::Struct => { methods = dd.kind.payload.Struct.methods; mlen = dd.kind.payload.Struct.methodsLen; },
                        DeclKind::Union => { methods = dd.kind.payload.Union.methods; mlen = dd.kind.payload.Union.methodsLen; },
                        DeclKind::Variant => { methods = dd.kind.payload.Variant.methods; mlen = dd.kind.payload.Variant.methodsLen; },
                        DeclKind::Extend => { methods = dd.kind.payload.Extend.methods; mlen = dd.kind.payload.Extend.methodsLen; },
                        DeclKind::ExtendTrait => { methods = dd.kind.payload.ExtendTrait.methods; mlen = dd.kind.payload.ExtendTrait.methodsLen; },
                        else => {},
                    }
                    NodeId hit = cgMethodsContain(cg, methods, mlen, methName);
                    if (hit.index != 0) return hit;
                }
            }
        }
        i++;
    }
    /* monomorphised owner (`Foo_int32_t`): the instance's type decl plus
     * every extend its self type matches; mirrors cgEmitInstanceMethods */
    if (cg.mono != null)
    {
        i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::TypeInstance &&
                cgSliceEq(cgInstanceName(cg, inst.name, inst.arguments, inst.argumentsLen), owner))
            {
                Node* dn = cgNode(cg, inst.declaration);
                if (dn.kind.tag == NodeKind::Decl)
                {
                    Decl* td = &dn.kind.payload.Decl.value;
                    NodeId* methods = null;
                    u32 mlen = 0;
                    switch (td.kind.tag)
                    {
                        DeclKind::Struct => { methods = td.kind.payload.Struct.methods; mlen = td.kind.payload.Struct.methodsLen; },
                        DeclKind::Union => { methods = td.kind.payload.Union.methods; mlen = td.kind.payload.Union.methodsLen; },
                        DeclKind::Variant => { methods = td.kind.payload.Variant.methods; mlen = td.kind.payload.Variant.methodsLen; },
                        else => {},
                    }
                    NodeId hit = cgMethodsContain(cg, methods, mlen, methName);
                    if (hit.index != 0) return hit;
                }
                u32 d = 0;
                while (d < cg.file.declsLen)
                {
                    Node* dn2 = cgNode(cg, cg.file.decls[d]);
                    if (dn2.kind.tag == NodeKind::Decl)
                    {
                        Decl* xd = &dn2.kind.payload.Decl.value;
                        bool matches = false;
                        if (xd.kind.tag == DeclKind::Extend)
                            matches = cgSelfTyMatches(cg, xd.kind.payload.Extend.selfType, inst.name, inst.arguments, inst.argumentsLen);
                        else if (xd.kind.tag == DeclKind::ExtendTrait)
                            matches = cgSelfTyMatches(cg, xd.kind.payload.ExtendTrait.selfType, inst.name, inst.arguments, inst.argumentsLen);
                        if (matches)
                        {
                            NodeId* em = null;
                            u32 eml = 0;
                            if (xd.kind.tag == DeclKind::Extend) { em = xd.kind.payload.Extend.methods; eml = xd.kind.payload.Extend.methodsLen; }
                            else { em = xd.kind.payload.ExtendTrait.methods; eml = xd.kind.payload.ExtendTrait.methodsLen; }
                            NodeId hit2 = cgMethodsContain(cg, em, eml, methName);
                            if (hit2.index != 0) return hit2;
                        }
                    }
                    d++;
                }
            }
            i++;
        }
    }
    return none;
}

// the method's declaring node for a receiver type (unwraps ptr/const)
NodeId cgFindMethodDecl(Codegen* cg, Ty recvTy, Str methName)
{
    NodeId none;
    none.index = 0;
    if (recvTy == 0 || methName == 0) return none;
    Ty t = cgTyUnwrap(cg, cgSubstTy(cg, recvTy));
    if (t != 0 && (cg.ctx->types + t)->kind.tag == TypeKind::Pointer)
        t = cgTyUnwrap(cg, (cg.ctx->types + t)->kind.payload.Pointer.base);
    if (t == 0) return none;
    return cgFindMethodDeclOwner(cg, cgOwnerName(cg, t), methName);
}

// true when a value expression has type str
bool cgIsStrTy(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Ty t = cgSubstTy(cg, n.kind.payload.Expr.value.resolvedType);
    if (t == 0) return false;
    return (cg.ctx->types + t)->kind.tag == TypeKind::Str;
}

// true when the expr's type is a `struct` decl (Named → DeclKind::Struct)
bool cgIsStructTy(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Ty t = cgSubstTy(cg, n.kind.payload.Expr.value.resolvedType);
    while (t != 0 && ((cg.ctx->types + t)->kind.tag == TypeKind::Const ||
                      (cg.ctx->types + t)->kind.tag == TypeKind::Comptime))
    {
        if ((cg.ctx->types + t)->kind.tag == TypeKind::Const) t = (cg.ctx->types + t)->kind.payload.Const.base;
        else t = (cg.ctx->types + t)->kind.payload.Comptime.base;
    }
    if (t == 0) return false;
    if ((cg.ctx->types + t)->kind.tag != TypeKind::Named) return false;
    NodeId d = cgFindDecl(cg, (cg.ctx->types + t)->kind.payload.Named.name, (u32)DeclKind::Struct);
    return d.index != 0;
}

/* variant-typed value: a Named type resolving to a Variant decl. C maps
 * variants to a struct with an int `tag`, so ordering/equality compares
 * must go through `.tag` — the struct itself has no C operators */
bool cgIsVariantTy(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Ty t = cgSubstTy(cg, n.kind.payload.Expr.value.resolvedType);
    while (t != 0 && ((cg.ctx->types + t)->kind.tag == TypeKind::Const ||
                      (cg.ctx->types + t)->kind.tag == TypeKind::Comptime))
    {
        if ((cg.ctx->types + t)->kind.tag == TypeKind::Const) t = (cg.ctx->types + t)->kind.payload.Const.base;
        else t = (cg.ctx->types + t)->kind.payload.Comptime.base;
    }
    if (t == 0) return false;
    if ((cg.ctx->types + t)->kind.tag != TypeKind::Named) return false;
    NodeId d = cgFindDecl(cg, (cg.ctx->types + t)->kind.payload.Named.name, (u32)DeclKind::Variant);
    return d.index != 0;
}

/* first decl with this name+kind in the current file (decl order wins);
 * hits are cached in the 32-slot declCache: the miss path rescans */
NodeId cgFindDecl(Codegen* cg, Str name, u32 tag)
{
    NodeId none;
    none.index = 0;
    if (cg.file == null || name == 0) return none;
    u32 c = 0;
    while (c < cg.declCacheLen)
    {
        if (cg.declCacheNames[c] == name && cg.declCacheTags[c] == tag)
        {
            NodeId hit;
            hit.index = cg.declCacheIds[c];
            return hit;
        }
        c++;
    }
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cg.ctx->nodes + cg.file.decls[i].index;
        if (d.kind.tag == NodeKind::Decl && (u32)d.kind.payload.Decl.value.kind.tag == tag)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            Str dn = 0;
            switch (dd.kind.tag)
            {
                DeclKind::Func => { dn = dd.kind.payload.Func.name; },
                DeclKind::Struct => { dn = dd.kind.payload.Struct.name; },
                DeclKind::Enum => { dn = dd.kind.payload.Enum.name; },
                DeclKind::Variant => { dn = dd.kind.payload.Variant.name; },
                DeclKind::Union => { dn = dd.kind.payload.Union.name; },
                DeclKind::TypeAlias => { dn = dd.kind.payload.TypeAlias.name; },
                DeclKind::Constant => { dn = dd.kind.payload.Constant.name; },
                else => {},
            }
            if (dn == name)
            {
                NodeId found = cg.file.decls[i];
                if (cg.declCacheLen < 32)
                {
                    cg.declCacheNames[cg.declCacheLen] = name;
                    cg.declCacheIds[cg.declCacheLen] = found.index;
                    cg.declCacheTags[cg.declCacheLen] = tag;
                    cg.declCacheLen++;
                }
                return found;
            }
        }
        i++;
    }
    return none;
}

/* str → const T* argument decay: true when the callee's parameter is a
 * pointer and the argument expression has type str (emit `<arg>.ptr`) */
bool cgStrToPtr(Codegen* cg, Ty paramTy, NodeId argId)
{
    if (paramTy == 0) return false;
    Node* an = cgNode(cg, argId);
    if (an.kind.tag != NodeKind::Expr) return false;
    Ty at = cgSubstTy(cg, an.kind.payload.Expr.value.resolvedType);
    if (at == 0) return false;
    if ((cg.ctx->types + at)->kind.tag != TypeKind::Str) return false;
    Ty t = paramTy;
    TypeEntry* e = cg.ctx->types + t;
    while (e.kind.tag == TypeKind::Const || e.kind.tag == TypeKind::Comptime)
    {
        if (e.kind.tag == TypeKind::Const) t = e.kind.payload.Const.base;
        else t = e.kind.payload.Comptime.base;
        if (t == 0) return false;
        e = cg.ctx->types + t;
    }
    return e.kind.tag == TypeKind::Pointer;
}

/* variant decl behind a (possibly pointer/const-qualified) type plus the
 * ordinal of `variantName` within it; returns the decl or index 0 */
NodeId cgFindVariantOfTy(Codegen* cg, Ty t, Str variantName, u32* outIdx)
{
    NodeId none;
    none.index = 0;
    *outIdx = 0;
    if (t == 0 || variantName == 0) return none;
    TypeEntry* e = cg.ctx->types + t;
    while (e.kind.tag == TypeKind::Pointer || e.kind.tag == TypeKind::Const ||
           e.kind.tag == TypeKind::Comptime)
    {
        if (e.kind.tag == TypeKind::Pointer) t = e.kind.payload.Pointer.base;
        else if (e.kind.tag == TypeKind::Const) t = e.kind.payload.Const.base;
        else t = e.kind.payload.Comptime.base;
        if (t == 0) return none;
        e = cg.ctx->types + t;
    }
    if (e.kind.tag != TypeKind::Named) return none;
    NodeId d = cgFindDecl(cg, e.kind.payload.Named.name, (u32)DeclKind::Variant);
    if (d.index == 0) return none;
    Node* dn = cgNode(cg, d);
    Decl* dd = &dn.kind.payload.Decl.value;
    u32 v = 0;
    while (v < dd.kind.payload.Variant.variantsLen)
    {
        if (dd.kind.payload.Variant.variants[v].name == variantName)
        {
            *outIdx = v;
            return d;
        }
        v++;
    }
    return none;
}

/* Resolve the callee of a call: plain name for non-generic functions,
 * mangled instance name for generic ones. Sets *outRet to the concrete
 * return type. Returns null slice when the declaration is unknown. */
Slice cgCallFromDecl(Codegen* cg, NodeId declId, Str alias, NodeId* args, u32 argsLen,
                     Ty* outRet, bool* found, NodeId* outDecl)
{
    *found = false;
    *outRet = 0;
    if (outDecl != null) { outDecl->index = 0; }
    if (declId.index == 0) return Slice::from(null, 0);
    Node* ddn = cgNode(cg, declId);
    Decl* dd = &ddn.kind.payload.Decl.value;
    if (ddn.kind.tag != NodeKind::Decl || dd.kind.tag != DeclKind::Func) return Slice::from(null, 0);
    if (outDecl != null) *outDecl = declId;
    if (cg.mono == null || cg.mono.genericCount(declId) == 0) {
        *found = true;
        *outRet = dd.kind.payload.Func.returnType;
        return cgMangle(cg, declId, dd.kind.payload.Func.name, alias);
    }
    /* generic: pick the mono instance whose collected argument types and
     * Zig-style value key match this call site (the key is computed over
     * the same arg nodes collectCall saw, including the substituted type
     * of every arg, so runtime-tail types select their own instance) */
    u64 callKey = cg.mono.callValueKeyTyped(args, argsLen, cg.subs, cg.subsLen);
    u32 gcount = cg.mono.genericCount(declId);
    Ty* want = null;
    if (gcount > 0)
    {
        want = alloc<Ty>((usize)gcount);
        if (want == null) { cgError(cg, "out of memory"); return Slice::from(null, 0); }
        zero<Ty>(want, (usize)gcount);
        cg.mono.inferCallArgs(declId, args, argsLen, cg.subs, cg.subsLen, want);
    }
    u32 total = 0;
    u32 firstTotal = 0;
    u32 keyPick = 0;
    u32 typePick = 0;
    u32 typeMatches = 0;
    u32 i = 0;
    while (i < cg.mono.instancesLen)
    {
        MonoInstance* inst = cg.mono.instances + i;
        if (inst.kind == MonoInstanceKind::FunctionInstance && inst.declaration.index == declId.index)
        {
            if (total == 0) firstTotal = i;
            total++;
            bool ok = true;
            if (inst.argumentsLen == gcount) {
                u32 k = 0;
                while (k < gcount) {
                    if (want == null || want[k] == 0 ||
                        !cg.sema.sameType(want[k], inst.arguments[k])) { ok = false; break; }
                    k++;
                }
            } else {
                ok = false;
            }
            if (ok) {
                typeMatches++;
                if (typePick == 0) typePick = i + 1;
                if (keyPick == 0 && inst.valueKey == callKey) keyPick = i + 1;
            }
        }
        i++;
    }
    if (want != null) dealloc<Ty>(want);
    if (total == 0) return Slice::from(null, 0);
    /* preference: exact value-key match; else the lone argument-type
     * match when it carries no value key; else the first instance of the
     * decl, with a diagnostic */
    u32 pick = firstTotal;
    if (keyPick != 0) pick = keyPick - 1;
    else if (typeMatches == 1 && cg.mono.instances[typePick - 1].valueKey == 0) pick = typePick - 1;
    else {
        /* no argument+value match, and the fallback (a lone unkeyed
           instance) is unavailable: surface the mismatch */
        cgError(cg, "no unique mono instance for call");
    }
    MonoInstance* p = cg.mono.instances + pick;
    *found = true;
    *outRet = p.returnType;
    return cgMangleS(cg, p.declaration,
                     cgInstanceNameV(cg, p.name, p.arguments, p.argumentsLen, p.valueKey), alias);
}

Slice cgResolveCall(Codegen* cg, Str name, NodeId* args, u32 argsLen, Ty* outRet, bool* found, NodeId refSite, NodeId* outDecl)
{
    *found = false;
    *outRet = 0;
    if (outDecl != null) { outDecl->index = 0; }
    Str alias = 0;
    NodeId declId = cgResolveRef(cg, name, (u32)DeclKind::Func, refSite, &alias);
    Slice r = cgCallFromDecl(cg, declId, alias, args, argsLen, outRet, found, outDecl);
    if (*found) return r;
    /* the scope binding (or file preference) pointed at a generic
     * template with no usable instance: any non-generic decl of the
     * same name still emits (matches the pre-mangling decl-order pick) */
    if (cg.file != null && name != 0)
    {
        u32 q = 0;
        while (q < cg.file.declsLen)
        {
            NodeId qid = cg.file.decls[q];
            Node* dnq = cg.ctx->nodes + qid.index;
            if (dnq.kind.tag == NodeKind::Decl)
            {
                Decl* ddq = &dnq.kind.payload.Decl.value;
                if (ddq.kind.tag == DeclKind::Func && ddq.kind.payload.Func.name == name &&
                    !cgDeclIsGeneric(cg, qid))
                {
                    return cgCallFromDecl(cg, qid, 0, args, argsLen, outRet, found, outDecl);
                }
            }
            q++;
        }
    }
    return r;
}

/* fileId of the file a module import path points at: the path joined
 * with '/' (+ ".crl") must be a suffix of the file's own path (lib files
 * carry extra platform segments in between) */
u32 cgFileForModulePath(Codegen* cg, Str path)
{
    if (path == 0 || cg.sema == null || cg.sema.diag == null) return 0;
    Slice p = cgIntern(cg, path);
    if (p.len == 0 || cg.sema.diag.fileCount == 0) return 0;
    Stream s = stNew(cg.arena, 64);
    usize i = 0;
    while (i < p.len)
    {
        if (i + 1 < p.len && p.ptr[i] == 58 && p.ptr[i + 1] == 58) { stCh(&s, '/'); i += 2; }
        else { stCh(&s, p.ptr[i]); i++; }
    }
    bool hasCrl = s.len >= 4 && s.p[s.len - 4] == 46 && s.p[s.len - 3] == 99 &&
                  s.p[s.len - 2] == 114 && s.p[s.len - 1] == 108;
    if (!hasCrl) stP(&s, ".crl");
    if (s.len == 0) return 0;
    u32 f = 0;
    while (f < cg.sema.diag.fileCount)
    {
        str fp = cg.sema.diag.filePaths.at((usize)f);
        if (fp.ptr != null && fp.len >= s.len)
        {
            bool ok = true;
            usize j = 0;
            while (j < s.len)
            {
                if (fp.ptr[fp.len - s.len + j] != s.p[j]) { ok = false; break; }
                j++;
            }
            if (ok) return f;
        }
        f++;
    }
    return 0;
}

/* Name for an explicit-generic call `f<T>(...)`: the mono instance bound to
 * the callee's generic arguments. When several instances share the same
 * generic args, the call site's value key (computed from the call's own
 * arg nodes, exactly like cgCallFromDecl) picks the right one: first
 * match otherwise. Null slice when no instance matches; *outDecl always
 * receives the callee's declaration when found. */
Slice cgResolveGenericCall(Codegen* cg, Str fname, Ty namedTy, Ty* outRet, bool* found, NodeId* outDecl, NodeId refSite,
                           NodeId* args, u32 argsLen)
{
    *found = false;
    *outRet = 0;
    if (outDecl != null) { outDecl->index = 0; }
    u64 wantKey = 0;
    if (cg.mono != null) wantKey = cg.mono.callValueKeyTyped(args, argsLen, cg.subs, cg.subsLen);
    Ty* gargs = null;
    u32 glen = 0;
    Ty* gbuf = null;
    if (namedTy != 0)
    {
        TypeEntry* ne = cg.ctx->types + namedTy;
        if (ne->kind.tag == TypeKind::Named)
        {
            gargs = ne->kind.payload.Named.genericArgs;
            glen = ne->kind.payload.Named.genericArgsLen;
        }
    }
    if (glen > 0 && cg.subs != null && cg.subsLen > 0)
    {
        /* inside an instance body the callee's explicit args may be the
         * template's own params (`dealloc<T>` in realloc<cchar>): resolve
         * them through the current substitutions before instance matching */
        gbuf = alloc<Ty>((usize)glen);
        if (gbuf != null)
        {
            u32 gi = 0;
            while (gi < glen)
            {
                gbuf[gi] = cg.mono.substituteType(gargs[gi], cg.subs, cg.subsLen);
                gi++;
            }
            gargs = gbuf;
        }
    }
    /* the declaring file's decl owns the instance (the name may be
     * ambiguous across merged files: libc's extern realloc vs mman's
     * realloc<T>): resolve through sema like every other reference */
    Str alias = 0;
    NodeId declId = cgResolveRef(cg, fname, (u32)DeclKind::Func, refSite, &alias);
    if (declId.index != 0 && cg.mono != null && cg.sema != null && glen > 0)
    {
        u32 pick = 0;
        u32 i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::FunctionInstance && inst.declaration.index == declId.index &&
                inst.argumentsLen == glen)
            {
                bool ok = true;
                u32 k = 0;
                while (k < glen)
                {
                    if (!cg.sema.sameType(inst.arguments[k], gargs[k])) { ok = false; break; }
                    k++;
                }
                if (ok)
                {
                    if (pick == 0) pick = i + 1;
                    if (wantKey != 0 && inst.valueKey == wantKey) { pick = i + 1; break; }
                }
            }
            i++;
        }
        if (pick != 0)
        {
            MonoInstance* inst = cg.mono.instances + pick - 1;
            *found = true;
            *outRet = inst.returnType;
            if (outDecl != null) *outDecl = inst.declaration;
            if (gbuf != null) dealloc<Ty>(gbuf);
            return cgMangleS(cg, inst.declaration,
                             cgInstanceNameV(cg, inst.name, inst.arguments, inst.argumentsLen, inst.valueKey), alias);
        }
    }
    // unresolved decl: fall back to a name+args instance scan (no alias)
    if (cg.mono != null && cg.sema != null && glen > 0)
    {
        u32 pick = 0;
        u32 i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::FunctionInstance && inst.name == fname &&
                inst.argumentsLen == glen)
            {
                bool ok = true;
                u32 k = 0;
                while (k < glen)
                {
                    if (!cg.sema.sameType(inst.arguments[k], gargs[k])) { ok = false; break; }
                    k++;
                }
                if (ok)
                {
                    if (pick == 0) pick = i + 1;
                    if (wantKey != 0 && inst.valueKey == wantKey) { pick = i + 1; break; }
                }
            }
            i++;
        }
        if (pick != 0)
        {
            MonoInstance* inst = cg.mono.instances + pick - 1;
            *found = true;
            *outRet = inst.returnType;
            if (outDecl != null) *outDecl = inst.declaration;
            if (gbuf != null) dealloc<Ty>(gbuf);
            return cgMangleS(cg, inst.declaration,
                             cgInstanceNameV(cg, inst.name, inst.arguments, inst.argumentsLen, inst.valueKey), 0);
        }
    }
    if (declId.index != 0 && outDecl != null) *outDecl = declId;
    if (gbuf != null) dealloc<Ty>(gbuf);
    return Slice::from(null, 0);
}

/* StringLit token text keeps its surrounding quotes (cgExpr strips them
   on emission): asm pieces/constraints are stored raw, so unquote here */
Slice cgUnquote(Codegen* cg, Slice s)
{
    if (s.len >= 2 && s.ptr[0] == '"') return Slice::from(s.ptr + 1, s.len - 2);
    return s;
}

/* ── C type emission ─────────────────────────────────────────── */

extern("C") Slice tyStr(Codegen* cg, Ty t);

/* append text at [start, ...): tyStr arms all write into tybuf so nested
   composition never re-appends a slice of the same buffer */
Slice tyStrPut(Codegen* cg, Slice text, usize start)
{
    stPS(&cg.tybuf, text);
    return stTail(&cg.tybuf, start);
}

Slice tyStr(Codegen* cg, Ty t)
{
    if (t == 0) return Slice::fromStr("void*");
    TypeEntry* e = cg.ctx->types + t;
    TypeKind k = e.kind;
    usize start = cg.tybuf.len;
    switch (k.tag)
    {
        TypeKind::Void => { return tyStrPut(cg, Slice::fromStr("void"), start); },
        TypeKind::Bool => { return tyStrPut(cg, Slice::fromStr("_Bool"), start); },
        // char = UTF-32 codepoint (u32 width), never C's 1-byte char
        TypeKind::Char => { return tyStrPut(cg, Slice::fromStr("uint32_t"), start); },
        TypeKind::I8 => { return tyStrPut(cg, Slice::fromStr("int8_t"), start); },
        TypeKind::U8 => { return tyStrPut(cg, Slice::fromStr("uint8_t"), start); },
        TypeKind::I16 => { return tyStrPut(cg, Slice::fromStr("int16_t"), start); },
        TypeKind::U16 => { return tyStrPut(cg, Slice::fromStr("uint16_t"), start); },
        TypeKind::I32 => { return tyStrPut(cg, Slice::fromStr("int32_t"), start); },
        TypeKind::U32 => { return tyStrPut(cg, Slice::fromStr("uint32_t"), start); },
        TypeKind::I64 => { return tyStrPut(cg, Slice::fromStr("int64_t"), start); },
        TypeKind::U64 => { return tyStrPut(cg, Slice::fromStr("uint64_t"), start); },
        TypeKind::I128 => { return tyStrPut(cg, Slice::fromStr("__int128_t"), start); },
        TypeKind::U128 => { return tyStrPut(cg, Slice::fromStr("__uint128_t"), start); },
        TypeKind::F32 => { return tyStrPut(cg, Slice::fromStr("float"), start); },
        TypeKind::F64 => { return tyStrPut(cg, Slice::fromStr("double"), start); },
        TypeKind::Isize => { return tyStrPut(cg, Slice::fromStr("intptr_t"), start); },
        TypeKind::Usize => { return tyStrPut(cg, Slice::fromStr("size_t"), start); },
        TypeKind::Rawptr => { return tyStrPut(cg, Slice::fromStr("void*"), start); },
        // str = immutable slice view { ptr, len } (preamble typedef)
        TypeKind::Str => { return tyStrPut(cg, Slice::fromStr("_coral_str"), start); },
        TypeKind::Error => { return tyStrPut(cg, Slice::fromStr("void"), start); },
        TypeKind::Named => {
            // inside an instance: resolve a bare generic parameter name
            Ty sub = cgSubstTy(cg, t);
            if (sub != t) return tyStr(cg, sub);
            Str name = k.payload.Named.name;
            /* cchar = the C-ABI byte type → C's plain `char` (the platform
             * char signedness matches cchar's flag(i8/u8) arms, and libc
             * prototypes take `char`). coral `char` itself is utf32 and
             * emits uint32_t, never C's char. */
            if (slEqU8(cgIntern(cg, name), "cchar"))
                return tyStrPut(cg, Slice::fromStr("char"), start);
            if (k.payload.Named.genericArgsLen > 0) {
                return cgInstanceName(cg, name, k.payload.Named.genericArgs, k.payload.Named.genericArgsLen);
            }
            // alias? find `typedef` decl with this name and follow it
            File* file = cg.file;
            if (file != null) {
                u32 i = 0;
                while (i < file.declsLen)
                {
                    Node* d = cg.ctx->nodes + file.decls[i].index;
                    if (d.kind.tag == NodeKind::Decl)
                    {
                        Decl* dd = &d.kind.payload.Decl.value;
                        if (dd.kind.tag == DeclKind::TypeAlias)
                        {
                            if (dd.kind.payload.TypeAlias.name == name)
                                return tyStr(cg, dd.kind.payload.TypeAlias.target);
                        }
                    }
                    i++;
                }
            }
            /* mangle through the declaring decl: the type's own file
             * (TypeEntry.loc) picks the right one when several files
             * declare the same type name */
            NodeId td = cgFindTypeDecl(cg, name, locFile(e.loc));
            if (td.index != 0) return tyStrPut(cg, cgMangle(cg, td, name, 0), start);
            return tyStrPut(cg, cgIdent(cg, name), start);
        },
        TypeKind::Pointer => {
            tyStr(cg, k.payload.Pointer.base);
            stCh(&cg.tybuf, '*');
            return stTail(&cg.tybuf, start);
        },
        TypeKind::Const => {
            Ty base = k.payload.Const.base;
            TypeEntry* be = cg.ctx->types + base;
            if (be.kind.tag == TypeKind::Pointer) {
                tyStr(cg, base);
                stP(&cg.tybuf, " const");
                return stTail(&cg.tybuf, start);
            }
            stP(&cg.tybuf, "const ");
            tyStr(cg, base);
            return stTail(&cg.tybuf, start);
        },
        TypeKind::Comptime => { return tyStr(cg, k.payload.Comptime.base); },
        TypeKind::TypeParam => {
            Ty sub = cgSubstTy(cg, t);
            if (sub != t) return tyStr(cg, sub);
            cgError(cg, "unresolved type param in codegen");
            return tyStrPut(cg, Slice::fromStr("void*"), start);
        },
        TypeKind::Slice => { return cgRegName(cg, t); },
        TypeKind::FnPtr => { return cgRegName(cg, t); },
        TypeKind::Tuple => { return cgRegName(cg, t); },
        /* comptime value mangling fragment: `Arr_int32_t_4` */
        TypeKind::ValueInt => {
            stU64(&cg.tybuf, k.payload.ValueInt.value);
            return stTail(&cg.tybuf, start);
        },
        TypeKind::Array => {
            tyStr(cg, k.payload.Array.base);
            stCh(&cg.tybuf, '[');
            stU64(&cg.tybuf, cgSubsArrayLen(cg, k.payload.Array.sizeParam, k.payload.Array.sizeName, (u64)k.payload.Array.len));
            stCh(&cg.tybuf, ']');
            return stTail(&cg.tybuf, start);
        },
        else => { return tyStrPut(cg, Slice::fromStr("void*"), start); },
    }
    return stTail(&cg.tybuf, start);
}

/* ── registered typedefs (slices, tuples, fn pointers) ───────── */

/* registry of already-emitted typedef names (slices/tuples/fn pointers):
 * cgRegName dedups against it, cgRegAdd records a fresh name right before
 * its text lands in tdecl */
bool cgRegHas(Codegen* cg, Slice name)
{
    u32 i = 0;
    while (i < cg.regLen)
    {
        Slice r = cg.regNames[i];
        if (r.len == name.len) {
            bool eq = true;
            usize j = 0;
            while (j < name.len) {
                if (r.ptr[j] != name.ptr[j]) { eq = false; break; }
                j++;
            }
            if (eq) return true;
        }
        i++;
    }
    return false;
}

void cgRegAdd(Codegen* cg, Slice name)
{
    if (cg.regLen >= cg.regCap) return;
    cg.regNames[cg.regLen] = name;
    cg.regLen++;
}

/* has the C symbol already been emitted in this phase (protos / bodies)?
 * `proto` picks the registry so the body pass still runs after the
 * proto pass has seen the same name */
bool cgFnSeen(Codegen* cg, Slice name, bool proto)
{
    Slice* names = cg.bodyFnNames;
    u32 len = cg.bodyFnLen;
    if (proto) { names = cg.protoFnNames; len = cg.protoFnLen; }
    if (names == null) return false;
    u32 i = 0;
    while (i < len)
    {
        if (cgSliceEq(names[i], name)) return true;
        i++;
    }
    return false;
}

void cgFnSee(Codegen* cg, Slice name, bool proto)
{
    if (proto)
    {
        if (cg.protoFnNames != null && cg.protoFnLen < cg.protoFnCap)
        {
            cg.protoFnNames[cg.protoFnLen] = name;
            cg.protoFnLen++;
        }
    }
    else
    {
        if (cg.bodyFnNames != null && cg.bodyFnLen < cg.bodyFnCap)
        {
            cg.bodyFnNames[cg.bodyFnLen] = name;
            cg.bodyFnLen++;
        }
    }
}

extern("C") Slice cgRegName(Codegen* cg, Ty t);

Slice cgRegName(Codegen* cg, Ty t)
{
    TypeEntry* e = cg.ctx->types + t;
    TypeKind k = e.kind;
    usize nstart = cg.tybuf.len;

    if (k.tag == TypeKind::Slice) {
        stP(&cg.tybuf, "Slice_");
        tyStr(cg, k.payload.Slice.base);
    } else if (k.tag == TypeKind::FnPtr) {
        /* name from the SUBSTITUTED spelling: `bool(T,T)` under Vec<str>
         * and Vec<i32> shares one type id but needs two typedefs */
        stP(&cg.tybuf, "FnP_");
        tyStr(cg, k.payload.FnPtr.returnType);
        u32 fi = 0;
        while (fi < k.payload.FnPtr.paramsLen)
        {
            stCh(&cg.tybuf, 95);
            tyStr(cg, k.payload.FnPtr.params[fi]);
            fi++;
        }
        // same mapping as cgMangleTy: `int32_t*` → `int32_t_p`
        usize si = nstart;
        while (si < cg.tybuf.len)
        {
            u8 c = cg.tybuf.p[si];
            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;
            if (ok) { }
            else if (c == 42) cg.tybuf.p[si] = 112;
            else cg.tybuf.p[si] = 95;
            si++;
        }
    } else {
        stP(&cg.tybuf, "_coral_tuple_");
        u32 i = 0;
        while (i < k.payload.Tuple.elemsLen)
        {
            if (i > 0) stCh(&cg.tybuf, '_');
            tyStr(cg, k.payload.Tuple.elems[i]);
            i++;
        }
    }
    Slice name = stTail(&cg.tybuf, nstart);
    if (cgRegHas(cg, name)) return name;
    cgRegAdd(cg, name);

    // dependency typedefs first
    if (k.tag == TypeKind::Slice) cgRegEnsure(cg, k.payload.Slice.base);
    if (k.tag == TypeKind::FnPtr) {
        cgRegEnsure(cg, k.payload.FnPtr.returnType);
        u32 i = 0;
        while (i < k.payload.FnPtr.paramsLen) {
            cgRegEnsure(cg, k.payload.FnPtr.params[i]);
            i++;
        }
    }
    if (k.tag == TypeKind::Tuple) {
        u32 i = 0;
        while (i < k.payload.Tuple.elemsLen) {
            cgRegEnsure(cg, k.payload.Tuple.elems[i]);
            i++;
        }
    }

    // emit the typedef
    if (k.tag == TypeKind::Slice) {
        stP(&cg.tdecl, "typedef struct ");
        stPS(&cg.tdecl, name);
        stP(&cg.tdecl, " { ");
        stPS(&cg.tdecl, tyStr(cg, k.payload.Slice.base));
        stP(&cg.tdecl, "* ptr; size_t len; } ");
        stPS(&cg.tdecl, name);
        stP(&cg.tdecl, ";\n");
    } else if (k.tag == TypeKind::FnPtr) {
        stP(&cg.tdecl, "typedef ");
        stPS(&cg.tdecl, tyStr(cg, k.payload.FnPtr.returnType));
        stP(&cg.tdecl, " (*");
        stPS(&cg.tdecl, name);
        stP(&cg.tdecl, ")(");
        u32 i = 0;
        while (i < k.payload.FnPtr.paramsLen)
        {
            if (i > 0) stP(&cg.tdecl, ", ");
            stPS(&cg.tdecl, tyStr(cg, k.payload.FnPtr.params[i]));
            i++;
        }
        stP(&cg.tdecl, ");\n");
    } else {
        stP(&cg.tdecl, "typedef struct ");
        stPS(&cg.tdecl, name);
        stP(&cg.tdecl, " {\n");
        u32 i = 0;
        while (i < k.payload.Tuple.elemsLen)
        {
            stP(&cg.tdecl, "    ");
            stPS(&cg.tdecl, tyStr(cg, k.payload.Tuple.elems[i]));
            stP(&cg.tdecl, " _");
            stU64(&cg.tdecl, (u64)(i + 1));
            stP(&cg.tdecl, ";\n");
            i++;
        }
        stP(&cg.tdecl, "} ");
        stPS(&cg.tdecl, name);
        stP(&cg.tdecl, ";\n");
    }
    return name;
}

void cgRegEnsure(Codegen* cg, Ty t)
{
    if (t == 0) return;
    TypeEntry* e = cg.ctx->types + t;
    TypeKind k = e.kind;
    if (k.tag == TypeKind::Slice || k.tag == TypeKind::FnPtr || k.tag == TypeKind::Tuple)
        cgRegName(cg, t);
}

/* ── helpers ─────────────────────────────────────────────────── */

Node* cgNode(Codegen* cg, NodeId id)
{
    return cg.ctx->nodes + id.index;
}

// C type text for a value expression node (0-safe).
Slice cgValExprTy(Codegen* cg, NodeId id)
{
    if (id.index == 0) return Slice::fromStr("void*");
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return Slice::fromStr("void*");
    return cgResultTy(cg, id, &n.kind.payload.Expr.value);
}

/* --allow-int-ptr lowering: sema waived an integer→pointer bind, but gcc
 * still rejects the bare conversion: emit the explicit C cast instead */
bool cgIntTyTag(Codegen* cg, Ty t)
{
    if (t == 0) return false;
    TypeEntry* e = cg.ctx->types + t;
    return e->kind.tag == TypeKind::U8 || e->kind.tag == TypeKind::U16 || e->kind.tag == TypeKind::U32 ||
           e->kind.tag == TypeKind::U64 || e->kind.tag == TypeKind::U128 || e->kind.tag == TypeKind::I8 ||
           e->kind.tag == TypeKind::I16 || e->kind.tag == TypeKind::I32 || e->kind.tag == TypeKind::I64 ||
           e->kind.tag == TypeKind::I128 || e->kind.tag == TypeKind::Usize || e->kind.tag == TypeKind::Isize ||
           e->kind.tag == TypeKind::Char;
}

bool cgPtrTyTag(Codegen* cg, Ty t)
{
    while (t != 0)
    {
        TypeEntry* e = cg.ctx->types + t;
        if (e->kind.tag == TypeKind::Pointer || e->kind.tag == TypeKind::Rawptr) return true;
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else return false;
    }
    return false;
}

bool cgIntToPtrInit(Codegen* cg, NodeId value, Ty targetTy)
{
    if (value.index == 0 || targetTy == 0) return false;
    if (!cgPtrTyTag(cg, targetTy)) return false;
    Node* n = cgNode(cg, value);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* ev = &n.kind.payload.Expr.value;
    if (ev->kind.tag == ExprKind::IntLit) return true;
    return cgIntTyTag(cg, ev->resolvedType);
}

Slice cgWrapPtrCast(Codegen* cg, Slice tyText, Slice inner)
{
    usize rs = cg.ebuf.len;
    stP(&cg.ebuf, "((");
    stPS(&cg.ebuf, tyText);
    stP(&cg.ebuf, ")(");
    stPS(&cg.ebuf, inner);
    stP(&cg.ebuf, "))");
    return stTail(&cg.ebuf, rs);
}

/* C type text for an expression: sema's resolvedType when present, else
 * derived from the kind (Not → _Bool, AddressOf → base + '*', assignments
 * → the assigned value's type) */
Slice cgResultTy(Codegen* cg, NodeId id, Expr* e)
{
    if (e.resolvedType != 0) return tyStr(cg, cgSubstTy(cg, e.resolvedType));
    switch (e.kind.tag)
    {
        ExprKind::Not => { return Slice::fromStr("_Bool"); },
        ExprKind::AddressOf => {
            NodeId c = e.kind.payload.AddressOf.expr;
            Node* cn = cgNode(cg, c);
            Slice base = Slice::fromStr("void*");
            usize s = cg.tybuf.len;
            if (cn.kind.tag == NodeKind::Expr)
                base = cgResultTy(cg, c, &cn.kind.payload.Expr.value);
            /* base usually IS the tail of tybuf already; appending it
             * again would print the type twice, so only copy when it
             * came from somewhere else */
            if (!(base.ptr + base.len == cg.tybuf.p + cg.tybuf.len))
                stPS(&cg.tybuf, base);
            stCh(&cg.tybuf, '*');
            return stTail(&cg.tybuf, s);
        },
        ExprKind::Assign => { return cgValExprTy(cg, e.kind.payload.Assign.value); },
        ExprKind::AssignAdd => { return cgValExprTy(cg, e.kind.payload.AssignAdd.value); },
        ExprKind::AssignSub => { return cgValExprTy(cg, e.kind.payload.AssignSub.value); },
        ExprKind::AssignMul => { return cgValExprTy(cg, e.kind.payload.AssignMul.value); },
        ExprKind::AssignDiv => { return cgValExprTy(cg, e.kind.payload.AssignDiv.value); },
        ExprKind::AssignMod => { return cgValExprTy(cg, e.kind.payload.AssignMod.value); },
        ExprKind::AssignBitAnd => { return cgValExprTy(cg, e.kind.payload.AssignBitAnd.value); },
        ExprKind::AssignBitOr => { return cgValExprTy(cg, e.kind.payload.AssignBitOr.value); },
        ExprKind::AssignBitXor => { return cgValExprTy(cg, e.kind.payload.AssignBitXor.value); },
        ExprKind::AssignShl => { return cgValExprTy(cg, e.kind.payload.AssignShl.value); },
        ExprKind::AssignShr => { return cgValExprTy(cg, e.kind.payload.AssignShr.value); },
        else => {},
    }
    return Slice::fromStr("void*");
}

void cgEmitStmt(Codegen* cg, str text)
{
    stNL(&cg.body, cg.ind);
    stPS(&cg.body, Slice::fromStr(text));
    stCh(&cg.body, ';');
}

void cgEmitLine(Codegen* cg, Slice a, str mid, Slice b)
{
    stNL(&cg.body, cg.ind);
    stPS(&cg.body, a);
    stP(&cg.body, mid);
    stPS(&cg.body, b);
    stCh(&cg.body, ';');
}

void cgEmitLabel(Codegen* cg, u32 lab)
{
    stNL(&cg.body, cg.ind);
    stP(&cg.body, "__L");
    stU64(&cg.body, (u64)lab);
    stP(&cg.body, ": ;"); // a label must precede a statement: the empty one
}

void cgEmitGoto(Codegen* cg, u32 lab)
{
    stNL(&cg.body, cg.ind);
    stP(&cg.body, "goto __L");
    stU64(&cg.body, (u64)lab);
    stCh(&cg.body, ';');
}

bool slEqU8(Slice a, str b)
{
    if (a.len != b.len) return false;
    usize i = 0;
    while (i < b.len) {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

/* identifiers that collide with a C keyword (or a stdlib macro) get a
 * trailing underscore so the generated C stays valid */
Slice cgIdent(Codegen* cg, Str name)
{
    Slice t = cgIntern(cg, name);
    if (slEqU8(t, "auto") ||
        slEqU8(t, "break") ||
        slEqU8(t, "case") ||
        slEqU8(t, "char") ||
        slEqU8(t, "const") ||
        slEqU8(t, "continue") ||
        slEqU8(t, "default") ||
        slEqU8(t, "do") ||
        slEqU8(t, "double") ||
        slEqU8(t, "else") ||
        slEqU8(t, "enum") ||
        slEqU8(t, "extern") ||
        slEqU8(t, "float") ||
        slEqU8(t, "for") ||
        slEqU8(t, "goto") ||
        slEqU8(t, "if") ||
        slEqU8(t, "inline") ||
        slEqU8(t, "int") ||
        slEqU8(t, "long") ||
        slEqU8(t, "register") ||
        slEqU8(t, "restrict") ||
        slEqU8(t, "return") ||
        slEqU8(t, "short") ||
        slEqU8(t, "signed") ||
        slEqU8(t, "sizeof") ||
        slEqU8(t, "static") ||
        slEqU8(t, "struct") ||
        slEqU8(t, "switch") ||
        slEqU8(t, "typedef") ||
        slEqU8(t, "union") ||
        slEqU8(t, "unsigned") ||
        slEqU8(t, "void") ||
        slEqU8(t, "volatile") ||
        slEqU8(t, "while") ||
        slEqU8(t, "bool") ||
        slEqU8(t, "true") ||
        slEqU8(t, "false") ||
        slEqU8(t, "size_t") ||
        slEqU8(t, "NULL"))
    {
        usize ns = cg.tybuf.len;
        stPS(&cg.tybuf, t);
        stCh(&cg.tybuf, '_');
        return stTail(&cg.tybuf, ns);
    }
    return t;
}

bool cgIsCrtFn(Str name, Slice text)
{
    /* provided by the preamble headers; compared inline (no local arrays:
       bootstrap C emission can't spell array locals) */
    return slEqU8(text, "printf") ||
           slEqU8(text, "write") ||
           slEqU8(text, "read") ||
           slEqU8(text, "malloc") ||
           slEqU8(text, "calloc") ||
           slEqU8(text, "realloc") ||
           slEqU8(text, "free") ||
           slEqU8(text, "strlen") ||
           slEqU8(text, "strcmp") ||
           slEqU8(text, "exit") ||
           slEqU8(text, "abort") ||
           slEqU8(text, "puts") ||
           slEqU8(text, "strchr") ||
           slEqU8(text, "strncpy") ||
           slEqU8(text, "abs") ||
           slEqU8(text, "fflush") ||
           slEqU8(text, "strcpy") ||
           slEqU8(text, "snprintf") ||
           slEqU8(text, "chdir") ||
           slEqU8(text, "rmdir") ||
           slEqU8(text, "unlink") ||
           slEqU8(text, "rename") ||
           slEqU8(text, "access") ||
           slEqU8(text, "fopen") ||
           slEqU8(text, "fclose") ||
           slEqU8(text, "fread") ||
           slEqU8(text, "fwrite") ||
           slEqU8(text, "feof") ||
           slEqU8(text, "ferror") ||
           slEqU8(text, "mkstemp") ||
           slEqU8(text, "mkdtemp") ||
           slEqU8(text, "execvp") ||
           slEqU8(text, "getenv") ||
           slEqU8(text, "setenv") ||
           slEqU8(text, "unsetenv") ||
           slEqU8(text, "readlink");
}

// owner name for a method receiver type: strip one pointer level
Slice cgOwnerName(Codegen* cg, Ty selfTy)
{
    TypeEntry* e = cg.ctx->types + selfTy;
    Ty u = selfTy;
    if (e.kind.tag == TypeKind::Pointer) u = e.kind.payload.Pointer.base;
    TypeEntry* ue = cg.ctx->types + u;
    /* method symbol suffixes key off the bare coral owner name: def and
     * call sides both compose `owner_method` from it; but tyStr now
     * path-mangles type names, so a plain non-generic Named must not go
     * through it (the self *parameter* uses cgOwnerTypeName instead) */
    if (ue.kind.tag == TypeKind::Named && ue.kind.payload.Named.genericArgsLen == 0)
    {
        Ty sub = cgSubstTy(cg, u);
        if (sub == u) return cgIdent(cg, ue.kind.payload.Named.name);
        return tyStr(cg, sub);
    }
    return tyStr(cg, u);
}

/* the receiver's C type name for the self parameter: tyStr (path-mangled
 * through the type's declaring decl), pointer level stripped like
 * cgOwnerName: cgOwnerName stays bare because it also forms symbol
 * suffixes */
Slice cgOwnerTypeName(Codegen* cg, Ty selfTy)
{
    Ty u = selfTy;
    TypeEntry* e = cg.ctx->types + selfTy;
    if (e.kind.tag == TypeKind::Pointer) u = e.kind.payload.Pointer.base;
    TypeEntry* e2 = cg.ctx->types + u;
    if (e2.kind.tag == TypeKind::Const) u = e2.kind.payload.Const.base;
    return tyStr(cg, u);
}

/* does the receiver's named struct/union declare field `name`? Used to
 * spot fn-pointer field calls (`p->alloc(ctx, size)` parses as a method) */
bool cgHasField(Codegen* cg, Ty t, Str name)
{
    Ty u = cgTyUnwrap(cg, t);
    if (u != 0 && (cg.ctx->types + u)->kind.tag == TypeKind::Pointer)
        u = cgTyUnwrap(cg, (cg.ctx->types + u)->kind.payload.Pointer.base);
    if (u == 0 || (cg.ctx->types + u)->kind.tag != TypeKind::Named) return false;
    Str tn = (cg.ctx->types + u)->kind.payload.Named.name;
    NodeId d = cgFindDecl(cg, tn, (u32)DeclKind::Struct);
    if (d.index == 0) d = cgFindDecl(cg, tn, (u32)DeclKind::Union);
    if (d.index == 0) return false;
    Node* dn = cgNode(cg, d);
    if (dn.kind.tag != NodeKind::Decl) return false;
    Decl* dd = &dn.kind.payload.Decl.value;
    NodeId* fields = null;
    u32 flen = 0;
    if (dd.kind.tag == DeclKind::Struct) {
        fields = dd.kind.payload.Struct.fields;
        flen = dd.kind.payload.Struct.fieldsLen;
    } else if (dd.kind.tag == DeclKind::Union) {
        fields = dd.kind.payload.Union.fields;
        flen = dd.kind.payload.Union.fieldsLen;
    } else return false;
    u32 i = 0;
    while (i < flen)
    {
        Node* fn = cgNode(cg, fields[i]);
        if (fn.kind.tag == NodeKind::Field && fn.kind.payload.Field.value.name == name) return true;
        i++;
    }
    return false;
}

/* receiver for a method call: 0 = none (static), 1 = by value,
 * 2 = explicit `self` parameter (pointer); *found = the method exists
 * on the receiver type (false = not a real method, e.g. a fn-pointer
 * field call like `alloc->fallback->alloc(...)`) */
u8 cgMethodRecvKind(Codegen* cg, Ty recvTy, Str method, bool* found)
{
    *found = false;
    if (recvTy == 0 || cg.file == null) return 1;
    TypeEntry* e = cg.ctx->types + recvTy;
    while (e.kind.tag == TypeKind::Pointer || e.kind.tag == TypeKind::Const || e.kind.tag == TypeKind::Comptime)
    {
        if (e.kind.tag == TypeKind::Pointer) recvTy = e.kind.payload.Pointer.base;
        else if (e.kind.tag == TypeKind::Const) recvTy = e.kind.payload.Const.base;
        else recvTy = e.kind.payload.Comptime.base;
        e = cg.ctx->types + recvTy;
    }
    if (e.kind.tag != TypeKind::Named) return 1;
    Str typeName = e.kind.payload.Named.name;
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cg.ctx->nodes + cg.file.decls[i].index;
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            NodeId* methods = null;
            u32 mlen = 0;
            switch (dd.kind.tag)
            {
                DeclKind::Struct => {
                    if (dd.kind.payload.Struct.name != typeName) break;
                    methods = dd.kind.payload.Struct.methods;
                    mlen = dd.kind.payload.Struct.methodsLen;
                },
                DeclKind::Union => {
                    if (dd.kind.payload.Union.name != typeName) break;
                    methods = dd.kind.payload.Union.methods;
                    mlen = dd.kind.payload.Union.methodsLen;
                },
                DeclKind::Variant => {
                    if (dd.kind.payload.Variant.name != typeName) break;
                    methods = dd.kind.payload.Variant.methods;
                    mlen = dd.kind.payload.Variant.methodsLen;
                },
                /* an extend's methods belong to its self type — without
                 * this filter a fn-pointer field call (`p->alloc(...)`,
                 * where some OTHER type has an `alloc` method) matches
                 * this unrelated extend and composes a bogus method call */
                DeclKind::Extend => {
                    Ty st = cgTyUnwrap(cg, dd.kind.payload.Extend.selfType);
                    if (st != 0 && (cg.ctx->types + st)->kind.tag == TypeKind::Pointer)
                        st = cgTyUnwrap(cg, (cg.ctx->types + st)->kind.payload.Pointer.base);
                    if (st == 0 || (cg.ctx->types + st)->kind.tag != TypeKind::Named ||
                        (cg.ctx->types + st)->kind.payload.Named.name != typeName) break;
                    methods = dd.kind.payload.Extend.methods;
                    mlen = dd.kind.payload.Extend.methodsLen;
                },
                DeclKind::ExtendTrait => {
                    Ty st = cgTyUnwrap(cg, dd.kind.payload.ExtendTrait.selfType);
                    if (st != 0 && (cg.ctx->types + st)->kind.tag == TypeKind::Pointer)
                        st = cgTyUnwrap(cg, (cg.ctx->types + st)->kind.payload.Pointer.base);
                    if (st == 0 || (cg.ctx->types + st)->kind.tag != TypeKind::Named ||
                        (cg.ctx->types + st)->kind.payload.Named.name != typeName) break;
                    methods = dd.kind.payload.ExtendTrait.methods;
                    mlen = dd.kind.payload.ExtendTrait.methodsLen;
                },
                else => {},
            }
            if (methods != null)
            {
                u32 m = 0;
                while (m < mlen)
                {
                    Node* mn = cg.ctx->nodes + methods[m].index;
                    if (mn.kind.tag == NodeKind::Decl && mn.kind.payload.Decl.value.kind.tag == DeclKind::Func)
                    {
                        Decl* md = &mn.kind.payload.Decl.value;
                        if (md.kind.payload.Func.name == method)
                        {
                            *found = true;
                            if ((md.kind.payload.Func.flags & 4) != 0) return 0;
                            if (md.kind.payload.Func.paramsLen > 0)
                            {
                                Node* p0 = cg.ctx->nodes + md.kind.payload.Func.params[0].index;
                                if (p0.kind.tag == NodeKind::Param && (p0.kind.payload.Param.value.flags & 1) != 0) return 2;
                            }
                            return 1;
                        }
                    }
                    m++;
                }
            }
        }
        i++;
    }
    return 1;
}

/* ── expressions ─────────────────────────────────────────────── */

extern("C") Slice cgExpr(Codegen* cg, NodeId id);
extern("C") Slice cgLvalue(Codegen* cg, NodeId id);
extern("C") Slice cgValBody(Codegen* cg, NodeId id);
extern("C") void cgStmt(Codegen* cg, NodeId id);
extern("C") Slice cgAddrOfValue(Codegen* cg, NodeId oid, Slice vtext);

Slice cgExpr(Codegen* cg, NodeId id)
{
    if (id.index == 0) {
        stP(&cg.ebuf, "0");
        return stTail(&cg.ebuf, cg.ebuf.len - 1);
    }
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) {
        stP(&cg.ebuf, "0");
        return stTail(&cg.ebuf, cg.ebuf.len - 1);
    }
    Expr* e = &n.kind.payload.Expr.value;
    usize es = cg.ebuf.len;

    switch (e.kind.tag)
    {
        // atoms
        ExprKind::IntLit => {
            /* Give the C literal the type sema assigned. A bare decimal
             * is `int`, so `1 << 32` (from a u64 literal) shifts a 32-bit
             * value and is undefined in C; `((uint64_t)1)` is not. */
            Ty rt = e.resolvedType != 0 ? cgSubstTy(cg, e.resolvedType) : 0;
            while (rt != 0)
            {
                TypeEntry* te = cg.ctx->types + rt;
                if (te->kind.tag == TypeKind::Const) rt = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) rt = te->kind.payload.Comptime.base;
                else break;
            }
            bool wrap = false;
            if (rt != 0)
            {
                TypeEntry* te = cg.ctx->types + rt;
                switch (te->kind.tag)
                {
                    TypeKind::I8 | TypeKind::U8 | TypeKind::I16 | TypeKind::U16 |
                    TypeKind::I32 | TypeKind::U32 | TypeKind::I64 | TypeKind::U64 |
                    TypeKind::I128 | TypeKind::U128 | TypeKind::Isize | TypeKind::Usize |
                    TypeKind::Char => { wrap = true; },
                    else => { },
                }
            }
            if (wrap)
            {
                Slice tn = tyStr(cg, rt);
                stP(&cg.ebuf, "((");
                stPS(&cg.ebuf, tn);
                stP(&cg.ebuf, ")");
                stU64(&cg.ebuf, e.kind.payload.IntLit.value);
                stP(&cg.ebuf, ")");
            }
            else
            {
                stU64(&cg.ebuf, e.kind.payload.IntLit.value);
            }
            return stTail(&cg.ebuf, es);
        },
        ExprKind::FloatLit => {
            stPS(&cg.ebuf, cgIntern(cg, e.kind.payload.FloatLit.value));
            return stTail(&cg.ebuf, es);
        },
        ExprKind::StringLit => {
            /* C"..." → plain NUL-terminated C string literal; any other
             * string literal → immutable slice, the compiler counts the len */
            Slice s = cgIntern(cg, e.kind.payload.StringLit.value);
            bool isC = (e.kind.payload.StringLit.flags & 1) != 0;
            if (isC) stP(&cg.ebuf, "\"");
            else stP(&cg.ebuf, "(_coral_str){ (const uint8_t*)\"");
            usize begin = 0;
            usize end = s.len;
            if (isC) {
                // token text is `C"…"`: drop the prefix and both quotes
                if (s.len >= 3 && s.ptr[0] == 'C' && s.ptr[1] == '"') { begin = 2; end = s.len - 1; }
            } else if (s.len >= 2 && s.ptr[0] == '"') { begin = 1; end = s.len - 1; }
            usize i = begin;
            /* decoded length for the slice: every escape counts as ONE
             * byte, which is what a coral `str` len means */
            usize dlen = 0;
            while (i < end)
            {
                u8 c = s.ptr[i];
                if (c == '\\' && i + 1 < end) {
                    u8 esc = s.ptr[i + 1];
                    if (esc == 'n') stP(&cg.ebuf, "\\n");
                    else if (esc == 't') stP(&cg.ebuf, "\\t");
                    else if (esc == 'r') stP(&cg.ebuf, "\\r");
                    else if (esc == '0') stP(&cg.ebuf, "\\0");
                    else if (esc == '"' || esc == '\\' || esc == '\'') { stCh(&cg.ebuf, '\\'); stCh(&cg.ebuf, esc); }
                    else { stCh(&cg.ebuf, esc); }
                    dlen++;
                    i += 2;
                } else if (c == '"') {
                    stP(&cg.ebuf, "\\\"");
                    dlen++;
                    i++;
                } else if (c < 32 || c > 126) {
                    /* non-printables as 3-digit octal so the C literal
                     * stays portable (hex escapes would eat following
                     * hex digits of the next char) */
                    stP(&cg.ebuf, "\\");
                    u8 v = c;
                    stCh(&cg.ebuf, (u8)(48 + (v / 64)));
                    stCh(&cg.ebuf, (u8)(48 + ((v / 8) % 8)));
                    stCh(&cg.ebuf, (u8)(48 + (v % 8)));
                    dlen++;
                    i++;
                } else {
                    stCh(&cg.ebuf, c);
                    dlen++;
                    i++;
                }
            }
            if (isC) {
                stP(&cg.ebuf, "\"");
            } else {
                stP(&cg.ebuf, "\", ");
                stU64(&cg.ebuf, (u64)dlen);
                stP(&cg.ebuf, " }");
            }
            return stTail(&cg.ebuf, es);
        },
        ExprKind::CharLit => {
            u32 v = e.kind.payload.CharLit.value;
            /* `'` (39) and `\` (92) need an escape; printable chars go
             * out as C chars, everything else as a numeric cast */
            if (v == 39 || v == 92) {
                stCh(&cg.ebuf, '\'');
                stCh(&cg.ebuf, '\\');
                stCh(&cg.ebuf, (u8)v);
                stCh(&cg.ebuf, '\'');
            } else if (v >= 32 && v < 127) {
                stCh(&cg.ebuf, '\'');
                stCh(&cg.ebuf, (u8)v);
                stCh(&cg.ebuf, '\'');
            } else {
                stP(&cg.ebuf, "(uint32_t)");
                stU64(&cg.ebuf, (u64)v);
            }
            return stTail(&cg.ebuf, es);
        },
        ExprKind::BoolLit => {
            if (e.kind.payload.BoolLit.flags & 1) stP(&cg.ebuf, "1");
            else stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },
        ExprKind::NullLit => {
            /* `null` in a str position is the empty slice, not C NULL */
            Ty nt = cgSubstTy(cg, e.resolvedType);
            if (nt != 0 && (cg.ctx->types + nt)->kind.tag == TypeKind::Str)
            {
                stP(&cg.ebuf, "(_coral_str){0}");
                return stTail(&cg.ebuf, es);
            }
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },
        ExprKind::Ident => {
            /* generic value parameter in an instance body (`N` in
             * `Arr<T, N>`: `return N;`, `self.data[N - 1]`): sema typed the
             * ident as the param; emit the instance's argument value */
            Ty vt = cgSubstTy(cg, e.resolvedType);
            if (vt != e.resolvedType && vt != 0)
            {
                TypeEntry* ve = cg.ctx->types + vt;
                if (ve.kind.tag == TypeKind::ValueInt)
                {
                    stU64(&cg.ebuf, ve.kind.payload.ValueInt.value);
                    return stTail(&cg.ebuf, es);
                }
            }
            Str nm = e.kind.payload.Ident.name;
            if (!cgIsLocalName(cg, nm))
            {
                Str alias = 0;
                NodeId rd = cgResolveRef(cg, nm, 0, id, &alias);
                if (rd.index != 0)
                {
                    Node* rn = cgNode(cg, rd);
                    if (rn.kind.tag == NodeKind::Decl)
                    {
                        Decl* rdd = &rn.kind.payload.Decl.value;
                        if (rdd.kind.tag == DeclKind::Func || rdd.kind.tag == DeclKind::Constant)
                        {
                            Str own = cgDeclOwnName(rdd);
                            if (own != 0)
                            {
                                stPS(&cg.ebuf, cgMangle(cg, rd, own, alias));
                                return stTail(&cg.ebuf, es);
                            }
                        }
                    }
                }
            }
            stPS(&cg.ebuf, cgIdent(cg, nm));
            return stTail(&cg.ebuf, es);
        },
        ExprKind::Path => {
            u32 last = e.kind.payload.Path.segmentsLen;
            if (last == 0) { stP(&cg.ebuf, "0"); return stTail(&cg.ebuf, es); }
            // enum value: `Color::Red` → Color_Red
            if (last == 2) {
                Node* seg0 = cgNode(cg, e.kind.payload.Path.segments[0]);
                if (seg0.kind.tag == NodeKind::Expr && seg0.kind.payload.Expr.value.kind.tag == ExprKind::Ident) {
                    Str root = seg0.kind.payload.Expr.value.kind.payload.Ident.name;
                    NodeId ed = cgFindDecl(cg, root, (u32)DeclKind::Enum);
                    if (ed.index != 0) {
                        Node* seg1 = cgNode(cg, e.kind.payload.Path.segments[1]);
                        if (seg1.kind.tag == NodeKind::Expr && seg1.kind.payload.Expr.value.kind.tag == ExprKind::Ident) {
                            stPS(&cg.ebuf, cgMangle(cg, ed, root, 0));
                            stCh(&cg.ebuf, '_');
                            stPS(&cg.ebuf, cgIntern(cg, seg1.kind.payload.Expr.value.kind.payload.Ident.name));
                            return stTail(&cg.ebuf, es);
                        }
                    }
                }
            }
            // variant: `Option<f64>::None` → (Option_f64){ .tag = v }
            if (last == 2)
            {
                Node* s0n = cgNode(cg, e.kind.payload.Path.segments[0]);
                Node* s1n = cgNode(cg, e.kind.payload.Path.segments[1]);
                if (s0n.kind.tag == NodeKind::Expr && s1n.kind.tag == NodeKind::Expr)
                {
                    Expr* s0 = &s0n.kind.payload.Expr.value;
                    Expr* s1 = &s1n.kind.payload.Expr.value;
                    if (s1.kind.tag == ExprKind::Ident)
                    {
                        Ty hty = 0;
                        if (s0.kind.tag == ExprKind::TypeRef) hty = s0.kind.payload.TypeRef.typeNode;
                        else if (s0.kind.tag == ExprKind::Ident) hty = e.resolvedType;
                        if (hty != 0)
                        {
                            u32 vidx = 0;
                            NodeId vd = cgFindVariantOfTy(cg, hty, s1.kind.payload.Ident.name, &vidx);
                            if (vd.index != 0)
                            {
                                Ty rty = e.resolvedType;
                                if (rty == 0) rty = hty;
                                Slice lty = tyStr(cg, cgSubstTy(cg, rty));
                                usize vs = cg.ebuf.len;
                                stP(&cg.ebuf, "((");
                                stPS(&cg.ebuf, lty);
                                stP(&cg.ebuf, "){ .tag = ");
                                stU64(&cg.ebuf, (u64)vidx);
                                stP(&cg.ebuf, "})");
                                return stTail(&cg.ebuf, vs);
                            }
                        }
                    }
                }
            }
            return cgExpr(cg, e.kind.payload.Path.segments[last - 1]);
        },
        ExprKind::Sizeof => {
            stP(&cg.ebuf, "sizeof(");
            stPS(&cg.ebuf, tyStr(cg, e.kind.payload.Sizeof.targetType));
            stCh(&cg.ebuf, ')');
            return stTail(&cg.ebuf, es);
        },
        ExprKind::Alignof => {
            stP(&cg.ebuf, "__alignof__(");
            stPS(&cg.ebuf, tyStr(cg, e.kind.payload.Alignof.targetType));
            stCh(&cg.ebuf, ')');
            return stTail(&cg.ebuf, es);
        },

        // pure inline: children become temps first, result parenthesized
        ExprKind::Neg => {
            Slice c = cgExpr(cg, e.kind.payload.Neg.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "(-(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::BitNot => {
            Slice c = cgExpr(cg, e.kind.payload.BitNot.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "(~(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::Not => {
            Slice c = cgExpr(cg, e.kind.payload.Not.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "(!(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::AddressOf => {
            NodeId oid = e.kind.payload.AddressOf.expr;
            Slice vt = cgExpr(cg, oid);
            return cgAddrOfValue(cg, oid, vt);
        },
        ExprKind::Deref => {
            Slice c = cgExpr(cg, e.kind.payload.Deref.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "(*(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::Cast => {
            /* str literal → pointer: emit the C string token directly (a
             * slice struct cannot be cast to a pointer) */
            NodeId cin = e.kind.payload.Cast.expr;
            Node* cn = cgNode(cg, cin);
            bool ptrCast = false;
            {
                Ty ctk = e.kind.payload.Cast.targetType;
                while (ctk != 0 && ((cg.ctx->types + ctk)->kind.tag == TypeKind::Const ||
                                    (cg.ctx->types + ctk)->kind.tag == TypeKind::Comptime))
                    ctk = (cg.ctx->types + ctk)->kind.payload.Const.base;
                if (ctk != 0 && (cg.ctx->types + ctk)->kind.tag == TypeKind::Pointer) ptrCast = true;
            }
            if (ptrCast && cn != null && cn->kind.tag == NodeKind::Expr &&
                cn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit &&
                (cn->kind.payload.Expr.value.kind.payload.StringLit.flags & 1) == 0)
            {
                Slice lit = cgIntern(cg, cn->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize rs2 = cg.ebuf.len;
                stP(&cg.ebuf, "((");
                stPS(&cg.ebuf, tyStr(cg, e.kind.payload.Cast.targetType));
                stP(&cg.ebuf, ")(");
                usize begin = 0;
                usize end = lit.len;
                if (end >= 2 && lit.ptr[0] == 34) { begin = 1; end--; }
                stCh(&cg.ebuf, 34);
                usize i2 = begin;
                while (i2 < end)
                {
                    u8 c2 = lit.ptr[i2];
                    if (c2 == 92 && i2 + 1 < end)
                    {
                        u8 esc = lit.ptr[i2 + 1];
                        if (esc == 'n') stP(&cg.ebuf, "\\n");
                        else if (esc == 't') stP(&cg.ebuf, "\\t");
                        else if (esc == 'r') stP(&cg.ebuf, "\\r");
                        else if (esc == '0') stP(&cg.ebuf, "\\0");
                        else if (esc == 34 || esc == 92 || esc == 39) { stCh(&cg.ebuf, 92); stCh(&cg.ebuf, esc); }
                        else { stCh(&cg.ebuf, esc); }
                        i2 += 2;
                    }
                    else if (c2 < 32 || c2 > 126)
                    {
                        stCh(&cg.ebuf, 92);
                        stCh(&cg.ebuf, (u8)(48 + (c2 / 64)));
                        stCh(&cg.ebuf, (u8)(48 + ((c2 / 8) % 8)));
                        stCh(&cg.ebuf, (u8)(48 + (c2 % 8)));
                        i2++;
                    }
                    else
                    {
                        stCh(&cg.ebuf, c2);
                        i2++;
                    }
                }
                stCh(&cg.ebuf, 34);
                stP(&cg.ebuf, "))");
                return stTail(&cg.ebuf, rs2);
            }
            /* `(u32)V::Case` is the case's ordinal, not its struct form */
            {
                u64 vcase = 0;
                if (cgVariantCaseIdx(cg, cin, &vcase))
                {
                    usize rv = cg.ebuf.len;
                    stP(&cg.ebuf, "((");
                    stPS(&cg.ebuf, tyStr(cg, e.kind.payload.Cast.targetType));
                    stP(&cg.ebuf, ")");
                    stU64(&cg.ebuf, vcase);
                    stP(&cg.ebuf, ")");
                    return stTail(&cg.ebuf, rv);
                }
            }
            /* casting a void call (`(usize)f()`) drops the value; C has
             * no cast-from-void */
            {
                Ty cit = 0;
                if (cn != null && cn->kind.tag == NodeKind::Expr)
                    cit = cgSubstTy(cg, cn->kind.payload.Expr.value.resolvedType);
                if (cit != 0 && (cg.ctx->types + cit)->kind.tag == TypeKind::Void)
                    return cgExpr(cg, cin);
            }
            Slice c = cgExpr(cg, e.kind.payload.Cast.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, tyStr(cg, e.kind.payload.Cast.targetType));
            stP(&cg.ebuf, ")(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },

        // binary → three-address temp
        ExprKind::Add, ExprKind::Sub, ExprKind::Mul, ExprKind::Div, ExprKind::Mod,
        ExprKind::Eq, ExprKind::Ne, ExprKind::Lt, ExprKind::Le, ExprKind::Gt, ExprKind::Ge,
        ExprKind::BitAnd, ExprKind::BitOr, ExprKind::BitXor, ExprKind::Shl, ExprKind::Shr => {
            NodeId left;
            NodeId right;
            str op = "+";
            switch (e.kind.tag)
            {
                ExprKind::Add => { op = " + "; },
                ExprKind::Sub => { op = " - "; },
                ExprKind::Mul => { op = " * "; },
                ExprKind::Div => { op = " / "; },
                ExprKind::Mod => { op = " % "; },
                ExprKind::Eq => { op = " == "; },
                ExprKind::Ne => { op = " != "; },
                ExprKind::Lt => { op = " < "; },
                ExprKind::Le => { op = " <= "; },
                ExprKind::Gt => { op = " > "; },
                ExprKind::Ge => { op = " >= "; },
                ExprKind::BitAnd => { op = " & "; },
                ExprKind::BitOr => { op = " | "; },
                ExprKind::BitXor => { op = " ^ "; },
                ExprKind::Shl => { op = " << "; },
                ExprKind::Shr => { op = " >> "; },
                else => {},
            }
            left = e.kind.payload.Add.left;
            right = e.kind.payload.Add.right;
            Slice l;
            Slice r;
            /* variant operands compare by tag ordinal: `V::Case` lowers to
             * its declaration index, a variant-typed value reads `.tag`.
             * covers ==/!= directly and the ordering ops (declaration order) */
            {
                u64 cidx = 0;
                bool isCmp = e.kind.tag == ExprKind::Eq || e.kind.tag == ExprKind::Ne ||
                             e.kind.tag == ExprKind::Lt || e.kind.tag == ExprKind::Le ||
                             e.kind.tag == ExprKind::Gt || e.kind.tag == ExprKind::Ge;
                if (isCmp && cgVariantCaseIdx(cg, left, &cidx)) l = cgU64Text(cg, cidx);
                else
                {
                    l = cgExpr(cg, left);
                    /* extend the slice over the appended ".tag" */
                    if (isCmp && cgIsVariantTy(cg, left)) { stP(&cg.ebuf, ".tag"); l.len = l.len + 4; }
                }
                if (isCmp && cgVariantCaseIdx(cg, right, &cidx)) r = cgU64Text(cg, cidx);
                else
                {
                    r = cgExpr(cg, right);
                    if (isCmp && cgIsVariantTy(cg, right)) { stP(&cg.ebuf, ".tag"); r.len = r.len + 4; }
                }
            }
            // str is a slice view: compare by content, not by struct bits
            if (cgIsStrTy(cg, left) &&
                (e.kind.tag == ExprKind::Eq || e.kind.tag == ExprKind::Ne))
            {
                usize cs = cg.ebuf.len;
                if (e.kind.tag == ExprKind::Ne) stP(&cg.ebuf, "!");
                stP(&cg.ebuf, "_coral_streq(");
                stPS(&cg.ebuf, l);
                stP(&cg.ebuf, ", ");
                stPS(&cg.ebuf, r);
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, cs);
            }
            /* structs have no C `==`: compare their bytes (like str above,
             * deterministic for same-type values of POD structs) */
            if (cgIsStructTy(cg, left) &&
                (e.kind.tag == ExprKind::Eq || e.kind.tag == ExprKind::Ne))
            {
                Node* ln = cgNode(cg, left);
                Slice lty = ln.kind.tag == NodeKind::Expr
                    ? cgResultTy(cg, left, &ln.kind.payload.Expr.value)
                    : Slice::fromStr("void*");
                usize cs = cg.ebuf.len;
                stP(&cg.ebuf, "((memcmp(&(");
                stPS(&cg.ebuf, l);
                stP(&cg.ebuf, "), &(");
                stPS(&cg.ebuf, r);
                stP(&cg.ebuf, "), sizeof(");
                stPS(&cg.ebuf, lty);
                stP(&cg.ebuf, ")) ");
                if (e.kind.tag == ExprKind::Eq) stP(&cg.ebuf, "== 0))");
                else stP(&cg.ebuf, "!= 0))");
                return stTail(&cg.ebuf, cs);
            }
            usize cs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, l);
            stP(&cg.ebuf, op);
            stPS(&cg.ebuf, r);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, cs);
        },

        // short-circuit: C `&&`/`||` evaluate left first and skip right
        ExprKind::And => {
            Slice l = cgExpr(cg, e.kind.payload.And.left);
            Slice r = cgExpr(cg, e.kind.payload.And.right);
            usize cs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, l);
            stP(&cg.ebuf, ") && (");
            stPS(&cg.ebuf, r);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, cs);
        },
        ExprKind::Or => {
            Slice l = cgExpr(cg, e.kind.payload.Or.left);
            Slice r = cgExpr(cg, e.kind.payload.Or.right);
            usize cs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, l);
            stP(&cg.ebuf, ") || (");
            stPS(&cg.ebuf, r);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, cs);
        },

        ExprKind::Call => {
            NodeId calleeId = e.kind.payload.Call.callee;
            Node* cn = cgNode(cg, calleeId);
            Slice calleeText;
            #[[maybe_unused]]
            Slice retTy;
            Ty rty = 0;
            bool resolved = false;
            NodeId fdecl;
            fdecl.index = 0;
            if (cn.kind.tag == NodeKind::Expr && cn.kind.payload.Expr.value.kind.tag == ExprKind::Path &&
                cn.kind.payload.Expr.value.kind.payload.Path.segmentsLen >= 2)
            {
                NodeId* segs = cn.kind.payload.Expr.value.kind.payload.Path.segments;
                u32 sn = cn.kind.payload.Expr.value.kind.payload.Path.segmentsLen;
                Node* s0 = cgNode(cg, segs[0]);
                Node* s1 = cgNode(cg, segs[sn - 1]);
                if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
                    s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                {
                    /* resolve through the declaration: the C name is the
                       function's own name (flat), not `module_fn` */
                    Str s1name = s1->kind.payload.Expr.value.kind.payload.Ident.name;
                    if (!resolved)
                    {
                        /* qualified member: try the module's own file first;
                         * lookupFrom prefers the reference site's file, which
                         * for `libc::realloc` points at the wrong (generic)
                         * decl */
                        Str root = s0->kind.payload.Expr.value.kind.payload.Ident.name;
                        if (cg.sema != null && cg.sema.scopes != null)
                        {
                            u32 refF = 0;
                            if (id.index != 0)
                            {
                                Node* rn2 = cgNode(cg, id);
                                refF = locFile(rn2->loc);
                            }
                            ScopeStack* scopes2 = cg.sema.scopes;
                            Symbol* rsym = scopes2.lookupFrom(root, refF);
                            if (rsym != null && rsym->kind == 5 && rsym->declaration.index != 0)
                            {
                                Node* imn = cgNode(cg, rsym->declaration);
                                if (imn.kind.tag == NodeKind::Decl)
                                {
                                    Decl* imd = &imn.kind.payload.Decl.value;
                                    Str mpath = 0;
                                    if (imd.kind.tag == DeclKind::Import) mpath = imd.kind.payload.Import.path;
                                    else if (imd.kind.tag == DeclKind::ModReexport) mpath = imd.kind.payload.ModReexport.path;
                                    u32 mf = cgFileForModulePath(cg, mpath);
                                    if (mf != 0)
                                    {
                                        NodeId md = cgFindDeclFrom(cg, s1name, (u32)DeclKind::Func, mf);
                                        if (md.index != 0)
                                            calleeText = cgCallFromDecl(cg, md, 0, e.kind.payload.Call.args,
                                                                        e.kind.payload.Call.argsLen,
                                                                        &rty, &resolved, &fdecl);
                                    }
                                }
                            }
                        }
                    }
                    if (!resolved)
                    {
                        /* `Type::method(...)` / `str::fromParts(...)`: the
                         * head is a struct/extend owner, not a module:
                         * resolve the method decl through the owner text */
                        Str rootT = s0->kind.payload.Expr.value.kind.payload.Ident.name;
                        NodeId sdecl = cgFindMethodDeclOwner(cg, cgIntern(cg, rootT), s1name);
                        if (sdecl.index != 0 && !cgDeclIsGeneric(cg, sdecl))
                        {
                            Node* sdn = cgNode(cg, sdecl);
                            Decl* sdd = &sdn.kind.payload.Decl.value;
                            if (sdn.kind.tag == NodeKind::Decl)
                            {
                                /* suffix = the same owner+name the def side
                                 * composes (the C spelling for builtin owners
                                 * like str → `_coral_str`) */
                                usize rcs = cg.ebuf.len;
                                stPS(&cg.ebuf, cgOwnerSpelling(cg, cgIdent(cg, rootT)));
                                stCh(&cg.ebuf, '_');
                                stPS(&cg.ebuf, cgIntern(cg, s1name));
                                calleeText = cgMangleS(cg, sdecl, stTail(&cg.ebuf, rcs), 0);
                                fdecl = sdecl;
                                if (sdd.kind.tag == DeclKind::Func)
                                    rty = sdd.kind.payload.Func.returnType;
                                resolved = true;
                            }
                        }
                    }
                    if (!resolved)
                        calleeText = cgResolveCall(cg, s1name, e.kind.payload.Call.args, e.kind.payload.Call.argsLen, &rty, &resolved, id, &fdecl);
                    if (resolved) {
                                            retTy = tyStr(cg, cgSubstTy(cg, rty));
                    } else {
                        if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))
                            cgErrorAt(cg, id, "no monomorphized instance for generic call; the call site was not collected");
                        usize cs = cg.ebuf.len;
                        stPS(&cg.ebuf, cgIntern(cg, s0->kind.payload.Expr.value.kind.payload.Ident.name));
                        stCh(&cg.ebuf, '_');
                        stPS(&cg.ebuf, cgIntern(cg, s1name));
                        calleeText = stTail(&cg.ebuf, cs);
                        retTy = cgResultTy(cg, id, e);
                        resolved = true;
                    }
                }
                else if (s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef)
                {
                    // `mod::f<T>(...)`: explicit generic args on the last segment
                    calleeText = cgResolveGenericCall(cg, s1->kind.payload.Expr.value.kind.payload.TypeRef.name,
                                                      s1->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,
                                                      &rty, &resolved, &fdecl, id,
                                                      e.kind.payload.Call.args, e.kind.payload.Call.argsLen);
                    if (resolved) {
                                            retTy = tyStr(cg, cgSubstTy(cg, rty));
                    } else {
                        if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))
                            cgErrorAt(cg, id, "no monomorphized instance for generic call; the call site was not collected");
                        calleeText = cgExpr(cg, calleeId);
                        retTy = cgResultTy(cg, id, e);
                    }
                }
                else if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef &&
                         s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                {
                    /* static method on a generic instance: `Foo<i32>::new(...)`:
                       <instance>_<method>, matching cgEmitInstMethodList */
                    Ty ownerTy = s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode;
                    Str s1name2 = s1->kind.payload.Expr.value.kind.payload.Ident.name;
                    Slice owner = cgOwnerName(cg, ownerTy);
                    usize cs2 = cg.ebuf.len;
                    stPS(&cg.ebuf, owner);
                    stCh(&cg.ebuf, '_');
                    stPS(&cg.ebuf, cgIntern(cg, s1name2));
                    Slice rawCallee = stTail(&cg.ebuf, cs2);
                    NodeId mdecl = cgFindMethodDeclOwner(cg, owner, s1name2);
                    if (mdecl.index != 0) calleeText = cgMangleS(cg, mdecl, rawCallee, 0);
                    else calleeText = rawCallee;
                    fdecl = mdecl;
                    retTy = cgResultTy(cg, id, e);
                }
                else
                {
                    calleeText = cgExpr(cg, calleeId);
                    retTy = cgResultTy(cg, id, e);
                }
            }
            else if (cn.kind.tag == NodeKind::Expr && cn.kind.payload.Expr.value.kind.tag == ExprKind::TypeRef) {
                /* `f<T>(...)`, explicit generic call: pick the mono
                   instance for the callee's generic arguments */
                calleeText = cgResolveGenericCall(cg, cn.kind.payload.Expr.value.kind.payload.TypeRef.name,
                                                  cn.kind.payload.Expr.value.kind.payload.TypeRef.typeNode,
                                                  &rty, &resolved, &fdecl, id,
                                                  e.kind.payload.Call.args, e.kind.payload.Call.argsLen);
                if (resolved) {
                                        retTy = tyStr(cg, cgSubstTy(cg, rty));
                } else {
                    if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))
                        cgErrorAt(cg, id, "no monomorphized instance for generic call; the call site was not collected");
                    calleeText = cgExpr(cg, calleeId);
                    retTy = cgResultTy(cg, id, e);
                }
            }
            else if (cn.kind.tag == NodeKind::Expr && cn.kind.payload.Expr.value.kind.tag == ExprKind::Ident) {
                Str fname = cn.kind.payload.Expr.value.kind.payload.Ident.name;
                calleeText = cgResolveCall(cg, fname, e.kind.payload.Call.args, e.kind.payload.Call.argsLen, &rty, &resolved, id, &fdecl);
                if (resolved) {
                                        retTy = tyStr(cg, cgSubstTy(cg, rty));
                } else {
                    if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))
                        cgErrorAt(cg, id, "no monomorphized instance for generic call; the call site was not collected");
                    calleeText = cgExpr(cg, calleeId);
                    retTy = cgResultTy(cg, id, e);
                }
            } else {
                calleeText = cgExpr(cg, calleeId);
                retTy = cgResultTy(cg, id, e);
            }
            /* comptime (type-level) parameters are erased from the C
               signature: skip their arguments here as well */
            Slice argTexts = Slice::from(null, 0);
            u32 n = 0;
            {
                Stream abuf = stNew(cg.arena, 64);
                bool first = true;
                NodeId* args = e.kind.payload.Call.args;
                u32 argsLen = e.kind.payload.Call.argsLen;
                u32 i = 0;
                /* hard cap of 16 call args; overflow is reported as an
                 * error after the loop */
                while (i < argsLen && i < 16) {
                    bool skip = false;
                    bool dec = false;
                    if (fdecl.index != 0) {
                        Node* fdn = cgNode(cg, fdecl);
                        Decl* fd = &fdn.kind.payload.Decl.value;
                        if (i < fd.kind.payload.Func.paramsLen) {
                            Node* pn = cgNode(cg, fd.kind.payload.Func.params[i]);
                            if (pn.kind.tag == NodeKind::Param) {
                                Param* pp = &pn.kind.payload.Param.value;
                                if ((pp->flags & 8) != 0) skip = true;
                                else dec = cgStrToPtr(cg, pp->typeNode, args[i]);
                            }
                        }
                    }
                    if (!skip) {
                        if (first) first = false;
                        else stP(&abuf, ", ");
                        /* str→ptr decay borrows the buffer; a plain
                         * by-value arg moves it */
                        if (!dec) cgMoveArg(cg, args[i]);
                        stPS(&abuf, cgExpr(cg, args[i]));
                        if (dec) stP(&abuf, ".ptr");
                        n++;
                    }
                    i++;
                }
                if (argsLen > 16) cgError(cg, "too many arguments (cap 16)");
                argTexts = stTail(&abuf, 0);
            }
            usize ccs = cg.ebuf.len;
            stPS(&cg.ebuf, calleeText);
            stCh(&cg.ebuf, '(');
            stPS(&cg.ebuf, argTexts);
            stCh(&cg.ebuf, ')');
            return stTail(&cg.ebuf, ccs);
        },

        ExprKind::MethodCall => {
            NodeId recv = e.kind.payload.MethodCall.receiver;
            Node* rn = cgNode(cg, recv);
            Ty recvTy = 0;
            if (rn.kind.tag == NodeKind::Expr) recvTy = rn.kind.payload.Expr.value.resolvedType;
            Slice owner;
            if (recvTy != 0) {
                /* const receivers may wrap Pointer in Const: unwrap both
                 * so the owner name matches the definition side */
                recvTy = cgTyUnwrap(cg, recvTy);
                if (recvTy != 0 && (cg.ctx->types + recvTy)->kind.tag == TypeKind::Pointer)
                    recvTy = cgTyUnwrap(cg, (cg.ctx->types + recvTy)->kind.payload.Pointer.base);
                if (recvTy != 0) owner = cgOwnerName(cg, recvTy);
                else owner = Slice::fromStr("Unknown");
            } else {
                owner = Slice::fromStr("Unknown");
            }
            Slice recvText = cgExpr(cg, recv);
            bool recvIsPtr = false;
            Ty rawRecvTy = 0;
            if (rn.kind.tag == NodeKind::Expr) {
                rawRecvTy = rn.kind.payload.Expr.value.resolvedType;
                if (rawRecvTy != 0 && cgTyIsPtr(cg, rawRecvTy)) recvIsPtr = true;
            }
            Str methName = e.kind.payload.MethodCall.method;
            cgMoveDisposeRecv(cg, methName, rn);
            bool mFound = false;
            u8 recvKind = cgMethodRecvKind(cg, rawRecvTy, methName, &mFound);
            /* `p->alloc(ctx, size)` parses as a method call but names a
             * fn-pointer field: lower to `(p->alloc)(ctx, size)` */
            bool fieldCall = !mFound && cgHasField(cg, rawRecvTy, methName);
            Slice callee;
            NodeId mdef;
            mdef.index = 0;
            if (fieldCall)
            {
                usize cfs = cg.ebuf.len;
                stP(&cg.ebuf, "(");
                stPS(&cg.ebuf, recvText);
                if (recvIsPtr) stP(&cg.ebuf, "->");
                else stCh(&cg.ebuf, '.');
                stPS(&cg.ebuf, cgIdent(cg, methName));
                stCh(&cg.ebuf, ')');
                callee = stTail(&cg.ebuf, cfs);
            }
            else
            {
                usize cs = cg.ebuf.len;
                stPS(&cg.ebuf, owner);
                stCh(&cg.ebuf, '_');
                stPS(&cg.ebuf, cgIntern(cg, methName));
                Slice rawCallee = stTail(&cg.ebuf, cs);
                /* resolve the method's own decl for file-correct mangling
                   (def side: cgEmitMethodSet composes the same base) */
                mdef = cgFindMethodDecl(cg, rawRecvTy, methName);
                if (mdef.index != 0) callee = cgMangleS(cg, mdef, rawCallee, 0);
                else callee = rawCallee;
            }

            Slice argTexts = Slice::from(null, 0);
            u32 n = 0;
            {
                Stream abuf = stNew(cg.arena, 64);
                bool first = true;
                bool passRecv = recvKind != 0 && !fieldCall;
                if (passRecv) {
                    /* self is a pointer in C: pass the address of a value
                     * receiver (materialized when the receiver is a
                     * temporary), or the receiver itself when already a
                     * pointer */
                    if (!recvIsPtr) {
                        Slice rt = cgAddrOfValue(cg, recv, recvText);
                        stPS(&abuf, rt);
                    } else {
                        stPS(&abuf, recvText);
                    }
                    first = false;
                    n++;
                }
                NodeId* args = e.kind.payload.MethodCall.args;
                u32 argsLen = e.kind.payload.MethodCall.argsLen;
                u32 i = 0;
                while (i < argsLen && n < 16) {
                    if (first) first = false;
                    else stP(&abuf, ", ");
                    /* `null` in a str parameter position is the empty slice */
                    bool nullStr = false;
                    if (mdef.index != 0)
                    {
                        Node* mdn = cgNode(cg, mdef);
                        Node* an2 = cgNode(cg, args[i]);
                        if (mdn.kind.tag == NodeKind::Decl && an2.kind.tag == NodeKind::Expr &&
                            an2.kind.payload.Expr.value.kind.tag == ExprKind::NullLit &&
                            i < mdn.kind.payload.Decl.value.kind.payload.Func.paramsLen)
                        {
                            Node* mpn = cgNode(cg, mdn.kind.payload.Decl.value.kind.payload.Func.params[i]);
                            if (mpn.kind.tag == NodeKind::Param)
                            {
                                Ty pt = mpn.kind.payload.Param.value.typeNode;
                                while (pt != 0 && ((cg.ctx->types + pt)->kind.tag == TypeKind::Const ||
                                                   (cg.ctx->types + pt)->kind.tag == TypeKind::Comptime))
                                {
                                    if ((cg.ctx->types + pt)->kind.tag == TypeKind::Const)
                                        pt = (cg.ctx->types + pt)->kind.payload.Const.base;
                                    else pt = (cg.ctx->types + pt)->kind.payload.Comptime.base;
                                }
                                if (pt != 0 && (cg.ctx->types + pt)->kind.tag == TypeKind::Str) nullStr = true;
                            }
                        }
                    }
                    if (nullStr) stP(&abuf, "(_coral_str){0}");
                    else
                    {
                        cgMoveArg(cg, args[i]);
                        stPS(&abuf, cgExpr(cg, args[i]));
                    }
                    n++;
                    i++;
                }
                if (argsLen + (u32)(passRecv ? 1 : 0) > 16) cgError(cg, "too many arguments (cap 16)");
                argTexts = stTail(&abuf, 0);
            }
            #[[maybe_unused]]
            Slice methResTy = cgResultTy(cg, id, e);
            usize mcs = cg.ebuf.len;
            stPS(&cg.ebuf, callee);
            stCh(&cg.ebuf, '(');
            stPS(&cg.ebuf, argTexts);
            stCh(&cg.ebuf, ')');
            return stTail(&cg.ebuf, mcs);
        },

        ExprKind::StaticCall => {
            usize cs = cg.ebuf.len;
            stPS(&cg.ebuf, cgIntern(cg, e.kind.payload.StaticCall.typeName));
            stCh(&cg.ebuf, '_');
            stPS(&cg.ebuf, cgIntern(cg, e.kind.payload.StaticCall.method));
            Slice rawCallee = stTail(&cg.ebuf, cs);
            NodeId smdecl = cgFindMethodDeclOwner(cg, cgIntern(cg, e.kind.payload.StaticCall.typeName),
                                                  e.kind.payload.StaticCall.method);
            Slice callee;
            if (smdecl.index != 0)
            {
                Node* sdn = cgNode(cg, smdecl);
                if (sdn.kind.tag == NodeKind::Decl)
                {
                    /* suffix = def-side owner+method (C spelling of builtin
                     * owners: str → `_coral_str`) */
                    usize rcs = cg.ebuf.len;
                    stPS(&cg.ebuf, cgOwnerSpelling(cg, cgIdent(cg, e.kind.payload.StaticCall.typeName)));
                    stCh(&cg.ebuf, '_');
                    stPS(&cg.ebuf, cgIntern(cg, e.kind.payload.StaticCall.method));
                    callee = cgMangleS(cg, smdecl, stTail(&cg.ebuf, rcs), 0);
                }
                else callee = rawCallee;
            }
            else callee = rawCallee;
            Slice argTexts = Slice::from(null, 0);
            u32 n = 0;
            {
                Stream abuf = stNew(cg.arena, 64);
                bool first = true;
                NodeId* args = e.kind.payload.StaticCall.args;
                u32 argsLen = e.kind.payload.StaticCall.argsLen;
                u32 i = 0;
                while (i < argsLen && n < 16) {
                    if (first) first = false;
                    else stP(&abuf, ", ");
                    cgMoveArg(cg, args[i]);
                    stPS(&abuf, cgExpr(cg, args[i]));
                    n++;
                    i++;
                }
                if (argsLen > 16) cgError(cg, "too many arguments (cap 16)");
                argTexts = stTail(&abuf, 0);
            }
            #[[maybe_unused]]
            Slice statResTy = cgResultTy(cg, id, e);
            usize scs = cg.ebuf.len;
            stPS(&cg.ebuf, callee);
            stCh(&cg.ebuf, '(');
            stPS(&cg.ebuf, argTexts);
            stCh(&cg.ebuf, ')');
            return stTail(&cg.ebuf, scs);
        },

        ExprKind::Field, ExprKind::DerefField => {
            NodeId obj;
            Str field;
            if (e.kind.tag == ExprKind::Field) {
                obj = e.kind.payload.Field.obj;
                field = e.kind.payload.Field.field;
            } else {
                obj = e.kind.payload.DerefField.obj;
                field = e.kind.payload.DerefField.field;
            }
            /* `x.payload.Case`: lower to the union member slot of the
             * case's ordinal: `x.u.v<idx>` (only when the base is a variant
             * and the case exists; a plain `payload` struct field is not) */
            if (cgIsPayloadAccess(cg, obj))
            {
                NodeId base = cgFieldAccessObj(cg, obj);
                Node* bn = cgNode(cg, base);
                Ty bty = 0;
                if (bn.kind.tag == NodeKind::Expr) bty = bn.kind.payload.Expr.value.resolvedType;
                u32 vidx = 0;
                NodeId vd = cgFindVariantOfTy(cg, bty, field, &vidx);
                if (vd.index != 0)
                {
                    bool basePtr = cgTyIsPtr(cg, bty);
                    Slice o = basePtr ? cgExpr(cg, base) : cgLvalue(cg, base);
                    usize cs = cg.ebuf.len;
                    stPS(&cg.ebuf, o);
                    if (basePtr) stP(&cg.ebuf, "->");
                    else stCh(&cg.ebuf, '.');
                    stP(&cg.ebuf, "u.v");
                    stU64(&cg.ebuf, (u64)vidx);
                    return stTail(&cg.ebuf, cs);
                }
            }
            Slice o = cgExpr(cg, obj);
            Node* on = cgNode(cg, obj);
            bool isPtr = false;
            if (on.kind.tag == NodeKind::Expr) {
                Ty ot = on.kind.payload.Expr.value.resolvedType;
                if (ot != 0 && cgTyIsPtr(cg, ot)) isPtr = true;
            }
            usize cs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            if (isPtr) stP(&cg.ebuf, "->");
            else stCh(&cg.ebuf, '.');
            stPS(&cg.ebuf, cgIdent(cg, field));
            Slice fieldText = stTail(&cg.ebuf, cs);
            return fieldText;
        },

        ExprKind::Index => {
            Slice o = cgExpr(cg, e.kind.payload.Index.obj);
            Slice ix = cgExpr(cg, e.kind.payload.Index.index);
            bool isStr = cgIsStrTy(cg, e.kind.payload.Index.obj);
            usize cs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            if (isStr) stP(&cg.ebuf, ".ptr");
            stCh(&cg.ebuf, '[');
            stPS(&cg.ebuf, ix);
            stCh(&cg.ebuf, ']');
            Slice idxText = stTail(&cg.ebuf, cs);
            return idxText;
        },

        ExprKind::TupleField => {
            Slice o = cgExpr(cg, e.kind.payload.TupleField.obj);
            usize cs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            stCh(&cg.ebuf, '.');
            stP(&cg.ebuf, "_");
            stU64(&cg.ebuf, (u64)e.kind.payload.TupleField.index);
            Slice ttext = stTail(&cg.ebuf, cs);
            return ttext;
        },

        ExprKind::StructLiteral => {
            u32 fvLen = e.kind.payload.StructLiteral.fieldValuesLen;
            Stream vs = stNew(cg.arena, 64);
            bool first = true;
            u32 i = 0;
            while (i < fvLen) {
                if (first) first = false;
                else stP(&vs, ", ");
                if (e.kind.payload.StructLiteral.fieldNames != 0) {
                    stP(&vs, ".");
                    stPS(&vs, cgIdent(cg, e.kind.payload.StructLiteral.fieldNames[i]));
                    stP(&vs, " = ");
                }
                stPS(&vs, cgExpr(cg, e.kind.payload.StructLiteral.fieldValues[i]));
                i++;
            }
            if (fvLen > 256) cgError(cg, "too many struct fields (cap 256)");
            Slice lty = tyStr(cg, e.kind.payload.StructLiteral.typeNode);
            usize lcs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, lty);
            stP(&cg.ebuf, "){");
            Str vname = e.kind.payload.StructLiteral.variantName;
            if (vname != 0)
            {
                // variant construction: tag + payload union member
                u32 vidx = 0;
                NodeId vd = cgFindVariantOfTy(cg, e.kind.payload.StructLiteral.typeNode, vname, &vidx);
                if (vd.index == 0) cgError(cg, "variant case not found");
                stP(&cg.ebuf, " .tag = ");
                stU64(&cg.ebuf, (u64)vidx);
                if (fvLen > 0)
                {
                    stP(&cg.ebuf, ", .u.v");
                    stU64(&cg.ebuf, (u64)vidx);
                    stP(&cg.ebuf, " = {");
                    stPS(&cg.ebuf, stTail(&vs, 0));
                    stCh(&cg.ebuf, '}');
                }
            }
            else
            {
                stPS(&cg.ebuf, stTail(&vs, 0));
            }
            stP(&cg.ebuf, "})");
            return stTail(&cg.ebuf, lcs);
        },

        ExprKind::ArrayLiteral => {
            u32 alen = e.kind.payload.ArrayLiteral.elemsLen;
            Stream vs = stNew(cg.arena, 64);
            bool first = true;
            u32 i = 0;
            while (i < alen) {
                if (first) first = false;
                else stP(&vs, ", ");
                stPS(&vs, cgExpr(cg, e.kind.payload.ArrayLiteral.elems[i]));
                i++;
            }
            if (alen > 16) cgError(cg, "too many array elements (cap 16)");
            Slice aty = cgResultTy(cg, id, e);
            usize acs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, aty);
            stP(&cg.ebuf, "){");
            stPS(&cg.ebuf, stTail(&vs, 0));
            stP(&cg.ebuf, "})");
            return stTail(&cg.ebuf, acs);
        },

        ExprKind::TupleExpr => {
            u32 elen = e.kind.payload.TupleExpr.elemsLen;
            Stream vs = stNew(cg.arena, 64);
            bool first = true;
            u32 i = 0;
            while (i < elen) {
                if (first) first = false;
                else stP(&vs, ", ");
                stPS(&vs, cgExpr(cg, e.kind.payload.TupleExpr.elems[i]));
                i++;
            }
            if (elen > 16) cgError(cg, "too many tuple elements (cap 16)");
            Slice tty = cgResultTy(cg, id, e);
            usize tcs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, tty);
            stP(&cg.ebuf, "){");
            stPS(&cg.ebuf, stTail(&vs, 0));
            stP(&cg.ebuf, "})");
            return stTail(&cg.ebuf, tcs);
        },

        ExprKind::Ternary => {
            Slice c = cgExpr(cg, e.kind.payload.Ternary.cond);
            Slice tt = cgExpr(cg, e.kind.payload.Ternary.thenExpr);
            Slice ee = cgExpr(cg, e.kind.payload.Ternary.elseExpr);
            usize cs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, ") ? (");
            stPS(&cg.ebuf, tt);
            stP(&cg.ebuf, ") : (");
            stPS(&cg.ebuf, ee);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, cs);
        },

        ExprKind::IfExpr => {
            Slice c = cgExpr(cg, e.kind.payload.IfExpr.cond);
            u32 t = cgNewTemp(cg, cgResultTy(cg, id, e), 0);
            Slice tn = cgTempName(cg, t);
            u32 le = cgLabel(cg);
            u32 lend = cgLabel(cg);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "if (!(");
            stPS(&cg.body, c);
            stP(&cg.body, ")) goto __L");
            stU64(&cg.body, (u64)le);
            stCh(&cg.body, ';');
            Slice thenc = cgValBody(cg, e.kind.payload.IfExpr.thenBody);
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, tn);
            stP(&cg.body, " = (");
            stPS(&cg.body, thenc);
            stP(&cg.body, ");");
            cgEmitGoto(cg, lend);
            cgEmitLabel(cg, le);
            Slice elsec = cgValBody(cg, e.kind.payload.IfExpr.elseBody);
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, tn);
            stP(&cg.body, " = (");
            stPS(&cg.body, elsec);
            stP(&cg.body, ");");
            cgEmitLabel(cg, lend);
            return tn;
        },

        ExprKind::BlockExpr => {
            u32 i = 0;
            u32 n = e.kind.payload.BlockExpr.stmtsLen;
            while (i < n) {
                cgStmt(cg, e.kind.payload.BlockExpr.stmts[i]);
                i++;
            }
            if (e.kind.payload.BlockExpr.result.index != 0)
                return cgExpr(cg, e.kind.payload.BlockExpr.result);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, rs);
        },

        ExprKind::PostInc, ExprKind::PostDec, ExprKind::PreInc, ExprKind::PreDec => {
            NodeId target;
            str op = "++";
            if (e.kind.tag == ExprKind::PostInc) { target = e.kind.payload.PostInc.expr; op = "++"; }
            if (e.kind.tag == ExprKind::PostDec) { target = e.kind.payload.PostDec.expr; op = "--"; }
            if (e.kind.tag == ExprKind::PreInc) { target = e.kind.payload.PreInc.expr; op = "++"; }
            if (e.kind.tag == ExprKind::PreDec) { target = e.kind.payload.PreDec.expr; op = "--"; }
            Slice lv = cgLvalue(cg, target);
            usize ics = cg.ebuf.len;
            if (e.kind.tag == ExprKind::PostInc || e.kind.tag == ExprKind::PostDec) {
                stP(&cg.ebuf, "((");
                stPS(&cg.ebuf, lv);
                stCh(&cg.ebuf, ')');
                stP(&cg.ebuf, op);
                stCh(&cg.ebuf, ')');
            } else {
                stP(&cg.ebuf, "((");
                stP(&cg.ebuf, op);
                stPS(&cg.ebuf, lv);
                stP(&cg.ebuf, "))");
            }
            return stTail(&cg.ebuf, ics);
        },

        ExprKind::Assign, ExprKind::AssignAdd, ExprKind::AssignSub,
        ExprKind::AssignMul, ExprKind::AssignDiv, ExprKind::AssignMod,
        ExprKind::AssignBitAnd, ExprKind::AssignBitOr, ExprKind::AssignBitXor,
        ExprKind::AssignShl, ExprKind::AssignShr => {
            NodeId target;
            NodeId value;
            str op = "=";
            if (e.kind.tag == ExprKind::Assign) { target = e.kind.payload.Assign.target; value = e.kind.payload.Assign.value; }
            else if (e.kind.tag == ExprKind::AssignAdd) { target = e.kind.payload.AssignAdd.target; value = e.kind.payload.AssignAdd.value; op = "+="; }
            else if (e.kind.tag == ExprKind::AssignSub) { target = e.kind.payload.AssignSub.target; value = e.kind.payload.AssignSub.value; op = "-="; }
            else if (e.kind.tag == ExprKind::AssignMul) { target = e.kind.payload.AssignMul.target; value = e.kind.payload.AssignMul.value; op = "*="; }
            else if (e.kind.tag == ExprKind::AssignDiv) { target = e.kind.payload.AssignDiv.target; value = e.kind.payload.AssignDiv.value; op = "/="; }
            else if (e.kind.tag == ExprKind::AssignMod) { target = e.kind.payload.AssignMod.target; value = e.kind.payload.AssignMod.value; op = "%="; }
            else if (e.kind.tag == ExprKind::AssignBitAnd) { target = e.kind.payload.AssignBitAnd.target; value = e.kind.payload.AssignBitAnd.value; op = "&="; }
            else if (e.kind.tag == ExprKind::AssignBitOr) { target = e.kind.payload.AssignBitOr.target; value = e.kind.payload.AssignBitOr.value; op = "|="; }
            else if (e.kind.tag == ExprKind::AssignBitXor) { target = e.kind.payload.AssignBitXor.target; value = e.kind.payload.AssignBitXor.value; op = "^="; }
            else if (e.kind.tag == ExprKind::AssignShl) { target = e.kind.payload.AssignShl.target; value = e.kind.payload.AssignShl.value; op = "<<="; }
            else { target = e.kind.payload.AssignShr.target; value = e.kind.payload.AssignShr.value; op = ">>="; }
            Slice lv = cgLvalue(cg, target);
            Slice rv = cgAssignValue(cg, target, value);
            if (e.kind.tag == ExprKind::Assign)
            {
                Node* tn = cgNode(cg, target);
                Ty tt = 0;
                if (tn.kind.tag == NodeKind::Expr) tt = tn.kind.payload.Expr.value.resolvedType;
                if (cgIntToPtrInit(cg, value, tt)) rv = cgWrapPtrCast(cg, tyStr(cg, tt), rv);
                /* RAII move semantics `x = y;` on droppable locals: the
                 * overwritten value of x drops now and y's pending drop
                 * is cancelled (x owns the new value at its exit) */
                Node* tgn = cgNode(cg, target);
                Node* vgn = cgNode(cg, value);
                bool tIsIdent = tgn.kind.tag == NodeKind::Expr &&
                                tgn.kind.payload.Expr.value.kind.tag == ExprKind::Ident;
                bool vIsIdent = vgn.kind.tag == NodeKind::Expr &&
                                vgn.kind.payload.Expr.value.kind.tag == ExprKind::Ident;
                i32 ti = tIsIdent ? cgFindDrop(cg, tgn.kind.payload.Expr.value.kind.payload.Ident.name) : -1;
                i32 vi = vIsIdent ? cgFindDrop(cg, vgn.kind.payload.Expr.value.kind.payload.Ident.name) : -1;
                if (ti >= 0 && vi != ti)
                    cgEmitDropEntry(cg, &cg.drops[ti]); // old value of x
                if (vi >= 0 && vi != ti)
                    cgRemoveDropAt(cg, (u32)vi); // y moved into x
            }
            usize ascs = cg.ebuf.len;
            stP(&cg.ebuf, "((");
            stPS(&cg.ebuf, lv);
            stP(&cg.ebuf, " ");
            stP(&cg.ebuf, op);
            stP(&cg.ebuf, " ");
            stPS(&cg.ebuf, rv);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, ascs);
        },

        ExprKind::BuiltinCall => {
            Slice name = cgIntern(cg, e.kind.payload.BuiltinCall.name);
            bool isAssert = false;
            if (name.len == 6) {
                isAssert = true;
                usize i = 0;
                str want = "assert";
                while (i < 6) { if (name.ptr[i] != want.ptr[i]) { isAssert = false; break; } i++; }
            }
            if (isAssert && e.kind.payload.BuiltinCall.argsLen == 1) {
                Slice a = cgExpr(cg, e.kind.payload.BuiltinCall.args[0]);
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "assert(");
                stPS(&cg.body, a);
                stP(&cg.body, ");");
                usize rs = cg.ebuf.len;
                stP(&cg.ebuf, "0");
                return stTail(&cg.ebuf, rs);
            }
            /* @assertOut(cond) / @assertOut(cond, "msg"): like @assert; with a
             * message the msg text appears in the assertion failure output */
            bool isAssertOut = false;
            if (name.len == 9) {
                isAssertOut = true;
                usize iAo = 0;
                str wantAo = "assertOut";
                while (iAo < 9) { if (name.ptr[iAo] != wantAo.ptr[iAo]) { isAssertOut = false; break; } iAo++; }
            }
            if (isAssertOut && e.kind.payload.BuiltinCall.argsLen >= 1) {
                Slice a = cgExpr(cg, e.kind.payload.BuiltinCall.args[0]);
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "assert((");
                stPS(&cg.body, a);
                if (e.kind.payload.BuiltinCall.argsLen >= 2) {
                    NodeId mid2 = e.kind.payload.BuiltinCall.args[1];
                    Slice m = cgExpr(cg, mid2);
                    bool mIsStr = false;
                    Node* mnn = cgNode(cg, mid2);
                    if (mnn.kind.tag == NodeKind::Expr && mnn.kind.payload.Expr.value.resolvedType != 0 &&
                        (cg.ctx->types + mnn.kind.payload.Expr.value.resolvedType)->kind.tag == TypeKind::Str)
                        mIsStr = true;
                    stP(&cg.body, ") && ");
                    if (mIsStr) stP(&cg.body, "_coral_strtruth(");
                    else stCh(&cg.body, '(');
                    stPS(&cg.body, m);
                    stCh(&cg.body, ')');
                    stP(&cg.body, ");");
                } else {
                    stP(&cg.body, "));");
                }
                usize rs = cg.ebuf.len;
                stP(&cg.ebuf, "0");
                return stTail(&cg.ebuf, rs);
            }
            /* @isFormatLiteral(expr): true only for literal args (static
             * comptime-checked gate); everything else is `false`. */
            bool isIsFormatLiteral = false;
            if (name.len == 15) {
                isIsFormatLiteral = true;
                str wantIfl = "isFormatLiteral";
                usize iI = 0;
                while (iI < 15) { if (name.ptr[iI] != wantIfl.ptr[iI]) { isIsFormatLiteral = false; break; } iI++; }
            }
            if (isIsFormatLiteral)
            {
                bool hasStrLit = false;
                if (e.kind.payload.BuiltinCall.argsLen == 1)
                {
                    Node* na = cgNode(cg, e.kind.payload.BuiltinCall.args[0]);
                    if (na->kind.tag == NodeKind::Expr &&
                        na->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        hasStrLit = true;
                }
                usize rs = cg.ebuf.len;
                stP(&cg.ebuf, hasStrLit ? "1" : "0");
                return stTail(&cg.ebuf, rs);
            }
            cgError(cg, "unsupported builtin call");
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },

        ExprKind::SwitchExpr => {
            Slice scrut = cgExpr(cg, e.kind.payload.SwitchExpr.expr);
            Ty scrutTy = 0;
            {
                Node* sn = cgNode(cg, e.kind.payload.SwitchExpr.expr);
                if (sn.kind.tag == NodeKind::Expr) scrutTy = sn.kind.payload.Expr.value.resolvedType;
            }
            u32 t = cgNewTemp(cg, cgResultTy(cg, id, e), 0);
            Slice tn = cgTempName(cg, t);
            cgEmitSwitch(cg, scrut, scrutTy, e.kind.payload.SwitchExpr.cases, e.kind.payload.SwitchExpr.casesLen, tn);
            return tn;
        },

        ExprKind::TypeRef => {
            cgError(cg, "unresolved TypeRef");
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },
        ExprKind::Spread => {
            /* `...pack`: after comptime eval the pack is gone; if one
             * survives to codegen it is just its inner expression */
            return cgExpr(cg, e.kind.payload.Spread.expr);
        },
        ExprKind::Typeof => {
            cgError(cg, "typeof not supported");
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },

        else => {
            cgError(cg, "unsupported expression kind");
            stP(&cg.ebuf, "0");
            return stTail(&cg.ebuf, es);
        },
    }
    return stTail(&cg.ebuf, es);
}

/* A field of a temporary (`f().field`) is not a C lvalue even though
 * the field expression itself is an lvalue shape; walk back through
 * value receivers until a real storage location or a pointer base. */
bool cgExprIsLvalue(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* e = &n.kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::Ident, ExprKind::Deref, ExprKind::Index => { return true; },
        ExprKind::Field, ExprKind::DerefField => {
            NodeId obj = e->kind.tag == ExprKind::Field
                             ? e->kind.payload.Field.obj
                             : e->kind.payload.DerefField.obj;
            Node* on = cgNode(cg, obj);
            if (on->kind.tag == NodeKind::Expr)
            {
                Ty ot = on->kind.payload.Expr.value.resolvedType;
                if (ot != 0 && cgTyIsPtr(cg, ot)) return true;
            }
            return cgExprIsLvalue(cg, obj);
        },
        ExprKind::TupleField => { return cgExprIsLvalue(cg, e->kind.payload.TupleField.obj); },
        else => { return false; }
    }
}

/* `&expr`: C cannot take the address of a temporary, so a non-lvalue
 * operand is materialized into a hidden local first. vtext is the
 * already-lowered operand text. */
Slice cgAddrOfValue(Codegen* cg, NodeId oid, Slice vtext)
{
    Node* on = cgNode(cg, oid);
    bool lv = cgExprIsLvalue(cg, oid);
    Slice c = vtext;
    if (!lv) {
        Slice oty;
        if (on.kind.tag == NodeKind::Expr && on.kind.payload.Expr.value.resolvedType != 0) {
            Ty ot = cgSubstTy(cg, on.kind.payload.Expr.value.resolvedType);
            oty = tyStr(cg, cgTyUnwrap(cg, ot));
        } else if (on.kind.tag == NodeKind::Expr) {
            oty = cgResultTy(cg, oid, &on.kind.payload.Expr.value);
        } else {
            oty = Slice::fromStr("void*");
        }
        u32 t = cgNewTemp(cg, oty, 0);
        Slice tn = cgTempName(cg, t);
        stNL(&cg.body, cg.ind);
        stPS(&cg.body, tn);
        stP(&cg.body, " = ");
        stPS(&cg.body, c);
        stCh(&cg.body, ';');
        c = tn;
    }
    usize rs = cg.ebuf.len;
    stP(&cg.ebuf, "(&(");
    stPS(&cg.ebuf, c);
    stP(&cg.ebuf, "))");
    return stTail(&cg.ebuf, rs);
}

/* Receiver expression for a for-in @iter loop. A bare variable needs no
 * temp: use the pointer directly, or `&name` at each call site. Complex
 * receivers were already materialized into a pointer temp by the caller. */
Slice cgForInRecv(Codegen* cg, bool simpleIter, bool iterIsPtr, Str simpleName, u32 rt)
{
    if (!simpleIter) return cgTempName(cg, rt);
    Slice name = cgIdent(cg, simpleName);
    if (iterIsPtr) return name;
    usize rs = cg.tybuf.len;
    stP(&cg.tybuf, "(&(");
    stPS(&cg.tybuf, name);
    stP(&cg.tybuf, "))");
    return stTail(&cg.tybuf, rs);
}

Slice cgLvalue(Codegen* cg, NodeId id)
{
    if (id.index == 0) {
        stP(&cg.ebuf, "0");
        return stTail(&cg.ebuf, cg.ebuf.len - 1);
    }
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) {
        cgError(cg, "expected expression node");
        stP(&cg.ebuf, "0");
        return stTail(&cg.ebuf, cg.ebuf.len - 1);
    }
    Expr* e = &n.kind.payload.Expr.value;
    usize es = cg.ebuf.len;
    switch (e.kind.tag)
    {
        ExprKind::Ident => {
            Str iname = e.kind.payload.Ident.name;
            /* self is a pointer parameter: an lvalue assignment to it
             * writes through the pointer */
            if (cgTyIsPtr(cg, e.resolvedType) && iname == cg.ctx.intern("self")) {
                stP(&cg.ebuf, "*(");
                stPS(&cg.ebuf, cgIdent(cg, iname));
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, es);
            }
            if (!cgIsLocalName(cg, iname))
            {
                Str alias = 0;
                NodeId rd = cgResolveRef(cg, iname, 0, id, &alias);
                if (rd.index != 0)
                {
                    Node* rn = cgNode(cg, rd);
                    if (rn.kind.tag == NodeKind::Decl)
                    {
                        Decl* rdd = &rn.kind.payload.Decl.value;
                        if (rdd.kind.tag == DeclKind::Func || rdd.kind.tag == DeclKind::Constant)
                        {
                            Str own = cgDeclOwnName(rdd);
                            if (own != 0)
                            {
                                stPS(&cg.ebuf, cgMangle(cg, rd, own, alias));
                                return stTail(&cg.ebuf, es);
                            }
                        }
                    }
                }
            }
            stPS(&cg.ebuf, cgIdent(cg, iname));
            return stTail(&cg.ebuf, es);
        },
        ExprKind::Deref => {
            Slice c = cgExpr(cg, e.kind.payload.Deref.expr);
            usize rs = cg.ebuf.len;
            stP(&cg.ebuf, "(*(");
            stPS(&cg.ebuf, c);
            stP(&cg.ebuf, "))");
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::Field, ExprKind::DerefField => {
            NodeId obj;
            Str field;
            if (e.kind.tag == ExprKind::Field) {
                obj = e.kind.payload.Field.obj;
                field = e.kind.payload.Field.field;
            } else {
                obj = e.kind.payload.DerefField.obj;
                field = e.kind.payload.DerefField.field;
            }
            /* `x.payload.Case`: lower to the union member slot of the
             * case's ordinal: `x.u.v<idx>` (only when the base is a variant
             * and the case exists; a plain `payload` struct field is not) */
            if (cgIsPayloadAccess(cg, obj))
            {
                NodeId base = cgFieldAccessObj(cg, obj);
                Node* bn = cgNode(cg, base);
                Ty bty = 0;
                if (bn.kind.tag == NodeKind::Expr) bty = bn.kind.payload.Expr.value.resolvedType;
                u32 vidx = 0;
                NodeId vd = cgFindVariantOfTy(cg, bty, field, &vidx);
                if (vd.index != 0)
                {
                    bool basePtr = cgTyIsPtr(cg, bty);
                    Slice o = basePtr ? cgExpr(cg, base) : cgLvalue(cg, base);
                    usize cs = cg.ebuf.len;
                    stPS(&cg.ebuf, o);
                    if (basePtr) stP(&cg.ebuf, "->");
                    else stCh(&cg.ebuf, '.');
                    stP(&cg.ebuf, "u.v");
                    stU64(&cg.ebuf, (u64)vidx);
                    return stTail(&cg.ebuf, cs);
                }
            }
            Node* on = cgNode(cg, obj);
            bool isPtr = false;
            if (on.kind.tag == NodeKind::Expr) {
                Ty ot = on.kind.payload.Expr.value.resolvedType;
                if (ot != 0 && cgTyIsPtr(cg, ot)) isPtr = true;
            }
            /* `base->field`: the base is a pointer *value*, so take the
             * value form (an lvalue deref like `*(self)` would bind as
             * `*((self)->field)`); a plain field still needs an lvalue */
            Slice o = isPtr ? cgExpr(cg, obj) : cgLvalue(cg, obj);
            usize rs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            if (isPtr) stP(&cg.ebuf, "->");
            else stCh(&cg.ebuf, '.');
            stPS(&cg.ebuf, cgIdent(cg, field));
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::Index => {
            Slice o = cgExpr(cg, e.kind.payload.Index.obj);
            Slice ix = cgExpr(cg, e.kind.payload.Index.index);
            bool isStr = cgIsStrTy(cg, e.kind.payload.Index.obj);
            usize rs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            if (isStr) stP(&cg.ebuf, ".ptr");
            stCh(&cg.ebuf, '[');
            stPS(&cg.ebuf, ix);
            stCh(&cg.ebuf, ']');
            return stTail(&cg.ebuf, rs);
        },
        ExprKind::TupleField => {
            Slice o = cgLvalue(cg, e.kind.payload.TupleField.obj);
            usize rs = cg.ebuf.len;
            stPS(&cg.ebuf, o);
            stCh(&cg.ebuf, '.');
            stP(&cg.ebuf, "_");
            stU64(&cg.ebuf, (u64)e.kind.payload.TupleField.index);
            return stTail(&cg.ebuf, rs);
        },
        else => {
            // not an lvalue: fall back to value path (error surfaces in C)
            return cgExpr(cg, id);
        },
    }
    return stTail(&cg.ebuf, es);
}

/* ── value of a body used as expression (if/switch branches) ─── */

Slice cgValBody(Codegen* cg, NodeId id)
{
    if (id.index == 0) return Slice::fromStr("0");
    Node* n = cgNode(cg, id);
    if (n.kind.tag == NodeKind::Expr) return cgExpr(cg, id);
    if (n.kind.tag != NodeKind::Stmt) {
        cgError(cg, "expected lvalue node");
        return Slice::fromStr("0");
    }
    Stmt* s = &n.kind.payload.Stmt.value;
    if (s.kind.tag == StmtKind::ExprStmt) return cgExpr(cg, s.kind.payload.ExprStmt.expr);
    if (s.kind.tag == StmtKind::Block)
    {
        u32 i = 0;
        u32 cnt = s.kind.payload.Block.stmtsLen;
        while (i + 1 < cnt)
        {
            cgStmt(cg, s.kind.payload.Block.stmts[i]);
            i++;
        }
        if (cnt == 0) return Slice::fromStr("0");
        NodeId last = s.kind.payload.Block.stmts[cnt - 1];
        Node* ln = cgNode(cg, last);
        if (ln.kind.tag == NodeKind::Stmt && ln.kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)
            return cgExpr(cg, ln.kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
        cgStmt(cg, last);
        return Slice::fromStr("0");
    }
    cgError(cg, "expected statement node");
    return Slice::fromStr("0");
}

/* ── switch lowering: compare chains + labels ────────────────── */

/* strip Const/Comptime wrappers: `const T*` receivers carry the const
 * on the outside, so Pointer/Array checks must look through it */
Ty cgTyUnwrap(Codegen* cg, Ty t)
{
    while (t != 0 && ((cg.ctx->types + t)->kind.tag == TypeKind::Const ||
                      (cg.ctx->types + t)->kind.tag == TypeKind::Comptime))
    {
        if ((cg.ctx->types + t)->kind.tag == TypeKind::Const) t = (cg.ctx->types + t)->kind.payload.Const.base;
        else t = (cg.ctx->types + t)->kind.payload.Comptime.base;
    }
    return t;
}

bool cgTyIsPtr(Codegen* cg, Ty t)
{
    if (t == 0) return false;
    TypeEntry* e = cg.ctx->types + t;
    while (e->kind.tag == TypeKind::Const || e->kind.tag == TypeKind::Comptime)
    {
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else t = e->kind.payload.Comptime.base;
        if (t == 0) return false;
        e = cg.ctx->types + t;
    }
    return e->kind.tag == TypeKind::Pointer;
}

extern("C") Slice cgPatTest(Codegen* cg, NodeId patId, Slice scrut, Ty scrutTy, bool* isWildcard);

Slice cgPatTest(Codegen* cg, NodeId patId, Slice scrut, Ty scrutTy, bool* isWildcard)
{
    *isWildcard = false;
    if (patId.index == 0) { *isWildcard = true; return Slice::from(null, 0); }
    Node* n = cgNode(cg, patId);
    if (n.kind.tag == NodeKind::Pat)
    {
        Pat* p = &n.kind.payload.Pat.value;
        switch (p.kind.tag)
        {
            PatKind::Wildcard => { *isWildcard = true; return Slice::from(null, 0); },
            PatKind::Variant => {
                /* enum scrutinee: members are C enum constants
                 * `Root_Name`: compare the value directly (variant decls
                 * are structs and compare their .tag field below) */
                {
                    Ty et = scrutTy;
                    while (et != 0)
                    {
                        TypeEntry* ee = cg.ctx->types + et;
                        if (ee->kind.tag == TypeKind::Pointer) et = ee->kind.payload.Pointer.base;
                        else if (ee->kind.tag == TypeKind::Const) et = ee->kind.payload.Const.base;
                        else if (ee->kind.tag == TypeKind::Comptime) et = ee->kind.payload.Comptime.base;
                        else break;
                    }
                    if (et != 0 && (cg.ctx->types + et)->kind.tag == TypeKind::Named)
                    {
                        Str root = (cg.ctx->types + et)->kind.payload.Named.name;
                        NodeId ed = cgFindDecl(cg, root, (u32)DeclKind::Enum);
                        if (ed.index != 0)
                        {
                            usize es = cg.ebuf.len;
                            stCh(&cg.ebuf, '(');
                            stPS(&cg.ebuf, scrut);
                            stP(&cg.ebuf, " == ");
                            stPS(&cg.ebuf, cgMangle(cg, ed, root, 0));
                            stCh(&cg.ebuf, '_');
                            stPS(&cg.ebuf, cgIntern(cg, p.kind.payload.Variant.variantName));
                            stCh(&cg.ebuf, ')');
                            return stTail(&cg.ebuf, es);
                        }
                    }
                }
                u32 vidx = 0;
                NodeId vd = cgFindVariantOfTy(cg, scrutTy, p.kind.payload.Variant.variantName, &vidx);
                bool tagField = vd.index != 0;
                if (vd.index == 0 && p.kind.payload.Variant.typeName != 0)
                {
                    /* `switch (x.kind.tag)`: the scrutinee is already the
                     * ordinal; resolve the variant behind the pattern head */
                    vd = cgFindDecl(cg, p.kind.payload.Variant.typeName, (u32)DeclKind::Variant);
                    if (vd.index != 0)
                    {
                        Node* dn = cgNode(cg, vd);
                        Decl* dd = &dn.kind.payload.Decl.value;
                        u32 v = 0;
                        bool found = false;
                        while (v < dd.kind.payload.Variant.variantsLen)
                        {
                            if (dd.kind.payload.Variant.variants[v].name == p.kind.payload.Variant.variantName)
                            {
                                vidx = v;
                                found = true;
                                break;
                            }
                            v++;
                        }
                        if (!found) vd.index = 0;
                    }
                }
                if (vd.index == 0) {
                    cgError(cg, "pattern lowering failed");
                    *isWildcard = true;
                    return Slice::from(null, 0);
                }
                usize s = cg.ebuf.len;
                stCh(&cg.ebuf, '(');
                stPS(&cg.ebuf, scrut);
                if (tagField)
                {
                    if (cgTyIsPtr(cg, scrutTy)) stP(&cg.ebuf, "->tag == ");
                    else stP(&cg.ebuf, ".tag == ");
                }
                else stP(&cg.ebuf, " == ");
                stU64(&cg.ebuf, (u64)vidx);
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, s);
            },
            PatKind::Ident => {
                /* a bare name in a value switch is a file-scope constant:
                 * `switch (sig) { SIGSEGV_ => … }`. resolve it the way an
                 * Ident expression would, then compare the scrutinee. */
                Str nm = p.kind.payload.Ident.name;
                Str alias = 0;
                NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Constant, patId, &alias);
                Node* rn = rd.index != 0 ? cgNode(cg, rd) : null;
                if (rn != null && rn.kind.tag == NodeKind::Decl &&
                    rn.kind.payload.Decl.value.kind.tag == DeclKind::Constant)
                {
                    Decl* cd = &rn.kind.payload.Decl.value;
                    Str own = cgDeclOwnName(cd);
                    usize s = cg.ebuf.len;
                    stCh(&cg.ebuf, '(');
                    stPS(&cg.ebuf, scrut);
                    stP(&cg.ebuf, " == ");
                    stPS(&cg.ebuf, cgMangle(cg, rd, own, alias));
                    stCh(&cg.ebuf, ')');
                    return stTail(&cg.ebuf, s);
                }
                cgError(cg, "pattern names an unknown constant");
                *isWildcard = true;
                return Slice::from(null, 0);
            },
            PatKind::Lit => {
                Slice l = cgExpr(cg, p.kind.payload.Lit.expr);
                usize s = cg.ebuf.len;
                stCh(&cg.ebuf, '(');
                stPS(&cg.ebuf, scrut);
                stP(&cg.ebuf, " == ");
                stPS(&cg.ebuf, l);
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, s);
            },
            PatKind::Or => {
                /* Render each alternative, collect the parts, then build the
                 * wrapping text from scratch: appending each part slice
                 * directly into cg.ebuf duplicates it (inner expr artifacts
                 * + the real text land in the same stream). */
                Slice altsText = Slice::from(null, 0);
                {
                    Stream abuf = stNew(cg.arena, 64);
                    u32 i = 0;
                    while (i < p.kind.payload.Or.alternativesLen)
                    {
                        bool w = false;
                        Slice t = cgPatTest(cg, p.kind.payload.Or.alternatives[i], scrut, scrutTy, &w);
                        if (i > 0) stP(&abuf, " || ");
                        if (w) stP(&abuf, "1");
                        else stPS(&abuf, t);
                        i++;
                    }
                    altsText = stTail(&abuf, 0);
                }
                usize s = cg.ebuf.len;
                stCh(&cg.ebuf, '(');
                stPS(&cg.ebuf, altsText);
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, s);
            },
            PatKind::Range => {
                Slice a = cgExpr(cg, p.kind.payload.Range.start);
                Slice b = cgExpr(cg, p.kind.payload.Range.end);
                usize s = cg.ebuf.len;
                stCh(&cg.ebuf, '(');
                stPS(&cg.ebuf, scrut);
                stP(&cg.ebuf, " >= ");
                stPS(&cg.ebuf, a);
                if (p.kind.payload.Range.flags & 1) stP(&cg.ebuf, " && ");
                else stP(&cg.ebuf, " && ");
                stPS(&cg.ebuf, scrut);
                if (p.kind.payload.Range.flags & 1) stP(&cg.ebuf, " <= ");
                else stP(&cg.ebuf, " < ");
                stPS(&cg.ebuf, b);
                stCh(&cg.ebuf, ')');
                return stTail(&cg.ebuf, s);
            },
            else => {
                cgError(cg, "pattern lowering failed");
                *isWildcard = true;
                return Slice::from(null, 0);
            },
        }
    }
    if (n.kind.tag == NodeKind::Expr)
    {
        // bare expression pattern (e.g. enum variant)
        Slice l = cgExpr(cg, patId);
        usize s = cg.ebuf.len;
        stCh(&cg.ebuf, '(');
        stPS(&cg.ebuf, scrut);
        stP(&cg.ebuf, " == ");
        stPS(&cg.ebuf, l);
        stCh(&cg.ebuf, ')');
        return stTail(&cg.ebuf, s);
    }
    cgError(cg, "pattern lowering failed");
    *isWildcard = true;
    return Slice::from(null, 0);
}

/* variant-field bindings for one case's pattern(s): declared before the
 * chain, assigned when the case is entered */
void cgSwitchBinds(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* c)
{
    u32 pp = 0;
    while (pp < c.patternsLen)
    {
        Node* pn = cgNode(cg, c.patterns[pp]);
        if (pn.kind.tag == NodeKind::Pat)
        {
            Pat* pv = &pn.kind.payload.Pat.value;
            if (pv.kind.tag == PatKind::Variant && pv.kind.payload.Variant.fieldNamesLen > 0)
            {
                u32 vidx = 0;
                NodeId vd = cgFindVariantOfTy(cg, scrutTy, pv.kind.payload.Variant.variantName, &vidx);
                if (vd.index != 0)
                {
                    u32 ff = 0;
                    while (ff < pv.kind.payload.Variant.fieldNamesLen)
                    {
                        Str fname = pv.kind.payload.Variant.fieldNames[ff];
                        stNL(&cg.body, cg.ind);
                        stPS(&cg.body, cgIntern(cg, fname));
                        stP(&cg.body, " = ");
                        stPS(&cg.body, scrut);
                        if (cgTyIsPtr(cg, scrutTy)) stP(&cg.body, "->u.v");
                        else stP(&cg.body, ".u.v");
                        stU64(&cg.body, (u64)vidx);
                        stCh(&cg.body, '.');
                        stPS(&cg.body, cgIntern(cg, fname));
                        stCh(&cg.body, ';');
                        ff++;
                    }
                }
            }
        }
        pp++;
    }
}

// one case's body: statement bodies, or value bodies assigning resultTemp
void cgSwitchBody(Codegen* cg, SwitchCase* c, Slice resultTemp)
{
    Node* bn = cgNode(cg, c.body);
    if (bn.kind.tag == NodeKind::Expr && resultTemp.len > 0)
    {
        Slice v = cgExpr(cg, c.body);
        stNL(&cg.body, cg.ind);
        stPS(&cg.body, resultTemp);
        stP(&cg.body, " = (");
        stPS(&cg.body, v);
        stP(&cg.body, ");");
    }
    else if (bn.kind.tag == NodeKind::Stmt && bn.kind.payload.Stmt.value.kind.tag == StmtKind::Block && resultTemp.len > 0)
    {
        // value block: stmts then last expr result
        Stmt* bs = &bn.kind.payload.Stmt.value;
        u32 si = 0;
        u32 cnt = bs.kind.payload.Block.stmtsLen;
        while (si + 1 < cnt) {
            cgStmt(cg, bs.kind.payload.Block.stmts[si]);
            si++;
        }
        if (cnt > 0) {
            NodeId last = bs.kind.payload.Block.stmts[cnt - 1];
            Node* ln = cgNode(cg, last);
            if (ln.kind.tag == NodeKind::Stmt && ln.kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt) {
                Slice v = cgExpr(cg, ln.kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
                stNL(&cg.body, cg.ind);
                stPS(&cg.body, resultTemp);
                stP(&cg.body, " = (");
                stPS(&cg.body, v);
                stP(&cg.body, ");");
            }
        }
    }
    else
    {
        if (c.body.index != 0) cgStmt(cg, c.body);
        if (resultTemp.len > 0) {
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, resultTemp);
            stP(&cg.body, " = 0;");
        }
    }
}

/* if/else-if chain over cases[start..]. A guarded case whose guard fails
 * nests the remaining chain in its else. No fallthrough. `break` in a case
 * jumps to the chain's `__Lsw<n>` label (cgPushSwitch/cgPopSwitch) so it
 * exits the switch only, matching the reference (real C switch). */
void cgEmitSwitchChain(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* cases, u32 casesLen, u32 start, Slice resultTemp, bool first)
{
    u32 j = start;
    while (j < casesLen) {
        SwitchCase* cc = cases + j;
        if ((cc.flags & 4) == 0 && cc.patternsLen > 0) break;
        j++;
    }
    if (j == casesLen)
    {
        // default (any source position) runs only when nothing matched
        u32 d = 0;
        while (d < casesLen) {
            SwitchCase* cc = cases + d;
            if ((cc.flags & 4) != 0 || cc.patternsLen == 0) break;
            d++;
        }
        if (d < casesLen)
        {
            stNL(&cg.body, cg.ind);
            if (first) stP(&cg.body, "{");
            else stP(&cg.body, "else");
            if (!first) { stNL(&cg.body, cg.ind); stP(&cg.body, "{"); }
            cg.ind++;
            cgSwitchBinds(cg, scrut, scrutTy, cases + d);
            cgSwitchBody(cg, cases + d, resultTemp);
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
        }
        return;
    }

    SwitchCase* c = cases + j;
    Slice testText;
    {
        Stream pbuf = stNew(cg.arena, 64);
        u32 p = 0;
        while (p < c.patternsLen)
        {
            bool w = false;
            Slice t = cgPatTest(cg, c.patterns[p], scrut, scrutTy, &w);
            if (p > 0) stP(&pbuf, " || ");
            if (w) { stP(&pbuf, "1"); break; }
            stPS(&pbuf, t);
            p++;
        }
        testText = stTail(&pbuf, 0);
    }

    stNL(&cg.body, cg.ind);
    if (first) stP(&cg.body, "if (");
    else stP(&cg.body, "else if (");
    stPS(&cg.body, testText);
    stCh(&cg.body, ')');
    stNL(&cg.body, cg.ind);
    stCh(&cg.body, '{');
    cg.ind++;
    cgSwitchBinds(cg, scrut, scrutTy, c);
    bool hasGuard = ((c.flags & 1) != 0 && c.guard.index != 0);
    if (hasGuard)
    {
        Slice g = cgExpr(cg, c.guard);
        stNL(&cg.body, cg.ind);
        stP(&cg.body, "if (");
        stPS(&cg.body, g);
        stCh(&cg.body, ')');
        stNL(&cg.body, cg.ind);
        stCh(&cg.body, '{');
        cg.ind++;
        cgSwitchBody(cg, c, resultTemp);
        cg.ind--;
        stNL(&cg.body, cg.ind);
        stCh(&cg.body, '}');
        // guard failed: try the remaining cases
        stNL(&cg.body, cg.ind);
        stP(&cg.body, "else");
        stNL(&cg.body, cg.ind);
        stCh(&cg.body, '{');
        cg.ind++;
        cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, j + 1, resultTemp, true);
        cg.ind--;
        stNL(&cg.body, cg.ind);
        stCh(&cg.body, '}');
    }
    else
    {
        cgSwitchBody(cg, c, resultTemp);
    }
    cg.ind--;
    stNL(&cg.body, cg.ind);
    stCh(&cg.body, '}');
    if (!hasGuard)
        cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, j + 1, resultTemp, false);
}

/* cases: statement bodies (resultTemp empty) or expression bodies
 * (resultTemp names the variable each branch assigns). */
void cgEmitSwitch(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* cases, u32 casesLen, Slice resultTemp)
{
    if (casesLen > 256) {
        cgError(cg, "too many switch cases (cap 256)");
        return;
    }
    u32 swLabel = cg.switchSeq;
    cg.switchSeq++;
    cgPushSwitch(cg, swLabel, cg.dropsLen);

    // pattern bindings: declared up front, assigned on case entry
    {
        Str* bindNames = (Str*)cg.arena.alloc(256 * 4, 4);
        u32 bindCount = 0;
        if (bindNames != null)
        {
            u32 ci = 0;
            while (ci < casesLen)
            {
                SwitchCase* cc = cases + ci;
                u32 pp = 0;
                while (pp < cc.patternsLen)
                {
                    Node* pn = cgNode(cg, cc.patterns[pp]);
                    if (pn.kind.tag == NodeKind::Pat)
                    {
                        Pat* pv = &pn.kind.payload.Pat.value;
                        if (pv.kind.tag == PatKind::Variant && pv.kind.payload.Variant.fieldNamesLen > 0 && bindCount < 256)
                        {
                            u32 vidx0 = 0;
                            NodeId vd0 = cgFindVariantOfTy(cg, scrutTy, pv.kind.payload.Variant.variantName, &vidx0);
                            if (vd0.index != 0)
                            {
                                Node* vdn = cgNode(cg, vd0);
                                Decl* vdd = &vdn.kind.payload.Decl.value;
                                VariantVariant* vv0 = vdd.kind.payload.Variant.variants + vidx0;
                                u32 ff = 0;
                                while (ff < pv.kind.payload.Variant.fieldNamesLen && bindCount < 256)
                                {
                                    Str fname = pv.kind.payload.Variant.fieldNames[ff];
                                    u32 kk = 0;
                                    bool dup = false;
                                    while (kk < bindCount) { if (bindNames[kk] == fname) { dup = true; break; } kk++; }
                                    Ty ft = 0;
                                    u32 fi = 0;
                                    while (fi < vv0->fieldsLen)
                                    {
                                        if (vv0->fieldNames[fi] == fname) { ft = vv0->fieldTypes[fi]; break; }
                                        fi++;
                                    }
                                    if (ft != 0 && !dup)
                                    {
                                        /* the field type comes from the generic
                                         * variant declaration (`T value`), so bind
                                         * it through the scrutinee's concrete
                                         * arguments before emitting the C type */
                                        Ty boundFt = cg.sema.substituteFieldTy(cgSubstTy(cg, ft), scrutTy);
                                        stNL(&cg.body, cg.ind);
                                        stPS(&cg.body, tyStr(cg, cgSubstTy(cg, boundFt)));
                                        stCh(&cg.body, ' ');
                                        stPS(&cg.body, cgIntern(cg, fname));
                                        stCh(&cg.body, ';');
                                        bindNames[bindCount] = fname;
                                        bindCount++;
                                        cgAddLocal(cg, fname);
                                    }
                                    ff++;
                                }
                            }
                        }
                    }
                    pp++;
                }
                ci++;
            }
        }
    }

    cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, 0, resultTemp, true);
    stNL(&cg.body, cg.ind);
    stP(&cg.body, "__Lsw");
    stU64(&cg.body, (u64)swLabel);
    stP(&cg.body, ":;");
    cgPopSwitch(cg);
}

/* ── statements ──────────────────────────────────────────────── */

extern("C") void cgStmt(Codegen* cg, NodeId id);

/* a body in statement position must be a block (a bare decl after
 * `if (c)` is invalid C): wrap non-block bodies in braces */
void cgStmtBraced(Codegen* cg, NodeId id)
{
    if (id.index == 0) {
        stNL(&cg.body, cg.ind);
        stP(&cg.body, "{}");
        return;
    }
    Node* n = cgNode(cg, id);
    if (n.kind.tag == NodeKind::Stmt && n.kind.payload.Stmt.value.kind.tag == StmtKind::Block)
    {
        cgStmt(cg, id);
        return;
    }
    stNL(&cg.body, cg.ind);
    stCh(&cg.body, '{');
    cg.ind++;
    cgStmt(cg, id);
    cg.ind--;
    stNL(&cg.body, cg.ind);
    stCh(&cg.body, '}');
}

void cgStmt(Codegen* cg, NodeId id)
{
    if (id.index == 0) return;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Stmt) {
        if (n.kind.tag == NodeKind::Expr) {
            Slice t = cgExpr(cg, id);
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, t);
            stCh(&cg.body, ';');
            return;
        }
        cgError(cg, "expected statement node");
        return;
    }
    Stmt* s = &n.kind.payload.Stmt.value;

    switch (s.kind.tag)
    {
        StmtKind::Block => {
            u32 dropMark = cg.dropsLen;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;
            u32 i = 0;
            while (i < s.kind.payload.Block.stmtsLen)
            {
                cgStmt(cg, s.kind.payload.Block.stmts[i]);
                i++;
            }
            /* scope exit: unwind the block's locals, innermost first */
            cgEmitDropsTo(cg, dropMark);
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            return;
        },

        StmtKind::ExprStmt => {
            Slice t = cgExpr(cg, s.kind.payload.ExprStmt.expr);
            if (t.len == 0) return; // void call already emitted inline
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, t);
            stCh(&cg.body, ';');
            return;
        },

        StmtKind::VarDecl => {
            Str name = s.kind.payload.VarDecl.name;
            Ty ty = s.kind.payload.VarDecl.typeNode;
            NodeId init = s.kind.payload.VarDecl.init;
            cgAddLocal(cg, name);
            Slice tyText;
            if (ty != 0) tyText = tyStr(cg, ty);
            else if (init.index != 0) {
                Node* inn = cgNode(cg, init);
                if (inn.kind.tag == NodeKind::Expr)
                    tyText = cgResultTy(cg, init, &inn.kind.payload.Expr.value);
                else tyText = Slice::fromStr("void*");
            } else tyText = Slice::fromStr("void*");

            // array-typed local: declarator form, braced initializer
            bool isArray = false;
            if (ty != 0 && (cg.ctx->types + ty)->kind.tag == TypeKind::Array) isArray = true;

            Node* inn = (init.index != 0) ? cgNode(cg, init) : null;
            bool initIsArrayLit = false;
            if (inn != null && inn.kind.tag == NodeKind::Expr &&
                inn.kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral) initIsArrayLit = true;

            if (isArray) {
                stNL(&cg.body, cg.ind);
                if ((s.kind.payload.VarDecl.flags & 4) != 0) stP(&cg.body, "static ");
                Ty et = ty;
                while ((cg.ctx->types + et)->kind.tag == TypeKind::Array)
                    et = (cg.ctx->types + et)->kind.payload.Array.base;
                stPS(&cg.body, tyStr(cg, et));
                stCh(&cg.body, ' ');
                stPS(&cg.body, cgIdent(cg, name));
                Ty w = ty;
                while ((cg.ctx->types + w)->kind.tag == TypeKind::Array)
                {
                    stCh(&cg.body, '[');
                    stU64(&cg.body, (u64)(cg.ctx->types + w)->kind.payload.Array.len);
                    stCh(&cg.body, ']');
                    w = (cg.ctx->types + w)->kind.payload.Array.base;
                }
                if (initIsArrayLit) {
                    Expr* al = &inn.kind.payload.Expr.value;
                    stP(&cg.body, " = {");
                    u32 i = 0;
                    while (i < al.kind.payload.ArrayLiteral.elemsLen) {
                        if (i > 0) stP(&cg.body, ", ");
                        Slice v = cgExpr(cg, al.kind.payload.ArrayLiteral.elems[i]);
                        stPS(&cg.body, v);
                        i++;
                    }
                    stCh(&cg.body, '}');
                } else if (init.index != 0) {
                    if (!initIsArrayLit) cgError(cg, "array local needs array-literal init");
                    stP(&cg.body, " = {0}");
                } else {
                    stP(&cg.body, " = {0}");
                }
            } else {
                bool hasInit = init.index != 0;
                Slice initText;
                if (hasInit) initText = cgExpr(cg, init);
                if (hasInit && cgIntToPtrInit(cg, init, ty)) initText = cgWrapPtrCast(cg, tyText, initText);
                stNL(&cg.body, cg.ind);
                if ((s.kind.payload.VarDecl.flags & 4) != 0) stP(&cg.body, "static ");
                stPS(&cg.body, tyText);
                stCh(&cg.body, ' ');
                stPS(&cg.body, cgIdent(cg, name));
                if (hasInit) {
                    stP(&cg.body, " = ");
                    stPS(&cg.body, initText);
                }
            }
            stCh(&cg.body, ';');
            /* RAII: register the local so its drop runs at scope exit.
             * `T x = y;` with y a droppable local moves the value: y is
             * unregistered and x's future drop owns the buffer */
            if (s.kind.payload.VarDecl.dropMethod.index != 0 &&
                (s.kind.payload.VarDecl.flags & 4) == 0 && ty != 0)
            {
                if (init.index != 0)
                {
                    Node* inn2 = cgNode(cg, init);
                    if (inn2.kind.tag == NodeKind::Expr &&
                        inn2.kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                    {
                        i32 si = cgFindDrop(cg, inn2.kind.payload.Expr.value.kind.payload.Ident.name);
                        if (si >= 0) cgRemoveDropAt(cg, (u32)si);
                    }
                }
                cgPushDrop(cg, name, ty, s.kind.payload.VarDecl.dropMethod);
            }
            return;
        },

        StmtKind::Assign => {
            Slice lv = cgLvalue(cg, s.kind.payload.Assign.target);
            Slice rv = cgAssignValue(cg, s.kind.payload.Assign.target, s.kind.payload.Assign.value);
            Slice op = cgIntern(cg, s.kind.payload.Assign.op);
            /* plain `=` of an integer into a pointer (only reachable with
             * --allow-int-ptr): gcc needs the cast; `+=` is pointer
             * arithmetic and needs none */
            if (op.len == 1 && op.ptr[0] == 61)
            {
                Node* tn = cgNode(cg, s.kind.payload.Assign.target);
                Ty tt = 0;
                if (tn.kind.tag == NodeKind::Expr) tt = tn.kind.payload.Expr.value.resolvedType;
                if (cgIntToPtrInit(cg, s.kind.payload.Assign.value, tt)) rv = cgWrapPtrCast(cg, tyStr(cg, tt), rv);
                /* RAII move semantics for `x = y;` on droppable locals:
                 * the overwritten value of x drops now, and y's pending
                 * drop is cancelled (x's exit drop owns the new value) */
                Node* tgn = cgNode(cg, s.kind.payload.Assign.target);
                Node* vgn = cgNode(cg, s.kind.payload.Assign.value);
                bool tIsIdent = tgn.kind.tag == NodeKind::Expr &&
                                tgn.kind.payload.Expr.value.kind.tag == ExprKind::Ident;
                bool vIsIdent = vgn.kind.tag == NodeKind::Expr &&
                                vgn.kind.payload.Expr.value.kind.tag == ExprKind::Ident;
                i32 ti = tIsIdent ? cgFindDrop(cg, tgn.kind.payload.Expr.value.kind.payload.Ident.name) : -1;
                i32 vi = vIsIdent ? cgFindDrop(cg, vgn.kind.payload.Expr.value.kind.payload.Ident.name) : -1;
                if (ti >= 0 && vi != ti)
                    cgEmitDropEntry(cg, &cg.drops[ti]); // old value of x
                if (vi >= 0 && vi != ti)
                    cgRemoveDropAt(cg, (u32)vi); // y moved into x
            }
            stNL(&cg.body, cg.ind);
            stPS(&cg.body, lv);
            stCh(&cg.body, ' ');
            stPS(&cg.body, op);
            stCh(&cg.body, ' ');
            stPS(&cg.body, rv);
            stCh(&cg.body, ';');
            return;
        },

        StmtKind::Return => {
            NodeId v = s.kind.payload.Return.value;
            if (v.index == 0) {
                cgEmitDropsBranch(cg, cg.fnDropMark, -1);
                cgEmitStmt(cg, "return");
                return;
            }
            Slice t = cgExpr(cg, v);
            if (cg.dropsLen > cg.fnDropMark)
            {
                /* `return s;` moves the local out: its drop must not run,
                 * the caller owns the value now */
                i32 moved = -1;
                Node* vn = cgNode(cg, v);
                if (vn.kind.tag == NodeKind::Expr &&
                    vn.kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                    moved = cgFindDrop(cg, vn.kind.payload.Expr.value.kind.payload.Ident.name);
                if (moved >= 0)
                {
                    cgEmitDropsBranch(cg, cg.fnDropMark, moved);
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "return ");
                    stPS(&cg.body, t);
                    stCh(&cg.body, ';');
                    return;
                }
                /* other returns may alias dropped locals (slices into a
                 * local buffer): materialize the value first */
                Slice rt = Slice::fromStr("long");
                if (vn.kind.tag == NodeKind::Expr)
                {
                    Slice rtyp = cgResultTy(cg, v, &vn.kind.payload.Expr.value);
                    if (rtyp.len > 0) rt = rtyp;
                }
                u32 ti = cgNewTemp(cg, rt, 0);
                Slice tn = cgTempName(cg, ti);
                stNL(&cg.body, cg.ind);
                stPS(&cg.body, tn);
                stP(&cg.body, " = ");
                stPS(&cg.body, t);
                stCh(&cg.body, ';');
                cgEmitDropsBranch(cg, cg.fnDropMark, -1);
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "return ");
                stPS(&cg.body, tn);
                stCh(&cg.body, ';');
                return;
            }
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "return ");
            stPS(&cg.body, t);
            stCh(&cg.body, ';');
            return;
        },

        StmtKind::Break => {
            if (cg.breakDepth > 0 && cg.breakKinds[cg.breakDepth - 1] == 1) {
                cgEmitDropsBranch(cg, cg.breakDropMarks[cg.breakDepth - 1], -1);
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "goto __Lsw");
                stU64(&cg.body, (u64)cg.breakLabels[cg.breakDepth - 1]);
                stCh(&cg.body, ';');
                return;
            }
            if (cg.loopDepth == 0) { cgError(cg, "break outside of loop"); return; }
            if (cg.loopDepth > 0) cgEmitDropsBranch(cg, cg.loopDropMarks[cg.loopDepth - 1], -1);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "break;");
            return;
        },

        StmtKind::Continue => {
            if (cg.loopDepth == 0) { cgError(cg, "continue outside of loop"); return; }
            cgEmitDropsBranch(cg, cg.loopDropMarks[cg.loopDepth - 1], -1);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "continue;");
            return;
        },

        StmtKind::If => {
            Slice c = cgExpr(cg, s.kind.payload.If.cond);
            bool hasElse = s.kind.payload.If.elseBody.index != 0;
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "if (");
            stPS(&cg.body, c);
            stCh(&cg.body, ')');
            cgStmtBraced(cg, s.kind.payload.If.thenBody);
            if (hasElse) {
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "else");
                cgStmtBraced(cg, s.kind.payload.If.elseBody);
            }
            return;
        },

        StmtKind::While => {
            u32 loopMark = cg.dropsLen;
            usize b0 = cg.body.len;
            Slice c = cgExpr(cg, s.kind.payload.While.cond);
            bool condStmts = cg.body.len > b0;
            if (!condStmts)
            {
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "while (");
                stPS(&cg.body, c);
                stCh(&cg.body, ')');
                cgPushLoop(cg, loopMark);
                cgStmtBraced(cg, s.kind.payload.While.body);
                cgPopLoop(cg);
                cgEmitDropsTo(cg, loopMark);
                return;
            }
            // the condition carried statements: keep them inside the loop
            stTrunc(&cg.body, b0);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "while (1)");
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;
            c = cgExpr(cg, s.kind.payload.While.cond);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "if (!(");
            stPS(&cg.body, c);
            stP(&cg.body, ")) break;");
            cgPushLoop(cg, loopMark);
            cgStmtBraced(cg, s.kind.payload.While.body);
            cgPopLoop(cg);
            cgEmitDropsTo(cg, loopMark);
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            return;
        },

        StmtKind::Loop => {
            u32 loopMark = cg.dropsLen;
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "while (1)");
            cgPushLoop(cg, loopMark);
            cgStmtBraced(cg, s.kind.payload.Loop.body);
            cgPopLoop(cg);
            cgEmitDropsTo(cg, loopMark);
            return;
        },

        StmtKind::For => {
            u32 loopMark = cg.dropsLen;
            bool hasInit = s.kind.payload.For.init.index != 0;
            bool hasCond = (s.kind.payload.For.flags & 2) != 0;
            bool hasPost = (s.kind.payload.For.flags & 4) != 0;
            /* plain C `for (init; cond; post)` needs statement-free cond/post
             * measure first; statements would have to run each iteration */
            usize b0 = cg.body.len;
            Slice c = Slice::from(null, 0);
            if (hasCond) c = cgExpr(cg, s.kind.payload.For.cond);
            bool condStmts = cg.body.len > b0;
            Slice p = Slice::from(null, 0);
            bool postStmts = false;
            if (!condStmts && hasPost) {
                usize b1 = cg.body.len;
                p = cgExpr(cg, s.kind.payload.For.post);
                postStmts = cg.body.len > b1;
            }
            if (!condStmts && !postStmts)
            {
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "for (");
                if (hasInit) cgStmt(cg, s.kind.payload.For.init);
                else stCh(&cg.body, ';');
                stPS(&cg.body, c);
                stCh(&cg.body, ';');
                stPS(&cg.body, p);
                stCh(&cg.body, ')');
                cgPushLoop(cg, loopMark);
                cgStmtBraced(cg, s.kind.payload.For.body);
                cgPopLoop(cg);
                /* the C for-init declared its locals in the loop scope */
                cgEmitDropsTo(cg, loopMark);
                return;
            }
            // statement-bearing cond/post: manual loop shape
            stTrunc(&cg.body, b0);
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;
            if (hasInit) cgStmt(cg, s.kind.payload.For.init);
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "while (1)");
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;
            if (hasCond) {
                c = cgExpr(cg, s.kind.payload.For.cond);
                stNL(&cg.body, cg.ind);
                stP(&cg.body, "if (!(");
                stPS(&cg.body, c);
                stP(&cg.body, ")) break;");
            }
            cgPushLoop(cg, loopMark);
            cgStmtBraced(cg, s.kind.payload.For.body);
            cgPopLoop(cg);
            if (hasPost) {
                p = cgExpr(cg, s.kind.payload.For.post);
                stNL(&cg.body, cg.ind);
                stPS(&cg.body, p);
                stCh(&cg.body, ';');
            }
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            cgEmitDropsTo(cg, loopMark);
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            return;
        },

        StmtKind::ForIn => {
            // own scope: index temp + bind name must not collide
            u32 loopMark = cg.dropsLen;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;
            NodeId iter = s.kind.payload.ForIn.iterExpr;
            NodeId rangeStart = s.kind.payload.ForIn.rangeStart;
            NodeId rangeEnd = s.kind.payload.ForIn.rangeEnd;
            bool ranged = rangeStart.index != 0;
            Slice it = cgExpr(cg, iter);
            Node* in = cgNode(cg, iter);
            Ty iterTy = 0;
            if (in.kind.tag == NodeKind::Expr) iterTy = in.kind.payload.Expr.value.resolvedType;

            TypeEntry* te = null;
            if (iterTy != 0) te = cg.ctx->types + iterTy;
            bool indexed = te != null && (te.kind.tag == TypeKind::Slice || te.kind.tag == TypeKind::Array);
            bool useAt = false;
            bool simpleIter = in.kind.tag == NodeKind::Expr &&
                              in.kind.payload.Expr.value.kind.tag == ExprKind::Ident;
            Str simpleIterName = 0;
            if (simpleIter)
            {
                simpleIterName = in.kind.payload.Expr.value.kind.payload.Ident.name;
                if (!cgIsLocalName(cg, simpleIterName)) simpleIter = false;
            }
            bool iterIsPtr = false;
            u32 rt = 0;
            Slice elemTy;
            Slice atCallee;
            u32 countLabel = 0;
            u32 rangeLabel = 0;
            if (indexed)
            {
                elemTy = tyStr(cg, te.kind.tag == TypeKind::Slice ? te.kind.payload.Slice.base
                                                                  : te.kind.payload.Array.base);
                if (ranged)
                {
                    rangeLabel = cgLabel(cg);
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "size_t coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = (size_t)(");
                    stPS(&cg.body, cgExpr(cg, rangeStart));
                    stP(&cg.body, ");");
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "size_t coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = (size_t)(");
                    stPS(&cg.body, cgExpr(cg, rangeEnd));
                    stP(&cg.body, ");");
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "if (coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " > ");
                    if (te.kind.tag == TypeKind::Array) stU64(&cg.body, (u64)te.kind.payload.Array.len);
                    else { stPS(&cg.body, it); stP(&cg.body, ".len"); }
                    stP(&cg.body, ") coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = ");
                    if (te.kind.tag == TypeKind::Array) stU64(&cg.body, (u64)te.kind.payload.Array.len);
                    else { stPS(&cg.body, it); stP(&cg.body, ".len"); }
                    stCh(&cg.body, ';');
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "if (coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " > ");
                    if (te.kind.tag == TypeKind::Array) stU64(&cg.body, (u64)te.kind.payload.Array.len);
                    else { stPS(&cg.body, it); stP(&cg.body, ".len"); }
                    stP(&cg.body, ") coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = ");
                    if (te.kind.tag == TypeKind::Array) stU64(&cg.body, (u64)te.kind.payload.Array.len);
                    else { stPS(&cg.body, it); stP(&cg.body, ".len"); }
                    stCh(&cg.body, ';');
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "if (coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " < coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, ") coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stCh(&cg.body, ';');
                }
            }
            else
            {
                /* `@iter` collections are consumed through count()/at() */
                NodeId countDecl = cgFindMethodDecl(cg, iterTy, cg.ctx->intern("count"));
                NodeId atDecl = cgFindMethodDecl(cg, iterTy, cg.ctx->intern("at"));
                if (countDecl.index == 0 || atDecl.index == 0) {
                    cgError(cg, "for-in over non-slice/array without @iter count()/at()");
                    return;
                }
                Ty baseTy = cgTyUnwrap(cg, iterTy);
                iterIsPtr = baseTy != 0 && (cg.ctx->types + baseTy)->kind.tag == TypeKind::Pointer;
                if (iterIsPtr) baseTy = cgTyUnwrap(cg, (cg.ctx->types + baseTy)->kind.payload.Pointer.base);
                if (baseTy == 0) { cgError(cg, "for-in over unknown iterator type"); return; }

                if (!simpleIter)
                {
                    usize ps = cg.tybuf.len;
                    tyStr(cg, baseTy);
                    stCh(&cg.tybuf, '*');
                    Slice ptrTy = stTail(&cg.tybuf, ps);
                    rt = cgNewTemp(cg, ptrTy, 0);
                    if (iterIsPtr) {
                        stNL(&cg.body, cg.ind);
                        stPS(&cg.body, cgTempName(cg, rt));
                        stP(&cg.body, " = (");
                        stPS(&cg.body, ptrTy);
                        stP(&cg.body, ")");
                        stPS(&cg.body, it);
                        stCh(&cg.body, ';');
                    } else {
                        /* Materialize the iterable before assigning its address:
                         * cgAddrOfValue emits its own temp assignment, and that
                         * statement must finish before this `recv = &temp;`. */
                        Slice ptrExpr = cgAddrOfValue(cg, iter, it);
                        stNL(&cg.body, cg.ind);
                        stPS(&cg.body, cgTempName(cg, rt));
                        stP(&cg.body, " = ");
                        stPS(&cg.body, ptrExpr);
                        stCh(&cg.body, ';');
                    }
                }

                if (ranged)
                {
                    rangeLabel = cgLabel(cg);
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "size_t coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = (size_t)(");
                    stPS(&cg.body, cgExpr(cg, rangeStart));
                    stP(&cg.body, ");");
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "size_t coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = (size_t)(");
                    stPS(&cg.body, cgExpr(cg, rangeEnd));
                    stP(&cg.body, ");");

                    NodeId rangeDecl = cgFindMethodDecl(cg, iterTy, cg.ctx->intern("range"));
                    if (rangeDecl.index == 0) { cgError(cg, "for-in range() not found"); return; }
                    Node* rd = cgNode(cg, rangeDecl);
                    Ty rangeRetTy = 0;
                    if (rd.kind.tag == NodeKind::Decl && rd.kind.payload.Decl.value.kind.tag == DeclKind::Func)
                        rangeRetTy = rd.kind.payload.Decl.value.kind.payload.Func.returnType;
                    Slice rangeTy = tyStr(cg, cgSubstTy(cg, rangeRetTy));

                    Slice owner = cgOwnerName(cg, baseTy);
                    usize cs = cg.ebuf.len;
                    stPS(&cg.ebuf, owner);
                    stCh(&cg.ebuf, '_');
                    stPS(&cg.ebuf, cgIntern(cg, cg.ctx->intern("range")));
                    Slice rangeCallee = cgMangleS(cg, rangeDecl, stTail(&cg.ebuf, cs), 0);
                    stNL(&cg.body, cg.ind);
                    stPS(&cg.body, rangeTy);
                    stP(&cg.body, " coral_r");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, " = ");
                    stPS(&cg.body, rangeCallee);
                    stCh(&cg.body, '(');
                    stPS(&cg.body, cgForInRecv(cg, simpleIter, iterIsPtr, simpleIterName, rt));
                    stP(&cg.body, ", coral_rs");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, ", coral_re");
                    stU64(&cg.body, (u64)rangeLabel);
                    stP(&cg.body, ");");
                }
                else
                {
                    Slice owner = cgOwnerName(cg, baseTy);
                    usize cs = cg.ebuf.len;
                    stPS(&cg.ebuf, owner);
                    stCh(&cg.ebuf, '_');
                    stPS(&cg.ebuf, cgIntern(cg, cg.ctx->intern("count")));
                    Slice countCallee = cgMangleS(cg, countDecl, stTail(&cg.ebuf, cs), 0);
                    countLabel = cgLabel(cg);
                    stNL(&cg.body, cg.ind);
                    stP(&cg.body, "size_t coral_n");
                    stU64(&cg.body, (u64)countLabel);
                    stP(&cg.body, " = ");
                    stPS(&cg.body, countCallee);
                    stCh(&cg.body, '(');
                    stPS(&cg.body, cgForInRecv(cg, simpleIter, iterIsPtr, simpleIterName, rt));
                    stP(&cg.body, ");");
                }

                Slice owner = cgOwnerName(cg, baseTy);
                usize cs = cg.ebuf.len;
                stPS(&cg.ebuf, owner);
                stCh(&cg.ebuf, '_');
                stPS(&cg.ebuf, cgIntern(cg, cg.ctx->intern("at")));
                atCallee = cgMangleS(cg, atDecl, stTail(&cg.ebuf, cs), 0);
                elemTy = tyStr(cg, cgSubstTy(cg, s.kind.payload.ForIn.bindType));
                useAt = true;
            }
            u32 k = cgLabel(cg);
            usize kxs = cg.tybuf.len;
            stP(&cg.tybuf, "coral_k");
            stU64(&cg.tybuf, (u64)k);
            Slice ix = stTail(&cg.tybuf, kxs);

            stNL(&cg.body, cg.ind);
            stP(&cg.body, "for (size_t ");
            stPS(&cg.body, ix);
            stP(&cg.body, " = ");
            if (ranged && !indexed) {
                stP(&cg.body, "coral_r");
                stU64(&cg.body, (u64)rangeLabel);
                stP(&cg.body, ".start");
            } else if (ranged) {
                stP(&cg.body, "coral_rs");
                stU64(&cg.body, (u64)rangeLabel);
            } else {
                stP(&cg.body, "0");
            }
            stP(&cg.body, "; ");
            stPS(&cg.body, ix);
            stP(&cg.body, " < ");
            if (ranged && !indexed) {
                stP(&cg.body, "coral_r");
                stU64(&cg.body, (u64)rangeLabel);
                stP(&cg.body, ".end");
            } else if (ranged) {
                stP(&cg.body, "coral_re");
                stU64(&cg.body, (u64)rangeLabel);
            } else if (indexed && te.kind.tag == TypeKind::Array) {
                stU64(&cg.body, (u64)te.kind.payload.Array.len);
            } else if (indexed) {
                stPS(&cg.body, it);
                stP(&cg.body, ".len");
            } else {
                stP(&cg.body, "coral_n");
                stU64(&cg.body, (u64)countLabel);
            }
            stP(&cg.body, "; ");
            stPS(&cg.body, ix);
            stP(&cg.body, " = ");
            stPS(&cg.body, ix);
            stP(&cg.body, " + 1)");
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '{');
            cg.ind++;

            // bind
            usize es = cg.ebuf.len;
            if (useAt) {
                stPS(&cg.ebuf, atCallee);
                stCh(&cg.ebuf, '(');
                stPS(&cg.ebuf, cgForInRecv(cg, simpleIter, iterIsPtr, simpleIterName, rt));
                stP(&cg.ebuf, ", ");
                stPS(&cg.ebuf, ix);
                stCh(&cg.ebuf, ')');
            } else {
                stPS(&cg.ebuf, it);
                if (te.kind.tag == TypeKind::Array) {
                    stCh(&cg.ebuf, '[');
                    stPS(&cg.ebuf, ix);
                    stCh(&cg.ebuf, ']');
                } else {
                    stP(&cg.ebuf, ".ptr[");
                    stPS(&cg.ebuf, ix);
                    stCh(&cg.ebuf, ']');
                }
            }
            Slice elemExpr = stTail(&cg.ebuf, es);
            u32 extraLen = s.kind.payload.ForIn.extraBindNamesLen;
            if (extraLen == 0)
            {
                cgAddLocal(cg, s.kind.payload.ForIn.bindName);
                stNL(&cg.body, cg.ind);
                stPS(&cg.body, elemTy);
                stCh(&cg.body, ' ');
                stPS(&cg.body, cgIntern(cg, s.kind.payload.ForIn.bindName));
                stP(&cg.body, " = ");
                stPS(&cg.body, elemExpr);
                stCh(&cg.body, ';');
            }
            else
            {
                Ty tupleTy = cgTyUnwrap(cg, cgSubstTy(cg, s.kind.payload.ForIn.bindType));
                TypeEntry* tupleEntry = tupleTy != 0 ? cg.ctx->types + tupleTy : null;
                u32 bindCount = 1 + extraLen;
                if (tupleEntry == null || tupleEntry->kind.tag != TypeKind::Tuple ||
                    tupleEntry->kind.payload.Tuple.elemsLen != bindCount)
                {
                    cgError(cg, "for-in multi-binding requires a matching tuple element type");
                    return;
                }
                u32 elemTemp = cgNewTemp(cg, elemTy, 0);
                Slice elemTempName = cgTempName(cg, elemTemp);
                stNL(&cg.body, cg.ind);
                stPS(&cg.body, elemTy);
                stCh(&cg.body, ' ');
                stPS(&cg.body, elemTempName);
                stP(&cg.body, " = ");
                stPS(&cg.body, elemExpr);
                stCh(&cg.body, ';');
                u32 bj = 0;
                while (bj < bindCount)
                {
                    Str bn = bj == 0 ? s.kind.payload.ForIn.bindName
                                     : s.kind.payload.ForIn.extraBindNames[bj - 1];
                    Slice ft = tyStr(cg, cgSubstTy(cg, tupleEntry->kind.payload.Tuple.elems[bj]));
                    cgAddLocal(cg, bn);
                    stNL(&cg.body, cg.ind);
                    stPS(&cg.body, ft);
                    stCh(&cg.body, ' ');
                    stPS(&cg.body, cgIntern(cg, bn));
                    stP(&cg.body, " = ");
                    stPS(&cg.body, elemTempName);
                    stP(&cg.body, "._");
                    stU64(&cg.body, (u64)(bj + 1));
                    stCh(&cg.body, ';');
                    bj++;
                }
            }

            cgPushLoop(cg, loopMark);
            cgStmtBraced(cg, s.kind.payload.ForIn.body);
            cgPopLoop(cg);
            cgEmitDropsTo(cg, loopMark);

            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            cg.ind--;
            stNL(&cg.body, cg.ind);
            stCh(&cg.body, '}');
            return;
        },

        StmtKind::Switch => {
            Slice scrut = cgExpr(cg, s.kind.payload.Switch.expr);
            Ty scrutTy = 0;
            {
                Node* sn = cgNode(cg, s.kind.payload.Switch.expr);
                if (sn.kind.tag == NodeKind::Expr) scrutTy = sn.kind.payload.Expr.value.resolvedType;
            }
            cgEmitSwitch(cg, scrut, scrutTy, s.kind.payload.Switch.cases, s.kind.payload.Switch.casesLen, Slice::from(null, 0));
            return;
        },

        StmtKind::Defer => {
            cgError(cg, "defer is not supported");
            stNL(&cg.body, cg.ind);
            stP(&cg.body, "/* unsupported: defer */");
            return;
        },

        StmtKind::Comptime => {
            /* comptime blocks are evaluated by the mono phase (CtEval),
             * which replaces the enclosing function body with the surviving
             * runtime statements. If codegen reaches a Comptime stmt the
             * block was never instantiated (e.g. a static helper only
             * called from comptime): emit nothing; walking it would try
             * to code-gen comptime-only constructs (pack iteration, type
             * switches) that have no runtime form. */
            return;
        },

        StmtKind::Asm => {
            stNL(&cg.body, cg.ind);
            if (s.kind.payload.Asm.flags & 1) stP(&cg.body, "__asm__ volatile (");
            else stP(&cg.body, "__asm__ (");
            // template: string literal pieces only
            u8* built = "".ptr;
            usize blen = 0;
            u32 i = 0;
            while (i < s.kind.payload.Asm.templateLen)
            {
                NodeId tnid = s.kind.payload.Asm.template[i];
                Node* tn = cgNode(cg, tnid);
                if (tn.kind.tag == NodeKind::Expr && tn.kind.payload.Expr.value.kind.tag == ExprKind::StringLit) {
                    Slice piece = cgUnquote(cg, cgIntern(cg, tn.kind.payload.Expr.value.kind.payload.StringLit.value));
                    u8* nb = (u8*)cg.arena.alloc(blen + piece.len + 1, 1);
                    if (nb != null) {
                        memcpy(nb, built, blen);
                        memcpy(nb + blen, piece.ptr, piece.len);
                        built = nb;
                        blen += piece.len;
                    }
                } else {
                    cgError(cg, "asm template pieces must be string literals");
                }
                i++;
            }
            stCh(&cg.body, '"');
            stPut(&cg.body, built, blen);
            stCh(&cg.body, '"');
            // GCC extended asm sections: `: outputs : inputs : clobbers`
            {
                bool needIn = s.kind.payload.Asm.inputsLen > 0 || s.kind.payload.Asm.clobbersLen > 0;
                if (s.kind.payload.Asm.outputsLen > 0 || needIn)
                {
                    stP(&cg.body, " : ");
                    u32 oi = 0;
                    while (oi < s.kind.payload.Asm.outputsLen)
                    {
                        if (oi > 0) stP(&cg.body, ", ");
                        Node* cn = cgNode(cg, s.kind.payload.Asm.outputs[oi]);
                        if (cn.kind.tag == NodeKind::Expr && cn.kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        {
                            Slice cs = cgUnquote(cg, cgIntern(cg, cn.kind.payload.Expr.value.kind.payload.StringLit.value));
                            stCh(&cg.body, '"');
                            stPut(&cg.body, cs.ptr, cs.len);
                            stCh(&cg.body, '"');
                        }
                        else cgError(cg, "asm operand constraint must be a string literal");
                        if (oi + 1 < s.kind.payload.Asm.outputsLen)
                        {
                            stCh(&cg.body, '(');
                            stPS(&cg.body, cgExpr(cg, s.kind.payload.Asm.outputs[oi + 1]));
                            stCh(&cg.body, ')');
                            oi++;
                        }
                        oi++;
                    }
                }
                if (needIn)
                {
                    stP(&cg.body, " : ");
                    u32 ii = 0;
                    while (ii < s.kind.payload.Asm.inputsLen)
                    {
                        if (ii > 0) stP(&cg.body, ", ");
                        Node* cn = cgNode(cg, s.kind.payload.Asm.inputs[ii]);
                        if (cn.kind.tag == NodeKind::Expr && cn.kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        {
                            Slice cs = cgUnquote(cg, cgIntern(cg, cn.kind.payload.Expr.value.kind.payload.StringLit.value));
                            stCh(&cg.body, '"');
                            stPut(&cg.body, cs.ptr, cs.len);
                            stCh(&cg.body, '"');
                        }
                        else cgError(cg, "asm operand constraint must be a string literal");
                        if (ii + 1 < s.kind.payload.Asm.inputsLen)
                        {
                            stCh(&cg.body, '(');
                            stPS(&cg.body, cgExpr(cg, s.kind.payload.Asm.inputs[ii + 1]));
                            stCh(&cg.body, ')');
                            ii++;
                        }
                        ii++;
                    }
                }
                if (s.kind.payload.Asm.clobbersLen > 0)
                {
                    stP(&cg.body, " : ");
                    u32 ci = 0;
                    while (ci < s.kind.payload.Asm.clobbersLen)
                    {
                        if (ci > 0) stP(&cg.body, ", ");
                        Node* cbn = cgNode(cg, s.kind.payload.Asm.clobbers[ci]);
                        if (cbn.kind.tag == NodeKind::Expr && cbn.kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        {
                            Slice cs = cgUnquote(cg, cgIntern(cg, cbn.kind.payload.Expr.value.kind.payload.StringLit.value));
                            stCh(&cg.body, '"');
                            stPut(&cg.body, cs.ptr, cs.len);
                            stCh(&cg.body, '"');
                        }
                        else cgError(cg, "asm clobber must be a string literal");
                        ci++;
                    }
                }
            }
            stP(&cg.body, ");");
            return;
        },

        else => {
            cgError(cg, "unsupported statement kind");
            return;
        },
    }
}

/* ── declarations: prototypes, types, bodies ──────────────────── */

bool cgDeclIsGeneric(Codegen* cg, NodeId declId)
{
    if (cg.mono == null) return false;
    return cg.mono.genericCount(declId) != 0;
}

// does a type mention a generic parameter (skip such extends)?
bool cgTyHasParam(Codegen* cg, Ty t)
{
    if (t == 0) return false;
    TypeEntry* e = cg.ctx->types + t;
    switch (e.kind.tag)
    {
        TypeKind::TypeParam => { return true; },
        TypeKind::Pointer => { return cgTyHasParam(cg, e.kind.payload.Pointer.base); },
        TypeKind::Const => { return cgTyHasParam(cg, e.kind.payload.Const.base); },
        TypeKind::Comptime => { return cgTyHasParam(cg, e.kind.payload.Comptime.base); },
        TypeKind::Slice => { return cgTyHasParam(cg, e.kind.payload.Slice.base); },
        TypeKind::Array => {
            return cgTyHasParam(cg, e.kind.payload.Array.base) ||
                   e.kind.payload.Array.sizeParam != 4294967295;
        },
        TypeKind::Named => {
            u32 i = 0;
            while (i < e.kind.payload.Named.genericArgsLen) {
                Ty arg = e.kind.payload.Named.genericArgs[i];
                TypeEntry* ae = cg.ctx->types + arg;
                /* a bare name used as a generic argument (`Option<T>`)
                 * is a parameter reference */
                if (ae.kind.tag == TypeKind::Named && ae.kind.payload.Named.genericArgsLen == 0)
                    return true;
                if (cgTyHasParam(cg, arg)) return true;
                i++;
            }
            return false;
        },
        else => { return false; },
    }
    return false;
}

// parameter list → stream (comptime/type-level params are erased)
void cgEmitParams(Codegen* cg, Stream* s, Decl* dd, Ty* paramTys, Slice owner, MonoInstance* inst)
{
    bool hadOne = false;
    /* methods without an explicit `self` still take the receiver as their
     * first parameter: sema declares an implicit `self` for them */
    bool explicitSelf = false;
    if (dd.kind.payload.Func.paramsLen > 0)
    {
        Node* p0n = cgNode(cg, dd.kind.payload.Func.params[0]);
        if (p0n.kind.tag == NodeKind::Param && (p0n.kind.payload.Param.value.flags & 1) != 0) explicitSelf = true;
    }
    if (owner.len != 0 && !explicitSelf && (dd.kind.payload.Func.flags & 4) == 0)
    {
        stPS(s, owner);
        stP(s, "* self");
        hadOne = true;
    }
    u32 i = 0;
    while (i < dd.kind.payload.Func.paramsLen)
    {
        Node* pn = cgNode(cg, dd.kind.payload.Func.params[i]);
        if (pn.kind.tag == NodeKind::Param)
        {
            Param* p = &pn.kind.payload.Param.value;
            if ((p.flags & 8) != 0) { i++; continue; }
            if ((p.flags & 16) != 0)
            {
                /* a value-specialized instance whose comptime body
                 * consumed runtime tail args names them explicitly
                 * (`_varg0`, …) so the emitted body's references resolve;
                 * call sites pass the args positionally either way */
                if (inst != null && inst.tailLen > 0 && inst.tailArgNames != null)
                {
                    u32 k = 0;
                    while (k < inst.tailLen)
                    {
                        if (hadOne) stP(s, ", ");
                        Ty ttk = cgSubstTy(cg, inst.tailTypes[k]);
                        if (ttk != 0 && (cg.ctx->types + ttk)->kind.tag == TypeKind::Array)
                        {
                            // an array parameter decays: `int32_t name[]`
                            TypeEntry* tek = cg.ctx->types + ttk;
                            stPS(s, tyStr(cg, tek->kind.payload.Array.base));
                            stCh(s, ' ');
                            stPS(s, cgIdent(cg, inst.tailArgNames[k]));
                            stP(s, "[]");
                        }
                        else
                        {
                            stPS(s, tyStr(cg, ttk));
                            stCh(s, ' ');
                            stPS(s, cgIdent(cg, inst.tailArgNames[k]));
                        }
                        hadOne = true;
                        k++;
                    }
                }
                else
                {
                    if (hadOne) stP(s, ", ");
                    stP(s, "...");
                    hadOne = true;
                }
                i++;
                continue;
            }
            if (hadOne) stP(s, ", ");
            hadOne = true;
            if ((p.flags & 1) != 0)
            {
                if (owner.len == 0) {
                    cgError(cg, "explicit self with unknown owner");
                    stP(s, "rawptr* self");
                } else {
                    stPS(s, owner);
                    stP(s, "* self");
                }
            }
            else
            {
                Ty pt = p.typeNode;
                if (paramTys != null) pt = paramTys[i];
                /* array params decay to pointers: `T name[]` */
                if (pt != 0 && (cg.ctx->types + pt)->kind.tag == TypeKind::Array)
                {
                    TypeEntry* te = cg.ctx->types + pt;
                    stPS(s, tyStr(cg, te.kind.payload.Array.base));
                    stCh(s, ' ');
                    if (p.name != 0) stPS(s, cgIdent(cg, p.name));
                    else { stP(s, "_p"); stU64(s, (u64)i); }
                    stP(s, "[]");
                }
                else
                {
                    stPS(s, tyStr(cg, pt));
                    stCh(s, ' ');
                    if (p.name != 0) stPS(s, cgIdent(cg, p.name));
                    else { stP(s, "_p"); stU64(s, (u64)i); }
                }
            }
        }
        i++;
    }
    if (!hadOne) stP(s, "void");
}

/* `#[[inline]]` / `#[[inline_always]]` on the source decl: generic
 * instances share the decl node, so the qualifier is uniform across
 * them. `extern inline` keeps an out-of-line body in the object file so
 * an un-inlined call still links */
u8 cgInlineKind(Codegen* cg, Decl* dd)
{
    Str inl = cg.ctx.intern("inline");
    Str alw = cg.ctx.intern("inline_always");
    u32 i = 0;
    while (i < dd->attrsLen)
    {
        if (dd->attrs[i].name == alw) return 2;
        if (dd->attrs[i].name == inl) return 1;
        i++;
    }
    return 0;
}

void cgEmitProto(Codegen* cg, NodeId declId, Slice cname, Ty retTy, Ty* paramTys, MonoSubstitution* subs, u32 subsLen, Slice owner, MonoInstance* inst)
{
    Node* ddn = cgNode(cg, declId);
    Decl* dd = &ddn.kind.payload.Decl.value;
    MonoSubstitution* oldSubs = cg.subs;
    u32 oldSubsLen = cg.subsLen;
    cg.subs = subs;
    cg.subsLen = subsLen;

    stNL(&cg.protos, 0);
    stPS(&cg.protos, tyStr(cg, retTy));
    stCh(&cg.protos, ' ');
    stPS(&cg.protos, cname);
    stCh(&cg.protos, '(');
    cgEmitParams(cg, &cg.protos, dd, paramTys, owner, inst);
    stP(&cg.protos, ");");

    cg.subs = oldSubs;
    cg.subsLen = oldSubsLen;
}

/* the monomorphised instance's rewritten body for this decl + subs:
 * comptime blocks were already evaluated into it; 0 when there is no
 * matching instance (callers fall back to the declaration's body) */
NodeId cgInstanceBody(Codegen* cg, NodeId declId, MonoSubstitution* subs, u32 subsLen, u64 valueKey)
{
    if (cg.mono == null) return NodeId{ .index = 0 };
    u32 k = 0;
    while (k < cg.mono.instancesLen)
    {
        MonoInstance* inst = cg.mono.instances + k;
        if (inst.kind == MonoInstanceKind::FunctionInstance &&
            inst.declaration.index == declId.index &&
            inst.substitutionsLen == subsLen &&
            inst.valueKey == valueKey &&
            inst.body.index != 0)
        {
            bool same = true;
            u32 j = 0;
            while (j < subsLen)
            {
                if (subs[j].parameter != inst.substitutions[j].parameter ||
                    subs[j].typeNode != inst.substitutions[j].typeNode)
                {
                    same = false;
                    break;
                }
                j++;
            }
            if (same) return inst.body;
        }
        k++;
    }
    return NodeId{ .index = 0 };
}

void cgEmitFuncCommon(Codegen* cg, NodeId declId, Slice cname, Ty retTy, Ty* paramTys, MonoSubstitution* subs, u32 subsLen, Slice owner, u8 isStatic, MonoInstance* inst)
{
    u64 valueKey = 0;
    if (inst != null) valueKey = inst.valueKey;
    Node* ddn = cgNode(cg, declId);
    Decl* dd = &ddn.kind.payload.Decl.value;

    MonoSubstitution* oldSubs = cg.subs;
    u32 oldSubsLen = cg.subsLen;
    cg.subs = subs;
    cg.subsLen = subsLen;

    // body first: it allocates temps whose declarations go at fn top
    usize bodyStart = cg.body.len;
    cg.tempsLen = 0;
    cg.loopDepth = 0;
    cg.breakDepth = 0;
    cg.dropsLen = 0;
    cg.fnDropMark = 0;
    cg.ind = 1;
    /* bound names: fresh set per function; params and `self` are
     * locals (Ident refs to them stay raw) */
    cg.localNamesLen = 0;
    if (owner.len != 0) cgAddLocal(cg, cg.ctx.intern("self"));
    {
        u32 pi = 0;
        while (pi < dd.kind.payload.Func.paramsLen)
        {
            Node* pn = cgNode(cg, dd.kind.payload.Func.params[pi]);
            if (pn.kind.tag == NodeKind::Param)
            {
                Param* p = &pn.kind.payload.Param.value;
                cgAddLocal(cg, p->name);
            }
            pi++;
        }
    }
    /* the instance's synthesized tail parameters are locals too: the
     * emitted body references them by name (`_varg0`, …) */
    if (inst != null && inst.tailLen > 0 && inst.tailArgNames != null)
    {
        u32 tk = 0;
        while (tk < inst.tailLen)
        {
            cgAddLocal(cg, inst.tailArgNames[tk]);
            tk++;
        }
    }
    NodeId bodyId = dd.kind.payload.Func.body;
    NodeId instBody = cgInstanceBody(cg, declId, subs, subsLen, valueKey);
    if (instBody.index != 0) bodyId = instBody;
    Node* bn = cgNode(cg, bodyId);
    if (bn.kind.tag == NodeKind::Stmt && bn.kind.payload.Stmt.value.kind.tag == StmtKind::Block)
    {
        Stmt* bs = &bn.kind.payload.Stmt.value;
        u32 i = 0;
        while (i < bs.kind.payload.Block.stmtsLen)
        {
            cgStmt(cg, bs.kind.payload.Block.stmts[i]);
            i++;
        }
    }
    else
    {
        cgStmt(cg, bodyId);
    }
    /* fall-through end of the body: unwind every live local */
    cgEmitDropsTo(cg, cg.fnDropMark);
    Slice bodyText = stTail(&cg.body, bodyStart);

    // header
    stNL(&cg.bodies, 0);
    {
        u8 inl = cgInlineKind(cg, dd);
        if (inl == 1) stP(&cg.bodies, "extern inline ");
        else if (inl == 2) stP(&cg.bodies, "extern inline __attribute__((always_inline)) ");
    }
    stPS(&cg.bodies, tyStr(cg, retTy));
    stCh(&cg.bodies, ' ');
    stPS(&cg.bodies, cname);
    stCh(&cg.bodies, '(');
    cgEmitParams(cg, &cg.bodies, dd, paramTys, owner, inst);
    stP(&cg.bodies, ") {");
    // temporaries declared at function top
    u32 t = 0;
    while (t < cg.tempsLen)
    {
        stP(&cg.bodies, "\n    ");
        Slice tty = cg.tempTys[t];
        /* an array type spells as `T[N]`; in a declaration the suffix
         * must follow the name: split at the first '[' */
        usize bi = 0;
        while (bi < tty.len && tty.ptr[bi] != 91) bi++;
        if (bi < tty.len)
        {
            usize j = 0;
            while (j < bi) { stCh(&cg.bodies, tty.ptr[j]); j++; }
            stCh(&cg.bodies, ' ');
            stPS(&cg.bodies, cgTempName(cg, t));
            j = bi;
            while (j < tty.len) { stCh(&cg.bodies, tty.ptr[j]); j++; }
            stP(&cg.bodies, ";");
        }
        else
        {
            stPS(&cg.bodies, tty);
            stCh(&cg.bodies, ' ');
            stPS(&cg.bodies, cgTempName(cg, t));
            stP(&cg.bodies, ";");
        }
        t++;
    }
    stPS(&cg.bodies, bodyText);
    stNL(&cg.bodies, 0);
    stCh(&cg.bodies, '}');

    cg.subs = oldSubs;
    cg.subsLen = oldSubsLen;
}

// fwd typedefs: structs/unions/variants + type instances
void cgEmitFwd(Codegen* cg)
{
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        NodeId id = cg.file.decls[i];
        Node* d = cgNode(cg, id);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            switch (dd.kind.tag)
            {
                DeclKind::Struct => {
                    if (cgDeclIsGeneric(cg, id)) break;
                    stP(&cg.fwd, "typedef struct ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Struct.name, 0));
                    stP(&cg.fwd, " ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Struct.name, 0));
                    stP(&cg.fwd, ";\n");
                },
                DeclKind::Union => {
                    if (cgDeclIsGeneric(cg, id)) break;
                    stP(&cg.fwd, "typedef union ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Union.name, 0));
                    stP(&cg.fwd, " ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Union.name, 0));
                    stP(&cg.fwd, ";\n");
                },
                DeclKind::Variant => {
                    if (cgDeclIsGeneric(cg, id)) break;
                    stP(&cg.fwd, "typedef struct ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Variant.name, 0));
                    stP(&cg.fwd, " ");
                    stPS(&cg.fwd, cgMangle(cg, id, dd.kind.payload.Variant.name, 0));
                    stP(&cg.fwd, ";\n");
                },
                else => {},
            }
        }
        i++;
    }
    if (cg.mono != null)
    {
        i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::TypeInstance)
            {
                Slice m = cgInstanceName(cg, inst.name, inst.arguments, inst.argumentsLen);
                stP(&cg.fwd, "typedef struct ");
                stPS(&cg.fwd, m);
                stCh(&cg.fwd, ' ');
                stPS(&cg.fwd, m);
                stP(&cg.fwd, ";\n");
            }
            i++;
        }
    }
}

/* import `as` alias refs mangle as `path__alias__name`: map each one
 * back to the canonical `path__name` definition. Exempt names (main,
 * CRT, extern) never carry the alias segment at the use site, and types
 * resolve through their declaring decl (TypeEntry.loc), so only
 * Func/Constant pairs (plus their monomorphised instances) need a
 * bridge. */
void cgEmitAliasBridges(Codegen* cg)
{
    if (cg.sema == null) return;
    u32 i = 0;
    while (i < cg.sema.aliasLen)
    {
        Str alias = cg.sema.aliasNames[i];
        NodeId declId = cg.sema.aliasDecls[i];
        i++;
        if (alias == 0 || declId.index == 0) continue;
        Node* n = cgNode(cg, declId);
        if (n.kind.tag != NodeKind::Decl) continue;
        Decl* dd = &n.kind.payload.Decl.value;
        if (dd.kind.tag != DeclKind::Func && dd.kind.tag != DeclKind::Constant) continue;
        Str own = cgDeclOwnName(dd);
        if (own == 0) continue;
        if (cgMangleExempt(cg, declId, cgIntern(cg, own))) continue;
        if (dd.kind.tag == DeclKind::Func && cgDeclIsGeneric(cg, declId))
        {
            if (cg.mono == null) continue;
            u32 j = 0;
            while (j < cg.mono.instancesLen)
            {
                MonoInstance* inst = cg.mono.instances + j;
                if (inst.kind == MonoInstanceKind::FunctionInstance &&
                    inst.declaration.index == declId.index)
                {
                    Slice inm = cgInstanceName(cg, inst.name, inst.arguments, inst.argumentsLen);
                    if (!cgMangleExempt(cg, declId, inm))
                    {
                        stP(&cg.fwd, "#define ");
                        stPS(&cg.fwd, cgMangleS(cg, declId, inm, alias));
                        stP(&cg.fwd, " ");
                        stPS(&cg.fwd, cgMangleS(cg, declId, inm, 0));
                        stP(&cg.fwd, "\n");
                    }
                }
                j++;
            }
        }
        else
        {
            stP(&cg.fwd, "#define ");
            stPS(&cg.fwd, cgMangle(cg, declId, own, alias));
            stP(&cg.fwd, " ");
            stPS(&cg.fwd, cgMangle(cg, declId, own, 0));
            stP(&cg.fwd, "\n");
        }
    }
}

void cgEmitEnumDef(Codegen* cg, NodeId declId, Decl* dd)
{
    stP(&cg.defs, "typedef enum {\n");
    u32 v = 0;
    i64 nextVal = 0;
    while (v < dd.kind.payload.Enum.variantsLen)
    {
        Node* vn = cgNode(cg, dd.kind.payload.Enum.variants[v]);
        if (vn.kind.tag == NodeKind::EnumVariant)
        {
            EnumVariant* ev = &vn.kind.payload.EnumVariant.value;
            stP(&cg.defs, "    ");
            stPS(&cg.defs, cgMangle(cg, declId, dd.kind.payload.Enum.name, 0));
            stCh(&cg.defs, '_');
            stPS(&cg.defs, cgIdent(cg, ev.name));
            if ((ev.flags & 1) != 0 && ev.value.index != 0)
            {
                /* explicit `= N` resets the auto-increment counter (the
                 * Neg path covers `= -N`) */
                Node* valNode = cgNode(cg, ev.value);
                i64 evVal = 0;
                bool evNeg = false;
                bool evOk = false;
                if (valNode.kind.tag == NodeKind::Expr)
                {
                    Expr* iv = &valNode.kind.payload.Expr.value;
                    if (iv.kind.tag == ExprKind::IntLit)
                    {
                        evVal = (i64)iv.kind.payload.IntLit.value;
                        evOk = true;
                    }
                    else if (iv.kind.tag == ExprKind::Neg)
                    {
                        Node* inn = cgNode(cg, iv.kind.payload.Neg.expr);
                        if (inn.kind.tag == NodeKind::Expr && inn.kind.payload.Expr.value.kind.tag == ExprKind::IntLit)
                        {
                            evVal = (i64)inn.kind.payload.Expr.value.kind.payload.IntLit.value;
                            evNeg = true;
                            evOk = true;
                        }
                    }
                }
                if (evOk)
                {
                    stP(&cg.defs, " = ");
                    if (evNeg) stCh(&cg.defs, '-');
                    stU64(&cg.defs, (u64)evVal);
                    nextVal = evVal;
                    if (evNeg) nextVal = -nextVal;
                    nextVal++;
                }
                else
                {
                    cgError(cg, "enum variant is not a literal");
                }
            }
            else
            {
                stP(&cg.defs, " = ");
                stI64(&cg.defs, nextVal);
                nextVal++;
            }
            if (v + 1 < dd.kind.payload.Enum.variantsLen) stCh(&cg.defs, ',');
            stP(&cg.defs, "\n");
        }
        v++;
    }
    stP(&cg.defs, "} ");
    stPS(&cg.defs, cgMangle(cg, declId, dd.kind.payload.Enum.name, 0));
    stP(&cg.defs, ";\n");
}

// `T name` / `T name[len]` at file scope (C puts array bounds after the name)
void cgEmitGlobalDeclarator(Codegen* cg, Ty cty, Slice name)
{
    if (cty != 0 && (cg.ctx->types + cty)->kind.tag == TypeKind::Array)
    {
        Ty et = cty;
        while ((cg.ctx->types + et)->kind.tag == TypeKind::Array)
            et = (cg.ctx->types + et)->kind.payload.Array.base;
        stPS(&cg.defs, tyStr(cg, et));
        stCh(&cg.defs, ' ');
        stPS(&cg.defs, name);
        Ty w = cty;
        while ((cg.ctx->types + w)->kind.tag == TypeKind::Array)
        {
            stCh(&cg.defs, '[');
            stU64(&cg.defs, (u64)(cg.ctx->types + w)->kind.payload.Array.len);
            stCh(&cg.defs, ']');
            w = (cg.ctx->types + w)->kind.payload.Array.base;
        }
        return;
    }
    stPS(&cg.defs, tyStr(cg, cty));
    stCh(&cg.defs, ' ');
    stPS(&cg.defs, name);
}

/* file-scope initializer value: brace literals stay inline (temp
 * statements cannot be emitted at file scope) and recurse into
 * nested braces; anything else falls back to cgExpr. */
void cgEmitInitValue(Codegen* cg, NodeId v)
{
    Node* n = cgNode(cg, v);
    if (n.kind.tag == NodeKind::Expr && n.kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral)
    {
        Expr* al = &n.kind.payload.Expr.value;
        stP(&cg.defs, "{");
        u32 i = 0;
        while (i < al.kind.payload.ArrayLiteral.elemsLen)
        {
            if (i > 0) stP(&cg.defs, ", ");
            cgEmitInitValue(cg, al.kind.payload.ArrayLiteral.elems[i]);
            i++;
        }
        stCh(&cg.defs, '}');
        return;
    }
    if (n.kind.tag == NodeKind::Expr && n.kind.payload.Expr.value.kind.tag == ExprKind::StructLiteral &&
        n.kind.payload.Expr.value.kind.payload.StructLiteral.variantName == 0)
    {
        Expr* se = &n.kind.payload.Expr.value;
        stP(&cg.defs, "(");
        stPS(&cg.defs, tyStr(cg, se->kind.payload.StructLiteral.typeNode));
        stP(&cg.defs, "){");
        u32 i = 0;
        while (i < se->kind.payload.StructLiteral.fieldValuesLen)
        {
            if (i > 0) stP(&cg.defs, ", ");
            if (se->kind.payload.StructLiteral.fieldNames != 0)
            {
                stP(&cg.defs, ".");
                stPS(&cg.defs, cgIdent(cg, se->kind.payload.StructLiteral.fieldNames[i]));
                stP(&cg.defs, " = ");
            }
            cgEmitInitValue(cg, se->kind.payload.StructLiteral.fieldValues[i]);
            i++;
        }
        stCh(&cg.defs, '}');
        return;
    }
    /* const-shaped exprs lower inline: cgExpr would emit statement
     * temps, which are illegal at file scope */
    if (cgConstAtom(cg, v)) { cgConstExpr(cg, v); return; }
    Slice ev = cgExpr(cg, v);
    stPS(&cg.defs, ev);
}

void cgEmitStructFields(Codegen* cg, NodeId* fields, u32 fieldsLen, u32 indent)
{
    u32 f = 0;
    bool hadOne = false;
    while (f < fieldsLen)
    {
        Node* fn = cgNode(cg, fields[f]);
        if (fn.kind.tag == NodeKind::Field)
        {
            Field* fd = &fn.kind.payload.Field.value;
            stP(&cg.defs, "\n    ");
            if (fd.typeNode != 0 &&
                (cg.ctx->types + fd.typeNode)->kind.tag == TypeKind::Array)
            {
                /* strip every dim for the element type, then re-emit the
                 * dims after the name: `T name[A][B];` */
                Ty et = fd.typeNode;
                while ((cg.ctx->types + et)->kind.tag == TypeKind::Array)
                    et = (cg.ctx->types + et)->kind.payload.Array.base;
                stPS(&cg.defs, tyStr(cg, et));
                stCh(&cg.defs, ' ');
                stPS(&cg.defs, cgIdent(cg, fd.name));
                Ty w = fd.typeNode;
                while ((cg.ctx->types + w)->kind.tag == TypeKind::Array)
                {
                    stCh(&cg.defs, '[');
                    stU64(&cg.defs, cgSubsArrayLen(cg, (cg.ctx->types + w)->kind.payload.Array.sizeParam, (cg.ctx->types + w)->kind.payload.Array.sizeName, (u64)(cg.ctx->types + w)->kind.payload.Array.len));
                    stCh(&cg.defs, ']');
                    w = (cg.ctx->types + w)->kind.payload.Array.base;
                }
                stCh(&cg.defs, ';');
            }
            else
            {
                stPS(&cg.defs, tyStr(cg, fd.typeNode));
                stCh(&cg.defs, ' ');
                stPS(&cg.defs, cgIdent(cg, fd.name));
                stCh(&cg.defs, ';');
            }
            hadOne = true;
        }
        f++;
    }
    /* C forbids an empty struct: give it a dummy member instead */
    if (!hadOne) stP(&cg.defs, "\n    char _empty;");
}

void cgEmitVariantDef(Codegen* cg, Decl* dd, Slice name)
{
    stP(&cg.defs, "struct ");
    stPS(&cg.defs, name);
    /* tag holds the variant's ORDINAL: switch lowering and cgVariantCaseIdx
       compare against the same 0-based order */
    stP(&cg.defs, " {\n    int32_t tag;");
    if (dd.kind.payload.Variant.variantsLen > 0)
    {
        stP(&cg.defs, "\n    union {");
        u32 v = 0;
        while (v < dd.kind.payload.Variant.variantsLen)
        {
            VariantVariant* vv = dd.kind.payload.Variant.variants + v;
            stP(&cg.defs, "\n        struct {");
            if (vv.fieldsLen == 0) stP(&cg.defs, " char _e;"); /* empty case still needs a member */
            u32 f = 0;
            while (f < vv.fieldsLen)
            {
                stP(&cg.defs, "\n            ");
                stPS(&cg.defs, tyStr(cg, vv.fieldTypes[f]));
                stCh(&cg.defs, ' ');
                stPS(&cg.defs, cgIdent(cg, vv.fieldNames[f]));
                stCh(&cg.defs, ';');
                f++;
            }
            stP(&cg.defs, "\n        } v");
            stU64(&cg.defs, (u64)v);
            stCh(&cg.defs, ';');
            v++;
        }
        stP(&cg.defs, "\n    } u;");
    }
    stP(&cg.defs, "\n};\n");
}

/* a reference to a file-scope `const` whose own initializer is
 * constant-foldable: cgConstExpr can substitute the value, since C
 * rejects reading another object at file scope. Returns the Constant
 * decl's node id (0 when not foldable) */
NodeId cgFoldableConstDecl(Codegen* cg, NodeId id)
{
    NodeId none;
    none.index = 0;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return none;
    Expr* e = &n.kind.payload.Expr.value;
    if (e->kind.tag != ExprKind::Ident) return none;
    Str nm = e->kind.payload.Ident.name;
    if (cgIsLocalName(cg, nm)) return none;
    Str alias = 0;
    NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Constant, id, &alias);
    if (rd.index == 0) return none;
    Node* rn = cgNode(cg, rd);
    if (rn.kind.tag != NodeKind::Decl) return none;
    Decl* rdd = &rn.kind.payload.Decl.value;
    if (rdd.kind.tag != DeclKind::Constant) return none;
    /* flags bit 16 = `const`; a `var` global may change at runtime */
    if ((rdd.kind.payload.Constant.flags & 16) == 0) return none;
    if (rdd.kind.payload.Constant.value.index == 0) return none;
    if (!cgConstAtom(cg, rdd.kind.payload.Constant.value)) return none;
    return rd;
}

/* an ident naming a function is an address constant in C: file-scope
 * `const A = { .alloc = f }` initializers rely on this */
bool cgConstFuncIdent(Codegen* cg, NodeId id)
{
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* e = &n.kind.payload.Expr.value;
    if (e->kind.tag != ExprKind::Ident) return false;
    Str nm = e->kind.payload.Ident.name;
    if (cgIsLocalName(cg, nm)) return false;
    Str alias = 0;
    NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Func, id, &alias);
    if (rd.index == 0) return false;
    Node* rn = cgNode(cg, rd);
    return rn.kind.tag == NodeKind::Decl && rn.kind.payload.Decl.value.kind.tag == DeclKind::Func;
}

/* file-scope constant values must lower to C constant expressions:
 * literals, casts, and unary/binary operators over the same, plus
 * references to other file-scope `const` decls (folded by value) */
bool cgConstAtom(Codegen* cg, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) return false;
    Expr* e = &n.kind.payload.Expr.value;
    u32 k = (u32)e->kind.tag;
    if (k == ExprKind::IntLit || k == ExprKind::FloatLit || k == ExprKind::BoolLit ||
        k == ExprKind::StringLit || k == ExprKind::CharLit || k == ExprKind::NullLit) return true;
    if (k == ExprKind::Ident)
    {
        if (cg.foldDepth >= 32) return false;
        cg.foldDepth++;
        NodeId fd = cgFoldableConstDecl(cg, id);
        bool foldable = fd.index != 0;
        cg.foldDepth--;
        if (foldable) return true;
        return cgConstFuncIdent(cg, id);
    }
    if (k == ExprKind::Neg) return cgConstAtom(cg, e->kind.payload.Neg.expr);
    if (k == ExprKind::Not) return cgConstAtom(cg, e->kind.payload.Not.expr);
    if (k == ExprKind::BitNot) return cgConstAtom(cg, e->kind.payload.BitNot.expr);
    if (k == ExprKind::AddressOf) return true;
    if (k == ExprKind::Cast) return cgConstAtom(cg, e->kind.payload.Cast.expr);
    if (k == ExprKind::Ternary)
        return cgConstAtom(cg, e->kind.payload.Ternary.cond) && cgConstAtom(cg, e->kind.payload.Ternary.thenExpr) && cgConstAtom(cg, e->kind.payload.Ternary.elseExpr);
    if (k == ExprKind::Add) return cgConstAtom(cg, e->kind.payload.Add.left) && cgConstAtom(cg, e->kind.payload.Add.right);
    if (k == ExprKind::Sub) return cgConstAtom(cg, e->kind.payload.Sub.left) && cgConstAtom(cg, e->kind.payload.Sub.right);
    if (k == ExprKind::Mul) return cgConstAtom(cg, e->kind.payload.Mul.left) && cgConstAtom(cg, e->kind.payload.Mul.right);
    if (k == ExprKind::Div) return cgConstAtom(cg, e->kind.payload.Div.left) && cgConstAtom(cg, e->kind.payload.Div.right);
    if (k == ExprKind::Mod) return cgConstAtom(cg, e->kind.payload.Mod.left) && cgConstAtom(cg, e->kind.payload.Mod.right);
    if (k == ExprKind::Eq) return cgConstAtom(cg, e->kind.payload.Eq.left) && cgConstAtom(cg, e->kind.payload.Eq.right);
    if (k == ExprKind::Ne) return cgConstAtom(cg, e->kind.payload.Ne.left) && cgConstAtom(cg, e->kind.payload.Ne.right);
    if (k == ExprKind::Lt) return cgConstAtom(cg, e->kind.payload.Lt.left) && cgConstAtom(cg, e->kind.payload.Lt.right);
    if (k == ExprKind::Le) return cgConstAtom(cg, e->kind.payload.Le.left) && cgConstAtom(cg, e->kind.payload.Le.right);
    if (k == ExprKind::Gt) return cgConstAtom(cg, e->kind.payload.Gt.left) && cgConstAtom(cg, e->kind.payload.Gt.right);
    if (k == ExprKind::Ge) return cgConstAtom(cg, e->kind.payload.Ge.left) && cgConstAtom(cg, e->kind.payload.Ge.right);
    if (k == ExprKind::And) return cgConstAtom(cg, e->kind.payload.And.left) && cgConstAtom(cg, e->kind.payload.And.right);
    if (k == ExprKind::Or) return cgConstAtom(cg, e->kind.payload.Or.left) && cgConstAtom(cg, e->kind.payload.Or.right);
    if (k == ExprKind::BitAnd) return cgConstAtom(cg, e->kind.payload.BitAnd.left) && cgConstAtom(cg, e->kind.payload.BitAnd.right);
    if (k == ExprKind::BitOr) return cgConstAtom(cg, e->kind.payload.BitOr.left) && cgConstAtom(cg, e->kind.payload.BitOr.right);
    if (k == ExprKind::BitXor) return cgConstAtom(cg, e->kind.payload.BitXor.left) && cgConstAtom(cg, e->kind.payload.BitXor.right);
    if (k == ExprKind::Shl) return cgConstAtom(cg, e->kind.payload.Shl.left) && cgConstAtom(cg, e->kind.payload.Shl.right);
    if (k == ExprKind::Shr) return cgConstAtom(cg, e->kind.payload.Shr.left) && cgConstAtom(cg, e->kind.payload.Shr.right);
    return false;
}

/* emit a cgConstAtom expression as inline C into cg.defs: literals go
 * through cgExpr (they emit no statements); operators recurse so file
 * scope never sees a statement temp */
void cgConstExpr(Codegen* cg, NodeId id)
{
    Node* n = cgNode(cg, id);
    if (n.kind.tag != NodeKind::Expr) { stPS(&cg.defs, cgExpr(cg, id)); return; }
    Expr* e = &n.kind.payload.Expr.value;
    u32 k = (u32)e->kind.tag;
    if (k == ExprKind::IntLit || k == ExprKind::FloatLit || k == ExprKind::BoolLit ||
        k == ExprKind::StringLit || k == ExprKind::CharLit || k == ExprKind::NullLit ||
        k == ExprKind::Path)
    {
        stPS(&cg.defs, cgExpr(cg, id));
        return;
    }
    if (k == ExprKind::Ident)
    {
        /* fold a reference to another file-scope `const` by value: C
         * forbids reading another object in a file-scope initializer */
        NodeId fd = cgFoldableConstDecl(cg, id);
        if (fd.index != 0)
        {
            if (cg.foldDepth >= 32)
            {
                cgError(cg, "constant initializer refers to itself");
                return;
            }
            Node* dn = cgNode(cg, fd);
            Decl* fdd = &dn.kind.payload.Decl.value;
            cg.foldDepth++;
            stCh(&cg.defs, '(');
            cgConstExpr(cg, fdd.kind.payload.Constant.value);
            stCh(&cg.defs, ')');
            cg.foldDepth--;
            return;
        }
        stPS(&cg.defs, cgExpr(cg, id));
        return;
    }
    if (k == ExprKind::Neg) { stP(&cg.defs, "-("); cgConstExpr(cg, e->kind.payload.Neg.expr); stP(&cg.defs, ")"); return; }
    if (k == ExprKind::Not) { stP(&cg.defs, "!("); cgConstExpr(cg, e->kind.payload.Not.expr); stP(&cg.defs, ")"); return; }
    if (k == ExprKind::BitNot) { stP(&cg.defs, "~("); cgConstExpr(cg, e->kind.payload.BitNot.expr); stP(&cg.defs, ")"); return; }
    if (k == ExprKind::AddressOf) { stP(&cg.defs, "&("); cgConstExpr(cg, e->kind.payload.AddressOf.expr); stP(&cg.defs, ")"); return; }
    if (k == ExprKind::Cast)
    {
        stP(&cg.defs, "(");
        /* const exprs may lack resolvedType; the cast target is authoritative */
        if (e->kind.payload.Cast.targetType != 0)
            stPS(&cg.defs, tyStr(cg, cgSubstTy(cg, e->kind.payload.Cast.targetType)));
        else
            stPS(&cg.defs, cgResultTy(cg, id, e));
        stP(&cg.defs, ")(");
        cgConstExpr(cg, e->kind.payload.Cast.expr);
        stP(&cg.defs, ")");
        return;
    }
    if (k == ExprKind::Ternary)
    {
        stP(&cg.defs, "(");
        cgConstExpr(cg, e->kind.payload.Ternary.cond);
        stP(&cg.defs, " ? ");
        cgConstExpr(cg, e->kind.payload.Ternary.thenExpr);
        stP(&cg.defs, " : ");
        cgConstExpr(cg, e->kind.payload.Ternary.elseExpr);
        stP(&cg.defs, ")");
        return;
    }
    str op = "+";
    switch (k)
    {
        ExprKind::Add, ExprKind::Sub, ExprKind::Mul, ExprKind::Div, ExprKind::Mod,
        ExprKind::Eq, ExprKind::Ne, ExprKind::Lt, ExprKind::Le, ExprKind::Gt, ExprKind::Ge,
        ExprKind::And, ExprKind::Or,
        ExprKind::BitAnd, ExprKind::BitOr, ExprKind::BitXor, ExprKind::Shl, ExprKind::Shr => {
            switch (k)
            {
                ExprKind::Add => { op = "+"; },
                ExprKind::Sub => { op = "-"; },
                ExprKind::Mul => { op = "*"; },
                ExprKind::Div => { op = "/"; },
                ExprKind::Mod => { op = "%"; },
                ExprKind::Eq => { op = "=="; },
                ExprKind::Ne => { op = "!="; },
                ExprKind::Lt => { op = "<"; },
                ExprKind::Le => { op = "<="; },
                ExprKind::Gt => { op = ">"; },
                ExprKind::Ge => { op = ">="; },
                ExprKind::And => { op = "&&"; },
                ExprKind::Or => { op = "||"; },
                ExprKind::BitAnd => { op = "&"; },
                ExprKind::BitOr => { op = "|"; },
                ExprKind::BitXor => { op = "^"; },
                ExprKind::Shl => { op = "<<"; },
                ExprKind::Shr => { op = ">>"; },
                else => {},
            }
            stCh(&cg.defs, '(');
            cgConstExpr(cg, e->kind.payload.Add.left);
            stP(&cg.defs, op);
            cgConstExpr(cg, e->kind.payload.Add.right);
            stCh(&cg.defs, ')');
            return;
        },
        else => {},
    }
    stPS(&cg.defs, cgExpr(cg, id));
}

/* would cgEmitInitValue emit this initializer without statement temps
 * and without C runtime expressions? (mirrors its shape) */
bool cgInitConstP(Codegen* cg, NodeId v)
{
    if (v.index == 0) return true;
    Node* n = cgNode(cg, v);
    if (n.kind.tag == NodeKind::Expr && n.kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral)
    {
        Expr* al = &n.kind.payload.Expr.value;
        u32 i = 0;
        while (i < al.kind.payload.ArrayLiteral.elemsLen)
        {
            if (!cgInitConstP(cg, al.kind.payload.ArrayLiteral.elems[i])) return false;
            i++;
        }
        return true;
    }
    if (n.kind.tag == NodeKind::Expr && n.kind.payload.Expr.value.kind.tag == ExprKind::StructLiteral)
    {
        Expr* se = &n.kind.payload.Expr.value;
        /* variant literals lower through cgExpr already; leave that path
         * unchanged rather than reclassifying them */
        if (se->kind.payload.StructLiteral.variantName != 0) return true;
        u32 i = 0;
        while (i < se->kind.payload.StructLiteral.fieldValuesLen)
        {
            if (!cgInitConstP(cg, se->kind.payload.StructLiteral.fieldValues[i])) return false;
            i++;
        }
        return true;
    }
    return cgConstAtom(cg, v);
}

void cgAddDynInit(Codegen* cg, NodeId decl)
{
    if (cg.dynInitsLen >= cg.dynInitsCap)
    {
        cgError(cg, "too many file-scope variables with runtime initializers");
        return;
    }
    cg.dynInits[cg.dynInitsLen] = decl;
    cg.dynInitsLen++;
}

/* runtime `var` globals: the assignments run from a constructor before
 * main, so the emitted C storage stays plain zero-initialized */
void cgEmitGlobalInit(Codegen* cg)
{
    if (cg.dynInitsLen == 0) return;
    usize bodyStart = cg.body.len;
    cg.tempsLen = 0;
    cg.loopDepth = 0;
    cg.breakDepth = 0;
    cg.dropsLen = 0;
    cg.fnDropMark = 0;
    cg.ind = 1;
    cg.localNamesLen = 0;
    u32 i = 0;
    while (i < cg.dynInitsLen)
    {
        Node* dn = cgNode(cg, cg.dynInits[i]);
        Decl* dd = &dn.kind.payload.Decl.value;
        stNL(&cg.body, cg.ind);
        stPS(&cg.body, cgMangle(cg, cg.dynInits[i], dd.kind.payload.Constant.name, 0));
        stP(&cg.body, " = ");
        Slice ev = cgExpr(cg, dd.kind.payload.Constant.value);
        stPS(&cg.body, ev);
        stCh(&cg.body, ';');
        i++;
    }
    Slice bodyText = stTail(&cg.body, bodyStart);
    stNL(&cg.bodies, 0);
    stP(&cg.bodies, "__attribute__((constructor)) static void coral_globals_init(void) {");
    // temporaries declared at function top (same shape as cgEmitFuncCommon)
    u32 t = 0;
    while (t < cg.tempsLen)
    {
        stP(&cg.bodies, "\n    ");
        Slice tty = cg.tempTys[t];
        usize bi = 0;
        while (bi < tty.len && tty.ptr[bi] != 91) bi++;
        if (bi < tty.len)
        {
            usize j = 0;
            while (j < bi) { stCh(&cg.bodies, tty.ptr[j]); j++; }
            stCh(&cg.bodies, ' ');
            stPS(&cg.bodies, cgTempName(cg, t));
            j = bi;
            while (j < tty.len) { stCh(&cg.bodies, tty.ptr[j]); j++; }
            stP(&cg.bodies, ";");
        }
        else
        {
            stPS(&cg.bodies, tty);
            stCh(&cg.bodies, ' ');
            stPS(&cg.bodies, cgTempName(cg, t));
            stP(&cg.bodies, ";");
        }
        t++;
    }
    stPS(&cg.bodies, bodyText);
    stNL(&cg.bodies, 0);
    stCh(&cg.bodies, '}');
}

/* file-scope constants and variables, emitted after the prototypes so
 * fn-pointer initializers (`const A = { .alloc = f }`) see a prior
 * declaration of f */
void cgEmitGlobals(Codegen* cg)
{
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cgNode(cg, cg.file.decls[i]);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Constant)
            {
                u8 cflags = dd.kind.payload.Constant.flags;
                NodeId cval = dd.kind.payload.Constant.value;
                Ty cty = dd.kind.payload.Constant.typeNode;
                Str cname = dd.kind.payload.Constant.name;
                if ((cflags & 2) != 0)
                {
                    // extern variable: declaration only
                    stP(&cg.defs, "extern ");
                    cgEmitGlobalDeclarator(cg, cty, cgMangle(cg, cg.file.decls[i], cname, 0));
                    stP(&cg.defs, ";\n");
                }
                else
                {
                    if ((cflags & 4) != 0) stP(&cg.defs, "static ");
                    cgEmitGlobalDeclarator(cg, cty, cgMangle(cg, cg.file.decls[i], cname, 0));
                    if (cval.index != 0)
                    {
                        bool isArray = cty != 0 &&
                            (cg.ctx->types + cty)->kind.tag == TypeKind::Array;
                        Node* inn = cgNode(cg, cval);
                        bool isArrLit = inn.kind.tag == NodeKind::Expr &&
                            inn.kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral;
                        if (isArray && !isArrLit)
                            cgError(cg, "array constant needs an array-literal initializer");
                        /* C only accepts constant expressions at file scope.
                         * a `const` decl must be one; a runtime `var`
                         * initializer is deferred to coral_globals_init() */
                        bool constShaped = cgInitConstP(cg, cval);
                        if (!constShaped && (cflags & 16) != 0)
                        {
                            cgErrorUnsupported(cg, cg.file.decls[i],
                                "initializer of a file-scope constant must be a constant expression");
                        }
                        else if (!constShaped && isArray)
                        {
                            cgErrorUnsupported(cg, cg.file.decls[i],
                                "file-scope array initializer must be constant");
                        }
                        else if (!constShaped)
                        {
                            cgAddDynInit(cg, cg.file.decls[i]);
                        }
                        else
                        {
                            stP(&cg.defs, " = ");
                            cgEmitInitValue(cg, cval);
                        }
                    }
                    stP(&cg.defs, ";\n");
                }
            }
        }
        i++;
    }
}

/* completeness walk for by-value field ordering: pointer and slice
 * fields name an incomplete type legally; const/comptime/array wrap a
 * by-value element; a Named must already be emitted */
void cgTypeCompleteDeps(Codegen* cg, Ty t, Slice* names, u8* emitted, u32 n, bool* ready)
{
    if (!*ready || t == 0 || names == null) return;
    TypeKind k = (cg.ctx->types + t)->kind;
    if (k.tag == TypeKind::Pointer) return;
    if (k.tag == TypeKind::Slice) return;
    if (k.tag == TypeKind::Const) { cgTypeCompleteDeps(cg, k.payload.Const.base, names, emitted, n, ready); return; }
    if (k.tag == TypeKind::Comptime) { cgTypeCompleteDeps(cg, k.payload.Comptime.base, names, emitted, n, ready); return; }
    if (k.tag == TypeKind::Array) { cgTypeCompleteDeps(cg, k.payload.Array.base, names, emitted, n, ready); return; }
    if (k.tag == TypeKind::Named)
    {
        Slice want = tyStr(cg, t);
        u32 j = 0;
        while (j < n)
        {
            if (!emitted[j] && cgSliceEq(names[j], want)) { *ready = false; return; }
            j++;
        }
    }
}

bool cgTypeBodyReady(Codegen* cg, NodeId declId, MonoInstance* inst, Slice* names, u8* emitted, u32 n)
{
    Node* d = cgNode(cg, declId);
    if (d.kind.tag != NodeKind::Decl || names == null) return true;
    Decl* dd = &d.kind.payload.Decl.value;
    MonoSubstitution* oldSubs = cg.subs;
    u32 oldSubsLen = cg.subsLen;
    if (inst != null) { cg.subs = inst->substitutions; cg.subsLen = inst->substitutionsLen; }
    else { cg.subs = null; cg.subsLen = 0; }
    bool ready = true;
    if (dd.kind.tag == DeclKind::Struct)
    {
        u32 f = 0;
        while (f < dd.kind.payload.Struct.fieldsLen && ready)
        {
            Node* fn = cgNode(cg, dd.kind.payload.Struct.fields[f]);
            if (fn.kind.tag == NodeKind::Field)
                cgTypeCompleteDeps(cg, fn.kind.payload.Field.value.typeNode, names, emitted, n, &ready);
            f++;
        }
    }
    else if (dd.kind.tag == DeclKind::Union)
    {
        u32 f = 0;
        while (f < dd.kind.payload.Union.fieldsLen && ready)
        {
            Node* fn = cgNode(cg, dd.kind.payload.Union.fields[f]);
            if (fn.kind.tag == NodeKind::Field)
                cgTypeCompleteDeps(cg, fn.kind.payload.Field.value.typeNode, names, emitted, n, &ready);
            f++;
        }
    }
    else if (dd.kind.tag == DeclKind::Variant)
    {
        u32 v = 0;
        while (v < dd.kind.payload.Variant.variantsLen && ready)
        {
            u32 f = 0;
            while (f < dd.kind.payload.Variant.variants[v].fieldsLen && ready)
            {
                cgTypeCompleteDeps(cg, dd.kind.payload.Variant.variants[v].fieldTypes[f], names, emitted, n, &ready);
                f++;
            }
            v++;
        }
    }
    cg.subs = oldSubs;
    cg.subsLen = oldSubsLen;
    return ready;
}

void cgEmitTypeBody(Codegen* cg, NodeId declId, MonoInstance* inst, Slice m)
{
    Node* d = cgNode(cg, declId);
    if (d.kind.tag != NodeKind::Decl) return;
    Decl* dd = &d.kind.payload.Decl.value;
    MonoSubstitution* oldSubs = cg.subs;
    u32 oldSubsLen = cg.subsLen;
    if (inst != null) { cg.subs = inst->substitutions; cg.subsLen = inst->substitutionsLen; }
    else { cg.subs = null; cg.subsLen = 0; }
    if (dd.kind.tag == DeclKind::Struct)
    {
        stP(&cg.defs, "struct ");
        stPS(&cg.defs, m);
        stP(&cg.defs, " {");
        cgEmitStructFields(cg, dd.kind.payload.Struct.fields, dd.kind.payload.Struct.fieldsLen, 4);
        stP(&cg.defs, "\n};\n");
    }
    else if (dd.kind.tag == DeclKind::Union)
    {
        stP(&cg.defs, "union ");
        stPS(&cg.defs, m);
        stP(&cg.defs, " {");
        cgEmitStructFields(cg, dd.kind.payload.Union.fields, dd.kind.payload.Union.fieldsLen, 4);
        stP(&cg.defs, "\n};\n");
    }
    else if (dd.kind.tag == DeclKind::Variant) cgEmitVariantDef(cg, dd, m);
    cg.subs = oldSubs;
    cg.subsLen = oldSubsLen;
}

void cgEmitTypeDefs(Codegen* cg)
{
    u32 i = 0;
    /* sweeps 1+2 target cg.typedefs (emitted before the registry
     * typedefs — FnP typedefs name aliases like `File` by value, so the
     * aliases must be complete before them). Re-bind the stream; growth
     * reallocates, so copy the grown stream back. */
    Stream defsSaved = cg.defs;
    cg.defs = cg.typedefs;
    // sweep 1: aliases
    while (i < cg.file.declsLen)
    {
        Node* d = cgNode(cg, cg.file.decls[i]);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::TypeAlias)
            {
                Ty tgt = dd.kind.payload.TypeAlias.target;
                TypeKind tgtKind = (cg.ctx->types + tgt)->kind;
                /* An alias of a registry type (FnPtr/Slice/Tuple) must
                 * follow the registry typedef it names. The registry
                 * stream is emitted after cg.typedefs, so emit these
                 * aliases into tdecl, right after cgRegEnsure has
                 * deposited the target definition. */
                if (tgt != 0 && (tgtKind.tag == TypeKind::FnPtr ||
                                 tgtKind.tag == TypeKind::Slice ||
                                 tgtKind.tag == TypeKind::Tuple))
                {
                    cgRegEnsure(cg, tgt);
                    stP(&cg.tdecl, "typedef ");
                    stPS(&cg.tdecl, tyStr(cg, tgt));
                    stCh(&cg.tdecl, ' ');
                    stPS(&cg.tdecl, cgMangle(cg, cg.file.decls[i], dd.kind.payload.TypeAlias.name, 0));
                    stP(&cg.tdecl, ";\n");
                }
                else
                {
                    stP(&cg.defs, "typedef ");
                    stPS(&cg.defs, tyStr(cg, dd.kind.payload.TypeAlias.target));
                    stCh(&cg.defs, ' ');
                    stPS(&cg.defs, cgMangle(cg, cg.file.decls[i], dd.kind.payload.TypeAlias.name, 0));
                    stP(&cg.defs, ";\n");
                }
            }
            else if (dd.kind.tag == DeclKind::Distinct)
            {
                stP(&cg.defs, "typedef ");
                stPS(&cg.defs, tyStr(cg, dd.kind.payload.Distinct.baseType));
                stCh(&cg.defs, ' ');
                stPS(&cg.defs, cgMangle(cg, cg.file.decls[i], dd.kind.payload.Distinct.name, 0));
                stP(&cg.defs, ";\n");
            }
        }
        i++;
    }
    // sweep 2: enums (typedef names must exist before structs use them)
    i = 0;
    while (i < cg.file.declsLen)
    {
        Node* d = cgNode(cg, cg.file.decls[i]);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Enum) cgEmitEnumDef(cg, cg.file.decls[i], dd);
        }
        i++;
    }
    cg.typedefs = cg.defs;
    cg.defs = defsSaved;
    /* sweep 2b+3+5 combined: struct/union/variant bodies — file decls
     * and monomorphised instances — in by-value dependency order.
     * Instances hold file types by value (HashMapEntry<String,String>
     * contains String) and file structs hold instances by value
     * (entries as Vec<String>), so neither fixed order works: emit any
     * body whose by-value named fields are already emitted, repeating
     * until none remain. Pointer and slice fields need no ordering (the
     * typedefs above make the names visible); a by-value cycle is
     * illegal in Coral and falls back to source order. */
    {
        u32 count = 0;
        i = 0;
        while (i < cg.file.declsLen)
        {
            Node* d = cgNode(cg, cg.file.decls[i]);
            if (d.kind.tag == NodeKind::Decl)
            {
                Decl* dd = &d.kind.payload.Decl.value;
                if ((dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union || dd.kind.tag == DeclKind::Variant) &&
                    !cgDeclIsGeneric(cg, cg.file.decls[i])) count++;
            }
            i++;
        }
        u32 instCount = 0;
        if (cg.mono != null)
        {
            i = 0;
            while (i < cg.mono.instancesLen)
            {
                MonoInstance* inst = cg.mono.instances + i;
                if (inst.kind == MonoInstanceKind::TypeInstance)
                {
                    Node* d = cgNode(cg, inst.declaration);
                    if (d.kind.tag == NodeKind::Decl)
                    {
                        Decl* dd = &d.kind.payload.Decl.value;
                        if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union || dd.kind.tag == DeclKind::Variant) instCount++;
                    }
                }
                i++;
            }
        }
        if (count + instCount > 0)
        {
            NodeId* declIds = alloc<NodeId>((usize)(count + instCount));
            MonoInstance** insts = alloc<MonoInstance*>((usize)(count + instCount));
            Slice* names = alloc<Slice>((usize)(count + instCount));
            u8* emitted = alloc<u8>((usize)(count + instCount));
            if (declIds != null && insts != null && names != null && emitted != null)
            {
                zero<u8>(emitted, (usize)(count + instCount));
                u32 n = 0;
                i = 0;
                while (i < cg.file.declsLen)
                {
                    Node* d = cgNode(cg, cg.file.decls[i]);
                    if (d.kind.tag == NodeKind::Decl)
                    {
                        Decl* dd = &d.kind.payload.Decl.value;
                        bool take = !cgDeclIsGeneric(cg, cg.file.decls[i]);
                        Slice m = Slice::from(null, 0);
                        if (take && dd.kind.tag == DeclKind::Struct) m = cgMangle(cg, cg.file.decls[i], dd.kind.payload.Struct.name, 0);
                        else if (take && dd.kind.tag == DeclKind::Union) m = cgMangle(cg, cg.file.decls[i], dd.kind.payload.Union.name, 0);
                        else if (take && dd.kind.tag == DeclKind::Variant) m = cgMangle(cg, cg.file.decls[i], dd.kind.payload.Variant.name, 0);
                        else take = false;
                        if (take)
                        {
                            declIds[n] = cg.file.decls[i];
                            insts[n] = null;
                            names[n] = m;
                            n++;
                        }
                    }
                    i++;
                }
                if (cg.mono != null)
                {
                    i = 0;
                    while (i < cg.mono.instancesLen)
                    {
                        MonoInstance* inst = cg.mono.instances + i;
                        if (inst.kind == MonoInstanceKind::TypeInstance)
                        {
                            Node* d = cgNode(cg, inst.declaration);
                            if (d.kind.tag == NodeKind::Decl)
                            {
                                Decl* dd = &d.kind.payload.Decl.value;
                                if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union || dd.kind.tag == DeclKind::Variant)
                                {
                                    declIds[n] = inst.declaration;
                                    insts[n] = inst;
                                    names[n] = cgInstanceName(cg, inst.name, inst.arguments, inst.argumentsLen);
                                    n++;
                                }
                            }
                        }
                        i++;
                    }
                }
                u32 remaining = n;
                while (remaining > 0)
                {
                    u32 progress = 0;
                    u32 bi = 0;
                    while (bi < n)
                    {
                        if (!emitted[bi])
                        {
                            bool ready = cgTypeBodyReady(cg, declIds[bi], insts[bi], names, emitted, n);
                            if (ready)
                            {
                                cgEmitTypeBody(cg, declIds[bi], insts[bi], names[bi]);
                                emitted[bi] = 1;
                                remaining--;
                                progress++;
                            }
                        }
                        bi++;
                    }
                    if (progress == 0)
                    {
                        bi = 0;
                        while (bi < n)
                        {
                            if (!emitted[bi])
                            {
                                cgEmitTypeBody(cg, declIds[bi], insts[bi], names[bi]);
                                emitted[bi] = 1;
                                remaining--;
                            }
                            bi++;
                        }
                    }
                }
                dealloc<NodeId>(declIds);
                dealloc<MonoInstance*>(insts);
                dealloc<Slice>(names);
                dealloc<u8>(emitted);
            }
            else
            {
                if (declIds != null) dealloc<NodeId>(declIds);
                if (insts != null) dealloc<MonoInstance*>(insts);
                if (names != null) dealloc<Slice>(names);
                if (emitted != null) dealloc<u8>(emitted);
                cg.errors++;
            }
        }
    }
    /* sweep 4 (file-scope constants) moved to cgEmitGlobals: it runs
     * after the prototypes so fn-pointer initializers see a prior
     * declaration of the function */
}

// owner prefix for methods of a type/extend decl
Slice cgDeclOwner(Codegen* cg, Decl* dd)
{
    switch (dd.kind.tag)
    {
        DeclKind::Struct => { return cgIdent(cg, dd.kind.payload.Struct.name); },
        DeclKind::Union => { return cgIdent(cg, dd.kind.payload.Union.name); },
        DeclKind::Variant => { return cgIdent(cg, dd.kind.payload.Variant.name); },
        DeclKind::Extend => { return cgOwnerName(cg, dd.kind.payload.Extend.selfType); },
        DeclKind::ExtendTrait => { return cgOwnerName(cg, dd.kind.payload.ExtendTrait.selfType); },
        else => { return Slice::from(null, 0); },
    }
    return Slice::from(null, 0);
}

bool cgOwnerGeneric(Codegen* cg, Decl* dd)
{
    switch (dd.kind.tag)
    {
        DeclKind::Struct => { return dd.kind.payload.Struct.genericParamsLen > 0; },
        DeclKind::Union => { return dd.kind.payload.Union.genericParamsLen > 0; },
        DeclKind::Variant => { return dd.kind.payload.Variant.genericParamsLen > 0; },
        DeclKind::Extend => { return dd.kind.payload.Extend.genericParamsLen > 0 || cgTyHasParam(cg, dd.kind.payload.Extend.selfType); },
        DeclKind::ExtendTrait => { return dd.kind.payload.ExtendTrait.genericParamsLen > 0 || cgTyHasParam(cg, dd.kind.payload.ExtendTrait.selfType); },
        else => { return false; },
    }
    return false;
}

void cgEmitMethodSet(Codegen* cg, NodeId declId, bool withBodies)
{
    Node* od = cgNode(cg, declId);
    if (od.kind.tag != NodeKind::Decl) return;
    Decl* dd = &od.kind.payload.Decl.value;
    if (cgOwnerGeneric(cg, dd)) return;
    /* `owner` = the bare coral name: it forms the `owner_method` symbol
     * suffix both def and call sides agree on. `paramOwner` = the self
     * parameter's C type, path-mangled like every other type reference. */
    Slice owner = cgDeclOwner(cg, dd);
    Slice paramOwner = owner;
    if (dd.kind.tag == DeclKind::Extend)
        paramOwner = cgOwnerTypeName(cg, dd.kind.payload.Extend.selfType);
    else if (dd.kind.tag == DeclKind::ExtendTrait)
        paramOwner = cgOwnerTypeName(cg, dd.kind.payload.ExtendTrait.selfType);
    else
        paramOwner = cgMangle(cg, declId, cgDeclOwnName(dd), 0);
    NodeId* methods = null;
    u32 mlen = 0;
    switch (dd.kind.tag)
    {
        DeclKind::Struct => { methods = dd.kind.payload.Struct.methods; mlen = dd.kind.payload.Struct.methodsLen; },
        DeclKind::Union => { methods = dd.kind.payload.Union.methods; mlen = dd.kind.payload.Union.methodsLen; },
        DeclKind::Variant => { methods = dd.kind.payload.Variant.methods; mlen = dd.kind.payload.Variant.methodsLen; },
        DeclKind::Extend => { methods = dd.kind.payload.Extend.methods; mlen = dd.kind.payload.Extend.methodsLen; },
        DeclKind::ExtendTrait => { methods = dd.kind.payload.ExtendTrait.methods; mlen = dd.kind.payload.ExtendTrait.methodsLen; },
        else => { return; },
    }
    u32 m = 0;
    while (m < mlen)
    {
        NodeId mid = methods[m];
        Node* mn = cgNode(cg, mid);
        if (mn.kind.tag == NodeKind::Decl && mn.kind.payload.Decl.value.kind.tag == DeclKind::Func)
        {
            Decl* md = &mn.kind.payload.Decl.value;
            if (!cgDeclIsGeneric(cg, mid))
            {
                usize ns = cg.tybuf.len;
                stPS(&cg.tybuf, owner);
                stCh(&cg.tybuf, '_');
                stPS(&cg.tybuf, cgIntern(cg, md.kind.payload.Func.name));
                Slice cname = cgMangleS(cg, mid, stTail(&cg.tybuf, ns), 0);
                u8 flags = md.kind.payload.Func.flags;
                if (withBodies)
                {
                    if ((flags & 8) != 0 && (flags & 2) == 0)
                        cgEmitFuncCommon(cg, mid, cname, md.kind.payload.Func.returnType, null, null, 0, paramOwner, (flags & 4) != 0 ? 1 : 0, null);
                }
                else
                {
                    /* extern method: emit the prototype too: nothing
                       (system header) declares it for us anymore */
                    cgEmitProto(cg, mid, cname, md.kind.payload.Func.returnType, null, null, 0, paramOwner, null);
                }
            }
        }
        m++;
    }
}

// an extend's self type matched against a concrete instance
bool cgSelfTyMatches(Codegen* cg, Ty selfTy, Str instName, Ty* args, u32 argsLen)
{
    if (selfTy == 0) return false;
    TypeEntry* e = cg.ctx->types + selfTy;
    if (e.kind.tag == TypeKind::Const) return cgSelfTyMatches(cg, e.kind.payload.Const.base, instName, args, argsLen);
    if (e.kind.tag != TypeKind::Named) return false;
    if (e.kind.payload.Named.name != instName) return false;
    if (e.kind.payload.Named.genericArgsLen != argsLen) return false;
    u32 i = 0;
    while (i < argsLen)
    {
        Ty a = e.kind.payload.Named.genericArgs[i];
        TypeEntry* ae = cg.ctx->types + a;
        if (ae.kind.tag != TypeKind::TypeParam && a != args[i]) return false;
        i++;
    }
    return true;
}

void cgEmitInstMethodList(Codegen* cg, NodeId* methods, u32 mlen, Slice m, MonoInstance* inst, bool withBodies)
{
    u32 k = 0;
    while (k < mlen)
    {
        NodeId mid = methods[k];
        Node* mn = cgNode(cg, mid);
        if (mn.kind.tag == NodeKind::Decl && mn.kind.payload.Decl.value.kind.tag == DeclKind::Func)
        {
            Decl* md = &mn.kind.payload.Decl.value;
            if (!cgDeclIsGeneric(cg, mid))
            {
                usize ns = cg.tybuf.len;
                stPS(&cg.tybuf, m);
                stCh(&cg.tybuf, '_');
                stPS(&cg.tybuf, cgIntern(cg, md.kind.payload.Func.name));
                Slice cname = cgMangleS(cg, mid, stTail(&cg.tybuf, ns), 0);
                u8 flags = md.kind.payload.Func.flags;
                if (withBodies)
                {
                    if ((flags & 8) != 0 && (flags & 2) == 0)
                        cgEmitFuncCommon(cg, mid, cname, md.kind.payload.Func.returnType, null, inst.substitutions, inst.substitutionsLen, m, (flags & 4) != 0 ? 1 : 0, inst);
                }
                else
                {
                    cgEmitProto(cg, mid, cname, md.kind.payload.Func.returnType, null, inst.substitutions, inst.substitutionsLen, m, inst);
                }
            }
        }
        k++;
    }
}

/* methods for a monomorphised type instance: the type's own methods plus
 * every extend whose self type matches it */
void cgEmitInstanceMethods(Codegen* cg, Decl* dd, MonoInstance* inst, bool withBodies)
{
    Slice m = cgInstanceName(cg, inst.name, inst.arguments, inst.argumentsLen);
    /* same alias-equal-args symbol collapse as FunctionInstance protos */
    if (withBodies)
    {
        if (cgFnSeen(cg, m, false)) return;
        cgFnSee(cg, m, false);
    }
    else
    {
        if (cgFnSeen(cg, m, true)) return;
        cgFnSee(cg, m, true);
    }
    NodeId* methods = null;
    u32 mlen = 0;
    switch (dd.kind.tag)
    {
        DeclKind::Struct => { methods = dd.kind.payload.Struct.methods; mlen = dd.kind.payload.Struct.methodsLen; },
        DeclKind::Union => { methods = dd.kind.payload.Union.methods; mlen = dd.kind.payload.Union.methodsLen; },
        DeclKind::Variant => { methods = dd.kind.payload.Variant.methods; mlen = dd.kind.payload.Variant.methodsLen; },
        else => {},
    }
    if (methods != null) cgEmitInstMethodList(cg, methods, mlen, m, inst, withBodies);
    u32 d = 0;
    while (d < cg.file.declsLen)
    {
        Node* dn = cgNode(cg, cg.file.decls[d]);
        if (dn.kind.tag == NodeKind::Decl)
        {
            Decl* xd = &dn.kind.payload.Decl.value;
            bool matches = false;
            if (xd.kind.tag == DeclKind::Extend)
                matches = cgSelfTyMatches(cg, xd.kind.payload.Extend.selfType, inst.name, inst.arguments, inst.argumentsLen);
            else if (xd.kind.tag == DeclKind::ExtendTrait)
                matches = cgSelfTyMatches(cg, xd.kind.payload.ExtendTrait.selfType, inst.name, inst.arguments, inst.argumentsLen);
            if (matches)
            {
                NodeId* em = null;
                u32 eml = 0;
                if (xd.kind.tag == DeclKind::Extend) { em = xd.kind.payload.Extend.methods; eml = xd.kind.payload.Extend.methodsLen; }
                else { em = xd.kind.payload.ExtendTrait.methods; eml = xd.kind.payload.ExtendTrait.methodsLen; }
                cgEmitInstMethodList(cg, em, eml, m, inst, withBodies);
            }
        }
        d++;
    }
}

void cgEmitProtos(Codegen* cg)
{
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        NodeId id = cg.file.decls[i];
        Node* d = cgNode(cg, id);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Func)
            {
                if (cgDeclIsGeneric(cg, id)) { i++; continue; }
                /* two extern decls of the same C name (libc's printf vs a
                 * user redeclaration with a different pointer type) must
                 * produce ONE prototype: C allows a name only once per
                 * translation unit; first declaration wins */
                if ((dd.kind.payload.Func.flags & 2) != 0)
                {
                    u32 j = 0;
                    while (j < i)
                    {
                        Node* d2 = cgNode(cg, cg.file.decls[j]);
                        if (d2.kind.tag == NodeKind::Decl)
                        {
                            Decl* d2d = &d2.kind.payload.Decl.value;
                            if (d2d.kind.tag == DeclKind::Func && (d2d.kind.payload.Func.flags & 2) != 0 &&
                                d2d.kind.payload.Func.name == dd.kind.payload.Func.name)
                            { i++; break; }
                        }
                        j++;
                    }
                    if (j < i) continue;
                }
                /* emit prototypes for ALL extern fns too: the system
                 * headers are gone, so coral's own decl is the only one */
                cgEmitProto(cg, id, cgMangle(cg, id, dd.kind.payload.Func.name, 0),
                            dd.kind.payload.Func.returnType, null, null, 0, Slice::from(null, 0), null);
            }
            else if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union ||
                     dd.kind.tag == DeclKind::Variant || dd.kind.tag == DeclKind::Extend ||
                     dd.kind.tag == DeclKind::ExtendTrait)
            {
                cgEmitMethodSet(cg, id, false);
            }
        }
        i++;
    }
    if (cg.mono != null)
    {
        i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::FunctionInstance)
            {
                Slice m = cgMangleS(cg, inst.declaration,
                                    cgInstanceNameV(cg, inst.name, inst.arguments, inst.argumentsLen, inst.valueKey), 0);
                /* alias-equal args (`u32` / `Str` / `Ty` all spell `uint32_t`)
                 * compose one C symbol from several instances — emit once */
                if (!cgFnSeen(cg, m, true))
                {
                    cgFnSee(cg, m, true);
                    cgEmitProto(cg, inst.declaration, m, inst.returnType, inst.paramTypes,
                                inst.substitutions, inst.substitutionsLen, Slice::from(null, 0), inst);
                }
            }
            else if (inst.kind == MonoInstanceKind::TypeInstance)
            {
                Node* dn = cgNode(cg, inst.declaration);
                if (dn.kind.tag == NodeKind::Decl)
                {
                    Decl* dd = &dn.kind.payload.Decl.value;
                    if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union || dd.kind.tag == DeclKind::Variant)
                        cgEmitInstanceMethods(cg, dd, inst, false);
                }
            }
            i++;
        }
    }
}

/* emits every body the module owns: non-generic funcs, then each mono
 * function instance and every type instance's methods */
void cgEmitBodies(Codegen* cg)
{
    u32 i = 0;
    while (i < cg.file.declsLen)
    {
        NodeId id = cg.file.decls[i];
        Node* d = cgNode(cg, id);
        if (d.kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d.kind.payload.Decl.value;
            if (dd.kind.tag == DeclKind::Func)
            {
                /* func flags: 2 = extern (declared, not defined), 4 = static, 8 = has a body */
                u8 flags = dd.kind.payload.Func.flags;
                if ((flags & 8) != 0 && (flags & 2) == 0 && !cgDeclIsGeneric(cg, id))
                    cgEmitFuncCommon(cg, id, cgMangle(cg, id, dd.kind.payload.Func.name, 0),
                                     dd.kind.payload.Func.returnType, null, null, 0,
                                     Slice::from(null, 0), (flags & 4) != 0 ? 1 : 0, null);
            }
            else if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union ||
                     dd.kind.tag == DeclKind::Variant || dd.kind.tag == DeclKind::Extend ||
                     dd.kind.tag == DeclKind::ExtendTrait)
            {
                cgEmitMethodSet(cg, id, true);
            }
        }
        i++;
    }
    if (cg.mono != null)
    {
        i = 0;
        while (i < cg.mono.instancesLen)
        {
            MonoInstance* inst = cg.mono.instances + i;
            if (inst.kind == MonoInstanceKind::FunctionInstance)
            {
                Node* idn = cgNode(cg, inst.declaration);
                Decl* dd = &idn.kind.payload.Decl.value;
                if ((dd.kind.payload.Func.flags & 8) != 0 && (dd.kind.payload.Func.flags & 2) == 0)
                {
                    Slice m = cgMangleS(cg, inst.declaration,
                                        cgInstanceNameV(cg, inst.name, inst.arguments, inst.argumentsLen, inst.valueKey), 0);
                    if (!cgFnSeen(cg, m, false))
                    {
                        cgFnSee(cg, m, false);
                        cgEmitFuncCommon(cg, inst.declaration, m, inst.returnType, inst.paramTypes,
                                         inst.substitutions, inst.substitutionsLen, Slice::from(null, 0), 0, inst);
                    }
                }
            }
            else if (inst.kind == MonoInstanceKind::TypeInstance)
            {
                Node* dn = cgNode(cg, inst.declaration);
                if (dn.kind.tag == NodeKind::Decl)
                {
                    Decl* dd = &dn.kind.payload.Decl.value;
                    if (dd.kind.tag == DeclKind::Struct || dd.kind.tag == DeclKind::Union || dd.kind.tag == DeclKind::Variant)
                        cgEmitInstanceMethods(cg, dd, inst, true);
                }
            }
            i++;
        }
    }
}

/* ── entry point: analyzed AST → flat C ──────────────────────── */

pub CodegenResult generateC(AstContext* ctx, File* file, MonoContext* mono, Arena* arena)
{
    Codegen cg;
    cg.ctx = ctx;
    cg.file = file;
    cg.mono = mono;
    cg.sema = null;
    if (mono != null) cg.sema = mono.sema;
    cg.arena = arena;
    cg.out = stNew(arena, 4096);
    cg.fwd = stNew(arena, 4096);
    cg.defs = stNew(arena, 16384);
    cg.protos = stNew(arena, 8192);
    /* initial capacities only; stPut doubles a stream when it fills */
    cg.bodies = stNew(arena, 65536);
    cg.body = stNew(arena, 65536);
    cg.ebuf = stNew(arena, 8192);
    cg.tybuf = stNew(arena, 16384);
    cg.tdecl = stNew(arena, 16384);
    cg.typedefs = stNew(arena, 8192);
    cg.protoFnCap = 16384;
    cg.protoFnLen = 0;
    cg.protoFnNames = (Slice*)arena.alloc(16384 * @sizeof(Slice), 8);
    cg.bodyFnCap = 16384;
    cg.bodyFnLen = 0;
    cg.bodyFnNames = (Slice*)arena.alloc(16384 * @sizeof(Slice), 8);
    cg.subs = null;
    cg.subsLen = 0;
    cg.errors = 0;
    cg.declCacheLen = 0;
    cg.declCacheNames = (Str*)cg.arena.alloc(32 * @sizeof(Str), 4);
    cg.declCacheIds = (u32*)cg.arena.alloc(32 * @sizeof(u32), 4);
    cg.declCacheTags = (u32*)cg.arena.alloc(32 * @sizeof(u32), 4);
    if (cg.declCacheNames != null)
    {
        u32 dci = 0;
        while (dci < 32) { cg.declCacheNames[dci] = 0; cg.declCacheIds[dci] = 0; cg.declCacheTags[dci] = 0; dci++; }
    }
    cg.labelSeq = 0;
    cg.tempSeq = 0;
    cg.localNames = null;
    cg.localNamesLen = 0;
    cg.localNamesCap = 0;
    cg.tempsCap = 4096;
    cg.tempsLen = 0;
    cg.tempTys = (Slice*)arena.alloc(4096 * @sizeof(Slice), 8);
    cg.tempArrs = (u32*)arena.alloc(4096 * @sizeof(u32), 8);
    cg.loopCap = 64;
    cg.loopDepth = 0;
    cg.breakDepth = 0;
    cg.switchSeq = 0;
    cg.breakKinds = (u32*)arena.alloc(64 * @sizeof(u32), 8);
    cg.breakLabels = (u32*)arena.alloc(64 * @sizeof(u32), 8);
    cg.dropsCap = 4096;
    cg.dropsLen = 0;
    cg.fnDropMark = 0;
    cg.drops = (DropEntry*)arena.alloc(4096 * @sizeof(DropEntry), 8);
    cg.loopDropMarks = (u32*)arena.alloc(64 * @sizeof(u32), 8);
    cg.breakDropMarks = (u32*)arena.alloc(64 * @sizeof(u32), 8);
    cg.regCap = 512;
    cg.regLen = 0;
    cg.regNames = (Slice*)arena.alloc(512 * @sizeof(Slice), 8);
    cg.dynInitsCap = 512;
    cg.dynInitsLen = 0;
    cg.dynInits = (NodeId*)arena.alloc(512 * @sizeof(NodeId), 8);
    cg.foldDepth = 0;
    cg.ind = 0;
    if (cg.tempTys == null || cg.tempArrs == null || cg.regNames == null || cg.dynInits == null) {
        CodegenResult r;
        r.cCode = Slice::from(null, 0);
        r.errors = 1;
        return r;
    }

    cgEmitFwd(&cg);
    cgEmitAliasBridges(&cg);
    cgEmitTypeDefs(&cg);
    cgEmitProtos(&cg);
    {
        /* file-scope globals land after the prototypes: their initializers
         * may name functions (`const A = { .alloc = f }`). Re-bind the
         * stream after emission; growth reallocates the buffer. */
        Stream defsSaved = cg.defs;
        cg.defs = cg.protos;
        cgEmitGlobals(&cg);
        cg.protos = cg.defs;
        cg.defs = defsSaved;
    }
    cgEmitGlobalInit(&cg);
    cgEmitBodies(&cg);

    // assemble: preamble | fwd typedefs | alias/enum typedefs | registry typedefs | defs | protos | bodies
    /* Type/macro headers ONLY; no function-declaring headers (stdio,
     * stdlib, string, unistd). The generated C carries coral's own extern
     * prototypes (libc.crl / `extern` decls) and links against libc; a
     * second set of system prototypes only causes conflicting-types
     * errors (const placement, int32_t vs int, ...). assert.h stays:
     * it defines the assert() macro and declares no libc function
     * prototypes that coral also declares. */
    stP(&cg.out, "#include <stdint.h>\n#include <stddef.h>\n#include <stdbool.h>\n");
    stP(&cg.out, "#include <assert.h>\n\n");
    /* memcmp for str/struct equality: a bare prototype, not a header
       (generated C must not include system headers) */
    stP(&cg.out, "extern int memcmp(const void*, const void*, size_t);\n\n");
    /* limits.crl defines the same names: drop the stdint macros so the
       emitted constants win */
    stP(&cg.out, "#undef INT8_MIN\n#undef INT8_MAX\n#undef INT16_MIN\n#undef INT16_MAX\n");
    stP(&cg.out, "#undef INT32_MIN\n#undef INT32_MAX\n#undef INT64_MIN\n#undef INT64_MAX\n\n");
    stP(&cg.out, "typedef struct _coral_str { const uint8_t* ptr; size_t len; } _coral_str;\n");
    stP(&cg.out, "static bool _coral_streq(_coral_str a, _coral_str b) { return a.len == b.len && memcmp(a.ptr, b.ptr, a.len) == 0; }\n");
    stP(&cg.out, "static bool _coral_strtruth(_coral_str s) { return s.len > 0; }\n");
    stPS(&cg.out, Slice::from(cg.fwd.p, cg.fwd.len));
    stPS(&cg.out, Slice::from(cg.typedefs.p, cg.typedefs.len));
    stPS(&cg.out, Slice::from(cg.tdecl.p, cg.tdecl.len));
    stPS(&cg.out, Slice::from(cg.defs.p, cg.defs.len));
    stPS(&cg.out, Slice::from(cg.protos.p, cg.protos.len));
    stPS(&cg.out, Slice::from(cg.bodies.p, cg.bodies.len));

    CodegenResult result;
    result.cCode = Slice::from(cg.out.p, cg.out.len);
    result.errors = cg.errors;
    return result;
}
