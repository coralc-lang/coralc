#[[no_drop_all]]

// parser/parser.crl: cursor plumbing: advance/match/expect, node
// constructors, and the speculative save()/restore() machinery

import(lib) std::mman { dealloc, realloc };
import diag::code { ErrorCode };
import common::token { Token, TokenKind };
import lexer::lexer { Lexer };
import context::context { AstContext };
import ast {
    id { NodeId, SourceLoc, makeLoc },
    node { Node, NodeKind },
    pat { Pat, PatKind }
};
import base { Parser, ParserMark };

pub extend Parser
{
    /* lex the whole source once into the token array, then run the parse
     * purely over indices. Lexer diagnostics fire here, exactly once per
     * token, instead of re-emitting on every speculative re-lex */
    static Parser init(Lexer* lexer, AstContext* ctx, u32 fileId)
    {
        Parser p = Parser {
            .lexer = lexer,
            .ctx = ctx,
            .panicMode = 0,
            .specDepth = 0,
            .pendingGreater = false,
            .fileId = fileId,
            /* Eof sentinel: survives a token-buffer OOM so atEnd() and
             * advance() stay safe with toks == null */
            .current = Token { .kind = TokenKind::Eof },
            .previous = Token { .kind = TokenKind::Eof },
        };
        while (true)
        {
            Token t = lexer.nextToken();
            if (!p.pushTok(t)) break;
            if (t.kind == TokenKind::Eof) break;
        }
        if (p.toksLen > 0)
        {
            p.pos = 0;
            p.current = p.toks[0];
            p.previous = p.current;
        }
        return p;
    }

    bool pushTok(Token t)
    {
        if (self.toksLen >= self.toksCap)
        {
            u32 newCap = self.toksCap;
            if (newCap == 0) newCap = 1024;
            else newCap = newCap * 2;
            Token* grown = realloc<Token>(self.toks, (usize)newCap);
            if (grown == null)
            {
                self.reportAllocFailed();
                return false;
            }
            self.toks = grown;
            self.toksCap = newCap;
        }
        self.toks[self.toksLen] = t;
        self.toksLen++;
        return true;
    }

    void freeTokens()
    {
        if (self.toks != null) dealloc<Token>(self.toks);
        self.toks = null;
        self.toksLen = 0;
        self.toksCap = 0;
        self.pos = 0;
    }

    Token advance()
    {
        self.previous = self.current;
        if (self.toks != null && self.pos + 1 < self.toksLen)
        {
            self.pos++;
            self.current = self.toks[self.pos];
        }
        return self.previous;
    }

    bool match(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            self.advance();
            return true;
        }
        return false;
    }

    Token expect(TokenKind kind)
    {
        if (self.current.kind == kind)
        {
            return self.advance();
        }
        self.reportExpected(kind);
        if (self.atEnd()) return self.current;
        /* on mismatch, only consume the offending token when it can't
         * belong to an enclosing construct; swallowing a `)` or `}` here
         * would desync every level above us */
        bool closeExpected = kind == TokenKind::RParen ||
                             kind == TokenKind::RBrace ||
                             kind == TokenKind::RBracket;
        if (closeExpected || self.isRecoveryBoundary(self.current.kind))
            return self.current;
        return self.advance();
    }

    bool atEnd() { return self.current.kind == TokenKind::Eof; }
    NodeId noneNode() { return self.ctx.noneNode(); }

    SourceLoc tokenLoc(Token token)
    {
        return makeLoc(self.fileId, (u32)token.line, (u32)token.col);
    }

    NodeId storeNode(NodeKind kind)
    {
        NodeId id = self.ctx.allocNodeSlot();
        if (id.index == 0)
        {
            self.reportAllocFailed();
            return id;
        }
        Node* node = self.ctx.nodes + id.index;
        node.kind = kind;
        node.loc = self.tokenLoc(self.previous);
        return id;
    }

    /* storeNode lands on the token that closed a construct (the `)` of a
     * call); point the node at the item instead so diagnostics show the
     * callee/receiver, not end-of-line */
    void pointAt(NodeId nodeId, NodeId at)
    {
        if (nodeId.index == 0 || at.index == 0) return;
        Node* n = self.ctx.nodes + nodeId.index;
        Node* a = self.ctx.nodes + at.index;
        n.loc = a.loc;
        if (n.kind.tag == NodeKind::Expr) n.kind.payload.Expr.value.loc = a.loc;
    }

    NodeId storePat(PatKind kind)
    {
        Pat p;
        p.kind = kind;
        p.loc = self.tokenLoc(self.previous);
        return self.storeNode(NodeKind::Pat{ .value = p });
    }

    NodeId allocNode()
    {
        return self.storeNode(NodeKind::Invalid{ .flags = 0 });
    }

    /* speculative-parse bookmark. save() bumps specDepth so any diagnostic
     * from a lookahead is dropped (see recovery.crl reportError); restore()
     * rewinds both arenas. Nodes and types are discarded together because
     * a speculative parse must not leave reachable or stale entries behind:
     * duplicate primitive type entries break sema's index equality
     * (boolType() returns the FIRST Bool entry), and orphaned nodes bloat
     * later full-arena scans. */
    ParserMark save()
    {
        ParserMark m = ParserMark {
            .pos = self.pos,
            .current = self.current,
            .previous = self.previous,
            .panicMode = self.panicMode,
            .specDepth = self.specDepth,
            .pendingGreater = self.pendingGreater,
            .typesLen = self.ctx.typesLen,
            .nodesLen = self.ctx.nodesLen
        };
        self.beginSpeculation();
        return m;
    }

    void restore(ParserMark m)
    {
        /* pure index rewind: the token array already holds everything the
         * discarded parse consumed, so no byte cursors and no re-lex */
        self.pos = m.pos;
        self.current = m.current;
        self.previous = m.previous;
        self.panicMode = m.panicMode;
        self.specDepth = m.specDepth;
        self.pendingGreater = m.pendingGreater;
        self.ctx.typesLen = m.typesLen;
        self.ctx.nodesLen = m.nodesLen;
    }

    /* close one `>` of a generic list. `>>` lexes as a single Shr token, so
     * the first consumeGreater() eats the whole token and remembers that a
     * second closer is still owed; that's what pendingGreater is for.
     * parseTypeSuffix/parseBaseType check it before absorbing a `(` as a
     * fn-type suffix: `zero<E<i32, i32>>(a)` has a call there, not params */
    bool consumeGreater()
    {
        if (self.pendingGreater) {
            self.pendingGreater = false;
            return true;
        }
        
        switch (self.current.kind) {
            TokenKind::Greater => { self.advance(); return true; },
            TokenKind::Shr => {
                self.advance();
                self.pendingGreater = true;
                return true;
            },
            else => { return false; },
        }
    }
}
