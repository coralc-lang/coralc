#[[no_drop_all]]

// parser/file.crl: file-level driver, parse decls until EOF

import(lib) std::mman { alloc };
import common::token { TokenKind };
import diag::code { ErrorCode };
import context::context { AstContext, NodeListBuilder };
import ast::decl { File, Attribute };
import ast::id { Str, NodeId, SourceLoc };
import ast::node { Node, NodeKind };
import base { Parser, ParserMark };

pub extend Parser
{
    /* one File per source. prescan const ints, then parse decls under the
     * standard progress/error guard; unknown tokens and stray closers are
     * reported and eaten here because no lower level wants them. returns
     * null only when the File allocation fails. `path` is an interned Str,
     * so the File owns no string bytes */
    File* parseFile(Str path)
    {
        /* declare-all consts first (text.txt pass 1 fast variant) so
         * array sizes resolve regardless of declaration order */
        self.prescanConstInts();
        /* `#[[no_drop_all]]` at the very top attaches to the file; any
         * other leading attribute belongs to the first declaration, so
         * peek the first name before consuming the group */
        Attribute* fattrs = null;
        u32 fattrsLen = 0;
        while (self.current.kind == TokenKind::Hash && fattrsLen == 0)
        {
            ParserMark m = self.save();
            SourceLoc attrLoc = self.tokenLoc(self.current);
            self.advance();
            self.match(TokenKind::LBracket);
            self.match(TokenKind::LBracket);
            Str nm = 0;
            if (self.current.kind == TokenKind::Ident)
            {
                nm = self.ctx.intern(self.current.data.asStr());
                self.advance();
            }
            self.restore(m);
            if (nm != self.ctx.intern("no_drop_all")) break;
            self.expect(TokenKind::Hash);
            self.expect(TokenKind::LBracket);
            self.expect(TokenKind::LBracket);
            self.expect(TokenKind::Ident);
            self.expect(TokenKind::RBracket);
            self.expect(TokenKind::RBracket);
            Attribute* raw = alloc<Attribute>(1);
            if (raw == null) { self.reportAllocFailed(); break; }
            raw[0] = Attribute{ .name = nm, .args = null, .argsLen = 0, .loc = attrLoc };
            fattrs = raw;
            fattrsLen = 1;
        }
        NodeListBuilder decls;
        self.ctx.nodeListInit(&decls);
        while (!self.atEnd())
        {
            // Unknown token (stray byte). nothing has reported it (the
            // lexer's unknown-char diag is dead), so just get past it
             if (self.current.kind == TokenKind::Unknown)
            {
                self.advance();
                continue;
            }
            // stray closer at top level: report and eat it, nobody else will
             if (self.current.kind == TokenKind::RBrace || self.current.kind == TokenKind::RParen ||
                 self.current.kind == TokenKind::RBracket)
            {
                self.reportCurrentError(ErrorCode::ParseUnexpectedClosingToken, "unexpected closing token");
                self.advance();
                continue;
            }

            u32 errorsBefore = self.errorCount();
            u8* cursorBefore = self.lexer.getCur();
            Token tokenBefore = self.current;
            NodeId decl = self.parseDecl();
            if (!self.ctx.nodeListAppend(&decls, decl)) self.reportAllocFailed();

            /* if parseDecl returned without moving the cursor, force it;
             * otherwise a decl that reports an error before consuming
             * anything spins this loop forever */
            bool progressed = self.lexer.getCur() != cursorBefore ||
                              self.current.kind != tokenBefore.kind ||
                              self.current.data.ptr != tokenBefore.data.ptr;
            if (!progressed && !self.atEnd()) self.advance();
            /* P0012 only flags an attribute name; the decl itself parsed,
             * so a resync here would skip the next decl's attributes */
            if (self.errorCount() > errorsBefore && !self.attrNameError) self.synchronize();
            self.attrNameError = false;
        }
        u32 count = decls.len;
        NodeId* values = self.ctx.nodeListFinish(&decls);
        /* file-level attrs ride on every top-level decl: merged lib files
         * concatenate decls into one File, so File.attrs alone would lose
         * them (sema reads attrs off the function decl) */
        if (fattrsLen > 0 && values != null)
        {
            u32 vi = 0;
            while (vi < count)
            {
                Node* dn = self.ctx.nodes + values[vi].index;
                if (dn->kind.tag == NodeKind::Decl)
                {
                    u32 oldLen = dn->kind.payload.Decl.value.attrsLen;
                    if (oldLen == 0)
                    {
                        dn->kind.payload.Decl.value.attrs = fattrs;
                        dn->kind.payload.Decl.value.attrsLen = fattrsLen;
                    }
                    else
                    {
                        Attribute* merged = alloc<Attribute>((usize)(oldLen + fattrsLen));
                        if (merged != null)
                        {
                            u32 mi = 0;
                            while (mi < oldLen) { merged[mi] = dn->kind.payload.Decl.value.attrs[mi]; mi++; }
                            u32 fi = 0;
                            while (fi < fattrsLen) { merged[oldLen + fi] = fattrs[fi]; fi++; }
                            dn->kind.payload.Decl.value.attrs = merged;
                            dn->kind.payload.Decl.value.attrsLen = oldLen + fattrsLen;
                        }
                    }
                }
                vi++;
            }
        }
        File* file = self.ctx.allocFile();
        if (file == null)
        {
            self.reportAllocFailed();
            self.freeConstTable();
            return null;
        }
        file->path = path;
        file->decls = values;
        file->declsLen = count;
        file->attrs = fattrs;
        file->attrsLen = fattrsLen;
        // per-file scratch, must not outlive the parse
        self.freeConstTable();
        return file;
    }
}
