#[[no_drop_all]]

// parser/pattern.crl: switch patterns
//
// raw tokens to Pat nodes: idents, `T::V {}` / `V {}` variants, struct
// shapes, tuples, literals, `any <trait>`. type-prefix forms (`const T*`,
// `T*`) are captured as source text into a scratch buffer, interned, and
// the buffer freed; no structured type ever comes out of those branches.

import(lib) std::mman { alloc, dealloc };
import common::token { Token, TokenKind };
import diag::code { ErrorCode };
import context::context { AstContext, NodeListBuilder, StrListBuilder };
import ast::id { NodeId, Str };
import ast::pat { Pat, PatKind };
import ast::node { Node, NodeKind };
import base { Parser };

pub extend Parser
{
    // leading `|` opens an or-group (`| A | B`); the `A | B` delimiter
    // form is folded by the case parsers, each `|` must be followed by one
    NodeId parseSwitchPattern()
    {
        TokenKind k = self.current.kind;
        if (k == TokenKind::Pipe)
        {
            NodeListBuilder alternatives;
            self.ctx.nodeListInit(&alternatives);
            while (self.match(TokenKind::Pipe))
            {
                NodeId pat = self.parseSwitchPattern();
                if (!self.ctx.nodeListAppend(&alternatives, pat)) self.reportAllocFailed();
            }
            u32 count = alternatives.len;
            NodeId* values = self.ctx.nodeListFinish(&alternatives);
            return self.storePat(PatKind::Or{ .alternatives = values, .alternativesLen = count });
        }
        if (k == TokenKind::Any)
        {
            self.advance(); // any
            Token tTok = self.expect(TokenKind::Ident);
            Str tn = self.ctx.intern(tTok.data.asStr());
            /* stored as a nominal pattern naming `any <trait>`; semantic
             * refinement plus codegen-on-AnyTrait is a later todo */
            return self.storePat(PatKind::Ident{ .name = tn });
        }
        if (k == TokenKind::Const)
        {
            /* `const T*` style pattern-name: read a type prefix and turn it
             * into a nominal pattern storing its source text (the pattern
             * selector in control flow will be this text). */
            u8* buf = alloc<u8>(256);
            usize bpos = 0;
            // current is TokenKind::Const
            while (true)
            {
                TokenKind kk = self.current.kind;
                bool takes = false;
                if (kk == TokenKind::Ident || kk == TokenKind::Void || kk == TokenKind::Bool ||
                    kk == TokenKind::Char || kk == TokenKind::U8 || kk == TokenKind::I8 ||
                    kk == TokenKind::U16 || kk == TokenKind::I16 || kk == TokenKind::U32 ||
                    kk == TokenKind::I32 || kk == TokenKind::U64 || kk == TokenKind::I64 ||
                    kk == TokenKind::U128 || kk == TokenKind::I128 || kk == TokenKind::F32 ||
                    kk == TokenKind::F64 || kk == TokenKind::Usize || kk == TokenKind::Isize ||
                    kk == TokenKind::Rawptr || kk == TokenKind::Str || kk == TokenKind::Const ||
                    kk == TokenKind::Star || kk == TokenKind::Ampersand || kk == TokenKind::LParen ||
                    kk == TokenKind::RParen || kk == TokenKind::LBracket || kk == TokenKind::RBracket ||
                    kk == TokenKind::Less || kk == TokenKind::Greater || kk == TokenKind::ColonColon)
                {
                    takes = true;
                }
                if (!takes) break;
                Token tk2 = self.advance();
                if (bpos > 0 && bpos + tk2.data.len < 255)
                {
                    // separate two alphanums with a space, the rest flush
                    if (tk2.kind != TokenKind::Star && tk2.kind != TokenKind::RParen) buf[bpos++] = ' ';
                }
                if (bpos + tk2.data.len < 255)
                {
                    usize qq2 = 0;
                    while (qq2 < tk2.data.len) buf[bpos++] = tk2.data.ptr[qq2++];
                }
            }
            buf[bpos] = 0;
            Str nameStr = self.ctx.intern(str { .ptr = buf, .len = bpos });
            dealloc<u8>(buf); // was buf previousle deallocated? let me not casue a bug
            return self.storePat(PatKind::Ident{ .name = nameStr });
        }
        if (k == TokenKind::Ident ||
            k == TokenKind::Void || k == TokenKind::Bool || k == TokenKind::Char ||
            k == TokenKind::U8 || k == TokenKind::I8 || k == TokenKind::U16 || k == TokenKind::I16 ||
            k == TokenKind::U32 || k == TokenKind::I32 || k == TokenKind::U64 || k == TokenKind::I64 ||
            k == TokenKind::U128 || k == TokenKind::I128 || k == TokenKind::F32 || k == TokenKind::F64 ||
            k == TokenKind::Usize || k == TokenKind::Isize || k == TokenKind::Rawptr || k == TokenKind::Str)
        {
            Token first = self.advance();
            Str firstName = self.ctx.intern(first.data.asStr());
            /* a name immediately MASTERed by pointer/ref/array or
             * generic markers again denotes a type-prefix pattern: 'T*',
             * 'const*', 'T<T>', '...' collect text up to this branch
             * separator and match as a nominal pattern */
            if (self.current.kind == TokenKind::Star || self.current.kind == TokenKind::Ampersand ||
                self.current.kind == TokenKind::LBracket || self.current.kind == TokenKind::Less)
            {
                u8* buf = alloc<u8>(256);
                usize ppos = 0;
                // prefix with firstName words
                usize i0 = 0;
                while (i0 < first.data.len) buf[ppos++] = first.data.ptr[i0++];
                while (true)
                {
                    TokenKind kk = self.current.kind;
                    bool take =  (kk == TokenKind::Ident || kk == TokenKind::Void || kk == TokenKind::Bool ||
                        kk == TokenKind::Char || kk == TokenKind::U8 || kk == TokenKind::I8 ||
                        kk == TokenKind::U16 || kk == TokenKind::I16 || kk == TokenKind::U32 ||
                        kk == TokenKind::I32 || kk == TokenKind::U64 || kk == TokenKind::I64 ||
                        kk == TokenKind::U128 || kk == TokenKind::I128 || kk == TokenKind::F32 ||
                        kk == TokenKind::F64 || kk == TokenKind::Usize || kk == TokenKind::Isize ||
                        kk == TokenKind::Rawptr || kk == TokenKind::Str || kk == TokenKind::Const ||
                        kk == TokenKind::Star || kk == TokenKind::Ampersand || kk == TokenKind::LParen ||
                        kk == TokenKind::RParen || kk == TokenKind::LBracket || kk == TokenKind::RBracket ||
                        kk == TokenKind::Less || kk == TokenKind::Greater || kk == TokenKind::Comma ||
                        kk == TokenKind::ColonColon);
                    if (!take) break;
                    Token tk2 = self.advance();
                    if (ppos > 0 && tk2.kind != TokenKind::Star && tk2.kind !=
                        TokenKind::RParen && tk2.kind != TokenKind::RBracket && tk2.kind != TokenKind::Greater && tk2.kind != TokenKind::Comma)
                        buf[ppos++] = ' ';
                    usize j0 = 0;
                    while (j0 < tk2.data.len) buf[ppos++] = tk2.data.ptr[j0++];
                }
                buf[ppos] = 0;
                Str nameStr = self.ctx.intern(str { .ptr = buf, .len = ppos });
                dealloc<u8>(buf); // was buf previousle deallocated? let me not casue a bug
                return self.storePat(PatKind::Ident{ .name = nameStr });
            }

            if (self.match(TokenKind::ColonColon))
            {
                Token second = self.expect(TokenKind::Ident);
                Str secondName = self.ctx.intern(second.data.asStr());
                // `T::V { .a, .b }`: named fields are optional
                if (self.current.kind == TokenKind::LBrace)
                {
                    self.advance();
                    StrListBuilder fields;
                    self.ctx.strListInit(&fields);
                    while (self.current.kind != TokenKind::RBrace && !self.atEnd())
                    {
                        self.match(TokenKind::Dot);
                        Token field = self.expect(TokenKind::Ident);
                        Str fieldName = self.ctx.intern(field.data.asStr());
                        if (!self.ctx.strListAppend(&fields, fieldName)) self.reportAllocFailed();
                        if (!self.match(TokenKind::Comma)) break;
                    }
                    self.expect(TokenKind::RBrace);
                    u32 count = fields.len;
                    Str* names = self.ctx.strListFinish(&fields);
                    return self.storePat(PatKind::Variant{ .typeName = firstName, .variantName = secondName, .fieldNames = names, .fieldNamesLen = count });
                }
                return self.storePat(PatKind::Variant{ .typeName = firstName, .variantName = secondName, .fieldNames = null, .fieldNamesLen = 0 });
            }
            if (self.current.kind == TokenKind::LBrace)
            {
                self.advance();
                StrListBuilder fields;
                self.ctx.strListInit(&fields);
                while (self.current.kind != TokenKind::RBrace && !self.atEnd())
                {
                    self.match(TokenKind::Dot);
                    Token field = self.expect(TokenKind::Ident);
                    Str fieldName = self.ctx.intern(field.data.asStr());
                    if (!self.ctx.strListAppend(&fields, fieldName)) self.reportAllocFailed();
                    if (!self.match(TokenKind::Comma)) break;
                }
                self.expect(TokenKind::RBrace);
                u32 count = fields.len;
                Str* names = self.ctx.strListFinish(&fields);
                // capitalization heuristic: `V { }` names a variant case,
                // `v { }` names a struct. no stronger signal exists here
                if (first.data.ptr[0] >= 'A' && first.data.ptr[0] <= 'Z')
                    return self.storePat(PatKind::Variant{ .typeName = 0, .variantName = firstName, .fieldNames = names, .fieldNamesLen = count });
                return self.storePat(PatKind::Struct{ .name = firstName, .fieldNames = names, .fieldNamesLen = count });
            }
            return self.storePat(PatKind::Ident{ .name = firstName });
        }
        if (k == TokenKind::LParen)
        {
            self.advance();
            NodeListBuilder elems;
            self.ctx.nodeListInit(&elems);
            while (self.current.kind != TokenKind::RParen && !self.atEnd())
            {
                NodeId pat = self.parseSwitchPattern();
                if (!self.ctx.nodeListAppend(&elems, pat)) self.reportAllocFailed();
                if (!self.match(TokenKind::Comma)) break;
            }
            self.expect(TokenKind::RParen);
            /* nodeListFinish resets the builder's len; capture the count
             * BEFORE finishing (reading elems.len after always stored 0,
             * so every parenthesized pattern like `(any toStr)` was an
             * empty tuple that could never match) */
            u32 count = elems.len;
            NodeId* values = self.ctx.nodeListFinish(&elems);
            return self.storePat(PatKind::Tuple{ .elems = values, .elemsLen = count });
        }
        if (k == TokenKind::Dec || k == TokenKind::Hex || k == TokenKind::Bin ||
            k == TokenKind::Oct || k == TokenKind::Float || k == TokenKind::String ||
            k == TokenKind::CString || k == TokenKind::CharLit || k == TokenKind::True ||
            k == TokenKind::False || k == TokenKind::Null)
        {
            // minPrec 5: `1 + 2` or `x <= y` fold into the literal, but a
            // following `|` (bit-or, prec 4) stays a pattern separator
            NodeId expr = self.parseBinaryExpr(5);
            return self.storePat(PatKind::Lit{ .expr = expr });
        }
        // at a closer, hand back the none-node and let the caller report;
        // at anything else eat one token so the case loop keeps moving
        if (self.isRecoveryBoundary(self.current.kind))
        {
            self.reportExpectedWith(ErrorCode::ParseExpectedSwitchPattern, "expected a switch pattern");
            return self.noneNode();
        }
        self.reportExpectedWith(ErrorCode::ParseExpectedSwitchPattern, "expected a switch pattern");
        self.advance();
        return self.noneNode();
    }

    // expect(Ident), but keyword-shaped names pass too: fields, methods,
    // parameters and import symbols may collide with keywords (`str`,
    // `import::return`, …). the lexer marks every reserved word, so this
    // stays correct as the keyword table grows.
    Token expectName()
    {
        if (self.current.kind == TokenKind::Ident ||
            (self.current.info != null && self.current.info.isKeyword))
        {
            return self.advance();
        }
        return self.expect(TokenKind::Ident);
    }

    // recovery hint used by recovery.crl's synchronize(): a fresh-line token
    // from this set probably starts the next decl, so stop skipping there
    bool isDeclarationStart()
    {
        TokenKind kind = self.current.kind;
        switch (kind)
        {
            TokenKind::Pub | TokenKind::Extern | TokenKind::Static | TokenKind::Struct |
            TokenKind::Enum | TokenKind::Variant | TokenKind::Union | TokenKind::Trait |
            TokenKind::Extend | TokenKind::Const | TokenKind::Typedef | TokenKind::Distinct |
            TokenKind::Flag | TokenKind::Import | TokenKind::Mod | TokenKind::Comptime |
            TokenKind::Void | TokenKind::Bool | TokenKind::Char | TokenKind::U8 |
            TokenKind::I8 | TokenKind::U16 | TokenKind::I16 | TokenKind::U32 |
            TokenKind::I32 | TokenKind::U64 | TokenKind::I64 | TokenKind::U128  |
            TokenKind::I128 | TokenKind::F32 | TokenKind::F64 | TokenKind::Usize |
            TokenKind::Isize | TokenKind::Rawptr | TokenKind::Str | TokenKind::Ident |
            TokenKind::LParen => { return true; },
            else => { return false; },
        }
    }
}
