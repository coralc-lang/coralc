#[[no_drop_all]]
// parser/base.crl: parser state and token stream

import common::token { Token, TokenKind };
import lexer::lexer { Lexer };
import context::context { AstContext };
import ast::id { NodeId, Str };

pub struct ParserMark
{
    /* index of self.current in the token array: restore() is a pure
     * rewind of the index, no re-lex */
    u32 pos;
    Token current;
    Token previous;
    u32 panicMode;
    u32 specDepth;
    bool pendingGreater;
    /* type-table length at save(): restore() rewinds it so a speculative
     * parseType() does not leave orphaned entries behind; orphan Bool/Int
     * entries before the real ones broke index equality with the sema
     * type helpers (boolType() returns the FIRST Bool entry). */
    u32 typesLen;
    /* node-arena length at save(): restore() rewinds it too, so nodes
     * allocated by a discarded speculative parse are reclaimed rather
     * than accumulating as unreachable AST entries. */
    u32 nodesLen;
}

pub struct Parser
{
    Lexer* lexer;
    AstContext* ctx;
    /* whole-file token array, lexed once by init; the parser consumes it
     * by index so save()/restore() never re-lex (F4/F5). `pos` indexes
     * `current`. Freed by parseFile via freeTokens */
    Token* toks;
    u32 toksLen;
    u32 toksCap;
    u32 pos;
    Token current;
    // last consumed token; every node/store helper stamps its loc
    Token previous;
    /* error count in the low 30 bits, 0x40000000 = recovery in progress
     * (addError/beginRecovery in recovery.crl). packed into one word so
     * save()/restore() rewinds it together with the cursors */
    u32 panicMode;
    /* nested-speculation depth: save() pushes, restore()/endSpeculation()
     * pop. A single flag cannot survive an inner save()/endSpeculation()
     * pair inside an outer speculative parse (e.g. generic-arg parsing
     * inside a declaration lookahead), which let diagnostics from a
     * discarded parse escape. */
    u32 specDepth;
    bool pendingGreater;
    /* set when the last error was P0012 (unknown attribute name). Those
     * are non-structural: the declaration parsed fine, so parseFile must
     * not resynchronize (the skip would eat the next declaration's
     * attribute lines). Cleared by the next ordinary reportError */
    bool attrNameError;
    /* #[[condassign]] allows `=` at the top level of the next
     * if/while/for/switch condition */
    bool condAssignAttr;
    /* position of the most recent assignment operator, for
     * ParseCondAssign diagnostics */
    usize lastAssignLine;
    usize lastAssignCol;
    /* generic params of the innermost enclosing container
     * (struct/union/trait/variant/extend); method signatures parsed
     * inside it rebind their type parameters against these in addition
     * to their own <...> */
    NodeId* outerGenerics;
    u32 outerGenericsLen;
    // source file this parser is lexing; packed into every SourceLoc
    u32 fileId;
    /* same-file `const T NAME = <int literal>` table, prescanned before
     * parsing; declarator array sizes (`u8 buf[N]`) resolve N through it
     * no matter where the const sits in the file. Per-parser (per-file) so
     * equal names elsewhere do not collide; cross-file consts are not in
     * here. Freed by freeConstTable at the end of parseFile. */
    Str* constNames;
    u64* constValues;
    u32 constLen;
    u32 constCap;
}