#[[no_drop_all]]
/* typecheck.crl: type identity and compatibility: sameType (structural),
 * compatible (assignment leniency), substituteFieldTy (generic object →
 * field type), and the singleton getters for primitive types. the dump of
 * `compatible` rules at the bottom is the one that decides what compiles. */
import ast::id { Str, NodeId };
import ast::types { Ty, TypeEntry, TypeKind };
import ast::node { Node, NodeKind };
import ast::expr { Expr };
import ast::decl { Decl, DeclKind, GenericParam, Param };
import scope { Symbol };
import sema { Sema };
import diag::code { ErrorCode };
import(lib) std::mman { alloc, dealloc };

pub extend Sema
{
    // primitive type singletons

    /* synthesize a type-table slot. the local is ceremony; the loc reset is
     * the point: a synthesized type has no source site, so lookupType falls
     * back to plain scope lookup instead of file-preferred resolution. */
    Ty allocType(TypeKind kind)
    {
        Ty id = self.ctx.allocTypeSlot();
        if (id == 0) {
            self.semaErrorNode(ErrorCode::SemaInternal, self.ctx.noneNode(), "allocTypeSlot failed (type table full)");
            return 0;
        }
        TypeEntry* entry = self.ctx.types + id;
        entry->kind = kind;
        entry->loc.data = 0;
        return id;
    }

    /* one singleton per primitive: a linear scan of the type table on every
     * call. the table only grows and slots are never removed, so the first
     * hit is stable; yes, it's O(types) each time, no caching. */
    Ty boolType()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::Bool) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::Bool;
        return self.allocType(kind);
    }

    Ty u32Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::U32) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::U32;
        return self.allocType(kind);
    }

    Ty u8Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::U8) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::U8;
        return self.allocType(kind);
    }

    Ty u16Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::U16) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::U16;
        return self.allocType(kind);
    }

    Ty u64Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::U64) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::U64;
        return self.allocType(kind);
    }

    Ty rawptrType()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::Rawptr) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::Rawptr;
        return self.allocType(kind);
    }

    Ty usizeType()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::Usize) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::Usize;
        return self.allocType(kind);
    }

    /* str.ptr: const u8* (immutable *byte* view into the literal/storage;
     * str is a byte string, `char` is utf32 and never a byte) */
    Ty strPtrType()
    {
        Ty b = self.u8Type();
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* e = self.ctx.types + i;
            if (e->kind.tag == TypeKind::Pointer && e->kind.payload.Pointer.base == b) return i;
            i++;
        }
        TypeKind inner = TypeKind::Const{ .base = b };
        Ty cst = self.allocType(inner);
        TypeKind kind = TypeKind::Pointer{ .base = cst };
        return self.allocType(kind);
    }

    /* slice.ptr: T* into the slice's storage (mutable — unlike str's
     * const byte view, a T[] may alias writable data) */
    Ty slicePtrType(Ty base)
    {
        if (base == 0) return 0;
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* e = self.ctx.types + i;
            if (e->kind.tag == TypeKind::Pointer && e->kind.payload.Pointer.base == base) return i;
            i++;
        }
        TypeKind kind = TypeKind::Pointer{ .base = base };
        return self.allocType(kind);
    }

    /* C"..." → const cchar*, NUL-terminated C-ABI byte string, matching
     * libc's `const cchar*` params (printf/snprintf/...). Built by name so
     * the literal type-checks against those params without the calling
     * file importing cchar itself; sameType compares Named by name. */
    Ty ccharPtrType()
    {
        Str cn = self.ctx.intern("cchar");
        Ty named = 0;
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* e = self.ctx.types + i;
            if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.name == cn &&
                e->kind.payload.Named.genericArgsLen == 0) { named = i; break; }
            i++;
        }
        if (named == 0) {
            TypeKind nk;
            nk = TypeKind::Named{ .name = cn, .genericArgs = null, .genericArgsLen = 0 };
            named = self.allocType(nk);
        }
        /* Const{Pointer{Named}}: the shape `const cchar*` params parse to
         * (type-position const wraps the whole type) and, via compatible()'s
         * source-const strip, also assignable to statement-const locals
         * (`const cchar* s` = bare Pointer + const flag) */
        TypeKind pk;
        pk = TypeKind::Pointer{ .base = named };
        Ty ptr = self.allocType(pk);
        TypeKind ck;
        ck = TypeKind::Const{ .base = ptr };
        return self.allocType(ck);
    }

    Ty i32Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::I32) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::I32;
        return self.allocType(kind);
    }

    Ty i64Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::I64) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::I64;
        return self.allocType(kind);
    }

    Ty f32Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::F32) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::F32;
        return self.allocType(kind);
    }

    Ty f64Type()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::F64) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::F64;
        return self.allocType(kind);
    }

    Ty charType()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::Char) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::Char;
        return self.allocType(kind);
    }

    Ty strType()
    {
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            if (self.ctx.types[i].kind.tag == TypeKind::Str) return i;
            i++;
        }
        TypeKind kind;
        kind.tag = TypeKind::Str;
        return self.allocType(kind);
    }

    Ty selfNamedType(Str name, NodeId* genericParams, u32 genericParamsLen)
    {
        if (genericParamsLen == 0) return self.namedType(name);
        TypeKind kind;
        Ty* args = null;
        if (genericParamsLen > 0) args = alloc<Ty>((usize)genericParamsLen);
        u32 i = 0;
        while (i < genericParamsLen)
        {
            Node* gn = self.ctx.nodes + genericParams[i].index;
            Str pname = 0;
            if (gn->kind.tag == NodeKind::GenericParam) pname = gn->kind.payload.GenericParam.value.name;
            args[i] = self.typeParamType(pname, i);
            i++;
        }
        kind = TypeKind::Named { .name = name, .genericArgs = args, .genericArgsLen = genericParamsLen };
        return self.allocType(kind);
    }

    /* dedup is by bare name: the first Named entry with this name wins even
     * if it carries generic args; callers that want Vec<i32> build the args
     * themselves (selfNamedType / the parser). */
    Ty namedType(Str name)
    {
        /* `str` is a builtin; `str::…` static calls route here via the
         * type-static arm of checkCall, so it must map to the singleton */
        if (name == self.ctx.intern("str")) return self.strType();
        u32 i = 1;
        while (i < self.ctx.typesLen) {
            TypeEntry* entry = self.ctx.types + i;
            if (entry->kind.tag == TypeKind::Named && entry->kind.payload.Named.name == name)
                return i;
            i++;
        }
        TypeKind kind = TypeKind::Named { .name = name, .genericArgs = null, .genericArgsLen = 0 };
        return self.allocType(kind);
    }

    // index = the param's position in the generic list; substitution uses it
    // to find which generic arg replaces this `T`
    Ty typeParamType(Str name, u32 index)
    {
        TypeKind kind = TypeKind::TypeParam { .name = name, .index = index };
        return self.allocType(kind);
    }

    void setExprType(NodeId id, Ty typeNode)
    {
        if (id.index == 0) return;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag == NodeKind::Expr)
            node->kind.payload.Expr.value.resolvedType = typeNode;
    }

    Ty exprType(NodeId id)
    {
        if (id.index == 0) return 0;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Expr) return 0;
        return node->kind.payload.Expr.value.resolvedType;
    }

    /* structural equality. tag must match, then shape: Named compares names
     * and args, pointers/const/slice/etc recurse. primitive tags fall into
     * the else and are equal by tag alone. */
    bool sameType(Ty left, Ty right)
    {
        if (left == right) return true;
        if (left == 0 || right == 0) return false;
        TypeEntry* a = self.ctx.types + left;
        TypeEntry* b = self.ctx.types + right;
        /* During generic checking a type param may appear on one side and its
         * unparameterised Named placeholder (pre-binding parse form) on the
         * other; they denote the same type when the names match. */
        if (a->kind.tag == TypeKind::TypeParam && b->kind.tag == TypeKind::Named && b->kind.payload.Named.genericArgsLen == 0 &&
            a->kind.payload.TypeParam.name == b->kind.payload.Named.name) return true;
        if (b->kind.tag == TypeKind::TypeParam && a->kind.tag == TypeKind::Named && a->kind.payload.Named.genericArgsLen == 0 &&
            b->kind.payload.TypeParam.name == a->kind.payload.Named.name) return true;
        if (a->kind.tag != b->kind.tag) return false;
        switch (a->kind.tag)
        {
            TypeKind::Named => {
                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;
                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Named.genericArgsLen)
                {
                    if (!self.sameType(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::Pointer => { return self.sameType(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.sameType(a->kind.payload.Const.base, b->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.sameType(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.sameType(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },

            TypeKind::Array => {
                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;
                if (a->kind.payload.Array.sizeParam != b->kind.payload.Array.sizeParam) return false;
                if (a->kind.payload.Array.sizeName != b->kind.payload.Array.sizeName) return false;
                return self.sameType(a->kind.payload.Array.base, b->kind.payload.Array.base);
            },
            
            TypeKind::FnPtr => {
                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;
                if (!self.sameType(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < a->kind.payload.FnPtr.paramsLen) {
                    if (!self.sameType(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },

            TypeKind::Tuple => {
                if (a->kind.payload.Tuple.elemsLen != b->kind.payload.Tuple.elemsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Tuple.elemsLen) {
                    if (!self.sameType(a->kind.payload.Tuple.elems[i], b->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::TypeParam => { return a->kind.payload.TypeParam.name == b->kind.payload.TypeParam.name; },
            /* comptime value args are equal only when the values match:
             * `Arr<i32, 4>` and `Arr<i32, 9>` are different instances */
            TypeKind::ValueInt => { return a->kind.payload.ValueInt.value == b->kind.payload.ValueInt.value; },
            else => { return true; }
        }
    }

    /* typedefs (Str = u32, Ty = u32, ...) are transparent for scalar
     * compatibility; they lower to their C base types */
    Ty resolveScalarAlias(Ty t)
    {
        u32 guard = 0; // alias cycles (A = B; B = A) must not spin forever
        while (t != 0 && guard < 32)
        {
            guard++;
            TypeEntry* entry = self.ctx.types + t;
            if (entry->kind.tag == TypeKind::Const || entry->kind.tag == TypeKind::Comptime)
            {
                if (entry->kind.tag == TypeKind::Const) t = entry->kind.payload.Const.base;
                else t = entry->kind.payload.Comptime.base;
                continue;
            }
            if (entry->kind.tag != TypeKind::Named) return t;
            if (entry->kind.payload.Named.genericArgsLen != 0) return t;
            Symbol* symbol = self.lookupType(entry->kind.payload.Named.name, entry->loc);
            if (symbol == null || symbol->declaration.index == 0) return t;
            Node* declNode = self.ctx.nodes + symbol->declaration.index;
            if (declNode->kind.tag != NodeKind::Decl) return t;
            Decl* decl = &declNode->kind.payload.Decl.value;
            if (decl->kind.tag == DeclKind::TypeAlias)
            {
                if (decl->kind.payload.TypeAlias.target == 0) return t;
                t = decl->kind.payload.TypeAlias.target;
                continue;
            }
            if (decl->kind.tag == DeclKind::Distinct)
            {
                if (decl->kind.payload.Distinct.baseType == 0) return t;
                t = decl->kind.payload.Distinct.baseType;
                continue;
            }
            return t;
        }
        return t;
    }

    u32 intWidth(Ty t)
    {
        if (t == 0) return 0;
        t = self.resolveScalarAlias(t);
        TypeEntry* entry = self.ctx.types + t;
        switch (entry->kind.tag)
        {
            TypeKind::U8, TypeKind::I8 => { return 8; },
            /* char is a UTF-32 codepoint (u32 width), never a byte;
             * bytes are u8/cchar */
            TypeKind::Char => { return 32; },
            TypeKind::U16, TypeKind::I16 => { return 16; },
            TypeKind::U32, TypeKind::I32 => { return 32; },
            TypeKind::U64, TypeKind::I64, TypeKind::Usize, TypeKind::Isize => { return 64; },
            TypeKind::U128, TypeKind::I128 => { return 128; },
            else => { return 0; },
        }
    }

    bool intSigned(Ty t)
    {
        if (t == 0) return false;
        t = self.resolveScalarAlias(t);
        TypeEntry* entry = self.ctx.types + t;
        switch (entry->kind.tag)
        {
            TypeKind::I8, TypeKind::I16, TypeKind::I32, TypeKind::I64, TypeKind::Isize, TypeKind::I128 => { return true; },
            else => { return false; },
        }
    }

    /* T0010: a literal being stored into a narrower integer type must fit
     * (u8 x = 300 is an error even though the generic-literal rules widen
     * it for arithmetic). Only the plainly-written shapes are checked:
     * `N` and `-N`. */
    void checkIntLitFit(NodeId initId, Ty declared)
    {
        if (initId.index == 0 || declared == 0) return;
        u32 w = self.intWidth(declared);
        if (w == 0 || w >= 64) return;
        bool signed = self.intSigned(declared);
        Node* n = self.ctx.nodes + initId.index;
        if (n->kind.tag != NodeKind::Expr) return;
        Expr* e = &n->kind.payload.Expr.value;
        u64 mag = 0;
        bool neg = false;
        if (e->kind.tag == ExprKind::IntLit) mag = e->kind.payload.IntLit.value;
        else if (e->kind.tag == ExprKind::Neg)
        {
            neg = true;
            NodeId inner = e->kind.payload.Neg.expr;
            if (inner.index == 0) return;
            Node* in = self.ctx.nodes + inner.index;
            if (in->kind.tag != NodeKind::Expr) return;
            Expr* ie = &in->kind.payload.Expr.value;
            if (ie->kind.tag != ExprKind::IntLit) return;
            mag = ie->kind.payload.IntLit.value;
        }
        else return;
        bool overflow = false;
        if (!signed)
        {
            if (neg) overflow = true;
            else if (mag >= (((u64)1) << (u64)w)) overflow = true;
        }
        else
        {
            u64 limit = ((u64)1) << (u64)(w - 1);
            if (neg) { if (mag > limit) overflow = true; }
            else { if (mag >= limit) overflow = true; }
        }
        if (!overflow) return;
        String msg = String::new();
        if (neg) msg.pushView("integer literal '-");
        else msg.pushView("integer literal '");
        self.pushDec(&msg, mag);
        msg.pushView("' does not fit in the declared integer type");
        self.semaErrorNode(ErrorCode::SemaLiteralOverflow, initId, msg.asView());
    }

    bool integerType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        typeNode = self.resolveScalarAlias(typeNode);
        TypeEntry* entry = self.ctx.types + typeNode;
        if (entry->kind.tag == TypeKind::U8 || entry->kind.tag == TypeKind::U16 || entry->kind.tag == TypeKind::U32 || entry->kind.tag == TypeKind::U64 || entry->kind.tag == TypeKind::U128 || entry->kind.tag == TypeKind::I8 || entry->kind.tag == TypeKind::I16 || entry->kind.tag == TypeKind::I32 || entry->kind.tag == TypeKind::I64 || entry->kind.tag == TypeKind::I128 || entry->kind.tag == TypeKind::Usize || entry->kind.tag == TypeKind::Isize || entry->kind.tag == TypeKind::Char) return true;
        /* `cchar` is the C ABI byte type (Named); it participates in integer
         * expressions (`*endptr != 0`) the way u8/i8 do */
        if (entry->kind.tag == TypeKind::Named && entry->kind.payload.Named.genericArgsLen == 0 &&
            entry->kind.payload.Named.name == self.ctx.intern("cchar")) return true;
        /* a generic parameter used in value position is a comptime integer
         * (`Arr<T, N>`: `self.data[N - 1]`, `return N`); pure type params
         * never reach value position in valid code */
        if (entry->kind.tag == TypeKind::TypeParam) return true;
        return false;
    }

    bool floatType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        typeNode = self.resolveScalarAlias(typeNode);
        TypeEntry* entry = self.ctx.types + typeNode;
        return entry->kind.tag == TypeKind::F32 || entry->kind.tag == TypeKind::F64;
    }

    u32 genericCount(NodeId id)
    {
        if (id.index == 0) return 0;
        Node* node = self.ctx.nodes + id.index;
        if (node->kind.tag != NodeKind::Decl) return 0;
        Decl* decl = &node->kind.payload.Decl.value;
        switch (decl->kind.tag)
        {
            DeclKind::Func => { return decl->kind.payload.Func.genericParamsLen; },
            DeclKind::Struct => { return decl->kind.payload.Struct.genericParamsLen; },
            DeclKind::Variant => { return decl->kind.payload.Variant.genericParamsLen; },
            DeclKind::Union => { return decl->kind.payload.Union.genericParamsLen; },
            DeclKind::Trait => { return decl->kind.payload.Trait.genericParamsLen; },
            DeclKind::Extend => { return decl->kind.payload.Extend.genericParamsLen; },
            DeclKind::ExtendTrait => { return decl->kind.payload.ExtendTrait.genericParamsLen; },
            else => { return 0; }
        }
    }

    bool checkType(Ty typeNode)
    {
        if (typeNode == 0) return true;
        TypeEntry* entry = self.ctx.types + typeNode;
        switch (entry->kind.tag)
        {
            TypeKind::Named => {
                Str tn = entry->kind.payload.Named.name;
                Symbol* symbol = self.lookupType(tn, entry->loc);
                if (symbol == null) {
                    self.semaError(ErrorCode::SemaUndeclaredIdent, entry->loc, self.nameMsg("unknown type name: ", tn));
                    return false;
                }
                u32 want = entry->kind.payload.Named.genericArgsLen;
                u32 expected = self.genericCount(symbol->declaration);
                if (expected != want)
                {
                    /* merged files may declare the same name (libc's extern
                     * realloc vs mman's realloc<T>); prefer a decl whose
                     * generic arity matches the explicit arguments */
                    Symbol** cands = alloc<Symbol*>(16);
                    if (cands != null)
                    {
                        u32 n = self.scopes.lookupAll(tn, cands, 16);
                        u32 a = 0;
                        while (a < n)
                        {
                            if (self.genericCount(cands[a]->declaration) == want)
                            {
                                symbol = cands[a];
                                break;
                            }
                            a++;
                        }
                        dealloc<Symbol*>(cands);
                    }
                    expected = self.genericCount(symbol->declaration);
                }
                if (expected != want) {
                    String msg = String::new();
                    msg.pushView("type '");
                    msg.pushView(self.nameTextView(tn));
                    msg.pushView("': wrong number of generic arguments, expected ");
                    self.pushDec(&msg, (u64)expected);
                    msg.pushView(", got ");
                    self.pushDec(&msg, (u64)want);
                    self.semaError(ErrorCode::SemaArityMismatch, entry->loc, msg.asView());
                    return false;
                }
                u32 i = 0;
                while (i < entry->kind.payload.Named.genericArgsLen) {
                    if (!self.checkType(entry->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::ValueInt => { return true; },
            TypeKind::Pointer => { return self.checkType(entry->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.checkType(entry->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.checkType(entry->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.checkType(entry->kind.payload.Slice.base); },
            TypeKind::Array => {
                if (entry->kind.payload.Array.sizeName != 0 && entry->kind.payload.Array.sizeParam == 4294967295)
                {
                    self.semaError(ErrorCode::SemaNonConstArraySize, entry->loc,
                        self.nameMsg("array size is not a compile-time constant: ", entry->kind.payload.Array.sizeName));
                    return false;
                }
                return self.checkType(entry->kind.payload.Array.base);
            },
            
            TypeKind::FnPtr => {
                if (!self.checkType(entry->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < entry->kind.payload.FnPtr.paramsLen) {
                    if (!self.checkType(entry->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },
            
            TypeKind::Tuple => {
                u32 i = 0;
                while (i < entry->kind.payload.Tuple.elemsLen) {
                    if (!self.checkType(entry->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            else => { return true; }
        }
    }

    /* does `t` mention a type parameter anywhere? a bare `T` parsed as Named
     * still counts via the kind-4 symbol check below. two dependent types
     * are not interchangeable; see compatible(). */
    bool dependentType(Ty typeNode)
    {
        if (typeNode == 0) return false;
        TypeEntry* entry = self.ctx.types + typeNode;
        if (entry->kind.tag == TypeKind::TypeParam) return true;
        if (entry->kind.tag == TypeKind::Named)
        {
            u32 i = 0;
            while (i < entry->kind.payload.Named.genericArgsLen) {
                if (self.dependentType(entry->kind.payload.Named.genericArgs[i])) return true;
                i++;
            }
            Symbol* symbol = self.lookupType(entry->kind.payload.Named.name, entry->loc);
            if (symbol != null && symbol->kind == 4) return true;
            return false;
        }
        if (entry->kind.tag == TypeKind::Pointer) return self.dependentType(entry->kind.payload.Pointer.base);
        if (entry->kind.tag == TypeKind::Const) return self.dependentType(entry->kind.payload.Const.base);
        if (entry->kind.tag == TypeKind::Comptime) return self.dependentType(entry->kind.payload.Comptime.base);
        if (entry->kind.tag == TypeKind::Slice) return self.dependentType(entry->kind.payload.Slice.base);
        if (entry->kind.tag == TypeKind::Array)
            return self.dependentType(entry->kind.payload.Array.base) ||
                   entry->kind.payload.Array.sizeParam != 4294967295;
        return false;
    }

    /* is this param a type placeholder rather than a value? true for a
     * const-wrapped TypeParam, an unnamed param (flags bit 8), or a name
     * that appears in the function's generic list (`fn f<T>(x: T)`). */
    bool genericArgParam(Decl* decl, Param* param)
    {
        if (decl == null || param == null) return false;
        if (decl->kind.tag != DeclKind::Func) return false;
        if (param->typeNode == 0) return false;
        Ty base = param->typeNode;
        TypeEntry* entry = self.ctx.types + base;
        while (entry != null && entry->kind.tag == TypeKind::Const)
        {
            base = entry->kind.payload.Const.base;
            if (base == 0) return false;
            entry = self.ctx.types + base;
        }
        if (entry == null) return false;
        if (entry->kind.tag == TypeKind::TypeParam) return true;
        if (entry->kind.tag != TypeKind::Named) return false;
        if ((param->flags & 8) != 0) return true;
        Str name = entry->kind.payload.Named.name;
        u32 i = 0;
        while (i < decl->kind.payload.Func.genericParamsLen)
        {
            Node* genericNode = self.ctx.nodes + decl->kind.payload.Func.genericParams[i].index;
            if (genericNode->kind.tag == NodeKind::GenericParam)
            {
                GenericParam* generic = &genericNode->kind.payload.GenericParam.value;
                if (generic->name == name) return true;
            }
            i++;
        }
        return false;
    }

    // pull the generic param list out of any decl kind that can carry one;
    // *outParams is borrowed from the AST, not a copy
    u32 declGenericParams(Decl* decl, NodeId** outParams)
    {
        *outParams = null;
        if (decl == null) return 0;
        if (decl->kind.tag == DeclKind::Struct) {
            *outParams = decl->kind.payload.Struct.genericParams;
            return decl->kind.payload.Struct.genericParamsLen;
        }
        if (decl->kind.tag == DeclKind::Func) {
            *outParams = decl->kind.payload.Func.genericParams;
            return decl->kind.payload.Func.genericParamsLen;
        }
        if (decl->kind.tag == DeclKind::Variant) {
            *outParams = decl->kind.payload.Variant.genericParams;
            return decl->kind.payload.Variant.genericParamsLen;
        }
        if (decl->kind.tag == DeclKind::Union) {
            *outParams = decl->kind.payload.Union.genericParams;
            return decl->kind.payload.Union.genericParamsLen;
        }
        if (decl->kind.tag == DeclKind::Trait) {
            *outParams = decl->kind.payload.Trait.genericParams;
            return decl->kind.payload.Trait.genericParamsLen;
        }
        return 0;
    }

    Str structParamName(Ty objectType, u32 index)
    {
        if (objectType == 0) return 0;
        TypeEntry* obj = self.ctx.types + objectType;
        if (obj->kind.tag != TypeKind::Named) return 0;
        Str name = obj->kind.payload.Named.name;
        Decl* decl = null;
        Symbol* symbol = self.lookupType(name, obj->loc);
        if (symbol != null && symbol->declaration.index != 0)
        {
            Node* declNode = self.ctx.nodes + symbol->declaration.index;
            if (declNode->kind.tag == NodeKind::Decl) decl = &declNode->kind.payload.Decl.value;
        }
        NodeId* generics = null;
        u32 count = self.declGenericParams(decl, &generics);
        if (generics == null || index >= count)
        {
            /* the plain scope lookup can bind a same-named non-generic
             * declaration (libc's extern realloc shadows mman's realloc<T>);
             * search all candidates for one with a generic param at index */
            generics = null;
            count = 0;
            Symbol** cands = alloc<Symbol*>(16);
            if (cands != null)
            {
                u32 n = self.scopes.lookupAll(name, cands, 16);
                u32 m = 0;
                while (m < n)
                {
                    if (cands[m]->declaration.index != 0)
                    {
                        Node* dn = self.ctx.nodes + cands[m]->declaration.index;
                        if (dn->kind.tag == NodeKind::Decl)
                        {
                            NodeId* g2 = null;
                            u32 c2 = self.declGenericParams(&dn->kind.payload.Decl.value, &g2);
                            if (g2 != null && index < c2)
                            {
                                decl = &dn->kind.payload.Decl.value;
                                generics = g2;
                                count = c2;
                                m = n;
                                break;
                            }
                        }
                    }
                    m++;
                }
                dealloc<Symbol*>(cands);
            }
        }
        if (generics == null || index >= count) return 0;
        Node* genericNode = self.ctx.nodes + generics[index].index;
        if (genericNode->kind.tag != NodeKind::GenericParam) return 0;
        return genericNode->kind.payload.GenericParam.value.name;
    }

    /* Structural match where TypeParam entries in `pattern` act as wildcards.
     * used to match an extend's self type (`Option<T>`) against a concrete
     * receiver (`Option<f64>`) */
    bool sameTypePattern(Ty pattern, Ty concrete)
    {
        if (pattern == concrete) return true;
        if (pattern == 0 || concrete == 0) return false;
        TypeEntry* a = self.ctx.types + pattern;
        TypeEntry* b = self.ctx.types + concrete;
        if (a->kind.tag == TypeKind::TypeParam) return true;
        if (a->kind.tag != b->kind.tag) return false;
        switch (a->kind.tag)
        {
            TypeKind::Named => {
                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;
                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Named.genericArgsLen)
                {
                    if (!self.sameTypePattern(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;
                    i++;
                }
                return true;
            },
            TypeKind::Pointer => { return self.sameTypePattern(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },
            TypeKind::Const => { return self.sameTypePattern(a->kind.payload.Const.base, b->kind.payload.Const.base); },
            TypeKind::Comptime => { return self.sameTypePattern(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },
            TypeKind::Slice => { return self.sameTypePattern(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },
            TypeKind::Array => {
                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;
                if (a->kind.payload.Array.sizeParam != b->kind.payload.Array.sizeParam) return false;
                return self.sameTypePattern(a->kind.payload.Array.base, b->kind.payload.Array.base);
            },
            TypeKind::FnPtr => {
                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;
                if (!self.sameTypePattern(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;
                u32 i = 0;
                while (i < a->kind.payload.FnPtr.paramsLen) {
                    if (!self.sameTypePattern(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;
                    i++;
                }
                return true;
            },
            TypeKind::Tuple => {
                if (a->kind.payload.Tuple.elemsLen != b->kind.payload.Tuple.elemsLen) return false;
                u32 i = 0;
                while (i < a->kind.payload.Tuple.elemsLen) {
                    if (!self.sameTypePattern(a->kind.payload.Tuple.elems[i], b->kind.payload.Tuple.elems[i])) return false;
                    i++;
                }
                return true;
            },
            else => { return true; }
        }
        return true;
    }

    /* replace the object's generic args inside a field type: inside
     * `Vec<i32>`, `T` becomes i32. wrappers are rebuilt only when a child
     * actually changed (unchanged types are shared). the fresh args array of
     * a Named result is handed to ctx.track; the context owns it and frees
     * it at teardown, because the new TypeEntry points straight into it. */
    Ty substituteFieldTy(Ty fieldType, Ty objectType)
    {
        if (fieldType == 0 || objectType == 0) return fieldType;
        TypeEntry* obj = self.ctx.types + objectType;
        while (obj != null)
        {
            if (obj->kind.tag == TypeKind::Pointer) objectType = obj->kind.payload.Pointer.base;
            else if (obj->kind.tag == TypeKind::Const) objectType = obj->kind.payload.Const.base;
            else if (obj->kind.tag == TypeKind::Comptime) objectType = obj->kind.payload.Comptime.base;
            else break;
            if (objectType == 0) return fieldType;
            obj = self.ctx.types + objectType;
        }
        if (obj == null || obj->kind.tag != TypeKind::Named) return fieldType;
        u32 objArgsLen = obj->kind.payload.Named.genericArgsLen;
        Ty* objArgs = obj->kind.payload.Named.genericArgs;
        if (objArgsLen == 0) return fieldType;
        TypeEntry* entry = self.ctx.types + fieldType;
        switch (entry->kind.tag)
        {
            TypeKind::TypeParam => {
                u32 i = 0;
                while (i < objArgsLen) {
                    if (self.structParamName(objectType, i) == entry->kind.payload.TypeParam.name) return objArgs[i];
                    i++;
                }
                return fieldType;
            },
            
            TypeKind::Named => {
                if (entry->kind.payload.Named.genericArgsLen == 0) {
                    Str name = entry->kind.payload.Named.name;
                    u32 i = 0;
                    while (i < objArgsLen) {
                        if (self.structParamName(objectType, i) == name) return objArgs[i];
                        i++;
                    }
                    return fieldType;
                }
                u32 len = entry->kind.payload.Named.genericArgsLen;
                Ty* args = alloc<Ty>((usize)len);
                if (args == null) return fieldType;
                bool changed = false;
                u32 i = 0;
                while (i < len) {
                    args[i] = self.substituteFieldTy(entry->kind.payload.Named.genericArgs[i], objectType);
                    if (args[i] != entry->kind.payload.Named.genericArgs[i]) changed = true;
                    i++;
                }
                if (!changed) {
                    dealloc<Ty>(args);
                    return fieldType;
                }
                if (!self.ctx.track((rawptr)args)) {
                    dealloc<Ty>(args);
                    return fieldType;
                }
                TypeKind kind = TypeKind::Named{ .name = entry->kind.payload.Named.name, .genericArgs = args, .genericArgsLen = len };
                Ty nt = self.allocType(kind);
                TypeEntry* ne = self.ctx.types + nt;
                ne->loc = entry->loc;
                return nt;
            },
            
            TypeKind::Pointer => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Pointer.base, objectType);
                if (base == entry->kind.payload.Pointer.base) return fieldType;
                TypeKind kind = TypeKind::Pointer{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Const => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Const.base, objectType);
                if (base == entry->kind.payload.Const.base) return fieldType;
                TypeKind kind = TypeKind::Const{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Comptime => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Comptime.base, objectType);
                if (base == entry->kind.payload.Comptime.base) return fieldType;
                TypeKind kind = TypeKind::Comptime{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Slice => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Slice.base, objectType);
                if (base == entry->kind.payload.Slice.base) return fieldType;
                TypeKind kind = TypeKind::Slice{ .base = base };
                return self.allocType(kind);
            },
            
            TypeKind::Array => {
                Ty base = self.substituteFieldTy(entry->kind.payload.Array.base, objectType);
                if (base == entry->kind.payload.Array.base) return fieldType;
                TypeKind kind = TypeKind::Array{ .base = base, .len = entry->kind.payload.Array.len,
                                                 .sizeParam = entry->kind.payload.Array.sizeParam,
                                                 .sizeName = entry->kind.payload.Array.sizeName };
                return self.allocType(kind);
            },

            TypeKind::FnPtr => {
                Ty ret = self.substituteFieldTy(entry->kind.payload.FnPtr.returnType, objectType);
                u32 len = entry->kind.payload.FnPtr.paramsLen;
                Ty* params = alloc<Ty>((usize)len);
                if (params == null) return fieldType;
                bool changed = ret != entry->kind.payload.FnPtr.returnType;
                u32 i = 0;
                while (i < len) {
                    params[i] = self.substituteFieldTy(entry->kind.payload.FnPtr.params[i], objectType);
                    if (params[i] != entry->kind.payload.FnPtr.params[i]) changed = true;
                    i++;
                }
                if (!changed || !self.ctx.track((rawptr)params)) {
                    dealloc<Ty>(params);
                    return fieldType;
                }
                TypeKind kind = TypeKind::FnPtr{ .returnType = ret, .params = params, .paramsLen = len,
                                                 .name = entry->kind.payload.FnPtr.name };
                return self.allocType(kind);
            },

            TypeKind::Tuple => {
                u32 len = entry->kind.payload.Tuple.elemsLen;
                Ty* elems = alloc<Ty>((usize)len);
                if (elems == null) return fieldType;
                bool changed = false;
                u32 i = 0;
                while (i < len) {
                    elems[i] = self.substituteFieldTy(entry->kind.payload.Tuple.elems[i], objectType);
                    if (elems[i] != entry->kind.payload.Tuple.elems[i]) changed = true;
                    i++;
                }
                if (!changed || !self.ctx.track((rawptr)elems)) {
                    dealloc<Ty>(elems);
                    return fieldType;
                }
                TypeKind kind = TypeKind::Tuple{ .elems = elems, .elemsLen = len };
                return self.allocType(kind);
            },
            else => { return fieldType; }
        }
    }

    Ty unqualTy(Ty t)
    {
        u32 guard = 0;
        while (t != 0 && guard < 8)
        {
            guard++;
            TypeEntry* e = self.ctx.types + t;
            if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
            else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
            else if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.genericArgsLen == 0)
            {
                /* `cchar` and friends stay Named in the parse-time param
                 * types; resolve through the symbol to the primitive so
                 * char-sign mixing can see it (aliases are chains, hence
                 * the guard) */
                Symbol* sym = self.lookupType(e->kind.payload.Named.name, e->loc);
                if (sym == null || sym->typeNode == 0 || sym->typeNode == t) break;
                t = sym->typeNode;
            }
            else break;
        }
        return t;
    }

    /* the three C char types (char/signed/unsigned char; `cchar` is i8
     * on x86_64): clang and gcc accept mixed char-signedness pointers
     * with only -Wpointer-sign, so `u8*` fits a `const cchar*` param */
    bool charFamily(Ty t)
    {
        t = self.unqualTy(t);
        if (t == 0) return false;
        TypeEntry* e = self.ctx.types + t;
        if (e->kind.tag == TypeKind::I8 || e->kind.tag == TypeKind::U8 || e->kind.tag == TypeKind::Char) return true;
        /* Named `cchar` is the C ABI byte type (codegen maps it to C
         * `char`); like clang's -Wpointer-sign family it mixes with
         * u8* /i8* pointers: C"..." vs `u8* fmt`, `str.ptr` vs `cchar*` */
        if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.genericArgsLen == 0 &&
            e->kind.payload.Named.name == self.ctx.intern("cchar")) return true;
        return false;
    }

    bool charSignMix(Ty a, Ty b)
    {
        return self.charFamily(a) && self.charFamily(b);
    }

    /* the one compatibility oracle. order matters: identity and typedef
     * resolution first, then const/comptime strip on both sides, pointer
     * const-add (T* → const T*), array decay, char family, usize≡u64, and
     * finally the dependent-type escape hatch.
     * from == 0 / to == 0 means "no type" (null, an untyped brace literal)
     * and fits anything, which is why `i32 x = null` quietly type-checks.
     * pointer targets are the intent there, not a general invitation. */
    bool compatible(Ty from, Ty to)
    {
        if (from == 0 || to == 0) return true;
        if (self.sameType(from, to)) return true;

        // see through typedefs before the structural rules below
        Ty rf = self.resolveScalarAlias(from);
        Ty rt = self.resolveScalarAlias(to);
        if (rf != from || rt != to) return self.compatible(rf, rt);

        TypeEntry* source = self.ctx.types + from;
        TypeEntry* target = self.ctx.types + to;
        if (source->kind.tag == TypeKind::Const)
            return self.compatible(source->kind.payload.Const.base, to);
        if (source->kind.tag == TypeKind::Comptime)
            return self.compatible(source->kind.payload.Comptime.base, to);
        if (target->kind.tag == TypeKind::Const)
            return self.compatible(from, target->kind.payload.Const.base);
        if (target->kind.tag == TypeKind::Comptime)
            return self.compatible(from, target->kind.payload.Comptime.base);

        /* Pointer structure first: adding qualification to the target is
         * allowed (T* -> const T*), matching element type is required. */
        if (source->kind.tag == TypeKind::Pointer && target->kind.tag == TypeKind::Pointer)
        {
            Ty sb = source->kind.payload.Pointer.base;
            Ty tb = target->kind.payload.Pointer.base;
            while (tb != 0)
            {
                TypeEntry* te = self.ctx.types + tb;
                if (te->kind.tag == TypeKind::Const) tb = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) tb = te->kind.payload.Comptime.base;
                else break;
            }
            if (self.sameType(sb, tb)) return true;
            if (self.charSignMix(sb, tb)) return true;
        }
        if (source->kind.tag == TypeKind::Pointer && target->kind.tag == TypeKind::Rawptr)
            return true;

        /* array decay: T[] matches T* / rawptr (stack buffers passed to
         * pointer params, `p >= buf` comparisons) */
        if (source->kind.tag == TypeKind::Array && target->kind.tag == TypeKind::Pointer)
        {
            Ty tb2 = target->kind.payload.Pointer.base;
            while (tb2 != 0)
            {
                TypeEntry* te2 = self.ctx.types + tb2;
                if (te2->kind.tag == TypeKind::Const) tb2 = te2->kind.payload.Const.base;
                else if (te2->kind.tag == TypeKind::Comptime) tb2 = te2->kind.payload.Comptime.base;
                else break;
            }
            if (self.sameType(source->kind.payload.Array.base, tb2)) return true;
            if (self.charSignMix(source->kind.payload.Array.base, tb2)) return true;
        }
        if (source->kind.tag == TypeKind::Array && target->kind.tag == TypeKind::Rawptr)
            return true;

        /* array → slice decay: `T[N]` binds to `T[]` params the way it
         * binds to `T*` (length travels in the slice's len field) */
        if (source->kind.tag == TypeKind::Array && target->kind.tag == TypeKind::Slice)
        {
            if (self.sameType(source->kind.payload.Array.base, target->kind.payload.Slice.base)) return true;
            if (self.charSignMix(source->kind.payload.Array.base, target->kind.payload.Slice.base)) return true;
        }

        /* char-family scalar mixing: `char`/`u8`/`i8`/`cchar` are the C byte
         * types; like C's integer promotion they mix in scalar position the
         * same way charSignMix already lets their pointers mix (`tmp[0]='0'`,
         * `'0'+digit`, `u8[]` vs `cchar`). */
        if (self.charFamily(from) && self.charFamily(to)) return true;

        /* usize/isize are the platform word types (C size_t/ptrdiff_t); on a
         * 64-bit target they are the same representation as u64/i64, so the
         * two are mutually assignable the way size_t and uint64_t are in C.
         * This is what lets `write(fd, ptr, s.len)` pass a `usize` count to
         * a `u64` libc param without a cast. */
        if (source->kind.tag == TypeKind::Usize && target->kind.tag == TypeKind::U64) return true;
        if (source->kind.tag == TypeKind::U64 && target->kind.tag == TypeKind::Usize) return true;
        if (source->kind.tag == TypeKind::Isize && target->kind.tag == TypeKind::I64) return true;
        if (source->kind.tag == TypeKind::I64 && target->kind.tag == TypeKind::Isize) return true;

        /* no implicit scalar conversion: typed int→int / int→float etc.
         * require an exact match (or an explicit cast); only literals and
         * the pointer/array/const rules above are lenient */

        /* Dependent/generic flexibility (no bounds yet; mono boundary is
         * the enforcement point): one side dependent fits anything, BUT two
         * distinct dependent types are not interchangeable unless their
         * shapes already matched above. */
        bool fromDep = self.dependentType(from);
        bool toDep = self.dependentType(to);
        if (fromDep && toDep) return false;
        if (fromDep || toDep) return true;
        return false;
    }
}
