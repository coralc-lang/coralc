#[[no_drop_all]]

/* scope.crl: the lexical scope stack: one Scope per block, symbols in a
 * growable array, lookup walks parent pointers. top-level decls remember
 * their source file so same-named decls merged from different files stay
 * distinct (the backend mangles them apart). */
import ast::id { Str, NodeId };
import ast::types { Ty };

import(lib) std::mman { alloc, dealloc, realloc, zero };

pub struct Symbol
{
    Str name;
    /* kind codes: 1 var/const, 2 func, 3 type, 4 generic param, 5 module
     * namespace (set at declare time by decl.crl) */
    u8 kind;
    Ty typeNode;
    NodeId declaration;
    /* bit 0 = const: assignment is rejected (TC-0008). bit 1 = assigned to
     * at least once (set by assign(); nothing reads it back yet) */
    u8 flags;
    /* source file the declaration lives in (diagnostic file id). symbols
     * with the same name from different files are distinct (the backend
     * mangles their names apart); see coral-docs/mangle_asm.md */
    u32 fileId;
}

pub struct Scope
{
    Symbol* symbols;
    u32 symbolsLen;
    u32 symbolsCap;
    Scope* parent;
}

pub struct ScopeStack
{
    rawptr* scopes;
    u32 len;
    u32 cap;
    u32 errors;
    /* why the last declare() failed: 0 = none, 1 = redeclaration in this
     * scope, 2 = out of memory / no scope */
    u8 lastDeclFail;
    // the symbol the last declare() conflicted with (lastDeclFail == 1)
    Symbol* dupSymbol;
}

pub extend ScopeStack
{
    /* cap 0 = init failed / stack deliberately dead: enter() refuses and the
     * first real push grows from 4. scopes[] holds Scope* as rawptr because
     * Scope is defined above but the array is just addresses. */
    void init(u32 cap)
    {
        self.scopes = null;
        self.len = 0;
        self.cap = 0;
        self.errors = 0;
        self.lastDeclFail = 0;
        self.dupSymbol = null;
        if (cap == 0) return;
        self.scopes = alloc<rawptr>((usize)cap);
        if (self.scopes != null)
        {
            zero<rawptr>(self.scopes, (usize)cap);
            self.cap = cap;
        }
    }

    // pop everything still open (early-return leaks land here); leave()
    // normally owns this per scope
    void deinit()
    {
        while (self.len > 0)
        {
            self.len--;
            Scope* scope = (Scope*)self.scopes[self.len];
            if (scope->symbols != null) dealloc<Symbol>(scope->symbols);
            dealloc<Scope>(scope);
        }
        if (self.scopes != null) dealloc<rawptr>(self.scopes);
        self.scopes = null;
        self.len = 0;
        self.cap = 0;
        self.errors = 0;
    }

    Scope* current()
    {
        if (self.scopes == null || self.len == 0) return null;
        return (Scope*)self.scopes[self.len - 1];
    }

    /* push a scope parented to the current one; pair every success with
     * leave() (an imbalance isn't fatal; deinit sweeps leftovers, but
     * lookups will see the wrong set of names in the meantime) */
    bool enter()
    {
        if (self.scopes == null) return false;
        if (self.len >= self.cap)
        {
            u32 newCap = self.cap * 2;
            if (newCap == 0) newCap = 4;
            rawptr* raw = realloc<rawptr>(self.scopes, (usize)newCap);
            if (raw == null)
            {
                self.errors++;
                return false;
            }
            self.scopes = raw;
            self.cap = newCap;
        }
        Scope* scope = alloc<Scope>(1);
        if (scope == null)
        {
            self.errors++;
            return false;
        }
        zero<Scope>(scope, 1);
        scope->parent = self.current();
        self.scopes[self.len] = (rawptr)scope;
        self.len++;
        return true;
    }

    bool leave()
    {
        if (self.len == 0)
        {
            self.errors++;
            return false;
        }
        self.len--;
        Scope* scope = (Scope*)self.scopes[self.len];
        if (scope->symbols != null) dealloc<Symbol>(scope->symbols);
        dealloc<Scope>(scope);
        self.scopes[self.len] = null;
        return true;
    }

    /* add to the innermost scope. identity is (name, fileId): a same-name
     * symbol from another merged file coexists. re-declaring the very same
     * node (declare pass then body pass) returns true, not a dup.
     * on failure, lastDeclFail says 1 = duplicate (dupSymbol set) or
     * 2 = OOM, and the counter was already bumped. */
    bool declare(Str name, u8 kind, Ty typeNode, NodeId declaration, u8 flags, u32 fileId)
    {
        self.lastDeclFail = 0;
        self.dupSymbol = null;
        Scope* scope = self.current();
        if (scope == null)
        {
            self.lastDeclFail = 2;
            self.errors++;
            return false;
        }
        u32 i = 0;
        while (i < scope->symbolsLen)
        {
            if (scope->symbols[i].name == name)
            {
                /* different source file: distinct (mangled) symbols are
                 * allowed; this also lets an import binding coexist with
                 * the real merged declaration it points at */
                if (scope->symbols[i].fileId != fileId)
                {
                    i++;
                    continue;
                }
                if (scope->symbols[i].declaration.index == declaration.index) return true; // same node: idempotent
                self.lastDeclFail = 1;
                self.dupSymbol = scope->symbols + i;
                self.errors++;
                return false;
            }
            i++;
        }
        if (scope->symbolsLen >= scope->symbolsCap)
        {
            u32 newCap = scope->symbolsCap * 2;
            if (newCap == 0) newCap = 4;
            Symbol* raw = realloc<Symbol>(scope->symbols, (usize)newCap);
            if (raw == null)
            {
                self.lastDeclFail = 2;
                self.errors++;
                return false;
            }
            scope->symbols = raw;
            scope->symbolsCap = newCap;
        }
        Symbol* symbol = scope->symbols + scope->symbolsLen;
        symbol->name = name;
        symbol->kind = kind;
        symbol->typeNode = typeNode;
        symbol->declaration = declaration;
        symbol->flags = flags;
        symbol->fileId = fileId;
        scope->symbolsLen++;
        return true;
    }

    Symbol* lookup(Str name)
    {
        Scope* scope = self.current();
        while (scope != null)
        {
            u32 i = 0;
            while (i < scope->symbolsLen)
            {
                if (scope->symbols[i].name == name) return scope->symbols + i;
                i++;
            }
            scope = scope->parent;
        }
        return null;
    }

    /* like lookup, but the symbol declared in `fileId`'s own file wins over
     * same-named symbols merged from other files; shadowing still applies
     * (an inner scope's entry beats any outer entry) */
    Symbol* lookupFrom(Str name, u32 fileId)
    {
        Scope* scope = self.current();
        while (scope != null)
        {
            Symbol* first = null;
            u32 i = 0;
            while (i < scope->symbolsLen)
            {
                if (scope->symbols[i].name == name)
                {
                    if (scope->symbols[i].fileId == fileId) return scope->symbols + i;
                    if (first == null) first = scope->symbols + i;
                }
                i++;
            }
            if (first != null) return first;
            scope = scope->parent;
        }
        return null;
    }

    /* every symbol named `name`, innermost scope first; lets callers
     * resolve ambiguous names (the same name declared in several merged
     * files, e.g. libc's extern realloc vs mman's realloc<T>) by a
     * secondary criterion such as generic arity */
    u32 lookupAll(Str name, Symbol** out, u32 max)
    {
        u32 n = 0;
        Scope* scope = self.current();
        while (scope != null)
        {
            u32 i = 0;
            while (i < scope->symbolsLen)
            {
                if (scope->symbols[i].name == name && n < max)
                {
                    out[n] = scope->symbols + i;
                    n++;
                }
                i++;
            }
            scope = scope->parent;
        }
        return n;
    }

    /* mark a name as written to. only kind 1 (variable) is assignable and
     * a const (flags bit 0) never is; everything else fails silently here;
     * the caller already reported the shape problem */
    bool assign(Str name, NodeId target)
    {
        Symbol* symbol = self.lookup(name);
        if (symbol == null)
        {
            self.errors++;
            return false;
        }
        if (symbol->kind != 1 || (symbol->flags & 1) != 0)
        {
            self.errors++;
            return false;
        }
        symbol->flags |= 2;
        return true;
    }

    u32 errorCount() { return self.errors; }
}
