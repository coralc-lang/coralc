#[[no_drop_all]]

/* scope.crl: the lexical scope stack: one Scope per block, symbols in a
 * growable array, lookup walks parent pointers. top-level decls remember
 * their source file so same-named decls merged from different files stay
 * distinct (the backend mangles them apart).
 *
 * every Scope carries an inline 64-bucket name index: symbols are
 * appended to the array (never removed) and linked tail-first into their
 * bucket's chain, so a chain walks in array order — lookup/lookupFrom/
 * lookupAll/declare's dup-check all see exactly the sequence the old
 * full scans produced, in O(chain) instead of O(symbols). Scope structs
 * and their symbol arrays are pooled across enter/leave (properly
 * nested, so a LIFO freelist fits). */
use ast::id { Str, NodeId };
use ast::types { Ty };

import std::mman { alloc, dealloc, realloc, zero };

pub struct Symbol
{
    Str name;
    /* kind codes: 1 var/const, 2 func, 3 type, 4 generic param, 5 module
     * namespace (set at declare time by decl.crl) */
    u8 kind;
    Ty typeNode;
    NodeId declaration;
    /* bit 0 = const: assignment is rejected (TC-0008). bit 1 = assigned to
     * at least once (set by assign(); nothing reads it back yet) */
    u8 flags;
    /* source file the declaration lives in (diagnostic file id). symbols
     * with the same name from different files are distinct (the backend
     * mangles their names apart); see coral-docs/mangle_asm.md */
    u32 fileId;
    /* next symbol in this scope's bucket chain, stored as index+1
     * (0 = end); chains ascend in array order (tail-linked at declare) */
    u32 next;
}

pub struct Scope
{
    Symbol* symbols;
    u32 symbolsLen;
    u32 symbolsCap;
    Scope* parent;
    /* name → index+1 of the first symbol in that bucket (0 = empty) */
    u32[64] buckets;
    /* ScopeStack's freelist link once the scope has been left */
    Scope* poolNext;
}

pub struct ScopeStack
{
    rawptr* scopes;
    u32 len;
    u32 cap;
    u32 errors;
    /* why the last declare() failed: 0 = none, 1 = redeclaration in this
     * scope, 2 = out of memory / no scope */
    u8 lastDeclFail;
    // the symbol the last declare() conflicted with (lastDeclFail == 1)
    Symbol* dupSymbol;
    /* freelist of Scope structs from leave() (properly nested → LIFO) */
    Scope* scopePool;
    /* freed symbol arrays keyed by log2(capacity): slot 2 = cap 4,
     * slot 3 = cap 8, … the block's first word carries the next pointer */
    rawptr[16] symPool;
    /* prelude-root file ids (analyze.crl marks each libLoadModulePath
     * root): their symbols resolve from any use site without an import.
     * everything else is visible only from its own file or through an
     * explicit import binding. */
    u32[64] ambientFiles;
    u32 ambientLen;
}

/* golden-ratio mix of the interned id, top6 bits: the 64-bit constant is
 * essential — with the 32-bit one, dense Str ids (< ~1e8) never reach
 * bit58 and every name lands in bucket 0 */
u32 symBucket(Str name)
{
    u64 h = (u64)name * 0x9E3779B97F4A7C15;
    return (u32)((h >> 58) & 63);
}

// log2 of a power-of-two capacity (4 → 2, 8 → 3, …)
u32 symCapSlot(u32 cap)
{
    u32 s = 0;
    u32 c = cap;
    while (c > 1)
    {
        c >>= 1;
        s++;
    }
    return s;
}

pub extend ScopeStack
{
    /* cap 0 = init failed / stack deliberately dead: enter() refuses and the
     * first real push grows from 4. scopes[] holds Scope* as rawptr because
     * Scope is defined above but the array is just addresses. */
    void init(u32 cap)
    {
        self.scopes = null;
        self.len = 0;
        self.cap = 0;
        self.errors = 0;
        self.lastDeclFail = 0;
        self.dupSymbol = null;
        self.scopePool = null;
        u32 s = 0;
        while (s < 16)
        {
            self.symPool[s] = null;
            s++;
        }
        if (cap == 0) return;
        self.scopes = alloc<rawptr>((usize)cap);
        if (self.scopes != null)
        {
            zero<rawptr>(self.scopes, (usize)cap);
            self.cap = cap;
        }
    }

    // pop everything still open (early-return leaks land here); leave()
    // normally owns this per scope
    void deinit()
    {
        while (self.len > 0)
        {
            self.len--;
            Scope* scope = (Scope*)self.scopes[self.len];
            self.scopes[self.len] = null;
            self.poolScope(scope);
        }
        /* sweep the symbol-array freelists */
        u32 s = 0;
        while (s < 16)
        {
            rawptr blk = self.symPool[s];
            while (blk != null)
            {
                rawptr next = ((rawptr*)blk)[0];
                dealloc<Symbol>((Symbol*)blk);
                blk = next;
            }
            self.symPool[s] = null;
            s++;
        }
        /* sweep the scope freelist */
        Scope* sc = self.scopePool;
        while (sc != null)
        {
            Scope* next = sc->poolNext;
            dealloc<Scope>(sc);
            sc = next;
        }
        self.scopePool = null;
        if (self.scopes != null) dealloc<rawptr>(self.scopes);
        self.scopes = null;
        self.len = 0;
        self.cap = 0;
        self.errors = 0;
    }

    /* return a scope's memory to the pools: symbols by capacity class,
     * then the struct itself (used by leave() and deinit()) */
    void poolScope(Scope* scope)
    {
        if (scope == null) return;
        if (scope->symbols != null)
        {
            u32 slot = symCapSlot(scope->symbolsCap);
            if (scope->symbolsCap >= 4 && slot < 16)
            {
                ((rawptr*)scope->symbols)[0] = self.symPool[slot];
                self.symPool[slot] = (rawptr)scope->symbols;
            }
            else dealloc<Symbol>(scope->symbols);
            scope->symbols = null;
        }
        scope->poolNext = self.scopePool;
        self.scopePool = scope;
    }

    // take a symbol array of exactly newCap slots from the pool, else alloc
    Symbol* takeSymBlock(u32 newCap)
    {
        u32 slot = symCapSlot(newCap);
        if (slot < 16 && self.symPool[slot] != null)
        {
            Symbol* blk = (Symbol*)self.symPool[slot];
            self.symPool[slot] = ((rawptr*)blk)[0];
            return blk;
        }
        return alloc<Symbol>((usize)newCap);
    }

    Scope* current()
    {
        if (self.scopes == null || self.len == 0) return null;
        return (Scope*)self.scopes[self.len - 1];
    }

    /* push a scope parented to the current one; pair every success with
     * leave() (an imbalance isn't fatal; deinit sweeps leftovers, but
     * lookups will see the wrong set of names in the meantime) */
    bool enter()
    {
        if (self.scopes == null) return false;
        if (self.len >= self.cap)
        {
            u32 newCap = self.cap * 2;
            if (newCap == 0) newCap = 4;
            rawptr* raw = realloc<rawptr>(self.scopes, (usize)newCap);
            if (raw == null)
            {
                self.errors++;
                return false;
            }
            self.scopes = raw;
            self.cap = newCap;
        }
        Scope* scope = null;
        if (self.scopePool != null)
        {
            scope = self.scopePool;
            self.scopePool = scope->poolNext;
        }
        else
        {
            scope = alloc<Scope>(1);
            if (scope == null)
            {
                self.errors++;
                return false;
            }
        }
        zero<Scope>(scope, 1);
        scope->parent = self.current();
        self.scopes[self.len] = (rawptr)scope;
        self.len++;
        return true;
    }

    bool leave()
    {
        if (self.len == 0)
        {
            self.errors++;
            return false;
        }
        self.len--;
        Scope* scope = (Scope*)self.scopes[self.len];
        self.scopes[self.len] = null;
        self.poolScope(scope);
        return true;
    }

    /* add to the innermost scope. identity is (name, fileId): a same-name
     * symbol from another merged file coexists. re-declaring the very same
     * node (declare pass then body pass) returns true, not a dup.
     * on failure, lastDeclFail says 1 = duplicate (dupSymbol set) or
     * 2 = OOM, and the counter was already bumped. */
    bool declare(Str name, u8 kind, Ty typeNode, NodeId declaration, u8 flags, u32 fileId)
    {
        self.lastDeclFail = 0;
        self.dupSymbol = null;
        Scope* scope = self.current();
        if (scope == null)
        {
            self.lastDeclFail = 2;
            self.errors++;
            return false;
        }
        u32 b = symBucket(name);
        u32 i = scope->buckets[b];
        while (i != 0)
        {
            Symbol* sym = scope->symbols + (i - 1);
            if (sym->name == name)
            {
                /* different source file: distinct (mangled) symbols are
                 * allowed; this also lets an use binding coexist with
                 * the real merged declaration it points at */
                if (sym->fileId != fileId)
                {
                    i = sym->next;
                    continue;
                }
                if (sym->declaration.index == declaration.index) return true; // same node: idempotent
                self.lastDeclFail = 1;
                self.dupSymbol = sym;
                self.errors++;
                return false;
            }
            i = sym->next;
        }
        if (scope->symbolsLen >= scope->symbolsCap)
        {
            u32 newCap = scope->symbolsCap * 2;
            if (newCap == 0) newCap = 4;
            Symbol* raw = self.takeSymBlock(newCap);
            if (raw == null)
            {
                self.lastDeclFail = 2;
                self.errors++;
                return false;
            }
            if (scope->symbols != null)
            {
                /* carry the live symbols (and their chain links) into the
                 * new block — the pool swap is not realloc, nothing copies
                 * for us */
                u32 c = 0;
                while (c < scope->symbolsLen)
                {
                    raw[c] = scope->symbols[c];
                    c++;
                }
                /* old block goes back to its capacity pool instead of
                 * realloc (same move semantics, but no free) */
                u32 slot = symCapSlot(scope->symbolsCap);
                if (slot < 16)
                {
                    ((rawptr*)scope->symbols)[0] = self.symPool[slot];
                    self.symPool[slot] = (rawptr)scope->symbols;
                }
                else dealloc<Symbol>(scope->symbols);
            }
            scope->symbols = raw;
            scope->symbolsCap = newCap;
        }
        u32 idx = scope->symbolsLen;
        Symbol* symbol = scope->symbols + idx;
        symbol->name = name;
        symbol->kind = kind;
        symbol->typeNode = typeNode;
        symbol->declaration = declaration;
        symbol->flags = flags;
        symbol->fileId = fileId;
        symbol->next = 0;
        scope->symbolsLen++;
        /* tail-link keeps the chain in array order (walk above and every
         * lookup then see exactly what the old linear scans saw) */
        u32* link = &scope->buckets[b];
        while (*link != 0) link = &scope->symbols[*link - 1].next;
        *link = idx + 1;
        return true;
    }

    Symbol* lookup(Str name)
    {
        Scope* scope = self.current();
        u32 b = symBucket(name);
        while (scope != null)
        {
            u32 i = scope->buckets[b];
            while (i != 0)
            {
                Symbol* sym = scope->symbols + (i - 1);
                if (sym->name == name) return sym;
                i = sym->next;
            }
            scope = scope->parent;
        }
        return null;
    }

    /* prelude roots are visible everywhere; everything else must be the
     * use site's own file (or an import binding declared in it) */
    bool fileIsAmbient(u32 fileId)
    {
        u32 i = 0;
        while (i < self.ambientLen)
        {
            if (self.ambientFiles[i] == fileId) return true;
            i++;
        }
        return false;
    }

    void ambientAdd(u32 fileId)
    {
        if (self.fileIsAmbient(fileId)) return;
        if (self.ambientLen >= 64) return;
        self.ambientFiles[self.ambientLen] = fileId;
        self.ambientLen++;
    }

    /* like lookup, but a symbol from a foreign file only resolves when
     * that file is a prelude root (ambient); same-file symbols win per
     * scope level so shadowing still applies */
    Symbol* lookupFrom(Str name, u32 fileId)
    {
        Scope* scope = self.current();
        u32 b = symBucket(name);
        Symbol* ambient = null;
        while (scope != null)
        {
            u32 i = scope->buckets[b];
            while (i != 0)
            {
                Symbol* sym = scope->symbols + (i - 1);
                if (sym->name == name)
                {
                    /* file-neutral: synthetic declares (builtin `str`
                     * namespace, legacy generic-arg aliases) carry no
                     * declaration node and serve every file */
                    if (sym->fileId == fileId || sym->declaration.index == 0) return sym;
                    if (ambient == null && self.fileIsAmbient(sym->fileId)) ambient = sym;
                }
                i = sym->next;
            }
            scope = scope->parent;
        }
        return ambient;
    }

    /* every symbol named `name`, innermost scope first; lets callers
     * resolve ambiguous names (the same name declared in several merged
     * files, e.g. libc's extern realloc vs mman's realloc<T>) by a
     * secondary criterion such as generic arity */
    u32 lookupAll(Str name, Symbol** out, u32 max)
    {
        u32 n = 0;
        Scope* scope = self.current();
        u32 b = symBucket(name);
        while (scope != null)
        {
            u32 i = scope->buckets[b];
            while (i != 0 && n < max)
            {
                Symbol* sym = scope->symbols + (i - 1);
                if (sym->name == name)
                {
                    out[n] = sym;
                    n++;
                }
                i = sym->next;
            }
            scope = scope->parent;
        }
        return n;
    }

    /* mark a name as written to. only kind 1 (variable) is assignable and
     * a const (flags bit 0) never is; everything else fails silently here;
     * the caller already reported the shape problem. resolution is
     * use-site-file strict: a foreign variable is never this file's to
     * assign */
    bool assign(Str name, u32 fileId)
    {
        Symbol* symbol = self.lookupFrom(name, fileId);
        if (symbol == null)
        {
            self.errors++;
            return false;
        }
        if (symbol->kind != 1 || (symbol->flags & 1) != 0)
        {
            self.errors++;
            return false;
        }
        symbol->flags |= 2;
        return true;
    }

    u32 errorCount() { return self.errors; }
}
