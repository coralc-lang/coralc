                            t = self.i64Type();
                        }
                    }
                }
                if (t != 0) self.setExprType(id, t);
                return true;
            },
            ExprKind::BitNot => {
                if (!self.checkExpr(expr->kind.payload.BitNot.expr)) return false;
                Ty t = self.exprType(expr->kind.payload.BitNot.expr);
                if (t != 0) self.setExprType(id, t);
                return true;
            },
            ExprKind::Not => {
                if (!self.checkExpr(expr->kind.payload.Not.expr)) return false;
                self.setExprType(id, self.boolType());
                return true;
            },
            ExprKind::Add => { return self.checkBinary(id, expr->kind.payload.Add.left, expr->kind.payload.Add.right, false); },
            ExprKind::Sub => { return self.checkBinary(id, expr->kind.payload.Sub.left, expr->kind.payload.Sub.right, true); },
            ExprKind::Mul => { return self.checkBinary(id, expr->kind.payload.Mul.left, expr->kind.payload.Mul.right, false); },
            ExprKind::Div => { return self.checkBinary(id, expr->kind.payload.Div.left, expr->kind.payload.Div.right, false); },
            ExprKind::Mod => { return self.checkBinary(id, expr->kind.payload.Mod.left, expr->kind.payload.Mod.right, false); },
            ExprKind::Eq => { return self.checkBinaryBool(id, expr->kind.payload.Eq.left, expr->kind.payload.Eq.right); },
            ExprKind::Ne => { return self.checkBinaryBool(id, expr->kind.payload.Ne.left, expr->kind.payload.Ne.right); },
            ExprKind::Lt => { return self.checkBinaryBool(id, expr->kind.payload.Lt.left, expr->kind.payload.Lt.right); },
            ExprKind::Le => { return self.checkBinaryBool(id, expr->kind.payload.Le.left, expr->kind.payload.Le.right); },
            ExprKind::Gt => { return self.checkBinaryBool(id, expr->kind.payload.Gt.left, expr->kind.payload.Gt.right); },
            ExprKind::Ge => { return self.checkBinaryBool(id, expr->kind.payload.Ge.left, expr->kind.payload.Ge.right); },
            ExprKind::And => { return self.checkCondBinary(id, expr->kind.payload.And.left, expr->kind.payload.And.right); },
            ExprKind::Or => { return self.checkCondBinary(id, expr->kind.payload.Or.left, expr->kind.payload.Or.right); },
            ExprKind::BitAnd => { return self.checkBinary(id, expr->kind.payload.BitAnd.left, expr->kind.payload.BitAnd.right, false); },
            ExprKind::BitOr => { return self.checkBinary(id, expr->kind.payload.BitOr.left, expr->kind.payload.BitOr.right, false); },
            ExprKind::BitXor => { return self.checkBinary(id, expr->kind.payload.BitXor.left, expr->kind.payload.BitXor.right, false); },
            ExprKind::Shl => { return self.checkBinary(id, expr->kind.payload.Shl.left, expr->kind.payload.Shl.right, false); },
            ExprKind::Shr => { return self.checkBinary(id, expr->kind.payload.Shr.left, expr->kind.payload.Shr.right, false); },
            ExprKind::Assign => {
                if (!self.assignExpr(expr->kind.payload.Assign.target)) return false;
                NodeId av = expr->kind.payload.Assign.value;
                NodeId at = expr->kind.payload.Assign.target;
                Ty atgt = self.assignTargetType(at);
                /* `{ .field = … }` value adopts the target's type, the way
                 * a var initializer does, so checkExpr can resolve fields */
                if (atgt != 0 && av.index != 0)
                {
                    Node* avn = self.ctx.nodes + av.index;
                    if (avn.kind.tag == NodeKind::Expr)
                    {
                        Expr* ave = &avn.kind.payload.Expr.value;
                        if (ave->kind.tag == ExprKind::StructLiteral &&
                            ave->kind.payload.StructLiteral.typeNode == 0)
                            ave->kind.payload.StructLiteral.typeNode = atgt;
                    }
                }
                if (!self.checkExpr(av)) return false;
                /* untyped `{ … }` adopts the target type, as in
                 * struct-literal fields and var initializers */
                if (self.exprType(av) == 0 && self.isBraceLiteral(av))
                {
                    Ty bt = atgt;
                    while (bt != 0)
                    {
                        TypeEntry* te = self.ctx.types + bt;
                        if (te->kind.tag == TypeKind::Const) bt = te->kind.payload.Const.base;
                        else if (te->kind.tag == TypeKind::Comptime) bt = te->kind.payload.Comptime.base;
                        else break;
                    }
                    /* a slice borrows memory it does not own: a fresh
                     * brace literal has no storage to point at */
                    if (bt != 0 && (self.ctx.types + bt)->kind.tag == TypeKind::Slice)
                    {
                        String msg = String::new();
                        msg.pushView("cannot assign a brace literal to a slice");
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, av, msg.asView());
                        return true;
                    }
                    self.coerceArrayLit(av, atgt);
                }
                if (!self.checkAssign(av, self.exprType(av), atgt))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, av,
                        self.typeMismatchMsg("assignment", self.exprType(av), atgt));
                if (self.sameIdentExpr(at, av))
                    self.semaWarnNode(ErrorCode::SemaSelfAssign, at,
                        "self-assignment has no effect");
                return true;
            },
            ExprKind::AssignAdd => {
                if (!self.assignExpr(expr->kind.payload.AssignAdd.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignAdd.value)) return false;
                NodeId av = expr->kind.payload.AssignAdd.value;
                Ty atgt = self.assignTargetType(expr->kind.payload.AssignAdd.target);
                // `p += 1` is pointer arithmetic, not an int→pointer bind
                if (!self.intToPtrAssign(av, self.exprType(av), atgt) &&
                    !self.checkAssign(av, self.exprType(av), atgt))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, av,
                        self.typeMismatchMsg("compound assignment", self.exprType(av), atgt));
                return true;
            },
            ExprKind::AssignSub => {
                if (!self.assignExpr(expr->kind.payload.AssignSub.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignSub.value)) return false;
                NodeId av = expr->kind.payload.AssignSub.value;
                Ty atgt = self.assignTargetType(expr->kind.payload.AssignSub.target);
                if (!self.intToPtrAssign(av, self.exprType(av), atgt) &&
                    !self.checkAssign(av, self.exprType(av), atgt))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, av,
                        self.typeMismatchMsg("compound assignment", self.exprType(av), atgt));
                return true;
            },
            /* only += and -= get the int→pointer treatment (pointer
             * arithmetic); *= /= %= &= |= ^= <<= >>= just walk target and
             * value; NO type check. `x *= "hi"` type-checks today. */
            ExprKind::AssignMul => {
                if (!self.assignExpr(expr->kind.payload.AssignMul.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignMul.value)) return false;
                return true;
            },
            ExprKind::AssignDiv => {
                if (!self.assignExpr(expr->kind.payload.AssignDiv.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignDiv.value)) return false;
                return true;
            },
            ExprKind::AssignMod => {
                if (!self.assignExpr(expr->kind.payload.AssignMod.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignMod.value)) return false;
                return true;
            },
            ExprKind::AssignBitAnd => {
                if (!self.assignExpr(expr->kind.payload.AssignBitAnd.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitAnd.value)) return false;
                return true;
            },
            ExprKind::AssignBitOr => {
                if (!self.assignExpr(expr->kind.payload.AssignBitOr.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitOr.value)) return false;
                return true;
            },
            ExprKind::AssignBitXor => {
                if (!self.assignExpr(expr->kind.payload.AssignBitXor.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignBitXor.value)) return false;
                return true;
            },
            ExprKind::AssignShl => {
                if (!self.assignExpr(expr->kind.payload.AssignShl.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignShl.value)) return false;
                return true;
            },
            ExprKind::AssignShr => {
                if (!self.assignExpr(expr->kind.payload.AssignShr.target)) return false;
                if (!self.checkExpr(expr->kind.payload.AssignShr.value)) return false;
                return true;
            },
            ExprKind::TupleField => {
                if (!self.checkExpr(expr->kind.payload.TupleField.obj)) return false;
                Ty objTy = self.stripType(self.exprType(expr->kind.payload.TupleField.obj));
                if (objTy == 0) return false;
                TypeEntry* te = self.ctx.types + objTy;
                if (te->kind.tag != TypeKind::Tuple) return false;
                // `n.1`: source indices are 1-based (codegen emits ._1)
                u32 tIdx = expr->kind.payload.TupleField.index;
                if (tIdx == 0 || tIdx > te->kind.payload.Tuple.elemsLen)
                {
                    String msg = String::new();
                    msg.pushView("tuple index ");
                    self.pushDec(&msg, (u64)tIdx);
                    msg.pushView(" out of range for a ");
                    self.pushDec(&msg, (u64)te->kind.payload.Tuple.elemsLen);
                    msg.pushView("-element tuple");
                    self.semaErrorNode(ErrorCode::SemaIndexOutOfBounds, id, msg.asView());
                    return false;
                }
                self.setExprType(id, te->kind.payload.Tuple.elems[tIdx - 1]);
                return true;
            },
            ExprKind::StructLiteral => {
                if (!self.checkType(expr->kind.payload.StructLiteral.typeNode)) return false;
                Str variantName = expr->kind.payload.StructLiteral.variantName;
                if (variantName != 0)
                {
                    /* variant construction: fields must belong to the
                     * named variant of the variant decl behind typeNode */
                    Ty base = self.stripType(expr->kind.payload.StructLiteral.typeNode);
                    if (base == 0) return false;
                    TypeEntry* te = self.ctx.types + base;
                    if (te->kind.tag != TypeKind::Named)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "variant construction needs a variant type");
                        return false;
                    }
                    Symbol* symbol = self.lookupType(te->kind.payload.Named.name, te->loc);
                    if (symbol == null || symbol->declaration.index == 0)
                    {
                        self.semaErrorNode(ErrorCode::SemaUndeclaredIdent, id, self.nameMsg("unknown type name: ", te->kind.payload.Named.name));
                        return false;
                    }
                    Node* dn = self.ctx.nodes + symbol->declaration.index;
                    if (dn->kind.tag != NodeKind::Decl)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "variant construction needs a variant type");
                        return false;
                    }
                    Decl* decl = &dn->kind.payload.Decl.value;
                    if (decl->kind.tag != DeclKind::Variant)
                    {
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, self.nameMsgS("type '", te->kind.payload.Named.name, "' is not a variant"));
                        return false;
                    }
                    VariantVariant* vv = null;
                    u32 v = 0;
                    while (v < decl->kind.payload.Variant.variantsLen)
                    {
                        if (decl->kind.payload.Variant.variants[v].name == variantName)
                        {
                            vv = decl->kind.payload.Variant.variants + v;
                            break;
                        }
                        v++;
                    }
                    if (vv == null)
                    {
                        String msg = String::new();
                        msg.pushView("unknown variant case '");
                        msg.pushView(self.nameTextView(variantName));
                        msg.pushView("' in type '");
                        msg.pushView(self.nameTextView(te->kind.payload.Named.name));
                        msg.pushView("'");
                        self.pushAvailableVariantCases(&msg, decl);
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, msg.asView());
                        return false;
                    }
                    u32 i = 0;
                    Str* litNames = expr->kind.payload.StructLiteral.fieldNames;
                    while (i < expr->kind.payload.StructLiteral.fieldValuesLen)
                    {
                        Str fieldName;
                        if (litNames != 0) fieldName = litNames[i];
                        else
                        {
                            if (i >= vv->fieldsLen)
                            {
                                self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "too many positional fields in variant construction");
                                return false;
                            }
                            fieldName = vv->fieldNames[i];
                        }
                        Ty ft = 0;
                        u32 k = 0;
                        while (k < vv->fieldsLen)
                        {
                            if (vv->fieldNames[k] == fieldName)
                            {
                                ft = vv->fieldTypes[k];
                                break;
                            }
                            k++;
                        }
                        if (ft == 0)
                        {
                            self.semaErrorNode(ErrorCode::SemaUnknownMember, id, "unknown field in variant construction");
                            return false;
                        }
                    NodeId valueId = expr->kind.payload.StructLiteral.fieldValues[i];
                    if (!self.checkExpr(valueId)) return false;
                    Ty expected = self.substituteFieldTy(ft, expr->kind.payload.StructLiteral.typeNode);
                    Ty actual = self.exprType(valueId);
                    if (!self.checkAssign(valueId, actual, expected))
                    {
                        if (fieldName != 0)
                            self.semaErrorNode(ErrorCode::SemaTypeMismatch, valueId,
                                self.paramMismatchMsg(fieldName, actual, expected));
                        else
                            self.semaErrorNode(ErrorCode::SemaTypeMismatch, valueId,
                                self.typeMismatchMsg("field type", actual, expected));
                    }
                    if (actual == 0) self.coerceArrayLit(valueId, expected);
                        i++;
                    }
                    self.setExprType(id, expr->kind.payload.StructLiteral.typeNode);
                    return true;
                }
                u32 i = 0;
                Str* litNames = expr->kind.payload.StructLiteral.fieldNames;
                while (i < expr->kind.payload.StructLiteral.fieldValuesLen)
                {
                    // named fields resolve by name; the arg-list form
                    // (`Pair { 1, 2 }`) falls back to positional lookup
                    MemberInfo member;
                    if (litNames != 0) member = self.findMember(expr->kind.payload.StructLiteral.typeNode, litNames[i]);
                    else member = self.findMemberByIndex(expr->kind.payload.StructLiteral.typeNode, i);
                    if (member.typeNode == 0)
                    {
                        u8* tb = alloc<u8>(256);
                        String msg = String::new();
                        Ty litTy = self.stripType(expr->kind.payload.StructLiteral.typeNode);
                        if (litNames != 0)
                        {
                            msg.pushView("unknown field '");
                            msg.pushView(self.nameTextView(litNames[i]));
                            msg.pushView("' in struct literal of type '");
                            if (tb != null) { msg.pushView(self.typeTextView(litTy, tb, 256)); dealloc<u8>(tb); }
                            else msg.pushView("?");
                            msg.pushView("'");
                            Str close = self.closestField(litTy, litNames[i]);
                            if (close != 0)
                            {
                                msg.pushView("\n\ndid you mean '");
                                msg.pushView(self.nameTextView(close));
                                msg.pushView("'?");
                            }
                        }
                        else
                        {
                            msg.pushView("too many positional fields in struct literal of type '");
                            if (tb != null) { msg.pushView(self.typeTextView(litTy, tb, 256)); dealloc<u8>(tb); }
                            else msg.pushView("?");
                            msg.pushView("'");
                        }
                        self.pushAvailableFields(&msg, litTy);
                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, msg.asView());
                        return false;
                    }
                    NodeId valueId = expr->kind.payload.StructLiteral.fieldValues[i];
                    if (!self.checkExpr(valueId)) return false;
                    Ty expected = self.substituteFieldTy(member.typeNode, expr->kind.payload.StructLiteral.typeNode);
                    Ty actual = self.exprType(valueId);
                    if (!self.checkAssign(valueId, actual, expected))
                    {
                        if (litNames != 0)
                            self.semaErrorNode(ErrorCode::SemaTypeMismatch, valueId,
                                self.paramMismatchMsg(litNames[i], actual, expected));
                        else
                            self.semaErrorNode(ErrorCode::SemaTypeMismatch, valueId,
                                self.typeMismatchMsg("struct field type", actual, expected));
                    }
                    if (actual == 0) self.coerceArrayLit(valueId, expected);
                    i++;
                }
                self.setExprType(id, expr->kind.payload.StructLiteral.typeNode);
                return true;
            },
            ExprKind::ArrayLiteral => {
                u32 i = 0;
                while (i < expr->kind.payload.ArrayLiteral.elemsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.ArrayLiteral.elems[i])) return false;
                    i++;
                }
                return true;
            },
            ExprKind::StaticCall => {
                u32 i = 0;
                while (i < expr->kind.payload.StaticCall.argsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.StaticCall.args[i])) return false;
                    i++;
                }
                Ty ownerTy = self.namedType(expr->kind.payload.StaticCall.typeName);
                MemberInfo methodInfo = self.findMethod(ownerTy, expr->kind.payload.StaticCall.method);
                if (methodInfo.declaration.index == 0)
                {
                    u8* mbuf = alloc<u8>(128);
                    String msg = String::new();
                    msg.pushView("static method '");
                    msg.pushView(self.nameTextView(expr->kind.payload.StaticCall.method));
                    msg.pushView("' not found on type '");
                    if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView("?");
                    msg.pushView("'");
                    self.semaErrorNode(ErrorCode::SemaUnknownMember, id, msg.asView());
                    dealloc<u8>(mbuf);
                    return false;
                }
                Node* methodNode = self.ctx.nodes + methodInfo.declaration.index;
                Decl* methodDecl = &methodNode->kind.payload.Decl.value;
                if ((methodDecl->kind.payload.Func.flags & 4) == 0)
                {
                    u8* mbuf = alloc<u8>(128);
                    String msg = String::new();
                    msg.pushView("method '");
                    msg.pushView(self.nameTextView(expr->kind.payload.StaticCall.method));
                    msg.pushView("' on type '");
                    if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView("?");
                    msg.pushView("' is not static; it needs a receiver");
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, msg.asView());
                    dealloc<u8>(mbuf);
                    return false;
                }
                u32 paramsLen = methodDecl->kind.payload.Func.paramsLen;
                if (paramsLen != expr->kind.payload.StaticCall.argsLen)
                {
                    String msg = String::new();
                    msg.pushView("wrong number of arguments to static method '");
                    msg.pushView(self.nameTextView(methodDecl->kind.payload.Func.name));
                    msg.pushView("': expected ");
                    self.pushDec(&msg, (u64)paramsLen);
                    msg.pushView(", got ");
                    self.pushDec(&msg, (u64)expr->kind.payload.StaticCall.argsLen);
                    self.semaErrorNode(ErrorCode::SemaArityMismatch, id, msg.asView());
                    return false;
                }
                i = 0;
                while (i < expr->kind.payload.StaticCall.argsLen)
                {
                    NodeId paramId = methodDecl->kind.payload.Func.params[i];
                    Node* paramNode = self.ctx.nodes + paramId.index;
                    if (paramNode->kind.tag == NodeKind::Param)
                    {
                        Param* param = &paramNode->kind.payload.Param.value;
                        NodeId sarg = expr->kind.payload.StaticCall.args[i];
                        if (!self.checkAssign(sarg, self.exprType(sarg), param->typeNode))
                        {
                            if (param->name != 0)
                                self.semaErrorNode(ErrorCode::SemaTypeMismatch, sarg,
                                    self.paramMismatchMsg(param->name, self.exprType(sarg), param->typeNode));
                            else
                                self.semaErrorNode(ErrorCode::SemaTypeMismatch, sarg,
                                    self.typeMismatchMsg("static method argument type", self.exprType(sarg), param->typeNode));
                        }
                    }
                    i++;
                }
                self.setExprType(id, methodDecl->kind.payload.Func.returnType);
                return true;
            },
            ExprKind::BuiltinCall => {
                u32 i = 0;
                while (i < expr->kind.payload.BuiltinCall.argsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.BuiltinCall.args[i])) return false;
                    i++;
                }
                Str bname = expr->kind.payload.BuiltinCall.name;
                /* @compileError("msg"): a hard compile-time error carrying
                 * the user message. Inside a comptime block the evaluator
                 * handles it (only the matching switch arm reaches it);
                 * sema must NOT flag it during the blanket walk of all
                 * arms; otherwise `else => { @compileError(...) }` fires
                 * even when a prior arm matched. */
                if (bname == self.ctx.intern("compileError"))
                {
                    if (self.comptimeDepth > 0)
                    {
                        // inside comptime: the evaluator decides reachability
                        self.setExprType(id, self.boolType());
                        return true;
                    }
                    str msgPtr = "@compileError tripped";
                    usize msgLen = 21;
                    NodeId msgNodeId;
                    msgNodeId.index = 0;
                    if (expr->kind.payload.BuiltinCall.argsLen > 0)
                        msgNodeId = expr->kind.payload.BuiltinCall.args[0];
                    if (msgNodeId.index != 0)
                    {
                        Node* mn = self.ctx.nodes + msgNodeId.index;
                        if (mn->kind.tag == NodeKind::Expr &&
                            mn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        {
                            Str litStr = mn->kind.payload.Expr.value.kind.payload.StringLit.value;
                            if (litStr != 0 && litStr < self.ctx.internsLen)
                            {
                                msgPtr = str { .ptr = self.ctx.interns[litStr].ptr, .len = self.ctx.interns[litStr].len };
                                msgLen = self.ctx.interns[litStr].len;
                            }
                        }
                    }
                    u8* msgBuf = alloc<u8>(msgLen + 1);
                    usize cpI = 0;
                    while (cpI < msgLen) { msgBuf[cpI] = msgPtr.ptr[cpI]; cpI++; }
                    msgBuf[msgLen] = 0;
                    // (usize) on a void call: does nothing, the value is dropped.
                    // leftover artifact, kept exactly as-is
                    (usize)self.semaErrorNode(ErrorCode::ComptimeError, id, str { .ptr = msgBuf, .len = (usize)msgLen });
                    return false;
                }
                /* @isFormatLiteral(expr): true only when the given
                 * argument is a string literal (comptime path gate). */
                if (bname == self.ctx.intern("isFormatLiteral"))
                {
                    bool lit = false;
                    if (expr->kind.payload.BuiltinCall.argsLen == 1)
                    {
                        NodeId nid = expr->kind.payload.BuiltinCall.args[0];
                        if (nid.index != 0)
                        {
                            Node* nn = self.ctx.nodes + nid.index;
                            if (nn->kind.tag == NodeKind::Expr &&
                                nn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                                lit = true;
                        }
                    }
                    // sic: both ternary arms are boolType(). lit doesn't pick a
                    // type; @isFormatLiteral always yields bool
                    self.setExprType(id, lit ? self.boolType() : self.boolType());
                    return true;
                }
                /* @typeof(x): the type of x, only inside comptime blocks,
                 * and only on a type name, a variable, or a literal
                 * (int/float/bool/null/str). not on arbitrary expressions. */
                if (bname == self.ctx.intern("typeof"))
                {
                    if (self.comptimeDepth == 0)
                    {
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id,
                            "@typeof is only allowed inside a comptime block");
                        return false;
                    }
                    if (expr->kind.payload.BuiltinCall.argsLen != 1)
                    {
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id,
                            "@typeof takes exactly one argument");
                        return false;
                    }
                    NodeId aid = expr->kind.payload.BuiltinCall.args[0];
                    Node* an = self.ctx.nodes + aid.index;
                    if (an == null || an->kind.tag != NodeKind::Expr)
                    {
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id,
                            "@typeof argument must be a type, variable, or literal");
                        return false;
                    }
                    Expr* ae = &an->kind.payload.Expr.value;
                    u8 akind = 0;
                    // 1=literal 2=ident/var 3=type
                    if (ae->kind.tag == ExprKind::IntLit ||
                        ae->kind.tag == ExprKind::FloatLit ||
                        ae->kind.tag == ExprKind::BoolLit ||
                        ae->kind.tag == ExprKind::NullLit ||
                        ae->kind.tag == ExprKind::StringLit ||
                        ae->kind.tag == ExprKind::CharLit)
                        akind = 1;
                    else if (ae->kind.tag == ExprKind::Ident)
                        akind = 2;
                    else if (ae->kind.tag == ExprKind::TypeRef)
                        akind = 3;
                    else
                    {
                        self.semaErrorNode(ErrorCode::SemaTypeMismatch, id,
                            "@typeof argument must be a type, variable, or literal");
                        return false;
                    }
                    // resolve the type of the argument
                    #[[maybe_unused]]
                    Ty argTy = 0;
                    if (akind == 3)
                        argTy = ae->kind.payload.TypeRef.typeNode;
                    else
                    {
                        if (!self.checkExpr(aid)) return false;
                        argTy = self.exprType(aid);
                    }
                    /* @typeof returns a type as a comptime value; the
                     * expression is typed as the type-of-types placeholder
                     * (u64) so it can flow into comptime switch arms */
                    self.setExprType(id, self.u64Type());
                    return true;
                }
                return true;
            },
            ExprKind::TupleExpr => {
                u32 i = 0;
                while (i < expr->kind.payload.TupleExpr.elemsLen)
                {
                    if (!self.checkExpr(expr->kind.payload.TupleExpr.elems[i])) return false;
                    i++;
                }
                // type the literal as a tuple of the element types
                u32 n = expr->kind.payload.TupleExpr.elemsLen;
                if (n > 0)
                {
                    Ty* elems = alloc<Ty>((usize)n);
                    if (elems != null)
                    {
                        u32 j = 0;
                        bool allTyped = true;
                        while (j < n)
                        {
                            Ty et = self.exprType(expr->kind.payload.TupleExpr.elems[j]);
                            if (et == 0) allTyped = false;
                            elems[j] = et;
                            j++;
                        }
                        if (allTyped)
                        {
                            TypeKind k;
                            k = TypeKind::Tuple{ .elems = elems, .elemsLen = n };
                            self.setExprType(id, self.allocType(k));
                        }
                    }
                }
                return true;
            },
            ExprKind::BlockExpr => {
                u32 i = 0;
                while (i < expr->kind.payload.BlockExpr.stmtsLen)
                {
                    if (!self.checkStmt(expr->kind.payload.BlockExpr.stmts[i])) return false;
                    i++;
                }
                if (!self.checkExpr(expr->kind.payload.BlockExpr.result)) return false;
                Ty bty = self.exprType(expr->kind.payload.BlockExpr.result);
                if (bty != 0) self.setExprType(id, bty);
                return true;
            },
            ExprKind::Ternary => {
                if (!self.checkExpr(expr->kind.payload.Ternary.cond)) return false;
                Ty ternCondTy = self.exprType(expr->kind.payload.Ternary.cond);
                if (ternCondTy != 0 && ternCondTy != self.boolType() && !self.integerType(ternCondTy) && !self.pointerLike(ternCondTy))
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.truthyCondMsg("ternary condition", ternCondTy));
                if (!self.checkExpr(expr->kind.payload.Ternary.thenExpr)) return false;
                if (!self.checkExpr(expr->kind.payload.Ternary.elseExpr)) return false;
                Ty thenTy = self.exprType(expr->kind.payload.Ternary.thenExpr);
                Ty elseTy = self.exprType(expr->kind.payload.Ternary.elseExpr);
                if (thenTy == 0) thenTy = elseTy;
                if (elseTy == 0) elseTy = thenTy;
                Ty ternTy = thenTy;
                if (!self.compatible(thenTy, elseTy))
                {
                    /* literal branches (`cond ? x : 0`) convert the way
                     * initializers do; bool branch vs integer branch unifies
                     * to the integer side (generated C promotes the bool) */
                    if (self.assignCompatible(expr->kind.payload.Ternary.thenExpr, thenTy, elseTy)) ternTy = elseTy;
                    else if (self.assignCompatible(expr->kind.payload.Ternary.elseExpr, elseTy, thenTy)) ternTy = thenTy;
                    else if (thenTy == self.boolType() && self.integerType(elseTy)) ternTy = elseTy;
                    else if (elseTy == self.boolType() && self.integerType(thenTy)) ternTy = thenTy;
                    else self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.typeMismatchMsg("ternary then-branch", thenTy, elseTy));
                }
                self.setExprType(id, ternTy);
                return true;
            },
            ExprKind::PostInc => { if (!self.assignExpr(expr->kind.payload.PostInc.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PostInc.expr)); return true; },
            ExprKind::PostDec => { if (!self.assignExpr(expr->kind.payload.PostDec.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PostDec.expr)); return true; },
            ExprKind::PreInc => { if (!self.assignExpr(expr->kind.payload.PreInc.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PreInc.expr)); return true; },
            ExprKind::PreDec => { if (!self.assignExpr(expr->kind.payload.PreDec.expr)) return false; self.setExprType(id, self.exprType(expr->kind.payload.PreDec.expr)); return true; },
            ExprKind::Spread => {
                /* `...pack` in a call arg list: the pack itself; arity and
                 * per-arg checks for the spread tail are the call checker's
                 * job. bare `...` (expr=none) forwards the enclosing
                 * variadic pack and has no inner expr to type. */
                NodeId spreadInner = expr->kind.payload.Spread.expr;
                if (spreadInner.index != 0)
                {
                    if (!self.checkExpr(spreadInner)) return false;
                    self.setExprType(id, self.exprType(spreadInner));
                }
                return true;
            },
            ExprKind::IfExpr => {
                if (!self.checkExpr(expr->kind.payload.IfExpr.cond)) return false;
                Ty ifExprCondTy = self.exprType(expr->kind.payload.IfExpr.cond);
                // unlike statement `if`, the expression form is strict bool
                // (no C truthiness, no null)
                if (ifExprCondTy != 0 && ifExprCondTy != self.boolType())
                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.typeMismatchMsg("if-expression condition", ifExprCondTy, self.boolType()));
                if (!self.checkExpr(expr->kind.payload.IfExpr.thenBody)) return false;
                if (!self.checkExpr(expr->kind.payload.IfExpr.elseBody)) return false;
                Ty thenTy = self.exprType(expr->kind.payload.IfExpr.thenBody);
                Ty elseTy = self.exprType(expr->kind.payload.IfExpr.elseBody);
                if (thenTy == 0) thenTy = elseTy;
                if (elseTy == 0) elseTy = thenTy;
                // one branch's type becomes the result; an untyped branch
                // (null literal) adopted the other's before we got here
                if (!self.compatible(thenTy, elseTy)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.typeMismatchMsg("if-expression then-branch", thenTy, elseTy));
                self.setExprType(id, thenTy);
                return true;
            },
            ExprKind::SwitchExpr => {
                if (!self.checkExpr(expr->kind.payload.SwitchExpr.expr)) return false;
                Ty resultTy = 0;
                bool ok = true;
                u32 i = 0;
                while (i < expr->kind.payload.SwitchExpr.casesLen)
                {
                    SwitchCase* switchCase = expr->kind.payload.SwitchExpr.cases + i;
                    u32 p = 0;
                    while (p < switchCase->patternsLen)
                    {
                        if (!self.checkExpr(switchCase->patterns[p])) ok = false;
                        p++;
                    }
                    if (switchCase->guard.index != 0)
                    {
                        if (!self.checkExpr(switchCase->guard)) ok = false;
                    }
                    if (!self.checkExpr(switchCase->body)) ok = false;
                    Ty bodyTy = self.exprType(switchCase->body);
                    /* a case body that is a block value yields the type of
                       its trailing expression statement */
                    if (bodyTy == 0 && switchCase->body.index != 0)
                    {
                        Node* bn = self.ctx.nodes + switchCase->body.index;
                        if (bn->kind.tag == NodeKind::Stmt &&
                            bn->kind.payload.Stmt.value.kind.tag == StmtKind::Block)
                        {
                            Stmt* blk = &bn->kind.payload.Stmt.value;
                            u32 si = blk->kind.payload.Block.stmtsLen;
                            while (si > 0)
                            {
                                si--;
                                Node* inn = self.ctx.nodes + blk->kind.payload.Block.stmts[si].index;
                                if (inn->kind.tag != NodeKind::Stmt) continue;
                                if (inn->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)
                                {
                                    bodyTy = self.exprType(inn->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
                                    break;
                                }
                                if (inn->kind.payload.Stmt.value.kind.tag == StmtKind::Return &&
                                    inn->kind.payload.Stmt.value.kind.payload.Return.value.index != 0)
                                {
                                    bodyTy = self.exprType(inn->kind.payload.Stmt.value.kind.payload.Return.value);
                                    break;
                                }
                            }
                        }
                    }
                    if (bodyTy != 0)
                    {
                        if (resultTy == 0) resultTy = bodyTy;
                        else if (!self.compatible(bodyTy, resultTy)) self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.typeMismatchMsg("switch arm", bodyTy, resultTy));
                    }
                    i++;
                }
                self.setExprType(id, resultTy);
                return ok;
            },
            else => {
                self.semaErrorNode(ErrorCode::SemaInternal, id, "unhandled expression kind in checkExpr");
                return false;
            }
        }
    }
}
