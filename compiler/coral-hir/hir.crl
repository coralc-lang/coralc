#[[no_drop_all]]
/* coral-hir/hir.crl: in-memory HIR produced after sema/mono; `print` renders.
 *
 * Design (HANDOFF § "HIR text format"): a single, self-contained form
 * produced after sema + import resolution + monomorphization, everything
 * the backend needs already resolved/named. `build` constructs it; text
 * is emitted only when `print` is called.
 */

import context::context;

import ast::id { Str, NodeId };
import ast::types { Ty, TypeEntry, TypeKind };
import ast::node { Node, NodeKind };
import ast::decl { Decl, DeclKind, File, Param };
import context::context { AstContext };
import mono::mono { MonoContext, MonoInstance, MonoInstanceKind };

import(lib) core::cchar { cchar };
import(lib) platform::libc { printf };
import(lib) std::mman { alloc };
import(lib) std::vec { Vec };

pub struct HirModule
{
    Str name;         /* module path or file name */
    Vec<Str> items;   /* item names (fn/struct/variant/enum/union); later: Styles */
    Vec<Str> monos;   /* instance names for mono fns/types */
}

pub HirModule* build(AstContext* ctx, File* file, MonoContext* mono, Str name)
{
    HirModule* m = alloc<HirModule>(1);
    m->name = name;
    m->items = Vec<Str>::new();
    m->monos = Vec<Str>::new();

    u32 i = 0;
    while (i < file->declsLen)
    {
        Node* dn = ctx->nodes + file->decls[i].index;
        i++;
        if (dn.kind.tag != NodeKind::Decl) continue;
        Decl* dd = &dn.kind.payload.Decl.value;
        Str item = 0;
        bool have = false;
        if (dd.kind.tag == DeclKind::Func) { item = dd.kind.payload.Func.name; have = true; }
        else if (dd.kind.tag == DeclKind::Struct) { item = dd.kind.payload.Struct.name; have = true; }
        else if (dd.kind.tag == DeclKind::Variant) { item = dd.kind.payload.Variant.name; have = true; }
        else if (dd.kind.tag == DeclKind::Enum) { item = dd.kind.payload.Enum.name; have = true; }
        else if (dd.kind.tag == DeclKind::Union) { item = dd.kind.payload.Union.name; have = true; }
        if (have)
        {
            m->items.push(item);
        }
    }

    if (mono != null)
    {
        u32 k = 0;
        while (k < mono->instancesLen)
        {
            MonoInstance* inst = mono->instances + k;
            m->monos.push(inst.name);
            k++;
        }
    }
    return m;
}

pub void printHir(AstContext* ctx, HirModule* m)
{
    if (m->name != 0 && m->name < ctx->internsLen) printf(C"module @%.*s\n", (i32)ctx->interns[m->name].len, ctx->interns[m->name].ptr);

    printf(C"  items:\n");
    u32 i = 0;
    while (i < (u32)m->items.len)
    {
        Str it = m->items.at((usize)i);
        if (it != 0 && it < ctx->internsLen) printf(C"    %.*s\n", (i32)ctx->interns[it].len, ctx->interns[it].ptr);
        i++;
    }
    printf(C"  mono:\n");
    i = 0;
    while (i < (u32)m->monos.len)
    {
        printf(C"    #%d ", i);
        Str it = m->monos.at((usize)i);
        if (it != 0 && it < ctx->internsLen) printf(C"%.*s\n", (i32)ctx->interns[it].len, ctx->interns[it].ptr);
        i++;
    }
}
