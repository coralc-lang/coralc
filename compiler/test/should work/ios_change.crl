// pub void print<comptime T>(T fmt, ...)
// {
//     u8[1024] outBuf;
//     _Buf out = { .fd = 1, .data = outBuf, .len = 0 };
//     comptime { _printEmit(&out, fmt, ...); }  // this part in io should also error, this is a hack, and would stop real variadics from being differentiated from comptime variadics.
//      // it was just made to let print work. 
//      // _printEmit was declared as with .. args, specifying that args is a comptime pack, and not a runtime variadic.  but println, pases it direct, becaue we used a hack to get it working.
//     _pflush(&out);
// }

// argument renders through the comptime switch above or its own toStr.
void _printEmit<comptime T>(_Buf* out, T fmt, ... args); // ... with a name specifies that it is a comptime pack, and it should not work on a non comptime function. 

// the correct definition would be:

pub void print<comptime T>(T fmt, ... args) // args actually specified to be a comptime pack, for out remaining arguments, 
{
    u8[1024] outBuf;
    _Buf out = { .fd = 1, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, args); } // args actually specified as the comptime pack we are passing as an argument to the space requiring a comptime pack
    _pflush(&out);
}

// this should be enforced. and would need changes on ios. 
// but it is better than leaving it, then having a codegen issue later on.