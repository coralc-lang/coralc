#[[no_drop_all]]
/* source/source.crl: source manager with file table
 *
 * Owns file contents and line offset tables.
 * Converts byte offsets to (line, col) via binary search.
 * Follows Clang's SourceManager design (simplified, no include stack yet).
 */

import ast::id { Str };
import(lib) std::mman { alloc, dealloc };

pub struct SourceFile
{
    Str path;
    u8* bytes;
    usize len;
    u32* lineStarts;
    u32 lineCount;
    u32 lineCap;
}

pub struct SourceManager
{
    SourceFile* files;
    u32 filesLen;
    u32 filesCap;

    void init(u32 fileCap)
    {
        self.files = alloc<SourceFile>((usize)fileCap);
        self.filesLen = 0;
        self.filesCap = fileCap;
    }

    void deinit()
    {
        u32 i = 0;
        while (i < self.filesLen)
        {
            SourceFile* f = self.files + i;
            dealloc<u32>(f.lineStarts);
            i++;
        }
        dealloc<SourceFile>(self.files);
    }

    u32 addFile(Str path, u8* bytes, usize len)
    {
        if (self.filesLen >= self.filesCap) return 0;
        u32 id = self.filesLen;
        SourceFile* f = self.files + id;
        f.path = path;
        f.bytes = bytes;
        f.len = len;
        f.lineStarts = alloc<u32>(1024);
        f.lineCap = 1024;
        f.lineCount = 1;
        u32* ls = f.lineStarts;
        ls[0] = 0;
        usize i = 0;
        while (i < len)
        {
            u8* p = bytes + i;
            if (p[0] == 10)
            {
                if (f.lineCount < f.lineCap)
                {
                    u32* dst = f.lineStarts + f.lineCount;
                    dst[0] = i + 1;
                    f.lineCount++;
                }
            }
            i++;
        }
        self.filesLen++;
        return id;
    }

    u32 lineForOffset(u32 fileId, u32 offset)
    {
        SourceFile* f = self.files + fileId;
        u32 lo = 0;
        u32 hi = f.lineCount;
        while (lo < hi)
        {
            u32 mid = (lo + hi) / 2;
            u32* ls = f.lineStarts + mid;
            if (ls[0] <= offset) {
                lo = mid + 1;
            }
            else {
                hi = mid;
            }
        }
        return lo;
    }

    u32 colForOffset(u32 fileId, u32 offset)
    {
        SourceFile* f = self.files + fileId;
        u32 line = self.lineForOffset(fileId, offset);
        u32* ls = f.lineStarts + (line - 1);
        return offset - ls[0];
    }
}
