#[[no_drop_all]]
/* frontend/init.crl: `coralc init [dir]` scaffolds a new project:
 *   dir/coral.crlb, dir/.coral/, dir/src/lib.crl
 */

import common::slice { Slice };
import args { Options };
import io { readFile, writeFile };
import build::builder { bFileExists };
import(lib) core::cchar { cchar };
import(lib) platform::libc { printf };
import(lib) std::mman { alloc, dealloc };
import(lib) std::fs { IoError, createDirRecursive };

str inJoin(str a, str b)
{
    usize n = a.len + b.len;
    u8* p = alloc<u8>(n + 1);
    if (p == null) return str { .ptr = null, .len = 0 };
    usize i = 0;
    while (i < a.len) { p[i] = a.ptr[i]; i++; }
    usize j = 0;
    while (j < b.len) { p[a.len + j] = b.ptr[j]; j++; }
    p[n] = 0;
    return str { .ptr = p, .len = n };
}

Slice inBaseName(Slice dir)
{
    usize end = dir.len;
    while (end > 0 && dir.ptr[end - 1] == 47) end--;
    usize start = 0;
    usize i = 0;
    while (i < end)
    {
        if (dir.ptr[i] == 47) start = i + 1;
        i++;
    }
    return Slice::from(dir.ptr + start, end - start);
}

void inPut(u8* buf, usize cap, usize* len, str s)
{
    usize i = 0;
    while (i < s.len && *len < cap)
    {
        buf[*len] = s.ptr[i];
        *len = *len + 1;
        i++;
    }
}

void inPutSlice(u8* buf, usize cap, usize* len, Slice s)
{
    usize i = 0;
    while (i < s.len && *len < cap)
    {
        buf[*len] = s.ptr[i];
        *len = *len + 1;
        i++;
    }
}

bool inEqN(Slice s, usize start, str lit)
{
    usize i = 0;
    while (i < lit.len)
    {
        if (start + i >= s.len) return false;
        if (s.ptr[start + i] != lit.ptr[i]) return false;
        i++;
    }
    return true;
}

/* does the .gitignore already mention the .coral folder (any depth)? */
bool inHasIgnore(Slice s)
{
    usize i = 0;
    while (i < s.len)
    {
        usize start = i;
        while (i < s.len && s.ptr[i] != 10) i++;
        usize end = i;
        if (i < s.len) i++;
        while (end > start && (s.ptr[start] == 32 || s.ptr[start] == 9)) start++;
        while (end > start && (s.ptr[end - 1] == 32 || s.ptr[end - 1] == 9 || s.ptr[end - 1] == 13)) end--;
        usize n = end - start;
        if (n > 3 && inEqN(s, start, "**/")) { start = start + 3; n = n - 3; }
        if (n == 6 && inEqN(s, start, ".coral")) return true;
        if (n == 7 && inEqN(s, start, ".coral/")) return true;
    }
    return false;
}

pub i32 runInit(Options* opts)
{
    str dir = opts->input.len > 0 ? opts->input.asStr() : Slice::fromStr(".").asStr();
    while (dir.len > 1 && dir.ptr[dir.len - 1] == 47) dir.len = dir.len - 1;

    Slice name = opts->input.len > 0 ? inBaseName(opts->input) : Slice::fromStr("app");
    if (name.len == 0 || (name.len == 1 && name.ptr[0] == 46))
    {
        name = Slice::fromStr("app");
    }

    str crlbPath = inJoin(dir, "/coral.crlb");
    str coralDir = inJoin(dir, "/.coral");
    str srcDir = inJoin(dir, "/src");
    str libPath = inJoin(dir, "/src/lib.crl");
    if (crlbPath.ptr == null || libPath.ptr == null) return 1;

    if (bFileExists(crlbPath))
    {
        printf(C"coralc: %s already exists; refusing to overwrite\n", (cchar*)crlbPath.ptr);
        return 1;
    }

    createDirRecursive(coralDir, 493);
    createDirRecursive(srcDir, 493);

    u8* buf = alloc<u8>(4096);
    if (buf == null) return 1;
    usize len = 0;
    inPut(buf, 4096, &len, "build \"");
    inPutSlice(buf, 4096, &len, name);
    inPut(buf, 4096, &len, "\" {\n    root    = \".\";\n    entry   = \"src\";\n    target  = \"native-x86_64\";\n    opt     = \"debug\";\n    output  = \"build/");
    inPutSlice(buf, 4096, &len, name);
    inPut(buf, 4096, &len, "\";\n    modules = [\"src\"];\n}\n");

    bool ok = writeFile(crlbPath, Slice::from(buf, len));
    if (ok)
    {
        ok = writeFile(libPath, Slice::fromStr("// public surface of src\n\npub void main()\n{\n    println(\"Hello, World!\");\n}\n"));
    }
    dealloc<u8>(buf);
    if (!ok)
    {
        printf(C"coralc: cannot write scaffold files under %s\n", (cchar*)dir.ptr);
        return 1;
    }

    /* keep build artifacts and the module cache out of git */
    str giPath = inJoin(dir, "/.gitignore");
    if (bFileExists(giPath))
    {
        usize giLen = 0;
        Slice gi = readFile(giPath, &giLen);
        if (gi.ptr != null)
        {
            if (!inHasIgnore(gi))
            {
                bool needsNl = gi.len > 0 && gi.ptr[gi.len - 1] != 10;
                usize extra = 0;
                if (needsNl) extra = 1;
                usize need = gi.len + extra + 11;
                u8* nb = alloc<u8>(need);
                if (nb != null)
                {
                    usize k = 0;
                    while (k < gi.len) { nb[k] = gi.ptr[k]; k++; }
                    if (needsNl) { nb[k] = 10; k++; }
                    inPut(nb, need, &k, "**/.coral/\n**/build/");
                    if (writeFile(giPath, Slice::from(nb, k)))
                    {
                        printf(C"coralc: updated %s\n", (cchar*)giPath.ptr);
                    }
                    dealloc<u8>(nb);
                }
            }
            dealloc<u8>(gi.ptr);
        }
    }
    else if (writeFile(giPath, Slice::fromStr("**/.coral/\n**/build/")))
    {
        printf(C"coralc: created %s\n", (cchar*)giPath.ptr);
    }

    printf(C"coralc: created %s\n", (cchar*)crlbPath.ptr);
    printf(C"coralc: created %s\n", (cchar*)libPath.ptr);
    printf(C"coralc: created %s/\n", (cchar*)coralDir.ptr);
    printf(C"next: cd %s && coralc run\n", (cchar*)dir.ptr);
    return 0;
}
