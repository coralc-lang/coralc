#[[no_drop_all]]
// frontend/io.crl: file readers/writers shared by coralc.

import common::slice { Slice };
import(lib) std::mman { alloc, dealloc, realloc };
import(lib) std::io::fios { FileHandle, fileOpen, fileClose, fileRead, fileWrite };

pub Slice readFile(str path, usize* outLen)
{
    *outLen = 0;
    FileHandle fh = fileOpen(path, "rb").unwrapOr((FileHandle)0);
    if (fh == (FileHandle)0) return Slice::from(null, 0);
    usize cap = 65536;
    u8* buf = alloc<u8>(cap);
    if (buf == null) {
        fileClose(fh);
        return Slice::from(null, 0);
    }
    usize len = 0;
    while (true)
    {
        if (len + 1 >= cap)
        {
            usize newCap = cap * 2;
            u8* grown = realloc<u8>(buf, newCap);
            if (grown == null) {
                fileClose(fh);
                dealloc<u8>(buf);
                return Slice::from(null, 0);
            }
            buf = grown;
            cap = newCap;
        }
        usize got = fileRead(fh, buf + len, cap - 1 - len).unwrapOr(0);
        if (got == 0) break;
        len += got;
    }
    fileClose(fh);
    buf[len] = 0;
    *outLen = len;
    return Slice::from(buf, len);
}

pub u8* sliceCStr(Slice s)
{
    u8* p = alloc<u8>(s.len + 1);
    if (p == null) return null;
    usize i = 0;
    while (i < s.len) {
        p[i] = s.ptr[i];
        i++;
    }
    p[s.len] = 0;
    return p;
}

pub bool writeFile(str path, Slice data)
{
    FileHandle fh = fileOpen(path, "wb").unwrapOr((FileHandle)0);
    if (fh == (FileHandle)0) return false;
    bool ok = fileWrite(fh, str { .ptr = data.ptr, .len = data.len }).isOk();
    fileClose(fh);
    return ok;
}
