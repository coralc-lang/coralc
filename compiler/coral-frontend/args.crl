#[[no_drop_all]]
// frontend/args.crl: coralc command-line parsing.

import common::slice { Slice };
import io { sliceCStr };
import(lib) core::cchar { cchar };
import(lib) platform::libc { printf };
import(lib) std::io::cmd { commandLine };
import(lib) std::mman { alloc };
import(lib) std::option { Option };

pub enum Command { Build, Map, Init, Run, Compile, Task }
pub enum Flag { Help, Force, DryRun, MapOnly, Strict, File, Out, Other, Explain, Version, AllowIntPtr, Quiet, Set, NoPrelude, Opt, EmitC, ShowGcc, Serve, Platform, Extra }

pub struct Options
{
    Command cmd;
    Slice buildFile;
    bool buildFileSet;
    Slice input;
    Slice output;
    bool help;
    bool force;
    bool dryRun;
    bool mapOnly;
    bool strict;
    bool emitHir;
    bool version;
    Slice explain;
    bool explainSet;
    usize errorLimit;
    Slice* flagNames;
    Slice* flagValues;
    u32 flagsCount;
    bool allowIntPtr;
    bool noPrelude;
    bool quiet;
    Slice opt;
    bool emitC;
    bool showGcc;
    bool serve;
    bool extras;
}

bool aEq(Slice a, str b)
{
    if (a.len != b.len) return false;
    usize i = 0;
    while (i < b.len) {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

bool aStartsWith(Slice a, str p)
{
    if (a.len < p.len) return false;
    usize i = 0;
    while (i < p.len) { if (a.ptr[i] != p.ptr[i]) return false; i++; }
    return true;
}

pub bool addFlagPair(Options* opts, Slice key, Slice val)
{
    if (key.len == 0) return true;
    if (opts->flagsCount >= 32) return true;
    if (opts->flagNames == null)
    {
        opts->flagNames = alloc<Slice>(32);
        opts->flagValues = alloc<Slice>(32);
    }
    if (opts->flagNames == null || opts->flagValues == null) return false;
    opts->flagNames[opts->flagsCount] = key;
    opts->flagValues[opts->flagsCount] = val;
    opts->flagsCount++;
    return true;
}

/* --flag VALUE: the std form is brace-wrapped comma pairs:
 *   --flag {platform=windows,arch=x86_64,mode=debug}
 * a bare NAME=VALUE is also accepted (and may repeat) */
bool parseFlagValue(Options* opts, Slice val)
{
    if (val.len == 0)
    {
        printf(C"coralc: --flag needs {name=value,...} or name=value\n");
        return false;
    }
    usize start = 0;
    usize end = val.len;
    if (val.ptr[0] == 123 && val.ptr[end - 1] == 125) { start = 1; end--; }
    usize segStart = start;
    usize i = start;
    while (i <= end)
    {
        if (i == end || val.ptr[i] == 44)
        {
            usize eq = segStart;
            while (eq < i && val.ptr[eq] != 61) eq++;
            if (eq > segStart)
            {
                if (!addFlagPair(opts, Slice::from(val.ptr + segStart, eq - segStart),
                                 Slice::from(val.ptr + eq + 1, i - eq - 1))) return false;
            }
            segStart = i + 1;
        }
        i++;
    }
    return true;
}

usize nextArg(str all, usize pos, Slice* out)
{
    while (pos < all.len && all.ptr[pos] == 0) pos++;
    if (pos >= all.len) {
        *out = Slice::from(null, 0);
        return pos;
    }
    usize start = pos;
    while (pos < all.len && all.ptr[pos] != 0) pos++;
    *out = Slice::from(all.ptr + start, pos - start);
    return pos;
}

Flag classifyFlag(Slice a)
{
    switch (a.len)
    {
        2 => {
            if (aEq(a, "-h")) return Flag::Help;
            if (aEq(a, "-f")) return Flag::File;
            if (aEq(a, "-o")) return Flag::Out;
            if (aEq(a, "-V")) return Flag::Version;
            if (aEq(a, "-w")) return Flag::Quiet;
        },
        5 => { if (aEq(a, "--opt")) return Flag::Opt; },
        6 => { if (aEq(a, "--help")) return Flag::Help; if (aEq(a, "--flag")) return Flag::Set; if (aEq(a, "--extra")) return Flag::Extra; },
        7 => { if (aEq(a, "--force")) return Flag::Force; if (aEq(a, "--serve")) return Flag::Serve; },
        8 => { if (aEq(a, "--strict")) return Flag::Strict; if (aEq(a, "--emit-c")) return Flag::EmitC; },
        9 => {
            if (aEq(a, "--dry-run")) return Flag::DryRun;
            if (aEq(a, "--explain")) return Flag::Explain;
            if (aEq(a, "--version")) return Flag::Version;
        },
        10 => { if (aEq(a, "--map-only")) return Flag::MapOnly; if (aEq(a, "--show-gcc")) return Flag::ShowGcc; if (aEq(a, "--platform")) return Flag::Platform; },
        12 => { if (aEq(a, "--no-prelude")) return Flag::NoPrelude; },
        15 => { if (aEq(a, "--allow-int-ptr")) return Flag::AllowIntPtr; },
        else => { return Flag::Other; }
    }
    /* a listed length that matched nothing, e.g. a .crl path of exactly
     * 15 chars, fell off the switch; return Other instead of garbage */
    return Flag::Other;
}

pub void usage2()
{
    printf(C"coralc <command> [options]\n");
    printf(C"commands:\n");
    printf(C"  build             build the project (default)\n");
    printf(C"  map               discover lib.crl folders, update the build file\n");
    printf(C"  init [dir]        scaffold a new project\n");
    printf(C"  run               build, then run the task \"run\" (or the output)\n");
    printf(C"  <file.crl>        compile a single file\n");
    printf(C"options:\n");
    printf(C"  -f <file>         build file (default coral.crlb, fallback build.crlb)\n");
    printf(C"  -o <file>         output file (single-file compile)\n");
    printf(C"  --opt <level>     optimization: debug (default), release, size, O3\n");
    printf(C"  --flag {k=v,...}  set build-time flags for flag (NAME) selection\n");
    printf(C"  --allow-int-ptr   permit int->pointer assignments (still reported)\n");
    printf(C"  -ferror-limit=N   stop after N errors (0 = unlimited)\n"); // diagnistic, will be removed.
    printf(C"  --platform <os>   target std platform (linux, windows, x86_64/windows)\n");
    printf(C"  --no-prelude      skip the builtin pre-imported items: ios, string...\n");
    printf(C"  --map-only        write modules.map only\n");
    printf(C"  --show-gcc        stream gcc diagnostics (silent by default)\n");
    printf(C"  --dry-run         compile without producing output\n");
    printf(C"  --emit-c          keep the generated .c next to the output\n");
    printf(C"  --strict          reject unknown build-file fields\n");
    printf(C"  --serve           run the language server on stdio (LSP)\n");
    printf(C"  --force           rebuild everything\n");
    printf(C"  <task>            build, then run the named task from the build file\n");
    printf(C"  -w                silence diagnostics (does not change success/failure)\n");
    printf(C"  -V, --version     print version identification\n");
    printf(C"  -h, --help        show this help\n");
}

pub void usage()
{
    printf(C"coralc <command> [options]\n");
    printf(C"commands:\n");
    printf(C"  build             build the project (default)\n");
    printf(C"  map               discover lib.crl folders, update the build file\n");
    printf(C"  init [dir]        scaffold a new project\n");
    printf(C"  run               build, then run the task \"run\" (or the output)\n");
    printf(C"  <file.crl>        compile a single file\n");
    printf(C"options:\n");
    printf(C"  -f <file>         build file (default coral.crlb, fallback build.crlb)\n");
    printf(C"  -o <file>         output file (single-file compile)\n");
    printf(C"  --opt <level>     optimization: debug (default), release, size, O3\n");
    printf(C"  --extra           Print all flags. coralc -h --extra\n");
}

pub bool parseArgs(Options* opts)
{
    *opts = Options {
        .cmd = Command::Build,
        .buildFile = Slice::fromStr("coral.crlb"),
        .buildFileSet = false,
        .input = Slice::from(null, 0),
        .output = Slice::from(null, 0),
        .help = false,
        .force = false,
        .dryRun = false,
        .mapOnly = false,
        .strict = false,
        .emitHir = false,
        .version = false,
        .explain = Slice::from(null, 0),
        .explainSet = false,
        .errorLimit = 20,
        .flagNames = null,
        .flagValues = null,
        .flagsCount = 0,
        .allowIntPtr = false,
        .noPrelude = false,
        .quiet = false,
        .opt = Slice::fromStr("debug"),
        .emitC = false,
        .showGcc = false,
        .serve = false,
        .extras = false
    };

    Option<str> cl = commandLine();
    if (cl.isNone()) return false;
    str argv = cl.unwrap();
    usize pos = 0;
    Slice tok;
    pos = nextArg(argv, pos, &tok);
    if (tok.len == 0) return false;

    bool haveCmd = false;
    while (true)
    {
        pos = nextArg(argv, pos, &tok);
        if (tok.len == 0) break;
        Flag f = classifyFlag(tok);
        switch (f)
        {
            Flag::Help => { opts->help = true; return true; },
            Flag::Version => { opts->version = true; return true; },
            Flag::Force => { opts->force = true; continue; },
            Flag::DryRun => { opts->dryRun = true; continue; },
            Flag::MapOnly => { opts->mapOnly = true; continue; },
            Flag::Strict => { opts->strict = true; continue; },
            Flag::EmitC => { opts->emitC = true; continue; },
            Flag::ShowGcc => { opts->showGcc = true; continue; },
            Flag::Serve => { opts->serve = true; continue; },
            Flag::AllowIntPtr => { opts->allowIntPtr = true; continue; },
            Flag::NoPrelude => { opts->noPrelude = true; continue; },
            Flag::Quiet => { opts->quiet = true; continue; },
            Flag::Extra => { opts->extras = true; continue; },
            Flag::Explain => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf(C"coralc: --explain needs a code, e.g. --explain PAR-0001\n");
                    return false;
                }
                opts->explain = val;
                opts->explainSet = true;
                continue;
            },

            Flag::Set => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (!parseFlagValue(opts, val)) return false;
                continue;
            },
            Flag::Platform => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf(C"coralc: --platform needs a value: linux, windows, or arch/os\n");
                    return false;
                }
                if (!addFlagPair(opts, Slice::fromStr("platform"), val)) return false;
                continue;
            },
            Flag::Opt => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf(C"coralc: --opt needs a level: debug, release, or size\n");
                    return false;
                }
                opts->opt = val;
                continue;
            },

            Flag::File => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0) {
                    printf(C"coralc: -f needs a file path\n");
                    return false;
                }
                opts->buildFile = val;
                opts->buildFileSet = true;
                continue;
            },

            Flag::Out => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    printf(C"coralc: -o needs a file path\n");
                    return false;
                }
                opts->output = val;
                continue;
            },

            Flag::Other => {
                str pfx = "-ferror-limit=";
                if (tok.len > pfx.len && aStartsWith(tok, pfx))
                {
                    usize pl = pfx.len;
                    usize v = 0;
                    usize qi = pl;
                    bool ok = true;
                    while (qi < tok.len)
                    {
                        u8 c = tok.ptr[qi];
                        if (c < 48 || c > 57) { ok = false; break; }
                        v = v * 10 + (usize)(c - 48);
                        if (v > 1000000) v = 1000000;
                        qi++;
                    }
                    if (!ok)
                    {
                        printf(C"coralc: -ferror-limit needs a number, e.g. -ferror-limit=20\n");
                        return false;
                    }
                    opts->errorLimit = v;
                    continue;
                }
            },
            else => { return false; }
        }

        if (tok.ptr[0] == 45) {
            printf(C"coralc: unknown flag: %s\n", sliceCStr(tok));
            return false;
        }
        if (haveCmd) {
            if (opts->cmd == Command::Init && opts->input.len == 0)
            {
                opts->input = tok;
                continue;
            }
            printf(C"coralc: unexpected argument: %s\n", sliceCStr(tok));
            return false;
        }
        haveCmd = true;
        bool known = false;
        switch (tok.len) {
            3 => {
                if (aEq(tok, "map")) { opts->cmd = Command::Map; known = true; }
                if (aEq(tok, "run")) { opts->cmd = Command::Run; known = true; }
            },
            4 => { if (aEq(tok, "init")) { opts->cmd = Command::Init; known = true; } },
            5 => { if (aEq(tok, "build")) { opts->cmd = Command::Build; known = true; } },
            else => {},
        }
        if (!known) {
            usize i = tok.len;
            if (i >= 4 && tok.ptr[i - 4] == 46 && tok.ptr[i - 3] == 99 && tok.ptr[i - 2] == 114 && tok.ptr[i - 1] == 108) {
                opts->cmd = Command::Compile;
                opts->input = tok;
                known = true;
            }
        }
        if (!known) {
            opts->cmd = Command::Task;
            opts->input = tok;
        }
    }
    return true;
}
