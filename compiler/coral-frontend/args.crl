#[[no_drop_all]]
// frontend/args.crl: coralc command-line parsing.

use common::slice { Slice };
use io { sliceCStr };
import core::cchar { cchar };
import platform::libc { printf };
import std::cmd { commandLine };
import std::mman { alloc };
import std::option { Option };

pub enum Command { Build, Map, Init, Run, Compile, Task }
pub enum Flag {
    Help, Force,
    DryRun, MapOnly,
    Strict, File, Out,
    Other, Explain, Version,
    AllowIntPtr, Quiet, Set,
    Opt0, Opt1, Opt2, Opt3, OptSize, OptDebug, EmitC, Safety, NoSafety,
    ShowGcc, Serve, Platform,
    Extra, Profile, WallVm,
    EmitAsm, EmitIr
}

pub struct Options
{
    Command cmd;
    Slice buildFile;
    bool buildFileSet;
    Slice input;
    Slice output;
    bool help;
    bool force;
    bool dryRun;
    bool mapOnly;
    bool strict;
    bool emitHir;
    bool version;
    Slice explain;
    bool explainSet;
    usize errorLimit;
    Slice* flagNames;
    Slice* flagValues;
    u32 flagsCount;
    bool allowIntPtr;
    bool quiet;
    Slice opt;
    bool optSet;
    /* -1 auto (-O0 on, higher levels off), 0 off, 1 on at every level */
    i32 safetyMode;
    bool emitC;
    bool wallvm;
    bool emitAsm;
    bool emitIr;
    bool showGcc;
    bool serve;
    bool extras;
    Slice extraGroup;
    Slice profile;
    bool profileSet;
    Slice* linkLibs;
    u32 linkLibsLen;
    Slice* linkFlags;
    u32 linkFlagsLen;
}

bool aEq(Slice a, str b)
{
    if (a.len != b.len) return false;
    usize i = 0;
    while (i < b.len) {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

bool aStartsWith(Slice a, str p)
{
    if (a.len < p.len) return false;
    usize i = 0;
    while (i < p.len) { if (a.ptr[i] != p.ptr[i]) return false; i++; }
    return true;
}

pub bool addFlagPair(Options* opts, Slice key, Slice val)
{
    if (key.len == 0) return true;
    if (opts->flagsCount >= 32) return true;
    if (opts->flagNames == null)
    {
        opts->flagNames = alloc<Slice>(32);
        opts->flagValues = alloc<Slice>(32);
    }
    if (opts->flagNames == null || opts->flagValues == null) return false;
    opts->flagNames[opts->flagsCount] = key;
    opts->flagValues[opts->flagsCount] = val;
    opts->flagsCount++;
    return true;
}

/* --flag VALUE: the std form is brace-wrapped comma pairs:
 *   --flag {platform=windows,arch=x86_64,mode=debug}
 * a bare NAME=VALUE is also accepted (and may repeat) */
bool parseFlagValue(Options* opts, Slice val)
{
    if (val.len == 0)
    {
        print("coralc: --flag needs {{name=value,...}} or name=value\n");
        return false;
    }
    usize start = 0;
    usize end = val.len;
    if (val.ptr[0] == 123 && val.ptr[end - 1] == 125) { start = 1; end--; }
    usize segStart = start;
    usize i = start;
    while (i <= end)
    {
        if (i == end || val.ptr[i] == 44)
        {
            usize eq = segStart;
            while (eq < i && val.ptr[eq] != 61) eq++;
            if (eq > segStart)
            {
                if (!addFlagPair(opts, Slice::from(val.ptr + segStart, eq - segStart),
                                 Slice::from(val.ptr + eq + 1, i - eq - 1))) return false;
            }
            segStart = i + 1;
        }
        i++;
    }
    return true;
}

usize nextArg(str all, usize pos, Slice* out)
{
    while (pos < all.len && all.ptr[pos] == 0) pos++;
    if (pos >= all.len) {
        *out = Slice::from(null, 0);
        return pos;
    }
    usize start = pos;
    while (pos < all.len && all.ptr[pos] != 0) pos++;
    *out = Slice::from((u8*)(all.ptr + start), pos - start);
    return pos;
}

Flag classifyFlag(Slice a)
{
    switch (a.len)
    {
        2 => {
            if (aEq(a, "-h")) return Flag::Help;
            if (aEq(a, "-f")) return Flag::File;
            if (aEq(a, "-o")) return Flag::Out;
            if (aEq(a, "-V")) return Flag::Version;
            if (aEq(a, "-w")) return Flag::Quiet;
            if (aEq(a, "-e")) return Flag::Extra;
        },
        3 => {
            if (aEq(a, "-O0")) return Flag::Opt0;
            if (aEq(a, "-O1")) return Flag::Opt1;
            if (aEq(a, "-O2")) return Flag::Opt2;
            if (aEq(a, "-O3")) return Flag::Opt3;
            if (aEq(a, "-Os")) return Flag::OptSize;
        },
        6 => { if (aEq(a, "--help")) return Flag::Help; if (aEq(a, "--flag")) return Flag::Set; if (aEq(a, "-debug")) return Flag::OptDebug; },
        7 => {
            if (aEq(a, "--extra")) return Flag::Extra;
            if (aEq(a, "--force")) return Flag::Force;
            if (aEq(a, "--serve")) return Flag::Serve;
            if (aEq(a, "--quiet")) return Flag::Quiet;
        },
        8 => {
            if (aEq(a, "--strict")) return Flag::Strict;
            if (aEq(a, "--emit-c")) return Flag::EmitC;
            if (aEq(a, "--wallvm")) return Flag::WallVm;
            if (aEq(a, "--safety")) return Flag::Safety;
        },
        9 => {
            if (aEq(a, "--dry-run")) return Flag::DryRun;
            if (aEq(a, "--explain")) return Flag::Explain;
            if (aEq(a, "--version")) return Flag::Version;
            if (aEq(a, "--profile")) return Flag::Profile;
            if (aEq(a, "--emit-ir")) return Flag::EmitIr;
        },
        10 => {
            if (aEq(a, "--map-only")) return Flag::MapOnly;
            if (aEq(a, "--show-gcc")) return Flag::ShowGcc;
            if (aEq(a, "--platform")) return Flag::Platform;
            if (aEq(a, "--emit-asm")) return Flag::EmitAsm;
        },
        11 => { if (aEq(a, "--no-safety")) return Flag::NoSafety; },
        15 => { if (aEq(a, "--allow-int-ptr")) return Flag::AllowIntPtr; },
        else => { return Flag::Other; }
    }
    /* a listed length that matched nothing, e.g. a .crl path of exactly
     * 15 chars, fell off the switch; return Other instead of garbage */
    return Flag::Other;
}

pub void usage2(Slice group)
{
    usage();
    if (group.len == 0)
    {
        print("\nOption groups:\n");
        print("  build             Inputs, profiles, and build-time flags\n");
        print("  backend           Code generation, target, and safety checks\n");
        print("  diagnostics       Output, errors, and explanations\n");
        print("  project           Project commands and tooling\n");
        print("\nRun \"coralc -h --extra <group>\" to show one group.\n");
        return;
    }
    if (aEq(group, "build"))
    {
        print("\nBuild options:\n");
        print("  -f <file>         Build file (default: coral.crlb)\n");
        print("  -o <file>         Output path\n");
        print("  --profile <name>  Apply a profile from the build file\n");
        print("  --flag <k=v,...>  Set build-time flags for flag (NAME) selection\n");
        print("  --strict          Reject unknown build-file fields\n");
        print("  --force           Rebuild everything\n");
        print("  --dry-run         Compile without writing output\n");
        print("  --map-only        Write modules.map only\n");
    }
    else if (aEq(group, "backend"))
    {
        print("\nBackend options:\n");
        print("  --wallvm          Use the wallvm backend\n");
        print("  --emit-c          Keep the generated C file\n");
        print("  --emit-asm        With --wallvm: keep the generated assembly\n");
        print("  --emit-ir         With --wallvm: keep the generated IR\n");
        print("  --platform <os>   Target platform (linux, windows, or arch/os)\n");
        print("  --allow-int-ptr   Permit int-to-pointer assignments\n");
        print("  --safety          Enable safety checks at every optimization level\n");
        print("  --no-safety       Disable safety checks, including at -O0\n");
    }
    else if (aEq(group, "diagnostics"))
    {
        print("\nDiagnostic options:\n");
        print("  -w, --quiet       Suppress compiler output\n");
        print("  --show-gcc        Stream gcc diagnostics\n");
        print("  --explain <code>  Explain a diagnostic code\n");
    }
    else if (aEq(group, "project"))
    {
        print("\nProject options:\n");
        print("  init [dir]        Create a new project\n");
        print("  --serve           Run the language server on stdio\n");
        print("  --force           Rebuild everything\n");
    }
    else
    {
        print("\ncoralc: unknown option group: {}\n", (cchar*)sliceCStr(group));
        print("Groups: build, backend, diagnostics, project\n");
    }
}

pub void usage()
{
    print("Usage:    coralc [options] <file.crl>\n");
    print("          coralc [options] build [task]\n");
    print("Commands:\n");
    print("  build             Build the project (default)\n");
    print("  run               Build, then run the project's \"run\" task\n");
    print("  map               Discover lib.crl folders and update the build file\n");
    print("  init [dir]        Create a new project\n");
    print("\n");
    print("Options:\n");
    print("  -f <file>            Build file (default: coral.crlb)\n");
    print("  -o <file>            Output path\n");
    print("  -w, --quiet          Suppress compiler output\n");
    print("  -V, --version        Show version\n");
    print("  -h, --help           Show this help\n");
    print("  -e, --extra [group]  Show advanced option groups\n");
    
    print("\n");
    print("Run \"coralc -h --extra\" for advanced option groups.");
}

pub bool parseArgs(Options* opts)
{
    *opts = Options {
        .cmd = Command::Build,
        .buildFile = Slice::fromStr("coral.crlb"),
        .buildFileSet = false,
        .input = Slice::from(null, 0),
        .output = Slice::from(null, 0),
        .help = false,
        .force = false,
        .dryRun = false,
        .mapOnly = false,
        .strict = false,
        .emitHir = false,
        .version = false,
        .explain = Slice::from(null, 0),
        .explainSet = false,
        .errorLimit = 20,
        .flagNames = null,
        .flagValues = null,
        .flagsCount = 0,
        .allowIntPtr = false,
        .quiet = false,
        .opt = Slice::fromStr("debug"),
        .optSet = false,
        .safetyMode = -1,
        .emitC = false,
        .showGcc = false,
        .serve = false,
        .extras = false,
        .extraGroup = Slice::from(null, 0),
        .profile = Slice::from(null, 0),
        .profileSet = false,
        .linkLibs = null,
        .linkLibsLen = 0,
        .linkFlags = null,
        .linkFlagsLen = 0
    };

    Option<str> cl = commandLine();
    if (cl.isNone()) return false;
    str argv = cl.unwrap();
    usize pos = 0;
    Slice tok;
    pos = nextArg(argv, pos, &tok);
    if (tok.len == 0) return false;

    bool haveCmd = false;
    while (true)
    {
        pos = nextArg(argv, pos, &tok);
        if (tok.len == 0) break;
        Flag f = classifyFlag(tok);
        switch (f)
        {
            Flag::Help => { opts->help = true; continue; },
            Flag::Version => { opts->version = true; return true; },
            Flag::Force => { opts->force = true; continue; },
            Flag::DryRun => { opts->dryRun = true; continue; },
            Flag::MapOnly => { opts->mapOnly = true; continue; },
            Flag::Strict => { opts->strict = true; continue; },
            Flag::EmitC => { opts->emitC = true; continue; },
            Flag::WallVm => { opts->wallvm = true; continue; },
            Flag::EmitAsm => { opts->emitAsm = true; continue; },
            Flag::EmitIr => { opts->emitIr = true; continue; },
            Flag::ShowGcc => { opts->showGcc = true; continue; },
            Flag::Serve => { opts->serve = true; continue; },
            Flag::AllowIntPtr => { opts->allowIntPtr = true; continue; },
            Flag::Quiet => { opts->quiet = true; continue; },
            Flag::Extra => {
                Slice g;
                usize save = pos;
                pos = nextArg(argv, pos, &g);
                if (g.len == 0 || g.ptr[0] == 45)
                {
                    pos = save;
                    g = Slice::from(null, 0);
                }
                opts->extras = true;
                opts->extraGroup = g;
                continue;
            },
            Flag::Explain => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    print("coralc: --explain needs a code, e.g. --explain PAR-0001\n");
                    return false;
                }
                opts->explain = val;
                opts->explainSet = true;
                continue;
            },

            Flag::Set => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (!parseFlagValue(opts, val)) return false;
                continue;
            },
            Flag::Platform => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    print("coralc: --platform needs a value: linux, windows, or arch/os\n");
                    return false;
                }
                if (!addFlagPair(opts, Slice::fromStr("platform"), val)) return false;
                continue;
            },
            Flag::Opt0 => { opts->opt = Slice::fromStr("debug"); opts->optSet = true; continue; },
            Flag::Opt1 => { opts->opt = Slice::fromStr("O1"); opts->optSet = true; continue; },
            Flag::Opt2 => { opts->opt = Slice::fromStr("release"); opts->optSet = true; continue; },
            Flag::Opt3 => { opts->opt = Slice::fromStr("O3"); opts->optSet = true; continue; },
            Flag::OptSize => { opts->opt = Slice::fromStr("size"); opts->optSet = true; continue; },
            Flag::OptDebug => { opts->opt = Slice::fromStr("debug"); opts->optSet = true; continue; },
            Flag::Safety => { opts->safetyMode = 1; continue; },
            Flag::NoSafety => { opts->safetyMode = 0; continue; },
            Flag::Profile => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    print("coralc: --profile needs a name from the build file\n");
                    return false;
                }
                opts->profile = val;
                opts->profileSet = true;
                continue;
            },

            Flag::File => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0) {
                    print("coralc: -f needs a file path\n");
                    return false;
                }
                opts->buildFile = val;
                opts->buildFileSet = true;
                continue;
            },

            Flag::Out => {
                Slice val;
                pos = nextArg(argv, pos, &val);
                if (val.len == 0)
                {
                    print("coralc: -o needs a file path\n");
                    return false;
                }
                opts->output = val;
                continue;
            },

            Flag::Other => {},
            else => { return false; }
        }

        if (tok.ptr[0] == 45) {
            print("coralc: unknown flag: {}\n", (cchar*)sliceCStr(tok));
            return false;
        }
        if (haveCmd) {
            if (opts->cmd == Command::Init && opts->input.len == 0)
            {
                opts->input = tok;
                continue;
            }
            print("coralc: unexpected argument: {}\n", (cchar*)sliceCStr(tok));
            return false;
        }
        haveCmd = true;
        bool known = false;
        switch (tok.len) {
            3 => {
                if (aEq(tok, "map")) { opts->cmd = Command::Map; known = true; }
                if (aEq(tok, "run")) { opts->cmd = Command::Run; known = true; }
            },
            4 => { if (aEq(tok, "init")) { opts->cmd = Command::Init; known = true; } },
            5 => { if (aEq(tok, "build")) { opts->cmd = Command::Build; known = true; } },
            else => {},
        }
        if (!known) {
            usize i = tok.len;
            if (i >= 4 && tok.ptr[i - 4] == 46 && tok.ptr[i - 3] == 99 && tok.ptr[i - 2] == 114 && tok.ptr[i - 1] == 108) {
                opts->cmd = Command::Compile;
                opts->input = tok;
                known = true;
            }
        }
        if (!known) {
            opts->cmd = Command::Task;
            opts->input = tok;
        }
    }
    return true;
}
