#[[no_drop_all]]
/* frontend/tasks.crl: run task decls from the build file. Tasks execute
 * after the build pipeline; `after` may name other tasks, "build" is a
 * no-op there (the pipeline already ran by the time a task executes). */

import common::slice { Slice };
import build::builder { Builder, bEq, bTaskIndex };
import(lib) core::cchar { cchar };
import(lib) platform::libc { printf, system };
import(lib) std::mman { alloc, dealloc };

pub i32 runTask(Builder* b, str name, u32 depth)
{
    if (depth > 8)
    {
        printf(C"coralc: task dependency loop at \"%.*s\"\n", (i32)name.len, name.ptr);
        return 3;
    }
    i32 idx = bTaskIndex(b, name);
    if (idx < 0)
    {
        printf(C"coralc: no task \"%.*s\" in the build file\n", (i32)name.len, name.ptr);
        return 2;
    }

    u32 u = (u32)idx;
    u32 i = 0;
    while (i < b->taskAfterLens[u])
    {
        Slice dep = b->taskAfters[u][i];
        if (!bEq(dep, "build"))
        {
            i32 st = runTask(b, dep.asStr(), depth + 1);
            if (st != 0) return st;
        }
        i++;
    }

    Slice exec = b->taskExecs[u];
    if (exec.len == 0) return 0;

    Slice out = b->taskOutputs[u];
    bool redirect = out.len > 0 && out.ptr[out.len - 1] != 47;
    usize need = exec.len + (redirect ? out.len : 0) + 8;
    u8* cmd = alloc<u8>(need);
    if (cmd == null) return 3;
    usize cl = 0;
    usize k = 0;
    while (k < exec.len) { cmd[cl] = exec.ptr[k]; cl++; k++; }
    if (redirect)
    {
        cmd[cl] = 32; cl++;
        cmd[cl] = 62; cl++;
        cmd[cl] = 32; cl++;
        k = 0;
        while (k < out.len) { cmd[cl] = out.ptr[k]; cl++; k++; }
    }
    cmd[cl] = 0;

    printf(C"coralc: task %.*s: %s\n", (i32)b->taskNames[u].len, b->taskNames[u].ptr, (cchar*)cmd);
    i32 st = system((const cchar*)cmd);
    dealloc<u8>(cmd);
    if (st != 0)
    {
        printf(C"coralc: task %.*s failed (status %d)\n", (i32)name.len, name.ptr, (i32)st);
        return 3;
    }
    return 0;
}
