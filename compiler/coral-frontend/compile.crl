#[[no_drop_all]]
// frontend/compile.crl: single-file compile (coralc name.crl -o name).

use common::slice { Slice };
use args { Options };
use io { readFile, sliceCStr, writeFile };
use sem::analyze { CompileUnit, analyzeForCompile, freeUnit };
use build::arena { Arena };
use backend::codegen { generateC, CodegenResult };
use ir::wallvm { generateWallVm, WallVmResult };
use build::parser { CrlbParser };
use build::ast { CrlbNode, CrlbNodeKind, Value, ValueArray };
import core::cchar { cchar };
import std::mman { alloc, dealloc };
import std::vec { Vec };
import std::result { Result };
import std::fs { IoError };
import std::process { spawn, writeStdin, waitFor, pollfd, Process, ProcessResult };
import platform::libc { printf, close, read, write, poll };

bool endsWithCrl(Slice s)
{
    if (s.len < 4) return false;
    return s.ptr[s.len - 4] == 46 && s.ptr[s.len - 3] == 99 &&
           s.ptr[s.len - 2] == 114 && s.ptr[s.len - 1] == 108;
}

// default output: input with a trailing `.crl` stripped
Slice defaultOutput(Slice input)
{
    if (endsWithCrl(input)) return Slice::from(input.ptr, input.len - 4);
    return input;
}

/* feed the generated C (or wallvm asm) to gcc through a pipe: no .c/.s
 * file ever touches the disk. asAsm=true treats the input as assembly
 * (`-x assembler -no-pie -`) and skips the C-only flags. gcc's
 * diagnostics are dropped unless showGcc. Returns gcc's exit status
 * (127 = could not start / wait for gcc). */
i32 runGcc(str outPath, str opt, Slice cCode, bool hasMain, bool showGcc, bool asAsm)
{
    Vec<str> args = Vec<str>::new();
    bool release = opt.len == 7 && opt.ptr[0] == 114 && opt.ptr[1] == 101 && opt.ptr[2] == 108 && opt.ptr[3] == 101 && opt.ptr[4] == 97 && opt.ptr[5] == 115 && opt.ptr[6] == 101;
    if (asAsm)
    {
        /* wallvm asm: assemble + link. -no-pie sidesteps absolute-ref
         * relocation (wallvm G37); wallvm already optimized the asm so
         * no -O/-g/-std. libc links by default when linking. */
        args.push("-x");
        args.push("assembler");
        args.push("-no-pie");
        args.push("-");
        if (!hasMain) args.push("-c");
        args.push("-o");
        args.push(outPath);
        args.push("-lm");
    }
    else
    {
        args.push("-std=gnu11");
        args.push("-x");
        args.push("c");
        args.push("-");
        if (release)
        {
            args.push("-O2");
        }
        else if (opt.len == 4 && opt.ptr[0] == 115 && opt.ptr[1] == 105 && opt.ptr[2] == 122 && opt.ptr[3] == 101)
        {
            args.push("-Os");
        }
        else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 51)
        {
            args.push("-O3");
        }
        else
        {
            args.push("-O0");
            args.push("-g");
        }
        if (!hasMain) args.push("-c");
        /* strip only release binaries: debug builds keep their symbols so a
         * crash still produces a symbolized backtrace */
        else if (release) args.push("-s");
        args.push("-o");
        args.push(outPath);
        args.push("-lm");
    }

    Result<Process, IoError> sr = spawn("gcc", &args);
    if (sr.isErr()) return 127;
    Process p = sr.unwrap();

    usize off = 0;
    while (off < cCode.len)
    {
        Result<isize, IoError> wr = writeStdin(&p, (const cchar*)(cCode.ptr + off), cCode.len - off);
        if (wr.isErr()) break;
        isize n = wr.unwrap();
        if (n <= 0) break;
        off += (usize)n;
    }
    /* EOF for gcc, then drain both output pipes so gcc can never block
     * writing diagnostics while we wait for it */
    close((i32)p.stdinFd);

    u8* buf = alloc<u8>(4096);
    if (buf != null)
    {
        bool stdoutOpen = true;
        bool stderrOpen = true;
        while (stdoutOpen || stderrOpen)
        {
            pollfd[2] fds;
            i32 outIdx = -1;
            i32 errIdx = -1;
            usize nfds = 0;
            if (stdoutOpen) { outIdx = (i32)nfds; fds[nfds].fd = (i32)p.stdoutFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
            if (stderrOpen) { errIdx = (i32)nfds; fds[nfds].fd = (i32)p.stderrFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
            if (nfds == 0) break;
            i32 prc = poll((rawptr)fds, nfds, -1);
            if (prc <= 0) break;
            usize i = 0;
            while (i < nfds)
            {
                if ((fds[i].revents & 17) == 0) { i++; continue; }
                isize n = read(fds[i].fd, buf, 4096);
                if (n <= 0)
                {
                    close(fds[i].fd);
                    if ((i32)i == outIdx) stdoutOpen = false;
                    else if ((i32)i == errIdx) stderrOpen = false;
                }
                else if (showGcc)
                {
                    if ((i32)i == outIdx) write(1, (const cchar*)buf, (usize)n);
                    else write(2, (const cchar*)buf, (usize)n);
                }
                i++;
            }
        }
        dealloc<u8>(buf);
    }

    Result<ProcessResult, IoError> gw = waitFor(&p);
    if (gw.isErr()) return 127;
    return gw.unwrap().exitCode;
}

bool codeHasSlice(Slice code, str pat)
{
    if (code.ptr == null || code.len < pat.len) return false;
    usize i = 0;
    while (i + pat.len <= code.len)
    {
        bool m = true;
        usize j = 0;
        while (j < pat.len)
        {
            if (code.ptr[i + j] != pat.ptr[j]) { m = false; break; }
            j++;
        }
        if (m) return true;
        i++;
    }
    return false;
}

bool codeHasMain(Slice code)
{
    if (codeHasSlice(code, "int32_t main(")) return true;
    return codeHasSlice(code, "void main(");
}

/* wallvm asm: main is exempt from mangling so it appears as a bare `main:`
 * label. check start-of-buffer and newline-before to avoid matching
 * `foo_main:` / `crl$...$main:`. */
bool asmHasMain(Slice body)
{
    if (body.ptr == null || body.len < 5) return false;
    if (body.ptr[0] == 109 && body.ptr[1] == 97 && body.ptr[2] == 105 && body.ptr[3] == 110 && body.ptr[4] == 58) return true;
    return codeHasSlice(body, "\nmain:");
}

/* one compilation unit → one binary/object. The build path calls this with
 * the builder's in-memory module table; single-file mode passes nulls.
 * o->wallvm selects the wallvm backend (o->emitAsm/emitIr keep the .s/.ir
 * for inspection). Bundles the option fields into one pointer to stay
 * under codegen's 16-argument cap. */
pub i32 compileUnitTo(str inPath, str outPath, Options* o, Slice* modKeys, Slice* modVals, u32 modLen)
{
    usize len = 0;
    Slice src = readFile(inPath, &len);
    u8* inZ = sliceCStr(Slice::fromStr(inPath));
    if (src.ptr == null) {
        printf(C"error: cannot read %s\n", inZ);
        dealloc<u8>(inZ);
        return 1;
    }
    CompileUnit unit = analyzeForCompile(src.ptr, len, inZ, o->flagNames, o->flagValues, o->flagsCount, o->errorLimit, o->allowIntPtr, o->noPrelude, o->quiet, modKeys, modVals, modLen, false, null);
    if (unit.ctx == null) {
        printf(C"error: compile failed (%d errors)\n",
               (i32)(unit.parseErrors + unit.semanticErrors + unit.monoErrors));
        dealloc<u8>(inZ);
        return 2;
    }

    // generated C sits next to the output: <out>.c
    usize outLen = outPath.len;
    u8* cPath = alloc<u8>(outLen + 3);
    if (cPath == null) { freeUnit(&unit); dealloc<u8>(inZ); return 1; }
    usize ci = 0;
    while (ci < outLen) { cPath[ci] = outPath.ptr[ci]; ci++; }
    cPath[ci] = 46; cPath[ci + 1] = 99; cPath[ci + 2] = 0;

    Arena a;
    a.init(4194304);

    Slice code = Slice::from(null, 0);
    bool hasMain = false;
    bool failed = false;

    if (o->wallvm)
    {
        WallVmResult wv = generateWallVm(unit.ctx, unit.file, unit.mono, &a, o->opt.asStr(), o->emitIr);
        // the .ir dump lands next to the output whenever --emit-ir asked
        // for one, validation failure or not: a failed compile is exactly
        // when the IR is worth inspecting
        if (o->emitIr && wv.irText.ptr != null)
        {
            u8* irPath = alloc<u8>(outLen + 4);
            if (irPath != null) {
                usize ii = 0;
                while (ii < outLen) { irPath[ii] = outPath.ptr[ii]; ii++; }
                irPath[ii] = 46; irPath[ii + 1] = 105; irPath[ii + 2] = 114; irPath[ii + 3] = 0;
                if (!writeFile(str { .ptr = irPath, .len = outLen + 3 }, wv.irText)) {
                    printf(C"error: cannot write %s\n", irPath);
                } else {
                    printf(C"coral: emit %s (%d bytes)\n", irPath, (i32)wv.irText.len);
                }
                dealloc<u8>(irPath);
            }
        }
        if (wv.errors > 0 || wv.asmText.ptr == null) {
            printf(C"error: wallvm codegen failed (%d errors)\n", (i32)wv.errors);
            failed = true;
        } else {
            code = wv.asmText;
            hasMain = asmHasMain(code);
            if (o->emitAsm)
            {
                u8* asmPath = alloc<u8>(outLen + 3);
                if (asmPath != null) {
                    usize si2 = 0;
                    while (si2 < outLen) { asmPath[si2] = outPath.ptr[si2]; si2++; }
                    asmPath[si2] = 46; asmPath[si2 + 1] = 115; asmPath[si2 + 2] = 0;
                    if (!writeFile(str { .ptr = asmPath, .len = outLen + 2 }, code)) {
                        printf(C"error: cannot write %s\n", asmPath);
                    } else {
                        printf(C"coral: emit %s (%d bytes)\n", asmPath, (i32)code.len);
                    }
                    dealloc<u8>(asmPath);
                }
            }
        }
    }
    else
    {
        CodegenResult cg = generateC(unit.ctx, unit.file, unit.mono, &a);
        if (cg.errors > 0 || cg.cCode.ptr == null) {
            printf(C"error: codegen failed (%d errors)\n", (i32)cg.errors);
            failed = true;
        } else {
            code = cg.cCode;
            hasMain = codeHasMain(code);
            if (o->emitC)
            {
                if (!writeFile(str { .ptr = cPath, .len = outLen + 2 }, code)) {
                    printf(C"error: cannot write %s\n", cPath);
                    failed = true;
                } else {
                    printf(C"coral: emit %s (%d bytes)\n", cPath, (i32)code.len);
                }
            }
        }
    }

    if (failed) {
        a.freeAll();
        dealloc<u8>(cPath);
        dealloc<u8>(inZ);
        freeUnit(&unit);
        return 3;
    }

    i32 rc = 0;
    if (o->dryRun) {
        u8* outZ = sliceCStr(Slice::fromStr(outPath));
        printf(C"coral: dry run, would link %s\n", outZ);
        dealloc<u8>(outZ);
    } else {
        /* helper/library files emit no main: compile to an object instead
         * of linking an executable (which would fail with undefined main) */
        i32 st = runGcc(outPath, o->opt.asStr(), code, hasMain, o->showGcc, o->wallvm);
        if (st != 0) {
            printf(C"error: gcc failed (status %d); rerun with --show-gcc for details\n", (i32)st);
            rc = 3;
        } else {
            u8* outZ = sliceCStr(Slice::fromStr(outPath));
            printf(C"coral: built %s -> %s\n", inZ, outZ);
            dealloc<u8>(outZ);
        }
    }

    a.freeAll();
    dealloc<u8>(cPath);
    dealloc<u8>(inZ);
    freeUnit(&unit);
    return rc;
}

pub i32 compileFile(Options* opts)
{
    /* also surfacing build-file flags: the manifest's `flags = [ "NAME=VALUE",
     * ... ]` list merges into the compile-time flag table (see Options).  */
    if (opts->buildFileSet)
    {
        usize fbuflen = 0;
        Slice fsrc = readFile(opts->buildFile.asStr(), &fbuflen);
        if (fsrc.ptr != null && fbuflen > 0)
        {
            Arena fa;
            fa.init(1 << 18);
            CrlbParser fp;
            fp.init(&fa, fsrc);
            CrlbNode* rootp = fp.parseFile();
            if (rootp != null && fp.errors == 0)
            {
                usize bi = 0;
                while (bi < rootp.children.len)
                {
                    CrlbNode* c = rootp.children.data + bi;
                    if (c.kind == CrlbNodeKind::Build)
                    {
                        // find fields.
                        usize fi = 0;
                        while (fi < c.fields.len)
                        {
                            CrlbField* f = c.fields.data + fi;
                            if (f.name.len == 5 && f.name.ptr[0] == 102 && f.name.ptr[1] == 108 && f.name.ptr[2] == 97 && f.name.ptr[3] == 103 && f.name.ptr[4] == 115)
                            {
                                // Value::List
                                usize vi = 0;
                                ValueArray* va = f.value.payload.List.value;
                                if (va != null) {
                                while (vi < va.len)
                                {
                                    Value* v = va.data + (u32)vi;
                                    if (v.tag == Value::String)
                                    {
                                        usize si = 0;
                                        usize ev = v.payload.String.value.len;
                                        while (si < ev)
                                        {
                                            if (v.payload.String.value.ptr[si] == 61) break;
                                            si++;
                                        }
                                        if (si > 0 && si < ev && opts->flagsCount < 32)
                                        {
                                            if (opts->flagNames == null)
                                            {
                                                opts->flagNames = alloc<Slice>(32);
                                                opts->flagValues = alloc<Slice>(32);
                                            }
                                            opts->flagNames[opts->flagsCount] = Slice::from(v.payload.String.value.ptr, (usize)si);
                                            opts->flagValues[opts->flagsCount] = Slice::from(v.payload.String.value.ptr + si + 1, ev - si - 1);
                                            opts->flagsCount++;
                                        }
                                    }
                                    vi++;
                                }
                                }
                            }
                            fi++;
                        }
                    }
                    bi++;
                }
            }
        }
    }
    // output binary path: -o or input minus `.crl`
    Slice out = opts.output;
    if (out.ptr == null || out.len == 0) out = defaultOutput(opts.input);

    i32 rc = compileUnitTo(opts.input.asStr(), out.asStr(), opts, null, null, 0);
    return rc;
}
