#[[no_drop_all]]
// frontend/compile.crl: single-file compile (coralc name.crl -o name).

use common::slice { Slice };
use args { Options };
use io { readFile, sliceCStr, writeFile };
use sem::analyze { CompileUnit, AnalyzeOptions, analyzeForCompile, freeUnit };
use build::arena { Arena };
use backend::codegen { generateC, CodegenResult, TuCode };
use ir::muvm { generateMuvm, MuvmResult };
import muvm::muvm { CallingConvention };
use build::parser { CrlbParser };
use build::ast { CrlbNode, CrlbNodeKind, CrlbField, Value, ValueArray };

import core::cchar { cchar };
import std::mman { alloc, dealloc, zero };
import std::ios { print };
import std::vec { Vec };
import std::result { Result };
