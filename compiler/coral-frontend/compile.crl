/* the --platform/--flag {platform=...} value picks the module calling
 * convention: windows targets take Win64, everything else the SysV
 * default. arch/os spellings ("x86_64/windows") match on the os part. */
CallingConvention platformCallingConvention(Slice* names, Slice* vals, u32 n)
{
    u32 i = 0;
    while (i < n)
    {
        Slice nm = names[i];
        if (nm.len == 8)
        {
            bool isPlat = true;
            usize k = 0;
            str pn = "platform";
            while (k < 8) { if (nm.ptr[k] != pn.ptr[k]) { isPlat = false; break; } k++; }
            if (isPlat)
            {
                Slice v = vals[i];
                /* scan for a "windows" component: "windows" or "arch/os" */
                usize j = 0;
                while (j + 7 <= v.len)
                {
                    if (v.ptr[j] == 119 && v.ptr[j+1] == 105 && v.ptr[j+2] == 110 &&
                        v.ptr[j+3] == 100 && v.ptr[j+4] == 111 && v.ptr[j+5] == 119 &&
                        v.ptr[j+6] == 115)
                        return CallingConvention::Win64;
                    j++;
                }
                return CallingConvention::SystemV;
            }
        }
        i++;
    }
    return CallingConvention::SystemV;
}

bool endsWithCrl(Slice s)
{
    if (s.len < 4) return false;
    return s.ptr[s.len - 4] == 46 && s.ptr[s.len - 3] == 99 &&
           s.ptr[s.len - 2] == 114 && s.ptr[s.len - 1] == 108;
}

// default output: input with a trailing `.crl` stripped
Slice defaultOutput(Slice input)
{
    if (endsWithCrl(input)) return Slice::from(input.ptr, input.len - 4);
    return input;
}

bool linkLibIsRaw(Slice s)
{
    if (s.len == 0) return false;
    if (s.ptr[0] == 45) return true;
    usize i = 0;
    while (i < s.len)
    {
        if (s.ptr[i] == 47) return true;
        i++;
    }
    if (s.len >= 2 && s.ptr[s.len - 2] == 46 && s.ptr[s.len - 1] == 97) return true;
    if (s.len >= 3 && s.ptr[s.len - 3] == 46 && s.ptr[s.len - 2] == 115 && s.ptr[s.len - 1] == 111) return true;
    return false;
}

/* feed the generated C (or muvm asm) to gcc through a pipe: no .c/.s
 * file ever touches the disk. asAsm=true treats the input as assembly
 * (`-x assembler -no-pie -`) and skips the C-only flags. gcc's
 * diagnostics are dropped unless showGcc. Returns gcc's exit status
 * (127 = could not start / wait for gcc). */
i32 runGcc(str outPath, str opt, Slice cCode, bool hasMain, bool showGcc, bool asAsm, Slice* linkLibs, u32 linkLibsLen, Slice* linkFlags, u32 linkFlagsLen)
{
    Vec<str> args = Vec<str>::new();
    bool release = opt.len == 7 && opt.ptr[0] == 114 && opt.ptr[1] == 101 && opt.ptr[2] == 108 && opt.ptr[3] == 101 && opt.ptr[4] == 97 && opt.ptr[5] == 115 && opt.ptr[6] == 101;
    if (asAsm)
    {
        /* muvm asm: assemble + link. -no-pie sidesteps absolute-ref
         * relocation (muvm G37); muvm already optimized the asm so
         * no -O/-g/-std. libc links by default when linking. */
        args.push("-x");
        args.push("assembler");
        args.push("-no-pie");
        args.push("-");
        if (!hasMain) args.push("-c");
        /* symbolic backtraces: the fatal handler can name the function
         * where the fault happened (dladdr sees .dynsym) */
        else args.push("-rdynamic");
        args.push("-o");
        args.push(outPath);
        if (hasMain)
        {
            args.push("-x");
            args.push("none");
            u32 fi = 0;
            while (fi < linkFlagsLen) { args.push(linkFlags[fi].asStr()); fi++; }
            u32 li = 0;
            while (li < linkLibsLen)
            {
                Slice lib = linkLibs[li];
                if (linkLibIsRaw(lib))
                {
                    args.push(lib.asStr());
                }
                else
                {
                    args.push("-l");
                    args.push(lib.asStr());
                }
                li++;
            }
        }
        args.push("-lm");
    }
    else
    {
        args.push("-std=gnu11");
        args.push("-x");
        args.push("c");
        args.push("-");
        if (release)
        {
            args.push("-O2");
        }
        else if (opt.len == 4 && opt.ptr[0] == 115 && opt.ptr[1] == 105 && opt.ptr[2] == 122 && opt.ptr[3] == 101)
        {
            args.push("-Os");
        }
        else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 49)
        {
            args.push("-O1");
        }
        else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 51)
        {
            args.push("-O3");
        }
        else
        {
            args.push("-O0");
            args.push("-g");
        }
        if (!hasMain) args.push("-c");
        else args.push("-rdynamic");
        /* strip only release binaries: debug builds keep their symbols so a
         * crash still produces a symbolized backtrace */
        if (hasMain && release) args.push("-s");
        args.push("-o");
        args.push(outPath);
        if (hasMain)
        {
            args.push("-x");
            args.push("none");
            u32 fi = 0;
            while (fi < linkFlagsLen) { args.push(linkFlags[fi].asStr()); fi++; }
            u32 li = 0;
            while (li < linkLibsLen)
            {
                Slice lib = linkLibs[li];
                if (linkLibIsRaw(lib))
                {
                    args.push(lib.asStr());
                }
                else
                {
                    args.push("-l");
                    args.push(lib.asStr());
                }
                li++;
            }
        }
        args.push("-lm");
    }
    str cc = ccPick();
    Result<Process, IoError> sr = spawn(cc, &args);
    if (sr.isErr()) { dealloc<u8>(cc.ptr); return 127; }
    Process p = sr.unwrap();

    usize off = 0;
    while (off < cCode.len)
    {
        Result<isize, IoError> wr = writeStdin(&p, (const cchar*)(cCode.ptr + off), cCode.len - off);
        if (wr.isErr()) break;
        isize n = wr.unwrap();
        if (n <= 0) break;
        off += (usize)n;
    }
    /* EOF for gcc, then drain both output pipes so gcc can never block
     * writing diagnostics while we wait for it */
    close((i32)p.stdinFd);

    u8* buf = alloc<u8>(4096);
    if (buf != null)
    {
        bool stdoutOpen = true;
        bool stderrOpen = true;
        while (stdoutOpen || stderrOpen)
        {
            pollfd[2] fds;
            i32 outIdx = -1;
            i32 errIdx = -1;
            usize nfds = 0;
            if (stdoutOpen) { outIdx = (i32)nfds; fds[nfds].fd = (i32)p.stdoutFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
            if (stderrOpen) { errIdx = (i32)nfds; fds[nfds].fd = (i32)p.stderrFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
            if (nfds == 0) break;
            i32 prc = poll((rawptr)fds, nfds, -1);
            if (prc <= 0) break;
            usize i = 0;
            while (i < nfds)
            {
                if ((fds[i].revents & 17) == 0) { i++; continue; }
                isize n = read(fds[i].fd, (cchar*)buf, 4096);
                if (n <= 0)
                {
                    close(fds[i].fd);
                    if ((i32)i == outIdx) stdoutOpen = false;
                    else if ((i32)i == errIdx) stderrOpen = false;
                }
                else if (showGcc)
                {
                    if ((i32)i == outIdx) write(1, (const cchar*)buf, (usize)n);
                    else write(2, (const cchar*)buf, (usize)n);
                }
                i++;
            }
        }
        dealloc<u8>(buf);
    }
    Result<ProcessResult, IoError> gw = waitFor(&p);
    i32 rc = gw.isErr() ? 127 : gw.unwrap().exitCode;
    dealloc<u8>(cc.ptr);
    return rc;
}

// we'd strip from here. because what i see here is even too linux cnetred. so when it is time for the strip, this will go.
/* C compiler driver: CORAL_CC overrides (e.g. "clang"); default gcc.
 * Returns a malloc'd str; caller deallocs. */
str ccPick()
{
    cchar* e = getenv(C"CORAL_CC");
    const cchar* src = e != null ? e : C"gcc";
    usize n = 0;
    while (src[n] != 0) n++;
    u8* b = alloc<u8>(n + 1);
    if (b == null) return str { null, 0 };
    usize i = 0;
    while (i < n) { b[i] = (u8)src[i]; i++; }
    b[n] = 0; /* spawn execvp's cmd.ptr — must be NUL-terminated */
    return str { b, n };
}

/* does `hay` contain `needle`? tiny substring scan for "gcc" */
bool slContains(Slice hay, str needle)
{
    if (needle.len == 0 || hay.len < needle.len) return false;
    usize i = 0;
    while (i + needle.len <= hay.len)
    {
        bool m = true;
        usize j = 0;
        while (j < needle.len)
        {
            if (hay.ptr[i + j] != needle.ptr[j]) { m = false; break; }
            j++;
        }
        if (m) return true;
        i++;
    }
    return false;
}

/* rough per-cc1 RSS budget for the parallel pool: each compile holds
 * the PCH/AST plus its own bodies — a few hundred MB. Returns
 * MemAvailable in MB from /proc/meminfo, 0 when unreadable. */
u32 memAvailMB()
{
    usize len = 0;
    Slice t = readFile("/proc/meminfo", &len);
    if (t.ptr == null) return 0;
    /* find "MemAvailable:" then parse the kB figure */
    usize i = 0;
    while (i + 13 <= t.len)
    {
        if (t.ptr[i] == 77 && t.ptr[i+1] == 101 && t.ptr[i+2] == 109 &&
            t.ptr[i+3] == 65 && t.ptr[i+4] == 118 && t.ptr[i+5] == 97 &&
            t.ptr[i+6] == 105 && t.ptr[i+7] == 108 && t.ptr[i+8] == 97 &&
            t.ptr[i+9] == 98 && t.ptr[i+10] == 108 && t.ptr[i+11] == 101 &&
            t.ptr[i+12] == 58)
        {
            usize j = i + 13;
            while (j < t.len && (t.ptr[j] == 32 || t.ptr[j] == 9)) j++;
            u64 kb = 0;
            while (j < t.len && t.ptr[j] >= 48 && t.ptr[j] <= 57)
            {
                kb = kb * 10 + (u64)(t.ptr[j] - 48);
                j++;
            }
            return (u32)(kb / 1024);
        }
        i++;
    }
    return 0;
}

/* drain a spawned gcc's stdout/stderr so it can never block on a full
 * pipe; diagnostics are echoed only under showGcc */
void drainGcc(Process* p, bool showGcc)
{
    u8* buf = alloc<u8>(4096);
    if (buf == null) return;
    bool outOpen = true;
    bool errOpen = true;
    while (outOpen || errOpen)
    {
        pollfd[2] fds;
        i32 outIdx = -1;
        i32 errIdx = -1;
        usize nfds = 0;
        if (outOpen) { outIdx = (i32)nfds; fds[nfds].fd = (i32)p->stdoutFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
        if (errOpen) { errIdx = (i32)nfds; fds[nfds].fd = (i32)p->stderrFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
        if (nfds == 0) break;
        i32 prc = poll((rawptr)fds, nfds, -1);
        if (prc <= 0) break;
        usize i = 0;
        while (i < nfds)
        {
            if ((fds[i].revents & 17) == 0) { i++; continue; }
            isize n = read(fds[i].fd, (cchar*)buf, 4096);
            if (n <= 0)
            {
                close(fds[i].fd);
                if ((i32)i == outIdx) outOpen = false;
                else if ((i32)i == errIdx) errOpen = false;
            }
            else if (showGcc)
            {
                if ((i32)i == outIdx) write(1, (const cchar*)buf, (usize)n);
                else write(2, (const cchar*)buf, (usize)n);
            }
            i++;
        }
    }
    dealloc<u8>(buf);
}

/* multi-TU compile: each generated C file becomes <out>.d/<name>.c,
 * compiled to <name>.o by a parallel gcc -c pool, then linked once.
 * Returns the link/compile status (127 = could not start gcc). */
i32 runGccMulti(str outPath, str opt, CodegenResult* cg, bool hasMain, bool showGcc, Slice* linkLibs, u32 linkLibsLen, Slice* linkFlags, u32 linkFlagsLen)
{
    str cc = ccPick();
    /* gcc consumes coral_pch.h.gch; other drivers (clang) parse the
     * header text themselves, so the .gch step is gcc-only */
    bool isGcc = slContains(Slice { cc.ptr, cc.len }, "gcc");

    /* <out>.d/ holds the per-TU sources and objects */
    usize outLen = outPath.len;
    u8* dirBuf = alloc<u8>(outLen + 4);
    if (dirBuf == null) { dealloc<u8>(cc.ptr); return 1; }
    usize di = 0;
    while (di < outLen) { dirBuf[di] = outPath.ptr[di]; di++; }
    dirBuf[di] = 46; dirBuf[di + 1] = 100; dirBuf[di + 2] = 0;
    str dirS = str { .ptr = dirBuf, .len = outLen + 2 };
    Result<bool, IoError> mk = createDirRecursive(dirS, 493);
    if (mk.isErr() || !mk.unwrap()) { dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }

    bool release = opt.len == 7 && opt.ptr[0] == 114 && opt.ptr[1] == 101 && opt.ptr[2] == 108 && opt.ptr[3] == 101 && opt.ptr[4] == 97 && opt.ptr[5] == 115 && opt.ptr[6] == 101;

    /* shared decls → coral_pch.h (+ .gch under gcc); every TU .c
     * starts with #include "coral_pch.h" */
    Slice pch = cg->pch;
    if (pch.ptr != null && pch.len > 0)
    {
        usize hlen = dirS.len + 1 + 11;
        u8* hp = alloc<u8>(hlen + 1);
        if (hp == null) { dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }
        usize w = 0;
        while (w < dirS.len) { hp[w] = dirS.ptr[w]; w++; }
        hp[w] = 47; w++;
        const cchar* hn = C"coral_pch.h";
        u32 hi = 0;
        while (hi < 11) { hp[w] = (u8)hn[hi]; w++; hi++; }
        hp[w] = 0;
        str hps = str { .ptr = hp, .len = hlen };
        if (!writeFile(hps, pch)) { dealloc<u8>(hp); dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }

        if (isGcc)
        {
            /* <dir>/coral_pch.h.gch */
            u8* gp = alloc<u8>(hlen + 5);
            w = 0;
            while (w < dirS.len) { gp[w] = dirS.ptr[w]; w++; }
            gp[w] = 47; w++;
            hi = 0;
            while (hi < 11) { gp[w] = (u8)hn[hi]; w++; hi++; }
            gp[w] = 46; gp[w + 1] = 103; gp[w + 2] = 99; gp[w + 3] = 104; gp[w + 4] = 0;
            str gps = str { .ptr = gp, .len = hlen + 4 };

            Vec<str> hargs = Vec<str>::new();
            hargs.push("-std=gnu11");
            if (release) hargs.push("-O2");
            else if (opt.len == 4 && opt.ptr[0] == 115 && opt.ptr[1] == 105 && opt.ptr[2] == 122 && opt.ptr[3] == 101) hargs.push("-Os");
            else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 49) hargs.push("-O1");
            else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 51) hargs.push("-O3");
            else { hargs.push("-O0"); hargs.push("-g"); }
            hargs.push("-x");
            hargs.push("c-header");
            hargs.push(hps);
            hargs.push("-o");
            hargs.push(gps);
            Result<Process, IoError> hsr = spawn(cc, &hargs);
            i32 hst = 127;
            if (!hsr.isErr())
            {
                Process hp2 = hsr.unwrap();
                close((i32)hp2.stdinFd);
                drainGcc(&hp2, showGcc);
                Result<ProcessResult, IoError> hw = waitFor(&hp2);
                hst = hw.isErr() ? 127 : hw.unwrap().exitCode;
            }
            dealloc<u8>(gp);
            if (hst != 0) { dealloc<u8>(hp); dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return hst; }
        }
        dealloc<u8>(hp);
    }

    /* per-TU paths: <dir>/<name>.c and <dir>/<name>.o */
    u32 n = cg->tusLen;
    Slice* cpaths = alloc<Slice>((usize)n);
    Slice* opaths = alloc<Slice>((usize)n);
    i64 nproc = sysconf(84); /* _SC_NPROCESSORS_ONLN */
    u32 coreCap = (u32)(nproc > 0 && nproc < 6 ? nproc : (nproc >= 6 ? 6 : 4));
    /* never run more cc1s than free memory affords (~512MB each),
     * and never fewer than one — parallel gcc OOM'd a 9GB desktop */
    u32 memCap = memAvailMB() / 512;
    u32 maxPar = memCap < coreCap ? memCap : coreCap;
    if (maxPar < 1) maxPar = 1;
    Process* procs = alloc<Process>((usize)maxPar);
    i32 status = 0;
    if (cpaths == null || opaths == null || procs == null) { dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }
    zero<Slice>(cpaths, (usize)n);
    zero<Slice>(opaths, (usize)n);

    /* bounded parallel pool: each batch spawns ≤ maxPar compiles,
     * then drains+waits them (draining lets cc1 exit; the rest of the
     * batch keeps running meanwhile). Bounded because each cc1 can
     * hold hundreds of MB — spawning all TUs at once OOMs. */
    u32 base = 0;
    while (base < n && status == 0)
    {
        u32 cnt = n - base < maxPar ? n - base : maxPar;
        u32 j = 0;
        while (j < cnt && status == 0)
        {
            u32 ti = base + j;
            Slice nm = cg->tus[ti].name;
            usize plen = dirS.len + 1 + nm.len + 2;
            u8* cp = alloc<u8>(plen + 1);
            usize w = 0;
            while (w < dirS.len) { cp[w] = dirS.ptr[w]; w++; }
            cp[w] = 47; w++;
            usize ni = 0;
            while (ni < nm.len) { cp[w] = nm.ptr[ni]; w++; ni++; }
            cp[w] = 46; cp[w + 1] = 99; cp[w + 2] = 0;
            str cps = str { .ptr = cp, .len = plen };
            cpaths[ti] = Slice { cp, plen };
            if (!writeFile(cps, cg->tus[ti].text)) { status = 1; break; }

            u8* op = alloc<u8>(plen + 1);
            w = 0;
            while (w < dirS.len) { op[w] = dirS.ptr[w]; w++; }
            op[w] = 47; w++;
            ni = 0;
            while (ni < nm.len) { op[w] = nm.ptr[ni]; w++; ni++; }
            op[w] = 46; op[w + 1] = 111; op[w + 2] = 0;
            str ops = str { .ptr = op, .len = plen };
            opaths[ti] = Slice { op, plen };

            Vec<str> args = Vec<str>::new();
            args.push("-std=gnu11");
            args.push("-x");
            args.push("c");
            args.push(cps);
            if (release) args.push("-O2");
            else if (opt.len == 4 && opt.ptr[0] == 115 && opt.ptr[1] == 105 && opt.ptr[2] == 122 && opt.ptr[3] == 101) args.push("-Os");
            else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 49) args.push("-O1");
            else if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 51) args.push("-O3");
            else { args.push("-O0"); args.push("-g"); }
            args.push("-c");
            args.push("-o");
            args.push(ops);
            Result<Process, IoError> sr = spawn(cc, &args);
            if (sr.isErr()) { status = 127; break; }
            procs[j] = sr.unwrap();
            j++;
        }
        u32 spawned = j;

        /* wait for every spawned compile in this batch */
        j = 0;
        while (j < spawned && status == 0)
        {
            close((i32)procs[j].stdinFd);
            drainGcc(&procs[j], showGcc);
            Result<ProcessResult, IoError> gw = waitFor(&procs[j]);
            if (gw.isErr()) { status = 127; break; }
            if (gw.unwrap().exitCode != 0) status = 3;
            j++;
        }
        while (j < spawned)
        {
            close((i32)procs[j].stdinFd);
            drainGcc(&procs[j], false);
            waitFor(&procs[j]);
            j++;
        }
        base += cnt;
    }

    if (status == 0)
    {
        /* link: all objects + flags/libs, or -r merge for !hasMain */
        Vec<str> args = Vec<str>::new();
        if (!hasMain) args.push("-r");
        u32 oi = 0;
        while (oi < n) { args.push(str { .ptr = opaths[oi].ptr, .len = opaths[oi].len }); oi++; }
        args.push("-o");
        args.push(outPath);
        if (hasMain)
        {
            if (release) args.push("-s");
            else args.push("-rdynamic");
            args.push("-x");
            args.push("none");
            u32 fi = 0;
            while (fi < linkFlagsLen) { args.push(linkFlags[fi].asStr()); fi++; }
            u32 li = 0;
            while (li < linkLibsLen)
            {
                Slice lib = linkLibs[li];
                if (linkLibIsRaw(lib)) args.push(lib.asStr());
                else { args.push("-l"); args.push(lib.asStr()); }
                li++;
            }
            args.push("-lm");
        }
        Result<Process, IoError> lr = spawn(cc, &args);
        if (lr.isErr()) status = 127;
        else
        {
            Process lp = lr.unwrap();
            close((i32)lp.stdinFd);
            drainGcc(&lp, showGcc);
            Result<ProcessResult, IoError> lw = waitFor(&lp);
            if (lw.isErr()) status = 127;
            else if (lw.unwrap().exitCode != 0) status = 3;
        }
    }

    u32 fi2 = 0;
    while (fi2 < n)
    {
        if (cpaths[fi2].ptr != null) dealloc<u8>(cpaths[fi2].ptr);
        if (opaths[fi2].ptr != null) dealloc<u8>(opaths[fi2].ptr);
        fi2++;
    }
    dealloc<Slice>(cpaths);
    dealloc<Slice>(opaths);
    dealloc<Process>(procs);
    dealloc<u8>(dirBuf);
    dealloc<u8>(cc.ptr);
    return status;
}

/* multi-TU muvm asm: each generated .s becomes <out>.d/<name>.s,
 * assembled to <name>.o by a bounded parallel pool, then linked once
 * (-no-pie: muvm asm needs it; -r merge when the unit has no main).
 * Assembler jobs are tiny — the same memory-aware cap is overkill
 * but harmless. Returns link/compile status (127 = could not start). */
i32 runAsmMulti(str outPath, str opt, MuvmResult* muv, bool hasMain, bool showGcc, Slice* linkLibs, u32 linkLibsLen, Slice* linkFlags, u32 linkFlagsLen)
{
    str cc = ccPick();
    usize outLen = outPath.len;
    u8* dirBuf = alloc<u8>(outLen + 4);
    if (dirBuf == null) { dealloc<u8>(cc.ptr); return 1; }
    usize di = 0;
    while (di < outLen) { dirBuf[di] = outPath.ptr[di]; di++; }
    dirBuf[di] = 46; dirBuf[di + 1] = 100; dirBuf[di + 2] = 0;
    str dirS = str { .ptr = dirBuf, .len = outLen + 2 };
    Result<bool, IoError> mk = createDirRecursive(dirS, 493);
    if (mk.isErr() || !mk.unwrap()) { dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }

    u32 n = muv->tusLen;
    Slice* spaths = alloc<Slice>((usize)n);
    Slice* opaths = alloc<Slice>((usize)n);
    i64 nproc = sysconf(84); /* _SC_NPROCESSORS_ONLN */
    u32 coreCap = (u32)(nproc > 0 && nproc < 6 ? nproc : (nproc >= 6 ? 6 : 4));
    u32 memCap = memAvailMB() / 512;
    u32 maxPar = memCap < coreCap ? memCap : coreCap;
    if (maxPar < 1) maxPar = 1;
    Process* procs = alloc<Process>((usize)maxPar);
    i32 status = 0;
    if (spaths == null || opaths == null || procs == null) { dealloc<u8>(dirBuf); dealloc<u8>(cc.ptr); return 1; }
    zero<Slice>(spaths, (usize)n);
    zero<Slice>(opaths, (usize)n);

    u32 base = 0;
    while (base < n && status == 0)
    {
        u32 cnt = n - base < maxPar ? n - base : maxPar;
        u32 j = 0;
        while (j < cnt && status == 0)
        {
            u32 ti = base + j;
            Slice nm = muv->tus[ti].name;
            usize plen = dirS.len + 1 + nm.len + 2;
            u8* sp = alloc<u8>(plen + 1);
            usize w = 0;
            while (w < dirS.len) { sp[w] = dirS.ptr[w]; w++; }
            sp[w] = 47; w++;
            usize ni = 0;
            while (ni < nm.len) { sp[w] = nm.ptr[ni]; w++; ni++; }
            sp[w] = 46; sp[w + 1] = 115; sp[w + 2] = 0;
            str sps = str { .ptr = sp, .len = plen };
            spaths[ti] = Slice { sp, plen };
            if (!writeFile(sps, muv->tus[ti].text)) { status = 1; break; }

            u8* op = alloc<u8>(plen + 1);
            w = 0;
            while (w < dirS.len) { op[w] = dirS.ptr[w]; w++; }
            op[w] = 47; w++;
            ni = 0;
            while (ni < nm.len) { op[w] = nm.ptr[ni]; w++; ni++; }
            op[w] = 46; op[w + 1] = 111; op[w + 2] = 0;
            str ops = str { .ptr = op, .len = plen };
            opaths[ti] = Slice { op, plen };

            Vec<str> args = Vec<str>::new();
            args.push("-x");
            args.push("assembler");
            args.push(sps);
            args.push("-c");
            args.push("-o");
            args.push(ops);
            Result<Process, IoError> sr = spawn(cc, &args);
            if (sr.isErr()) { status = 127; break; }
            procs[j] = sr.unwrap();
            j++;
        }
        u32 spawned = j;

        j = 0;
        while (j < spawned && status == 0)
        {
            close((i32)procs[j].stdinFd);
            drainGcc(&procs[j], showGcc);
            Result<ProcessResult, IoError> gw = waitFor(&procs[j]);
            if (gw.isErr()) { status = 127; break; }
            if (gw.unwrap().exitCode != 0) status = 3;
            j++;
        }
        while (j < spawned)
        {
            close((i32)procs[j].stdinFd);
            drainGcc(&procs[j], false);
            waitFor(&procs[j]);
            j++;
        }
        base += cnt;
    }

    if (status == 0)
    {
        /* link: -no-pie (muvm asm requirement); -r merge into one
         * relocatable object when the unit has no main */
        Vec<str> args = Vec<str>::new();
        args.push("-no-pie");
        if (!hasMain) args.push("-r");
        u32 oi = 0;
        while (oi < n) { args.push(str { .ptr = opaths[oi].ptr, .len = opaths[oi].len }); oi++; }
        args.push("-o");
        args.push(outPath);
        if (hasMain)
        {
            args.push("-rdynamic");
            args.push("-x");
            args.push("none");
            u32 fi = 0;
            while (fi < linkFlagsLen) { args.push(linkFlags[fi].asStr()); fi++; }
            u32 li = 0;
            while (li < linkLibsLen)
            {
                Slice lib = linkLibs[li];
                if (linkLibIsRaw(lib)) args.push(lib.asStr());
                else { args.push("-l"); args.push(lib.asStr()); }
                li++;
            }
            args.push("-lm");
        }
        Result<Process, IoError> lr = spawn(cc, &args);
        if (lr.isErr()) status = 127;
        else
        {
            Process lp = lr.unwrap();
            close((i32)lp.stdinFd);
            drainGcc(&lp, showGcc);
            Result<ProcessResult, IoError> lw = waitFor(&lp);
            if (lw.isErr()) status = 127;
            else if (lw.unwrap().exitCode != 0) status = 3;
        }
    }

    u32 fi2 = 0;
    while (fi2 < n)
    {
        if (spaths[fi2].ptr != null) dealloc<u8>(spaths[fi2].ptr);
        if (opaths[fi2].ptr != null) dealloc<u8>(opaths[fi2].ptr);
        fi2++;
    }
    dealloc<Slice>(spaths);
    dealloc<Slice>(opaths);
    dealloc<Process>(procs);
    dealloc<u8>(dirBuf);
    dealloc<u8>(cc.ptr);
    return status;
}

bool codeHasSlice(Slice code, str pat)
{
    if (code.ptr == null || code.len < pat.len) return false;
    /* skip to candidate first-byte hits — generated C is ~12MB, a
     * naive per-position compare shows up in profiles */
    u8 first = pat.ptr[0];
    usize i = 0;
    usize lim = code.len - pat.len;
    while (i <= lim)
    {
        while (i <= lim && code.ptr[i] != first) i++;
        if (i > lim) return false;
        bool m = true;
        usize j = 1;
        while (j < pat.len)
        {
            if (code.ptr[i + j] != pat.ptr[j]) { m = false; break; }
            j++;
        }
        if (m) return true;
        i++;
    }
    return false;
}

bool codeHasMain(Slice code)
{
    if (codeHasSlice(code, "int32_t main(")) return true;
    return codeHasSlice(code, "void main(");
}

/* muvm asm: main is exempt from mangling so it appears as a bare `main:`
 * label. check start-of-buffer and newline-before to avoid matching
 * `foo_main:` / `crl$...$main:`. */
bool asmHasMain(Slice body)
{
    if (body.ptr == null || body.len < 5) return false;
    if (body.ptr[0] == 109 && body.ptr[1] == 97 && body.ptr[2] == 105 && body.ptr[3] == 110 && body.ptr[4] == 58) return true;
    return codeHasSlice(body, "\nmain:");
}

/* one compilation unit → one binary/object. The build path calls this with
 * the builder's in-memory module table; single-file mode passes nulls.
 * o->muvm selects the muvm backend (o->emitAsm/emitIr keep the .s/.muvm
 * for inspection). Bundles the option fields into one pointer to stay
 * under codegen's 16-argument cap. */
pub i32 compileUnitTo(str inPath, str outPath, Options* o, Slice* modKeys, Slice* modVals, u32 modLen)
{
    usize len = 0;
    Slice src = readFile(inPath, &len);
    u8* inZ = sliceCStr(Slice::fromStr(inPath));
    if (src.ptr == null) {
        print("error: cannot read {}\n", (const cchar*)inZ);
        dealloc<u8>(inZ);
        return 1;
    }
    AnalyzeOptions aopts = {
        .noPrelude = o->noPrelude,
        .freestanding = o->freestanding,
        .keepOnError = false,
        .collectDocs = false,
        .colorMode = o->colorMode,
    };
    bool timed = getenv(C"CORALC_TIME") != null;
    Timespec t0 = nowMonotonic();
    CompileUnit unit = analyzeForCompile(src.ptr, len, inZ, o->flagNames, o->flagValues, o->flagsCount, o->errorLimit, o->allowIntPtr, o->quiet, modKeys, modVals, modLen, &aopts, null);
    Timespec t1 = nowMonotonic();
    if (unit.ctx == null) {
        print("error: compile failed {} errors!!\n",
               (unit.parseErrors + unit.semanticErrors + unit.monoErrors));
        dealloc<u8>(inZ);
        return 2;
    }

    // generated C sits next to the output: <out>.c
    usize outLen = outPath.len;
    u8* cPath = alloc<u8>(outLen + 3);
    if (cPath == null) { freeUnit(&unit); dealloc<u8>(inZ); return 1; }
    usize ci = 0;
    while (ci < outLen) { cPath[ci] = outPath.ptr[ci]; ci++; }
    cPath[ci] = 46; cPath[ci + 1] = 99; cPath[ci + 2] = 0;

    Arena a;
    a.init(4194304);

    Slice code = Slice { null, 0 };
    bool hasMain = false;
    bool failed = false;
    CodegenResult cgKeep;
    bool multiTu = false;
    u8* mergedBuf = null;
    MuvmResult muvKeep;
    bool muvMulti = false;

    if (o->muvm)
    {
        CallingConvention cc = platformCallingConvention(o->flagNames, o->flagValues, o->flagsCount);
        MuvmResult muv = generateMuvm(unit.ctx, unit.file, unit.mono, unit.engineObj, &a, o->opt.asStr(), o->safetyMode, o->emitIr, cc);
        // the .muvm dump lands next to the output whenever --emit-ir asked
        // for one, validation failure or not: a failed compile is exactly
        // when the IR is worth inspecting
        if (o->emitIr && muv.irText.ptr != null)
        {
            u8* irPath = alloc<u8>(outLen + 6);
            if (irPath != null) {
                usize ii = 0;
                while (ii < outLen) { irPath[ii] = outPath.ptr[ii]; ii++; }
                irPath[ii] = 46; irPath[ii + 1] = 109; irPath[ii + 2] = 117;
                irPath[ii + 3] = 118; irPath[ii + 4] = 109; irPath[ii + 5] = 0;
                if (!writeFile(str { .ptr = irPath, .len = outLen + 5 }, muv.irText)) {
                    print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (const cchar*)irPath);
                } else {
                    print("coralc: emit {} ({} bytes)\n", (const cchar*)irPath, muv.irText.len);
                }
                dealloc<u8>(irPath);
            }
        }
        if (muv.errors > 0 || (muv.asmText.ptr == null && muv.tusLen == 0)) {
            print("error: muvm codegen failed ({} errors)\n", muv.errors);
            failed = true;
        } else if (muv.tusLen > 1 && muv.tus != null) {
            /* multi-TU asm: hasMain is program-wide (any TU may own
             * it); the .s files land in <out>.d/ via runAsmMulti —
             * --emit-asm mirrors them there eagerly for inspection */
            hasMain = false;
            u32 mti = 0;
            while (mti < muv.tusLen)
            {
                if (asmHasMain(muv.tus[mti].text)) { hasMain = true; break; }
                mti++;
            }
            muvKeep = muv;
            muvMulti = true;
            if (o->emitAsm)
            {
                u8* dirBuf = alloc<u8>(outLen + 4);
                if (dirBuf != null)
                {
                    usize di = 0;
                    while (di < outLen) { dirBuf[di] = outPath.ptr[di]; di++; }
                    dirBuf[di] = 46; dirBuf[di + 1] = 100; dirBuf[di + 2] = 0;
                    str dirS = str { .ptr = dirBuf, .len = outLen + 2 };
                    createDirRecursive(dirS, 493);
                    mti = 0;
                    while (mti < muv.tusLen)
                    {
                        Slice nm = muv.tus[mti].name;
                        usize plen = dirS.len + 1 + nm.len + 2;
                        u8* sp = alloc<u8>(plen + 1);
                        usize w = 0;
                        while (w < dirS.len) { sp[w] = dirS.ptr[w]; w++; }
                        sp[w] = 47; w++;
                        usize ni = 0;
                        while (ni < nm.len) { sp[w] = nm.ptr[ni]; w++; ni++; }
                        sp[w] = 46; sp[w + 1] = 115; sp[w + 2] = 0;
                        str sps = str { .ptr = sp, .len = plen };
                        if (!writeFile(sps, muv.tus[mti].text))
                        {
                            print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (const cchar*)sp);
                            failed = true;
                        }
                        else
                        {
                            print("coralc: emit {} ({} bytes)\n", (const cchar*)sp, muv.tus[mti].text.len);
                        }
                        dealloc<u8>(sp);
                        mti++;
                    }
                    dealloc<u8>(dirBuf);
                }
            }
        } else {
            code = muv.asmText;
            hasMain = asmHasMain(code);
            if (o->emitAsm)
            {
                u8* asmPath = alloc<u8>(outLen + 3);
                if (asmPath != null) {
                    usize si2 = 0;
                    while (si2 < outLen) { asmPath[si2] = outPath.ptr[si2]; si2++; }
                    asmPath[si2] = 46; asmPath[si2 + 1] = 115; asmPath[si2 + 2] = 0;
                    if (!writeFile(str { .ptr = asmPath, .len = outLen + 2 }, code)) {
                        print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (const cchar*)asmPath);
                    } else {
                        print("coralc: emit {} ({} bytes)\n", (const cchar*)asmPath, code.len);
                    }
                    dealloc<u8>(asmPath);
                }
            }
        }
    }
    else
    {
        CodegenResult cg = generateC(unit.ctx, unit.file, unit.mono, &a, unit.engineObj);
        if (cg.errors > 0 || cg.tus == null || cg.tusLen == 0) {
            print("error: codegen failed ({} errors)\n", cg.errors);
            failed = true;
        } else {
            hasMain = false;
            u32 ti = 0;
            while (ti < cg.tusLen)
            {
                if (codeHasMain(cg.tus[ti].text)) hasMain = true;
                ti++;
            }
            if (o->emitC)
            {
                /* <out>.d/<name>.c per TU; a lone TU also lands at
                 * <out>.c for --emit-c compatibility */
                u8* dirBuf = alloc<u8>(outLen + 4);
                if (dirBuf != null)
                {
                    usize di = 0;
                    while (di < outLen) { dirBuf[di] = outPath.ptr[di]; di++; }
                    dirBuf[di] = 46; dirBuf[di + 1] = 100; dirBuf[di + 2] = 0;
                    str dirS = str { .ptr = dirBuf, .len = outLen + 2 };
                    createDirRecursive(dirS, 493);
                    /* TU sources #include "coral_pch.h" — emit it too */
                    if (cg.pch.ptr != null && cg.pch.len > 0)
                    {
                        u8* hp = alloc<u8>(dirS.len + 1 + 11 + 1);
                        if (hp != null)
                        {
                            usize w = 0;
                            while (w < dirS.len) { hp[w] = dirS.ptr[w]; w++; }
                            hp[w] = 47; w++;
                            const cchar* hn = C"coral_pch.h";
                            u32 hi = 0;
                            while (hi < 11) { hp[w] = (u8)hn[hi]; w++; hi++; }
                            hp[w] = 0;
                            str hps = str { .ptr = hp, .len = dirS.len + 1 + 11 };
                            if (!writeFile(hps, cg.pch))
                            {
                                print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (cchar*)hp);
                                failed = true;
                            }
                            else
                            {
                                print("coralc: emit {} ({} bytes)\n", (const cchar*)hp, cg.pch.len);
                            }
                            dealloc<u8>(hp);
                        }
                    }
                    ti = 0;
                    while (ti < cg.tusLen)
                    {
                        Slice nm = cg.tus[ti].name;
                        usize plen = dirS.len + 1 + nm.len + 2;
                        u8* cp = alloc<u8>(plen + 1);
                        usize w = 0;
                        while (w < dirS.len) { cp[w] = dirS.ptr[w]; w++; }
                        cp[w] = 47; w++;
                        usize ni = 0;
                        while (ni < nm.len) { cp[w] = nm.ptr[ni]; w++; ni++; }
                        cp[w] = 46; cp[w + 1] = 99; cp[w + 2] = 0;
                        str cps = str { .ptr = cp, .len = plen };
                        if (!writeFile(cps, cg.tus[ti].text))
                        {
                            print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (cchar*)cp);
                            failed = true;
                        }
                        else
                        {
                            print("coralc: emit {} ({} bytes)\n", (const cchar*)cp, cg.tus[ti].text.len);
                        }
                        dealloc<u8>(cp);
                        ti++;
                    }
                    if (cg.tusLen == 1)
                    {
                        if (!writeFile(str { .ptr = cPath, .len = outLen + 2 }, cg.tus[0].text))
                        {
                            print("error[D0005]: cannot write {}\n  fix: check that the output path is writable\n", (cchar*)cPath);
                            failed = true;
                        }
                        else
                        {
                            print("coralc: emit {} ({} bytes)\n", (const cchar*)cPath, cg.tus[0].text.len);
                        }
                    }
                    dealloc<u8>(dirBuf);
                }
            }
            cgKeep = cg;
            /* debug (-O0) builds merge every TU back into one
             * self-contained .c: per-TU spawn+PCH+dwarf overhead
             * dwarfs any parallelism win there. release/size/O*
             * keep the multi-TU split where cc1 time dominates. */
            bool dbg = o->opt.len == 5 && o->opt.ptr[0] == 100 && o->opt.ptr[1] == 101 && o->opt.ptr[2] == 98 && o->opt.ptr[3] == 117 && o->opt.ptr[4] == 103;
            multiTu = !dbg;
            if (!multiTu && cg.pch.ptr != null)
            {
                /* merged = pch text + each TU's globals/bodies with the
                 * leading `#include "coral_pch.h"\n\n` line stripped */
                usize total = cg.pch.len;
                u32 ti = 0;
                while (ti < cg.tusLen)
                {
                    Slice tx = cg.tus[ti].text;
                    usize off = 0;
                    while (off + 1 < tx.len && !(tx.ptr[off] == 10 && tx.ptr[off + 1] == 10)) off++;
                    off += 2;
                    if (off < tx.len) total += tx.len - off;
                    ti++;
                }
                mergedBuf = alloc<u8>(total + 1);
                if (mergedBuf != null)
                {
                    usize w = 0;
                    usize pi = 0;
                    while (pi < cg.pch.len) { mergedBuf[w] = cg.pch.ptr[pi]; w++; pi++; }
                    ti = 0;
                    while (ti < cg.tusLen)
                    {
                        Slice tx = cg.tus[ti].text;
                        usize off = 0;
                        while (off + 1 < tx.len && !(tx.ptr[off] == 10 && tx.ptr[off + 1] == 10)) off++;
                        off += 2;
                        usize bi = off;
                        while (bi < tx.len) { mergedBuf[w] = tx.ptr[bi]; w++; bi++; }
                        ti++;
                    }
                    mergedBuf[w] = 0;
                    code = Slice { mergedBuf, w };
                }
            }
            if (multiTu) code = cg.tusLen > 0 ? cg.tus[0].text : Slice { null, 0 };
        }
    }

    if (failed) {
        a.freeAll();
        dealloc<u8>(cPath);
        dealloc<u8>(inZ);
        freeUnit(&unit);
        return 3;
    }

    Timespec t2 = nowMonotonic();
    if (timed)
    {
        Timespec d0 = subTimespec(t1, t0); Timespec d1 = subTimespec(t2, t1);
        printf(C"coralc: time analyze=%d.%03ds codegen=%d.%03ds\n",
            (i32)d0.sec, (i32)(d0.nsec / 1000000),
            (i32)d1.sec, (i32)(d1.nsec / 1000000));
    }
    i32 rc = 0;
    if (o->dryRun) {
        u8* outZ = sliceCStr(Slice::fromStr(outPath));
        print("coralc: dry run, would link {}\n", (const cchar*)outZ);
        dealloc<u8>(outZ);
    } else {
        i32 st;
        if (muvMulti)
        {
            st = runAsmMulti(outPath, o->opt.asStr(), &muvKeep, hasMain, o->showGcc, o->linkLibs, o->linkLibsLen, o->linkFlags, o->linkFlagsLen);
        }
        else if (multiTu)
        {
            st = runGccMulti(outPath, o->opt.asStr(), &cgKeep, hasMain, o->showGcc, o->linkLibs, o->linkLibsLen, o->linkFlags, o->linkFlagsLen);
        }
        else
        {
            st = runGcc(outPath, o->opt.asStr(), code, hasMain, o->showGcc, o->muvm, o->linkLibs, o->linkLibsLen, o->linkFlags, o->linkFlagsLen);
        }
        if (mergedBuf != null) dealloc<u8>(mergedBuf);
        Timespec t3 = nowMonotonic();
        if (timed)
        {
            Timespec d2 = subTimespec(t3, t2);
            printf(C"coralc: time gcc=%d.%03ds\n", (i32)d2.sec, (i32)(d2.nsec / 1000000));
        }
        if (st != 0) {
            print("error[D0004]: C backend failed (status {}); rerun with --show-gcc for details\n  fix: ensure gcc is installed and on PATH\n", (i32)st);
            rc = 3;
        }
    }

    a.freeAll();
    dealloc<u8>(cPath);
    dealloc<u8>(inZ);
    freeUnit(&unit);
    return rc;
}

pub i32 compileFile(Options* opts)
{
    /* also surfacing build-file flags: the manifest's `flags = [ "NAME=VALUE",
     * ... ]` list merges into the compile-time flag table (see Options).  */
    if (opts->buildFileSet)
    {
        usize fbuflen = 0;
        Slice fsrc = readFile(opts->buildFile.asStr(), &fbuflen);
        if (fsrc.ptr != null && fbuflen > 0)
        {
            Arena fa;
            fa.init(1 << 18);
            CrlbParser fp;
            fp.init(&fa, fsrc);
            CrlbNode* rootp = fp.parseFile();
            if (rootp != null && fp.errors == 0)
            {
                usize bi = 0;
                while (bi < rootp->children.len)
                {
                    CrlbNode* c = rootp->children.data + bi;
                    if (c->kind == CrlbNodeKind::Build)
                    {
                        // find fields.
                        usize fi = 0;
                        while (fi < c->fields.len)
                        {
                            CrlbField* f = c->fields.data + fi;
                            if (f->name.len == 5 && f->name.ptr[0] == 102 && f->name.ptr[1] == 108 && f->name.ptr[2] == 97 && f->name.ptr[3] == 103 && f->name.ptr[4] == 115)
                            {
                                // Value::List
                                usize vi = 0;
                                ValueArray* va = f->value.payload.List.value;
                                if (va != null) {
                                while (vi < va->len)
                                {
                                    Value* v = va->data + (u32)vi;
                                    if (v->tag == Value::String)
                                    {
                                        usize si = 0;
                                        usize ev = v->payload.String.value.len;
                                        while (si < ev)
                                        {
                                            if (v->payload.String.value.ptr[si] == 61) break;
                                            si++;
                                        }
                                        if (si > 0 && si < ev && opts->flagsCount < 32)
                                        {
                                            if (opts->flagNames == null)
                                            {
                                                opts->flagNames = alloc<Slice>(32);
                                                opts->flagValues = alloc<Slice>(32);
                                            }
                                            opts->flagNames[opts->flagsCount] = Slice::from(v->payload.String.value.ptr, (usize)si);
                                            opts->flagValues[opts->flagsCount] = Slice::from(v->payload.String.value.ptr + si + 1, ev - si - 1);
                                            opts->flagsCount++;
                                        }
                                    }
                                    vi++;
                                }
                                }
                            }
                            fi++;
                        }
                    }
                    bi++;
                }
            }
        }
    }
    // output binary path: -o or input minus `.crl`
    Slice out = opts->output;
    if (out.ptr == null || out.len == 0) out = defaultOutput(opts->input);

    i32 rc = compileUnitTo(opts->input.asStr(), out.asStr(), opts, null, null, 0);
    if (rc == 0 && !opts->dryRun) {
        u8* inZ = sliceCStr(opts->input);
        u8* outZ = sliceCStr(out);
        print("coralc: built {} -> {}\n", (const cchar*)inZ, (const cchar*)outZ);
        dealloc<u8>(inZ);
        dealloc<u8>(outZ);
    }
    return rc;
}
