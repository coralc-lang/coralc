#[[no_drop_all]]
/* frontend/coralc.crl: the single coralc entry point.
 *
 * One executable: build-file parsing + builder + (later) compile.
 * Args come from /proc/self/cmdline (NUL-separated), not argc/argv.
 */

use common::slice { Slice };
use common::platform { hostArch, hostOs };
use build {
    arena { Arena },
    parser { CrlbParser },
    ast { CrlbNode, CrlbNodeKind, CrlbField, Value, ValueArray, valueArrayPush },
    builder { builderRunEx, Builder, bFileExists, bWriteAllFps, bMkdirParent, bTaskIndex, bFieldList }
};
use args { Options, Command, parseArgs, usage, usage2, addFlagPair };
use io { readFile, sliceCStr };
use map { runMap };
use init { runInit };
use tasks { runTask };
use compile { compileFile, compileUnitTo };
use diag::explain { explain };
use lsp { server { runServer } };

import core::cchar { cchar };
import core::error { __catchFatalSignals };
import std::mman { alloc, dealloc };
import std::signal { ignore, SIGPIPE };
import std::env { set };
import std::result { Result };
import std::fs { IoError };
import std::time { Timespec, nowMonotonic, subTimespec };
import platform::libc { printf, system, getenv };

pub i32 main()
{
    // a child (gcc) that exits before we finish piping the source must not
    // kill us with SIGPIPE; writes then just fail with EPIPE
    ignore(SIGPIPE);
    // a compiler crash prints the faulting signal + a symbolized backtrace
    // (the function where it happened) instead of dying silently
    __catchFatalSignals();
    Options opts;
    if (!parseArgs(&opts)) {
        usage();
        return 2;
    }
    if (opts.extras && opts.help) {
        usage2(opts.extraGroup);
        return 0;
    }
    if (opts.help) {
        usage();
        return 0;
    }
    if (opts.version) {
        printf(C"coralc 0.1.0 (coral compiler; self compiling, optimization compile phase)\n");
        return 0;
    }
    if (opts.explainSet) {
        explain(str { .ptr = opts.explain.ptr, .len = opts.explain.len });
        return 0;
    }
    if (opts.serve) {
        return runServer(opts.buildFile, opts.buildFileSet);
    }

    switch (opts.cmd)
    {
        Command::Compile => { return compileFile(&opts); },
        Command::Init => { return runInit(&opts); },
        Command::Run => {}, // stub
        Command::Task => {}, // stub
        Command::Build => {}, // stub
        Command::Map => {}, // stub
        else => { return 2; },
    }

    Slice buildPath = opts.buildFile;
    usize len = 0;
    Slice src = readFile(buildPath.asStr(), &len);

    if (src.ptr == null && !opts.buildFileSet) {
        buildPath = Slice::fromStr("build.crlb");
        src = readFile(buildPath.asStr(), &len);
    }
    if (src.ptr == null) {
        printf(C"coralc: cannot read %s\n", sliceCStr(buildPath));
        return 1;
    }

    Arena a;
    a.init(4194304);
    CrlbParser p;
    p.init(&a, src);
    CrlbNode* root = p.parseFile();
    if (root == null || p.errors > 0) {
        printf(C"error[D0006]: invalid build manifest (parse errors=%d)\n  fix: check coral.crlb syntax\n", (i32)p.errors);
        return 2;
    }

    // expand include "other.crlb" decls (relative to the including file)
    {
        u32 idepth = 0;
        while (idepth < 8)
        {
            bool anyInc = false;
            usize i = 0;
            while (i < root->children.len)
            {
                CrlbNode* c = root->children.data + i;
                if (c->kind != CrlbNodeKind::Include || !c->hasPayload) { i++; continue; }
                anyInc = true;
                usize sep = 0;
                usize k = 0;
                while (k < buildPath.len)
                {
                    if (buildPath.ptr[k] == '/') sep = k + 1;
                    k++;
                }
                usize blen = sep > 0 ? sep : 0;
                usize plen = c->payload.len;
                u8* joined = alloc<u8>(blen + plen + 1);
                k = 0;
                while (k < blen) { joined[k] = buildPath.ptr[k]; k++; }
                usize j = 0;
                while (j < plen) { joined[blen + j] = c->payload.ptr[j]; j++; }
                joined[blen + plen] = 0;
                usize ilen = 0;
                Slice isrc = readFile(str { .ptr = joined, .len = blen + plen }, &ilen);
                if (isrc.ptr == null)
                {
                    printf(C"coralc: cannot read include \"%s\"\n", joined);
                    return 2;
                }
                CrlbParser ip;
                ip.init(&a, isrc);
                CrlbNode* iroot = ip.parseFile();
                dealloc<u8>(joined);
                if (iroot == null || ip.errors > 0) { printf(C"error[D0006]: invalid included build manifest\n  fix: check the included .crlb syntax\n"); return 2; }
                usize nl = root->children.len - i - 1;
                CrlbNode* grown = (CrlbNode*)a.alloc((root->children.len + iroot->children.len) * @sizeof(CrlbNode), 8);
                k = 0;
                while (k < i) { grown[k] = root->children.data[k]; k++; }
                k = 0;
                while (k < iroot->children.len) { grown[i + k] = iroot->children.data[k]; k++; }
                k = 0;
                while (k < nl) { grown[i + iroot->children.len + k] = root->children.data[i + 1 + k]; k++; }
                root->children.data = grown;
                root->children.cap = root->children.len + iroot->children.len;
                root->children.len += iroot->children.len - 1;
                i += iroot->children.len;
            }
            if (!anyInc) break;
            idepth++;
        }
    }

    /* merge extends "base.crlb" into build blocks: base fields fill gaps,
     * the child's own fields always win */
    {
        u32 edepth = 0;
        while (edepth < 8)
        {
            bool anyExt = false;
            usize i = 0;
            while (i < root->children.len)
            {
                CrlbNode* c = root->children.data + i;
                i++;
                /* only build blocks extend by file path here; profile
                 * extends are names resolved inside the builder */
                if (c->kind != CrlbNodeKind::Build || !c->hasExtends) continue;
                anyExt = true;
                Slice target = c->extendsTarget;
                usize k = 0;
                usize nl = 0;
                
                while (target.ptr[k] != 0 && k < target.len) { nl++; k++; }
                usize sep = 0;
                k = 0;
                
                while (k < buildPath.len) { if (buildPath.ptr[k] == '/') sep = k + 1; k++; }
                u8* joined = alloc<u8>(sep + nl + 1);
                k = 0;
                
                while (k < sep) { joined[k] = buildPath.ptr[k]; k++; }
                usize j = 0;
                while (j < nl) { joined[sep + j] = target.ptr[j]; j++; }
                joined[sep + nl] = 0;
                usize elen = 0;
                Slice esrc = readFile(str { .ptr = joined, .len = sep + nl }, &elen);
                
                dealloc<u8>(joined);
                
                if (esrc.ptr == null) { printf(C"coralc: cannot read extends target\n"); return 2; }
                CrlbParser ep;
                ep.init(&a, esrc);
                
                CrlbNode* eroot = ep.parseFile();
                if (eroot == null || ep.errors > 0) { printf(C"error[D0006]: invalid extended build manifest\n  fix: check the extended .crlb syntax\n"); return 2; }
                CrlbNode* ebuild = null;
                usize q = 0;
                while (q < eroot->children.len)
                {
                    if (eroot->children.data[q].kind == CrlbNodeKind::Build) { ebuild = eroot->children.data + q; break; }
                    q++;
                }
                if (ebuild == null) { continue; }
                usize newcap = c->fields.len + ebuild->fields.len;
                CrlbField* merged = (CrlbField*)a.alloc(newcap * @sizeof(CrlbField), 8);
                k = 0;
                while (k < c->fields.len) { merged[k] = c->fields.data[k]; k++; }
                usize w = c->fields.len;
                usize m = 0;
                while (m < ebuild->fields.len)
                {
                    CrlbField* bf = ebuild->fields.data + m;
                    bool found = false;
                    usize f = 0;
                    while (f < c->fields.len)
                    {
                        CrlbField* cf = c->fields.data + f;
                        if (cf->name.len == bf->name.len)
                        {
                            usize eq = 0;
                            bool same = true;
                            while (eq < cf->name.len) { if (cf->name.ptr[eq] != bf->name.ptr[eq]) { same = false; break; } eq++; }
                            if (same) { found = true; break; }
                        }
                        f++;
                    }
                    if (!found) { merged[w] = bf[0]; w++; }
                    m++;
                }
                c->fields.data = merged;
                c->fields.cap = newcap;
                c->fields.len = w;
                c->hasExtends = false;
            }
            if (!anyExt) break;
            edepth++;
        }
    }

    switch (opts.cmd)
    {
        Command::Map => { return runMap(&opts, root, &a, src); },
        else => {},
    }

    /* inject CLI --profile / --strict into the build block's flags list so
     * the builder's flag handling sees them (profile=NAME is a k=v pair,
     * --strict is an option). appends after the crlb's own flags: the
     * builder's profile select scans last-match-wins, so CLI wins. */
    if (opts.profileSet || opts.strict)
    {
        CrlbNode* bn = null;
        usize bni = 0;
        while (bni < root->children.len)
        {
            if (root->children.data[bni].kind == CrlbNodeKind::Build) { bn = root->children.data + bni; break; }
            bni++;
        }
        if (bn != null)
        {
            CrlbField* ff = null;
            usize fxi = 0;
            while (fxi < bn->fields.len)
            {
                if (bn->fields.data[fxi].name.eq(Slice::fromStr("flags"))) { ff = bn->fields.data + fxi; break; }
                fxi++;
            }
            if (ff != null && ff->value.tag == Value::List && ff->value.payload.List.value != null)
            {
                ValueArray* arr = ff->value.payload.List.value;
                if (opts.strict)
                {
                    Value sv = Value::String { .value = Slice::fromStr("--strict") };
                    valueArrayPush(arr, sv);
                }
                if (opts.profileSet)
                {
                    usize plen = 8 + opts.profile.len;
                    u8* pbuf = alloc<u8>(plen);
                    if (pbuf != null)
                    {
                        Slice tag = Slice::fromStr("profile=");
                        usize pi = 0;
                        while (pi < 8) { pbuf[pi] = tag.ptr[pi]; pi++; }
                        pi = 0;
                        while (pi < opts.profile.len) { pbuf[8 + pi] = opts.profile.ptr[pi]; pi++; }
                        Value pv = Value::String { .value = Slice { pbuf, plen } };
                        valueArrayPush(arr, pv);
                    }
                }
            }
        }
    }

    Builder b;
    b.compilePhaseReached = false;
    Timespec buildStart = nowMonotonic();
    i32 errs = builderRunEx(root, &a, opts.force, opts.mapOnly, opts.dryRun, false, &b);
    if (errs != 0) return 3;
    if (opts.mapOnly) return 0;
    opts.linkLibs = b.linkLibs;
    opts.linkLibsLen = b.linkLibsLen;
    opts.linkFlags = b.linkFlags;
    opts.linkFlagsLen = b.linkFlagsLen;

    /* the build file (or a profile) chooses the optimization level unless
     * the command line set one explicitly; pass it to the backend */
    if (!opts.optSet) opts.opt = b.opt;

    /* env = { NAME = "value"; } in the build block: set for the rest of
     * this process (the gcc spawn and tasks inherit them). */
    {
        usize ei = 0;
        while (ei < b.build->children.len)
        {
            CrlbNode* en = b.build->children.data + ei;
            if (en->kind == CrlbNodeKind::Env)
            {
                usize fi2 = 0;
                while (fi2 < en->fields.len)
                {
                    CrlbField* ef = en->fields.data + fi2;
                    if (ef->value.tag == Value::String)
                    {
                        Result<bool, IoError> es = set(ef->name.asStr(), ef->value.payload.String.value.asStr());
                        if (es.isErr() && !opts.quiet)
                            printf(C"coralc: env %.*s not set\n", (i32)ef->name.len, ef->name.ptr);
                    }
                    fi2++;
                }
            }
            ei++;
        }
    }

    /* merge build-file flags into the CLI flag table. CLI flags occupy the
     * low indices and the parser first-match-wins, so CLI values beat crlb
     * values when both set the same name. */
    {
        u32 cf = 0;
        while (cf < b.crlbFlagPairs)
        {
            addFlagPair(&opts, b.crlbFlagNames[cf], b.crlbFlagValues[cf]);
            cf++;
        }
        if (b.crlbAllowIntPtr) opts.allowIntPtr = true;
        if (b.crlbQuiet) opts.quiet = true;
    }

    /* per-target link overrides: the build file may carry
     * `target "arch" { platform "os" { link { libs flags } } }`; the
     * effective triple comes from the merged flag table (CLI wins over
     * crlb, first match wins), defaulting to the compile-time host.
     * Exact "arch/os" beats the "arch/" any-os wildcard; a matching
     * block replaces the base link libs/flags. */
    if (b.tgtLinksLen > 0)
    {
        Slice plat = Slice { null, 0 };
        Slice arch = Slice { null, 0 };
        u32 fli = 0;
        while (fli < opts.flagsCount)
        {
            /* first match wins — CLI flags occupy the low indices */
            if (plat.len == 0 && opts.flagNames[fli].eq(Slice::fromStr("platform"))) plat = opts.flagValues[fli];
            else if (arch.len == 0 && opts.flagNames[fli].eq(Slice::fromStr("arch"))) arch = opts.flagValues[fli];
            fli++;
        }
        bool platIsTriple = false;
        usize sl = 0;
        while (sl < plat.len) { if (plat.ptr[sl] == 47) { platIsTriple = true; break; } sl++; }
        Slice want = Slice { null, 0 };
        u8* wbuf = null;
        if (platIsTriple)
        {
            want = plat;
        }
        else
        {
            str ha = hostArch();
            str ho = hostOs();
            usize al = arch.len > 0 ? arch.len : (usize)ha.len;
            usize ol = plat.len > 0 ? plat.len : (usize)ho.len;
            wbuf = alloc<u8>(al + 1 + ol + 1);
            if (wbuf != null)
            {
                usize w = 0;
                if (arch.len > 0)
                {
                    usize q = 0;
                    while (q < arch.len) { wbuf[w] = arch.ptr[q]; w++; q++; }
                }
                else
                {
                    usize q = 0;
                    while (q < (usize)ha.len) { wbuf[w] = (u8)ha.ptr[q]; w++; q++; }
                }
                wbuf[w] = 47; w++;
                if (plat.len > 0)
                {
                    usize q = 0;
                    while (q < plat.len) { wbuf[w] = plat.ptr[q]; w++; q++; }
                }
                else
                {
                    usize q = 0;
                    while (q < (usize)ho.len) { wbuf[w] = (u8)ho.ptr[q]; w++; q++; }
                }
                want = Slice::from(wbuf, w);
            }
        }
        if (want.len > 0)
        {
            i32 pick = -1;
            i32 wild = -1;
            fli = 0;
            while (fli < (u32)b.tgtLinksLen)
            {
                Slice tt = b.tgtTriples[fli];
                if (tt.len == want.len && tt.eq(want)) pick = (i32)fli;
                else if (wild < 0 && tt.len > 0 && tt.ptr[tt.len - 1] == 47)
                {
                    /* "arch/" wildcard: arch part must equal want's */
                    usize al2 = 0;
                    while (al2 < want.len && want.ptr[al2] != 47) al2++;
                    if (tt.len == al2 + 1 && tt.len - 1 == al2)
                    {
                        bool eq = true;
                        usize k = 0;
                        while (k < al2) { if (tt.ptr[k] != want.ptr[k]) { eq = false; break; } k++; }
                        if (eq) wild = (i32)fli;
                    }
                }
                fli++;
            }
            if (pick < 0) pick = wild;
            if (getenv(C"CORAL_TRACE_LINK") != null)
            {
                printf(C"tgtlink want: %.*s pick: %d wild: %d\n", (i32)want.len, want.ptr, pick, wild);
            }
            if (pick >= 0)
            {
                CrlbNode* ln = b.tgtLinks[(usize)pick];
                Slice* nl = (Slice*)b.arena->alloc(64 * @sizeof(Slice), 8);
                Slice* nf = (Slice*)b.arena->alloc(64 * @sizeof(Slice), 8);
                if (nl != null && nf != null)
                {
                    opts.linkLibs = nl;
                    opts.linkLibsLen = bFieldList(ln, Slice::fromStr("libs"), b.arena, nl, 64);
                    opts.linkFlags = nf;
                    opts.linkFlagsLen = bFieldList(ln, Slice::fromStr("flags"), b.arena, nf, 64);
                }
            }
        }
    }

    /* task commands: `coralc run` executes task "run" if the build file
     * defines one (else the output binary); `coralc <name>` runs that task.
     * Every task path builds first. */
    bool wantTask = opts.cmd == Command::Run || opts.cmd == Command::Task;
    bool haveTask = false;
    str taskName = "run";
    if (opts.cmd == Command::Task)
    {
        taskName = opts.input.asStr();
        if (bTaskIndex(&b, taskName) < 0)
        {
            printf(C"coralc: no task \"%.*s\" in the build file\n", (i32)opts.input.len, opts.input.ptr);
            return 2;
        }
        haveTask = true;
    }
    else if (opts.cmd == Command::Run)
    {
        haveTask = bTaskIndex(&b, "run") >= 0;
    }

    // up to date: nothing stale, the output binary exists, no --force
    u8* outZ = sliceCStr(b.output);
    if (outZ == null || b.output.len == 0)
    {
        printf(C"coralc: build block needs output = \"path\" (the linked binary)\n");
        return 3;
    }
    if (!opts.force && !b.anyStale && !opts.dryRun && bFileExists(b.output.asStr()))
    {
        printf(C"coralc: up to date (%s)\n", outZ);
        b.compilePhaseReached = true;
        if (wantTask)
        {
            if (haveTask)
            {
                i32 st = runTask(&b, taskName, 0);
                if (st != 0) return st;
            }
            else
            {
                i32 st = system((const cchar*)outZ);
                if (st != 0) return 3;
            }
        }
        return 0;
    }

    /* compile phase: one unit (the entry module's closure) → one binary.
     * the loader resolves imports through the builder's in-memory module
     * table first, then falls back to lib-root probing. */
    if (!bMkdirParent(b.output.asStr()))
    {
        printf(C"coralc: cannot create output directory for %s\n", outZ);
        return 3;
    }
    if (b.entryPath.ptr == null)
    {
        printf(C"coralc: entry module not resolved\n");
        return 3;
    }
    i32 rc = compileUnitTo(b.entryPath.asStr(), b.output.asStr(), &opts, b.modKeys, b.modVals, b.modLen);
    if (rc == 0)
    {
        b.compilePhaseReached = true;
        if (!opts.dryRun) bWriteAllFps(&b);
        if (!opts.quiet && !opts.dryRun)
        {
            Timespec buildEnd = subTimespec(nowMonotonic(), buildStart);
            printf(C"    Finished %s in %d.%02ds\n", outZ, (i32)buildEnd.sec, (i32)(buildEnd.nsec / 10000000));
        }
        if (wantTask)
        {
            if (haveTask)
            {
                i32 st = runTask(&b, taskName, 0);
                if (st != 0) return st;
            }
            else
            {
                i32 st = system((const cchar*)outZ);
                if (st != 0) return 3;
            }
        }
        return 0;
    }
    return 3;
}
