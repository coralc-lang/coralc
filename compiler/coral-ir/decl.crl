#[[no_drop_all]]
/* coral-ir/decl.crl — mangling, function shells, extern protos
 *
 * Mangling follows mangle.md: `_C` + `N` root segment* `E` +
 * kind-suffix, where every ident is <decimal length><raw bytes>. The
 * root is `f` for files under the entry root (segments are the file's
 * path relative to it), `l<package>` for `lib/` files (segments are
 * every component after the package directory), and `r<stem>` for
 * files outside the entry tree. Functions encode `[M<self>]F<params>_
 * <ret>`, globals `G`; generic args attach to their segment as `I…E`.
 *
 * Exempt from mangling (raw source name): `main`, `extern` decls of any
 * form (`extern`, `extern("C")`, `extern("kernel32")` — detectxed by the
 * isExtern flag bit, not by convention string), and `#[[no_mangle]]`
 * decls. The C backend uses `__` instead of `$` (its C-text emission
 * cannot spell `$` in identifiers); the two backends intentionally
 * diverge — wallvm emits asm directly. */
use lower { Wv, wvNode, wvStr, wvMbReset, wvMbCh, wvMbP, wvMbSeg, wvMbStr, wvArr,
               wvSubstTy, wvMbHex, wvMbDec, wvMbIdent, wvMbIdentStr,
               wvTypeInstanceName };
use types { wvTy, wvFindTypeDecl };
use context::context { AstContext, InternEntry };
use mono::mono { MonoInstance };
use ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param, Attribute, ATTR_NO_MANGLE }
};
use common::slice { Slice };
import wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrType, IrValueKind };

/* exempt from mangling: `main` (entry point), `extern` decls (flag bit 2
 * — any convention, incl. bare `extern` and `extern("kernel32")`), and
 * `#[[no_mangle]]` decls (ATTR_NO_MANGLE bit). All keep their raw source
 * name. `main` is matched by precomputed FNV-1a, not a byte compare:
 * the hash literal appears once, here. */
pub bool wvMangleExempt(Wv* w, NodeId declId, str name)
{
    if (name.len == 0) return true;
    if (name.len == 4 && w->ctx->hashStr(name) == 0xEA90E208) return true; /* FNV("main") */
    if (declId.index == 0) return false;
    Node* n = wvNode(w, declId);
    if (n->kind.tag != NodeKind::Decl) return false;
    Decl* d = &n->kind.payload.Decl.value;
    if (d->kind.tag == DeclKind::Func)
    {
        if ((d->kind.payload.Func.flags & 2) != 0) return true; // isExtern
        if ((d->attrBits & ATTR_NO_MANGLE) != 0) return true;
    }
    else if (d->kind.tag == DeclKind::Constant)
    {
        if ((d->kind.payload.Constant.flags & 2) != 0) return true; // isExtern
        if ((d->attrBits & ATTR_NO_MANGLE) != 0) return true;
    }
    return false;
}

/* ── mangle.md symbols ────────────────────────────────────────────────
 * `_C` scope kind-suffix, scope = `N` root segment* `E`, root `f` (entry
 * tree), `l<ident>` (lib package) or `r<ident>` (external path), and
 * every ident is <decimal length><raw bytes>. See mangle.md. */

/* host platform directory names: `lib/std/x86_64/linux/error.crl` is
 * one module namespace, not a path through arch/os dirs. FNV-1a 32
 * constants keep the check to a hash load. */
bool wvMbIsPlatformTag(Wv* w, u8* s, usize len)
{
    u32 h = w->ctx->hashStr(str { .ptr = s, .len = len });
    if (len == 6 && h == 0x5FA00F30) return true; // x86_64
    if (len == 3 && h == 0x92060801) return true; // x86
    if (len == 7 && h == 0x1FA64776) return true; // aarch64
    if (len == 5 && h == 0xB3715D77) return true; // arm64
    if (len == 3 && h == 0x386F27B5) return true; // arm
    if (len == 7 && h == 0x6B83E9AE) return true; // riscv64
    if (len == 7 && h == 0x6F90BBED) return true; // riscv32
    if (len == 6 && h == 0x0D246AB8) return true; // wasm32
    if (len == 6 && h == 0x811CD28F) return true; // wasm64
    if (len == 5 && h == 0xECBB951D) return true; // linux
    if (len == 7 && h == 0xD59726EA) return true; // windows
    if (len == 5 && h == 0x42747F82) return true; // macos
    if (len == 6 && h == 0x097682A2) return true; // darwin
    if (len == 3 && h == 0x80EB9BE6) return true; // ios
    if (len == 7 && h == 0xFA1B0B2C) return true; // android
    if (len == 7 && h == 0xF1F85674) return true; // freebsd
    if (len == 7 && h == 0x6E12B2A6) return true; // openbsd
    if (len == 6 && h == 0xC07B89D9) return true; // netbsd
    if (len == 9 && h == 0x12ADE7EF) return true; // dragonfly
    if (len == 7 && h == 0x1294D85A) return true; // solaris
    if (len == 5 && h == 0xAB756201) return true; // haiku
    if (len == 12 && h == 0x41E273FB) return true; // freestanding
    return false;
}

/* emit the scope root + path segments of a source file; the caller
 * appends the decl-name segment and the closing `E`. */
void wvMbPathScope(Wv* w, u8* path, usize pathLen)
{
    /* drop a trailing ".crl" */
    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&
        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)
        pathLen -= 4;

    /* locate the lib/ root (leading "lib/" or any "/lib/") */
    bool isLib = false;
    usize libPos = 0;
    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)
    {
        isLib = true;
        libPos = 4;
    }
    usize q = 0;
    while (!isLib && q + 5 <= pathLen)
    {
        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&
            path[q + 3] == 98 && path[q + 4] == 47)
        {
            isLib = true;
            libPos = q + 5;
        }
        q++;
    }

    if (isLib)
    {
        /* l<pkg> then every component after the package directory */
        usize pkgEnd = libPos;
        while (pkgEnd < pathLen && path[pkgEnd] != 47) pkgEnd++;
        wvMbCh(w, 108); // 'l'
        wvMbIdent(w, path + libPos, pkgEnd - libPos);
        usize segStart = pkgEnd + 1;
        /* platform dirs directly under the package (lib/std/x86_64/
         * linux/error.crl) are build-host layout, not module identity:
         * skip leading arch/os components. `target/x86_64` is real. */
        u32 stripped = 0;
        while (segStart < pathLen && stripped < 2)
        {
            usize segEnd = segStart;
            while (segEnd < pathLen && path[segEnd] != 47) segEnd++;
            if (!wvMbIsPlatformTag(w, path + segStart, segEnd - segStart)) break;
            stripped++;
            segStart = segEnd + 1;
        }
        usize i = segStart;
        while (i <= pathLen)
        {
            if (i == pathLen || path[i] == 47)
            {
                if (i > segStart) wvMbIdent(w, path + segStart, i - segStart);
                segStart = i + 1;
            }
            i++;
        }
        return;
    }

    /* local project files: the path relative to the entry file's
     * directory (the module/use root), '/' as separator */
    usize start = 0;
    bool underRoot = false;
    if (w->sema != null && w->sema->diag != null && w->sema->diag->fileCount > 0)
    {
        str entry = w->sema->diag->filePaths.at((usize)0);
        usize dirLen = 0;
        usize e = 0;
        while (e < entry.len)
        {
            if (entry.ptr[e] == 47) dirLen = e + 1;
            e++;
        }
        if (dirLen == 0)
        {
            underRoot = true;
        }
        else if (pathLen >= dirLen)
        {
            usize m = 0;
            while (m < dirLen && path[m] == entry.ptr[m]) m++;
            if (m == dirLen)
            {
                start = dirLen;
                underRoot = true;
            }
        }
    }
    if (!underRoot && pathLen > 0 && path[0] == 47)
    {
        /* absolute path outside the entry's tree: keep only the stem so
         * no system directories reach the symbol */
        usize ls = 0;
        usize i = 0;
        while (i < pathLen)
        {
            if (path[i] == 47) ls = i + 1;
            i++;
        }
        wvMbCh(w, 114); // 'r'
        wvMbIdent(w, path + ls, pathLen - ls);
        return;
    }
    while (start + 1 < pathLen && path[start] == 46 && path[start + 1] == 47)
        start += 2;
    wvMbCh(w, 102); // 'f'
    usize segStart = start;
    usize i = start;
    while (i <= pathLen)
    {
        if (i == pathLen || path[i] == 47)
        {
            if (i > segStart) wvMbIdent(w, path + segStart, i - segStart);
            segStart = i + 1;
        }
        i++;
    }
}

/* scope root + path segments for the file declaring declId */
void wvMbDeclScope(Wv* w, NodeId declId)
{
    u8* path = null;
    usize pathLen = 0;
    if (declId.index != 0 && w->sema != null && w->sema->diag != null)
    {
        Node* n = wvNode(w, declId);
        u32 fid = locFile(n->loc);
        if (fid < w->sema->diag->fileCount)
        {
            str fpath = w->sema->diag->filePaths.at((usize)fid);
            if (fpath.ptr != null && fpath.len > 0)
            {
                path = (u8*)fpath.ptr;
                pathLen = fpath.len;
            }
        }
    }
    if (pathLen == 0) { wvMbCh(w, 102); return; } // bare 'f'
    wvMbPathScope(w, path, pathLen);
}

/* mangle.md type encoding. `subs` resolves TypeParam indices left in the
 * type by a generic declaration (instance arguments); the encoder
 * substitutes at any depth, unlike wvSubstTy (top-level only). Letters
 * beyond mangle.md's table: e=i128 q=u128 C=char Q<T>=slice U..E=tuple
 * D=variadic L<v>_=comptime int T<i>_=unresolved param. */
pub void wvMbTyEnc(Wv* w, Ty t, Ty* subs, u32 subsLen, u32 depth)
{
    if (t == 0 || depth > 10) { wvMbCh(w, 118); return; } // 'v'
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { wvMbCh(w, 118); },   // v
        TypeKind::Bool => { wvMbCh(w, 98); },    // b
        TypeKind::Char => { wvMbCh(w, 67); },    // C
        TypeKind::I8 => { wvMbCh(w, 97); },      // a
        TypeKind::U8 => { wvMbCh(w, 104); },     // h
        TypeKind::I16 => { wvMbCh(w, 115); },    // s
        TypeKind::U16 => { wvMbCh(w, 116); },    // t
        TypeKind::I32 => { wvMbCh(w, 105); },    // i
        TypeKind::U32 => { wvMbCh(w, 106); },    // j
        TypeKind::I64 => { wvMbCh(w, 120); },    // x
        TypeKind::U64 => { wvMbCh(w, 109); },    // m
        TypeKind::I128 => { wvMbCh(w, 101); },   // e (not in mangle.md)
        TypeKind::U128 => { wvMbCh(w, 113); },   // q (not in mangle.md)
        TypeKind::F32 => { wvMbCh(w, 102); },    // f
        TypeKind::F64 => { wvMbCh(w, 100); },    // d
        TypeKind::Isize => { wvMbCh(w, 121); },  // y
        TypeKind::Usize => { wvMbCh(w, 122); },  // z
        TypeKind::Rawptr => { wvMbCh(w, 114); }, // r
        TypeKind::Str => { wvMbCh(w, 83); },     // S
        TypeKind::Error => { wvMbCh(w, 118); },  // v
        TypeKind::Pointer => {
            wvMbCh(w, 80); // P<T>
            wvMbTyEnc(w, e->kind.payload.Pointer.base, subs, subsLen, depth + 1);
        },
        TypeKind::Const => {
            wvMbCh(w, 75); // K<T>
            wvMbTyEnc(w, e->kind.payload.Const.base, subs, subsLen, depth + 1);
        },
        TypeKind::Comptime => {
            wvMbTyEnc(w, e->kind.payload.Comptime.base, subs, subsLen, depth + 1);
        },
        TypeKind::Slice => {
            wvMbCh(w, 81); // Q<T> (not in mangle.md)
            wvMbTyEnc(w, e->kind.payload.Slice.base, subs, subsLen, depth + 1);
        },
        TypeKind::Array => {
            wvMbCh(w, 65); // A<n>_<T>
            wvMbDec(w, (u64)e->kind.payload.Array.len);
            wvMbCh(w, 95);
            wvMbTyEnc(w, e->kind.payload.Array.base, subs, subsLen, depth + 1);
        },
        TypeKind::FnPtr => {
            wvMbCh(w, 89); // Y<params>_<ret>E
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                wvMbTyEnc(w, e->kind.payload.FnPtr.params[i], subs, subsLen, depth + 1);
                i++;
            }
            wvMbCh(w, 95);
            wvMbTyEnc(w, e->kind.payload.FnPtr.returnType, subs, subsLen, depth + 1);
            wvMbCh(w, 69);
        },
        TypeKind::Tuple => {
            wvMbCh(w, 85); // U<elems>E (not in mangle.md)
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                wvMbTyEnc(w, e->kind.payload.Tuple.elems[i], subs, subsLen, depth + 1);
                i++;
            }
            wvMbCh(w, 69);
        },
        TypeKind::TypeParam => {
            u32 idx = e->kind.payload.TypeParam.index;
            if (subs != null && idx < subsLen && subs[idx] != 0 && subs[idx] != t)
                wvMbTyEnc(w, subs[idx], subs, subsLen, depth + 1);
            else
            {
                wvMbCh(w, 84); // T<i>_
                wvMbDec(w, (u64)idx);
                wvMbCh(w, 95);
            }
        },
        TypeKind::ValueInt => {
            wvMbCh(w, 76); // L<value>_
            wvMbDec(w, e->kind.payload.ValueInt.value);
            wvMbCh(w, 95);
        },
        TypeKind::Named => {
            /* N root segments <type ident [I args E]> E */
            wvMbCh(w, 78);
            Str tn = e->kind.payload.Named.name;
            NodeId td = wvFindTypeDecl(w, tn);
            if (td.index != 0) wvMbDeclScope(w, td);
            else wvMbCh(w, 102); // 'f' — opaque name only
            wvMbIdentStr(w, wvStr(w, tn));
            u32 gl = e->kind.payload.Named.genericArgsLen;
            if (gl > 0)
            {
                wvMbCh(w, 73); // I
                u32 i = 0;
                while (i < gl)
                {
                    wvMbTyEnc(w, e->kind.payload.Named.genericArgs[i], subs, subsLen, depth + 1);
                    i++;
                }
                wvMbCh(w, 69); // E
            }
            wvMbCh(w, 69);
        },
    }
}

/* emit "<param encs>_<ret>" — the caller writes the F prefix. The self
 * parameter (if any) is encoded by the M marker, not here. */
void wvMbSig(Wv* w, Decl* d, Ty* subs, u32 subsLen)
{
    u32 np = d->kind.payload.Func.paramsLen;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 1) != 0) { i++; continue; } // self lives in M
            if ((pp->flags & 16) != 0) wvMbCh(w, 68);    // D — variadic
            else wvMbTyEnc(w, pp->typeNode, subs, subsLen, 0);
        }
        i++;
    }
    wvMbCh(w, 95); // '_'
    wvMbTyEnc(w, d->kind.payload.Func.returnType, subs, subsLen, 0);
}

/* compute the final linker name for a decl: raw for exempt decls, else
 * `_C N <root> <segments> <name> E <kind-suffix>`. The result is owned
 * by the reusable mangle buffer — copy it (via createFunc's irDupStr)
 * before the next wvMangle call. */
pub str wvMangle(Wv* w, NodeId declId, Str name)
{
    if (name == 0) return "";
    str nm = wvStr(w, name);
    if (wvMangleExempt(w, declId, nm)) return nm;

    wvMbReset(w);
    wvMbP(w, "_C");
    wvMbCh(w, 78); // N
    wvMbDeclScope(w, declId);
    wvMbIdentStr(w, nm);

    Node* dn = null;
    Decl* d = null;
    if (declId.index != 0)
    {
        dn = wvNode(w, declId);
        if (dn->kind.tag == NodeKind::Decl) d = &dn->kind.payload.Decl.value;
    }
    wvMbCh(w, 69); // E
    if (d != null && d->kind.tag == DeclKind::Func)
    {
        wvMbCh(w, 70); // F
        wvMbSig(w, d, null, 0);
    }
    else
    {
        wvMbCh(w, 71); // G
    }
    return wvMbStr(w);
}

/* The lexer keeps a string token's source span, quotes and all. The text
 * `extern("C")` names the C ABI library `C`; the IR slot must hold that
 * name, not the literal's syntax, or every dump re-escapes the quotes. */
str wvExternLibName(Wv* w, Str lib)
{
    str s = wvStr(w, lib);
    if (s.len >= 2 && s.ptr[0] == '"' && s.ptr[s.len - 1] == '"')
        return str::fromParts(s.ptr + 1, s.len - 2);
    return s;
}

/* declare an IrFunc shell for a Func decl under an already-composed
 * symbol name; selfTy, when non-null, is prepended as parameter 0 —
 * the receiver of a method whose Coral params never spell `self`.
 * ptypes comes from the Wv arena: wallvm stores the pointer in the
 * interned Func type for its whole lifetime. */
IrFunc* wvDeclareFuncNamed(Wv* w, NodeId declId, Decl* d, str name, IrType* selfTy)
{
    /* stabilize the symbol before any wvTy below: instance-typed
     * signatures rewrite w->mb through wvTypeInstanceName, and `name`
     * is a view into it (the caller's compose would silently become
     * the instance type name) */
    if (name.ptr != null && name.len > 0)
    {
        Str ni = w->ctx->intern(name);
        if (ni != 0) name = wvStr(w, ni);
    }
    IrType* retTy = wvTy(w, d->kind.payload.Func.returnType, 0);

    u32 np = d->kind.payload.Func.paramsLen;
    u32 extra = selfTy != null ? 1 : 0;
    u32 realNp = 0;
    IrType** ptypes = null;
    if (np + extra > 0) ptypes = (IrType**)wvArr(w, (usize)(np + extra), 8);
    if (selfTy != null && ptypes != null) { ptypes[0] = selfTy; realNp = 1; }
    bool hasVararg = false;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) != 0) { hasVararg = true; i++; continue; }
            ptypes[realNp] = wvTy(w, pp->typeNode, 0);
            realNp++;
        }
        i++;
    }
    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);
    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);
    if ((d->kind.payload.Func.flags & 2) != 0)
    {
        f->isExtern = true;
        /* wallvm externs registry: import-table/linker consumption reads
         * {isExtern, externLib, externSym}. `extern("lib")` carries the
         * library; a bare extern leaves it empty (default libs). The
         * symbol the import binds is the raw name — externs are
         * mangle-exempt, so base.name is already it. */
        Str lib = d->kind.payload.Func.externLib;
        if (lib != 0) f->externLib = wvExternLibName(w, lib);
        f->externSym = f->base.name;
    }
    return f;
}

/* declare an IrFunc (extern or forward shell) for a Func decl; returns
 * the func, or null on error. */
pub IrFunc* wvDeclareFunc(Wv* w, NodeId declId, Decl* d)
{
    str name = wvMangle(w, declId, d->kind.payload.Func.name);
    return wvDeclareFuncNamed(w, declId, d, name, null);
}

/* declare the shell for a method under its `owner_method` symbol */
pub IrFunc* wvDeclareMethod(Wv* w, NodeId mdef, Decl* d, str name, IrType* selfTy)
{
    return wvDeclareFuncNamed(w, mdef, d, name, selfTy);
}

/* how a method receives its receiver: 0 = static (no receiver), 1 =
 * implicit `self` (the receiver becomes parameter 0 — the only form
 * the parser accepts), 2 = an explicit self parameter (reserved,
 * rejected at parse time; kept so a half-parsed tree still lowers). */
pub u8 wvMethodSelfKind(Wv* w, NodeId mdef)
{
    Node* mn = wvNode(w, mdef);
    if (mn->kind.tag != NodeKind::Decl) return 1;
    Decl* md = &mn->kind.payload.Decl.value;
    if (md->kind.tag != DeclKind::Func) return 1;
    if ((md->kind.payload.Func.flags & 4) != 0) return 0; // static
    if (md->kind.payload.Func.paramsLen > 0)
    {
        Node* p0 = wvNode(w, md->kind.payload.Func.params[0]);
        if (p0->kind.tag == NodeKind::Param && (p0->kind.payload.Param.value.flags & 1) != 0)
            return 2;
    }
    return 1;
}

/* the owner name a method symbol composes: def side (an extend's self
 * type) and call side (the receiver's type) both run it, so the two
 * spellings always agree. Pointer stripped like cgOwnerName; a generic
 * instance composes its `Vec_str`-style instance base; 0 when the type
 * has no bare name. Inside an instance body the active substitutions
 * are applied first so `self: Vec<T>` reaches the concrete instance. */
pub Str wvOwnerStr(Wv* w, Ty selfTy)
{
    if (selfTy == 0) return 0;
    if (w->subsLen > 0) selfTy = wvSubstTy(w, selfTy);
    if (selfTy == 0) return 0;
    /* strip qualifiers/pointers in any order and depth — `const String*`
     * parses as Const(Pointer(…)), which a pointer-first single step
     * fell through on (owner 0 → "cannot compose the method symbol");
     * the receiver resolver unwraps the same way */
    Ty u = selfTy;
    u32 guard = 0;
    while (u != 0 && guard < 8)
    {
        guard++;
        TypeEntry* ue = w->ctx->types + u;
        if (ue->kind.tag == TypeKind::Pointer) u = ue->kind.payload.Pointer.base;
        else if (ue->kind.tag == TypeKind::Const) u = ue->kind.payload.Const.base;
        else if (ue->kind.tag == TypeKind::Comptime) u = ue->kind.payload.Comptime.base;
        else break;
    }
    if (u == 0) return 0;
    TypeEntry* ue = w->ctx->types + u;
    if (ue->kind.tag == TypeKind::Named)
    {
        if (ue->kind.payload.Named.genericArgsLen != 0)
        {
            /* a receiver inside a generic body carries the raw type param
             * (`self` in Vec<T>::push is Pointer(Named Vec<T>)) —
             * wvSubstTy only matches a top-level TypeParam, so substitute
             * each arg before composing the instance name, or the owner
             * comes out `Vec_T0` and matches no decl or instance */
            u32 gl = ue->kind.payload.Named.genericArgsLen;
            Ty* ga = (Ty*)wvArr(w, (usize)gl, 4);
            if (ga == null) return 0;
            u32 gi = 0;
            while (gi < gl)
            {
                ga[gi] = wvSubstTy(w, ue->kind.payload.Named.genericArgs[gi]);
                gi++;
            }
            Str r = wvTypeInstanceName(w, ue->kind.payload.Named.name, ga, gl);
            dealloc<Ty>(ga);
            return r;
        }
        return ue->kind.payload.Named.name;
    }
    if (ue->kind.tag == TypeKind::Str) return w->ctx->tyIdxStrLit();
    if (ue->kind.tag == TypeKind::Slice) return w->ctx->tyIdxSliceLit2();
    if (ue->kind.tag == TypeKind::Rawptr) return w->ctx->tyIdxRawptrLit2();
    return 0;
}

/* `<self>` marker for a method: v (implicit by-value receiver — the
 * pointer in lowering is an implementation detail), p (explicit self*),
 * c (explicit const self*), or 0 when the method is static (no M). */
u8 wvSelfCode(Wv* w, NodeId mdef)
{
    u8 sk = wvMethodSelfKind(w, mdef);
    if (sk == 0) return 0;
    if (sk != 2) return 118; // 'v'
    Node* mn = wvNode(w, mdef);
    if (mn->kind.tag != NodeKind::Decl) return 118;
    Decl* md = &mn->kind.payload.Decl.value;
    if (md->kind.tag != DeclKind::Func || md->kind.payload.Func.paramsLen == 0) return 118;
    Node* p0 = wvNode(w, md->kind.payload.Func.params[0]);
    if (p0->kind.tag != NodeKind::Param) return 118;
    Ty pt = p0->kind.payload.Param.value.typeNode;
    if (pt == 0) return 118;
    TypeEntry* pe = w->ctx->types + pt;
    if (pe->kind.tag == TypeKind::Const)
    {
        Ty b = pe->kind.payload.Const.base;
        if (b != 0 && (w->ctx->types + b)->kind.tag == TypeKind::Pointer) return 99; // 'c'
        return 118;
    }
    if (pe->kind.tag == TypeKind::Pointer)
    {
        Ty b = pe->kind.payload.Pointer.base;
        if (b != 0 && (w->ctx->types + b)->kind.tag == TypeKind::Const) return 99; // 'c'
        return 112; // 'p'
    }
    return 118;
}

/* method symbol: `_C N <path> <owner segment>[I args E]<method> E <M?>F sig`
 * — the owner is the `owner` string composed by wvOwnerStr on both the
 * def and call sides; args come from the instance substitution list or,
 * when absent, from selfTy's Named generic arguments (instance methods). */
pub str wvMethodMangleEx(Wv* w, NodeId mdef, Str owner, Ty selfTy, Ty* subs,
                         u32 subsLen, Str methName)
{
    if (owner == 0 || methName == 0) return "";
    str own = wvStr(w, owner);
    str mn = wvStr(w, methName);
    wvMbReset(w);
    wvMbP(w, "_C");
    wvMbCh(w, 78); // N
    wvMbDeclScope(w, mdef);
    wvMbIdentStr(w, own);

    Ty* ga = subs;
    u32 gl = subsLen;
    if (gl == 0 && ga == null && selfTy != 0)
    {
        /* peel qualifiers and pointers to the receiver's Named type */
        Ty u = selfTy;
        u32 guard = 0;
        while (u != 0 && guard < 8)
        {
            TypeEntry* ue = w->ctx->types + u;
            if (ue->kind.tag == TypeKind::Pointer) u = ue->kind.payload.Pointer.base;
            else if (ue->kind.tag == TypeKind::Const) u = ue->kind.payload.Const.base;
            else if (ue->kind.tag == TypeKind::Comptime) u = ue->kind.payload.Comptime.base;
            else break;
            guard++;
        }
        if (u != 0)
        {
            TypeEntry* ue = w->ctx->types + u;
            if (ue->kind.tag == TypeKind::Named)
            {
                ga = ue->kind.payload.Named.genericArgs;
                gl = ue->kind.payload.Named.genericArgsLen;
            }
        }
    }
    /* inside a generic body the receiver's args can still be TypeParams
     * (`Vec<T>` in Vec<T>::sortBy); resolve them through the active
     * instance substitutions so def and call sides encode the same
     * concrete types */
    Ty* eff = ga;
    u32 effLen = gl;
    if (ga != null && gl > 0 && w->subsLen > 0)
    {
        Ty* tmp = (Ty*)wvArr(w, (usize)gl, 4);
        if (tmp != null)
        {
            u32 i = 0;
            while (i < gl) { tmp[i] = wvSubstTy(w, ga[i]); i++; }
            eff = tmp;
            effLen = gl;
        }
    }
    if (effLen > 0 && eff != null)
    {
        wvMbCh(w, 73); // I
        u32 i = 0;
        while (i < effLen)
        {
            wvMbTyEnc(w, eff[i], null, 0, 0);
            i++;
        }
        wvMbCh(w, 69); // E
    }
    wvMbIdentStr(w, mn);
    wvMbCh(w, 69); // E

    u8 sc = wvSelfCode(w, mdef);
    if (sc != 0) { wvMbCh(w, 77); wvMbCh(w, sc); } // M<c>
    wvMbCh(w, 70); // F
    Node* mn2 = wvNode(w, mdef);
    if (mn2->kind.tag == NodeKind::Decl && mn2->kind.payload.Decl.value.kind.tag == DeclKind::Func)
        wvMbSig(w, &mn2->kind.payload.Decl.value, eff, effLen);
    return wvMbStr(w);
}

/* path/static-call form: no receiver type, no substitutions */
pub str wvMethodMangle(Wv* w, NodeId mdef, Str owner, Str methName)
{
    return wvMethodMangleEx(w, mdef, owner, 0, null, 0, methName);
}

/* an instance's symbol: the generic args attach to the name segment
 * (I…E), a value-specialized instance appends `W<hex>_`, and the F
 * suffix encodes the concrete parameter and return types. The instance
 * index is gone: identical specializations are deduped by mono and
 * must compose the same symbol. */
pub str wvInstanceSymbol(Wv* w, MonoInstance* inst, u32 idx)
{
    if (inst == null || inst->name == 0) return "";
    wvMbReset(w);
    wvMbP(w, "_C");
    wvMbCh(w, 78); // N
    wvMbDeclScope(w, inst->declaration);
    wvMbIdentStr(w, wvStr(w, inst->name));
    if (inst->argumentsLen > 0 && inst->arguments != null)
    {
        wvMbCh(w, 73); // I
        u32 i = 0;
        while (i < inst->argumentsLen)
        {
            wvMbTyEnc(w, inst->arguments[i], null, 0, 0);
            i++;
        }
        wvMbCh(w, 69); // E
    }
    if (inst->valueKey != 0)
    {
        wvMbCh(w, 87); // W
        wvMbHex(w, inst->valueKey);
        wvMbCh(w, 95); // _
    }
    wvMbCh(w, 69); // E
    wvMbCh(w, 70); // F
    u32 pi = 0;
    while (pi < inst->paramTypesLen)
    {
        wvMbTyEnc(w, inst->paramTypes[pi], null, 0, 0);
        pi++;
    }
    u32 ti = 0;
    while (ti < inst->tailLen)
    {
        wvMbTyEnc(w, inst->tailTypes[ti], null, 0, 0);
        ti++;
    }
    wvMbCh(w, 95); // '_'
    wvMbTyEnc(w, inst->returnType, null, 0, 0);
    return wvMbStr(w);
}

/* declare the IrFunc for a monomorphised function instance: fixed
 * params carry the instance's substituted types, and the vararg slot is
 * either specialized into named tail params (the rewritten body
 * references them by name) or kept as a real `...` */
pub IrFunc* wvDeclareInstanceFunc(Wv* w, MonoInstance* inst, str name)
{
    Node* dn = wvNode(w, inst->declaration);
    if (dn->kind.tag != NodeKind::Decl) return null;
    Decl* dd = &dn->kind.payload.Decl.value;
    if (dd->kind.tag != DeclKind::Func) return null;
    /* same mb-stabilization as wvDeclareFuncNamed: substituted
     * signatures may rewrite the view `name` points into */
    if (name.ptr != null && name.len > 0)
    {
        Str ni = w->ctx->intern(name);
        if (ni != 0) name = wvStr(w, ni);
    }
    IrType* retTy = wvTy(w, inst->returnType, 0);
    u32 np = dd->kind.payload.Func.paramsLen;
    u32 max = np + inst->tailLen + 1;
    IrType** ptypes = null;
    if (max > 0) ptypes = (IrType**)wvArr(w, (usize)max, 8);
    if (max > 0 && ptypes == null) return null;
    u32 realNp = 0;
    /* a monomorphised call site has a known tail arity: its `...` was a
     * comptime pack, already expanded into named tail params (possibly
     * zero of them). Never keep a runtime vararg window on an instance —
     * that is what made `print("a")` emit a variadic body that saves
     * registers it never reads. */
    bool hasVararg = false;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, dd->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) != 0)
            {
                if (inst->tailLen > 0 && inst->tailArgNames != null)
                {
                    u32 k = 0;
                    while (k < inst->tailLen)
                    {
                        Ty tt = inst->tailTypes[k];
                        if (tt != 0 && (w->ctx->types + tt)->kind.tag == TypeKind::Array)
                            ptypes[realNp] = w->ir->tyPtr(
                                wvTy(w, (w->ctx->types + tt)->kind.payload.Array.base, 0));
                        else
                            ptypes[realNp] = wvTy(w, tt, 0);
                        realNp++;
                        k++;
                    }
                }
                /* no recorded tail args: this instance takes no tail
                 * parameters at all */
                i++;
                continue;
            }
            Ty pt = i < inst->paramTypesLen ? inst->paramTypes[i] : pp->typeNode;
            ptypes[realNp] = wvTy(w, pt, 0);
            realNp++;
        }
        i++;
    }
    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);
    if (f == null) return null;
    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);
    return f;
}
