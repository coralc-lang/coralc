#[[no_drop_all]]
/* coral-ir/decl.crl — mangling, function shells, extern protos
 *
 * Mangling follows docs/mangle_asm.md: crl$<scope>$<segment>$…$<name>.
 * The scope is `loc` (local project files) or `lib` (`import(lib)`
 * packages). Segments are the declaring file's path components — for
 * `loc`, the parent directory and file stem; for `lib`, every component
 * after the `lib/` root. `$` separates fields, and each segment is
 * sanitized to [A-Za-z0-9_] (leading digits prefixed with `_`).
 *
 * Exempt from mangling (raw source name): `main`, `extern` decls of any
 * form (`extern`, `extern("C")`, `extern("kernel32")` — detected by the
 * isExtern flag bit, not by convention string), and `#[[no_mangle]]`
 * decls. The C backend uses `__` instead of `$` (its C-text emission
 * cannot spell `$` in identifiers); the two backends intentionally
 * diverge — wallvm emits asm directly. */
import lower { Wv, wvNode, wvStr, wvMbReset, wvMbCh, wvMbP, wvMbSeg, wvMbStr, wvArr };
import types { wvTy };
import context::context { AstContext, InternEntry };
import mono::mono { MonoInstance };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param, Attribute }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrType, IrValueKind };

/* does the decl carry the named attribute? */
pub bool wvHasAttr(Wv* w, Decl* d, str attrName)
{
    if (d->attrsLen == 0 || d->attrs == null) return false;
    u32 want = w->ctx->intern(attrName);
    u32 i = 0;
    while (i < d->attrsLen)
    {
        if (d->attrs[i].name == want) return true;
        i++;
    }
    return false;
}

/* exempt from mangling: `main` (entry point), `extern` decls (flag bit 2
 * — any convention, incl. bare `extern` and `extern("kernel32")`), and
 * `#[[no_mangle]]` decls. All keep their raw source name. */
pub bool wvMangleExempt(Wv* w, NodeId declId, str name)
{
    if (name.len == 0) return true;
    if (name.equals("main")) return true;
    if (declId.index == 0) return false;
    Node* n = wvNode(w, declId);
    if (n->kind.tag != NodeKind::Decl) return false;
    Decl* d = &n->kind.payload.Decl.value;
    if (d->kind.tag == DeclKind::Func)
    {
        if ((d->kind.payload.Func.flags & 2) != 0) return true; // isExtern
        if (wvHasAttr(w, d, "no_mangle")) return true;
    }
    else if (d->kind.tag == DeclKind::Constant)
    {
        if ((d->kind.payload.Constant.flags & 2) != 0) return true; // isExtern
        if (wvHasAttr(w, d, "no_mangle")) return true;
    }
    return false;
}

/* compute the final linker name for a decl: raw for exempt decls, else
 * crl$<scope>$<segments>$<name>. The result is owned by the reusable
 * mangle buffer — copy it (via createFunc's irDupStr) before the next
 * wvMangle call. */
pub str wvMangle(Wv* w, NodeId declId, Str name)
{
    if (name == 0) return str::empty();
    str nm = wvStr(w, name);
    if (wvMangleExempt(w, declId, nm)) return nm;

    /* declaring file path for the scope/segments */
    u8* path = null;
    usize pathLen = 0;
    if (declId.index != 0 && w->sema != null && w->sema.diag != null)
    {
        Node* n = wvNode(w, declId);
        u32 fid = locFile(n->loc);
        if (fid < w->sema.diag.fileCount)
        {
            str fpath = w->sema.diag.filePaths.at((usize)fid);
            if (fpath.ptr != null && fpath.len > 0)
            {
                path = (u8*)fpath.ptr;
                pathLen = fpath.len;
            }
        }
    }
    /* drop a trailing ".crl" */
    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&
        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)
        pathLen -= 4;

    wvMbReset(w);
    wvMbP(w, "crl");
    wvMbCh(w, 36); // '$' — field separator, not part of a segment

    /* locate the lib/ root (leading "lib/" or any "/lib/") */
    bool isLib = false;
    usize libPos = 0;
    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)
    {
        isLib = true;
        libPos = 4;
    }
    usize q = 0;
    while (!isLib && q + 5 <= pathLen)
    {
        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&
            path[q + 3] == 98 && path[q + 4] == 47)
        {
            isLib = true;
            libPos = q + 5;
        }
        q++;
    }

    if (isLib)
    {
        /* crl$lib$<seg>$<seg>$…$<name> — every path component after lib/ */
        wvMbP(w, "lib");
        wvMbCh(w, 36);
        usize i = libPos;
        usize segStart = i;
        bool firstSeg = true;
        while (i <= pathLen)
        {
            if (i == pathLen || path[i] == 47)
            {
                if (i > segStart)
                {
                    if (!firstSeg) wvMbCh(w, 36); // '$'
                    wvMbSeg(w, path + segStart, i - segStart);
                    firstSeg = false;
                }
                segStart = i + 1;
            }
            i++;
        }
    }
    else
    {
        /* crl$loc$<parentdir>$<stem>$<name> */
        wvMbP(w, "loc");
        wvMbCh(w, 36);
        usize lastSlash = pathLen;
        usize i = 0;
        while (i < pathLen)
        {
            if (path[i] == 47) lastSlash = i;
            i++;
        }
        usize prevSlash = 0;
        i = 0;
        while (i < lastSlash)
        {
            if (path[i] == 47) prevSlash = i + 1;
            i++;
        }
        bool firstSeg = true;
        if (lastSlash < pathLen && lastSlash > prevSlash)
        {
            wvMbSeg(w, path + prevSlash, lastSlash - prevSlash);
            firstSeg = false;
        }
        /* no '/' at all: the whole path is the stem */
        usize stemStart = pathLen;
        if (lastSlash < pathLen) stemStart = lastSlash + 1;
        else stemStart = 0;
        if (pathLen > stemStart)
        {
            if (!firstSeg) wvMbCh(w, 36); // '$'
            wvMbSeg(w, path + stemStart, pathLen - stemStart);
        }
    }
    wvMbCh(w, 36); // '$'
    wvMbSeg(w, nm.ptr, nm.len);
    return wvMbStr(w);
}

/* declare an IrFunc shell for a Func decl under an already-composed
 * symbol name; selfTy, when non-null, is prepended as parameter 0 —
 * the receiver of a method whose Coral params never spell `self`.
 * ptypes comes from the Wv arena: wallvm stores the pointer in the
 * interned Func type for its whole lifetime. */
IrFunc* wvDeclareFuncNamed(Wv* w, NodeId declId, Decl* d, str name, IrType* selfTy)
{
    IrType* retTy = wvTy(w, d->kind.payload.Func.returnType, 0);

    u32 np = d->kind.payload.Func.paramsLen;
    u32 extra = selfTy != null ? 1 : 0;
    u32 realNp = 0;
    IrType** ptypes = null;
    if (np + extra > 0) ptypes = (IrType**)wvArr(w, (usize)(np + extra), 8);
    if (selfTy != null && ptypes != null) { ptypes[0] = selfTy; realNp = 1; }
    bool hasVararg = false;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) != 0) { hasVararg = true; i++; continue; }
            ptypes[realNp] = wvTy(w, pp->typeNode, 0);
            realNp++;
        }
        i++;
    }
    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);
    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);
    if ((d->kind.payload.Func.flags & 2) != 0) f->isExtern = true;
    return f;
}

/* declare an IrFunc (extern or forward shell) for a Func decl; returns
 * the func, or null on error. */
pub IrFunc* wvDeclareFunc(Wv* w, NodeId declId, Decl* d)
{
    str name = wvMangle(w, declId, d->kind.payload.Func.name);
    return wvDeclareFuncNamed(w, declId, d, name, null);
}

/* declare the shell for a method under its `owner_method` symbol */
pub IrFunc* wvDeclareMethod(Wv* w, NodeId mdef, Decl* d, str name, IrType* selfTy)
{
    return wvDeclareFuncNamed(w, mdef, d, name, selfTy);
}

/* how a method receives its receiver: 0 = static (no receiver), 1 =
 * implicit `self` (the receiver becomes parameter 0 — the only form
 * the parser accepts), 2 = an explicit self parameter (reserved,
 * rejected at parse time; kept so a half-parsed tree still lowers). */
pub u8 wvMethodSelfKind(Wv* w, NodeId mdef)
{
    Node* mn = wvNode(w, mdef);
    if (mn->kind.tag != NodeKind::Decl) return 1;
    Decl* md = &mn->kind.payload.Decl.value;
    if (md->kind.tag != DeclKind::Func) return 1;
    if ((md->kind.payload.Func.flags & 4) != 0) return 0; // static
    if (md->kind.payload.Func.paramsLen > 0)
    {
        Node* p0 = wvNode(w, md->kind.payload.Func.params[0]);
        if (p0->kind.tag == NodeKind::Param && (p0->kind.payload.Param.value.flags & 1) != 0)
            return 2;
    }
    return 1;
}

/* the bare coral owner name a method symbol composes: def side (an
 * extend's self type) and call side (the receiver's type) both run it,
 * so the two spellings always agree. Pointer stripped like
 * cgOwnerName; 0 when the type has no bare name. */
pub Str wvOwnerStr(Wv* w, Ty selfTy)
{
    if (selfTy == 0) return 0;
    TypeEntry* e = w->ctx->types + selfTy;
    Ty u = selfTy;
    if (e->kind.tag == TypeKind::Pointer) u = e->kind.payload.Pointer.base;
    if (u == 0) return 0;
    TypeEntry* ue = w->ctx->types + u;
    if (ue->kind.tag == TypeKind::Const) u = ue->kind.payload.Const.base;
    else if (ue->kind.tag == TypeKind::Comptime) u = ue->kind.payload.Comptime.base;
    if (u == 0) return 0;
    ue = w->ctx->types + u;
    if (ue->kind.tag == TypeKind::Named) return ue->kind.payload.Named.name;
    if (ue->kind.tag == TypeKind::Str) return w->ctx->intern("str");
    if (ue->kind.tag == TypeKind::Slice) return w->ctx->intern("slice");
    if (ue->kind.tag == TypeKind::Rawptr) return w->ctx->intern("rawptr");
    return 0;
}

/* a method's symbol: the same path-mangled shape a file function gets,
 * but with `owner_method` as the final segment (the C backend composes
 * the same base for def and call sides). */
pub str wvMethodMangle(Wv* w, NodeId mdef, Str owner, Str methName)
{
    if (owner == 0 || methName == 0) return str::empty();
    str o = wvStr(w, owner);
    str m = wvStr(w, methName);
    usize n = o.len + 1 + m.len;
    u8* buf = (u8*)wvArr(w, n, 1);
    if (buf == null) return str::empty();
    usize k = 0;
    while (k < o.len) { buf[k] = o.ptr[k]; k++; }
    buf[o.len] = 95; // '_'
    k = 0;
    while (k < m.len) { buf[o.len + 1 + k] = m.ptr[k]; k++; }
    str comp = str { .ptr = (const u8*)buf, .len = n };
    Str cid = w->ctx->intern(comp);
    if (cid == 0) return str::empty();
    return wvMangle(w, mdef, cid);
}

/* declare an IrFunc for a monomorphisation instance */
pub IrFunc* wvDeclareInstanceFunc(Wv* w, MonoInstance* inst, str name)
{
    IrType* retTy = wvTy(w, inst->returnType, 0);
    u32 np = inst->paramTypesLen;
    IrType** ptypes = null;
    if (np > 0) ptypes = (IrType**)wvArr(w, (usize)np, 8);
    u32 i = 0;
    while (i < np) { ptypes[i] = wvTy(w, inst->paramTypes[i], 0); i++; }
    return w->ir->createFunc(name, retTy, ptypes, np);
}
