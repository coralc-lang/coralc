#[[no_drop_all]]
/* coral-ir/decl.crl — mangling, function shells, extern protos
 *
 * Mirrors codegen cgMangle/cgMangleS/cgIsCrtFn/cgEmitFuncCommon for the
 * wallvm backend. Extern decls and CRT/main names keep their raw C name;
 * everything else gets crl__loc__<parentdir>__<stem>__<name> (or
 * crl__lib__<path>__<name> for lib files). */
import lower { Wv };
import types { wvTy, wvStr, wvSlice };
import context::context { AstContext, InternEntry };
import mono::mono { MonoInstance };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrType, IrValueKind };

/* exempt from mangling: `main` (the entry point) and `extern` decls
 * (flag bit 2) — extern("C") declarations keep their raw C name, which
 * covers libc and any other C library the user declares. A future
 * #[[no_mangle]] attribute adds a third exemption here. */
bool wvMangleExempt(Wv* w, NodeId declId, str name)
{
    if (name.len == 0) return true;
    if (name.equals("main")) return true;
    if (declId.index != 0)
    {
        Node* n = wvNode(w, declId);
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* d = &n->kind.payload.Decl.value;
            if (d->kind.tag == DeclKind::Func && (d->kind.payload.Func.flags & 2) != 0) return true;
            if (d->kind.tag == DeclKind::Constant && (d->kind.payload.Constant.flags & 2) != 0) return true;
        }
    }
    return false;
}

str wvMangle(Wv* w, NodeId declId, Str name)
{
    if (name == 0) return str::empty();
    str nm = wvStr(w, name);
    if (wvMangleExempt(w, declId, nm)) return nm;

    /* declaring file path for the prefix */
    u8* path = null;
    usize pathLen = 0;
    if (declId.index != 0 && w->sema != null && w->sema.diag != null)
    {
        Node* n = wvNode(w, declId);
        u32 fid = locFile(n->loc);
        if (fid < w->sema.diag.fileCount)
        {
            str fpath = w->sema.diag.filePaths.at((usize)fid);
            if (fpath.ptr != null && fpath.len > 0)
            {
                path = (u8*)fpath.ptr;
                pathLen = fpath.len;
            }
        }
    }
    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&
        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)
        pathLen -= 4;

    wvMbReset(w);
    wvMbP(w, "crl__");

    bool isLib = false;
    usize libPos = 0;
    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)
    {
        isLib = true;
        libPos = 4;
    }
    usize q = 0;
    while (!isLib && q + 5 <= pathLen)
    {
        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&
            path[q + 3] == 98 && path[q + 4] == 47)
        {
            isLib = true;
            libPos = q + 5;
        }
        q++;
    }
    if (isLib)
    {
        wvMbP(w, "lib__");
        usize i = libPos;
        usize segStart = i;
        bool firstSeg = true;
        while (i <= pathLen)
        {
            if (i == pathLen || path[i] == 47)
            {
                if (i > segStart)
                {
                    if (!firstSeg) { wvMbCh(w, 95); wvMbCh(w, 95); }
                    wvMbSeg(w, path + segStart, i - segStart);
                    firstSeg = false;
                }
                segStart = i + 1;
            }
            i++;
        }
    }
    else
    {
        wvMbP(w, "loc__");
        usize lastSlash = pathLen;
        usize i = 0;
        while (i < pathLen)
        {
            if (path[i] == 47) lastSlash = i;
            i++;
        }
        usize prevSlash = 0;
        i = 0;
        while (i < lastSlash)
        {
            if (path[i] == 47) prevSlash = i + 1;
            i++;
        }
        bool firstSeg = true;
        if (lastSlash < pathLen && lastSlash > prevSlash)
        {
            wvMbSeg(w, path + prevSlash, lastSlash - prevSlash);
            firstSeg = false;
        }
        usize stemStart = pathLen;
        if (lastSlash < pathLen) stemStart = lastSlash + 1;
        if (pathLen > stemStart)
        {
            if (!firstSeg) { wvMbCh(w, 95); wvMbCh(w, 95); }
            wvMbSeg(w, path + stemStart, pathLen - stemStart);
        }
    }
    wvMbCh(w, 95);
    wvMbCh(w, 95);
    wvMbSeg(w, nm.ptr, nm.len);
    return wvMbStr(w);
}

/* declare an IrFunc (extern or forward shell) for a Func decl; returns
 * the func, or null on error */
IrFunc* wvDeclareFunc(Wv* w, NodeId declId, Decl* d)
{
    str name = wvMangle(w, declId, d->kind.payload.Func.name);
    IrType* retTy = wvTy(w->ctx, w->file, w->ir, d->kind.payload.Func.returnType, 0);

    u32 np = d->kind.payload.Func.paramsLen;
    u32 realNp = 0;
    IrType** ptypes = null;
    if (np > 0) ptypes = alloc<IrType*>((usize)np);
    bool hasVararg = false;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) != 0) { hasVararg = true; i++; continue; }
            ptypes[realNp] = wvTy(w->ctx, w->file, w->ir, pp->typeNode, 0);
            realNp++;
        }
        i++;
    }
    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);
    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);
    if (ptypes != null) dealloc<IrType*>(ptypes);
    if ((d->kind.payload.Func.flags & 2) != 0) f->isExtern = true;
    return f;
}

/* declare an IrFunc for a monomorphisation instance */
IrFunc* wvDeclareInstanceFunc(Wv* w, MonoInstance* inst, str name)
{
    IrType* retTy = wvTy(w->ctx, w->file, w->ir, inst->returnType, 0);
    u32 np = inst->paramTypesLen;
    IrType** ptypes = null;
    if (np > 0) ptypes = alloc<IrType*>((usize)np);
    u32 i = 0;
    while (i < np) { ptypes[i] = wvTy(w->ctx, w->file, w->ir, inst->paramTypes[i], 0); i++; }
    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, np);
    if (ptypes != null) dealloc<IrType*>(ptypes);
    return f;
}
