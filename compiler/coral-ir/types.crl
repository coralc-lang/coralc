#[[no_drop_all]]
/* coral-ir/types.crl — Coral Ty/TypeKind → wallvm IrType
 *
 * wvTy is the single Ty→IrType mapper. It takes the lowering state Wv
 * (AstContext, merged File, IrContext and the arena) and a recursion
 * depth guard (self-referential structs resolve through a Pointer,
 * which breaks the cycle at depth 1; the guard is a hard stop for
 * pathological cases Phase 3 will memoize properly).
 *
 * Arena rule: wallvm's tyGetOrCreate / createStructType store the raw
 * params/fields array pointers inside the interned IrType for the whole
 * IrContext lifetime — every array handed there comes from wvArr (the
 * Wv arena), never from alloc/dealloc, and never from the stack.
 *
 * Layout note (Phase 3): #[[packed]] / #[[reorder]] struct attributes
 * are honoured here via createStructType — packed = 1-byte field
 * alignment, reorder = sort fields by descending alignment. */

use lower { Wv, wvArr, wvTyMapFind, wvTyMapSet, wvTdMapGet, wvTdMapPut, wvSubstTy,
               wvTypeInstanceName };
use ast::id { Str, NodeId, locFile };
use ast::types { Ty, TypeEntry, TypeKind };
use ast::node { Node, NodeKind };
use ast::decl { File, Decl, DeclKind, Field };
use context::context { AstContext, InternEntry };
use common::slice { Slice };
use mono::mono { MonoInstance, MonoInstanceKind, MonoSubstitution };
import wallvm::irtypes { IrContext, IrType, IrTypeKind, IrStructType };

pub str wvStr(AstContext* ctx, Str s)
{
    if (s == 0) return str::empty();
    InternEntry* e = ctx->interns + s;
    return str { .ptr = (const u8*)e.ptr, .len = e.len };
}

Slice wvSlice(AstContext* ctx, Str s)
{
    if (s == 0) return Slice { .ptr = null, .len = 0 };
    InternEntry* e = ctx->interns + s;
    return Slice { .ptr = e.ptr, .len = e.len };
}

/* find a type-named decl (struct/enum/union/variant/alias/distinct) in
 * the merged file by bare name; 0 when absent. Memoized on the interned
 * name — the merged decl list is O(#decls) per lookup and this sits in
 * the innermost type loop. */
pub NodeId wvFindTypeDecl(Wv* w, Str name)
{
    NodeId none;
    none.index = 0;
    if (w->file == null || name == 0) return none;
    bool hit = false;
    u32 mv = wvTdMapGet(w, name, &hit);
    if (hit)
    {
        if (mv >= 2) none.index = mv - 1;
        return none;
    }
    File* file = w->file;
    AstContext* ctx = w->ctx;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId id = file->decls[i];
        Node* n = ctx->nodes + id.index;
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &n->kind.payload.Decl.value;
            Str dn = 0;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => { dn = dd->kind.payload.Struct.name; },
                DeclKind::Enum => { dn = dd->kind.payload.Enum.name; },
                DeclKind::Union => { dn = dd->kind.payload.Union.name; },
                DeclKind::Variant => { dn = dd->kind.payload.Variant.name; },
                DeclKind::TypeAlias => { dn = dd->kind.payload.TypeAlias.name; },
                DeclKind::Distinct => { dn = dd->kind.payload.Distinct.name; },
                else => {},
            }
            if (dn == name)
            {
                wvTdMapPut(w, name, id.index + 1);
                return id;
            }
        }
        i++;
    }
    wvTdMapPut(w, name, 1); /* cache the miss too */
    return none;
}

pub IrType* wvTy(Wv* w, Ty t, u32 depth);

/* build a struct IrType from a struct decl's fields */
pub IrType* wvStructTy(Wv* w, Decl* dd, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    u32 n = dd->kind.payload.Struct.fieldsLen;
    if (n == 0) return ir->tyInt(8); // empty struct: 1 byte
    IrType** fts = (IrType**)wvArr(w, (usize)n, 8);
    str* fns = (str*)wvArr(w, (usize)n, 16);
    if (fts == null || fns == null) return ir->tyInt(8);
    u32 k = 0;
    u32 actual = 0;
    while (k < n)
    {
        Node* fn = ctx->nodes + dd->kind.payload.Struct.fields[k].index;
        if (fn->kind.tag == NodeKind::Field)
        {
            Field* f = &fn->kind.payload.Field.value;
            fts[actual] = wvTy(w, f->typeNode, depth + 1);
            fns[actual] = wvStr(ctx, f->name);
            actual++;
        }
        k++;
    }
    IrStructType* st = ir->createStructType(wvStr(ctx, dd->kind.payload.Struct.name),
                                            fts, fns, actual);
    return st->irType;
}

pub IrType* wvTy(Wv* w, Ty t, u32 depth);

/* the uncached Ty→IrType derivation; wvTy wraps this with the memo */
IrType* wvTyBuild(Wv* w, Ty t, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    if (t == 0 || depth > 32) return ir->tyInt(32);
    TypeEntry* e = ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { return ir->tyVoid(); },
        TypeKind::Bool => { return ir->tyInt(1); },
        TypeKind::Char => { return ir->tyInt(8); },
        TypeKind::I8 => { return ir->tyInt(8); },
        TypeKind::U8 => { return ir->tyInt(8); },
        TypeKind::I16 => { return ir->tyInt(16); },
        TypeKind::U16 => { return ir->tyInt(16); },
        TypeKind::I32 => { return ir->tyInt(32); },
        TypeKind::U32 => { return ir->tyInt(32); },
        TypeKind::I64 => { return ir->tyInt(64); },
        TypeKind::U64 => { return ir->tyInt(64); },
        TypeKind::I128 => { return ir->tyInt(128); },
        TypeKind::U128 => { return ir->tyInt(128); },
        TypeKind::F32 => { return ir->tyFloat(); },
        TypeKind::F64 => { return ir->tyDouble(); },
        TypeKind::Isize => { return ir->tyInt(64); },
        TypeKind::Usize => { return ir->tyInt(64); },
        TypeKind::Rawptr => { return ir->tyPtr(ir->tyInt(8)); },
        // str = { ptr: u8*, len: usize } — same layout as the C backend
        TypeKind::Str => {
            IrType** fts = (IrType**)wvArr(w, 2, 8);
            str* fns = (str*)wvArr(w, 2, 16);
            if (fts == null || fns == null) return ir->tyInt(8);
            fts[0] = ir->tyPtr(ir->tyInt(8));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_str", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Pointer => { return ir->tyPtr(wvTy(w, e->kind.payload.Pointer.base, depth + 1)); },
        TypeKind::Const => { return wvTy(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return wvTy(w, e->kind.payload.Comptime.base, depth + 1); },
        // slice = { ptr: T*, len: usize }
        TypeKind::Slice => {
            IrType** fts = (IrType**)wvArr(w, 2, 8);
            str* fns = (str*)wvArr(w, 2, 16);
            if (fts == null || fns == null) return ir->tyInt(8);
            fts[0] = ir->tyPtr(wvTy(w, e->kind.payload.Slice.base, depth + 1));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_slice", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Array => {
            IrType* elem = wvTy(w, e->kind.payload.Array.base, depth + 1);
            return ir->tyArray(elem, e->kind.payload.Array.len);
        },
        TypeKind::FnPtr => {
            Ty rt = e->kind.payload.FnPtr.returnType;
            u32 np = e->kind.payload.FnPtr.paramsLen;
            IrType* ret = wvTy(w, rt, depth + 1);
            if (np == 0) return ir->tyFunc(ret, null, 0, false);
            IrType** ps = (IrType**)wvArr(w, (usize)np, 8);
            if (ps == null) return ir->tyFunc(ret, null, 0, false);
            u32 i = 0;
            while (i < np) { ps[i] = wvTy(w, e->kind.payload.FnPtr.params[i], depth + 1); i++; }
            return ir->tyFunc(ret, ps, np, false);
        },
        TypeKind::Tuple => {
            u32 np = e->kind.payload.Tuple.elemsLen;
            if (np == 0) return ir->tyInt(8);
            IrType** ps = (IrType**)wvArr(w, (usize)np, 8);
            str* pns = (str*)wvArr(w, (usize)np, 16);
            if (ps == null || pns == null) return ir->tyInt(8);
            u32 i = 0;
            while (i < np) { ps[i] = wvTy(w, e->kind.payload.Tuple.elems[i], depth + 1); pns[i] = "_"; i++; }
            IrStructType* st = ir->createStructType("coral_tuple", ps, pns, np);
            return st->irType;
        },
        TypeKind::Named => {
            /* a generic instance (`Vec<str>`) resolves through the mono
             * table first: the decl itself is a parametrised template
             * whose fields only make sense under its substitutions */
            if (e->kind.payload.Named.genericArgsLen != 0)
            {
                IrType* ity = wvTypeInstanceTy(w, e->kind.payload.Named.name,
                                               e->kind.payload.Named.genericArgs,
                                               e->kind.payload.Named.genericArgsLen,
                                               depth);
                if (ity != null) return ity;
            }
            NodeId td = wvFindTypeDecl(w, e->kind.payload.Named.name);
            if (td.index == 0) return ir->tyInt(64); // unresolved named → opaque 64-bit
            Node* dn = ctx->nodes + td.index;
            if (dn->kind.tag != NodeKind::Decl) return ir->tyInt(64);
            return wvDeclTy(w, &dn->kind.payload.Decl.value, depth);
        },
        TypeKind::TypeParam => { return ir->tyInt(64); }, // erased after mono
        TypeKind::ValueInt => { return ir->tyInt(64); },
        else => { return ir->tyInt(32); },
    }
}

/* the IrType a declaring decl denotes — the Named arm's body without
 * the name lookup, so a caller that already holds the decl (method
 * collection composes the self parameter's pointee) can reuse it. */
pub IrType* wvDeclTy(Wv* w, Decl* dd, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    switch (dd->kind.tag)
    {
        DeclKind::Struct => { return wvStructTy(w, dd, depth); },
        DeclKind::Enum => {
            if ((dd->kind.payload.Enum.flags & 1) != 0)
                return wvTy(w, dd->kind.payload.Enum.backingType, depth + 1);
            return ir->tyInt(32);
        },
        DeclKind::TypeAlias => { return wvTy(w, dd->kind.payload.TypeAlias.target, depth + 1); },
        DeclKind::Distinct => { return wvTy(w, dd->kind.payload.Distinct.baseType, depth + 1); },
        DeclKind::Union => {
            // union = [size x i8], size = max field size (Phase 3:
            // real tagged layout for variant; opaque for now)
            u32 maxSz = 1;
            u32 k = 0;
            while (k < dd->kind.payload.Union.fieldsLen)
            {
                Node* fn = ctx->nodes + dd->kind.payload.Union.fields[k].index;
                if (fn->kind.tag == NodeKind::Field)
                {
                    IrType* ft = wvTy(w, fn->kind.payload.Field.value.typeNode, depth + 1);
                    u32 sz = ir->irTypeSizeOf(ft);
                    if (sz > maxSz) maxSz = sz;
                }
                k++;
            }
            return ir->tyArray(ir->tyInt(8), maxSz);
        },
        DeclKind::Variant => {
            // variant = opaque byte blob (tag + union); exact layout Phase 3
            return ir->tyArray(ir->tyInt(8), 16);
        },
        else => { return ir->tyInt(64); },
    }
}

/* does a type mention a generic parameter anywhere? (mirrors
 * cgTyHasParam — a method on a not-yet-monomorphised owner is
 * skipped by the collection pass) */
pub bool wvTyHasParam(Wv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 8) return false;
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::TypeParam => { return true; },
        TypeKind::Pointer => { return wvTyHasParam(w, e->kind.payload.Pointer.base, depth + 1); },
        TypeKind::Const => { return wvTyHasParam(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return wvTyHasParam(w, e->kind.payload.Comptime.base, depth + 1); },
        TypeKind::Slice => { return wvTyHasParam(w, e->kind.payload.Slice.base, depth + 1); },
        TypeKind::Array => { return wvTyHasParam(w, e->kind.payload.Array.base, depth + 1); },
        TypeKind::FnPtr => {
            if (wvTyHasParam(w, e->kind.payload.FnPtr.returnType, depth + 1)) return true;
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                if (wvTyHasParam(w, e->kind.payload.FnPtr.params[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Tuple => {
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                if (wvTyHasParam(w, e->kind.payload.Tuple.elems[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Named => {
            u32 i = 0;
            while (i < e->kind.payload.Named.genericArgsLen)
            {
                if (wvTyHasParam(w, e->kind.payload.Named.genericArgs[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        else => { return false; },
    }
}

/* the IrType for a concrete type instance (`Vec<str>`), built lazily
 * with that instance's substitutions active so field types resolve to
 * the concrete argument; memoised in w.instTys. Null when no mono
 * TypeInstance matches (or depth overflows a value cycle guard). */
pub IrType* wvTypeInstanceTy(Wv* w, Str name, Ty* args, u32 argsLen, u32 depth)
{
    if (w->mono == null || w->instTys == null || depth > 32) return null;
    Str want = wvTypeInstanceName(w, name, args, argsLen);
    u32 j = 0;
    while (j < w->mono.instancesLen)
    {
        MonoInstance* inst = w->mono.instances + j;
        if (inst->kind == MonoInstanceKind::TypeInstance && inst->name == name &&
            inst->argumentsLen == argsLen)
        {
            if (wvTypeInstanceName(w, inst->name, inst->arguments,
                                   inst->argumentsLen) != want)
                { j++; continue; }
            if (j >= w->instTysLen) return null;
            if (w->instTys[j] != null) return w->instTys[j];
            Node* tn = w->ctx->nodes + inst->declaration.index;
            if (tn->kind.tag != NodeKind::Decl) return null;
            MonoSubstitution* os = w->subs;
            u32 osl = w->subsLen;
            w->subs = inst->substitutions;
            w->subsLen = inst->substitutionsLen;
            IrType* ity = wvDeclTy(w, &tn->kind.payload.Decl.value, depth + 1);
            w->subs = os;
            w->subsLen = osl;
            w->instTys[j] = ity;
            return ity;
        }
        j++;
    }
    return null;
}

/* memoized Ty→IrType. A Ty still being derived is a cycle: break it at
 * the edge with a pointer-width placeholder (only reachable behind an
 * indirection — a by-value cycle has no finite layout and is rejected
 * upstream), so every Ty is built once and cached. Without this the
 * nested rebuild is exponential on std's type graph. */
pub IrType* wvTy(Wv* w, Ty t, u32 depth)
{
    IrContext* ir = w->ir;
    if (t == 0) return ir->tyInt(32);
    /* inside a monomorphised instance one Ty may denote a different
     * concrete type per instance: substitute the top level here (each
     * nested level substitutes on its own way down), and keep any type
     * that still nests a param OUT of the shared memo — the memo key is
     * the raw Ty, whose meaning depends on the active substitutions */
    t = wvSubstTy(w, t);
    if (w->subsLen > 0 && wvTyHasParam(w, t, 0))
    {
        if (depth > 32) return ir->tyInt(32);
        IrType* pr = wvTyBuild(w, t, depth);
        return pr != null ? pr : ir->tyInt(32);
    }
    u8 busy = 0;
    IrType* hit = null;
    if (wvTyMapFind(w, t, &busy, &hit))
    {
        if (busy != 0) return ir->tyPtr(ir->tyInt(8));
        if (hit != null) return hit;
    }
    if (depth > 32) return ir->tyInt(32);
    wvTyMapSet(w, t, 1, null);
    IrType* r = wvTyBuild(w, t, depth);
    if (r == null) r = ir->tyInt(32);
    wvTyMapSet(w, t, 0, r);
    return r;
}
