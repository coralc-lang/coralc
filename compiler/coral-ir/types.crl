#[[no_drop_all]]
/* coral-ir/types.crl — Coral Ty/TypeKind → wallvm IrType
 *
 * wvTy is the single Ty→IrType mapper. It takes the AstContext, the
 * merged File (for Named-type decl resolution) and the IrContext, and
 * a recursion depth guard (self-referential structs resolve through a
 * Pointer, which breaks the cycle at depth 1; the guard is a hard stop
 * for pathological cases Phase 3 will memoize properly).
 *
 * Layout note (Phase 3): #[[packed]] / #[[reorder]] struct attributes
 * are honoured here via createStructType — packed = 1-byte field
 * alignment, reorder = sort fields by descending alignment. */

import ast::id { Str, NodeId, locFile };
import ast::types { Ty, TypeEntry, TypeKind };
import ast::node { Node, NodeKind };
import ast::decl { File, Decl, DeclKind, Field };
import context::context { AstContext, InternEntry };
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrType, IrTypeKind, IrStructType };
import(lib) std::mman { alloc, dealloc };

pub str wvStr(AstContext* ctx, Str s)
{
    if (s == 0) return str::empty();
    InternEntry* e = ctx->interns + s;
    return str { .ptr = (const u8*)e.ptr, .len = e.len };
}

Slice wvSlice(AstContext* ctx, Str s)
{
    if (s == 0) return Slice { .ptr = null, .len = 0 };
    InternEntry* e = ctx->interns + s;
    return Slice { .ptr = e.ptr, .len = e.len };
}

/* find a type-named decl (struct/enum/union/variant/alias/distinct) in
 * the merged file by bare name; 0 when absent */
NodeId wvFindTypeDecl(File* file, AstContext* ctx, Str name)
{
    NodeId none;
    none.index = 0;
    if (file == null || name == 0) return none;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId id = file->decls[i];
        Node* n = ctx->nodes + id.index;
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &n->kind.payload.Decl.value;
            Str dn = 0;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => { dn = dd->kind.payload.Struct.name; },
                DeclKind::Enum => { dn = dd->kind.payload.Enum.name; },
                DeclKind::Union => { dn = dd->kind.payload.Union.name; },
                DeclKind::Variant => { dn = dd->kind.payload.Variant.name; },
                DeclKind::TypeAlias => { dn = dd->kind.payload.TypeAlias.name; },
                DeclKind::Distinct => { dn = dd->kind.payload.Distinct.name; },
                else => {},
            }
            if (dn == name) return id;
        }
        i++;
    }
    return none;
}

pub IrType* wvTy(AstContext* ctx, File* file, IrContext* ir, Ty t, u32 depth);

/* build a struct IrType from a struct decl's fields */
pub IrType* wvStructTy(AstContext* ctx, File* file, IrContext* ir, Decl* dd, u32 depth)
{
    u32 n = dd->kind.payload.Struct.fieldsLen;
    if (n == 0) return ir->tyInt(8); // empty struct: 1 byte
    IrType** fts = alloc<IrType*>((usize)n);
    str* fns = alloc<str>((usize)n);
    if (fts == null || fns == null)
    {
        if (fts != null) dealloc<IrType*>(fts);
        if (fns != null) dealloc<str>(fns);
        return ir->tyInt(8);
    }
    u32 k = 0;
    u32 actual = 0;
    while (k < n)
    {
        Node* fn = ctx->nodes + dd->kind.payload.Struct.fields[k].index;
        if (fn->kind.tag == NodeKind::Field)
        {
            Field* f = &fn->kind.payload.Field.value;
            fts[actual] = wvTy(ctx, file, ir, f->typeNode, depth + 1);
            fns[actual] = wvStr(ctx, f->name);
            actual++;
        }
        k++;
    }
    IrStructType* st = ir->createStructType(wvStr(ctx, dd->kind.payload.Struct.name),
                                            fts, fns, actual);
    IrType* res = st->irType;
    // createStructType keeps its own copies of the arrays via the type
    // intern; the temp arrays are only read during layout
    dealloc<IrType*>(fts);
    dealloc<str>(fns);
    return res;
}

pub IrType* wvTy(AstContext* ctx, File* file, IrContext* ir, Ty t, u32 depth)
{
    if (t == 0 || depth > 32) return ir->tyInt(32);
    TypeEntry* e = ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { return ir->tyVoid(); },
        TypeKind::Bool => { return ir->tyInt(1); },
        TypeKind::Char => { return ir->tyInt(8); },
        TypeKind::I8 => { return ir->tyInt(8); },
        TypeKind::U8 => { return ir->tyInt(8); },
        TypeKind::I16 => { return ir->tyInt(16); },
        TypeKind::U16 => { return ir->tyInt(16); },
        TypeKind::I32 => { return ir->tyInt(32); },
        TypeKind::U32 => { return ir->tyInt(32); },
        TypeKind::I64 => { return ir->tyInt(64); },
        TypeKind::U64 => { return ir->tyInt(64); },
        TypeKind::I128 => { return ir->tyInt(128); },
        TypeKind::U128 => { return ir->tyInt(128); },
        TypeKind::F32 => { return ir->tyFloat(); },
        TypeKind::F64 => { return ir->tyDouble(); },
        TypeKind::Isize => { return ir->tyInt(64); },
        TypeKind::Usize => { return ir->tyInt(64); },
        TypeKind::Rawptr => { return ir->tyPtr(ir->tyInt(8)); },
        // str = { ptr: u8*, len: usize } — same layout as the C backend
        TypeKind::Str => {
            IrType*[2] fts;
            str[2] fns;
            fts[0] = ir->tyPtr(ir->tyInt(8));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_str", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Pointer => { return ir->tyPtr(wvTy(ctx, file, ir, e->kind.payload.Pointer.base, depth + 1)); },
        TypeKind::Const => { return wvTy(ctx, file, ir, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return wvTy(ctx, file, ir, e->kind.payload.Comptime.base, depth + 1); },
        // slice = { ptr: T*, len: usize }
        TypeKind::Slice => {
            IrType*[2] fts;
            str[2] fns;
            fts[0] = ir->tyPtr(wvTy(ctx, file, ir, e->kind.payload.Slice.base, depth + 1));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_slice", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Array => {
            IrType* elem = wvTy(ctx, file, ir, e->kind.payload.Array.base, depth + 1);
            return ir->tyArray(elem, e->kind.payload.Array.len);
        },
        TypeKind::FnPtr => {
            Ty rt = e->kind.payload.FnPtr.returnType;
            u32 np = e->kind.payload.FnPtr.paramsLen;
            IrType* ret = wvTy(ctx, file, ir, rt, depth + 1);
            if (np == 0) return ir->tyFunc(ret, null, 0, false);
            IrType** ps = alloc<IrType*>((usize)np);
            if (ps == null) return ir->tyFunc(ret, null, 0, false);
            u32 i = 0;
            while (i < np) { ps[i] = wvTy(ctx, file, ir, e->kind.payload.FnPtr.params[i], depth + 1); i++; }
            IrType* res = ir->tyFunc(ret, ps, np, false);
            dealloc<IrType*>(ps);
            return res;
        },
        TypeKind::Tuple => {
            u32 np = e->kind.payload.Tuple.elemsLen;
            if (np == 0) return ir->tyInt(8);
            IrType** ps = alloc<IrType*>((usize)np);
            str* pns = alloc<str>((usize)np);
            if (ps == null || pns == null)
            {
                if (ps != null) dealloc<IrType*>(ps);
                if (pns != null) dealloc<str>(pns);
                return ir->tyInt(8);
            }
            u32 i = 0;
            while (i < np) { ps[i] = wvTy(ctx, file, ir, e->kind.payload.Tuple.elems[i], depth + 1); pns[i] = "_"; i++; }
            IrStructType* st = ir->createStructType("coral_tuple", ps, pns, np);
            dealloc<IrType*>(ps);
            dealloc<str>(pns);
            return st->irType;
        },
        TypeKind::Named => {
            NodeId td = wvFindTypeDecl(file, ctx, e->kind.payload.Named.name);
            if (td.index == 0) return ir->tyInt(64); // unresolved named → opaque 64-bit
            Node* dn = ctx->nodes + td.index;
            if (dn->kind.tag != NodeKind::Decl) return ir->tyInt(64);
            Decl* dd = &dn->kind.payload.Decl.value;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => { return wvStructTy(ctx, file, ir, dd, depth); },
                DeclKind::Enum => {
                    if ((dd->kind.payload.Enum.flags & 1) != 0)
                        return wvTy(ctx, file, ir, dd->kind.payload.Enum.backingType, depth + 1);
                    return ir->tyInt(32);
                },
                DeclKind::TypeAlias => { return wvTy(ctx, file, ir, dd->kind.payload.TypeAlias.target, depth + 1); },
                DeclKind::Distinct => { return wvTy(ctx, file, ir, dd->kind.payload.Distinct.baseType, depth + 1); },
                DeclKind::Union => {
                    // union = [size x i8], size = max field size (Phase 3:
                    // real tagged layout for variant; opaque for now)
                    u32 maxSz = 1;
                    u32 k = 0;
                    while (k < dd->kind.payload.Union.fieldsLen)
                    {
                        Node* fn = ctx->nodes + dd->kind.payload.Union.fields[k].index;
                        if (fn->kind.tag == NodeKind::Field)
                        {
                            IrType* ft = wvTy(ctx, file, ir, fn->kind.payload.Field.value.typeNode, depth + 1);
                            u32 sz = ir->irTypeSizeOf(ft);
                            if (sz > maxSz) maxSz = sz;
                        }
                        k++;
                    }
                    return ir->tyArray(ir->tyInt(8), maxSz);
                },
                DeclKind::Variant => {
                    // variant = opaque byte blob (tag + union); exact layout Phase 3
                    return ir->tyArray(ir->tyInt(8), 16);
                },
                else => { return ir->tyInt(64); },
            }
        },
        TypeKind::TypeParam => { return ir->tyInt(64); }, // erased after mono
        TypeKind::ValueInt => { return ir->tyInt(64); },
        else => { return ir->tyInt(32); },
    }
}
