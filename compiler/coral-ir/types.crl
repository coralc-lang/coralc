#[[no_drop_all]]
/* coral-ir/types.crl — Coral Ty/TypeKind → muvm IrType
 *
 * muvTy is the single Ty→IrType mapper. It takes the lowering state Muv
 * (AstContext, merged File, IrContext and the arena) and a recursion
 * depth guard (self-referential structs resolve through a Pointer,
 * which breaks the cycle at depth 1; the guard is a hard stop for
 * pathological cases Phase 3 will memoize properly).
 *
 * Arena rule: muvm's tyGetOrCreate / createStructType store the raw
 * params/fields array pointers inside the interned IrType for the whole
 * IrContext lifetime — every array handed there comes from muvArr (the
 * Muv arena), never from alloc/dealloc, and never from the stack.
 *
 * Layout note (Phase 3): #[[packed]] / #[[reorder]] struct attributes
 * are honoured here via createStructType — packed = 1-byte field
 * alignment, reorder = sort fields by descending alignment. */

use lower { Muv, muvArr, muvTrackStruct, muvTyMapFind, muvTyMapSet, muvTdMapGet, muvTdMapPut, muvSubstTy, muvSubstDeep,
               muvTypeInstanceName, muvErr };
use sem { scope { Symbol } };
use ast::id { Str, NodeId, locFile };
use ast::types { Ty, TypeEntry, TypeKind };
use ast::node { Node, NodeKind };
use ast::decl { File, Decl, DeclKind, Field, Attribute, VariantVariant, ATTR_REORDER, ATTR_PACKED, ATTR_ALIGN, ATTR_SIMD };
use context::context { AstContext, InternEntry };
use common::slice { Slice };
import platform::libc { getenv, printf };
use diag::code { ErrorCode };
use mono::mono { MonoInstance, MonoInstanceKind, MonoSubstitution };
import muvm::irtypes { IrContext, IrType, IrTypeKind, IrStructType };

pub str muvStr(AstContext* ctx, Str s)
{
    if (s == 0) return "";
    InternEntry* e = ctx->interns + s;
    return str { .ptr = (const u8*)e->ptr, .len = e->len };
}

Slice muvSlice(AstContext* ctx, Str s)
{
    if (s == 0) return Slice { .ptr = null, .len = 0 };
    InternEntry* e = ctx->interns + s;
    return Slice { .ptr = e->ptr, .len = e->len };
}

/* find a type-named decl (struct/enum/union/variant/alias/distinct) in
 * the merged file by bare name; 0 when absent. Memoized on the interned
 * name — the merged decl list is O(#decls) per lookup and this sits in
 * the innermost type loop. */
pub NodeId muvFindTypeDeclRef(Muv* w, Str name, u32 refFile)
{
    NodeId none;
    none.index = 0;
    if (w->file == null || name == 0) return none;
    /* qualified `foo::goo` names name nested type declarations: resolve
     * the root segment against top-level decls, then walk each level's
     * nested list by segment name */
    {
        InternEntry* ne = w->ctx->interns + name;
        u8* np = ne->ptr;
        usize nn = ne->len;
        usize sep = nn;
        usize si = 0;
        while (si + 1 < nn)
        {
            if (np[si] == 58 && np[si + 1] == 58) { sep = si; break; }
            si++;
        }
        if (sep != nn && sep > 0)
        {
            Str rootName = w->ctx->intern(str { .ptr = np, .len = sep });
            NodeId root = muvFindTypeDeclRef(w, rootName, refFile);
            if (root.index != 0)
            {
                Node* rn = w->ctx->nodes + root.index;
                if (rn->kind.tag == NodeKind::Decl)
                {
                    Decl* rd = &rn->kind.payload.Decl.value;
                    NodeId* nested = null;
                    u32 nestedLen = 0;
                    if (rd->kind.tag == DeclKind::Struct)
                    { nested = rd->kind.payload.Struct.nested; nestedLen = rd->kind.payload.Struct.nestedLen; }
                    else if (rd->kind.tag == DeclKind::Union)
                    { nested = rd->kind.payload.Union.nested; nestedLen = rd->kind.payload.Union.nestedLen; }
                    usize pos = sep + 2;
                    while (pos < nn && nested != null)
                    {
                        usize e2 = pos;
                        while (e2 < nn)
                        {
                            if (e2 + 1 < nn && np[e2] == 58 && np[e2 + 1] == 58) break;
                            e2++;
                        }
                        Str seg = w->ctx->intern(str { .ptr = np + pos, .len = e2 - pos });
                        NodeId found;
                        found.index = 0;
                        u32 ni = 0;
                        while (ni < nestedLen)
                        {
                            Node* cn = w->ctx->nodes + nested[ni].index;
                            if (cn->kind.tag == NodeKind::Decl)
                            {
                                Decl* cd = &cn->kind.payload.Decl.value;
                                Str cnm = 0;
                                if (cd->kind.tag == DeclKind::Struct) cnm = cd->kind.payload.Struct.name;
                                else if (cd->kind.tag == DeclKind::Union) cnm = cd->kind.payload.Union.name;
                                if (cnm == seg) { found = nested[ni]; break; }
                            }
                            ni++;
                        }
                        if (found.index == 0) return none;
                        if (e2 >= nn) { muvTdMapPut(w, name, found.index + 1); return found; }
                        Node* fn = w->ctx->nodes + found.index;
                        Decl* fd = &fn->kind.payload.Decl.value;
                        if (fd->kind.tag == DeclKind::Struct)
                        { nested = fd->kind.payload.Struct.nested; nestedLen = fd->kind.payload.Struct.nestedLen; }
                        else if (fd->kind.tag == DeclKind::Union)
                        { nested = fd->kind.payload.Union.nested; nestedLen = fd->kind.payload.Union.nestedLen; }
                        else return none;
                        pos = e2 + 2;
                    }
                }
            }
            return none;
        }
    }
    bool hit = false;
    u32 mv = muvTdMapGet(w, name, &hit);
    if (hit && mv >= 2)
    {
        none.index = mv - 1;
        return none;
    }
    /* a cached miss is only a hint: scope resolution depends on the
     * spelling file's imports, so a name missed under one refFile can
     * still resolve under another — always run the real lookup */
    File* file = w->file;
    AstContext* ctx = w->ctx;
    /* TypeEntry locs are often synthetic (locFile==0); the spelling site
     * is the file of the decl being lowered — w->file merges several
     * sources, so its first decl's file is not necessarily ours */
    if (refFile == 0) refFile = w->curFileId;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId id = file->decls[i];
        Node* n = ctx->nodes + id.index;
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &n->kind.payload.Decl.value;
            Str dn = 0;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => { dn = dd->kind.payload.Struct.name; },
                DeclKind::Enum => { dn = dd->kind.payload.Enum.name; },
                DeclKind::Union => { dn = dd->kind.payload.Union.name; },
                DeclKind::Variant => { dn = dd->kind.payload.Variant.name; },
                DeclKind::TypeAlias => { dn = dd->kind.payload.TypeAlias.name; },
                DeclKind::Distinct => { dn = dd->kind.payload.Distinct.name; },
                else => {},
            }
            if (dn == name)
            {
                muvTdMapPut(w, name, id.index + 1);
                return id;
            }
        }
        i++;
    }
    /* cross-module types: the decl lives in another file's decl list,
     * invisible to the scan above — resolve the way sema did, through
     * the scope binding visible from the spelling site's file (an
     * import binds the name in the importing file's scope) */
    if (w->sema != null && w->sema->scopes != null && refFile != 0)
    {
        Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);
        if (getenv(C"MUV_DEBUG") != null)
        {
            printf(C"muvdbg: tdRef refFile=%u sym=%p decl=%u\n",
                   refFile, (void*)sym,
                   sym != null ? sym->declaration.index : 0);
        }
        if (sym != null && sym->declaration.index != 0)
        {
            Node* sn = ctx->nodes + sym->declaration.index;
            if (sn->kind.tag == NodeKind::Decl)
            {
                Decl* sd = &sn->kind.payload.Decl.value;
                switch (sd->kind.tag)
                {
                    DeclKind::Struct | DeclKind::Enum | DeclKind::Union |
                    DeclKind::Variant | DeclKind::TypeAlias | DeclKind::Distinct => {
                        return sym->declaration;
                    },
                    else => {},
                }
            }
        }
    }
    muvTdMapPut(w, name, 1); /* cache the miss too */
    return none;
}

pub NodeId muvFindTypeDecl(Muv* w, Str name)
{
    return muvFindTypeDeclRef(w, name, 0);
}

pub IrType* muvTy(Muv* w, Ty t, u32 depth);

/* build a struct IrType from a struct decl's fields. The compiler owns
 * layout: fields are emitted in declaration order unless the decl asks
 * for [[reorder]] (sort by descending alignment, then size, stably),
 * and [[packed]] packs them with no padding. Every field-index consumer
 * (muvFieldIdx, literals, geps) resolves names through the IrStructType
 * this builds, so the permutation stays consistent everywhere. */
pub IrType* muvStructTy(Muv* w, Decl* dd, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    u32 n = dd->kind.payload.Struct.fieldsLen;
    if (n == 0) return ir->tyInt(8); // empty struct: 1 byte
    IrType** fts = (IrType**)muvArr(w, (usize)n, 8);
    str* fns = (str*)muvArr(w, (usize)n, 16);
    u32* perm = (u32*)muvArr(w, (usize)n, 4);
    if (fts == null || fns == null || perm == null) return ir->tyInt(8);
    u32 k = 0;
    u32 actual = 0;
    while (k < n)
    {
        Node* fn = ctx->nodes + dd->kind.payload.Struct.fields[k].index;
        if (fn->kind.tag == NodeKind::Field)
        {
            Field* f = &fn->kind.payload.Field.value;
            fts[actual] = muvTy(w, f->typeNode, depth + 1);
            fns[actual] = muvStr(ctx, f->name);
            perm[actual] = actual;
            actual++;
        }
        k++;
    }
    /* [[simd]]: sema guarantees every field shares one scalar
     * integer/float type — lower the whole struct to a fixed-length
     * vector type (vNf32 / vNi32) instead of an aggregate */
    if (((dd->attrBits & ATTR_SIMD) != 0) && actual >= 2)
    {
        IrType* et = fts[0];
        bool uniform = (et->kind == IrTypeKind::Int || et->kind == IrTypeKind::Float);
        u32 i = 1;
        while (uniform && i < actual)
        {
            uniform = et->kind == fts[i]->kind && et->width == fts[i]->width;
            i++;
        }
        if (uniform) return ir->tyVector(et, actual);
    }
    u32 abits = dd->attrBits;
    bool reorder = (abits & ATTR_REORDER) != 0 && (abits & ATTR_PACKED) == 0;
    bool packed = (abits & ATTR_PACKED) != 0;
    
    // member alignment: fields with align > 0 get their own alignment
    // packed structs override member alignment
    if (!packed && actual > 1)
    {
        // compute effective alignment for each field
        // for now, we'll rely on the IR's default alignment
        // member alignment can be applied in future enhancement
    }
    
    if (reorder && actual > 1)
    {
        /* stable insertion sort on (align desc, size desc, decl pos asc)
         * — small field counts make the quadratic walk irrelevant */
        u32 i = 1;
        while (i < actual)
        {
            u32 key = perm[i];
            IrType* kt = fts[key];
            u32 ka = ir->irTypeAlignOf(kt);
            u32 ks = ir->irTypeSizeOf(kt);
            i32 j = (i32)i - 1;
            while (j >= 0)
            {
                IrType* bt = fts[perm[j]];
                u32 ba = ir->irTypeAlignOf(bt);
                u32 bs = ir->irTypeSizeOf(bt);
                /* shift b right while it sorts AFTER the key:
                 * descending align, descending size, decl order on ties */
                bool after = ba < ka || (ba == ka && (bs < ks ||
                                (bs == ks && perm[j] > key)));
                if (!after) break;
                perm[j + 1] = perm[j];
                j--;
            }
            perm[j + 1] = key;
            i++;
        }
        IrType** sfts = (IrType**)muvArr(w, (usize)actual, 8);
        str* sfns = (str*)muvArr(w, (usize)actual, 16);
        if (sfts == null || sfns == null) return ir->tyInt(8);
        i = 0;
        while (i < actual) { sfts[i] = fts[perm[i]]; sfns[i] = fns[perm[i]]; i++; }
        fts = sfts;
        fns = sfns;
    }
    /* [[align(N)]]: alignas floor on the whole struct — bumps the
     * struct's alignment and size rounding, never moves fields */
    u32 alignAs = 0;
    if ((abits & ATTR_ALIGN) != 0 && dd->attrs != null)
    {
        u32 ai = 0;
        while (ai < dd->attrsLen)
        {
            Attribute* at = dd->attrs + ai;
            if (at->argsLen > 0)
            {
                InternEntry* ne = ctx->interns + at->name;
                if (ne->len == (usize)5 && ne->ptr[0] == 'a' && ne->ptr[1] == 'l' &&
                    ne->ptr[2] == 'i' && ne->ptr[3] == 'g' && ne->ptr[4] == 'n')
                {
                    InternEntry* ae = ctx->interns + at->args[0];
                    u32 v = 0;
                    u32 d = 0;
                    while ((usize)d < ae->len && ae->ptr[d] >= '0' && ae->ptr[d] <= '9')
                    { v = v * 10 + (u32)(ae->ptr[d] - '0'); d++; }
                    if (v > 1) alignAs = v;
                    break;
                }
            }
            ai++;
        }
    }
    IrStructType* st = ir->createStructTypeAlign(muvStr(ctx, dd->kind.payload.Struct.name),
                                                 fts, fns, actual,
                                                 packed ? 1 : 0,
                                                 alignAs);
    muvTrackStruct(w, st);
    return st->irType;
}

pub IrType* muvTy(Muv* w, Ty t, u32 depth);

/* the uncached Ty→IrType derivation; muvTy wraps this with the memo */
IrType* muvTyBuild(Muv* w, Ty t, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    if (t == 0 || depth > 32) return ir->tyInt(32);
    TypeEntry* e = ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { return ir->tyVoid(); },
        TypeKind::Bool => { return ir->tyInt(1); },
        TypeKind::Char => { return ir->tyInt(8); },
        TypeKind::I8 => { return ir->tyInt(8); },
        TypeKind::U8 => { return ir->tyInt(8); },
        TypeKind::I16 => { return ir->tyInt(16); },
        TypeKind::U16 => { return ir->tyInt(16); },
        TypeKind::I32 => { return ir->tyInt(32); },
        TypeKind::U32 => { return ir->tyInt(32); },
        TypeKind::I64 => { return ir->tyInt(64); },
        TypeKind::U64 => { return ir->tyInt(64); },
        TypeKind::I128 => { return ir->tyInt(128); },
        TypeKind::U128 => { return ir->tyInt(128); },
        TypeKind::F32 => { return ir->tyFloat(); },
        TypeKind::F64 => { return ir->tyDouble(); },
        TypeKind::Isize => { return ir->tyInt(64); },
        TypeKind::Usize => { return ir->tyInt(64); },
        TypeKind::Rawptr => { return ir->tyPtr(ir->tyInt(8)); },
        // str = { ptr: u8*, len: usize } — same layout as the C backend
        TypeKind::Str => {
            IrType** fts = (IrType**)muvArr(w, 2, 8);
            str* fns = (str*)muvArr(w, 2, 16);
            if (fts == null || fns == null) return ir->tyInt(8);
            fts[0] = ir->tyPtr(ir->tyInt(8));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_str", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Pointer => { return ir->tyPtr(muvTy(w, e->kind.payload.Pointer.base, depth + 1)); },
        TypeKind::Reference => { return ir->tyPtr(muvTy(w, e->kind.payload.Reference.base, depth + 1)); },
        TypeKind::Const => { return muvTy(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return muvTy(w, e->kind.payload.Comptime.base, depth + 1); },
        // slice = { ptr: T*, len: usize }
        TypeKind::Slice => {
            IrType** fts = (IrType**)muvArr(w, 2, 8);
            str* fns = (str*)muvArr(w, 2, 16);
            if (fts == null || fns == null) return ir->tyInt(8);
            fts[0] = ir->tyPtr(muvTy(w, e->kind.payload.Slice.base, depth + 1));
            fns[0] = "ptr";
            fts[1] = ir->tyInt(64);
            fns[1] = "len";
            IrStructType* st = ir->createStructType("coral_slice", fts, fns, 2);
            return st->irType;
        },
        TypeKind::Array => {
            IrType* elem = muvTy(w, e->kind.payload.Array.base, depth + 1);
            return ir->tyArray(elem, e->kind.payload.Array.len);
        },
        TypeKind::FnPtr => {
            Ty rt = e->kind.payload.FnPtr.returnType;
            u32 np = e->kind.payload.FnPtr.paramsLen;
            IrType* ret = muvTy(w, rt, depth + 1);
            if (np == 0) return ir->tyFunc(ret, null, 0, false);
            IrType** ps = (IrType**)muvArr(w, (usize)np, 8);
            if (ps == null) return ir->tyFunc(ret, null, 0, false);
            u32 i = 0;
            while (i < np) { ps[i] = muvTy(w, e->kind.payload.FnPtr.params[i], depth + 1); i++; }
            return ir->tyFunc(ret, ps, np, false);
        },
        TypeKind::Tuple => {
            u32 np = e->kind.payload.Tuple.elemsLen;
            if (np == 0) return ir->tyInt(8);
            IrType** ps = (IrType**)muvArr(w, (usize)np, 8);
            str* pns = (str*)muvArr(w, (usize)np, 16);
            if (ps == null || pns == null) return ir->tyInt(8);
            u32 i = 0;
            while (i < np) { ps[i] = muvTy(w, e->kind.payload.Tuple.elems[i], depth + 1); pns[i] = "_"; i++; }
            IrStructType* st = ir->createStructType("coral_tuple", ps, pns, np);
            return st->irType;
        },
        TypeKind::Named => {
            /* a generic instance (`Vec<str>`) resolves through the mono
             * table first: the decl itself is a parametrised template
             * whose fields only make sense under its substitutions */
            if (e->kind.payload.Named.genericArgsLen != 0)
            {
                IrType* ity = muvTypeInstanceTy(w, e->kind.payload.Named.name,
                                               e->kind.payload.Named.genericArgs,
                                               e->kind.payload.Named.genericArgsLen,
                                               depth);
                if (ity != null) return ity;
            }
            NodeId td = muvFindTypeDeclRef(w, e->kind.payload.Named.name, locFile(e->loc));
            if (getenv(C"MUV_DEBUG") != null &&
                ctx->internEqHashLen(e->kind.payload.Named.name, 0x2B183663, 4))
                printf(C"muvdbg: Named 'File' td=%u curFile=%u\n", td.index, w->curFileId);
            if (td.index == 0)
            {
                if (getenv(C"MUV_DEBUG") != null)
                    printf(C"muvdbg: unresolved named type (refFile=%u)\n", w->curFileId);
                return ir->tyInt(64); // unresolved named → opaque 64-bit
            }
            Node* dn = ctx->nodes + td.index;
            if (dn->kind.tag != NodeKind::Decl) return ir->tyInt(64);
            return muvDeclTy(w, &dn->kind.payload.Decl.value, depth);
        },
        TypeKind::TypeParam => { return ir->tyInt(64); }, // erased after mono
        TypeKind::ValueInt => { return ir->tyInt(64); },
        else => {
            /* TypeKind::Error must never reach lowering (sema rejects
             * first); any other kind landing here is a compiler bug —
             * say so instead of silently emitting i32 storage */
            w->errors++;
            w->sema->semaError(ErrorCode::CodegenUnsupported, e->loc,
                "unsupported type kind in IR lowering");
            return ir->tyInt(32);
        }
    }
}

/* [[align(N)]] floor from a decl's attributes; 0 when absent */
pub u32 muvAlignAsAttr(Muv* w, Decl* dd)
{
    AstContext* ctx = w->ctx;
    if ((dd->attrBits & ATTR_ALIGN) == 0 || dd->attrs == null) return 0;
    u32 ai = 0;
    while (ai < dd->attrsLen)
    {
        Attribute* at = dd->attrs + ai;
        if (at->argsLen > 0)
        {
            InternEntry* ne = ctx->interns + at->name;
            if (ne->len == (usize)5 && ne->ptr[0] == 'a' && ne->ptr[1] == 'l' &&
                ne->ptr[2] == 'i' && ne->ptr[3] == 'g' && ne->ptr[4] == 'n')
            {
                InternEntry* ae = ctx->interns + at->args[0];
                u32 v = 0;
                u32 d = 0;
                while ((usize)d < ae->len && ae->ptr[d] >= '0' && ae->ptr[d] <= '9')
                { v = v * 10 + (u32)(ae->ptr[d] - '0'); d++; }
                if (v > 1) return v;
                break;
            }
        }
        ai++;
    }
    return 0;
}

/* union storage is a first-class IrTypeKind::Union: every field
 * overlaps at offset 0, size = max field size rounded to max field
 * alignment, align = max field alignment. Field access still goes
 * through bitcast-to-field-pointer (see muvFieldAddr), but the storage
 * type itself tells passes the bytes are one overlapping blob — no
 * struct field indexing, no scalarization. */
pub IrType* muvUnionBlobTy(Muv* w, Decl* ud, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    u32 n = ud->kind.payload.Union.fieldsLen;
    u32 alignAs = muvAlignAsAttr(w, ud);
    if (n == 0) return alignAs > 1 ? ir->tyUnionAlign(null, 0, alignAs) : ir->tyUnion(null, 0);
    IrType** fts = (IrType**)muvArr(w, (usize)n, 8);
    if (fts == null) return ir->tyInt(8);
    u32 k = 0;
    u32 m = 0;
    while (k < n)
    {
        Node* fn = ctx->nodes + ud->kind.payload.Union.fields[k].index;
        if (fn->kind.tag == NodeKind::Field)
        {
            fts[m] = muvTy(w, fn->kind.payload.Field.value.typeNode, depth + 1);
            m++;
        }
        k++;
    }
    return alignAs > 1 ? ir->tyUnionAlign(fts, m, alignAs) : ir->tyUnion(fts, m);
}

/* the IrType of one union field by name; null when absent */
pub IrType* muvUnionFieldTy(Muv* w, Decl* ud, Str fname, u32 depth)
{
    AstContext* ctx = w->ctx;
    u32 k = 0;
    while (k < ud->kind.payload.Union.fieldsLen)
    {
        Node* fn = ctx->nodes + ud->kind.payload.Union.fields[k].index;
        if (fn->kind.tag == NodeKind::Field &&
            fn->kind.payload.Field.value.name == fname)
            return muvTy(w, fn->kind.payload.Field.value.typeNode, depth + 1);
        k++;
    }
    return null;
}

/* the IrType of the idx-th union field in declaration order; null
 * when out of range — positional union literals (`U { v }`) need it */
pub IrType* muvUnionFieldTyIdx(Muv* w, Decl* ud, u32 idx, u32 depth)
{
    AstContext* ctx = w->ctx;
    u32 k = 0;
    u32 m = 0;
    while (k < ud->kind.payload.Union.fieldsLen)
    {
        Node* fn = ctx->nodes + ud->kind.payload.Union.fields[k].index;
        if (fn->kind.tag == NodeKind::Field)
        {
            if (m == idx)
                return muvTy(w, fn->kind.payload.Field.value.typeNode, depth + 1);
            m++;
        }
        k++;
    }
    return null;
}

/* strip Const/Comptime wrappers (expr.crl's muvUnwrapTy — duplicated
 * here because types cannot import expr) */
Ty muvUnwrapTyLocal(Muv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard++ < 8)
    {
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else break;
    }
    return t;
}

/* Pointer and Reference both lower to ptr in the IR — every receiver/
 * pointee unwrap in codegen must treat them alike. `T&` keeps its own
 * TypeKind only for mangling ('r' vs 'P'); semantically it IS the
 * pointer value, so field/method/index access goes through the same
 * branches as `T*`. */
pub bool muvIsIndirect(TypeEntry* e)
{
    return e != null &&
        (e->kind.tag == TypeKind::Pointer || e->kind.tag == TypeKind::Reference);
}

pub Ty muvIndirectBase(TypeEntry* e)
{
    if (e == null) return (Ty)0;
    if (e->kind.tag == TypeKind::Pointer) return e->kind.payload.Pointer.base;
    if (e->kind.tag == TypeKind::Reference) return e->kind.payload.Reference.base;
    return (Ty)0;
}

/* unwrap Const/Comptime/Pointer/Alias/Distinct wrappers to the decl a
 * type names; returns the Decl* when it is a Union, else null */
pub Decl* muvUnionDeclOf(Muv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard++ < 16)
    {
        t = muvUnwrapTyLocal(w, t);
        if (t == 0) return null;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag != TypeKind::Named) return null;
        NodeId td = muvFindTypeDeclRef(w, e->kind.payload.Named.name, locFile(e->loc));
        if (td.index == 0) return null;
        Node* dn = w->ctx->nodes + td.index;
        if (dn->kind.tag != NodeKind::Decl) return null;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::Union) return dd;
        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = dd->kind.payload.TypeAlias.target; continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = dd->kind.payload.Distinct.baseType; continue; }
        return null;
    }
    return null;
}

pub Decl* muvVariantDeclOf(Muv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard++ < 16)
    {
        t = muvUnwrapTyLocal(w, t);
        if (t == 0) return null;
        TypeEntry* e = w->ctx->types + t;
        Ty ib = muvIndirectBase(e);
        if (ib != 0 || muvIsIndirect(e)) { t = ib; continue; }
        if (e->kind.tag != TypeKind::Named) return null;
        NodeId td = muvFindTypeDeclRef(w, e->kind.payload.Named.name, locFile(e->loc));
        if (td.index == 0) return null;
        Node* dn = w->ctx->nodes + td.index;
        if (dn->kind.tag != NodeKind::Decl) return null;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::Variant) return dd;
        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = dd->kind.payload.TypeAlias.target; continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = dd->kind.payload.Distinct.baseType; continue; }
        return null;
    }
    return null;
}

/* variant payload is a first-class union whose fields are the per-case
 * anonymous struct types — overlapping at offset 0, sized/aligned to
 * the largest case. Access bitcasts the payload pointer to the case
 * struct (union-variant-ir.md). */
pub IrType* muvVariantBlobTy(Muv* w, Decl* vd, u32 depth)
{
    u32 nv = vd->kind.payload.Variant.variantsLen;
    if (nv == 0) return w->ir->tyUnion(null, 0);
    IrType** fts = (IrType**)muvArr(w, (usize)nv, 8);
    if (fts == null) return w->ir->tyInt(8);
    u32 v = 0;
    while (v < nv)
    {
        IrStructType* cst = muvVariantCaseStructTy(w, vd, v, depth + 1);
        fts[v] = cst != null ? cst->irType : w->ir->tyInt(8);
        v++;
    }
    return w->ir->tyUnion(fts, nv);
}

/* ordinal of a case name inside a variant decl; -1 when absent */
pub i32 muvVariantCaseIdx(Muv* w, Decl* vd, Str caseName)
{
    u32 v = 0;
    while (v < vd->kind.payload.Variant.variantsLen)
    {
        if (vd->kind.payload.Variant.variants[v].name == caseName)
            return (i32)v;
        v++;
    }
    return -1;
}

/* the case's anonymous struct type — declaration-order fields with
 * substituted types; tracked so field-name lookups resolve like any
 * other struct. Empty cases get a dummy i8 field (C's `char _e`). */
pub IrStructType* muvVariantCaseStructTy(Muv* w, Decl* vd, u32 cidx, u32 depth)
{
    if (cidx >= vd->kind.payload.Variant.variantsLen) return null;
    VariantVariant* vv = vd->kind.payload.Variant.variants + cidx;
    u32 n = vv->fieldsLen;
    if (n == 0) n = 1;
    IrType** fts = (IrType**)muvArr(w, (usize)n, 8);
    str* fns = (str*)muvArr(w, (usize)n, 16);
    if (fts == null || fns == null) return null;
    AstContext* ctx = w->ctx;
    u32 i = 0;
    while (i < n)
    {
        if (vv->fieldsLen == 0) { fts[i] = w->ir->tyInt(8); fns[i] = "_e"; }
        else
        {
            fts[i] = muvTy(w, vv->fieldTypes[i], depth + 1);
            fns[i] = muvStr(ctx, vv->fieldNames[i]);
        }
        i++;
    }
    IrStructType* st = w->ir->createStructType("muv_vcase", fts, fns, n);
    muvTrackStruct(w, st);
    return st;
}

/* field index of `fname` inside a case struct (declaration order) */
pub i32 muvVariantCaseFieldIdx(Muv* w, Decl* vd, u32 cidx, Str fname)
{
    if (cidx >= vd->kind.payload.Variant.variantsLen) return -1;
    VariantVariant* vv = vd->kind.payload.Variant.variants + cidx;
    u32 i = 0;
    while (i < vv->fieldsLen)
    {
        if (vv->fieldNames[i] == fname) return (i32)i;
        i++;
    }
    return -1;
}

/* activate the mono substitutions of a generic-instance Ty
 * (`Option<f64>` → [T→f64]) so nested muvTy/muvSubstTy calls see
 * concrete types. Caller saves w->subs/w->subsLen first and restores
 * them after; returns false when `vt` is not a generic instance. */
pub bool muvPushTySubs(Muv* w, Ty vt, MonoSubstitution** os, u32* osl)
{
    *os = w->subs;
    *osl = w->subsLen;
    Ty t = vt;
    u32 guard = 0;
    while (t != 0 && guard++ < 16)
    {
        t = muvSubstTy(w, t);
        while (t != 0)
        {
            TypeEntry* ce = w->ctx->types + t;
            if (ce->kind.tag == TypeKind::Const) t = ce->kind.payload.Const.base;
            else if (ce->kind.tag == TypeKind::Comptime) t = ce->kind.payload.Comptime.base;
            else break;
        }
        if (t == 0) return false;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag != TypeKind::Named) break;
        /* alias/distinct Nameds forward to their target type; a Named
         * with generic args (or a plain generic type name) is the
         * instance candidate */
        if (e->kind.payload.Named.genericArgsLen == 0)
        {
            NodeId td = muvFindTypeDeclRef(w, e->kind.payload.Named.name, locFile(e->loc));
            if (td.index == 0) break;
            Node* dn = w->ctx->nodes + td.index;
            if (dn->kind.tag != NodeKind::Decl) break;
            Decl* dd = &dn->kind.payload.Decl.value;
            if (dd->kind.tag == DeclKind::TypeAlias)
                { t = dd->kind.payload.TypeAlias.target; continue; }
            if (dd->kind.tag == DeclKind::Distinct)
                { t = dd->kind.payload.Distinct.baseType; continue; }
        }
        break;
    }
    if (t == 0) return false;
    TypeEntry* te = w->ctx->types + t;
    if (te == null || te->kind.tag != TypeKind::Named ||
        te->kind.payload.Named.genericArgsLen == 0 || w->mono == null)
        return false;
    Str name = te->kind.payload.Named.name;
    Ty* args = te->kind.payload.Named.genericArgs;
    u32 al = te->kind.payload.Named.genericArgsLen;
    Str want = muvTypeInstanceName(w, name, args, al);
    u32 j = 0;
    while (j < w->mono->instancesLen)
    {
        MonoInstance* inst = w->mono->instances + j;
        if (inst->kind == MonoInstanceKind::TypeInstance &&
            inst->name == name && inst->argumentsLen == al &&
            muvTypeInstanceName(w, inst->name, inst->arguments,
                                inst->argumentsLen) == want)
        {
            w->subs = inst->substitutions;
            w->subsLen = inst->substitutionsLen;
            return true;
        }
        j++;
    }
    return false;
}

/* muvVariantCaseStructTy under the variant TYPE's substitution
 * context. The payload union inside a generic instance
 * (`Option<f64>`) was built with the instance's substitutions active,
 * so its case structs have concrete field types; rebuilding the case
 * struct without them yields `T`→i64 fields that mis-store payloads.
 * Interning makes the rebuilt type identical to the union member. */
pub IrStructType* muvVariantCaseStructTyFor(Muv* w, Ty vt, u32 cidx, u32 depth)
{
    Decl* vd = muvVariantDeclOf(w, vt);
    if (vd == null) return null;
    MonoSubstitution* os;
    u32 osl;
    bool pushed = muvPushTySubs(w, vt, &os, &osl);
    IrStructType* r = muvVariantCaseStructTy(w, vd, cidx, depth);
    if (pushed) { w->subs = os; w->subsLen = osl; }
    return r;
}

/* the IrType a declaring decl denotes — the Named arm's body without
 * the name lookup, so a caller that already holds the decl (method
 * collection composes the self parameter's pointee) can reuse it. */
pub IrType* muvDeclTy(Muv* w, Decl* dd, u32 depth)
{
    AstContext* ctx = w->ctx;
    IrContext* ir = w->ir;
    switch (dd->kind.tag)
    {
        DeclKind::Struct => { return muvStructTy(w, dd, depth); },
        DeclKind::Enum => {
            if ((dd->kind.payload.Enum.flags & 1) != 0)
                return muvTy(w, dd->kind.payload.Enum.backingType, depth + 1);
            return ir->tyInt(32);
        },
        DeclKind::TypeAlias => { return muvTy(w, dd->kind.payload.TypeAlias.target, depth + 1); },
        DeclKind::Distinct => { return muvTy(w, dd->kind.payload.Distinct.baseType, depth + 1); },
        DeclKind::Union => {
            /* union storage is an aligned byte blob; field access goes
             * through bitcast-to-field-pointer (see muvFieldAddr) so no
             * IR type change is needed */
            return muvUnionBlobTy(w, dd, depth);
        },
        DeclKind::Variant => {
            /* { i32 tag; <blob> payload } — mirrors the C backend's
             * struct { int32_t tag; union { … } u; } with "payload"
             * naming the blob so x.tag / x.payload resolve as ordinary
             * struct fields */
            IrType* blob = muvVariantBlobTy(w, dd, depth + 1);
            IrType** fts = (IrType**)muvArr(w, 2, 8);
            str* fns = (str*)muvArr(w, 2, 16);
            if (fts == null || fns == null) return ir->tyInt(8);
            fts[0] = ir->tyInt(32);
            fns[0] = "tag";
            fts[1] = blob;
            fns[1] = "payload";
            IrStructType* st = ir->createStructTypeAlign(
                muvStr(ctx, dd->kind.payload.Variant.name),
                fts, fns, 2, 0, 0);
            muvTrackStruct(w, st);
            return st->irType;
        },
        else => {
            /* only runtime-bearing decls (struct/enum/union/variant/
             * alias/distinct) have an IrType; anything else in type
             * position is a compiler bug — report, don't fake i64 */
            w->errors++;
            w->sema->semaError(ErrorCode::CodegenUnsupported, dd->loc,
                "declaration has no IR type representation");
            return ir->tyInt(64);
        }
    }
}

/* does a type mention a generic parameter anywhere? (mirrors
 * cgTyHasParam — a method on a not-yet-monomorphised owner is
 * skipped by the collection pass) */
pub bool muvTyHasParam(Muv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 8) return false;
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::TypeParam => { return true; },
        TypeKind::Pointer => { return muvTyHasParam(w, e->kind.payload.Pointer.base, depth + 1); },
        TypeKind::Reference => { return muvTyHasParam(w, e->kind.payload.Reference.base, depth + 1); },
        TypeKind::Const => { return muvTyHasParam(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return muvTyHasParam(w, e->kind.payload.Comptime.base, depth + 1); },
        TypeKind::Slice => { return muvTyHasParam(w, e->kind.payload.Slice.base, depth + 1); },
        TypeKind::Array => { return muvTyHasParam(w, e->kind.payload.Array.base, depth + 1); },
        TypeKind::FnPtr => {
            if (muvTyHasParam(w, e->kind.payload.FnPtr.returnType, depth + 1)) return true;
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                if (muvTyHasParam(w, e->kind.payload.FnPtr.params[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Tuple => {
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                if (muvTyHasParam(w, e->kind.payload.Tuple.elems[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Named => {
            u32 i = 0;
            while (i < e->kind.payload.Named.genericArgsLen)
            {
                if (muvTyHasParam(w, e->kind.payload.Named.genericArgs[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        else => { return false; },
    }
}

/* like muvTyHasParam but also counts a bare `Named "T"` matching an
 * active substitution — field/member typeNodes keep the written
 * spelling (no parser rebind), so param detection must see through it */
pub bool muvTyHasParamDeep(Muv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 8) return false;
    /* no muvSubstTy here: detection must see the param itself, not its
     * substitution — callers run this on the already-shallow-substituted
     * type, where surviving params are exactly what we are looking for */
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::TypeParam => { return true; },
        TypeKind::Named => {
            if (e->kind.payload.Named.genericArgsLen == 0)
            {
                u32 i = 0;
                while (i < w->subsLen)
                {
                    if (w->subs[i].parameter == e->kind.payload.Named.name) return true;
                    i++;
                }
                return false;
            }
            u32 i = 0;
            while (i < e->kind.payload.Named.genericArgsLen)
            {
                if (muvTyHasParamDeep(w, e->kind.payload.Named.genericArgs[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Pointer => { return muvTyHasParamDeep(w, e->kind.payload.Pointer.base, depth + 1); },
        TypeKind::Reference => { return muvTyHasParamDeep(w, e->kind.payload.Reference.base, depth + 1); },
        TypeKind::Const => { return muvTyHasParamDeep(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { return muvTyHasParamDeep(w, e->kind.payload.Comptime.base, depth + 1); },
        TypeKind::Slice => { return muvTyHasParamDeep(w, e->kind.payload.Slice.base, depth + 1); },
        TypeKind::Array => { return muvTyHasParamDeep(w, e->kind.payload.Array.base, depth + 1); },
        TypeKind::FnPtr => {
            if (muvTyHasParamDeep(w, e->kind.payload.FnPtr.returnType, depth + 1)) return true;
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                if (muvTyHasParamDeep(w, e->kind.payload.FnPtr.params[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        TypeKind::Tuple => {
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                if (muvTyHasParamDeep(w, e->kind.payload.Tuple.elems[i], depth + 1)) return true;
                i++;
            }
            return false;
        },
        else => { return false; },
    }
}

/* the IrType for a concrete type instance (`Vec<str>`), built lazily
 * with that instance's substitutions active so field types resolve to
 * the concrete argument; memoised in w.instTys. Null when no mono
 * TypeInstance matches (or depth overflows a value cycle guard). */
pub IrType* muvTypeInstanceTy(Muv* w, Str name, Ty* args, u32 argsLen, u32 depth)
{
    if (w->mono == null || w->instTys == null || depth > 32) return null;
    Str want = muvTypeInstanceName(w, name, args, argsLen);
    u32 j = 0;
    while (j < w->mono->instancesLen)
    {
        MonoInstance* inst = w->mono->instances + j;
        if (inst->kind == MonoInstanceKind::TypeInstance && inst->name == name &&
            inst->argumentsLen == argsLen)
        {
            if (muvTypeInstanceName(w, inst->name, inst->arguments,
                                   inst->argumentsLen) != want)
                { j++; continue; }
            if (j >= w->instTysLen) return null;
            if (w->instTys[j] != null) return w->instTys[j];
            Node* tn = w->ctx->nodes + inst->declaration.index;
            if (tn->kind.tag != NodeKind::Decl) return null;
            MonoSubstitution* os = w->subs;
            u32 osl = w->subsLen;
            w->subs = inst->substitutions;
            w->subsLen = inst->substitutionsLen;
            IrType* ity = muvDeclTy(w, &tn->kind.payload.Decl.value, depth + 1);
            w->subs = os;
            w->subsLen = osl;
            w->instTys[j] = ity;
            return ity;
        }
        j++;
    }
    return null;
}

/* memoized Ty→IrType. A Ty still being derived is a cycle: break it at
 * the edge with a pointer-width placeholder (only reachable behind an
 * indirection — a by-value cycle has no finite layout and is rejected
 * upstream), so every Ty is built once and cached. Without this the
 * nested rebuild is exponential on std's type graph. */
pub IrType* muvTy(Muv* w, Ty t, u32 depth)
{
    IrContext* ir = w->ir;
    if (t == 0) return ir->tyInt(32);
    /* inside a monomorphised instance one Ty may denote a different
     * concrete type per instance: substitute the top level here (each
     * nested level substitutes on its own way down), and keep any type
     * that still nests a param OUT of the shared memo — the memo key is
     * the raw Ty, whose meaning depends on the active substitutions */
    t = muvSubstTy(w, t);
    if (w->subsLen > 0 && muvTyHasParamDeep(w, t, 0))
    {
        /* params survive the shallow pass inside compound types
         * (`Vec<T>` fields): rebuild the Ty with them substituted —
         * the result is param-free so it could memo, but the fresh Ty
         * id would miss anyway; build directly like before */
        t = muvSubstDeep(w, t, 0);
        if (depth > 32) return ir->tyInt(32);
        IrType* pr = muvTyBuild(w, t, depth);
        return pr != null ? pr : ir->tyInt(32);
    }
    u8 busy = 0;
    IrType* hit = null;
    if (muvTyMapFind(w, t, &busy, &hit))
    {
        if (busy != 0) return ir->tyPtr(ir->tyInt(8));
        if (hit != null) return hit;
    }
    if (depth > 32) return ir->tyInt(32);
    muvTyMapSet(w, t, 1, null);
    IrType* r = muvTyBuild(w, t, depth);
    if (r == null) r = ir->tyInt(32);
    muvTyMapSet(w, t, 0, r);
    return r;
}
