#[[no_drop_all]]
/* coral-ir/muvm.crl — muvm backend entry point
 *
 * generateMuvm: analyzed AST → muvm IR → pipeline → asm. Mirrors
 * generateC's shape but builds IR directly (no text streams). Phase 1:
 * one collection pass that mangles each symbol exactly once, detects
 * raw-name collisions at compile time, declares IrFunc shells (externs
 * + definitions), then lowers definition bodies. */
use lower { Muv, MuvmResult, MuvmTu, MuvNameEnt, MuvNames, muvNode, muvErr, muvStr, muvResolved,
               muvPushLocal, muvBlock, muvSetBlock, muvTerm, muvPos, muvFnMapInit, muvFnMapPut,
               muvTyMapInit, muvTdMapInit, muvDeclTyMapInit, muvGMapInit, muvHashStr, muvNamesInit, muvNamesFind,
               muvNamesInsert, muvTypeInstanceName, muvAddFunc, muvAddGlobal };
use types { muvTy, muvDeclTy, muvTyHasParam, muvTypeInstanceTy, muvFindTypeDecl, muvSettleTypes };
use decl { muvMangle, muvMangleExempt, muvDeclareMethod, muvMethodSelfKind,
               muvOwnerStr, muvMethodMangle, muvMethodMangleEx, muvDeclareInstanceFunc,
               muvInstanceSymbol };
use stmt { muvStmt, muvDropsBranch, muvDefersBranch, muvDropPush };
use expr { muvExpr, muvAggSlot, muvIsAgg, muvMakeGlobal, muvUnwrapTy, muvSelfTyMatches, muvV };
use context::context { AstContext, InternEntry };
use build::arena { Arena };
use mono::mono { MonoContext, MonoInstance, MonoInstanceKind, MonoSubstitution };
use diag::code { ErrorCode };
use diag::engine { DiagnosticEngine };
use sem::sema { Sema };
use ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param, ATTR_FREESTANDING }
};
use common::slice { Slice };
import muvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrValue, IrValueKind, IrType, IrTypeKind, IrGlobal, irCtxCreate, irCtxDestroy };
import muvm::irOps { IrICmpPred };
import muvm::irBuilder { IrBuilder };
import muvm::irPrinter { IrPrinter };
import muvm::passes::diagnostics::verify { muvmPassVerify };
import muvm::passes::diagnostics::safety { muvmPassSafety };
import muvm::muvm { muvmCompileAsm, muvmOptions, MuvmOptions, OptLevel, CallingConvention, muvmCCId };
import std::mman { alloc, dealloc, zero };
import platform::libc { printf, getenv };
import std::string { String };

/* ── opt-level mapping (mirror of runGcc's C flags) ─────────── */

u32 muvOptLevel(str opt)
{
    if (opt.len == 7 && opt.ptr[0] == 114) return 2; // "release" (-O2)
    if (opt.len == 4 && opt.ptr[0] == 115) return 1; // "size"
    if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 49) return 1; // "O1"
    if (opt.len == 2 && opt.ptr[0] == 79) return 3;  // "O3"
    return 0; // debug
}

OptLevel muvOptEnum(u32 lvl)
{
    if (lvl >= 3) return OptLevel::O3;
    if (lvl == 2) return OptLevel::O2;
    if (lvl == 1) return OptLevel::O1;
    return OptLevel::O0;
}

/* the mangled core::error::_trap symbol the safety pass calls (same
 * hard-coded name the safety pass used: mangle.md lib `core`,
 * ident `_trap`, 6 params, void) */
str muvTrapName() { return "_CNl4core5error5_trapEFmmmKPNl4core5cchar5ccharEmKPNl4core5cchar5ccharE_v"; }

/* a type-named decl that owns methods (mirrors the C backend's
 * cgEmitMethodSet set: struct/union/variant bodies plus the two
 * extension forms) */
bool muvIsOwnerDecl(Decl* d)
{
    return d->kind.tag == DeclKind::Struct || d->kind.tag == DeclKind::Union ||
           d->kind.tag == DeclKind::Variant || d->kind.tag == DeclKind::Extend ||
           d->kind.tag == DeclKind::ExtendTrait;
}

/* is this file-scope constant a type alias (`const c2 = cchar`)? The
 * value is a bare identifier naming a type decl: no storage, and uses
 * resolve through the type system (the C backend spells a typedef;
 * here every use site's Named type carries the name directly). */
bool muvConstIsTypeAlias(Muv* w, NodeId declId)
{
    Node* n = muvNode(w, declId);
    if (n->kind.tag != NodeKind::Decl) return false;
    Decl* dd = &n->kind.payload.Decl.value;
    if (dd->kind.tag != DeclKind::Constant) return false;
    NodeId v = dd->kind.payload.Constant.value;
    if (v.index == 0) return false;
    Node* vn = muvNode(w, v);
    if (vn->kind.tag != NodeKind::Expr ||
        vn->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;
    return muvFindTypeDecl(w, vn->kind.payload.Expr.value.kind.payload.Ident.name).index != 0;
}

/* the methods[] array and owner shape of such a decl; false when the
 * owner is generic (Phase 2 — mono does not reach methods yet) */
bool muvOwnerMethods(Muv* w, Decl* d, Str* owner, NodeId** methodsOut, u32* mlenOut,
                    IrType** selfPtOut)
{
    *owner = 0;
    *methodsOut = null;
    *mlenOut = 0;
    *selfPtOut = null;
    if (d->kind.tag == DeclKind::Struct || d->kind.tag == DeclKind::Union ||
        d->kind.tag == DeclKind::Variant)
    {
        NodeId* methods = null;
        u32 mlen = 0;
        if (d->kind.tag == DeclKind::Struct)
        {
            if (d->kind.payload.Struct.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Struct.name;
            methods = d->kind.payload.Struct.methods;
            mlen = d->kind.payload.Struct.methodsLen;
        }
        else if (d->kind.tag == DeclKind::Union)
        {
            if (d->kind.payload.Union.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Union.name;
            methods = d->kind.payload.Union.methods;
            mlen = d->kind.payload.Union.methodsLen;
        }
        else
        {
            if (d->kind.payload.Variant.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Variant.name;
            methods = d->kind.payload.Variant.methods;
            mlen = d->kind.payload.Variant.methodsLen;
        }
        *selfPtOut = w->ir->tyPtr(muvDeclTy(w, d, 0));
        *methodsOut = methods;
        *mlenOut = mlen;
        return mlen > 0;
    }
    Ty st = 0;
    if (d->kind.tag == DeclKind::Extend)
    {
        if (d->kind.payload.Extend.genericParamsLen != 0) return false;
        st = d->kind.payload.Extend.selfType;
        *methodsOut = d->kind.payload.Extend.methods;
        *mlenOut = d->kind.payload.Extend.methodsLen;
    }
    else if (d->kind.tag == DeclKind::ExtendTrait)
    {
        if (d->kind.payload.ExtendTrait.genericParamsLen != 0) return false;
        st = d->kind.payload.ExtendTrait.selfType;
        *methodsOut = d->kind.payload.ExtendTrait.methods;
        *mlenOut = d->kind.payload.ExtendTrait.methodsLen;
    }
    else return false;
    if (st == 0 || muvTyHasParam(w, st, 0)) return false;
    *owner = muvOwnerStr(w, st);
    Ty u = muvUnwrapTy(w, st);
    TypeEntry* ue = w->ctx->types + u;
    if (ue->kind.tag == TypeKind::Pointer)
    {
        u = muvUnwrapTy(w, ue->kind.payload.Pointer.base);
        if (u == 0) return false;
    }
    *selfPtOut = w->ir->tyPtr(muvTy(w, u, 0));
    return *mlenOut > 0;
}

/* lower one function body. hasSelf says the shell was declared with a
 * receiver as parameter 0 (only the method-collection path does that —
 * plain file functions never take one). body is the node to lower: the
 * decl's own, or a monomorphisation instance's rewritten body when inst
 * is non-null (its substitutions are the caller's responsibility). */
void muvLowerBody(Muv* w, NodeId declId, Decl* d, IrFunc* f, u8 hasSelf, NodeId body, MonoInstance* inst)
{
    /* non-instance bodies carry no substitution: a stale subs table
     * leaking in from instance signature building would be read as an
     * active generic context (and may be a null pointer with a nonzero
     * length) */
    if (inst == null) { w->subs = null; w->subsLen = 0; }
    /* types consumed by this body must be fully settled: recursive-type
     * builds degrade pointer elems to ptr(i8) and record patch sites;
     * rebuild/upgrade them now that their blockers have published */
    muvSettleTypes(w);
    {
        Node* dn = muvNode(w, declId);
        w->curFileId = locFile(dn->loc);
    }
    w->fn = f;
    w->retTy = d->kind.payload.Func.returnType;
    w->locLen = 0;
    w->term = false;
    w->breakT = null;
    w->contT = null;
    w->loopDepth = 0;
    w->dropLen = 0;
    w->fnDropMark = 0;
    w->contDropMark = 0;
    w->breakDropMark = 0;
    w->deferLen = 0;
    w->fnDeferMark = 0;
    w->contDeferMark = 0;
    w->breakDeferMark = 0;

    IrBlock* entry = muvBlock(w, "");
    muvSetBlock(w, entry);

    /* a method's receiver: parameter 0 of the shell, never spelled in
     * the Coral param list (the parser rejects explicit `self`) */
    u32 pi = 0;
    if (hasSelf != 0 && f->nparams > 0)
    {
        pi = 1;
        IrType* st = f->paramTypes[0];
        IrValue* av = alloc<IrValue>((usize)1);
        if (av == null) { muvErr(w, declId, "out of memory binding self"); return; }
        *av = IrValue { IrValueKind::Arg, st, w->ir->nextValueId(), 0,
                        muvStr(w, w->ctx->tyIdxSelfLit2()), null, 0, 0 };
        f->addArg(av);
        if (st != null && st->kind != IrTypeKind::Void)
        {
            IrValue* slot = muvIsAgg(st) ? muvAggSlot(w, st) : muvV(w->b.alloca(st));
            if (slot != null)
            {
                w->b.store(av, slot);
                muvPushLocal(w, w->ctx->tyIdxSelfLit2(), slot, 0);
            }
        }
    }

    /* bind params: create arg values, alloca slots, store args in.
     * The type comes from the shell's own signature (f->paramTypes), so
     * binding can never drift from what the call site was given. */
    u32 np = d->kind.payload.Func.paramsLen;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = muvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) == 0) // not variadic
            {
                IrType* at = pi < f->nparams ? f->paramTypes[pi] : muvTy(w, pp->typeNode, 0);
                pi++;
                IrValue* av = alloc<IrValue>((usize)1);
                if (av == null) { muvErr(w, declId, "out of memory binding param"); return; }
                *av = IrValue { IrValueKind::Arg, at, w->ir->nextValueId(), 0,
                                muvStr(w, pp->name), null, 0, 0 };
                f->addArg(av);
                if (at != null && at->kind != IrTypeKind::Void)
                {
                    IrValue* slot = muvIsAgg(at) ? muvAggSlot(w, at) : muvV(w->b.alloca(at));
                    if (slot != null)
                    {
                        w->b.store(av, slot);
                        Ty pty = muvResolved(w, pp->typeNode);
                        muvPushLocal(w, pp->name, slot, pty);
                        /* RAII: by-value droppable params unwind on every
                         * exit path, same as VarDecl locals */
                        if (pp->dropMethod.index != 0 || (pp->flags & 32) != 0)
                            muvDropPush(w, pp->name, slot, pty, pp->dropMethod);
                    }
                }
            }
        }
        i++;
    }

    /* an instance whose vararg slot was specialized: the rewritten body
     * references the tail args by their synthesized names (_varg0, …) */
    if (inst != null && inst->tailLen > 0 && inst->tailArgNames != null)
    {
        u32 k = 0;
        while (k < inst->tailLen && pi < f->nparams)
        {
            IrType* at = f->paramTypes[pi];
            pi++;
            IrValue* av = alloc<IrValue>((usize)1);
            if (av == null) { muvErr(w, declId, "out of memory binding tail arg"); return; }
            Str tn = inst->tailArgNames[k];
            *av = IrValue { IrValueKind::Arg, at, w->ir->nextValueId(), 0,
                            muvStr(w, tn), null, 0, 0 };
            f->addArg(av);
            if (at != null && at->kind != IrTypeKind::Void)
            {
                IrValue* slot = muvIsAgg(at) ? muvAggSlot(w, at) : muvV(w->b.alloca(at));
                if (slot != null)
                {
                    w->b.store(av, slot);
                    muvPushLocal(w, tn, slot, 0);
                }
            }
            k++;
        }
    }

    /* lower the body block */
    muvStmt(w, body);

    /* implicit terminator on fallthrough */
    if (!w->term)
    {
        muvDefersBranch(w, w->fnDeferMark);
        muvDropsBranch(w, w->fnDropMark, -1);
        IrType* rt = muvTy(w, muvResolved(w, w->retTy), 0);
        if (rt == null || rt->kind == IrTypeKind::Void) w->b.retVoid();
        else w->b.ret(w->ir->constInt(rt, 0));
        muvTerm(w);
    }
}

/* claim a symbol for a function shell under an already-composed name:
 * dedup against the name table (extern/definition of one symbol bind
 * together, two definitions are an error), register the IrFunc for
 * call sites, add it to the module-> selfTy, when non-null, is the
 * method receiver prepended as parameter 0. `names` may be null for a
 * bare on-demand declaration (the fn map still dedups per declId). */
IrFunc* muvRegisterFunc(Muv* w, MuvNames* names, NodeId declId, Decl* d, str name, IrType* selfTy)
{
    bool isExtern = (d->kind.payload.Func.flags & 2) != 0;
    bool isDefn = (d->kind.payload.Func.flags & 8) != 0 && !isExtern;

    MuvNameEnt* ent = null;
    if (names != null && name.len != 0) ent = muvNamesFind(names, name);
    if (ent != null)
    {
        /* two definitions of the same final name = error */
        if (ent->isDefn && isDefn)
        {
            w->errors++;
            w->sema->semaErrorNode(ErrorCode::CodegenInternal, declId,
                "duplicate definition of unmangled symbol (no_mangle/extern collision)");
            return null;
        }
        /* existing definition + new extern: calls to the extern bind to
         * the definition's symbol */
        if (ent->isDefn && !isDefn)
        {
            muvFnMapPut(w, declId.index, ent->f);
            return null;
        }
        /* existing extern + new definition: promote the shell to a
         * definition (the provide-an-implementation pattern) */
        if (!ent->isDefn && isDefn)
        {
            ent->isDefn = true;
            ent->f->isExtern = false;
            muvFnMapPut(w, declId.index, ent->f);
            return ent->f;
        }
        /* two externs of the same name: dedup, bind to the first */
        muvFnMapPut(w, declId.index, ent->f);
        return null;
    }

    /* new name: declare the shell, claim the slot, register for calls */
    IrFunc* f = muvDeclareMethod(w, declId, d, name, selfTy);
    if (f == null) return null;
    muvAddFunc(w, f);
    if (names != null && name.len != 0)
    {
        /* key from the IrFunc's own copy: muvTy inside the declare may
         * have rewritten `name`'s view into w->mb (instance-typed
         * signatures go through muvTypeInstanceName) */
        ent = muvNamesInsert(names, f->base.name);
        if (ent != null)
        {
            ent->name = f->base.name;
            ent->declIdx = declId.index;
            ent->isDefn = isDefn;
            ent->f = f;
        }
    }
    muvFnMapPut(w, declId.index, f);
    return isDefn ? f : null;
}

/* declare + collect one function decl; returns the IrFunc for the
 * definition (or null for extern-only / generic / collision-skipped) */
IrFunc* muvCollectFunc(Muv* w, MuvNames* names, NodeId declId, Decl* d)
{
    /* skip generics (Phase 2) */
    if (w->mono != null && w->mono->genericCount(declId) != 0) return null;

    str name = muvMangle(w, declId, d->kind.payload.Func.name);
    return muvRegisterFunc(w, names, declId, d, name, null);
}

/* one entry of the monomorphised body queue: the shell, the decl whose
 * params it binds, the body node, the mono instance supplying the
 * substitutions while lowering, and whether the shell carries a receiver
 * as parameter 0. FunctionInstance entries pass the instance's rewritten
 * body; instance-method entries pass the method's own body. */
struct MuvBodyEnt
{
    IrFunc* f;
    NodeId decl;
    NodeId body;
    u32 inst;
    u32 tu;         // partition TU (instance hash shard)
    u8 self;
}

/* declare + queue one instance method under the instance-composed
 * `<owner>_<method>` symbol (mirror cgEmitInstMethodList). Never
 * muvRegisterFunc: mdef is shared by every instance of the type, so the
 * names table — keyed by the composed symbol, deduping alias-equal
 * instances — is the only binding, and the fn map must not answer for
 * it. Signature building runs with the instance's substitutions active. */
void muvQueueInstMethod(Muv* w, NodeId mdef, Decl* md, Str iown, IrType* selfPt,
                       MonoInstance* inst, u32 ii, MuvBodyEnt* ents, u32* qlen, u32 qcap)
{
    str msym = muvMethodMangleEx(w, mdef, iown, 0, inst->arguments,
                                inst->argumentsLen, md->kind.payload.Func.name);
    if (getenv(C"MUV_DEBUG") != null &&
        w->ctx->internEqHashLen(md->kind.payload.Func.name, 0x71969BBC, 5))
    {
        printf(C"muvdbg: queue isErr msym=%.*s\n", (i32)msym.len, msym.ptr);
        u32 ai = 0;
        while (ai < inst->argumentsLen)
        {
            Ty at = inst->arguments[ai];
            TypeEntry* ate = w->ctx->types + at;
            printf(C"muvdbg:   arg%u kind=%u locFile=%u\n", ai,
                   (u32)ate->kind.tag, locFile(ate->loc));
            ai++;
        }
    }
    if (msym.len == 0)
    {
        muvErr(w, mdef, "cannot compose the instance method symbol");
        return;
    }
    if (w->names != null && muvNamesFind(w->names, msym) != null) return;
    u8 sk = muvMethodSelfKind(w, mdef);
    u8 flags = md->kind.payload.Func.flags;
    MonoSubstitution* oldS = w->subs;
    u32 oldSL = w->subsLen;
    w->subs = inst->substitutions;
    w->subsLen = inst->substitutionsLen;
    IrFunc* f = muvDeclareMethod(w, mdef, md, msym, sk == 1 ? selfPt : null);
    if (getenv(C"MUV_DEBUG") != null && f == null)
        printf(C"muvdbg: instMethod decl failed mdef=%u\n", mdef.index);
    w->subs = oldS;
    muvAddFunc(w, f);
    if (w->names != null)
    {
        /* key from the IrFunc's own copy: `msym` is a view into w->mb,
         * which the signature's instance types just rewrote */
        MuvNameEnt* ent = muvNamesInsert(w->names, f->base.name);
        if (ent != null)
        {
            ent->name = f->base.name;
            ent->declIdx = mdef.index;
            ent->isDefn = (flags & 8) != 0 && (flags & 2) == 0;
            ent->f = f;
        }
    }
    if ((flags & 8) != 0 && (flags & 2) == 0 && ents != null && qlen != null && *qlen < qcap)
    {
        ents[*qlen] = MuvBodyEnt { .f = f, .decl = mdef,
                                  .body = md->kind.payload.Func.body,
                                  .inst = ii, .tu = w->curTu,
                                  .self = sk == 1 ? 1 : 0 };
        *qlen = *qlen + 1;
    }
}

/* one owner's method list through the instance queue: non-generic
 * methods only (own generics stay Phase 2), like cgEmitInstMethodList */
void muvQueueInstMethods(Muv* w, NodeId* methods, u32 mlen, Str iown, IrType* selfPt,
                        MonoInstance* inst, u32 ii, MuvBodyEnt* ents, u32* qlen, u32 qcap)
{
    if (methods == null) return;
    u32 k = 0;
    while (k < mlen)
    {
        NodeId mdef = methods[k];
        Node* mn = muvNode(w, mdef);
        if (mn->kind.tag == NodeKind::Decl)
        {
            Decl* md = &mn->kind.payload.Decl.value;
            /* type-instance methods lower under the instance's
             * substitutions, which cover the type's own params — a
             * method inside `extend<T,E>` sees T,E bound even though
             * genericCount counts them. Only a method's OWN explicit
             * generics (`fn foo<U>`) need a separate mono instance */
            if (md->kind.tag == DeclKind::Func &&
                (w->mono == null || w->mono->explicitGenericCount(mdef) == 0))
                muvQueueInstMethod(w, mdef, md, iown, selfPt, inst, ii, ents, qlen, qcap);
        }
        k++;
    }
}
/* ── multi-TU partition (Rust-CGU model) ───────────────────────
 * decls group by home file (locFile); a file owning more than 400
 * code decls sub-shards by decl hash (
 mono instances hash-shard across ALL TUs so generic
 * code spreads evenly instead of piling into std's modules. */

/* decl-hash bucket inside file lf's shard range — FNV-1a over node
 * index + file id, */
u32 muvDeclShard(Muv* w, NodeId id, u32 lf)
{
    u32 sc = 1;
    if (w->fileShards != null && lf <= w->maxFid) sc = w->fileShards[lf];
    if (sc <= 1) return 0;
    u64 h = 1469598103934665603u;
    u32 v = id.index;
    u32 s = 0;
    while (s < 4)
    {
        h = (h ^ (u64)(v & 255u)) * 1099511628211u;
        v >>= 8;
        s++;
    }
    h = (h ^ (u64)lf) * 1099511628211u;
    return (u32)(h % (u64)sc);
}

/* TU owning decl `id`; 0 when partitioning is off or the decl has
 * no code-owning file (non-decl nodes, files with no code decls) */
u32 muvTuOfDecl(Muv* w, NodeId id)
{
    if (w->tuCount <= 1 || w->fileTuBase == null) return 0;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Decl) return 0;
    u32 lf = locFile(n->loc);
    if (lf > w->maxFid || w->fileShards == null || w->fileShards[lf] == 0) return 0;
    return w->fileTuBase[lf] + muvDeclShard(w, id, lf);
}

u32 muvFnvBytes(str s)
{
    u64 h = 1469598103934665603u;
    usize i = 0;
    while (i < s.len)
    {
        h = (h ^ (u64)s.ptr[i]) * 1099511628211u;
        i++;
    }
    return (u32)h;
}

/* mono-instance TU: hash of the instance's symbol/name across the
 * whole TU space (not per-file) for statistical balance */
u32 muvInstTu(Muv* w, str key)
{
    if (w->tuCount <= 1) return 0;
    return muvFnvBytes(key) % w->tuCount;
}

/* owner-decl method count for partition sizing */
u32 muvOwnerMethodCount(Decl* d)
{
    if (d->kind.tag == DeclKind::Struct) return d->kind.payload.Struct.methodsLen;
    if (d->kind.tag == DeclKind::Union) return d->kind.payload.Union.methodsLen;
    if (d->kind.tag == DeclKind::Variant) return d->kind.payload.Variant.methodsLen;
    if (d->kind.tag == DeclKind::Extend) return d->kind.payload.Extend.methodsLen;
    if (d->kind.tag == DeclKind::ExtendTrait) return d->kind.payload.ExtendTrait.methodsLen;
    return 0;
}

pub MuvmResult generateMuvm(AstContext* ctx, File* file, MonoContext* mono, DiagnosticEngine* diag, Arena* arena, str opt, i32 safetyMode, bool wantIr, CallingConvention cc)
{
    MuvmResult result;
    result.asmText = Slice { null, 0 };
    result.irText = Slice { null, 0 };
    result.tus = null;
    result.tusLen = 0;
    result.errors = 0;
    u32 ccId = muvmCCId(cc);

    /* safety pass: auto (O0 on, O1+ off) unless --safety/--no-safety;
     * freestanding units have no runtime error machinery, so never run it.
     * muvm has no safety globals — the pass is applied per function
     * after lowering (same slot the safety pass gave it: first) */
    u32 optLvl = muvOptLevel(opt);
    bool freestanding = file != null && (file->attrBits & ATTR_FREESTANDING) != 0;
    bool runSafety = !freestanding && safetyMode != 0 &&
                     (optLvl == 0 || safetyMode == 1);

    Muv w;
    w.ctx = ctx;
    w.file = file;
    w.mono = mono;
    w.diag = diag;
    w.arena = arena;
    w.sema = null;
    if (mono != null) w.sema = mono->sema;
    w.errors = 0;
    w.locNames = null;
    w.locSlots = null;
    w.locTys = null;
    w.locLen = 0;
    w.locCap = 0;
    w.fn = null;
    w.block = null;
    w.term = false;
    w.retTy = 0;
    w.breakT = null;
    w.contT = null;
    w.loopDepth = 0;
    w.drops = null;
    w.dropLen = 0;
    w.dropCap = 0;
    w.fnDropMark = 0;
    w.contDropMark = 0;
    w.breakDropMark = 0;
    w.defers = null;
    w.deferLen = 0;
    w.deferCap = 0;
    w.fnDeferMark = 0;
    w.contDeferMark = 0;
    w.breakDeferMark = 0;
    w.mb = String::new();
    w.fnKeys = null;
    w.fnVals = null;
    w.fnCap = 0;
    w.gKeys = null;
    w.gVals = null;
    w.gCap = 0;
    w.structTys = null;
    w.structTysLen = 0;
    w.structTysCap = 0;
    w.ccId = ccId;
    w.subs = null;
    w.subsLen = 0;
    w.instFns = null;
    w.instFnsLen = 0;
    w.dtKeys = null;
    w.dtVals = null;
    w.dtBusy = null;
    w.dtCap = 0;
    w.dtLen = 0;
    w.buildBlocked = false;
    w.placeholderHit = false;
    w.settling = false;
    w.patchOwners = null;
    w.patchArrs = null;
    w.patchIdxs = null;
    w.patchTys = null;
    w.patchLen = 0;
    w.patchCap = 0;
    w.degTys = null;
    w.degLen = 0;
    w.degCap = 0;
    w.tyKeys = null;
    w.tyVals = null;
    w.tyBusy = null;
    w.tyCap = 0;
    w.tdKeys = null;
    w.funcTus = null;
    w.funcTusLen = 0;
    w.funcTusCap = 0;
    w.globTus = null;
    w.globTusLen = 0;
    w.globTusCap = 0;
    w.curTu = 0;
    w.fileShards = null;
    w.fileTuBase = null;
    w.maxFid = 0;
    w.tuCount = 1;
    w.tuFileId = null;
    w.tuShard = null;

    w.ir = irCtxCreate();
    if (w.ir == null) { result.errors = 1; return result; }
    w.module = w.ir->createModule("coral");
    w.b = IrBuilder::new(w.ir);
    muvFnMapInit(&w, 1024);
    muvGMapInit(&w, 256);
    muvTyMapInit(&w, 4096);
    muvDeclTyMapInit(&w, 4096);
    muvTdMapInit(&w, 4096);

    MuvNames names;
    muvNamesInit(&names, 1024);
    w.names = &names;
    w.instTys = null;
    w.instTysLen = 0;
    if (mono != null && mono->instancesLen > 0)
    {
        w.instTysLen = mono->instancesLen;
        w.instTys = alloc<IrType*>((usize)mono->instancesLen);
        if (w.instTys != null)
        {
            u32 zi = 0;
            while (zi < w.instTysLen) { w.instTys[zi] = null; zi++; }
        }
        else w.instTysLen = 0;
    }
    /* build every type instance's IrType up front: method shells and
     * concrete extends resolve field/parameter types through these
     * while collecting, before any body is lowered */
    if (w.instTys != null)
    {
        u32 pj = 0;
        while (pj < w.instTysLen)
        {
            MonoInstance* pinst = mono->instances + pj;
            if (pinst->kind == MonoInstanceKind::TypeInstance)
                muvTypeInstanceTy(&w, pinst->name, pinst->arguments,
                                 pinst->argumentsLen, 0);
            pj++;
        }
    }
    /* ── partition: count code-owning decls per file, derive shard
     * counts and the flat TU list (file-major order). tuCount stays
     * 1 for small units — the single-module path then runs unchanged. */
    if (file != null && file->declsLen > 0)
    {
        u32 pfi = 0;
        while (pfi < file->declsLen)
        {
            Node* pn = muvNode(&w, file->decls[pfi]);
            if (pn->kind.tag == NodeKind::Decl)
            {
                u32 plf = locFile(pn->loc);
                if (plf > w.maxFid) w.maxFid = plf;
            }
            pfi++;
        }
        u32* fileCnt = alloc<u32>((usize)w.maxFid + 1);
        if (fileCnt != null) zero<u32>(fileCnt, (usize)w.maxFid + 1);
        pfi = 0;
        while (pfi < file->declsLen)
        {
            Node* pn = muvNode(&w, file->decls[pfi]);
            if (pn->kind.tag == NodeKind::Decl && fileCnt != null)
            {
                Decl* pd = &pn->kind.payload.Decl.value;
                u32 plf = locFile(pn->loc);
                if (plf <= w.maxFid)
                {
                    if (pd->kind.tag == DeclKind::Func || pd->kind.tag == DeclKind::Constant)
                        fileCnt[plf] = fileCnt[plf] + 1;
                    else if (muvIsOwnerDecl(pd))
                    {
                        u32 ml = muvOwnerMethodCount(pd);
                        fileCnt[plf] = fileCnt[plf] + (ml > 0 ? ml : 1);
                    }
                }
            }
            pfi++;
        }
        w.fileShards = alloc<u32>((usize)w.maxFid + 1);
        w.fileTuBase = alloc<u32>((usize)w.maxFid + 1);
        if (w.fileShards != null) zero<u32>(w.fileShards, (usize)w.maxFid + 1);
        if (w.fileTuBase != null) zero<u32>(w.fileTuBase, (usize)w.maxFid + 1);
        if (fileCnt != null && w.fileShards != null && w.fileTuBase != null)
        {
            u32 f = 0;
            u32 tc = 0;
            while (f <= w.maxFid)
            {
                u32 dcnt = fileCnt[f];
                u32 s = 0;
                if (dcnt > 400) s = (dcnt + 399) / 400;
                else if (dcnt > 0) s = 1;
                w.fileShards[f] = s;
                w.fileTuBase[f] = tc;
                tc += s;
                f++;
            }
            if (tc > 1)
            {
                w.tuFileId = alloc<u32>((usize)tc);
                w.tuShard = alloc<u32>((usize)tc);
                if (w.tuFileId != null && w.tuShard != null)
                {
                    u32 k = 0;
                    f = 0;
                    while (f <= w.maxFid)
                    {
                        u32 s = w.fileShards[f];
                        u32 j = 0;
                        while (j < s) { w.tuFileId[k] = f; w.tuShard[k] = j; k++; j++; }
                        f++;
                    }
                    w.tuCount = k;
                }
            }
        }
        if (fileCnt != null) dealloc<u32>(fileCnt);
    }

    /* collect + declare every function (externs + non-generic defs) */
    IrFunc** bodies = null;
    NodeId* bodyDecls = null;
    u8* bodySelf = null;   // 1 when the shell carries a receiver param 0
    u32 bodiesLen = 0;
    u32 bodiesCap = file->declsLen + 64;
    /* methods ride the same body list: size for every owner's method
     * array up front so the collection loop never has to grow it */
    u32 instMethodCap = 0;
    {
        u32 ci = 0;
        while (ci < file->declsLen)
        {
            Node* cn = muvNode(&w, file->decls[ci]);
            if (cn->kind.tag == NodeKind::Decl && muvIsOwnerDecl(&cn->kind.payload.Decl.value))
            {
                Decl* cd = &cn->kind.payload.Decl.value;
                if (cd->kind.tag == DeclKind::Struct) bodiesCap += cd->kind.payload.Struct.methodsLen;
                else if (cd->kind.tag == DeclKind::Union) bodiesCap += cd->kind.payload.Union.methodsLen;
                else if (cd->kind.tag == DeclKind::Variant) bodiesCap += cd->kind.payload.Variant.methodsLen;
                else if (cd->kind.tag == DeclKind::Extend) bodiesCap += cd->kind.payload.Extend.methodsLen;
                else bodiesCap += cd->kind.payload.ExtendTrait.methodsLen;
            }
            ci++;
        }
        /* instance methods queue too: each TypeInstance's own methods
         * plus every matching extend (over-count of skipped externs and
         * own-generic methods is safe — the queue bounds-checks) */
        if (mono != null && mono->instancesLen > 0)
        {
            u32 pj = 0;
            while (pj < mono->instancesLen)
            {
                MonoInstance* pinst = mono->instances + pj;
                if (pinst->kind == MonoInstanceKind::TypeInstance)
                {
                    Node* pn = muvNode(&w, pinst->declaration);
                    if (pn->kind.tag == NodeKind::Decl)
                    {
                        Decl* pd = &pn->kind.payload.Decl.value;
                        if (pd->kind.tag == DeclKind::Struct) instMethodCap += pd->kind.payload.Struct.methodsLen;
                        else if (pd->kind.tag == DeclKind::Union) instMethodCap += pd->kind.payload.Union.methodsLen;
                        else if (pd->kind.tag == DeclKind::Variant) instMethodCap += pd->kind.payload.Variant.methodsLen;
                    }
                    u32 d = 0;
                    while (d < file->declsLen)
                    {
                        Node* dn = muvNode(&w, file->decls[d]);
                        if (dn->kind.tag == NodeKind::Decl)
                        {
                            Decl* xd = &dn->kind.payload.Decl.value;
                            if (xd->kind.tag == DeclKind::Extend &&
                                muvSelfTyMatches(&w, xd->kind.payload.Extend.selfType,
                                                pinst->name, pinst->arguments, pinst->argumentsLen))
                                instMethodCap += xd->kind.payload.Extend.methodsLen;
                            else if (xd->kind.tag == DeclKind::ExtendTrait &&
                                     muvSelfTyMatches(&w, xd->kind.payload.ExtendTrait.selfType,
                                                     pinst->name, pinst->arguments, pinst->argumentsLen))
                                instMethodCap += xd->kind.payload.ExtendTrait.methodsLen;
                        }
                        d++;
                    }
                }
                pj++;
            }
        }
    }
    if (bodiesCap > 0)
    {
        bodies = alloc<IrFunc*>((usize)bodiesCap);
        bodyDecls = alloc<NodeId>((usize)bodiesCap);
        bodySelf = alloc<u8>((usize)bodiesCap);
        if (bodySelf != null)
        {
            u32 zi = 0;
            while (zi < bodiesCap) { bodySelf[zi] = 0; zi++; }
        }
    }
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId did = file->decls[i];
        Node* n = muvNode(&w, did);
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* d = &n->kind.payload.Decl.value;
            w.curTu = muvTuOfDecl(&w, did);
            w.curFileId = locFile(n->loc);
            if (d->kind.tag == DeclKind::Func)
            {
                IrFunc* f = muvCollectFunc(&w, &names, did, d);
                if (f != null && bodiesLen < bodiesCap)
                {
                    bodies[bodiesLen] = f;
                    bodyDecls[bodiesLen] = did;
                    bodiesLen++;
                }
            }
            else if (d->kind.tag == DeclKind::Constant && !muvConstIsTypeAlias(&w, did))
            {
                /* every file-scope constant gets one copy of storage —
                 * aggregates are addressed through it, scalars may still
                 * fold into their uses instead of being read back */
                u8 cf = d->kind.payload.Constant.flags;
                muvSettleTypes(&w);
                w.buildBlocked = false;
                muvMakeGlobal(&w, did, d->kind.payload.Constant.name,
                             muvResolved(&w, d->kind.payload.Constant.typeNode),
                             d->kind.payload.Constant.value,
                             (cf & 16) != 0, (cf & 2) != 0, 0);
            }
            else if (muvIsOwnerDecl(d))
            {
                /* every method of a type-named decl: its symbol composes
                 * `owner_method`, and an implicit receiver becomes
                 * parameter 0 of the shell (bind in muvLowerBody) */
                Str owner = 0;
                NodeId* methods = null;
                u32 mlen = 0;
                IrType* selfPt = null;
                if (muvOwnerMethods(&w, d, &owner, &methods, &mlen, &selfPt))
                {
                    u32 mi = 0;
                    while (mi < mlen)
                    {
                        NodeId mdef = methods[mi];
                        Node* mn = muvNode(&w, mdef);
                        if (mn->kind.tag == NodeKind::Decl)
                        {
                            Decl* md = &mn->kind.payload.Decl.value;
                            if (md->kind.tag == DeclKind::Func &&
                                (w.mono == null || w.mono->genericCount(mdef) == 0))
                            {
                                w.curTu = muvTuOfDecl(&w, mdef);
                                w.curFileId = locFile(mn->loc);
                                u8 sk = muvMethodSelfKind(&w, mdef);
                                str msym = muvMethodMangle(&w, mdef, owner, md->kind.payload.Func.name);
                                IrFunc* f = muvRegisterFunc(&w, &names, mdef, md, msym,
                                                           sk == 1 ? selfPt : null);
                                if (f != null && bodiesLen < bodiesCap)
                                {
                                    bodies[bodiesLen] = f;
                                    bodyDecls[bodiesLen] = mdef;
                                    bodySelf[bodiesLen] = (sk == 1 && selfPt != null) ? 1 : 0;
                                    bodiesLen++;
                                }
                            }
                        }
                        mi++;
                    }
                }
            }
        }
        i++;
    }

    /* declare every collected function instance under its own symbol —
     * call resolution runs during body lowering and picks through
     * w.instFns, so this must precede both lowering loops */
    MuvBodyEnt* iEnts = null;
    u32 iBodiesLen = 0;
    u32 iQCap = 0;
    if (mono != null && mono->instancesLen > 0)
    {
        u32 icap = mono->instancesLen;
        iQCap = icap + instMethodCap;
        w.instFns = alloc<IrFunc*>((usize)icap);
        iEnts = alloc<MuvBodyEnt>((usize)iQCap);
        if (w.instFns != null)
        {
            w.instFnsLen = icap;
            u32 zi = 0;
            while (zi < icap) { w.instFns[zi] = null; zi++; }
        }
        u32 ii = 0;
        while (ii < icap)
        {
            MonoInstance* inst = mono->instances + ii;
            if (inst->kind == MonoInstanceKind::FunctionInstance && inst->body.index != 0 &&
                w.instFns != null && iEnts != null)
            {
                Node* dn = muvNode(&w, inst->declaration);
                if (dn->kind.tag == NodeKind::Decl)
                {
                    Decl* dd = &dn->kind.payload.Decl.value;
                    if (dd->kind.tag == DeclKind::Func)
                    {
                        str isym = muvInstanceSymbol(&w, inst, ii);
                        if (isym.len == 0)
                        {
                            w.errors++;
                            w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                 "cannot compose the function instance symbol");
                        }
                        else if (muvNamesFind(&names, isym) != null)
                        {
                            w.errors++;
                            w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                 "duplicate function instance symbol");
                        }
                        else
                        {
                            IrFunc* f = muvDeclareInstanceFunc(&w, inst, isym);
                            if (f == null)
                            {
                                w.errors++;
                                w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                     "cannot declare the function instance");
                            }
                            else
                            {
                                w.curTu = muvInstTu(&w, isym);
                                {
                                    Node* in0 = muvNode(&w, inst->declaration);
                                    w.curFileId = locFile(in0->loc);
                                }
                                muvAddFunc(&w, f);
                                /* key from the IrFunc's own copy: isym is
                                 * a view into w->mb, which the instance's
                                 * substituted signature just rewrote */
                                MuvNameEnt* ent = muvNamesInsert(&names, f->base.name);
                                if (ent != null)
                                {
                                    ent->name = f->base.name;
                                    ent->declIdx = inst->declaration.index;
                                    ent->isDefn = true;
                                    ent->f = f;
                                }
                                w.instFns[ii] = f;
                                iEnts[iBodiesLen] = MuvBodyEnt { .f = f,
                                                                .decl = inst->declaration,
                                                                .body = inst->body,
                                                                .inst = ii, .tu = w.curTu, .self = 0 };
                                iBodiesLen++;
                            }
                        }
                    }
                }
            }
            ii++;
        }

        /* instance methods: each TypeInstance's own methods plus every
         * matching extend, under the instance-composed owner (mirror
         * cgEmitInstanceMethods); bodies ride the same queue with the
         * instance's substitutions active while lowering */
        ii = 0;
        while (ii < mono->instancesLen)
        {
            MonoInstance* inst = mono->instances + ii;
            if (inst->kind == MonoInstanceKind::TypeInstance && iEnts != null)
            {
                if (getenv(C"MUV_DEBUG") != null)
                    printf(C"muvdbg: typeInst ii=%u args=%u decl=%u\n",
                           ii, inst->argumentsLen, inst->declaration.index);
                if (w.instTys == null || ii >= w.instTysLen || w.instTys[ii] == null)
                    muvErr(&w, inst->declaration, "cannot build the instance type for its methods");
                else
                {
                    Str iown = muvTypeInstanceName(&w, inst->name, inst->arguments,
                                                  inst->argumentsLen);
                    w.curTu = muvInstTu(&w, muvStr(&w, iown));
                    IrType* selfPt = w.ir->tyPtr(w.instTys[ii]);
                    Node* pn = muvNode(&w, inst->declaration);
                    w.curFileId = locFile(pn->loc);
                    if (pn->kind.tag == NodeKind::Decl)
                    {
                        Decl* pd = &pn->kind.payload.Decl.value;
                        NodeId* im = null;
                        u32 iml = 0;
                        if (pd->kind.tag == DeclKind::Struct) {
                            im = pd->kind.payload.Struct.methods; iml = pd->kind.payload.Struct.methodsLen;
                        }
                        else if (pd->kind.tag == DeclKind::Union) { 
                            im = pd->kind.payload.Union.methods; iml = pd->kind.payload.Union.methodsLen; }
                        else if (pd->kind.tag == DeclKind::Variant) {
                            im = pd->kind.payload.Variant.methods; iml = pd->kind.payload.Variant.methodsLen;
                        }
                        muvQueueInstMethods(&w, im, iml, iown, selfPt, inst, ii,
                                           iEnts, &iBodiesLen, iQCap);
                    }
                    u32 d = 0;
                    while (d < file->declsLen)
                    {
                        Node* dn2 = muvNode(&w, file->decls[d]);
                        if (dn2->kind.tag == NodeKind::Decl)
                        {
                            Decl* xd = &dn2->kind.payload.Decl.value;
                            NodeId* em = null;
                            u32 eml = 0;
                            if (xd->kind.tag == DeclKind::Extend &&
                                muvSelfTyMatches(&w, xd->kind.payload.Extend.selfType,
                                                inst->name, inst->arguments, inst->argumentsLen)) {
                                if (getenv(C"MUV_DEBUG") != null)
                                {
                                    InternEntry* ie = w.ctx->interns + iown;
                                    printf(C"muvdbg: sweep extend iown=%.*s eml=%u\n",
                                           (i32)ie->len, ie->ptr, xd->kind.payload.Extend.methodsLen);
                                }
                                em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen;
                            }
                            else if (xd->kind.tag == DeclKind::ExtendTrait &&
                                     muvSelfTyMatches(&w, xd->kind.payload.ExtendTrait.selfType,
                                                     inst->name, inst->arguments, inst->argumentsLen)) {
                                em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen;
                            }
                            muvQueueInstMethods(&w, em, eml, iown, selfPt, inst, ii,
                                               iEnts, &iBodiesLen, iQCap);
                        }
                        d++;
                    }
                }
            }
            ii++;
        }
    }

    /* lower definition bodies */
    i = 0;
    while (i < bodiesLen && w.errors == 0)
    {
        Node* n = muvNode(&w, bodyDecls[i]);
        Decl* d = &n->kind.payload.Decl.value;
        w.curTu = muvTuOfDecl(&w, bodyDecls[i]);
        muvLowerBody(&w, bodyDecls[i], d, bodies[i], bodySelf != null ? bodySelf[i] : 0,
                    d->kind.payload.Func.body, null);
        i++;
    }

    /* lower monomorphised instance bodies (function instances and
     * instance methods) with their substitutions active */
    i = 0;
    while (i < iBodiesLen && w.errors == 0)
    {
        MuvBodyEnt* ent = iEnts + i;
        MonoInstance* inst = mono->instances + ent->inst;
        Node* n = muvNode(&w, ent->decl);
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* d = &n->kind.payload.Decl.value;
            MonoSubstitution* oldS = w.subs;
            u32 oldSL = w.subsLen;
            w.curTu = ent->tu;
            w.subs = inst->substitutions;
            w.subsLen = inst->substitutionsLen;
            muvLowerBody(&w, ent->decl, d, ent->f, ent->self, ent->body, inst);
            w.subs = oldS;
            w.subsLen = oldSL;
        }
        i++;
    }
    if (iEnts != null) dealloc<MuvBodyEnt>(iEnts);

    /* validate every function in the module */
    if (w.errors == 0)
    {
        u32 fi = 0;
        while (fi < w.module->nfuncs)
        {
            IrFunc* f = w.module->funcs[fi];
            if (f != null && !f->isExtern && !muvmPassVerify(f, null))
            {
                w.errors++;
                printf(C"error: IR validation failed in %.*s\n",
                       (i32)f->base.name.len, (const cchar*)f->base.name.ptr);
            }
            fi++;
        }
    }

    /* optional IR dump (--emit-ir): print before asm so a failed
     * compileAsm still leaves inspectable IR — also on validation
     * failure, which is exactly when inspection matters most. The
     * printer owns its buffer (freed by destroy), so copy into the
     * arena that the caller frees after reading. */
    if (wantIr)
    {
        IrPrinter p = IrPrinter::new();
        p.printModule(w.module);
        str irOut = p.output();
        if (irOut.ptr != null && irOut.len > 0)
        {
            u8* buf = (u8*)arena->alloc(irOut.len + 1, 1);
            if (buf != null)
            {
                usize bi = 0;
                while (bi < irOut.len) { buf[bi] = irOut.ptr[bi]; bi++; }
                buf[irOut.len] = 0;
                result.irText = Slice::from(buf, irOut.len);
            }
        }
        p.destroy();
    }

    /* safety instrumentation: the pass muvm's Debug level would run,
     * applied explicitly so --safety/--no-safety and the O0-only auto
     * rule keep their meaning at every opt level */
    if (w.errors == 0 && runSafety)
    {
        u32 fi = 0;
        while (fi < w.module->nfuncs)
        {
            IrFunc* f = w.module->funcs[fi];
            if (f != null && !f->isExtern)
                muvmPassSafety(f, w.ir, muvTrapName());
            fi++;
        }
    }
    /* compile to asm — one IrModule per TU when the partition
     * produced several; per-TU modules share the IrContext and
     * replicate the read-only tables (struct types are layout-only,
     * string constants emit .L local labels so duplicating is
     * link-safe, externs replicate as decls — dyn externs need their
     * .globl/.type in every object that references them). Function
     * bodies and non-extern globals stay in their home TU; cross-TU
     * references resolve as ordinary undefined symbols at link. */
    if (w.errors == 0)
    {
        MuvmOptions o = muvmOptions(muvOptEnum(optLvl));
        o.unroll = optLvl == 3;
        if (w.tuCount > 1 && w.tuFileId != null && w.funcTus != null)
        {
            result.tusLen = w.tuCount;
            result.tus = alloc<MuvmTu>((usize)w.tuCount);
            if (result.tus == null) w.errors++;
            u32 k = 0;
            while (k < w.tuCount && w.errors == 0 && result.tus != null)
            {
                IrModule* mk = w.ir->createModule("tu");
                if (mk == null) { w.errors++; break; }
                mk->attrGroups = w.module->attrGroups;
                mk->nAttrGroups = w.module->nAttrGroups;
                mk->capAttrGroups = w.module->capAttrGroups;
                u32 mi = 0;
                while (mi < w.module->nstructs)
                {
                    mk->addStruct(w.module->structs[mi]);
                    mi++;
                }
                mi = 0;
                while (mi < w.module->nconstStrings)
                {
                    mk->addConstString(w.module->constStrings[mi]);
                    mi++;
                }
                /* externs first: addFunc re-collects the extern list,
                 * so keeping this pass small bounds that rescan */
                mi = 0;
                while (mi < w.module->nfuncs)
                {
                    IrFunc* f = w.module->funcs[mi];
                    if (f != null && f->isExtern) mk->addFunc(f);
                    mi++;
                }
                mi = 0;
                while (mi < w.module->nfuncs)
                {
                    IrFunc* f = w.module->funcs[mi];
                    if (f != null && !f->isExtern && mi < w.funcTusLen &&
                        w.funcTus != null && w.funcTus[mi] == k)
                        mk->addFunc(f);
                    mi++;
                }
                mi = 0;
                while (mi < w.module->nglobals)
                {
                    IrGlobal* g = w.module->globals[mi];
                    if (g != null && !g->isExtern && mi < w.globTusLen &&
                        w.globTus != null && w.globTus[mi] == k)
                        mk->addGlobal(g);
                    mi++;
                }
                str asmText = muvmCompileAsm(mk, w.ir, cc, o);
                if (asmText.ptr != null && asmText.len > 0)
                {
                    /* TU name "tu<k>" in the arena so it outlives the
                     * result hand-off */
                    u8* nb = (u8*)arena->alloc(24, 1);
                    if (nb != null)
                    {
                        usize nn = 0;
                        nb[nn++] = 116; nb[nn++] = 117; /* "tu" */
                        u8[10] tmp;
                        u32 tn = 0;
                        u32 kv = k;
                        if (kv == 0) tmp[tn++] = 48;
                        else
                        {
                            while (kv > 0) { tmp[tn++] = (u8)(48 + (kv % 10)); kv /= 10; }
                            while (tn > 0) { tn = tn - 1; nb[nn++] = tmp[tn]; }
                        }
                        nb[nn] = 0;
                        result.tus[k].name = Slice::from(nb, nn);
                        result.tus[k].text = Slice::from((u8*)asmText.ptr, asmText.len);
                    }
                    else w.errors++;
                }
                else
                {
                    w.errors++;
                    printf(C"error: muvm asm generation failed (tu %u)\n", k);
                }
                k++;
            }
        }
        else
        {
            str asmText = muvmCompileAsm(w.module, w.ir, cc, o);
            if (asmText.ptr != null && asmText.len > 0)
                result.asmText = Slice::from((u8*)asmText.ptr, asmText.len);
            else
            {
                w.errors++;
                printf(C"error: muvm asm generation failed\n");
            }
        }
    }

    result.errors = w.errors;

    /* cleanup */
    if (bodies != null) dealloc<IrFunc*>(bodies);
    if (bodyDecls != null) dealloc<NodeId>(bodyDecls);
    if (names.ents != null) dealloc<MuvNameEnt>(names.ents);
    if (w.fnKeys != null) dealloc<u32>(w.fnKeys);
    if (w.fnVals != null) dealloc<IrFunc*>(w.fnVals);
    if (w.tyKeys != null) dealloc<u32>(w.tyKeys);
    if (w.tyVals != null) dealloc<IrType*>(w.tyVals);
    if (w.tyBusy != null) dealloc<u8>(w.tyBusy);
    if (w.tdKeys != null) dealloc<u32>(w.tdKeys);
    if (w.tdVals != null) dealloc<u32>(w.tdVals);
    w.mb.free();
    if (w.funcTus != null) dealloc<u32>(w.funcTus);
    if (w.globTus != null) dealloc<u32>(w.globTus);
    if (w.fileShards != null) dealloc<u32>(w.fileShards);
    if (w.fileTuBase != null) dealloc<u32>(w.fileTuBase);
    if (w.tuFileId != null) dealloc<u32>(w.tuFileId);
    if (w.tuShard != null) dealloc<u32>(w.tuShard);
    irCtxDestroy(w.ir);
    return result;
}
