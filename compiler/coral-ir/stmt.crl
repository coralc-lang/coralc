#[[no_drop_all]]
/* coral-ir/stmt.crl — statement lowering
 *
 * Phase 1: Return, Block, VarDecl, ExprStmt, If, While, Assign ("="),
 * Break/Continue. Blocks lower straight into the current function via
 * the builder; the `term` flag tracks terminators so dead statements
 * after Return/Break/Continue are skipped. No phis — locals are
 * alloca+load/store. */
import lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvFindLocal, wvPushLocal,
               wvBlock, wvSetBlock, wvTerm, wvPos };
import types { wvTy };
import expr { wvExpr };
import context::context { AstContext };
import sem { scope { Symbol, ScopeStack } };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, Param }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrBlock };
import(lib) wallvm::irOps { IrICmpPred };
import(lib) wallvm::irBuilder { IrBuilder };
import(lib) std::mman { alloc, dealloc };

pub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }

pub void wvStmt(Wv* w, NodeId id);

/* ── helpers ────────────────────────────────────────────────── */

/* store an expression's value into an lvalue slot (Ident local or
 * Deref pointee). Returns false on unsupported targets. */
pub bool wvAssignTo(Wv* w, NodeId targetId, IrValue* val)
{
    Node* tn = wvNode(w, targetId);
    if (tn->kind.tag != NodeKind::Expr) return false;
    Expr* te = &tn->kind.payload.Expr.value;
    if (te->kind.tag == ExprKind::Ident)
    {
        IrValue* slot = wvFindLocal(w, te->kind.payload.Ident.name);
        if (slot == null) return false;
        w->b.store(val, slot);
        return true;
    }
    if (te->kind.tag == ExprKind::Deref)
    {
        IrValue* ptr = wvExpr(w, te->kind.payload.Deref.expr);
        if (ptr == null) return false;
        w->b.store(val, ptr);
        return true;
    }
    return false;
}

/* lower a VarDecl: alloca, optionally store init, register the local */
pub void wvVarDecl(Wv* w, Stmt* s, NodeId id)
{
    Str name = s->kind.payload.VarDecl.name;
    Ty vt = wvResolved(w, s->kind.payload.VarDecl.typeNode);
    if (vt == 0)
    {
        /* `var x = init` — infer from the init expr's resolved type */
        NodeId initId = s->kind.payload.VarDecl.init;
        if (initId.index != 0)
        {
            Node* in = wvNode(w, initId);
            if (in->kind.tag == NodeKind::Expr)
                vt = wvResolved(w, in->kind.payload.Expr.value.resolvedType);
        }
    }
    IrType* irt = vt != 0 ? wvTy(w->ctx, w->file, w->ir, vt, 0) : null;
    if (irt == null || irt->kind == IrTypeKind::Void)
    {
        wvErr(w, id, "cannot local-bind a void value");
        return;
    }
    IrValue* slot = wvV(w->b.alloca(irt));
    if (slot == null) return;
    if ((s->kind.payload.VarDecl.flags & 2) != 0) // hasInit
    {
        IrValue* init = wvExpr(w, s->kind.payload.VarDecl.init);
        if (init != null) w->b.store(init, slot);
    }
    wvPushLocal(w, name, slot);
}

/* ── the main statement dispatch ────────────────────────────── */

pub void wvStmt(Wv* w, NodeId id)
{
    if (id.index == 0) return;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Stmt)
    {
        wvErr(w, id, "expected statement node");
        return;
    }
    if (w->term) return; // dead code after a terminator
    Stmt* s = &n->kind.payload.Stmt.value;
    switch (s->kind.tag)
    {
        StmtKind::ExprStmt => { wvExpr(w, s->kind.payload.ExprStmt.expr); },
        StmtKind::VarDecl => { wvVarDecl(w, s, id); },
        StmtKind::Return => {
            NodeId vId = s->kind.payload.Return.value;
            if (vId.index != 0)
            {
                IrValue* v = wvExpr(w, vId);
                if (v != null) w->b.ret(v);
            }
            else w->b.retVoid();
            wvTerm(w);
        },
        StmtKind::Block => {
            u32 i = 0;
            while (i < s->kind.payload.Block.stmtsLen && !w->term)
            {
                wvStmt(w, s->kind.payload.Block.stmts[i]);
                i++;
            }
        },
        StmtKind::Assign => {
            Str op = s->kind.payload.Assign.op;
            if (op == 0) return;
            str ops = wvStr(w, op);
            if (!ops.equals("="))
            {
                wvErr(w, id, "compound assignment: Phase 2");
                return;
            }
            IrValue* val = wvExpr(w, s->kind.payload.Assign.value);
            if (val == null) return;
            if (!wvAssignTo(w, s->kind.payload.Assign.target, val))
                wvErr(w, id, "unsupported assignment target (Phase 1)");
        },
        StmtKind::If => {
            IrValue* cond = wvExpr(w, s->kind.payload.If.cond);
            if (cond == null) return;
            IrValue* c = cond->type != null && cond->type->kind == IrTypeKind::Int &&
                         cond->type->width == 1
                ? cond
                : wvV(w->b.icmp(IrICmpPred::Ne, cond, w->ir->constInt(cond->type, 1)));
            IrBlock* thenBb = wvBlock(w, "if.then");
            NodeId elseId = s->kind.payload.If.elseBody;
            IrBlock* elseBb = elseId.index != 0 ? wvBlock(w, "if.else") : null;
            IrBlock* joinBb = wvBlock(w, "if.end");
            w->b.condBr(c, thenBb, elseBb != null ? elseBb : joinBb);

            wvSetBlock(w, thenBb);
            wvStmt(w, s->kind.payload.If.thenBody);
            if (!w->term) w->b.br(joinBb);

            if (elseBb != null)
            {
                wvSetBlock(w, elseBb);
                wvStmt(w, elseId);
                if (!w->term) w->b.br(joinBb);
            }
            wvSetBlock(w, joinBb);
        },
        StmtKind::While => {
            IrBlock* headBb = wvBlock(w, "while.head");
            IrBlock* bodyBb = wvBlock(w, "while.body");
            IrBlock* exitBb = wvBlock(w, "while.end");
            w->b.br(headBb);
            wvSetBlock(w, headBb);
            IrValue* cond = wvExpr(w, s->kind.payload.While.cond);
            if (cond == null) return;
            IrValue* c = cond->type != null && cond->type->kind == IrTypeKind::Int &&
                         cond->type->width == 1
                ? cond
                : wvV(w->b.icmp(IrICmpPred::Ne, cond, w->ir->constInt(cond->type, 1)));
            w->b.condBr(c, bodyBb, exitBb);

            wvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            w->breakT = exitBb;
            w->contT = headBb;
            w->loopDepth++;
            wvStmt(w, s->kind.payload.While.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            if (!w->term) w->b.br(headBb);
            wvSetBlock(w, exitBb);
        },
        StmtKind::Break => {
            if (w->breakT == null) { wvErr(w, id, "break outside a loop"); return; }
            w->b.br(w->breakT);
            wvTerm(w);
        },
        StmtKind::Continue => {
            if (w->contT == null) { wvErr(w, id, "continue outside a loop"); return; }
            w->b.br(w->contT);
            wvTerm(w);
        },
        else => {
            wvErr(w, id, "unsupported statement (Phase 1)");
        },
    }
}
