#[[no_drop_all]]
/* coral-ir/stmt.crl — statement lowering
 *
 * Return, Block (with scope popping), VarDecl (aggregate-aware init),
 * ExprStmt, If, While, Loop, For, Assign (plain + compound via
 * wvAssignCommon), Break/Continue. Blocks lower straight into the
 * current function via the builder; the `term` flag tracks terminators
 * so dead statements after Return/Break/Continue are skipped. No phis —
 * locals are alloca+load/store. */
use lower { Wv, WvDrop, wvNode, wvErr, wvStr, wvResolved, wvFindLocal, wvPushLocal,
               wvBlock, wvSetBlock, wvTerm, wvPos, wvArr, wvSlotTy };
use types { wvTy, wvFindTypeDecl };
use expr { wvExpr, wvAddrOf, wvCond, wvAssignCommon, wvIsAgg, wvCopyAgg, wvAggSlot,
               wvDecodeLit, wvCompareVals, wvResolveConst, wvMakeGlobal, wvValBody,
               wvMethodFnFor, wvCast, wvUnwrapTy, wvTyUnsigned, wvIndexAddr,
               wvGepField, wvFieldIdx };
use decl { wvMethodSelfKind };
use context::context { AstContext };
use sem { scope { Symbol, ScopeStack } };
use ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind, SwitchCase },
    decl { Decl, DeclKind, Param },
    pat { Pat, PatKind }
};
use common::slice { Slice };
import wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrBlock };
import wallvm::irOps { IrICmpPred };
import wallvm::irBuilder { IrBuilder };
import std::mman { alloc, dealloc };

pub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }

pub void wvStmt(Wv* w, NodeId id);

/* one pattern's test against an already-evaluated scrutinee: an i1
 * value, or null with *isWildcard set when the pattern matches every
 * value. Mirrors the C backend's cgPatTest; the arm's patterns are OR'd
 * by wvSwitchTest. */
pub IrValue* wvPatTest(Wv* w, NodeId patId, IrValue* scrut, Ty scrutTy,
                        bool* isWildcard, NodeId id)
{
    *isWildcard = false;
    if (patId.index == 0) { *isWildcard = true; return null; }
    Node* n = wvNode(w, patId);
    if (n->kind.tag == NodeKind::Pat)
    {
        Pat* p = &n->kind.payload.Pat.value;
        switch (p->kind.tag)
        {
            PatKind::Wildcard => { *isWildcard = true; return null; },
            PatKind::Lit => {
                IrValue* lit = wvExpr(w, p->kind.payload.Lit.expr);
                if (lit == null) return null;
                return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
            },
            PatKind::Ident => {
                /* a bare name in a value switch is a file-scope constant
                 * (`switch (sig) { SIGSEGV_ => … }`), not a binding */
                NodeId cd = wvResolveConst(w, p->kind.payload.Ident.name, patId);
                if (cd.index == 0)
                    { wvErr(w, patId, "pattern names an unknown constant"); return null; }
                NodeId init = wvNode(w, cd)->kind.payload.Decl.value->kind.payload.Constant.value;
                IrValue* lit = wvExpr(w, init);
                if (lit == null) return null;
                return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
            },
            PatKind::Or => {
                IrValue* acc = null;
                u32 i = 0;
                while (i < p->kind.payload.Or.alternativesLen)
                {
                    bool wild = false;
                    IrValue* t = wvPatTest(w, p->kind.payload.Or.alternatives[i],
                                           scrut, scrutTy, &wild, id);
                    if (wild) { *isWildcard = true; return null; }
                    if (t == null) return null;
                    acc = acc == null ? t : wvV(w->b.orOp(acc, t));
                    if (acc == null) return null;
                    i++;
                }
                if (acc == null) { *isWildcard = true; return null; }
                return acc;
            },
            PatKind::Range => {
                IrValue* lo = wvExpr(w, p->kind.payload.Range.start);
                IrValue* hi = wvExpr(w, p->kind.payload.Range.end);
                if (lo == null || hi == null) return null;
                bool incl = (p->kind.payload.Range.flags & 1) != 0;
                IrValue* a = wvCompareVals(w, ExprKind::Ge, scrut, lo, id, scrutTy);
                IrValue* b = wvCompareVals(w, incl ? ExprKind::Le : ExprKind::Lt,
                                           scrut, hi, id, scrutTy);
                if (a == null || b == null) return null;
                return wvV(w->b.andOp(a, b));
            },
            PatKind::Guard => {
                /* pattern-level guard: test && cond; a wildcard inner
                 * pattern leaves the guard as the whole test */
                bool wild = false;
                IrValue* t = wvPatTest(w, p->kind.payload.Guard.pattern,
                                       scrut, scrutTy, &wild, id);
                IrValue* g = wvCond(w, wvExpr(w, p->kind.payload.Guard.cond));
                if (g == null) return null;
                if (wild) return g;
                if (t == null) return null;
                return wvV(w->b.andOp(t, g));
            },
            else => { wvErr(w, patId, "pattern kind unsupported (Phase 3)"); return null; },
        }
    }
    if (n->kind.tag == NodeKind::Expr)
    {
        /* bare expression pattern (a literal or constant reference) */
        IrValue* lit = wvExpr(w, patId);
        if (lit == null) return null;
        return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
    }
    wvErr(w, patId, "unsupported pattern");
    return null;
}

/* the arm's test: every pattern OR'd together; a wildcard anywhere in
 * the arm matches all values */
pub IrValue* wvSwitchTest(Wv* w, SwitchCase* c, IrValue* scrut, Ty scrutTy,
                           bool* isWildcard, NodeId id)
{
    *isWildcard = false;
    IrValue* acc = null;
    u32 p = 0;
    while (p < c->patternsLen)
    {
        bool wild = false;
        IrValue* t = wvPatTest(w, c->patterns[p], scrut, scrutTy, &wild, id);
        if (wild) { *isWildcard = true; return null; }
        if (t == null) return null;
        acc = acc == null ? t : wvV(w->b.orOp(acc, t));
        if (acc == null) return null;
        p++;
    }
    if (acc == null) { *isWildcard = true; return null; }
    return acc;
}

/* value switch as a compare chain in blocks (no phis). Each arm owns a
 * test block and a body block; a failed test or a failed guard branches
 * to the next arm's test block, then to the else arm, then to the join.
 * The else arm runs only when nothing matched, wherever it sits in the
 * source — the same shape cgEmitSwitchChain prints as if/else-if.
 * slot/vt are null for the statement form; a switch-expr passes its
 * result slot and every arm's body value is stored into it. */
pub void wvSwitchCore(Wv* w, NodeId scrutId, SwitchCase* cases, u32 n,
                      NodeId id, IrValue* slot, IrType* vt)
{
    if (scrutId.index == 0) { wvErr(w, id, "switch without a scrutinee"); return; }
    Node* sn = wvNode(w, scrutId);
    if (sn->kind.tag != NodeKind::Expr) { wvErr(w, id, "switch scrutinee"); return; }
    IrValue* scrut = wvExpr(w, scrutId);
    if (scrut == null) return;
    Ty scrutTy = wvResolved(w, sn->kind.payload.Expr.value.resolvedType);

    if (cases == null || n == 0) { wvErr(w, id, "switch without cases"); return; }

    IrBlock** tbb = (IrBlock**)wvArr(w, (usize)n, 8);
    IrBlock** bbb = (IrBlock**)wvArr(w, (usize)n, 8);
    IrBlock** gbb = (IrBlock**)wvArr(w, (usize)n, 8);
    IrBlock** fbb = (IrBlock**)wvArr(w, (usize)n, 8);
    if (tbb == null || bbb == null || gbb == null || fbb == null)
        { wvErr(w, id, "switch: out of memory"); return; }

    u32 elseIdx = 0xFFFFFFFF;
    u32 i = 0;
    while (i < n)
    {
        tbb[i] = null;
        bbb[i] = null;
        gbb[i] = null;
        fbb[i] = null;
        SwitchCase* c = cases + i;
        if ((c->flags & 4) != 0 || c->patternsLen == 0)
        {
            if (elseIdx == 0xFFFFFFFF) elseIdx = i;
        }
        else
        {
            tbb[i] = wvBlock(w, "sw.test");
            bbb[i] = wvBlock(w, "sw.body");
            if ((c->flags & 1) != 0 && c->guard.index != 0)
                gbb[i] = wvBlock(w, "sw.guard");
        }
        i++;
    }
    IrBlock* joinBb = wvBlock(w, "sw.end");
    IrBlock* elseBb = elseIdx != 0xFFFFFFFF ? wvBlock(w, "sw.else") : null;

    /* fail targets, walked backwards so each arm knows where a failed
     * test or guard lands: the next arm's test, else, then join */
    IrBlock* nextTest = null;
    i = n;
    while (i > 0)
    {
        i--;
        if (i == elseIdx || tbb[i] == null) continue;
        fbb[i] = nextTest != null ? nextTest
                 : (elseBb != null ? elseBb : joinBb);
        nextTest = tbb[i];
    }
    IrBlock* entry = nextTest != null ? nextTest
                     : (elseBb != null ? elseBb : joinBb);
    w->b.br(entry);

    IrBlock* savedBreak = w->breakT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    w->breakT = joinBb;
    w->breakDropMark = w->dropLen;
    w->breakDeferMark = w->deferLen;
    w->loopDepth++;

    i = 0;
    while (i < n)
    {
        if (i == elseIdx || tbb[i] == null) { i++; continue; }
        SwitchCase* c = cases + i;
        IrBlock* fail = fbb[i];

        wvSetBlock(w, tbb[i]);
        bool wild = false;
        IrValue* test = wvSwitchTest(w, c, scrut, scrutTy, &wild, id);
        if (!wild && test == null) break;
        IrBlock* hit = gbb[i] != null ? gbb[i] : bbb[i];
        if (wild) w->b.br(hit);
        else w->b.condBr(test, hit, fail);

        if (gbb[i] != null)
        {
            wvSetBlock(w, gbb[i]);
            IrValue* g = wvCond(w, wvExpr(w, c->guard));
            if (g == null) break;
            w->b.condBr(g, bbb[i], fail);
        }

        wvSetBlock(w, bbb[i]);
        if (slot != null)
        {
            IrValue* v = wvValBody(w, c->body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else wvStmt(w, c->body);
        if (!w->term) w->b.br(joinBb);
        i++;
    }

    if (elseBb != null && elseIdx < n)
    {
        wvSetBlock(w, elseBb);
        if (slot != null)
        {
            IrValue* v = wvValBody(w, cases[elseIdx].body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else wvStmt(w, cases[elseIdx].body);
        if (!w->term) w->b.br(joinBb);
    }

    w->breakT = savedBreak;
    w->breakDropMark = savedBreakMark;
    w->breakDeferMark = savedBreakDefers;
    w->loopDepth--;
    wvSetBlock(w, joinBb);
}

/* the statement form: no result slot, every arm lowers as statements */
pub void wvSwitch(Wv* w, Stmt* s, NodeId id)
{
    wvSwitchCore(w, s->kind.payload.Switch.expr, s->kind.payload.Switch.cases,
                 s->kind.payload.Switch.casesLen, id, null, null);
}



/* ── defer stack ────────────────────────────────────────────── */

void wvDeferPush(Wv* w, NodeId stmt)
{
    if (w->deferLen >= w->deferCap)
    {
        u32 nc = w->deferCap == 0 ? 8 : w->deferCap * 2;
        NodeId* nd = alloc<NodeId>((usize)nc);
        if (nd == null) { wvErr(w, stmt, "out of memory in defer table"); return; }
        u32 i = 0;
        while (i < w->deferLen) { nd[i] = w->defers[i]; i++; }
        if (w->defers != null) dealloc<NodeId>(w->defers);
        w->defers = nd;
        w->deferCap = nc;
    }
    w->defers[w->deferLen] = stmt;
    w->deferLen++;
}

/* run deferred statements above `mark` LIFO; scope end also pops */
void wvDefersFrom(Wv* w, u32 mark, bool pop)
{
    u32 i = w->deferLen;
    while (i > mark)
    {
        i--;
        wvStmt(w, w->defers[i]);
    }
    if (pop && w->deferLen > mark) w->deferLen = mark;
}

pub void wvDefersBranch(Wv* w, u32 mark)
{
    wvDefersFrom(w, mark, false);
}

/* ── RAII drop stack ────────────────────────────────────────── */

void wvDropPush(Wv* w, Str name, IrValue* slot, Ty ty, NodeId mdef)
{
    if (w->dropLen >= w->dropCap)
    {
        u32 nc = w->dropCap == 0 ? 8 : w->dropCap * 2;
        WvDrop* nd = alloc<WvDrop>((usize)nc);
        if (nd == null) { wvErr(w, NodeId{}, "out of memory in drop table"); return; }
        u32 i = 0;
        while (i < w->dropLen) { nd[i] = w->drops[i]; i++; }
        if (w->drops != null) dealloc<WvDrop>(w->drops);
        w->drops = nd;
        w->dropCap = nc;
    }
    w->drops[w->dropLen] = WvDrop { .name = name, .slot = slot, .ty = ty, .mdef = mdef };
    w->dropLen++;
}

i32 wvDropFind(Wv* w, Str name)
{
    if (name == 0) return -1;
    i32 i = (i32)w->dropLen - 1;
    while (i >= 0)
    {
        if (w->drops[i].name == name) return i;
        i--;
    }
    return -1;
}

void wvDropRemoveAt(Wv* w, u32 idx)
{
    if (idx >= w->dropLen) return;
    u32 i = idx;
    while (i + 1 < w->dropLen)
    {
        w->drops[i] = w->drops[i + 1];
        i++;
    }
    w->dropLen--;
}

/* emit `owner_drop(&slot);` for one entry */
void wvEmitDropEntry(Wv* w, WvDrop* d)
{
    if (d == null || d->slot == null) return;
    bool nf = false;
    NodeId mdef = NodeId{ .index = 0 };
    IrFunc* f = wvMethodFnFor(w, d->ty, w->ctx->intern("drop"), NodeId{}, &nf, &mdef);
    if (f == null) return;
    u8 sk = wvMethodSelfKind(w, mdef);
    u32 n = sk != 0 ? 1 : 0;
    IrValue*[1] args;
    if (n != 0)
    {
        Ty u = wvUnwrapTy(w, d->ty);
        bool recvPtr = u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer;
        if (recvPtr)
        {
            IrType* st = wvSlotTy(d->slot->type);
            IrValue* pv = wvV(w->b.load(st, d->slot));
            if (pv == null) return;
            args[0] = pv;
        }
        else args[0] = d->slot;
    }
    w->b.call(&f->base, args, n);
}

/* walk the live set above `mark` innermost-first; `skip` leaves one
 * entry un-dropped (a moved-out local). `pop` truncates the stack after
 * the walk (scope end), otherwise the live set survives (branch exit). */
void wvDropsFrom(Wv* w, u32 mark, i32 skip, bool pop)
{
    i32 i = (i32)w->dropLen - 1;
    while (i >= (i32)mark)
    {
        if (i != skip) wvEmitDropEntry(w, &w->drops[i]);
        i--;
    }
    if (pop && w->dropLen > mark) w->dropLen = mark;
}

pub void wvDropsBranch(Wv* w, u32 mark, i32 skip)
{
    wvDropsFrom(w, mark, skip, false);
}

/* lower a VarDecl: alloca, optionally initialise (aggregates copy
 * element-wise from the source's address), register the local */
pub void wvVarDecl(Wv* w, Stmt* s, NodeId id)
{
    Str name = s->kind.payload.VarDecl.name;
    Ty vt = wvResolved(w, s->kind.payload.VarDecl.typeNode);
    if (vt == 0)
    {
        /* `var x = init` — infer from the init expr's resolved type */
        NodeId initId = s->kind.payload.VarDecl.init;
        if (initId.index != 0)
        {
            Node* in = wvNode(w, initId);
            if (in->kind.tag == NodeKind::Expr)
                vt = wvResolved(w, in->kind.payload.Expr.value.resolvedType);
        }
    }
    IrType* irt = vt != 0 ? wvTy(w, vt, 0) : null;
    if (irt == null || irt->kind == IrTypeKind::Void)
    {
        wvErr(w, id, "cannot local-bind a void value");
        return;
    }
    if ((s->kind.payload.VarDecl.flags & 4) != 0)
    {
        /* `static` keeps its storage across calls: a global registered
         * under this statement, pushed as a local so loads and stores
         * reach it; its initializer is constant, never run at entry */
        IrValue* gv = wvMakeGlobal(w, id, name, vt, s->kind.payload.VarDecl.init,
                                   (s->kind.payload.VarDecl.flags & 1) != 0, false,
                                   id.index);
        if (gv != null) wvPushLocal(w, name, gv, vt);
        return;
    }
    IrValue* slot = wvIsAgg(irt) ? wvAggSlot(w, irt) : wvV(w->b.alloca(irt));
    if (slot == null) return;
    if ((s->kind.payload.VarDecl.flags & 2) != 0) // hasInit
    {
        NodeId initId = s->kind.payload.VarDecl.init;
        if (wvIsAgg(irt))
        {
            /* aggregates never load into a register: copy element-wise */
            IrValue* src = wvAddrOf(w, initId);
            if (src != null) wvCopyAgg(w, slot, src, irt, 0);
        }
        else
        {
            IrValue* init = wvExpr(w, initId);
            if (init != null) w->b.store(init, slot);
        }
    }
    /* RAII move: `T x = y;` transfers y's ownership, so y must not
     * drop at scope exit (the C backend's cgPushDrop does the same) */
    if (s->kind.payload.VarDecl.dropMethod.index != 0)
    {
        NodeId initId = s->kind.payload.VarDecl.init;
        if (initId.index != 0)
        {
            Node* in = wvNode(w, initId);
            if (in->kind.tag == NodeKind::Expr &&
                in->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
            {
                i32 si = wvDropFind(w, in->kind.payload.Expr.value.kind.payload.Ident.name);
                if (si >= 0) wvDropRemoveAt(w, (u32)si);
            }
        }
        wvDropPush(w, name, slot, vt, s->kind.payload.VarDecl.dropMethod);
    }
    wvPushLocal(w, name, slot, vt);
}


/* `for x in iterable` and `for x in iter(start, end)` — an index loop
 * over a slice/array, or count()/at() calls over an @iter collection
 * (with range() when bounds are given). Mirrors the C backend's ForIn:
 * ranged bounds clamp to the collection, the receiver is the pointer
 * value or the iterable's own address, multi-binding reads tuple
 * fields, and the whole loop owns one scope. continue advances the
 * index, break leaves it. */
void wvForIn(Wv* w, Stmt* s, NodeId id)
{
    u32 scopeMark = w->locLen;
    u32 entryMark = w->dropLen;
    u32 entryDefers = w->deferLen;
    NodeId iterId = s->kind.payload.ForIn.iterExpr;
    NodeId rangeStart = s->kind.payload.ForIn.rangeStart;
    NodeId rangeEnd = s->kind.payload.ForIn.rangeEnd;
    bool ranged = rangeStart.index != 0;
    Str bindName = s->kind.payload.ForIn.bindName;
    Ty bindType = wvResolved(w, s->kind.payload.ForIn.bindType);
    u32 extraLen = s->kind.payload.ForIn.extraBindNamesLen;
    NodeId bodyId = s->kind.payload.ForIn.body;

    Node* in = wvNode(w, iterId);
    Ty iterTy = in->kind.tag == NodeKind::Expr
        ? wvResolved(w, in->kind.payload.Expr.value.resolvedType) : 0;
    TypeEntry* te = iterTy != 0 ? w->ctx->types + iterTy : null;
    bool indexed = te != null && (te->kind.tag == TypeKind::Slice ||
                                  te->kind.tag == TypeKind::Array);

    i32 ik = -1;
    if (in->kind.tag == NodeKind::Expr) ik = in->kind.payload.Expr.value.kind.tag;
    bool lshape = ik == ExprKind::Ident || ik == ExprKind::Field ||
                  ik == ExprKind::DerefField || ik == ExprKind::Index ||
                  ik == ExprKind::TupleField || ik == ExprKind::Deref;

    Ty ub = wvUnwrapTy(w, iterTy);
    bool iterIsPtr = ub != 0 && (w->ctx->types + ub)->kind.tag == TypeKind::Pointer;

    /* the iterable is read once, before the loop: an lvalue's own
     * storage, an rvalue materialized into a temp (an aggregate already
     * is its own address) */
    IrValue* stor = null;
    if (indexed || !iterIsPtr)
    {
        if (lshape) stor = wvAddrOf(w, iterId);
        else
        {
            IrValue* v = wvExpr(w, iterId);
            if (v == null) { w->locLen = scopeMark; return; }
            if (wvIsAgg(v->type)) stor = v;
            else
            {
                stor = wvV(w->b.alloca(v->type));
                if (stor == null) { w->locLen = scopeMark; return; }
                w->b.store(v, stor);
            }
        }
        if (stor == null)
            { wvErr(w, id, "for-in iterable has no storage"); w->locLen = scopeMark; return; }
    }
    IrValue* recv = null; // the @iter receiver (non-indexed loops only)
    if (!indexed)
    {
        if (iterIsPtr)
        {
            recv = wvExpr(w, iterId);
            if (recv == null) { w->locLen = scopeMark; return; }
        }
        else recv = stor;
    }

    IrType* cntTy = w->ir->tyInt(64);
    IrValue* iSlot = wvV(w->b.alloca(cntTy));
    if (iSlot == null) { w->locLen = scopeMark; return; }
    IrValue* endSlot = null;
    IrValue* rsV = null;
    IrValue* reV = null;
    IrFunc* countFn = null;
    IrFunc* atFn = null;
    NodeId mdefC = NodeId{ .index = 0 };
    NodeId mdefA = NodeId{ .index = 0 };

    if (ranged)
    {
        rsV = wvExpr(w, rangeStart);
        reV = wvExpr(w, rangeEnd);
        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
        Node* rsn = wvNode(w, rangeStart);
        Node* ren = wvNode(w, rangeEnd);
        Ty rst = rsn->kind.tag == NodeKind::Expr
            ? wvResolved(w, rsn->kind.payload.Expr.value.resolvedType) : 0;
        Ty ret = ren->kind.tag == NodeKind::Expr
            ? wvResolved(w, ren->kind.payload.Expr.value.resolvedType) : 0;
        rsV = wvCast(w, rsV, rsV->type, cntTy, wvTyUnsigned(w, rst), true);
        reV = wvCast(w, reV, reV->type, cntTy, wvTyUnsigned(w, ret), true);
        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
    }

    IrType* elemIr = null;
    Ty et = 0;
    if (indexed)
    {
        et = te->kind.tag == TypeKind::Slice
            ? te->kind.payload.Slice.base : te->kind.payload.Array.base;
        elemIr = wvTy(w, et, 0);
        if (elemIr == null)
            { wvErr(w, id, "for-in element type"); w->locLen = scopeMark; return; }
        if (ranged)
        {
            IrValue* lenV = null;
            if (te->kind.tag == TypeKind::Array)
                lenV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);
            else
            {
                IrValue* lSlot = wvGepField(w, stor, 1);
                if (lSlot != null) lenV = wvV(w->b.load(cntTy, lSlot));
            }
            if (lenV == null) { w->locLen = scopeMark; return; }
            /* clamp like C: rs = min(rs, len); re = min(re, len);
             * if (re < rs) re = rs — size_t bounds, unsigned compares */
            rsV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ugt, rsV, lenV)), lenV, rsV));
            reV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ugt, reV, lenV)), lenV, reV));
            reV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ult, reV, rsV)), rsV, reV));
            if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
            endSlot = wvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(rsV, iSlot);
            w->b.store(reV, endSlot);
        }
        else w->b.store(w->ir->constInt(cntTy, 0), iSlot);
    }
    else
    {
        /* @iter collections are consumed through count()/at(), plus
         * range() when bounds are given — both count and at must exist */
        bool nfC = false;
        bool nfA = false;
        bool nfR = false;
        NodeId mdefR = NodeId{ .index = 0 };
        countFn = wvMethodFnFor(w, iterTy, w->ctx->intern("count"), id, &nfC, &mdefC);
        atFn = wvMethodFnFor(w, iterTy, w->ctx->intern("at"), id, &nfA, &mdefA);
        IrFunc* rangeFn = null;
        if (ranged)
            rangeFn = wvMethodFnFor(w, iterTy, w->ctx->intern("range"), id, &nfR, &mdefR);
        if (nfC || nfA)
        {
            wvErr(w, id, "for-in over non-slice/array without @iter count()/at()");
            w->locLen = scopeMark;
            return;
        }
        if (ranged && nfR)
            { wvErr(w, id, "for-in range() not found"); w->locLen = scopeMark; return; }
        if (countFn == null || atFn == null) { w->locLen = scopeMark; return; }
        if (ranged && rangeFn == null) { w->locLen = scopeMark; return; }

        if (ranged)
        {
            u8 skR = wvMethodSelfKind(w, mdefR);
            IrValue*[3] rargs;
            u32 rn = 0;
            if (skR != 0) rargs[rn++] = recv;
            rargs[rn++] = rsV;
            rargs[rn++] = reV;
            IrValue* rObj = wvV(w->b.call(&rangeFn->base, rargs, rn));
            if (rObj == null || !wvIsAgg(rObj->type))
                { wvErr(w, id, "range() must return struct(usize, usize)"); w->locLen = scopeMark; return; }
            Ty rr = 0;
            Node* mrn = wvNode(w, mdefR);
            if (mrn->kind.tag == NodeKind::Decl &&
                mrn->kind.payload.Decl.value.kind.tag == DeclKind::Func)
                rr = wvResolved(w, mrn->kind.payload.Decl.value.kind.payload.Func.returnType);
            /* the bounds are the tuple `struct(usize, usize)`: elements 0/1 */
            Ty rb = wvUnwrapTy(w, rr);
            u32 si = 0xFFFFFFFF;
            u32 ei = 0xFFFFFFFF;
            u32 bGuard = 0;
            while (rb != 0 && bGuard < 8)
            {
                bGuard++;
                TypeEntry* be = w->ctx->types + rb;
                if (be->kind.tag == TypeKind::Tuple)
                {
                    if (be->kind.payload.Tuple.elemsLen == 2) { si = 0; ei = 1; }
                    break;
                }
                if (be->kind.tag == TypeKind::Named)
                {
                    NodeId td = wvFindTypeDecl(w, be->kind.payload.Named.name);
                    if (td.index == 0) break;
                    Node* dn = wvNode(w, td);
                    if (dn->kind.tag != NodeKind::Decl) break;
                    Decl* dd = &dn->kind.payload.Decl.value;
                    if (dd->kind.tag != DeclKind::TypeAlias) break;
                    rb = wvUnwrapTy(w, dd->kind.payload.TypeAlias.target);
                    continue;
                }
                break;
            }
            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)
            {
                si = wvFieldIdx(w, rr, w->ctx->intern("start"));
                ei = wvFieldIdx(w, rr, w->ctx->intern("end"));
            }
            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)
                { wvErr(w, id, "range() must return struct(usize, usize)"); w->locLen = scopeMark; return; }
            IrType* stT = rObj->type->params[si];
            IrType* etT = rObj->type->params[ei];
            IrValue* sSlot = wvGepField(w, rObj, si);
            IrValue* eSlot = wvGepField(w, rObj, ei);
            if (sSlot == null || eSlot == null) { w->locLen = scopeMark; return; }
            IrValue* sV = wvV(w->b.load(stT, sSlot));
            IrValue* eV = wvV(w->b.load(etT, eSlot));
            if (sV == null || eV == null) { w->locLen = scopeMark; return; }
            sV = wvCast(w, sV, stT, cntTy, wvTyUnsigned(w, rr), true);
            eV = wvCast(w, eV, etT, cntTy, wvTyUnsigned(w, rr), true);
            if (sV == null || eV == null) { w->locLen = scopeMark; return; }
            endSlot = wvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(sV, iSlot);
            w->b.store(eV, endSlot);
        }
        else
        {
            u8 skC = wvMethodSelfKind(w, mdefC);
            IrValue*[2] cargs;
            u32 cn = 0;
            if (skC != 0) cargs[cn++] = recv;
            IrValue* nV = wvV(w->b.call(&countFn->base, cargs, cn));
            if (nV == null) { w->locLen = scopeMark; return; }
            Ty crt = 0;
            Node* mcn = wvNode(w, mdefC);
            if (mcn->kind.tag == NodeKind::Decl &&
                mcn->kind.payload.Decl.value.kind.tag == DeclKind::Func)
                crt = wvResolved(w, mcn->kind.payload.Decl.value.kind.payload.Func.returnType);
            nV = wvCast(w, nV, nV->type, cntTy, wvTyUnsigned(w, crt), true);
            if (nV == null) { w->locLen = scopeMark; return; }
            endSlot = wvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(nV, endSlot);
            w->b.store(w->ir->constInt(cntTy, 0), iSlot);
        }
    }

    /* bind slots are allocated once, before the loop; each iteration
     * stores the element into them (multi-binding: one slot per name) */
    bool multi = extraLen > 0;
    u32 bindCount = 1 + extraLen;
    Ty* bindTypes = s->kind.payload.ForIn.bindTypes;
    u32 bindTypesLen = s->kind.payload.ForIn.bindTypesLen;
    if (multi && (bindTypes == null || bindTypesLen != bindCount))
    {
        wvErr(w, id, "for-in multi-binding requires a matching tuple element type");
        w->locLen = scopeMark;
        return;
    }
    IrValue** bindSlots = (IrValue**)wvArr(w, (usize)bindCount, 8);
    if (bindSlots == null) { w->locLen = scopeMark; return; }
    u32 b = 0;
    while (b < bindCount)
    {
        Ty bt = multi ? wvResolved(w, bindTypes[b]) : bindType;
        IrType* birt = bt != 0 ? wvTy(w, bt, 0) : null;
        if (birt == null || birt->kind == IrTypeKind::Void)
        {
            wvErr(w, id, "for-in bind has no type");
            w->locLen = scopeMark;
            return;
        }
        bindSlots[b] = wvIsAgg(birt) ? wvAggSlot(w, birt) : wvV(w->b.alloca(birt));
        if (bindSlots[b] == null) { w->locLen = scopeMark; return; }
        b++;
    }

    IrBlock* headBb = wvBlock(w, "forin.head");
    IrBlock* bodyBb = wvBlock(w, "forin.body");
    IrBlock* closeBb = wvBlock(w, "forin.close");
    IrBlock* postBb = wvBlock(w, "forin.post");
    IrBlock* exitBb = wvBlock(w, "forin.end");
    w->b.br(headBb);

    wvSetBlock(w, headBb);
    {
        IrValue* endV = null;
        if (endSlot != null) endV = wvV(w->b.load(cntTy, endSlot));
        else if (te->kind.tag == TypeKind::Slice)
        {
            IrValue* lSlot = wvGepField(w, stor, 1);
            if (lSlot != null) endV = wvV(w->b.load(cntTy, lSlot));
        }
        else endV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);
        IrValue* iv = wvV(w->b.load(cntTy, iSlot));
        if (endV == null || iv == null) { w->locLen = scopeMark; return; }
        IrValue* c = wvV(w->b.icmp(IrICmpPred::Ult, iv, endV));
        if (c == null) { w->locLen = scopeMark; return; }
        w->b.condBr(c, bodyBb, closeBb);
    }

    wvSetBlock(w, bodyBb);
    IrBlock* savedBreak = w->breakT;
    IrBlock* savedCont = w->contT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedContMark = w->contDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    u32 savedContDefers = w->contDeferMark;
    w->breakT = exitBb;
    w->contT = postBb;
    w->breakDropMark = entryMark;
    w->contDropMark = entryMark;
    w->breakDeferMark = entryDefers;
    w->contDeferMark = entryDefers;
    w->loopDepth++;
    {
        /* this iteration's element: an indexed address, or at(recv, i) */
        IrValue* eAddr = null;
        IrValue* atVal = null;
        if (indexed)
        {
            IrValue* iv = wvV(w->b.load(cntTy, iSlot));
            if (iv == null) { wvErr(w, id, "for-in index"); w->locLen = scopeMark; return; }
            if (te->kind.tag == TypeKind::Array)
                eAddr = wvIndexAddr(w, stor, elemIr, iv, true);
            else
            {
                IrValue* pSlot = wvGepField(w, stor, 0);
                if (pSlot == null) { w->locLen = scopeMark; return; }
                IrValue* p = wvV(w->b.load(w->ir->tyPtr(elemIr), pSlot));
                if (p == null) { w->locLen = scopeMark; return; }
                eAddr = wvIndexAddr(w, p, elemIr, iv, false);
            }
            if (eAddr == null) { wvErr(w, id, "for-in element address"); w->locLen = scopeMark; return; }
        }
        else
        {
            u8 skA = wvMethodSelfKind(w, mdefA);
            IrValue*[2] aargs;
            u32 an = 0;
            if (skA != 0) aargs[an++] = recv;
            IrValue* iv = wvV(w->b.load(cntTy, iSlot));
            if (iv == null) { wvErr(w, id, "for-in index"); w->locLen = scopeMark; return; }
            u32 ip = skA != 0 ? 1 : 0;
            if (ip < atFn->nparams && atFn->paramTypes[ip] != null &&
                atFn->paramTypes[ip]->kind == IrTypeKind::Int &&
                atFn->paramTypes[ip]->width != iv->type->width)
            {
                iv = wvCast(w, iv, iv->type, atFn->paramTypes[ip], false, true);
                if (iv == null) { w->locLen = scopeMark; return; }
            }
            aargs[an++] = iv;
            atVal = wvV(w->b.call(&atFn->base, aargs, an));
            if (atVal == null) { wvErr(w, id, "for-in at()"); w->locLen = scopeMark; return; }
        }

        /* store the element into the bind slots */
        b = 0;
        while (b < bindCount)
        {
            Ty bt = multi ? wvResolved(w, bindTypes[b]) : bindType;
            IrType* birt = wvTy(w, bt, 0);
            if (birt == null) { w->locLen = scopeMark; return; }
            if (multi)
            {
                IrValue* tupleAddr = indexed ? eAddr : atVal;
                if (tupleAddr == null) { w->locLen = scopeMark; return; }
                IrValue* fa = wvGepField(w, tupleAddr, b);
                if (fa == null) { w->locLen = scopeMark; return; }
                if (wvIsAgg(birt))
                {
                    if (!wvCopyAgg(w, bindSlots[b], fa, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else
                {
                    IrValue* fv = wvV(w->b.load(birt, fa));
                    if (fv == null) { w->locLen = scopeMark; return; }
                    w->b.store(fv, bindSlots[b]);
                }
            }
            else if (indexed)
            {
                if (wvIsAgg(birt))
                {
                    if (!wvCopyAgg(w, bindSlots[b], eAddr, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else
                {
                    IrValue* ev = wvV(w->b.load(birt, eAddr));
                    if (ev == null) { w->locLen = scopeMark; return; }
                    w->b.store(ev, bindSlots[b]);
                }
            }
            else
            {
                if (wvIsAgg(birt))
                {
                    if (!wvCopyAgg(w, bindSlots[b], atVal, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else w->b.store(atVal, bindSlots[b]);
            }
            b++;
        }

        b = 0;
        while (b < bindCount)
        {
            Str bn = b == 0 ? bindName : s->kind.payload.ForIn.extraBindNames[b - 1];
            wvPushLocal(w, bn, bindSlots[b], multi ? wvResolved(w, bindTypes[b]) : bindType);
            b++;
        }
        wvStmt(w, bodyId);
    }
    w->loopDepth--;
    w->breakT = savedBreak;
    w->contT = savedCont;
    w->breakDropMark = savedBreakMark;
    w->contDropMark = savedContMark;
    w->breakDeferMark = savedBreakDefers;
    w->contDeferMark = savedContDefers;
    if (!w->term) w->b.br(postBb);

    wvSetBlock(w, postBb);
    {
        IrValue* iv = wvV(w->b.load(cntTy, iSlot));
        if (iv == null) { w->locLen = scopeMark; return; }
        IrValue* nv = wvV(w->b.add(iv, w->ir->constInt(cntTy, 1)));
        if (nv == null) { w->locLen = scopeMark; return; }
        w->b.store(nv, iSlot);
        w->b.br(headBb);
    }

    wvSetBlock(w, closeBb);
    wvDefersFrom(w, entryDefers, true);
    wvDropsFrom(w, entryMark, -1, true);
    w->b.br(exitBb);
    wvSetBlock(w, exitBb);
    w->dropLen = entryMark;
    w->deferLen = entryDefers;
    w->locLen = scopeMark;
}


pub void wvStmt(Wv* w, NodeId id)
{
    if (id.index == 0) return;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Stmt)
    {
        wvErr(w, id, "expected statement node");
        return;
    }
    if (w->term) return; // dead code after a terminator
    Stmt* s = &n->kind.payload.Stmt.value;
    switch (s->kind.tag)
    {
        StmtKind::ExprStmt => { wvExpr(w, s->kind.payload.ExprStmt.expr); },
        StmtKind::VarDecl => { wvVarDecl(w, s, id); },
        StmtKind::Return => {
            NodeId vId = s->kind.payload.Return.value;
            IrValue* v = null;
            i32 skip = -1;
            if (vId.index != 0)
            {
                Node* rn = wvNode(w, vId);
                if (rn->kind.tag == NodeKind::Expr &&
                    rn->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                    skip = wvDropFind(w, rn->kind.payload.Expr.value.kind.payload.Ident.name);
                v = wvExpr(w, vId);
                if (v != null) {
                    wvDefersBranch(w, w->fnDeferMark);
                    wvDropsBranch(w, w->fnDropMark, skip);
                    w->b.ret(v);
                }
            }
            else
            {
                wvDefersBranch(w, w->fnDeferMark);
                wvDropsBranch(w, w->fnDropMark, -1);
                w->b.retVoid();
            }
            wvTerm(w);
        },
        StmtKind::Block => {
            /* block scope: locals declared inside vanish at the closing
             * brace (sema enforces the same rule — see T0001 on escape) */
            u32 scopeMark = w->locLen;
            u32 dropMark = w->dropLen;
            u32 deferMark = w->deferLen;
            u32 i = 0;
            while (i < s->kind.payload.Block.stmtsLen && !w->term)
            {
                wvStmt(w, s->kind.payload.Block.stmts[i]);
                i++;
            }
            /* a terminated block already unwound through return/break */
            if (!w->term)
            {
                wvDefersFrom(w, deferMark, true);
                wvDropsFrom(w, dropMark, -1, true);
            }
            else
            {
                if (w->deferLen > deferMark) w->deferLen = deferMark;
                if (w->dropLen > dropMark) w->dropLen = dropMark;
            }
            w->locLen = scopeMark;
        },
        StmtKind::Assign => {
            Str opS = s->kind.payload.Assign.op;
            if (opS == 0) return;
            str ops = wvStr(w, opS);
            wvAssignCommon(w, s->kind.payload.Assign.target,
                           s->kind.payload.Assign.value, ops, id);
        },
        StmtKind::If => {
            IrValue* c = wvCond(w, wvExpr(w, s->kind.payload.If.cond));
            if (c == null) return;
            IrBlock* thenBb = wvBlock(w, "if.then");
            NodeId elseId = s->kind.payload.If.elseBody;
            IrBlock* elseBb = elseId.index != 0 ? wvBlock(w, "if.else") : null;
            IrBlock* joinBb = wvBlock(w, "if.end");
            w->b.condBr(c, thenBb, elseBb != null ? elseBb : joinBb);

            wvSetBlock(w, thenBb);
            wvStmt(w, s->kind.payload.If.thenBody);
            if (!w->term) w->b.br(joinBb);

            if (elseBb != null)
            {
                wvSetBlock(w, elseBb);
                wvStmt(w, elseId);
                if (!w->term) w->b.br(joinBb);
            }
            wvSetBlock(w, joinBb);
        },
        StmtKind::While => {
            IrBlock* headBb = wvBlock(w, "while.head");
            IrBlock* bodyBb = wvBlock(w, "while.body");
            IrBlock* closeBb = wvBlock(w, "while.close");
            IrBlock* exitBb = wvBlock(w, "while.end");
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;
            w->b.br(headBb);
            wvSetBlock(w, headBb);
            IrValue* c = wvCond(w, wvExpr(w, s->kind.payload.While.cond));
            if (c == null) return;
            w->b.condBr(c, bodyBb, closeBb);

            wvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = entryMark;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = entryDefers;
            w->loopDepth++;
            wvStmt(w, s->kind.payload.While.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(headBb);
            wvSetBlock(w, closeBb);
            wvDefersFrom(w, entryDefers, true);
            wvDropsFrom(w, entryMark, -1, true);
            w->b.br(exitBb);
            wvSetBlock(w, exitBb);
        },
        StmtKind::Loop => {
            /* `loop { ... }` — unconditionally re-enter the head block
             * (an empty-trip body with no terminator: same shape as
             * while(true)) */
            IrBlock* headBb = wvBlock(w, "loop.head");
            IrBlock* bodyBb = wvBlock(w, "loop.body");
            IrBlock* exitBb = wvBlock(w, "loop.end");
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;
            w->b.br(headBb);
            wvSetBlock(w, headBb);
            w->b.br(bodyBb);

            wvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = entryMark;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = entryDefers;
            w->loopDepth++;
            wvStmt(w, s->kind.payload.Loop.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(headBb);
            wvSetBlock(w, exitBb);
        },
        StmtKind::For => {
            /* for (init; cond; post) — continue targets `post`, break
             * targets the exit block. The init's locals are scoped to
             * the whole loop (matching the C backend's for-scope). */
            NodeId initId = s->kind.payload.For.init;
            NodeId condId = s->kind.payload.For.cond;
            NodeId postId = s->kind.payload.For.post;
            bool hasPost = (s->kind.payload.For.flags & 4) != 0;
            u32 scopeMark = w->locLen;
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;

            if (initId.index != 0) wvStmt(w, initId);

            IrBlock* headBb = wvBlock(w, "for.head");
            IrBlock* bodyBb = wvBlock(w, "for.body");
            IrBlock* closeBb = wvBlock(w, "for.close");
            IrBlock* postBb = hasPost || postId.index != 0 ? wvBlock(w, "for.post") : null;
            IrBlock* exitBb = wvBlock(w, "for.end");
            w->b.br(headBb);

            wvSetBlock(w, headBb);
            if (condId.index != 0)
            {
                IrValue* c = wvCond(w, wvExpr(w, condId));
                if (c == null) { w->locLen = scopeMark; return; }
                w->b.condBr(c, bodyBb, closeBb);
            }
            else w->b.br(bodyBb); // no condition: run forever (break exits)

            wvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = postBb != null ? postBb : headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = w->dropLen;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = w->deferLen;
            w->loopDepth++;
            wvStmt(w, s->kind.payload.For.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(postBb != null ? postBb : headBb);

            if (postBb != null)
            {
                wvSetBlock(w, postBb);
                if (postId.index != 0) wvExpr(w, postId);
                if (!w->term) w->b.br(headBb);
            }
            wvSetBlock(w, closeBb);
            wvDefersFrom(w, entryDefers, true);
            wvDropsFrom(w, entryMark, -1, true);
            w->b.br(exitBb);
            wvSetBlock(w, exitBb);
            w->dropLen = entryMark;
            w->deferLen = entryDefers;
            w->locLen = scopeMark;
        },
        StmtKind::Asm => {
            /* gcc-style extended asm → one InlineAsm. Template pieces
             * join; output/input sections are constraint/operand pairs
             * that flatten to a comma-joined constraint list plus an
             * ops array (outputs first, then inputs). Outputs and
             * memory-class inputs go through wvAddrOf — the emitter
             * reads and writes them through that pointer, so every
             * read-back operand carries a Ptr(T) alloca. All buffers
             * are arena-backed; inlineAsm dupStr's what it keeps. */
            u32 tLen = s->kind.payload.Asm.templateLen;
            u32 outLen = s->kind.payload.Asm.outputsLen;
            u32 inLen = s->kind.payload.Asm.inputsLen;
            u32 clobLen = s->kind.payload.Asm.clobbersLen;
            if ((outLen & 1) != 0 || (inLen & 1) != 0)
            {
                wvErr(w, id, "asm operand constraint needs a value");
                return;
            }

            /* template: string-literal pieces, escapes decoded like any
             * other literal */
            usize tcap = 0;
            u32 i = 0;
            while (i < tLen)
            {
                Node* tn = wvNode(w, s->kind.payload.Asm.template[i]);
                if (tn->kind.tag != NodeKind::Expr ||
                    tn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { wvErr(w, id, "asm template pieces must be string literals"); return; }
                tcap += wvStr(w, tn->kind.payload.Expr.value.kind.payload.StringLit.value).len;
                i++;
            }
            u8* tbuf = (u8*)wvArr(w, tcap + 1, 1);
            if (tbuf == null) { wvErr(w, id, "asm template buffer"); return; }
            usize tlen = 0;
            i = 0;
            while (i < tLen)
            {
                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.template[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                tlen += wvDecodeLit(tok, b, e, tbuf + tlen);
                i++;
            }

            /* constraints: raw token capacity first (validate the nodes),
             * then decode outputs then inputs into one comma list */
            usize ccap = 0;
            i = 0;
            while (i < outLen)
            {
                Node* cn = wvNode(w, s->kind.payload.Asm.outputs[i]);
                if (cn->kind.tag != NodeKind::Expr ||
                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { wvErr(w, id, "asm operand constraint must be a string literal"); return; }
                ccap += wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i += 2;
            }
            i = 0;
            while (i < inLen)
            {
                Node* cn = wvNode(w, s->kind.payload.Asm.inputs[i]);
                if (cn->kind.tag != NodeKind::Expr ||
                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { wvErr(w, id, "asm operand constraint must be a string literal"); return; }
                ccap += wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i += 2;
            }
            u8* cbuf = (u8*)wvArr(w, ccap + 1, 1);
            if (cbuf == null) { wvErr(w, id, "asm constraint buffer"); return; }
            usize clen = 0;
            i = 0;
            while (i < outLen)
            {
                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.outputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (clen > 0) { cbuf[clen] = ','; clen++; }
                clen += wvDecodeLit(tok, b, e, cbuf + clen);
                i = i + 2;
            }
            i = 0;
            while (i < inLen)
            {
                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.inputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (clen > 0) { cbuf[clen] = ','; clen++; }
                clen += wvDecodeLit(tok, b, e, cbuf + clen);
                i = i + 2;
            }

            /* exactly one register-class output ⇒ value mode: the asm
             * produces the result directly (no address escape), so
             * mem2reg still promotes the local; the value is stored back
             * to the lvalue right after. Multiple register outputs or
             * all-memory outputs keep the pointer model. */
            u32 nOut = outLen / 2;
            u32 nIn = inLen / 2;
            u32 regOut = 0;
            u32 regOutIdx = 0;
            bool regInOut = false;
            i = 0;
            while (i < outLen)
            {
                str raw = wvStr(w, wvNode(w, s->kind.payload.Asm.outputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize qi = 0;
                bool isInOut = false;
                while (qi < raw.len)
                {
                    u8 c = raw.ptr[qi];
                    if (c == (u8)'+') isInOut = true;
                    if (c == (u8)'"' || c == (u8)'=' || c == (u8)'+' || c == (u8)'&') { qi++; continue; }
                    break;
                }
                u8 cls = qi < raw.len ? raw.ptr[qi] : (u8)'r';
                bool isTie = cls >= (u8)'0' && cls <= (u8)'9';
                if (!isTie && cls != (u8)'m' && cls != (u8)'i' && cls != (u8)'f')
                {
                    regOut++;
                    regOutIdx = i;
                    if (isInOut) regInOut = true;
                }
                i += 2;
            }
            IrType* retT = null;
            if (regOut == 1)
            {
                Node* en = wvNode(w, s->kind.payload.Asm.outputs[regOutIdx + 1]);
                if (en->kind.tag == NodeKind::Expr && en->kind.payload.Expr.value.resolvedType != 0)
                    retT = wvTy(w, wvResolved(w, en->kind.payload.Expr.value.resolvedType), 0);
            }
            bool valMode = regOut == 1 && retT != null;

            u32 nops = nOut + nIn;
            IrValue** ops = null;
            if (nops > 0)
            {
                ops = (IrValue**)wvArr(w, (usize)nops, 8);
                if (ops == null) { wvErr(w, id, "asm operand array"); return; }
            }
            u32 k = 0;
            i = 0;
            while (i < outLen)
            {
                if (valMode && i == regOutIdx)
                {
                    /* the single register output: value operand — inout
                     * carries the current value, pure output carries
                     * nothing (the result rides on the inst value) */
                    ops[k] = regInOut ? wvExpr(w, s->kind.payload.Asm.outputs[i + 1]) : null;
                }
                else
                {
                    ops[k] = wvAddrOf(w, s->kind.payload.Asm.outputs[i + 1]);
                    if (ops[k] == null) return;
                }
                k++;
                i += 2;
            }
            i = 0;
            while (i < inLen)
            {
                Node* cn = wvNode(w, s->kind.payload.Asm.inputs[i]);
                str ctok = wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value);
                bool isMem = false;
                usize qi = 0;
                while (qi < ctok.len) { if (ctok.ptr[qi] == (u8)'m') isMem = true; qi++; }
                NodeId vid = s->kind.payload.Asm.inputs[i + 1];
                if (isMem) ops[k] = wvAddrOf(w, vid);
                else ops[k] = wvExpr(w, vid);
                if (ops[k] == null) return;
                k++;
                i += 2;
            }

            /* clobbers: bare string literals, comma-joined */
            usize kcap = 0;
            i = 0;
            while (i < clobLen)
            {
                Node* kn = wvNode(w, s->kind.payload.Asm.clobbers[i]);
                if (kn->kind.tag != NodeKind::Expr ||
                    kn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { wvErr(w, id, "asm clobber must be a string literal"); return; }
                kcap += wvStr(w, kn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i++;
            }
            u8* kbuf = (u8*)wvArr(w, kcap + 1, 1);
            if (kbuf == null) { wvErr(w, id, "asm clobber buffer"); return; }
            usize klen = 0;
            i = 0;
            while (i < clobLen)
            {
                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.clobbers[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (klen > 0) { kbuf[klen] = ','; klen++; }
                klen += wvDecodeLit(tok, b, e, kbuf + klen);
                i++;
            }

            IrInst* asmInst = w->b.inlineAsm(str::fromParts(tbuf, tlen),
                           str::fromParts(cbuf, clen),
                           str::fromParts(kbuf, klen),
                           (s->kind.payload.Asm.flags & 1) != 0,
                           ops, nops, retT);
            if (valMode && asmInst != null)
            {
                /* write the register result back to the local — mem2reg
                 * removes the pair whenever the local stays promotable */
                IrValue* res = wvV(asmInst);
                IrValue* dst = wvAddrOf(w, s->kind.payload.Asm.outputs[regOutIdx + 1]);
                if (res != null && dst != null) w->b.store(res, dst);
            }
        },
        StmtKind::Switch => { wvSwitch(w, s, id); },
        StmtKind::ForIn => { wvForIn(w, s, id); },
        StmtKind::Defer => {
            wvDeferPush(w, s->kind.payload.Defer.stmt);
        },
        StmtKind::Comptime => {
            /* comptime blocks are evaluated by mono's CtEval, which
             * replaces instantiated bodies with their surviving runtime
             * statements. One reaching here was never evaluated — the
             * concrete decl of an instantiated helper, or a static only
             * called from comptime. Mirror the C backend: emit nothing —
             * walking it would try to lower comptime-only constructs
             * (pack iteration, type switches) with no runtime form. */
        },
        StmtKind::Break => {
            if (w->breakT == null) { wvErr(w, id, "break outside a loop"); return; }
            wvDefersBranch(w, w->breakDeferMark);
            wvDropsBranch(w, w->breakDropMark, -1);
            w->b.br(w->breakT);
            wvTerm(w);
        },
        StmtKind::Continue => {
            if (w->contT == null) { wvErr(w, id, "continue outside a loop"); return; }
            wvDefersBranch(w, w->contDeferMark);
            wvDropsBranch(w, w->contDropMark, -1);
            w->b.br(w->contT);
            wvTerm(w);
        },
        else => {
            wvErr(w, id, "unsupported statement (Phase 1)");
        },
    }
}
