#[[no_drop_all]]
/* coral-ir/stmt.crl — statement lowering
 *
 * Return, Block (with scope popping), VarDecl (aggregate-aware init),
 * ExprStmt, If, While, Loop, For, Assign (plain + compound via
 * muvAssignCommon), Break/Continue. Blocks lower straight into the
 * current function via the builder; the `term` flag tracks terminators
 * so dead statements after Return/Break/Continue are skipped. No phis —
 * locals are alloca+load/store. */
use lower { Muv, MuvDrop, muvNode, muvErr, muvStr, muvResolved, muvFindLocal, muvPushLocal,
               muvBlock, muvSetBlock, muvTerm, muvPos, muvArr, muvSlotTy };
use types { muvTy, muvFindTypeDecl };
use expr { muvExpr, muvAddrOf, muvCond, muvAssignCommon, muvIsAgg, muvCopyAgg, muvAggSlot,
               muvDecodeLit, muvCompareVals, muvResolveConst, muvMakeGlobal, muvValBody,
               muvMethodFnFor, muvCast, muvUnwrapTy, muvTyUnsigned, muvIndexAddr,
               muvGepField, muvFieldIdx };
use decl { muvMethodSelfKind };
use context::context { AstContext };
use sem { scope { Symbol, ScopeStack } };
use ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind, SwitchCase },
    decl { Decl, DeclKind, Param },
    pat { Pat, PatKind }
};
use common::slice { Slice };
import muvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrBlock };
import muvm::irOps { IrICmpPred };
import muvm::irBuilder { IrBuilder };
import std::mman { alloc, dealloc };

pub IrValue* muvV(IrInst* inst) { return inst != null ? &inst->base : null; }

pub void muvStmt(Muv* w, NodeId id);

/* one pattern's test against an already-evaluated scrutinee: an i1
 * value, or null with *isWildcard set when the pattern matches every
 * value. Mirrors the C backend's cgPatTest; the arm's patterns are OR'd
 * by muvSwitchTest. */
pub IrValue* muvPatTest(Muv* w, NodeId patId, IrValue* scrut, Ty scrutTy,
                        bool* isWildcard, NodeId id)
{
    *isWildcard = false;
    if (patId.index == 0) { *isWildcard = true; return null; }
    Node* n = muvNode(w, patId);
    if (n->kind.tag == NodeKind::Pat)
    {
        Pat* p = &n->kind.payload.Pat.value;
        switch (p->kind.tag)
        {
            PatKind::Wildcard => { *isWildcard = true; return null; },
            PatKind::Lit => {
                IrValue* lit = muvExpr(w, p->kind.payload.Lit.expr);
                if (lit == null) return null;
                return muvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
            },
            PatKind::Ident => {
                /* a bare name in a value switch is a file-scope constant
                 * (`switch (sig) { SIGSEGV_ => … }`), not a binding */
                NodeId cd = muvResolveConst(w, p->kind.payload.Ident.name, patId);
                if (cd.index == 0)
                    { muvErr(w, patId, "pattern names an unknown constant"); return null; }
                NodeId init = muvNode(w, cd)->kind.payload.Decl.value->kind.payload.Constant.value;
                IrValue* lit = muvExpr(w, init);
                if (lit == null) return null;
                return muvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
            },
            PatKind::Or => {
                IrValue* acc = null;
                u32 i = 0;
                while (i < p->kind.payload.Or.alternativesLen)
                {
                    bool wild = false;
                    IrValue* t = muvPatTest(w, p->kind.payload.Or.alternatives[i],
                                           scrut, scrutTy, &wild, id);
                    if (wild) { *isWildcard = true; return null; }
                    if (t == null) return null;
                    acc = acc == null ? t : muvV(w->b.orOp(acc, t));
                    if (acc == null) return null;
                    i++;
                }
                if (acc == null) { *isWildcard = true; return null; }
                return acc;
            },
            PatKind::Range => {
                IrValue* lo = muvExpr(w, p->kind.payload.Range.start);
                IrValue* hi = muvExpr(w, p->kind.payload.Range.end);
                if (lo == null || hi == null) return null;
                bool incl = (p->kind.payload.Range.flags & 1) != 0;
                IrValue* a = muvCompareVals(w, ExprKind::Ge, scrut, lo, id, scrutTy);
                IrValue* b = muvCompareVals(w, incl ? ExprKind::Le : ExprKind::Lt,
                                           scrut, hi, id, scrutTy);
                if (a == null || b == null) return null;
                return muvV(w->b.andOp(a, b));
            },
            PatKind::Guard => {
                /* pattern-level guard: test && cond; a wildcard inner
                 * pattern leaves the guard as the whole test */
                bool wild = false;
                IrValue* t = muvPatTest(w, p->kind.payload.Guard.pattern,
                                       scrut, scrutTy, &wild, id);
                IrValue* g = muvCond(w, muvExpr(w, p->kind.payload.Guard.cond));
                if (g == null) return null;
                if (wild) return g;
                if (t == null) return null;
                return muvV(w->b.andOp(t, g));
            },
            else => { muvErr(w, patId, "pattern kind unsupported (Phase 3)"); return null; },
        }
    }
    if (n->kind.tag == NodeKind::Expr)
    {
        /* bare expression pattern (a literal or constant reference) */
        IrValue* lit = muvExpr(w, patId);
        if (lit == null) return null;
        return muvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);
    }
    muvErr(w, patId, "unsupported pattern");
    return null;
}

/* the arm's test: every pattern OR'd together; a wildcard anywhere in
 * the arm matches all values */
pub IrValue* muvSwitchTest(Muv* w, SwitchCase* c, IrValue* scrut, Ty scrutTy,
                           bool* isWildcard, NodeId id)
{
    *isWildcard = false;
    IrValue* acc = null;
    u32 p = 0;
    while (p < c->patternsLen)
    {
        bool wild = false;
        IrValue* t = muvPatTest(w, c->patterns[p], scrut, scrutTy, &wild, id);
        if (wild) { *isWildcard = true; return null; }
        if (t == null) return null;
        acc = acc == null ? t : muvV(w->b.orOp(acc, t));
        if (acc == null) return null;
        p++;
    }
    if (acc == null) { *isWildcard = true; return null; }
    return acc;
}

/* ── switch fast path: one muvm Switch terminator ───────────── */

/* collect the constant values one pattern matches into vals (bounded
 * by cap); *wild set when the pattern matches every value. false →
 * the pattern isn't switch-able (range/guard/aggregate) and the whole
 * switch falls back to the compare chain. Only ConstInt patterns whose
 * IrType is exactly the scrutinee's qualify — mixed-width cases stay
 * on the chain, which promotes them correctly. */
bool muvSwitchPatVals(Muv* w, NodeId patId, IrType* sty,
                      IrValue** vals, u32* nvals, u32 cap, bool* wild)
{
    if (patId.index == 0) { *wild = true; return true; }
    Node* n = muvNode(w, patId);
    if (n->kind.tag == NodeKind::Pat)
    {
        Pat* p = &n->kind.payload.Pat.value;
        if (p->kind.tag == PatKind::Wildcard) { *wild = true; return true; }
        if (p->kind.tag == PatKind::Lit || p->kind.tag == PatKind::Ident ||
            p->kind.tag == PatKind::Or)
        {
            NodeId ev;
            ev.index = 0;
            if (p->kind.tag == PatKind::Lit) ev = p->kind.payload.Lit.expr;
            else if (p->kind.tag == PatKind::Ident)
            {
                NodeId cd = muvResolveConst(w, p->kind.payload.Ident.name, patId);
                if (cd.index == 0) return false;
                Node* cn = muvNode(w, cd);
                if (cn->kind.tag != NodeKind::Decl) return false;
                ev = cn->kind.payload.Decl.value->kind.payload.Constant.value;
            }
            else
            {
                u32 i = 0;
                while (i < p->kind.payload.Or.alternativesLen)
                {
                    if (!muvSwitchPatVals(w, p->kind.payload.Or.alternatives[i],
                                          sty, vals, nvals, cap, wild))
                        return false;
                    i++;
                }
                return true;
            }
            IrValue* v = muvExpr(w, ev);
            if (v == null || v->kind != IrValueKind::ConstInt || v->type != sty)
                return false;
            if (*nvals >= cap) return false;
            vals[(*nvals)++] = v;
            return true;
        }
        return false;
    }
    if (n->kind.tag == NodeKind::Expr)
    {
        IrValue* v = muvExpr(w, patId);
        if (v == null || v->kind != IrValueKind::ConstInt || v->type != sty)
            return false;
        if (*nvals >= cap) return false;
        vals[(*nvals)++] = v;
        return true;
    }
    return false;
}

/* lower the whole switch to a single Switch terminator when every live
 * arm is integer-constant patterns (or one catch-all) with no guards —
 * the shape the chain lowering would produce anyway, but as real
 * switch IR the backend can turn into a jump table. Returns false to
 * keep the compare-chain path. */
bool muvSwitchFast(Muv* w, IrValue* scrut, SwitchCase* cases, u32 n,
                   NodeId id, IrValue* slot, IrType* vt)
{
    IrType* sty = scrut != null ? scrut->type : null;
    if (sty == null || sty->kind != IrTypeKind::Int) return false;

    u32 cap = n * 8 + 16;
    IrValue** vals = (IrValue**)muvArr(w, (usize)cap, 8);
    u32* valArm = (u32*)muvArr(w, (usize)cap, 4);
    u8* armKind = (u8*)muvArr(w, (usize)n, 1);  // 0 dead, 1 const, 2 wild, 3 else
    IrBlock** armBb = (IrBlock**)muvArr(w, (usize)n, 8);
    if (vals == null || valArm == null || armKind == null || armBb == null)
        return false;

    u32 nvals = 0;
    u32 elseIdx = 0xFFFFFFFF;
    u32 defaultArm = 0xFFFFFFFF;
    bool bail = false;
    u32 i = 0;
    while (i < n && !bail)
    {
        SwitchCase* c = cases + i;
        armKind[i] = 0;
        armBb[i] = null;
        if ((c->flags & 4) != 0 || c->patternsLen == 0)
        {
            /* the else arm is the chain's terminal fallback — first one
             * wins, later else-flagged arms are dead in both paths */
            if (elseIdx == 0xFFFFFFFF) { elseIdx = i; armKind[i] = 3; }
            i++;
            continue;
        }
        if (defaultArm != 0xFFFFFFFF) { i++; continue; } // past the catch-all: dead
        if ((c->flags & 1) != 0 && c->guard.index != 0) { bail = true; break; }
        u32 armStart = nvals;
        bool wild = false;
        u32 p = 0;
        while (p < c->patternsLen)
        {
            if (!muvSwitchPatVals(w, c->patterns[p], sty, vals, &nvals, cap, &wild))
                { bail = true; break; }
            p++;
        }
        if (bail) break;
        if (wild)
        {
            nvals = armStart;
            defaultArm = i;
            armKind[i] = 2;
        }
        else
        {
            u32 k = armStart;
            while (k < nvals) { valArm[k] = i; k++; }
            armKind[i] = nvals > armStart ? 1 : 0;
        }
        i++;
    }
    if (bail) return false;

    /* first occurrence wins on duplicate values — the chain tests arms
     * in order, so a later arm's duplicate is unreachable */
    u32 m = 0;
    u32 k = 0;
    while (k < nvals)
    {
        bool dup = false;
        u32 j = 0;
        while (j < m)
        {
            if (vals[j] == vals[k]) { dup = true; break; }
            j++;
        }
        if (!dup) { vals[m] = vals[k]; valArm[m] = valArm[k]; m++; }
        k++;
    }

    IrBlock* joinBb = muvBlock(w, "sw.end");
    /* default target: the catch-all arm's body, else the else arm's,
     * else the join (no match falls through) */
    u32 dfltArm = defaultArm != 0xFFFFFFFF ? defaultArm
                 : (elseIdx != 0xFFFFFFFF ? elseIdx : 0xFFFFFFFF);
    IrBlock** cblks = (IrBlock**)muvArr(w, (usize)(m > 0 ? m : 1), 8);
    if (cblks == null) return false;
    i = 0;
    while (i < n)
    {
        if (armKind[i] == 1 || i == dfltArm) armBb[i] = muvBlock(w, "sw.body");
        i++;
    }
    k = 0;
    while (k < m) { cblks[k] = armBb[valArm[k]]; k++; }
    IrBlock* dfltBb = dfltArm != 0xFFFFFFFF ? armBb[dfltArm] : joinBb;

    w->b.switchInst(scrut, dfltBb, vals, cblks, m);

    IrBlock* savedBreak = w->breakT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    w->breakT = joinBb;
    w->breakDropMark = w->dropLen;
    w->breakDeferMark = w->deferLen;
    w->loopDepth++;

    i = 0;
    while (i < n)
    {
        if (armBb[i] == null) { i++; continue; }
        muvSetBlock(w, armBb[i]);
        if (slot != null)
        {
            IrValue* v = muvValBody(w, cases[i].body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else muvStmt(w, cases[i].body);
        if (!w->term) w->b.br(joinBb);
        i++;
    }

    w->breakT = savedBreak;
    w->breakDropMark = savedBreakMark;
    w->breakDeferMark = savedBreakDefers;
    w->loopDepth--;
    muvSetBlock(w, joinBb);
    return true;
}

/* hybrid lowering for mixed switches: the leading run of arms whose
 * patterns are all integer constants (no guards, no catch-alls) lowers
 * to a native Switch terminator; its default edge enters a block that
 * recursively lowers the remaining arms — which may themselves be all
 * constant (another Switch), guarded, or reach the plain chain. Arm
 * order is preserved because a guarded/binding arm can match any
 * value, so only the prefix is safe to dispatch on the scrutinee. */
bool muvSwitchHybrid(Muv* w, IrValue* scrut, Ty scrutTy,
                     SwitchCase* cases, u32 n, NodeId id,
                     IrValue* slot, IrType* vt)
{
    IrType* sty = scrut != null ? scrut->type : null;
    if (sty == null || sty->kind != IrTypeKind::Int) return false;

    u32 cap = n * 8 + 16;
    IrValue** vals = (IrValue**)muvArr(w, (usize)cap, 8);
    u32* valArm = (u32*)muvArr(w, (usize)cap, 4);
    u8* armKind = (u8*)muvArr(w, (usize)n, 1);
    IrBlock** armBb = (IrBlock**)muvArr(w, (usize)n, 8);
    if (vals == null || valArm == null || armKind == null || armBb == null)
        return false;

    /* collect the switchable prefix; stop at the first arm that needs
     * the chain (guard, wildcard/binding, range, non-constant) or at
     * the else arm — both hand off to the suffix lowering */
    u32 nvals = 0;
    u32 prefixN = 0;
    bool bail = false;
    while (prefixN < n && !bail)
    {
        SwitchCase* c = cases + prefixN;
        if ((c->flags & 4) != 0 || c->patternsLen == 0 ||
            ((c->flags & 1) != 0 && c->guard.index != 0))
            break;
        u32 armStart = nvals;
        bool wild = false;
        u32 p = 0;
        while (p < c->patternsLen)
        {
            if (!muvSwitchPatVals(w, c->patterns[p], sty, vals, &nvals, cap, &wild))
                { bail = true; break; }
            p++;
        }
        if (bail || wild) { nvals = armStart; break; }
        u32 k = armStart;
        while (k < nvals) { valArm[k] = prefixN; k++; }
        armKind[prefixN] = nvals > armStart ? 1 : 0;
        prefixN++;
    }
    if (bail || prefixN == 0 || prefixN >= n) return false;

    /* dedup case values — first arm wins, same as the chain's order */
    u32 m = 0;
    u32 k = 0;
    while (k < nvals)
    {
        bool dup = false;
        u32 j = 0;
        while (j < m)
        {
            if (vals[j] == vals[k]) { dup = true; break; }
            j++;
        }
        if (!dup) { vals[m] = vals[k]; valArm[m] = valArm[k]; m++; }
        k++;
    }

    IrBlock* joinBb = muvBlock(w, "sw.end");
    IrBlock* chainBb = muvBlock(w, "sw.chain");
    IrBlock** cblks = (IrBlock**)muvArr(w, (usize)(m > 0 ? m : 1), 8);
    if (cblks == null) return false;
    u32 i = 0;
    while (i < prefixN)
    {
        if (armKind[i] == 1) armBb[i] = muvBlock(w, "sw.body");
        i++;
    }
    k = 0;
    while (k < m) { cblks[k] = armBb[valArm[k]]; k++; }

    w->b.switchInst(scrut, chainBb, vals, cblks, m);

    IrBlock* savedBreak = w->breakT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    w->breakT = joinBb;
    w->breakDropMark = w->dropLen;
    w->breakDeferMark = w->deferLen;
    w->loopDepth++;

    i = 0;
    while (i < prefixN)
    {
        if (armBb[i] == null) { i++; continue; }
        muvSetBlock(w, armBb[i]);
        if (slot != null)
        {
            IrValue* v = muvValBody(w, cases[i].body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else muvStmt(w, cases[i].body);
        if (!w->term) w->b.br(joinBb);
        i++;
    }

    w->breakT = savedBreak;
    w->breakDropMark = savedBreakMark;
    w->breakDeferMark = savedBreakDefers;
    w->loopDepth--;

    /* default edge: lower the remaining arms recursively — the suffix
     * may itself split into another Switch plus chain */
    muvSetBlock(w, chainBb);
    muvSwitchCoreVal(w, scrut, scrutTy, cases + prefixN, n - prefixN,
                     id, slot, vt);
    if (!w->term) w->b.br(joinBb);
    muvSetBlock(w, joinBb);
    return true;
}

/* value switch as a compare chain in blocks (no phis). Each arm owns a
 * test block and a body block; a failed test or a failed guard branches
 * to the next arm's test block, then to the else arm, then to the join.
 * The else arm runs only when nothing matched, wherever it sits in the
 * source — the same shape cgEmitSwitchChain prints as if/else-if.
 * slot/vt are null for the statement form; a switch-expr passes its
 * result slot and every arm's body value is stored into it. */
/* everything after the scrutinee is evaluated: fast switch, hybrid
 * prefix+chain, or the full compare chain. Takes the already-lowered
 * scrutinee so the hybrid path can recurse on a suffix without
 * re-evaluating it (which would duplicate side effects). */
pub void muvSwitchCoreVal(Muv* w, IrValue* scrut, Ty scrutTy,
                        SwitchCase* cases, u32 n, NodeId id,
                        IrValue* slot, IrType* vt)
{
    /* constant-only switches lower to a real Switch terminator; anything
     * richer (ranges, guards, or-patterns over non-constants, floats)
     * stays on the compare chain */
    if (muvSwitchFast(w, scrut, cases, n, id, slot, vt)) return;
    if (muvSwitchHybrid(w, scrut, scrutTy, cases, n, id, slot, vt)) return;

    IrBlock** tbb = (IrBlock**)muvArr(w, (usize)n, 8);
    IrBlock** bbb = (IrBlock**)muvArr(w, (usize)n, 8);
    IrBlock** gbb = (IrBlock**)muvArr(w, (usize)n, 8);
    IrBlock** fbb = (IrBlock**)muvArr(w, (usize)n, 8);
    if (tbb == null || bbb == null || gbb == null || fbb == null)
        { muvErr(w, id, "switch: out of memory"); return; }

    u32 elseIdx = 0xFFFFFFFF;
    u32 i = 0;
    while (i < n)
    {
        tbb[i] = null;
        bbb[i] = null;
        gbb[i] = null;
        fbb[i] = null;
        SwitchCase* c = cases + i;
        if ((c->flags & 4) != 0 || c->patternsLen == 0)
        {
            if (elseIdx == 0xFFFFFFFF) elseIdx = i;
        }
        else
        {
            tbb[i] = muvBlock(w, "sw.test");
            bbb[i] = muvBlock(w, "sw.body");
            if ((c->flags & 1) != 0 && c->guard.index != 0)
                gbb[i] = muvBlock(w, "sw.guard");
        }
        i++;
    }
    IrBlock* joinBb = muvBlock(w, "sw.end");
    IrBlock* elseBb = elseIdx != 0xFFFFFFFF ? muvBlock(w, "sw.else") : null;

    /* fail targets, walked backwards so each arm knows where a failed
     * test or guard lands: the next arm's test, else, then join */
    IrBlock* nextTest = null;
    i = n;
    while (i > 0)
    {
        i--;
        if (i == elseIdx || tbb[i] == null) continue;
        fbb[i] = nextTest != null ? nextTest
                 : (elseBb != null ? elseBb : joinBb);
        nextTest = tbb[i];
    }
    IrBlock* entry = nextTest != null ? nextTest
                     : (elseBb != null ? elseBb : joinBb);
    w->b.br(entry);

    IrBlock* savedBreak = w->breakT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    w->breakT = joinBb;
    w->breakDropMark = w->dropLen;
    w->breakDeferMark = w->deferLen;
    w->loopDepth++;

    i = 0;
    while (i < n)
    {
        if (i == elseIdx || tbb[i] == null) { i++; continue; }
        SwitchCase* c = cases + i;
        IrBlock* fail = fbb[i];

        muvSetBlock(w, tbb[i]);
        bool wild = false;
        IrValue* test = muvSwitchTest(w, c, scrut, scrutTy, &wild, id);
        if (!wild && test == null) break;
        IrBlock* hit = gbb[i] != null ? gbb[i] : bbb[i];
        if (wild) w->b.br(hit);
        else w->b.condBr(test, hit, fail);

        if (gbb[i] != null)
        {
            muvSetBlock(w, gbb[i]);
            IrValue* g = muvCond(w, muvExpr(w, c->guard));
            if (g == null) break;
            w->b.condBr(g, bbb[i], fail);
        }

        muvSetBlock(w, bbb[i]);
        if (slot != null)
        {
            IrValue* v = muvValBody(w, c->body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else muvStmt(w, c->body);
        if (!w->term) w->b.br(joinBb);
        i++;
    }

    if (elseBb != null && elseIdx < n)
    {
        muvSetBlock(w, elseBb);
        if (slot != null)
        {
            IrValue* v = muvValBody(w, cases[elseIdx].body, vt);
            if (v != null) w->b.store(v, slot);
        }
        else muvStmt(w, cases[elseIdx].body);
        if (!w->term) w->b.br(joinBb);
    }

    w->breakT = savedBreak;
    w->breakDropMark = savedBreakMark;
    w->breakDeferMark = savedBreakDefers;
    w->loopDepth--;
    muvSetBlock(w, joinBb);
}

pub void muvSwitchCore(Muv* w, NodeId scrutId, SwitchCase* cases, u32 n,
                      NodeId id, IrValue* slot, IrType* vt)
{
    if (scrutId.index == 0) { muvErr(w, id, "switch without a scrutinee"); return; }
    Node* sn = muvNode(w, scrutId);
    if (sn->kind.tag != NodeKind::Expr) { muvErr(w, id, "switch scrutinee"); return; }
    IrValue* scrut = muvExpr(w, scrutId);
    if (scrut == null) return;
    Ty scrutTy = muvResolved(w, sn->kind.payload.Expr.value.resolvedType);

    if (cases == null || n == 0) { muvErr(w, id, "switch without cases"); return; }
    muvSwitchCoreVal(w, scrut, scrutTy, cases, n, id, slot, vt);
}

/* the statement form: no result slot, every arm lowers as statements */
pub void muvSwitch(Muv* w, Stmt* s, NodeId id)
{
    muvSwitchCore(w, s->kind.payload.Switch.expr, s->kind.payload.Switch.cases,
                 s->kind.payload.Switch.casesLen, id, null, null);
}



/* ── defer stack ────────────────────────────────────────────── */

void muvDeferPush(Muv* w, NodeId stmt)
{
    if (w->deferLen >= w->deferCap)
    {
        u32 nc = w->deferCap == 0 ? 8 : w->deferCap * 2;
        NodeId* nd = alloc<NodeId>((usize)nc);
        if (nd == null) { muvErr(w, stmt, "out of memory in defer table"); return; }
        u32 i = 0;
        while (i < w->deferLen) { nd[i] = w->defers[i]; i++; }
        if (w->defers != null) dealloc<NodeId>(w->defers);
        w->defers = nd;
        w->deferCap = nc;
    }
    w->defers[w->deferLen] = stmt;
    w->deferLen++;
}

/* run deferred statements above `mark` LIFO; scope end also pops */
void muvDefersFrom(Muv* w, u32 mark, bool pop)
{
    u32 i = w->deferLen;
    while (i > mark)
    {
        i--;
        muvStmt(w, w->defers[i]);
    }
    if (pop && w->deferLen > mark) w->deferLen = mark;
}

pub void muvDefersBranch(Muv* w, u32 mark)
{
    muvDefersFrom(w, mark, false);
}

/* ── RAII drop stack ────────────────────────────────────────── */

void muvDropPush(Muv* w, Str name, IrValue* slot, Ty ty, NodeId mdef)
{
    if (w->dropLen >= w->dropCap)
    {
        u32 nc = w->dropCap == 0 ? 8 : w->dropCap * 2;
        MuvDrop* nd = alloc<MuvDrop>((usize)nc);
        if (nd == null) { muvErr(w, NodeId{}, "out of memory in drop table"); return; }
        u32 i = 0;
        while (i < w->dropLen) { nd[i] = w->drops[i]; i++; }
        if (w->drops != null) dealloc<MuvDrop>(w->drops);
        w->drops = nd;
        w->dropCap = nc;
    }
    w->drops[w->dropLen] = MuvDrop { .name = name, .slot = slot, .ty = ty, .mdef = mdef };
    w->dropLen++;
}

i32 muvDropFind(Muv* w, Str name)
{
    if (name == 0) return -1;
    i32 i = (i32)w->dropLen - 1;
    while (i >= 0)
    {
        if (w->drops[i].name == name) return i;
        i--;
    }
    return -1;
}

void muvDropRemoveAt(Muv* w, u32 idx)
{
    if (idx >= w->dropLen) return;
    u32 i = idx;
    while (i + 1 < w->dropLen)
    {
        w->drops[i] = w->drops[i + 1];
        i++;
    }
    w->dropLen--;
}

/* emit `owner_drop(&slot);` for one entry */
void muvEmitDropEntry(Muv* w, MuvDrop* d)
{
    if (d == null || d->slot == null) return;
    bool nf = false;
    NodeId mdef = NodeId{ .index = 0 };
    IrFunc* f = muvMethodFnFor(w, d->ty, w->ctx->intern("drop"), NodeId{}, &nf, &mdef);
    if (f == null) return;
    u8 sk = muvMethodSelfKind(w, mdef);
    u32 n = sk != 0 ? 1 : 0;
    IrValue*[1] args;
    if (n != 0)
    {
        Ty u = muvUnwrapTy(w, d->ty);
        bool recvPtr = u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer;
        if (recvPtr)
        {
            IrType* st = muvSlotTy(d->slot->type);
            IrValue* pv = muvV(w->b.load(st, d->slot));
            if (pv == null) return;
            args[0] = pv;
        }
        else args[0] = d->slot;
    }
    w->b.call(&f->base, args, n);
}

/* walk the live set above `mark` innermost-first; `skip` leaves one
 * entry un-dropped (a moved-out local). `pop` truncates the stack after
 * the walk (scope end), otherwise the live set survives (branch exit). */
void muvDropsFrom(Muv* w, u32 mark, i32 skip, bool pop)
{
    i32 i = (i32)w->dropLen - 1;
    while (i >= (i32)mark)
    {
        if (i != skip) muvEmitDropEntry(w, &w->drops[i]);
        i--;
    }
    if (pop && w->dropLen > mark) w->dropLen = mark;
}

pub void muvDropsBranch(Muv* w, u32 mark, i32 skip)
{
    muvDropsFrom(w, mark, skip, false);
}

/* lower a VarDecl: alloca, optionally initialise (aggregates copy
 * element-wise from the source's address), register the local */
pub void muvVarDecl(Muv* w, Stmt* s, NodeId id)
{
    Str name = s->kind.payload.VarDecl.name;
    Ty vt = muvResolved(w, s->kind.payload.VarDecl.typeNode);
    if (vt == 0)
    {
        /* `var x = init` — infer from the init expr's resolved type */
        NodeId initId = s->kind.payload.VarDecl.init;
        if (initId.index != 0)
        {
            Node* in = muvNode(w, initId);
            if (in->kind.tag == NodeKind::Expr)
                vt = muvResolved(w, in->kind.payload.Expr.value.resolvedType);
        }
    }
    IrType* irt = vt != 0 ? muvTy(w, vt, 0) : null;
    if (irt == null || irt->kind == IrTypeKind::Void)
    {
        muvErr(w, id, "cannot local-bind a void value");
        return;
    }
    if ((s->kind.payload.VarDecl.flags & 4) != 0)
    {
        /* `static` keeps its storage across calls: a global registered
         * under this statement, pushed as a local so loads and stores
         * reach it; its initializer is constant, never run at entry */
        IrValue* gv = muvMakeGlobal(w, id, name, vt, s->kind.payload.VarDecl.init,
                                   (s->kind.payload.VarDecl.flags & 1) != 0, false,
                                   id.index);
        if (gv != null) muvPushLocal(w, name, gv, vt);
        return;
    }
    IrValue* slot = muvIsAgg(irt) ? muvAggSlot(w, irt) : muvV(w->b.alloca(irt));
    if (slot == null) return;
    if ((s->kind.payload.VarDecl.flags & 2) != 0) // hasInit
    {
        NodeId initId = s->kind.payload.VarDecl.init;
        if (muvIsAgg(irt))
        {
            /* aggregates never load into a register: copy element-wise */
            IrValue* src = muvAddrOf(w, initId);
            if (src != null) muvCopyAgg(w, slot, src, irt, 0);
        }
        else
        {
            IrValue* init = muvExpr(w, initId);
            if (init != null) w->b.store(init, slot);
        }
    }
    /* RAII move: `T x = y;` transfers y's ownership, so y must not
     * drop at scope exit (the C backend's cgPushDrop does the same) */
    if (s->kind.payload.VarDecl.dropMethod.index != 0)
    {
        NodeId initId = s->kind.payload.VarDecl.init;
        if (initId.index != 0)
        {
            Node* in = muvNode(w, initId);
            if (in->kind.tag == NodeKind::Expr &&
                in->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
            {
                i32 si = muvDropFind(w, in->kind.payload.Expr.value.kind.payload.Ident.name);
                if (si >= 0) muvDropRemoveAt(w, (u32)si);
            }
        }
        muvDropPush(w, name, slot, vt, s->kind.payload.VarDecl.dropMethod);
    }
    muvPushLocal(w, name, slot, vt);
}


/* `for x in iterable` and `for x in iter(start, end)` — an index loop
 * over a slice/array, or count()/at() calls over an @iter collection
 * (with range() when bounds are given). Mirrors the C backend's ForIn:
 * ranged bounds clamp to the collection, the receiver is the pointer
 * value or the iterable's own address, multi-binding reads tuple
 * fields, and the whole loop owns one scope. continue advances the
 * index, break leaves it. */
void muvForIn(Muv* w, Stmt* s, NodeId id)
{
    u32 scopeMark = w->locLen;
    u32 entryMark = w->dropLen;
    u32 entryDefers = w->deferLen;
    NodeId iterId = s->kind.payload.ForIn.iterExpr;
    NodeId rangeStart = s->kind.payload.ForIn.rangeStart;
    NodeId rangeEnd = s->kind.payload.ForIn.rangeEnd;
    bool ranged = rangeStart.index != 0;
    Str bindName = s->kind.payload.ForIn.bindName;
    Ty bindType = muvResolved(w, s->kind.payload.ForIn.bindType);
    u32 extraLen = s->kind.payload.ForIn.extraBindNamesLen;
    NodeId bodyId = s->kind.payload.ForIn.body;

    Node* in = muvNode(w, iterId);
    Ty iterTy = in->kind.tag == NodeKind::Expr
        ? muvResolved(w, in->kind.payload.Expr.value.resolvedType) : 0;
    TypeEntry* te = iterTy != 0 ? w->ctx->types + iterTy : null;
    bool indexed = te != null && (te->kind.tag == TypeKind::Slice ||
                                  te->kind.tag == TypeKind::Array);

    i32 ik = -1;
    if (in->kind.tag == NodeKind::Expr) ik = in->kind.payload.Expr.value.kind.tag;
    bool lshape = ik == ExprKind::Ident || ik == ExprKind::Field ||
                  ik == ExprKind::DerefField || ik == ExprKind::Index ||
                  ik == ExprKind::TupleField || ik == ExprKind::Deref;

    Ty ub = muvUnwrapTy(w, iterTy);
    bool iterIsPtr = ub != 0 && (w->ctx->types + ub)->kind.tag == TypeKind::Pointer;

    /* the iterable is read once, before the loop: an lvalue's own
     * storage, an rvalue materialized into a temp (an aggregate already
     * is its own address) */
    IrValue* stor = null;
    if (indexed || !iterIsPtr)
    {
        if (lshape) stor = muvAddrOf(w, iterId);
        else
        {
            IrValue* v = muvExpr(w, iterId);
            if (v == null) { w->locLen = scopeMark; return; }
            if (muvIsAgg(v->type)) stor = v;
            else
            {
                stor = muvV(w->b.alloca(v->type));
                if (stor == null) { w->locLen = scopeMark; return; }
                w->b.store(v, stor);
            }
        }
        if (stor == null)
            { muvErr(w, id, "for-in iterable has no storage"); w->locLen = scopeMark; return; }
    }
    IrValue* recv = null; // the @iter receiver (non-indexed loops only)
    if (!indexed)
    {
        if (iterIsPtr)
        {
            recv = muvExpr(w, iterId);
            if (recv == null) { w->locLen = scopeMark; return; }
        }
        else recv = stor;
    }

    IrType* cntTy = w->ir->tyInt(64);
    IrValue* iSlot = muvV(w->b.alloca(cntTy));
    if (iSlot == null) { w->locLen = scopeMark; return; }
    IrValue* endSlot = null;
    IrValue* rsV = null;
    IrValue* reV = null;
    IrFunc* countFn = null;
    IrFunc* atFn = null;
    NodeId mdefC = NodeId{ .index = 0 };
    NodeId mdefA = NodeId{ .index = 0 };

    if (ranged)
    {
        rsV = muvExpr(w, rangeStart);
        reV = muvExpr(w, rangeEnd);
        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
        Node* rsn = muvNode(w, rangeStart);
        Node* ren = muvNode(w, rangeEnd);
        Ty rst = rsn->kind.tag == NodeKind::Expr
            ? muvResolved(w, rsn->kind.payload.Expr.value.resolvedType) : 0;
        Ty ret = ren->kind.tag == NodeKind::Expr
            ? muvResolved(w, ren->kind.payload.Expr.value.resolvedType) : 0;
        rsV = muvCast(w, rsV, rsV->type, cntTy, muvTyUnsigned(w, rst), true);
        reV = muvCast(w, reV, reV->type, cntTy, muvTyUnsigned(w, ret), true);
        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
    }

    IrType* elemIr = null;
    Ty et = 0;
    if (indexed)
    {
        et = te->kind.tag == TypeKind::Slice
            ? te->kind.payload.Slice.base : te->kind.payload.Array.base;
        elemIr = muvTy(w, et, 0);
        if (elemIr == null)
            { muvErr(w, id, "for-in element type"); w->locLen = scopeMark; return; }
        if (ranged)
        {
            IrValue* lenV = null;
            if (te->kind.tag == TypeKind::Array)
                lenV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);
            else
            {
                IrValue* lSlot = muvGepField(w, stor, 1);
                if (lSlot != null) lenV = muvV(w->b.load(cntTy, lSlot));
            }
            if (lenV == null) { w->locLen = scopeMark; return; }
            /* clamp like C: rs = min(rs, len); re = min(re, len);
             * if (re < rs) re = rs — size_t bounds, unsigned compares */
            rsV = muvV(w->b.select(muvV(w->b.icmp(IrICmpPred::Ugt, rsV, lenV)), lenV, rsV));
            reV = muvV(w->b.select(muvV(w->b.icmp(IrICmpPred::Ugt, reV, lenV)), lenV, reV));
            reV = muvV(w->b.select(muvV(w->b.icmp(IrICmpPred::Ult, reV, rsV)), rsV, reV));
            if (rsV == null || reV == null) { w->locLen = scopeMark; return; }
            endSlot = muvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(rsV, iSlot);
            w->b.store(reV, endSlot);
        }
        else w->b.store(w->ir->constInt(cntTy, 0), iSlot);
    }
    else
    {
        /* @iter collections are consumed through count()/at(), plus
         * range() when bounds are given — both count and at must exist */
        bool nfC = false;
        bool nfA = false;
        bool nfR = false;
        NodeId mdefR = NodeId{ .index = 0 };
        countFn = muvMethodFnFor(w, iterTy, w->ctx->intern("count"), id, &nfC, &mdefC);
        atFn = muvMethodFnFor(w, iterTy, w->ctx->intern("at"), id, &nfA, &mdefA);
        IrFunc* rangeFn = null;
        if (ranged)
            rangeFn = muvMethodFnFor(w, iterTy, w->ctx->intern("range"), id, &nfR, &mdefR);
        if (nfC || nfA)
        {
            muvErr(w, id, "for-in over non-slice/array without @iter count()/at()");
            w->locLen = scopeMark;
            return;
        }
        if (ranged && nfR)
            { muvErr(w, id, "for-in range() not found"); w->locLen = scopeMark; return; }
        if (countFn == null || atFn == null) { w->locLen = scopeMark; return; }
        if (ranged && rangeFn == null) { w->locLen = scopeMark; return; }

        if (ranged)
        {
            u8 skR = muvMethodSelfKind(w, mdefR);
            IrValue*[3] rargs;
            u32 rn = 0;
            if (skR != 0) rargs[rn++] = recv;
            rargs[rn++] = rsV;
            rargs[rn++] = reV;
            IrValue* rObj = muvV(w->b.call(&rangeFn->base, rargs, rn));
            if (rObj == null || !muvIsAgg(rObj->type))
                { muvErr(w, id, "range() must return struct(usize, usize)"); w->locLen = scopeMark; return; }
            Ty rr = 0;
            Node* mrn = muvNode(w, mdefR);
            if (mrn->kind.tag == NodeKind::Decl &&
                mrn->kind.payload.Decl.value.kind.tag == DeclKind::Func)
                rr = muvResolved(w, mrn->kind.payload.Decl.value.kind.payload.Func.returnType);
            /* the bounds are the tuple `struct(usize, usize)`: elements 0/1 */
            Ty rb = muvUnwrapTy(w, rr);
            u32 si = 0xFFFFFFFF;
            u32 ei = 0xFFFFFFFF;
            u32 bGuard = 0;
            while (rb != 0 && bGuard < 8)
            {
                bGuard++;
                TypeEntry* be = w->ctx->types + rb;
                if (be->kind.tag == TypeKind::Tuple)
                {
                    if (be->kind.payload.Tuple.elemsLen == 2) { si = 0; ei = 1; }
                    break;
                }
                if (be->kind.tag == TypeKind::Named)
                {
                    NodeId td = muvFindTypeDecl(w, be->kind.payload.Named.name);
                    if (td.index == 0) break;
                    Node* dn = muvNode(w, td);
                    if (dn->kind.tag != NodeKind::Decl) break;
                    Decl* dd = &dn->kind.payload.Decl.value;
                    if (dd->kind.tag != DeclKind::TypeAlias) break;
                    rb = muvUnwrapTy(w, dd->kind.payload.TypeAlias.target);
                    continue;
                }
                break;
            }
            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)
            {
                si = muvFieldIdx(w, rr, w->ctx->intern("start"));
                ei = muvFieldIdx(w, rr, w->ctx->intern("end"));
            }
            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)
                { muvErr(w, id, "range() must return struct(usize, usize)"); w->locLen = scopeMark; return; }
            IrType* stT = rObj->type->params[si];
            IrType* etT = rObj->type->params[ei];
            IrValue* sSlot = muvGepField(w, rObj, si);
            IrValue* eSlot = muvGepField(w, rObj, ei);
            if (sSlot == null || eSlot == null) { w->locLen = scopeMark; return; }
            IrValue* sV = muvV(w->b.load(stT, sSlot));
            IrValue* eV = muvV(w->b.load(etT, eSlot));
            if (sV == null || eV == null) { w->locLen = scopeMark; return; }
            sV = muvCast(w, sV, stT, cntTy, muvTyUnsigned(w, rr), true);
            eV = muvCast(w, eV, etT, cntTy, muvTyUnsigned(w, rr), true);
            if (sV == null || eV == null) { w->locLen = scopeMark; return; }
            endSlot = muvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(sV, iSlot);
            w->b.store(eV, endSlot);
        }
        else
        {
            u8 skC = muvMethodSelfKind(w, mdefC);
            IrValue*[2] cargs;
            u32 cn = 0;
            if (skC != 0) cargs[cn++] = recv;
            IrValue* nV = muvV(w->b.call(&countFn->base, cargs, cn));
            if (nV == null) { w->locLen = scopeMark; return; }
            Ty crt = 0;
            Node* mcn = muvNode(w, mdefC);
            if (mcn->kind.tag == NodeKind::Decl &&
                mcn->kind.payload.Decl.value.kind.tag == DeclKind::Func)
                crt = muvResolved(w, mcn->kind.payload.Decl.value.kind.payload.Func.returnType);
            nV = muvCast(w, nV, nV->type, cntTy, muvTyUnsigned(w, crt), true);
            if (nV == null) { w->locLen = scopeMark; return; }
            endSlot = muvV(w->b.alloca(cntTy));
            if (endSlot == null) { w->locLen = scopeMark; return; }
            w->b.store(nV, endSlot);
            w->b.store(w->ir->constInt(cntTy, 0), iSlot);
        }
    }

    /* bind slots are allocated once, before the loop; each iteration
     * stores the element into them (multi-binding: one slot per name) */
    bool multi = extraLen > 0;
    u32 bindCount = 1 + extraLen;
    Ty* bindTypes = s->kind.payload.ForIn.bindTypes;
    u32 bindTypesLen = s->kind.payload.ForIn.bindTypesLen;
    if (multi && (bindTypes == null || bindTypesLen != bindCount))
    {
        muvErr(w, id, "for-in multi-binding requires a matching tuple element type");
        w->locLen = scopeMark;
        return;
    }
    IrValue** bindSlots = (IrValue**)muvArr(w, (usize)bindCount, 8);
    if (bindSlots == null) { w->locLen = scopeMark; return; }
    u32 b = 0;
    while (b < bindCount)
    {
        Ty bt = multi ? muvResolved(w, bindTypes[b]) : bindType;
        IrType* birt = bt != 0 ? muvTy(w, bt, 0) : null;
        if (birt == null || birt->kind == IrTypeKind::Void)
        {
            muvErr(w, id, "for-in bind has no type");
            w->locLen = scopeMark;
            return;
        }
        bindSlots[b] = muvIsAgg(birt) ? muvAggSlot(w, birt) : muvV(w->b.alloca(birt));
        if (bindSlots[b] == null) { w->locLen = scopeMark; return; }
        b++;
    }

    IrBlock* headBb = muvBlock(w, "forin.head");
    IrBlock* bodyBb = muvBlock(w, "forin.body");
    IrBlock* closeBb = muvBlock(w, "forin.close");
    IrBlock* postBb = muvBlock(w, "forin.post");
    IrBlock* exitBb = muvBlock(w, "forin.end");
    w->b.br(headBb);

    muvSetBlock(w, headBb);
    {
        IrValue* endV = null;
        if (endSlot != null) endV = muvV(w->b.load(cntTy, endSlot));
        else if (te->kind.tag == TypeKind::Slice)
        {
            IrValue* lSlot = muvGepField(w, stor, 1);
            if (lSlot != null) endV = muvV(w->b.load(cntTy, lSlot));
        }
        else endV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);
        IrValue* iv = muvV(w->b.load(cntTy, iSlot));
        if (endV == null || iv == null) { w->locLen = scopeMark; return; }
        IrValue* c = muvV(w->b.icmp(IrICmpPred::Ult, iv, endV));
        if (c == null) { w->locLen = scopeMark; return; }
        w->b.condBr(c, bodyBb, closeBb);
    }

    muvSetBlock(w, bodyBb);
    IrBlock* savedBreak = w->breakT;
    IrBlock* savedCont = w->contT;
    u32 savedBreakMark = w->breakDropMark;
    u32 savedContMark = w->contDropMark;
    u32 savedBreakDefers = w->breakDeferMark;
    u32 savedContDefers = w->contDeferMark;
    w->breakT = exitBb;
    w->contT = postBb;
    w->breakDropMark = entryMark;
    w->contDropMark = entryMark;
    w->breakDeferMark = entryDefers;
    w->contDeferMark = entryDefers;
    w->loopDepth++;
    {
        /* this iteration's element: an indexed address, or at(recv, i) */
        IrValue* eAddr = null;
        IrValue* atVal = null;
        if (indexed)
        {
            IrValue* iv = muvV(w->b.load(cntTy, iSlot));
            if (iv == null) { muvErr(w, id, "for-in index"); w->locLen = scopeMark; return; }
            if (te->kind.tag == TypeKind::Array)
                eAddr = muvIndexAddr(w, stor, elemIr, iv, true, id);
            else
            {
                IrValue* pSlot = muvGepField(w, stor, 0);
                if (pSlot == null) { w->locLen = scopeMark; return; }
                IrValue* p = muvV(w->b.load(w->ir->tyPtr(elemIr), pSlot));
                if (p == null) { w->locLen = scopeMark; return; }
                eAddr = muvIndexAddr(w, p, elemIr, iv, false, id);
            }
            if (eAddr == null) { muvErr(w, id, "for-in element address"); w->locLen = scopeMark; return; }
        }
        else
        {
            u8 skA = muvMethodSelfKind(w, mdefA);
            IrValue*[2] aargs;
            u32 an = 0;
            if (skA != 0) aargs[an++] = recv;
            IrValue* iv = muvV(w->b.load(cntTy, iSlot));
            if (iv == null) { muvErr(w, id, "for-in index"); w->locLen = scopeMark; return; }
            u32 ip = skA != 0 ? 1 : 0;
            if (ip < atFn->nparams && atFn->paramTypes[ip] != null &&
                atFn->paramTypes[ip]->kind == IrTypeKind::Int &&
                atFn->paramTypes[ip]->width != iv->type->width)
            {
                iv = muvCast(w, iv, iv->type, atFn->paramTypes[ip], false, true);
                if (iv == null) { w->locLen = scopeMark; return; }
            }
            aargs[an++] = iv;
            atVal = muvV(w->b.call(&atFn->base, aargs, an));
            if (atVal == null) { muvErr(w, id, "for-in at()"); w->locLen = scopeMark; return; }
        }

        /* store the element into the bind slots */
        b = 0;
        while (b < bindCount)
        {
            Ty bt = multi ? muvResolved(w, bindTypes[b]) : bindType;
            IrType* birt = muvTy(w, bt, 0);
            if (birt == null) { w->locLen = scopeMark; return; }
            if (multi)
            {
                IrValue* tupleAddr = indexed ? eAddr : atVal;
                if (tupleAddr == null) { w->locLen = scopeMark; return; }
                IrValue* fa = muvGepField(w, tupleAddr, b);
                if (fa == null) { w->locLen = scopeMark; return; }
                if (muvIsAgg(birt))
                {
                    if (!muvCopyAgg(w, bindSlots[b], fa, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else
                {
                    IrValue* fv = muvV(w->b.load(birt, fa));
                    if (fv == null) { w->locLen = scopeMark; return; }
                    w->b.store(fv, bindSlots[b]);
                }
            }
            else if (indexed)
            {
                if (muvIsAgg(birt))
                {
                    if (!muvCopyAgg(w, bindSlots[b], eAddr, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else
                {
                    IrValue* ev = muvV(w->b.load(birt, eAddr));
                    if (ev == null) { w->locLen = scopeMark; return; }
                    w->b.store(ev, bindSlots[b]);
                }
            }
            else
            {
                if (muvIsAgg(birt))
                {
                    if (!muvCopyAgg(w, bindSlots[b], atVal, birt, 0)) { w->locLen = scopeMark; return; }
                }
                else w->b.store(atVal, bindSlots[b]);
            }
            b++;
        }

        b = 0;
        while (b < bindCount)
        {
            Str bn = b == 0 ? bindName : s->kind.payload.ForIn.extraBindNames[b - 1];
            muvPushLocal(w, bn, bindSlots[b], multi ? muvResolved(w, bindTypes[b]) : bindType);
            b++;
        }
        muvStmt(w, bodyId);
    }
    w->loopDepth--;
    w->breakT = savedBreak;
    w->contT = savedCont;
    w->breakDropMark = savedBreakMark;
    w->contDropMark = savedContMark;
    w->breakDeferMark = savedBreakDefers;
    w->contDeferMark = savedContDefers;
    if (!w->term) w->b.br(postBb);

    muvSetBlock(w, postBb);
    {
        IrValue* iv = muvV(w->b.load(cntTy, iSlot));
        if (iv == null) { w->locLen = scopeMark; return; }
        IrValue* nv = muvV(w->b.add(iv, w->ir->constInt(cntTy, 1)));
        if (nv == null) { w->locLen = scopeMark; return; }
        w->b.store(nv, iSlot);
        w->b.br(headBb);
    }

    muvSetBlock(w, closeBb);
    muvDefersFrom(w, entryDefers, true);
    muvDropsFrom(w, entryMark, -1, true);
    w->b.br(exitBb);
    muvSetBlock(w, exitBb);
    w->dropLen = entryMark;
    w->deferLen = entryDefers;
    w->locLen = scopeMark;
}


pub void muvStmt(Muv* w, NodeId id)
{
    if (id.index == 0) return;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Stmt)
    {
        muvErr(w, id, "expected statement node");
        return;
    }
    if (w->term) return; // dead code after a terminator
    Stmt* s = &n->kind.payload.Stmt.value;
    switch (s->kind.tag)
    {
        StmtKind::ExprStmt => { muvExpr(w, s->kind.payload.ExprStmt.expr); },
        StmtKind::VarDecl => { muvVarDecl(w, s, id); },
        StmtKind::Return => {
            NodeId vId = s->kind.payload.Return.value;
            IrValue* v = null;
            i32 skip = -1;
            if (vId.index != 0)
            {
                Node* rn = muvNode(w, vId);
                if (rn->kind.tag == NodeKind::Expr &&
                    rn->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                    skip = muvDropFind(w, rn->kind.payload.Expr.value.kind.payload.Ident.name);
                v = muvExpr(w, vId);
                if (v != null) {
                    muvDefersBranch(w, w->fnDeferMark);
                    muvDropsBranch(w, w->fnDropMark, skip);
                    w->b.ret(v);
                }
            }
            else
            {
                muvDefersBranch(w, w->fnDeferMark);
                muvDropsBranch(w, w->fnDropMark, -1);
                w->b.retVoid();
            }
            muvTerm(w);
        },
        StmtKind::Block => {
            /* block scope: locals declared inside vanish at the closing
             * brace (sema enforces the same rule — see T0001 on escape) */
            u32 scopeMark = w->locLen;
            u32 dropMark = w->dropLen;
            u32 deferMark = w->deferLen;
            u32 i = 0;
            while (i < s->kind.payload.Block.stmtsLen && !w->term)
            {
                muvStmt(w, s->kind.payload.Block.stmts[i]);
                i++;
            }
            /* a terminated block already unwound through return/break */
            if (!w->term)
            {
                muvDefersFrom(w, deferMark, true);
                muvDropsFrom(w, dropMark, -1, true);
            }
            else
            {
                if (w->deferLen > deferMark) w->deferLen = deferMark;
                if (w->dropLen > dropMark) w->dropLen = dropMark;
            }
            w->locLen = scopeMark;
        },
        StmtKind::Assign => {
            Str opS = s->kind.payload.Assign.op;
            if (opS == 0) return;
            str ops = muvStr(w, opS);
            muvAssignCommon(w, s->kind.payload.Assign.target,
                           s->kind.payload.Assign.value, ops, id);
        },
        StmtKind::If => {
            IrValue* c = muvCond(w, muvExpr(w, s->kind.payload.If.cond));
            if (c == null) return;
            IrBlock* thenBb = muvBlock(w, "if.then");
            NodeId elseId = s->kind.payload.If.elseBody;
            IrBlock* elseBb = elseId.index != 0 ? muvBlock(w, "if.else") : null;
            IrBlock* joinBb = muvBlock(w, "if.end");
            w->b.condBr(c, thenBb, elseBb != null ? elseBb : joinBb);

            muvSetBlock(w, thenBb);
            muvStmt(w, s->kind.payload.If.thenBody);
            if (!w->term) w->b.br(joinBb);

            if (elseBb != null)
            {
                muvSetBlock(w, elseBb);
                muvStmt(w, elseId);
                if (!w->term) w->b.br(joinBb);
            }
            muvSetBlock(w, joinBb);
        },
        StmtKind::While => {
            IrBlock* headBb = muvBlock(w, "while.head");
            IrBlock* bodyBb = muvBlock(w, "while.body");
            IrBlock* closeBb = muvBlock(w, "while.close");
            IrBlock* exitBb = muvBlock(w, "while.end");
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;
            w->b.br(headBb);
            muvSetBlock(w, headBb);
            IrValue* c = muvCond(w, muvExpr(w, s->kind.payload.While.cond));
            if (c == null) return;
            w->b.condBr(c, bodyBb, closeBb);

            muvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = entryMark;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = entryDefers;
            w->loopDepth++;
            muvStmt(w, s->kind.payload.While.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(headBb);
            muvSetBlock(w, closeBb);
            muvDefersFrom(w, entryDefers, true);
            muvDropsFrom(w, entryMark, -1, true);
            w->b.br(exitBb);
            muvSetBlock(w, exitBb);
        },
        StmtKind::Loop => {
            /* `loop { ... }` — unconditionally re-enter the head block
             * (an empty-trip body with no terminator: same shape as
             * while(true)) */
            IrBlock* headBb = muvBlock(w, "loop.head");
            IrBlock* bodyBb = muvBlock(w, "loop.body");
            IrBlock* exitBb = muvBlock(w, "loop.end");
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;
            w->b.br(headBb);
            muvSetBlock(w, headBb);
            w->b.br(bodyBb);

            muvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = entryMark;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = entryDefers;
            w->loopDepth++;
            muvStmt(w, s->kind.payload.Loop.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(headBb);
            muvSetBlock(w, exitBb);
        },
        StmtKind::For => {
            /* for (init; cond; post) — continue targets `post`, break
             * targets the exit block. The init's locals are scoped to
             * the whole loop (matching the C backend's for-scope). */
            NodeId initId = s->kind.payload.For.init;
            NodeId condId = s->kind.payload.For.cond;
            NodeId postId = s->kind.payload.For.post;
            bool hasPost = (s->kind.payload.For.flags & 4) != 0;
            u32 scopeMark = w->locLen;
            u32 entryMark = w->dropLen;
            u32 entryDefers = w->deferLen;

            if (initId.index != 0) muvStmt(w, initId);

            IrBlock* headBb = muvBlock(w, "for.head");
            IrBlock* bodyBb = muvBlock(w, "for.body");
            IrBlock* closeBb = muvBlock(w, "for.close");
            IrBlock* postBb = hasPost || postId.index != 0 ? muvBlock(w, "for.post") : null;
            IrBlock* exitBb = muvBlock(w, "for.end");
            w->b.br(headBb);

            muvSetBlock(w, headBb);
            if (condId.index != 0)
            {
                IrValue* c = muvCond(w, muvExpr(w, condId));
                if (c == null) { w->locLen = scopeMark; return; }
                w->b.condBr(c, bodyBb, closeBb);
            }
            else w->b.br(bodyBb); // no condition: run forever (break exits)

            muvSetBlock(w, bodyBb);
            IrBlock* savedBreak = w->breakT;
            IrBlock* savedCont = w->contT;
            u32 savedBreakMark = w->breakDropMark;
            u32 savedContMark = w->contDropMark;
            u32 savedBreakDefers = w->breakDeferMark;
            u32 savedContDefers = w->contDeferMark;
            w->breakT = exitBb;
            w->contT = postBb != null ? postBb : headBb;
            w->breakDropMark = entryMark;
            w->contDropMark = w->dropLen;
            w->breakDeferMark = entryDefers;
            w->contDeferMark = w->deferLen;
            w->loopDepth++;
            muvStmt(w, s->kind.payload.For.body);
            w->loopDepth--;
            w->breakT = savedBreak;
            w->contT = savedCont;
            w->breakDropMark = savedBreakMark;
            w->contDropMark = savedContMark;
            w->breakDeferMark = savedBreakDefers;
            w->contDeferMark = savedContDefers;
            if (!w->term) w->b.br(postBb != null ? postBb : headBb);

            if (postBb != null)
            {
                muvSetBlock(w, postBb);
                if (postId.index != 0) muvExpr(w, postId);
                if (!w->term) w->b.br(headBb);
            }
            muvSetBlock(w, closeBb);
            muvDefersFrom(w, entryDefers, true);
            muvDropsFrom(w, entryMark, -1, true);
            w->b.br(exitBb);
            muvSetBlock(w, exitBb);
            w->dropLen = entryMark;
            w->deferLen = entryDefers;
            w->locLen = scopeMark;
        },
        StmtKind::Asm => {
            /* gcc-style extended asm → one InlineAsm. Template pieces
             * join; output/input sections are constraint/operand pairs
             * that flatten to a comma-joined constraint list plus an
             * ops array (outputs first, then inputs). Outputs and
             * memory-class inputs go through muvAddrOf — the emitter
             * reads and writes them through that pointer, so every
             * read-back operand carries a Ptr(T) alloca. All buffers
             * are arena-backed; inlineAsm dupStr's what it keeps. */
            u32 tLen = s->kind.payload.Asm.templateLen;
            u32 outLen = s->kind.payload.Asm.outputsLen;
            u32 inLen = s->kind.payload.Asm.inputsLen;
            u32 clobLen = s->kind.payload.Asm.clobbersLen;
            if ((outLen & 1) != 0 || (inLen & 1) != 0)
            {
                muvErr(w, id, "asm operand constraint needs a value");
                return;
            }

            /* template: string-literal pieces, escapes decoded like any
             * other literal */
            usize tcap = 0;
            u32 i = 0;
            while (i < tLen)
            {
                Node* tn = muvNode(w, s->kind.payload.Asm.template[i]);
                if (tn->kind.tag != NodeKind::Expr ||
                    tn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { muvErr(w, id, "asm template pieces must be string literals"); return; }
                tcap += muvStr(w, tn->kind.payload.Expr.value.kind.payload.StringLit.value).len;
                i++;
            }
            u8* tbuf = (u8*)muvArr(w, tcap + 1, 1);
            if (tbuf == null) { muvErr(w, id, "asm template buffer"); return; }
            usize tlen = 0;
            i = 0;
            while (i < tLen)
            {
                str tok = muvStr(w, muvNode(w, s->kind.payload.Asm.template[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                tlen += muvDecodeLit(tok, b, e, tbuf + tlen);
                i++;
            }

            /* constraints: raw token capacity first (validate the nodes),
             * then decode outputs then inputs into one comma list */
            usize ccap = 0;
            i = 0;
            while (i < outLen)
            {
                Node* cn = muvNode(w, s->kind.payload.Asm.outputs[i]);
                if (cn->kind.tag != NodeKind::Expr ||
                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { muvErr(w, id, "asm operand constraint must be a string literal"); return; }
                ccap += muvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i += 2;
            }
            i = 0;
            while (i < inLen)
            {
                Node* cn = muvNode(w, s->kind.payload.Asm.inputs[i]);
                if (cn->kind.tag != NodeKind::Expr ||
                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { muvErr(w, id, "asm operand constraint must be a string literal"); return; }
                ccap += muvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i += 2;
            }
            u8* cbuf = (u8*)muvArr(w, ccap + 1, 1);
            if (cbuf == null) { muvErr(w, id, "asm constraint buffer"); return; }
            usize clen = 0;
            i = 0;
            while (i < outLen)
            {
                str tok = muvStr(w, muvNode(w, s->kind.payload.Asm.outputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (clen > 0) { cbuf[clen] = ','; clen++; }
                clen += muvDecodeLit(tok, b, e, cbuf + clen);
                i = i + 2;
            }
            i = 0;
            while (i < inLen)
            {
                str tok = muvStr(w, muvNode(w, s->kind.payload.Asm.inputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (clen > 0) { cbuf[clen] = ','; clen++; }
                clen += muvDecodeLit(tok, b, e, cbuf + clen);
                i = i + 2;
            }

            /* exactly one register-class output ⇒ value mode: the asm
             * produces the result directly (no address escape), so
             * mem2reg still promotes the local; the value is stored back
             * to the lvalue right after. Multiple register outputs or
             * all-memory outputs keep the pointer model. */
            u32 nOut = outLen / 2;
            u32 nIn = inLen / 2;
            u32 regOut = 0;
            u32 regOutIdx = 0;
            bool regInOut = false;
            i = 0;
            while (i < outLen)
            {
                str raw = muvStr(w, muvNode(w, s->kind.payload.Asm.outputs[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize qi = 0;
                bool isInOut = false;
                while (qi < raw.len)
                {
                    u8 c = raw.ptr[qi];
                    if (c == (u8)'+') isInOut = true;
                    if (c == (u8)'"' || c == (u8)'=' || c == (u8)'+' || c == (u8)'&') { qi++; continue; }
                    break;
                }
                u8 cls = qi < raw.len ? raw.ptr[qi] : (u8)'r';
                bool isTie = cls >= (u8)'0' && cls <= (u8)'9';
                if (!isTie && cls != (u8)'m' && cls != (u8)'i' && cls != (u8)'f')
                {
                    regOut++;
                    regOutIdx = i;
                    if (isInOut) regInOut = true;
                }
                i += 2;
            }
            IrType* retT = null;
            if (regOut == 1)
            {
                Node* en = muvNode(w, s->kind.payload.Asm.outputs[regOutIdx + 1]);
                if (en->kind.tag == NodeKind::Expr && en->kind.payload.Expr.value.resolvedType != 0)
                    retT = muvTy(w, muvResolved(w, en->kind.payload.Expr.value.resolvedType), 0);
            }
            bool valMode = regOut == 1 && retT != null;

            u32 nops = nOut + nIn;
            IrValue** ops = null;
            if (nops > 0)
            {
                ops = (IrValue**)muvArr(w, (usize)nops, 8);
                if (ops == null) { muvErr(w, id, "asm operand array"); return; }
            }
            u32 k = 0;
            i = 0;
            while (i < outLen)
            {
                if (valMode && i == regOutIdx)
                {
                    /* the single register output: value operand — inout
                     * carries the current value, pure output carries
                     * nothing (the result rides on the inst value) */
                    ops[k] = regInOut ? muvExpr(w, s->kind.payload.Asm.outputs[i + 1]) : null;
                }
                else
                {
                    ops[k] = muvAddrOf(w, s->kind.payload.Asm.outputs[i + 1]);
                    if (ops[k] == null) return;
                }
                k++;
                i += 2;
            }
            i = 0;
            while (i < inLen)
            {
                Node* cn = muvNode(w, s->kind.payload.Asm.inputs[i]);
                str ctok = muvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value);
                bool isMem = false;
                usize qi = 0;
                while (qi < ctok.len) { if (ctok.ptr[qi] == (u8)'m') isMem = true; qi++; }
                NodeId vid = s->kind.payload.Asm.inputs[i + 1];
                if (isMem) ops[k] = muvAddrOf(w, vid);
                else ops[k] = muvExpr(w, vid);
                if (ops[k] == null) return;
                k++;
                i += 2;
            }

            /* clobbers: bare string literals, comma-joined */
            usize kcap = 0;
            i = 0;
            while (i < clobLen)
            {
                Node* kn = muvNode(w, s->kind.payload.Asm.clobbers[i]);
                if (kn->kind.tag != NodeKind::Expr ||
                    kn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)
                    { muvErr(w, id, "asm clobber must be a string literal"); return; }
                kcap += muvStr(w, kn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;
                i++;
            }
            u8* kbuf = (u8*)muvArr(w, kcap + 1, 1);
            if (kbuf == null) { muvErr(w, id, "asm clobber buffer"); return; }
            usize klen = 0;
            i = 0;
            while (i < clobLen)
            {
                str tok = muvStr(w, muvNode(w, s->kind.payload.Asm.clobbers[i])
                                ->kind.payload.Expr.value.kind.payload.StringLit.value);
                usize b = 0;
                usize e = tok.len;
                if (e >= 2 && tok.ptr[0] == '"') { b = 1; e = e - 1; }
                if (klen > 0) { kbuf[klen] = ','; klen++; }
                klen += muvDecodeLit(tok, b, e, kbuf + klen);
                i++;
            }

            IrInst* asmInst = w->b.inlineAsm(str::fromParts(tbuf, tlen),
                           str::fromParts(cbuf, clen),
                           str::fromParts(kbuf, klen),
                           (s->kind.payload.Asm.flags & 1) != 0,
                           ops, nops, retT);
            if (valMode && asmInst != null)
            {
                /* write the register result back to the local — mem2reg
                 * removes the pair whenever the local stays promotable */
                IrValue* res = muvV(asmInst);
                IrValue* dst = muvAddrOf(w, s->kind.payload.Asm.outputs[regOutIdx + 1]);
                if (res != null && dst != null) w->b.store(res, dst);
            }
        },
        StmtKind::Switch => { muvSwitch(w, s, id); },
        StmtKind::ForIn => { muvForIn(w, s, id); },
        StmtKind::Defer => {
            muvDeferPush(w, s->kind.payload.Defer.stmt);
        },
        StmtKind::Comptime => {
            /* comptime blocks are evaluated by mono's CtEval, which
             * replaces instantiated bodies with their surviving runtime
             * statements. One reaching here was never evaluated — the
             * concrete decl of an instantiated helper, or a static only
             * called from comptime. Mirror the C backend: emit nothing —
             * walking it would try to lower comptime-only constructs
             * (pack iteration, type switches) with no runtime form. */
        },
        StmtKind::Break => {
            if (w->breakT == null) { muvErr(w, id, "break outside a loop"); return; }
            muvDefersBranch(w, w->breakDeferMark);
            muvDropsBranch(w, w->breakDropMark, -1);
            w->b.br(w->breakT);
            muvTerm(w);
        },
        StmtKind::Continue => {
            if (w->contT == null) { muvErr(w, id, "continue outside a loop"); return; }
            muvDefersBranch(w, w->contDeferMark);
            muvDropsBranch(w, w->contDropMark, -1);
            w->b.br(w->contT);
            muvTerm(w);
        },
        else => {
            muvErr(w, id, "unsupported statement (Phase 1)");
        },
    }
}
