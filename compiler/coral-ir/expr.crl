#[[no_drop_all]]
/* coral-ir/expr.crl — expression lowering
 *
 * Phase 1: integer/float literals, arithmetic, comparisons, boolean
 * logic, locals, direct calls, address-of/deref, casts, sizeof. Returns
 * the IrValue* for the expression; null on void/unhandled. Unhandled
 * forms report G0001. Callee resolution goes through the sema scope
 * stack (lookupFrom) → declId → the collection pass's fn map — no
 * per-reference re-mangling, no linear decl scans. */
import lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvSubstTy, wvFindLocal,
               wvPushLocal, wvFnMapGet, wvBlock, wvSetBlock, wvTerm, wvPos };
import types { wvTy };
import decl { wvMangle, wvDeclareFunc };
import context::context { AstContext };
import mono::mono { MonoContext, MonoInstance };
import sem { scope { Symbol, ScopeStack } };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, Param }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst };
import(lib) wallvm::irOps { IrICmpPred, IrFCmpPred };
import(lib) wallvm::irBuilder { IrBuilder };
import(lib) std::mman { alloc, dealloc };

/* builder ops return IrInst*; the SSA value is the instruction's base */
pub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }

/* is the resolved Coral type an unsigned integer? (drives signedness of
 * div/rem/shr/casts — wallvm IrType carries no signed flag) */
pub bool wvTyUnsigned(Wv* w, Ty t)
{
    Ty rt = wvResolved(w, t);
    if (rt == 0) return false;
    TypeEntry* te = w->ctx->types + rt;
    switch (te.kind.tag)
    {
        TypeKind::U8 | TypeKind::U16 | TypeKind::U32 | TypeKind::U64 |
        TypeKind::U128 | TypeKind::Usize | TypeKind::Char | TypeKind::Bool =>
            { return true; },
        else => { return false; },
    }
}

pub IrValue* wvExpr(Wv* w, NodeId id);

/* ── callee resolution ──────────────────────────────────────── */

/* resolve a bare-name call target: sema scope lookup → declId → the
 * pre-declared IrFunc from the collection pass. Falls back to declaring
 * an on-the-fly shell (externs not seen in the collection pass). */
pub IrFunc* wvResolveCallee(Wv* w, Str name, NodeId refSite)
{
    if (name == 0) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    if (w->sema != null && w->sema.scopes != null)
    {
        Symbol* sym = w->sema.scopes.lookupFrom(name, refFile);
        if (sym != null && sym->declaration.index != 0)
        {
            IrFunc* f = wvFnMapGet(w, sym->declaration.index);
            if (f != null) return f;
            /* not in the collection pass (e.g. an extern the pass skipped):
             * declare a shell now */
            Node* sn = wvNode(w, sym->declaration);
            if (sn->kind.tag == NodeKind::Decl)
            {
                Decl* sd = &sn->kind.payload.Decl.value;
                if (sd->kind.tag == DeclKind::Func)
                    return wvDeclareFunc(w, sym->declaration, sd);
            }
        }
    }
    wvErr(w, refSite, "unresolved call target");
    return null;
}

/* C default-argument promotions for variadic args: int < 32-bit →
 * zext/sext to i32, float < 64-bit → fpext to f64 */
pub IrValue* wvPromoteVararg(Wv* w, IrValue* v, Ty coralTy)
{
    if (v == null || v->type == null) return v;
    Ty rt = wvResolved(w, coralTy);
    if (rt == 0) return v;
    TypeEntry* te = w->ctx->types + rt;
    bool uns = wvTyUnsigned(w, coralTy);
    switch (te.kind.tag)
    {
        TypeKind::I8 | TypeKind::I16 => {
            return wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::U8 | TypeKind::U16 | TypeKind::Bool => {
            return wvV(w->b.zext(v, w->ir->tyInt(32)));
        },
        TypeKind::Char => {
            return uns ? wvV(w->b.zext(v, w->ir->tyInt(32)))
                       : wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::F32 => { return wvV(w->b.fpExt(v, w->ir->tyDouble())); },
        else => { return v; },
    }
}

/* ── calls ──────────────────────────────────────────────────── */

pub IrValue* wvCall(Wv* w, Expr* e, NodeId id)
{
    NodeId calleeId = e->kind.payload.Call.callee;
    Node* cn = wvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr ||
        cn->kind.payload.Expr.value.kind.tag != ExprKind::Ident)
    {
        wvErr(w, id, "unsupported callee form (Phase 1: bare-name calls only)");
        return null;
    }
    Str name = cn->kind.payload.Expr.value.kind.payload.Ident.name;
    IrFunc* f = wvResolveCallee(w, name, calleeId);
    if (f == null) return null;

    u32 nargs = e->kind.payload.Call.argsLen;
    IrValue** args = null;
    if (nargs > 0) args = alloc<IrValue*>((usize)nargs);
    bool vararg = f->base.type != null && f->base.type->isVararg;
    u32 fixed = f->nparams;
    bool fail = false;
    u32 i = 0;
    while (i < nargs && !fail)
    {
        IrValue* av = wvExpr(w, e->kind.payload.Call.args[i]);
        if (av == null) { fail = true; break; }
        if (vararg && i >= fixed)
        {
            Node* an = wvNode(w, e->kind.payload.Call.args[i]);
            Ty at = an->kind.tag == NodeKind::Expr ? an->kind.payload.Expr.value.resolvedType : 0;
            av = wvPromoteVararg(w, av, at);
        }
        args[i] = av;
        i++;
    }
    if (fail)
    {
        if (args != null) dealloc<IrValue*>(args);
        return null;
    }
    IrValue* res = wvV(w->b.call(&f->base, args, nargs));
    if (args != null) dealloc<IrValue*>(args);
    if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
    return res;
}

/* ── arithmetic / comparison ────────────────────────────────── */

pub IrValue* wvBinaryArith(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Add => { return wvV(isFloat ? w->b.fadd(l, r) : w->b.add(l, r)); },
        ExprKind::Sub => { return wvV(isFloat ? w->b.fsub(l, r) : w->b.sub(l, r)); },
        ExprKind::Mul => { return wvV(isFloat ? w->b.fmul(l, r) : w->b.mul(l, r)); },
        ExprKind::Div => {
            if (isFloat) return wvV(w->b.fdiv(l, r));
            return wvV(uns ? w->b.udiv(l, r) : w->b.sdiv(l, r));
        },
        ExprKind::Mod => {
            if (isFloat) { wvErr(w, id, "float modulo (needs fmod lowering, Phase 2)"); return null; }
            return wvV(uns ? w->b.urem(l, r) : w->b.srem(l, r));
        },
        ExprKind::BitAnd => { return wvV(w->b.andOp(l, r)); },
        ExprKind::BitOr => { return wvV(w->b.orOp(l, r)); },
        ExprKind::BitXor => { return wvV(w->b.xorOp(l, r)); },
        ExprKind::Shl => { return wvV(w->b.shl(l, r)); },
        ExprKind::Shr => { return wvV(uns ? w->b.lshr(l, r) : w->b.ashr(l, r)); },
        else => { wvErr(w, id, "unhandled binary op"); return null; },
    }
}

pub IrValue* wvCompare(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Eq => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::Oeq, l, r)
                               : w->b.icmp(IrICmpPred::Eq, l, r));
        },
        ExprKind::Ne => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::One, l, r)
                               : w->b.icmp(IrICmpPred::Ne, l, r));
        },
        ExprKind::Lt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Olt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ult : IrICmpPred::Slt, l, r));
        },
        ExprKind::Le => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ole, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ule : IrICmpPred::Sle, l, r));
        },
        ExprKind::Gt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ogt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ugt : IrICmpPred::Sgt, l, r));
        },
        ExprKind::Ge => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Oge, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Uge : IrICmpPred::Sge, l, r));
        },
        else => { wvErr(w, id, "unhandled comparison"); return null; },
    }
}

/* short-circuit And/Or via result alloca + condBr (no phis) */
pub IrValue* wvShortCircuit(Wv* w, Expr* e, NodeId id)
{
    IrType* bt = w->ir->tyInt(1);
    IrValue* resSlot = wvV(w->b.alloca(bt));
    IrValue* l = wvExpr(w, e->kind.payload.And.left);
    if (l == null) return null;
    IrValue* lz = wvV(w->b.icmp(IrICmpPred::Ne, l, w->ir->constInt(l->type, 1)));
    IrBlock* rhsBb = wvBlock(w, "sc.rhs");
    IrBlock* endBb = wvBlock(w, "sc.end");
    bool isAnd = e->kind.tag == ExprKind::And;
    if (isAnd) w->b.condBr(lz, rhsBb, endBb);
    else w->b.condBr(lz, endBb, rhsBb);

    /* short-circuit path: store the known result, branch to join */
    wvSetBlock(w, endBb);
    w->b.store(w->ir->constInt(bt, isAnd ? 0 : 1), resSlot);
    IrBlock* joinBb = wvBlock(w, "sc.join");
    w->b.br(joinBb);

    /* rhs path: evaluate, store, branch to join */
    wvSetBlock(w, rhsBb);
    IrValue* r = wvExpr(w, e->kind.payload.And.right);
    if (r == null) return null;
    IrValue* rz = wvV(w->b.icmp(IrICmpPred::Ne, r, w->ir->constInt(r->type, 1)));
    w->b.store(rz, resSlot);
    w->b.br(joinBb);

    wvSetBlock(w, joinBb);
    return wvV(w->b.load(bt, resSlot));
}

/* scalar cast between two IrTypes, using Coral signedness for the
 * int↔int / int→float choice (IrType has no signed flag) */
pub IrValue* wvCast(Wv* w, IrValue* v, IrType* st, IrType* dt, bool srcUnsigned, bool dstUnsigned)
{
    if (v == null || dt == null) return v;
    if (st == dt) return v;
    if (st->kind == IrTypeKind::Ptr && dt->kind == IrTypeKind::Ptr) return v;
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Int)
    {
        if (dt->width == st->width) return v;
        if (dt->width < st->width) return wvV(w->b.trunc(v, dt));
        return wvV(srcUnsigned ? w->b.zext(v, dt) : w->b.sext(v, dt));
    }
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Float)
        return wvV(srcUnsigned ? w->b.uiToFp(v, dt) : w->b.siToFp(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Int)
        return wvV(dstUnsigned ? w->b.fpToUi(v, dt) : w->b.fpToSi(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Float)
    {
        if (dt->width < st->width) return wvV(w->b.fpTrunc(v, dt));
        return wvV(w->b.fpExt(v, dt));
    }
    return wvV(w->b.bitcast(v, dt));
}

/* ── the main expression dispatch ───────────────────────────── */

pub IrValue* wvExpr(Wv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Expr)
    {
        wvErr(w, id, "expected expression node");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    Ty rt = wvResolved(w, e->resolvedType);
    switch (e->kind.tag)
    {
        ExprKind::IntLit => {
            IrType* it = rt != 0 ? wvTy(w->ctx, w->file, w->ir, rt, 0)
                                 : w->ir->tyInt(32);
            return w->ir->constInt(it, e->kind.payload.IntLit.value);
        },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(w->ir->tyInt(1), v);
        },
        ExprKind::CharLit => {
            return w->ir->constInt(w->ir->tyInt(8), (u64)e->kind.payload.CharLit.value);
        },
        ExprKind::NullLit => {
            return w->ir->constInt(w->ir->tyPtr(w->ir->tyInt(8)), 0);
        },
        ExprKind::FloatLit => {
            wvErr(w, id, "float literals: Phase 2 (needs str→f64 parse)");
            return null;
        },
        ExprKind::StringLit => {
            wvErr(w, id, "string literals: Phase 2 (needs global data, wallvm G29)");
            return null;
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = wvFindLocal(w, name);
            if (slot != null)
            {
                IrType* vt = wvTy(w->ctx, w->file, w->ir, rt, 0);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                return wvV(w->b.load(vt, slot));
            }
            wvErr(w, id, "unresolved identifier (globals: Phase 2)");
            return null;
        },
        ExprKind::Call => { return wvCall(w, e, id); },
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr => {
            Expr* le = &wvNode(w, e->kind.payload.Add.left)->kind.payload.Expr.value;
            return wvBinaryArith(w, e->kind, e->kind.payload.Add.left,
                                 e->kind.payload.Add.right, id, le->resolvedType);
        },
        ExprKind::Eq | ExprKind::Ne | ExprKind::Lt | ExprKind::Le |
        ExprKind::Gt | ExprKind::Ge => {
            Expr* le = &wvNode(w, e->kind.payload.Eq.left)->kind.payload.Expr.value;
            return wvCompare(w, e->kind, e->kind.payload.Eq.left,
                             e->kind.payload.Eq.right, id, le->resolvedType);
        },
        ExprKind::And | ExprKind::Or => { return wvShortCircuit(w, e, id); },
        ExprKind::Neg => {
            IrValue* v = wvExpr(w, e->kind.payload.Neg.expr);
            if (v == null) return null;
            if (rt != 0)
            {
                TypeEntry* te = w->ctx->types + rt;
                if (te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64)
                    return wvV(w->b.fsub(w->ir->constInt(v->type, 0), v));
            }
            return wvV(w->b.neg(v));
        },
        ExprKind::Not => {
            IrValue* v = wvExpr(w, e->kind.payload.Not.expr);
            if (v == null) return null;
            return wvV(w->b.xorOp(v, w->ir->constInt(v->type, 1)));
        },
        ExprKind::BitNot => {
            IrValue* v = wvExpr(w, e->kind.payload.BitNot.expr);
            if (v == null) return null;
            return wvV(w->b.notOp(v));
        },
        ExprKind::AddressOf => {
            NodeId tgt = e->kind.payload.AddressOf.expr;
            Node* tn = wvNode(w, tgt);
            if (tn->kind.tag == NodeKind::Expr)
            {
                Expr* te = &tn->kind.payload.Expr.value;
                if (te->kind.tag == ExprKind::Ident)
                {
                    IrValue* slot = wvFindLocal(w, te->kind.payload.Ident.name);
                    if (slot != null) return slot;
                }
            }
            wvErr(w, id, "address-of target: only locals supported (Phase 1)");
            return null;
        },
        ExprKind::Deref => {
            IrValue* v = wvExpr(w, e->kind.payload.Deref.expr);
            if (v == null) return null;
            IrType* vt = wvTy(w->ctx, w->file, w->ir, rt, 0);
            return wvV(w->b.load(vt, v));
        },
        ExprKind::Cast => {
            IrValue* v = wvExpr(w, e->kind.payload.Cast.expr);
            if (v == null) return null;
            Ty tgt = wvResolved(w, e->kind.payload.Cast.targetType);
            IrType* dt = wvTy(w->ctx, w->file, w->ir, tgt, 0);
            Expr* se = &wvNode(w, e->kind.payload.Cast.expr)->kind.payload.Expr.value;
            bool su = wvTyUnsigned(w, se->resolvedType);
            bool du = wvTyUnsigned(w, e->kind.payload.Cast.targetType);
            return wvCast(w, v, v->type, dt, su, du);
        },
        ExprKind::Sizeof => {
            IrType* st = wvTy(w->ctx, w->file, w->ir,
                              wvResolved(w, e->kind.payload.Sizeof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeSizeOf(st));
        },
        ExprKind::Alignof => {
            IrType* at = wvTy(w->ctx, w->file, w->ir,
                              wvResolved(w, e->kind.payload.Alignof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeAlignOf(at));
        },
        else => {
            wvErr(w, id, "unsupported expression (Phase 1)");
            return null;
        },
    }
}
