#[[no_drop_all]]
/* coral-ir/expr.crl — expression lowering
 *
 * Phase 1: integer/float literals, arithmetic, comparisons, boolean
 * logic, locals, direct calls, address-of/deref, casts, sizeof. Returns
 * the IrValue* for the expression; null on void/unhandled. Unhandled
 * forms report G0001. Callee resolution goes through the sema scope
 * stack (lookupFrom) → declId → the collection pass's fn map — no
 * per-reference re-mangling, no linear decl scans. */
import lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvSubstTy, wvFindLocal,
               wvPushLocal, wvFnMapGet, wvBlock, wvSetBlock, wvTerm, wvPos };
import types { wvTy, wvFindTypeDecl };
import decl { wvMangle, wvDeclareFunc };
import context::context { AstContext };
import mono::mono { MonoContext, MonoInstance };
import sem { scope { Symbol, ScopeStack } };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, Field, Param }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst };
import(lib) wallvm::irOps { IrICmpPred, IrFCmpPred };
import(lib) wallvm::irBuilder { IrBuilder };
import(lib) std::mman { alloc, dealloc };
import(lib) platform::libc { strtod };
import(lib) core::cchar { cchar };

/* builder ops return IrInst*; the SSA value is the instruction's base */
pub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }

/* is the resolved Coral type an unsigned integer? (drives signedness of
 * div/rem/shr/casts — wallvm IrType carries no signed flag) */
pub bool wvTyUnsigned(Wv* w, Ty t)
{
    Ty rt = wvResolved(w, t);
    if (rt == 0) return false;
    TypeEntry* te = w->ctx->types + rt;
    switch (te.kind.tag)
    {
        TypeKind::U8 | TypeKind::U16 | TypeKind::U32 | TypeKind::U64 |
        TypeKind::U128 | TypeKind::Usize | TypeKind::Char | TypeKind::Bool =>
            { return true; },
        else => { return false; },
    }
}

pub IrValue* wvExpr(Wv* w, NodeId id);


/* resolve a bare-name call target: sema scope lookup → declId → the
 * pre-declared IrFunc from the collection pass. Falls back to declaring
 * an on-the-fly shell (externs not seen in the collection pass). */
pub IrFunc* wvResolveCallee(Wv* w, Str name, NodeId refSite)
{
    if (name == 0) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    if (w->sema != null && w->sema.scopes != null)
    {
        Symbol* sym = w->sema.scopes.lookupFrom(name, refFile);
        if (sym != null && sym->declaration.index != 0)
        {
            IrFunc* f = wvFnMapGet(w, sym->declaration.index);
            if (f != null) return f;
            /* not in the collection pass (e.g. an extern the pass skipped):
             * declare a shell now */
            Node* sn = wvNode(w, sym->declaration);
            if (sn->kind.tag == NodeKind::Decl)
            {
                Decl* sd = &sn->kind.payload.Decl.value;
                if (sd->kind.tag == DeclKind::Func)
                    return wvDeclareFunc(w, sym->declaration, sd);
            }
        }
    }
    wvErr(w, refSite, "unresolved call target");
    return null;
}

/* C default-argument promotions for variadic args: int < 32-bit →
 * zext/sext to i32, float < 64-bit → fpext to f64 */
pub IrValue* wvPromoteVararg(Wv* w, IrValue* v, Ty coralTy)
{
    if (v == null || v->type == null) return v;
    Ty rt = wvResolved(w, coralTy);
    if (rt == 0) return v;
    TypeEntry* te = w->ctx->types + rt;
    bool uns = wvTyUnsigned(w, coralTy);
    switch (te.kind.tag)
    {
        TypeKind::I8 | TypeKind::I16 => {
            return wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::U8 | TypeKind::U16 | TypeKind::Bool => {
            return wvV(w->b.zext(v, w->ir->tyInt(32)));
        },
        TypeKind::Char => {
            return uns ? wvV(w->b.zext(v, w->ir->tyInt(32)))
                       : wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::F32 => { return wvV(w->b.fpExt(v, w->ir->tyDouble())); },
        else => { return v; },
    }
}


pub IrValue* wvCall(Wv* w, Expr* e, NodeId id)
{
    NodeId calleeId = e->kind.payload.Call.callee;
    Node* cn = wvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr ||
        cn->kind.payload.Expr.value.kind.tag != ExprKind::Ident)
    {
        wvErr(w, id, "unsupported callee form (Phase 1: bare-name calls only)");
        return null;
    }
    Str name = cn->kind.payload.Expr.value.kind.payload.Ident.name;
    IrFunc* f = wvResolveCallee(w, name, calleeId);
    if (f == null) return null;

    u32 nargs = e->kind.payload.Call.argsLen;
    IrValue** args = null;
    if (nargs > 0) args = alloc<IrValue*>((usize)nargs);
    bool vararg = f->base.type != null && f->base.type->isVararg;
    u32 fixed = f->nparams;
    bool fail = false;
    u32 i = 0;
    while (i < nargs && !fail)
    {
        IrValue* av = wvExpr(w, e->kind.payload.Call.args[i]);
        if (av == null) { fail = true; break; }
        if (vararg && i >= fixed)
        {
            Node* an = wvNode(w, e->kind.payload.Call.args[i]);
            Ty at = an->kind.tag == NodeKind::Expr ? an->kind.payload.Expr.value.resolvedType : 0;
            av = wvPromoteVararg(w, av, at);
        }
        args[i] = av;
        i++;
    }
    if (fail)
    {
        if (args != null) dealloc<IrValue*>(args);
        return null;
    }
    IrValue* res = wvV(w->b.call(&f->base, args, nargs));
    if (args != null) dealloc<IrValue*>(args);
    if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
    return res;
}


/* value-level arithmetic: l and r are already evaluated. Shared by
 * binary expressions and compound assignment (`x += e` = load, apply,
 * store). */
pub IrValue* wvArithVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Add => { return wvV(isFloat ? w->b.fadd(l, r) : w->b.add(l, r)); },
        ExprKind::Sub => { return wvV(isFloat ? w->b.fsub(l, r) : w->b.sub(l, r)); },
        ExprKind::Mul => { return wvV(isFloat ? w->b.fmul(l, r) : w->b.mul(l, r)); },
        ExprKind::Div => {
            if (isFloat) return wvV(w->b.fdiv(l, r));
            return wvV(uns ? w->b.udiv(l, r) : w->b.sdiv(l, r));
        },
        ExprKind::Mod => {
            if (isFloat) { wvErr(w, id, "float modulo (needs fmod lowering, Phase 2)"); return null; }
            return wvV(uns ? w->b.urem(l, r) : w->b.srem(l, r));
        },
        ExprKind::BitAnd => { return wvV(w->b.andOp(l, r)); },
        ExprKind::BitOr => { return wvV(w->b.orOp(l, r)); },
        ExprKind::BitXor => { return wvV(w->b.xorOp(l, r)); },
        ExprKind::Shl => { return wvV(w->b.shl(l, r)); },
        ExprKind::Shr => { return wvV(uns ? w->b.lshr(l, r) : w->b.ashr(l, r)); },
        else => { wvErr(w, id, "unhandled binary op"); return null; },
    }
}

pub IrValue* wvBinaryArith(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    return wvArithVals(w, k, l, r, id, ct);
}

/* value-level comparison (see wvArithVals) */
pub IrValue* wvCompareVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Eq => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::Oeq, l, r)
                               : w->b.icmp(IrICmpPred::Eq, l, r));
        },
        ExprKind::Ne => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::One, l, r)
                               : w->b.icmp(IrICmpPred::Ne, l, r));
        },
        ExprKind::Lt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Olt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ult : IrICmpPred::Slt, l, r));
        },
        ExprKind::Le => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ole, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ule : IrICmpPred::Sle, l, r));
        },
        ExprKind::Gt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ogt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ugt : IrICmpPred::Sgt, l, r));
        },
        ExprKind::Ge => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Oge, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Uge : IrICmpPred::Sge, l, r));
        },
        else => { wvErr(w, id, "unhandled comparison"); return null; },
    }
}

pub IrValue* wvCompare(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    return wvCompareVals(w, k, l, r, id, ct);
}

/* short-circuit And/Or via result alloca + condBr (no phis) */
pub IrValue* wvShortCircuit(Wv* w, Expr* e, NodeId id)
{
    IrType* bt = w->ir->tyInt(1);
    IrValue* resSlot = wvV(w->b.alloca(bt));
    IrValue* l = wvExpr(w, e->kind.payload.And.left);
    if (l == null) return null;
    IrValue* lz = wvV(w->b.icmp(IrICmpPred::Ne, l, w->ir->constInt(l->type, 1)));
    IrBlock* rhsBb = wvBlock(w, "sc.rhs");
    IrBlock* endBb = wvBlock(w, "sc.end");
    bool isAnd = e->kind.tag == ExprKind::And;
    if (isAnd) w->b.condBr(lz, rhsBb, endBb);
    else w->b.condBr(lz, endBb, rhsBb);

    /* short-circuit path: store the known result, branch to join */
    wvSetBlock(w, endBb);
    w->b.store(w->ir->constInt(bt, isAnd ? 0 : 1), resSlot);
    IrBlock* joinBb = wvBlock(w, "sc.join");
    w->b.br(joinBb);

    /* rhs path: evaluate, store, branch to join */
    wvSetBlock(w, rhsBb);
    IrValue* r = wvExpr(w, e->kind.payload.And.right);
    if (r == null) return null;
    IrValue* rz = wvV(w->b.icmp(IrICmpPred::Ne, r, w->ir->constInt(r->type, 1)));
    w->b.store(rz, resSlot);
    w->b.br(joinBb);

    wvSetBlock(w, joinBb);
    return wvV(w->b.load(bt, resSlot));
}

/* scalar cast between two IrTypes, using Coral signedness for the
 * int↔int / int→float choice (IrType has no signed flag) */
pub IrValue* wvCast(Wv* w, IrValue* v, IrType* st, IrType* dt, bool srcUnsigned, bool dstUnsigned)
{
    if (v == null || dt == null) return v;
    if (st == dt) return v;
    if (st->kind == IrTypeKind::Ptr && dt->kind == IrTypeKind::Ptr) return v;
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Int)
    {
        if (dt->width == st->width) return v;
        if (dt->width < st->width) return wvV(w->b.trunc(v, dt));
        return wvV(srcUnsigned ? w->b.zext(v, dt) : w->b.sext(v, dt));
    }
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Float)
        return wvV(srcUnsigned ? w->b.uiToFp(v, dt) : w->b.siToFp(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Int)
        return wvV(dstUnsigned ? w->b.fpToUi(v, dt) : w->b.fpToSi(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Float)
    {
        if (dt->width < st->width) return wvV(w->b.fpTrunc(v, dt));
        return wvV(w->b.fpExt(v, dt));
    }
    return wvV(w->b.bitcast(v, dt));
}


/* coerce any expression value to an i1 condition: i1 passes through,
 * other ints compare against 1, floats against 0.0, pointers against
 * null. Returns null on failure. */
pub IrValue* wvCond(Wv* w, IrValue* v)
{
    if (v == null || v->type == null) return null;
    if (v->type->kind == IrTypeKind::Int && v->type->width == 1) return v;
    if (v->type->kind == IrTypeKind::Float)
        return wvV(w->b.fcmp(IrFCmpPred::One, v, w->ir->constFloat(v->type, 0.0)));
    if (v->type->kind == IrTypeKind::Ptr)
        return wvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 0)));
    return wvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 1)));
}

pub IrValue* wvAddrOf(Wv* w, NodeId id);

/* strip Const/Comptime wrappers; Named alias/distinct unwrapping happens
 * where the decl is needed */
pub Ty wvUnwrapTy(Wv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else return t;
        guard++;
    }
    return t;
}

/* is this IR type an aggregate (address-copied, never register-loaded)? */
pub bool wvIsAgg(IrType* t)
{
    return t != null && (t->kind == IrTypeKind::Struct ||
                         t->kind == IrTypeKind::Array ||
                         t->kind == IrTypeKind::Vector);
}

/* declaration-order field index of `name` in struct type `t` — the same
 * order wvStructTy feeds createStructType, which is the order wallvm's
 * emitGep walks for field offsets. Str/Slice expose the fixed {ptr,len}
 * pair. 0xFFFFFFFF when the field is unknown. */
pub u32 wvFieldIdx(Wv* w, Ty t, Str name)
{
    u32 none = 0xFFFFFFFF;
    if (name == 0) return none;
    str sn = wvStr(w, name);
    t = wvUnwrapTy(w, t);
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        guard++;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Str || e->kind.tag == TypeKind::Slice)
        {
            if (sn.equals("ptr")) return 0;
            if (sn.equals("len")) return 1;
            return none;
        }
        if (e->kind.tag != TypeKind::Named) return none;
        NodeId td = wvFindTypeDecl(w->file, w->ctx, e->kind.payload.Named.name);
        if (td.index == 0) return none;
        Node* dn = wvNode(w, td);
        if (dn->kind.tag != NodeKind::Decl) return none;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::Struct)
        {
            u32 i = 0;
            while (i < dd->kind.payload.Struct.fieldsLen)
            {
                Node* fn = wvNode(w, dd->kind.payload.Struct.fields[i]);
                if (fn->kind.tag == NodeKind::Field &&
                    fn->kind.payload.Field.value.name == name) return i;
                i++;
            }
            return none;
        }
        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = wvUnwrapTy(w, dd->kind.payload.TypeAlias.target); continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = wvUnwrapTy(w, dd->kind.payload.Distinct.baseType); continue; }
        return none;
    }
    return none;
}

/* address of element `idx` reached through `base`.
 *
 * byElement: base already points INTO an array (a local array slot or a
 * ptr-to-array's interior) — a plain gep strides by the array element
 * size, which wallvm's emitGep walks correctly.
 *
 * otherwise base points AT `pointee` (T*, a struct*, a slice's data
 * pointer): wallvm's emitGep silently DROPS the index when the pointee is
 * a scalar (the walk breaks out with offset 0). Retype the base as
 * [0 x pointee]* first, so the stride becomes sizeOf(pointee) — plain C
 * pointer arithmetic — and cast the result back to pointee*. */
pub IrValue* wvIndexAddr(Wv* w, IrValue* base, IrType* pointee, IrValue* idx, bool byElement)
{
    if (base == null || pointee == null || idx == null) return null;
    IrValue*[1] idxs;
    idxs[0] = idx;
    if (byElement) return wvV(w->b.gep(base, idxs, 1));
    IrType* arrT = w->ir->tyArray(pointee, 0);
    IrValue* bc = wvV(w->b.bitcast(base, w->ir->tyPtr(arrT)));
    if (bc == null) return null;
    IrValue* g = wvV(w->b.gep(bc, idxs, 1));
    if (g == null) return null;
    return wvV(w->b.bitcast(g, w->ir->tyPtr(pointee)));
}

/* gep to struct field `fi` of the aggregate at `base` */
pub IrValue* wvGepField(Wv* w, IrValue* base, u32 fi)
{
    if (base == null) return null;
    IrValue*[1] idxs;
    idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)fi);
    return wvV(w->b.gep(base, idxs, 1));
}

/* the address of an lvalue expression: local slot, deref pointee, or a
 * gep chain (field / tuple field / index). Used by plain assignment,
 * compound assignment and aggregate copies alike. */
pub IrValue* wvAddrOf(Wv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) { wvErr(w, id, "not an lvalue"); return null; }
    Expr* e = &n->kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::Ident => {
            IrValue* slot = wvFindLocal(w, e->kind.payload.Ident.name);
            if (slot == null)
                wvErr(w, id, "cannot assign to a non-local name (globals: Phase 2)");
            return slot;
        },
        ExprKind::Deref => { return wvExpr(w, e->kind.payload.Deref.expr); },
        ExprKind::Field | ExprKind::DerefField => {
            NodeId obj; Str fname;
            if (e->kind.tag == ExprKind::Field)
                { obj = e->kind.payload.Field.obj; fname = e->kind.payload.Field.field; }
            else
                { obj = e->kind.payload.DerefField.obj; fname = e->kind.payload.DerefField.field; }
            Node* on = wvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { wvErr(w, id, "field base is not an expression"); return null; }
            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
            IrValue* base; Ty sty;
            if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)
            {
                sty = (w->ctx->types + obt)->kind.payload.Pointer.base;
                base = wvExpr(w, obj); // the pointer value
            }
            else
            {
                sty = obt;
                base = wvAddrOf(w, obj); // address of the struct value
            }
            if (base == null) return null;
            u32 fi = wvFieldIdx(w, sty, fname);
            if (fi == 0xFFFFFFFF) { wvErr(w, id, "unknown struct field"); return null; }
            return wvGepField(w, base, fi);
        },
        ExprKind::TupleField => {
            NodeId obj = e->kind.payload.TupleField.obj;
            u32 ti = e->kind.payload.TupleField.index;
            Node* on = wvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { wvErr(w, id, "tuple base is not an expression"); return null; }
            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
            IrValue* base;
            if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)
                base = wvExpr(w, obj);
            else
                base = wvAddrOf(w, obj);
            return wvGepField(w, base, ti);
        },
        ExprKind::Index => {
            NodeId obj = e->kind.payload.Index.obj;
            NodeId ixId = e->kind.payload.Index.index;
            Node* on = wvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { wvErr(w, id, "index base is not an expression"); return null; }
            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
            IrValue* base = null;
            IrType* pointee = null;
            bool byElement = false;
            if (obt != 0)
            {
                TypeEntry* oe = w->ctx->types + obt;
                if (oe->kind.tag == TypeKind::Array)
                {
                    /* an array value: its address points at element 0 */
                    base = wvAddrOf(w, obj);
                    pointee = wvTy(w, oe->kind.payload.Array.base, 0);
                    byElement = true;
                }
                else if (oe->kind.tag == TypeKind::Pointer)
                {
                    /* p[i]: C pointer arithmetic steps sizeOf(pointee) */
                    base = wvExpr(w, obj);
                    Ty pe = wvUnwrapTy(w, oe->kind.payload.Pointer.base);
                    TypeEntry* peE = pe != 0 ? w->ctx->types + pe : null;
                    if (peE != null && peE->kind.tag == TypeKind::Array)
                        pointee = wvTy(w, pe, 0);           // whole-array step
                    else
                        pointee = wvTy(w, pe, 0);           // scalar/struct step
                }
                else if (oe->kind.tag == TypeKind::Slice || oe->kind.tag == TypeKind::Str)
                {
                    Ty et = oe->kind.tag == TypeKind::Slice
                        ? oe->kind.payload.Slice.base : (Ty)0;
                    IrType* eir = et != 0 ? wvTy(w, et, 0) : w->ir->tyInt(8);
                    IrValue* va = wvAddrOf(w, obj);
                    if (va == null) return null;
                    IrValue* pSlot = wvGepField(w, va, 0); // { ptr, len } layout
                    if (pSlot == null) return null;
                    base = wvV(w->b.load(w->ir->tyPtr(eir), pSlot));
                    pointee = eir;
                }
            }
            if (base == null || pointee == null)
                { wvErr(w, id, "unsupported index base"); return null; }
            IrValue* idx = wvExpr(w, ixId);
            if (idx == null) return null;
            return wvIndexAddr(w, base, pointee, idx, byElement);
        },
        ExprKind::StructLiteral => {
            Ty st = wvResolved(w, e->kind.payload.StructLiteral.typeNode);
            if (e->kind.payload.StructLiteral.variantName != 0)
                { wvErr(w, id, "variant construction (Phase 3)"); return null; }
            IrType* irt = st != 0 ? wvTy(w, st, 0) : null;
            if (irt == null || irt->kind != IrTypeKind::Struct)
                { wvErr(w, id, "struct literal needs a struct type"); return null; }
            IrValue* slot = wvV(w->b.alloca(irt));
            if (slot == null) return null;
            u32 i = 0;
            u32 n = e->kind.payload.StructLiteral.fieldValuesLen;
            Str* fnames = e->kind.payload.StructLiteral.fieldNames;
            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
            while (i < n)
            {
                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }
                u32 fi = wvFieldIdx(w, st, fnames[i]);
                if (fi == 0xFFFFFFFF || fi >= irt->nparams)
                    { wvErr(w, id, "unknown struct literal field"); return null; }
                IrValue* fa = wvGepField(w, slot, fi);
                if (fa == null) return null;
                IrType* ft = irt->params[fi];
                if (wvIsAgg(ft))
                {
                    IrValue* sv = wvAddrOf(w, fvals[i]);
                    if (sv == null) return null;
                    if (!wvCopyAgg(w, fa, sv, ft, 0)) return null;
                }
                else
                {
                    IrValue* v = wvExpr(w, fvals[i]);
                    if (v == null) return null;
                    w->b.store(v, fa);
                }
                i++;
            }
            return slot;
        },
        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            Ty at = wvResolved(w, e->resolvedType);
            IrType* irt = at != 0 ? wvTy(w, at, 0) : null;
            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))
                { wvErr(w, id, "array/tuple literal needs an aggregate type"); return null; }
            IrValue* slot = wvV(w->b.alloca(irt));
            if (slot == null) return null;
            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;
            u32 n = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;
            u32 i = 0;
            while (i < n)
            {
                if (elems == null || elems[i].index == 0) { i++; continue; }
                if (irt->kind == IrTypeKind::Array && i >= irt->count) { i++; continue; }
                IrValue*[1] idxs;
                idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
                IrValue* ea = wvV(w->b.gep(slot, idxs, 1));
                if (ea == null) return null;
                IrType* et = irt->kind == IrTypeKind::Array ? irt->elem
                    : (i < irt->nparams ? irt->params[i] : null);
                if (et == null) { i++; continue; }
                if (wvIsAgg(et))
                {
                    IrValue* sv = wvAddrOf(w, elems[i]);
                    if (sv == null) return null;
                    if (!wvCopyAgg(w, ea, sv, et, 0)) return null;
                }
                else
                {
                    IrValue* v = wvExpr(w, elems[i]);
                    if (v == null) return null;
                    w->b.store(v, ea);
                }
                i++;
            }
            return slot;
        },
        else => { wvErr(w, id, "unsupported assignment target"); return null; },
    }
}

/* element-wise aggregate copy through addresses (structs/arrays are never
 * register values in this lowering — see the aggregate rule in expr.crl) */
pub bool wvCopyAgg(Wv* w, IrValue* dst, IrValue* src, IrType* ty, u32 depth)
{
    if (dst == null || src == null || ty == null) return false;
    if (depth > 16) { wvErr(w, NodeId{ .index = 0 }, "aggregate copy too deep"); return false; }
    if (ty->kind == IrTypeKind::Struct)
    {
        u32 i = 0;
        while (i < ty->nparams)
        {
            IrValue* d = wvGepField(w, dst, i);
            IrValue* s = wvGepField(w, src, i);
            if (d == null || s == null) return false;
            if (!wvCopyAgg(w, d, s, ty->params[i], depth + 1)) return false;
            i++;
        }
        return true;
    }
    if (ty->kind == IrTypeKind::Array || ty->kind == IrTypeKind::Vector)
    {
        u32 i = 0;
        while (i < ty->count)
        {
            IrValue*[1] idxs;
            idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
            IrValue* d = wvV(w->b.gep(dst, idxs, 1));
            IrValue* s = wvV(w->b.gep(src, idxs, 1));
            if (d == null || s == null) return false;
            if (!wvCopyAgg(w, d, s, ty->elem, depth + 1)) return false;
            i++;
        }
        return true;
    }
    /* scalar: wallvm loads at most 8 bytes into one register */
    u32 sz = w->ir->irTypeSizeOf(ty);
    if (sz == 0 || sz > 8)
    {
        wvErr(w, NodeId{ .index = 0 }, "scalar wider than 8 bytes in aggregate copy (Phase 2)");
        return false;
    }
    IrValue* v = wvV(w->b.load(ty, src));
    if (v == null) return false;
    w->b.store(v, dst);
    return true;
}

/* compound-assignment operator: op is the Coral source operator
 * ("+=", "-=", ...); cur is the loaded lhs, rhs the evaluated rhs.
 * Returns the stored result. */
pub IrValue* wvCompoundOp(Wv* w, str op, IrValue* cur, IrValue* rhs, Ty ct, NodeId id)
{
    if (cur == null || rhs == null) return null;
    ExprKind k;
    if (op.equals("+=")) k.tag = ExprKind::Add;
    else if (op.equals("-=")) k.tag = ExprKind::Sub;
    else if (op.equals("*=")) k.tag = ExprKind::Mul;
    else if (op.equals("/=")) k.tag = ExprKind::Div;
    else if (op.equals("%=")) k.tag = ExprKind::Mod;
    else if (op.equals("&=")) k.tag = ExprKind::BitAnd;
    else if (op.equals("|=")) k.tag = ExprKind::BitOr;
    else if (op.equals("^=")) k.tag = ExprKind::BitXor;
    else if (op.equals("<<=")) k.tag = ExprKind::Shl;
    else if (op.equals(">>=")) k.tag = ExprKind::Shr;
    else { wvErr(w, id, "unsupported assignment operator"); return null; }
    return wvArithVals(w, k, cur, rhs, id, ct);
}

/* one assignment: address the target, then store (plain) or
 * load–combine–store (compound). Aggregates copy element-wise. Shared by
 * the ExprKind::Assign* family and StmtKind::Assign. Returns the stored
 * value, or null (void / aggregate / error). */
pub IrValue* wvAssignCommon(Wv* w, NodeId target, NodeId value, str op, NodeId id)
{
    IrValue* addr = wvAddrOf(w, target);
    if (addr == null) return null;
    Node* tn = wvNode(w, target);
    Ty tgtTy = tn->kind.tag == NodeKind::Expr
        ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
    IrType* vt = tgtTy != 0 ? wvTy(w, tgtTy, 0) : null;
    if (vt == null || vt->kind == IrTypeKind::Void)
        { wvErr(w, id, "cannot type assignment target"); return null; }

    if (op.equals("="))
    {
        if (wvIsAgg(vt))
        {
            IrValue* src = wvAddrOf(w, value);
            if (src == null) return null;
            if (!wvCopyAgg(w, addr, src, vt, 0)) return null;
            return null;
        }
        IrValue* val = wvExpr(w, value);
        if (val == null) return null;
        w->b.store(val, addr);
        return val;
    }
    if (wvIsAgg(vt)) { wvErr(w, id, "compound assign on aggregate (Phase 2)"); return null; }
    IrValue* cur = wvV(w->b.load(vt, addr));
    IrValue* rhs = wvExpr(w, value);
    IrValue* res = wvCompoundOp(w, op, cur, rhs, tgtTy, id);
    if (res == null) return null;
    w->b.store(res, addr);
    return res;
}


pub IrValue* wvExpr(Wv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Expr)
    {
        wvErr(w, id, "expected expression node");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    Ty rt = wvResolved(w, e->resolvedType);
    switch (e->kind.tag)
    {
        ExprKind::IntLit => {
            IrType* it = rt != 0 ? wvTy(w, rt, 0)
                                 : w->ir->tyInt(32);
            return w->ir->constInt(it, e->kind.payload.IntLit.value);
        },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(w->ir->tyInt(1), v);
        },
        ExprKind::CharLit => {
            return w->ir->constInt(w->ir->tyInt(8), (u64)e->kind.payload.CharLit.value);
        },
        ExprKind::NullLit => {
            return w->ir->constInt(w->ir->tyPtr(w->ir->tyInt(8)), 0);
        },
        ExprKind::FloatLit => {
            /* strtod on a NUL-terminated arena copy of the literal text */
            str s = wvStr(w, e->kind.payload.FloatLit.value);
            rawptr buf = w->arena->alloc(s.len + 1, 1);
            if (buf == null) return null;
            u8* bp = (u8*)buf;
            usize i = 0;
            while (i < s.len) { bp[i] = s.ptr[i]; i++; }
            bp[s.len] = 0;
            f64 d = strtod((const cchar*)bp, null);
            IrType* ft = w->ir->tyDouble();
            if (rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::F32)
                ft = w->ir->tyFloat();
            IrValue* dv = w->ir->constFloat(w->ir->tyDouble(), d);
            if (ft->width == 32) return wvV(w->b.fpTrunc(dv, ft));
            return dv;
        },
        ExprKind::StringLit => {
            wvErr(w, id, "string literals: Phase 2 (needs global data, wallvm G29)");
            return null;
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = wvFindLocal(w, name);
            if (slot != null)
            {
                IrType* vt = wvTy(w, rt, 0);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                if (wvIsAgg(vt))
                {
                    wvErr(w, id, "aggregate value in value position (Phase 2: struct/str args & returns)");
                    return null;
                }
                return wvV(w->b.load(vt, slot));
            }
            wvErr(w, id, "unresolved identifier (globals: Phase 2)");
            return null;
        },
        ExprKind::Field | ExprKind::DerefField | ExprKind::TupleField |
        ExprKind::Index => {
            IrValue* addr = wvAddrOf(w, id);
            if (addr == null) return null;
            IrType* vt = wvTy(w, rt, 0);
            if (vt == null || vt->kind == IrTypeKind::Void) return null;
            if (wvIsAgg(vt))
            {
                wvErr(w, id, "aggregate value in value position (Phase 2: struct/str args & returns)");
                return null;
            }
            return wvV(w->b.load(vt, addr));
        },
        ExprKind::Assign | ExprKind::AssignAdd | ExprKind::AssignSub |
        ExprKind::AssignMul | ExprKind::AssignDiv | ExprKind::AssignMod |
        ExprKind::AssignBitAnd | ExprKind::AssignBitOr | ExprKind::AssignBitXor |
        ExprKind::AssignShl | ExprKind::AssignShr => {
            NodeId target; NodeId value;
            str op = "=";
            if (e->kind.tag == ExprKind::Assign)
                { target = e->kind.payload.Assign.target; value = e->kind.payload.Assign.value; }
            else if (e->kind.tag == ExprKind::AssignAdd)
                { target = e->kind.payload.AssignAdd.target; value = e->kind.payload.AssignAdd.value; op = "+="; }
            else if (e->kind.tag == ExprKind::AssignSub)
                { target = e->kind.payload.AssignSub.target; value = e->kind.payload.AssignSub.value; op = "-="; }
            else if (e->kind.tag == ExprKind::AssignMul)
                { target = e->kind.payload.AssignMul.target; value = e->kind.payload.AssignMul.value; op = "*="; }
            else if (e->kind.tag == ExprKind::AssignDiv)
                { target = e->kind.payload.AssignDiv.target; value = e->kind.payload.AssignDiv.value; op = "/="; }
            else if (e->kind.tag == ExprKind::AssignMod)
                { target = e->kind.payload.AssignMod.target; value = e->kind.payload.AssignMod.value; op = "%="; }
            else if (e->kind.tag == ExprKind::AssignBitAnd)
                { target = e->kind.payload.AssignBitAnd.target; value = e->kind.payload.AssignBitAnd.value; op = "&="; }
            else if (e->kind.tag == ExprKind::AssignBitOr)
                { target = e->kind.payload.AssignBitOr.target; value = e->kind.payload.AssignBitOr.value; op = "|="; }
            else if (e->kind.tag == ExprKind::AssignBitXor)
                { target = e->kind.payload.AssignBitXor.target; value = e->kind.payload.AssignBitXor.value; op = "^="; }
            else if (e->kind.tag == ExprKind::AssignShl)
                { target = e->kind.payload.AssignShl.target; value = e->kind.payload.AssignShl.value; op = "<<="; }
            else
                { target = e->kind.payload.AssignShr.target; value = e->kind.payload.AssignShr.value; op = ">>="; }
            return wvAssignCommon(w, target, value, op, id);
        },
        ExprKind::PostInc | ExprKind::PostDec | ExprKind::PreInc |
        ExprKind::PreDec => {
            NodeId tgt = e->kind.payload.PostInc.expr;
            IrValue* addr = wvAddrOf(w, tgt);
            if (addr == null) return null;
            Node* tn = wvNode(w, tgt);
            Ty tt = tn->kind.tag == NodeKind::Expr
                ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
            IrType* vt = tt != 0 ? wvTy(w, tt, 0) : null;
            if (vt == null || wvIsAgg(vt)) { wvErr(w, id, "increment target is not scalar"); return null; }
            IrValue* cur = wvV(w->b.load(vt, addr));
            bool dec = e->kind.tag == ExprKind::PostDec || e->kind.tag == ExprKind::PreDec;
            IrValue* nv;
            if (vt->kind == IrTypeKind::Float)
            {
                IrValue* one = w->ir->constFloat(vt, 1.0);
                nv = wvV(dec ? w->b.fsub(cur, one) : w->b.fadd(cur, one));
            }
            else
            {
                IrValue* one = w->ir->constInt(vt, 1);
                nv = wvV(dec ? w->b.sub(cur, one) : w->b.add(cur, one));
            }
            if (nv == null) return null;
            w->b.store(nv, addr);
            bool post = e->kind.tag == ExprKind::PostInc || e->kind.tag == ExprKind::PostDec;
            return post ? cur : nv;
        },
        ExprKind::Ternary => {
            IrValue* c = wvCond(w, wvExpr(w, e->kind.payload.Ternary.cond));
            if (c == null) return null;
            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;
            if (vt == null || vt->kind == IrTypeKind::Void)
            {
                /* void ternary: lower both arms as statements */
                IrBlock* tBb = wvBlock(w, "sel.then");
                IrBlock* fBb = wvBlock(w, "sel.else");
                IrBlock* jBb = wvBlock(w, "sel.end");
                w->b.condBr(c, tBb, fBb);
                wvSetBlock(w, tBb);
                wvExpr(w, e->kind.payload.Ternary.thenExpr);
                if (!w->term) w->b.br(jBb);
                wvSetBlock(w, fBb);
                wvExpr(w, e->kind.payload.Ternary.elseExpr);
                if (!w->term) w->b.br(jBb);
                wvSetBlock(w, jBb);
                return null;
            }
            if (wvIsAgg(vt)) { wvErr(w, id, "aggregate ternary (Phase 2)"); return null; }
            IrValue* slot = wvV(w->b.alloca(vt));
            if (slot == null) return null;
            IrBlock* tBb = wvBlock(w, "sel.then");
            IrBlock* fBb = wvBlock(w, "sel.else");
            IrBlock* jBb = wvBlock(w, "sel.end");
            w->b.condBr(c, tBb, fBb);
            wvSetBlock(w, tBb);
            IrValue* tv = wvExpr(w, e->kind.payload.Ternary.thenExpr);
            if (tv != null) w->b.store(tv, slot);
            w->b.br(jBb);
            wvSetBlock(w, fBb);
            IrValue* fv = wvExpr(w, e->kind.payload.Ternary.elseExpr);
            if (fv != null) w->b.store(fv, slot);
            w->b.br(jBb);
            wvSetBlock(w, jBb);
            return wvV(w->b.load(vt, slot));
        },
        ExprKind::Call => { return wvCall(w, e, id); },
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr => {
            Expr* le = &wvNode(w, e->kind.payload.Add.left)->kind.payload.Expr.value;
            return wvBinaryArith(w, e->kind, e->kind.payload.Add.left,
                                 e->kind.payload.Add.right, id, le->resolvedType);
        },
        ExprKind::Eq | ExprKind::Ne | ExprKind::Lt | ExprKind::Le |
        ExprKind::Gt | ExprKind::Ge => {
            Expr* le = &wvNode(w, e->kind.payload.Eq.left)->kind.payload.Expr.value;
            return wvCompare(w, e->kind, e->kind.payload.Eq.left,
                             e->kind.payload.Eq.right, id, le->resolvedType);
        },
        ExprKind::And | ExprKind::Or => { return wvShortCircuit(w, e, id); },
        ExprKind::Neg => {
            IrValue* v = wvExpr(w, e->kind.payload.Neg.expr);
            if (v == null) return null;
            if (rt != 0)
            {
                TypeEntry* te = w->ctx->types + rt;
                if (te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64)
                    return wvV(w->b.fsub(w->ir->constInt(v->type, 0), v));
            }
            return wvV(w->b.neg(v));
        },
        ExprKind::Not => {
            IrValue* v = wvExpr(w, e->kind.payload.Not.expr);
            if (v == null) return null;
            return wvV(w->b.xorOp(v, w->ir->constInt(v->type, 1)));
        },
        ExprKind::BitNot => {
            IrValue* v = wvExpr(w, e->kind.payload.BitNot.expr);
            if (v == null) return null;
            return wvV(w->b.notOp(v));
        },
        ExprKind::AddressOf => {
            NodeId tgt = e->kind.payload.AddressOf.expr;
            Node* tn = wvNode(w, tgt);
            if (tn->kind.tag == NodeKind::Expr)
            {
                Expr* te = &tn->kind.payload.Expr.value;
                if (te->kind.tag == ExprKind::Ident)
                {
                    IrValue* slot = wvFindLocal(w, te->kind.payload.Ident.name);
                    if (slot != null) return slot;
                }
            }
            wvErr(w, id, "address-of target: only locals supported (Phase 1)");
            return null;
        },
        ExprKind::Deref => {
            IrValue* v = wvExpr(w, e->kind.payload.Deref.expr);
            if (v == null) return null;
            IrType* vt = wvTy(w, rt, 0);
            return wvV(w->b.load(vt, v));
        },
        ExprKind::Cast => {
            IrValue* v = wvExpr(w, e->kind.payload.Cast.expr);
            if (v == null) return null;
            Ty tgt = wvResolved(w, e->kind.payload.Cast.targetType);
            IrType* dt = wvTy(w, tgt, 0);
            Expr* se = &wvNode(w, e->kind.payload.Cast.expr)->kind.payload.Expr.value;
            bool su = wvTyUnsigned(w, se->resolvedType);
            bool du = wvTyUnsigned(w, e->kind.payload.Cast.targetType);
            return wvCast(w, v, v->type, dt, su, du);
        },
        ExprKind::Sizeof => {
            IrType* st = wvTy(w, wvResolved(w, e->kind.payload.Sizeof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeSizeOf(st));
        },
        ExprKind::Alignof => {
            IrType* at = wvTy(w, wvResolved(w, e->kind.payload.Alignof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeAlignOf(at));
        },
        else => {
            wvErr(w, id, "unsupported expression (Phase 1)");
            return null;
        },
    }
}
