#[[no_drop_all]]
/* coral-ir/expr.crl — expression lowering
 *
 * Phase 1: integer/float literals, arithmetic, comparisons, boolean
 * logic, locals, direct calls, address-of/deref, casts, sizeof. Returns
 * the IrValue* for the expression; null on void/unhandled. Unhandled
 * forms report G0001. Callee resolution goes through the sema scope
 * stack (lookupFrom) → declId → the collection pass's fn map — no
 * per-reference re-mangling, no linear decl scans. */
import lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvSubstTy, wvFindLocal,
               wvPushLocal, wvFnMapGet, wvFnMapPut, wvGMapGet, wvGMapPut, wvBlock,
               wvSetBlock, wvTerm, wvPos, wvArr, wvMbCh, wvMbStr };
import types { wvTy, wvFindTypeDecl, wvTyHasParam };
import decl { wvMangle, wvDeclareFunc, wvDeclareMethod, wvMethodSelfKind,
               wvOwnerStr, wvMethodMangle };
import stmt { wvStmt, wvSwitchCore };
import context::context { AstContext };
import mono::mono { MonoContext, MonoInstance };
import sem { scope { Symbol, ScopeStack } };
import ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind, SwitchCase },
    decl { Decl, DeclKind, Field, Param, File }
};
import common::slice { Slice };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrStringConst, IrGlobal };
import(lib) wallvm::irOps { IrICmpPred, IrFCmpPred };
import(lib) wallvm::irBuilder { IrBuilder };
import(lib) std::mman { alloc, dealloc, copy };
import(lib) platform::libc { strtod };
import(lib) core::cchar { cchar };

/* builder ops return IrInst*; the SSA value is the instruction's base */
pub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }

/* is the resolved Coral type an unsigned integer? (drives signedness of
 * div/rem/shr/casts — wallvm IrType carries no signed flag) */
pub bool wvTyUnsigned(Wv* w, Ty t)
{
    Ty rt = wvResolved(w, t);
    if (rt == 0) return false;
    TypeEntry* te = w->ctx->types + rt;
    switch (te.kind.tag)
    {
        TypeKind::U8 | TypeKind::U16 | TypeKind::U32 | TypeKind::U64 |
        TypeKind::U128 | TypeKind::Usize | TypeKind::Char | TypeKind::Bool =>
            { return true; },
        else => { return false; },
    }
}

pub IrValue* wvExpr(Wv* w, NodeId id);


/* the silent half of callee resolution: sema scope lookup → declId →
 * the collection pass's IrFunc, or a shell for an extern the pass never
 * saw. Null when the name is not a function at all — callers that probe
 * (a value that may be a function or a variable) must not report. */
pub IrFunc* wvLookupFunc(Wv* w, Str name, NodeId refSite)
{
    if (name == 0) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    if (w->sema == null || w->sema.scopes == null) return null;
    Symbol* sym = w->sema.scopes.lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return null;
    IrFunc* f = wvFnMapGet(w, sym->declaration.index);
    if (f != null) return f;
    Node* sn = wvNode(w, sym->declaration);
    if (sn->kind.tag == NodeKind::Decl)
    {
        Decl* sd = &sn->kind.payload.Decl.value;
        if (sd->kind.tag == DeclKind::Func)
        {
            IrFunc* shell = wvDeclareFunc(w, sym->declaration, sd);
            /* keep the shell: a second reference reuses it instead of
             * minting another IrFunc of the same symbol */
            if (shell != null) wvFnMapPut(w, sym->declaration.index, shell);
            return shell;
        }
    }
    return null;
}

/* the Func decl named `name` declared in file `refFile` (first match
 * when the file has none) — the module-qualified call's lookup, after
 * cgFindDeclFrom. */
NodeId wvFindFuncDeclFrom(Wv* w, Str name, u32 refFile)
{
    NodeId first;
    first.index = 0;
    if (w->file == null || name == 0) return first;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId id = file->decls[i];
        Node* n = wvNode(w, id);
        if (n->kind.tag == NodeKind::Decl &&
            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)
        {
            Decl* dd = &n->kind.payload.Decl.value;
            if (dd->kind.payload.Func.name == name)
            {
                if (refFile != 0 && locFile(n->loc) == refFile) return id;
                if (first.index == 0) first = id;
            }
        }
        i++;
    }
    return first;
}

/* a module path (`std::fs`) → the diagnostic file id of its source:
 * `::` becomes `/`, `.crl` is appended when missing, then suffix-matched
 * against sema's file table (mirror of cgFileForModulePath). */
u32 wvFileForModulePath(Wv* w, Str path)
{
    if (path == 0 || w->sema == null || w->sema.diag == null) return 0;
    if (w->sema.diag.fileCount == 0) return 0;
    str p = wvStr(w, path);
    if (p.len == 0) return 0;
    bool hasCrl = p.len >= 4 && p.ptr[p.len - 4] == 46 && p.ptr[p.len - 3] == 99 &&
                  p.ptr[p.len - 2] == 114 && p.ptr[p.len - 1] == 108;
    usize n = p.len + (hasCrl ? 0 : 4);
    u8* buf = (u8*)wvArr(w, n, 1);
    if (buf == null) return 0;
    usize j = 0;
    usize k = 0;
    while (j < p.len)
    {
        if (j + 1 < p.len && p.ptr[j] == 58 && p.ptr[j + 1] == 58)
            { buf[k] = 47; k++; j += 2; } // "::" → '/'
        else { buf[k] = p.ptr[j]; k++; j++; }
    }
    if (!hasCrl) { buf[k] = 46; buf[k + 1] = 99; buf[k + 2] = 114; buf[k + 3] = 108; }
    u32 f = 0;
    while (f < w->sema.diag.fileCount)
    {
        str fp = w->sema.diag.filePaths.at((usize)f);
        if (fp.ptr != null && fp.len >= n)
        {
            bool ok = true;
            usize q = 0;
            while (q < n)
            {
                if (fp.ptr[fp.len - n + q] != buf[q]) { ok = false; break; }
                q++;
            }
            if (ok) return f;
        }
        f++;
    }
    return 0;
}

/* `root::name(...)`: resolve through the module namespace the root
 * names — import symbol → its source file → the Func declared there.
 * Null when the root is not a module (the caller tries the next form). */
IrFunc* wvLookupPathModule(Wv* w, Str root, Str fname, NodeId refSite)
{
    if (root == 0 || fname == 0 || w->sema == null || w->sema.scopes == null) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* rsym = w->sema.scopes.lookupFrom(root, refFile);
    if (rsym == null || rsym->kind != 5 || rsym->declaration.index == 0) return null;
    Node* imn = wvNode(w, rsym->declaration);
    if (imn->kind.tag != NodeKind::Decl) return null;
    Decl* imd = &imn->kind.payload.Decl.value;
    Str mpath = 0;
    if (imd->kind.tag == DeclKind::Import) mpath = imd->kind.payload.Import.path;
    else if (imd->kind.tag == DeclKind::ModReexport) mpath = imd->kind.payload.ModReexport.path;
    else return null;
    u32 mf = wvFileForModulePath(w, mpath);
    if (mf == 0) return null;
    NodeId md = wvFindFuncDeclFrom(w, fname, mf);
    if (md.index == 0) return null;
    IrFunc* f = wvFnMapGet(w, md.index);
    if (f != null) return f;
    Node* fdn = wvNode(w, md);
    if (fdn->kind.tag != NodeKind::Decl) return null;
    Decl* fd = &fdn->kind.payload.Decl.value;
    if (fd->kind.tag != DeclKind::Func) return null;
    f = wvDeclareFunc(w, md, fd);
    if (f == null) return null;
    w->mod.addFunc(f);
    wvFnMapPut(w, md.index, f);
    return f;
}

/* `Owner::method(...)`: the declaring node of a method whose owner
 * text matches (the def side composes the same `owner_method` symbol).
 * Generic owners are skipped — mono does not reach methods yet. */
pub NodeId wvFindMethodDeclOwner(Wv* w, Str owner, Str methName)
{
    NodeId none;
    none.index = 0;
    if (owner == 0 || methName == 0 || w->file == null) return none;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        Node* d = wvNode(w, file->decls[i]);
        if (d->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d->kind.payload.Decl.value;
            Str ow = 0;
            NodeId* methods = null;
            u32 mlen = 0;
            if (dd->kind.tag == DeclKind::Struct)
            {
                if (dd->kind.payload.Struct.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Struct.name;
                methods = dd->kind.payload.Struct.methods;
                mlen = dd->kind.payload.Struct.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Union)
            {
                if (dd->kind.payload.Union.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Union.name;
                methods = dd->kind.payload.Union.methods;
                mlen = dd->kind.payload.Union.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Variant)
            {
                if (dd->kind.payload.Variant.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Variant.name;
                methods = dd->kind.payload.Variant.methods;
                mlen = dd->kind.payload.Variant.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Extend)
            {
                if (dd->kind.payload.Extend.genericParamsLen != 0) { i++; continue; }
                if (wvTyHasParam(w, dd->kind.payload.Extend.selfType, 0)) { i++; continue; }
                ow = wvOwnerStr(w, dd->kind.payload.Extend.selfType);
                methods = dd->kind.payload.Extend.methods;
                mlen = dd->kind.payload.Extend.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::ExtendTrait)
            {
                if (dd->kind.payload.ExtendTrait.genericParamsLen != 0) { i++; continue; }
                if (wvTyHasParam(w, dd->kind.payload.ExtendTrait.selfType, 0)) { i++; continue; }
                ow = wvOwnerStr(w, dd->kind.payload.ExtendTrait.selfType);
                methods = dd->kind.payload.ExtendTrait.methods;
                mlen = dd->kind.payload.ExtendTrait.methodsLen;
            }
            else { i++; continue; }
            if (ow == owner && methods != null)
            {
                u32 m = 0;
                while (m < mlen)
                {
                    Node* mn = wvNode(w, methods[m]);
                    if (mn->kind.tag == NodeKind::Decl &&
                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                        mn->kind.payload.Decl.value.kind.payload.Func.name == methName)
                        return methods[m];
                    m++;
                }
            }
        }
        i++;
    }
    return none;
}

/* a `root::name(...)` callee: module function, then static method on
 * an owner type, then the bare name as a last resort (the order the C
 * backend resolves in). Null only after the last form also fails to
 * name a function — that failure is reported by the bare resolver. */
IrFunc* wvResolveCalleePath(Wv* w, NodeId calleeId, NodeId refSite)
{
    Node* cn = wvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr) return null;
    Expr* ce = &cn->kind.payload.Expr.value;
    NodeId* segs = ce->kind.payload.Path.segments;
    u32 sn = ce->kind.payload.Path.segmentsLen;
    if (sn == 0) return null;
    if (sn >= 2)
    {
        Node* s0 = wvNode(w, segs[0]);
        Node* sl = wvNode(w, segs[sn - 1]);
        if (s0->kind.tag == NodeKind::Expr && sl->kind.tag == NodeKind::Expr &&
            s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
            sl->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        {
            Str root = s0->kind.payload.Expr.value.kind.payload.Ident.name;
            Str fname = sl->kind.payload.Expr.value.kind.payload.Ident.name;
            IrFunc* f = wvLookupPathModule(w, root, fname, refSite);
            if (f != null) return f;
            NodeId mdef = wvFindMethodDeclOwner(w, root, fname);
            if (mdef.index != 0)
            {
                if (w->mono != null && w->mono.genericCount(mdef) != 0)
                    { wvErr(w, refSite, "call to a generic method (Phase 2)"); return null; }
                if (wvMethodSelfKind(w, mdef) != 0)
                    { wvErr(w, refSite, "instance method needs a receiver expression"); return null; }
                f = wvFnMapGet(w, mdef.index);
                if (f != null) return f;
                Node* mn = wvNode(w, mdef);
                if (mn->kind.tag != NodeKind::Decl) return null;
                Decl* md = &mn->kind.payload.Decl.value;
                if (md->kind.tag != DeclKind::Func) return null;
                str msym = wvMethodMangle(w, mdef, root, fname);
                if (msym.len == 0) return null;
                f = wvDeclareMethod(w, mdef, md, msym, null);
                if (f == null) return null;
                w->mod.addFunc(f);
                wvFnMapPut(w, mdef.index, f);
                return f;
            }
        }
    }
    /* last segment as a plain name */
    Node* sl2 = wvNode(w, segs[sn - 1]);
    if (sl2->kind.tag == NodeKind::Expr &&
        sl2->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        return wvResolveCallee(w, sl2->kind.payload.Expr.value.kind.payload.Ident.name, refSite);
    return null;
}

/* resolve a bare-name call target. Null means the name is not a
 * function — reported here because every call site wants that said. */
pub IrFunc* wvResolveCallee(Wv* w, Str name, NodeId refSite)
{
    IrFunc* f = wvLookupFunc(w, name, refSite);
    if (f == null) wvErr(w, refSite, "unresolved call target");
    return f;
}

/* resolve a bare name to a file-scope constant declaration: sema scope
 * lookup (the same walk calls use) → declId, kept only when it really
 * is a constant. Null when the name is not one — the caller decides
 * whether that is an error or falls through to another resolution. */
pub NodeId wvResolveConst(Wv* w, Str name, NodeId refSite)
{
    NodeId none;
    none.index = 0;
    if (name == 0 || w->sema == null || w->sema.scopes == null) return none;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* sym = w->sema.scopes.lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return none;
    Node* sn = wvNode(w, sym->declaration);
    if (sn->kind.tag != NodeKind::Decl) return none;
    if (sn->kind.payload.Decl.value.kind.tag != DeclKind::Constant) return none;
    /* a name that keeps storage (`var`, `static`, `extern`) is not a
     * value to fold — references reach its global through the map */
    if ((sn->kind.payload.Decl.value.kind.payload.Constant.flags & 16) == 0) return none;
    return sym->declaration;
}

/* a name that keeps storage → its address value. The collection pass
 * registered one IrGlobal per declaring node, so the sema symbol's
 * declaration indexes straight into that map. */
pub IrValue* wvResolveGlobal(Wv* w, Str name, NodeId refSite)
{
    if (name == 0 || w->sema == null || w->sema.scopes == null) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = wvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* sym = w->sema.scopes.lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return null;
    IrGlobal* g = wvGMapGet(w, sym->declaration.index);
    if (g == null) return null;
    return &g->base;
}

/* strtod over a NUL-terminated arena copy of the literal text */
pub f64 wvParseFloat(Wv* w, Str value)
{
    str sv = wvStr(w, value);
    if (w->arena == null) return 0;
    rawptr buf = w->arena->alloc(sv.len + 1, 1);
    if (buf == null) return 0;
    u8* bp = (u8*)buf;
    usize i = 0;
    while (i < sv.len) { bp[i] = sv.ptr[i]; i++; }
    bp[sv.len] = 0;
    return strtod((const cchar*)bp, null);
}

/* the f64 a ConstFloat carries, read back out of its raw bits */
f64 wvConstFloatBits(IrValue* v)
{
    f64 d = 0;
    copy<u8>((u8*)&d, (u8*)&v->valData, 8);
    return d;
}

pub IrValue* wvConstInit(Wv* w, NodeId initId, IrType* dt);

/* fold an initializer and read it back as an integer / an f64. Both
 * answer false without touching `out` when the node does not fold that
 * way — the caller then reports. */
bool wvConstU64(Wv* w, NodeId id, IrType* dt, u64* out)
{
    IrValue* v = wvConstInit(w, id, dt);
    if (v == null || v->kind != IrValueKind::ConstInt) return false;
    *out = v->valData;
    return true;
}

bool wvConstF64(Wv* w, NodeId id, IrType* dt, f64* out)
{
    IrValue* v = wvConstInit(w, id, dt);
    if (v == null || v->kind != IrValueKind::ConstFloat) return false;
    *out = wvConstFloatBits(v);
    return true;
}

/* compile-time initializer for static storage: literals, their negation
 * and a cast over either fold into an IrValue of the storage's own type;
 * anything else would need code at load time (Phase 3). */
pub IrValue* wvConstInit(Wv* w, NodeId initId, IrType* dt)
{
    if (initId.index == 0 || dt == null) return null;
    Node* n = wvNode(w, initId);
    if (n->kind.tag != NodeKind::Expr)
    {
        wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::IntLit => { return w->ir->constInt(dt, e->kind.payload.IntLit.value); },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(dt, v);
        },
        ExprKind::CharLit => { return w->ir->constInt(dt, (u64)e->kind.payload.CharLit.value); },
        ExprKind::NullLit => { return w->ir->constInt(dt, 0); },
        ExprKind::FloatLit => {
            return w->ir->constFloat(dt, wvParseFloat(w, e->kind.payload.FloatLit.value));
        },
        ExprKind::Neg => {
            IrValue* v = wvConstInit(w, e->kind.payload.Neg.expr, dt);
            if (v == null) return null;
            if (v->kind == IrValueKind::ConstFloat)
            {
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&v->valData, 8);
                return w->ir->constFloat(dt, -d);
            }
            return w->ir->constInt(dt, (u64)(0 - (i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL)));
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            /* a function reference is its symbol address */
            IrFunc* f = wvLookupFunc(w, name, initId);
            if (f != null) return &f->base;
            /* another name that keeps storage: its address */
            IrValue* gv = wvResolveGlobal(w, name, initId);
            if (gv != null) return gv;
            /* a plain constant folds to its own initializer */
            NodeId cd = wvResolveConst(w, name, initId);
            if (cd.index != 0)
            {
                Node* cn = wvNode(w, cd);
                NodeId inner = cn->kind.payload.Decl.value.kind.payload.Constant.value;
                if (inner.index != 0) return wvConstInit(w, inner, dt);
            }
            wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
            return null;
        },
        ExprKind::StringLit => {
            str tok = wvStr(w, e->kind.payload.StringLit.value);
            bool isC = (e->kind.payload.StringLit.flags & 1) != 0;
            usize begin = 0;
            usize end = tok.len;
            if (isC)
            {
                if (tok.len >= 3 && tok.ptr[0] == 67 && tok.ptr[1] == 34)
                    { begin = 2; end = tok.len - 1; }
            }
            else if (tok.len >= 2 && tok.ptr[0] == 34)
                { begin = 1; end = tok.len - 1; }
            u8* buf = (u8*)wvArr(w, (end - begin) + 4, 1);
            if (buf == null) { wvErr(w, initId, "string literal buffer"); return null; }
            usize dlen = wvDecodeLit(tok, begin, end, buf);
            str bytes = str::fromParts(buf, dlen);
            IrStringConst* sc = w->mod->findConstString(bytes, (u32)dlen);
            if (sc == null)
            {
                sc = w->ir->createStringConst(bytes, (u32)dlen);
                if (sc == null) { wvErr(w, initId, "string constant creation failed"); return null; }
                w->mod->addConstString(sc);
            }
            if (isC) return &sc->base;
            /* a `str` is { ptr, len } laid out statically */
            Ty rt = wvResolved(w, e->resolvedType);
            IrType* st = rt != 0 ? wvTy(w, rt, 0) : null;
            if (st == null || st->kind != IrTypeKind::Struct)
                { wvErr(w, initId, "str literal needs the str type"); return null; }
            IrValue*[2] parts;
            parts[0] = &sc->base;
            parts[1] = w->ir->constInt(w->ir->tyInt(64), (u64)dlen);
            return w->ir->createStructConst(st, parts, 2);
        },
        ExprKind::StructLiteral => {
            if (e->kind.payload.StructLiteral.variantName != 0)
                { wvErr(w, initId, "variant construction in static storage (Phase 3)"); return null; }
            Ty stw = wvResolved(w, e->kind.payload.StructLiteral.typeNode);
            /* the storage's own type decides the layout; the literal's
             * type node only gives the field names their order */
            IrType* irt = dt->kind == IrTypeKind::Struct ? dt
                          : (stw != 0 ? wvTy(w, stw, 0) : null);
            if (irt == null || irt->kind != IrTypeKind::Struct)
                { wvErr(w, initId, "struct literal needs a struct type"); return null; }
            u32 n = irt->nparams;
            IrValue** fields = (IrValue**)wvArr(w, (usize)n, 8);
            if (fields == null) return null;
            u32 z = 0;
            while (z < n) { fields[z] = null; z++; }
            u32 i = 0;
            u32 m = e->kind.payload.StructLiteral.fieldValuesLen;
            Str* fnames = e->kind.payload.StructLiteral.fieldNames;
            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
            while (i < m)
            {
                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }
                u32 fi = wvFieldIdx(w, stw, fnames[i]);
                if (fi == 0xFFFFFFFF || fi >= n)
                    { wvErr(w, initId, "unknown struct literal field"); return null; }
                fields[fi] = wvConstInit(w, fvals[i], irt->params[fi]);
                i++;
            }
            return w->ir->createStructConst(irt, fields, n);
        },
        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            IrType* irt = dt;
            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))
                { wvErr(w, initId, "aggregate literal needs an aggregate type"); return null; }
            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;
            u32 cnt = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;
            u32 cap = irt->kind == IrTypeKind::Array ? (irt->count > 0 ? irt->count : cnt) : irt->nparams;
            if (cap < cnt) cap = cnt;
            IrValue** evs = (IrValue**)wvArr(w, (usize)cap, 8);
            if (evs == null) return null;
            u32 i = 0;
            while (i < cap)
            {
                evs[i] = null;
                i++;
            }
            i = 0;
            while (i < cnt && elems != null)
            {
                if (elems[i].index != 0)
                {
                    IrType* et = irt->kind == IrTypeKind::Array ? irt->elem
                        : (i < irt->nparams ? irt->params[i] : null);
                    if (et != null) evs[i] = wvConstInit(w, elems[i], et);
                }
                i++;
            }
            if (irt->kind == IrTypeKind::Array) return w->ir->constArray(irt, evs, cnt);
            return w->ir->createStructConst(irt, evs, cap);
        },
        ExprKind::Sizeof => {
            Ty st = wvResolved(w, e->kind.payload.Sizeof.targetType);
            IrType* stt = st != 0 ? wvTy(w, st, 0) : null;
            if (stt == null) { wvErr(w, initId, "sizeof of an unknown type in an initializer"); return null; }
            return w->ir->constInt(dt, (u64)w->ir->irTypeSizeOf(stt));
        },
        ExprKind::Alignof => {
            Ty st = wvResolved(w, e->kind.payload.Alignof.targetType);
            IrType* stt = st != 0 ? wvTy(w, st, 0) : null;
            if (stt == null) { wvErr(w, initId, "alignof of an unknown type in an initializer"); return null; }
            u32 al = w->ir->irTypeAlignOf(stt);
            if (al == 0) al = 1;
            return w->ir->constInt(dt, (u64)al);
        },
        ExprKind::Cast => {
            IrValue* v = wvConstInit(w, e->kind.payload.Cast.expr, dt);
            if (v == null) return null;
            /* both sides already carry the storage's type: only a float
             * narrowed to an integer needs an actual conversion */
            if (v->kind == IrValueKind::ConstFloat && dt->kind != IrTypeKind::Float)
            {
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&v->valData, 8);
                return w->ir->constInt(dt, (u64)(i64)d);
            }
            if (v->kind == IrValueKind::ConstFloat) return w->ir->constFloat(dt, wvConstFloatBits(v));
            if (dt->kind == IrTypeKind::Float)
                return w->ir->constFloat(dt, (f64)(i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL));
            return w->ir->constInt(dt, v->valData);
        },
        ExprKind::BitNot | ExprKind::Not => {
            if (dt->kind != IrTypeKind::Int)
                { wvErr(w, initId, "bitwise not of a non-integer constant (Phase 3)"); return null; }
            NodeId inner = e->kind.tag == ExprKind::BitNot
                ? e->kind.payload.BitNot.expr : e->kind.payload.Not.expr;
            u64 v = 0;
            if (!wvConstU64(w, inner, dt, &v))
                { wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
            if (e->kind.tag == ExprKind::BitNot) return w->ir->constInt(dt, ~v);
            return w->ir->constInt(dt, v == 0 ? 1 : 0);
        },
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr | ExprKind::And | ExprKind::Or => {
            NodeId lid = e->kind.payload.Add.left;
            NodeId rid = e->kind.payload.Add.right;
            bool isArith = e->kind.tag == ExprKind::Add || e->kind.tag == ExprKind::Sub ||
                           e->kind.tag == ExprKind::Mul || e->kind.tag == ExprKind::Div ||
                           e->kind.tag == ExprKind::Mod;
            if (dt->kind == IrTypeKind::Float)
            {
                if (!isArith || e->kind.tag == ExprKind::Mod)
                    { wvErr(w, initId, "operator has no constant float form (Phase 3)"); return null; }
                f64 a = 0;
                f64 b = 0;
                if (!wvConstF64(w, lid, dt, &a) || !wvConstF64(w, rid, dt, &b))
                    { wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
                f64 r = 0;
                if (e->kind.tag == ExprKind::Add) r = a + b;
                else if (e->kind.tag == ExprKind::Sub) r = a - b;
                else if (e->kind.tag == ExprKind::Mul) r = a * b;
                else if (b != 0) r = a / b;
                return w->ir->constFloat(dt, r);
            }
            if (dt->kind != IrTypeKind::Int)
                { wvErr(w, initId, "arithmetic on a non-numeric constant (Phase 3)"); return null; }
            u64 a = 0;
            u64 b = 0;
            if (!wvConstU64(w, lid, dt, &a) || !wvConstU64(w, rid, dt, &b))
                { wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
            /* signedness comes from the expression's own resolved type:
             * the IR type carries only a width */
            Ty ct = wvResolved(w, e->resolvedType);
            bool uns = ct != 0 && wvTyUnsigned(w, ct);
            i32 k = e->kind.tag;
            u64 r = 0;
            if (k == ExprKind::Add) r = a + b;
            else if (k == ExprKind::Sub) r = a - b;
            else if (k == ExprKind::Mul) r = a * b;
            else if (k == ExprKind::BitAnd) r = a & b;
            else if (k == ExprKind::BitOr) r = a | b;
            else if (k == ExprKind::BitXor) r = a ^ b;
            else if (k == ExprKind::And) r = (a != 0 && b != 0) ? 1 : 0;
            else if (k == ExprKind::Or) r = (a != 0 || b != 0) ? 1 : 0;
            else if (k == ExprKind::Shl) r = b >= 64 ? 0 : (a << b);
            else if (k == ExprKind::Shr)
                r = b >= 64 ? (uns ? 0 : 0)
                            : (uns ? (a >> b) : (u64)((i64)a >> (i64)b));
            else if (k == ExprKind::Div || k == ExprKind::Mod)
            {
                if (b == 0)
                    { wvErr(w, initId, "division by zero in a constant expression"); return null; }
                if (uns) r = (k == ExprKind::Div) ? (a / b) : (a % b);
                else
                {
                    i64 sa = (i64)a;
                    i64 sb = (i64)b;
                    r = (k == ExprKind::Div) ? (u64)(sa / sb) : (u64)(sa % sb);
                }
            }
            return w->ir->constInt(dt, r);
        },
        else => {
            wvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
            return null;
        },
    }
}

/* static storage for one name: an IrGlobal registered under the
 * declaring node, typed as a pointer to the data so loads, stores and
 * geppes all reach it. `disambiguator` (0 for file scope) keeps two
 * same-named statics in one file from sharing a symbol. */
pub IrValue* wvMakeGlobal(Wv* w, NodeId declId, Str name, Ty vt, NodeId initId,
                          bool isConst, bool isExtern, u32 disambiguator)
{
    IrGlobal* seen = wvGMapGet(w, declId.index);
    if (seen != null) return &seen->base;
    if (vt == 0 && initId.index != 0)
    {
        /* `const NAME = value;` carries no type node: take the type the
         * initializer resolved to */
        Node* in = wvNode(w, initId);
        if (in->kind.tag == NodeKind::Expr)
            vt = wvResolved(w, in->kind.payload.Expr.value.resolvedType);
    }
    IrType* dt = vt != 0 ? wvTy(w, vt, 0) : null;
    if (dt == null || dt->kind == IrTypeKind::Void)
    {
        wvErr(w, declId, "cannot give this name storage");
        return null;
    }
    IrValue* init = null;
    if (initId.index != 0 && !isExtern) init = wvConstInit(w, initId, dt);
    str mangled = wvMangle(w, declId, name);
    if (disambiguator != 0)
    {
        wvMbCh(w, 36); // '$'
        u32 d = disambiguator;
        u8[10] tmp;
        u32 k = 0;
        if (d == 0) tmp[k++] = 48;
        while (d > 0) { tmp[k++] = (u8)(48 + (d % 10)); d /= 10; }
        while (k > 0) { k--; wvMbCh(w, tmp[k]); }
        mangled = wvMbStr(w);
    }
    IrGlobal* g = w->ir->createGlobal(mangled, w->ir->tyPtr(dt), isConst, isExtern,
                                      init, w->ir->irTypeAlignOf(dt));
    w->mod->addGlobal(g);
    wvGMapPut(w, declId.index, g);
    return &g->base;
}

/* C default-argument promotions for variadic args: int < 32-bit →
 * zext/sext to i32, float < 64-bit → fpext to f64 */
pub IrValue* wvPromoteVararg(Wv* w, IrValue* v, Ty coralTy)
{
    if (v == null || v->type == null) return v;
    Ty rt = wvResolved(w, coralTy);
    if (rt == 0) return v;
    TypeEntry* te = w->ctx->types + rt;
    bool uns = wvTyUnsigned(w, coralTy);
    switch (te.kind.tag)
    {
        TypeKind::I8 | TypeKind::I16 => {
            return wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::U8 | TypeKind::U16 | TypeKind::Bool => {
            return wvV(w->b.zext(v, w->ir->tyInt(32)));
        },
        TypeKind::Char => {
            return uns ? wvV(w->b.zext(v, w->ir->tyInt(32)))
                       : wvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::F32 => { return wvV(w->b.fpExt(v, w->ir->tyDouble())); },
        else => { return v; },
    }
}


/* evaluate a call's argument list: an optional receiver first, then
 * every listed argument (with vararg promotion past the fixed prefix).
 * Shared by bare calls and method calls. On failure *fail is set and
 * the array (if any) is already freed. */
pub IrValue** wvBuildCallArgs(Wv* w, IrFunc* f, NodeId* argv, u32 argvLen,
                              IrValue* recv, bool passRecv, u32* outN, bool* fail)
{
    *fail = false;
    *outN = 0;
    u32 n = argvLen + (passRecv ? 1 : 0);
    IrValue** args = null;
    if (n > 0)
    {
        args = alloc<IrValue*>((usize)n);
        if (args == null) { *fail = true; return null; }
    }
    u32 j = 0;
    if (passRecv) { args[0] = recv; j = 1; }
    bool vararg = f != null && f->base.type != null && f->base.type->isVararg;
    u32 fixed = f != null ? f->nparams : 0;
    u32 i = 0;
    while (i < argvLen)
    {
        IrValue* av = wvExpr(w, argv[i]);
        if (av == null)
        {
            *fail = true;
            if (args != null) dealloc<IrValue*>(args);
            return null;
        }
        if (vararg && (i + (passRecv ? 1 : 0)) >= fixed)
        {
            Node* an = wvNode(w, argv[i]);
            Ty at = an->kind.tag == NodeKind::Expr ? an->kind.payload.Expr.value.resolvedType : 0;
            av = wvPromoteVararg(w, av, at);
        }
        args[j] = av;
        j++;
        i++;
    }
    *outN = n;
    return args;
}

/* resolve a method's IrFunc: name-table hit first, otherwise declare a
 * shell under the composed `owner_method` symbol. `owner` is the bare
 * owner spelling (receiver side or the call site's own text), `recvTy`
 * the receiver type used to derive the implicit self pointee (0 when
 * the caller knows the method is static). *notFound distinguishes "no
 * such method" (silent — callers fall back or word their own error)
 * from a lowering failure (already reported). */
IrFunc* wvMethodShell(Wv* w, NodeId mdef, Str owner, Ty recvTy, Str methName,
                      NodeId id, bool* notFound)
{
    if (notFound != null) *notFound = false;
    if (mdef.index == 0)
    {
        if (notFound != null) *notFound = true;
        return null;
    }
    Node* mn = wvNode(w, mdef);
    if (mn->kind.tag != NodeKind::Decl ||
        mn->kind.payload.Decl.value.kind.tag != DeclKind::Func)
        { wvErr(w, id, "method is not a function"); return null; }
    Decl* md = &mn->kind.payload.Decl.value;
    if (w->mono != null && w->mono.genericCount(mdef) != 0)
        { wvErr(w, id, "call to a generic method (Phase 2)"); return null; }
    IrFunc* f = wvFnMapGet(w, mdef.index);
    if (f != null) return f;
    str msym = wvMethodMangle(w, mdef, owner, methName);
    if (msym.len == 0) { wvErr(w, id, "cannot compose the method symbol"); return null; }
    IrType* selfPt = null;
    if (wvMethodSelfKind(w, mdef) == 1 && recvTy != 0)
    {
        Ty u = wvUnwrapTy(w, recvTy);
        if (u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer)
            u = wvUnwrapTy(w, (w->ctx->types + u)->kind.payload.Pointer.base);
        if (u != 0) selfPt = w->ir->tyPtr(wvTy(w, u, 0));
    }
    f = wvDeclareMethod(w, mdef, md, msym, selfPt);
    if (f == null) { wvErr(w, id, "cannot declare the method"); return null; }
    w->mod.addFunc(f);
    wvFnMapPut(w, mdef.index, f);
    return f;
}

/* the receiver-typed form: find the method on recvTy's owner, then the
 * shared shell. Used by method calls and for-in's count()/at()/range().
 * *outDef (optional) receives the method decl so callers can ask about
 * the receiver parameter. */
pub IrFunc* wvMethodFnFor(Wv* w, Ty recvTy, Str methName, NodeId id,
                          bool* notFound, NodeId* outDef)
{
    NodeId mdef = wvFindMethodDecl(w, recvTy, methName);
    if (outDef != null) *outDef = mdef;
    return wvMethodShell(w, mdef, wvOwnerStr(w, recvTy), recvTy, methName, id, notFound);
}

pub IrValue* wvCall(Wv* w, Expr* e, NodeId id)
{
    NodeId calleeId = e->kind.payload.Call.callee;
    Node* cn = wvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr)
    {
        wvErr(w, id, "unsupported callee form (Phase 1: bare-name calls only)");
        return null;
    }
    i32 ck = cn->kind.payload.Expr.value.kind.tag;
    IrFunc* f = null;
    if (ck == ExprKind::Ident)
        f = wvResolveCallee(w, cn->kind.payload.Expr.value.kind.payload.Ident.name, calleeId);
    else if (ck == ExprKind::Path)
        f = wvResolveCalleePath(w, calleeId, id);
    else
    {
        wvErr(w, id, "unsupported callee form (Phase 1: bare-name calls only)");
        return null;
    }
    if (f == null) return null;

    u32 nargs = 0;
    bool fail = false;
    IrValue** args = wvBuildCallArgs(w, f, e->kind.payload.Call.args,
                                     e->kind.payload.Call.argsLen,
                                     null, false, &nargs, &fail);
    if (fail) return null;
    IrValue* res = wvV(w->b.call(&f->base, args, nargs));
    if (args != null) dealloc<IrValue*>(args);
    if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
    return res;
}

/* `recv.method(args...)`: a real method when the receiver's type (or a
 * matching extend) declares one — the receiver becomes the shell's
 * parameter 0 unless the method is static — otherwise a fn-pointer
 * field of the receiver called with only the listed arguments. */
pub IrValue* wvMethodCall(Wv* w, Expr* e, NodeId id)
{
    NodeId recvNode = e->kind.payload.MethodCall.receiver;
    Str meth = e->kind.payload.MethodCall.method;
    NodeId* argv = e->kind.payload.MethodCall.args;
    u32 argvLen = e->kind.payload.MethodCall.argsLen;

    Node* rn = wvNode(w, recvNode);
    Ty recvTy = rn->kind.tag == NodeKind::Expr
        ? rn->kind.payload.Expr.value.resolvedType : 0;

    bool nf = false;
    NodeId mdef = NodeId{ .index = 0 };
    IrFunc* f = wvMethodFnFor(w, recvTy, meth, id, &nf, &mdef);
    if (f != null)
    {
        u8 sk = wvMethodSelfKind(w, mdef);
        IrValue* recvVal = null;
        bool passRecv = sk != 0;
        if (passRecv)
        {
            Ty rt = wvUnwrapTy(w, recvTy);
            bool recvIsPtr = rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::Pointer;
            recvVal = recvIsPtr ? wvExpr(w, recvNode) : wvAddrOf(w, recvNode);
            if (recvVal == null) return null;
        }
        u32 nargs = 0;
        bool fail = false;
        IrValue** args = wvBuildCallArgs(w, f, argv, argvLen, recvVal, passRecv,
                                         &nargs, &fail);
        if (fail) return null;
        IrValue* res = wvV(w->b.call(&f->base, args, nargs));
        if (args != null) dealloc<IrValue*>(args);
        if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
        return res;
    }
    if (!nf) return null; // the shell reported why

    /* not a method: a fn-pointer field, called as `(recv.field)(args)` */
    if (wvHasField(w, recvTy, meth))
    {
        IrValue* faddr = wvFieldAddr(w, recvNode, meth, id);
        if (faddr == null) return null;
        IrType* fty = faddr->type != null ? faddr->type->elem : null;
        if (fty == null || fty->kind != IrTypeKind::Func)
            { wvErr(w, id, "field is not a function pointer"); return null; }
        IrValue* fval = wvV(w->b.load(fty, faddr));
        if (fval == null) return null;
        u32 nargs = 0;
        bool fail = false;
        IrValue** args = wvBuildCallArgs(w, null, argv, argvLen, null, false,
                                         &nargs, &fail);
        if (fail) return null;
        IrValue* res = wvV(w->b.call(fval, args, nargs));
        if (args != null) dealloc<IrValue*>(args);
        if (fty->ret == null || fty->ret->kind == IrTypeKind::Void) return null;
        return res;
    }

    wvErr(w, id, "no such method or function-pointer field");
    return null;
}


/* value-level arithmetic: l and r are already evaluated. Shared by
 * binary expressions and compound assignment (`x += e` = load, apply,
 * store). */
pub IrValue* wvArithVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Add => { return wvV(isFloat ? w->b.fadd(l, r) : w->b.add(l, r)); },
        ExprKind::Sub => { return wvV(isFloat ? w->b.fsub(l, r) : w->b.sub(l, r)); },
        ExprKind::Mul => { return wvV(isFloat ? w->b.fmul(l, r) : w->b.mul(l, r)); },
        ExprKind::Div => {
            if (isFloat) return wvV(w->b.fdiv(l, r));
            return wvV(uns ? w->b.udiv(l, r) : w->b.sdiv(l, r));
        },
        ExprKind::Mod => {
            if (isFloat) { wvErr(w, id, "float modulo (needs fmod lowering, Phase 2)"); return null; }
            return wvV(uns ? w->b.urem(l, r) : w->b.srem(l, r));
        },
        ExprKind::BitAnd => { return wvV(w->b.andOp(l, r)); },
        ExprKind::BitOr => { return wvV(w->b.orOp(l, r)); },
        ExprKind::BitXor => { return wvV(w->b.xorOp(l, r)); },
        ExprKind::Shl => { return wvV(w->b.shl(l, r)); },
        ExprKind::Shr => { return wvV(uns ? w->b.lshr(l, r) : w->b.ashr(l, r)); },
        else => { wvErr(w, id, "unhandled binary op"); return null; },
    }
}

pub IrValue* wvBinaryArith(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    return wvArithVals(w, k, l, r, id, ct);
}

/* value-level comparison (see wvArithVals) */
pub IrValue* wvCompareVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    Ty rt = wvResolved(w, ct);
    bool isFloat = false;
    if (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        isFloat = te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64;
    }
    bool uns = wvTyUnsigned(w, ct);
    switch (k.tag)
    {
        ExprKind::Eq => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::Oeq, l, r)
                               : w->b.icmp(IrICmpPred::Eq, l, r));
        },
        ExprKind::Ne => {
            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::One, l, r)
                               : w->b.icmp(IrICmpPred::Ne, l, r));
        },
        ExprKind::Lt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Olt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ult : IrICmpPred::Slt, l, r));
        },
        ExprKind::Le => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ole, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ule : IrICmpPred::Sle, l, r));
        },
        ExprKind::Gt => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ogt, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Ugt : IrICmpPred::Sgt, l, r));
        },
        ExprKind::Ge => {
            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Oge, l, r));
            return wvV(w->b.icmp(uns ? IrICmpPred::Uge : IrICmpPred::Sge, l, r));
        },
        else => { wvErr(w, id, "unhandled comparison"); return null; },
    }
}

pub IrValue* wvCompare(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = wvExpr(w, lid);
    IrValue* r = wvExpr(w, rid);
    return wvCompareVals(w, k, l, r, id, ct);
}

/* short-circuit And/Or via result alloca + condBr (no phis) */
pub IrValue* wvShortCircuit(Wv* w, Expr* e, NodeId id)
{
    IrType* bt = w->ir->tyInt(1);
    IrValue* resSlot = wvV(w->b.alloca(bt));
    IrValue* l = wvExpr(w, e->kind.payload.And.left);
    if (l == null) return null;
    IrValue* lz = wvV(w->b.icmp(IrICmpPred::Ne, l, w->ir->constInt(l->type, 1)));
    IrBlock* rhsBb = wvBlock(w, "sc.rhs");
    IrBlock* endBb = wvBlock(w, "sc.end");
    bool isAnd = e->kind.tag == ExprKind::And;
    if (isAnd) w->b.condBr(lz, rhsBb, endBb);
    else w->b.condBr(lz, endBb, rhsBb);

    /* short-circuit path: store the known result, branch to join */
    wvSetBlock(w, endBb);
    w->b.store(w->ir->constInt(bt, isAnd ? 0 : 1), resSlot);
    IrBlock* joinBb = wvBlock(w, "sc.join");
    w->b.br(joinBb);

    /* rhs path: evaluate, store, branch to join */
    wvSetBlock(w, rhsBb);
    IrValue* r = wvExpr(w, e->kind.payload.And.right);
    if (r == null) return null;
    IrValue* rz = wvV(w->b.icmp(IrICmpPred::Ne, r, w->ir->constInt(r->type, 1)));
    w->b.store(rz, resSlot);
    w->b.br(joinBb);

    wvSetBlock(w, joinBb);
    return wvV(w->b.load(bt, resSlot));
}

/* scalar cast between two IrTypes, using Coral signedness for the
 * int↔int / int→float choice (IrType has no signed flag) */
pub IrValue* wvCast(Wv* w, IrValue* v, IrType* st, IrType* dt, bool srcUnsigned, bool dstUnsigned)
{
    if (v == null || dt == null) return v;
    if (st == dt) return v;
    if (st->kind == IrTypeKind::Ptr && dt->kind == IrTypeKind::Ptr) return v;
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Int)
    {
        if (dt->width == st->width) return v;
        if (dt->width < st->width) return wvV(w->b.trunc(v, dt));
        return wvV(srcUnsigned ? w->b.zext(v, dt) : w->b.sext(v, dt));
    }
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Float)
        return wvV(srcUnsigned ? w->b.uiToFp(v, dt) : w->b.siToFp(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Int)
        return wvV(dstUnsigned ? w->b.fpToUi(v, dt) : w->b.fpToSi(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Float)
    {
        if (dt->width < st->width) return wvV(w->b.fpTrunc(v, dt));
        return wvV(w->b.fpExt(v, dt));
    }
    return wvV(w->b.bitcast(v, dt));
}


/* coerce any expression value to an i1 condition: i1 passes through,
 * other ints compare against 1, floats against 0.0, pointers against
 * null. Returns null on failure. */
pub IrValue* wvCond(Wv* w, IrValue* v)
{
    if (v == null || v->type == null) return null;
    if (v->type->kind == IrTypeKind::Int && v->type->width == 1) return v;
    if (v->type->kind == IrTypeKind::Float)
        return wvV(w->b.fcmp(IrFCmpPred::One, v, w->ir->constFloat(v->type, 0.0)));
    if (v->type->kind == IrTypeKind::Ptr)
        return wvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 0)));
    return wvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 1)));
}

pub IrValue* wvAddrOf(Wv* w, NodeId id);

/* strip Const/Comptime wrappers; Named alias/distinct unwrapping happens
 * where the decl is needed */
pub Ty wvUnwrapTy(Wv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else return t;
        guard++;
    }
    return t;
}

/* is this IR type an aggregate (address-copied, never register-loaded)? */
pub bool wvIsAgg(IrType* t)
{
    return t != null && (t->kind == IrTypeKind::Struct ||
                         t->kind == IrTypeKind::Array ||
                         t->kind == IrTypeKind::Vector);
}

/* declaration-order field index of `name` in struct type `t` — the same
 * order wvStructTy feeds createStructType, which is the order wallvm's
 * emitGep walks for field offsets. Str/Slice expose the fixed {ptr,len}
 * pair. 0xFFFFFFFF when the field is unknown. */
/* the field's address: pointer receivers pass the value through, value
 * receivers contribute their address — shared by `x.f`, `x?.f`-style
 * chains and the fn-pointer-field call form of a method call. */
pub IrValue* wvFieldAddr(Wv* w, NodeId obj, Str fname, NodeId errId)
{
    Node* on = wvNode(w, obj);
    if (on->kind.tag != NodeKind::Expr)
        { wvErr(w, errId, "field base is not an expression"); return null; }
    Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
    IrValue* base; Ty sty;
    if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)
    {
        sty = (w->ctx->types + obt)->kind.payload.Pointer.base;
        base = wvExpr(w, obj); // the pointer value
    }
    else
    {
        sty = obt;
        base = wvAddrOf(w, obj); // address of the struct value
    }
    if (base == null) return null;
    u32 fi = wvFieldIdx(w, sty, fname);
    if (fi == 0xFFFFFFFF) { wvErr(w, errId, "unknown struct field"); return null; }
    return wvGepField(w, base, fi);
}

/* the declaring node of a method on a receiver type — the same walk
 * cgMethodRecvKind performs: unwrap ptr/const/comptime to the named
 * type, then scan the type's own methods and the extends whose self
 * type matches. 0 when the name is not a method at all. */
pub NodeId wvFindMethodDecl(Wv* w, Ty recvTy, Str method)
{
    NodeId none;
    none.index = 0;
    if (recvTy == 0 || method == 0 || w->file == null) return none;
    Ty t = recvTy;
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        guard++;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Pointer) t = e->kind.payload.Pointer.base;
        else if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else break;
    }
    if (t == 0 || (w->ctx->types + t)->kind.tag != TypeKind::Named) return none;
    Str typeName = (w->ctx->types + t)->kind.payload.Named.name;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        Node* d = wvNode(w, file->decls[i]);
        if (d->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d->kind.payload.Decl.value;
            NodeId* methods = null;
            u32 mlen = 0;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => {
                    if (dd->kind.payload.Struct.name != typeName) break;
                    methods = dd->kind.payload.Struct.methods;
                    mlen = dd->kind.payload.Struct.methodsLen;
                },
                DeclKind::Union => {
                    if (dd->kind.payload.Union.name != typeName) break;
                    methods = dd->kind.payload.Union.methods;
                    mlen = dd->kind.payload.Union.methodsLen;
                },
                DeclKind::Variant => {
                    if (dd->kind.payload.Variant.name != typeName) break;
                    methods = dd->kind.payload.Variant.methods;
                    mlen = dd->kind.payload.Variant.methodsLen;
                },
                /* an extend's methods belong to its self type — without
                 * this filter a fn-pointer field call (`p->alloc(...)`,
                 * where some OTHER type has an `alloc` method) matches
                 * this unrelated extend and composes a bogus call */
                DeclKind::Extend | DeclKind::ExtendTrait => {
                    Ty st = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.selfType
                        : dd->kind.payload.ExtendTrait.selfType;
                    st = wvUnwrapTy(w, st);
                    if (st != 0 && (w->ctx->types + st)->kind.tag == TypeKind::Pointer)
                        st = wvUnwrapTy(w, (w->ctx->types + st)->kind.payload.Pointer.base);
                    if (st == 0 || (w->ctx->types + st)->kind.tag != TypeKind::Named ||
                        (w->ctx->types + st)->kind.payload.Named.name != typeName) break;
                    methods = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.methods
                        : dd->kind.payload.ExtendTrait.methods;
                    mlen = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.methodsLen
                        : dd->kind.payload.ExtendTrait.methodsLen;
                },
                else => {},
            }
            if (methods != null)
            {
                u32 m = 0;
                while (m < mlen)
                {
                    Node* mn = wvNode(w, methods[m]);
                    if (mn->kind.tag == NodeKind::Decl &&
                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                        mn->kind.payload.Decl.value.kind.payload.Func.name == method)
                        return methods[m];
                    m++;
                }
            }
        }
        i++;
    }
    return none;
}

/* does the receiver's named struct/union declare field `name`? (the
 * fn-pointer field form a method call may fall back to) */
pub bool wvHasField(Wv* w, Ty recvTy, Str name)
{
    if (recvTy == 0 || name == 0) return false;
    Ty u = wvUnwrapTy(w, recvTy);
    if (u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer)
        u = wvUnwrapTy(w, (w->ctx->types + u)->kind.payload.Pointer.base);
    if (u == 0 || (w->ctx->types + u)->kind.tag != TypeKind::Named) return false;
    Str tn = (w->ctx->types + u)->kind.payload.Named.name;
    NodeId d = wvFindTypeDecl(w, tn);
    if (d.index == 0) return false;
    Node* dn = wvNode(w, d);
    if (dn->kind.tag != NodeKind::Decl) return false;
    Decl* dd = &dn->kind.payload.Decl.value;
    NodeId* fields = null;
    u32 flen = 0;
    if (dd->kind.tag == DeclKind::Struct)
    {
        fields = dd->kind.payload.Struct.fields;
        flen = dd->kind.payload.Struct.fieldsLen;
    }
    else if (dd->kind.tag == DeclKind::Union)
    {
        fields = dd->kind.payload.Union.fields;
        flen = dd->kind.payload.Union.fieldsLen;
    }
    else return false;
    u32 i = 0;
    while (i < flen)
    {
        Node* fn = wvNode(w, fields[i]);
        if (fn->kind.tag == NodeKind::Field && fn->kind.payload.Field.value.name == name)
            return true;
        i++;
    }
    return false;
}

pub u32 wvFieldIdx(Wv* w, Ty t, Str name)
{
    u32 none = 0xFFFFFFFF;
    if (name == 0) return none;
    str sn = wvStr(w, name);
    t = wvUnwrapTy(w, t);
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        guard++;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Str || e->kind.tag == TypeKind::Slice)
        {
            if (sn.equals("ptr")) return 0;
            if (sn.equals("len")) return 1;
            return none;
        }
        if (e->kind.tag != TypeKind::Named) return none;
        NodeId td = wvFindTypeDecl(w, e->kind.payload.Named.name);
        if (td.index == 0) return none;
        Node* dn = wvNode(w, td);
        if (dn->kind.tag != NodeKind::Decl) return none;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::Struct)
        {
            u32 i = 0;
            while (i < dd->kind.payload.Struct.fieldsLen)
            {
                Node* fn = wvNode(w, dd->kind.payload.Struct.fields[i]);
                if (fn->kind.tag == NodeKind::Field &&
                    fn->kind.payload.Field.value.name == name) return i;
                i++;
            }
            return none;
        }
        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = wvUnwrapTy(w, dd->kind.payload.TypeAlias.target); continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = wvUnwrapTy(w, dd->kind.payload.Distinct.baseType); continue; }
        return none;
    }
    return none;
}

/* address of element `idx` reached through `base`.
 *
 * byElement: base already points INTO an array (a local array slot or a
 * ptr-to-array's interior) — a plain gep strides by the array element
 * size, which wallvm's emitGep walks correctly.
 *
 * otherwise base points AT `pointee` (T*, a struct*, a slice's data
 * pointer): wallvm's emitGep silently DROPS the index when the pointee is
 * a scalar (the walk breaks out with offset 0). Retype the base as
 * [0 x pointee]* first, so the stride becomes sizeOf(pointee) — plain C
 * pointer arithmetic — and cast the result back to pointee*. */
pub IrValue* wvIndexAddr(Wv* w, IrValue* base, IrType* pointee, IrValue* idx, bool byElement)
{
    if (base == null || pointee == null || idx == null) return null;
    IrValue*[1] idxs;
    idxs[0] = idx;
    if (byElement) return wvV(w->b.gep(base, idxs, 1));
    IrType* arrT = w->ir->tyArray(pointee, 0);
    IrValue* bc = wvV(w->b.bitcast(base, w->ir->tyPtr(arrT)));
    if (bc == null) return null;
    IrValue* g = wvV(w->b.gep(bc, idxs, 1));
    if (g == null) return null;
    return wvV(w->b.bitcast(g, w->ir->tyPtr(pointee)));
}

/* gep to struct field `fi` of the aggregate at `base` */
pub IrValue* wvGepField(Wv* w, IrValue* base, u32 fi)
{
    if (base == null) return null;
    IrValue*[1] idxs;
    idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)fi);
    return wvV(w->b.gep(base, idxs, 1));
}

/* An aggregate value IS its address, so the alloca that holds one is
 * typed as the aggregate itself: call/return ABI classification reads
 * the struct words through that address (kind 3/4), which it only does
 * when the value's type says Struct. Scalar slots stay ptr-typed — they
 * are loaded into registers instead. */
pub IrValue* wvAggSlot(Wv* w, IrType* ty)
{
    IrValue* slot = wvV(w->b.alloca(ty));
    if (slot != null) slot->type = ty;
    return slot;
}

/* decode Coral string-literal token text [begin,end) into out — every
 * escape becomes one byte (\n \t \r \0 \a \b \f \v \\ \" \' \xNN,
 * \NNN octal; unknown escapes drop the backslash, like C). out must hold
 * at least end-begin bytes; returns the decoded length. Shared by string
 * literals and asm template pieces so both reach IR as identical bytes. */
pub usize wvDecodeLit(str tok, usize begin, usize end, u8* out)
{
    usize dlen = 0;
    usize i = begin;
    while (i < end)
    {
        u8 c = tok.ptr[i];
        if (c != '\\' || i + 1 >= end) { out[dlen++] = c; i++; continue; }
        u8 esc = tok.ptr[i + 1];
        if (esc == 'n') { out[dlen++] = 10; i += 2; continue; }
        if (esc == 't') { out[dlen++] = 9; i += 2; continue; }
        if (esc == 'r') { out[dlen++] = 13; i += 2; continue; }
        if (esc == '0') { out[dlen++] = 0; i += 2; continue; }
        if (esc == 'a') { out[dlen++] = 7; i += 2; continue; }
        if (esc == 'b') { out[dlen++] = 8; i += 2; continue; }
        if (esc == 'f') { out[dlen++] = 12; i += 2; continue; }
        if (esc == 'v') { out[dlen++] = 11; i += 2; continue; }
        if (esc == '\\' || esc == '"' || esc == '\'') { out[dlen++] = esc; i += 2; continue; }
        if (esc == 'x')
        {
            u32 v = 0;
            usize j = i + 2;
            u32 used = 0;
            while (j < end && used < 2)
            {
                u8 h = tok.ptr[j];
                u32 d;
                if (h >= '0' && h <= '9') d = (u32)(h - '0');
                else if (h >= 'a' && h <= 'f') d = (u32)(h - 'a' + 10);
                else if (h >= 'A' && h <= 'F') d = (u32)(h - 'A' + 10);
                else break;
                v = v * 16 + d;
                j++; used++;
            }
            if (used == 0) { out[dlen++] = 'x'; i += 2; continue; }
            out[dlen++] = (u8)v;
            i = j;
            continue;
        }
        if (esc >= '0' && esc <= '7')
        {
            u32 v = 0;
            usize j = i + 1;
            u32 used = 0;
            while (j < end && used < 3)
            {
                u8 h = tok.ptr[j];
                if (h < '0' || h > '7') break;
                v = v * 8 + (u32)(h - '0');
                j++; used++;
            }
            out[dlen++] = (u8)v;
            i = j;
            continue;
        }
        /* unknown escape: the backslash drops, like C */
        out[dlen++] = esc;
        i += 2;
    }
    return dlen;
}

/* StringLit → address of merged rodata.
 *   C"..." → the pointer value itself (record is NUL-terminated)
 *   "..."  → { ptr, len } in an aggregate slot, field-wise initialized
 * Token text keeps its quotes and escapes; decoding happens here the way
 * the C backend lets the C compiler do it: every escape is one byte of
 * the str's len. */
pub IrValue* wvStringLit(Wv* w, NodeId id)
{
    Node* n = wvNode(w, id);
    if (n == null || n->kind.tag != NodeKind::Expr)
        { wvErr(w, id, "string literal"); return null; }
    Expr* e = &n->kind.payload.Expr.value;
    str tok = wvStr(w, e->kind.payload.StringLit.value);
    bool isC = (e->kind.payload.StringLit.flags & 1) != 0;
    usize begin = 0;
    usize end = tok.len;
    if (isC)
    {
        /* token text is `C"…"`: drop the prefix and both quotes */
        if (tok.len >= 3 && tok.ptr[0] == 'C' && tok.ptr[1] == '"')
            { begin = 2; end = tok.len - 1; }
    }
    else if (tok.len >= 2 && tok.ptr[0] == '"')
        { begin = 1; end = tok.len - 1; }

    u8* buf = (u8*)wvArr(w, (end - begin) + 4, 1);
    if (buf == null) { wvErr(w, id, "string literal buffer"); return null; }
    usize dlen = wvDecodeLit(tok, begin, end, buf);


    IrValue*[1] z;
    z[0] = w->ir->constInt(w->ir->tyInt(32), 0);
    str bytes = str::fromParts(buf, dlen);
    IrStringConst* sc = w->mod->findConstString(bytes, (u32)dlen);
    if (sc == null)
    {
        sc = w->ir->createStringConst(bytes, (u32)dlen);
        if (sc == null) { wvErr(w, id, "string constant creation failed"); return null; }
        w->mod->addConstString(sc);
    }
    IrValue* addr = wvV(w->b.gep(&sc->base, z, 1));
    if (addr == null) return null;
    if (isC) return addr;

    Ty rt = wvResolved(w, e->resolvedType);
    IrType* st = wvTy(w, rt, 0);
    if (st == null || st->kind != IrTypeKind::Struct)
        { wvErr(w, id, "str literal needs the str type"); return null; }
    IrValue* slot = wvAggSlot(w, st);
    if (slot == null) return null;
    w->b.store(addr, slot);
    IrValue* lenF = wvGepField(w, slot, 1);
    if (lenF == null) return null;
    w->b.store(w->ir->constInt(w->ir->tyInt(64), (u64)dlen), lenF);
    return slot;
}

/* the address of an lvalue expression: local slot, deref pointee, or a
 * gep chain (field / tuple field / index). Used by plain assignment,
 * compound assignment and aggregate copies alike. */
pub IrValue* wvAddrOf(Wv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) { wvErr(w, id, "not an lvalue"); return null; }
    Expr* e = &n->kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = wvFindLocal(w, name);
            if (slot != null) return slot;
            IrValue* gv = wvResolveGlobal(w, name, id);
            if (gv != null) return gv;
            wvErr(w, id, "cannot assign to a non-local name");
            return null;
        },
        ExprKind::Deref => { return wvExpr(w, e->kind.payload.Deref.expr); },
        ExprKind::Field | ExprKind::DerefField => {
            NodeId obj; Str fname;
            if (e->kind.tag == ExprKind::Field)
                { obj = e->kind.payload.Field.obj; fname = e->kind.payload.Field.field; }
            else
                { obj = e->kind.payload.DerefField.obj; fname = e->kind.payload.DerefField.field; }
            return wvFieldAddr(w, obj, fname, id);
        },
        ExprKind::TupleField => {
            NodeId obj = e->kind.payload.TupleField.obj;
            u32 ti = e->kind.payload.TupleField.index;
            Node* on = wvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { wvErr(w, id, "tuple base is not an expression"); return null; }
            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
            IrValue* base;
            if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)
                base = wvExpr(w, obj);
            else
                base = wvAddrOf(w, obj);
            return wvGepField(w, base, ti);
        },
        ExprKind::Index => {
            NodeId obj = e->kind.payload.Index.obj;
            NodeId ixId = e->kind.payload.Index.index;
            Node* on = wvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { wvErr(w, id, "index base is not an expression"); return null; }
            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));
            IrValue* base = null;
            IrType* pointee = null;
            bool byElement = false;
            if (obt != 0)
            {
                TypeEntry* oe = w->ctx->types + obt;
                if (oe->kind.tag == TypeKind::Array)
                {
                    /* an array value: its address points at element 0 */
                    base = wvAddrOf(w, obj);
                    pointee = wvTy(w, oe->kind.payload.Array.base, 0);
                    byElement = true;
                }
                else if (oe->kind.tag == TypeKind::Pointer)
                {
                    /* p[i]: C pointer arithmetic steps sizeOf(pointee) */
                    base = wvExpr(w, obj);
                    Ty pe = wvUnwrapTy(w, oe->kind.payload.Pointer.base);
                    TypeEntry* peE = pe != 0 ? w->ctx->types + pe : null;
                    if (peE != null && peE->kind.tag == TypeKind::Array)
                        pointee = wvTy(w, pe, 0);           // whole-array step
                    else
                        pointee = wvTy(w, pe, 0);           // scalar/struct step
                }
                else if (oe->kind.tag == TypeKind::Slice || oe->kind.tag == TypeKind::Str)
                {
                    Ty et = oe->kind.tag == TypeKind::Slice
                        ? oe->kind.payload.Slice.base : (Ty)0;
                    IrType* eir = et != 0 ? wvTy(w, et, 0) : w->ir->tyInt(8);
                    IrValue* va = wvAddrOf(w, obj);
                    if (va == null) return null;
                    IrValue* pSlot = wvGepField(w, va, 0); // { ptr, len } layout
                    if (pSlot == null) return null;
                    base = wvV(w->b.load(w->ir->tyPtr(eir), pSlot));
                    pointee = eir;
                }
            }
            if (base == null || pointee == null)
                { wvErr(w, id, "unsupported index base"); return null; }
            IrValue* idx = wvExpr(w, ixId);
            if (idx == null) return null;
            return wvIndexAddr(w, base, pointee, idx, byElement);
        },
        ExprKind::StructLiteral => {
            Ty st = wvResolved(w, e->kind.payload.StructLiteral.typeNode);
            if (e->kind.payload.StructLiteral.variantName != 0)
                { wvErr(w, id, "variant construction (Phase 3)"); return null; }
            IrType* irt = st != 0 ? wvTy(w, st, 0) : null;
            if (irt == null || irt->kind != IrTypeKind::Struct)
                { wvErr(w, id, "struct literal needs a struct type"); return null; }
            IrValue* slot = wvAggSlot(w, irt);
            if (slot == null) return null;
            u32 i = 0;
            u32 n = e->kind.payload.StructLiteral.fieldValuesLen;
            Str* fnames = e->kind.payload.StructLiteral.fieldNames;
            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
            while (i < n)
            {
                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }
                u32 fi = wvFieldIdx(w, st, fnames[i]);
                if (fi == 0xFFFFFFFF || fi >= irt->nparams)
                    { wvErr(w, id, "unknown struct literal field"); return null; }
                IrValue* fa = wvGepField(w, slot, fi);
                if (fa == null) return null;
                IrType* ft = irt->params[fi];
                if (wvIsAgg(ft))
                {
                    IrValue* sv = wvAddrOf(w, fvals[i]);
                    if (sv == null) return null;
                    if (!wvCopyAgg(w, fa, sv, ft, 0)) return null;
                }
                else
                {
                    IrValue* v = wvExpr(w, fvals[i]);
                    if (v == null) return null;
                    w->b.store(v, fa);
                }
                i++;
            }
            return slot;
        },
        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            Ty at = wvResolved(w, e->resolvedType);
            IrType* irt = at != 0 ? wvTy(w, at, 0) : null;
            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))
                { wvErr(w, id, "array/tuple literal needs an aggregate type"); return null; }
            IrValue* slot = wvAggSlot(w, irt);
            if (slot == null) return null;
            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;
            u32 n = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;
            u32 i = 0;
            while (i < n)
            {
                if (elems == null || elems[i].index == 0) { i++; continue; }
                if (irt->kind == IrTypeKind::Array && i >= irt->count) { i++; continue; }
                IrValue*[1] idxs;
                idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
                IrValue* ea = wvV(w->b.gep(slot, idxs, 1));
                if (ea == null) return null;
                IrType* et = irt->kind == IrTypeKind::Array ? irt->elem
                    : (i < irt->nparams ? irt->params[i] : null);
                if (et == null) { i++; continue; }
                if (wvIsAgg(et))
                {
                    IrValue* sv = wvAddrOf(w, elems[i]);
                    if (sv == null) return null;
                    if (!wvCopyAgg(w, ea, sv, et, 0)) return null;
                }
                else
                {
                    IrValue* v = wvExpr(w, elems[i]);
                    if (v == null) return null;
                    w->b.store(v, ea);
                }
                i++;
            }
            return slot;
        },
        ExprKind::StringLit => { return wvStringLit(w, id); },
        else => { wvErr(w, id, "unsupported assignment target"); return null; },
    }
}

/* element-wise aggregate copy through addresses (structs/arrays are never
 * register values in this lowering — see the aggregate rule in expr.crl) */
pub bool wvCopyAgg(Wv* w, IrValue* dst, IrValue* src, IrType* ty, u32 depth)
{
    if (dst == null || src == null || ty == null) return false;
    if (depth > 16) { wvErr(w, NodeId{ .index = 0 }, "aggregate copy too deep"); return false; }
    if (ty->kind == IrTypeKind::Struct)
    {
        u32 i = 0;
        while (i < ty->nparams)
        {
            IrValue* d = wvGepField(w, dst, i);
            IrValue* s = wvGepField(w, src, i);
            if (d == null || s == null) return false;
            if (!wvCopyAgg(w, d, s, ty->params[i], depth + 1)) return false;
            i++;
        }
        return true;
    }
    if (ty->kind == IrTypeKind::Array || ty->kind == IrTypeKind::Vector)
    {
        u32 i = 0;
        while (i < ty->count)
        {
            IrValue*[1] idxs;
            idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
            IrValue* d = wvV(w->b.gep(dst, idxs, 1));
            IrValue* s = wvV(w->b.gep(src, idxs, 1));
            if (d == null || s == null) return false;
            if (!wvCopyAgg(w, d, s, ty->elem, depth + 1)) return false;
            i++;
        }
        return true;
    }
    /* scalar: wallvm loads at most 8 bytes into one register */
    u32 sz = w->ir->irTypeSizeOf(ty);
    if (sz == 0 || sz > 8)
    {
        wvErr(w, NodeId{ .index = 0 }, "scalar wider than 8 bytes in aggregate copy (Phase 2)");
        return false;
    }
    IrValue* v = wvV(w->b.load(ty, src));
    if (v == null) return false;
    w->b.store(v, dst);
    return true;
}

/* compound-assignment operator: op is the Coral source operator
 * ("+=", "-=", ...); cur is the loaded lhs, rhs the evaluated rhs.
 * Returns the stored result. */
pub IrValue* wvCompoundOp(Wv* w, str op, IrValue* cur, IrValue* rhs, Ty ct, NodeId id)
{
    if (cur == null || rhs == null) return null;
    ExprKind k;
    if (op.equals("+=")) k.tag = ExprKind::Add;
    else if (op.equals("-=")) k.tag = ExprKind::Sub;
    else if (op.equals("*=")) k.tag = ExprKind::Mul;
    else if (op.equals("/=")) k.tag = ExprKind::Div;
    else if (op.equals("%=")) k.tag = ExprKind::Mod;
    else if (op.equals("&=")) k.tag = ExprKind::BitAnd;
    else if (op.equals("|=")) k.tag = ExprKind::BitOr;
    else if (op.equals("^=")) k.tag = ExprKind::BitXor;
    else if (op.equals("<<=")) k.tag = ExprKind::Shl;
    else if (op.equals(">>=")) k.tag = ExprKind::Shr;
    else { wvErr(w, id, "unsupported assignment operator"); return null; }
    return wvArithVals(w, k, cur, rhs, id, ct);
}

/* one assignment: address the target, then store (plain) or
 * load–combine–store (compound). Aggregates copy element-wise. Shared by
 * the ExprKind::Assign* family and StmtKind::Assign. Returns the stored
 * value, or null (void / aggregate / error). */
pub IrValue* wvAssignCommon(Wv* w, NodeId target, NodeId value, str op, NodeId id)
{
    IrValue* addr = wvAddrOf(w, target);
    if (addr == null) return null;
    Node* tn = wvNode(w, target);
    Ty tgtTy = tn->kind.tag == NodeKind::Expr
        ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
    IrType* vt = tgtTy != 0 ? wvTy(w, tgtTy, 0) : null;
    if (vt == null || vt->kind == IrTypeKind::Void)
        { wvErr(w, id, "cannot type assignment target"); return null; }

    if (op.equals("="))
    {
        if (wvIsAgg(vt))
        {
            IrValue* src = wvAddrOf(w, value);
            if (src == null) return null;
            if (!wvCopyAgg(w, addr, src, vt, 0)) return null;
            return null;
        }
        IrValue* val = wvExpr(w, value);
        if (val == null) return null;
        w->b.store(val, addr);
        return val;
    }
    if (wvIsAgg(vt)) { wvErr(w, id, "compound assign on aggregate (Phase 2)"); return null; }
    IrValue* cur = wvV(w->b.load(vt, addr));
    IrValue* rhs = wvExpr(w, value);
    IrValue* res = wvCompoundOp(w, op, cur, rhs, tgtTy, id);
    if (res == null) return null;
    w->b.store(res, addr);
    return res;
}


/* the value of a body node: an expression, an expression statement, or
 * a block whose last statement is one — everything before it lowers as
 * statements in its own scope. `vt` is the result type (null = no
 * value); a body that yields nothing falls back to a zero constant. */
pub IrValue* wvValBody(Wv* w, NodeId id, IrType* vt)
{
    if (id.index == 0) return vt != null ? w->ir->constInt(vt, 0) : null;
    Node* n = wvNode(w, id);
    if (n->kind.tag == NodeKind::Expr) return wvExpr(w, id);
    if (n->kind.tag != NodeKind::Stmt)
        { wvErr(w, id, "expected a statement or expression body"); return null; }
    Stmt* s = &n->kind.payload.Stmt.value;
    if (s->kind.tag == StmtKind::ExprStmt) return wvExpr(w, s->kind.payload.ExprStmt.expr);
    if (s->kind.tag == StmtKind::Block)
    {
        u32 scopeMark = w->locLen;
        u32 cnt = s->kind.payload.Block.stmtsLen;
        u32 i = 0;
        while (i + 1 < cnt && !w->term) { wvStmt(w, s->kind.payload.Block.stmts[i]); i++; }
        IrValue* res = null;
        if (cnt == 0 || w->term) res = vt != null ? w->ir->constInt(vt, 0) : null;
        else
        {
            NodeId last = s->kind.payload.Block.stmts[cnt - 1];
            Node* ln = wvNode(w, last);
            if (ln->kind.tag == NodeKind::Stmt &&
                ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)
                res = wvExpr(w, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
            else
            {
                wvStmt(w, last);
                res = vt != null ? w->ir->constInt(vt, 0) : null;
            }
        }
        w->locLen = scopeMark;
        return res;
    }
    wvErr(w, id, "expected a statement or expression body");
    return null;
}

/* a zero-argument libc extern the source never declares (`abort` for
 * @assert). Declared once per module under its bare C name. */
IrFunc* wvExternFn0(Wv* w, str name)
{
    u32 i = 0;
    while (i < w->mod.nfuncs)
    {
        IrFunc* f = w->mod.funcs[i];
        if (f != null && f->base.name.equals(name)) return f;
        i++;
    }
    IrFunc* f = w->ir->createFunc(name, w->ir->tyVoid(), null, 0);
    if (f == null) return null;
    f->isExtern = true;
    w->mod.addFunc(f);
    return f;
}


pub IrValue* wvExpr(Wv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = wvNode(w, id);
    if (n->kind.tag != NodeKind::Expr)
    {
        wvErr(w, id, "expected expression node");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    Ty rt = wvResolved(w, e->resolvedType);
    switch (e->kind.tag)
    {
        ExprKind::IntLit => {
            IrType* it = rt != 0 ? wvTy(w, rt, 0)
                                 : w->ir->tyInt(32);
            return w->ir->constInt(it, e->kind.payload.IntLit.value);
        },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(w->ir->tyInt(1), v);
        },
        ExprKind::CharLit => {
            return w->ir->constInt(w->ir->tyInt(8), (u64)e->kind.payload.CharLit.value);
        },
        ExprKind::NullLit => {
            return w->ir->constInt(w->ir->tyPtr(w->ir->tyInt(8)), 0);
        },
        ExprKind::FloatLit => {
            f64 d = wvParseFloat(w, e->kind.payload.FloatLit.value);
            IrType* ft = w->ir->tyDouble();
            if (rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::F32)
                ft = w->ir->tyFloat();
            IrValue* dv = w->ir->constFloat(w->ir->tyDouble(), d);
            if (ft->width == 32) return wvV(w->b.fpTrunc(dv, ft));
            return dv;
        },
        ExprKind::StringLit => { return wvStringLit(w, id); },
        ExprKind::StructLiteral | ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            /* aggregates are address-valued: the literal's slot IS the value */
            return wvAddrOf(w, id);
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = wvFindLocal(w, name);
            if (slot != null)
            {
                IrType* vt = wvTy(w, rt, 0);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                /* an aggregate's value is its address — no load */
                if (wvIsAgg(vt)) return slot;
                return wvV(w->b.load(vt, slot));
            }
            IrType* vt = wvTy(w, rt, 0);
            if (vt == null || vt->kind == IrTypeKind::Void) return null;
            /* an aggregate's value is its address, and that address is
             * one copy in storage — never re-materialised per use */
            if (wvIsAgg(vt))
            {
                IrValue* gva = wvResolveGlobal(w, name, id);
                if (gva != null) return gva;
                wvErr(w, id, "aggregate name has no storage");
                return null;
            }
            /* a function in value position is a pointer to itself */
            IrFunc* fv = wvLookupFunc(w, name, id);
            if (fv != null) return &fv->base;
            /* a scalar constant has no storage to read: fold it */
            NodeId cd = wvResolveConst(w, name, id);
            if (cd.index != 0)
            {
                Node* cn = wvNode(w, cd);
                NodeId init = cn->kind.payload.Decl.value.kind.payload.Constant.value;
                if (init.index != 0) return wvExpr(w, init);
            }
            /* a name that keeps storage reads through its global */
            IrValue* gv = wvResolveGlobal(w, name, id);
            if (gv != null) return wvV(w->b.load(vt, gv));
            wvErr(w, id, "unresolved identifier");
            return null;
        },
        ExprKind::Field | ExprKind::DerefField | ExprKind::TupleField |
        ExprKind::Index => {
            IrValue* addr = wvAddrOf(w, id);
            if (addr == null) return null;
            IrType* vt = wvTy(w, rt, 0);
            if (vt == null || vt->kind == IrTypeKind::Void) return null;
            if (wvIsAgg(vt))
            {
                wvErr(w, id, "aggregate value in value position (Phase 2: struct/str args & returns)");
                return null;
            }
            return wvV(w->b.load(vt, addr));
        },
        ExprKind::Assign | ExprKind::AssignAdd | ExprKind::AssignSub |
        ExprKind::AssignMul | ExprKind::AssignDiv | ExprKind::AssignMod |
        ExprKind::AssignBitAnd | ExprKind::AssignBitOr | ExprKind::AssignBitXor |
        ExprKind::AssignShl | ExprKind::AssignShr => {
            NodeId target; NodeId value;
            str op = "=";
            if (e->kind.tag == ExprKind::Assign)
                { target = e->kind.payload.Assign.target; value = e->kind.payload.Assign.value; }
            else if (e->kind.tag == ExprKind::AssignAdd)
                { target = e->kind.payload.AssignAdd.target; value = e->kind.payload.AssignAdd.value; op = "+="; }
            else if (e->kind.tag == ExprKind::AssignSub)
                { target = e->kind.payload.AssignSub.target; value = e->kind.payload.AssignSub.value; op = "-="; }
            else if (e->kind.tag == ExprKind::AssignMul)
                { target = e->kind.payload.AssignMul.target; value = e->kind.payload.AssignMul.value; op = "*="; }
            else if (e->kind.tag == ExprKind::AssignDiv)
                { target = e->kind.payload.AssignDiv.target; value = e->kind.payload.AssignDiv.value; op = "/="; }
            else if (e->kind.tag == ExprKind::AssignMod)
                { target = e->kind.payload.AssignMod.target; value = e->kind.payload.AssignMod.value; op = "%="; }
            else if (e->kind.tag == ExprKind::AssignBitAnd)
                { target = e->kind.payload.AssignBitAnd.target; value = e->kind.payload.AssignBitAnd.value; op = "&="; }
            else if (e->kind.tag == ExprKind::AssignBitOr)
                { target = e->kind.payload.AssignBitOr.target; value = e->kind.payload.AssignBitOr.value; op = "|="; }
            else if (e->kind.tag == ExprKind::AssignBitXor)
                { target = e->kind.payload.AssignBitXor.target; value = e->kind.payload.AssignBitXor.value; op = "^="; }
            else if (e->kind.tag == ExprKind::AssignShl)
                { target = e->kind.payload.AssignShl.target; value = e->kind.payload.AssignShl.value; op = "<<="; }
            else
                { target = e->kind.payload.AssignShr.target; value = e->kind.payload.AssignShr.value; op = ">>="; }
            return wvAssignCommon(w, target, value, op, id);
        },
        ExprKind::PostInc | ExprKind::PostDec | ExprKind::PreInc |
        ExprKind::PreDec => {
            NodeId tgt = e->kind.payload.PostInc.expr;
            IrValue* addr = wvAddrOf(w, tgt);
            if (addr == null) return null;
            Node* tn = wvNode(w, tgt);
            Ty tt = tn->kind.tag == NodeKind::Expr
                ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
            IrType* vt = tt != 0 ? wvTy(w, tt, 0) : null;
            if (vt == null || wvIsAgg(vt)) { wvErr(w, id, "increment target is not scalar"); return null; }
            IrValue* cur = wvV(w->b.load(vt, addr));
            bool dec = e->kind.tag == ExprKind::PostDec || e->kind.tag == ExprKind::PreDec;
            IrValue* nv;
            if (vt->kind == IrTypeKind::Float)
            {
                IrValue* one = w->ir->constFloat(vt, 1.0);
                nv = wvV(dec ? w->b.fsub(cur, one) : w->b.fadd(cur, one));
            }
            else
            {
                IrValue* one = w->ir->constInt(vt, 1);
                nv = wvV(dec ? w->b.sub(cur, one) : w->b.add(cur, one));
            }
            if (nv == null) return null;
            w->b.store(nv, addr);
            bool post = e->kind.tag == ExprKind::PostInc || e->kind.tag == ExprKind::PostDec;
            return post ? cur : nv;
        },
        ExprKind::Ternary => {
            IrValue* c = wvCond(w, wvExpr(w, e->kind.payload.Ternary.cond));
            if (c == null) return null;
            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;
            if (vt == null || vt->kind == IrTypeKind::Void)
            {
                /* void ternary: lower both arms as statements */
                IrBlock* tBb = wvBlock(w, "sel.then");
                IrBlock* fBb = wvBlock(w, "sel.else");
                IrBlock* jBb = wvBlock(w, "sel.end");
                w->b.condBr(c, tBb, fBb);
                wvSetBlock(w, tBb);
                wvExpr(w, e->kind.payload.Ternary.thenExpr);
                if (!w->term) w->b.br(jBb);
                wvSetBlock(w, fBb);
                wvExpr(w, e->kind.payload.Ternary.elseExpr);
                if (!w->term) w->b.br(jBb);
                wvSetBlock(w, jBb);
                return null;
            }
            if (wvIsAgg(vt)) { wvErr(w, id, "aggregate ternary (Phase 2)"); return null; }
            IrValue* slot = wvV(w->b.alloca(vt));
            if (slot == null) return null;
            IrBlock* tBb = wvBlock(w, "sel.then");
            IrBlock* fBb = wvBlock(w, "sel.else");
            IrBlock* jBb = wvBlock(w, "sel.end");
            w->b.condBr(c, tBb, fBb);
            wvSetBlock(w, tBb);
            IrValue* tv = wvExpr(w, e->kind.payload.Ternary.thenExpr);
            if (tv != null) w->b.store(tv, slot);
            w->b.br(jBb);
            wvSetBlock(w, fBb);
            IrValue* fv = wvExpr(w, e->kind.payload.Ternary.elseExpr);
            if (fv != null) w->b.store(fv, slot);
            w->b.br(jBb);
            wvSetBlock(w, jBb);
            return wvV(w->b.load(vt, slot));
        },
        ExprKind::Call => { return wvCall(w, e, id); },
        ExprKind::MethodCall => { return wvMethodCall(w, e, id); },
        ExprKind::Path => {
            NodeId* segs = e->kind.payload.Path.segments;
            u32 sn = e->kind.payload.Path.segmentsLen;
            if (sn == 0) { wvErr(w, id, "empty path expression"); return null; }
            /* a value reference through a namespace resolves to its
             * final segment (a function becomes its address, a constant
             * folds, an enum/variant name reports and gets fixed when
             * the layout work lands) */
            return wvExpr(w, segs[sn - 1]);
        },
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr => {
            Expr* le = &wvNode(w, e->kind.payload.Add.left)->kind.payload.Expr.value;
            return wvBinaryArith(w, e->kind, e->kind.payload.Add.left,
                                 e->kind.payload.Add.right, id, le->resolvedType);
        },
        ExprKind::Eq | ExprKind::Ne | ExprKind::Lt | ExprKind::Le |
        ExprKind::Gt | ExprKind::Ge => {
            Expr* le = &wvNode(w, e->kind.payload.Eq.left)->kind.payload.Expr.value;
            return wvCompare(w, e->kind, e->kind.payload.Eq.left,
                             e->kind.payload.Eq.right, id, le->resolvedType);
        },
        ExprKind::And | ExprKind::Or => { return wvShortCircuit(w, e, id); },
        ExprKind::Neg => {
            IrValue* v = wvExpr(w, e->kind.payload.Neg.expr);
            if (v == null) return null;
            if (rt != 0)
            {
                TypeEntry* te = w->ctx->types + rt;
                if (te.kind.tag == TypeKind::F32 || te.kind.tag == TypeKind::F64)
                    return wvV(w->b.fsub(w->ir->constInt(v->type, 0), v));
            }
            return wvV(w->b.neg(v));
        },
        ExprKind::Not => {
            IrValue* v = wvExpr(w, e->kind.payload.Not.expr);
            if (v == null) return null;
            return wvV(w->b.xorOp(v, w->ir->constInt(v->type, 1)));
        },
        ExprKind::BitNot => {
            IrValue* v = wvExpr(w, e->kind.payload.BitNot.expr);
            if (v == null) return null;
            return wvV(w->b.notOp(v));
        },
        ExprKind::AddressOf => {
            /* the address of an lvalue — locals, globals, and the same
             * field/index chains assignment accepts */
            return wvAddrOf(w, e->kind.payload.AddressOf.expr);
        },
        ExprKind::Deref => {
            IrValue* v = wvExpr(w, e->kind.payload.Deref.expr);
            if (v == null) return null;
            IrType* vt = wvTy(w, rt, 0);
            return wvV(w->b.load(vt, v));
        },
        ExprKind::Cast => {
            IrValue* v = wvExpr(w, e->kind.payload.Cast.expr);
            if (v == null) return null;
            Ty tgt = wvResolved(w, e->kind.payload.Cast.targetType);
            IrType* dt = wvTy(w, tgt, 0);
            Expr* se = &wvNode(w, e->kind.payload.Cast.expr)->kind.payload.Expr.value;
            bool su = wvTyUnsigned(w, se->resolvedType);
            bool du = wvTyUnsigned(w, e->kind.payload.Cast.targetType);
            return wvCast(w, v, v->type, dt, su, du);
        },
        ExprKind::Sizeof => {
            IrType* st = wvTy(w, wvResolved(w, e->kind.payload.Sizeof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeSizeOf(st));
        },
        ExprKind::Alignof => {
            IrType* at = wvTy(w, wvResolved(w, e->kind.payload.Alignof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeAlignOf(at));
        },
        ExprKind::TypeRef => {
            wvErr(w, id, "unresolved TypeRef");
            return null;
        },
        ExprKind::Typeof => {
            wvErr(w, id, "typeof not supported");
            return null;
        },
        ExprKind::Spread => {
            /* `...pack` only survives to lowering when comptime never
             * evaluated it — forward the inner expression */
            return wvExpr(w, e->kind.payload.Spread.expr);
        },
        ExprKind::StaticCall => {
            /* `Owner.method(args)` with no receiver: the method must be
             * static, symbol composed from the call site's own text */
            Str typeName = e->kind.payload.StaticCall.typeName;
            Str meth = e->kind.payload.StaticCall.method;
            NodeId mdef = wvFindMethodDeclOwner(w, typeName, meth);
            if (mdef.index == 0)
                { wvErr(w, id, "static method not found"); return null; }
            if (w->mono != null && w->mono.genericCount(mdef) != 0)
                { wvErr(w, id, "call to a generic method (Phase 2)"); return null; }
            if (wvMethodSelfKind(w, mdef) != 0)
                { wvErr(w, id, "instance method needs a receiver expression"); return null; }
            IrFunc* f = wvMethodShell(w, mdef, typeName, 0, meth, id, null);
            if (f == null) return null;
            u32 nargs = 0;
            bool fail = false;
            IrValue** args = wvBuildCallArgs(w, f, e->kind.payload.StaticCall.args,
                                             e->kind.payload.StaticCall.argsLen,
                                             null, false, &nargs, &fail);
            if (fail) return null;
            IrValue* res = wvV(w->b.call(&f->base, args, nargs));
            if (args != null) dealloc<IrValue*>(args);
            if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
            return res;
        },
        ExprKind::BuiltinCall => {
            str name = wvStr(w, e->kind.payload.BuiltinCall.name);
            NodeId* bargs = e->kind.payload.BuiltinCall.args;
            u32 bargsLen = e->kind.payload.BuiltinCall.argsLen;
            /* @assert(cond) / @assertOut(cond[, msg]) — a failing
             * condition calls libc abort, the same end C's assert()
             * reaches; the optional message has no IR form yet */
            bool isAssert = name.equals("assert");
            bool isAssertOut = name.equals("assertOut");
            if ((isAssert && bargsLen == 1) || (isAssertOut && bargsLen >= 1))
            {
                IrValue* c = wvCond(w, wvExpr(w, bargs[0]));
                if (c == null) return null;
                IrBlock* okBb = wvBlock(w, "assert.ok");
                IrBlock* failBb = wvBlock(w, "assert.fail");
                w->b.condBr(c, okBb, failBb);
                wvSetBlock(w, failBb);
                IrFunc* af = wvExternFn0(w, "abort");
                if (af != null) w->b.call(&af->base, null, 0);
                w->b.unreachable();
                wvSetBlock(w, okBb);
                IrType* vt = rt != 0 ? wvTy(w, rt, 0) : w->ir->tyInt(32);
                if (vt == null || vt->kind == IrTypeKind::Void ||
                    vt->kind == IrTypeKind::Struct || vt->kind == IrTypeKind::Array)
                    return null;
                return w->ir->constInt(vt, 0);
            }
            /* @isFormatLiteral(x): true only for a literal argument */
            if (name.equals("isFormatLiteral"))
            {
                bool hasStrLit = false;
                if (bargsLen == 1 && bargs != null)
                {
                    Node* an = wvNode(w, bargs[0]);
                    if (an->kind.tag == NodeKind::Expr &&
                        an->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)
                        hasStrLit = true;
                }
                IrType* vt = rt != 0 ? wvTy(w, rt, 0) : w->ir->tyInt(1);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                return w->ir->constInt(vt, hasStrLit ? 1 : 0);
            }
            wvErr(w, id, "unsupported builtin call");
            return null;
        },
        ExprKind::BlockExpr => {
            u32 scopeMark = w->locLen;
            NodeId* bstmts = e->kind.payload.BlockExpr.stmts;
            u32 bn = e->kind.payload.BlockExpr.stmtsLen;
            u32 i = 0;
            while (i < bn && !w->term) { wvStmt(w, bstmts[i]); i++; }
            if (w->term) { w->locLen = scopeMark; return null; }
            IrValue* res = null;
            NodeId resId = e->kind.payload.BlockExpr.result;
            if (resId.index != 0) res = wvExpr(w, resId);
            else
            {
                IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;
                if (vt != null && vt->kind != IrTypeKind::Void &&
                    !wvIsAgg(vt)) res = w->ir->constInt(vt, 0);
            }
            w->locLen = scopeMark;
            return res;
        },
        ExprKind::IfExpr => {
            IrValue* c = wvCond(w, wvExpr(w, e->kind.payload.IfExpr.cond));
            if (c == null) return null;
            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;
            bool hasVal = vt != null && vt->kind != IrTypeKind::Void;
            if (hasVal && wvIsAgg(vt))
                { wvErr(w, id, "aggregate if-expression (Phase 2)"); return null; }
            IrValue* slot = hasVal ? wvV(w->b.alloca(vt)) : null;
            if (hasVal && slot == null) return null;
            IrBlock* thenBb = wvBlock(w, "if.then");
            IrBlock* elseBb = wvBlock(w, "if.else");
            IrBlock* endBb = wvBlock(w, "if.end");
            w->b.condBr(c, thenBb, elseBb);
            wvSetBlock(w, thenBb);
            IrValue* tv = wvValBody(w, e->kind.payload.IfExpr.thenBody, vt);
            if (tv != null && slot != null) w->b.store(tv, slot);
            if (!w->term) w->b.br(endBb);
            wvSetBlock(w, elseBb);
            IrValue* fv = wvValBody(w, e->kind.payload.IfExpr.elseBody, vt);
            if (fv != null && slot != null) w->b.store(fv, slot);
            if (!w->term) w->b.br(endBb);
            wvSetBlock(w, endBb);
            if (!hasVal) return null;
            return wvV(w->b.load(vt, slot));
        },
        ExprKind::SwitchExpr => {
            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;
            if (vt == null || vt->kind == IrTypeKind::Void)
                { wvErr(w, id, "switch expression without a result type"); return null; }
            if (wvIsAgg(vt))
                { wvErr(w, id, "aggregate switch-expression (Phase 2)"); return null; }
            IrValue* slot = wvV(w->b.alloca(vt));
            if (slot == null) return null;
            wvSwitchCore(w, e->kind.payload.SwitchExpr.expr,
                         e->kind.payload.SwitchExpr.cases,
                         e->kind.payload.SwitchExpr.casesLen, id, slot, vt);
            return wvV(w->b.load(vt, slot));
        },
        else => {
            wvErr(w, id, "unsupported expression (Phase 1)");
            return null;
        },
    }
}
