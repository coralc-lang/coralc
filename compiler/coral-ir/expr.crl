#[[no_drop_all]]
/* coral-ir/expr.crl — expression lowering
 *
 * Phase 1: integer/float literals, arithmetic, comparisons, boolean
 * logic, locals, direct calls, address-of/deref, casts, sizeof. Returns
 * the IrValue* for the expression; null on void/unhandled. Unhandled
 * forms report G0001. Callee resolution goes through the sema scope
 * stack (lookupFrom) → declId → the collection pass's fn map — no
 * per-reference re-mangling, no linear decl scans. */
use lower { Muv, muvNode, muvErr, muvStr, muvResolved, muvSubstTy, muvSubstDeep, muvFindLocal,
               muvLocalTy, muvSlotTy,
               muvPushLocal, muvFnMapGet, muvFnMapPut, muvGMapGet, muvGMapPut, muvBlock,
               muvSetBlock, muvTerm, muvPos, muvArr, muvMbCh, muvMbStr,
               MuvNameEnt, muvNamesFind, muvTypeInstanceName, muvAddFunc, muvAddGlobal,
               muvTyMapFind, muvDeclTyMapFind };
use types { muvTy, muvFindTypeDecl, muvFindTypeDeclRef, muvTyHasParam, muvVariantDeclOf, muvVariantCaseIdx,
               muvVariantCaseStructTy, muvVariantCaseStructTyFor, muvVariantCaseFieldIdx, muvUnionDeclOf, muvUnionFieldTy, muvUnionFieldTyIdx,
               muvIsIndirect, muvIndirectBase, muvDeclTy };
use decl { muvMangle, muvDeclareFunc, muvDeclareMethod, muvMethodSelfKind,
               muvOwnerStr, muvMethodMangle, muvMethodMangleEx };
use stmt;
use context::context { AstContext };
use mono::mono { MonoContext, MonoInstance, MonoInstanceKind, MonoSubstitution };
use sem { scope { Symbol, ScopeStack } };
use ast {
    id { Str, NodeId, locFile, locLine, locCol },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind, builtinImplHash,
           BUILTIN_ASSERT, BUILTIN_ASSERTOUT, BUILTIN_PANIC, BUILTIN_UNREACHABLE,
           BUILTIN_REPORT, BUILTIN_REPORTHEX, BUILTIN_ABORTNOW, BUILTIN_ASSERTEQ,
           BUILTIN_ASSERTNE, BUILTIN_ASSERTLT, BUILTIN_ASSERTLE, BUILTIN_ASSERTGT,
           BUILTIN_ASSERTGE, BUILTIN_ASSERTRANGE, BUILTIN_ASSERTNONNULL,
           BUILTIN_ASSERTALIGNED, BUILTIN_BACKTRACETO },
    stmt { Stmt, StmtKind, SwitchCase },
    decl { Decl, DeclKind, Field, Param, File, VariantVariant, EnumVariant, ATTR_THREADLOCAL }
};
use common::slice { Slice };
import muvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrStringConst, IrGlobal, IrStructType, IrArrayConst, IrStructConst, irTypeEqual };
import muvm::irOps { IrICmpPred, IrFCmpPred };
import muvm::irBuilder { IrBuilder };
import std::mman { alloc, dealloc, copy, zero };
import platform::libc { strtod, getenv, printf };
import core::cchar { cchar };

/* builder ops return IrInst*; the SSA value is the instruction's base */
pub IrValue* muvV(IrInst* inst) { return inst != null ? &inst->base : null; }

/* set debug location on an IR instruction from the AST node's SourceLoc.
 * The safety pass reads this for line/column info in trap calls. */
pub void muvSetDebugLoc(Muv* w, IrInst* inst, NodeId id)
{
    if (inst == null || id.index == 0) return;
    Node* node = muvNode(w, id);
    if (node->loc.data == 0) return;
    u32 fileId = locFile(node->loc);
    u32 line = locLine(node->loc);
    u32 col = locCol(node->loc);
    /* get the file path from the diagnostic engine's file table */
    str file = "?";
    if (w->diag != null && fileId < w->diag->fileCount)
    {
        file = w->diag->filePaths.at((usize)fileId);
    }
    inst->setDebugLoc(file, line, col);
}

/* is the resolved Coral type an unsigned integer? (drives signedness of
 * div/rem/shr/casts — muvm IrType carries no signed flag) */
/* resolve a type through subst + Const/Comptime plus decl-level
 * TypeAlias/Distinct wrappers — the type it is ultimately spelled as.
 * Scalar-kind classification (float/int/unsigned) must see through
 * `distinct Celsius = f64`: the IR operands are f64 either way, but
 * the Distinct Named tag alone reads as "not float". */
pub Ty muvBaseTy(Muv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard++ < 16)
    {
        t = muvResolved(w, t);
        if (t == 0) return 0;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag != TypeKind::Named) return t;
        NodeId td = muvFindTypeDeclRef(w, e->kind.payload.Named.name, e->loc);
        if (td.index == 0) return t;
        Node* dn = muvNode(w, td);
        if (dn->kind.tag != NodeKind::Decl) return t;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = dd->kind.payload.TypeAlias.target; continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = dd->kind.payload.Distinct.baseType; continue; }
        return t;
    }
    return t;
}

pub bool muvTyUnsigned(Muv* w, Ty t)
{
    Ty rt = muvBaseTy(w, t);
    if (rt == 0) return false;
    TypeEntry* te = w->ctx->types + rt;
    switch (te->kind.tag)
    {
        TypeKind::U8 | TypeKind::U16 | TypeKind::U32 | TypeKind::U64 |
        TypeKind::U128 | TypeKind::Usize | TypeKind::Char | TypeKind::Bool =>
            { return true; },
        else => { return false; },
    }
}

// pub IrValue* muvExpr(Muv* w, NodeId id);


/* the silent half of callee resolution: sema scope lookup → declId →
 * the collection pass's IrFunc, or a shell for an extern the pass never
 * saw. Null when the name is not a function at all — callers that probe
 * (a value that may be a function or a variable) must not report. */
pub IrFunc* muvLookupFunc(Muv* w, Str name, NodeId refSite)
{
    if (name == 0) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = muvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    if (w->sema == null || w->sema->scopes == null) return null;
    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return null;
    /* generic templates never get a shell: their calls resolve through
     * the mono instance pick, and probes must not mint one */
    if (w->mono != null && w->mono->genericCount(sym->declaration) != 0) return null;
    IrFunc* f = muvFnMapGet(w, sym->declaration.index);
    if (f != null) return f;
    Node* sn = muvNode(w, sym->declaration);
    if (sn->kind.tag == NodeKind::Decl)
    {
        Decl* sd = &sn->kind.payload.Decl.value;
        if (sd->kind.tag == DeclKind::Func)
        {
            IrFunc* shell = muvDeclareFunc(w, sym->declaration, sd);
            /* keep the shell: a second reference reuses it instead of
             * minting another IrFunc of the same symbol */
            if (shell != null) muvFnMapPut(w, sym->declaration.index, shell);
            return shell;
        }
    }
    return null;
}

/* the Func decl named `name` declared in file `refFile` (first match
 * when the file has none) — the module-qualified call's lookup, after
 * cgFindDeclFrom. */
NodeId muvFindFuncDeclFrom(Muv* w, Str name, u32 refFile)
{
    NodeId first;
    first.index = 0;
    if (w->file == null || name == 0) return first;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId id = file->decls[i];
        Node* n = muvNode(w, id);
        if (n->kind.tag == NodeKind::Decl &&
            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)
        {
            Decl* dd = &n->kind.payload.Decl.value;
            if (dd->kind.payload.Func.name == name)
            {
                if (refFile != 0 && locFile(n->loc) == refFile) return id;
                if (first.index == 0) first = id;
            }
        }
        i++;
    }
    return first;
}

/* a module path (`std::fs`) → the diagnostic file id of its source:
 * `::` becomes `/`, `.crl` is appended when missing, then suffix-matched
 * against sema's file table (mirror of cgFileForModulePath). */
u32 muvFileForModulePath(Muv* w, Str path)
{
    if (path == 0 || w->sema == null || w->sema->diag == null) return 0;
    if (w->sema->diag->fileCount == 0) return 0;
    str p = muvStr(w, path);
    if (p.len == 0) return 0;
    bool hasCrl = p.len >= 4 && p.ptr[p.len - 4] == 46 && p.ptr[p.len - 3] == 99 &&
                  p.ptr[p.len - 2] == 114 && p.ptr[p.len - 1] == 108;
    usize dc = 0;
    usize c = 0;
    while (c + 1 < p.len)
    {
        if (p.ptr[c] == 58 && p.ptr[c + 1] == 58) dc++;
        c++;
    }
    usize n = p.len - dc + (hasCrl ? 0 : 4);
    u8* buf = (u8*)muvArr(w, n, 1);
    if (buf == null) return 0;
    usize j = 0;
    usize k = 0;
    while (j < p.len)
    {
        if (j + 1 < p.len && p.ptr[j] == 58 && p.ptr[j + 1] == 58)
            { buf[k] = 47; k++; j += 2; } // "::" → '/'
        else { buf[k] = p.ptr[j]; k++; j++; }
    }
    if (!hasCrl) { buf[k] = 46; buf[k + 1] = 99; buf[k + 2] = 114; buf[k + 3] = 108; }
    u32 f = 0;
    while (f < w->sema->diag->fileCount)
    {
        str fp = w->sema->diag->filePaths.at((usize)f);
        if (fp.ptr != null && fp.len >= n)
        {
            bool ok = true;
            usize q = 0;
            while (q < n)
            {
                if (fp.ptr[fp.len - n + q] != buf[q]) { ok = false; break; }
                q++;
            }
            if (ok) return f;
        }
        f++;
    }
    return 0;
}

/* `root::name(...)`: resolve through the module namespace the root
 * names — use symbol → its source file → the Func declared there.
 * Null when the root is not a module (the caller tries the next form). */
IrFunc* muvLookupPathModule(Muv* w, Str root, Str fname, NodeId refSite)
{
    if (root == 0 || fname == 0 || w->sema == null || w->sema->scopes == null) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = muvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* rsym = w->sema->scopes->lookupFrom(root, refFile);
    if (rsym == null || rsym->kind != 5 || rsym->declaration.index == 0) return null;
    Node* imn = muvNode(w, rsym->declaration);
    if (imn->kind.tag != NodeKind::Decl) return null;
    Decl* imd = &imn->kind.payload.Decl.value;
    Str mpath = 0;
    if (imd->kind.tag == DeclKind::Import) mpath = imd->kind.payload.Import.path;
    else if (imd->kind.tag == DeclKind::ModReexport) mpath = imd->kind.payload.ModReexport.path;
    else return null;
    u32 mf = muvFileForModulePath(w, mpath);
    if (mf == 0) return null;
    NodeId md = muvFindFuncDeclFrom(w, fname, mf);
    if (md.index == 0) return null;
    if (w->mono != null && w->mono->genericCount(md) != 0) return null;
    IrFunc* f = muvFnMapGet(w, md.index);
    if (f != null) return f;
    Node* fdn = muvNode(w, md);
    if (fdn->kind.tag != NodeKind::Decl) return null;
    Decl* fd = &fdn->kind.payload.Decl.value;
    if (fd->kind.tag != DeclKind::Func) return null;
    muvAddFunc(w, f);
    muvFnMapPut(w, md.index, f);
    return f;
}

/* `Owner::method(...)`: the declaring node of a method whose owner
 * text matches (the def side composes the same `owner_method` symbol).
 * Generic owners are skipped — mono does not reach methods yet. */
pub NodeId muvFindMethodDeclOwner(Muv* w, Str owner, Str methName)
{
    NodeId none;
    none.index = 0;
    if (owner == 0 || methName == 0 || w->file == null) return none;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        Node* d = muvNode(w, file->decls[i]);
        if (d->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d->kind.payload.Decl.value;
            Str ow = 0;
            NodeId* methods = null;
            u32 mlen = 0;
            if (dd->kind.tag == DeclKind::Struct)
            {
                if (dd->kind.payload.Struct.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Struct.name;
                methods = dd->kind.payload.Struct.methods;
                mlen = dd->kind.payload.Struct.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Union)
            {
                if (dd->kind.payload.Union.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Union.name;
                methods = dd->kind.payload.Union.methods;
                mlen = dd->kind.payload.Union.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Variant)
            {
                if (dd->kind.payload.Variant.genericParamsLen != 0) { i++; continue; }
                ow = dd->kind.payload.Variant.name;
                methods = dd->kind.payload.Variant.methods;
                mlen = dd->kind.payload.Variant.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::Extend)
            {
                if (dd->kind.payload.Extend.genericParamsLen != 0) { i++; continue; }
                if (muvTyHasParam(w, dd->kind.payload.Extend.selfType, 0)) { i++; continue; }
                ow = muvOwnerStr(w, dd->kind.payload.Extend.selfType);
                methods = dd->kind.payload.Extend.methods;
                mlen = dd->kind.payload.Extend.methodsLen;
            }
            else if (dd->kind.tag == DeclKind::ExtendTrait)
            {
                if (dd->kind.payload.ExtendTrait.genericParamsLen != 0) { i++; continue; }
                if (muvTyHasParam(w, dd->kind.payload.ExtendTrait.selfType, 0)) { i++; continue; }
                ow = muvOwnerStr(w, dd->kind.payload.ExtendTrait.selfType);
                methods = dd->kind.payload.ExtendTrait.methods;
                mlen = dd->kind.payload.ExtendTrait.methodsLen;
            }
            else { i++; continue; }
            if (ow == owner && methods != null)
            {
                u32 m = 0;
                while (m < mlen)
                {
                    Node* mn = muvNode(w, methods[m]);
                    if (mn->kind.tag == NodeKind::Decl &&
                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                        mn->kind.payload.Decl.value.kind.payload.Func.name == methName)
                        return methods[m];
                    m++;
                }
            }
        }
        i++;
    }
    /* monomorphised owner (`Vec_i32`): the instance's type decl plus
     * every extend its self type matches; mirrors cgFindMethodDeclOwner
     * phases 2/3 — one mdef serves every instance, the names table binds
     * the per-instance symbols */
    if (w->mono != null)
    {
        u32 ii = 0;
        while (ii < w->mono->instancesLen)
        {
            MonoInstance* inst = w->mono->instances + ii;
            if (inst->kind == MonoInstanceKind::TypeInstance &&
                muvTypeInstanceName(w, inst->name, inst->arguments,
                                   inst->argumentsLen) == owner)
            {
                Node* dn = muvNode(w, inst->declaration);
                if (dn->kind.tag == NodeKind::Decl)
                {
                    Decl* td = &dn->kind.payload.Decl.value;
                    NodeId* methods = null;
                    u32 mlen = 0;
                    if (td->kind.tag == DeclKind::Struct)
                        { methods = td->kind.payload.Struct.methods; mlen = td->kind.payload.Struct.methodsLen; }
                    else if (td->kind.tag == DeclKind::Union)
                        { methods = td->kind.payload.Union.methods; mlen = td->kind.payload.Union.methodsLen; }
                    else if (td->kind.tag == DeclKind::Variant)
                        { methods = td->kind.payload.Variant.methods; mlen = td->kind.payload.Variant.methodsLen; }
                    u32 m = 0;
                    while (methods != null && m < mlen)
                    {
                        Node* mn = muvNode(w, methods[m]);
                        if (mn->kind.tag == NodeKind::Decl &&
                            mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                            mn->kind.payload.Decl.value.kind.payload.Func.name == methName)
                            return methods[m];
                        m++;
                    }
                }
                u32 d = 0;
                while (d < file->declsLen)
                {
                    Node* dn2 = muvNode(w, file->decls[d]);
                    if (dn2->kind.tag == NodeKind::Decl)
                    {
                        Decl* xd = &dn2->kind.payload.Decl.value;
                        NodeId* em = null;
                        u32 eml = 0;
                        if (xd->kind.tag == DeclKind::Extend &&
                            muvSelfTyMatches(w, xd->kind.payload.Extend.selfType,
                                            inst->name, inst->arguments, inst->argumentsLen))
                            { em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen; }
                        else if (xd->kind.tag == DeclKind::ExtendTrait &&
                                 muvSelfTyMatches(w, xd->kind.payload.ExtendTrait.selfType,
                                                 inst->name, inst->arguments, inst->argumentsLen))
                            { em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen; }
                        u32 m = 0;
                        while (em != null && m < eml)
                        {
                            Node* mn = muvNode(w, em[m]);
                            if (mn->kind.tag == NodeKind::Decl &&
                                mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                                mn->kind.payload.Decl.value.kind.payload.Func.name == methName)
                                return em[m];
                            m++;
                        }
                    }
                    d++;
                }
            }
            ii++;
        }
    }
    return none;
}

/* does an extend's self type match the type instance `instName<args…>`?
 * Mirrors the C backend's cgSelfTyMatches: the self type must be Named
 * with the same owner name and arity, and each self-type arg is either
 * a type param (matches any instance arg) or exactly the instance arg. */
pub bool muvSelfTyMatches(Muv* w, Ty selfTy, Str instName, Ty* args, u32 argsLen)
{
    if (selfTy == 0 || instName == 0) return false;
    Ty t = muvUnwrapTy(w, selfTy);
    if (t == 0) return false;
    TypeEntry* te = w->ctx->types + t;
    if (te->kind.tag != TypeKind::Named) return false;
    if (te->kind.payload.Named.name != instName) return false;
    if (te->kind.payload.Named.genericArgsLen != argsLen) return false;
    u32 i = 0;
    while (i < argsLen)
    {
        Ty a = te->kind.payload.Named.genericArgs[i];
        if ((w->ctx->types + a)->kind.tag == TypeKind::TypeParam) { i++; continue; }
        if (!w->sema->sameType(a, args[i])) return false;
        i++;
    }
    return true;
}

/* a `root::name(...)` callee: module function, then static method on
 * an owner type, then the bare name as a last resort (the order the C
 * backend resolves in). Null only after the last form also fails to
 * name a function — that failure is reported by the bare resolver. */
/* resolves a `mod::…::member` callee path to the member's Func decl
 * node, walking module symbols exactly like mono's collect pass does.
 * Returns NodeId 0 for type-headed paths (`Foo::new`) and non-module
 * roots — those stay on the method-owner path below. */
/* `a::b::c` paths parse left-nested: Path{ [Path{a,b}, c] }. Flatten
 * to leaf segment node ids so module walks see every `::` step. */
u32 muvPathLeaves(Muv* w, NodeId pathId, NodeId* out, u32 cap)
{
    Node* pn = muvNode(w, pathId);
    if (pn == null || pn->kind.tag != NodeKind::Expr) return 0;
    Expr* pe = &pn->kind.payload.Expr.value;
    if (pe->kind.tag != ExprKind::Path) return 0;
    NodeId* segs = pe->kind.payload.Path.segments;
    u32 sn = pe->kind.payload.Path.segmentsLen;
    u32 n = 0;
    u32 i = 0;
    while (i < sn && n < cap)
    {
        NodeId sid = segs[i];
        Node* sn2 = muvNode(w, sid);
        if (sn2 != null && sn2->kind.tag == NodeKind::Expr &&
            sn2->kind.payload.Expr.value.kind.tag == ExprKind::Path)
            n += muvPathLeaves(w, sid, out + n, cap - n);
        else { out[n] = sid; n++; }
        i++;
    }
    return n;
}

NodeId muvModuleFuncDecl(Muv* w, NodeId pathId)
{
    NodeId none;
    none.index = 0;
    if (w->sema == null || w->sema->scopes == null) return none;
    Node* pn = muvNode(w, pathId);
    if (pn->kind.tag != NodeKind::Expr) return none;
    Expr* pe = &pn->kind.payload.Expr.value;
    if (pe->kind.tag != ExprKind::Path) return none;
    NodeId[24] leaves;
    u32 n = muvPathLeaves(w, pathId, leaves, 24);
    if (n < 2) return none;
    Node* s0 = muvNode(w, leaves[0]);
    if (s0->kind.tag != NodeKind::Expr ||
        s0->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return none;
    Str rootName = s0->kind.payload.Expr.value.kind.payload.Ident.name;
    u32 refFile = 0;
    if (pn != null) refFile = locFile(pn->loc);
    Symbol* sym = w->sema->scopes->lookupFrom(rootName, refFile);
    if (sym == null || sym->kind != 5 || sym->declaration.index == 0) return none;
    Node* curMod = muvNode(w, sym->declaration);
    u32 i = 1;
    while (i < n)
    {
        Node* sn = muvNode(w, leaves[i]);
        if (sn->kind.tag != NodeKind::Expr ||
            sn->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return none;
        Str mname = sn->kind.payload.Expr.value.kind.payload.Ident.name;
        Symbol* ms = w->sema->lookupModuleMember(curMod, mname);
        if (ms == null || ms->declaration.index == 0) return none;
        if (i + 1 == n)
        {
            Node* mn = muvNode(w, ms->declaration);
            if (mn->kind.tag == NodeKind::Decl &&
                mn->kind.payload.Decl.value.kind.tag == DeclKind::Func)
                return ms->declaration;
            return none;
        }
        if (ms->kind != 5) return none;
        curMod = muvNode(w, ms->declaration);
        i++;
    }
    return none;
}

/* `mod::…::name` in value position: same module walk as
 * muvModuleFuncDecl but returns the final segment's decl of ANY kind
 * (constants, statics, …). Null for type-headed paths. */
NodeId muvModuleMemberDecl(Muv* w, NodeId pathId)
{
    NodeId none;
    none.index = 0;
    if (w->sema == null || w->sema->scopes == null) return none;
    Node* pn = muvNode(w, pathId);
    if (pn->kind.tag != NodeKind::Expr) return none;
    Expr* pe = &pn->kind.payload.Expr.value;
    if (pe->kind.tag != ExprKind::Path) return none;
    NodeId[24] leaves;
    u32 n = muvPathLeaves(w, pathId, leaves, 24);
    if (n < 2) return none;
    Node* s0 = muvNode(w, leaves[0]);
    if (s0->kind.tag != NodeKind::Expr ||
        s0->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return none;
    Str rootName = s0->kind.payload.Expr.value.kind.payload.Ident.name;
    u32 refFile = 0;
    if (pn != null) refFile = locFile(pn->loc);
    Symbol* sym = w->sema->scopes->lookupFrom(rootName, refFile);
    if (sym == null || sym->kind != 5 || sym->declaration.index == 0) return none;
    Node* curMod = muvNode(w, sym->declaration);
    u32 i = 1;
    while (i < n)
    {
        Node* sn = muvNode(w, leaves[i]);
        if (sn->kind.tag != NodeKind::Expr ||
            sn->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return none;
        Str mname = sn->kind.payload.Expr.value.kind.payload.Ident.name;
        Symbol* ms = w->sema->lookupModuleMember(curMod, mname);
        if (ms == null || ms->declaration.index == 0) return none;
        if (i + 1 == n) return ms->declaration;
        if (ms->kind != 5) return none;
        curMod = muvNode(w, ms->declaration);
        i++;
    }
    return none;
}

IrFunc* muvResolveCalleePath(Muv* w, NodeId calleeId, NodeId refSite, NodeId* args, u32 argsLen)
{
    Node* cn = muvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr) return null;
    Expr* ce = &cn->kind.payload.Expr.value;
    NodeId* segs = ce->kind.payload.Path.segments;
    u32 sn = ce->kind.payload.Path.segmentsLen;
    if (sn == 0) return null;
    /* module-qualified function: `ios::println(...)`. Resolved through
     * the same module walk collect uses, so generic instances picked
     * here are the ones collect enqueued for this call site. */
    NodeId mdecl = muvModuleFuncDecl(w, calleeId);
    if (mdecl.index != 0)
    {
        if (w->mono != null && w->mono->genericCount(mdecl) != 0)
            return muvPickInstanceForDecl(w, mdecl, args, argsLen, refSite);
        IrFunc* mf = muvFnMapGet(w, mdecl.index);
        if (mf != null) return mf;
        Node* mdn = muvNode(w, mdecl);
        if (mdn->kind.tag != NodeKind::Decl) return null;
        Decl* mdd = &mdn->kind.payload.Decl.value;
        if (mdd->kind.tag != DeclKind::Func) return null;
        muvAddFunc(w, mf);
        muvFnMapPut(w, mdecl.index, mf);
        return mf;
    }
    if (sn >= 2)
    {
        NodeId[24] fleaves;
        u32 fnn = muvPathLeaves(w, calleeId, fleaves, 24);
        Node* s0 = fnn > 0 ? muvNode(w, fleaves[0]) : null;
        Node* sl = muvNode(w, segs[sn - 1]);
        if (s0 != null && sl != null &&
            s0->kind.tag == NodeKind::Expr && sl->kind.tag == NodeKind::Expr &&
            s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
            sl->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        {
            Str root = s0->kind.payload.Expr.value.kind.payload.Ident.name;
            Str fname = sl->kind.payload.Expr.value.kind.payload.Ident.name;
            IrFunc* f = muvLookupPathModule(w, root, fname, refSite);
            if (f != null) return f;
            NodeId mdef = muvFindMethodDeclOwner(w, root, fname);
            if (mdef.index != 0)
            {
                if (w->mono != null && w->mono->genericCount(mdef) != 0)
                    { muvErr(w, refSite, "call to a generic method (Phase 2)"); return null; }
                if (muvMethodSelfKind(w, mdef) != 0)
                    { muvErr(w, refSite, "instance method needs a receiver expression"); return null; }
                str msym = muvMethodMangle(w, mdef, root, fname);
                if (msym.len == 0) return null;
                /* the names table first: it is the one binding whose key
                 * differs per instance (the fn map is keyed by declId and
                 * one mdef is shared by every instance of the type) */
                if (w->names != null)
                {
                    MuvNameEnt* ent = muvNamesFind(w->names, msym);
                    if (ent != null && ent->f != null) return ent->f;
                }
                f = muvFnMapGet(w, mdef.index);
                if (f != null) return f;
                Node* mn = muvNode(w, mdef);
                if (mn->kind.tag != NodeKind::Decl) return null;
                Decl* md = &mn->kind.payload.Decl.value;
                if (md->kind.tag != DeclKind::Func) return null;
                muvAddFunc(w, f);
                muvFnMapPut(w, mdef.index, f);
                return f;
            }
        }
        else if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef &&
                 sl->kind.tag == NodeKind::Expr && sl->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        {
            /* static method on a generic instance: `Foo<i32>::new(...)` —
             * owner = the composed instance name (mirror cgResolveCall's
             * TypeRef-root arm); its sweep-declared shell lives in the
             * names table under `<instance>_<method>` */
            Str fname = sl->kind.payload.Expr.value.kind.payload.Ident.name;
            Str owner = muvOwnerStr(w, s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode);
            if (owner != 0)
            {
                NodeId mdef = muvFindMethodDeclOwner(w, owner, fname);
                if (mdef.index != 0)
                {
                    if (w->mono != null && w->mono->genericCount(mdef) != 0)
                        { muvErr(w, refSite, "call to a generic method (Phase 2)"); return null; }
                    if (muvMethodSelfKind(w, mdef) != 0)
                        { muvErr(w, refSite, "instance method needs a receiver expression"); return null; }
                    str msym = muvMethodMangleEx(w, mdef, owner,
                                                s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,
                                                null, 0, fname);
                    if (msym.len == 0) return null;
                    if (w->names != null)
                    {
                        MuvNameEnt* ent = muvNamesFind(w->names, msym);
                        if (ent != null && ent->f != null) return ent->f;
                    }
                    /* every reachable instance method was declared by the
                     * sweep: declaring ad hoc here would let the declId-keyed
                     * fn map bind one instance's shell for all its siblings */
                    if (getenv(C"MUV_DEBUG") != null)
                        printf(C"muvdbg: instMethod miss msym=%.*s\n", (i32)msym.len, msym.ptr);
                    muvErr(w, refSite, "instance method was not declared (method sweep gap)");
                    return null;
                }
            }
            /* no such method — the bare last-segment form answers below */
        }
    }
    /* last segment as a plain name */
    Node* sl2 = muvNode(w, segs[sn - 1]);
    if (sl2->kind.tag == NodeKind::Expr &&
        sl2->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        return muvResolveCallee(w, sl2->kind.payload.Expr.value.kind.payload.Ident.name,
                               refSite, args, argsLen);
    return null;
}

/* the mono FunctionInstance of declId whose collected argument types and
 * Zig-style value key match this call site (mirror of cgCallFromDecl).
 * Reports and returns null when no unique instance applies. */
IrFunc* muvPickInstanceForDecl(Muv* w, NodeId declId, NodeId* args, u32 argsLen, NodeId refSite)
{
    if (w->mono == null || w->sema == null) return null;
    if (args == null)
    {
        muvErr(w, refSite, "call to a generic function (Phase 2)");
        return null;
    }
    u64 callKey = w->mono->callValueKeyTyped(args, argsLen, w->subs, w->subsLen);
    u32 gcount = w->mono->genericCount(declId);
    Ty* want = null;
    if (gcount > 0)
    {
        want = alloc<Ty>((usize)gcount);
        if (want == null) { muvErr(w, refSite, "out of memory resolving generic call"); return null; }
        zero<Ty>(want, (usize)gcount);
        w->mono->inferCallArgs(declId, args, argsLen, w->subs, w->subsLen, want);
    }
    u32 total = 0;
    u32 firstTotal = 0;
    u32 keyPick = 0;
    u32 typePick = 0;
    u32 typeMatches = 0;
    u32 i = 0;
    while (i < w->mono->instancesLen)
    {
        MonoInstance* inst = w->mono->instances + i;
        if (inst->kind == MonoInstanceKind::FunctionInstance && inst->declaration.index == declId.index)
        {
            if (total == 0) firstTotal = i;
            total++;
            bool ok = true;
            if (inst->argumentsLen == gcount)
            {
                u32 k = 0;
                while (k < gcount)
                {
                    if (want == null || want[k] == 0 ||
                        !w->sema->sameType(want[k], inst->arguments[k])) { ok = false; break; }
                    k++;
                }
            }
            else
                ok = false;
            if (ok)
            {
                typeMatches++;
                if (typePick == 0) typePick = i + 1;
                if (keyPick == 0 && inst->valueKey == callKey) keyPick = i + 1;
            }
        }
        i++;
    }
    if (want != null) dealloc<Ty>(want);
    if (total == 0)
    {
        muvErr(w, refSite, "no monomorphized instance for generic call (the call site was not collected)");
        return null;
    }
    u32 pick = firstTotal;
    if (keyPick != 0) pick = keyPick - 1;
    else if (typeMatches == 1 && w->mono->instances[typePick - 1].valueKey == 0) pick = typePick - 1;
    else
    {
        muvErr(w, refSite, "no unique mono instance for call");
        return null;
    }
    if (w->instFns == null || pick >= w->instFnsLen || w->instFns[pick] == null)
    {
        muvErr(w, refSite, "mono instance was not lowered");
        return null;
    }
    return w->instFns[pick];
}

/* callee written with explicit type arguments (`f<T>(…)` — the parser
 * hands it over as ExprKind::TypeRef): pick the instance whose collected
 * arguments equal the written ones (resolved through any active
 * substitutions), preferring the exact value key. Mirror of
 * cgResolveGenericCall. */
IrFunc* muvResolveGenericCall(Muv* w, Str fname, Ty namedTy, NodeId refSite,
                             NodeId* args, u32 argsLen)
{
    if (w->mono == null || w->sema == null)
    {
        muvErr(w, refSite, "no monomorphized instance for generic call (the call site was not collected)");
        return null;
    }
    Ty* gargs = null;
    u32 glen = 0;
    if (namedTy != 0)
    {
        TypeEntry* te = w->ctx->types + namedTy;
        if (te->kind.tag == TypeKind::Named)
        {
            gargs = te->kind.payload.Named.genericArgs;
            glen = te->kind.payload.Named.genericArgsLen;
        }
    }
    Ty* gbuf = null;
    if (glen > 0 && w->subs != null && w->subsLen > 0)
    {
        /* inside an instance body the written args may be the template's
         * own params (`dealloc<T>` in realloc<cchar>): resolve them
         * through the current substitutions before instance matching */
        gbuf = alloc<Ty>((usize)glen);
        if (gbuf != null)
        {
            u32 gi = 0;
            while (gi < glen)
            {
                gbuf[gi] = w->mono->substituteType(gargs[gi], w->subs, w->subsLen);
                gi++;
            }
            gargs = gbuf;
        }
    }
    if (glen == 0)
    {
        if (gbuf != null) dealloc<Ty>(gbuf);
        muvErr(w, refSite, "generic call without type arguments");
        return null;
    }
    u64 wantKey = w->mono->callValueKeyTyped(args, argsLen, w->subs, w->subsLen);
    /* the declaring file's decl owns the instance: resolve through sema
     * like every other reference (name-based scan as the fallback) */
    NodeId declId;
    declId.index = 0;
    u32 refFile = 0;
    if (refSite.index != 0) refFile = locFile(muvNode(w, refSite)->loc);
    if (fname != 0 && w->sema->scopes != null)
    {
        Symbol* sym = w->sema->scopes->lookupFrom(fname, refFile);
        if (sym != null) declId = sym->declaration;
    }
    u32 pick = 0;
    if (declId.index != 0)
    {
        u32 i = 0;
        while (i < w->mono->instancesLen)
        {
            MonoInstance* inst = w->mono->instances + i;
            if (inst->kind == MonoInstanceKind::FunctionInstance &&
                inst->declaration.index == declId.index && inst->argumentsLen == glen)
            {
                bool ok = true;
                u32 k = 0;
                while (k < glen)
                {
                    if (!w->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }
                    k++;
                }
                if (ok)
                {
                    if (pick == 0) pick = i + 1;
                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }
                }
            }
            i++;
        }
    }
    if (pick == 0 && fname != 0)
    {
        u32 i = 0;
        while (i < w->mono->instancesLen)
        {
            MonoInstance* inst = w->mono->instances + i;
            if (inst->kind == MonoInstanceKind::FunctionInstance &&
                inst->name == fname && inst->argumentsLen == glen)
            {
                bool ok = true;
                u32 k = 0;
                while (k < glen)
                {
                    if (!w->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }
                    k++;
                }
                if (ok)
                {
                    if (pick == 0) pick = i + 1;
                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }
                }
            }
            i++;
        }
    }
    if (gbuf != null) dealloc<Ty>(gbuf);
    if (pick == 0)
    {
        if (getenv(C"MUV_DEBUG") != null)
        {
            printf(C"muvdbg: generic call miss declId=%u glen=%u instances=%u subsLen=%u subsNull=%u\n",
                   declId.index, glen, w->mono->instancesLen, w->subsLen,
                   w->subs == null ? 1 : 0);
            u32 di = 0;
            while (di < w->mono->instancesLen && di < 40)
            {
                MonoInstance* inst = w->mono->instances + di;
                if (inst->kind == MonoInstanceKind::FunctionInstance)
                    printf(C"  inst[%u] decl=%u argsLen=%u\n", di,
                           inst->declaration.index, inst->argumentsLen);
                di++;
            }
        }
        muvErr(w, refSite, "no monomorphized instance for generic call (the call site was not collected)");
        return null;
    }
    if (w->instFns == null || pick - 1 >= w->instFnsLen || w->instFns[pick - 1] == null)
    {
        muvErr(w, refSite, "mono instance was not lowered");
        return null;
    }
    return w->instFns[pick - 1];
}

/* resolve a bare-name call target. Null means the name is not a
 * function — reported here because every call site wants that said. */
pub IrFunc* muvResolveCallee(Muv* w, Str name, NodeId refSite, NodeId* args, u32 argsLen)
{
    if (name != 0 && w->mono != null && w->sema != null && w->sema->scopes != null)
    {
        u32 refFile = 0;
        if (refSite.index != 0) refFile = locFile(muvNode(w, refSite)->loc);
        Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);
        if (sym != null && sym->declaration.index != 0 &&
            w->mono->genericCount(sym->declaration) != 0)
            return muvPickInstanceForDecl(w, sym->declaration, args, argsLen, refSite);
    }
    IrFunc* f = muvLookupFunc(w, name, refSite);
    if (f == null) muvErr(w, refSite, "unresolved call target");
    return f;
}

/* resolve a bare name to a file-scope constant declaration: sema scope
 * lookup (the same walk calls use) → declId, kept only when it really
 * is a constant. Null when the name is not one — the caller decides
 * whether that is an error or falls through to another resolution. */
pub NodeId muvResolveConst(Muv* w, Str name, NodeId refSite)
{
    NodeId none;
    none.index = 0;
    if (name == 0 || w->sema == null || w->sema->scopes == null) return none;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = muvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return none;
    Node* sn = muvNode(w, sym->declaration);
    if (sn->kind.tag != NodeKind::Decl) return none;
    if (sn->kind.payload.Decl.value.kind.tag != DeclKind::Constant) return none;
    /* a name that keeps storage (`var`, `static`, `extern`) is not a
     * value to fold — references reach its global through the map */
    if ((sn->kind.payload.Decl.value.kind.payload.Constant.flags & 16) == 0) return none;
    return sym->declaration;
}

/* a name that keeps storage → its address value. The collection pass
 * registered one IrGlobal per declaring node, so the sema symbol's
 * declaration indexes straight into that map. */
pub IrValue* muvResolveGlobal(Muv* w, Str name, NodeId refSite)
{
    if (name == 0 || w->sema == null || w->sema->scopes == null) return null;
    u32 refFile = 0;
    if (refSite.index != 0)
    {
        Node* rn = muvNode(w, refSite);
        refFile = locFile(rn->loc);
    }
    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);
    if (sym == null || sym->declaration.index == 0) return null;
    IrGlobal* g = muvGMapGet(w, sym->declaration.index);
    if (g == null) return null;
    return &g->base;
}

/* strtod over a NUL-terminated arena copy of the literal text */
pub f64 muvParseFloat(Muv* w, Str value)
{
    str sv = muvStr(w, value);
    if (w->arena == null) return 0;
    rawptr buf = w->arena->alloc(sv.len + 1, 1);
    if (buf == null) return 0;
    u8* bp = (u8*)buf;
    usize i = 0;
    while (i < sv.len) { bp[i] = sv.ptr[i]; i++; }
    bp[sv.len] = 0;
    return strtod((const cchar*)bp, null);
}

/* the f64 a ConstFloat carries, read back out of its raw bits */
f64 muvConstFloatBits(IrValue* v)
{
    f64 d = 0;
    copy<u8>((u8*)&d, (u8*)&v->valData, 8);
    return d;
}

// pub IrValue* muvConstInit(Muv* w, NodeId initId, IrType* dt);

/* fold an initializer and read it back as an integer / an f64. Both
 * answer false without touching `out` when the node does not fold that
 * way — the caller then reports. */
pub bool muvConstU64(Muv* w, NodeId id, IrType* dt, u64* out)
{
    IrValue* v = muvConstInit(w, id, dt);
    if (v == null || v->kind != IrValueKind::ConstInt) return false;
    *out = v->valData;
    return true;
}

bool muvConstF64(Muv* w, NodeId id, IrType* dt, f64* out)
{
    IrValue* v = muvConstInit(w, id, dt);
    if (v == null || v->kind != IrValueKind::ConstFloat) return false;
    *out = muvConstFloatBits(v);
    return true;
}

/* enum member constant: auto-increment ordinal with explicit `= N`
 * resetting the counter (same computation the pattern-side switch
 * lowering and the C backend's enum emission use). false when the
 * member is absent or its value is not constant. */
pub bool muvEnumMemberConst(Muv* w, Decl* edd, Str member, IrType* bt, u64* out)
{
    u64 running = 0;
    u32 v = 0;
    while (v < edd->kind.payload.Enum.variantsLen)
    {
        Node* vn = muvNode(w, edd->kind.payload.Enum.variants[v]);
        if (vn->kind.tag == NodeKind::EnumVariant)
        {
            EnumVariant* ev = &vn->kind.payload.EnumVariant.value;
            if (ev->name == member)
            {
                if ((ev->flags & 1) != 0)
                    return muvConstU64(w, ev->value, bt, out);
                *out = running;
                return true;
            }
            if ((ev->flags & 1) != 0)
            {
                u64 evv = 0;
                running = muvConstU64(w, ev->value, bt, &evv) ? evv + 1 : running + 1;
            }
            else running++;
        }
        v++;
    }
    return false;
}

/* compile-time initializer for static storage: literals, their negation
 * and a cast over either fold into an IrValue of the storage's own type;
 * anything else would need code at load time (Phase 3). */
/* serialize a static-storage constant into raw bytes at buf (little
 * endian, real struct field offsets). returns bytes written, or 0 when
 * the value cannot be flattened (relocatable addresses etc.) — union
 * literals in static storage are stored as an i8 const array image */
pub usize muvConstSer(Muv* w, IrValue* v, u8* buf, usize cap)
{
    if (v == null || buf == null) return 0;
    switch (v->kind)
    {
        IrValueKind::ConstInt => {
            u32 n = w->ir->irTypeSizeOf(v->type);
            if (n > 8) n = 8;
            if ((usize)n > cap) n = (u32)cap;
            u64 x = v->valData & 0xFFFFFFFFFFFFFFFFUL;
            u32 i = 0;
            while (i < n) { buf[i] = (u8)(x & 0xFF); x >>= 8; i++; }
            return (usize)n;
        },
        IrValueKind::ConstFloat => {
            u32 n = w->ir->irTypeSizeOf(v->type);
            u64 bits = v->valData & 0xFFFFFFFFFFFFFFFFUL;
            if (n > 8) n = 8;
            if ((usize)n > cap) n = (u32)cap;
            u32 i = 0;
            while (i < n) { buf[i] = (u8)(bits & 0xFF); bits >>= 8; i++; }
            return (usize)n;
        },
        IrValueKind::ConstArray => {
            IrArrayConst* ac = (IrArrayConst*)v;
            IrType* et = v->type != null ? v->type->elem : null;
            u32 es = et != null ? w->ir->irTypeSizeOf(et) : 1;
            usize off = 0;
            u32 i = 0;
            while (i < ac->nelems && off < cap)
            {
                usize wro = muvConstSer(w, ac->elems[i], buf + off, cap - off);
                if (wro == 0) return 0;
                off += (usize)es;
                i++;
            }
            return off;
        },
        IrValueKind::StructConst => {
            IrStructConst* sc = (IrStructConst*)v;
            /* real field offsets when the tracked IrStructType is
             * known; sequential otherwise (matches backend emission) */
            IrStructType* st = null;
            u32 si = 0;
            while (si < w->structTysLen)
            {
                if (w->structTys[si] != null && w->structTys[si]->irType == v->type)
                    { st = w->structTys[si]; break; }
                si++;
            }
            u32 i = 0;
            while (i < sc->nelems && i < (st != null ? st->nfields : sc->nelems))
            {
                usize fo = st != null && st->offsets != null ? (usize)st->offsets[i] : 0;
                if (fo >= cap) { i++; continue; }
                usize wro = muvConstSer(w, sc->elems[i], buf + fo, cap - fo);
                if (wro == 0) return 0;
                i++;
            }
            return (usize)w->ir->irTypeSizeOf(v->type);
        },
        else => { return 0; }
    }
}

pub IrValue* muvConstInit(Muv* w, NodeId initId, IrType* dt)
{
    if (initId.index == 0 || dt == null) return null;
    Node* n = muvNode(w, initId);
    if (n->kind.tag != NodeKind::Expr)
    {
        muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::IntLit => { return w->ir->constInt(dt, e->kind.payload.IntLit.value); },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(dt, v);
        },
        ExprKind::CharLit => { return w->ir->constInt(dt, (u64)e->kind.payload.CharLit.value); },
        ExprKind::NullLit => { return w->ir->constInt(dt, 0); },
        ExprKind::FloatLit => {
            return w->ir->constFloat(dt, muvParseFloat(w, e->kind.payload.FloatLit.value));
        },
        ExprKind::Neg => {
            IrValue* v = muvConstInit(w, e->kind.payload.Neg.expr, dt);
            if (v == null) return null;
            if (v->kind == IrValueKind::ConstFloat)
            {
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&v->valData, 8);
                return w->ir->constFloat(dt, -d);
            }
            return w->ir->constInt(dt, (u64)(0 - (i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL)));
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            /* a function reference is its symbol address */
            IrFunc* f = muvLookupFunc(w, name, initId);
            if (f != null) return &f->base;
            /* a plain constant folds to its own initializer — before the
             * global lookup, since const decls also register storage and
             * their address is a pointer, not the constant value */
            NodeId cd = muvResolveConst(w, name, initId);
            if (cd.index != 0)
            {
                Node* cn = muvNode(w, cd);
                NodeId inner = cn->kind.payload.Decl.value.kind.payload.Constant.value;
                if (inner.index != 0) return muvConstInit(w, inner, dt);
            }
            /* another name that keeps storage: its address */
            IrValue* gv = muvResolveGlobal(w, name, initId);
            if (gv != null) return gv;
            muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
            return null;
        },
        ExprKind::StringLit => {
            str tok = muvStr(w, e->kind.payload.StringLit.value);
            bool isC = (e->kind.payload.StringLit.flags & 1) != 0;
            usize begin = 0;
            usize end = tok.len;
            if (isC)
            {
                if (tok.len >= 3 && tok.ptr[0] == 67 && tok.ptr[1] == 34)
                    { begin = 2; end = tok.len - 1; }
            }
            else if (tok.len >= 2 && tok.ptr[0] == 34)
                { begin = 1; end = tok.len - 1; }
            u8* buf = (u8*)muvArr(w, (end - begin) + 4, 1);
            if (buf == null) { muvErr(w, initId, "string literal buffer"); return null; }
            usize dlen = muvDecodeLit(tok, begin, end, buf);
            str bytes = str::fromParts(buf, dlen);
            IrStringConst* sc = w->module->findConstString(bytes, (u32)dlen);
            if (sc == null)
            {
                sc = w->ir->createStringConst(bytes, (u32)dlen);
                if (sc == null) { muvErr(w, initId, "string constant creation failed"); return null; }
                w->module->addConstString(sc);
            }
            if (isC) return &sc->base;
            /* a `str` is { ptr, len } laid out statically */
            Ty rt = muvResolved(w, e->resolvedType);
            /* literals inside aggregate initializers carry no resolved
             * type of their own — the element type comes from the
             * array, so fall back to the canonical str type */
            if (rt == 0 && w->sema != null) rt = w->sema->strType();
            IrType* st = rt != 0 ? muvTy(w, rt, 0) : null;
            if (st == null || st->kind != IrTypeKind::Struct)
                { muvErr(w, initId, "str literal needs the str type"); return null; }
            IrValue*[2] parts;
            parts[0] = &sc->base;
            parts[1] = w->ir->constInt(w->ir->tyInt(64), (u64)dlen);
            return w->ir->createStructConst(st, parts, 2);
        },
        ExprKind::StructLiteral => {
            if (e->kind.payload.StructLiteral.variantName != 0)
                { muvErr(w, initId, "variant construction in static storage (Phase 3)"); return null; }
            Ty stw = muvResolved(w, e->kind.payload.StructLiteral.typeNode);
            /* the storage's own type decides the layout; the literal's
             * type node only gives the field names their order */
            IrType* irt = dt->kind == IrTypeKind::Struct || dt->kind == IrTypeKind::Union ? dt
                          : (stw != 0 ? muvTy(w, stw, 0) : null);
            Decl* ud = muvUnionDeclOf(w, stw);
            if (ud != null)
            {
                /* union literal in static storage: serialize the field
                 * values into a byte image at offset 0 (last field
                 * wins) and keep it as an i8 const array — there is no
                 * ConstUnion value kind, and the global's declared size
                 * already comes from the union type */
                if (irt == null || irt->kind != IrTypeKind::Union)
                    { muvErr(w, initId, "union literal needs a union type"); return null; }
                u32 size = w->ir->irTypeSizeOf(irt);
                u8* bytes = (u8*)muvArr(w, (usize)(size > 0 ? size : 1), 1);
                if (bytes == null) { muvErr(w, initId, "union literal buffer"); return null; }
                u32 zi = 0;
                while (zi < size) { bytes[zi] = 0; zi++; }
                u32 i = 0;
                u32 m = e->kind.payload.StructLiteral.fieldValuesLen;
                Str* fnames = e->kind.payload.StructLiteral.fieldNames;
                NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
                while (i < m)
                {
                    if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }
                    IrType* ft = fnames != null
                        ? muvUnionFieldTy(w, ud, fnames[i], 0)
                        : muvUnionFieldTyIdx(w, ud, i, 0);
                    if (ft == null)
                        { muvErr(w, initId, "unknown union literal field"); return null; }
                    IrValue* fv = muvConstInit(w, fvals[i], ft);
                    if (fv == null) return null;
                    if (muvConstSer(w, fv, bytes, (usize)size) == 0 && size > 0)
                        { muvErr(w, initId, "union literal field is not a static constant"); return null; }
                    i++;
                }
                IrValue** evs = (IrValue**)muvArr(w, (usize)(size > 0 ? size : 1), 8);
                if (evs == null) { muvErr(w, initId, "union literal elements"); return null; }
                IrType* i8t = w->ir->tyInt(8);
                u32 bi = 0;
                while (bi < size)
                {
                    evs[bi] = w->ir->constInt(i8t, (u64)bytes[bi]);
                    bi++;
                }
                IrType* blob = w->ir->tyArray(i8t, size);
                return w->ir->constArray(blob, evs, size);
            }
            if (irt == null || irt->kind != IrTypeKind::Struct)
                { muvErr(w, initId, "struct literal needs a struct type"); return null; }
            u32 n = irt->nparams;
            IrValue** fields = (IrValue**)muvArr(w, (usize)n, 8);
            if (fields == null) return null;
            u32 z = 0;
            while (z < n) { fields[z] = null; z++; }
            u32 i = 0;
            u32 m = e->kind.payload.StructLiteral.fieldValuesLen;
            Str* fnames = e->kind.payload.StructLiteral.fieldNames;
            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
            while (i < m)
            {
                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }
                u32 fi = muvFieldIdx(w, stw, fnames[i]);
                if (fi == 0xFFFFFFFF || fi >= n)
                    { muvErr(w, initId, "unknown struct literal field"); return null; }
                fields[fi] = muvConstInit(w, fvals[i], irt->params[fi]);
                i++;
            }
            return w->ir->createStructConst(irt, fields, n);
        },
        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            IrType* irt = dt;
            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))
                { muvErr(w, initId, "aggregate literal needs an aggregate type"); return null; }
            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;
            u32 cnt = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;
            u32 cap = irt->kind == IrTypeKind::Array ? (irt->count > 0 ? irt->count : cnt) : irt->nparams;
            if (cap < cnt) cap = cnt;
            IrValue** evs = (IrValue**)muvArr(w, (usize)cap, 8);
            if (evs == null) return null;
            u32 i = 0;
            while (i < cap)
            {
                evs[i] = null;
                i++;
            }
            i = 0;
            while (i < cnt && elems != null)
            {
                if (elems[i].index != 0)
                {
                    IrType* et = irt->kind == IrTypeKind::Array ? irt->elem
                        : (i < irt->nparams ? irt->params[i] : null);
                    if (et != null) evs[i] = muvConstInit(w, elems[i], et);
                }
                i++;
            }
            if (irt->kind == IrTypeKind::Array) return w->ir->constArray(irt, evs, cnt);
            return w->ir->createStructConst(irt, evs, cap);
        },
        ExprKind::Sizeof => {
            Ty st = muvResolved(w, e->kind.payload.Sizeof.targetType);
            IrType* stt = st != 0 ? muvTy(w, st, 0) : null;
            if (stt == null) { muvErr(w, initId, "sizeof of an unknown type in an initializer"); return null; }
            return w->ir->constInt(dt, (u64)w->ir->irTypeSizeOf(stt));
        },
        ExprKind::Alignof => {
            Ty st = muvResolved(w, e->kind.payload.Alignof.targetType);
            IrType* stt = st != 0 ? muvTy(w, st, 0) : null;
            if (stt == null) { muvErr(w, initId, "alignof of an unknown type in an initializer"); return null; }
            u32 al = w->ir->irTypeAlignOf(stt);
            if (al == 0) al = 1;
            return w->ir->constInt(dt, (u64)al);
        },
        ExprKind::Cast => {
            IrValue* v = muvConstInit(w, e->kind.payload.Cast.expr, dt);
            if (v == null) return null;
            /* both sides already carry the storage's type: only a float
             * narrowed to an integer needs an actual conversion */
            if (v->kind == IrValueKind::ConstFloat && dt->kind != IrTypeKind::Float)
            {
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&v->valData, 8);
                return w->ir->constInt(dt, (u64)(i64)d);
            }
            if (v->kind == IrValueKind::ConstFloat) return w->ir->constFloat(dt, muvConstFloatBits(v));
            if (dt->kind == IrTypeKind::Float)
                return w->ir->constFloat(dt, (f64)(i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL));
            return w->ir->constInt(dt, v->valData);
        },
        ExprKind::BitNot | ExprKind::Not => {
            if (dt->kind != IrTypeKind::Int)
                { muvErr(w, initId, "bitwise not of a non-integer constant (Phase 3)"); return null; }
            NodeId inner = e->kind.tag == ExprKind::BitNot
                ? e->kind.payload.BitNot.expr : e->kind.payload.Not.expr;
            u64 v = 0;
            if (!muvConstU64(w, inner, dt, &v))
                { muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
            if (e->kind.tag == ExprKind::BitNot) return w->ir->constInt(dt, ~v);
            return w->ir->constInt(dt, v == 0 ? 1 : 0);
        },
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr | ExprKind::And | ExprKind::Or => {
            NodeId lid = e->kind.payload.Add.left;
            NodeId rid = e->kind.payload.Add.right;
            bool isArith = e->kind.tag == ExprKind::Add || e->kind.tag == ExprKind::Sub ||
                           e->kind.tag == ExprKind::Mul || e->kind.tag == ExprKind::Div ||
                           e->kind.tag == ExprKind::Mod;
            if (dt->kind == IrTypeKind::Float)
            {
                if (!isArith || e->kind.tag == ExprKind::Mod)
                    { muvErr(w, initId, "operator has no constant float form (Phase 3)"); return null; }
                f64 a = 0;
                f64 b = 0;
                if (!muvConstF64(w, lid, dt, &a) || !muvConstF64(w, rid, dt, &b))
                    { muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
                f64 r = 0;
                if (e->kind.tag == ExprKind::Add) r = a + b;
                else if (e->kind.tag == ExprKind::Sub) r = a - b;
                else if (e->kind.tag == ExprKind::Mul) r = a * b;
                else if (b != 0) r = a / b;
                return w->ir->constFloat(dt, r);
            }
            if (dt->kind != IrTypeKind::Int)
                { muvErr(w, initId, "arithmetic on a non-numeric constant (Phase 3)"); return null; }
            u64 a = 0;
            u64 b = 0;
            if (!muvConstU64(w, lid, dt, &a) || !muvConstU64(w, rid, dt, &b))
                { muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)"); return null; }
            /* signedness comes from the expression's own resolved type:
             * the IR type carries only a width */
            Ty ct = muvResolved(w, e->resolvedType);
            bool uns = ct != 0 && muvTyUnsigned(w, ct);
            i32 k = e->kind.tag;
            u64 r = 0;
            if (k == ExprKind::Add) r = a + b;
            else if (k == ExprKind::Sub) r = a - b;
            else if (k == ExprKind::Mul) r = a * b;
            else if (k == ExprKind::BitAnd) r = a & b;
            else if (k == ExprKind::BitOr) r = a | b;
            else if (k == ExprKind::BitXor) r = a ^ b;
            else if (k == ExprKind::And) r = (a != 0 && b != 0) ? 1 : 0;
            else if (k == ExprKind::Or) r = (a != 0 || b != 0) ? 1 : 0;
            else if (k == ExprKind::Shl) r = b >= 64 ? 0 : (a << b);
            else if (k == ExprKind::Shr)
                r = b >= 64 ? (uns ? 0 : 0)
                            : (uns ? (a >> b) : (u64)((i64)a >> (i64)b));
            else if (k == ExprKind::Div || k == ExprKind::Mod)
            {
                if (b == 0)
                    { muvErr(w, initId, "division by zero in a constant expression"); return null; }
                if (uns) r = (k == ExprKind::Div) ? (a / b) : (a % b);
                else
                {
                    i64 sa = (i64)a;
                    i64 sb = (i64)b;
                    r = (k == ExprKind::Div) ? (u64)(sa / sb) : (u64)(sa % sb);
                }
            }
            return w->ir->constInt(dt, r);
        },
        else => {
            muvErr(w, initId, "initializer of static storage must be a constant (Phase 3)");
            return null;
        },
    }
}

/* static storage for one name: an IrGlobal registered under the
 * declaring node, typed as a pointer to the data so loads, stores and
 * geppes all reach it. `disambiguator` (0 for file scope) keeps two
 * same-named statics in one file from sharing a symbol. */
pub IrValue* muvMakeGlobal(Muv* w, NodeId declId, Str name, Ty vt, NodeId initId,
                          bool isConst, bool isExtern, u32 disambiguator)
{
    /* `#[[threadlocal]]` has no muvm representation — TLS changes
     * program semantics, so this is a hard error rather than a silent
     * drop to ordinary static storage */
    {
        Node* an = muvNode(w, declId);
        u32 abits = 0;
        if (an->kind.tag == NodeKind::Decl) abits = an->kind.payload.Decl.value.attrBits;
        else if (an->kind.tag == NodeKind::Stmt) abits = an->kind.payload.Stmt.value.attrBits;
        if ((abits & ATTR_THREADLOCAL) != 0)
        {
            muvErr(w, declId, "attribute `threadlocal` is not supported by the muvm backend");
            return null;
        }
    }
    IrGlobal* seen = muvGMapGet(w, declId.index);
    if (seen != null) return &seen->base;
    if (vt == 0 && initId.index != 0)
    {
        /* `const NAME = value;` carries no type node: take the type the
         * initializer resolved to */
        Node* in = muvNode(w, initId);
        if (in->kind.tag == NodeKind::Expr)
            vt = muvResolved(w, in->kind.payload.Expr.value.resolvedType);
    }
    IrType* dt = vt != 0 ? muvTy(w, vt, 0) : null;
    if (dt == null || dt->kind == IrTypeKind::Void)
    {
        muvErr(w, declId, "cannot give this name storage");
        return null;
    }
    IrValue* init = null;
    if (initId.index != 0 && !isExtern) init = muvConstInit(w, initId, dt);
    str mangled = muvMangle(w, declId, name);
    if (disambiguator != 0)
    {
        muvMbCh(w, 36); // '$'
        u32 d = disambiguator;
        u8[10] tmp;
        u32 k = 0;
        if (d == 0) tmp[k++] = 48;
        while (d > 0) { tmp[k++] = (u8)(48 + (d % 10)); d /= 10; }
        while (k > 0) { k--; muvMbCh(w, tmp[k]); }
        mangled = muvMbStr(w);
    }
    IrGlobal* g = w->ir->createGlobal(mangled, w->ir->tyPtr(dt), isConst, isExtern,
                                      init, w->ir->irTypeAlignOf(dt));
    muvAddGlobal(w, g);
    muvGMapPut(w, declId.index, g);
    return &g->base;
}

/* C default-argument promotions for variadic args: int < 32-bit →
 * zext/sext to i32, float < 64-bit → fpext to f64 */
pub IrValue* muvPromoteVararg(Muv* w, IrValue* v, Ty coralTy)
{
    if (v == null || v->type == null) return v;
    Ty rt = muvBaseTy(w, coralTy);
    if (rt == 0) return v;
    TypeEntry* te = w->ctx->types + rt;
    bool uns = muvTyUnsigned(w, coralTy);
    switch (te->kind.tag)
    {
        TypeKind::I8 | TypeKind::I16 => {
            return muvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::U8 | TypeKind::U16 | TypeKind::Bool => {
            return muvV(w->b.zext(v, w->ir->tyInt(32)));
        },
        TypeKind::Char => {
            return uns ? muvV(w->b.zext(v, w->ir->tyInt(32)))
                       : muvV(w->b.sext(v, w->ir->tyInt(32)));
        },
        TypeKind::F32 => { return muvV(w->b.fpExt(v, w->ir->tyDouble())); },
        else => { return v; },
    }
}


/* lvalue shape for `T&` argument binding — mirrors sema's
 * isLvalueExpr without depending on the analyzer being reachable:
 * locals, field/index/deref chains, lvalue ternaries, and calls that
 * return references. */
bool muvLvalueExpr(Muv* w, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) return false;
    Expr* e = &n->kind.payload.Expr.value;
    switch (e->kind.tag)
    {
        ExprKind::Ident => {
            return muvFindLocal(w, e->kind.payload.Ident.name) != null;
        },
        ExprKind::Field | ExprKind::DerefField | ExprKind::TupleField |
        ExprKind::Index | ExprKind::Deref => { return true; },
        ExprKind::Ternary => {
            return muvLvalueExpr(w, e->kind.payload.Ternary.thenExpr) &&
                   muvLvalueExpr(w, e->kind.payload.Ternary.elseExpr);
        },
        ExprKind::Call | ExprKind::MethodCall | ExprKind::StaticCall => {
            Ty ct = muvResolved(w, e->resolvedType);
            while (ct != 0)
            {
                TypeEntry* te = w->ctx->types + ct;
                if (te->kind.tag == TypeKind::Const) ct = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) ct = te->kind.payload.Comptime.base;
                else break;
            }
            return ct != 0 && (w->ctx->types + ct)->kind.tag == TypeKind::Reference;
        },
        else => { return false; }
    }
}

/* evaluate a call's argument list: an optional receiver first, then
 * every listed argument (with vararg promotion past the fixed prefix).
 * Shared by bare calls and method calls. On failure *fail is set and
 * the array (if any) is already freed. */
pub IrValue** muvBuildCallArgs(Muv* w, IrFunc* f, NodeId* argv, u32 argvLen,
                              IrValue* recv, bool passRecv, u32* outN, bool* fail,
                              IrType** paramTypes, u32 paramCount)
{
    *fail = false;
    *outN = 0;
    u32 n = argvLen + (passRecv ? 1 : 0);
    IrValue** args = null;
    if (n > 0)
    {
        args = alloc<IrValue*>((usize)n);
        if (args == null) { *fail = true; return null; }
    }
    u32 j = 0;
    if (passRecv) { args[0] = recv; j = 1; }
    bool vararg = f != null && f->base.type != null && f->base.type->isVararg;
    u32 fixed = f != null ? f->nparams : 0;
    u32 i = 0;
    while (i < argvLen)
    {
        IrValue* av = muvExpr(w, argv[i]);
        if (av == null)
        {
            *fail = true;
            if (args != null) dealloc<IrValue*>(args);
            return null;
        }
        /* `T&` parameters take the referent ADDRESS: an argument that
         * is itself a reference passes its raw pointer, any other
         * lvalue binds by address (the C backend's cgRefArgText). The
         * IR cannot tell `T*` from `T&`, so this only fires when the
         * value form's type disagrees with the declared param type —
         * which sema only allows for reference bindings. */
        u32 pi = i + (passRecv ? 1 : 0);
        if (paramTypes != null && pi < paramCount && paramTypes[pi] != null &&
            av->type != null && !irTypeEqual(av->type, paramTypes[pi]))
        {
            if (getenv(C"MUV_DEBUG") != null)
            {
                Node* an0 = muvNode(w, argv[i]);
                i32 ek = an0 != null && an0->kind.tag == NodeKind::Expr
                    ? an0->kind.payload.Expr.value.kind.tag : -1;
                printf(C"muvdbg: argtype mismatch pi=%u ek=%d avk=%d pw=%u paramk=%d pw2=%u\n",
                       pi, ek, av->type->kind, av->type->width,
                       paramTypes[pi]->kind, paramTypes[pi]->width);
                if (av->type->kind == IrTypeKind::Ptr && paramTypes[pi]->kind == IrTypeKind::Ptr &&
                    av->type->elem != null && paramTypes[pi]->elem != null)
                {
                    printf(C"muvdbg:   elemk av=%d pw=%u param=%d pw2=%u np=%u/%u\n",
                           av->type->elem->kind, av->type->elem->width,
                           paramTypes[pi]->elem->kind, paramTypes[pi]->elem->width,
                           av->type->elem->nparams, paramTypes[pi]->elem->nparams);
                    IrStructType* ast = null;
                    IrStructType* pst = null;
                    u32 si = 0;
                    while (si < w->structTysLen)
                    {
                        IrStructType* st = w->structTys[si];
                        if (st != null && st->irType == av->type->elem) ast = st;
                        if (st != null && st->irType == paramTypes[pi]->elem) pst = st;
                        si++;
                    }
                    if (ast != null && pst != null)
                    {
                        str an = ast->name; str pn = pst->name;
                        printf(C"muvdbg:   avname=%.*s pname=%.*s nf=%u/%u\n",
                               (i32)an.len, an.ptr, (i32)pn.len, pn.ptr,
                               ast->nfields, pst->nfields);
                        u32 fi2 = 0;
                        while (fi2 < ast->nfields && fi2 < pst->nfields)
                        {
                            if (!irTypeEqual(ast->fieldTypes[fi2], pst->fieldTypes[fi2]))
                            {
                                str fn = ast->fieldNames[fi2];
                                printf(C"muvdbg:   fielddiff[%u]=%.*s ak=%d aw=%u pk=%d pw=%u\n",
                                       fi2, (i32)fn.len, fn.ptr,
                                       ast->fieldTypes[fi2]->kind, ast->fieldTypes[fi2]->width,
                                       pst->fieldTypes[fi2]->kind, pst->fieldTypes[fi2]->width);
                                break;
                            }
                            fi2++;
                        }
                    }
                }
            }
            Node* an = muvNode(w, argv[i]);
            Ty at = an->kind.tag == NodeKind::Expr
                ? an->kind.payload.Expr.value.resolvedType : 0;
            Ty bt = at;
            while (bt != 0)
            {
                TypeEntry* te = w->ctx->types + bt;
                if (te->kind.tag == TypeKind::Const) bt = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) bt = te->kind.payload.Comptime.base;
                else break;
            }
            IrValue* cand = null;
            if (bt != 0 && (w->ctx->types + bt)->kind.tag == TypeKind::Reference)
                cand = muvExprRaw(w, argv[i]);
            else if (muvLvalueExpr(w, argv[i]))
                cand = muvAddrOf(w, argv[i]);
            if (cand != null && cand->type != null &&
                irTypeEqual(cand->type, paramTypes[pi]))
                av = cand;
        }
        /* implicit numeric conversion: `f(1)` into an f64 param must
         * emit si_to_fp — the C backend gets this free from C */
        if (paramTypes != null && pi < paramCount && paramTypes[pi] != null &&
            !(vararg && pi >= fixed))
        {
            Node* an2 = muvNode(w, argv[i]);
            Ty at2 = an2->kind.tag == NodeKind::Expr
                ? an2->kind.payload.Expr.value.resolvedType : 0;
            av = muvCoerceToIr(w, av, at2, paramTypes[pi], argv[i]);
        }
        if (vararg && (i + (passRecv ? 1 : 0)) >= fixed)
        {
            Node* an = muvNode(w, argv[i]);
            Ty at = an->kind.tag == NodeKind::Expr ? an->kind.payload.Expr.value.resolvedType : 0;
            av = muvPromoteVararg(w, av, at);
        }
        /* by-value droppable args move into the callee: cancel the
         * caller's pending drop (mirrors cgMoveArg) */
        if (!(vararg && (i + (passRecv ? 1 : 0)) >= fixed))
            stmt::muvMoveArg(w, argv[i]);
        args[j] = av;
        j++;
        i++;
    }
    *outN = n;
    return args;
}

/* the Func decl in the module tree whose interned name matches a
 * precomputed FNV hash+length; id 0 when the unit does not contain it
 * (e.g. core::error was not imported). no probe string is interned. */
pub NodeId muvFindDeclByHash(Muv* w, u32 hash, u32 len)
{
    NodeId none;
    none.index = 0;
    if (w->file == null) return none;
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId did = file->decls[i];
        Node* n = muvNode(w, did);
        if (n->kind.tag == NodeKind::Decl &&
            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)
        {
            Decl* d = &n->kind.payload.Decl.value;
            if (w->ctx->internEqHashLen(d->kind.payload.Func.name, hash, len)) return did;
        }
        i++;
    }
    return none;
}

/* resolve a method's IrFunc: name-table hit first (the one binding whose
 * key differs per instance — an instance shares mdef with its siblings),
 * otherwise the declId-keyed fn map, otherwise declare a shell under the
 * composed `owner_method` symbol. `owner` is the bare owner spelling
 * (receiver side or the call site's own text), `recvTy` the receiver type
 * used to derive the implicit self pointee (0 when the caller knows the
 * method is static). *notFound distinguishes "no such method" (silent —
 * callers fall back or word their own error) from a lowering failure
 * (already reported). */
IrFunc* muvMethodShell(Muv* w, NodeId mdef, Str owner, Ty recvTy, Str methName,
                      NodeId id, bool* notFound)
{
    if (notFound != null) *notFound = false;
    if (mdef.index == 0)
    {
        if (notFound != null) *notFound = true;
        return null;
    }
    Node* mn = muvNode(w, mdef);
    if (mn->kind.tag != NodeKind::Decl ||
        mn->kind.payload.Decl.value.kind.tag != DeclKind::Func)
        { muvErr(w, id, "method is not a function"); return null; }
    Decl* md = &mn->kind.payload.Decl.value;
    if (w->mono != null && w->mono->genericCount(mdef) != 0)
        { muvErr(w, id, "call to a generic method (Phase 2)"); return null; }
    str msym = muvMethodMangleEx(w, mdef, owner, recvTy, null, 0, methName);
    if (msym.len == 0) { muvErr(w, id, "cannot compose the method symbol"); return null; }
    if (w->names != null)
    {
        MuvNameEnt* ent = muvNamesFind(w->names, msym);
        if (ent != null && ent->f != null) return ent->f;
    }
    if (getenv(C"MUV_DEBUG") != null)
        printf(C"muvdbg: shell miss msym=%.*s\n", (i32)msym.len, msym.ptr);
    /* an instance receiver with no declared shell means the sweep missed
     * it — declaring ad hoc would let the declId-keyed fn map bind one
     * instance's shell for all its siblings */
    if (recvTy != 0)
    {
        Ty gu = muvUnwrapTy(w, recvTy);
        if (gu != 0 && muvIsIndirect(w->ctx->types + gu))
            gu = muvUnwrapTy(w, muvIndirectBase(w->ctx->types + gu));
        if (gu != 0 && (w->ctx->types + gu)->kind.tag == TypeKind::Named &&
            (w->ctx->types + gu)->kind.payload.Named.genericArgsLen != 0)
        {
            if (getenv(C"MUV_DEBUG") != null)
            {
                TypeEntry* ge = w->ctx->types + gu;
                printf(C"muvdbg: instMethod miss2 nameHash=%u args=%u\n",
                       ge->kind.payload.Named.name, ge->kind.payload.Named.genericArgsLen);
            }
            muvErr(w, id, "instance method was not declared (method sweep gap)");
            return null;
        }
    }
    IrFunc* f = muvFnMapGet(w, mdef.index);
    if (f != null) return f;
    IrType* selfPt = null;
    if (muvMethodSelfKind(w, mdef) == 1 && recvTy != 0)
    {
        Ty u = muvUnwrapTy(w, recvTy);
        if (u != 0 && muvIsIndirect(w->ctx->types + u))
            u = muvUnwrapTy(w, muvIndirectBase(w->ctx->types + u));
        if (u != 0) selfPt = w->ir->tyPtr(muvTy(w, u, 0));
    }
    muvAddFunc(w, f);
    muvFnMapPut(w, mdef.index, f);
    return f;
}

/* the receiver-typed form: find the method on recvTy's owner, then the
 * shared shell. Used by method calls and for-in's count()/at()/range().
 * *outDef (optional) receives the method decl so callers can ask about
 * the receiver parameter. */
pub IrFunc* muvMethodFnFor(Muv* w, Ty recvTy, Str methName, NodeId id,
                          bool* notFound, NodeId* outDef)
{
    NodeId mdef = muvFindMethodDecl(w, recvTy, methName);
    if (outDef != null) *outDef = mdef;
    return muvMethodShell(w, mdef, muvOwnerStr(w, recvTy), recvTy, methName, id, notFound);
}

pub IrValue* muvCall(Muv* w, Expr* e, NodeId id)
{
    NodeId calleeId = e->kind.payload.Call.callee;
    Node* cn = muvNode(w, calleeId);
    if (cn->kind.tag != NodeKind::Expr)
    {
        muvErr(w, id, "unsupported callee form (Phase 1: bare-name calls only)");
        return null;
    }
    i32 ck = cn->kind.payload.Expr.value.kind.tag;
    IrFunc* f = null;
    if (ck == ExprKind::Ident)
    {
        /* a fn-pointer local/param called bare (`less(a, b)` in
         * isSortedBy): the callee lives in the local's slot — call
         * through the loaded pointer, the same form the method fallback
         * uses for a fn-pointer field. Checked before muvResolveCallee,
         * which reports an unresolved name outright and would fire for
         * a parameter that is not a file-scope function at all. */
        Str cname = cn->kind.payload.Expr.value.kind.payload.Ident.name;
        IrValue* cslot = muvFindLocal(w, cname);
        IrType* cfty = cslot != null ? muvSlotTy(cslot->type) : null;
        if (cfty != null && cfty->kind == IrTypeKind::Func)
        {
            IrInst* loadInst = w->b.load(cfty, cslot);
            muvSetDebugLoc(w, loadInst, id);
            IrValue* fval = muvV(loadInst);
            if (fval == null) return null;
            u32 pnargs = 0;
            bool pfail = false;
            IrValue** pargs = muvBuildCallArgs(w, null, e->kind.payload.Call.args,
                                              e->kind.payload.Call.argsLen,
                                              null, false, &pnargs, &pfail,
                                              cfty->params, cfty->nparams);
            if (pfail) return null;
            IrValue* pres = muvV(w->b.call(fval, pargs, pnargs));
            if (pargs != null) dealloc<IrValue*>(pargs);
            if (pres == null) return null;
            if (cfty->ret == null || cfty->ret->kind == IrTypeKind::Void) return null;
            return pres;
        }
        f = muvResolveCallee(w, cn->kind.payload.Expr.value.kind.payload.Ident.name, calleeId,
                            e->kind.payload.Call.args, e->kind.payload.Call.argsLen);
    }
    else if (ck == ExprKind::Path)
        f = muvResolveCalleePath(w, calleeId, id,
                                e->kind.payload.Call.args, e->kind.payload.Call.argsLen);
    else if (ck == ExprKind::TypeRef)
        f = muvResolveGenericCall(w, cn->kind.payload.Expr.value.kind.payload.TypeRef.name,
                                 cn->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,
                                 calleeId, e->kind.payload.Call.args,
                                 e->kind.payload.Call.argsLen);
    else if (ck == ExprKind::Index || ck == ExprKind::Field ||
             ck == ExprKind::Deref)
    {
        /* call through any expression that yields a function pointer:
         * `fs[0](x)`, `holder.fn(x)`, `(*fp)(x)` */
        IrValue* fval = muvExpr(w, calleeId);
        if (fval == null) return null;
        IrType* fty = fval->type;
        if (fty != null && fty->kind == IrTypeKind::Ptr &&
            fty->elem != null && fty->elem->kind == IrTypeKind::Func)
        {
            fty = fty->elem;
            IrInst* loadInst = w->b.load(fty, fval);
            muvSetDebugLoc(w, loadInst, id);
            fval = muvV(loadInst);
            if (fval == null) return null;
        }
        if (fty == null || fty->kind != IrTypeKind::Func)
            { muvErr(w, id, "callee expression is not a function pointer"); return null; }
        u32 nargs = 0;
        bool fail = false;
        IrValue** args = muvBuildCallArgs(w, null, e->kind.payload.Call.args,
                                         e->kind.payload.Call.argsLen,
                                         null, false, &nargs, &fail,
                                         fty->params, fty->nparams);
        if (fail) return null;
        IrInst* callInst = w->b.call(fval, args, nargs);
        muvSetDebugLoc(w, callInst, id);
        IrValue* res = muvV(callInst);
        if (args != null) dealloc<IrValue*>(args);
        if (res == null) return null;
        if (fty->ret == null || fty->ret->kind == IrTypeKind::Void) return null;
        return res;
    }
    else
    {
        muvErr(w, id, "unsupported callee form");
        return null;
    }
    if (f == null) return null;

    u32 nargs = 0;
    bool fail = false;
    IrValue** args = muvBuildCallArgs(w, f, e->kind.payload.Call.args,
                                     e->kind.payload.Call.argsLen,
                                     null, false, &nargs, &fail,
                                     f->paramTypes, f->nparams);
    if (fail) return null;
    IrInst* callInst = w->b.call(&f->base, args, nargs);
    muvSetDebugLoc(w, callInst, id);
    IrValue* res = muvV(callInst);
    if (args != null) dealloc<IrValue*>(args);
    if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
    return res;
}

/* `recv.method(args...)`: a real method when the receiver's type (or a
 * matching extend) declares one — the receiver becomes the shell's
 * parameter 0 unless the method is static — otherwise a fn-pointer
 * field of the receiver called with only the listed arguments. */
pub IrValue* muvMethodCall(Muv* w, Expr* e, NodeId id)
{
    NodeId recvNode = e->kind.payload.MethodCall.receiver;
    Str meth = e->kind.payload.MethodCall.method;
    NodeId* argv = e->kind.payload.MethodCall.args;
    u32 argvLen = e->kind.payload.MethodCall.argsLen;

    Node* rn = muvNode(w, recvNode);
    Ty recvTy = rn->kind.tag == NodeKind::Expr
        ? rn->kind.payload.Expr.value.resolvedType : 0;

    bool nf = false;
    NodeId mdef = NodeId{ .index = 0 };
    IrFunc* f = muvMethodFnFor(w, recvTy, meth, id, &nf, &mdef);
    if (f != null)
    {
        u8 sk = muvMethodSelfKind(w, mdef);
        IrValue* recvVal = null;
        bool passRecv = sk != 0;
        if (passRecv)
        {
            Ty rt = muvUnwrapTy(w, recvTy);
            bool recvIsPtr = rt != 0 && muvIsIndirect(w->ctx->types + rt);
            recvVal = recvIsPtr ? muvExpr(w, recvNode) : muvAddrOf(w, recvNode);
            if (recvVal == null) return null;
        }
        u32 nargs = 0;
        bool fail = false;
        IrValue** args = muvBuildCallArgs(w, f, argv, argvLen, recvVal, passRecv,
                                         &nargs, &fail,
                                         f->paramTypes, f->nparams);
        if (fail) return null;
        IrValue* res = muvV(w->b.call(&f->base, args, nargs));
        if (args != null) dealloc<IrValue*>(args);
        stmt::muvMoveDisposeRecv(w, meth, rn);
        if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
        return res;
    }
    if (!nf) return null; // the shell reported why

    /* not a method: a fn-pointer field, called as `(recv.field)(args)` */
    if (muvHasField(w, recvTy, meth))
    {
        IrValue* faddr = muvFieldAddr(w, recvNode, meth, id);
        if (faddr == null) return null;
        IrType* fty = faddr->type != null ? faddr->type->elem : null;
        if (fty == null || fty->kind != IrTypeKind::Func)
            { muvErr(w, id, "field is not a function pointer"); return null; }
        IrValue* fval = muvV(w->b.load(fty, faddr));
        if (fval == null) return null;
        u32 nargs = 0;
        bool fail = false;
        IrValue** args = muvBuildCallArgs(w, null, argv, argvLen, null, false,
                                         &nargs, &fail,
                                         fty->params, fty->nparams);
        if (fail) return null;
        IrValue* res = muvV(w->b.call(fval, args, nargs));
        if (args != null) dealloc<IrValue*>(args);
        if (fty->ret == null || fty->ret->kind == IrTypeKind::Void) return null;
        return res;
    }

    muvErr(w, id, "no such method or function-pointer field");
    return null;
}


/* value-level arithmetic: l and r are already evaluated. Shared by
 * binary expressions and compound assignment (`x += e` = load, apply,
 * store). */
pub IrValue* muvArithVals(Muv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    /* float-ness comes from the lowered operands — `distinct F = f64`
     * operands are f64 in the IR even though the Ty stays Named */
    bool isFloat = l->type != null && l->type->kind == IrTypeKind::Float;
    bool uns = muvTyUnsigned(w, ct);
    IrInst* inst = null;
    switch (k.tag)
    {
        ExprKind::Add => { inst = isFloat ? w->b.fadd(l, r) : w->b.add(l, r); },
        ExprKind::Sub => { inst = isFloat ? w->b.fsub(l, r) : w->b.sub(l, r); },
        ExprKind::Mul => { inst = isFloat ? w->b.fmul(l, r) : w->b.mul(l, r); },
        ExprKind::Div => {
            if (isFloat) inst = w->b.fdiv(l, r);
            else inst = uns ? w->b.udiv(l, r) : w->b.sdiv(l, r);
        },
        ExprKind::Mod => {
            if (isFloat) { muvErr(w, id, "float modulo is not supported"); return null; }
            inst = uns ? w->b.urem(l, r) : w->b.srem(l, r);
        },
        ExprKind::BitAnd => { inst = w->b.andOp(l, r); },
        ExprKind::BitOr => { inst = w->b.orOp(l, r); },
        ExprKind::BitXor => { inst = w->b.xorOp(l, r); },
        ExprKind::Shl => { inst = w->b.shl(l, r); },
        ExprKind::Shr => { inst = uns ? w->b.lshr(l, r) : w->b.ashr(l, r); },
        else => { muvErr(w, id, "unhandled binary op"); return null; },
    }
    muvSetDebugLoc(w, inst, id);
    return muvV(inst);
}

pub IrValue* muvBinaryArith(Muv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    IrValue* l = muvExpr(w, lid);
    IrValue* r = muvExpr(w, rid);
    return muvArithVals(w, k, l, r, id, ct);
}

/* value-level comparison (see muvArithVals) */
pub IrValue* muvCompareVals(Muv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)
{
    if (l == null || r == null) return null;
    bool isFloat = l->type != null && l->type->kind == IrTypeKind::Float;
    bool uns = muvTyUnsigned(w, ct);
    IrInst* inst = null;
    switch (k.tag)
    {
        ExprKind::Eq => {
            inst = isFloat ? w->b.fcmp(IrFCmpPred::Oeq, l, r)
                           : w->b.icmp(IrICmpPred::Eq, l, r);
        },
        ExprKind::Ne => {
            inst = isFloat ? w->b.fcmp(IrFCmpPred::One, l, r)
                           : w->b.icmp(IrICmpPred::Ne, l, r);
        },
        ExprKind::Lt => {
            if (isFloat) inst = w->b.fcmp(IrFCmpPred::Olt, l, r);
            else inst = w->b.icmp(uns ? IrICmpPred::Ult : IrICmpPred::Slt, l, r);
        },
        ExprKind::Le => {
            if (isFloat) inst = w->b.fcmp(IrFCmpPred::Ole, l, r);
            else inst = w->b.icmp(uns ? IrICmpPred::Ule : IrICmpPred::Sle, l, r);
        },
        ExprKind::Gt => {
            if (isFloat) inst = w->b.fcmp(IrFCmpPred::Ogt, l, r);
            else inst = w->b.icmp(uns ? IrICmpPred::Ugt : IrICmpPred::Sgt, l, r);
        },
        ExprKind::Ge => {
            if (isFloat) inst = w->b.fcmp(IrFCmpPred::Oge, l, r);
            else inst = w->b.icmp(uns ? IrICmpPred::Uge : IrICmpPred::Sge, l, r);
        },
        else => { muvErr(w, id, "unhandled comparison"); return null; },
    }
    muvSetDebugLoc(w, inst, id);
    return muvV(inst);
}

pub IrValue* muvCompare(Muv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)
{
    /* `x.tag == V::Case` / `V::Case == x.tag`: the path's value form is
     * the whole {tag,payload} aggregate — compare the tag load against
     * the case ordinal instead (mirrors cgAssignValue's `.tag` rule) */
    if (k.tag == ExprKind::Eq || k.tag == ExprKind::Ne)
    {
        Decl* cvd = null;
        i32 lci = muvVariantCasePath(w, lid, &cvd);
        i32 rci = muvVariantCasePath(w, rid, &cvd);
        if (lci >= 0 && rci < 0 && muvIsTagAccess(w, rid))
        {
            IrValue* r = muvExpr(w, rid);
            if (r == null) return null;
            IrValue* lc = w->ir->constInt(w->ir->tyInt(32), (u64)(u32)lci);
            return muvCompareVals(w, k, lc, r, id, ct);
        }
        if (rci >= 0 && lci < 0 && muvIsTagAccess(w, lid))
        {
            IrValue* l = muvExpr(w, lid);
            if (l == null) return null;
            IrValue* rc = w->ir->constInt(w->ir->tyInt(32), (u64)(u32)rci);
            return muvCompareVals(w, k, l, rc, id, ct);
        }
    }
    IrValue* l = muvExpr(w, lid);
    IrValue* r = muvExpr(w, rid);
    return muvCompareVals(w, k, l, r, id, ct);
}

/* `V::Case` path detection shared by the Path arm and the `.tag`
 * consumers: returns the case ordinal and the variant decl, or -1
 * when `id` isn't a two-segment variant-case path. The head segment
 * may be a plain Ident (`Option::None`) or a TypeRef
 * (`Option<f64>::None`). */
pub i32 muvVariantCasePath(Muv* w, NodeId id, Decl** outVd)
{
    if (id.index == 0) return -1;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) return -1;
    Expr* e = &n->kind.payload.Expr.value;
    if (e->kind.tag != ExprKind::Path) return -1;
    if (e->kind.payload.Path.segmentsLen != 2) return -1;
    Node* s0 = muvNode(w, e->kind.payload.Path.segments[0]);
    Node* s1 = muvNode(w, e->kind.payload.Path.segments[1]);
    if (s0->kind.tag != NodeKind::Expr || s1->kind.tag != NodeKind::Expr) return -1;
    Expr* s0e = &s0->kind.payload.Expr.value;
    Expr* s1e = &s1->kind.payload.Expr.value;
    if (s1e->kind.tag != ExprKind::Ident) return -1;
    Decl* vd = null;
    if (s0e->kind.tag == ExprKind::TypeRef)
    {
        Ty ht = muvResolved(w, s0e->kind.payload.TypeRef.typeNode);
        vd = muvVariantDeclOf(w, muvUnwrapTy(w, ht));
    }
    else if (s0e->kind.tag == ExprKind::Ident)
    {
        NodeId td = muvFindTypeDecl(w, s0e->kind.payload.Ident.name);
        if (td.index != 0)
        {
            Node* dn = muvNode(w, td);
            if (dn->kind.tag == NodeKind::Decl &&
                dn->kind.payload.Decl.value.kind.tag == DeclKind::Variant)
                vd = &dn->kind.payload.Decl.value;
        }
    }
    if (vd == null) return -1;
    i32 ci = muvVariantCaseIdx(w, vd, s1e->kind.payload.Ident.name);
    if (ci < 0) return -1;
    if (outVd != null) *outVd = vd;
    return ci;
}

/* `x.tag` / `x->tag` where x's type is a variant — the field holding
 * the case ordinal */
pub bool muvIsTagAccess(Muv* w, NodeId id)
{
    if (id.index == 0) return false;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) return false;
    Expr* e = &n->kind.payload.Expr.value;
    Str fname = 0;
    NodeId obj;
    obj.index = 0;
    if (e->kind.tag == ExprKind::Field)
        { fname = e->kind.payload.Field.field; obj = e->kind.payload.Field.obj; }
    else if (e->kind.tag == ExprKind::DerefField)
        { fname = e->kind.payload.DerefField.field; obj = e->kind.payload.DerefField.obj; }
    else return false;
    if (fname != w->ctx->intern("tag") || obj.index == 0) return false;
    Node* on = muvNode(w, obj);
    if (on->kind.tag != NodeKind::Expr) return false;
    Ty ot = muvResolved(w, on->kind.payload.Expr.value.resolvedType);
    return muvVariantDeclOf(w, muvUnwrapTy(w, ot)) != null;
}

/* zero `size` bytes at `addr` — i64 chunks then an i8 tail. Used to
 * clear variant payload storage for `V::Case` values (C's `{ .tag = v }`
 * zero-initialises the rest). */
pub void muvZeroMem(Muv* w, IrValue* addr, u32 size)
{
    if (addr == null || size == 0) return;
    IrValue* p64 = muvV(w->b.bitcast(addr, w->ir->tyPtr(w->ir->tyInt(64))));
    IrValue* p8 = muvV(w->b.bitcast(addr, w->ir->tyPtr(w->ir->tyInt(8))));
    if (p64 == null || p8 == null) return;
    u32 off = 0;
    while (off + 8 <= size)
    {
        IrValue* idx = w->ir->constInt(w->ir->tyInt(32), (u64)(off / 8));
        IrValue* slot = muvV(w->b.gep(p64, &idx, 1));
        if (slot == null) return;
        w->b.store(w->ir->constInt(w->ir->tyInt(64), 0), slot);
        off += 8;
    }
    while (off < size)
    {
        IrValue* idx = w->ir->constInt(w->ir->tyInt(32), (u64)off);
        IrValue* slot = muvV(w->b.gep(p8, &idx, 1));
        if (slot == null) return;
        w->b.store(w->ir->constInt(w->ir->tyInt(8), 0), slot);
        off += 1;
    }
}

/* short-circuit And/Or via result alloca + condBr (no phis) */
pub IrValue* muvShortCircuit(Muv* w, Expr* e, NodeId id)
{
    IrType* bt = w->ir->tyInt(1);
    IrValue* resSlot = muvV(w->b.alloca(bt));
    IrValue* l = muvExpr(w, e->kind.payload.And.left);
    if (l == null) return null;
    /* truthiness == muvCond's: != 0 (i1/int/ptr; sema rejects floats in
     * &&/||) — `ne 1` inverted every condition (`true && x` folded false) */
    IrValue* lz = muvV(w->b.icmp(IrICmpPred::Ne, l, w->ir->constInt(l->type, 0)));
    IrBlock* rhsBb = muvBlock(w, "sc.rhs");
    IrBlock* endBb = muvBlock(w, "sc.end");
    bool isAnd = e->kind.tag == ExprKind::And;
    if (isAnd) w->b.condBr(lz, rhsBb, endBb);
    else w->b.condBr(lz, endBb, rhsBb);

    /* short-circuit path: store the known result, branch to join */
    muvSetBlock(w, endBb);
    w->b.store(w->ir->constInt(bt, isAnd ? 0 : 1), resSlot);
    IrBlock* joinBb = muvBlock(w, "sc.join");
    w->b.br(joinBb);

    /* rhs path: evaluate, store, branch to join */
    muvSetBlock(w, rhsBb);
    IrValue* r = muvExpr(w, e->kind.payload.And.right);
    if (r == null) return null;
    IrValue* rz = muvV(w->b.icmp(IrICmpPred::Ne, r, w->ir->constInt(r->type, 0)));
    w->b.store(rz, resSlot);
    w->b.br(joinBb);

    muvSetBlock(w, joinBb);
    return muvV(w->b.load(bt, resSlot));
}

/* scalar cast between two IrTypes, using Coral signedness for the
 * int↔int / int→float choice (IrType has no signed flag) */
pub IrValue* muvCast(Muv* w, IrValue* v, IrType* st, IrType* dt, bool srcUnsigned, bool dstUnsigned)
{
    if (v == null || dt == null) return v;
    if (dt->kind == IrTypeKind::Void) return v;
    if (st == dt) return v;
    if (st->kind == IrTypeKind::Ptr && dt->kind == IrTypeKind::Ptr) return v;
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Int)
    {
        if (dt->width == st->width) return v;
        if (dt->width < st->width) return muvV(w->b.trunc(v, dt));
        return muvV(srcUnsigned ? w->b.zext(v, dt) : w->b.sext(v, dt));
    }
    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Float)
        return muvV(srcUnsigned ? w->b.uiToFp(v, dt) : w->b.siToFp(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Int)
        return muvV(dstUnsigned ? w->b.fpToUi(v, dt) : w->b.fpToSi(v, dt));
    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Float)
    {
        if (dt->width < st->width) return muvV(w->b.fpTrunc(v, dt));
        return muvV(w->b.fpExt(v, dt));
    }
    return muvV(w->b.bitcast(v, dt));
}


/* implicit numeric conversion at store/return/argument boundaries:
 * the C backend leans on C's implicit conversions, but muvm IR is
 * typed — `f64 x = 1` must emit si_to_fp, not `store i32` into an
 * f64 slot. sit comes from the VALUE's own IR type (ground truth);
 * srcTy only supplies signedness for int→float / int→int widening.
 * i1 (bool) always zero-extends — sext would turn `true` into -1. */
pub IrValue* muvCoerceToIr(Muv* w, IrValue* v, Ty srcTy, IrType* dit, NodeId id)
{
    if (v == null || dit == null || v->type == null) return v;
    IrType* sit = v->type;
    if (sit == dit) return v;
    if (muvIsAgg(sit) || muvIsAgg(dit)) return v;
    if (sit->kind == IrTypeKind::Ptr || dit->kind == IrTypeKind::Ptr) return v;
    bool numeric = (sit->kind == IrTypeKind::Int || sit->kind == IrTypeKind::Float) &&
                   (dit->kind == IrTypeKind::Int || dit->kind == IrTypeKind::Float);
    if (!numeric) return v;
    Ty st = muvResolved(w, srcTy);
    bool su = st != 0 ? muvTyUnsigned(w, st) : false;
    /* dst sign only matters for float→int; assume signed — sema
     * rejects most narrowing conversions before this point anyway */
    bool du = false;
    IrValue* cv;
    if (sit->kind == IrTypeKind::Int && sit->width == 1 &&
        dit->kind == IrTypeKind::Int && dit->width > 1)
        cv = muvV(w->b.zext(v, dit));
    else
        cv = muvCast(w, v, sit, dit, su, du);
    if (cv != null && cv != v && cv->kind == IrValueKind::Inst)
        muvSetDebugLoc(w, (IrInst*)cv, id);
    return cv;
}


/* coerce any expression value to an i1 condition: i1 passes through,
 * other ints and pointers compare against 0 (C truthiness: `if (2)` and
 * `if (ptr)` are true, `if (0)`/`if (null)` false), floats against 0.0.
 * Returns null on failure. */
pub IrValue* muvCond(Muv* w, IrValue* v)
{
    if (v == null || v->type == null) return null;
    if (v->type->kind == IrTypeKind::Int && v->type->width == 1) return v;
    if (v->type->kind == IrTypeKind::Float)
        return muvV(w->b.fcmp(IrFCmpPred::One, v, w->ir->constFloat(v->type, 0.0)));
    return muvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 0)));
}

// pub IrValue* muvAddrOf(Muv* w, NodeId id);

/* strip Const/Comptime wrappers; Named alias/distinct unwrapping happens
 * where the decl is needed */
pub Ty muvUnwrapTy(Muv* w, Ty t)
{
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else return t;
        guard++;
    }
    return t;
}

/* is this IR type an aggregate (address-copied, never register-loaded)? */
pub bool muvIsAgg(IrType* t)
{
    return t != null && (t->kind == IrTypeKind::Struct ||
                         t->kind == IrTypeKind::Array ||
                         t->kind == IrTypeKind::Union ||
                         t->kind == IrTypeKind::Vector);
}

/* store `v` into `addr`, where the destination's value type is `dt`.
 * An aggregate-typed value IS its address; storing one into a
 * pointer/scalar slot is array->pointer decay and must store the
 * 8-byte address, not memcpy the whole object (a `u8[1024]` stored
 * into a `u8*` field used to overwrite 1 KiB of stack). Relabel the
 * value with a bitcast so the backend picks the pointer-store path. */
pub IrInst* muvStoreVal(Muv* w, IrValue* v, IrValue* addr, IrType* dt)
{
    if (v == null || addr == null) return null;
    if (dt != null && v->type != null && muvIsAgg(v->type) &&
        !muvIsAgg(dt) && dt->kind != IrTypeKind::Void)
        v = muvV(w->b.bitcast(v, dt));
    return w->b.store(v, addr);
}

/* result-slot store for branch arms (ternary/if/switch expressions):
 * scalar arms store their value, aggregate arms are already
 * address-valued so the bytes copy element-wise. */
pub void muvArmStore(Muv* w, IrValue* v, IrValue* slot, IrType* vt)
{
    if (v == null || slot == null) return;
    if (vt != null && muvIsAgg(vt)) { muvCopyAgg(w, slot, v, vt, 0); return; }
    muvStoreVal(w, v, slot, vt);
}

/* literal field/element store: evaluate the value expr, coerce its
 * numeric type to the slot's (C's implicit conversions), store.
 * Returns the stored value, null on error. */
pub IrValue* muvLitStore(Muv* w, NodeId valId, IrValue* dst, IrType* dt)
{
    IrValue* v = muvExpr(w, valId);
    if (v == null) return null;
    Node* vn = muvNode(w, valId);
    Ty vty = vn != null && vn->kind.tag == NodeKind::Expr
        ? vn->kind.payload.Expr.value.resolvedType : 0;
    v = muvCoerceToIr(w, v, vty, dt, valId);
    muvStoreVal(w, v, dst, dt);
    return v;
}

/* IR field index of `name` in struct type `t` — the position the field
 * occupies in the IrStructType createStructType built, which is the
 * compiler's layout order ([[reorder]]/[[packed]] permute it) and which
 * generic instances get per substituted layout. Str/Slice expose the
 * fixed {ptr,len} pair. 0xFFFFFFFF when the field is unknown. */
/* the field's address: pointer receivers pass the value through, value
 * receivers contribute their address — shared by `x.f`, `x?.f`-style
 * chains and the fn-pointer-field call form of a method call. */
pub IrValue* muvFieldAddr(Muv* w, NodeId obj, Str fname, NodeId errId)
{
    Node* on = muvNode(w, obj);
    if (on->kind.tag != NodeKind::Expr)
        { muvErr(w, errId, "field base is not an expression"); return null; }
    Ty obt = muvUnwrapTy(w, muvResolved(w, on->kind.payload.Expr.value.resolvedType));
    /* comptime-arm base sema never stamped: fall back to the local's
     * declared type (only Idents live in that table — see muvLocalTy) */
    if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
        obt = muvUnwrapTy(w, muvResolved(w, muvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));
    IrValue* base; Ty sty;
    TypeEntry* obe = obt != 0 ? w->ctx->types + obt : null;
    if (obe != null && muvIsIndirect(obe))
    {
        sty = muvIndirectBase(obe);
        base = muvExpr(w, obj); // the pointer/reference value
    }
    else
    {
        sty = obt;
        base = muvAddrOf(w, obj); // address of the struct value
    }
    if (base == null) return null;
    /* x.payload.Case: bitcast the payload blob to the selected case's
     * struct type — the address is then an ordinary struct lvalue */
    if (on->kind.payload.Expr.value.kind.tag == ExprKind::Field)
    {
        Str pf = on->kind.payload.Expr.value.kind.payload.Field.field;
        NodeId pobj = on->kind.payload.Expr.value.kind.payload.Field.obj;
        if (pf == w->ctx->intern("payload") && pobj.index != 0)
        {
            Node* inn = muvNode(w, pobj);
            if (inn->kind.tag == NodeKind::Expr)
            {
                Expr* ie = &inn->kind.payload.Expr.value;
                Ty ity = muvResolved(w, ie->resolvedType);
                if (ity == 0 && ie->kind.tag == ExprKind::Ident)
                    ity = muvResolved(w, muvLocalTy(w, ie->kind.payload.Ident.name));
                Decl* vd = muvVariantDeclOf(w, muvUnwrapTy(w, ity));
                if (vd != null)
                {
                    i32 ci = muvVariantCaseIdx(w, vd, fname);
                    if (ci >= 0)
                    {
                        /* base is already the payload union's address
                         * (obj was `x.payload`) — bitcast it directly;
                         * a field gep here would step past the union */
                        IrValue* payA = base;
                        IrStructType* cst = muvVariantCaseStructTyFor(w, ity, (u32)ci, 0);
                        if (cst == null) { muvErr(w, errId, "unknown variant case"); return null; }
                        return muvV(w->b.bitcast(payA, w->ir->tyPtr(cst->irType)));
                    }
                }
            }
        }
    }
    /* union field: every field overlaps at offset 0 — bitcast the
     * storage to the field's pointer type instead of indexing */
    Decl* ud = muvUnionDeclOf(w, sty);
    if (ud != null)
    {
        IrType* fty = muvUnionFieldTy(w, ud, fname, 0);
        if (fty == null) { muvErr(w, errId, "unknown union field"); return null; }
        return muvV(w->b.bitcast(base, w->ir->tyPtr(fty)));
    }
    /* x.payload.Case.field: resolve through the variant decl — case
     * structs of identical layout intern to the same IrType, so the
     * IrStructType name lookup below can bind the wrong twin's fields */
    if (on->kind.payload.Expr.value.kind.tag == ExprKind::Field)
    {
        Str cn = on->kind.payload.Expr.value.kind.payload.Field.field;
        NodeId cobj = on->kind.payload.Expr.value.kind.payload.Field.obj;
        Node* cnode = muvNode(w, cobj);
        if (cnode->kind.tag == NodeKind::Expr &&
            cnode->kind.payload.Expr.value.kind.tag == ExprKind::Field &&
            cnode->kind.payload.Expr.value.kind.payload.Field.field == w->ctx->intern("payload"))
        {
            NodeId vobj = cnode->kind.payload.Expr.value.kind.payload.Field.obj;
            Node* vn = muvNode(w, vobj);
            if (vn->kind.tag == NodeKind::Expr)
            {
                Expr* ve = &vn->kind.payload.Expr.value;
                Ty vty = muvResolved(w, ve->resolvedType);
                if (vty == 0 && ve->kind.tag == ExprKind::Ident)
                    vty = muvResolved(w, muvLocalTy(w, ve->kind.payload.Ident.name));
                Decl* vd = muvVariantDeclOf(w, muvUnwrapTy(w, vty));
                if (vd != null)
                {
                    i32 ci = muvVariantCaseIdx(w, vd, cn);
                    i32 cfi = ci >= 0 ? muvVariantCaseFieldIdx(w, vd, (u32)ci, fname) : -1;
                    if (cfi >= 0) return muvGepField(w, base, (u32)cfi);
                }
            }
        }
    }
    u32 fi = muvFieldIdx(w, sty, fname);
    if (fi == 0xFFFFFFFF)
    {
        /* bitcast-derived struct lvalue (variant case payload): the
         * pointee IrStructType carries the field names */
        IrType* bt = muvSlotTy(base->type);
        if (bt != null && bt->kind == IrTypeKind::Struct)
        {
            str want = muvStr(w, fname);
            fi = muvStructFieldIdxOf(w, bt, want);
        }
        if (fi == 0xFFFFFFFF)
        {
            if (getenv(C"MUV_DEBUG") != null)
            {
                printf(C"muvdbg: field miss sty=%u bt=%p kind=%u\n", sty, (void*)bt, bt != null ? (u32)bt->kind : 999);
                if (sty != 0)
                {
                    TypeEntry* ste = w->ctx->types + sty;
                    printf(C"  sty kind=%u", (u32)ste->kind.tag);
                    if (ste->kind.tag == TypeKind::Named)
                        printf(C" name=%u", ste->kind.payload.Named.name);
                    printf(C"\n");
                }
                if (bt != null && bt->kind == IrTypeKind::Struct)
                {
                    u32 si = 0;
                    u32 match = 0;
                    while (si < w->structTysLen)
                    {
                        IrStructType* st = w->structTys[si];
                        if (st != null && st->irType == bt) match++;
                        si++;
                    }
                    printf(C"  structTys matches for bt: %u (of %u)\n", match, w->structTysLen);
                    si = 0;
                    while (si < w->structTysLen)
                    {
                        IrStructType* st = w->structTys[si];
                        if (st != null && st->irType == bt)
                        {
                            printf(C"  struct '%s' nfields=%u:", st->name.ptr, st->nfields);
                            u32 fi2 = 0;
                            while (fi2 < st->nfields)
                            {
                                printf(C" %s", st->fieldNames[fi2].ptr);
                                fi2++;
                            }
                            printf(C"\n");
                            break;
                        }
                        si++;
                    }
                }
            }
            muvErr(w, errId, "unknown struct field"); return null;
        }
    }
    return muvGepField(w, base, fi);
}

/* field index of `fname` in the tracked IrStructType `st` whose
 * irType is `ir` — used for case-struct lvalues reached through
 * bitcasts where no Coral Ty exists to index through */
pub u32 muvStructFieldIdxOf(Muv* w, IrType* ir, str fname)
{
    u32 i = 0;
    while (i < w->structTysLen)
    {
        IrStructType* st = w->structTys[i];
        if (st->irType == ir)
        {
            u32 f = 0;
            while (f < st->nfields)
            {
                if (st->fieldNames[f].equals(fname)) return f;
                f++;
            }
            return 0xFFFFFFFF;
        }
        i++;
    }
    return 0xFFFFFFFF;
}

/* the declaring node of a method on a receiver type — the same walk
 * cgMethodRecvKind performs: unwrap ptr/const/comptime to the named
 * type, then scan the type's own methods and the extends whose self
 * type matches. 0 when the name is not a method at all. */
pub NodeId muvFindMethodDecl(Muv* w, Ty recvTy, Str method)
{
    NodeId none;
    none.index = 0;
    if (recvTy == 0 || method == 0 || w->file == null) return none;
    Ty t = recvTy;
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        guard++;
        TypeEntry* e = w->ctx->types + t;
        Ty ib = muvIndirectBase(e);
        if (ib != 0 || muvIsIndirect(e)) { t = ib; continue; }
        else if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;
        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;
        else break;
    }
    if (t == 0) return none;
    /* the receiver's owner name — builtins match their extend too
     * (`extend str`'s methods live behind TypeKind::Str, which is not
     * a Named and used to bail out here) */
    Str typeName = muvOwnerStr(w, t);
    if (typeName == 0) return none;
    /* for a generic receiver (`Result<File,IoError>`) ownerStr is the
     * instance-mangled name, which never equals an extend self type's
     * owner text — match on the base decl name + argument compatibility
     * instead (TypeParam self args are wildcards) */
    Str baseName = typeName;
    Ty* recvArgs = null;
    u32 recvArgsLen = 0;
    {
        TypeEntry* rte = w->ctx->types + t;
        if (rte->kind.tag == TypeKind::Named &&
            rte->kind.payload.Named.genericArgsLen != 0)
        {
            baseName = rte->kind.payload.Named.name;
            recvArgs = rte->kind.payload.Named.genericArgs;
            recvArgsLen = rte->kind.payload.Named.genericArgsLen;
        }
    }
    File* file = w->file;
    u32 i = 0;
    while (i < file->declsLen)
    {
        Node* d = muvNode(w, file->decls[i]);
        if (d->kind.tag == NodeKind::Decl)
        {
            Decl* dd = &d->kind.payload.Decl.value;
            NodeId* methods = null;
            u32 mlen = 0;
            switch (dd->kind.tag)
            {
                DeclKind::Struct => {
                    if (dd->kind.payload.Struct.name != baseName) break;
                    methods = dd->kind.payload.Struct.methods;
                    mlen = dd->kind.payload.Struct.methodsLen;
                },
                DeclKind::Union => {
                    if (dd->kind.payload.Union.name != baseName) break;
                    methods = dd->kind.payload.Union.methods;
                    mlen = dd->kind.payload.Union.methodsLen;
                },
                DeclKind::Variant => {
                    if (dd->kind.payload.Variant.name != baseName) break;
                    methods = dd->kind.payload.Variant.methods;
                    mlen = dd->kind.payload.Variant.methodsLen;
                },
                /* an extend's methods belong to its self type — without
                 * this filter a fn-pointer field call (`p->alloc(...)`,
                 * where some OTHER type has an `alloc` method) matches
                 * this unrelated extend and composes a bogus call */
                DeclKind::Extend | DeclKind::ExtendTrait => {
                    Ty st = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.selfType
                        : dd->kind.payload.ExtendTrait.selfType;
                    st = muvUnwrapTy(w, st);
                    if (st != 0 && muvIsIndirect(w->ctx->types + st))
                        st = muvUnwrapTy(w, muvIndirectBase(w->ctx->types + st));
                    if (st == 0) break;
                    TypeEntry* ste = w->ctx->types + st;
                    bool stMatch;
                    if (ste->kind.tag == TypeKind::Named && recvArgsLen != 0)
                    {
                        /* generic receiver: the extend's self type names
                         * the same decl — its TypeParam args are wildcards,
                         * concrete args must equal the receiver's */
                        stMatch = ste->kind.payload.Named.name == baseName &&
                                  ste->kind.payload.Named.genericArgsLen == recvArgsLen;
                        u32 ai = 0;
                        while (stMatch && ai < recvArgsLen)
                        {
                            Ty sa = ste->kind.payload.Named.genericArgs[ai];
                            if ((w->ctx->types + sa)->kind.tag != TypeKind::TypeParam &&
                                !w->sema->sameType(sa, recvArgs[ai]))
                                stMatch = false;
                            ai++;
                        }
                    }
                    else
                    {
                        stMatch = muvOwnerStr(w, st) == typeName;
                    }
                    if (getenv(C"MUV_DEBUG") != null &&
                        w->ctx->internEqHashLen(method, 0x71969BBC, 5))
                        printf(C"muvdbg: findMethod isErr stMatch=%u base=%u recvArgs=%u stKind=%u\n",
                               stMatch ? 1 : 0, baseName, recvArgsLen, (u32)ste->kind.tag);
                    if (!stMatch) break;
                    methods = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.methods
                        : dd->kind.payload.ExtendTrait.methods;
                    mlen = dd->kind.tag == DeclKind::Extend
                        ? dd->kind.payload.Extend.methodsLen
                        : dd->kind.payload.ExtendTrait.methodsLen;
                },
                else => {},
            }
            if (methods != null)
            {
                u32 m = 0;
                while (m < mlen)
                {
                    Node* mn = muvNode(w, methods[m]);
                    if (mn->kind.tag == NodeKind::Decl &&
                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&
                        mn->kind.payload.Decl.value.kind.payload.Func.name == method)
                        return methods[m];
                    m++;
                }
            }
        }
        i++;
    }
    /* a monomorphised owner (`Vec_i32` composes no decl of its own here)
     * reaches the shared resolver's instance phases */
    return muvFindMethodDeclOwner(w, typeName, method);
}

/* does the receiver's named struct/union declare field `name`? (the
 * fn-pointer field form a method call may fall back to) */
pub bool muvHasField(Muv* w, Ty recvTy, Str name)
{
    if (recvTy == 0 || name == 0) return false;
    Ty u = muvUnwrapTy(w, recvTy);
    if (u != 0 && muvIsIndirect(w->ctx->types + u))
        u = muvUnwrapTy(w, muvIndirectBase(w->ctx->types + u));
    if (u == 0 || (w->ctx->types + u)->kind.tag != TypeKind::Named) return false;
    Str tn = (w->ctx->types + u)->kind.payload.Named.name;
    NodeId d = muvFindTypeDeclRef(w, tn, (w->ctx->types + u)->loc);
    if (d.index == 0) return false;
    Node* dn = muvNode(w, d);
    if (dn->kind.tag != NodeKind::Decl) return false;
    Decl* dd = &dn->kind.payload.Decl.value;
    NodeId* fields = null;
    u32 flen = 0;
    if (dd->kind.tag == DeclKind::Struct)
    {
        fields = dd->kind.payload.Struct.fields;
        flen = dd->kind.payload.Struct.fieldsLen;
    }
    else if (dd->kind.tag == DeclKind::Union)
    {
        fields = dd->kind.payload.Union.fields;
        flen = dd->kind.payload.Union.fieldsLen;
    }
    else return false;
    u32 i = 0;
    while (i < flen)
    {
        Node* fn = muvNode(w, fields[i]);
        if (fn->kind.tag == NodeKind::Field && fn->kind.payload.Field.value.name == name)
            return true;
        i++;
    }
    return false;
}

pub u32 muvFieldIdx(Muv* w, Ty t, Str name)
{
    u32 none = 0xFFFFFFFF;
    if (name == 0) return none;
    t = muvUnwrapTy(w, t);
    Ty named = 0;
    Str typeName = 0;
    u32 guard = 0;
    while (t != 0 && guard < 8)
    {
        guard++;
        TypeEntry* e = w->ctx->types + t;
        if (e->kind.tag == TypeKind::Str || e->kind.tag == TypeKind::Slice)
        {
            if (w->ctx->internEqHashLen(name, 0x55764C09, 3)) return 0; /* FNV("ptr") */
            if (w->ctx->internEqHashLen(name, 0x366ADB0C, 3)) return 1; /* FNV("len") */
            return none;
        }
        if (e->kind.tag != TypeKind::Named) break;
        named = t;
        typeName = e->kind.payload.Named.name;
        NodeId td = muvFindTypeDeclRef(w, typeName, e->loc);
        if (td.index == 0) return none;
        Node* dn = muvNode(w, td);
        if (dn->kind.tag != NodeKind::Decl) return none;
        Decl* dd = &dn->kind.payload.Decl.value;
        if (dd->kind.tag == DeclKind::Struct) break; // resolved below via the IrStructType

        if (dd->kind.tag == DeclKind::TypeAlias)
            { t = muvUnwrapTy(w, dd->kind.payload.TypeAlias.target); continue; }
        if (dd->kind.tag == DeclKind::Distinct)
            { t = muvUnwrapTy(w, dd->kind.payload.Distinct.baseType); continue; }
        return none;
    }
    /* primary path: ask the IrStructType coral-ir built for this type —
     * its fieldNames are in layout order, so reordered/packed/generic-
     * instance structs all resolve correctly. Match on the interned
     * IrType plus the decl name so same-layout structs with different
     * field names can't alias. */
    if (named != 0 && w->structTysLen > 0)
    {
        IrType* it = muvTy(w, named, 0);
        if (it != null && it->kind == IrTypeKind::Struct)
        {
            str want = muvStr(w, typeName);
            str fname = muvStr(w, name);
            u32 si = 0;
            while (si < w->structTysLen)
            {
                IrStructType* st = w->structTys[si];
                if (st != null && st->irType == it && st->name.equals(want))
                {
                    u32 fi = 0;
                    while (fi < st->nfields)
                    {
                        if (st->fieldNames[fi].equals(fname)) return fi;
                        fi++;
                    }
                }
                si++;
            }
        }
    }
    /* fallback: declaration order through the type decl */
    if (named != 0)
    {
        NodeId td = muvFindTypeDeclRef(w, typeName, (w->ctx->types + named)->loc);
        if (td.index != 0)
        {
            Node* dn = muvNode(w, td);
            if (dn->kind.tag == NodeKind::Decl &&
                dn->kind.payload.Decl.value->kind.tag == DeclKind::Struct)
            {
                Decl* dd = &dn->kind.payload.Decl.value;
                u32 i = 0;
                while (i < dd->kind.payload.Struct.fieldsLen)
                {
                    Node* fn = muvNode(w, dd->kind.payload.Struct.fields[i]);
                    if (fn->kind.tag == NodeKind::Field &&
                        fn->kind.payload.Field.value.name == name) return i;
                    i++;
                }
            }
        }
    }
    return none;
}

/* semantic type of struct/union field `fname` (or the `pos`-th field
 * when fname == 0) in type `st`, with the type's own generic arguments
 * substituted. w->subs is empty at non-generic use sites, so build a
 * temporary table pairing the decl's generic param names with the
 * Named args — mirrors what a mono TypeInstance's substitutions carry.
 * Returns 0 when the field or type cannot be resolved. */
pub Ty muvStructFieldTy(Muv* w, Ty st, Str fname, u32 pos)
{
    if (st == 0) return 0;
    st = muvUnwrapTy(w, st);
    TypeEntry* se = w->ctx->types + st;
    if (se->kind.tag != TypeKind::Named) return 0;
    Str tname = se->kind.payload.Named.name;
    u32 al = se->kind.payload.Named.genericArgsLen;
    NodeId td = muvFindTypeDeclRef(w, tname, se->loc);
    if (td.index == 0) return 0;
    Node* dn = muvNode(w, td);
    if (dn->kind.tag != NodeKind::Decl) return 0;
    Decl* dd = &dn->kind.payload.Decl.value;
    NodeId* gparams; u32 gpl; NodeId* fields; u32 flen;
    if (dd->kind.tag == DeclKind::Struct)
    {
        gparams = dd->kind.payload.Struct.genericParams;
        gpl = dd->kind.payload.Struct.genericParamsLen;
        fields = dd->kind.payload.Struct.fields;
        flen = dd->kind.payload.Struct.fieldsLen;
    }
    else if (dd->kind.tag == DeclKind::Union)
    {
        gparams = dd->kind.payload.Union.genericParams;
        gpl = dd->kind.payload.Union.genericParamsLen;
        fields = dd->kind.payload.Union.fields;
        flen = dd->kind.payload.Union.fieldsLen;
    }
    else return 0;
    MonoSubstitution* ts = null;
    u32 tsl = 0;
    u32 np = gpl < al ? gpl : al;
    if (np > 0)
    {
        ts = alloc<MonoSubstitution>((usize)np);
        if (ts == null) return 0;
        u32 i = 0;
        while (i < np)
        {
            ts[i].parameter = 0;
            ts[i].typeNode = se->kind.payload.Named.genericArgs[i];
            ts[i].index = i;
            Node* gn = muvNode(w, gparams[i]);
            if (gn != null && gn->kind.tag == NodeKind::GenericParam)
                ts[i].parameter = gn->kind.payload.GenericParam.value.name;
            tsl++;
            i++;
        }
    }
    MonoSubstitution* os = w->subs;
    u32 osl = w->subsLen;
    w->subs = ts;
    w->subsLen = tsl;
    Ty res = 0;
    u32 seen = 0;
    u32 i = 0;
    while (i < flen)
    {
        Node* fn = muvNode(w, fields[i]);
        if (fn != null && fn->kind.tag == NodeKind::Field)
        {
            Field* f = &fn->kind.payload.Field.value;
            bool hit = fname != 0 ? (f->name == fname) : (seen == pos);
            if (hit)
            {
                res = muvSubstDeep(w, f->typeNode, 0);
                break;
            }
            seen++;
        }
        i++;
    }
    w->subs = os;
    w->subsLen = osl;
    if (ts != null) dealloc<MonoSubstitution>(ts);
    return res;
}

/* true when `t` (already through const/comptime) is a reference type —
 * aggregate literal fields of type `T&` store the value's ADDRESS */
pub bool muvTyIsRef(Muv* w, Ty t)
{
    t = muvUnwrapTy(w, t);
    if (t == 0) return false;
    TypeEntry* e = w->ctx->types + t;
    return e->kind.tag == TypeKind::Reference;
}

/* address of element `idx` reached through `base`.
 *
 * byElement: base already points INTO an array (a local array slot or a
 * ptr-to-array's interior) — a plain gep strides by the array element
 * size, which muvm's emitGep walks correctly.
 *
 * otherwise base points AT `pointee` (T*, a struct*, a slice's data
 * pointer): muvm's emitGep silently DROPS the index when the pointee is
 * a scalar (the walk breaks out with offset 0). Retype the base as
 * [0 x pointee]* first, so the stride becomes sizeOf(pointee) — plain C
 * pointer arithmetic — and cast the result back to pointee*. */
pub IrValue* muvIndexAddr(Muv* w, IrValue* base, IrType* pointee, IrValue* idx, bool byElement, NodeId id)
{
    if (base == null || pointee == null || idx == null) return null;
    IrValue*[1] idxs;
    idxs[0] = idx;
    IrInst* inst = null;
    if (byElement)
    {
        inst = w->b.gep(base, idxs, 1);
        muvSetDebugLoc(w, inst, id);
    }
    else
    {
        IrType* arrT = w->ir->tyArray(pointee, 0);
        IrValue* bc = muvV(w->b.bitcast(base, w->ir->tyPtr(arrT)));
        if (bc == null) return null;
        inst = w->b.gep(bc, idxs, 1);
        muvSetDebugLoc(w, inst, id);
        if (inst == null) return null;
        IrInst* bcInst = w->b.bitcast(muvV(inst), w->ir->tyPtr(pointee));
        return muvV(bcInst);
    }
    return muvV(inst);
}

/* gep to struct field `fi` of the aggregate at `base` */
pub IrValue* muvGepField(Muv* w, IrValue* base, u32 fi)
{
    if (base == null) return null;
    IrValue*[1] idxs;
    idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)fi);
    return muvV(w->b.gep(base, idxs, 1));
}

/* An aggregate value IS its address, so the alloca that holds one is
 * typed as the aggregate itself: call/return ABI classification reads
 * the struct words through that address (kind 3/4), which it only does
 * when the value's type says Struct. Scalar slots stay ptr-typed — they
 * are loaded into registers instead. */
pub IrValue* muvAggSlot(Muv* w, IrType* ty)
{
    IrValue* slot = muvV(w->b.alloca(ty));
    if (slot != null) slot->type = ty;
    return slot;
}

/* decode Coral string-literal token text [begin,end) into out — every
 * escape becomes one byte (\n \t \r \0 \a \b \f \v \\ \" \' \xNN,
 * \NNN octal; unknown escapes drop the backslash, like C). out must hold
 * at least end-begin bytes; returns the decoded length. Shared by string
 * literals and asm template pieces so both reach IR as identical bytes. */
pub usize muvDecodeLit(str tok, usize begin, usize end, u8* out)
{
    usize dlen = 0;
    usize i = begin;
    while (i < end)
    {
        u8 c = tok.ptr[i];
        if (c != '\\' || i + 1 >= end) { out[dlen++] = c; i++; continue; }
        u8 esc = tok.ptr[i + 1];
        if (esc == 'n') { out[dlen++] = 10; i += 2; continue; }
        if (esc == 't') { out[dlen++] = 9; i += 2; continue; }
        if (esc == 'r') { out[dlen++] = 13; i += 2; continue; }
        if (esc == '0') { out[dlen++] = 0; i += 2; continue; }
        if (esc == 'a') { out[dlen++] = 7; i += 2; continue; }
        if (esc == 'b') { out[dlen++] = 8; i += 2; continue; }
        if (esc == 'f') { out[dlen++] = 12; i += 2; continue; }
        if (esc == 'v') { out[dlen++] = 11; i += 2; continue; }
        if (esc == '\\' || esc == '"' || esc == '\'') { out[dlen++] = esc; i += 2; continue; }
        if (esc == 'x')
        {
            u32 v = 0;
            usize j = i + 2;
            u32 used = 0;
            while (j < end && used < 2)
            {
                u8 h = tok.ptr[j];
                u32 d;
                if (h >= '0' && h <= '9') d = (u32)(h - '0');
                else if (h >= 'a' && h <= 'f') d = (u32)(h - 'a' + 10);
                else if (h >= 'A' && h <= 'F') d = (u32)(h - 'A' + 10);
                else break;
                v = v * 16 + d;
                j++; used++;
            }
            if (used == 0) { out[dlen++] = 'x'; i += 2; continue; }
            out[dlen++] = (u8)v;
            i = j;
            continue;
        }
        if (esc >= '0' && esc <= '7')
        {
            u32 v = 0;
            usize j = i + 1;
            u32 used = 0;
            while (j < end && used < 3)
            {
                u8 h = tok.ptr[j];
                if (h < '0' || h > '7') break;
                v = v * 8 + (u32)(h - '0');
                j++; used++;
            }
            out[dlen++] = (u8)v;
            i = j;
            continue;
        }
        /* unknown escape: the backslash drops, like C */
        out[dlen++] = esc;
        i += 2;
    }
    return dlen;
}

/* StringLit → address of merged rodata.
 *   C"..." → the pointer value itself (record is NUL-terminated)
 *   "..."  → { ptr, len } in an aggregate slot, field-wise initialized
 * Token text keeps its quotes and escapes; decoding happens here the way
 * the C backend lets the C compiler do it: every escape is one byte of
 * the str's len. */
pub IrValue* muvStringLit(Muv* w, NodeId id)
{
    Node* n = muvNode(w, id);
    if (n == null || n->kind.tag != NodeKind::Expr)
        { muvErr(w, id, "string literal"); return null; }
    Expr* e = &n->kind.payload.Expr.value;
    str tok = muvStr(w, e->kind.payload.StringLit.value);
    bool isC = (e->kind.payload.StringLit.flags & 1) != 0;
    usize begin = 0;
    usize end = tok.len;
    if (isC)
    {
        /* token text is `C"…"`: drop the prefix and both quotes */
        if (tok.len >= 3 && tok.ptr[0] == 'C' && tok.ptr[1] == '"')
            { begin = 2; end = tok.len - 1; }
    }
    else if (tok.len >= 2 && tok.ptr[0] == '"')
        { begin = 1; end = tok.len - 1; }

    u8* buf = (u8*)muvArr(w, (end - begin) + 4, 1);
    if (buf == null) { muvErr(w, id, "string literal buffer"); return null; }
    usize dlen = muvDecodeLit(tok, begin, end, buf);


    IrValue*[1] z;
    z[0] = w->ir->constInt(w->ir->tyInt(32), 0);
    str bytes = str::fromParts(buf, dlen);
    IrStringConst* sc = w->module->findConstString(bytes, (u32)dlen);
    if (sc == null)
    {
        sc = w->ir->createStringConst(bytes, (u32)dlen);
        if (sc == null) { muvErr(w, id, "string constant creation failed"); return null; }
        w->module->addConstString(sc);
    }
    IrValue* addr = muvV(w->b.gep(&sc->base, z, 1));
    if (addr == null) return null;
    if (isC) return addr;

    Ty rt = muvResolved(w, e->resolvedType);
    if (rt == 0 && w->sema != null) rt = w->sema->strType();
    IrType* st = rt != 0 ? muvTy(w, rt, 0) : null;
    if (st == null || st->kind != IrTypeKind::Struct)
        { muvErr(w, id, "str literal needs the str type"); return null; }
    IrValue* slot = muvAggSlot(w, st);
    if (slot == null) return null;
    w->b.store(addr, slot);
    IrValue* lenF = muvGepField(w, slot, 1);
    if (lenF == null) return null;
    w->b.store(w->ir->constInt(w->ir->tyInt(64), (u64)dlen), lenF);
    return slot;
}

/* the address of an lvalue expression: local slot, deref pointee, or a
 * gep chain (field / tuple field / index). Used by plain assignment,
 * compound assignment and aggregate copies alike. */
/* `T&` lvalue's referent address: addr points at the stored pointer,
 * so the referent address is one load through it (the C backend's
 * lvalue-on-reference rule). Non-reference types pass through. */
IrValue* muvAddrOfRef(Muv* w, IrValue* addr, Ty rt, NodeId id)
{
    if (addr == null || rt == 0) return addr;
    Ty bt = rt;
    while (bt != 0)
    {
        TypeEntry* te = w->ctx->types + bt;
        if (te->kind.tag == TypeKind::Const) bt = te->kind.payload.Const.base;
        else if (te->kind.tag == TypeKind::Comptime) bt = te->kind.payload.Comptime.base;
        else break;
    }
    if (bt == 0 || (w->ctx->types + bt)->kind.tag != TypeKind::Reference) return addr;
    IrType* pt = muvTy(w, rt, 0);   // ptr T — the stored pointer type
    if (pt == null) return addr;
    IrInst* li = w->b.load(pt, addr);
    muvSetDebugLoc(w, li, id);
    return muvV(li);
}

pub IrValue* muvAddrOf(Muv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) { muvErr(w, id, "not an lvalue"); return null; }
    Expr* e = &n->kind.payload.Expr.value;
    Ty rt = muvResolved(w, e->resolvedType);
    switch (e->kind.tag)
    {
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = muvFindLocal(w, name);
            if (slot != null) return muvAddrOfRef(w, slot, rt, id);
            IrValue* gv = muvResolveGlobal(w, name, id);
            if (gv != null) return muvAddrOfRef(w, gv, rt, id);
            muvErr(w, id, "cannot assign to a non-local name");
            return null;
        },
        ExprKind::Deref => {
            IrValue* dv = muvExpr(w, e->kind.payload.Deref.expr);
            return dv != null ? muvAddrOfRef(w, dv, rt, id) : null;
        },
        ExprKind::Call | ExprKind::MethodCall | ExprKind::StaticCall => {
            /* a call returning `T&` IS the referent address already —
             * the result pointer needs no further load */
            Ty bt = rt;
            while (bt != 0)
            {
                TypeEntry* te = w->ctx->types + bt;
                if (te->kind.tag == TypeKind::Const) bt = te->kind.payload.Const.base;
                else if (te->kind.tag == TypeKind::Comptime) bt = te->kind.payload.Comptime.base;
                else break;
            }
            if (bt != 0 && (w->ctx->types + bt)->kind.tag == TypeKind::Reference)
                return muvExprRaw(w, id);
            /* an aggregate call result is already address-valued (the
             * same convention as every aggregate) — `T x = f()` where
             * f returns a struct/tuple needs exactly that address for
             * the element-wise copy, not an error */
            IrType* it = rt != 0 ? muvTy(w, rt, 0) : null;
            if (it != null && muvIsAgg(it)) return muvExprRaw(w, id);
            muvErr(w, id, "cannot assign to a call result");
            return null;
        },
        ExprKind::Path => {
            /* `V::Case` as an aggregate source (`x = Option::None`,
             * `T v = V::Case`): the path's value form is already the
             * storage address — same convention as aggregate calls */
            if (muvVariantCasePath(w, id, null) >= 0) return muvExprRaw(w, id);
            /* `mod::CONST` naming a constant with storage (arrays,
             * aggregates): its address is the global's base value */
            {
                NodeId md = muvModuleMemberDecl(w, id);
                if (md.index != 0)
                {
                    Node* mn = muvNode(w, md);
                    if (mn->kind.tag == NodeKind::Decl &&
                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Constant)
                    {
                        Decl* mdd = &mn->kind.payload.Decl.value;
                        IrGlobal* g = muvGMapGet(w, md.index);
                        if (g != null) return &g->base;
                        return muvMakeGlobal(w, md, mdd->kind.payload.Constant.name,
                                             mdd->kind.payload.Constant.typeNode,
                                             mdd->kind.payload.Constant.value,
                                             true, false, 0);
                    }
                }
            }
            muvErr(w, id, "path is not an lvalue");
            return null;
        },
        ExprKind::Field | ExprKind::DerefField => {
            NodeId obj; Str fname;
            if (e->kind.tag == ExprKind::Field)
                { obj = e->kind.payload.Field.obj; fname = e->kind.payload.Field.field; }
            else
                { obj = e->kind.payload.DerefField.obj; fname = e->kind.payload.DerefField.field; }
            return muvAddrOfRef(w, muvFieldAddr(w, obj, fname, id), rt, id);
        },
        ExprKind::TupleField => {
            NodeId obj = e->kind.payload.TupleField.obj;
            u32 ti = e->kind.payload.TupleField.index;
            /* source tuple indices are 1-based (sema `._1`), the struct
             * layout is 0-based */
            if (ti == 0)
                { muvErr(w, id, "tuple index 0"); return null; }
            Node* on = muvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { muvErr(w, id, "tuple base is not an expression"); return null; }
            Ty obt = muvUnwrapTy(w, muvResolved(w, on->kind.payload.Expr.value.resolvedType));
            if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                obt = muvUnwrapTy(w, muvResolved(w, muvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));
            IrValue* base;
            if (obt != 0 && muvIsIndirect(w->ctx->types + obt))
                base = muvExpr(w, obj);
            else
                base = muvAddrOf(w, obj);
            return muvAddrOfRef(w, muvGepField(w, base, ti - 1), rt, id);
        },
        ExprKind::Index => {
            NodeId obj = e->kind.payload.Index.obj;
            NodeId ixId = e->kind.payload.Index.index;
            Node* on = muvNode(w, obj);
            if (on->kind.tag != NodeKind::Expr)
                { muvErr(w, id, "index base is not an expression"); return null; }
            Ty obt = muvUnwrapTy(w, muvResolved(w, on->kind.payload.Expr.value.resolvedType));
            if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                obt = muvUnwrapTy(w, muvResolved(w, muvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));
            IrValue* base = null;
            IrType* pointee = null;
            bool byElement = false;
            if (obt != 0)
            {
                TypeEntry* oe = w->ctx->types + obt;
                if (oe->kind.tag == TypeKind::Array)
                {
                    /* an array value: its address points at element 0 */
                    base = muvAddrOf(w, obj);
                    pointee = muvTy(w, oe->kind.payload.Array.base, 0);
                    byElement = true;
                }
                else if (oe->kind.tag == TypeKind::Pointer || oe->kind.tag == TypeKind::Reference)
                {
                    /* p[i]: C pointer arithmetic steps sizeOf(pointee) */
                    base = muvExpr(w, obj);
                    Ty pe = muvUnwrapTy(w, muvIndirectBase(oe));
                    TypeEntry* peE = pe != 0 ? w->ctx->types + pe : null;
                    if (peE != null && peE->kind.tag == TypeKind::Array)
                        pointee = muvTy(w, pe, 0);           // whole-array step
                    else
                        pointee = muvTy(w, pe, 0);           // scalar/struct step
                }
                else if (oe->kind.tag == TypeKind::Slice || oe->kind.tag == TypeKind::Str)
                {
                    Ty et = oe->kind.tag == TypeKind::Slice
                        ? oe->kind.payload.Slice.base : (Ty)0;
                    IrType* eir = et != 0 ? muvTy(w, et, 0) : w->ir->tyInt(8);
                    IrValue* va = muvAddrOf(w, obj);
                    if (va == null) return null;
                    IrValue* pSlot = muvGepField(w, va, 0); // { ptr, len } layout
                    if (pSlot == null) return null;
                    base = muvV(w->b.load(w->ir->tyPtr(eir), pSlot));
                    pointee = eir;
                }
            }
            else
            {
                /* comptime-arm base sema never stamped: an array or a
                 * pointer still identifies itself from the lvalue's IR
                 * type (a str/slice base needs the sema type — Idents get
                 * it from muvLocalTy above) */
                IrValue* probe = muvAddrOf(w, obj);
                if (probe == null) return null;
                IrType* vt = muvSlotTy(probe->type);
                if (vt != null && vt->kind == IrTypeKind::Array)
                    { base = probe; pointee = vt->elem; byElement = true; }
                else if (vt != null && vt->kind == IrTypeKind::Ptr)
                    { base = muvExpr(w, obj); pointee = vt->elem; }
            }
            if (base == null || pointee == null)
                { muvErr(w, id, "unsupported index base"); return null; }
            IrValue* idx = muvExpr(w, ixId);
            if (idx == null) return null;
            return muvAddrOfRef(w, muvIndexAddr(w, base, pointee, idx, byElement, id), rt, id);
        },
        ExprKind::StructLiteral => {
            Ty st = muvResolved(w, e->kind.payload.StructLiteral.typeNode);
            Str vname = e->kind.payload.StructLiteral.variantName;
            IrType* irt = st != 0 ? muvTy(w, st, 0) : null;
            if (vname != 0)
            {
                /* V::Case { f = v, … } — store the case ordinal in the
                 * tag field, then fill the payload through the case's
                 * struct-typed bitcast (union-variant-ir.md) */
                Decl* vd = muvVariantDeclOf(w, st);
                if (vd == null)
                    { muvErr(w, id, "variant construction needs a variant type"); return null; }
                i32 ci = muvVariantCaseIdx(w, vd, vname);
                if (ci < 0)
                    { muvErr(w, id, "unknown variant case"); return null; }
                if (irt == null || irt->kind != IrTypeKind::Struct)
                    { muvErr(w, id, "variant type lowered to a non-struct"); return null; }
                IrValue* slot = muvAggSlot(w, irt);
                if (slot == null) return null;
                IrValue* tagA = muvGepField(w, slot, 0);
                if (tagA == null) return null;
                w->b.store(w->ir->constInt(w->ir->tyInt(32), (u64)(u32)ci), tagA);
                IrValue* payA = muvGepField(w, slot, 1);
                if (payA == null) return null;
                IrStructType* cst = muvVariantCaseStructTyFor(w, st, (u32)ci, 0);
                if (cst == null) return null;
                IrValue* caseA = muvV(w->b.bitcast(payA, w->ir->tyPtr(cst->irType)));
                if (caseA == null) return null;
                u32 i = 0;
                u32 n = e->kind.payload.StructLiteral.fieldValuesLen;
                Str* fnames = e->kind.payload.StructLiteral.fieldNames;
                NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
                while (i < n)
                {
                    if (fvals == null || fvals[i].index == 0) { i++; continue; }
                    /* positional literal (`V::Case { v1, v2 }`): the
                     * field is the i-th case field — sema already
                     * checked count and types */
                    i32 fi = fnames != null
                        ? muvVariantCaseFieldIdx(w, vd, (u32)ci, fnames[i])
                        : (i32)i;
                    if (fi < 0 || (u32)fi >= cst->nfields)
                        { muvErr(w, id, "unknown variant field"); return null; }
                    IrValue* fa = muvGepField(w, caseA, (u32)fi);
                    if (fa == null) return null;
                    IrType* ft = cst->irType->params[(u32)fi];
                    if (muvIsAgg(ft))
                    {
                        Node* _fv = muvNode(w, fvals[i]);
                        if (_fv != null && _fv->kind.tag == NodeKind::Expr &&
                            _fv->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                        {
                            muvZeroMem(w, fa, w->ir->irTypeSizeOf(ft));
                            i++;
                            continue;
                        }
                        IrValue* sv = muvAddrOf(w, fvals[i]);
                        if (sv == null) return null;
                        if (!muvCopyAgg(w, fa, sv, ft, 0)) return null;
                    }
                    else
                    {
                        if (muvLitStore(w, fvals[i], fa, ft) == null) return null;
                    }
                    i++;
                }
                return slot;
            }
            Decl* ud = muvUnionDeclOf(w, st);
            if (ud != null)
            {
                /* union literal `U { .f = v }`: every field overlaps at
                 * offset 0 — alloca the blob, then bitcast-store each
                 * provided field through its own pointer type (the same
                 * rule muvFieldAddr uses for `u.f = v`). Multiple fields
                 * store sequentially; the last one wins, matching the C
                 * backend's overlapping-storage semantics */
                if (irt == null || irt->kind != IrTypeKind::Union)
                    { muvErr(w, id, "union literal needs a union type"); return null; }
                IrValue* slot = muvAggSlot(w, irt);
                if (slot == null) return null;
                u32 i = 0;
                u32 n = e->kind.payload.StructLiteral.fieldValuesLen;
                Str* fnames = e->kind.payload.StructLiteral.fieldNames;
                NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
                while (i < n)
                {
                    if (fvals == null || fvals[i].index == 0) { i++; continue; }
                    IrType* ft = fnames != null
                        ? muvUnionFieldTy(w, ud, fnames[i], 0)
                        : muvUnionFieldTyIdx(w, ud, i, 0);
                    if (ft == null)
                        { muvErr(w, id, "unknown union literal field"); return null; }
                    IrValue* fa = muvV(w->b.bitcast(slot, w->ir->tyPtr(ft)));
                    if (fa == null) return null;
                    if (muvIsAgg(ft))
                    {
                        Node* _fv = muvNode(w, fvals[i]);
                        if (_fv != null && _fv->kind.tag == NodeKind::Expr &&
                            _fv->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                        {
                            muvZeroMem(w, fa, w->ir->irTypeSizeOf(ft));
                            i++;
                            continue;
                        }
                        IrValue* sv = muvAddrOf(w, fvals[i]);
                        if (sv == null) return null;
                        if (!muvCopyAgg(w, fa, sv, ft, 0)) return null;
                    }
                    else
                    {
                        if (muvLitStore(w, fvals[i], fa, ft) == null) return null;
                    }
                    i++;
                }
                return slot;
            }
            if (irt == null || irt->kind != IrTypeKind::Struct)
            {
                if (getenv(C"MUV_DEBUG") != null)
                {
                    TypeEntry* te = st != 0 ? w->ctx->types + st : null;
                    Str tn = te != null && te->kind.tag == TypeKind::Named
                        ? te->kind.payload.Named.name : 0;
                    str ns = tn != 0 ? muvStr(w, tn) : str { .ptr = (const u8*)"?", .len = 1 };
                    printf(C"muvdbg: structlit fail st=%u name=%.*s tk=%d irtk=%d\n",
                           st, (i32)ns.len, ns.ptr,
                           te != null ? (i32)te->kind.tag : -1,
                           irt != null ? (i32)irt->kind : -1);
                }
                muvErr(w, id, "struct literal needs a struct type"); return null;
            }
            IrValue* slot = muvAggSlot(w, irt);
            if (slot == null) return null;
            u32 i = 0;
            u32 n = e->kind.payload.StructLiteral.fieldValuesLen;
            Str* fnames = e->kind.payload.StructLiteral.fieldNames;
            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;
            while (i < n)
            {
                if (fvals == null || fvals[i].index == 0) { i++; continue; }
                /* positional literal (`S { v1, v2 }`): field i — sema
                 * validated count and types; skipping here used to emit
                 * an empty struct (silent miscompile) */
                u32 fi = fnames != null ? muvFieldIdx(w, st, fnames[i]) : i;
                if (fi == 0xFFFFFFFF || fi >= irt->nparams)
                    { muvErr(w, id, "unknown struct literal field"); return null; }
                IrValue* fa = muvGepField(w, slot, fi);
                if (fa == null) return null;
                IrType* ft = irt->params[fi];
                /* `T&` field: the slot holds a pointer — store the
                 * value expr's ADDRESS, like `T& r = x` var init */
                Str lf = fnames != null ? fnames[i] : 0;
                Ty fsem = muvStructFieldTy(w, st, lf, lf == 0 ? fi : 0);
                if (getenv(C"MUV_DEBUG") != null)
                {
                    Node* fv = muvNode(w, fvals[i]);
                    if (fv != null && fv->kind.tag == NodeKind::Expr &&
                        fv->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                        printf(C"muvdbg: null field fi=%u isRef=%u isAgg=%u\n",
                               fi, muvTyIsRef(w, fsem) ? 1 : 0, muvIsAgg(ft) ? 1 : 0);
                }
                if (muvTyIsRef(w, fsem))
                {
                    IrValue* ra = muvAddrOf(w, fvals[i]);
                    if (ra == null) return null;
                    muvStoreVal(w, ra, fa, ft);
                }
                else if (muvIsAgg(ft))
                {
                    /* `null` into an aggregate field zero-fills it —
                     * there is no literal address to copy from */
                    Node* fv = muvNode(w, fvals[i]);
                    if (fv != null && fv->kind.tag == NodeKind::Expr &&
                        fv->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                    {
                        muvZeroMem(w, fa, w->ir->irTypeSizeOf(ft));
                        i++;
                        continue;
                    }
                    IrValue* sv = muvAddrOf(w, fvals[i]);
                    if (sv == null) return null;
                    if (!muvCopyAgg(w, fa, sv, ft, 0)) return null;
                }
                else
                {
                    if (muvLitStore(w, fvals[i], fa, ft) == null) return null;
                }
                i++;
            }
            return slot;
        },
        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            Ty at = muvResolved(w, e->resolvedType);
            IrType* irt = at != 0 ? muvTy(w, at, 0) : null;
            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))
            {
                if (getenv(C"MUV_DEBUG") != null)
                {
                    TypeEntry* te = at != 0 ? w->ctx->types + at : null;
                    Str tn = te != null && te->kind.tag == TypeKind::Named
                        ? te->kind.payload.Named.name : 0;
                    str ns = tn != 0 ? muvStr(w, tn) : str { .ptr = (const u8*)"?", .len = 1 };
                    u8 tb = 0;
                    u8 db = 0;
                    IrType* th = null;
                    Decl* dd = null;
                    NodeId tdid = muvFindTypeDecl(w, tn);
                    if (tdid.index != 0)
                    {
                        Node* tn2 = w->ctx->nodes + tdid.index;
                        if (tn2->kind.tag == NodeKind::Decl)
                            dd = &tn2->kind.payload.Decl.value;
                    }
                    bool tf = muvTyMapFind(w, at, &tb, &th);
                    bool df = dd != null && muvDeclTyMapFind(w, dd, &db, &th);
                    str fnm = str { .ptr = (const u8*)"?", .len = 1 };
                    if (w->fn != null && w->fn->base.name.ptr != null)
                        fnm = w->fn->base.name;
                    printf(C"muvdbg: arrlit fail at=%u tk=%d name=%.*s irtk=%d tybusy=%u/%u declbusy=%u/%u subs=%u fn=%.*s\n",
                           at, te != null ? (i32)te->kind.tag : -1,
                           (i32)ns.len, ns.ptr,
                           irt != null ? (i32)irt->kind : -1,
                           tf ? 1 : 0, tb, df ? 1 : 0, db, w->subsLen,
                           (i32)fnm.len, fnm.ptr);
                }
                muvErr(w, id, "array/tuple literal needs an aggregate type"); return null;
            }
            IrValue* slot = muvAggSlot(w, irt);
            if (slot == null) return null;
            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;
            u32 n = e->kind.tag == ExprKind::ArrayLiteral
                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;
            u32 i = 0;
            while (i < n)
            {
                if (elems == null || elems[i].index == 0) { i++; continue; }
                if (irt->kind == IrTypeKind::Array && i >= irt->count) { i++; continue; }
                IrValue*[1] idxs;
                idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
                IrValue* ea = muvV(w->b.gep(slot, idxs, 1));
                if (ea == null) return null;
                IrType* et = irt->kind == IrTypeKind::Array ? irt->elem
                    : (i < irt->nparams ? irt->params[i] : null);
                if (et == null) { i++; continue; }
                if (muvIsAgg(et))
                {
                    Node* _ev = muvNode(w, elems[i]);
                    if (_ev != null && _ev->kind.tag == NodeKind::Expr &&
                        _ev->kind.payload.Expr.value.kind.tag == ExprKind::NullLit)
                    {
                        muvZeroMem(w, ea, w->ir->irTypeSizeOf(et));
                        i++;
                        continue;
                    }
                    IrValue* sv = muvAddrOf(w, elems[i]);
                    if (sv == null) return null;
                    if (!muvCopyAgg(w, ea, sv, et, 0)) return null;
                }
                else
                {
                    if (muvLitStore(w, elems[i], ea, et) == null) return null;
                }
                i++;
            }
            return slot;
        },
        ExprKind::IfExpr | ExprKind::SwitchExpr | ExprKind::Ternary => {
            /* a conditional expression yielding an aggregate
             * materializes a temp slot whose address IS the value —
             * same convention as aggregate calls/variant paths. Scalar
             * ternary lvalues (`(c ? a : b) = v`) never reach here with
             * an aggregate type, so they keep their existing path */
            IrType* it = rt != 0 ? muvTy(w, rt, 0) : null;
            if (it != null && muvIsAgg(it)) return muvExprRaw(w, id);
            muvErr(w, id, "cannot assign to a conditional expression result");
            return null;
        },
        ExprKind::StringLit => { return muvStringLit(w, id); },
        else => {
            if (getenv(C"MUV_DEBUG") != null)
                printf(C"muvdbg: addrOf unsupported kind=%d\n", e->kind.tag);
            muvErr(w, id, "unsupported assignment target"); return null;
        },
    }
}

/* element-wise aggregate copy through addresses (structs/arrays are never
 * register values in this lowering — see the aggregate rule in expr.crl) */
pub bool muvCopyAgg(Muv* w, IrValue* dst, IrValue* src, IrType* ty, u32 depth)
{
    if (dst == null || src == null || ty == null) return false;
    if (depth > 16) { muvErr(w, NodeId{ .index = 0 }, "aggregate copy too deep"); return false; }
    if (ty->kind == IrTypeKind::Struct)
    {
        u32 i = 0;
        while (i < ty->nparams)
        {
            IrValue* d = muvGepField(w, dst, i);
            IrValue* s = muvGepField(w, src, i);
            if (d == null || s == null) return false;
            if (!muvCopyAgg(w, d, s, ty->params[i], depth + 1)) return false;
            i++;
        }
        return true;
    }
    if (ty->kind == IrTypeKind::Union)
    {
        /* overlapping fields make element-wise copying meaningless —
         * move the whole blob with one aggregate load/store; the
         * backend memcpys the pointee bytes */
        IrValue* v = muvV(w->b.load(ty, src));
        if (v == null) return false;
        w->b.store(v, dst);
        return true;
    }
    if (ty->kind == IrTypeKind::Array || ty->kind == IrTypeKind::Vector)
    {
        u32 i = 0;
        while (i < ty->count)
        {
            IrValue*[1] idxs;
            idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);
            IrValue* d = muvV(w->b.gep(dst, idxs, 1));
            IrValue* s = muvV(w->b.gep(src, idxs, 1));
            if (d == null || s == null) return false;
            if (!muvCopyAgg(w, d, s, ty->elem, depth + 1)) return false;
            i++;
        }
        return true;
    }
    /* scalar: muvm loads at most 8 bytes into one register */
    u32 sz = w->ir->irTypeSizeOf(ty);
    if (sz == 0 || sz > 8)
    {
        muvErr(w, NodeId{ .index = 0 }, "scalar wider than 8 bytes in aggregate copy (Phase 2)");
        return false;
    }
    IrValue* v = muvV(w->b.load(ty, src));
    if (v == null) return false;
    w->b.store(v, dst);
    return true;
}

/* compound-assignment operator: op is the Coral source operator
 * ("+=", "-=", ...); cur is the loaded lhs, rhs the evaluated rhs.
 * Returns the stored result. */
pub IrValue* muvCompoundOp(Muv* w, str op, IrValue* cur, IrValue* rhs, Ty ct, NodeId id)
{
    if (cur == null || rhs == null) return null;
    ExprKind k;
    if (op.equals("+=")) k.tag = ExprKind::Add;
    else if (op.equals("-=")) k.tag = ExprKind::Sub;
    else if (op.equals("*=")) k.tag = ExprKind::Mul;
    else if (op.equals("/=")) k.tag = ExprKind::Div;
    else if (op.equals("%=")) k.tag = ExprKind::Mod;
    else if (op.equals("&=")) k.tag = ExprKind::BitAnd;
    else if (op.equals("|=")) k.tag = ExprKind::BitOr;
    else if (op.equals("^=")) k.tag = ExprKind::BitXor;
    else if (op.equals("<<=")) k.tag = ExprKind::Shl;
    else if (op.equals(">>=")) k.tag = ExprKind::Shr;
    else { muvErr(w, id, "unsupported assignment operator"); return null; }
    return muvArithVals(w, k, cur, rhs, id, ct);
}

/* one assignment: address the target, then store (plain) or
 * load–combine–store (compound). Aggregates copy element-wise. Shared by
 * the ExprKind::Assign* family and StmtKind::Assign. Returns the stored
 * value, or null (void / aggregate / error). */
pub IrValue* muvAssignCommon(Muv* w, NodeId target, NodeId value, str op, NodeId id)
{
    IrValue* addr = muvAddrOf(w, target);
    if (addr == null) return null;
    Node* tn = muvNode(w, target);
    Ty tgtTy = tn->kind.tag == NodeKind::Expr
        ? muvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
    /* `self = x` writes through the implicit receiver pointer — sema's
     * assignTargetType strips Self* -> Self for the name `self` only.
     * The lvalue is the pointee: load the pointer out of its slot and
     * type the access by the base, exactly like `*self = x` lowers. */
    if (tgtTy != 0 && tn->kind.tag == NodeKind::Expr &&
        tn->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
        tn->kind.payload.Expr.value.kind.payload.Ident.name ==
            w->ctx->intern("self"))
    {
        Ty ut = muvUnwrapTy(w, tgtTy);
        TypeEntry* ute = ut != 0 ? w->ctx->types + ut : null;
        IrType* pt = null;
        if (ute != null && ute->kind.tag == TypeKind::Pointer)
            pt = muvTy(w, tgtTy, 0);
        else if (ute == null)
        {
            /* self's local is pushed with ty=0 and sema may leave
             * resolvedType unstamped: the slot's value type is the
             * receiver pointer Self* — ptr Self — so a Ptr there is
             * the same write-through case */
            IrType* sv = muvSlotTy(addr->type);
            if (sv != null && sv->kind == IrTypeKind::Ptr) pt = sv;
        }
        if (pt != null && pt->kind == IrTypeKind::Ptr)
        {
            IrInst* li = w->b.load(pt, addr);
            if (li != null)
            {
                addr = muvV(li);
                if (ute != null) tgtTy = ute->kind.payload.Pointer.base;
            }
        }
    }
    /* assigning through `T&` stores/loads the REFERENT — addr already
     * is the referent address, so type the access by the base type */
    Ty at = tgtTy;
    while (at != 0)
    {
        TypeEntry* ae = w->ctx->types + at;
        if (ae->kind.tag == TypeKind::Const) at = ae->kind.payload.Const.base;
        else if (ae->kind.tag == TypeKind::Comptime) at = ae->kind.payload.Comptime.base;
        else if (ae->kind.tag == TypeKind::Reference) at = ae->kind.payload.Reference.base;
        else break;
    }
    IrType* vt = at != 0 ? muvTy(w, at, 0) : muvSlotTy(addr->type);
    if (vt == null || vt->kind == IrTypeKind::Void)
        { muvErr(w, id, "cannot type assignment target"); return null; }

    if (op.equals("="))
    {
        /* RAII: `x = v` drops x's OLD value now (the pending entry stays
         * registered — it now owns the new value at scope exit), same as
         * the C backend's cgEmitDropEntry on the assign path */
        {
            Node* tnn = muvNode(w, target);
            if (tnn != null && tnn->kind.tag == NodeKind::Expr &&
                tnn->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
            {
                Str tnm = tnn->kind.payload.Expr.value.kind.payload.Ident.name;
                i32 di = stmt::muvDropFind(w, tnm);
                if (di >= 0) stmt::muvEmitDropEntry(w, &w->drops[di]);
            }
        }
        /* `x.tag = V::Case` writes the case ordinal — the path's value
         * form is the whole {tag,payload} aggregate (C backend's
         * cgAssignValue does the same for `.tag` targets) */
        Decl* cvd = null;
        i32 vci = muvVariantCasePath(w, value, &cvd);
        if (vci >= 0 && muvIsTagAccess(w, target) && !muvIsAgg(vt))
        {
            IrInst* ti = w->b.store(w->ir->constInt(vt, (u64)(u32)vci), addr);
            if (ti != null) muvSetDebugLoc(w, ti, id);
            return null;
        }
        if (muvIsAgg(vt))
        {
            IrValue* src = muvAddrOf(w, value);
            if (src == null) return null;
            if (!muvCopyAgg(w, addr, src, vt, 0)) return null;
            return null;
        }
        IrValue* val = muvExpr(w, value);
        if (val == null) return null;
        Node* vn = muvNode(w, value);
        Ty vty = vn != null && vn->kind.tag == NodeKind::Expr
            ? vn->kind.payload.Expr.value.resolvedType : 0;
        val = muvCoerceToIr(w, val, vty, vt, id);
        IrInst* storeInst = muvStoreVal(w, val, addr, vt);
        if (storeInst != null) muvSetDebugLoc(w, storeInst, id);
        return val;
    }
    if (muvIsAgg(vt)) { muvErr(w, id, "compound assign on aggregate (Phase 2)"); return null; }
    IrInst* loadInst = w->b.load(vt, addr);
    muvSetDebugLoc(w, loadInst, id);
    IrValue* cur = muvV(loadInst);
    IrValue* rhs = muvExpr(w, value);
    Node* vn2 = muvNode(w, value);
    Ty vty2 = vn2 != null && vn2->kind.tag == NodeKind::Expr
        ? vn2->kind.payload.Expr.value.resolvedType : 0;
    rhs = muvCoerceToIr(w, rhs, vty2, vt, id);
    IrValue* res = muvCompoundOp(w, op, cur, rhs, tgtTy, id);
    if (res == null) return null;
    IrInst* storeInst = w->b.store(res, addr);
    muvSetDebugLoc(w, storeInst, id);
    return res;
}


/* the value of a body node: an expression, an expression statement, or
 * a block whose last statement is one — everything before it lowers as
 * statements in its own scope. `vt` is the result type (null = no
 * value); a body that yields nothing falls back to a zero constant. */
pub IrValue* muvValBody(Muv* w, NodeId id, IrType* vt)
{
    if (id.index == 0) return vt != null ? w->ir->constInt(vt, 0) : null;
    Node* n = muvNode(w, id);
    if (n->kind.tag == NodeKind::Expr) return muvExpr(w, id);
    if (n->kind.tag != NodeKind::Stmt)
        { muvErr(w, id, "expected a statement or expression body"); return null; }
    Stmt* s = &n->kind.payload.Stmt.value;
    if (s->kind.tag == StmtKind::ExprStmt) return muvExpr(w, s->kind.payload.ExprStmt.expr);
    if (s->kind.tag == StmtKind::Block)
    {
        u32 scopeMark = w->locLen;
        u32 cnt = s->kind.payload.Block.stmtsLen;
        u32 i = 0;
        while (i + 1 < cnt && !w->term)
        {
            NodeId si = s->kind.payload.Block.stmts[i];
            Node* sn = muvNode(w, si);
            /* block lists can hold a bare expr where a stmt is expected
             * (`=> { 1 }` arms): evaluate and discard it */
            if (sn != null && sn->kind.tag == NodeKind::Expr) muvExpr(w, si);
            else stmt::muvStmt(w, si);
            i++;
        }
        IrValue* res = null;
        if (cnt == 0 || w->term) res = vt != null ? w->ir->constInt(vt, 0) : null;
        else
        {
            NodeId last = s->kind.payload.Block.stmts[cnt - 1];
            Node* ln = muvNode(w, last);
            if (ln != null && ln->kind.tag == NodeKind::Expr)
                res = muvExpr(w, last);
            else if (ln->kind.tag == NodeKind::Stmt &&
                ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)
                res = muvExpr(w, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
            else
            {
                stmt::muvStmt(w, last);
                res = vt != null ? w->ir->constInt(vt, 0) : null;
            }
        }
        w->locLen = scopeMark;
        return res;
    }
    muvErr(w, id, "expected a statement or expression body");
    return null;
}

/* NOTE: no synthesized externs here — every IrFunc must come from a
 * source declaration (decl.crl) so the linker/import tables stay
 * honest. Runtime hooks like core::error::_trap are declared in core
 * itself (see muvTrapName). */


/* `T&` in operand position reads through the reference (the C backend's
 * cgExpr `(*v)` wrap): the raw lowering of a reference-typed expression
 * already yields the referent ADDRESS (slot load, call result, field
 * load — all ptr T), so the value form loads the referent for scalars
 * and keeps the address for aggregates. Anything whose raw result is
 * not a pointer (e.g. an assign expression's stored value) passes
 * through untouched. */
pub IrValue* muvExpr(Muv* w, NodeId id)
{
    IrValue* v = muvExprRaw(w, id);
    if (v == null || id.index == 0) return v;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr) return v;
    Ty rt = muvResolved(w, n->kind.payload.Expr.value.resolvedType);
    while (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        if (te->kind.tag == TypeKind::Const) rt = te->kind.payload.Const.base;
        else if (te->kind.tag == TypeKind::Comptime) rt = te->kind.payload.Comptime.base;
        else break;
    }
    if (rt == 0 || (w->ctx->types + rt)->kind.tag != TypeKind::Reference) return v;
    if (v->type == null || v->type->kind != IrTypeKind::Ptr) return v;
    Ty base = (w->ctx->types + rt)->kind.payload.Reference.base;
    IrType* tt = base != 0 ? muvTy(w, base, 0) : null;
    if (tt == null || muvIsAgg(tt)) return v;
    IrInst* li = w->b.load(tt, v);
    muvSetDebugLoc(w, li, id);
    return muvV(li);
}

pub IrValue* muvExprRaw(Muv* w, NodeId id)
{
    if (id.index == 0) return null;
    Node* n = muvNode(w, id);
    if (n->kind.tag != NodeKind::Expr)
    {
        muvErr(w, id, "expected expression node");
        return null;
    }
    Expr* e = &n->kind.payload.Expr.value;
    Ty rt = muvResolved(w, e->resolvedType);
    switch (e->kind.tag)
    {
        ExprKind::IntLit => {
            IrType* it = rt != 0 ? muvTy(w, rt, 0)
                                 : w->ir->tyInt(32);
            return w->ir->constInt(it, e->kind.payload.IntLit.value);
        },
        ExprKind::BoolLit => {
            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;
            return w->ir->constInt(w->ir->tyInt(1), v);
        },
        ExprKind::CharLit => {
            return w->ir->constInt(w->ir->tyInt(8), (u64)e->kind.payload.CharLit.value);
        },
        ExprKind::NullLit => {
            return w->ir->constInt(w->ir->tyPtr(w->ir->tyInt(8)), 0);
        },
        ExprKind::FloatLit => {
            f64 d = muvParseFloat(w, e->kind.payload.FloatLit.value);
            IrType* ft = w->ir->tyDouble();
            if (rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::F32)
                ft = w->ir->tyFloat();
            IrValue* dv = w->ir->constFloat(w->ir->tyDouble(), d);
            if (ft->width == 32) return muvV(w->b.fpTrunc(dv, ft));
            return dv;
        },
        ExprKind::StringLit => { return muvStringLit(w, id); },
        ExprKind::StructLiteral | ExprKind::ArrayLiteral | ExprKind::TupleExpr => {
            /* aggregates are address-valued: the literal's slot IS the value */
            return muvAddrOf(w, id);
        },
        ExprKind::Ident => {
            Str name = e->kind.payload.Ident.name;
            IrValue* slot = muvFindLocal(w, name);
            if (slot != null)
            {
                /* rt==0: expr inside a comptime switch arm — sema skips
                 * those arms (typecheck comptimeDepth guard) and CtEval
                 * emits the selected one, so type from the pushed slot */
                IrType* vt = rt != 0 ? muvTy(w, rt, 0) : muvSlotTy(slot->type);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                /* an aggregate's value is its address — no load */
                if (muvIsAgg(vt)) return slot;
                return muvV(w->b.load(vt, slot));
            }
            IrValue* gv = muvResolveGlobal(w, name, id);
            /* a function in value position is a pointer to itself. This
             * must come before the void/aggregate guards: a function
             * symbol is stamped with its return type (decl.crl), so a
             * void-returning function reaches here with rt==void and
             * would be dropped as a "void" name before the lookup */
            IrFunc* fv = muvLookupFunc(w, name, id);
            if (fv != null) return &fv->base;
            IrType* vt = rt != 0 ? muvTy(w, rt, 0) : null;
            if (vt != null && vt->kind == IrTypeKind::Void) return null;
            /* an aggregate's value is its address, and that address is
             * one copy in storage — never re-materialised per use */
            if (vt != null && muvIsAgg(vt))
            {
                if (gv != null) return gv;
                muvErr(w, id, "aggregate name has no storage");
                return null;
            }
            /* a scalar constant has no storage to read: fold it */
            NodeId cd = muvResolveConst(w, name, id);
            if (cd.index != 0)
            {
                Node* cn = muvNode(w, cd);
                NodeId init = cn->kind.payload.Decl.value.kind.payload.Constant.value;
                if (init.index != 0) return muvExpr(w, init);
            }
            /* a name that keeps storage reads through its global */
            if (gv != null)
            {
                if (vt == null) vt = muvSlotTy(gv->type);
                if (vt == null || vt->kind == IrTypeKind::Void) return null;
                if (muvIsAgg(vt)) return gv;
                return muvV(w->b.load(vt, gv));
            }
            muvErr(w, id, "unresolved identifier");
            return null;
        },
        ExprKind::Field | ExprKind::DerefField | ExprKind::TupleField |
        ExprKind::Index => {
            IrValue* addr = muvAddrOf(w, id);
            if (addr == null) return null;
            /* a reference-typed field/element: addrOf already resolved
             * through the reference and yielded the stored pointer —
             * that pointer IS the expression's value (the auto-deref
             * below loads the pointee when the context wants T, not T&) */
            Ty urt = rt != 0 ? muvUnwrapTy(w, rt) : 0;
            if (urt != 0 && (w->ctx->types + urt)->kind.tag == TypeKind::Reference)
                return addr;
            /* rt==0 (comptime arm): the gep result already carries the
             * field's address type — its pointee is the value type */
            IrType* vt = rt != 0 ? muvTy(w, rt, 0) : muvSlotTy(addr->type);
            if (vt == null || vt->kind == IrTypeKind::Void) return null;
            /* an aggregate's value is its address — same convention as
             * idents and literals (array->pointer decay for a `u8*`
             * argument is exactly this address) */
            if (muvIsAgg(vt)) return addr;
            return muvV(w->b.load(vt, addr));
        },
        ExprKind::Assign | ExprKind::AssignAdd | ExprKind::AssignSub |
        ExprKind::AssignMul | ExprKind::AssignDiv | ExprKind::AssignMod |
        ExprKind::AssignBitAnd | ExprKind::AssignBitOr | ExprKind::AssignBitXor |
        ExprKind::AssignShl | ExprKind::AssignShr => {
            NodeId target; NodeId value;
            str op = "=";
            if (e->kind.tag == ExprKind::Assign)
                { target = e->kind.payload.Assign.target; value = e->kind.payload.Assign.value; }
            else if (e->kind.tag == ExprKind::AssignAdd)
                { target = e->kind.payload.AssignAdd.target; value = e->kind.payload.AssignAdd.value; op = "+="; }
            else if (e->kind.tag == ExprKind::AssignSub)
                { target = e->kind.payload.AssignSub.target; value = e->kind.payload.AssignSub.value; op = "-="; }
            else if (e->kind.tag == ExprKind::AssignMul)
                { target = e->kind.payload.AssignMul.target; value = e->kind.payload.AssignMul.value; op = "*="; }
            else if (e->kind.tag == ExprKind::AssignDiv)
                { target = e->kind.payload.AssignDiv.target; value = e->kind.payload.AssignDiv.value; op = "/="; }
            else if (e->kind.tag == ExprKind::AssignMod)
                { target = e->kind.payload.AssignMod.target; value = e->kind.payload.AssignMod.value; op = "%="; }
            else if (e->kind.tag == ExprKind::AssignBitAnd)
                { target = e->kind.payload.AssignBitAnd.target; value = e->kind.payload.AssignBitAnd.value; op = "&="; }
            else if (e->kind.tag == ExprKind::AssignBitOr)
                { target = e->kind.payload.AssignBitOr.target; value = e->kind.payload.AssignBitOr.value; op = "|="; }
            else if (e->kind.tag == ExprKind::AssignBitXor)
                { target = e->kind.payload.AssignBitXor.target; value = e->kind.payload.AssignBitXor.value; op = "^="; }
            else if (e->kind.tag == ExprKind::AssignShl)
                { target = e->kind.payload.AssignShl.target; value = e->kind.payload.AssignShl.value; op = "<<="; }
            else
                { target = e->kind.payload.AssignShr.target; value = e->kind.payload.AssignShr.value; op = ">>="; }
            return muvAssignCommon(w, target, value, op, id);
        },
        
        ExprKind::PostInc | ExprKind::PostDec |
        ExprKind::PreInc | ExprKind::PreDec => {
            NodeId tgt = e->kind.payload.PostInc.expr;
            IrValue* addr = muvAddrOf(w, tgt);
            if (addr == null) return null;
            Node* tn = muvNode(w, tgt);
            Ty tt = tn->kind.tag == NodeKind::Expr
                ? muvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;
            IrType* vt = tt != 0 ? muvTy(w, tt, 0) : muvSlotTy(addr->type);
            if (vt == null || muvIsAgg(vt)) { muvErr(w, id, "increment target is not scalar"); return null; }
            IrValue* cur = muvV(w->b.load(vt, addr));
            bool dec = e->kind.tag == ExprKind::PostDec || e->kind.tag == ExprKind::PreDec;
            IrValue* nv;
            if (vt->kind == IrTypeKind::Float)
            {
                IrValue* one = w->ir->constFloat(vt, 1.0);
                nv = muvV(dec ? w->b.fsub(cur, one) : w->b.fadd(cur, one));
            }
            else {
                IrValue* one = w->ir->constInt(vt, 1);
                nv = muvV(dec ? w->b.sub(cur, one) : w->b.add(cur, one));
            }
            if (nv == null) return null;
            w->b.store(nv, addr);
            bool post = e->kind.tag == ExprKind::PostInc || e->kind.tag == ExprKind::PostDec;
            return post ? cur : nv;
        },
        
        ExprKind::Ternary => {
            IrValue* c = muvCond(w, muvExpr(w, e->kind.payload.Ternary.cond));
            if (c == null) return null;
            IrType* vt = rt != 0 ? muvTy(w, rt, 0) : null;
            if (vt == null || vt->kind == IrTypeKind::Void)
            {
                /* void ternary: lower both arms as statements */
                IrBlock* tBb = muvBlock(w, "sel.then");
                IrBlock* fBb = muvBlock(w, "sel.else");
                IrBlock* jBb = muvBlock(w, "sel.end");
                w->b.condBr(c, tBb, fBb);
                muvSetBlock(w, tBb);
                muvExpr(w, e->kind.payload.Ternary.thenExpr);
                if (!w->term) w->b.br(jBb);
                muvSetBlock(w, fBb);
                muvExpr(w, e->kind.payload.Ternary.elseExpr);
                if (!w->term) w->b.br(jBb);
                muvSetBlock(w, jBb);
                return null;
            }
            /* aggregate ternary: arms are address-valued — copy each
             * into the result slot and yield the slot's address */
            bool agg = muvIsAgg(vt);
            IrValue* slot = agg ? muvAggSlot(w, vt) : muvV(w->b.alloca(vt));
            if (slot == null) return null;
            IrBlock* tBb = muvBlock(w, "sel.then");
            IrBlock* fBb = muvBlock(w, "sel.else");
            IrBlock* jBb = muvBlock(w, "sel.end");
            w->b.condBr(c, tBb, fBb);
            muvSetBlock(w, tBb);
            IrValue* tv = muvExpr(w, e->kind.payload.Ternary.thenExpr);
            if (tv != null) muvArmStore(w, tv, slot, vt);
            w->b.br(jBb);
            muvSetBlock(w, fBb);
            IrValue* fv = muvExpr(w, e->kind.payload.Ternary.elseExpr);
            if (fv != null) muvArmStore(w, fv, slot, vt);
            w->b.br(jBb);
            muvSetBlock(w, jBb);
            return agg ? slot : muvV(w->b.load(vt, slot));
        },
        
        ExprKind::Call => { return muvCall(w, e, id); },
        ExprKind::MethodCall => { return muvMethodCall(w, e, id); },
        
        ExprKind::Path => {
            NodeId* segs = e->kind.payload.Path.segments;
            u32 sn = e->kind.payload.Path.segmentsLen;
            if (sn == 0) { muvErr(w, id, "empty path expression"); return null; }
            /* `V::Case` path in value position is the case's aggregate
             * value — { i32 tag = ordinal; zeroed payload } — the same
             * shape `V::Case { … }` literals produce. `.tag` reads and
             * writes intercept the ordinal form before reaching here
             * (muvCompare / muvAssignCommon). Enum members stay scalar
             * constants. */
            if (sn == 2)
            {
                Decl* cvd = null;
                i32 vci = muvVariantCasePath(w, id, &cvd);
                if (vci >= 0)
                {
                    Ty hty = muvResolved(w, e->resolvedType);
                    IrType* irt = hty != 0 ? muvTy(w, hty, 0) : muvDeclTy(w, cvd, 0);
                    if (irt == null || irt->kind != IrTypeKind::Struct)
                        { muvErr(w, id, "variant case value needs a variant type"); return null; }
                    IrValue* slot = muvAggSlot(w, irt);
                    if (slot == null) return null;
                    IrValue* tagA = muvGepField(w, slot, 0);
                    if (tagA == null) return null;
                    w->b.store(w->ir->constInt(w->ir->tyInt(32), (u64)(u32)vci), tagA);
                    IrValue* payA = muvGepField(w, slot, 1);
                    if (payA == null) return null;
                    muvZeroMem(w, payA, w->ir->irTypeSizeOf(irt->params[1]));
                    return slot;
                }
                Node* s0 = muvNode(w, segs[0]);
                Node* s1 = muvNode(w, segs[1]);
                if (s0->kind.tag == NodeKind::Expr && s1->kind.tag == NodeKind::Expr &&
                    s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&
                    s1->kind.payload.Expr.value.kind.tag == ExprKind::Ident)
                {
                    NodeId td = muvFindTypeDecl(w,
                        s0->kind.payload.Expr.value.kind.payload.Ident.name);
                    if (td.index != 0)
                    {
                        Node* dn = muvNode(w, td);
                        if (dn->kind.tag == NodeKind::Decl)
                        {
                            Decl* dd = &dn->kind.payload.Decl.value;
                            if (dd->kind.tag == DeclKind::Enum)
                            {
                                /* `Color::Blue` in value position is the
                                 * member's constant (ordinal or explicit
                                 * `= N`) at the enum's lowered type */
                                IrType* bt = dd->kind.payload.Enum.backingType != 0
                                    ? muvTy(w, dd->kind.payload.Enum.backingType, 0)
                                    : w->ir->tyInt(32);
                                if (bt == null || bt->kind != IrTypeKind::Int)
                                    bt = w->ir->tyInt(32);
                                u64 eval = 0;
                                if (muvEnumMemberConst(w, dd,
                                        s1->kind.payload.Expr.value.kind.payload.Ident.name,
                                        bt, &eval))
                                    return w->ir->constInt(bt, eval);
                            }
                        }
                    }
                }
            }
            /* `mod::CONST` / `mod::…::name`: module-qualified value —
             * a constant folds through its init expression, anything
             * else falls through to the final segment */
            NodeId mddecl = muvModuleMemberDecl(w, id);
            if (mddecl.index != 0)
            {
                Node* mdn = muvNode(w, mddecl);
                if (mdn->kind.tag == NodeKind::Decl)
                {
                    Decl* mdd = &mdn->kind.payload.Decl.value;
                    if (mdd->kind.tag == DeclKind::Constant)
                    {
                        NodeId init = mdd->kind.payload.Constant.value;
                        if (init.index != 0) return muvExpr(w, init);
                    }
                }
            }
            /* a value reference through a namespace resolves to its
             * final segment (a function becomes its address, a constant
             * folds, an enum/variant name reports and gets fixed when
             * the layout work lands) */
            return muvExpr(w, segs[sn - 1]);
        },
        
        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |
        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |
        ExprKind::Shl | ExprKind::Shr => {
            Expr* le = &muvNode(w, e->kind.payload.Add.left)->kind.payload.Expr.value;
            return muvBinaryArith(w, e->kind, e->kind.payload.Add.left,
                                 e->kind.payload.Add.right, id, le->resolvedType);
        },
        
        ExprKind::Eq | ExprKind::Ne | ExprKind::Lt | ExprKind::Le |
        ExprKind::Gt | ExprKind::Ge => {
            Expr* le = &muvNode(w, e->kind.payload.Eq.left)->kind.payload.Expr.value;
            return muvCompare(w, e->kind, e->kind.payload.Eq.left,
                             e->kind.payload.Eq.right, id, le->resolvedType);
        },
        
        ExprKind::And | ExprKind::Or => { return muvShortCircuit(w, e, id); },
        
        ExprKind::Neg => {
            IrValue* v = muvExpr(w, e->kind.payload.Neg.expr);
            if (v == null) return null;
            if (v != null && v->type != null && v->type->kind == IrTypeKind::Float)
                return muvV(w->b.fsub(w->ir->constInt(v->type, 0), v));
            return muvV(w->b.neg(v));
        },
        
        ExprKind::Not => {
            IrValue* v = muvExpr(w, e->kind.payload.Not.expr);
            if (v == null) return null;
            /* truth test: `!x` is `x == 0` for integers and pointers and
             * `x == 0.0` for floats — xor with 1 only flips an i1 and
             * miscompiles `!5` (and produced pointer-typed xors for rawptr
             * operands, which the short-circuit truthiness test then
             * compared against 1) */
            if (v->type != null && v->type->kind == IrTypeKind::Float)
                return muvV(w->b.fcmp(IrFCmpPred::Oeq, v, w->ir->constFloat(v->type, 0.0)));
            return muvV(w->b.icmp(IrICmpPred::Eq, v, w->ir->constInt(v->type, 0)));
        },
        
        ExprKind::BitNot => {
            IrValue* v = muvExpr(w, e->kind.payload.BitNot.expr);
            if (v == null) return null;
            return muvV(w->b.notOp(v));
        },
        
        ExprKind::AddressOf => {
            /* the address of an lvalue — locals, globals, and the same
             * field/index chains assignment accepts */
            return muvAddrOf(w, e->kind.payload.AddressOf.expr);
        },
        
        ExprKind::Deref => {
            IrValue* v = muvExpr(w, e->kind.payload.Deref.expr);
            if (v == null) return null;
            IrType* vt = muvTy(w, rt, 0);
            return muvV(w->b.load(vt, v));
        },
        
        ExprKind::Cast => {
            NodeId cin = e->kind.payload.Cast.expr;
            /* `(u64)V::Case` is the case's ordinal, not its aggregate
             * form — the C backend's cgVariantCaseIdx rule */
            {
                Decl* vcd = null;
                i32 vci = muvVariantCasePath(w, cin, &vcd);
                if (vci >= 0)
                {
                    Ty tgt0 = muvResolved(w, e->kind.payload.Cast.targetType);
                    IrType* dt0 = muvTy(w, tgt0, 0);
                    if (dt0 != null && dt0->kind == IrTypeKind::Int)
                        return w->ir->constInt(dt0, (u64)(u32)vci);
                }
            }
            IrValue* v = muvExpr(w, cin);
            if (v == null) return null;
            Ty tgt = muvResolved(w, e->kind.payload.Cast.targetType);
            IrType* dt = muvTy(w, tgt, 0);
            /* str/slice → pointer: the fat value's FIRST field is the
             * data address; bitcasting the {ptr,len} aggregate would
             * hand back the struct itself (C backend emits s.ptr). */
            {
                Node* cn = muvNode(w, cin);
                Ty sct = 0;
                if (cn != null && cn->kind.tag == NodeKind::Expr)
                    sct = muvResolved(w, cn->kind.payload.Expr.value.resolvedType);
                Ty sbt = sct;
                u32 sguard = 0;
                while (sbt != 0 && sguard < 8)
                {
                    TypeEntry* ste = w->ctx->types + sbt;
                    if (ste->kind.tag == TypeKind::Const) sbt = ste->kind.payload.Const.base;
                    else if (ste->kind.tag == TypeKind::Comptime) sbt = ste->kind.payload.Comptime.base;
                    else break;
                    sguard++;
                }
                Ty twt = tgt;
                u32 tguard = 0;
                while (twt != 0 && tguard < 8)
                {
                    TypeEntry* tte = w->ctx->types + twt;
                    if (tte->kind.tag == TypeKind::Const) twt = tte->kind.payload.Const.base;
                    else if (tte->kind.tag == TypeKind::Comptime) twt = tte->kind.payload.Comptime.base;
                    else break;
                    tguard++;
                }
                bool fat = sbt != 0 &&
                    ((w->ctx->types + sbt)->kind.tag == TypeKind::Str ||
                     (w->ctx->types + sbt)->kind.tag == TypeKind::Slice);
                bool toPtr = twt != 0 &&
                    ((w->ctx->types + twt)->kind.tag == TypeKind::Pointer ||
                     (w->ctx->types + twt)->kind.tag == TypeKind::Rawptr);
                if (fat && toPtr && v->type != null &&
                    v->type->kind == IrTypeKind::Struct && v->type->nparams > 0)
                {
                    IrValue* f0 = muvGepField(w, v, 0);
                    if (f0 == null) return null;
                    IrInst* li = w->b.load(v->type->params[0], f0);
                    muvSetDebugLoc(w, li, id);
                    return muvV(li);
                }
            }
            Expr* se = &muvNode(w, e->kind.payload.Cast.expr)->kind.payload.Expr.value;
            bool su = muvTyUnsigned(w, se->resolvedType);
            bool du = muvTyUnsigned(w, e->kind.payload.Cast.targetType);
            return muvCast(w, v, v->type, dt, su, du);
        },
        
        ExprKind::Sizeof => {
            IrType* st = muvTy(w, muvResolved(w, e->kind.payload.Sizeof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeSizeOf(st));
        },
        
        ExprKind::Alignof => {
            IrType* at = muvTy(w, muvResolved(w, e->kind.payload.Alignof.targetType), 0);
            return w->ir->constInt(w->ir->tyInt(64), (u64)w->ir->irTypeAlignOf(at));
        },
        
        ExprKind::TypeRef => {
            muvErr(w, id, "unresolved TypeRef");
            return null;
        },
        
        ExprKind::Typeof => {
            muvErr(w, id, "typeof not supported");
            return null;
        },
        
        ExprKind::Spread => {
            /* `...pack` only survives to lowering when comptime never
             * evaluated it — forward the inner expression */
            return muvExpr(w, e->kind.payload.Spread.expr);
        },
        
        ExprKind::StaticCall => {
            /* `Owner.method(args)` with no receiver: the method must be
             * static, symbol composed from the call site's own text */
            Str typeName = e->kind.payload.StaticCall.typeName;
            Str meth = e->kind.payload.StaticCall.method;
            NodeId mdef = muvFindMethodDeclOwner(w, typeName, meth);
            if (mdef.index == 0)
                { muvErr(w, id, "static method not found"); return null; }
            if (w->mono != null && w->mono->genericCount(mdef) != 0)
                { muvErr(w, id, "call to a generic method (Phase 2)"); return null; }
            if (muvMethodSelfKind(w, mdef) != 0)
                { muvErr(w, id, "instance method needs a receiver expression"); return null; }
            IrFunc* f = muvMethodShell(w, mdef, typeName, 0, meth, id, null);
            if (f == null) return null;
            u32 nargs = 0;
            bool fail = false;
            IrValue** args = muvBuildCallArgs(w, f, e->kind.payload.StaticCall.args,
                                             e->kind.payload.StaticCall.argsLen,
                                             null, false, &nargs, &fail,
                                             f->paramTypes, f->nparams);
            if (fail) return null;
            IrValue* res = muvV(w->b.call(&f->base, args, nargs));
            if (args != null) dealloc<IrValue*>(args);
            if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;
            return res;
        },
        
        ExprKind::BuiltinCall => {
            u32 bn = e->kind.payload.BuiltinCall.builtin;
            u32 implHash = 0;
            u32 implLen = 0;
            /* compile-time builtins (compileError / isFormatLiteral /
             * typeof) are consumed by sema and mono and never arrive. */
            if (!builtinImplHash(bn, &implHash, &implLen))
            {
                muvErr(w, id, "unsupported builtin call");
                return null;
            }
            /* @assertOut(cond) without a message is @assert(cond) */
            if (bn == BUILTIN_ASSERTOUT && e->kind.payload.BuiltinCall.argsLen < 2)
                builtinImplHash(BUILTIN_ASSERT, &implHash, &implLen);
            /* the tag only names the implementation; the backend resolves
             * it in the module tree and calls its resolved symbol */
            NodeId implId = muvFindDeclByHash(w, implHash, implLen);
            if (implId.index == 0)
            {
                muvErr(w, id, "the @-error builtins are not in this unit (import core::error)");
                return null;
            }
            IrFunc* impl = muvFnMapGet(w, implId.index);
            if (impl == null)
            {
                muvErr(w, id, "the @-error builtin implementation was not lowered");
                return null;
            }
            u32 nargs = 0;
            bool fail = false;
            IrValue** callArgs = muvBuildCallArgs(w, impl,
                e->kind.payload.BuiltinCall.args,
                e->kind.payload.BuiltinCall.argsLen, null, false, &nargs, &fail,
                impl->paramTypes, impl->nparams);
            if (fail) return null;
            IrValue* res = muvV(w->b.call(&impl->base, callArgs, nargs));
            if (callArgs != null) dealloc<IrValue*>(callArgs);
            if (impl->retType == null || impl->retType->kind == IrTypeKind::Void)
                return null;
            return res;
        },
        
        ExprKind::BlockExpr => {
            u32 scopeMark = w->locLen;
            NodeId* bstmts = e->kind.payload.BlockExpr.stmts;
            u32 bn = e->kind.payload.BlockExpr.stmtsLen;
            /* stmts mixes stmt nodes and bare expr nodes; `result`
             * aliases the LAST item, so evaluate [0,bn-1) for effect
             * and let the last item produce the value — evaluating
             * `result` again would run it twice. */
            u32 i = 0;
            while (i + 1 < bn && !w->term)
            {
                NodeId bi = bstmts[i];
                Node* bn2 = muvNode(w, bi);
                if (bn2 != null && bn2->kind.tag == NodeKind::Expr) muvExpr(w, bi);
                else stmt::muvStmt(w, bi);
                i++;
            }
            IrValue* res = null;
            if (bn == 0 || w->term) res = null;
            else
            {
                NodeId last = bstmts[bn - 1];
                Node* ln = muvNode(w, last);
                if (ln != null && ln->kind.tag == NodeKind::Expr)
                    res = muvExpr(w, last);
                else if (ln != null && ln->kind.tag == NodeKind::Stmt &&
                         ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)
                    res = muvExpr(w, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);
                else
                {
                    stmt::muvStmt(w, last);
                    res = null;
                }
            }
            if (res == null && !w->term)
            {
                IrType* vt = rt != 0 ? muvTy(w, rt, 0) : null;
                if (vt != null && vt->kind != IrTypeKind::Void &&
                    !muvIsAgg(vt)) res = w->ir->constInt(vt, 0);
            }
            w->locLen = scopeMark;
            return res;
        },
        
        ExprKind::IfExpr => {
            IrValue* c = muvCond(w, muvExpr(w, e->kind.payload.IfExpr.cond));
            if (c == null) return null;
            IrType* vt = rt != 0 ? muvTy(w, rt, 0) : null;
            bool hasVal = vt != null && vt->kind != IrTypeKind::Void;
            bool agg = hasVal && muvIsAgg(vt);
            IrValue* slot = !hasVal ? null :
                (agg ? muvAggSlot(w, vt) : muvV(w->b.alloca(vt)));
            if (hasVal && slot == null) return null;
            IrBlock* thenBb = muvBlock(w, "if.then");
            IrBlock* elseBb = muvBlock(w, "if.else");
            IrBlock* endBb = muvBlock(w, "if.end");
            w->b.condBr(c, thenBb, elseBb);
            muvSetBlock(w, thenBb);
            IrValue* tv = muvValBody(w, e->kind.payload.IfExpr.thenBody, vt);
            if (tv != null && slot != null) muvArmStore(w, tv, slot, vt);
            if (!w->term) w->b.br(endBb);
            muvSetBlock(w, elseBb);
            IrValue* fv = muvValBody(w, e->kind.payload.IfExpr.elseBody, vt);
            if (fv != null && slot != null) muvArmStore(w, fv, slot, vt);
            if (!w->term) w->b.br(endBb);
            muvSetBlock(w, endBb);
            if (!hasVal) return null;
            return agg ? slot : muvV(w->b.load(vt, slot));
        },
        
        ExprKind::SwitchExpr => {
            IrType* vt = rt != 0 ? muvTy(w, rt, 0) : null;
            if (vt == null || vt->kind == IrTypeKind::Void)
                { muvErr(w, id, "switch expression without a result type"); return null; }
            bool agg = muvIsAgg(vt);
            IrValue* slot = agg ? muvAggSlot(w, vt) : muvV(w->b.alloca(vt));
            if (slot == null) return null;
            stmt::muvSwitchCore(w, e->kind.payload.SwitchExpr.expr,
                         e->kind.payload.SwitchExpr.cases,
                         e->kind.payload.SwitchExpr.casesLen, id, slot, vt);
            return agg ? slot : muvV(w->b.load(vt, slot));
        },
        
        else => {
            muvErr(w, id, "unsupported expression (Phase 1)");
            return null;
        },
    }
}
