#[[no_drop_all]]
/* coral-ir/wallvm.crl — wallvm backend entry point
 *
 * generateWallVm: analyzed AST → wallvm IR → pipeline → asm. Mirrors
 * generateC's shape but builds IR directly (no text streams). Phase 1:
 * one collection pass that mangles each symbol exactly once, detects
 * raw-name collisions at compile time, declares IrFunc shells (externs
 * + definitions), then lowers definition bodies. */
use lower { Wv, WallVmResult, WvNameEnt, WvNames, wvNode, wvErr, wvStr, wvResolved,
               wvPushLocal, wvBlock, wvSetBlock, wvTerm, wvPos, wvFnMapInit, wvFnMapPut,
               wvTyMapInit, wvTdMapInit, wvGMapInit, wvHashStr, wvNamesInit, wvNamesFind,
               wvNamesInsert, wvTypeInstanceName };
use types { wvTy, wvDeclTy, wvTyHasParam, wvTypeInstanceTy, wvFindTypeDecl };
use decl { wvMangle, wvMangleExempt, wvDeclareMethod, wvMethodSelfKind,
               wvOwnerStr, wvMethodMangle, wvMethodMangleEx, wvDeclareInstanceFunc,
               wvInstanceSymbol };
use stmt { wvStmt, wvDropsBranch, wvDefersBranch };
use expr { wvExpr, wvAggSlot, wvIsAgg, wvMakeGlobal, wvUnwrapTy, wvSelfTyMatches, wvV };
use context::context { AstContext, InternEntry };
use build::arena { Arena };
use mono::mono { MonoContext, MonoInstance, MonoInstanceKind, MonoSubstitution };
use diag::code { ErrorCode };
use sem::sema { Sema };
use ast {
    id { Str, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param, ATTR_FREESTANDING }
};
use common::slice { Slice };
import wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrValue, IrValueKind, IrType, IrTypeKind, irCtxCreate, irCtxDestroy };
import wallvm::irOps { IrICmpPred };
import wallvm::irBuilder { IrBuilder };
import wallvm::irPrinter { IrPrinter };
import wallvm::passes::validate { IrValidator };
import wallvm::wallvm { irCompileAsm, gUnrollEnabled, gSafetyChecks, gSafetyAllLevels };
import wallvm::rules::asm_rules { CallingConvention };
import platform::libc { printf };
import std::mman { alloc, dealloc };
import std::string { String };

/* ── opt-level mapping (mirror of runGcc's C flags) ─────────── */

u32 wvOptLevel(str opt)
{
    if (opt.len == 7 && opt.ptr[0] == 114) return 2; // "release" (-O2)
    if (opt.len == 4 && opt.ptr[0] == 115) return 1; // "size"
    if (opt.len == 2 && opt.ptr[0] == 79 && opt.ptr[1] == 49) return 1; // "O1"
    if (opt.len == 2 && opt.ptr[0] == 79) return 3;  // "O3"
    return 0; // debug
}

/* a type-named decl that owns methods (mirrors the C backend's
 * cgEmitMethodSet set: struct/union/variant bodies plus the two
 * extension forms) */
bool wvIsOwnerDecl(Decl* d)
{
    return d->kind.tag == DeclKind::Struct || d->kind.tag == DeclKind::Union ||
           d->kind.tag == DeclKind::Variant || d->kind.tag == DeclKind::Extend ||
           d->kind.tag == DeclKind::ExtendTrait;
}

/* is this file-scope constant a type alias (`const c2 = cchar`)? The
 * value is a bare identifier naming a type decl: no storage, and uses
 * resolve through the type system (the C backend spells a typedef;
 * here every use site's Named type carries the name directly). */
bool wvConstIsTypeAlias(Wv* w, NodeId declId)
{
    Node* n = wvNode(w, declId);
    if (n->kind.tag != NodeKind::Decl) return false;
    Decl* dd = &n->kind.payload.Decl.value;
    if (dd->kind.tag != DeclKind::Constant) return false;
    NodeId v = dd->kind.payload.Constant.value;
    if (v.index == 0) return false;
    Node* vn = wvNode(w, v);
    if (vn->kind.tag != NodeKind::Expr ||
        vn->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;
    return wvFindTypeDecl(w, vn->kind.payload.Expr.value.kind.payload.Ident.name).index != 0;
}

/* the methods[] array and owner shape of such a decl; false when the
 * owner is generic (Phase 2 — mono does not reach methods yet) */
bool wvOwnerMethods(Wv* w, Decl* d, Str* owner, NodeId** methodsOut, u32* mlenOut,
                    IrType** selfPtOut)
{
    *owner = 0;
    *methodsOut = null;
    *mlenOut = 0;
    *selfPtOut = null;
    if (d->kind.tag == DeclKind::Struct || d->kind.tag == DeclKind::Union ||
        d->kind.tag == DeclKind::Variant)
    {
        NodeId* methods = null;
        u32 mlen = 0;
        if (d->kind.tag == DeclKind::Struct)
        {
            if (d->kind.payload.Struct.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Struct.name;
            methods = d->kind.payload.Struct.methods;
            mlen = d->kind.payload.Struct.methodsLen;
        }
        else if (d->kind.tag == DeclKind::Union)
        {
            if (d->kind.payload.Union.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Union.name;
            methods = d->kind.payload.Union.methods;
            mlen = d->kind.payload.Union.methodsLen;
        }
        else
        {
            if (d->kind.payload.Variant.genericParamsLen != 0) return false;
            *owner = d->kind.payload.Variant.name;
            methods = d->kind.payload.Variant.methods;
            mlen = d->kind.payload.Variant.methodsLen;
        }
        *selfPtOut = w->ir->tyPtr(wvDeclTy(w, d, 0));
        *methodsOut = methods;
        *mlenOut = mlen;
        return mlen > 0;
    }
    Ty st = 0;
    if (d->kind.tag == DeclKind::Extend)
    {
        if (d->kind.payload.Extend.genericParamsLen != 0) return false;
        st = d->kind.payload.Extend.selfType;
        *methodsOut = d->kind.payload.Extend.methods;
        *mlenOut = d->kind.payload.Extend.methodsLen;
    }
    else if (d->kind.tag == DeclKind::ExtendTrait)
    {
        if (d->kind.payload.ExtendTrait.genericParamsLen != 0) return false;
        st = d->kind.payload.ExtendTrait.selfType;
        *methodsOut = d->kind.payload.ExtendTrait.methods;
        *mlenOut = d->kind.payload.ExtendTrait.methodsLen;
    }
    else return false;
    if (st == 0 || wvTyHasParam(w, st, 0)) return false;
    *owner = wvOwnerStr(w, st);
    Ty u = wvUnwrapTy(w, st);
    TypeEntry* ue = w->ctx->types + u;
    if (ue->kind.tag == TypeKind::Pointer)
    {
        u = wvUnwrapTy(w, ue->kind.payload.Pointer.base);
        if (u == 0) return false;
    }
    *selfPtOut = w->ir->tyPtr(wvTy(w, u, 0));
    return *mlenOut > 0;
}

/* lower one function body. hasSelf says the shell was declared with a
 * receiver as parameter 0 (only the method-collection path does that —
 * plain file functions never take one). body is the node to lower: the
 * decl's own, or a monomorphisation instance's rewritten body when inst
 * is non-null (its substitutions are the caller's responsibility). */
void wvLowerBody(Wv* w, NodeId declId, Decl* d, IrFunc* f, u8 hasSelf, NodeId body, MonoInstance* inst)
{
    w->fn = f;
    w->retTy = d->kind.payload.Func.returnType;
    w->locLen = 0;
    w->term = false;
    w->breakT = null;
    w->contT = null;
    w->loopDepth = 0;
    w->dropLen = 0;
    w->fnDropMark = 0;
    w->contDropMark = 0;
    w->breakDropMark = 0;
    w->deferLen = 0;
    w->fnDeferMark = 0;
    w->contDeferMark = 0;
    w->breakDeferMark = 0;

    IrBlock* entry = wvBlock(w, "");
    wvSetBlock(w, entry);

    /* a method's receiver: parameter 0 of the shell, never spelled in
     * the Coral param list (the parser rejects explicit `self`) */
    u32 pi = 0;
    if (hasSelf != 0 && f->nparams > 0)
    {
        pi = 1;
        IrType* st = f->paramTypes[0];
        IrValue* av = alloc<IrValue>((usize)1);
        if (av == null) { wvErr(w, declId, "out of memory binding self"); return; }
        *av = IrValue { IrValueKind::Arg, st, w->ir->nextValueId(), 0,
                        wvStr(w, w->ctx->tyIdxSelfLit2()), null, 0, 0 };
        f->addArg(av);
        if (st != null && st->kind != IrTypeKind::Void)
        {
            IrValue* slot = wvIsAgg(st) ? wvAggSlot(w, st) : wvV(w->b.alloca(st));
            if (slot != null)
            {
                w->b.store(av, slot);
                wvPushLocal(w, w->ctx->tyIdxSelfLit2(), slot, 0);
            }
        }
    }

    /* bind params: create arg values, alloca slots, store args in.
     * The type comes from the shell's own signature (f->paramTypes), so
     * binding can never drift from what the call site was given. */
    u32 np = d->kind.payload.Func.paramsLen;
    u32 i = 0;
    while (i < np)
    {
        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);
        if (pn->kind.tag == NodeKind::Param)
        {
            Param* pp = &pn->kind.payload.Param.value;
            if ((pp->flags & 16) == 0) // not variadic
            {
                IrType* at = pi < f->nparams ? f->paramTypes[pi] : wvTy(w, pp->typeNode, 0);
                pi++;
                IrValue* av = alloc<IrValue>((usize)1);
                if (av == null) { wvErr(w, declId, "out of memory binding param"); return; }
                *av = IrValue { IrValueKind::Arg, at, w->ir->nextValueId(), 0,
                                wvStr(w, pp->name), null, 0, 0 };
                f->addArg(av);
                if (at != null && at->kind != IrTypeKind::Void)
                {
                    IrValue* slot = wvIsAgg(at) ? wvAggSlot(w, at) : wvV(w->b.alloca(at));
                    if (slot != null)
                    {
                        w->b.store(av, slot);
                        wvPushLocal(w, pp->name, slot, wvResolved(w, pp->typeNode));
                    }
                }
            }
        }
        i++;
    }

    /* an instance whose vararg slot was specialized: the rewritten body
     * references the tail args by their synthesized names (_varg0, …) */
    if (inst != null && inst->tailLen > 0 && inst->tailArgNames != null)
    {
        u32 k = 0;
        while (k < inst->tailLen && pi < f->nparams)
        {
            IrType* at = f->paramTypes[pi];
            pi++;
            IrValue* av = alloc<IrValue>((usize)1);
            if (av == null) { wvErr(w, declId, "out of memory binding tail arg"); return; }
            Str tn = inst->tailArgNames[k];
            *av = IrValue { IrValueKind::Arg, at, w->ir->nextValueId(), 0,
                            wvStr(w, tn), null, 0, 0 };
            f->addArg(av);
            if (at != null && at->kind != IrTypeKind::Void)
            {
                IrValue* slot = wvIsAgg(at) ? wvAggSlot(w, at) : wvV(w->b.alloca(at));
                if (slot != null)
                {
                    w->b.store(av, slot);
                    wvPushLocal(w, tn, slot, 0);
                }
            }
            k++;
        }
    }

    /* lower the body block */
    wvStmt(w, body);

    /* implicit terminator on fallthrough */
    if (!w->term)
    {
        wvDefersBranch(w, w->fnDeferMark);
        wvDropsBranch(w, w->fnDropMark, -1);
        IrType* rt = wvTy(w, wvResolved(w, w->retTy), 0);
        if (rt == null || rt->kind == IrTypeKind::Void) w->b.retVoid();
        else w->b.ret(w->ir->constInt(rt, 0));
        wvTerm(w);
    }
}

/* claim a symbol for a function shell under an already-composed name:
 * dedup against the name table (extern/definition of one symbol bind
 * together, two definitions are an error), register the IrFunc for
 * call sites, add it to the module-> selfTy, when non-null, is the
 * method receiver prepended as parameter 0. `names` may be null for a
 * bare on-demand declaration (the fn map still dedups per declId). */
IrFunc* wvRegisterFunc(Wv* w, WvNames* names, NodeId declId, Decl* d, str name, IrType* selfTy)
{
    bool isExtern = (d->kind.payload.Func.flags & 2) != 0;
    bool isDefn = (d->kind.payload.Func.flags & 8) != 0 && !isExtern;

    WvNameEnt* ent = null;
    if (names != null && name.len != 0) ent = wvNamesFind(names, name);
    if (ent != null)
    {
        /* two definitions of the same final name = error */
        if (ent->isDefn && isDefn)
        {
            w->errors++;
            w->sema->semaErrorNode(ErrorCode::CodegenInternal, declId,
                "duplicate definition of unmangled symbol (no_mangle/extern collision)");
            return null;
        }
        /* existing definition + new extern: calls to the extern bind to
         * the definition's symbol */
        if (ent->isDefn && !isDefn)
        {
            wvFnMapPut(w, declId.index, ent->f);
            return null;
        }
        /* existing extern + new definition: promote the shell to a
         * definition (the provide-an-implementation pattern) */
        if (!ent->isDefn && isDefn)
        {
            ent->isDefn = true;
            ent->f->isExtern = false;
            wvFnMapPut(w, declId.index, ent->f);
            return ent->f;
        }
        /* two externs of the same name: dedup, bind to the first */
        wvFnMapPut(w, declId.index, ent->f);
        return null;
    }

    /* new name: declare the shell, claim the slot, register for calls */
    IrFunc* f = wvDeclareMethod(w, declId, d, name, selfTy);
    if (f == null) return null;
    w->module->addFunc(f);
    if (names != null && name.len != 0)
    {
        /* key from the IrFunc's own copy: wvTy inside the declare may
         * have rewritten `name`'s view into w->mb (instance-typed
         * signatures go through wvTypeInstanceName) */
        ent = wvNamesInsert(names, f->base.name);
        if (ent != null)
        {
            ent->name = f->base.name;
            ent->declIdx = declId.index;
            ent->isDefn = isDefn;
            ent->f = f;
        }
    }
    wvFnMapPut(w, declId.index, f);
    return isDefn ? f : null;
}

/* declare + collect one function decl; returns the IrFunc for the
 * definition (or null for extern-only / generic / collision-skipped) */
IrFunc* wvCollectFunc(Wv* w, WvNames* names, NodeId declId, Decl* d)
{
    /* skip generics (Phase 2) */
    if (w->mono != null && w->mono->genericCount(declId) != 0) return null;

    str name = wvMangle(w, declId, d->kind.payload.Func.name);
    return wvRegisterFunc(w, names, declId, d, name, null);
}

/* one entry of the monomorphised body queue: the shell, the decl whose
 * params it binds, the body node, the mono instance supplying the
 * substitutions while lowering, and whether the shell carries a receiver
 * as parameter 0. FunctionInstance entries pass the instance's rewritten
 * body; instance-method entries pass the method's own body. */
struct WvBodyEnt
{
    IrFunc* f;
    NodeId decl;
    NodeId body;
    u32 inst;
    u8 self;
}

/* declare + queue one instance method under the instance-composed
 * `<owner>_<method>` symbol (mirror cgEmitInstMethodList). Never
 * wvRegisterFunc: mdef is shared by every instance of the type, so the
 * names table — keyed by the composed symbol, deduping alias-equal
 * instances — is the only binding, and the fn map must not answer for
 * it. Signature building runs with the instance's substitutions active. */
void wvQueueInstMethod(Wv* w, NodeId mdef, Decl* md, Str iown, IrType* selfPt,
                       MonoInstance* inst, u32 ii, WvBodyEnt* ents, u32* qlen, u32 qcap)
{
    str msym = wvMethodMangleEx(w, mdef, iown, 0, inst->arguments,
                                inst->argumentsLen, md->kind.payload.Func.name);
    if (msym.len == 0)
    {
        wvErr(w, mdef, "cannot compose the instance method symbol");
        return;
    }
    if (w->names != null && wvNamesFind(w->names, msym) != null) return;
    u8 sk = wvMethodSelfKind(w, mdef);
    u8 flags = md->kind.payload.Func.flags;
    MonoSubstitution* oldS = w->subs;
    u32 oldSL = w->subsLen;
    w->subs = inst->substitutions;
    w->subsLen = inst->substitutionsLen;
    IrFunc* f = wvDeclareMethod(w, mdef, md, msym, sk == 1 ? selfPt : null);
    w->subs = oldS;
    w->subsLen = oldSL;
    if (f == null) return;
    w->module->addFunc(f);
    if (w->names != null)
    {
        /* key from the IrFunc's own copy: `msym` is a view into w->mb,
         * which the signature's instance types just rewrote */
        WvNameEnt* ent = wvNamesInsert(w->names, f->base.name);
        if (ent != null)
        {
            ent->name = f->base.name;
            ent->declIdx = mdef.index;
            ent->isDefn = (flags & 8) != 0 && (flags & 2) == 0;
            ent->f = f;
        }
    }
    if ((flags & 8) != 0 && (flags & 2) == 0 && ents != null && qlen != null && *qlen < qcap)
    {
        ents[*qlen] = WvBodyEnt { .f = f, .decl = mdef,
                                  .body = md->kind.payload.Func.body,
                                  .inst = ii, .self = sk == 1 ? 1 : 0 };
        *qlen = *qlen + 1;
    }
}

/* one owner's method list through the instance queue: non-generic
 * methods only (own generics stay Phase 2), like cgEmitInstMethodList */
void wvQueueInstMethods(Wv* w, NodeId* methods, u32 mlen, Str iown, IrType* selfPt,
                        MonoInstance* inst, u32 ii, WvBodyEnt* ents, u32* qlen, u32 qcap)
{
    if (methods == null) return;
    u32 k = 0;
    while (k < mlen)
    {
        NodeId mdef = methods[k];
        Node* mn = wvNode(w, mdef);
        if (mn->kind.tag == NodeKind::Decl)
        {
            Decl* md = &mn->kind.payload.Decl.value;
            if (md->kind.tag == DeclKind::Func &&
                (w->mono == null || w->mono->genericCount(mdef) == 0))
                wvQueueInstMethod(w, mdef, md, iown, selfPt, inst, ii, ents, qlen, qcap);
        }
        k++;
    }
}

pub WallVmResult generateWallVm(AstContext* ctx, File* file, MonoContext* mono, Arena* arena, str opt, i32 safetyMode, bool wantIr)
{
    WallVmResult result;
    result.asmText = Slice::from(null, 0);
    result.irText = Slice::from(null, 0);
    result.errors = 0;

    // unrolling is O3-only — B4a/B4b (teardown ghosts, doubled exit
    // preds) fixed; lower levels keep the pass out of their pipelines
    gUnrollEnabled = wvOptLevel(opt) == 3;
    /* safety pass: auto (O0 on, O1+ off) unless --safety/--no-safety;
     * freestanding units have no runtime error machinery, so never run it */
    bool freestanding = file != null && (file->attrBits & ATTR_FREESTANDING) != 0;
    gSafetyChecks = !freestanding && safetyMode != 0;
    gSafetyAllLevels = !freestanding && safetyMode == 1;

    Wv w;
    w.ctx = ctx;
    w.file = file;
    w.mono = mono;
    w.arena = arena;
    w.sema = null;
    if (mono != null) w.sema = mono->sema;
    w.errors = 0;
    w.locNames = null;
    w.locSlots = null;
    w.locTys = null;
    w.locLen = 0;
    w.locCap = 0;
    w.fn = null;
    w.block = null;
    w.term = false;
    w.retTy = 0;
    w.breakT = null;
    w.contT = null;
    w.loopDepth = 0;
    w.drops = null;
    w.dropLen = 0;
    w.dropCap = 0;
    w.fnDropMark = 0;
    w.contDropMark = 0;
    w.breakDropMark = 0;
    w.defers = null;
    w.deferLen = 0;
    w.deferCap = 0;
    w.fnDeferMark = 0;
    w.contDeferMark = 0;
    w.breakDeferMark = 0;
    w.mb = String::new();
    w.fnKeys = null;
    w.fnVals = null;
    w.fnCap = 0;
    w.gKeys = null;
    w.gVals = null;
    w.gCap = 0;
    w.subs = null;
    w.subsLen = 0;
    w.instFns = null;
    w.instFnsLen = 0;
    w.tyKeys = null;
    w.tyVals = null;
    w.tyBusy = null;
    w.tyCap = 0;
    w.tdKeys = null;
    w.tdVals = null;
    w.tdCap = 0;

    w.ir = irCtxCreate();
    if (w.ir == null) { result.errors = 1; return result; }
    w.module = w.ir->createModule("coral");
    w.b = IrBuilder::new(w.ir);
    wvFnMapInit(&w, 1024);
    wvGMapInit(&w, 256);
    wvTyMapInit(&w, 4096);
    wvTdMapInit(&w, 4096);

    WvNames names;
    wvNamesInit(&names, 1024);
    w.names = &names;
    w.instTys = null;
    w.instTysLen = 0;
    if (mono != null && mono->instancesLen > 0)
    {
        w.instTysLen = mono->instancesLen;
        w.instTys = alloc<IrType*>((usize)mono->instancesLen);
        if (w.instTys != null)
        {
            u32 zi = 0;
            while (zi < w.instTysLen) { w.instTys[zi] = null; zi++; }
        }
        else w.instTysLen = 0;
    }
    /* build every type instance's IrType up front: method shells and
     * concrete extends resolve field/parameter types through these
     * while collecting, before any body is lowered */
    if (w.instTys != null)
    {
        u32 pj = 0;
        while (pj < w.instTysLen)
        {
            MonoInstance* pinst = mono->instances + pj;
            if (pinst->kind == MonoInstanceKind::TypeInstance)
                wvTypeInstanceTy(&w, pinst->name, pinst->arguments,
                                 pinst->argumentsLen, 0);
            pj++;
        }
    }

    /* collect + declare every function (externs + non-generic defs) */
    IrFunc** bodies = null;
    NodeId* bodyDecls = null;
    u8* bodySelf = null;   // 1 when the shell carries a receiver param 0
    u32 bodiesLen = 0;
    u32 bodiesCap = file->declsLen + 64;
    /* methods ride the same body list: size for every owner's method
     * array up front so the collection loop never has to grow it */
    u32 instMethodCap = 0;
    {
        u32 ci = 0;
        while (ci < file->declsLen)
        {
            Node* cn = wvNode(&w, file->decls[ci]);
            if (cn->kind.tag == NodeKind::Decl && wvIsOwnerDecl(&cn->kind.payload.Decl.value))
            {
                Decl* cd = &cn->kind.payload.Decl.value;
                if (cd->kind.tag == DeclKind::Struct) bodiesCap += cd->kind.payload.Struct.methodsLen;
                else if (cd->kind.tag == DeclKind::Union) bodiesCap += cd->kind.payload.Union.methodsLen;
                else if (cd->kind.tag == DeclKind::Variant) bodiesCap += cd->kind.payload.Variant.methodsLen;
                else if (cd->kind.tag == DeclKind::Extend) bodiesCap += cd->kind.payload.Extend.methodsLen;
                else bodiesCap += cd->kind.payload.ExtendTrait.methodsLen;
            }
            ci++;
        }
        /* instance methods queue too: each TypeInstance's own methods
         * plus every matching extend (over-count of skipped externs and
         * own-generic methods is safe — the queue bounds-checks) */
        if (mono != null && mono->instancesLen > 0)
        {
            u32 pj = 0;
            while (pj < mono->instancesLen)
            {
                MonoInstance* pinst = mono->instances + pj;
                if (pinst->kind == MonoInstanceKind::TypeInstance)
                {
                    Node* pn = wvNode(&w, pinst->declaration);
                    if (pn->kind.tag == NodeKind::Decl)
                    {
                        Decl* pd = &pn->kind.payload.Decl.value;
                        if (pd->kind.tag == DeclKind::Struct) instMethodCap += pd->kind.payload.Struct.methodsLen;
                        else if (pd->kind.tag == DeclKind::Union) instMethodCap += pd->kind.payload.Union.methodsLen;
                        else if (pd->kind.tag == DeclKind::Variant) instMethodCap += pd->kind.payload.Variant.methodsLen;
                    }
                    u32 d = 0;
                    while (d < file->declsLen)
                    {
                        Node* dn = wvNode(&w, file->decls[d]);
                        if (dn->kind.tag == NodeKind::Decl)
                        {
                            Decl* xd = &dn->kind.payload.Decl.value;
                            if (xd->kind.tag == DeclKind::Extend &&
                                wvSelfTyMatches(&w, xd->kind.payload.Extend.selfType,
                                                pinst->name, pinst->arguments, pinst->argumentsLen))
                                instMethodCap += xd->kind.payload.Extend.methodsLen;
                            else if (xd->kind.tag == DeclKind::ExtendTrait &&
                                     wvSelfTyMatches(&w, xd->kind.payload.ExtendTrait.selfType,
                                                     pinst->name, pinst->arguments, pinst->argumentsLen))
                                instMethodCap += xd->kind.payload.ExtendTrait.methodsLen;
                        }
                        d++;
                    }
                }
                pj++;
            }
        }
    }
    if (bodiesCap > 0)
    {
        bodies = alloc<IrFunc*>((usize)bodiesCap);
        bodyDecls = alloc<NodeId>((usize)bodiesCap);
        bodySelf = alloc<u8>((usize)bodiesCap);
        if (bodySelf != null)
        {
            u32 zi = 0;
            while (zi < bodiesCap) { bodySelf[zi] = 0; zi++; }
        }
    }
    u32 i = 0;
    while (i < file->declsLen)
    {
        NodeId did = file->decls[i];
        Node* n = wvNode(&w, did);
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* d = &n->kind.payload.Decl.value;
            if (d->kind.tag == DeclKind::Func)
            {
                IrFunc* f = wvCollectFunc(&w, &names, did, d);
                if (f != null && bodiesLen < bodiesCap)
                {
                    bodies[bodiesLen] = f;
                    bodyDecls[bodiesLen] = did;
                    bodiesLen++;
                }
            }
            else if (d->kind.tag == DeclKind::Constant && !wvConstIsTypeAlias(&w, did))
            {
                /* every file-scope constant gets one copy of storage —
                 * aggregates are addressed through it, scalars may still
                 * fold into their uses instead of being read back */
                u8 cf = d->kind.payload.Constant.flags;
                wvMakeGlobal(&w, did, d->kind.payload.Constant.name,
                             wvResolved(&w, d->kind.payload.Constant.typeNode),
                             d->kind.payload.Constant.value,
                             (cf & 16) != 0, (cf & 2) != 0, 0);
            }
            else if (wvIsOwnerDecl(d))
            {
                /* every method of a type-named decl: its symbol composes
                 * `owner_method`, and an implicit receiver becomes
                 * parameter 0 of the shell (bind in wvLowerBody) */
                Str owner = 0;
                NodeId* methods = null;
                u32 mlen = 0;
                IrType* selfPt = null;
                if (wvOwnerMethods(&w, d, &owner, &methods, &mlen, &selfPt))
                {
                    u32 mi = 0;
                    while (mi < mlen)
                    {
                        NodeId mdef = methods[mi];
                        Node* mn = wvNode(&w, mdef);
                        if (mn->kind.tag == NodeKind::Decl)
                        {
                            Decl* md = &mn->kind.payload.Decl.value;
                            if (md->kind.tag == DeclKind::Func &&
                                (w.mono == null || w.mono->genericCount(mdef) == 0))
                            {
                                u8 sk = wvMethodSelfKind(&w, mdef);
                                str msym = wvMethodMangle(&w, mdef, owner, md->kind.payload.Func.name);
                                IrFunc* f = wvRegisterFunc(&w, &names, mdef, md, msym,
                                                           sk == 1 ? selfPt : null);
                                if (f != null && bodiesLen < bodiesCap)
                                {
                                    bodies[bodiesLen] = f;
                                    bodyDecls[bodiesLen] = mdef;
                                    bodySelf[bodiesLen] = (sk == 1 && selfPt != null) ? 1 : 0;
                                    bodiesLen++;
                                }
                            }
                        }
                        mi++;
                    }
                }
            }
        }
        i++;
    }

    /* declare every collected function instance under its own symbol —
     * call resolution runs during body lowering and picks through
     * w.instFns, so this must precede both lowering loops */
    WvBodyEnt* iEnts = null;
    u32 iBodiesLen = 0;
    u32 iQCap = 0;
    if (mono != null && mono->instancesLen > 0)
    {
        u32 icap = mono->instancesLen;
        iQCap = icap + instMethodCap;
        w.instFns = alloc<IrFunc*>((usize)icap);
        iEnts = alloc<WvBodyEnt>((usize)iQCap);
        if (w.instFns != null)
        {
            w.instFnsLen = icap;
            u32 zi = 0;
            while (zi < icap) { w.instFns[zi] = null; zi++; }
        }
        u32 ii = 0;
        while (ii < icap)
        {
            MonoInstance* inst = mono->instances + ii;
            if (inst->kind == MonoInstanceKind::FunctionInstance && inst->body.index != 0 &&
                w.instFns != null && iEnts != null)
            {
                Node* dn = wvNode(&w, inst->declaration);
                if (dn->kind.tag == NodeKind::Decl)
                {
                    Decl* dd = &dn->kind.payload.Decl.value;
                    if (dd->kind.tag == DeclKind::Func)
                    {
                        str isym = wvInstanceSymbol(&w, inst, ii);
                        if (isym.len == 0)
                        {
                            w.errors++;
                            w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                 "cannot compose the function instance symbol");
                        }
                        else if (wvNamesFind(&names, isym) != null)
                        {
                            w.errors++;
                            w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                 "duplicate function instance symbol");
                        }
                        else
                        {
                            IrFunc* f = wvDeclareInstanceFunc(&w, inst, isym);
                            if (f == null)
                            {
                                w.errors++;
                                w.sema->semaErrorNode(ErrorCode::CodegenInternal, inst->declaration,
                                                     "cannot declare the function instance");
                            }
                            else
                            {
                                w.module->addFunc(f);
                                /* key from the IrFunc's own copy: isym is
                                 * a view into w->mb, which the instance's
                                 * substituted signature just rewrote */
                                WvNameEnt* ent = wvNamesInsert(&names, f->base.name);
                                if (ent != null)
                                {
                                    ent->name = f->base.name;
                                    ent->declIdx = inst->declaration.index;
                                    ent->isDefn = true;
                                    ent->f = f;
                                }
                                w.instFns[ii] = f;
                                iEnts[iBodiesLen] = WvBodyEnt { .f = f,
                                                                .decl = inst->declaration,
                                                                .body = inst->body,
                                                                .inst = ii, .self = 0 };
                                iBodiesLen++;
                            }
                        }
                    }
                }
            }
            ii++;
        }

        /* instance methods: each TypeInstance's own methods plus every
         * matching extend, under the instance-composed owner (mirror
         * cgEmitInstanceMethods); bodies ride the same queue with the
         * instance's substitutions active while lowering */
        ii = 0;
        while (ii < mono->instancesLen)
        {
            MonoInstance* inst = mono->instances + ii;
            if (inst->kind == MonoInstanceKind::TypeInstance && iEnts != null)
            {
                if (w.instTys == null || ii >= w.instTysLen || w.instTys[ii] == null)
                    wvErr(&w, inst->declaration, "cannot build the instance type for its methods");
                else
                {
                    Str iown = wvTypeInstanceName(&w, inst->name, inst->arguments,
                                                  inst->argumentsLen);
                    IrType* selfPt = w.ir->tyPtr(w.instTys[ii]);
                    Node* pn = wvNode(&w, inst->declaration);
                    if (pn->kind.tag == NodeKind::Decl)
                    {
                        Decl* pd = &pn->kind.payload.Decl.value;
                        NodeId* im = null;
                        u32 iml = 0;
                        if (pd->kind.tag == DeclKind::Struct)
                            { im = pd->kind.payload.Struct.methods; iml = pd->kind.payload.Struct.methodsLen; }
                        else if (pd->kind.tag == DeclKind::Union)
                            { im = pd->kind.payload.Union.methods; iml = pd->kind.payload.Union.methodsLen; }
                        else if (pd->kind.tag == DeclKind::Variant)
                            { im = pd->kind.payload.Variant.methods; iml = pd->kind.payload.Variant.methodsLen; }
                        wvQueueInstMethods(&w, im, iml, iown, selfPt, inst, ii,
                                           iEnts, &iBodiesLen, iQCap);
                    }
                    u32 d = 0;
                    while (d < file->declsLen)
                    {
                        Node* dn2 = wvNode(&w, file->decls[d]);
                        if (dn2->kind.tag == NodeKind::Decl)
                        {
                            Decl* xd = &dn2->kind.payload.Decl.value;
                            NodeId* em = null;
                            u32 eml = 0;
                            if (xd->kind.tag == DeclKind::Extend &&
                                wvSelfTyMatches(&w, xd->kind.payload.Extend.selfType,
                                                inst->name, inst->arguments, inst->argumentsLen))
                                { em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen; }
                            else if (xd->kind.tag == DeclKind::ExtendTrait &&
                                     wvSelfTyMatches(&w, xd->kind.payload.ExtendTrait.selfType,
                                                     inst->name, inst->arguments, inst->argumentsLen))
                                { em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen; }
                            wvQueueInstMethods(&w, em, eml, iown, selfPt, inst, ii,
                                               iEnts, &iBodiesLen, iQCap);
                        }
                        d++;
                    }
                }
            }
            ii++;
        }
    }

    /* lower definition bodies */
    i = 0;
    while (i < bodiesLen && w.errors == 0)
    {
        Node* n = wvNode(&w, bodyDecls[i]);
        Decl* d = &n->kind.payload.Decl.value;
        wvLowerBody(&w, bodyDecls[i], d, bodies[i], bodySelf != null ? bodySelf[i] : 0,
                    d->kind.payload.Func.body, null);
        i++;
    }

    /* lower monomorphised instance bodies (function instances and
     * instance methods) with their substitutions active */
    i = 0;
    while (i < iBodiesLen && w.errors == 0)
    {
        WvBodyEnt* ent = iEnts + i;
        MonoInstance* inst = mono->instances + ent->inst;
        Node* n = wvNode(&w, ent->decl);
        if (n->kind.tag == NodeKind::Decl)
        {
            Decl* d = &n->kind.payload.Decl.value;
            MonoSubstitution* oldS = w.subs;
            u32 oldSL = w.subsLen;
            w.subs = inst->substitutions;
            w.subsLen = inst->substitutionsLen;
            wvLowerBody(&w, ent->decl, d, ent->f, ent->self, ent->body, inst);
            w.subs = oldS;
            w.subsLen = oldSL;
        }
        i++;
    }
    if (iEnts != null) dealloc<WvBodyEnt>(iEnts);

    /* validate every function in the module */
    if (w.errors == 0)
    {
        IrValidator v = IrValidator::new(w.ir);
        u32 fi = 0;
        while (fi < w.module->nfuncs)
        {
            IrFunc* f = w.module->funcs[fi];
            if (f != null && !f->isExtern && !v.validateFunc(f))
            {
                w.errors++;
                printf(C"error: IR validation failed in %.*s: %.*s\n",
                       (i32)f->base.name.len, (const cchar*)f->base.name.ptr,
                       (i32)v.lastError.len, (const cchar*)v.lastError.ptr);
            }
            fi++;
        }
    }

    /* optional IR dump (--emit-ir): print before asm so a failed
     * compileAsm still leaves inspectable IR — also on validation
     * failure, which is exactly when inspection matters most. The
     * printer owns its buffer (freed by destroy), so copy into the
     * arena that the caller frees after reading. */
    if (wantIr)
    {
        IrPrinter p = IrPrinter::new();
        p.printModule(w.module);
        str irOut = p.output();
        if (irOut.ptr != null && irOut.len > 0)
        {
            u8* buf = (u8*)arena->alloc(irOut.len + 1, 1);
            if (buf != null)
            {
                usize bi = 0;
                while (bi < irOut.len) { buf[bi] = irOut.ptr[bi]; bi++; }
                buf[irOut.len] = 0;
                result.irText = Slice::from(buf, irOut.len);
            }
        }
        p.destroy();
    }

    /* compile to asm */
    if (w.errors == 0)
    {
        str asmText = irCompileAsm(w.module, w.ir, CallingConvention::SystemV, wvOptLevel(opt));
        if (asmText.ptr != null && asmText.len > 0)
            result.asmText = Slice::from((u8*)asmText.ptr, asmText.len);
        else
        {
            w.errors++;
            printf(C"error: wallvm asm generation failed\n");
        }
    }

    result.errors = w.errors;

    /* cleanup */
    if (bodies != null) dealloc<IrFunc*>(bodies);
    if (bodyDecls != null) dealloc<NodeId>(bodyDecls);
    if (names.ents != null) dealloc<WvNameEnt>(names.ents);
    if (w.fnKeys != null) dealloc<u32>(w.fnKeys);
    if (w.fnVals != null) dealloc<IrFunc*>(w.fnVals);
    if (w.tyKeys != null) dealloc<u32>(w.tyKeys);
    if (w.tyVals != null) dealloc<IrType*>(w.tyVals);
    if (w.tyBusy != null) dealloc<u8>(w.tyBusy);
    if (w.tdKeys != null) dealloc<u32>(w.tdKeys);
    if (w.tdVals != null) dealloc<u32>(w.tdVals);
    w.mb.free();
    if (w.locNames != null) dealloc<Str>(w.locNames);
    if (w.locSlots != null) dealloc<IrValue*>(w.locSlots);
    irCtxDestroy(w.ir);
    return result;
}
