#[[no_drop_all]]
/* coral-ir/lower.crl — wallvm lowering state and helpers
 *
 * Wv is the wallvm analog of Codegen: the same AstContext/File/MonoContext
 * /Sema inputs, but targeting wallvm IrContext/IrModule/IrBuilder instead
 * of C text. Phase 1 scope: extern protos, non-generic function bodies,
 * integer literals/arithmetic/comparisons, locals (alloca+load/store),
 * direct calls, if/while, return. */
import context::context { AstContext, InternEntry };
import mono::mono { MonoContext, MonoSubstitution };
import diag::code { ErrorCode };
import sem::sema { Sema };
import ast {
    id { Str, SourceLoc, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param }
};
import common::slice { Slice };
import build::arena { Arena };
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrValue, IrType, IrGlobal };
import(lib) wallvm::irBuilder { IrBuilder };
import(lib) std::mman { alloc, dealloc };
import(lib) std::string { String };

pub struct Wv
{
    AstContext* ctx;
    File* file;
    MonoContext* mono;
    Sema* sema;
    IrContext* ir;
    IrModule* mod;
    IrBuilder b;
    u32 errors;

    /* arena backing every params/fields array handed to createFunc /
     * createStructType / tyFunc: wallvm stores those raw pointers in the
     * interned types for the whole IrContext lifetime, so they must not
     * be per-call allocs. Freed with the arena after irCtxDestroy. */
    Arena* arena;

    /* local slots: name → alloca ptr (pushed per function / per scope) */
    Str* locNames;
    IrValue** locSlots;
    Ty* locTys;
    u32 locLen;
    u32 locCap;

    /* per-function lowering state */
    IrFunc* fn;
    IrBlock* block;
    bool term;          // current block already has a terminator
    Ty retTy;           // current function return type (for implicit void ret)

    /* loop targets */
    IrBlock* breakT;
    IrBlock* contT;
    u32 loopDepth;

    /* reusable mangle buffer for mangling (wallvm dups names on create) */
    String mb;

    /* declId.index → IrFunc* (populated once in the collection pass;
     * call resolution looks up here instead of re-deriving) */
    u32* fnKeys;       // declId.index + 1; 0 = empty slot
    IrFunc** fnVals;
    u32 fnCap;         // power of two

    /* declId.index → IrGlobal* for names that keep storage: a
     * DeclKind::Constant carrying static/extern storage (file-scope) or
     * a function-scope `static` VarDecl, keyed by the declaring node */
    u32* gKeys;        // declId.index + 1; 0 = empty slot
    IrGlobal** gVals;
    u32 gCap;          // power of two

    /* Ty → IrType* memo for wvTy. Without it a nested/recursive struct
     * re-derives its whole field graph on every visit (exponential on
     * std's type graph — observed as a hard hang in MiAlloc_alloc). */
    u32* tyKeys;       // Ty + 1; 0 = empty slot
    IrType** tyVals;
    u8* tyBusy;        // 1 while that Ty is being derived (cycle marker)
    u32 tyCap;         // power of two

    /* interned type-name → its type decl (wvFindTypeDecl). The merged
     * file's decl list is scanned linearly otherwise — 37% of compile
     * time on std-sized units. */
    u32* tdKeys;       // Str + 1; 0 = empty slot
    u32* tdVals;       // NodeId.index + 1
    u32 tdCap;         // power of two

    /* monomorphisation substitution for the current instance */
    MonoSubstitution* subs;
    u32 subsLen;

    /* mono FunctionInstance index → its IrFunc (null when the instance
     * has no lowered body); call resolution picks through this */
    IrFunc** instFns;
    u32 instFnsLen;

    /* mono TypeInstance index → its IrType, built with that instance's
     * substitutions active; wvTy resolves a generic-named type
     * (`Vec<str>`) through this table */
    IrType** instTys;
    u32 instTysLen;

    /* symbol table, set by generateWallVm so expression lowering can
     * find an instance-method shell by its composed symbol */
    WvNames* names;
}

/* symbol → first-decl collision table (open-addressed) */
pub struct WvNameEnt
{
    str name;        // stable (owned by IrFunc) or empty = empty slot
    u32 declIdx;     // declId.index of the first decl seen
    bool isDefn;     // first decl had a body
    IrFunc* f;
}

pub struct WvNames
{
    WvNameEnt* ents;
    u32 cap;         // power of two
}

pub u32 wvHashStr(str s)
{
    u32 h = 2166136261;
    usize i = 0;
    while (i < s.len) { h = (h ^ (u32)s.ptr[i]) * 16777619; i++; }
    return h;
}

pub bool wvNamesInit(WvNames* t, u32 capPow2)
{
    t->cap = capPow2;
    t->ents = alloc<WvNameEnt>((usize)capPow2);
    if (t->ents == null) { t->cap = 0; return false; }
    u32 i = 0;
    while (i < capPow2) { t->ents[i].name = str::empty(); t->ents[i].f = null; i++; }
    return true;
}

/* look up a name; returns the entry or null */
pub WvNameEnt* wvNamesFind(WvNames* t, str name)
{
    if (t == null || t->cap == 0) return null;
    u32 slot = wvHashStr(name) & (t->cap - 1);
    while (t->ents[slot].name.len != 0)
    {
        if (t->ents[slot].name.equals(name)) return t->ents + slot;
        slot = (slot + 1) & (t->cap - 1);
    }
    return null;
}

/* claim a slot for a new name; returns the entry */
pub WvNameEnt* wvNamesInsert(WvNames* t, str name)
{
    if (t == null || t->cap == 0) return null;
    u32 slot = wvHashStr(name) & (t->cap - 1);
    while (t->ents[slot].name.len != 0)
    {
        if (t->ents[slot].name.equals(name)) return t->ents + slot;
        slot = (slot + 1) & (t->cap - 1);
    }
    t->ents[slot].name = name;
    return t->ents + slot;
}

pub struct WallVmResult
{
    Slice asmText;
    Slice irText;
    u32 errors;
}

/* ── small helpers ──────────────────────────────────────────── */

pub Node* wvNode(Wv* w, NodeId id) { return w->ctx->nodes + id.index; }

pub void wvErr(Wv* w, NodeId id, str msg)
{
    w->errors++;
    w->sema.semaErrorNode(ErrorCode::CodegenUnsupported, id, msg);
}

/* allocate n T's from the Wv arena (for arrays wallvm keeps alive) */
pub rawptr wvArr(Wv* w, usize count, usize elemSize)
{
    if (w->arena != null && count > 0)
        return w->arena->alloc(count * elemSize, 8);
    return null;
}

/* intern Str → str */
pub str wvStr(Wv* w, Str s)
{
    if (s == 0) return str::empty();
    InternEntry* e = w->ctx->interns + s;
    return str { .ptr = (const u8*)e.ptr, .len = e.len };
}

Slice wvSlice(Wv* w, Str s)
{
    if (s == 0) return Slice::from(null, 0);
    InternEntry* e = w->ctx->interns + s;
    return Slice::from(e.ptr, e.len);
}

/* ensure the builder points at w->block (skips dead code after a
 * terminator by starting a fresh unreachable block) */
pub void wvPos(Wv* w)
{
    if (w->block == null) return;
    w->b.pos(w->block, null);
}

/* current-block tracking: mark terminator emitted */
pub void wvTerm(Wv* w)
{
    w->term = true;
}

pub IrBlock* wvBlock(Wv* w, str name)
{
    IrBlock* bb = w->ir->createBlock(name);
    w->fn->addBlock(bb);
    return bb;
}

/* switch to a (possibly new) block for continued emission */
pub void wvSetBlock(Wv* w, IrBlock* bb)
{
    w->block = bb;
    w->term = false;
    wvPos(w);
}

/* resolve a type through the current instance's substitutions (mirror
 * of codegen cgSubstTy) */
pub Ty wvSubstTy(Wv* w, Ty t)
{
    if (t == 0 || w->subsLen == 0 || w->subs == null) return t;
    TypeEntry* e = w->ctx->types + t;
    if (e.kind.tag == TypeKind::TypeParam)
    {
        u32 i = 0;
        while (i < w->subsLen)
        {
            if (w->subs[i].index == e.kind.payload.TypeParam.index ||
                w->subs[i].parameter == e.kind.payload.TypeParam.name)
                return w->subs[i].typeNode;
            i++;
        }
    }
    return t;
}

/* strip Const/Comptime wrappers around a resolved type */
pub Ty wvResolved(Wv* w, Ty t)
{
    Ty rt = t != 0 ? wvSubstTy(w, t) : 0;
    while (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        if (te.kind.tag == TypeKind::Const) rt = te.kind.payload.Const.base;
        else if (te.kind.tag == TypeKind::Comptime) rt = te.kind.payload.Comptime.base;
        else break;
    }
    return rt;
}

/* local-slot stack push/pop */
pub void wvPushLocal(Wv* w, Str name, IrValue* slot, Ty ty)
{
    if (w->locLen >= w->locCap)
    {
        u32 nc = w->locCap == 0 ? 8 : w->locCap * 2;
        Str* nn = alloc<Str>((usize)nc);
        IrValue** ns = alloc<IrValue*>((usize)nc);
        Ty* nt = alloc<Ty>((usize)nc);
        if (nn == null || ns == null || nt == null) { wvErr(w, NodeId{}, "out of memory in local table"); return; }
        u32 i = 0;
        while (i < w->locLen) { nn[i] = w->locNames[i]; ns[i] = w->locSlots[i]; nt[i] = w->locTys[i]; i++; }
        if (w->locNames != null) dealloc<Str>(w->locNames);
        if (w->locSlots != null) dealloc<IrValue*>(w->locSlots);
        if (w->locTys != null) dealloc<Ty>(w->locTys);
        w->locNames = nn;
        w->locSlots = ns;
        w->locTys = nt;
        w->locCap = nc;
    }
    w->locNames[w->locLen] = name;
    w->locSlots[w->locLen] = slot;
    w->locTys[w->locLen] = ty;
    w->locLen++;
}

pub IrValue* wvFindLocal(Wv* w, Str name)
{
    u32 i = w->locLen;
    while (i > 0)
    {
        i--;
        if (w->locNames[i] == name) return w->locSlots[i];
    }
    return null;
}

/* the declared sema type a local was pushed with — the type source for
 * exprs sema never stamped: typecheck skips comptime switch arms
 * (generic scrutinees would false-reject) and CtEval emits the selected
 * arm, so those nodes carry resolvedType == 0. The C backend re-derives
 * the same way, from symbols rather than sema annotations. */
pub Ty wvLocalTy(Wv* w, Str name)
{
    u32 i = w->locLen;
    while (i > 0)
    {
        i--;
        if (w->locNames[i] == name) return w->locTys != null ? w->locTys[i] : 0;
    }
    return 0;
}

/* the value a slot holds: slot types are Ptr(value), except aggregates,
 * whose slot IS the value under the address convention */
pub IrType* wvSlotTy(IrType* t)
{
    return t != null && t->kind == IrTypeKind::Ptr ? t->elem : t;
}

/* ── reusable mangle buffer ─────────────────────────────────── */

pub void wvMbReset(Wv* w) { w->mb.len = 0; w->mb.ptr[0] = 0; }

pub void wvMbCh(Wv* w, u8 c)
{
    w->mb.appendView(str { .ptr = &c, .len = 1 });
}

pub void wvMbSeg(Wv* w, const u8* p, usize n)
{
    usize i = 0;
    bool first = true;
    while (i < n)
    {
        u8 c = p[i];
        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                  (c >= 48 && c <= 57) || c == 95;
        if (!ok) c = 95;
        if (first && c >= 48 && c <= 57) wvMbCh(w, 95);
        wvMbCh(w, c);
        first = false;
        i++;
    }
}

pub void wvMbP(Wv* w, str s)
{
    if (s.ptr == null) return;
    wvMbSeg(w, s.ptr, s.len);
}

pub str wvMbStr(Wv* w) { return w->mb.asView(); }

/* ── declId.index → IrFunc* map (open-addressed, power-of-two) ─ */

pub void wvFnMapInit(Wv* w, u32 capPow2)
{
    w->fnCap = capPow2;
    w->fnKeys = alloc<u32>((usize)capPow2);
    w->fnVals = alloc<IrFunc*>((usize)capPow2);
    if (w->fnKeys == null || w->fnVals == null)
    {
        w->fnCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->fnKeys[i] = 0; w->fnVals[i] = null; i++; }
}

pub void wvFnMapPut(Wv* w, u32 declIdx, IrFunc* f)
{
    if (w->fnCap == 0 || declIdx == 0xffffffff) return;
    u32 slot = declIdx & (w->fnCap - 1);
    while (w->fnKeys[slot] != 0)
    {
        if (w->fnKeys[slot] == declIdx + 1) { w->fnVals[slot] = f; return; }
        slot = (slot + 1) & (w->fnCap - 1);
    }
    w->fnKeys[slot] = declIdx + 1;
    w->fnVals[slot] = f;
}

pub IrFunc* wvFnMapGet(Wv* w, u32 declIdx)
{
    if (w->fnCap == 0 || declIdx == 0xffffffff) return null;
    u32 slot = declIdx & (w->fnCap - 1);
    while (w->fnKeys[slot] != 0)
    {
        if (w->fnKeys[slot] == declIdx + 1) return w->fnVals[slot];
        slot = (slot + 1) & (w->fnCap - 1);
    }
    return null;
}

/* ── declId → IrGlobal* map (globals keep storage: see Wv.gKeys) ─────── */

pub void wvGMapInit(Wv* w, u32 capPow2)
{
    w->gCap = capPow2;
    w->gKeys = alloc<u32>((usize)capPow2);
    w->gVals = alloc<IrGlobal*>((usize)capPow2);
    if (w->gKeys == null || w->gVals == null)
    {
        w->gCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->gKeys[i] = 0; w->gVals[i] = null; i++; }
}

pub void wvGMapPut(Wv* w, u32 declIdx, IrGlobal* g)
{
    if (w->gCap == 0 || declIdx == 0xffffffff) return;
    u32 slot = declIdx & (w->gCap - 1);
    while (w->gKeys[slot] != 0)
    {
        if (w->gKeys[slot] == declIdx + 1) { w->gVals[slot] = g; return; }
        slot = (slot + 1) & (w->gCap - 1);
    }
    w->gKeys[slot] = declIdx + 1;
    w->gVals[slot] = g;
}

pub IrGlobal* wvGMapGet(Wv* w, u32 declIdx)
{
    if (w->gCap == 0 || declIdx == 0xffffffff) return null;
    u32 slot = declIdx & (w->gCap - 1);
    while (w->gKeys[slot] != 0)
    {
        if (w->gKeys[slot] == declIdx + 1) return w->gVals[slot];
        slot = (slot + 1) & (w->gCap - 1);
    }
    return null;
}

/* the decl→wallvm entry, defined in decl.crl */
pub str wvMangle(Wv* w, NodeId declId, Str name);

/* ── Ty → IrType* memo (see Wv.tyKeys) ──────────────────────────────── */

pub void wvTyMapInit(Wv* w, u32 capPow2)
{
    w->tyCap = capPow2;
    w->tyKeys = alloc<u32>((usize)capPow2);
    w->tyVals = alloc<IrType*>((usize)capPow2);
    w->tyBusy = alloc<u8>((usize)capPow2);
    if (w->tyKeys == null || w->tyVals == null || w->tyBusy == null)
    {
        w->tyCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->tyKeys[i] = 0; w->tyVals[i] = null; w->tyBusy[i] = 0; i++; }
}

/* found: fills busy (1 = still being derived) and val (null while busy) */
pub bool wvTyMapFind(Wv* w, Ty t, u8* busy, IrType** val)
{
    if (w->tyCap == 0) return false;
    u32 slot = ((u32)t) & (w->tyCap - 1);
    while (w->tyKeys[slot] != 0)
    {
        if (w->tyKeys[slot] == (u32)t + 1)
        {
            *busy = w->tyBusy[slot];
            *val = w->tyVals[slot];
            return true;
        }
        slot = (slot + 1) & (w->tyCap - 1);
    }
    return false;
}

/* claim the slot for derivation (busy=1) or publish a finished type
 * (busy=0, v!=null) */
pub void wvTyMapSet(Wv* w, Ty t, u8 b, IrType* v)
{
    if (w->tyCap == 0) return;
    u32 slot = ((u32)t) & (w->tyCap - 1);
    while (w->tyKeys[slot] != 0)
    {
        if (w->tyKeys[slot] == (u32)t + 1)
        {
            w->tyBusy[slot] = b;
            if (v != null) w->tyVals[slot] = v;
            return;
        }
        slot = (slot + 1) & (w->tyCap - 1);
    }
    w->tyKeys[slot] = (u32)t + 1;
    w->tyVals[slot] = v;
    w->tyBusy[slot] = b;
}

/* ── type-name → decl memo (see Wv.tdKeys) ─────────────────────────────── */

pub void wvTdMapInit(Wv* w, u32 capPow2)
{
    w->tdCap = capPow2;
    w->tdKeys = alloc<u32>((usize)capPow2);
    w->tdVals = alloc<u32>((usize)capPow2);
    if (w->tdKeys == null || w->tdVals == null)
    {
        w->tdCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->tdKeys[i] = 0; w->tdVals[i] = 0; i++; }
}

/* returns 0 when not memoized; out: 1+index when present (0 = "absent"
 * is cached too, as 1<<31 marker handled by caller) */
pub u32 wvTdMapGet(Wv* w, Str name, bool* found)
{
    *found = false;
    if (w->tdCap == 0) return 0;
    u32 slot = ((u32)name) & (w->tdCap - 1);
    while (w->tdKeys[slot] != 0)
    {
        if (w->tdKeys[slot] == (u32)name + 1)
        {
            *found = true;
            return w->tdVals[slot];
        }
        slot = (slot + 1) & (w->tdCap - 1);
    }
    return 0;
}

pub void wvTdMapPut(Wv* w, Str name, u32 v)
{
    if (w->tdCap == 0) return;
    u32 slot = ((u32)name) & (w->tdCap - 1);
    while (w->tdKeys[slot] != 0)
    {
        if (w->tdKeys[slot] == (u32)name + 1) { w->tdVals[slot] = v; return; }
        slot = (slot + 1) & (w->tdCap - 1);
    }
    w->tdKeys[slot] = (u32)name + 1;
    w->tdVals[slot] = v;
}

/* write v as lowercase hex into the mangle buffer */
pub void wvMbHex(Wv* w, u64 v)
{
    u8[16] rev;
    u32 n = 0;
    if (v == 0) rev[n++] = 48;
    while (v != 0)
    {
        u32 d = (u32)(v & 15);
        rev[n++] = (u8)(d < 10 ? 48 + d : 87 + d);
        v >>= 4;
    }
    while (n != 0) { n--; wvMbCh(w, rev[n]); }
}

/* append t's leaf spelling to the mangle buffer: the argument
 * discriminator inside an instance symbol. Structural, injective for
 * distinct shapes, depth-bounded (nesting past the cap spells `_`). */
pub void wvTyLeaf(Wv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 8) { wvMbP(w, "_"); return; }
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { wvMbP(w, "void"); },
        TypeKind::Bool => { wvMbP(w, "bool"); },
        TypeKind::Char => { wvMbP(w, "char"); },
        TypeKind::I8 => { wvMbP(w, "i8"); },
        TypeKind::U8 => { wvMbP(w, "u8"); },
        TypeKind::I16 => { wvMbP(w, "i16"); },
        TypeKind::U16 => { wvMbP(w, "u16"); },
        TypeKind::I32 => { wvMbP(w, "i32"); },
        TypeKind::U32 => { wvMbP(w, "u32"); },
        TypeKind::I64 => { wvMbP(w, "i64"); },
        TypeKind::U64 => { wvMbP(w, "u64"); },
        TypeKind::I128 => { wvMbP(w, "i128"); },
        TypeKind::U128 => { wvMbP(w, "u128"); },
        TypeKind::F32 => { wvMbP(w, "f32"); },
        TypeKind::F64 => { wvMbP(w, "f64"); },
        TypeKind::Isize => { wvMbP(w, "isize"); },
        TypeKind::Usize => { wvMbP(w, "usize"); },
        TypeKind::Rawptr => { wvMbP(w, "rawptr"); },
        TypeKind::Str => { wvMbP(w, "str"); },
        TypeKind::Pointer => { wvMbP(w, "p"); wvTyLeaf(w, e->kind.payload.Pointer.base, depth + 1); },
        TypeKind::Const => { wvMbP(w, "cv"); wvTyLeaf(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { wvMbP(w, "ct"); wvTyLeaf(w, e->kind.payload.Comptime.base, depth + 1); },
        TypeKind::Slice => { wvMbP(w, "s"); wvTyLeaf(w, e->kind.payload.Slice.base, depth + 1); },
        TypeKind::Array => {
            wvMbP(w, "a");
            wvMbHex(w, (u64)e->kind.payload.Array.len);
            wvMbCh(w, 95);
            wvTyLeaf(w, e->kind.payload.Array.base, depth + 1);
        },
        TypeKind::FnPtr => {
            wvMbP(w, "fp");
            wvTyLeaf(w, e->kind.payload.FnPtr.returnType, depth + 1);
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                wvMbCh(w, 95);
                wvTyLeaf(w, e->kind.payload.FnPtr.params[i], depth + 1);
                i++;
            }
        },
        TypeKind::Tuple => {
            wvMbP(w, "tp");
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                wvMbCh(w, 95);
                wvTyLeaf(w, e->kind.payload.Tuple.elems[i], depth + 1);
                i++;
            }
        },
        TypeKind::Named => {
            wvMbP(w, wvStr(w, e->kind.payload.Named.name));
            u32 i = 0;
            while (i < e->kind.payload.Named.genericArgsLen)
            {
                wvMbCh(w, 95);
                wvTyLeaf(w, e->kind.payload.Named.genericArgs[i], depth + 1);
                i++;
            }
        },
        TypeKind::TypeParam => { wvMbP(w, "T"); wvMbHex(w, (u64)e->kind.payload.TypeParam.index); },
        TypeKind::ValueInt => { wvMbP(w, "v"); wvMbHex(w, e->kind.payload.ValueInt.value); },
        else => { wvMbP(w, "x"); },
    }
}

/* the mono type-instance symbol base for `name<args...>`: the bare
 * decl name, then `_` per argument spelled through wvTyLeaf — the same
 * `name_arg…` shape the C backend's cgInstanceName composes (and the
 * same leaf spelling function-instance symbols use). */
pub Str wvTypeInstanceName(Wv* w, Str name, Ty* args, u32 argsLen)
{
    if (argsLen == 0 || args == null) return name;
    wvMbReset(w);
    wvMbP(w, wvStr(w, name));
    u32 i = 0;
    while (i < argsLen)
    {
        wvMbCh(w, 95);
        wvTyLeaf(w, args[i], 0);
        i++;
    }
    return w->ctx->intern(wvMbStr(w));
}
