#[[no_drop_all]]
/* coral-ir/lower.crl — muvm lowering state and helpers
 *
 * Muv is the muvm analog of Codegen: the same AstContext/File/MonoContext
 * /Sema inputs, but targeting muvm IrContext/IrModule/IrBuilder instead
 * of C text. Phase 1 scope: extern protos, non-generic function bodies,
 * integer literals/arithmetic/comparisons, locals (alloca+load/store),
 * direct calls, if/while, return. */
use context::context { AstContext, InternEntry };
use mono::mono { MonoContext, MonoSubstitution };
use diag::code { ErrorCode };
use diag::engine { DiagnosticEngine };
use sem::sema { Sema };
use ast {
    id { Str, SourceLoc, NodeId, locFile },
    types { Ty, TypeEntry, TypeKind },
    node { Node, NodeKind },
    expr { Expr, ExprKind },
    stmt { Stmt, StmtKind },
    decl { Decl, DeclKind, File, Param }
};
use common::slice { Slice };
use build::arena { Arena };
import std::mman { alloc, dealloc, copy, zero };
import std::string { String };

pub struct MuvDrop
{
    Str name;
    IrValue* slot;
    Ty ty;
    NodeId mdef;
}

pub struct Muv
{
    AstContext* ctx;
    File* file;
    MonoContext* mono;
    Sema* sema;
    DiagnosticEngine* diag;
    IrContext* ir;
    IrModule* module;
    IrBuilder b;
    u32 errors;

    /* arena backing every params/fields array handed to createFunc /
     * createStructType / tyFunc: muvm stores those raw pointers in the
     * interned types for the whole IrContext lifetime, so they must not
     * be per-call allocs. Freed with the arena after irCtxDestroy. */
    Arena* arena;

    /* local slots: name → alloca ptr (pushed per function / per scope) */
    Str* locNames;
    IrValue** locSlots;
    Ty* locTys;
    u32 locLen;
    u32 locCap;

    /* per-function lowering state */
    IrFunc* fn;
    IrBlock* block;
    bool term;          // current block already has a terminator
    Ty retTy;           // current function return type (for implicit void ret)

    /* loop targets */
    IrBlock* breakT;
    IrBlock* contT;
    u32 loopDepth;

    /* RAII: live locals with a drop method, innermost-last. Branch
     * targets carry the drop-stack mark of the scope they exit. */
    MuvDrop* drops;
    u32 dropLen;
    u32 dropCap;
    u32 fnDropMark;
    u32 contDropMark;
    u32 breakDropMark;

    /* defer stack (LIFO) and the marks branch targets unwind to */
    NodeId* defers;
    u32 deferLen;
    u32 deferCap;
    u32 fnDeferMark;
    u32 contDeferMark;
    u32 breakDeferMark;

    /* reusable mangle buffer for mangling (muvm dups names on create) */
    String mb;

    /* declId.index → IrFunc* (populated once in the collection pass;
     * call resolution looks up here instead of re-deriving) */
    u32* fnKeys;       // declId.index + 1; 0 = empty slot
    IrFunc** fnVals;
    u32 fnCap;         // power of two
    u32 fnLen;         // occupied slots (grows at 75%)

    /* declId.index → IrGlobal* for names that keep storage: a
     * DeclKind::Constant carrying static/extern storage (file-scope) or
     * a function-scope `static` VarDecl, keyed by the declaring node */
    u32* gKeys;        // declId.index + 1; 0 = empty slot
    IrGlobal** gVals;
    u32 gCap;          // power of two
    u32 gLen;          // occupied slots (grows at 75%)

    /* every IrStructType coral-ir built (muvStructTy), in creation
     * order — field-index lookups resolve names through these because
     * muvm never registers them on the module and their field order is
     * the compiler's layout order ([[reorder]]/[[packed]] permute it) */
    IrStructType** structTys;
    u32 structTysLen;
    u32 structTysCap;

    /* calling-convention id stamped on every IrFunc (IrFunc.cc): the
     * numeric form of the CallingConvention passed to generateMuvm —
     * externs especially must not lose it (0 = SystemV/target default) */
    u32 ccId;

    /* Ty → IrType* memo for muvTy. Without it a nested/recursive struct
     * re-derives its whole field graph on every visit (exponential on
     * std's type graph — observed as a hard hang in MiAlloc_alloc). */
    u32* tyKeys;       // Ty + 1; 0 = empty slot
    IrType** tyVals;
    u8* tyBusy;        // 1 while that Ty is being derived (cycle marker)
    u32 tyCap;         // power of two
    u32 tyLen;         // occupied slots (grows at 75%)

    /* interned type-name → its type decl (muvFindTypeDecl). The merged
     * file's decl list is scanned linearly otherwise — 37% of compile
     * time on std-sized units. */
    u32* tdKeys;       // Str + 1; 0 = empty slot
    u32* tdVals;       // NodeId.index + 1
    u32 tdCap;         // power of two
    u32 tdLen;         // occupied slots (grows at 75%)

    /* monomorphisation substitution for the current instance */
    MonoSubstitution* subs;
    u32 subsLen;

    /* mono FunctionInstance index → its IrFunc (null when the instance
     * has no lowered body); call resolution picks through this */
    IrFunc** instFns;
    u32 instFnsLen;

    /* mono TypeInstance index → its IrType, built with that instance's
     * substitutions active; muvTy resolves a generic-named type
     * (`Vec<str>`) through this table */
    IrType** instTys;
    u32 instTysLen;

    /* symbol table, set by generateMuvm so expression lowering can

    /* multi-TU partition: TU index recorded per module->funcs[] /
     * globals[] entry at registration time (parallel arrays, kept in
     * sync by muvAddFunc/muvAddGlobal). w->curTu is the TU of the decl
     * or instance currently being registered/lowered; funcs created
     * mid-lowering (closures, helpers) inherit it. */
    u32* funcTus;
    u32 funcTusLen;
    u32 funcTusCap;
    u32* globTus;
    u32 globTusLen;
    u32 globTusCap;
    u32 curTu;

    /* partition tables (generateMuvm fills; tuCount <= 1 = single
     * module, the tables stay null) */
    u32* fileShards;    // fileId → decl-hash shard count (0 = no code)
    u32* fileTuBase;    // fileId → first TU index for that file
    u32 maxFid;
    u32 tuCount;
    u32* tuFileId;      // TU → home file id (naming/debug only)
    u32* tuShard;       // TU → decl-hash shard within tuFileId
}

/* module->addFunc plus the TU bookkeeping: funcTus[i] is the TU of
 * module->funcs[i]. Every func registration must go through here. */
pub void muvAddFunc(Muv* w, IrFunc* f)
{
    if (w->module == null || f == null) return;
    w->module->addFunc(f);
    if (w->funcTusLen >= w->funcTusCap)
    {
        u32 nc = w->funcTusCap ? w->funcTusCap * 2 : 512;
        u32* nt = alloc<u32>((usize)nc);
        if (nt != null)
        {
            if (w->funcTus != null)
            {
                copy<u32>(nt, w->funcTus, (usize)w->funcTusLen);
                dealloc<u32>(w->funcTus);
            }
            w->funcTus = nt;
            w->funcTusCap = nc;
        }
    }
    if (w->funcTus != null && w->funcTusLen < w->funcTusCap)
        w->funcTus[w->funcTusLen] = w->curTu;
    w->funcTusLen++;
}

/* module->addGlobal plus TU bookkeeping (globTus parallels globals[]) */
pub void muvAddGlobal(Muv* w, IrGlobal* g)
{
    if (w->module == null || g == null) return;
    w->module->addGlobal(g);
    if (w->globTusLen >= w->globTusCap)
    {
        u32 nc = w->globTusCap ? w->globTusCap * 2 : 128;
        u32* nt = alloc<u32>((usize)nc);
        if (nt != null)
        {
            if (w->globTus != null)
            {
                copy<u32>(nt, w->globTus, (usize)w->globTusLen);
                dealloc<u32>(w->globTus);
            }
            w->globTus = nt;
            w->globTusCap = nc;
        }
    }
    if (w->globTus != null && w->globTusLen < w->globTusCap)
        w->globTus[w->globTusLen] = w->curTu;
    w->globTusLen++;
}

/* symbol → first-decl collision table (open-addressed) */
pub struct MuvNameEnt
{
    str name;        // stable (owned by IrFunc) or empty = empty slot
    u32 declIdx;     // declId.index of the first decl seen
    bool isDefn;     // first decl had a body
    IrFunc* f;
}

pub struct MuvNames
{
    MuvNameEnt* ents;
    u32 cap;         // power of two
    u32 len;         // occupied slots — table grows at 75% load
}

pub u32 muvHashStr(str s)
{
    u32 h = 2166136261;
    usize i = 0;
    while (i < s.len) { h = (h ^ (u32)s.ptr[i]) * 16777619; i++; }
    return h;
}

pub bool muvNamesInit(MuvNames* t, u32 capPow2)
{
    t->cap = capPow2;
    t->len = 0;
    t->ents = alloc<MuvNameEnt>((usize)capPow2);
    if (t->ents == null) { t->cap = 0; return false; }
    u32 i = 0;
    while (i < capPow2) { t->ents[i].name = ""; t->ents[i].f = null; i++; }
    return true;
}

/* look up a name; returns the entry or null */
pub MuvNameEnt* muvNamesFind(MuvNames* t, str name)
{
    if (t == null || t->cap == 0) return null;
    u32 slot = muvHashStr(name) & (t->cap - 1);
    while (t->ents[slot].name.len != 0)
    {
        if (t->ents[slot].name.equals(name)) return t->ents + slot;
        slot = (slot + 1) & (t->cap - 1);
    }
    return null;
}

/* double + reinsert every entry; names are stable strs (IrFunc-owned)
 * so rehashing is a pure copy */
void muvNamesGrow(MuvNames* t)
{
    u32 nc = t->cap * 2;
    MuvNameEnt* ne = alloc<MuvNameEnt>((usize)nc);
    if (ne == null) return;
    u32 i = 0;
    while (i < nc) { ne[i].name = ""; ne[i].f = null; i++; }
    i = 0;
    while (i < t->cap)
    {
        if (t->ents[i].name.len != 0)
        {
            u32 s = muvHashStr(t->ents[i].name) & (nc - 1);
            while (ne[s].name.len != 0) s = (s + 1) & (nc - 1);
            ne[s] = t->ents[i];
        }
        i++;
    }
    dealloc<MuvNameEnt>(t->ents);
    t->ents = ne;
    t->cap = nc;
}

/* claim a slot for a new name; returns the entry */
pub MuvNameEnt* muvNamesInsert(MuvNames* t, str name)
{
    if (t == null || t->cap == 0) return null;
    if ((t->len + 1) * 4 > t->cap * 3) muvNamesGrow(t);
    u32 slot = muvHashStr(name) & (t->cap - 1);
    while (t->ents[slot].name.len != 0)
    {
        if (t->ents[slot].name.equals(name)) return t->ents + slot;
        slot = (slot + 1) & (t->cap - 1);
    }
    t->ents[slot].name = name;
    t->len++;
    return t->ents + slot;
}

/* one translation unit's emitted asm (multi-TU partition) */
pub struct MuvmTu
{
    Slice name;
    Slice text;
}

pub struct MuvmResult
{
    Slice asmText;
    Slice irText;
    MuvmTu* tus;
    u32 tusLen;
    u32 errors;
}

/* ── small helpers ──────────────────────────────────────────── */

pub Node* muvNode(Muv* w, NodeId id) { return w->ctx->nodes + id.index; }

pub void muvErr(Muv* w, NodeId id, str msg)
{
    w->errors++;
    w->sema->semaErrorNode(ErrorCode::CodegenUnsupported, id, msg);
}

/* allocate n T's from the Muv arena (for arrays muvm keeps alive) */
pub rawptr muvArr(Muv* w, usize count, usize elemSize)
{
    if (w->arena != null && count > 0)
        return w->arena->alloc(count * elemSize, 8);
    return null;
}

/* intern Str → str */
pub str muvStr(Muv* w, Str s)
{
    if (s == 0) return "";
    InternEntry* e = w->ctx->interns + s;
    return str { .ptr = (const u8*)e->ptr, .len = e->len };
}

Slice muvSlice(Muv* w, Str s)
{
    if (s == 0) return Slice::from(null, 0);
    InternEntry* e = w->ctx->interns + s;
    return Slice { e->ptr, e->len };
}

/* ensure the builder points at w->block (skips dead code after a
 * terminator by starting a fresh unreachable block) */
pub void muvPos(Muv* w)
{
    if (w->block == null) return;
    w->b.pos(w->block, null);
}

/* current-block tracking: mark terminator emitted */
pub void muvTerm(Muv* w)
{
    w->term = true;
}

pub IrBlock* muvBlock(Muv* w, str name)
{
    IrBlock* bb = w->ir->createBlock(name);
    w->fn->addBlock(bb);
    return bb;
}

/* switch to a (possibly new) block for continued emission */
pub void muvSetBlock(Muv* w, IrBlock* bb)
{
    w->block = bb;
    w->term = false;
    muvPos(w);
}

/* resolve a type through the current instance's substitutions (mirror
 * of mono substituteType / codegen cgSubstTy). Fields keep the written
 * `Named "T"` spelling — no parser rebind — so a bare Named whose name
 * matches a substitution parameter resolves exactly like TypeParam. */
pub Ty muvSubstTy(Muv* w, Ty t)
{
    if (t == 0 || w->subsLen == 0 || w->subs == null) return t;
    TypeEntry* e = w->ctx->types + t;
    if (e->kind.tag == TypeKind::TypeParam)
    {
        u32 i = 0;
        while (i < w->subsLen)
        {
            if (w->subs[i].index == e->kind.payload.TypeParam.index ||
                w->subs[i].parameter == e->kind.payload.TypeParam.name)
                return w->subs[i].typeNode;
            i++;
        }
        return t;
    }
    if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.genericArgsLen == 0)
    {
        u32 i = 0;
        while (i < w->subsLen)
        {
            if (w->subs[i].parameter == e->kind.payload.Named.name)
                return w->subs[i].typeNode;
            i++;
        }
    }
    return t;
}

/* deep substitution: muvSubstTy plus recursion into Named generic
 * args and compound type constructors, rebuilding entries only where a
 * nested param actually changed (mirrors mono substituteType's shape).
 * Used at muvTy entry so `Vec<T>` fields resolve to `Vec<f64>`. */
pub Ty muvSubstDeep(Muv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 24 || w->subsLen == 0 || w->subs == null) return t;
    t = muvSubstTy(w, t);
    if (t == 0) return 0;
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Named => {
            u32 al = e->kind.payload.Named.genericArgsLen;
            if (al == 0) return t;
            Ty* na = alloc<Ty>((usize)al);
            if (na == null) return t;
            bool changed = false;
            u32 i = 0;
            while (i < al)
            {
                na[i] = muvSubstDeep(w, e->kind.payload.Named.genericArgs[i], depth + 1);
                if (na[i] != e->kind.payload.Named.genericArgs[i]) changed = true;
                i++;
            }
            if (!changed) { dealloc<Ty>(na); return t; }
            TypeKind nk = TypeKind::Named{
                .name = e->kind.payload.Named.name,
                .genericArgs = na, .genericArgsLen = al };
            Ty nt = w->sema->allocType(nk);
            if (nt == 0) { dealloc<Ty>(na); return t; }
            TypeEntry* ne = w->ctx->types + nt;
            ne->loc = e->loc;
            return nt;
        },
        TypeKind::Pointer => {
            Ty b = muvSubstDeep(w, e->kind.payload.Pointer.base, depth + 1);
            if (b == e->kind.payload.Pointer.base) return t;
            TypeKind nk = TypeKind::Pointer{ .base = b };
            return w->sema->allocType(nk);
        },
        TypeKind::Const => {
            Ty b = muvSubstDeep(w, e->kind.payload.Const.base, depth + 1);
            if (b == e->kind.payload.Const.base) return t;
            TypeKind nk = TypeKind::Const{ .base = b };
            return w->sema->allocType(nk);
        },
        TypeKind::Comptime => {
            Ty b = muvSubstDeep(w, e->kind.payload.Comptime.base, depth + 1);
            if (b == e->kind.payload.Comptime.base) return t;
            TypeKind nk = TypeKind::Comptime{ .base = b };
            return w->sema->allocType(nk);
        },
        TypeKind::Slice => {
            Ty b = muvSubstDeep(w, e->kind.payload.Slice.base, depth + 1);
            if (b == e->kind.payload.Slice.base) return t;
            TypeKind nk = TypeKind::Slice{ .base = b };
            return w->sema->allocType(nk);
        },
        TypeKind::Array => {
            Ty b = muvSubstDeep(w, e->kind.payload.Array.base, depth + 1);
            /* symbolic size `T data[N]`: N resolves through subs by
             * index or name to a ValueInt (mirrors mono substituteType) */
            u32 len = e->kind.payload.Array.len;
            u32 sizeParam = e->kind.payload.Array.sizeParam;
            Str sizeName = e->kind.payload.Array.sizeName;
            u32 si = 0;
            while (si < w->subsLen)
            {
                bool match = (sizeParam != 4294967295 && w->subs[si].index == sizeParam) ||
                    (sizeName != 0 && w->subs[si].parameter == sizeName);
                if (match)
                {
                    Ty st2 = w->subs[si].typeNode;
                    if (st2 != 0)
                    {
                        TypeEntry* se = w->ctx->types + st2;
                        if (se->kind.tag == TypeKind::ValueInt) { len = (u32)se->kind.payload.ValueInt.value; sizeParam = 4294967295; sizeName = 0; }
                    }
                    break;
                }
                si++;
            }
            if (b == e->kind.payload.Array.base && len == e->kind.payload.Array.len &&
                sizeParam == e->kind.payload.Array.sizeParam) return t;
            TypeKind nk = TypeKind::Array{
                .base = b, .len = len, .sizeParam = sizeParam, .sizeName = sizeName };
            return w->sema->allocType(nk);
        },
        TypeKind::Reference => {
            Ty b = muvSubstDeep(w, e->kind.payload.Reference.base, depth + 1);
            if (b == e->kind.payload.Reference.base) return t;
            TypeKind nk = TypeKind::Reference{ .base = b };
            return w->sema->allocType(nk);
        },
        TypeKind::FnPtr => {
            Ty rt = muvSubstDeep(w, e->kind.payload.FnPtr.returnType, depth + 1);
            u32 pl = e->kind.payload.FnPtr.paramsLen;
            Ty* np = alloc<Ty>((usize)(pl > 0 ? pl : 1));
            if (np == null) return t;
            bool changed = rt != e->kind.payload.FnPtr.returnType;
            u32 i = 0;
            while (i < pl)
            {
                np[i] = muvSubstDeep(w, e->kind.payload.FnPtr.params[i], depth + 1);
                if (np[i] != e->kind.payload.FnPtr.params[i]) changed = true;
                i++;
            }
            if (!changed) { dealloc<Ty>(np); return t; }
            TypeKind nk = TypeKind::FnPtr{
                .returnType = rt, .params = np, .paramsLen = pl,
                .name = e->kind.payload.FnPtr.name };
            return w->sema->allocType(nk);
        },
        TypeKind::Tuple => {
            u32 el = e->kind.payload.Tuple.elemsLen;
            Ty* ne = alloc<Ty>((usize)(el > 0 ? el : 1));
            if (ne == null) return t;
            bool changed = false;
            u32 i = 0;
            while (i < el)
            {
                ne[i] = muvSubstDeep(w, e->kind.payload.Tuple.elems[i], depth + 1);
                if (ne[i] != e->kind.payload.Tuple.elems[i]) changed = true;
                i++;
            }
            if (!changed) { dealloc<Ty>(ne); return t; }
            TypeKind nk = TypeKind::Tuple{ .elems = ne, .elemsLen = el };
            return w->sema->allocType(nk);
        },
        else => { return t; }
    }
}

/* strip Const/Comptime wrappers around a resolved type */
pub Ty muvResolved(Muv* w, Ty t)
{
    Ty rt = t != 0 ? muvSubstTy(w, t) : 0;
    while (rt != 0)
    {
        TypeEntry* te = w->ctx->types + rt;
        if (te->kind.tag == TypeKind::Const) rt = te->kind.payload.Const.base;
        else if (te->kind.tag == TypeKind::Comptime) rt = te->kind.payload.Comptime.base;
        else break;
    }
    return rt;
}

/* local-slot stack push/pop */
pub void muvPushLocal(Muv* w, Str name, IrValue* slot, Ty ty)
{
    if (w->locLen >= w->locCap)
    {
        u32 nc = w->locCap == 0 ? 8 : w->locCap * 2;
        Str* nn = alloc<Str>((usize)nc);
        IrValue** ns = alloc<IrValue*>((usize)nc);
        Ty* nt = alloc<Ty>((usize)nc);
        if (nn == null || ns == null || nt == null) { muvErr(w, NodeId{ .index = 0 }, "out of memory in local table"); return; }
        u32 i = 0;
        while (i < w->locLen) { nn[i] = w->locNames[i]; ns[i] = w->locSlots[i]; nt[i] = w->locTys[i]; i++; }
        if (w->locNames != null) dealloc<Str>(w->locNames);
        if (w->locSlots != null) dealloc<IrValue*>(w->locSlots);
        if (w->locTys != null) dealloc<Ty>(w->locTys);
        w->locNames = nn;
        w->locSlots = ns;
        w->locTys = nt;
        w->locCap = nc;
    }
    w->locNames[w->locLen] = name;
    w->locSlots[w->locLen] = slot;
    w->locTys[w->locLen] = ty;
    w->locLen++;
}

/* record an IrStructType so muvFieldIdx can resolve field names in
 * layout order later, and register it on the module so backend data
 * emission can place struct-constant fields at their real offsets */
pub void muvTrackStruct(Muv* w, IrStructType* st)
{
    if (st == null) return;
    if (w->module != null) w->module->addStruct(st);
    if (w->structTysLen >= w->structTysCap)
    {
        u32 nc = w->structTysCap == 0 ? 16 : w->structTysCap * 2;
        IrStructType** ns = alloc<IrStructType*>((usize)nc);
        if (ns == null) { muvErr(w, NodeId{ .index = 0 }, "out of memory in struct table"); return; }
        u32 i = 0;
        while (i < w->structTysLen) { ns[i] = w->structTys[i]; i++; }
        if (w->structTys != null) dealloc<IrStructType*>(w->structTys);
        w->structTys = ns;
        w->structTysCap = nc;
    }
    w->structTys[w->structTysLen++] = st;
}

pub IrValue* muvFindLocal(Muv* w, Str name)
{
    u32 i = w->locLen;
    while (i > 0)
    {
        i--;
        if (w->locNames[i] == name) return w->locSlots[i];
    }
    return null;
}

/* the declared sema type a local was pushed with — the type source for
 * exprs sema never stamped: typecheck skips comptime switch arms
 * (generic scrutinees would false-reject) and CtEval emits the selected
 * arm, so those nodes carry resolvedType == 0. The C backend re-derives
 * the same way, from symbols rather than sema annotations. */
pub Ty muvLocalTy(Muv* w, Str name)
{
    u32 i = w->locLen;
    while (i > 0)
    {
        i--;
        if (w->locNames[i] == name) return w->locTys != null ? w->locTys[i] : 0;
    }
    return 0;
}

/* the value a slot holds: slot types are Ptr(value), except aggregates,
 * whose slot IS the value under the address convention */
pub IrType* muvSlotTy(IrType* t)
{
    return t != null && t->kind == IrTypeKind::Ptr ? t->elem : t;
}

/* ── reusable mangle buffer ─────────────────────────────────── */

pub void muvMbReset(Muv* w) { w->mb.len = 0; w->mb.ptr[0] = 0; }

pub void muvMbCh(Muv* w, u8 c)
{
    w->mb.appendView(str { .ptr = &c, .len = 1 });
}

pub void muvMbSeg(Muv* w, const u8* p, usize n)
{
    usize i = 0;
    bool first = true;
    while (i < n)
    {
        u8 c = p[i];
        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                  (c >= 48 && c <= 57) || c == 95;
        if (!ok) c = 95;
        if (first && c >= 48 && c <= 57) muvMbCh(w, 95);
        muvMbCh(w, c);
        first = false;
        i++;
    }
}

pub void muvMbP(Muv* w, str s)
{
    if (s.ptr == null) return;
    muvMbSeg(w, (const u8*)s.ptr, s.len);
}

/* decimal digits (the length prefix of a mangle.md ident) */
pub void muvMbDec(Muv* w, u64 v)
{
    u8[24] rev;
    u32 n = 0;
    if (v == 0) rev[n++] = 48;
    while (v != 0)
    {
        rev[n++] = (u8)(48 + (v % 10));
        v = v / 10;
    }
    while (n != 0) { n--; muvMbCh(w, rev[n]); }
}

/* mangle.md ident: decimal byte length followed by the bytes. Bytes
 * that cannot appear in an assembler symbol (spaces in file names,
 * punctuation) fold to '_' 1:1 so the length prefix stays exact —
 * same rule cgMangleSeg applies on the C backend. */
pub void muvMbIdent(Muv* w, const u8* p, usize n)
{
    muvMbDec(w, (u64)n);
    usize i = 0;
    while (i < n)
    {
        u8 c = p[i];
        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                  (c >= 48 && c <= 57) || c == 95;
        muvMbCh(w, ok ? c : 95);
        i++;
    }
}

pub void muvMbIdentStr(Muv* w, str s)
{
    if (s.ptr == null) { muvMbCh(w, 48); return; }
    muvMbIdent(w, (const u8*)s.ptr, s.len);
}

pub str muvMbStr(Muv* w) { return w->mb.asView(); }

/* ── declId.index → IrFunc* map (open-addressed, power-of-two) ─ */

pub void muvFnMapInit(Muv* w, u32 capPow2)
{
    w->fnCap = capPow2;
    w->fnLen = 0;
    w->fnKeys = alloc<u32>((usize)capPow2);
    w->fnVals = alloc<IrFunc*>((usize)capPow2);
    if (w->fnKeys == null || w->fnVals == null)
    {
        w->fnCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->fnKeys[i] = 0; w->fnVals[i] = null; i++; }
}

pub void muvFnMapPut(Muv* w, u32 declIdx, IrFunc* f)
{
    if (w->fnCap == 0 || declIdx == 0xffffffff) return;
    /* grow at 75% load — the table must never fill completely or the
     * probe below never terminates (self-host exceeds 1024 decls) */
    if ((w->fnLen + 1) * 4 > w->fnCap * 3)
    {
        u32 nc = w->fnCap * 2;
        u32* nk = alloc<u32>((usize)nc);
        IrFunc** nv = alloc<IrFunc*>((usize)nc);
        if (nk != null && nv != null)
        {
            zero<u32>(nk, (usize)nc);
            u32 ri = 0;
            while (ri < w->fnCap)
            {
                if (w->fnKeys[ri] != 0)
                {
                    u32 s = (w->fnKeys[ri] - 1) & (nc - 1);
                    while (nk[s] != 0) s = (s + 1) & (nc - 1);
                    nk[s] = w->fnKeys[ri];
                    nv[s] = w->fnVals[ri];
                }
                ri++;
            }
            dealloc<u32>(w->fnKeys);
            dealloc<IrFunc*>(w->fnVals);
            w->fnKeys = nk;
            w->fnVals = nv;
            w->fnCap = nc;
        }
    }
    u32 slot = declIdx & (w->fnCap - 1);
    while (w->fnKeys[slot] != 0)
    {
        if (w->fnKeys[slot] == declIdx + 1) { w->fnVals[slot] = f; return; }
        slot = (slot + 1) & (w->fnCap - 1);
    }
    w->fnKeys[slot] = declIdx + 1;
    w->fnVals[slot] = f;
    w->fnLen++;
}

pub IrFunc* muvFnMapGet(Muv* w, u32 declIdx)
{
    if (w->fnCap == 0 || declIdx == 0xffffffff) return null;
    u32 slot = declIdx & (w->fnCap - 1);
    while (w->fnKeys[slot] != 0)
    {
        if (w->fnKeys[slot] == declIdx + 1) return w->fnVals[slot];
        slot = (slot + 1) & (w->fnCap - 1);
    }
    return null;
}

/* ── declId → IrGlobal* map (globals keep storage: see Muv.gKeys) ─────── */

pub void muvGMapInit(Muv* w, u32 capPow2)
{
    w->gCap = capPow2;
    w->gLen = 0;
    w->gKeys = alloc<u32>((usize)capPow2);
    w->gVals = alloc<IrGlobal*>((usize)capPow2);
    if (w->gKeys == null || w->gVals == null)
    {
        w->gCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->gKeys[i] = 0; w->gVals[i] = null; i++; }
}

pub void muvGMapPut(Muv* w, u32 declIdx, IrGlobal* g)
{
    if (w->gCap == 0 || declIdx == 0xffffffff) return;
    if ((w->gLen + 1) * 4 > w->gCap * 3)
    {
        u32 nc = w->gCap * 2;
        u32* nk = alloc<u32>((usize)nc);
        IrGlobal** nv = alloc<IrGlobal*>((usize)nc);
        if (nk != null && nv != null)
        {
            zero<u32>(nk, (usize)nc);
            u32 ri = 0;
            while (ri < w->gCap)
            {
                if (w->gKeys[ri] != 0)
                {
                    u32 s = (w->gKeys[ri] - 1) & (nc - 1);
                    while (nk[s] != 0) s = (s + 1) & (nc - 1);
                    nk[s] = w->gKeys[ri];
                    nv[s] = w->gVals[ri];
                }
                ri++;
            }
            dealloc<u32>(w->gKeys);
            dealloc<IrGlobal*>(w->gVals);
            w->gKeys = nk;
            w->gVals = nv;
            w->gCap = nc;
        }
    }
    u32 slot = declIdx & (w->gCap - 1);
    while (w->gKeys[slot] != 0)
    {
        if (w->gKeys[slot] == declIdx + 1) { w->gVals[slot] = g; return; }
        slot = (slot + 1) & (w->gCap - 1);
    }
    w->gKeys[slot] = declIdx + 1;
    w->gVals[slot] = g;
    w->gLen++;
}

pub IrGlobal* muvGMapGet(Muv* w, u32 declIdx)
{
    if (w->gCap == 0 || declIdx == 0xffffffff) return null;
    u32 slot = declIdx & (w->gCap - 1);
    while (w->gKeys[slot] != 0)
    {
        if (w->gKeys[slot] == declIdx + 1) return w->gVals[slot];
        slot = (slot + 1) & (w->gCap - 1);
    }
    return null;
}

/* the decl→muvm entry, defined in decl.crl */
pub str muvMangle(Muv* w, NodeId declId, Str name);

/* ── Ty → IrType* memo (see Muv.tyKeys) ──────────────────────────────── */

pub void muvTyMapInit(Muv* w, u32 capPow2)
{
    w->tyCap = capPow2;
    w->tyLen = 0;
    w->tyKeys = alloc<u32>((usize)capPow2);
    w->tyVals = alloc<IrType*>((usize)capPow2);
    w->tyBusy = alloc<u8>((usize)capPow2);
    if (w->tyKeys == null || w->tyVals == null || w->tyBusy == null)
    {
        w->tyCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->tyKeys[i] = 0; w->tyVals[i] = null; w->tyBusy[i] = 0; i++; }
}

/* found: fills busy (1 = still being derived) and val (null while busy) */
pub bool muvTyMapFind(Muv* w, Ty t, u8* busy, IrType** val)
{
    if (w->tyCap == 0) return false;
    u32 slot = ((u32)t) & (w->tyCap - 1);
    while (w->tyKeys[slot] != 0)
    {
        if (w->tyKeys[slot] == (u32)t + 1)
        {
            *busy = w->tyBusy[slot];
            *val = w->tyVals[slot];
            return true;
        }
        slot = (slot + 1) & (w->tyCap - 1);
    }
    return false;
}

/* claim the slot for derivation (busy=1) or publish a finished type
 * (busy=0, v!=null) */
pub void muvTyMapSet(Muv* w, Ty t, u8 b, IrType* v)
{
    if (w->tyCap == 0) return;
    if ((w->tyLen + 1) * 4 > w->tyCap * 3)
    {
        u32 nc = w->tyCap * 2;
        u32* nk = alloc<u32>((usize)nc);
        IrType** nv = alloc<IrType*>((usize)nc);
        u8* nb = alloc<u8>((usize)nc);
        if (nk != null && nv != null && nb != null)
        {
            zero<u32>(nk, (usize)nc);
            zero<u8>(nb, (usize)nc);
            u32 ri = 0;
            while (ri < w->tyCap)
            {
                if (w->tyKeys[ri] != 0)
                {
                    u32 s = (w->tyKeys[ri] - 1) & (nc - 1);
                    while (nk[s] != 0) s = (s + 1) & (nc - 1);
                    nk[s] = w->tyKeys[ri];
                    nv[s] = w->tyVals[ri];
                    nb[s] = w->tyBusy[ri];
                }
                ri++;
            }
            dealloc<u32>(w->tyKeys);
            dealloc<IrType*>(w->tyVals);
            dealloc<u8>(w->tyBusy);
            w->tyKeys = nk;
            w->tyVals = nv;
            w->tyBusy = nb;
            w->tyCap = nc;
        }
    }
    u32 slot = ((u32)t) & (w->tyCap - 1);
    while (w->tyKeys[slot] != 0)
    {
        if (w->tyKeys[slot] == (u32)t + 1)
        {
            w->tyBusy[slot] = b;
            if (v != null) w->tyVals[slot] = v;
            return;
        }
        slot = (slot + 1) & (w->tyCap - 1);
    }
    w->tyKeys[slot] = (u32)t + 1;
    w->tyVals[slot] = v;
    w->tyBusy[slot] = b;
    w->tyLen++;
}

/* ── type-name → decl memo (see Muv.tdKeys) ─────────────────────────────── */

pub void muvTdMapInit(Muv* w, u32 capPow2)
{
    w->tdCap = capPow2;
    w->tdLen = 0;
    w->tdKeys = alloc<u32>((usize)capPow2);
    w->tdVals = alloc<u32>((usize)capPow2);
    if (w->tdKeys == null || w->tdVals == null)
    {
        w->tdCap = 0;
        return;
    }
    u32 i = 0;
    while (i < capPow2) { w->tdKeys[i] = 0; w->tdVals[i] = 0; i++; }
}

/* returns 0 when not memoized; out: 1+index when present (0 = "absent"
 * is cached too, as 1<<31 marker handled by caller) */
pub u32 muvTdMapGet(Muv* w, Str name, bool* found)
{
    *found = false;
    if (w->tdCap == 0) return 0;
    u32 slot = ((u32)name) & (w->tdCap - 1);
    while (w->tdKeys[slot] != 0)
    {
        if (w->tdKeys[slot] == (u32)name + 1)
        {
            *found = true;
            return w->tdVals[slot];
        }
        slot = (slot + 1) & (w->tdCap - 1);
    }
    return 0;
}

pub void muvTdMapPut(Muv* w, Str name, u32 v)
{
    if (w->tdCap == 0) return;
    if ((w->tdLen + 1) * 4 > w->tdCap * 3)
    {
        u32 nc = w->tdCap * 2;
        u32* nk = alloc<u32>((usize)nc);
        u32* nv = alloc<u32>((usize)nc);
        if (nk != null && nv != null)
        {
            zero<u32>(nk, (usize)nc);
            u32 ri = 0;
            while (ri < w->tdCap)
            {
                if (w->tdKeys[ri] != 0)
                {
                    u32 s = (w->tdKeys[ri] - 1) & (nc - 1);
                    while (nk[s] != 0) s = (s + 1) & (nc - 1);
                    nk[s] = w->tdKeys[ri];
                    nv[s] = w->tdVals[ri];
                }
                ri++;
            }
            dealloc<u32>(w->tdKeys);
            dealloc<u32>(w->tdVals);
            w->tdKeys = nk;
            w->tdVals = nv;
            w->tdCap = nc;
        }
    }
    u32 slot = ((u32)name) & (w->tdCap - 1);
    while (w->tdKeys[slot] != 0)
    {
        if (w->tdKeys[slot] == (u32)name + 1) { w->tdVals[slot] = v; return; }
        slot = (slot + 1) & (w->tdCap - 1);
    }
    w->tdKeys[slot] = (u32)name + 1;
    w->tdVals[slot] = v;
    w->tdLen++;
}

/* write v as lowercase hex into the mangle buffer */
pub void muvMbHex(Muv* w, u64 v)
{
    u8[16] rev;
    u32 n = 0;
    if (v == 0) rev[n++] = 48;
    while (v != 0)
    {
        u32 d = (u32)(v & 15);
        rev[n++] = (u8)(d < 10 ? 48 + d : 87 + d);
        v >>= 4;
    }
    while (n != 0) { n--; muvMbCh(w, rev[n]); }
}

/* append t's leaf spelling to the mangle buffer: the argument
 * discriminator inside an instance symbol. Structural, injective for
 * distinct shapes, depth-bounded (nesting past the cap spells `_`). */
pub void muvTyLeaf(Muv* w, Ty t, u32 depth)
{
    if (t == 0 || depth > 8) { muvMbP(w, "_"); return; }
    TypeEntry* e = w->ctx->types + t;
    switch (e->kind.tag)
    {
        TypeKind::Void => { muvMbP(w, "void"); },
        TypeKind::Bool => { muvMbP(w, "bool"); },
        TypeKind::Char => { muvMbP(w, "char"); },
        TypeKind::I8 => { muvMbP(w, "i8"); },
        TypeKind::U8 => { muvMbP(w, "u8"); },
        TypeKind::I16 => { muvMbP(w, "i16"); },
        TypeKind::U16 => { muvMbP(w, "u16"); },
        TypeKind::I32 => { muvMbP(w, "i32"); },
        TypeKind::U32 => { muvMbP(w, "u32"); },
        TypeKind::I64 => { muvMbP(w, "i64"); },
        TypeKind::U64 => { muvMbP(w, "u64"); },
        TypeKind::I128 => { muvMbP(w, "i128"); },
        TypeKind::U128 => { muvMbP(w, "u128"); },
        TypeKind::F32 => { muvMbP(w, "f32"); },
        TypeKind::F64 => { muvMbP(w, "f64"); },
        TypeKind::Isize => { muvMbP(w, "isize"); },
        TypeKind::Usize => { muvMbP(w, "usize"); },
        TypeKind::Rawptr => { muvMbP(w, "rawptr"); },
        TypeKind::Str => { muvMbP(w, "str"); },
        TypeKind::Pointer => { muvMbP(w, "p"); muvTyLeaf(w, e->kind.payload.Pointer.base, depth + 1); },
        TypeKind::Reference => { muvMbP(w, "r"); muvTyLeaf(w, e->kind.payload.Reference.base, depth + 1); },
        TypeKind::Const => { muvMbP(w, "cv"); muvTyLeaf(w, e->kind.payload.Const.base, depth + 1); },
        TypeKind::Comptime => { muvMbP(w, "ct"); muvTyLeaf(w, e->kind.payload.Comptime.base, depth + 1); },
        TypeKind::Slice => { muvMbP(w, "s"); muvTyLeaf(w, e->kind.payload.Slice.base, depth + 1); },
        TypeKind::Array => {
            muvMbP(w, "a");
            muvMbHex(w, (u64)e->kind.payload.Array.len);
            muvMbCh(w, 95);
            muvTyLeaf(w, e->kind.payload.Array.base, depth + 1);
        },
        TypeKind::FnPtr => {
            muvMbP(w, "fp");
            muvTyLeaf(w, e->kind.payload.FnPtr.returnType, depth + 1);
            u32 i = 0;
            while (i < e->kind.payload.FnPtr.paramsLen)
            {
                muvMbCh(w, 95);
                muvTyLeaf(w, e->kind.payload.FnPtr.params[i], depth + 1);
                i++;
            }
        },
        TypeKind::Tuple => {
            muvMbP(w, "tp");
            u32 i = 0;
            while (i < e->kind.payload.Tuple.elemsLen)
            {
                muvMbCh(w, 95);
                muvTyLeaf(w, e->kind.payload.Tuple.elems[i], depth + 1);
                i++;
            }
        },
        TypeKind::Named => {
            muvMbP(w, muvStr(w, e->kind.payload.Named.name));
            u32 i = 0;
            while (i < e->kind.payload.Named.genericArgsLen)
            {
                muvMbCh(w, 95);
                muvTyLeaf(w, e->kind.payload.Named.genericArgs[i], depth + 1);
                i++;
            }
        },
        TypeKind::TypeParam => { muvMbP(w, "T"); muvMbHex(w, (u64)e->kind.payload.TypeParam.index); },
        TypeKind::ValueInt => { muvMbP(w, "v"); muvMbHex(w, e->kind.payload.ValueInt.value); },
        else => { muvMbP(w, "x"); },
    }
}

/* the mono type-instance symbol base for `name<args...>`: the bare
 * decl name, then `_` per argument spelled through muvTyLeaf — the same
 * `name_arg…` shape the C backend's cgInstanceName composes (and the
 * same leaf spelling function-instance symbols use). */
pub Str muvTypeInstanceName(Muv* w, Str name, Ty* args, u32 argsLen)
{
    if (argsLen == 0 || args == null) return name;
    muvMbReset(w);
    muvMbP(w, muvStr(w, name));
    u32 i = 0;
    while (i < argsLen)
    {
        muvMbCh(w, 95);
        muvTyLeaf(w, args[i], 0);
        i++;
    }
    return w->ctx->intern(muvMbStr(w));
}
