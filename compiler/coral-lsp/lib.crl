#[[no_drop_all]]
// coral-lsp: language server for coralc (coralc --serve)
//
// JSON-RPC over stdio, Content-Length framed. The server keeps one
// analyzed CompileUnit per open document; diagnostics flow through the
// engine's DiagList collector, hover resolves the expression type at a
// position through Expr.resolvedType / the top-level symbol table.
//
// stdout hazard: the compiler and builder print to stdout. The server
// diverts fd 1 to /dev/null at startup and writes protocol frames to a
// private dup of the original stdout instead.

pub mod server = import server;
