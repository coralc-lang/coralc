#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };

pub struct ArenaBlock
{
    u8* data;
    usize size;
    usize used;
    ArenaBlock* next;
}

pub ArenaBlock* arenaNewBlock(usize size)
{
    ArenaBlock* b = alloc<ArenaBlock>(1);
    if (b == null) return null;
    b.data = alloc<u8>(size);
    b.size = size;
    b.used = 0;
    b.next = null;
    if (b.data == null)
    {
        dealloc<ArenaBlock>(b);
        return null;
    }
    return b;
}

pub struct Arena
{
    ArenaBlock* head;
    usize blockSize;
}

extend Arena
{
    void init(usize size)
    {
        if (size < 64) size = 64;
        self.blockSize = size;
        self.head = arenaNewBlock(size);
    }

    rawptr alloc(usize size, usize align)
    {
        if (align == 0) align = 1;
        if (self.head == null) self.head = arenaNewBlock(self.blockSize);
        ArenaBlock* b = self.head;
        if (b == null) return null;
        usize used = (b.used + align - 1) & ~(align - 1);
        if (used + size > b.size)
        {
            usize newSize = self.blockSize;
            if (size + align + align > newSize) newSize = size + align + align;
            ArenaBlock* nb = arenaNewBlock(newSize);
            if (nb == null) return null;
            nb.next = b;
            self.head = nb;
            b = nb;
            used = 0;
        }
        rawptr ptr = (rawptr)((usize)(b.data) + used);
        b.used = used + size;
        return ptr;
    }

    void freeAll()
    {
        ArenaBlock* b = self.head;
        while (b != null)
        {
            ArenaBlock* nxt = b.next;
            dealloc<u8>(b.data);
            dealloc<ArenaBlock>(b);
            b = nxt;
        }
        self.head = arenaNewBlock(self.blockSize);
    }
}
