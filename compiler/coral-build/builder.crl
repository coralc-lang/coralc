#[[no_drop_all]]
import arena { Arena };
import ast { CrlbNode, CrlbNodeKind, Value, ValueArray, nodeKindName };
import common::slice { Slice };
import common::platform { hostOs, hostArch };
import(lib) core::cchar { cchar };
import(lib) platform::libc { printf, getenv };
import(lib) std::mman { alloc, dealloc, realloc, copy };
import(lib) std::result { Result };
import(lib) std::fios { FileHandle, fileOpen, fileRead, fileWrite, fileClose };
import(lib) std::fs { IoError, fileExists, openDir, readDirEntry, closeDir, createDirRecursive, Dirent, Dir };

// small helpers

pub bool bEq(Slice a, str b)
{
    if (a.len != b.len) return false;
    usize i = 0;
    while (i < b.len)
    {
        if (a.ptr[i] != b.ptr[i]) return false;
        i++;
    }
    return true;
}

bool bEndsWith(Slice a, str suffix)
{
    if (a.len < suffix.len) return false;
    return bEq(Slice::from(a.ptr + (a.len - suffix.len), suffix.len), suffix);
}

pub u8* bCStr(Arena* a, Slice s)
{
    u8* p = (u8*)a.alloc(s.len + 1, 1);
    if (p == null) return null;
    copy<u8>(p, s.ptr, s.len);
    p[s.len] = 0;
    return p;
}

u8* bConcat3(Arena* a, Slice x, str mid, Slice y)
{
    usize total = x.len + mid.len + y.len;
    u8* p = (u8*)a.alloc(total + 1, 1);
    if (p == null) return null;
    copy<u8>(p, x.ptr, x.len);
    copy<u8>(p + x.len, mid.ptr, mid.len);
    copy<u8>(p + x.len + mid.len, y.ptr, y.len);
    p[total] = 0;
    return p;
}

pub usize bJoin(u8* out, usize cap, Slice dir, Slice name)
{
    usize n = 0;
    usize i = 0;
    while (i < dir.len && n + 1 < cap)
    {
        out[n] = dir.ptr[i];
        n++;
        i++;
    }
    if (n > 0 && out[n - 1] != '/' && n + 1 < cap)
    {
        out[n] = '/';
        n++;
    }
    i = 0;
    while (i < name.len && n + 1 < cap)
    {
        out[n] = name.ptr[i];
        n++;
        i++;
    }
    out[n] = 0;
    return n;
}

// arena-owned `<dir>/<name>` join (mirrors bJoin's slash handling)
pub str bJoinStr(Arena* a, Slice dir, Slice name)
{
    usize cap = dir.len + name.len + 2;
    u8* p = (u8*)a.alloc(cap, 1);
    if (p == null) return str { .ptr = null, .len = 0 };
    usize n = bJoin(p, cap, dir, name);
    return str { .ptr = p, .len = n };
}

u64 bFnv(u64 h, u8* data, usize len)
{
    usize i = 0;
    while (i < len)
    {
        h = h ^ (u64)data[i];
        h *= 1099511628211; // also this, use compound assignment
        i++;
    }
    return h;
}

usize bApp(u8* buf, usize cap, usize* len, str src)
{
    usize i = 0;
    while (i < src.len && *len < cap)
    {
        buf[*len] = src.ptr[i];
        *len += 1;
        i++;
    }
    return *len;
}

pub bool bFileExists(str path)
{
    return fileExists(path);
}

Slice bReadFile(Arena* a, str path, usize* outLen)
{
    *outLen = 0;
    Result<FileHandle, IoError> fo = fileOpen(path, "rb");
    if (fo.isErr()) return Slice::from(null, 0);
    FileHandle fh = fo.unwrap();
    usize cap = 65536;
    u8* buf = alloc<u8>(cap);
    if (buf == null)
    {
        fileClose(fh);
        return Slice::from(null, 0);
    }
    usize len = 0;
    while (true)
    {
        if (len >= cap)
        {
            usize newCap = cap * 2;
            u8* fresh = realloc<u8>(buf, newCap);
            if (fresh == null) break;
            buf = fresh;
            cap = newCap;
        }
        Result<usize, IoError> rr = fileRead(fh, buf + len, cap - len);
        if (rr.isErr()) break;
        usize got = rr.unwrap();
        if (got == 0) break;
        len += got;
    }
    fileClose(fh);
    u8* cp = (u8*)a.alloc(len + 1, 1);
    if (cp == null)
    {
        dealloc<u8>(buf);
        return Slice::from(null, 0);
    }
    copy<u8>(cp, buf, len);
    cp[len] = 0;
    dealloc<u8>(buf);
    *outLen = len;
    return Slice::from(cp, len);
}

pub struct DirEnt
{
    u8* name;
    u8 dtype;
}

pub DirEnt* bListDir(Arena* a, str path, u32* outLen)
{
    *outLen = 0;
    Result<Dir, IoError> od = openDir(path);
    if (od.isErr()) return null;
    Dir dir = od.unwrap();
    DirEnt* arr = (DirEnt*)a.alloc(64 * @sizeof(DirEnt), 8);
    u32 cap = 64;
    if (arr == null)
    {
        closeDir(dir);
        return null;
    }
    u32 len = 0;
    Dirent de;
    while (readDirEntry(dir, &de))
    {
        u8 dtype = de.d_type;
        usize nameLen = 0;
        while (nameLen < 255 && de.d_name[nameLen] != 0) nameLen++;
        if (len >= cap)
        {
            u32 newCap = cap * 2;
            DirEnt* fresh = (DirEnt*)a.alloc((usize)newCap * @sizeof(DirEnt), 8);
            if (fresh == null) break;
            u32 i = 0;
            while (i < len)
            {
                fresh[i] = arr[i];
                i++;
            }
            arr = fresh;
            cap *= 2;
        }
        u8* name = (u8*)a.alloc(nameLen + 1, 1);
        copy<u8>(name, &de.d_name[0], nameLen);
        name[nameLen] = 0;
        arr[len].name = name;
        arr[len].dtype = dtype;
        len++;
    }
    closeDir(dir);
    *outLen = len;
    return arr;
}

bool bIsSkipped(Slice name, Slice* skips, u32 skipLen)
{
    u32 i = 0;
    while (i < skipLen)
    {
        if (bEq(name, skips[i].asStr())) return true;
        i++;
    }
    return false;
}

u32 bCollectCrl(Arena* a, Slice dirS, Slice* skips, u32 skipLen, Slice* out, u32 cap, u32* outLen)
{
    DirEnt* ents = null;
    u32 n = 0;
    ents = bListDir(a, dirS.asStr(), &n);
    u32 i = 0;
    while (i < n)
    {
        usize nameLen = 0;
        while (ents[i].name[nameLen] != 0) nameLen++;
        Slice nm = Slice::from(ents[i].name, nameLen);
        if (!bEq(nm, ".") && !bEq(nm, ".."))
        {
            if (ents[i].dtype == 4)
            {
                if (!bIsSkipped(nm, skips, skipLen))
                {
                    bCollectCrl(a, Slice::fromStr(bJoinStr(a, dirS, nm)), skips, skipLen, out, cap, outLen);
                }
            }
            else if (bEndsWith(nm, ".crl"))
            {
                if (*outLen < cap)
                {
                    out[*outLen] = Slice::fromStr(bJoinStr(a, dirS, nm));
                    *outLen += 1;
                }
            }
        }
        i++;
    }
    return *outLen;
}

void bSortFiles(Slice* files, u32 len)
{
    u32 i = 1;
    while (i < len)
    {
        Slice key = files[i];
        i32 j = (i32)i - 1;
        while (j >= 0)
        {
            bool less = false;
            Slice cur = files[j];
            usize minLen = cur.len;
            if (key.len < minLen) minLen = key.len;
            usize k = 0;
            while (k < minLen)
            {
                if (cur.ptr[k] < key.ptr[k]) { less = true; break; }
                if (cur.ptr[k] > key.ptr[k]) { less = false; break; }
                k++;
                if (k == minLen && cur.len < key.len) less = true;
            }
            if (!less) break;
            files[j + 1] = files[j];
            j--;
        }
        files[j + 1] = key;
        i++;
    }
}

// config extraction

CrlbField* bFindField(CrlbNode* n, Slice name)
{
    u32 i = 0;
    while (i < (u32)n.fields.len)
    {
        if (bEq(n.fields.data[i].name, name.asStr())) return n.fields.data + i;
        i++;
    }
    return null;
}

pub bool bFieldStr(CrlbNode* n, Slice name, Slice* out)
{
    CrlbField* f = bFindField(n, name);
    if (f == null) return false;
    Value v = f.value;
    if (v.tag != Value::String) return false;
    *out = v.payload.String.value;
    return true;
}

// fills out[0..cap) with the list field's strings; returns count (0 = absent/invalid)
pub u32 bFieldList(CrlbNode* n, Slice name, Arena* a, Slice* out, u32 cap)
{
    CrlbField* f = bFindField(n, name);
    if (f == null) return 0;
    Value v = f.value;
    if (v.tag != Value::List) return 0;
    ValueArray* va = v.payload.List.value;
    if (va == null) return 0;
    if (va.len == 0) return 0;
    if (va.len > (usize)cap) return 0;
    u32 i = 0;
    while (i < (u32)va.len)
    {
        Value item = va.data[i];
        if (item.tag != Value::String) return 0;
        out[i] = item.payload.String.value;
        i++;
    }
    return (u32)va.len;
}

pub struct AliasEnt
{
    Slice name;
    Slice folder;
}

pub struct ModNode
{
    Slice name;
    u32* deps;
    u32 depsLen;
    u32 depsCap;
    Slice* files;
    u32 filesLen;
    u64 fingerprint;
    bool stale;
}

pub struct Builder
{
    Arena* arena;
    CrlbNode* cfg;
    CrlbNode* build;
    Slice rootDir;
    Slice entry;
    Slice output;
    Slice mapPath;
    Slice cacheDir;
    Slice target;
    Slice opt;
    Slice* modules;
    u32 modulesLen;
    Slice* skips;
    u32 skipsLen;
    AliasEnt* aliases;
    u32 aliasesLen;
    ModNode* mods;
    u32 topoLen;
    u32* topoOrder;
    u32 errors;
    bool force;
    bool dryRun;
    bool emitMapOnly;
    /* in-memory module table: key (`module`, `alias`, `module::name`,
     * `alias::name`) → source path. The compiler's loader consumes this
     * directly; the .map file is a debug dump, never an input. */
    Slice* modKeys;
    Slice* modVals;
    u32 modLen;
    u32 modCap;
    /* build-file flags: k=v pairs feed the flag (NAME) table; recognized
     * --option entries flip the bools below (CLI still wins where both
     * set a flag: the parser first-match-wins and CLI flags load first) */
    Slice* crlbFlagNames;
    Slice* crlbFlagValues;
    u32 crlbFlagPairs;
    bool crlbAllowIntPtr;
    bool crlbQuiet;
    /* suppress every stdout summary/diagnostic (the LSP serves JSON on
     * stdout; builder output would corrupt the protocol stream) */
    bool quiet;
    /* task decls: name → exec/output plus `after` deps ("build" is the
     * pseudo-task of the compile+link pipeline itself) */
    Slice* taskNames;
    Slice* taskExecs;
    Slice* taskOutputs;
    Slice** taskAfters;
    u32* taskAfterLens;
    u32 tasksLen;
    Slice entryPath;
    bool anyStale;
    /* false until the compile phase actually compiles modules. coralc.crl
     * refuses to report build success while this is false. */
    bool compilePhaseReached;
}

void bError(Builder* b, str code, str msg, str k1, str v1, str k2, str v2, str hint)
{
    b.errors++;
    if (b->quiet) return;
    printf(C"%.*s  %.*s\n", (i32)code.len, code.ptr, (i32)msg.len, msg.ptr);
    if (k1.ptr != null) printf(C"  %.*s:   %.*s\n", (i32)k1.len, k1.ptr, (i32)v1.len, v1.ptr);
    if (k2.ptr != null) printf(C"  %.*s:   %.*s\n", (i32)k2.len, k2.ptr, (i32)v2.len, v2.ptr);
    if (hint.ptr != null) printf(C"  hint:   %.*s\n", (i32)hint.len, hint.ptr);
}

bool bInit(Builder* b, Arena* a, CrlbNode* root, bool forceIn, bool emitMapOnlyIn, bool quietIn)
{
    b.arena = a;
    b.cfg = root;
    b.build = null;
    b.errors = 0;
    b.force = forceIn;
    b.dryRun = false;
    b.emitMapOnly = emitMapOnlyIn;
    b.quiet = quietIn;
    b.compilePhaseReached = false;
    b.rootDir = Slice::fromStr("");  // root comes from the build file's root field
    b.entry = Slice::from(null, 0);
    b.output = Slice::from(null, 0);
    b.mapPath = Slice::fromStr(".coral/modules.map");
    b.cacheDir = Slice::fromStr(".coral/cache");
    b.target = Slice::from(null, 0);
    b.opt = Slice::fromStr("debug");
    b.modules = null;
    b.modulesLen = 0;
    b.skips = null;
    b.skipsLen = 0;
    b.aliases = null;
    b.aliasesLen = 0;
    b.mods = null;
    b.topoOrder = null;
    b.topoLen = 0;
    b.modKeys = null;
    b.modVals = null;
    b.modLen = 0;
    b.modCap = 0;
    b.crlbFlagNames = null;
    b.crlbFlagValues = null;
    b.crlbFlagPairs = 0;
    b.crlbAllowIntPtr = false;
    b.crlbQuiet = false;
    b.taskNames = null;
    b.taskExecs = null;
    b.taskOutputs = null;
    b.taskAfters = null;
    b.taskAfterLens = null;
    b.tasksLen = 0;
    b.entryPath = Slice::from(null, 0);
    b.anyStale = false;

    u32 i = 0;
    while (i < (u32)root.children.len)
    {
        CrlbNode* c = root.children.data + i;
        if (c.kind == CrlbNodeKind::Build)
        {
            b.build = c;
            break;
        }
        i++;
    }
    if (b.build == null)
    {
        if (!b.quiet) printf(C"E1000  no build block found\n");
        b.errors++;
        return false;
    }

    bFieldStr(b.build, Slice::fromStr("root"), &b.rootDir);
    bFieldStr(b.build, Slice::fromStr("entry"), &b.entry);
    bFieldStr(b.build, Slice::fromStr("output"), &b.output);
    bFieldStr(b.build, Slice::fromStr("module_map"), &b.mapPath);
    bFieldStr(b.build, Slice::fromStr("cache_dir"), &b.cacheDir);
    bFieldStr(b.build, Slice::fromStr("target"), &b.target);
    bFieldStr(b.build, Slice::fromStr("opt"), &b.opt);
    if (!(bEq(b.opt, "debug") || bEq(b.opt, "release") || bEq(b.opt, "size") || bEq(b.opt, "O3")))
    {
        if (!b.quiet) printf(C"E1000  unknown opt \"%s\" (expected debug, release, size, or O3)\n", bCStr(b.arena, b.opt));
        b.errors++;
        return false;
    }
    b.modules = (Slice*)a.alloc(512 * @sizeof(Slice), 8);
    b.modulesLen = bFieldList(b.build, Slice::fromStr("modules"), a, b.modules, 512);
    b.skips = (Slice*)a.alloc(512 * @sizeof(Slice), 8);
    b.skipsLen = bFieldList(b.build, Slice::fromStr("skip"), a, b.skips, 512);

    // build-file flags: k=v pairs (flag table) plus recognized options
    b.crlbFlagNames = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    b.crlbFlagValues = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    Slice* rawFlags = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    u32 rawCount = bFieldList(b.build, Slice::fromStr("flags"), a, rawFlags, 64);
    if (rawCount > 0)
    {
        u32 rf = 0;
        while (rf < rawCount)
        {
            Slice e = rawFlags[rf];
            rf++;
            if (e.len >= 3 && e.ptr[0] == 45 && e.ptr[1] == 45)
            {
                if (bEq(e, "--allow-int-ptr")) b.crlbAllowIntPtr = true; // stop freaking casting string literals to pointers, they are composite types with len youu fucktard
                else if (bEq(e, "--quiet")) b.crlbQuiet = true;
                /* other --options (--strict, …) are applied
                 * by their consumers or are informational, not errors */
            }
            else
            {
                // k=v pair, split at the first '='
                usize eq = 0;
                while (eq < e.len && e.ptr[eq] != 61) eq++;
                if (eq > 0 && eq < e.len && b.crlbFlagPairs < 64)
                {
                    b.crlbFlagNames[b.crlbFlagPairs] = Slice::from(e.ptr, (usize)eq);
                    b.crlbFlagValues[b.crlbFlagPairs] = Slice::from(e.ptr + eq + 1, e.len - eq - 1);
                    b.crlbFlagPairs++;
                }
            }
        }
    }

    if (b.modulesLen == 0)
    {
        if (!b.quiet) printf(C"E1000  modules = [...] is required in build block\n");
        b.errors++;
        return false;
    }

    b.mods = (ModNode*)a.alloc((usize)b.modulesLen * @sizeof(ModNode), 8);
    if (b.mods == null) return false;
    u32 m = 0;
    while (m < b.modulesLen)
    {
        b.mods[m].name = b.modules[m];
        b.mods[m].deps = null;
        b.mods[m].depsLen = 0;
        b.mods[m].depsCap = 0;
        b.mods[m].files = null;
        b.mods[m].filesLen = 0;
        b.mods[m].fingerprint = 14695981039346656037;
        b.mods[m].stale = true;
        m++;
    }

    u32 aliasCount = 0;
    i = 0;
    while (i < (u32)root.children.len)
    {
        if (root.children.data[i].kind == CrlbNodeKind::Alias) aliasCount++;
        i++;
    }
    if (aliasCount > 0)
    {
        b.aliases = (AliasEnt*)a.alloc((usize)aliasCount * @sizeof(AliasEnt), 8);
        if (b.aliases == null) return false;
    }
    i = 0;
    while (i < (u32)root.children.len)
    {
        CrlbNode* c = root.children.data + i;
        if (c.kind == CrlbNodeKind::Alias && c.hasLabel && c.hasPayload)
        {
            u8* tgt = c.payload.ptr;
            usize tgtLen = c.payload.len;
            u32 s = 0;
            while (s < (u32)tgtLen)
            {
                if (tgt[s] == '/')
                {
                    tgtLen = (usize)s;
                    break;
                }
                s++;
            }
            b.aliases[b.aliasesLen].name = c.label;
            b.aliases[b.aliasesLen].folder = Slice::from(tgt, tgtLen);
            b.aliasesLen++;
        }
        i++;
    }

    /* task decls (name, exec, output, after) */
    b.taskNames = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    b.taskExecs = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    b.taskOutputs = (Slice*)a.alloc(64 * @sizeof(Slice), 8);
    b.taskAfters = (Slice**)a.alloc(64 * @sizeof(Slice*), 8);
    b.taskAfterLens = (u32*)a.alloc(64 * @sizeof(u32), 8);
    if (b.taskNames == null || b.taskExecs == null || b.taskOutputs == null ||
        b.taskAfters == null || b.taskAfterLens == null) return false;
    i = 0;
    while (i < (u32)root.children.len)
    {
        CrlbNode* c = root.children.data + i;
        if (c.kind == CrlbNodeKind::Task && c.hasLabel && b.tasksLen < 64)
        {
            u32 t = b.tasksLen;
            b.taskNames[t] = c.label;
            b.taskExecs[t] = Slice::from(null, 0);
            b.taskOutputs[t] = Slice::from(null, 0);
            bFieldStr(c, Slice::fromStr("exec"), &b.taskExecs[t]);
            bFieldStr(c, Slice::fromStr("output"), &b.taskOutputs[t]);
            Slice* aft = (Slice*)a.alloc(16 * @sizeof(Slice), 8);
            b.taskAfters[t] = aft;
            b.taskAfterLens[t] = 0;
            if (aft != null)
            {
                b.taskAfterLens[t] = bFieldList(c, Slice::fromStr("after"), a, aft, 16);
            }
            b.tasksLen++;
        }
        i++;
    }
    return b.errors == 0;
}

// resolve alias or raw folder prefix to a module folder
bool bResolvePrefix(Builder* b, Slice prefix, Slice* outFolder)
{
    u32 i = 0;
    while (i < b.aliasesLen)
    {
        if (bEq(b.aliases[i].name, prefix.asStr()))
        {
            *outFolder = b.aliases[i].folder;
            return true;
        }
        i++;
    }
    i = 0;
    while (i < b.modulesLen)
    {
        if (bEq(b.modules[i], prefix.asStr()))
        {
            *outFolder = b.modules[i];
            return true;
        }
        i++;
    }
    return false;
}

i32 bModuleIdx(Builder* b, Slice folder)
{
    u32 i = 0;
    while (i < b.modulesLen)
    {
        if (bEq(b.modules[i], folder.asStr())) return (i32)i;
        i++;
    }
    return -1;
}

pub i32 bTaskIndex(Builder* b, str name)
{
    if (b.taskNames == null) return -1;
    u32 i = 0;
    while (i < b.tasksLen)
    {
        if (bEq(b.taskNames[i], name)) return (i32)i;
        i++;
    }
    return -1;
}

// the builder verifies the module surface file exists (E1001) and later
// line-scans it for `pub mod` re-exports (bBuildModuleTable); it never
// runs the full Coral parser on user sources.
bool bScanLib(Builder* b, Slice folder)
{
    str libDir = bJoinStr(b.arena, b.rootDir, folder);
    if (libDir.ptr == null) return false;
    str libPath = bJoinStr(b.arena, Slice::from(libDir.ptr, libDir.len), Slice::fromStr("lib.crl"));
    if (libPath.ptr == null) return false;
    if (!bFileExists(libPath))
    {
        bError(b, "E1001", "missing lib.crl", "module", folder.asStr(), "path", libPath,
               "run `coralc init <module>` or add a lib.crl");
        return false;
    }
    return true;
}

bool bValidateAliases(Builder* b)
{
    u32 i = 0;
    while (i < b.aliasesLen)
    {
        i32 idx = bModuleIdx(b, b.aliases[i].folder);
        if (idx < 0)
        {
            bError(b, "E1003", "alias points to unknown module", "alias", b.aliases[i].name.asStr(), "target", b.aliases[i].folder.asStr(),
                   "list: modules = [...]");
            return false;
        }
        i++;
    }
    return true;
}

pub bool bWriteFile(str path, const u8* data, usize len)
{
    Result<FileHandle, IoError> fo = fileOpen(path, "w");
    if (fo.isErr()) return false;
    FileHandle fh = fo.unwrap();
    Result<usize, IoError> wr = fileWrite(fh, str { .ptr = (u8*)data, .len = len });
    fileClose(fh);
    return wr.isOk();
}

/* platform root for platform-first re-export resolution inside the
 * builder: crlb flags (platform=/arch=) > CORAL_PLATFORM > compile-time host.
 * Returns an arena-owned "arch/os" string (may be empty on alloc failure). */
Slice bPlatformRoot(Builder* b)
{
    u8* plat = null;
    usize platLen = 0;
    u8* arch = null;
    usize archLen = 0;
    u32 fi = 0;
    while (fi < b.crlbFlagPairs)
    {
        if (bEq(b.crlbFlagNames[fi], "platform")) { plat = b.crlbFlagValues[fi].ptr; platLen = b.crlbFlagValues[fi].len; }
        if (bEq(b.crlbFlagNames[fi], "arch")) { arch = b.crlbFlagValues[fi].ptr; archLen = b.crlbFlagValues[fi].len; }
        fi++;
    }
    if (plat == null)
    {
        u8* env = getenv(C"CORAL_PLATFORM");
        if (env != null)
        {
            usize el = 0;
            while (env[el] != 0) el++;
            if (el > 0) { plat = env; platLen = el; }
        }
    }
    if (plat == null)
    {
        str a = hostArch();
        str o = hostOs();
        usize n = a.len + 1 + o.len;
        u8* p = (u8*)b.arena.alloc(n + 1, 1);
        if (p == null) return Slice::from(null, 0);
        usize k = 0;
        while (k < a.len) { p[k] = a.ptr[k]; k++; }
        p[k] = 47; k++;
        usize j = 0;
        while (j < o.len) { p[k] = o.ptr[j]; k++; j++; }
        p[k] = 0;
        return Slice::from(p, n);
    }
    // full 'arch/os' value: use as-is
    {
        usize sc = 0;
        usize q = 0;
        while (q < platLen) { if (plat[q] == 47) sc++; q++; }
        if (sc > 0)
        {
            u8* p = (u8*)b.arena.alloc(platLen + 1, 1);
            if (p == null) return Slice::from(null, 0);
            usize k = 0;
            while (k < platLen) { p[k] = plat[k]; k++; }
            p[platLen] = 0;
            return Slice::from(p, platLen);
        }
    }
    // bare OS name: prefix the arch (same shim as segsFromPlatformFlag)
    if (arch == null) { str dfltArch = hostArch(); arch = dfltArch.ptr; archLen = dfltArch.len; }
    u8* p = (u8*)b.arena.alloc(archLen + 1 + platLen + 1, 1);
    if (p == null) return Slice::from(null, 0);
    usize k = 0;
    while (k < archLen) { p[k] = arch[k]; k++; }
    p[k] = 47; k++;
    usize j = 0;
    while (j < platLen) { p[k] = plat[j]; k++; j++; }
    p[k] = 0;
    return Slice::from(p, k);
}

// append key→value to the in-memory module table (arena-owned copies)
bool bModTableAdd(Builder* b, Slice key, Slice val)
{
    if (b.modCap == 0)
    {
        b.modCap = 4096;
        b.modKeys = (Slice*)b.arena.alloc((usize)b.modCap * @sizeof(Slice), 8);
        b.modVals = (Slice*)b.arena.alloc((usize)b.modCap * @sizeof(Slice), 8);
        if (b.modKeys == null || b.modVals == null) { b.modCap = 0; return false; }
    }
    if (b.modLen >= b.modCap) return true; // table full; probing still works
    u8* k = bCStr(b.arena, key);
    u8* v = bCStr(b.arena, val);
    if (k == null || v == null) return false;
    b.modKeys[b.modLen] = Slice::from(k, key.len);
    b.modVals[b.modLen] = Slice::from(v, val.len);
    b.modLen++;
    return true;
}

bool bModTableHas(Builder* b, Slice key)
{
    u32 i = 0;
    while (i < b.modLen)
    {
        if (bEq(b.modKeys[i], key.asStr())) return true;
        i++;
    }
    return false;
}

/* register key under `prefix::NAME` and `NAME` for every alias of the
 * module folder plus the raw folder name */
void bRegisterExport(Builder* b, Slice folder, Slice name, Slice val)
{
    // raw: folder::name
    u8* k1 = (u8*)b.arena.alloc(folder.len + 2 + name.len + 1, 1);
    if (k1 != null)
    {
        usize n = 0;
        usize i = 0;
        while (i < folder.len) { k1[n] = folder.ptr[i]; n++; i++; }
        k1[n] = 58; k1[n + 1] = 58; n += 2;
        i = 0;
        while (i < name.len) { k1[n] = name.ptr[i]; n++; i++; }
        k1[n] = 0;
        if (!bModTableHas(b, Slice::from(k1, n))) bModTableAdd(b, Slice::from(k1, n), val);
        else
        {
            if (!b.quiet)
            {
                printf(C"E1002  duplicate module export\n  key:    ");
                usize q = 0;
                while (q < n) { printf(C"%c", k1[q]); q++; }
                printf(C"\n");
            }
            b.errors++;
        }
    }
    // alias: aliasname::name for each alias whose folder matches
    u32 ai = 0;
    while (ai < b.aliasesLen)
    {
        if (bEq(b.aliases[ai].folder, folder.asStr()))
        {
            u8* k2 = (u8*)b.arena.alloc(b.aliases[ai].name.len + 2 + name.len + 1, 1);
            if (k2 != null)
            {
                usize n = 0;
                usize i = 0;
                while (i < b.aliases[ai].name.len) { k2[n] = b.aliases[ai].name.ptr[i]; n++; i++; }
                k2[n] = 58; k2[n + 1] = 58; n += 2;
                i = 0;
                while (i < name.len) { k2[n] = name.ptr[i]; n++; i++; }
                k2[n] = 0;
                if (!bModTableHas(b, Slice::from(k2, n))) bModTableAdd(b, Slice::from(k2, n), val);
            }
        }
        ai++;
    }
}

bool bIsIdentChar(u8 c)
{
    if (c >= 97 && c <= 122) return true;
    if (c >= 65 && c <= 90) return true;
    if (c >= 48 && c <= 57) return true;
    if (c == 95) return true;
    return false;
}

/* try <base>/<path>.crl then <base>/<path>/lib.crl; returns a heap-allocated
 * path (release with dealloc<u8>) or null. base is a str. */
u8* bProbePath(str base, Slice path)
{
    usize bl = base.len;
    // room for BOTH candidates: base + '/' + path + "/lib.crl" + NUL
    usize cand = bl + 1 + path.len + 9 + 1;
    u8* p = alloc<u8>(cand);
    if (p == null) return null;
    usize n = 0;
    usize i = 0;
    while (i < bl) { p[n] = base.ptr[i]; n++; i++; }
    p[n] = 47; n++;
    i = 0;
    while (i < path.len) { p[n] = path.ptr[i]; n++; i++; }
    p[n] = 46; p[n + 1] = 99; p[n + 2] = 114; p[n + 3] = 108; p[n + 4] = 0;
    if (bFileExists(str { .ptr = p, .len = n + 4 })) return p;
    // <base>/<path>/lib.crl
    p[n] = 47; n++;
    str suf = "/lib.crl";
    i = 0;
    while (i < suf.len) { p[n] = suf.ptr[i]; n++; i++; }
    p[n] = 0;
    if (bFileExists(str { .ptr = p, .len = n })) return p;
    dealloc<u8>(p);
    return null;
}

/* line-scan one module's lib.crl for `pub mod NAME = import [ (x) ] PATH;`
 * and register every export in the module table. PATH is a namespace path
 * (ident (:: ident)*) or a quoted string (legacy: quotes are stripped). */
bool bScanReexports(Builder* b, Slice folder, str libPathC, Slice platRoot)
{
    usize len = 0;
    Slice content = bReadFile(b.arena, libPathC, &len);
    if (content.ptr == null) return true; // E1001 already covered existence
    u8* modDir = alloc<u8>(4096);
    if (modDir == null) return false;
    usize modDirLen = bJoin(modDir, 4096, b.rootDir, folder);
    usize i = 0;
    while (i < len)
    {
        // skip whitespace
        while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9 || content.ptr[i] == 10 || content.ptr[i] == 13)) i++;
        if (i >= len) break;
        // only `pub mod NAME = import ... ;` lines are re-exports
        if (i + 7 <= len && content.ptr[i] == 112 && content.ptr[i + 1] == 117 && content.ptr[i + 2] == 98 &&
            (i + 3 >= len || !bIsIdentChar(content.ptr[i + 3])))
        {
            i += 3;
            while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
            if (i + 3 <= len && content.ptr[i] == 109 && content.ptr[i + 1] == 111 && content.ptr[i + 2] == 100 &&
                (i + 3 >= len || !bIsIdentChar(content.ptr[i + 3])))
            {
                i += 3;
                while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
                usize nameStart = i;
                while (i < len && bIsIdentChar(content.ptr[i])) i++;
                usize nameLen = i - nameStart;
                while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
                if (i < len && content.ptr[i] == 61)
                {
                    i++;
                    while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
                    if (i + 6 <= len && content.ptr[i] == 105 && content.ptr[i + 1] == 109 && content.ptr[i + 2] == 112 &&
                        content.ptr[i + 3] == 111 && content.ptr[i + 4] == 114 && content.ptr[i + 5] == 116 &&
                        (i + 6 >= len || !bIsIdentChar(content.ptr[i + 6])))
                    {
                        i += 6;
                        while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
                        // optional (lib) marker
                        if (i < len && content.ptr[i] == 40)
                        {
                            while (i < len && content.ptr[i] != 41) i++;
                            if (i < len) i++;
                            while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;
                        }
                        u8* pathBuf = alloc<u8>(1024);
                        if (pathBuf != null)
                        {
                            usize pathLen = 0;
                            if (i < len && content.ptr[i] == 34)
                            {
                                i++;
                                while (i < len && content.ptr[i] != 34 && content.ptr[i] != 10 && pathLen < 1023)
                                {
                                    pathBuf[pathLen] = content.ptr[i];
                                    pathLen++;
                                    i++;
                                }
                                if (i < len && content.ptr[i] == 34) i++;
                            }
                            else
                            {
                                while (i < len && pathLen < 1023)
                                {
                                    if (bIsIdentChar(content.ptr[i])) { pathBuf[pathLen] = content.ptr[i]; pathLen++; i++; }
                                    else if (content.ptr[i] == 58 && i + 1 < len && content.ptr[i + 1] == 58 && pathLen < 1022)
                                    {
                                        pathBuf[pathLen] = 47; pathLen++; i += 2;
                                    }
                                    else break;
                                }
                            }
                            // skip to statement end
                            while (i < len && content.ptr[i] != 59 && content.ptr[i] != 10) i++;
                            if (i < len && content.ptr[i] == 59) i++;
                            if (nameLen > 0 && pathLen > 0)
                            {
                                /* resolve platform-first: <moddir>/<plat>/<path>.crl,
                                 * …/<path>/lib.crl, then base <moddir>/<path>.crl, …/lib.crl */
                                u8* resolved = null;
                                if (platRoot.len > 0)
                                {
                                    u8* platBase = alloc<u8>(4096);
                                    if (platBase != null)
                                    {
                                        usize pn = 0;
                                        usize q = 0;
                                        while (modDir[q] != 0 && pn < 4094) { platBase[pn] = modDir[q]; pn++; q++; }
                                        if (pn > 0 && platBase[pn - 1] != 47 && pn < 4094) { platBase[pn] = 47; pn++; }
                                        q = 0;
                                        while (q < platRoot.len && pn < 4094) { platBase[pn] = platRoot.ptr[q]; pn++; q++; }
                                        platBase[pn] = 0;
                                        resolved = bProbePath(str { .ptr = platBase, .len = pn }, Slice::from(pathBuf, pathLen));
                                        dealloc<u8>(platBase);
                                    }
                                }
                                if (resolved == null) resolved = bProbePath(str { .ptr = modDir, .len = modDirLen }, Slice::from(pathBuf, pathLen));
                                if (resolved != null)
                                {
                                    usize rl = 0;
                                    while (resolved[rl] != 0) rl++;
                                    Slice nameS = Slice::from(content.ptr + nameStart, (usize)nameLen);
                                    bRegisterExport(b, folder, nameS, Slice::from(resolved, (usize)rl));
                                    dealloc<u8>(resolved);
                                }
                                else
                                {
                                    if (!b.quiet)
                                    {
                                        printf(C"E1004  unresolved module export\n  module: ");
                                        usize q = 0;
                                        while (q < folder.len) { printf(C"%c", folder.ptr[q]); q++; }
                                        printf(C"\n  export: ");
                                        q = 0;
                                        while (q < nameLen) { printf(C"%c", content.ptr[nameStart + q]); q++; }
                                        printf(C"\n  path:   ");
                                        q = 0;
                                        while (q < pathLen) { printf(C"%c", pathBuf[q]); q++; }
                                        printf(C"\n");
                                    }
                                    b.errors++;
                                }
                            }
                            dealloc<u8>(pathBuf);
                        }
                        continue;
                    }
                }
            }
        }
        // not a re-export line: skip to end of line
        while (i < len && content.ptr[i] != 10) i++;
    }
    dealloc<u8>(modDir);
    return true;
}

/* build the in-memory module table: module surfaces + every `pub mod`
 * re-export they declare. Pass 1 registers surfaces (module + aliases),
 * pass 2 scans lib.crl files for exports. */
bool bBuildModuleTable(Builder* b)
{
    u32 m = 0;
    while (m < b.modulesLen)
    {
        u8* libP = alloc<u8>(4096);
        if (libP == null) return false;
        usize n = bJoin(libP, 4096, b.rootDir, b.modules[m]);
        str suf = "/lib.crl";
        usize k = 0;
        while (k < suf.len && n < 4095) { libP[n] = suf.ptr[k]; n++; k++; }
        libP[n] = 0;
        if (bFileExists(str { .ptr = libP, .len = n }))
        {
            // module surface: `module` → lib.crl; alias → lib.crl
            if (!bModTableHas(b, b.modules[m])) bModTableAdd(b, b.modules[m], Slice::from(libP, n));
            u32 ai = 0;
            while (ai < b.aliasesLen)
            {
                if (bEq(b.aliases[ai].folder, b.modules[m].asStr()))
                {
                    if (!bModTableHas(b, b.aliases[ai].name)) bModTableAdd(b, b.aliases[ai].name, Slice::from(libP, n));
                }
                ai++;
            }
        }
        dealloc<u8>(libP);
        m++;
    }
    Slice platRoot = bPlatformRoot(b);
    m = 0;
    while (m < b.modulesLen)
    {
        u8* libP = alloc<u8>(4096);
        if (libP == null) return false;
        usize n = bJoin(libP, 4096, b.rootDir, b.modules[m]);
        str suf = "/lib.crl";
        usize k = 0;
        while (k < suf.len && n < 4095) { libP[n] = suf.ptr[k]; n++; k++; }
        libP[n] = 0;
        if (bFileExists(str { .ptr = libP, .len = n })) bScanReexports(b, b.modules[m], str { .ptr = libP, .len = n }, platRoot);
        dealloc<u8>(libP);
        m++;
    }
    return true;
}

/* resolve the entry module to a source file:
 * <root><entry> when entry already ends in .crl (names the file directly),
 * <root><entry>.crl, <root><entry>/main.crl, <root><entry>/lib.crl */
bool bResolveEntry(Builder* b)
{
    if (b.entry.len == 0) return false;
    u8* cand = alloc<u8>(4096);
    if (cand == null) return false;
    /* the build-file worked example spells entry as an explicit file
     * (`entry = "coral-frontend/coral.crl"`): honor it instead of blindly
     * appending .crl to the name */
    bool hasCrl = b.entry.len >= 4;
    if (hasCrl)
    {
        if (b.entry.ptr[b.entry.len - 4] != 46) hasCrl = false;
        else if (b.entry.ptr[b.entry.len - 3] != 99) hasCrl = false;
        else if (b.entry.ptr[b.entry.len - 2] != 114) hasCrl = false;
        else if (b.entry.ptr[b.entry.len - 1] != 108) hasCrl = false;
    }
    usize n = bJoin(cand, 4096, b.rootDir, b.entry);
    if (hasCrl)
    {
        if (bFileExists(str { .ptr = cand, .len = n }))
        {
            b.entryPath = Slice::from(bCStr(b.arena, Slice::from(cand, n)), n);
            dealloc<u8>(cand);
            return true;
        }
    }
    if (n + 4 < 4095)
    {
        cand[n] = 46; cand[n + 1] = 99; cand[n + 2] = 114; cand[n + 3] = 108; cand[n + 4] = 0;
        if (bFileExists(str { .ptr = cand, .len = n + 4 }))
        {
            b.entryPath = Slice::from(bCStr(b.arena, Slice::from(cand, n + 4)), n + 4);
            dealloc<u8>(cand);
            return true;
        }
    }
    str mid = "/main.crl";
    n = bJoin(cand, 4096, b.rootDir, b.entry);
    usize k = 0;
    while (k < mid.len && n < 4095) { cand[n] = mid.ptr[k]; n++; k++; }
    cand[n] = 0;
    if (bFileExists(str { .ptr = cand, .len = n }))
    {
        b.entryPath = Slice::from(bCStr(b.arena, Slice::from(cand, n)), n);
        dealloc<u8>(cand);
        return true;
    }
    str libSuf = "/lib.crl";
    n = bJoin(cand, 4096, b.rootDir, b.entry);
    k = 0;
    while (k < libSuf.len && n < 4095) { cand[n] = libSuf.ptr[k]; n++; k++; }
    cand[n] = 0;
    if (bFileExists(str { .ptr = cand, .len = n }))
    {
        b.entryPath = Slice::from(bCStr(b.arena, Slice::from(cand, n)), n);
        dealloc<u8>(cand);
        return true;
    }
    dealloc<u8>(cand);
    if (!b.quiet)
    {
        printf(C"E1008  entry module not found\n  entry:  ");
        k = 0;
        while (k < b.entry.len) { printf(C"%c", b.entry.ptr[k]); k++; }
        printf(C"\n  tried:  <root><entry>.crl, <root><entry>/main.crl, <root><entry>/lib.crl\n");
    }
    b.errors++;
    return false;
}

/* write every module's fingerprint after a successful compile so the
 * next build can skip up-to-date work */
pub bool bWriteAllFps(Builder* b)
{
    u32 m = 0;
    bool ok = true;
    while (m < b.modulesLen)
    {
        if (!bWriteFp(b, m)) ok = false;
        m++;
    }
    return ok;
}

/* create the parent directory of a file path (for output=build/foo).
 * an existing directory is success (mkdir EEXIST). */
pub bool bMkdirParent(str path)
{
    i32 last = -1;
    usize i = 0;
    while (i < path.len) { if (path.ptr[i] == 47) last = (i32)i; i++; }
    if (last <= 0) return true;
    Result<bool, IoError> r = createDirRecursive(str { .ptr = path.ptr, .len = (usize)last }, 493);
    return r.isOk();
}

bool bWriteMap(Builder* b)
{
    createDirRecursive(".coral", 493);

    usize cap = 262144;
    u8* buf = alloc<u8>(cap);
    if (buf == null) return false;
    usize len = 0;
    str header = "# coral modules.map v1 — debug dump written by `coralc build`; the compiler uses the in-memory table\n";
    bApp(buf, cap, &len, header);

    // module dirs: + <name> → <rootDir><name>
    // the compiler reads these and expands each lib.crl itself
    u32 t = 0;
    while (t < b.modulesLen)
    {
        bApp(buf, cap, &len, "+ ");
        bApp(buf, cap, &len, b.modules[t].asStr());
        usize pad = b.modules[t].len + 2;
        while (pad < 24 && len < cap)
        {
            buf[len] = ' ';
            len++;
            pad++;
        }
        bApp(buf, cap, &len, " →  ");
        bApp(buf, cap, &len, bJoinStr(b.arena, b.rootDir, b.modules[t]));
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len++;
        }
        t++;
    }

    // aliases: @ <name> → <folder>
    if (b.aliasesLen > 0)
    {
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len++;
        }
        str ah = "# aliases (from build file)";
        bApp(buf, cap, &len, ah);
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len++;
        }
        u32 al = 0;
        while (al < b.aliasesLen)
        {
            bApp(buf, cap, &len, "@ ");
            bApp(buf, cap, &len, b.aliases[al].name.asStr());
            usize pad = b.aliases[al].name.len + 2;
            while (pad < 24 && len < cap)
            {
                buf[len] = ' ';
                len++;
                pad++;
            }
            bApp(buf, cap, &len, " →  ");
            bApp(buf, cap, &len, b.aliases[al].folder.asStr());
            if (len + 1 < cap)
            {
                buf[len] = '\n';
                len++;
            }
            al++;
        }
    }

    u8* mapC = alloc<u8>(4096);
    usize mi = 0;
    while (mi < b.mapPath.len && mi < 4095) { mapC[mi] = b.mapPath.ptr[mi]; mi++; }
    mapC[mi] = 0;
    // resolved table: key → path (what the loader actually consumes)
    if (b.modLen > 0)
    {
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len++;
        }
        str th = "# resolved module table (key → path)";
        bApp(buf, cap, &len, th);
        if (len + 1 < cap)
        {
            buf[len] = '\n';
            len++;
        }
        u32 e = 0;
        while (e < b.modLen)
        {
            bApp(buf, cap, &len, b.modKeys[e].asStr());
            bApp(buf, cap, &len, " → ");
            bApp(buf, cap, &len, b.modVals[e].asStr());
            if (len + 1 < cap)
            {
                buf[len] = '\n';
                len++;
            }
            e++;
        }
    }
    bool ok = bWriteFile(b.mapPath.asStr(), buf, len);
    if (!ok)
    {
        if (!b.quiet) printf(C"E1000  cannot write %s\n", mapC);
        b.errors++;
    }
    dealloc<u8>(buf);
    dealloc<u8>(mapC);
    return ok;
}

// walk each module's files, store the list, and fold content into the
// fingerprint. import resolution is the compiler's job, not the builder's.
bool bFingerprint(Builder* b)
{
    u32 m = 0;
    while (m < b.modulesLen)
    {
        Slice dirS = Slice::fromStr(bJoinStr(b.arena, b.rootDir, b.modules[m]));
        if (dirS.ptr == null) return false;

        Slice* files = (Slice*)b.arena.alloc(512 * @sizeof(Slice), 8);
        if (files == null) return false;
        u32 filesLen = 0;
        bCollectCrl(b.arena, dirS, b.skips, b.skipsLen, files, 512, &filesLen);
        bSortFiles(files, filesLen);
        b.mods[m].files = files;
        b.mods[m].filesLen = filesLen;

        u32 f = 0;
        while (f < filesLen)
        {
            usize flen = 0;
            Slice content = bReadFile(b.arena, files[f].asStr(), &flen);
            if (content.ptr != null)
            {
                b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, files[f].ptr, files[f].len);
                b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, content.ptr, flen);
            }
            f++;
        }
        /* build flags change codegen; fold them into every module's
         * fingerprint (build_sys.md §12: flags_for(module)) */
        u32 fl = 0;
        while (fl < b.crlbFlagPairs)
        {
            b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, b.crlbFlagNames[fl].ptr, b.crlbFlagNames[fl].len);
            b.mods[m].fingerprint = bFnv(b.mods[m].fingerprint, b.crlbFlagValues[fl].ptr, b.crlbFlagValues[fl].len);
            fl++;
        }
        m++;
    }
    return true;
}

// DFS topo + cycle detect
bool bDfs(Builder* b, u32 idx, u8* state, u32* stack, u32* stackLen, u32* out, u32* outLen)
{
    state[idx] = 1;
    stack[*stackLen] = idx;
    *stackLen += 1;
    u32 d = 0;
    while (d < b.mods[idx].depsLen)
    {
        u32 dep = b.mods[idx].deps[d];
        if (state[dep] == 1)
        {
            if (!b.quiet)
            {
                printf(C"E1006  dependency cycle\n  cycle:  ");
                u32 s = 0;
                while (s < *stackLen)
                {
                    usize n = 0;
                    u32 cIdx = stack[s];
                    while (n < b.mods[cIdx].name.len) { printf(C"%c", b.mods[cIdx].name.ptr[n]); n++; }
                    printf(C" -> ");
                    s++;
                }
                usize n = 0;
                while (n < b.mods[dep].name.len) { printf(C"%c", b.mods[dep].name.ptr[n]); n++; }
                printf(C"\n");
            }
            b.errors++;
            return false;
        }
        if (state[dep] == 0)
        {
            if (!bDfs(b, dep, state, stack, stackLen, out, outLen)) return false;
        }
        d++;
    }
    *stackLen -= 1;
    state[idx] = 2;
    out[*outLen] = idx;
    *outLen += 1;
    return true;
}

bool bTopo(Builder* b)
{
    u8* state = (u8*)b.arena.alloc((usize)b.modulesLen, 1);
    u32* stack = (u32*)b.arena.alloc((usize)b.modulesLen * @sizeof(u32), 4);
    u32* out = (u32*)b.arena.alloc((usize)b.modulesLen * @sizeof(u32), 4);
    if (state == null || stack == null || out == null) return false;
    u32 i = 0;
    while (i < b.modulesLen) { state[i] = 0; i++; }
    b.topoOrder = out;
    b.topoLen = 0;
    u32 stackLen = 0;
    i = 0;
    while (i < b.modulesLen)
    {
        if (state[i] == 0)
        {
            if (!bDfs(b, i, state, stack, &stackLen, out, &b.topoLen)) return false;
        }
        i++;
    }
    return true;
}

pub bool bAddEdge(Builder* b, u32 from, u32 to)
{
    if (from >= b.modulesLen || to >= b.modulesLen) return false;
    if (from == to) return true;
    ModNode* node = b->mods + from;
    u32 d = 0;
    while (d < node->depsLen)
    {
        if (node->deps[d] == to) return true;
        d++;
    }
    if (node->depsLen >= node->depsCap)
    {
        u32 newCap = 8;
        if (node->depsCap != 0) newCap = node->depsCap * 2;
        Arena* ar = b->arena;
        u32* fresh = (u32*)ar.alloc((usize)newCap * @sizeof(u32), 4);
        if (fresh == null) return false;
        u32 d2 = 0;
        while (d2 < node->depsLen)
        {
            fresh[d2] = node->deps[d2];
            d2++;
        }
        node->deps = fresh;
        node->depsCap = newCap;
    }
    node->deps[node->depsLen] = to;
    node->depsLen++;
    return true;
}

// load persisted edges: `.coral/graph` lines are `from -> to`, `#` comments
bool bLoadGraph(Builder* b)
{
    usize len = 0;
    Slice content = bReadFile(b->arena, ".coral/graph", &len);
    if (content.ptr == null) return true;
    usize i = 0;
    while (i < len)
    {
        usize lineStart = i;
        while (i < len && content.ptr[i] != '\n') i++;
        usize lineEnd = i;
        if (i < len) i++;
        usize p = lineStart;
        while (p < lineEnd && (content.ptr[p] == ' ' || content.ptr[p] == '\t' || content.ptr[p] == '\r')) p++;
        if (p >= lineEnd) continue;
        if (content.ptr[p] == '#') continue;
        usize fromStart = p;
        while (p < lineEnd && content.ptr[p] != ' ') p++;
        Slice from = Slice::from(content.ptr + fromStart, p - fromStart);
        while (p < lineEnd && content.ptr[p] == ' ') p++;
        if (p + 1 >= lineEnd) continue;
        if (content.ptr[p] != 45 || content.ptr[p + 1] != 62) continue;
        p += 2;
        while (p < lineEnd && content.ptr[p] == ' ') p++;
        usize toStart = p;
        while (p < lineEnd && content.ptr[p] != ' ' && content.ptr[p] != '\r') p++;
        Slice to = Slice::from(content.ptr + toStart, p - toStart);
        if (from.len == 0 || to.len == 0) continue;
        i32 fi = bModuleIdx(b, from);
        i32 ti = bModuleIdx(b, to);
        if (fi >= 0 && ti >= 0) bAddEdge(b, (u32)fi, (u32)ti);
    }
    return true;
}

pub bool bWriteGraph(Builder* b)
{
    createDirRecursive(".coral", 493);
    usize cap = 65536;
    u8* buf = alloc<u8>(cap);
    if (buf == null) return false;
    usize len = 0;
    str start = "digraph coral {\n  rankdir=BT;\n";
    bApp(buf, cap, &len, start);
    u32 m = 0;
    while (m < b.modulesLen)
    {
        u32 d = 0;
        while (d < b.mods[m].depsLen)
        {
            bApp(buf, cap, &len, "  \"");
            bApp(buf, cap, &len, b.mods[m].name.asStr());
            bApp(buf, cap, &len, "\" -> \"");
            u32 dep = b.mods[m].deps[d];
            bApp(buf, cap, &len, b.mods[dep].name.asStr());
            bApp(buf, cap, &len, "\";\n");
            d++;
        }
        m++;
    }
    bApp(buf, cap, &len, "}\n");
    bool ok = bWriteFile(".coral/graph.dot", buf, len);
    dealloc<u8>(buf);
    if (!ok)
    {
        if (!b.quiet) printf(C"E1000  cannot write .coral/graph.dot\n");
        b.errors++;
    }

    usize cap2 = 65536;
    u8* buf2 = alloc<u8>(cap2);
    if (buf2 == null) return false;
    usize len2 = 0;
    str header2 = "# coral module graph — `from -> to`, written by coralc\n";
    bApp(buf2, cap2, &len2, header2);
    u32 m2 = 0;
    while (m2 < b.modulesLen)
    {
        u32 d2 = 0;
        while (d2 < b.mods[m2].depsLen)
        {
            bApp(buf2, cap2, &len2, b.mods[m2].name.asStr());
            bApp(buf2, cap2, &len2, " -> ");
            u32 dep2 = b.mods[m2].deps[d2];
            bApp(buf2, cap2, &len2, b.mods[dep2].name.asStr());
            bApp(buf2, cap2, &len2, "\n");
            d2++;
        }
        m2++;
    }
    bool ok2 = bWriteFile(".coral/graph", buf2, len2);
    dealloc<u8>(buf2);
    if (!ok2)
    {
        if (!b.quiet) printf(C"E1000  cannot write .coral/graph\n");
        b.errors++;
    }
    return ok && ok2;
}

pub bool bWriteFp(Builder* b, u32 modIdx)
{
    createDirRecursive(".coral", 493);
    createDirRecursive(".coral/cache", 493);
    u8* pathC = alloc<u8>(512);
    if (pathC == null) return false;
    usize n = 0;
    str pre = ".coral/cache/";
    while (n < pre.len) { pathC[n] = pre.ptr[n]; n++; }
    usize i = 0;
    while (i < b.mods[modIdx].name.len && n < 500) { pathC[n] = b.mods[modIdx].name.ptr[i]; n++; i++; }
    str fp = ".fp";
    pathC[n] = fp.ptr[0]; pathC[n + 1] = fp.ptr[1]; pathC[n + 2] = fp.ptr[2]; pathC[n + 3] = 0;
    u8* hex = alloc<u8>(17);
    if (hex == null) { dealloc<u8>(pathC); return false; }
    u64 v = b.mods[modIdx].fingerprint;
    u32 s = 0;
    while (s < 16)
    {
        u32 nib = (u32)((v >> ((u64)(15 - s) * 4)) & 15);
        if (nib < 10) hex[s] = (u8)(48 + nib);
        else hex[s] = (u8)(87 + nib);
        s++;
    }
    hex[16] = 0;
    bool ok = bWriteFile(str { .ptr = pathC, .len = n + 3 }, hex, 16);
    dealloc<u8>(pathC);
    dealloc<u8>(hex);
    return ok;
}

bool bCheckFp(Builder* b, u32 modIdx)
{
    if (b.force) return true;
    u8* pathC = alloc<u8>(512);
    if (pathC == null) return true;
    usize n = 0;
    str pre = ".coral/cache/";
    while (n < pre.len) { pathC[n] = pre.ptr[n]; n++; }
    usize i = 0;
    while (i < b.mods[modIdx].name.len && n < 500) { pathC[n] = b.mods[modIdx].name.ptr[i]; n++; i++; }
    str fp = ".fp";
    pathC[n] = fp.ptr[0]; pathC[n + 1] = fp.ptr[1]; pathC[n + 2] = fp.ptr[2]; pathC[n + 3] = 0;
    usize len = 0;
    Slice got = bReadFile(b.arena, str { .ptr = pathC, .len = n + 3 }, &len);
    if (got.ptr == null || len < 16) { dealloc<u8>(pathC); return true; }
    u8* hex = alloc<u8>(17);
    if (hex == null) { dealloc<u8>(pathC); return true; }
    u64 v = b.mods[modIdx].fingerprint;
    u32 s = 0;
    while (s < 16)
    {
        u32 nib = (u32)((v >> ((u64)(15 - s) * 4)) & 15);
        if (nib < 10) hex[s] = (u8)(48 + nib);
        else hex[s] = (u8)(87 + nib);
        s++;
    }
    u32 c = 0;
    while (c < 16)
    {
        if (got.ptr[c] != hex[c]) { dealloc<u8>(pathC); dealloc<u8>(hex); return true; }
        c++;
    }
    dealloc<u8>(pathC);
    dealloc<u8>(hex);
    return false;
}

pub i32 builderRunEx(CrlbNode* cfgRoot, Arena* a, bool forceIn, bool emitMapOnlyIn, bool dryRunIn, bool quietIn, Builder* out)
{
    Builder b;
    if (!bInit(&b, a, cfgRoot, forceIn, emitMapOnlyIn, quietIn)) return (i32)b.errors;
    b.dryRun = dryRunIn;

    u32 m = 0;
    while (m < b.modulesLen)
    {
        if (!bScanLib(&b, b.modules[m]))
        {
            m++;
            continue;
        }
        m++;
    }
    if (b.errors > 0) return (i32)b.errors;

    if (!bValidateAliases(&b)) return (i32)b.errors;
    /* in-memory module table: surfaces + `pub mod` re-exports. The
     * compiler's loader consumes this directly at compile time. */
    if (!bBuildModuleTable(&b)) return (i32)b.errors;
    if (!bResolveEntry(&b)) return (i32)b.errors;
    // a dry run writes nothing: no modules.map, no graph, no cache
    if (!dryRunIn && !bWriteMap(&b)) return (i32)b.errors;
    if (emitMapOnlyIn)
    {
        if (!b.quiet)
        {
            if (dryRunIn) printf(C"coral: module map (dry run): %d modules, %d aliases, not written\n", (i32)b.modulesLen, (i32)b.aliasesLen);
            else printf(C"coral: module map: %d modules, %d aliases -> .coral/modules.map\n", (i32)b.modulesLen, (i32)b.aliasesLen);
        }
        if (out != null) out[0] = b;
        return (i32)b.errors;
    }
    if (forceIn)
    {
        /* --force bypasses the fingerprint/staleness computation entirely:
         * no source walk, no cache read: every module is forced stale.
         * the single plan line is printed with the staleness block below. */
    }
    else if (!bFingerprint(&b)) return (i32)b.errors;
    if (!bLoadGraph(&b)) return (i32)b.errors;
    if (!bTopo(&b)) return (i32)b.errors;
    if (!dryRunIn && !bWriteGraph(&b)) return (i32)b.errors;

    // staleness pass: fold dep fps into module fps (reverse topo = deps first)
    u32 i = 0;
    while (i < b.topoLen)
    {
        u32 idx = b.topoOrder[i];
        if (!forceIn)
        {
            u32 d = 0;
            while (d < b.mods[idx].depsLen)
            {
                u32 dep = b.mods[idx].deps[d];
                b.mods[idx].fingerprint = bFnv(b.mods[idx].fingerprint, (u8*)&b.mods[dep].fingerprint, 8);
                d++;
            }
            b.mods[idx].stale = bCheckFp(&b, idx);
        }
        if (b.mods[idx].stale) b.anyStale = true;
        i++;
    }

    if (!b.quiet)
    {
        /* one line, only what the reader acts on: how big the program is,
         * how much of it will be rebuilt, and why (--force / dry run).
         * The module order itself lives in .coral/modules.map for tools. */
        u32 staleCount = 0;
        if (forceIn) staleCount = b.modulesLen;
        else
        {
            i = 0;
            while (i < b.topoLen)
            {
                if (b.mods[b.topoOrder[i]].stale) staleCount++;
                i++;
            }
        }
        if (dryRunIn)
            printf(C"coral: build plan (dry run): %d modules, %d aliases, %d stale, .coral/modules.map not written\n",
                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);
        else if (forceIn)
            printf(C"coral: build plan: %d modules, %d aliases, %d stale (--force)\n",
                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);
        else
            printf(C"coral: build plan: %d modules, %d aliases, %d stale\n",
                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);
    }

    /* the compile phase runs in coralc.crl via compileUnitTo with this
     * builder's module table; discovery/staleness ends builderRunEx. */
    if (out != null) *out = b;
    return (i32)b.errors;
}

// signature kept for `coralc map`; forwards with dryRunIn = false
pub i32 builderRun(CrlbNode* cfgRoot, Arena* a, bool forceIn, bool emitMapOnlyIn, Builder* out)
{
    return builderRunEx(cfgRoot, a, forceIn, emitMapOnlyIn, false, false, out);
}
