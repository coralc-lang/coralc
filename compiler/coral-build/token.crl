#[[no_drop_all]]
import common::slice { Slice };

pub enum CrlbTokenKind
{
    Eof,
    Ident,
    String,
    Number,
    Bool,
    LBrace,
    RBrace,
    LBracket,
    RBracket,
    Equals,
    Semi,
    Comma,
    Error
}

pub struct CrlbToken
{
    CrlbTokenKind kind;
    Slice text;
    usize line;
    usize col;
    i64 numValue;
    bool boolValue;
}
