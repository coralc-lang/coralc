#[[no_drop_all]]
import common::slice { Slice };
import arena { Arena };

pub variant Value
{
    String { Slice value; },
    Number { i64 value; },
    Boolean { bool value; },
    List { ValueArray* value; }
}

pub struct ValueArray
{
    Value* data;
    usize len;
    usize cap;
    Arena* arena;
}

pub struct CrlbField
{
    Slice name;
    Value value;
}

pub struct FieldArray
{
    CrlbField* data;
    usize len;
    usize cap;
    Arena* arena;
}

pub struct ChildArray
{
    CrlbNode* data;
    usize len;
    usize cap;
    Arena* arena;
}

pub enum CrlbNodeKind
{
    Root,
    Schema,
    Strict,
    Build,
    Workspace,
    Profile,
    Alias,
    Task,
    Test,
    Bench,
    Hook,
    Phase,
    Target,
    Link,
    Artifact,
    Features,
    Env,
    Log,
    Metrics,
    Lint,
    Format,
    Lsp,
    Ci,
    Remote,
    Deps,
    DepEntry,
    Override,
    Include
}

pub str nodeKindName(CrlbNodeKind k)
{
    switch (k)
    {
        CrlbNodeKind::Root => { return "root"; },
        CrlbNodeKind::Schema => { return "schema"; },
        CrlbNodeKind::Strict => { return "strict"; },
        CrlbNodeKind::Build => { return "build"; },
        CrlbNodeKind::Workspace => { return "workspace"; },
        CrlbNodeKind::Profile => { return "profile"; },
        CrlbNodeKind::Alias => { return "alias"; },
        CrlbNodeKind::Task => { return "task"; },
        CrlbNodeKind::Test => { return "test"; },
        CrlbNodeKind::Bench => { return "bench"; },
        CrlbNodeKind::Hook => { return "hook"; },
        CrlbNodeKind::Phase => { return "phase"; },
        CrlbNodeKind::Target => { return "target"; },
        CrlbNodeKind::Link => { return "link"; },
        CrlbNodeKind::Artifact => { return "artifact"; },
        CrlbNodeKind::Features => { return "features"; },
        CrlbNodeKind::Env => { return "env"; },
        CrlbNodeKind::Log => { return "log"; },
        CrlbNodeKind::Metrics => { return "metrics"; },
        CrlbNodeKind::Lint => { return "lint"; },
        CrlbNodeKind::Format => { return "format"; },
        CrlbNodeKind::Lsp => { return "lsp"; },
        CrlbNodeKind::Ci => { return "ci"; },
        CrlbNodeKind::Remote => { return "remote"; },
        CrlbNodeKind::Deps => { return "deps"; },
        CrlbNodeKind::DepEntry => { return "dep_entry"; },
        CrlbNodeKind::Override => { return "override"; },
        CrlbNodeKind::Include => { return "include"; },
        else => { return "node"; }
    }
}

pub struct CrlbNode
{
    CrlbNodeKind kind;
    Slice label;
    bool hasLabel;
    Slice extendsTarget;
    bool hasExtends;
    Slice payload;
    bool hasPayload;
    FieldArray fields;
    ChildArray children;
    Arena* arena;

    void init(CrlbNodeKind k, Arena* a)
    {
        self.kind = k;
        self.arena = a;
        self.label.ptr = null;
        self.label.len = 0;
        self.hasLabel = false;
        self.extendsTarget.ptr = null;
        self.extendsTarget.len = 0;
        self.hasExtends = false;
        self.payload.ptr = null;
        self.payload.len = 0;
        self.hasPayload = false;
        self.fields.data = null;
        self.fields.len = 0;
        self.fields.cap = 0;
        self.fields.arena = a;
        self.children.data = null;
        self.children.len = 0;
        self.children.cap = 0;
        self.children.arena = a;
    }

    void addField(Slice name, Value v)
    {
        if (self.fields.len >= self.fields.cap)
        {
            usize newCap = 8;
            if (self.fields.cap != 0) newCap = self.fields.cap * 2;
            CrlbField* fresh = (CrlbField*)self.arena.alloc(newCap * @sizeof(CrlbField), 8);
            if (fresh == null) return;
            usize i = 0;
            while (i < self.fields.len)
            {
                fresh[i] = self.fields.data[i];
                i++; // use a fucking increment
            }
            self.fields.data = fresh;
            self.fields.cap = newCap;
        }
        self.fields.data[self.fields.len].name = name;
        self.fields.data[self.fields.len].value = v;
        self.fields.len++;
    }

    void addChild(CrlbNode* child)
    {
        if (self.children.len >= self.children.cap)
        {
            usize newCap = 8;
            if (self.children.cap != 0) newCap = self.children.cap * 2;
            CrlbNode* fresh = (CrlbNode*)self.arena.alloc(newCap * @sizeof(CrlbNode), 8);
            if (fresh == null) return;
            usize i = 0;
            while (i < self.children.len)
            {
                fresh[i] = self.children.data[i];
                i++;
            }
            self.children.data = fresh;
            self.children.cap = newCap;
        }
        self.children.data[self.children.len] = *child;
        self.children.len++;
    }
}

pub void valueArrayPush(ValueArray* arr, Value v)
{
    if (arr.len >= arr.cap)
    {
        usize newCap = 8;
        if (arr.cap != 0) newCap = arr.cap * 2;
        Value* fresh = (Value*)arr.arena.alloc(newCap * @sizeof(Value), 8);
        if (fresh == null) return;
        usize i = 0;
        while (i < arr.len)
        {
            fresh[i] = arr.data[i];
            i++;
        }
        arr.data = fresh;
        arr.cap = newCap;
    }
    arr.data[arr.len] = v;
    arr.len++;
}
