#[[no_drop_all]]
// module manifests: per-module `manifest.crlb` files declare
// target-conditional source roots, a fallback root, and k=v flags.
// `lib/manifest.crlb` doubles as the installed-library registry.
//
//   manifest "std" {
//       version  = "0.1.0";
//       fallback = "x86_64/linux";              // probed when no target matches
//       flags    = ["feature=1"];               // merged into the flag table
//       target "x86_64/linux"   { path = "x86_64/linux"; }
//       target "arm64/macos"    { path = "arm64/macos"; }
//   }
//
//   // lib/manifest.crlb — registry of installed libraries
//   manifest "lib" {
//       module "core" { path = "core"; }
//       module "std"  { path = "std"; }
//   }

use arena { Arena };
use ast { CrlbNode, CrlbNodeKind, CrlbField, Value, ValueArray };
use common::slice { Slice };
use parser { CrlbParser };
import std::mman { alloc, dealloc, realloc };
import std::fios { FileHandle, fileOpen, fileRead, fileClose };
import std::fs { IoError };
import std::result { Result };

pub struct ManifestTarget
{
    Slice triple;   // "arch/os" label of the target block
    Slice path;     // dir under the module dir (defaults to the triple)
}

pub struct ModuleManifest
{
    bool present;          // manifest.crlb exists and parsed
    bool parseFailed;      // file existed but did not parse
    Slice name;            // manifest label (module name)
    Slice version;
    Slice fallback;        // empty when undeclared
    bool hasFallback;
    Slice defaultTriple;   // registry-level default "arch/os" target
    bool hasDefaultTriple;
    Slice* flags;          // raw k=v strings
    u32 flagsLen;
    ManifestTarget* targets;
    u32 targetsLen;
    /* registry children (`module "name" { path = "..."; }`) — only
     * populated for lib/manifest.crlb */
    Slice* modNames;
    Slice* modPaths;
    /* per-module opt-in: the registry entry's `extends` relationship —
     * `module "std" extends "manifest.crlb" { }` (or field
     * `extends = "…"`) activates that file as the module's manifest.
     * null ptr = not activated; the slice is the manifest file name
     * relative to the module dir (empty → "manifest.crlb") */
    Slice* modExtends;
    u32 modsLen;
    u32 modsCap;
    bool flagsMerged;   // loader-side: flags already merged into ctx
    /* `warnings = false` in a module manifest: files under the module
     * root have warnings suppressed (errors still report) */
    bool warnOff;
}

Slice mReadFile(Arena* a, str path, usize* outLen)
{
    *outLen = 0;
    Result<FileHandle, IoError> fo = fileOpen(path, "rb");
    if (fo.isErr()) return Slice { null, 0 };
    FileHandle fh = fo.unwrap();
    usize cap = 65536;
    u8* buf = alloc<u8>(cap);
    if (buf == null) { fileClose(fh); return Slice { null, 0 }; }
    usize len = 0;
    while (true)
    {
        if (len >= cap)
        {
            usize newCap = cap * 2;
            u8* fresh = realloc<u8>(buf, newCap);
            if (fresh == null) break;
            buf = fresh;
            cap = newCap;
        }
        Result<usize, IoError> rr = fileRead(fh, buf + len, cap - len);
        if (rr.isErr()) break;
        usize got = rr.unwrap();
        if (got == 0) break;
        len += got;
    }
    fileClose(fh);
    u8* cp = (u8*)a->alloc(len + 1, 1);
    if (cp == null) { dealloc<u8>(buf); return Slice { null, 0 }; }
    u8* dst = cp;
    u8* src = buf;
    usize i = 0;
    while (i < len) { dst[i] = src[i]; i++; }
    cp[len] = 0;
    dealloc<u8>(buf);
    *outLen = len;
    return Slice::from(cp, len);
}

CrlbField* mFindField(CrlbNode* n, Slice name)
{
    usize i = 0;
    while (i < n->fields.len)
    {
        if (n->fields.data[i].name.len == name.len)
        {
            bool eq = true;
            usize k = 0;
            while (k < name.len) { if (n->fields.data[i].name.ptr[k] != name.ptr[k]) { eq = false; break; } k++; }
            if (eq) return n->fields.data + i;
        }
        i++;
    }
    return null;
}

bool mFieldStr(CrlbNode* n, Slice name, Slice* out)
{
    CrlbField* f = mFindField(n, name);
    if (f == null) return false;
    if (f->value.tag != Value::String) return false;
    *out = f->value.payload.String.value;
    return true;
}

bool mFieldBool(CrlbNode* n, Slice name, bool* out)
{
    CrlbField* f = mFindField(n, name);
    if (f == null) return false;
    if (f->value.tag != Value::Boolean) return false;
    *out = f->value.payload.Boolean.value;
    return true;
}

u32 mFieldList(CrlbNode* n, Slice name, Arena* a, Slice* out, u32 cap)
{
    CrlbField* f = mFindField(n, name);
    if (f == null) return 0;
    if (f->value.tag != Value::List) return 0;
    ValueArray* va = f->value.payload.List.value;
    if (va == null || va->len == 0 || va->len > (usize)cap) return 0;
    u32 i = 0;
    while (i < (u32)va->len)
    {
        if (va->data[i].tag != Value::String) return 0;
        out[i] = va->data[i].payload.String.value;
        i++;
    }
    return (u32)va->len;
}

/* the `extends` target a module/override block declares: the parser's
 * positional `extends "x"` wins, then an `extends = "x"` field. Empty
 * (null ptr) when the block does not extend anything. */
Slice mExtendsOf(CrlbNode* c, Arena* a)
{
    if (c->hasExtends && c->extendsTarget.ptr != null)
        return c->extendsTarget;
    Slice ex;
    if (mFieldStr(c, Slice::fromStr("extends"), &ex)) return ex;
    return Slice { null, 0 };
}

/* parse <path> as a crlb manifest file. Returns null when the file does
 * not exist; otherwise a manifest (present=false + parseFailed set on
 * bad syntax). Everything is arena-owned; the caller keeps the arena
 * alive. */
pub ModuleManifest* bLoadManifestFile(Arena* a, Slice pathS)
{
    usize len = 0;
    Slice content = mReadFile(a, pathS.asStr(), &len);
    if (content.ptr == null) return null;

    ModuleManifest* m = (ModuleManifest*)a->alloc(@sizeof(ModuleManifest), 8);
    if (m == null) return null;
    m->present = false;
    m->parseFailed = false;
    m->name = Slice { null, 0 };
    m->version = Slice { null, 0 };
    m->fallback = Slice { null, 0 };
    m->hasFallback = false;
    m->defaultTriple = Slice { null, 0 };
    m->hasDefaultTriple = false;
    m->flags = null;
    m->flagsLen = 0;
    m->targets = null;
    m->targetsLen = 0;
    m->modNames = null;
    m->modPaths = null;
    m->modExtends = null;
    m->modsLen = 0;
    m->modsCap = 0;
    m->flagsMerged = false;
    m->warnOff = false;

    CrlbParser p;
    p.init(a, content);
    p.quiet = true;
    CrlbNode* root = p.parseFile();
    if (root == null || p.errors > 0) { m->parseFailed = true; return m; }

    /* the manifest decl: `manifest "name" { ... }` — take the first
     * Manifest child; a manifest file may also carry registry `module`
     * children at top level for lib/manifest.crlb */
    CrlbNode* body = null;
    usize i = 0;
    while (i < root->children.len)
    {
        CrlbNode* c = root->children.data + i;
        if (c->kind == CrlbNodeKind::Manifest) { body = c; break; }
        i++;
    }
    m->present = true;
    if (body != null)
    {
        m->name = body->label;
        Slice v;
        if (mFieldStr(body, Slice::fromStr("version"), &v)) m->version = v;
        if (mFieldStr(body, Slice::fromStr("fallback"), &v)) { m->fallback = v; m->hasFallback = true; }
        if (mFieldStr(body, Slice::fromStr("default"), &v)) { m->defaultTriple = v; m->hasDefaultTriple = true; }
        m->flags = (Slice*)a->alloc(64 * @sizeof(Slice), 8);
        if (m->flags != null) m->flagsLen = mFieldList(body, Slice::fromStr("flags"), a, m->flags, 64);
        /* `nowarn` in flags suppresses warning rendering for the
         * module's files (errors still report). Warnings are on by
         * default — flags only ever suppress. */
        {
            u32 wi = 0;
            while (wi < m->flagsLen)
            {
                Slice e = m->flags[wi];
                if (e.len == 6 && e.ptr[0] == 'n' && e.ptr[1] == 'o' &&
                    e.ptr[2] == 'w' && e.ptr[3] == 'a' && e.ptr[4] == 'r' &&
                    e.ptr[5] == 'n') m->warnOff = true;
                wi++;
            }
        }

        u32 tc = 0;
        u32 tcCap = 0;
        ManifestTarget* tbuf = null;
        u32 mc = 0;
        u32 mcCap = 0;
        Slice* nbuf = null;
        Slice* pbuf = null;
        Slice* ebuf = null;
        i = 0;
        while (i < body->children.len)
        {
            CrlbNode* c = body->children.data + i;
            if (c->kind == CrlbNodeKind::Target && c->hasLabel)
            {
                /* nested form: target "arch" { platform "os" { path=… } }
                 * expands to "arch/os" triples — one arch can carry
                 * several OS trees. A target with no platform children
                 * is the flat "arch/os" (or direct-path) form. */
                bool hasPlatChild = false;
                usize sub = 0;
                while (sub < c->children.len)
                {
                    if (c->children.data[sub].kind == CrlbNodeKind::Platform) { hasPlatChild = true; break; }
                    sub++;
                }
                if (hasPlatChild)
                {
                    sub = 0;
                    while (sub < c->children.len)
                    {
                        CrlbNode* pc = c->children.data + sub;
                        if (pc->kind == CrlbNodeKind::Platform && pc->hasLabel)
                        {
                            if (tc >= tcCap)
                            {
                                tcCap = tcCap == 0 ? 8 : tcCap * 2;
                                ManifestTarget* ng = (ManifestTarget*)a->alloc((usize)tcCap * @sizeof(ManifestTarget), 8);
                                if (ng != null && tbuf != null)
                                {
                                    u32 q = 0;
                                    while (q < tc) { ng[q] = tbuf[q]; q++; }
                                }
                                tbuf = ng;
                            }
                            if (tbuf != null && tc < tcCap)
                            {
                                usize tl = c->label.len + 1 + pc->label.len;
                                u8* ts = (u8*)a->alloc(tl + 1, 1);
                                if (ts != null)
                                {
                                    usize w = 0;
                                    usize q = 0;
                                    while (q < c->label.len) { ts[w] = c->label.ptr[q]; w++; q++; }
                                    ts[w] = 47; w++;
                                    q = 0;
                                    while (q < pc->label.len) { ts[w] = pc->label.ptr[q]; w++; q++; }
                                    ts[w] = 0;
                                    Slice triple = Slice::from(ts, tl);
                                    Slice pp;
                                    if (!mFieldStr(pc, Slice::fromStr("path"), &pp)) pp = triple;
                                    tbuf[tc].triple = triple;
                                    tbuf[tc].path = pp;
                                    tc++;
                                }
                            }
                        }
                        sub++;
                    }
                }
                else
                {
                    if (tc >= tcCap)
                    {
                        tcCap = tcCap == 0 ? 8 : tcCap * 2;
                        ManifestTarget* ng = (ManifestTarget*)a->alloc((usize)tcCap * @sizeof(ManifestTarget), 8);
                        if (ng != null && tbuf != null)
                        {
                            u32 q = 0;
                            while (q < tc) { ng[q] = tbuf[q]; q++; }
                        }
                        tbuf = ng;
                    }
                    if (tbuf != null && tc < tcCap)
                    {
                        Slice tp = c->label;
                        Slice pp;
                        if (!mFieldStr(c, Slice::fromStr("path"), &pp)) pp = tp;
                        tbuf[tc].triple = tp;
                        tbuf[tc].path = pp;
                        tc++;
                    }
                }
            }
            else if (c->kind == CrlbNodeKind::Module && c->hasLabel)
            {
                if (mc >= mcCap)
                {
                    mcCap = mcCap == 0 ? 8 : mcCap * 2;
                    Slice* nn = (Slice*)a->alloc((usize)mcCap * @sizeof(Slice), 8);
                    Slice* pp2 = (Slice*)a->alloc((usize)mcCap * @sizeof(Slice), 8);
                    Slice* ee = (Slice*)a->alloc((usize)mcCap * @sizeof(Slice), 8);
                    if (nn != null && pp2 != null && ee != null && nbuf != null && pbuf != null && ebuf != null)
                    {
                        u32 q = 0;
                        while (q < mc) { nn[q] = nbuf[q]; pp2[q] = pbuf[q]; ee[q] = ebuf[q]; q++; }
                    }
                    nbuf = nn;
                    pbuf = pp2;
                    ebuf = ee;
                }
                if (nbuf != null && pbuf != null && ebuf != null && mc < mcCap)
                {
                    Slice mp = c->label;
                    Slice pp;
                    if (!mFieldStr(c, Slice::fromStr("path"), &pp)) pp = mp;
                    nbuf[mc] = mp;
                    pbuf[mc] = pp;
                    ebuf[mc] = mExtendsOf(c, a);
                    mc++;
                }
            }
            i++;
        }
        m->targets = tbuf;
        m->targetsLen = tc;
        m->modNames = nbuf;
        m->modPaths = pbuf;
        m->modExtends = ebuf;
        m->modsLen = mc;
        m->modsCap = mcCap;
    }
    /* registry shorthand: top-level `module "x" { }` decls (no
     * manifest wrapper) also count as registry entries */
    i = 0;
    while (i < root->children.len)
    {
        CrlbNode* c = root->children.data + i;
        if (c->kind == CrlbNodeKind::Module && c->hasLabel)
        {
            if (m->modNames == null)
            {
                m->modNames = (Slice*)a->alloc(256 * @sizeof(Slice), 8);
                m->modPaths = (Slice*)a->alloc(256 * @sizeof(Slice), 8);
                m->modExtends = (Slice*)a->alloc(256 * @sizeof(Slice), 8);
                m->modsCap = 256;
            }
            if (m->modsLen >= m->modsCap) break;
            if (m->modNames != null && m->modPaths != null && m->modExtends != null)
            {
                Slice mp = c->label;
                Slice pp;
                if (!mFieldStr(c, Slice::fromStr("path"), &pp)) pp = mp;
                m->modNames[m->modsLen] = mp;
                m->modPaths[m->modsLen] = pp;
                m->modExtends[m->modsLen] = mExtendsOf(c, a);
                m->modsLen++;
            }
        }
        i++;
    }
    return m;
}

/* <dir>/<file> as a NUL-terminated arena path */
str mJoinPath(Arena* a, Slice dir, Slice file)
{
    u8* p = (u8*)a->alloc(dir.len + file.len + 2, 1);
    if (p == null) return str { null, 0 };
    usize n = 0;
    usize i = 0;
    while (i < dir.len) { p[n] = dir.ptr[i]; n++; i++; }
    if (n > 0 && p[n - 1] != 47) { p[n] = 47; n++; }
    i = 0;
    while (i < file.len) { p[n] = file.ptr[i]; n++; i++; }
    p[n] = 0;
    return str { .ptr = p, .len = n };
}

/* parse <dir>/manifest.crlb — the default manifest file name */
pub ModuleManifest* bLoadManifest(Arena* a, Slice dirS)
{
    str path = mJoinPath(a, dirS, Slice::fromStr("manifest.crlb"));
    if (path.ptr == null) return null;
    return bLoadManifestFile(a, Slice::from(path.ptr, path.len));
}

/* parse <dir>/<file> — `file` comes from a registry/override `extends`
 * target; empty means the default manifest.crlb */
pub ModuleManifest* bLoadManifestAs(Arena* a, Slice dirS, Slice file)
{
    if (file.ptr == null || file.len == 0) return bLoadManifest(a, dirS);
    str path = mJoinPath(a, dirS, file);
    if (path.ptr == null) return null;
    return bLoadManifestFile(a, Slice::from(path.ptr, path.len));
}

/* the platform root this module should probe for build target `triple`:
 * the matching target block's path, else the fallback, else an empty
 * slice (manifest present but nothing matches → base dir only).
 * When no manifest exists the caller uses the global platform root. */
pub Slice bManifestPlatRoot(ModuleManifest* m, Slice triple)
{
    if (m == null || !m->present) return Slice { null, 0 };
    u32 i = 0;
    while (i < m->targetsLen)
    {
        Slice t = m->targets[i].triple;
        if (t.len == triple.len)
        {
            bool eq = true;
            usize k = 0;
            while (k < t.len) { if (t.ptr[k] != triple.ptr[k]) { eq = false; break; } k++; }
            if (eq) return m->targets[i].path;
        }
        i++;
    }
    if (m->hasFallback) return m->fallback;
    return Slice { C"", 0 };
}
