// ---- module ----

module "structs"

// ---- types ----

type @Pair = struct { x: i32, y: i64 };

// ---- funcs ----

func @main() i32 {
entry:
    %p = alloca struct @Pair
    %px = gep %p, 0
    %py = gep %p, 1
    store i32 7, %px
    store i64 50, %py
    %x = load i32 %px
    %xe = zext i32 %x to i64
    %y = load i64 %py
    %s = add i64 %xe, %y
    %r = trunc i64 %s to i32
    ret i32 %r
}
