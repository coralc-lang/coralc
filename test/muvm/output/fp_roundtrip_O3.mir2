// ---- module ----

module "fp_roundtrip"

// ---- globals ----

global @g: f64 = 1.5 !alignment = 8;

// ---- funcs ----

func @main() i32 {
entry:
    %x = load f64 @g
    %i = fptosi f64 %x to i64
    %f = sitofp i64 %i to f64
    %c = fcmp oeq f64 %f, %x
    %r = zext i1 %c to i32
    ret i32 %r
}
