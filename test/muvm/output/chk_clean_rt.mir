// ---- module ----

module "clean"

// ---- strings ----

string @.Lcs48: "main";

string @.Lcs49: "?";

string @.Lcs51: "?";

string @.Lcs59: "?";

string @.Lcs65: "?";

string @.Lcs67: "?";

string @.Lcs73: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    br fill

sum_pre:
    br sum

fill:
    %80 = phi i64 [ 0, entry ], [ %in, fill_body ]
    %fc = icmp slt i64 %80, 5
    cond_br %fc, fill_body, sum_pre

fill_body:
    call void @_trap(i64 0, i64 %80, i64 5, array i8 2 @.Lcs49, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %slot = gep %arr, %80
    %val = add i64 %80, 1
    %52 = xor i64 %80, %val !loc = "?", 0, 0
    %53 = xor i64 %val, 1 !loc = "?", 0, 0
    %54 = and i64 %52, %53 !loc = "?", 0, 0
    %56 = ashr i64 %54, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %56, i64 0, array i8 2 @.Lcs51, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %val, %slot
    %in = add i64 %80, 1
    %60 = xor i64 %80, %in !loc = "?", 0, 0
    %61 = xor i64 %in, 1 !loc = "?", 0, 0
    %62 = and i64 %60, %61 !loc = "?", 0, 0
    %63 = ashr i64 %62, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %63, i64 0, array i8 2 @.Lcs59, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    br fill

sum:
    %81 = phi i64 [ 0, sum_pre ], [ %acc, sum_body ]
    %79 = phi i64 [ 0, sum_pre ], [ %jn, sum_body ]
    %sc = icmp slt i64 %79, 5
    cond_br %sc, sum_body, done

sum_body:
    call void @_trap(i64 0, i64 %79, i64 5, array i8 2 @.Lcs65, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %slot2 = gep %arr, %79
    %elem = load i64 %slot2
    %acc = add i64 %81, %elem
    %68 = xor i64 %81, %acc !loc = "?", 0, 0
    %69 = xor i64 %elem, %acc !loc = "?", 0, 0
    %70 = and i64 %68, %69 !loc = "?", 0, 0
    %71 = ashr i64 %70, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %71, i64 0, array i8 2 @.Lcs67, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %jn = add i64 %79, 1
    %74 = xor i64 %79, %jn !loc = "?", 0, 0
    %75 = xor i64 %jn, 1 !loc = "?", 0, 0
    %76 = and i64 %74, %75 !loc = "?", 0, 0
    %77 = ashr i64 %76, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %77, i64 0, array i8 2 @.Lcs73, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    br sum

done:
    %r32 = trunc i64 %81 to i32
    ret i32 %r32
}

func @_trap() extern;
