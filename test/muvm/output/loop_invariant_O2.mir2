// ---- module ----

module "loop_invariant"

// ---- funcs ----

func @main() i32 {
entry:
    br loop

loop:
    %31 = phi i64 [ 0, entry ], [ %acc, body ]
    %30 = phi i64 [ 0, entry ], [ %next, body ]
    %cmp = icmp slt i64 %30, 10
    cond_br %cmp, body, done

done:
    %r32 = trunc i64 %31 to i32
    ret i32 %r32

body:
    %acc = add i64 %31, 21
    %next = add i64 %30, 1
    br loop
}
