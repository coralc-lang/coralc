// ---- module ----

module "nonnull"

// ---- globals ----

global @z: i64 = 0 !alignment = 8;

// ---- strings ----

string @.Lcs10: "main";

string @.Lcs11: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %n = load ptr @z
    call void @_trap(i64 1, ptr %n, i64 0, array i8 2 @.Lcs11, i64 0, array i8 5 @.Lcs10) !loc = "?", 0, 0
    %v = load i64 %n
    %t = trunc i64 %v to i32
    ret i32 %t
}

func @_trap() extern;
