// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    br outer

outer:
    br inner

ibody:
    %fc = icmp eq i64 %flag, 7
    cond_br %fc, imerge, imerge

imerge:
    br ilatch

inner:
    %j = phi i64 [ 0, outer ], [ %jn, ilatch ]
    br ibody

ilatch:
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, outer
}

func @main() i32 {
entry:
    %r = call i64 @nest(i64 7)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
