// ---- module ----

module "dedup"

// ---- strings ----

string @.Lcs21: "main";

string @.Lcs22: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    call void @_trap(i64 0, i64 0, i64 5, array i8 2 @.Lcs22, i64 0, array i8 5 @.Lcs21) !loc = "?", 0, 0
    %g0 = gep %arr, 0
    store i64 1, %g0
    br body

body:
    store i64 1, %g0
    store i64 1, %g0
    ret i32 0
}

func @_trap() extern;
