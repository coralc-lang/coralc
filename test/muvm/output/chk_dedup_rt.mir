// ---- module ----

module "dedup"

// ---- strings ----

string @.Lcs21: "main";

string @.Lcs22: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    %j = load i64 %i
    call void @_trap(i64 0, i64 %j, i64 5, array i8 2 @.Lcs22, i64 0, array i8 5 @.Lcs21) !loc = "?", 0, 0
    %g0 = gep %arr, %j
    store i64 1, %g0
    br body

body:
    %g1 = gep %arr, %j
    store i64 1, %g1
    %g2 = gep %arr, %j
    store i64 1, %g2
    ret i32 0
}

func @_trap() extern;
