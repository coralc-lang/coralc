// ---- module ----

module "fib_iter"

// ---- funcs ----

func @main() i32 {
entry:
    br loop

loop:
    %33 = phi i64 [ 0, entry ], [ %sum, body ]
    %32 = phi i64 [ 1, entry ], [ %33, body ]
    %31 = phi i64 [ 0, entry ], [ %next, body ]
    %cmp = icmp slt i64 %31, 10
    cond_br %cmp, body, done

body:
    %sum = add i64 %32, %33
    %next = add i64 %31, 1
    br loop

done:
    %r32 = trunc i64 %33 to i32
    ret i32 %r32
}
