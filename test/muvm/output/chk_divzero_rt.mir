// ---- module ----

module "divzero"

// ---- strings ----

string @.Lcs12: "main";

string @.Lcs13: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %z = alloca i64
    store i64 0, %z
    %d = load i64 %z
    call void @_trap(i64 2, i64 %d, i64 0, array i8 2 @.Lcs13, i64 0, array i8 5 @.Lcs12) !loc = "?", 0, 0
    %q = sdiv i64 100, %d
    %t = trunc i64 %q to i32
    ret i32 %t
}

func @_trap() extern;
