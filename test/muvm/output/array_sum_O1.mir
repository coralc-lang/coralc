// ---- module ----

module "array_sum"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    br fill

fill:
    %48 = phi i64 [ 0, entry ], [ %in, fill_body ]
    %fc = icmp slt i64 %48, 5
    cond_br %fc, fill_body, sum

sum:
    %49 = phi i64 [ 0, fill ], [ %acc, sum_body ]
    %47 = phi i64 [ 0, fill ], [ %jn, sum_body ]
    %sc = icmp slt i64 %47, 5
    cond_br %sc, sum_body, done

done:
    %r32 = trunc i64 %49 to i32
    ret i32 %r32

sum_body:
    %slot2 = gep %arr, %47
    %elem = load i64 %slot2
    %acc = add i64 %49, %elem
    %jn = add i64 %47, 1
    br sum

fill_body:
    %slot = gep %arr, %48
    %val = add i64 %48, 1
    store i64 %val, %slot
    %in = add i64 %48, 1
    br fill
}
