// ---- module ----

module "oob"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    br loop

loop:
    %25 = phi i64 [ 0, entry ], [ %n2, body ]
    %c = icmp slt i64 %25, 7
    cond_br %c, body, done

done:
    ret i32 0

body:
    %slot = gep %arr, %25
    store i64 1, %slot
    %n2 = add i64 %25, 1
    br loop
}
