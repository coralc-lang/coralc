// ---- module ----

module "oob"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    br loop

loop:
    %iv = load i64 %i
    %c = icmp slt i64 %iv, 7
    cond_br %c, body, done

body:
    %j = load i64 %i
    %slot = gep %arr, %j
    store i64 1, %slot
    %n = load i64 %i
    %n2 = add i64 %n, 1
    store i64 %n2, %i
    br loop

done:
    ret i32 0
}
