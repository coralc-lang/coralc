// ---- module ----

module "tco_acc"

// ---- funcs ----

func @sumto(%n: i64) i64 {
entry:
    %c = icmp sle i64 %n, 0
    cond_br %c, base, step

step:
    %m = sub i64 %n, 1
    %r = call i64 @sumto(i64 %m)
    %s = add i64 %r, %n
    ret i64 %s

base:
    ret i64 0
}

func @main() i32 {
entry:
    %v = call i64 @sumto(i64 5)
    %r = trunc i64 %v to i32
    ret i32 %r
}
