// ---- module ----

module "sum_loop"

// ---- funcs ----

func @main() i32 {
entry:
    br loop

loop:
    %29 = phi i64 [ 0, entry ], [ %acc, body ]
    %28 = phi i64 [ 0, entry ], [ %next, body ]
    %cmp = icmp slt i64 %28, 10
    cond_br %cmp, body, done

done:
    %r32 = trunc i64 %29 to i32
    ret i32 %r32

body:
    %acc = add i64 %29, %28
    %next = add i64 %28, 1
    br loop
}
