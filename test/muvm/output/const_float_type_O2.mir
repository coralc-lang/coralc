// ---- module ----

module "const_float_type"

// ---- globals ----

global @g: i32 = 3 !alignment = 4;

// ---- funcs ----

func @main() i32 {
entry:
    %si = fptosi f32 0.0 to i32
    %x = load i32 @g
    %d = sitofp i32 %x to f64
    %t = fadd f64 1.0, %d
    %ti = fptosi f64 %t to i32
    %r = add i32 %si, %ti
    ret i32 %r
}
