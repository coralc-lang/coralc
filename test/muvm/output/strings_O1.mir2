// ---- module ----

module "strings"

// ---- globals ----

global @first: ptr ptr i8 = 0 !alignment = 8;

// ---- strings ----

string @msg: "abc";

// ---- funcs ----

func @main() i32 {
entry:
    %p0 = gep @msg, 0
    %p1 = gep @msg, 1
    store ptr i8 %p0, @first
    %b0 = load i8 %p0
    %b1 = load i8 %p1
    %q = load ptr @first
    %qa = bitcast ptr %q to ptr array i8 0
    %q2 = gep %qa, 2
    %b2 = load i8 %q2
    %e0 = zext i8 %b0 to i64
    %e1 = zext i8 %b1 to i64
    %e2 = zext i8 %b2 to i64
    %x1 = xor i64 %e0, %e1
    %x = xor i64 %x1, %e2
    %r = trunc i64 %x to i32
    ret i32 %r
}
