// ---- module ----

module "parsed"

// ---- funcs ----

func @main() i32 {
entry:
    %p = alloca i64
    br loop

loop:
    %ph = phi ptr [ %p, entry ], [ %ph, body ]
    %v = load i64 %ph
    %cmp = icmp slt i64 %v, 7
    cond_br %cmp, body, done

body:
    store i64 7, %ph
    br loop

done:
    %r = trunc i64 %v to i32
    ret i32 %r
}
