// ---- module ----

module "parsed"

// ---- funcs ----

func @main() i32 {
entry:
    %a = alloca i64
    %b = alloca i64
    %f = alloca i64
    store i64 0, %a
    store i64 5, %b
    store i64 1, %f
    store i8 1, %f
    %fv = load i64 %f
    %c = icmp sgt i64 %fv, 0
    cond_br %c, els, then

then:
    store i64 10, %a
    br merge

els:
    store i64 20, %b
    br merge

merge:
    %ph = phi ptr [ %a, then ], [ %b, els ]
    %v1 = load i64 %ph
    store i64 30, %b
    %v2 = load i64 %ph
    %sum = add i64 %v1, %v2
    %r = trunc i64 %sum to i32
    ret i32 %r
}
