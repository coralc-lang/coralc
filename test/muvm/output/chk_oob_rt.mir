// ---- module ----

module "oob"

// ---- strings ----

string @.Lcs27: "main";

string @.Lcs28: "?";

string @.Lcs30: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    br loop

loop:
    %38 = phi i64 [ 0, entry ], [ %n2, body ]
    %c = icmp slt i64 %38, 7
    cond_br %c, body, done

done:
    ret i32 0

body:
    call void @_trap(i64 0, i64 %38, i64 5, array i8 2 @.Lcs28, i64 0, array i8 5 @.Lcs27) !loc = "?", 0, 0
    %slot = gep %arr, %38
    store i64 1, %slot
    %n2 = add i64 %38, 1
    %31 = xor i64 %38, %n2 !loc = "?", 0, 0
    %32 = xor i64 %n2, 1 !loc = "?", 0, 0
    %33 = and i64 %31, %32 !loc = "?", 0, 0
    %35 = ashr i64 %33, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %35, i64 0, array i8 2 @.Lcs30, i64 0, array i8 5 @.Lcs27) !loc = "?", 0, 0
    br loop
}

func @_trap() extern;
