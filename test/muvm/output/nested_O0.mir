// ---- module ----

module "nested"

// ---- funcs ----

func @main() i32 {
entry:
    br outer

done:
    ret i32 0

outer:
    %44 = phi i64 [ 0, entry ], [ %in, inner_done ]
    %oc = icmp slt i64 %44, 4
    cond_br %oc, inner, done

inner_done:
    %in = add i64 %44, 1
    br outer

inner:
    %46 = phi i64 [ 0, outer ], [ %jn, inner_body ]
    %ic = icmp slt i64 %46, 3
    cond_br %ic, inner_body, inner_done

inner_body:
    %jn = add i64 %46, 1
    br inner
}
