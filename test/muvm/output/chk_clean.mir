// ---- module ----

module "clean"

// ---- strings ----

string @.Lcs48: "main";

string @.Lcs49: "?";

string @.Lcs51: "?";

string @.Lcs59: "?";

string @.Lcs65: "?";

string @.Lcs67: "?";

string @.Lcs73: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    br fill

fill:
    %iv = load i64 %i
    %fc = icmp slt i64 %iv, 5
    cond_br %fc, fill_body, sum_pre

fill_body:
    %iv2 = load i64 %i
    call void @_trap(i64 0, i64 %iv2, i64 5, array i8 2 @.Lcs49, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %slot = gep %arr, %iv2
    %val = add i64 %iv2, 1
    %52 = xor i64 %iv2, %val !loc = "?", 0, 0
    %53 = xor i64 %val, 1 !loc = "?", 0, 0
    %54 = and i64 %52, %53 !loc = "?", 0, 0
    %56 = ashr i64 %54, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %56, i64 0, array i8 2 @.Lcs51, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %val, %slot
    %iv3 = load i64 %i
    %in = add i64 %iv3, 1
    %60 = xor i64 %iv3, %in !loc = "?", 0, 0
    %61 = xor i64 %in, 1 !loc = "?", 0, 0
    %62 = and i64 %60, %61 !loc = "?", 0, 0
    %63 = ashr i64 %62, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %63, i64 0, array i8 2 @.Lcs59, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %in, %i
    br fill

sum_pre:
    store i64 0, %i
    %s = alloca i64
    store i64 0, %s
    br sum

sum:
    %jv = load i64 %i
    %sc = icmp slt i64 %jv, 5
    cond_br %sc, sum_body, done

sum_body:
    %jv2 = load i64 %i
    call void @_trap(i64 0, i64 %jv2, i64 5, array i8 2 @.Lcs65, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %slot2 = gep %arr, %jv2
    %elem = load i64 %slot2
    %sv = load i64 %s
    %acc = add i64 %sv, %elem
    %68 = xor i64 %sv, %acc !loc = "?", 0, 0
    %69 = xor i64 %elem, %acc !loc = "?", 0, 0
    %70 = and i64 %68, %69 !loc = "?", 0, 0
    %71 = ashr i64 %70, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %71, i64 0, array i8 2 @.Lcs67, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %acc, %s
    %jv3 = load i64 %i
    %jn = add i64 %jv3, 1
    %74 = xor i64 %jv3, %jn !loc = "?", 0, 0
    %75 = xor i64 %jn, 1 !loc = "?", 0, 0
    %76 = and i64 %74, %75 !loc = "?", 0, 0
    %77 = ashr i64 %76, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %77, i64 0, array i8 2 @.Lcs73, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %jn, %i
    br sum

done:
    %res = load i64 %s
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}

func @_trap() extern;
