// ---- module ----

module "asm_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %x = alloca i64
    %res = alloca i64
    store i64 7, %x
    inlineasm void "movq %1, %0\naddq $1, %0" : "=r,m" : "cc" (ptr i64 %res, ptr i64 %x)
    %v = load i64 %res
    %v32 = trunc i64 %v to i32
    ret i32 %v32
}
