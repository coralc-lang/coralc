// ---- module ----

module "gcd"

// ---- funcs ----

func @main() i32 {
entry:
    br loop

loop:
    %27 = phi i64 [ 18, entry ], [ %r, body ]
    %26 = phi i64 [ 48, entry ], [ %27, body ]
    %cmp = icmp ne i64 %27, 0
    cond_br %cmp, body, done

body:
    %r = srem i64 %26, %27
    br loop

done:
    %r32 = trunc i64 %26 to i32
    ret i32 %r32
}
