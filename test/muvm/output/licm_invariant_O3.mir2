// ---- module ----

module "licmparam"

// ---- funcs ----

func @invariant_square(%n: i64) i64 {
entry:
    br licm.preheader

licm.preheader:
    %inv = mul i64 %n, %n
    br loop

loop:
    %i = phi i64 [ 0, licm.preheader ], [ %in, body ]
    %a = phi i64 [ 0, licm.preheader ], [ %acc, body ]
    %cmp = icmp slt i64 %i, 7
    cond_br %cmp, body, done

body:
    %in = add i64 %i, 1
    %acc = add i64 %a, %inv
    br loop

done:
    ret i64 %acc
}
