// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 3
    %brr = alloca array i64 3
    %crr = alloca array i64 3
    %drr = alloca array i64 3
    %s0 = gep %arr, 0
    store i64 10, %s0
    %s1 = gep %arr, 1
    store i64 20, %s1
    %t0 = gep %brr, 0
    store i64 1, %t0
    %t1 = gep %brr, 1
    store i64 2, %t1
    br loop1

loop1:
    %i = phi i64 [ 0, entry ], [ %i1, body1 ]
    %pa = gep %arr, %i
    %pb = gep %brr, %i
    %va = load i64 %pa
    %vb = load i64 %pb
    store i64 %va, %pb
    store i64 %vb, %pa
    br loop2_pre

loop2_pre:
    br loop2

loop2:
    %j = phi i64 [ 0, loop2_pre ], [ %j1, body2 ]
    %ca = gep %arr, %j
    %va2 = load i64 %ca
    %suma = add i64 %va2, 10
    %cc = gep %crr, %j
    store i64 %suma, %cc
    %db = gep %brr, %j
    %vb2 = load i64 %db
    %sumb = add i64 %vb2, 20
    %dd = gep %drr, %j
    store i64 %sumb, %dd
    br done

done:
    %ra = gep %arr, 1
    %rav = load i64 %ra
    %rc = gep %crr, 1
    %rcv = load i64 %rc
    %rd = gep %drr, 1
    %rdv = load i64 %rd
    %x1 = add i64 %rav, %rcv
    %res = add i64 %x1, %rdv
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
