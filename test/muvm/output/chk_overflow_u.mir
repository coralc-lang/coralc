// ---- module ----

module "overflow_u"

// ---- strings ----

string @.Lcs11: "main";

string @.Lcs12: "?";

string @.Lcs20: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %n = add i32 -1, 0
    %13 = xor i32 -1, %n !loc = "?", 0, 0
    %14 = xor i32 0, %n !loc = "?", 0, 0
    %15 = and i32 %13, %14 !loc = "?", 0, 0
    %17 = ashr i32 %15, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %17, i64 0, array i8 2 @.Lcs12, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    %x = add.u i32 %n, 1
    %21 = icmp ult i32 %x, %n !loc = "?", 0, 0
    %22 = select i1 %21, i32 1, i32 0 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %22, i64 0, array i8 2 @.Lcs20, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    ret i32 %x
}

func @_trap() extern;
