// ---- module ----

module "countdown"

// ---- funcs ----

func @main() i32 {
entry:
    br loop

loop:
    %29 = phi i64 [ 0, entry ], [ %acc, body ]
    %28 = phi i64 [ 10, entry ], [ %next, body ]
    %cmp = icmp sgt i64 %28, 0
    cond_br %cmp, body, done

body:
    %acc = add i64 %29, %28
    %next = sub i64 %28, 1
    br loop

done:
    %r32 = trunc i64 %29 to i32
    ret i32 %r32
}
