// ---- module ----

module "overflow_sub"

// ---- strings ----

string @.Lcs11: "main";

string @.Lcs12: "?";

string @.Lcs20: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %m = sub i32 -1073741824, 1073741824
    %13 = xor i32 -1073741824, 1073741824 !loc = "?", 0, 0
    %14 = xor i32 -1073741824, %m !loc = "?", 0, 0
    %15 = and i32 %13, %14 !loc = "?", 0, 0
    %17 = ashr i32 %15, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %17, i64 0, array i8 2 @.Lcs12, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    %x = sub i32 %m, 1
    %21 = xor i32 %m, 1 !loc = "?", 0, 0
    %22 = xor i32 %m, %x !loc = "?", 0, 0
    %23 = and i32 %21, %22 !loc = "?", 0, 0
    %24 = ashr i32 %23, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %24, i64 0, array i8 2 @.Lcs20, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    ret i32 %x
}

func @_trap() extern;
