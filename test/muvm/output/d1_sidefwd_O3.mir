// ---- module ----

module "d1_sidefwd"

// ---- globals ----

global @holder: ptr i32 = 0 !alignment = 8;

global @input: i32 = 1 !alignment = 4;

// ---- funcs ----

func @main() i32 {
entry:
    %p = alloca i32
    store i32 42, %p
    store ptr i32 %p, @holder
    %x = load i32 @input
    %c = icmp eq i32 %x, 0
    cond_br %c, side, head

head:
    %v = load i32 %p
    ret i32 %v

side:
    store i32 99, %p
    ret i32 0
}
