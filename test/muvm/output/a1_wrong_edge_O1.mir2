// ---- module ----

module "a1_wrong_edge"

// ---- globals ----

global @gx: i32 = 3 !alignment = 4;

global @gy: i32 = 10 !alignment = 4;

// ---- funcs ----

func @main() i32 {
entry:
    %x = load i32 @gx
    %y = load i32 @gy
    %c = icmp slt i32 %x, %y
    cond_br %c, A, B

A:
    %c2 = icmp sge i32 %x, %y
    cond_br %c2, B, X

X:
    ret i32 1

B:
    ret i32 2
}
