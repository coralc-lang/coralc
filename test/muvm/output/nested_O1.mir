// ---- module ----

module "nested"

// ---- funcs ----

func @main() i32 {
entry:
    br outer

outer:
    %46 = phi i64 [ 0, entry ], [ %45, inner_done ]
    %44 = phi i64 [ 0, entry ], [ %in, inner_done ]
    %oc = icmp slt i64 %44, 4
    cond_br %oc, inner, done

done:
    %r32 = trunc i64 %46 to i32
    ret i32 %r32

inner:
    %47 = phi i64 [ 0, outer ], [ %jn, inner_body ]
    %45 = phi i64 [ %46, outer ], [ %acc, inner_body ]
    %ic = icmp slt i64 %47, 3
    cond_br %ic, inner_body, inner_done

inner_done:
    %in = add i64 %44, 1
    br outer

inner_body:
    %prod = mul i64 %44, %47
    %acc = add i64 %45, %prod
    %jn = add i64 %47, 1
    br inner
}
