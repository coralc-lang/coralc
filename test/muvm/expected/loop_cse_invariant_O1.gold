// ---- module ----

module "lc_invariant2"

// ---- funcs ----

func @run(%n: i64) i64 {
entry:
    %arr = alloca array i64 4
    %k0 = gep %arr, 0
    store i64 99, %k0
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, latch ]
    %ac = phi i64 [ 0, entry ], [ %nac, latch ]
    %k = gep %arr, 0
    %v = load i64 %k
    %use = add i64 %v, 7
    %ac2 = mul i64 %use, 2
    %nac = add i64 %ac, %ac2
    br latch

latch:
    %in = add i64 %i, 1
    %cmp = icmp slt i64 %in, %n
    cond_br %cmp, loop, done

done:
    ret i64 %nac
}
