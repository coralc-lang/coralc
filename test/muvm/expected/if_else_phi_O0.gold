// ---- module ----

module "if_else_phi"

// ---- funcs ----

func @main() i32 {
entry:
    %cmp = icmp sgt i64 7, 5
    cond_br %cmp, then, els

els:
    %e2 = sub i64 0, 7
    br merge

then:
    %t2 = mul i64 7, 2
    br merge

merge:
    %r = phi i64 [ %t2, then ], [ %e2, els ]
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
