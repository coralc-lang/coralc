#[[no_drop_all]]
// muvm driver test tool: parse a .ir module, run the muvm driver's
// function-stage pipeline (O0-O3), print the result.
// No backend exists yet, so this is the check-point for the driver:
// exit code 0 means the module round-triped the driver path cleanly.
// run.sh feeds every case through this binary and compares fixpoints.
import muvm::muvm { MuvmOptions, muvmOptions, muvmOptimize, muvmStructureLane, muvmCompileModule, CallingConvention, SafetyMode };
import muvm::irtypes { IrContext, IrModule, IrFunc, irCtxCreate, irCtxDestroy };
import muvm::irParser { IrParser, new, destroy, parseModule, getError, getErrorLine };
import muvm::irPrinter { IrPrinter };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import std::ios { println, eprintln };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 2 || argc > 4)
    {
        eprintln("usage: muvm_tool <in.ir> [out.mir] [O0|O1|O2|O3]");
        eprintln("       muvm_tool --emit-ir <in.ir>   (print IR to stdout)");
        return 2;
    }
    str inPath = str::fromCstr(argv[1]);
    bool emitIr = inPath.equals("--emit-ir");
    if (emitIr)
    {
        if (argc < 3)
        {
            eprintln("usage: muvm_tool --emit-ir <in.ir>");
            return 2;
        }
        inPath = str::fromCstr(argv[2]);
    }
    u32 opt = 2;
    bool safety = false;
    for (u32 ai = 2; ai < (u32)argc; ai++)
    {
        str a = str::fromCstr(argv[ai]);
        if (a.equals("O0")) opt = 0;
        else if (a.equals("O1")) opt = 1;
        else if (a.equals("O2")) opt = 2;
        else if (a.equals("O3")) opt = 3;
        else if (a.equals("--safety")) safety = true;
    }

    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("muvm_tool: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();
    IrContext* ctx = irCtxCreate();
    IrParser p = new(ctx);
    IrModule* modd = parseModule(&p, src.asView());
    if (modd == null)
    {
        eprintln("{}:{}: {}", inPath, getErrorLine(&p), getError(&p));
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    MuvmOptions o = muvmOptions(opt);
    if (safety) o.safety = SafetyMode::All;
    for (u32 i = 0; i < modd->nfuncs; i++)
    {
        IrFunc* f = modd->funcs[i];
        if (f == null || f->isExtern) continue;
        muvmOptimize(f, ctx, CallingConvention::SystemV, o);
        muvmStructureLane(f, ctx, o);
    }

    IrPrinter pr = IrPrinter::new();
    pr.printModule(modd);

    if (emitIr)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }

    str outPath = str::empty();
    for (u32 ai = 2; ai < (u32)argc; ai++)
    {
        str a = str::fromCstr(argv[ai]);
        bool isLevel = a.equals("O0") || a.equals("O1") || a.equals("O2") || a.equals("O3");
        if (!isLevel) { outPath = a; break; }
    }
    if (outPath.len == 0)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }
    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("muvm_tool: cannot create {}", outPath);
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }
    File f = fo.unwrap();
    fileWrite(f, pr.output().ptr, (usize)pr.output().len);
    fileClose(f);
    pr.destroy();
    destroy(&p);
    src.free();
    irCtxDestroy(ctx);
    return 0;
}
