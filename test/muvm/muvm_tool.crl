#[[no_drop_all]]
// muvm driver test tool: parse a .ir module, run the muvm driver's
// function-stage pipeline (O0-O3), print the result.
// No backend exists yet, so this is the check-point for the driver:
// exit code 0 means the module round-triped the driver path cleanly.
// run.sh feeds every case through this binary and compares fixpoints.
import muvm::muvm { MuvmOptions, muvmOptions, muvmOptimize, muvmStructureLane, muvmCompileModule, CallingConvention, SafetyMode };
import muvm::passes::verify { muvmPassVerify };
import muvm::irtypes { IrContext, IrModule, IrFunc, irCtxCreate, irCtxDestroy };
import muvm::irParser { IrParser, new, destroy, parseModule, getError, getErrorLine };
import muvm::irPrinter { IrPrinter };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import std::ios { println, eprintln };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 2)
    {
        eprintln("usage: muvm_tool <in.ir> [out.mir] [O0|O1|O2|O3] [--safety] [--dumps] [--verbose] [--verify] [--verify-each] [--verify-before]");
        eprintln("       muvm_tool --emit-ir <in.ir> [--safety] [--dumps] [--verbose] [--verify] [--verify-each] [--verify-before]");
        return 2;
    }
    str inPath = str::empty();
    str outPath = str::empty();
    bool emitIr = false;
    bool safety = false;
    bool dumps = false;
    bool verbose = false;
    bool verifyEach = false;
    bool verifyAfter = false;
    bool verifyBefore = false;
    u32 opt = 2;
    u32 nPos = 0;
    for (u32 ai = 1; ai < (u32)argc; ai++)
    {
        str a = str::fromCstr(argv[ai]);
        if (a.equals("--emit-ir")) { emitIr = true; continue; }
        if (a.equals("--safety")) { safety = true; continue; }
        if (a.equals("--dumps")) { dumps = true; continue; }
        if (a.equals("--verbose")) { verbose = true; continue; }
        if (a.equals("--verify")) { verifyAfter = true; continue; }
        if (a.equals("--verify-each")) { verifyEach = true; continue; }
        if (a.equals("--verify-before")) { verifyBefore = true; continue; }
        if (a.equals("O0")) { opt = 0; continue; }
        if (a.equals("O1")) { opt = 1; continue; }
        if (a.equals("O2")) { opt = 2; continue; }
        if (a.equals("O3")) { opt = 3; continue; }
        if (a.equals("--dumps")) { dumps = true; continue; }
        if (nPos == 0) { inPath = a; nPos = 1; continue; }
        if (nPos == 1) { outPath = a; nPos = 2; continue; }
    }
    if (inPath.len == 0)
    {
        eprintln("usage: muvm_tool <in.ir> [out.mir] [O0|O1|O2|O3] [--safety]");
        return 2;
    }

    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("muvm_tool: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();
    IrContext* ctx = irCtxCreate();
    IrParser p = new(ctx);
    IrModule* modd = parseModule(&p, src.asView());
    if (modd == null)
    {
        eprintln("{}:{}: {}", inPath, getErrorLine(&p), getError(&p));
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    MuvmOptions o = muvmOptions(opt);
    if (safety) o.safety = SafetyMode::All;
    if (dumps) o.dumps = true;
    if (verbose) o.verbose = true;
    if (verifyEach) o.verify = true;
    bool verifyFail = false;
    for (u32 i = 0; i < modd->nfuncs; i++)
    {
        IrFunc* f = modd->funcs[i];
        if (f == null || f->isExtern) continue;
        if (verifyBefore)
            if (!muvmPassVerify(f, null)) { verifyFail = true; }
        muvmOptimize(f, ctx, CallingConvention::SystemV, o);
        muvmStructureLane(f, ctx, o);
        if (verifyAfter)
            if (!muvmPassVerify(f, null)) { verifyFail = true; }
    }

    if (verifyFail) { eprintln("muvm_tool: IR verification FAILED"); return 3; }

    IrPrinter pr = IrPrinter::new();
    pr.printModule(modd);

    if (emitIr)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }

    if (outPath.len == 0)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }
    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("muvm_tool: cannot create {}", outPath);
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }
    File f = fo.unwrap();
    fileWrite(f, pr.output().ptr, (usize)pr.output().len);
    fileClose(f);
    pr.destroy();
    destroy(&p);
    src.free();
    irCtxDestroy(ctx);
    return 0;
}
