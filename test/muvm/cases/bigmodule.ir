module "bigmodule"

global @g: i64 = 3;

func @square(%n: i64) i64 {
entry:
    %m = mul i64 %n, %n
    ret i64 %m
}

func @cube(%n: i64) i64 {
entry:
    %q = mul i64 %n, %n
    %c = mul i64 %q, %n
    ret i64 %c
}

func @sum_to(%n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done
body:
    %acc = add i64 %s, %i
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %s
}

func @collatz(%n: i64) i64 {
entry:
    br loop
loop:
    %x = phi i64 [ %n, entry ], [ %next, body ]
    %steps = phi i64 [ 0, entry ], [ %sn, body ]
    %one = icmp eq i64 %x, 1
    cond_br %one, done, body
body:
    %one1 = and i64 %x, 1
    %h = lshr i64 %x, 1
    %t3 = mul i64 %x, 3
    %t4 = add i64 %t3, 1
    %odd = icmp eq i64 %one1, 1
    %next = select i1 %odd, i64 %t4, i64 %h
    %sn = add i64 %steps, 1
    br loop
done:
    ret i64 %steps
}

func @fib(%n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %a = phi i64 [ 0, entry ], [ %b, body ]
    %b = phi i64 [ 1, entry ], [ %c, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done
body:
    %c = add i64 %a, %b
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %a
}

func @sum_squares_range(%lo: i64, %hi: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [ %lo, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %hi
    cond_br %cmp, body, done
body:
    %sq = mul i64 %i, %i
    %acc = add i64 %s, %sq
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %s
}

func @fact(%n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [ 1, entry ], [ %in, body ]
    %acc = phi i64 [ 1, entry ], [ %ac, body ]
    %cmp = icmp sle i64 %i, %n
    cond_br %cmp, body, done
body:
    %ac = mul i64 %acc, %i
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %acc
}

func @gcd(%a0: i64, %b0: i64) i64 {
entry:
    br loop
loop:
    %a = phi i64 [ %a0, entry ], [ %b, body ]
    %b = phi i64 [ %b0, entry ], [ %r, body ]
    %cmp = icmp eq i64 %b, 0
    cond_br %cmp, done, body
body:
    %r = srem i64 %a, %b
    br loop
done:
    ret i64 %a
}

func @count_bits(%v: i64) i64 {
entry:
    br loop
loop:
    %x = phi i64 [ %v, entry ], [ %nx, body ]
    %s = phi i64 [ 0, entry ], [ %ns, body ]
    %cmp = icmp eq i64 %x, 0
    cond_br %cmp, done, body
body:
    %one = and i64 %x, 1
    %ns = add i64 %s, %one
    %nx = lshr i64 %x, 1
    br loop
done:
    ret i64 %s
}

func @poly(%x: i64) i64 {
entry:
    %q = mul i64 %x, %x
    %t1 = mul i64 2, %x
    %u1 = add i64 %q, %t1
    %u2 = add i64 %u1, 1
    %q2 = mul i64 %x, %x
    %t2 = mul i64 2, %x
    %v1 = add i64 %q2, %t2
    %v2 = add i64 %v1, 1
    %r = add i64 %u2, %v2
    ret i64 %r
}

func @invar_loop(%n: i64, %k: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done
body:
    %inv = mul i64 %k, 7
    %acc = add i64 %s, %inv
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %s
}

func @big_switch(%c: i64) i64 {
entry:
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, case0, n1
n1:
    %c1 = icmp eq i64 %c, 1
    cond_br %c1, case1, n2
n2:
    %c2 = icmp eq i64 %c, 2
    cond_br %c2, case2, n3
n3:
    %c3 = icmp eq i64 %c, 3
    cond_br %c3, case3, n4
n4:
    %c4 = icmp eq i64 %c, 4
    cond_br %c4, case4, n5
n5:
    %c5 = icmp eq i64 %c, 5
    cond_br %c5, case5, n6
n6:
    %c6 = icmp eq i64 %c, 6
    cond_br %c6, case6, n7
n7:
    %c7 = icmp eq i64 %c, 7
    cond_br %c7, case7, n8
n8:
    %c8 = icmp eq i64 %c, 8
    cond_br %c8, case8, n9
n9:
    %c9 = icmp eq i64 %c, 9
    cond_br %c9, case9, case10
case0:
    ret i64 1
case1:
    ret i64 2
case2:
    ret i64 4
case3:
    ret i64 8
case4:
    ret i64 16
case5:
    ret i64 32
case6:
    ret i64 64
case7:
    ret i64 128
case8:
    ret i64 256
case9:
    ret i64 512
case10:
    ret i64 1024
}

func @const_chain() i64 {
entry:
    %a = add i64 1, 2
    %b = mul i64 %a, 3
    %c = mul i64 4, 5
    %d = add i64 %b, %c
    %e = add i64 %d, 6
    %f = mul i64 %e, 7
    ret i64 %f
}

func @redundant(%x: i64) i64 {
entry:
    %y = xor i64 %x, %x
    %r = icmp eq i64 %y, 1
    %res = select i1 %r, i64 999, i64 42
    ret i64 %res
}

func @xor_self(%x: i64) i64 {
entry:
    %r = xor i64 %x, %x
    ret i64 %r
}

func @select_real(%x: i64, %y: i64) i64 {
entry:
    %c = icmp sgt i64 %x, %y
    %r = select i1 %c, i64 %x, i64 %y
    ret i64 %r
}

func @phi_const_combo(%a: i64, %b: i64) i64 {
entry:
    %c = icmp sgt i64 %a, %b
    cond_br %c, small, big
small:
    br merge
big:
    br merge
merge:
    %r = phi i64 [ 100, small ], [ 200, big ]
    %r1 = add i64 %r, 1
    ret i64 %r1
}

func @same_pick(%c: i1, %x: i64, %y: i64) i64 {
entry:
    %r = select i1 %c, i64 %x, i64 %y
    ret i64 %r
}

func @select_same(%c: i1, %v: i64) i64 {
entry:
    %r = select i1 %c, i64 %v, i64 %v
    ret i64 %r
}

func @main() i32 {
entry:
    %g = load i64 @g
    %sq = call i64 @square(i64 %g)
    %cb = call i64 @cube(i64 %g)
    %s = call i64 @sum_to(i64 8)
    %f = call i64 @fib(i64 10)
    %ss = call i64 @sum_squares_range(i64 1, i64 8)
    %ft = call i64 @fact(i64 5)
    %gd = call i64 @gcd(i64 1071, i64 462)
    %bc = call i64 @count_bits(i64 12345)
    %pl = call i64 @poly(i64 3)
    %iv = call i64 @invar_loop(i64 4, i64 5)
    %bs = call i64 @big_switch(i64 7)
    %cc = call i64 @const_chain()
    %rd = call i64 @redundant(i64 9)
    %xs = call i64 @xor_self(i64 123)
    %sr = call i64 @select_real(i64 10, i64 20)
    %sp = call i64 @same_pick(i1 1, i64 7, i64 9)
    %ssq = call i64 @select_same(i1 0, i64 99)
    %pc = call i64 @phi_const_combo(i64 3, i64 5)
    %tot0 = add i64 %sq, %cb
    %tot1 = add i64 %tot0, %s
    %tot2 = add i64 %tot1, %f
    %tot3 = add i64 %tot2, %ss
    %tot4 = add i64 %tot3, %ft
    %tot5 = add i64 %tot4, %gd
    %tot6 = add i64 %tot5, %bc
    %tot7_add1 = add i64 %tot6, %pl
    %tot7_add2 = add i64 %tot7_add1, %iv
    %tot7_add3 = add i64 %tot7_add2, %bs
    %tot7_add4 = add i64 %tot7_add3, %cc
    %tot7_add5 = add i64 %tot7_add4, %rd
    %tot7_add6 = add i64 %tot7_add5, %xs
    %tot7_add7 = add i64 %tot7_add6, %sr
    %tot7_add8 = add i64 %tot7_add7, %sp
    %tot7_add9 = add i64 %tot7_add8, %ssq
    %tot7 = add i64 %tot7_add9, %pc
    %tot8 = and i64 %tot7, 255
    %t = trunc i64 %tot8 to i32
    ret i32 %t
}
