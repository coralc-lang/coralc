// expect: 14
// if/else merge through a phi (non-loop phi path)
module "if_else_phi"

func @main() i32 {
entry:
    %x = alloca i64
    store i64 7, %x
    %v = load i64 %x
    %cmp = icmp sgt i64 %v, 5
    cond_br %cmp, then, els

then:
    %t = load i64 %x
    %t2 = mul i64 %t, 2
    br merge

els:
    %e = load i64 %x
    %e2 = sub i64 0, %e
    br merge

merge:
    %r = phi i64 [ %t2, then ], [ %e2, els ]
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
