// divmod: both udiv(x, y) and urem(x, y) computed, div has >=2 uses →
// rem fused into x - div*y
module "divmod_demo"

func @divrem3(%x: i64, %y: i64) i64 {
entry:
    %q = sdiv i64 %x, %y
    %q2 = mul i64 %q, 10
    %q3 = add i64 %q, %q2
    %r = srem i64 %x, %y
    %sum = add i64 %q3, %r
    ret i64 %sum
}

func @urem_fused3(%x: i64, %y: i64) i64 {
entry:
    %q = udiv i64 %x, %y
    %q2 = mul i64 %q, 10
    %q3 = add i64 %q, %q2
    %r = urem i64 %x, %y
    %sum = add i64 %q3, %r
    ret i64 %sum
}
// opposite: div with only one use stays as-is (no redundant div to fuse)
func @no_fusion_single_use(%x: i64, %y: i64) i64 {
entry:
    %q = sdiv i64 %x, %y
    %r = srem i64 %x, %y
    %sum = add i64 %q, %r
    ret i64 %sum
}
