// expect: 252
module "licmparam"

func @main() i32 {
entry:
    %r = call i64 @invariant_square(i64 6)
    %t = trunc i64 %r to i32
    ret i32 %t
}

func @invariant_square(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [0, entry], [%in, body]
    %a = phi i64 [0, entry], [%acc, body]
    %cmp = icmp slt i64 %i, 7
    cond_br %cmp, body, done

body:
    %inv = mul i64 %n, %n
    %in = add i64 %i, 1
    %acc = add i64 %a, %inv
    br loop

done:
    ret i64 %a
}
