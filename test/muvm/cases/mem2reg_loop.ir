module "mem2regloop"

func @f(%n: i32) i32 {
entry:
    %i = alloca i32
    store i32 0, %i
    br loop

loop:
    %iv = load i32 %i
    %c = icmp slt i32 %iv, %n
    cond_br %c, body, exit

body:
    %iv2 = load i32 %i
    %sum = add i32 %iv2, 1
    store i32 %sum, %i
    br loop

exit:
    %r = load i32 %i
    ret i32 %r
}
