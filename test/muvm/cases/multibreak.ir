// expect: 50
// nested exit phi: %acc is live out of the loop, and the shared exit block
// is reached from the outside (select) as well as from inside both loop
// arms — exercises dedicated-exit splitting AND LCSSA on a multi-pred exit
module "multibreak"

func @main() i32 {
entry:
    %r = call i64 @ticket(i64 10)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}

func @ticket(%n: i64) i64 {
entry:
    br select
select:
    %useLoop = icmp slt i64 %n, 1000
    cond_br %useLoop, loopentry, exit
loopentry:
    br loop
loop:
    %i = phi i64 [0, loopentry], [%in, next]
    %acc = phi i64 [0, loopentry], [%acc2, next]
    %cmp2 = icmp slt i64 %i, %n
    cond_br %cmp2, body, exit
body:
    %acc2 = add i64 %acc, 2
    %isBrk = icmp eq i64 %i, 3
    cond_br %isBrk, exit, next
next:
    %in = add i64 %i, 1
    br loop
exit:
    %ax = phi i64 [0, select], [%acc, loop], [%acc, body]
    %r = add i64 %ax, 42
    ret i64 %r
}
