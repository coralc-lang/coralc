// loop_cse: invariant load with no writers anywhere in the loop — hoist
module "loopcse_demo"

func @main() i32 {
entry:
    %a = alloca i64
    %r = call i64 @sum_of_n(ptr %a, i64 10)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}

func @sum_of_n(%arr: ptr, %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [0, entry], [%in, loop]
    %sum = phi i64 [0, entry], [%s2, loop]
    %p = gep %arr, %i
    %v = load i64 %p
    %s2 = add i64 %sum, %v
    %in = add i64 %i, 1
    %cond = icmp slt i64 %in, %n
    cond_br %cond, loop, done

done:
    ret i64 %s2
}

func @sum_no_invariant(%arr: ptr, %n: i64) i64 {
entry:
    br loop

loop:
    %iv = phi i64 [0, entry], [%in, loop]
    %sum = phi i64 [0, entry], [%s2, loop]
    %k = add i64 %iv, 0
    %p = gep %arr, %k
    %v = load i64 %p
    %s2 = add i64 %sum, %v
    %in = add i64 %iv, 1
    %cond = icmp slt i64 %in, %n
    cond_br %cond, loop, done

done:
    ret i64 %s2
}
