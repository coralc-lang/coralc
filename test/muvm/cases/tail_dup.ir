// expect: 14
module "traildup"

func @dup_test(%x: i64, %y: i64) i64 {
entry:
    %cmp = icmp sgt i64 %x, 5
    cond_br %cmp, px, py

px:
    %r = mul i64 %x, 2
    ret i64 %r

py:
    %s = sub i64 0, %y
    ret i64 %s
}

func @main() i32 {
entry:
    %r = call i64 @dup_test(i64 7, i64 3)
    %t = trunc i64 %r to i32
    ret i32 %t
}
