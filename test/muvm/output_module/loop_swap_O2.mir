// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    %fc = icmp eq i64 %flag, 7
    br loop.preheader

loop.preheader:
    br outer

outer:
    %i = phi i64 [ 0, loop.preheader ], [ %in, loop.preheader ]
    %jo = phi i64 [ 0, loop.preheader ], [ %j, loop.preheader ]
    %ao = phi i64 [ 0, loop.preheader ], [ %acc, loop.preheader ]
    %oc = icmp slt i64 %i, 3
    %in = add i64 %i, 1
    cond_br %oc, inner, done

done:
    %ten = mul i64 %jo, 10
    %s1 = add i64 %ten, %i
    %res = add i64 %s1, %ao
    ret i64 %res

inner:
    %j = phi i64 [ 0, outer ], [ %jn, ilatch ]
    %acc = phi i64 [ 0, outer ], [ %sel, ilatch ]
    br ibody

ibody:
    %ta = add i64 %acc, 1
    %tb = add i64 %acc, 2
    cond_br %fc, imerge, imerge

imerge:
    %sel = phi i64 [ %ta, ibody ], [ %tb, ibody ]
    br ilatch

ilatch:
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, loop.preheader
}

func @main() i32 {
entry:
    br loop.preheader

loop.preheader:
    br __inl.body.2

__inl.body.2:
    %107 = phi i64 [ 0, loop.preheader ], [ %111, loop.preheader ]
    %108 = phi i64 [ 0, loop.preheader ], [ %113, loop.preheader ]
    %109 = phi i64 [ 0, loop.preheader ], [ %114, loop.preheader ]
    %110 = icmp slt i64 %107, 3
    %111 = add i64 %107, 1
    %124 = mul i64 %108, 10
    %125 = add i64 %124, %107
    %126 = add i64 %125, %109
    cond_br %110, __inl.body.3, __inl.cont.0

__inl.cont.0:
    %r32 = trunc i64 %126 to i32
    ret i32 %r32

__inl.body.3:
    %113 = phi i64 [ 0, __inl.body.2 ], [ %121, __inl.body.6 ]
    %114 = phi i64 [ 0, __inl.body.2 ], [ %119, __inl.body.6 ]
    %116 = add i64 %114, 1
    %117 = add i64 %114, 2
    br __inl.body.5

__inl.body.5:
    %119 = phi i64 [ %116, __inl.body.3 ], [ %117, __inl.body.3 ]
    br __inl.body.6

__inl.body.6:
    %121 = add i64 %113, 1
    %122 = icmp slt i64 %121, 4
    cond_br %122, __inl.body.3, loop.preheader
}
