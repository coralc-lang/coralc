// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    %fc = icmp eq i64 %flag, 7
    br loop.preheader

loop.preheader:
    br outer

outer:
    %i = phi i64 [ 0, loop.preheader ], [ %in, loop.preheader ]
    %jo = phi i64 [ 0, loop.preheader ], [ %j, loop.preheader ]
    %ao = phi i64 [ 0, loop.preheader ], [ %acc, loop.preheader ]
    %oc = icmp slt i64 %i, 3
    %in = add i64 %i, 1
    cond_br %oc, inner, done

done:
    %ten = mul i64 %jo, 10
    %s1 = add i64 %ten, %i
    %res = add i64 %s1, %ao
    ret i64 %res

inner:
    %j = phi i64 [ 0, outer ], [ %jn, ilatch ]
    %acc = phi i64 [ 0, outer ], [ %sel, ilatch ]
    br ibody

ibody:
    %ta = add i64 %acc, 1
    %tb = add i64 %acc, 2
    cond_br %fc, imerge, imerge

imerge:
    %sel = phi i64 [ %ta, ibody ], [ %tb, ibody ]
    br ilatch

ilatch:
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, loop.preheader
}

func @main() i32 {
entry:
    br loop.preheader

loop.preheader:
    br __inl.body.2

__inl.body.2:
    %128 = phi i64 [ 0, loop.preheader ], [ %132, loop.preheader ]
    %129 = phi i64 [ 0, loop.preheader ], [ %134, loop.preheader ]
    %130 = phi i64 [ 0, loop.preheader ], [ %135, loop.preheader ]
    %131 = icmp slt i64 %128, 3
    %132 = add i64 %128, 1
    %145 = mul i64 %129, 10
    %146 = add i64 %145, %128
    %147 = add i64 %146, %130
    cond_br %131, __inl.body.3, __inl.cont.0

__inl.cont.0:
    %r32 = trunc i64 %147 to i32
    ret i32 %r32

__inl.body.3:
    %134 = phi i64 [ 0, __inl.body.2 ], [ %142, __inl.body.6 ]
    %135 = phi i64 [ 0, __inl.body.2 ], [ %140, __inl.body.6 ]
    %137 = add i64 %135, 1
    %138 = add i64 %135, 2
    br __inl.body.5

__inl.body.5:
    %140 = phi i64 [ %137, __inl.body.3 ], [ %138, __inl.body.3 ]
    br __inl.body.6

__inl.body.6:
    %142 = add i64 %134, 1
    %143 = icmp slt i64 %142, 4
    cond_br %143, __inl.body.3, loop.preheader
}
