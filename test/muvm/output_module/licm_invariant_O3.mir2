// ---- module ----

module "licmparam"

// ---- funcs ----

func @main() i32 {
entry:
    br __inl.body.2

__inl.body.2:
    %33 = phi i64 [ 0, entry ], [ %38, __inl.body.3 ]
    %34 = phi i64 [ 0, entry ], [ %39, __inl.body.3 ]
    %35 = icmp slt i64 %33, 7
    cond_br %35, __inl.body.3, __inl.cont.0

__inl.cont.0:
    %t = trunc i64 %34 to i32
    ret i32 %t

__inl.body.3:
    %38 = add i64 %33, 1
    %39 = add i64 %34, 36
    br __inl.body.2
}

func @invariant_square(%n: i64) i64 {
entry:
    %inv = mul i64 %n, %n
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %a = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, 7
    cond_br %cmp, body, done

done:
    ret i64 %a

body:
    %in = add i64 %i, 1
    %acc = add i64 %a, %inv
    br loop
}
