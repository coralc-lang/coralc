// ---- module ----

module "multibreak"

// ---- funcs ----

func @main() i32 {
entry:
    br __inl.body.4

__inl.body.4:
    %51 = phi i64 [ 0, entry ], [ %58, __inl.body.5 ]
    %52 = phi i64 [ 0, entry ], [ %55, __inl.body.5 ]
    %53 = icmp slt i64 %51, 10
    cond_br %53, __inl.body.5, loop.exit

__inl.body.5:
    %55 = add i64 %52, 2
    %56 = icmp eq i64 %51, 3
    %58 = add i64 %51, 1
    cond_br %56, loop.exit, __inl.body.4

loop.exit:
    %69 = phi i64 [ %52, __inl.body.4 ], [ %52, __inl.body.5 ]
    %60 = phi i64 [ %69, loop.exit ], [ %69, loop.exit ]
    %61 = add i64 %60, 42
    br __inl.cont.0

__inl.cont.0:
    %r32 = trunc i64 %61 to i32
    ret i32 %r32
}

func @ticket(%n: i64) i64 {
entry:
    br select

select:
    %useLoop = icmp slt i64 %n, 1000
    cond_br %useLoop, loop, exit

loop:
    %i = phi i64 [ 0, select ], [ %in, body ]
    %acc = phi i64 [ 0, select ], [ %acc2, body ]
    %cmp2 = icmp slt i64 %i, %n
    cond_br %cmp2, body, loop.exit

body:
    %acc2 = add i64 %acc, 2
    %isBrk = icmp eq i64 %i, 3
    %in = add i64 %i, 1
    cond_br %isBrk, loop.exit, loop

loop.exit:
    %78 = phi i64 [ %acc, loop ], [ %acc, body ]
    br exit

exit:
    %ax = phi i64 [ 0, select ], [ %78, loop.exit ], [ %78, loop.exit ]
    %r = add i64 %ax, 42
    ret i64 %r
}
