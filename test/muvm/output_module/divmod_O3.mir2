// ---- module ----

module "divmod_demo"

// ---- funcs ----

func @divrem3(%x: i64, %y: i64) i64 {
entry:
    %q = sdiv i64 %x, %y
    %q2 = mul i64 %q, 10
    %q3 = add i64 %q, %q2
    %30 = mul i64 %q, %y
    %31 = sub i64 %x, %30
    %sum = add i64 %q3, %31
    ret i64 %sum
}

func @urem_fused3(%x: i64, %y: i64) i64 {
entry:
    %q = udiv i64 %x, %y
    %q2 = mul i64 %q, 10
    %q3 = add i64 %q, %q2
    %34 = mul i64 %q, %y
    %35 = sub i64 %x, %34
    %sum = add i64 %q3, %35
    ret i64 %sum
}

func @no_fusion_single_use(%x: i64, %y: i64) i64 {
entry:
    %q = sdiv i64 %x, %y
    %r = srem i64 %x, %y
    %sum = add i64 %q, %r
    ret i64 %sum
}
