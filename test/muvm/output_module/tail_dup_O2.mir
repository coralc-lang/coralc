// ---- module ----

module "traildup"

// ---- funcs ----

func @dup_test(%x: i64, %y: i64) i64 {
entry:
    %cmp = icmp sgt i64 %x, 5
    cond_br %cmp, px, py

py:
    %s = sub i64 0, %y
    ret i64 %s

px:
    %41 = shl i64 %x, 1
    ret i64 %41
}

func @main() i32 {
entry:
    br __inl.cont.0

__inl.cont.0:
    ret i32 14
}
