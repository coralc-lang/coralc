// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @main() i32 {
entry:
    %a = alloca i64
    br __inl.body.2

__inl.body.2:
    %49 = phi i64 [ 0, entry ], [ %54, __inl.body.2 ]
    %50 = phi i64 [ 0, entry ], [ %53, __inl.body.2 ]
    %51 = gep %a, %49
    %52 = load i64 %51
    %53 = add i64 %50, %52
    %54 = add i64 %49, 1
    %55 = icmp slt i64 %54, 10
    cond_br %55, __inl.body.2, __inl.cont.0

__inl.cont.0:
    %r32 = trunc i64 %53 to i32
    ret i32 %r32
}

func @sum_of_n(%arr: ptr, %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, loop ]
    %sum = phi i64 [ 0, entry ], [ %s2, loop ]
    %p = gep %arr, %i
    %v = load i64 %p
    %s2 = add i64 %sum, %v
    %in = add i64 %i, 1
    %cond = icmp slt i64 %in, %n
    cond_br %cond, loop, done

done:
    ret i64 %s2
}

func @sum_no_invariant(%arr: ptr, %n: i64) i64 {
entry:
    br loop

loop:
    %iv = phi i64 [ 0, entry ], [ %in, loop ]
    %sum = phi i64 [ 0, entry ], [ %s2, loop ]
    %p = gep %arr, %iv
    %v = load i64 %p
    %s2 = add i64 %sum, %v
    %in = add i64 %iv, 1
    %cond = icmp slt i64 %in, %n
    cond_br %cond, loop, done

done:
    ret i64 %s2
}
