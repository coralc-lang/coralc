// ---- module ----

module "bigmodule"

// ---- globals ----

global @g: i64 = 3 !alignment = 8;

// ---- funcs ----

func @square(%n: i64) i64 {
entry:
    %m = mul i64 %n, %n
    ret i64 %m
}

func @cube(%n: i64) i64 {
entry:
    %q = mul i64 %n, %n
    %c = mul i64 %q, %n
    ret i64 %c
}

func @sum_to(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

done:
    ret i64 %s

body:
    %acc = add i64 %s, %i
    %in = add i64 %i, 1
    br loop
}

func @collatz(%n: i64) i64 {
entry:
    br loop

loop:
    %x = phi i64 [ %n, entry ], [ %next, body ]
    %steps = phi i64 [ 0, entry ], [ %sn, body ]
    %one = icmp eq i64 %x, 1
    cond_br %one, done, body

body:
    %one1 = and i64 %x, 1
    %h = lshr i64 %x, 1
    %t3 = mul i64 %x, 3
    %t4 = add i64 %t3, 1
    %odd = icmp eq i64 %one1, 1
    %next = select i1 %odd, i64 %t4, i64 %h
    %sn = add i64 %steps, 1
    br loop

done:
    ret i64 %steps
}

func @fib(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %a = phi i64 [ 0, entry ], [ %b, body ]
    %b = phi i64 [ 1, entry ], [ %c, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

done:
    ret i64 %a

body:
    %c = add i64 %a, %b
    %in = add i64 %i, 1
    br loop
}

func @sum_squares_range(%lo: i64, %hi: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ %lo, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %hi
    cond_br %cmp, body, done

done:
    ret i64 %s

body:
    %sq = mul i64 %i, %i
    %acc = add i64 %s, %sq
    %in = add i64 %i, 1
    br loop
}

func @fact(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 1, entry ], [ %in, body ]
    %acc = phi i64 [ 1, entry ], [ %ac, body ]
    %cmp = icmp sle i64 %i, %n
    cond_br %cmp, body, done

done:
    ret i64 %acc

body:
    %ac = mul i64 %acc, %i
    %in = add i64 %i, 1
    br loop
}

func @gcd(%a0: i64, %b0: i64) i64 {
entry:
    br loop

loop:
    %a = phi i64 [ %a0, entry ], [ %b, body ]
    %b = phi i64 [ %b0, entry ], [ %r, body ]
    %cmp = icmp eq i64 %b, 0
    cond_br %cmp, done, body

body:
    %r = srem i64 %a, %b
    br loop

done:
    ret i64 %a
}

func @count_bits(%v: i64) i64 {
entry:
    br loop

loop:
    %x = phi i64 [ %v, entry ], [ %nx, body ]
    %s = phi i64 [ 0, entry ], [ %ns, body ]
    %cmp = icmp eq i64 %x, 0
    cond_br %cmp, done, body

body:
    %one = and i64 %x, 1
    %ns = add i64 %s, %one
    %nx = lshr i64 %x, 1
    br loop

done:
    ret i64 %s
}

func @poly(%x: i64) i64 {
entry:
    %q = mul i64 %x, %x
    %565 = shl i64 %x, 1
    %u1 = add i64 %q, %565
    %u2 = add i64 %u1, 1
    %r = add i64 %u2, %u2
    ret i64 %r
}

func @invar_loop(%n: i64, %k: i64) i64 {
entry:
    %inv = mul i64 %k, 7
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

done:
    ret i64 %s

body:
    %acc = add i64 %s, %inv
    %in = add i64 %i, 1
    br loop
}

func @big_switch(%c: i64) i64 {
entry:
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, case0, n1

n1:
    %c1 = icmp eq i64 %c, 1
    cond_br %c1, case1, n2

n2:
    %c2 = icmp eq i64 %c, 2
    cond_br %c2, case2, n3

n3:
    %c3 = icmp eq i64 %c, 3
    cond_br %c3, case3, n4

n4:
    %c4 = icmp eq i64 %c, 4
    cond_br %c4, case4, n5

n5:
    %c5 = icmp eq i64 %c, 5
    cond_br %c5, case5, n6

n6:
    %c6 = icmp eq i64 %c, 6
    cond_br %c6, case6, n7

n7:
    %c7 = icmp eq i64 %c, 7
    cond_br %c7, case7, n8

n8:
    %c8 = icmp eq i64 %c, 8
    cond_br %c8, case8, n9

n9:
    %c9 = icmp eq i64 %c, 9
    cond_br %c9, case9, case10

case10:
    ret i64 1024

case9:
    ret i64 512

case8:
    ret i64 256

case7:
    ret i64 128

case6:
    ret i64 64

case5:
    ret i64 32

case4:
    ret i64 16

case3:
    ret i64 8

case2:
    ret i64 4

case1:
    ret i64 2

case0:
    ret i64 1
}

func @const_chain() i64 {
entry:
    ret i64 245
}

func @redundant(%x: i64) i64 {
entry:
    ret i64 42
}

func @xor_self(%x: i64) i64 {
entry:
    ret i64 0
}

func @select_real(%x: i64, %y: i64) i64 {
entry:
    %c = icmp sgt i64 %x, %y
    %r = select i1 %c, i64 %x, i64 %y
    ret i64 %r
}

func @phi_const_combo(%a: i64, %b: i64) i64 {
entry:
    %c = icmp sgt i64 %a, %b
    cond_br %c, merge, merge

merge:
    %r = phi i64 [ 100, entry ], [ 200, entry ]
    %r1 = add i64 %r, 1
    ret i64 %r1
}

func @same_pick(%c: i1, %x: i64, %y: i64) i64 {
entry:
    %r = select i1 %c, i64 %x, i64 %y
    ret i64 %r
}

func @select_same(%c: i1, %v: i64) i64 {
entry:
    %r = select i1 %c, i64 %v, i64 %v
    ret i64 %r
}

func @main() i32 {
entry:
    %g = load i64 @g
    %341 = mul i64 %g, %g
    %349 = mul i64 %341, %g
    br __inl.body.6

__inl.body.6:
    %360 = phi i64 [ 0, entry ], [ %365, __inl.body.7 ]
    %361 = phi i64 [ 0, entry ], [ %364, __inl.body.7 ]
    %362 = icmp slt i64 %360, 8
    cond_br %362, __inl.body.7, __inl.body.11

__inl.body.11:
    %377 = phi i64 [ 0, __inl.body.6 ], [ %383, __inl.body.12 ]
    %378 = phi i64 [ 0, __inl.body.6 ], [ %379, __inl.body.12 ]
    %379 = phi i64 [ 1, __inl.body.6 ], [ %382, __inl.body.12 ]
    %380 = icmp slt i64 %377, 10
    cond_br %380, __inl.body.12, __inl.body.16

__inl.body.16:
    %395 = phi i64 [ 1, __inl.body.11 ], [ %401, __inl.body.17 ]
    %396 = phi i64 [ 0, __inl.body.11 ], [ %400, __inl.body.17 ]
    %397 = icmp slt i64 %395, 8
    cond_br %397, __inl.body.17, __inl.body.21

__inl.body.21:
    %413 = phi i64 [ 1, __inl.body.16 ], [ %418, __inl.body.22 ]
    %414 = phi i64 [ 1, __inl.body.16 ], [ %417, __inl.body.22 ]
    %415 = icmp sle i64 %413, 5
    cond_br %415, __inl.body.22, __inl.body.26

__inl.body.26:
    %430 = phi i64 [ 1071, __inl.body.21 ], [ %431, __inl.body.27 ]
    %431 = phi i64 [ 462, __inl.body.21 ], [ %434, __inl.body.27 ]
    %432 = icmp eq i64 %431, 0
    cond_br %432, __inl.body.31, __inl.body.27

__inl.body.27:
    %434 = srem i64 %430, %431
    br __inl.body.26

__inl.body.31:
    %446 = phi i64 [ 12345, __inl.body.26 ], [ %452, __inl.body.32 ]
    %447 = phi i64 [ 0, __inl.body.26 ], [ %451, __inl.body.32 ]
    %448 = icmp eq i64 %446, 0
    cond_br %448, __inl.body.38, __inl.body.32

__inl.body.32:
    %450 = and i64 %446, 1
    %451 = add i64 %447, %450
    %452 = lshr i64 %446, 1
    br __inl.body.31

__inl.body.38:
    %479 = phi i64 [ 0, __inl.body.31 ], [ %485, __inl.body.39 ]
    %480 = phi i64 [ 0, __inl.body.31 ], [ %484, __inl.body.39 ]
    %481 = icmp slt i64 %479, 4
    cond_br %481, __inl.body.39, __inl.cont.36

__inl.cont.36:
    %bs = call i64 @big_switch(i64 7)
    br __inl.cont.53

__inl.cont.53:
    %tot0 = add i64 %341, %349
    %tot1 = add i64 %tot0, %361
    %tot2 = add i64 %tot1, %378
    %tot3 = add i64 %tot2, %396
    %tot4 = add i64 %tot3, %414
    %tot5 = add i64 %tot4, %430
    %tot6 = add i64 %tot5, %447
    %tot7_add1 = add i64 %tot6, 32
    %tot7_add2 = add i64 %tot7_add1, %480
    %tot7_add3 = add i64 %tot7_add2, %bs
    %tot7_add4 = add i64 %tot7_add3, 245
    %tot7_add5 = add i64 %tot7_add4, 42
    %tot7_add7 = add i64 %tot7_add5, 20
    %tot7_add8 = add i64 %tot7_add7, 7
    %tot7_add9 = add i64 %tot7_add8, 99
    %tot7 = add i64 %tot7_add9, 201
    %tot8 = and i64 %tot7, 255
    %t = trunc i64 %tot8 to i32
    ret i32 %t

__inl.body.39:
    %484 = add i64 %480, 35
    %485 = add i64 %479, 1
    br __inl.body.38

__inl.body.22:
    %417 = mul i64 %414, %413
    %418 = add i64 %413, 1
