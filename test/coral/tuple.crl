// Import resolutionandtype inference tuple test in one go.

import(lib) std { math };
import(lib) platform::libc;

i32 shuffle(i32 a)
{
    var b = (i32)math::sqrt((f64)a) * 2;
    return b;
}

struct(i32, i32) inTwo(i32 a)
{
    var b = a / 2;
    return (b, b);
}

i32 find(struct(i32, i32) n)
{
    var b = n.1 + n.2;
    return b * b;
}

i32 main(void)
{
   libc::printf(C"%d", find(inTwo(shuffle(1024))));
   return 0;
}