void do<comptime T>(T a, T b) {
    comptime {
        switch(@typeof(T)) {
            i32 | u32 | i64 | u64 => {
                print("{}, {}", a, b);
            },
            else => {
                @compileError("Unsupported type"); // it should be enforced that the last branch must have a compile error statement
            }
        }
    }
}

void main() {
    do(1024, 2048);

    i32 a = 4;

    switch (a) {
        1 => { }.
        else => { a = 4 ;}
    }
}

