extend std::string::String {
    i32 reverse() { // std::string already has a reverse function. it is not flagged despite me extending on it with this function of the same name. it then fails in the codegen
        print("{}", self.asView());
        return 0;
    }
}

void main() {

    var c = "hello world"
                        .asString()
                        .asView()
                        .equals("hello worl"); // correect, should reesolve to bool. 
    print("{}", "hello world".asString().asView().equals("hello world") == c);

    var g = "hello world".asString().reverse();
}
