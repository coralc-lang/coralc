void do<comptime T>(T a, T b) {
    comptime {
        if (@typeof(T) == i32) { // this will throw an error. this should not theow an error, i am in a comptime block using typeof, it would work if it were a switch
            print("{} {}", a, b);
        } else {
            @compileError("Unsupported type!");
        }
    }
}

void main() {
    do(1024, 2048);
}