// Comptime blocks compile, but ACTUAL comptime *evaluation* is not implemented:
// the switch is emitted as a normal runtime switch, not folded at compile time.
pub i32 main()
{
    u8 spec = 1;
    comptime
    {
        switch (spec)
        {
            0 => { return 0; },
            1 => { return 42; },
            else => { return 0; }
        }
    }
}
