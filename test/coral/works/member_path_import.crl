// Member-path imports: the last segment names a decl inside the parent
// module, not a submodule — `import std::ios::println` is equivalent to
// `import std::ios { println }`. The loader resolves the parent path and
// records the decl; sema binds the tail segment as a symbol.
import std::ios::println;
use std::option::Option;

pub i32 main()
{
    Option<i32> x = Option<i32>::Some { value = 7 };
    if (x.isSome()) println("member path ok");
    return 0;
}
