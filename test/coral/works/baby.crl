#[[freestanding]]
struct name
{
    i32 a;
    i32 b;

    void add(name other) {
        self.a += other.a;
        self.b += other.b;
    }
}

name new()
{
    return name {
        .a = 2,
        .b = 3
    };
}

name add(name a, name b) {
    return name { a.a + b.a, a.b + b.b };
}

void main() {
    name e = new();
    name c = new();

    c.add(e);

    c = add(c, e);
    printf("%d".ptr, c.a);
}

extern i32 printf(const u8* src, ...);

