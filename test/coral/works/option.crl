// Option, generics, use resolution, type inference and chained method calls.
// All in one go:
//      An advanced test that is expected to be among the
//      gold standards for the coralc compiler.

import core::limits { INT32_MAX };
import core::cchar { cchar };
import platform::libc { printf };

Option<f64> checkedPow(f64 base, f64 exponent)
{
    f64 count = 1;
    f64 currentBase = base;
    usize exp = (usize)exponent;

    while (exp > 0)
    {
        if (exp % 2 == 1)
        {
            if (currentBase > 0 && currentBase > (f64)INT32_MAX / count)
                return Option<f64>::None;
            count *= currentBase;
        }
        exp /= 2;

        if (exp > 0)
        {
            if (currentBase > 0 && currentBase > (f64)INT32_MAX / currentBase)
                return Option<f64>::None;
            currentBase *= currentBase;
        }
    }
    return Option<f64>::Some { .value = count };
}

pub i32 main()
{
    var result = checkedPow(2, 10); // Option<f64>, inferred

    if (result.isSome())
    {
        println("success: {} {}", result.unwrap(), checkedPow(3, 2).unwrapOr(-1));
        return 0;
    }
    return 1;
}
