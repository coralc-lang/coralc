pub struct calculator
{
    f64 a;
    f64 b;
    str operation;

    static calculator from(f64 a, f64 b, str ops) { return calculator { .a = a, .b = b, .operation = ops }; }
    f64 add(self);
    f64 sub(self);
    f64 mul(self);
    f64 div(self);

    f64 run()
    {
        if (operation.equals("add") return self.add();
        if (operation.equals("sub") return self.sub();
        if (operation.equals("mul") return self.mul();
        if (operation.equals("div") return self.div();
    }
}