use calc {
    calc::calculator, // calculator struct brought in.
    add, sub, mul, div // imported to bring the extend blocks into scope
};

pub void main()
{
    var c /* f32 */ = calculator::from(1024, 2048, "div");
    print("{}", c.run());
}

