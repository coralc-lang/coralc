import(lib) platform::libc { printf };

import calc {
    calc::calculator,
    add, sub, mul, div // imported to bring the extend blocks into scope
};

pub i32 main()
{
    calculator c = calculator::from(1024, 2048 "div");
    printf((u8*)"%f", c.run());
    return 0;
}

