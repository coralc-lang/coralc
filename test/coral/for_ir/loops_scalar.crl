#[[freestanding]]

/// Loops that scalar evolution (SCEV) can turn into closed forms.
/// Each function is followed by the closed form as `// =>`.
/// Arithmetic is wrapping unsigned unless noted.

/// n * (n - 1) / 2, correct under u64 wraparound (halve the even factor first).
u64 tri(u64 n)
{
    if ((n & 1) == 0) return (n / 2) * (n - 1);
    return n * ((n - 1) / 2);
}

// ============================================================
// 1. Constant and linear accumulators
// ============================================================

// 1. constant add
u64 f1(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += 7;
    return s;
}
// => return 7 * n;

// 2. add loop-invariant value
u64 f2(u64 n, u64 x)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += x;
    return s;
}
// => return x * n;

// 3. non-zero start
u64 f3(u64 n, u64 s0)
{
    u64 s = s0;
    for (u64 i = 0; i < n; i++) s += 3;
    return s;
}
// => return s0 + 3 * n;

// 4. subtract
u64 f4(u64 n)
{
    u64 s = 1000;
    for (u64 i = 0; i < n; i++) s -= 2;
    return s;
}
// => return 1000 - 2 * n;

// 5. counting loop
u64 f5(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++) c++;
    return c;
}
// => return n;

// 6. sum of induction variable
u64 f6(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += i;
    return s;
}
// => return tri(n);

// 7. sum of 1..n
u64 f7(u64 n)
{
    u64 s = 0;
    for (u64 i = 1; i <= n; i++) s += i;
    return s;
}
// => return tri(n + 1);

// 8. affine function of i
u64 f8(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += 3 * i + 5;
    return s;
}
// => return 3 * tri(n) + 5 * n;

// 9. invariant times i
u64 f9(u64 n, u64 x)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += x * i;
    return s;
}
// => return x * tri(n);

// 10. countdown
u64 f10(u64 n)
{
    u64 s = 0;
    for (u64 i = n; i > 0; i--) s += i;
    return s;
}
// => return tri(n + 1);

// ============================================================
// 2. Polynomial recurrences (higher-order chrecs)
// ============================================================

// 11. sum of squares
u64 f11(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += i * i;
    return s;
}
// => return (n - 1) * n * (2 * n - 1) / 6;   // exact while the product fits (n < 2^21)

// 12. sum of cubes
u64 f12(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += i * i * i;
    return s;
}
// => return tri(n) * tri(n);

// 13. two chained accumulators
u64 f13(u64 n, u64 a0, u64 b0)
{
    u64 a = a0;
    u64 b = b0;
    for (u64 i = 0; i < n; i++)
    {
        a += b;
        b += 2;
    }
    return a;
}
// => return a0 + n * b0 + 2 * tri(n);        // b_i = b0 + 2i, so a is quadratic in n

// 14. second difference constant
u64 f14(u64 n)
{
    u64 x = 0;
    u64 d = 1;
    for (u64 i = 0; i < n; i++)
    {
        x += d;
        d += 3;
    }
    return x;
}
// => return n + 3 * tri(n);

// 15. squares built incrementally (no multiply)
u64 f15(u64 n)
{
    u64 sq = 0;
    u64 odd = 1;
    for (u64 i = 0; i < n; i++)
    {
        sq += odd;
        odd += 2;
    }
    return sq;
}
// => return n * n;

// 16. product of two affine IVs
u64 f16(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++) s += (i + 1) * (i + 2);
    return s;
}
// => return (n * (n + 1) * (n + 2)) / 3;     // = 2 * C(n + 2, 3)

// ============================================================
// 3. Non-unit strides and trip counts
// ============================================================

// 17. step by 2
u64 f17(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i += 2) s += i;
    return s;
}
// => u64 m = (n + 1) / 2;
//    return m * (m - 1);

// 18. general stride, sum of i (st > 0)
u64 f18(u64 a, u64 b, u64 st)
{
    u64 s = 0;
    for (u64 i = a; i < b; i += st) s += i;
    return s;
}
// => u64 m = a < b ? (b - a + st - 1) / st : 0;
//    return m * a + st * tri(m);

// 19. trip count only
u64 f19(u64 a, u64 b, u64 st)
{
    u64 c = 0;
    for (u64 i = a; i < b; i += st) c++;
    return c;
}
// => return a < b ? (b - a + st - 1) / st : 0;

// 20. inclusive bound
u64 f20(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i <= n; i++) c++;
    return c;
}
// => return n + 1;                            // n == u64 max loops forever; compiler must rule that out

// 21. signed bound, possibly negative
u64 f21(i64 n)
{
    u64 c = 0;
    for (i64 i = 0; i < n; i++) c++;
    return c;
}
// => return n > 0 ? (u64)n : 0;

// 22. != exit with unit stride
u64 f22(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i != n; i++) c++;
    return c;
}
// => return n;

// 23. != exit with stride 3 (terminates only when (n - a) % 3 == 0)
u64 f23(u64 a, u64 n)
{
    u64 c = 0;
    for (u64 i = a; i != n; i += 3) c++;
    return c;
}
// => return (n - a) / 3;                      // given the divisibility precondition

// 24. final value of the induction variable
u64 f24(u64 n)
{
    u64 i = 0;
    for (; i < n; i++) {}
    return i;
}
// => return n;

// 25. final value with a stride
u64 f25(u64 n)
{
    u64 i = 0;
    for (; i < n; i += 4) {}
    return i;
}
// => return ((n + 3) / 4) * 4;                // n rounded up to a multiple of 4

// 26. two exits, count is a min
u64 f26(u64 n, u64 k)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
    {
        if (i == k) break;
        c++;
    }
    return c;
}
// => return k < n ? k : n;

// 27. predicate on the IV
u64 f27(u64 n, u64 m)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        if (i < m) c++;
    return c;
}
// => return n < m ? n : m;

// 28. count of multiples of k
u64 f28(u64 n, u64 k)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        if (i % k == 0) c++;
    return c;
}
// => return (n + k - 1) / k;

// 29. count of odd values
u64 f29(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        if ((i & 1) != 0) c++;
    return c;
}
// => return n / 2;

// ============================================================
// 4. Geometric and multiplicative recurrences
// ============================================================

// 30. doubling
u64 f30(u64 x0, u64 n)
{
    u64 x = x0;
    for (u64 i = 0; i < n; i++) x *= 2;
    return x;
}
// => return n >= 64 ? 0 : x0 << n;

// 31. shift left in the loop
u64 f31(u64 x0, u64 n)
{
    u64 x = x0;
    for (u64 i = 0; i < n; i++) x <<= 1;
    return x;
}
// => return n >= 64 ? 0 : x0 << n;

// 32. multiply by a constant
u64 _f32(u64 x0, u64 n)
{
    u64 x = x0;
    for (u64 i = 0; i < n; i++) x *= 3;
    return x;
}
// => return x0 * pow(3, n);                   // square-and-multiply, O(log n), wraps mod 2^64

// 33. multiply by an invariant (exponentiation)
u64 f33(u64 base, u64 e)
{
    u64 p = 1;
    for (u64 i = 0; i < e; i++) p *= base;
    return p;
}
// => return pow(base, e);

// 34. 2x + 1 recurrence
u64 f34(u64 n)
{
    u64 x = 0;
    for (u64 i = 0; i < n; i++) x = 2 * x + 1;
    return x;
}
// => return n >= 64 ? ~(u64)0 : ((u64)1 << n) - 1;

// 35. halving
u64 f35(u64 x0, u64 n)
{
    u64 x = x0;
    for (u64 i = 0; i < n; i++) x >>= 1;
    return x;
}
// => return n >= 64 ? 0 : x0 >> n;

// 36. doubling until a bound (trip count is a log)
u64 f36(u64 n)
{
    u64 c = 0;
    for (u64 x = 1; x < n; x <<= 1) c++;
    return c;
}
// => return n <= 1 ? 0 : 64 - clz64(n - 1);   // ceil(log2(n))

// 37. halving until zero
u64 f37(u64 x0)
{
    u64 c = 0;
    for (u64 x = x0; x != 0; x >>= 1) c++;
    return c;
}
// => return 64 - clz64(x0);                   // bit length

// ============================================================
// 5. Narrow types and wraparound
// ============================================================

// 38. u8 accumulator wraps
u8 f38(u64 n)
{
    u8 x = 0;
    for (u64 i = 0; i < n; i++) x += 5;
    return x;
}
// => return (u8)(5 * n);                      // truncating the 64-bit result is exact mod 256

// 39. u32 sum of i, wrapping
u32 f39(u32 n)
{
    u32 s = 0;
    for (u32 i = 0; i < n; i++) s += i;
    return s;
}
// => return (u32)tri((u64)n);                 // widen first, then truncate

// 40. u16 counter step
u16 f40(u16 x0, u64 n)
{
    u16 x = x0;
    for (u64 i = 0; i < n; i++) x += 0x1001;
    return x;
}
// => return (u16)(x0 + 0x1001 * n);

// ============================================================
// 6. Nested loops
// ============================================================

// 41. rectangular
u64 f41(u64 n, u64 m)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < m; j++) c++;
    return c;
}
// => return n * m;

// 42. triangular, j < i
u64 f42(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < i; j++) c++;
    return c;
}
// => return tri(n);

// 43. triangular, j from i
u64 f43(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = i; j < n; j++) c++;
    return c;
}
// => return tri(n + 1);

// 44. triangular, j <= i
u64 f44(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j <= i; j++) c++;
    return c;
}
// => return tri(n + 1);

// 45. sum of the inner IV
u64 f45(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < i; j++) s += j;
    return s;
}
// => return n * (n - 1) * (n - 2) / 6;        // C(n, 3), exact for modest n

// 46. product of both IVs
u64 f46(u64 n, u64 m)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < m; j++) s += i * j;
    return s;
}
// => return tri(n) * tri(m);

// 47. triple nested triangular
u64 f47(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < i; j++)
            for (u64 k = 0; k < j; k++) c++;
    return c;
}
// => return n * (n - 1) * (n - 2) / 6;

// 48. inner trip count is affine in the outer IV
u64 f48(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < 2 * i + 1; j++) c++;
    return c;
}
// => return n * n;                            // sum of the first n odd numbers

// 49. inner loop with a stride
u64 f49(u64 n)
{
    u64 c = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < i; j += 2) c++;
    return c;
}
// => return (n / 2) * ((n + 1) / 2);          // floor(n/2) * ceil(n/2)

// 50. constant-trip inner loop folds, then the outer folds
u64 f50(u64 n)
{
    u64 s = 0;
    for (u64 i = 0; i < n; i++)
        for (u64 j = 0; j < 10; j++) s += i;
    return s;
}
// => return 10 * tri(n);

// ============================================================
// 7. Indexing and pointer induction (strength reduction, LFTR)
// ============================================================

// 51. multiply by stride in the index
void f51(u32* a, u64 n)
{
    for (u64 i = 0; i < n; i++) a[i * 4] = 0;
}
// => for (u32* p = a; p < a + 4 * n; p += 4) *p = 0;   // one add per iteration, no multiply

// 52. separate running index
void f52(u32* a, u64 n)
{
    u64 k = 0;
    for (u64 i = 0; i < n; i++)
    {
        a[k] = (u32)i;
        k += 3;
    }
}
// => a[3 * i] = (u32)i;                       // k is the chrec {0,+,3}

// 53. two IVs collapse to one
u64 f53(u64 n)
{
    u64 j = 100;
    u64 s = 0;
    for (u64 i = 0; i < n; i++)
    {
        s += j;
        j -= 2;
    }
    return s;
}
// => return 100 * n - 2 * tri(n);

// 54. loop-test replacement: the exit test moves to the strided variable
void f54(u32* a, u64 n)
{
    for (u64 i = 0; i < n; i++) a[i * 8] = 1;
}
// => for (u64 j = 0; j < 8 * n; j += 8) a[j] = 1;      // i is dead, only j remains

// 55. pointer bump equals indexed access
u64 f55(u64* p, u64 n)
{
    u64* q = p;
    for (u64 i = 0; i < n; i++) q += 5;
    return (u64)q;
}
// => return (u64)(p + 5 * n);

// 56. exit value of a derived IV
u64 f56(u64 n)
{
    u64 j = 7;
    for (u64 i = 0; i < n; i++) j += 11;
    return j;
}
// => return 7 + 11 * n;

// ============================================================
// 8. Idioms that fall out once the trip count is known
// ============================================================

// 57. memset
void f57(u8* a, u64 n)
{
    for (u64 i = 0; i < n; i++) a[i] = 0;
}
// => memset(a, 0, n);

// 58. iota
void f58(u64* a, u64 n)
{
    for (u64 i = 0; i < n; i++) a[i] = i;
}
// => vectorized {0,+,1} ramp: a[i..i+3] = base + {0, 1, 2, 3}

// 59. loop whose result is never used
u64 f59(u64 n)
{
    u64 dead = 0;
    for (u64 i = 0; i < n; i++) dead += i;
    return 5;
}
// => return 5;                                // finite, no side effects, deleted

// 60. constant trip count: full unroll, then fold
u64 f60()
{
    u64 s = 0;
    for (u64 i = 0; i < 8; i++) s += i * i;
    return s;
}
// => return 140;

// ============================================================
// What does NOT become a closed form
// ============================================================

// Fibonacci: a depends on b and b on a (not an add-recurrence)
u64 g1(u64 n)
{
    u64 a = 0;
    u64 b = 1;
    for (u64 i = 0; i < n; i++)
    {
        u64 t = a + b;
        a = b;
        b = t;
    }
    return a;
}

// squaring: x = x * x is doubly exponential, not polynomial or geometric
u64 g2(u64 x0, u64 n)
{
    u64 x = x0;
    for (u64 i = 0; i < n; i++) x *= x;
    return x;
}

// data-dependent exit: trip count unknowable at compile time
u64 g3(u8* s)
{
    u64 n = 0;
    while (s[n] != 0) n++;
    return n;
}

// Collatz-style: a branch decides the update
u64 g4(u64 x)
{
    u64 c = 0;
    while (x != 1)
    {
        x = (x & 1) != 0 ? 3 * x + 1 : x / 2;
        c++;
    }
    return c;
}

// modulus that is not a power of two (closed form by hand is (3 * n) % 7,
// but a generic SCEV won't derive it)
u64 g5(u64 n)
{
    u64 x = 0;
    for (u64 i = 0; i < n; i++) x = (x + 3) % 7;
    return x;
}

// xorshift / LFSR state update
u64 g6(u64 x, u64 n)
{
    for (u64 i = 0; i < n; i++)
    {
        x ^= x << 13;
        x ^= x >> 7;
        x ^= x << 17;
    }
    return x;
}

// floating point accumulation: reassociation changes results without fast-math
f64 g7(u64 n)
{
    f64 s = 0.0;
    for (u64 i = 0; i < n; i++) s += 0.1;
    return s;
}

// ============================================================
// Notes for the pass author
// ============================================================
// - Overflow semantics matter: for `<` loops with a stride, `i += st` can wrap
//   past `b`. SCEV needs no-wrap flags or a proof that b + st cannot overflow
//   before using (b - a + st - 1) / st.
// - Widen before dividing: compute tri in u64 and truncate for u32 sums (ex. 39).
// - Division by 6 or 2 under wrap is only exact if the intermediate product does
//   not overflow (ex. 11, 45, 47). For wrapping types use a 128-bit intermediate
//   or split the factors as tri does.
// - Trip-count expressions need a guard: forms like n - 1 assume n >= 1, so the
//   zero-trip case is usually handled with a select on n == 0.
