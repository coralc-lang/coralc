extend std::string::String {
    void print() {
        print("{}", self.asView());
        // return 0;
    }
}

void main() {
    
    var c = "hello world"
                        .asString()
                        .asView()
                        .equals("hello worl");
                        
    print("{}", "hello world".asString().asView().equals("hello world") == c);

    var g = "hello world".asString().print(); // we pass a void function, but we use it as a value for a variable. the compiler suprisingly lets it happen
}