struct P { i32 a; i32 b; }

P pick(bool c, P x, P y) { return c ? x : y; }
P pickIf(bool c, P x, P y) { return if (c) x else y; }
P pickSw(i32 c, P x, P y) { return switch (c) { 0 => x, 1 => y, else => x }; }

pub i32 main()
{
    P a = P { .a = 1, .b = 2 };
    P b = P { .a = 3, .b = 4 };
    P r = pick(true, a, b);
    if (r.a != 1 || r.b != 2) return 1;
    r = pick(false, a, b);
    if (r.a != 3 || r.b != 4) return 2;
    r = pickIf(true, a, b);
    if (r.a != 1) return 3;
    r = pickIf(false, a, b);
    if (r.a != 3) return 4;
    r = pickSw(0, a, b);
    if (r.a != 1) return 5;
    r = pickSw(1, a, b);
    if (r.a != 3) return 6;
    r = pickSw(9, a, b);
    if (r.a != 1) return 7;
    return 0;
}
