/* complex variant lowering, modeled on the compiler AST shape
 * (ExprKind/DeclKind): many cases, empty + scalar + multi-field
 * aggregate payloads, nested variant payloads, struct fields inside
 * payloads, tag inspection, pattern bindings, copies, and by-value
 * argument/return through the aggregate ABI. */

struct Pair { i32 a; i32 b; }

variant Node {
    Empty,
    Int { u64 value; u8 flags; },
    Float { f64 value; },
    Str { str ptr; u64 len; },
    Call { Node* callee; Node** args; u64 nargs; },
    Pair { Pair p; i32 tag; },
    Nested { Node* inner; i32 depth; },
    Arr { i32[4] v; u64 n; }
}

/* by-value aggregate argument + pattern dispatch over every case */
u64 score(Node n)
{
    u64 s = 0;
    switch (n) {
        Node::Empty => { s = 1; },
        Node::Int { value, flags } => { s = value + (u64)flags; },
        Node::Float { value } => { s = (u64)value; },
        Node::Str { ptr, len } => { s = len + (u64)ptr; },
        Node::Call { callee, args, nargs } => { s = nargs + (u64)callee; },
        Node::Pair { p, tag } => { s = (u64)(p.a + p.b + tag); },
        Node::Nested { inner, depth } => { s = (u64)depth + (u64)(*inner).tag; },
        Node::Arr { v, n } => { s = n + (u64)v[0] + (u64)v[3]; }
    }
    return s;
}

Node wrap(Node* inner, i32 depth)
{
    return Node::Nested { .inner = inner, .depth = depth };
}

pub i32 main()
{
    i32 r = 0;

    /* scalar + flag payload */
    Node i = Node::Int { .value = 40, .flags = 2 };
    if (score(i) == 42) r = r + 1;

    /* empty case */
    Node e = Node::Empty {};
    if (score(e) == 1) r = r + 2;

    /* struct-in-payload + extra field */
    Node pp = Node::Pair { .p = Pair { .a = 10, .b = 20 }, .tag = 5 };
    if (score(pp) == 35) r = r + 4;

    /* nested variant: construction, copy, recursive tag inspect */
    Node inner = Node::Int { .value = 7, .flags = 0 };
    Node outer = wrap(&inner, 3);
    if (outer.tag == Node::Nested) r = r + 8;
    Node outer2 = outer;
    if (score(outer2) == 3 + (u64)Node::Int) r = r + 16;


    /* tag write + ordinal + aggregate copy of large variant */
    e.tag = Node::Arr;
    if (e.tag == 7) r = r + 64;
    Node big = Node::Arr { .v = {1,2,3,4}, .n = 9 };
    Node big2 = big;
    if (big2.payload.Arr.n == 9 && big2.payload.Arr.v[2] == 3) r = r + 128;

    /* float + str-ish payloads (str fields lowered as aggregates) */
    Node f = Node::Float { .value = 9.0 };
    if (score(f) == 9) r = r + 256;

    return r == 479 ? 0 : 1;
}
