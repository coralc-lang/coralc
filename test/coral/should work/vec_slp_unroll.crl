#[[freestanding]]
/* unrolled straight-line vectorization (slp_vec): two small fixed-trip
 * loops unroll completely, then slp_vec packs the isomorphic
 * gep/load/add/store chains into vector i64 2 groups. The odd element
 * count exercises the scalar tail path. Result must be correct at
 * every opt level: c[i] = i + 2i, so c[0]+c[15] = 0 + 45 = 45. */

i32 main()
{
    i64[16] a = {0};
    i64[16] b = {0};
    i64[16] c = {0};
    for (i64 i = 0; i < 16; i++) {
        a[i] = i;
        b[i] = i * 2;
    }
    for (i64 i = 0; i < 16; i++) {
        c[i] = a[i] + b[i];
    }
    i64 r = c[0] + c[15];
    return (i32)r;
}
