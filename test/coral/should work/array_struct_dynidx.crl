/* dynamic-index array-of-struct field access: `gs[i].a` / `gs[i].b`
 * must stride by sizeof(element) then take the field offset — a
 * gep typed ptr-to-array instead of ptr-to-element made field geps
 * add element size instead of field offset. */
struct P { i32 a; i32 b; }

P[3] gs = { P { .a = 1, .b = 2 }, P { .a = 3, .b = 4 }, P { .a = 5, .b = 6 } };

pub i32 main()
{
    i32 r = 0;
    for (i32 i = 0; i < 3; i++) { r += gs[i].a + gs[i].b; }
    if (r != 21) return 1;

    P[3] ls = { P { .a = 10, .b = 20 }, P { .a = 30, .b = 40 }, P { .a = 50, .b = 60 } };
    i32 s = 0;
    for (i32 i = 0; i < 3; i++) { s += ls[i].a * 10 + ls[i].b; }
    if (s != (100 + 20 + 300 + 40 + 500 + 60)) return 2;
    return 0;
}
