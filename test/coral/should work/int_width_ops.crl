/* sub-64-bit int ops must use width-correct instructions: slot values
 * carry producer-dependent upper bits (consts/loads zero-extend, neg
 * and arithmetic sign-extend), so a 64-bit cmpq/idivq/sarq reads
 * garbage. Regression: `a != -2` was true for a == -2, `-7 / 2` and
 * `-7 >> 1` broke depending on opt level. */

i32 neg7() { return -7; }
i32 neg2() { return -2; }

pub i32 main()
{
    i32 a = neg7();
    if (a / 2 != -3) return 1;
    if (a % 2 != -1) return 2;
    if (a >> 1 != -4) return 3;
    if (a << 1 != -14) return 4;
    if (!(a < 0)) return 5;

    i32 b = neg2();
    if (b != -2) return 6;
    if (b == -3) return 7;

    u32 u = 0xFFFFFFF9;
    if (!(u > 0xFFFFFF00)) return 8;
    if (u / 2 != 0x7FFFFFFC) return 9;
    if (u >> 1 != 0x7FFFFFFC) return 10;

    i16 s = -1000;
    if (s / 3 != -333) return 11;
    if (s >> 2 != -250) return 12;
    if (s < 0) { } else return 13;

    i8 t = -5;
    if (t * 2 != -10) return 14;
    if (t / 2 != -2) return 15;
    if (t % 2 != -1) return 16;
    return 0;
}
