#[[noprelude]]

/* function attributes carried to the backend: hot/cold steer layout,
 * inline hints and inline_never steer the inline pass. The generated
 * IR should carry !hot/!cold/inlinehint metadata (visible via
 * muvm_tool or the attr lines in --emit-ir). */
#[[inline]]
i32 sqr(i32 x) { return x * x; }

#[[inline_always]]
i32 twice(i32 x) { return x + x; }

#[[inline_never]]
i32 cube(i32 x) { return x * x * x; }

#[[hot]]
i32 hotfn(i32 x) { return x + 1; }

#[[cold]]
i32 coldfn(i32 x) { return x - 1; }

pub i32 main()
{
    i32 r = sqr(3) + twice(4) + cube(2) + hotfn(10) + coldfn(10);
    /* 9 + 8 + 8 + 11 + 9 = 45 */
    return r == 45 ? 0 : 1;
}
