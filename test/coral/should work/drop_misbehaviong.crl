// type does not implement drop, but the compiler foolishly says explicit call to drop not allowed
// if the type were to implenment it, we'd have
// 
// extend foo: @drop {
//     // we don't need to have the method in the body, it implements it already. 
// }

struct foo {
    i32 a;
    void drop() { 
        self.a = 0;
    }
}

void main() {
    foo g;
    g.drop(); // you can see the error here. 
}