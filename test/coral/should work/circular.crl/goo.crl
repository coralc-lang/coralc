use foo;

pub struct voo {
    i32 a;
}

static foo::foo m = {
    2, 1, { 3 }
};

i32 addfoo(voo a) {
    return a.a + m.a + m.b; // m here is a global. i quite literally have to mark it as static to stop it from erroring in one very stupid way possible.
    // that was at least until i use m in foo.crl, and it errors either way.
}