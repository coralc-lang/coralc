i32 rot(i32 n) {
    i32 p = 10;
    i32 q = 20;
    i32 i = 0;
    while (i < n) {
        i32 t = p;
        p = q;
        q = t;
        i = i + 1;
    }
    return p * 100 + q;
}

i32 main() {
    i32 r = rot(0);
    if (r != 1020) return 1;
    r = rot(1);
    if (r != 2010) return 2;
    r = rot(2);
    if (r != 1020) return 3;
    r = rot(3);
    if (r != 2010) return 4;
    r = rot(5);
    if (r != 2010) return 5;
    return 0;
}
