#[[freestanding]]
/* mixed switch: or-patterns take the native Switch; the guarded arm
 * forces the compare chain for the suffix — arm order must hold. */
pub i32 classify(i32 x)
{
    i32 r = 0;
    switch (x)
    {
        0 => { r = 1; },
        1 | 2 | 3 => { r = 2; },
        n if n > 100 => { r = 4; },
        else => { r = 5; }
    }
    return r;
}

pub i32 main()
{
    i32 ok = 1;
    if (classify(0) != 1) ok = 0;
    if (classify(2) != 2) ok = 0;
    if (classify(7) != 5) ok = 0;
    if (classify(200) != 4) ok = 0;
    if (classify(-5) != 5) ok = 0;
    return ok;
}
