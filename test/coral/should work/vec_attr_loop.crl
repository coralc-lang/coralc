#[[freestanding]]
/* loop-level vectorization attributes: #[[vectorise]] on a for/while
 * statement marks just that loop (!vectorize.loop on the header
 * terminator), and #[[novector]] on a loop opts it out even inside a
 * [[vectorise]] function. */

#[[vectorise]]
i64 lred(i64* a)
{
    i64 s = 0;
    #[[vectorise]]
    for (i64 i = 0; i < 64; i++) { s = s + a[i]; }
    return s;
}

#[[vectorise]]
i64 wred(i64* a)
{
    i64 s = 0;
    i64 i = 0;
    #[[vectorise]]
    while (i < 64) { s = s + a[i]; i++; }
    return s;
}

#[[vectorise]]
i64 mixed(i64* a)
{
    i64 s = 0;
    #[[novector]]
    for (i64 i = 0; i < 64; i++) { s = s + a[i]; }
    return s;
}

pub i32 main()
{
    i64[64] a = {0};
    i64 i = 0;
    while (i < 64) { a[i] = i; i++; }
    if (lred(&a[0]) != 2016) return 1;
    if (wred(&a[0]) != 2016) return 2;
    if (mixed(&a[0]) != 2016) return 3;
    return 0;
}
