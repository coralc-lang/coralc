#[[freestanding]]
/* std::vec-inspired sample: generic struct, implicit-self methods,
 * field stores through self, and element indexing — the same shapes
 * lib/std/x86_64/linux/vec.crl uses, minus the allocator. */
pub struct MiniVec<T>
{
    T* data;
    usize len;
    usize cap;

    static MiniVec<T> new()
    {
        MiniVec<T> v;
        v.data = null;
        v.len = 0;
        v.cap = 0;
        return v;
    }

    void push(T val)
    {
        if (self.len >= self.cap) return; // fixed buffer for the test
        self.data[self.len] = val;
        self.len++;
    }

    T at(usize i)
    {
        return self.data[i];
    }

    usize size() { return self.len; }
}

pub i32 main()
{
    i32[4] buf;
    MiniVec<i32> v;
    v.data = buf;
    v.len = 0;
    v.cap = 4;
    v.push(10);
    v.push(20);
    v.push(30);
    i32 ok = 1;
    if (v.size() != 3) ok = 0;
    if (v.at(0) != 10) ok = 0;
    if (v.at(1) != 20) ok = 0;
    if (v.at(2) != 30) ok = 0;
    return ok;
}
