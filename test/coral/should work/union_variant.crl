/* union + variant lowering (union-variant-ir.md): unions share one
 * aligned blob with fields bitcast at offset 0; variants are
 * { i32 tag; blob payload } with case-struct bitcast access,
 * construction, x.tag read/write, V::Case ordinals, pattern bindings,
 * and by-value aggregate argument/return ABI. */

union U {
    i32 i;
    f64 d;
    i64 l;
}

variant Shape {
    Point { i32 x; i32 y; },
    Circle { f64 r; },
    Empty
}

f64 area(Shape s)
{
    f64 a = 0.0;
    switch (s) {
        Shape::Point { x, y } => { a = (f64)(x * y); },
        Shape::Circle { r } => { a = 3.0 * r * r; },
        Shape::Empty => { a = -1.0; }
    }
    return a;
}

Shape mkpoint() { return Shape::Point { .x = 6, .y = 7 }; }

pub i32 main()
{
    i32 r = 0;

    /* union: overlapping fields at offset 0 */
    U u;
    u.i = 42;
    if (u.i == 42) r = r + 1;
    u.d = 3.5;
    if (u.d == 3.5) r = r + 2;
    u.l = 0x1122334455667788;
    if ((u.l >> 32) == 0x11223344) r = r + 4;

    /* variant: construction, by-value arg, pattern bindings */
    Shape p = Shape::Point { .x = 3, .y = 4 };
    if (area(p) == 12.0) r = r + 8;
    Shape c = Shape::Circle { .r = 2.0 };
    if (area(c) == 12.0) r = r + 16;
    Shape e = Shape::Empty {};
    if (area(e) == -1.0) r = r + 32;

    /* tag read/write + V::Case ordinal + aggregate copy + return */
    if (p.tag == Shape::Point) r = r + 64;
    p.tag = Shape::Empty;
    if (p.tag == 2) r = r + 128;
    Shape q = p;
    if (q.tag == Shape::Empty) r = r + 256;

    /* variant returned by value, multi-field + float payload binds */
    Shape m = mkpoint();
    i32 s = 0;
    switch (m) {
        Shape::Point { x, y } => { s = x * y; },
        Shape::Circle { r } => { s = -1; },
        Shape::Empty => { s = -2; }
    }
    if (s == 42) r = r + 512;

    return r == 1023 ? 0 : 1;
}
