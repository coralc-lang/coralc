#[[noprelude]]
// std::result + std::option under [[noprelude]]: the std preimports
// (str/option/result/arr) are off but core::error still links, so the
// @assert/@assertOut paths inside unwrap/take compile and the trap
// symbols resolve. Imports are explicit.
import std::result { Result };
import std::option { Option };

pub i32 main()
{
    Result<i32, i32> r1 = Result<i32, i32>::Ok { .value = 40 };
    Result<i32, i32> r2 = Result<i32, i32>::Err { .error = -7 };
    Option<i32> o1 = Option<i32>::Some { .value = 2 };
    Option<i32> o2 = Option<i32>::None;

    i32 r = 0;
    if (r1.isOk() && !r1.isErr()) r += 1;
    if (r2.isErr() && !r2.isOk()) r += 2;
    if (r1.unwrap() == 40) r += 4;
    if (r1.unwrapOr(0) == 40) r += 8;
    if (r2.unwrapOr(9) == 9) r += 16;
    if (r2.unwrapErr() == -7) r += 32;
    if (o1.isSome() && !o1.isNone()) r += 64;
    if (o2.isNone() && !o2.isSome()) r += 128;
    if (o1.unwrap() == 2) r += 256;
    if (o1.unwrapOr(0) == 2) r += 512;
    if (o2.unwrapOr(5) == 5) r += 1024;

    // by-value copies + aggregate payloads through std generics
    Result<i32, i32> r3 = r1;
    Option<i32> o3 = o1;
    if (r3.unwrapOr(0) == 40) r += 2048;
    if (o3.unwrapOr(0) == 2) r += 4096;

    return r == 8191 ? 0 : 1;
}
