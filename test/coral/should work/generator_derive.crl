#[[generate(Debug, Eq)]] // 
pub struct Point
{
    i32 x;
    i32 y;
}

pub i32 main()
{
    Point p = { .x = 1, .y = 2 };
    Point x = { .x = 22, .y = 22 };

    if (p == x) { // i'm not looking for memcmp it should run an eq method in the trait. or rahter, since we used generator, it should drop the scaffolding extend block for us.  not physically drop it, but mark the type as implementing it. so we can basically just write our trait methods in the stuct body or any other extend block 
    return p.x + p.y; }

    return 0;
}
