#[[freestanding]]
/* [[packed]]: no padding between fields — offsets are purely
 * sequential. Size must equal the sum of field sizes. */
#[[packed]]
pub struct Packed3
{
    u8 a;
    i32 b;
    u8 c;
}

pub i32 main()
{
    Packed3 p = Packed3 { .a = 1, .b = 0x01020304, .c = 5 };
    i32 ok = 1;
    if (p.a != 1) ok = 0;
    if (p.b != 0x01020304) ok = 0;
    if (p.c != 5) ok = 0;
    if (@sizeof(Packed3) != 6) ok = 0;
    return ok;
}
