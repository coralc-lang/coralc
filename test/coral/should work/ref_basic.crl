void bump(i32& x) { x = x + 1; }
i32& getRef(i32& r) { return r; }
i32 readIt(i32& r) { return r; }

struct P { i32 a; i32 b; }
void setA(P& p, i32 v) { p.a = v; }

pub i32 main()
{
    i32 v = 41;
    i32& r = v;
    r = r + 1;
    if (v != 42) return 1;
    if (r != 42) return 2;

    bump(v);
    if (v != 43) return 3;

    i32& r2 = r;
    r2 = 100;
    if (v != 100) return 4;

    i32& g = getRef(r);
    g = 7;
    if (v != 7) return 5;

    if (readIt(r) != 7) return 6;

    P p = P { .a = 1, .b = 2 };
    P& pr = p;
    pr.a = 9;
    pr.b = pr.a + 1;
    if (p.a != 9 || p.b != 10) return 7;
    setA(pr, 33);
    if (p.a != 33) return 8;

    i32[3] arr;
    arr[0] = 5; arr[1] = 6; arr[2] = 7;
    i32& e = arr[1];
    e = e * 2;
    if (arr[1] != 12) return 9;

    return 0;
}
