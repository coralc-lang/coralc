#[[freestanding]]
/* constant-only switch: every arm is literal patterns + else, so the
 * backend should emit a single muvm Switch terminator (see the
 * "switch" instruction in --emit-ir output). */
pub i32 main()
{
    i32 x = 2;
    i32 r = 0;
    switch (x)
    {
        1 => { r = 10; },
        2 => { r = 20; },
        3 => { r = 30; },
        4 => { r = 40; },
        else => { r = -1; }
    }
    return r;
}
