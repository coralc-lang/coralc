pub u64 hashOf(str s) { // i don't know, this should be on a format literal, not a runtime string.
    u64 h = 0xcbf29ce484222325;
    comptime {
        for (u64 i = 0; i < s.len; i++) {
            h = (h ^ (u64)s.ptr[i]) * 0x100000001b3;
        }
    }
    return h;
}

pub void main() {
    print("Hello world {} ", hashOf("hello world") - hashOf("you"));
}
