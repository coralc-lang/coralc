#[[freestanding]]
/* runtime-bound loops: the vectorizer currently requires a constant
 * trip count, so these stay scalar — but [[vectorise]] must still be
 * accepted and produce correct code. */

#[[vectorise]]
i64 vsum(i64 n, i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < n; i++) { s = s + a[i]; }
    return s;
}

#[[novector]]
i64 nsum(i64 n, i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < n; i++) { s = s + a[i]; }
    return s;
}

pub i32 main()
{
    i64[64] a = {0};
    i64 i = 0;
    while (i < 64) { a[i] = i; i++; }
    /* 2016 + 2016 = 4032 */
    return (i32)(vsum(64, &a[0]) + nsum(64, &a[0])) == 4032 ? 0 : 1;
}
