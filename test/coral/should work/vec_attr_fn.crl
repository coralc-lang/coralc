#[[freestanding]]
/* function-level vectorization attributes: [[vectorise]] marks the
 * function for the simd_vec pass (emitted as !vectorize metadata),
 * [[vectorise(N)]] additionally records a width hint
 * (!vectorize.width), and [[novector]] is a hard opt-out (!novector).
 * All three must still produce correct results at every opt level. */

#[[vectorise]]
i64 vsum(i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < 64; i++) { s = s + a[i]; }
    return s;
}

#[[vectorise(4)]]
i64 wsum(i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < 64; i++) { s = s + a[i]; }
    return s;
}

#[[novector]]
i64 nsum(i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < 64; i++) { s = s + a[i]; }
    return s;
}

pub i32 main()
{
    i64[64] a = {0};
    i64 i = 0;
    while (i < 64) { a[i] = i; i++; }
    /* sum 0..63 = 2016 each */
    if (vsum(&a[0]) != 2016) return 1;
    if (wsum(&a[0]) != 2016) return 2;
    if (nsum(&a[0]) != 2016) return 3;
    return 0;
}
