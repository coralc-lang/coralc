#[[freestanding]]
/* [[reorder]]: the compiler lays fields out by descending alignment,
 * not declaration order. Field access and literals must still resolve
 * by name — i64 pad fields move ahead of the i8 tag. */
#[[reorder, packed]]
pub struct Msg
{
    u8 tag;
    u8 flags;
    i64 payload;
    u16 kind;
}

pub i32 main()
{
    Msg m = Msg { .tag = 7, .flags = 3, .payload = 0x1122334455667788, .kind = 9 };
    i64 p = m.payload;
    i32 ok = 1;
    if (m.tag != 7) ok = 0;
    if (m.flags != 3) ok = 0;
    if (p != 0x1122334455667788) ok = 0;
    if (m.kind != 9) ok = 0;
    m.payload = 42;
    if (m.payload != 42) ok = 0;
    return ok;
}
