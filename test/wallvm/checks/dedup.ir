// expect: 0
// dominance-based dedup: %j is bounds-checked before the first gep in
// entry; the two geps in body (same SSA index, dominated block) must
// collapse into that one check — the O0 asm must contain exactly one
// call _trap.
module "dedup"

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    %j = load i64 %i
    %g0 = gep %arr, %j
    store i64 1, %g0
    br body

body:
    %g1 = gep %arr, %j
    store i64 1, %g1
    %g2 = gep %arr, %j
    store i64 1, %g2
    ret i32 0
}
