// expect: 70
// div-by-zero: the divisor loads as 0, so the divzero check fires before
// sdiv executes and trap_stub exits 70.
module "divzero"

func @main() i32 {
entry:
    %z = alloca i64
    store i64 0, %z
    %d = load i64 %z
    %q = sdiv i64 100, %d
    %t = trunc i64 %q to i32
    ret i32 %t
}
