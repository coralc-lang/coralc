// expect: 0
// no false positives: negative+negative add, both i32 range boundaries
// built by in-range subs/adds, chained arithmetic — every signed flag
// stays 0 and the program returns 0 under instrumentation.
module "overflow_safe"

func @main() i32 {
entry:
    %a = add i64 -1, -1
    %b = sub i32 -1073741824, 1073741824
    %c = add i32 1073741823, 1073741824
    %d = add i32 %b, %c
    %e = add i64 %a, %a
    ret i32 0
}
