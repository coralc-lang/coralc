// expect: 70
// aux-tagged unsigned overflow: -1 + 0 is a perfectly fine signed add
// (flag 0, no trap), then `add.u` sees the carry 0xFFFFFFFF + 1 -> 0 and
// exits 70. Without the .u suffix this program would NOT trap, so this
// pins the IR_AUX_UNSIGNED path end to end.
module "overflow_u"

func @main() i32 {
entry:
    %n = add i32 -1, 0
    %x = add.u i32 %n, 1
    ret i32 %x
}
