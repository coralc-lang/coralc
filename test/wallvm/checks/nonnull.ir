// expect: 70
// null dereference: @z holds 0, loaded as a pointer and then dereferenced
// — the null check on the second load fires and trap_stub exits 70.
// (The first load is from the global itself, which is provably non-null.)
module "nonnull"

global @z: i64 = 0;

func @main() i32 {
entry:
    %n = load ptr @z
    %v = load i64 %n
    %t = trunc i64 %v to i32
    ret i32 %t
}
