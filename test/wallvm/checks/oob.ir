// expect: 70
// bounds violation: loop indexes a[0..6] over an array of length 5 —
// the O0 check fires when i == 5 and trap_stub exits 70.
module "oob"

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    br loop

loop:
    %iv = load i64 %i
    %c = icmp slt i64 %iv, 7
    cond_br %c, body, done

body:
    %j = load i64 %i
    %slot = gep %arr, %j
    store i64 1, %slot
    %n = load i64 %i
    %n2 = add i64 %n, 1
    store i64 %n2, %i
    br loop

done:
    ret i32 0
}
