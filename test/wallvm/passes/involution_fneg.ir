// fabs(fneg(x)) keeps the fabs: the fold must not hand users the raw
// operand (fabs(-3.5) is 3.5, x itself is -3.5)
// level: O1
// expect: 3
module "involution_fneg"

global @g: f64 = -3.5;

func @main() i32 {
entry:
    %x = load f64 @g
    %n = neg f64 %x
    %a = fabs f64 %n
    %r = fptosi f64 %a to i32
    ret i32 %r
}
