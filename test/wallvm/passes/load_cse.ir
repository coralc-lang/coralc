// level: O2
// expect: 14
// gvn: two loads from the same pointer with no store between — one
// register-indirect movq remains. (Without gvn: two.)
// count: 1, movq (%r
module "p_loadcse"

global @idx: i64 = 0;

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %idx = load i64 @idx
    %s0 = gep %arr, %idx
    store i64 7, %s0
    %a = load i64 %s0
    %b = load i64 %s0
    %s = add i64 %a, %b
    %t = trunc i64 %s to i32
    ret i32 %t
}
