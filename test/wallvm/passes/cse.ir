// level: O1
// expect: 12
// cse: %a and %b both load @seed with no store between — one load
// reaches the asm. (Without cse: two movq seed(%rip).)
// count: 1, movq seed(%rip)
module "p_cse"

global @seed: i64 = 7;

func @main() i32 {
entry:
    %v = load i64 @seed
    %a = sub i64 %v, 1
    %b = sub i64 %v, 1
    %s = add i64 %a, %b
    %t = trunc i64 %s to i32
    ret i32 %t
}
