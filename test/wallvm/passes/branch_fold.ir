// level: O1
// expect: 42
// sccp/branchprop: the constant condition folds — the not-taken arm
// and its 9987 immediate disappear from the asm.
// absent: 2703
module "p_branch"

func @main() i32 {
entry:
    %k = add i64 1, 1
    %c = icmp eq i64 %k, 2
    cond_br %c, yes, no
yes:
    ret i32 42
no:
    ret i32 9987
}
