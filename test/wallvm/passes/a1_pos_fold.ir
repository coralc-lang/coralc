// level: O3
// expect: 2
// A1 positive control: entry tests c, A (reached only when c) tests !c with
// A's FALSE edge = entry's false target, so both paths reach B and entry
// collapses to `br B` (branch_fact case 1, correct edge). Verified via
// WALLVM_PRINT_AFTER_PASS: the branch_fact dump shows `br B`, then sccp
// drops A/X and adce drops the dead loads — no gx reference, no jumps.
// absent: movl gx(%rip)
// absent: jge
// absent: jl
module "a1_pos_fold"

global @gx: i32 = 3;
global @gy: i32 = 10;

func @main() i32 {
entry:
    %x = load i32 @gx
    %y = load i32 @gy
    %c = icmp slt i32 %x, %y
    cond_br %c, A, B
A:
    %c2 = icmp sge i32 %x, %y
    cond_br %c2, X, B
B:
    ret i32 2
X:
    ret i32 1
}
