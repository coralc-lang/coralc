// fptrunc(fpext(x)) round trip collapses at O1: no widening conversion
// may survive (the fold compares against the fpext source width)
// level: O1
// expect: 1
// absent: cvtss2sd
module "involution_fpwiden"

global @g: f32 = 1.5;

func @main() i32 {
entry:
    %x = load f32 @g
    %e = fpext f32 %x to f64
    %t = fptrunc f64 %e to f32
    %r = fptosi f32 %t to i32
    ret i32 %r
}
