// level: O1
// expect: 42
// dce: %dead/%dead2 form an unused chain — the multiply must not reach
// the asm even after constfold reduces it.
// absent: imul
module "p_dce"

func @main() i32 {
entry:
    %n = alloca i64
    store i64 7, %n
    %v = load i64 %n
    %dead = mul i64 %v, 3
    %dead2 = add i64 %dead, 11
    ret i32 42
}
