// level: O1
// expect: 2
// dse: the store of 9987 is overwritten by the store of 2 to the same
// pointer value — only the final store's immediate may remain.
// absent: 2703
module "p_dse"

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %s0 = gep %arr, 0
    store i64 9987, %s0
    store i64 2, %s0
    %v = load i64 %s0
    %t = trunc i64 %v to i32
    ret i32 %t
}
