// borrow-expect: DoubleBorrow DanglingPointerDeref StoreVsLiveLoad
module "borrow_double"

func @main() i32 {
entry:
    %pslot = alloca ptr
    %t = alloca i64
    store ptr %t, %pslot
    %l = load ptr %pslot
    %x = load i64 %l
    store i64 1, %l
    %y = load i64 %x
    %r = trunc i64 %y to i32
    ret i32 %r
}
