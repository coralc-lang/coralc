// borrow-expect: StaleLoadAcrossCall
module "borrow_stale"

func @sink(%p: ptr) {
entry:
    store i64 1, %p
    ret
}

func @main() i32 {
entry:
    %target = alloca i64
    %slot = alloca ptr
    store ptr %target, %slot
    %l = load ptr %slot
    call void @sink(ptr %slot)
    %v = load i64 %l
    %r = trunc i64 %v to i32
    ret i32 %r
}
