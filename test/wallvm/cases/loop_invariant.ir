// expect: 210
// loop-invariant expression inside the loop (LICM target):
// sum of (3*7) ten times = 210
module "loop_invariant"

func @main() i32 {
entry:
    %i = alloca i64
    %s = alloca i64
    store i64 0, %i
    store i64 0, %s
    br loop

loop:
    %iv = load i64 %i
    %cmp = icmp slt i64 %iv, 10
    cond_br %cmp, body, done

body:
    %inv = mul i64 3, 7
    %sv = load i64 %s
    %acc = add i64 %sv, %inv
    store i64 %acc, %s
    %iv2 = load i64 %i
    %next = add i64 %iv2, 1
    store i64 %next, %i
    br loop

done:
    %res = load i64 %s
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
