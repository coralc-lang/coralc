// expect: 55
// countdown loop: sum 10..1
module "countdown"

func @main() i32 {
entry:
    %i = alloca i64
    %s = alloca i64
    store i64 10, %i
    store i64 0, %s
    br loop

loop:
    %iv = load i64 %i
    %cmp = icmp sgt i64 %iv, 0
    cond_br %cmp, body, done

body:
    %iv2 = load i64 %i
    %sv = load i64 %s
    %acc = add i64 %sv, %iv2
    store i64 %acc, %s
    %iv3 = load i64 %i
    %next = sub i64 %iv3, 1
    store i64 %next, %i
    br loop

done:
    %res = load i64 %s
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
