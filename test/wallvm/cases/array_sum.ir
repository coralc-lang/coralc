; expect: 15
; array in memory: fill a[0..4] with 1..5, sum = 15 (GEP/load path)
module "array_sum"

func @main() i32 {
entry:
    %arr = alloca array i64 5
    %i = alloca i64
    store i64 0, %i
    br fill

fill:
    %iv = load i64 %i
    %fc = icmp slt i64 %iv, 5
    cond_br %fc, fill_body, sum_pre

fill_body:
    %iv2 = load i64 %i
    %slot = gep ptr %arr, i64 %iv2
    %val = add i64 %iv2, 1
    store i64 %val, ptr %slot
    %iv3 = load i64 %i
    %in = add i64 %iv3, 1
    store i64 %in, %i
    br fill

sum_pre:
    store i64 0, %i
    %s = alloca i64
    store i64 0, %s
    br sum

sum:
    %jv = load i64 %i
    %sc = icmp slt i64 %jv, 5
    cond_br %sc, sum_body, done

sum_body:
    %jv2 = load i64 %i
    %slot2 = gep ptr %arr, i64 %jv2
    %elem = load i64 ptr %slot2
    %sv = load i64 %s
    %acc = add i64 %sv, %elem
    store i64 %acc, %s
    %jv3 = load i64 %i
    %jn = add i64 %jv3, 1
    store i64 %jn, %i
    br sum

done:
    %res = load i64 %s
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
