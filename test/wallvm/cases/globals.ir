// expect: 52
// file-scope variables: mutable global read/modify/write, const global
// load, and a global initialized to another global's address (pointer
// alias), dereferenced back to the value it points at
module "globals"

global @counter: i64 = 10;
global const @answer: i64 = 42;
global @alias: ptr i64 = @counter;

func @main() i32 {
entry:
    %c = load i64 @counter
    %a = load i64 @answer
    %s = add i64 %c, %a
    store i64 %s, @counter
    %ap = load ptr @alias
    %v = load i64 %ap
    %r = trunc i64 %v to i32
    ret i32 %r
}
