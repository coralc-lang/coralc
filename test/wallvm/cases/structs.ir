// expect: 57
// named struct in memory: alloca + gep field addressing across a
// padding boundary (i32 then i64 lands y at offset 8), scalar stores
// and loads through the field pointers. 7 + 50 = 57
module "structs"

type @Pair = struct { x: i32, y: i64 };

func @main() i32 {
entry:
    %p = alloca struct @Pair
    %px = gep %p, 0
    %py = gep %p, 1
    store i32 7, %px
    store i64 50, %py
    %x = load i32 %px
    %xe = zext i32 %x to i64
    %y = load i64 %py
    %s = add i64 %xe, %y
    %r = trunc i64 %s to i32
    ret i32 %r
}
