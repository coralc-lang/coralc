// expect: 170
// D2 repro: a narrow store only overwrites half of a wider one — dse must
// not treat `store i64` as dead under a later `store i32` at the same
// address. i64 = 0xAA00000000, then i32 = 5 -> memory 0xAA00000005,
// high word 0xAA = 170. If the wide store is killed the high word stays 0.
func @main() i32 {
entry:
    %p = alloca i64
    store i64 0, %p
    store i64 730144440320, %p
    store i32 5, %p
    %v = load i64 %p
    %hi = lshr i64 %v, 32
    %r = trunc i64 %hi to i32
    ret i32 %r
}
