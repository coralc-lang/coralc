// expect: 12
// phi-swap cycle: a,b swap each iteration (parallel-copy cycle through RA)
module "swap_phi"

func @main() i32 {
entry:
    br loop

loop:
    %a = phi i64 [ 1, entry ], [ %b, loop ]
    %b = phi i64 [ 2, entry ], [ %a, loop ]
    %i = phi i64 [ 0, entry ], [ %in, loop ]
    %in = add i64 %i, 1
    %cmp = icmp slt i64 %in, 4
    cond_br %cmp, loop, done

done:
    %t = mul i64 %a, 10
    %r = add i64 %t, %b
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
