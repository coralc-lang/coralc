// expect: 3
// %c1 = (v >= 100) is false at v=0; computing it does not make it true,
// so %c2 = (v >= 50) must not be folded to true from it (range_br_elim,
// O1+)
module "a3_unguarded_range"

global @g: i32 = 0;

func @main() i32 {
entry:
    br A
A:
    %x = load i32 @g
    %c1 = icmp sge i32 %x, 100
    %c2 = icmp sge i32 %x, 50
    cond_br %c2, T, F
T:
    ret i32 7
F:
    ret i32 3
}
