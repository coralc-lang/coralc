// expect: 30
// D3: analyze() caches a multi-object phi as the FIRST incoming object, so
// queries through the phi answer NoAlias against the other arm's object —
// gvn then keeps a stale load across a store to the real object. The flag
// alloca is mixed-width (store i8 into i64) so mem2reg/sccp cannot fold the
// branch away; runtime takes the `els` arm: phi = %b, correct %v2 = 30,
// stale-forwarded %v2 = 20.
func @main() i32 {
entry:
    %a = alloca i64
    %b = alloca i64
    %f = alloca i64
    store i64 0, %a
    store i64 5, %b
    store i64 1, %f
    store i8 1, %f
    %fv = load i64 %f
    %c = icmp sgt i64 %fv, 0
    cond_br %c, els, then

then:
    store i64 10, %a
    br merge

els:
    store i64 20, %b
    br merge

merge:
    %ph = phi ptr [ %a, then ], [ %b, els ]
    %v1 = load i64 %ph
    store i64 30, %b
    %v2 = load i64 %ph
    %r = trunc i64 %v2 to i32
    ret i32 %r
}
