; expect: 55
; iterative fibonacci: two loop-carried scalars (a,b) = (fib(n+1), fib(n))
module "fib_iter"

func @main() i32 {
entry:
    %i = alloca i64
    %a = alloca i64
    %b = alloca i64
    store i64 0, %i
    store i64 1, %a
    store i64 0, %b
    br loop

loop:
    %iv = load i64 %i
    %cmp = icmp slt i64 %iv, 10
    cond_br %cmp, body, done

body:
    %av = load i64 %a
    %bv = load i64 %b
    %sum = add i64 %av, %bv
    store i64 %bv, %a
    store i64 %sum, %b
    %iv2 = load i64 %i
    %next = add i64 %iv2, 1
    store i64 %next, %i
    br loop

done:
    %res = load i64 %b
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
