// expect: 9
module "floats"

func @main() i32 {
entry:
    %a = sitofp i32 7 to f64
    %b = fptosi f64 %a to i32
    %c = sitofp i32 %b to f32
    %d = fptosi f32 %c to i32
    %e = uitofp i32 %d to f64
    %f = fptoui f64 %e to i32
    %g = sitofp i64 2 to f64
    %h = fptosi f64 %g to i64
    %i = trunc i64 %h to i32
    %r = add i32 %f, %i
    ret i32 %r
}
