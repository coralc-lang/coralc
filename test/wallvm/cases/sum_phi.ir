; expect: 45
; same as sum_loop but with explicit phis (frontend-pre-promoted form;
; unroll recognition path)
module "sum_phi"

func @main() i32 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %acc, body ]
    %cmp = icmp slt i64 %i, 10
    cond_br %cmp, body, done

body:
    %acc = add i64 %s, %i
    %in = add i64 %i, 1
    br loop

done:
    %r32 = trunc i64 %s to i32
    ret i32 %r32
}
