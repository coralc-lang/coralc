// expect: 42
// D1: a store on a side path that does not dominate the load must not be
// forwarded into the load. The address escapes into @holder so mem2reg
// keeps the load/store; @input is never stored, so no pass can fold the
// condition and the side block stays reachable-but-untaken at runtime.
// Pre-fix O3 machine_opt forwards 99 (array-ordered MemorySSA walk picks
// the side store, no dominance check); correct is 42.
module "d1_sidefwd"

global @holder: ptr i32 = 0;
global @input: i32 = 1;

func @main() i32 {
entry:
    %p = alloca i32
    store i32 42, %p
    store ptr %p, @holder
    %x = load i32 @input
    %c = icmp eq i32 %x, 0
    cond_br %c, side, head

side:
    store i32 99, %p
    ret i32 0

head:
    %v = load i32 %p
    ret i32 %v
}
