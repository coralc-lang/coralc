// expect: 8
// memory input: %1 expands to (%reg) pointing at x (7); addq $1 → 8
module "asm_mem"

func @main() i32 {
entry:
    %x = alloca i64
    %res = alloca i64
    store i64 7, %x
    inlineasm void "movq %1, %0\naddq $1, %0" : "=r,m" : "cc" (ptr %res, ptr %x)
    %v = load i64 %res
    %v32 = trunc i64 %v to i32
    ret i32 %v32
}
