// expect: 6
// Euclid gcd loop: gcd(48, 18) = 6
module "gcd"

func @main() i32 {
entry:
    %a = alloca i64
    %b = alloca i64
    store i64 48, %a
    store i64 18, %b
    br loop

loop:
    %bv = load i64 %b
    %cmp = icmp ne i64 %bv, 0
    cond_br %cmp, body, done

body:
    %av = load i64 %a
    %bv2 = load i64 %b
    %r = srem i64 %av, %bv2
    store i64 %bv2, %a
    store i64 %r, %b
    br loop

done:
    %res = load i64 %a
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
