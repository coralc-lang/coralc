// expect: 0
// sitofp(fptosi(x)) is not an identity: 1.5 must truncate to 1 (so the
// round trip compares unequal to the original and gives 0), not survive
// as 1.5 (which would compare equal and give 1)
module "fp_roundtrip"

global @g: f64 = 1.5;

func @main() i32 {
entry:
    %x = load f64 @g
    %i = fptosi f64 %x to i64
    %f = sitofp i64 %i to f64
    %c = fcmp oeq f64 %f, %x
    %r = zext i1 %c to i32
    ret i32 %r
}
