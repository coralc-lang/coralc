// expect: 2
// sitofp(fptosi(x)) is not an identity: 1.5 must truncate to 1 (so the
// doubled result is 2.0 -> 2), not survive as 1.5 (which would give 3)
module "fp_roundtrip"

global @g: f64 = 1.5;

func @main() i32 {
entry:
    %x = load f64 @g
    %i = fptosi f64 %x to i64
    %f = sitofp i64 %i to f64
    %m = fmul f64 %f, 2.0
    %r = fptosi f64 %m to i32
    ret i32 %r
}
