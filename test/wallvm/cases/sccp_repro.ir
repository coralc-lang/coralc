// expect: 55
// repro: inliner-shaped main (const icmp, phi, empty entry br) crashes sccp at O2
module "sccp_repro"

func @fib(%n: i64) i64 {
entry:
    %cmp = icmp slt i64 %n, 2
    cond_br %cmp, base, rec
base:
    %9 = ret i64 %n
rec:
    %n1 = sub i64 %n, 1
    %n2 = sub i64 %n, 2
    %a = call i64 @fib(i64 %n1)
    %b = call i64 @fib(i64 %n2)
    %s = add i64 %a, %b
    %16 = ret i64 %s
}

func @main() i32 {
entry:
    %r = call i64 @fib(i64 10)
    %r32 = trunc i64 %r to i32
    %22 = ret i32 %r32
}
