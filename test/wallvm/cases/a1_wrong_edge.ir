// expect: 1
// bb tests c, A tests !c: A is reached only when c is true, so A always
// takes its FALSE edge (X). Collapsing bb to the false target when only
// A's true edge matches is a miscompile (branch_fact, O3)
module "a1_wrong_edge"

global @gx: i32 = 3;
global @gy: i32 = 10;

func @main() i32 {
entry:
    %x = load i32 @gx
    %y = load i32 @gy
    %c = icmp slt i32 %x, %y
    cond_br %c, A, B
A:
    %c2 = icmp sge i32 %x, %y
    cond_br %c2, B, X
B:
    ret i32 2
X:
    ret i32 1
}
