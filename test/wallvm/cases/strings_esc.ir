// expect: 142
// string-pool escaping end to end: quote, backslash, newline, and
// high/low bytes travel through parse -> .asciz -> gas -> run.
// bytes: a " b \ c \n d \x01 \xff -> 61 22 62 5c 63 0a 64 01 ff
// xor-fold: 0x8e = 142
module "strings_esc"

string @msg: "a\"b\\c\nd\x01\xff";

func @main() i32 {
entry:
    %p0 = gep @msg, 0
    %p1 = gep @msg, 1
    %p2 = gep @msg, 2
    %p3 = gep @msg, 3
    %p4 = gep @msg, 4
    %p5 = gep @msg, 5
    %p6 = gep @msg, 6
    %p7 = gep @msg, 7
    %p8 = gep @msg, 8
    %b0 = load i8 %p0
    %b1 = load i8 %p1
    %b2 = load i8 %p2
    %b3 = load i8 %p3
    %b4 = load i8 %p4
    %b5 = load i8 %p5
    %b6 = load i8 %p6
    %b7 = load i8 %p7
    %b8 = load i8 %p8
    %e0 = zext i8 %b0 to i64
    %e1 = zext i8 %b1 to i64
    %e2 = zext i8 %b2 to i64
    %e3 = zext i8 %b3 to i64
    %e4 = zext i8 %b4 to i64
    %e5 = zext i8 %b5 to i64
    %e6 = zext i8 %b6 to i64
    %e7 = zext i8 %b7 to i64
    %e8 = zext i8 %b8 to i64
    %x1 = xor i64 %e0, %e1
    %x2 = xor i64 %x1, %e2
    %x3 = xor i64 %x2, %e3
    %x4 = xor i64 %x3, %e4
    %x5 = xor i64 %x4, %e5
    %x6 = xor i64 %x5, %e6
    %x7 = xor i64 %x6, %e7
    %x = xor i64 %x7, %e8
    %r = trunc i64 %x to i32
    ret i32 %r
}
