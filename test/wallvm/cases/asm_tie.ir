// expect: 42
// tied "0" input shares the output register; "i" feeds %1 as $2
module "asm_tie"

func @main() i32 {
entry:
    %res = alloca i64
    store i64 40, %res
    inlineasm void "addq %2, %0" : "=r,0,i" : "" (ptr %res, i64 40, i64 2)
    %v = load i64 %res
    %v32 = trunc i64 %v to i32
    ret i32 %v32
}
