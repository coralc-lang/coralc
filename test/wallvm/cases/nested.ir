; expect: 18
; nested loops: sum of i*j for i in 0..3, j in 0..2
module "nested"

func @main() i32 {
entry:
    %i = alloca i64
    %s = alloca i64
    store i64 0, %i
    store i64 0, %s
    br outer

outer:
    %iv = load i64 %i
    %oc = icmp slt i64 %iv, 4
    cond_br %oc, inner_pre, done

inner_pre:
    %j = alloca i64
    store i64 0, %j
    br inner

inner:
    %jv = load i64 %j
    %ic = icmp slt i64 %jv, 3
    cond_br %ic, inner_body, inner_done

inner_body:
    %iv2 = load i64 %i
    %jv2 = load i64 %j
    %prod = mul i64 %iv2, %jv2
    %sv = load i64 %s
    %acc = add i64 %sv, %prod
    store i64 %acc, %s
    %jv3 = load i64 %j
    %jn = add i64 %jv3, 1
    store i64 %jn, %j
    br inner

inner_done:
    %iv3 = load i64 %i
    %in = add i64 %iv3, 1
    store i64 %in, %i
    br outer

done:
    %res = load i64 %s
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
