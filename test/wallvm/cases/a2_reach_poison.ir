// expect: 8
// The eq(v,5) fact holds only on the taken edge (T), but F reaches T and
// then M, so M is reachable with v=7 (7+1=8). Dominance of M by T is not
// "v==5 on every path" (branchprop, O1+)
module "a2_reach_poison"

global @g: i32 = 7;

func @main() i32 {
entry:
    %x = load i32 @g
    %c = icmp eq i32 %x, 5
    cond_br %c, T, F
T:
    br M
F:
    br T
M:
    %r = add i32 %x, 1
    ret i32 %r
}
