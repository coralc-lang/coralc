// expect: 0
// cb==e tail-call shape: capterm block is the entry block itself. The
// callee never returns (infinite recursion), so the transformed loop has no
// ret anywhere; main never calls it. Locks the tco teardown/e-cleanup path
// and the peephole br-cycle chase (both hung O3 before).
module "e8"
func @inf(%n: i64) i64 {
entry:
    %r = call i64 @inf(i64 %n)
    %s = add i64 %r, %n
    ret i64 %s
}
func @main() i32 {
entry:
    ret i32 0
}
