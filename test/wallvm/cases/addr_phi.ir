// expect: 7
// P0-16b: the alloca's address flows through an input-level phi. mem2reg's
// promotability check blanket-allows Phi users ("these were placed by us"),
// but at check time no phis exist yet — so the address-escaping alloca is
// promoted and cleanup frees it while the phi still references it.
func @main() i32 {
entry:
    %p = alloca i64
    br loop

loop:
    %ph = phi ptr [ %p, entry ], [ %ph, body ]
    %v = load i64 %ph
    %cmp = icmp slt i64 %v, 7
    cond_br %cmp, body, done

body:
    store i64 7, %ph
    br loop

done:
    %r = trunc i64 %v to i32
    ret i32 %r
}
