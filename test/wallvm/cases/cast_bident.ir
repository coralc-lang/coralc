// expect: 7
// identity bitcast: the fold must hand its users over, not orphan the
// instruction while the add still names it
module "cast_bident"

global @g: i64 = 6;

func @main() i32 {
entry:
    %x = load i64 @g
    %a = bitcast i64 %x to i64
    %b = add i64 %a, 1
    %r = trunc i64 %b to i32
    ret i32 %r
}
