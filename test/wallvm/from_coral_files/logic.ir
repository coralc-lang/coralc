module "coral"

func @main() i32 {
    %3  = alloca i1
    %4  = alloca i1
    %7  = icmp ne i1 true, false
    cond_br %7, sc.rhs, sc.end
sc.rhs:
    %14 = icmp eq i1 false, false
    %15 = icmp ne i1 %14, false
    store i1 %15, %4
    br sc.join
sc.end:
    store i1 false, %4
    br sc.join
sc.join:
    %18 = load i1 %4
    store i1 %18, %3
    %20 = alloca i1
    %21 = alloca i1
    %22 = icmp ne i1 true, false
    cond_br %22, sc.rhs, sc.end
sc.rhs:
    %29 = icmp eq i1 true, false
    %30 = icmp ne i1 %29, false
    store i1 %30, %21
    br sc.join
sc.end:
    store i1 false, %21
    br sc.join
sc.join:
    %33 = load i1 %21
    store i1 %33, %20
    %35 = alloca i1
    %36 = load i1 %3
    %37 = icmp ne i1 %36, false
    cond_br %37, sc.rhs, sc.end
sc.rhs:
    %44 = load i1 %20
    %45 = icmp eq i1 %44, false
    %46 = icmp ne i1 %45, false
    store i1 %46, %35
    br sc.join
sc.end:
    store i1 false, %35
    br sc.join
sc.join:
    %49 = load i1 %35
    %50 = alloca i32
    cond_br %49, sel.then, sel.else
sel.then:
    store i32 1, %50
    br sel.end
sel.else:
    store i32 0, %50
    br sel.end
sel.end:
    %61 = load i32 %50
    ret i32 %61
}
