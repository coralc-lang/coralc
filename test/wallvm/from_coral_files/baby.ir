module "coral"

type @anon.1 = struct { f0: i32, f1: i32 };

func @main() i32 {
    %3  = alloca struct @anon.1
    %4  = alloca struct @anon.1
    %6  = gep %4, 0
    store i32 2, %6
    %10 = gep %4, 1
    store i32 3, %10
    %13 = gep %3, 0
    %14 = gep %4, 0
    %15 = load i32 %14
    store i32 %15, %13
    %17 = gep %3, 1
    %18 = gep %4, 1
    %19 = load i32 %18
    store i32 %19, %17
    ret i32 0
}
