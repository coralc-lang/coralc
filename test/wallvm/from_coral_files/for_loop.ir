module "coral"

func @main() i32 {
    %3  = alloca i32
    store i32 0, %3
    %6  = alloca i32
    store i32 0, %6
    br for.head
for.head:
    %14 = load i32 %6
    %16 = icmp slt i32 %14, 10
    cond_br %16, for.body, for.close
for.body:
    %18 = load i32 %3
    %20 = add i32 %18, 1
    store i32 %20, %3
    br for.post
for.close:
    br for.end
for.post:
    %23 = load i32 %6
    %24 = add i32 %23, 1
    store i32 %24, %6
    br for.head
for.end:
    %28 = load i32 %3
    %30 = icmp eq i32 %28, 45
    %31 = alloca i32
    cond_br %30, sel.then, sel.else
sel.then:
    store i32 1, %31
    br sel.end
sel.else:
    store i32 0, %31
    br sel.end
sel.end:
    %40 = load i32 %31
    ret i32 %40
}
