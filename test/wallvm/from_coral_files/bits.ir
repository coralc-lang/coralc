module "coral"

func @main() i32 {
    %3  = alloca i32
    %6  = and i32 12, 10
    store i32 %6, %3
    %8  = alloca i32
    %9  = or i32 12, 10
    store i32 %9, %8
    %11 = alloca i32
    %12 = xor i32 12, 10
    store i32 %12, %11
    %14 = alloca i32
    %17 = shl i32 1, 4
    store i32 %17, %14
    %19 = load i32 %3
    %21 = icmp eq i32 %19, 8
    %22 = alloca i32
    cond_br %21, sel.then, sel.else
sel.then:
    %27 = load i32 %8
    %29 = icmp eq i32 %27, 14
    store i1 %29, %22
    br sel.end
sel.else:
    store i32 1, %22
    br sel.end
sel.end:
    %34 = load i32 %22
    ret i32 %34
}
