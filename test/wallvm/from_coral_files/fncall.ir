module "coral"

func @_CNf6fncall3addEFii_i(%a: i32, %b: i32) i32 {
    %5  = alloca i32
    store i32 %a, %5
    %8  = alloca i32
    store i32 %b, %8
    %10 = load i32 %5
    %11 = load i32 %8
    %12 = add i32 %10, %11
    ret i32 %12
}

func @main() i32 {
    %17 = call i32 @_CNf6fncall3addEFii_i(i32 3, i32 4)
    %19 = icmp eq i32 %17, 7
    %20 = alloca i32
    cond_br %19, sel.then, sel.else
sel.then:
    store i32 1, %20
    br sel.end
sel.else:
    store i32 0, %20
    br sel.end
sel.end:
    %31 = load i32 %20
    ret i32 %31
}
