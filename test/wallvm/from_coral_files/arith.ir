module "coral"

func @main() i32 {
    %3  = alloca i32
    %7  = mul i32 4, 2
    %8  = add i32 3, %7
    %10 = sub i32 %8, 1
    store i32 %10, %3
    %12 = alloca i32
    %13 = add i32 3, 4
    %14 = mul i32 %13, 2
    store i32 %14, %12
    %16 = alloca i32
    %18 = srem i32 10, 3
    store i32 %18, %16
    %20 = load i32 %3
    %21 = icmp eq i32 %20, 10
    %22 = alloca i32
    cond_br %21, sel.then, sel.else
sel.then:
    %27 = alloca i1
    %28 = load i32 %12
    %30 = icmp eq i32 %28, 14
    %32 = icmp ne i1 %30, false
    cond_br %32, sc.rhs, sc.end
sel.else:
    store i32 1, %22
    br sel.end
sel.end:
    %49 = load i32 %22
    ret i32 %49
sc.rhs:
    %39 = load i32 %16
    %40 = icmp eq i32 %39, 1
    %41 = icmp ne i1 %40, false
    store i1 %41, %27
    br sc.join
sc.end:
    store i1 false, %27
    br sc.join
sc.join:
    %44 = load i1 %27
    store i1 %44, %22
    br sel.end
}
