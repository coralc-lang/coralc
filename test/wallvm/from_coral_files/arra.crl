#[[freestanding]]

distinct cchar = u8;

i8[20] a = { 22, 33, 3, 4, 5, 6, 6, 6, 6, 6, 23, 45, 13, 14, 15, 16, 65, 45, 44, 54 };

i8 shuffle(i8[20] a) {
    i8 tmp = a[0];
    a[0] = a[19];
    a[19] = tmp;

    return 0;
}

extern ("kernel32") i32 printf(const cchar*, ...);

void main() {
    var c = shuffle(a);
    printf(C"%c", c);
}

