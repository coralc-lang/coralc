#[[no_drop_all]]
import(lib) wallvm::wallvm { irCompileAsm };
import(lib) wallvm::irtypes { IrContext, IrModule, irCtxCreate, irCtxDestroy };
import(lib) wallvm::irParser { IrParser, new, destroy, parseModule, getError, getErrorLine };
import(lib) wallvm::rules::asm_rules { CallingConvention };
import(lib) wallvm::assembly::wasm::encode { wasmAssemble };
import(lib) wallvm::assembly::wasm::bindings { wasmBindings };
import(lib) std::io::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import(lib) std::io::ios { println, eprintln };

void moduleNameFromPath(String* out, str path)
{
    usize slash = path.rfindByte((u8)'/');
    usize start = slash < path.len ? slash + 1 : 0;
    usize end = path.len;
    for (usize i = path.len; i > start; i--)
    {
        if (path.ptr[i - 1] == (u8)'.') { end = i - 1; break; }
    }
    out->clear();
    out->pushView(path.slice(start, end));
}

bool writeTextFile(str path, String* data)
{
    Result<File, IoError> fo = fileOpen(path, "wb");
    if (fo.isErr()) return false;
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, data->asU8(), data->len);
    fileClose(f);
    return wr.isOk();
}

i32 main(i32 argc, cchar** argv)
{
    if (argc < 3)
    {
        eprintln("usage: wastool <in.ir|in.wat> <out.wasm> [O0|O1|O2|O3]");
        return 2;
    }
    str inPath = str::fromCstr(argv[1]);
    str outPath = str::fromCstr(argv[2]);
    u32 opt = 2;
    if (argc > 3)
    {
        str o = str::fromCstr(argv[3]);
        if (o.equals("O0")) opt = 0;
        else if (o.equals("O1")) opt = 1;
        else if (o.equals("O2")) opt = 2;
        else if (o.equals("O3")) opt = 3;
    }
    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("wastool: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();
    String wat = String::new();
    String moduleName = String::new();
    if (inPath.endsWith(".wat"))
    {
        wat.pushView(src.asView());
    }
    else
    {
        IrContext* ctx = irCtxCreate();
        IrParser p = new(ctx);
        IrModule* modd = parseModule(&p, src.asView());
        if (modd == null)
        {
            eprintln("{}:{}: {}", inPath, getErrorLine(&p), getError(&p));
            destroy(&p);
            src.free();
            irCtxDestroy(ctx);
            return 1;
        }
        if (modd->name.len > 0) moduleName.pushView(modd->name);
        str text = irCompileAsm(modd, ctx, CallingConvention::Wasm32, opt);
        if (text.len == 0)
        {
            eprintln("wastool: wasm codegen produced no text");
            destroy(&p);
            src.free();
            irCtxDestroy(ctx);
            return 1;
        }
        wat.pushView(text);
        destroy(&p);
        irCtxDestroy(ctx);
    }
    if (moduleName.len == 0) moduleNameFromPath(&moduleName, outPath);
    String dumpPath = String::from(outPath);
    dumpPath.pushView(".wat");
    Result<File, IoError> df = fileOpen(dumpPath.asView(), "wb");
    if (df.isOk())
    {
        File dfh = df.unwrap();
        fileWrite(dfh, wat.ptr, wat.len);
        fileClose(dfh);
    }
    dumpPath.free();
    String err = String::new();
    u32 errLine = 0;
    String bin = String::new();
    if (!wasmAssemble(wat.asView(), &bin, &err, &errLine))
    {
        eprintln("wastool:{}: {}", errLine, err.asView());
        wat.free();
        src.free();
        err.free();
        bin.free();
        return 1;
    }
    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("wastool: cannot create {}", outPath);
        wat.free();
        src.free();
        err.free();
        bin.free();
        return 1;
    }
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, bin.asU8(), bin.len);
    fileClose(f);
    bool ok = wr.isOk();
    if (!ok) eprintln("wastool: write failed for {}", outPath);
    if (ok)
    {
        String js = String::new();
        String dts = String::new();
        u32 bindLine = 0;
        if (!wasmBindings(wat.asView(), moduleName.asView(), &js, &dts, &err, &bindLine))
            eprintln("wastool:{}: bindings: {}", bindLine, err.asView());
        else
        {
            String jsPath = String::from(outPath);
            jsPath.pushView(".js");
            String dtsPath = String::from(outPath);
            dtsPath.pushView(".d.ts");
            bool jsOk = writeTextFile(jsPath.asView(), &js);
            bool dtsOk = writeTextFile(dtsPath.asView(), &dts);
            if (!jsOk || !dtsOk) eprintln("wastool: failed to write bindings for {}", outPath);
            else ok = true;
            jsPath.free();
            dtsPath.free();
        }
        js.free();
        dts.free();
    }
    println("{}: {} bytes", outPath, bin.len);
    wat.free();
    src.free();
    err.free();
    bin.free();
    moduleName.free();
    return ok ? 0 : 1;
}
