// expect: 7
// G-type4b: constFloat dedup must compare the type. The f32 1.0 is created
// first; without the type check the later f64 1.0 reuses the f32-typed
// constant, and emitFloatBinOp (x86_64_base.crl) keys isDouble off
// ops[0]->type->width — the f64 add then runs as addss against a runtime
// operand and yields the wrong value. The f64 operand is a load so
// constfold cannot constant-fold the add away before codegen.
module "const_float_type"

global @g: i32 = 3;

func @main() i32 {
entry:
    %z = fadd f32 1.0, 2.0
    %si = fptosi f32 %z to i32
    %x = load i32 @g
    %d = sitofp i32 %x to f64
    %t = fadd f64 1.0, %d
    %ti = fptosi f64 %t to i32
    %r = add i32 %si, %ti
    ret i32 %r
}
