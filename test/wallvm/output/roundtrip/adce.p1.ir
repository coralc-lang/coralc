module "p_adce"

func @main() i32 {
entry:
    br loop
loop:
    %i    = phi i64 [ 0, entry ], [ %i1, body ]
    %acc  = phi i64 [ 0, entry ], [ %acc1, body ]
    %d    = phi i64 [ 0, entry ], [ %d1, body ]
    %c    = icmp slt i64 %i, 5
    cond_br %c, body, done
body:
    %acc1 = add i64 %acc, %i
    %i1   = add i64 %i, 1
    %d1   = add i64 %d, 1000
    br loop
done:
    %t    = trunc i64 %acc to i32
    ret i32 %t
}

