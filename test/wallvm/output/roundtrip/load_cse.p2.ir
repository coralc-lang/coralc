module "p_loadcse"

global @idx: i64 = 0 !alignment = 8;

func @main() i32 {
    %arr = alloca array i64 5
    %idx = load i64 @idx
    %s0  = gep %arr, %idx
    store i64 7, %s0
    %a   = load i64 %s0
    %b   = load i64 %s0
    %s   = add i64 %a, %b
    %t   = trunc i64 %s to i32
    ret i32 %t
}

