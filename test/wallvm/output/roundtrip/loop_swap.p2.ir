module "nestflag"

func @nest(%flag: i64) i64 {
entry:
    br outer
inner_pre:
    br inner
ibody:
    %fc  = icmp eq i64 %flag, 7
    cond_br %fc, ithen, ielse
outer:
    %i   = phi i64 [ 0, entry ], [ %in, olatch ]
    %jo  = phi i64 [ 0, entry ], [ %j, olatch ]
    %ao  = phi i64 [ 0, entry ], [ %acc, olatch ]
    %oc  = icmp slt i64 %i, 3
    cond_br %oc, inner_pre, done
olatch:
    %in  = add i64 %i, 1
    br outer
done:
    %ten = mul i64 %jo, 10
    %s1  = add i64 %ten, %i
    %res = add i64 %s1, %ao
    ret i64 %res
inner:
    %j   = phi i64 [ 0, inner_pre ], [ %jn, ilatch ]
    %acc = phi i64 [ 0, inner_pre ], [ %sel, ilatch ]
    br ibody
ithen:
    %ta  = add i64 %acc, 1
    br imerge
ielse:
    %tb  = add i64 %acc, 2
    br imerge
imerge:
    %sel = phi i64 [ %ta, ithen ], [ %tb, ielse ]
    br ilatch
ilatch:
    %jn  = add i64 %j, 1
    %ic  = icmp slt i64 %jn, 4
    cond_br %ic, inner, olatch
}

func @main() i32 {
    %r   = call i64 @nest(i64 7)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}

