module "globals"

global @counter: i64 = 10 !alignment = 8;

global const @answer: i64 = 42 !alignment = 8;

global @alias: ptr i64 = @counter !alignment = 8;

func @main() i32 {
    %c  = load i64 @counter
    %a  = load i64 @answer
    %s  = add i64 %c, %a
    store i64 %s, @counter
    %ap = load ptr @alias
    %v  = load i64 %ap
    %r  = trunc i64 %v to i32
    ret i32 %r
}

