module "a1_pos_fold"

global @gx: i32 = 3 !alignment = 4;

global @gy: i32 = 10 !alignment = 4;

func @main() i32 {
    %x  = load i32 @gx
    %y  = load i32 @gy
    %c  = icmp slt i32 %x, %y
    cond_br %c, A, B
A:
    %c2 = icmp sge i32 %x, %y
    cond_br %c2, X, B
B:
    ret i32 2
X:
    ret i32 1
}

