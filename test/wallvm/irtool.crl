#[[no_drop_all]]
// IR pipeline test driver: parse a .ir text module, compile it through
// wallvm at a given -O level, and write the generated assembly.
// run.sh then assembles with gcc and checks the program's exit code.
import(lib) wallvm::wallvm { irCompileAsm, gUnrollEnabled, gPipelineVerbose, gPrintAfterPass };
import(lib) wallvm::irtypes { IrContext, IrModule, irCtxCreate, irCtxDestroy };
import(lib) wallvm::irParser { IrParser, new, destroy, parseModule, getError, getErrorLine };
import(lib) wallvm::regalloc::lsra { gLsraVerbose };
import(lib) wallvm::passes::sccp { gSccpVerbose };
import(lib) wallvm::rules::asm_rules { CallingConvention };
import(lib) std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import(lib) std::ios { println, eprintln };
import(lib) platform::libc { getenv };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 3)
    {
        eprintln("usage: irtool <in.ir> <out.s> [O0|O1|O2|O3]");
        return 2;
    }
    str inPath = str::fromCstr(argv[1]);
    str outPath = str::fromCstr(argv[2]);
    u32 opt = 2;
    if (argc > 3)
    {
        str o = str::fromCstr(argv[3]);
        if (o.equals("O0")) opt = 0;
        else if (o.equals("O1")) opt = 1;
        else if (o.equals("O2")) opt = 2;
        else if (o.equals("O3")) opt = 3;
    }
    // Unrolling stays opt-in: the current unroller mishandles some
    // counted-loop shapes (empty block chains), so the harness keeps
    // it off until G20 lands.
    gUnrollEnabled = false;
    if (getenv(C"WALLVM_LSRA_VERBOSE") != null) gLsraVerbose = true;
    if (getenv(C"WALLVM_PIPELINE_VERBOSE") != null) gPipelineVerbose = true;
    if (getenv(C"WALLVM_PRINT_AFTER_PASS") != null) gPrintAfterPass = true;
    if (getenv(C"WALLVM_SCCP_VERBOSE") != null) gSccpVerbose = true;

    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("irtool: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();

    IrContext* ctx = irCtxCreate();
    IrParser p = new(ctx);
    IrModule* modd = parseModule(&p, src.asView());
    if (modd == null)
    {
        eprintln("{}:{}: {}", inPath, getErrorLine(&p), getError(&p));
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    str asmText = irCompileAsm(modd, ctx, CallingConvention::SystemV, opt);
    if (asmText.len == 0)
    {
        eprintln("irtool: compile produced no assembly");
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("irtool: cannot create {}", outPath);
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, asmText.ptr, (usize)asmText.len);
    fileClose(f);
    if (wr.isErr())
    {
        eprintln("irtool: write failed for {}", outPath);
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    println("{}: {} bytes", outPath, asmText.len);
    destroy(&p);
    src.free();
    irCtxDestroy(ctx);
    return 0;
}
