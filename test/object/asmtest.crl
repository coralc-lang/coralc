#[[no_drop_all]]
// Minimal assembler driver: read an AT&T source file, assemble it through
// assembleText, and write an ELF64 relocatable object. This is the smoke
// path for the encoder; the linker consumes the emitted .o directly.
import(lib) wallvm::assembly::common { AsmParseError };
import(lib) wallvm::assembly::x86::common { AsmBytes };
import(lib) wallvm::assembly::x86::obj { AsmObject, asmObjectNew, asmObjectDeinit, emitElf, emitCoff };
import(lib) wallvm::assembly::x86::x86_64 { assembleText };
import(lib) std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import(lib) std::ios { println, eprintln };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 3)
    {
        eprintln("usage: asmtest <input.s> <output.o> [elf|coff]");
        return 2;
    }
    str inPath = str::fromCstr(argv[1]);
    str outPath = str::fromCstr(argv[2]);

    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("asmtest: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();

    AsmObject obj = asmObjectNew();
    AsmParseError err = AsmParseError { .msg = str::empty(), .lineNo = 0 };
    if (!assembleText(src.asView(), &obj, &err))
    {
        eprintln("{}:{}: {}", inPath, err.lineNo, err.msg);
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }

    bool wantCoff = false;
    if (argc > 3) wantCoff = str::fromCstr(argv[3]).equals("coff");

    AsmBytes out = AsmBytes::new();
    bool emitted = wantCoff ? emitCoff(&obj, &out, &err) : emitElf(&obj, &out, &err);
    if (!emitted)
    {
        eprintln("{}:{}: {}", inPath, err.lineNo, err.msg);
        out.deinit();
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }

    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("asmtest: cannot create {}", outPath);
        out.deinit();
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, out.data, (usize)out.len);
    fileClose(f);
    if (wr.isErr())
    {
        eprintln("asmtest: write failed for {}", outPath);
        out.deinit();
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }

    println("{}: {} bytes of text, {} hot, {} cold, {} data; {} symbols, {} relocations",
            outPath, obj.text.data.len, obj.hot.data.len, obj.cold.data.len,
            obj.data.data.len, obj.nsyms, obj.nrelocs);

    out.deinit();
    asmObjectDeinit(&obj);
    src.free();
    return 0;
}
