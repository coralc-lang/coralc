#[[no_drop_all]]
import(lib) wallvm::linker::x86::link { Config, Arch, configFor, Linker };
import(lib) std::string { String };
import(lib) std::ios { println, eprintln };
import(lib) wallvm::linker::x86::elf { FMT_ELF_EXE, FMT_ELF_DYN, FMT_PE_EXE, FMT_PE_DLL };

u64 _parseNum(str s, bool ok)
{
    ok = false;
    u64 v = 0;
    usize i = 0;
    u32 base = 10;
    if (s.len > 2 && s.ptr[0] == '0' && (s.ptr[1] == 'x' || s.ptr[1] == 'X'))
    {
        base = 16;
        i = 2;
    }
    if (i >= s.len) return 0;
    while (i < s.len)
    {
        u8 c = s.ptr[i];
        u32 d = 0;
        if (c >= '0' && c <= '9') d = (u32)(c - '0');
        else if (base == 16 && c >= 'a' && c <= 'f') d = 10 + (u32)(c - 'a');
        else if (base == 16 && c >= 'A' && c <= 'F') d = 10 + (u32)(c - 'A');
        else return 0;
        v = v * (u64)base + (u64)d;
        i++;
    }
    ok = true;
    return v;
}

void _usage()
{
    eprintln("usage:");
    eprintln("  linktool <entry> <out> [elf|coff] [options] <in>...");
    eprintln("  linktool --dll <out.dll> [--export NAME]... [--export-all] [--module NAME] <in>...");
    eprintln("  linktool --shared <out.so> [--entry-address ADDR] <in>...");
    eprintln("  linktool --static-lib <out.a> <in.o>...");
    eprintln("options: --entry-address ADDR --image-base ADDR");
}

i32 main(i32 argc, cchar** argv)
{
    if (argc < 4)
    {
        _usage();
        return 2;
    }
    Config cfg = configFor(Arch::X86_64);
    str a1 = str::fromCstr(argv[1]);
    if (a1.equals("--static-lib"))
    {
        Linker lk = Linker::new(cfg);
        String err = String::new();
        for (i32 i = 3; i < argc; i++)
        {
            str p = str::fromCstr(argv[i]);
            if (!lk.addObjectFile(p, &err))
            {
                eprintln("add {}: {}", p, err.asView());
                err.free();
                lk.dispose();
                return 1;
            }
        }
        if (!lk.writeStatic(str::fromCstr(argv[2]), &err))
        {
            eprintln("archive: {}", err.asView());
            err.free();
            lk.dispose();
            return 1;
        }
        println("wrote {}", str::fromCstr(argv[2]));
        err.free();
        lk.dispose();
        return 0;
    }

    bool dll = a1.equals("--dll");
    bool shared = a1.equals("--shared");
    str outPath = str::empty();
    i32 first = 0;
    if (dll || shared)
    {
        outPath = str::fromCstr(argv[2]);
        first = 3;
        if (dll)
        {
            cfg.outFmt = FMT_PE_DLL;
            cfg.isDll = true;
            cfg.entry = str::empty();
        }
        else
        {
            cfg.outFmt = FMT_ELF_DYN;
            cfg.entry = str::empty();
        }
    }
    else
    {
        cfg.entry = a1;
        outPath = str::fromCstr(argv[2]);
        first = 3;
        if (argc > 3)
        {
            str m = str::fromCstr(argv[3]);
            if (m.equals("coff"))
            {
                cfg.outFmt = FMT_PE_EXE;
                first = 4;
            }
            else if (m.equals("elf"))
            {
                cfg.outFmt = FMT_ELF_EXE;
                first = 4;
            }
        }
    }

    Linker lk = Linker::new(cfg);
    String err = String::new();
    for (i32 i = first; i < argc; i++)
    {
        str p = str::fromCstr(argv[i]);
        if (p.equals("--export") && i + 1 < argc)
        {
            lk.addExport(str::fromCstr(argv[i + 1]));
            i++;
            continue;
        }
        if (p.equals("--export-all"))
        {
            lk.setExportAll(true);
            continue;
        }
        if (p.equals("--module") && i + 1 < argc)
        {
            lk.setModuleName(str::fromCstr(argv[i + 1]));
            i++;
            continue;
        }
        if (p.equals("--entry-address") && i + 1 < argc)
        {
            bool ok = false;
            u64 v = _parseNum(str::fromCstr(argv[i + 1]), ok);
            if (!ok)
            {
                eprintln("bad entry address: {}", str::fromCstr(argv[i + 1]));
                err.free();
                lk.dispose();
                return 2;
            }
            lk.setEntryAddress(v);
            cfg.entry = str::empty();
            i++;
            continue;
        }
        if (p.equals("--image-base") && i + 1 < argc)
        {
            bool ok = false;
            u64 v = _parseNum(str::fromCstr(argv[i + 1]), ok);
            if (!ok)
            {
                eprintln("bad image base: {}", str::fromCstr(argv[i + 1]));
                err.free();
                lk.dispose();
                return 2;
            }
            lk.cfg.imageBase = v;
            i++;
            continue;
        }
        if (!lk.addObjectFile(p, &err))
        {
            eprintln("add {}: {}", p, err.asView());
            err.free();
            lk.dispose();
            return 1;
        }
    }
    if (!lk.write(outPath, &err))
    {
        eprintln("link: {}", err.asView());
        err.free();
        lk.dispose();
        return 1;
    }
    println("linked {}", outPath);
    err.free();
    lk.dispose();
    return 0;
}
