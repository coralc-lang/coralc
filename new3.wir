; WallVM IR

func @main -> i32 {
  block %entry:
    %5 = alloca ptr
    %8 = call i32 [%2(add), 5, 6]
    %9 = store void [%8, %5]
    %10 = alloca ptr
    %14 = load i32 [%5]
    %15 = call i32 [%3(printf), 0, %14]
    %17 = load i64 [%10]
    %18 = load i64 [%10]
    %19 = load i64 [%10]
    %20 = call i32 [%3(printf), 0, %17, %18, %19]
    %22 = ret i64 [0]
}
func @add -> i32 {
  block %entry:
    %24 = alloca ptr
    %26 = store void [%25(a), %24]
    %27 = alloca ptr
    %29 = store void [%28(b), %27]
    %30 = load i32 [%24]
    %31 = load i32 [%27]
    %32 = add i32 [%30, %31]
    %33 = ret i32 [%32]
}
extern func @printf -> i32 {}

