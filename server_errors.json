{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-ir/stmt.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* coral-ir/stmt.crl — statement lowering\n *\n * Return, Block (with scope popping), VarDecl (aggregate-aware init),\n * ExprStmt, If, While, Loop, For, Assign (plain + compound via\n * wvAssignCommon), Break/Continue. Blocks lower straight into the\n * current function via the builder; the `term` flag tracks terminators\n * so dead statements after Return/Break/Continue are skipped. No phis —\n * locals are alloca+load/store. */\nuse lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvFindLocal, wvPushLocal,\n               wvBlock, wvSetBlock, wvTerm, wvPos, wvArr };\nuse types { wvTy };\nuse expr { wvExpr, wvAddrOf, wvCond, wvAssignCommon, wvIsAgg, wvCopyAgg, wvAggSlot,\n               wvDecodeLit, wvCompareVals, wvResolveConst, wvMakeGlobal, wvValBody,\n               wvMethodFnFor, wvCast, wvUnwrapTy, wvTyUnsigned, wvIndexAddr,\n               wvGepField, wvFieldIdx };\nuse decl { wvMethodSelfKind };\nuse context::context { AstContext };\nuse sem { scope { Symbol, ScopeStack } };\nuse ast {\n    id { Str, NodeId, locFile },\n    types { Ty, TypeEntry, TypeKind },\n    node { Node, NodeKind },\n    expr { Expr, ExprKind },\n    stmt { Stmt, StmtKind, SwitchCase },\n    decl { Decl, DeclKind, Param },\n    pat { Pat, PatKind }\n};\nuse common::slice { Slice };\nimport wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrBlock };\nimport wallvm::irOps { IrICmpPred };\nimport wallvm::irBuilder { IrBuilder };\nimport std::mman { alloc, dealloc };\n\npub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }\n\npub void wvStmt(Wv* w, NodeId id);\n\n/* one pattern's test against an already-evaluated scrutinee: an i1\n * value, or null with *isWildcard set when the pattern matches every\n * value. Mirrors the C backend's cgPatTest; the arm's patterns are OR'd\n * by wvSwitchTest. */\npub IrValue* wvPatTest(Wv* w, NodeId patId, IrValue* scrut, Ty scrutTy,\n                        bool* isWildcard, NodeId id)\n{\n    *isWildcard = false;\n    if (patId.index == 0) { *isWildcard = true; return null; }\n    Node* n = wvNode(w, patId);\n    if (n->kind.tag == NodeKind::Pat)\n    {\n        Pat* p = &n->kind.payload.Pat.value;\n        switch (p->kind.tag)\n        {\n            PatKind::Wildcard => { *isWildcard = true; return null; },\n            PatKind::Lit => {\n                IrValue* lit = wvExpr(w, p->kind.payload.Lit.expr);\n                if (lit == null) return null;\n                return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);\n            },\n            PatKind::Ident => {\n                /* a bare name in a value switch is a file-scope constant\n                 * (`switch (sig) { SIGSEGV_ => … }`), not a binding */\n                NodeId cd = wvResolveConst(w, p->kind.payload.Ident.name, patId);\n                if (cd.index == 0)\n                    { wvErr(w, patId, \"pattern names an unknown constant\"); return null; }\n                NodeId init = wvNode(w, cd)->kind.payload.Decl.value->kind.payload.Constant.value;\n                IrValue* lit = wvExpr(w, init);\n                if (lit == null) return null;\n                return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);\n            },\n            PatKind::Or => {\n                IrValue* acc = null;\n                u32 i = 0;\n                while (i < p->kind.payload.Or.alternativesLen)\n                {\n                    bool wild = false;\n                    IrValue* t = wvPatTest(w, p->kind.payload.Or.alternatives[i],\n                                           scrut, scrutTy, &wild, id);\n                    if (wild) { *isWildcard = true; return null; }\n                    if (t == null) return null;\n                    acc = acc == null ? t : wvV(w->b.orOp(acc, t));\n                    if (acc == null) return null;\n                    i++;\n                }\n                if (acc == null) { *isWildcard = true; return null; }\n                return acc;\n            },\n            PatKind::Range => {\n                IrValue* lo = wvExpr(w, p->kind.payload.Range.start);\n                IrValue* hi = wvExpr(w, p->kind.payload.Range.end);\n                if (lo == null || hi == null) return null;\n                bool incl = (p->kind.payload.Range.flags & 1) != 0;\n                IrValue* a = wvCompareVals(w, ExprKind::Ge, scrut, lo, id, scrutTy);\n                IrValue* b = wvCompareVals(w, incl ? ExprKind::Le : ExprKind::Lt,\n                                           scrut, hi, id, scrutTy);\n                if (a == null || b == null) return null;\n                return wvV(w->b.andOp(a, b));\n            },\n            PatKind::Guard => {\n                /* pattern-level guard: test && cond; a wildcard inner\n                 * pattern leaves the guard as the whole test */\n                bool wild = false;\n                IrValue* t = wvPatTest(w, p->kind.payload.Guard.pattern,\n                                       scrut, scrutTy, &wild, id);\n                IrValue* g = wvCond(w, wvExpr(w, p->kind.payload.Guard.cond));\n                if (g == null) return null;\n                if (wild) return g;\n                if (t == null) return null;\n                return wvV(w->b.andOp(t, g));\n            },\n            else => { wvErr(w, patId, \"pattern kind unsupported (Phase 3)\"); return null; },\n        }\n    }\n    if (n->kind.tag == NodeKind::Expr)\n    {\n        /* bare expression pattern (a literal or constant reference) */\n        IrValue* lit = wvExpr(w, patId);\n        if (lit == null) return null;\n        return wvCompareVals(w, ExprKind::Eq, scrut, lit, id, scrutTy);\n    }\n    wvErr(w, patId, \"unsupported pattern\");\n    return null;\n}\n\n/* the arm's test: every pattern OR'd together; a wildcard anywhere in\n * the arm matches all values */\npub IrValue* wvSwitchTest(Wv* w, SwitchCase* c, IrValue* scrut, Ty scrutTy,\n                           bool* isWildcard, NodeId id)\n{\n    *isWildcard = false;\n    IrValue* acc = null;\n    u32 p = 0;\n    while (p < c->patternsLen)\n    {\n        bool wild = false;\n        IrValue* t = wvPatTest(w, c->patterns[p], scrut, scrutTy, &wild, id);\n        if (wild) { *isWildcard = true; return null; }\n        if (t == null) return null;\n        acc = acc == null ? t : wvV(w->b.orOp(acc, t));\n        if (acc == null) return null;\n        p++;\n    }\n    if (acc == null) { *isWildcard = true; return null; }\n    return acc;\n}\n\n/* value switch as a compare chain in blocks (no phis). Each arm owns a\n * test block and a body block; a failed test or a failed guard branches\n * to the next arm's test block, then to the else arm, then to the join.\n * The else arm runs only when nothing matched, wherever it sits in the\n * source — the same shape cgEmitSwitchChain prints as if/else-if.\n * slot/vt are null for the statement form; a switch-expr passes its\n * result slot and every arm's body value is stored into it. */\npub void wvSwitchCore(Wv* w, NodeId scrutId, SwitchCase* cases, u32 n,\n                      NodeId id, IrValue* slot, IrType* vt)\n{\n    if (scrutId.index == 0) { wvErr(w, id, \"switch without a scrutinee\"); return; }\n    Node* sn = wvNode(w, scrutId);\n    if (sn->kind.tag != NodeKind::Expr) { wvErr(w, id, \"switch scrutinee\"); return; }\n    IrValue* scrut = wvExpr(w, scrutId);\n    if (scrut == null) return;\n    Ty scrutTy = wvResolved(w, sn->kind.payload.Expr.value.resolvedType);\n\n    if (cases == null || n == 0) { wvErr(w, id, \"switch without cases\"); return; }\n\n    IrBlock** tbb = (IrBlock**)wvArr(w, (usize)n, 8);\n    IrBlock** bbb = (IrBlock**)wvArr(w, (usize)n, 8);\n    IrBlock** gbb = (IrBlock**)wvArr(w, (usize)n, 8);\n    IrBlock** fbb = (IrBlock**)wvArr(w, (usize)n, 8);\n    if (tbb == null || bbb == null || gbb == null || fbb == null)\n        { wvErr(w, id, \"switch: out of memory\"); return; }\n\n    u32 elseIdx = 0xFFFFFFFF;\n    u32 i = 0;\n    while (i < n)\n    {\n        tbb[i] = null;\n        bbb[i] = null;\n        gbb[i] = null;\n        fbb[i] = null;\n        SwitchCase* c = cases + i;\n        if ((c->flags & 4) != 0 || c->patternsLen == 0)\n        {\n            if (elseIdx == 0xFFFFFFFF) elseIdx = i;\n        }\n        else\n        {\n            tbb[i] = wvBlock(w, \"sw.test\");\n            bbb[i] = wvBlock(w, \"sw.body\");\n            if ((c->flags & 1) != 0 && c->guard.index != 0)\n                gbb[i] = wvBlock(w, \"sw.guard\");\n        }\n        i++;\n    }\n    IrBlock* joinBb = wvBlock(w, \"sw.end\");\n    IrBlock* elseBb = elseIdx != 0xFFFFFFFF ? wvBlock(w, \"sw.else\") : null;\n\n    /* fail targets, walked backwards so each arm knows where a failed\n     * test or guard lands: the next arm's test, else, then join */\n    IrBlock* nextTest = null;\n    i = n;\n    while (i > 0)\n    {\n        i--;\n        if (i == elseIdx || tbb[i] == null) continue;\n        fbb[i] = nextTest != null ? nextTest\n                 : (elseBb != null ? elseBb : joinBb);\n        nextTest = tbb[i];\n    }\n    IrBlock* entry = nextTest != null ? nextTest\n                     : (elseBb != null ? elseBb : joinBb);\n    w->b.br(entry);\n\n    IrBlock* savedBreak = w->breakT;\n    w->breakT = joinBb;\n    w->loopDepth++;\n\n    i = 0;\n    while (i < n)\n    {\n        if (i == elseIdx || tbb[i] == null) { i++; continue; }\n        SwitchCase* c = cases + i;\n        IrBlock* fail = fbb[i];\n\n        wvSetBlock(w, tbb[i]);\n        bool wild = false;\n        IrValue* test = wvSwitchTest(w, c, scrut, scrutTy, &wild, id);\n        if (!wild && test == null) break;\n        IrBlock* hit = gbb[i] != null ? gbb[i] : bbb[i];\n        if (wild) w->b.br(hit);\n        else w->b.condBr(test, hit, fail);\n\n        if (gbb[i] != null)\n        {\n            wvSetBlock(w, gbb[i]);\n            IrValue* g = wvCond(w, wvExpr(w, c->guard));\n            if (g == null) break;\n            w->b.condBr(g, bbb[i], fail);\n        }\n\n        wvSetBlock(w, bbb[i]);\n        if (slot != null)\n        {\n            IrValue* v = wvValBody(w, c->body, vt);\n            if (v != null) w->b.store(v, slot);\n        }\n        else wvStmt(w, c->body);\n        if (!w->term) w->b.br(joinBb);\n        i++;\n    }\n\n    if (elseBb != null && elseIdx < n)\n    {\n        wvSetBlock(w, elseBb);\n        if (slot != null)\n        {\n            IrValue* v = wvValBody(w, cases[elseIdx].body, vt);\n            if (v != null) w->b.store(v, slot);\n        }\n        else wvStmt(w, cases[elseIdx].body);\n        if (!w->term) w->b.br(joinBb);\n    }\n\n    w->breakT = savedBreak;\n    w->loopDepth--;\n    wvSetBlock(w, joinBb);\n}\n\n/* the statement form: no result slot, every arm lowers as statements */\npub void wvSwitch(Wv* w, Stmt* s, NodeId id)\n{\n    wvSwitchCore(w, s->kind.payload.Switch.expr, s->kind.payload.Switch.cases,\n                 s->kind.payload.Switch.casesLen, id, null, null);\n}\n\n\n\n/* lower a VarDecl: alloca, optionally initialise (aggregates copy\n * element-wise from the source's address), register the local */\npub void wvVarDecl(Wv* w, Stmt* s, NodeId id)\n{\n    Str name = s->kind.payload.VarDecl.name;\n    Ty vt = wvResolved(w, s->kind.payload.VarDecl.typeNode);\n    if (vt == 0)\n    {\n        /* `var x = init` — infer from the init expr's resolved type */\n        NodeId initId = s->kind.payload.VarDecl.init;\n        if (initId.index != 0)\n        {\n            Node* in = wvNode(w, initId);\n            if (in->kind.tag == NodeKind::Expr)\n                vt = wvResolved(w, in->kind.payload.Expr.value.resolvedType);\n        }\n    }\n    IrType* irt = vt != 0 ? wvTy(w, vt, 0) : null;\n    if (irt == null || irt->kind == IrTypeKind::Void)\n    {\n        wvErr(w, id, \"cannot local-bind a void value\");\n        return;\n    }\n    if ((s->kind.payload.VarDecl.flags & 4) != 0)\n    {\n        /* `static` keeps its storage across calls: a global registered\n         * under this statement, pushed as a local so loads and stores\n         * reach it; its initializer is constant, never run at entry */\n        IrValue* gv = wvMakeGlobal(w, id, name, vt, s->kind.payload.VarDecl.init,\n                                   (s->kind.payload.VarDecl.flags & 1) != 0, false,\n                                   id.index);\n        if (gv != null) wvPushLocal(w, name, gv, vt);\n        return;\n    }\n    IrValue* slot = wvIsAgg(irt) ? wvAggSlot(w, irt) : wvV(w->b.alloca(irt));\n    if (slot == null) return;\n    if ((s->kind.payload.VarDecl.flags & 2) != 0) // hasInit\n    {\n        NodeId initId = s->kind.payload.VarDecl.init;\n        if (wvIsAgg(irt))\n        {\n            /* aggregates never load into a register: copy element-wise */\n            IrValue* src = wvAddrOf(w, initId);\n            if (src != null) wvCopyAgg(w, slot, src, irt, 0);\n        }\n        else\n        {\n            IrValue* init = wvExpr(w, initId);\n            if (init != null) w->b.store(init, slot);\n        }\n    }\n    wvPushLocal(w, name, slot, vt);\n}\n\n\n/* `for x in iterable` and `for x in iter(start, end)` — an index loop\n * over a slice/array, or count()/at() calls over an @iter collection\n * (with range() when bounds are given). Mirrors the C backend's ForIn:\n * ranged bounds clamp to the collection, the receiver is the pointer\n * value or the iterable's own address, multi-binding reads tuple\n * fields, and the whole loop owns one scope. continue advances the\n * index, break leaves it. */\nvoid wvForIn(Wv* w, Stmt* s, NodeId id)\n{\n    u32 scopeMark = w->locLen;\n    NodeId iterId = s->kind.payload.ForIn.iterExpr;\n    NodeId rangeStart = s->kind.payload.ForIn.rangeStart;\n    NodeId rangeEnd = s->kind.payload.ForIn.rangeEnd;\n    bool ranged = rangeStart.index != 0;\n    Str bindName = s->kind.payload.ForIn.bindName;\n    Ty bindType = wvResolved(w, s->kind.payload.ForIn.bindType);\n    u32 extraLen = s->kind.payload.ForIn.extraBindNamesLen;\n    NodeId bodyId = s->kind.payload.ForIn.body;\n\n    Node* in = wvNode(w, iterId);\n    Ty iterTy = in->kind.tag == NodeKind::Expr\n        ? wvResolved(w, in->kind.payload.Expr.value.resolvedType) : 0;\n    TypeEntry* te = iterTy != 0 ? w->ctx->types + iterTy : null;\n    bool indexed = te != null && (te->kind.tag == TypeKind::Slice ||\n                                  te->kind.tag == TypeKind::Array);\n\n    i32 ik = -1;\n    if (in->kind.tag == NodeKind::Expr) ik = in->kind.payload.Expr.value.kind.tag;\n    bool lshape = ik == ExprKind::Ident || ik == ExprKind::Field ||\n                  ik == ExprKind::DerefField || ik == ExprKind::Index ||\n                  ik == ExprKind::TupleField || ik == ExprKind::Deref;\n\n    Ty ub = wvUnwrapTy(w, iterTy);\n    bool iterIsPtr = ub != 0 && (w->ctx->types + ub)->kind.tag == TypeKind::Pointer;\n\n    /* the iterable is read once, before the loop: an lvalue's own\n     * storage, an rvalue materialized into a temp (an aggregate already\n     * is its own address) */\n    IrValue* stor = null;\n    if (indexed || !iterIsPtr)\n    {\n        if (lshape) stor = wvAddrOf(w, iterId);\n        else\n        {\n            IrValue* v = wvExpr(w, iterId);\n            if (v == null) { w->locLen = scopeMark; return; }\n            if (wvIsAgg(v->type)) stor = v;\n            else\n            {\n                stor = wvV(w->b.alloca(v->type));\n                if (stor == null) { w->locLen = scopeMark; return; }\n                w->b.store(v, stor);\n            }\n        }\n        if (stor == null)\n            { wvErr(w, id, \"for-in iterable has no storage\"); w->locLen = scopeMark; return; }\n    }\n    IrValue* recv = null; // the @iter receiver (non-indexed loops only)\n    if (!indexed)\n    {\n        if (iterIsPtr)\n        {\n            recv = wvExpr(w, iterId);\n            if (recv == null) { w->locLen = scopeMark; return; }\n        }\n        else recv = stor;\n    }\n\n    IrType* cntTy = w->ir->tyInt(64);\n    IrValue* iSlot = wvV(w->b.alloca(cntTy));\n    if (iSlot == null) { w->locLen = scopeMark; return; }\n    IrValue* endSlot = null;\n    IrValue* rsV = null;\n    IrValue* reV = null;\n    IrFunc* countFn = null;\n    IrFunc* atFn = null;\n    NodeId mdefC = NodeId{ .index = 0 };\n    NodeId mdefA = NodeId{ .index = 0 };\n\n    if (ranged)\n    {\n        rsV = wvExpr(w, rangeStart);\n        reV = wvExpr(w, rangeEnd);\n        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }\n        Node* rsn = wvNode(w, rangeStart);\n        Node* ren = wvNode(w, rangeEnd);\n        Ty rst = rsn->kind.tag == NodeKind::Expr\n            ? wvResolved(w, rsn->kind.payload.Expr.value.resolvedType) : 0;\n        Ty ret = ren->kind.tag == NodeKind::Expr\n            ? wvResolved(w, ren->kind.payload.Expr.value.resolvedType) : 0;\n        rsV = wvCast(w, rsV, rsV->type, cntTy, wvTyUnsigned(w, rst), true);\n        reV = wvCast(w, reV, reV->type, cntTy, wvTyUnsigned(w, ret), true);\n        if (rsV == null || reV == null) { w->locLen = scopeMark; return; }\n    }\n\n    IrType* elemIr = null;\n    Ty et = 0;\n    if (indexed)\n    {\n        et = te->kind.tag == TypeKind::Slice\n            ? te->kind.payload.Slice.base : te->kind.payload.Array.base;\n        elemIr = wvTy(w, et, 0);\n        if (elemIr == null)\n            { wvErr(w, id, \"for-in element type\"); w->locLen = scopeMark; return; }\n        if (ranged)\n        {\n            IrValue* lenV = null;\n            if (te->kind.tag == TypeKind::Array)\n                lenV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);\n            else\n            {\n                IrValue* lSlot = wvGepField(w, stor, 1);\n                if (lSlot != null) lenV = wvV(w->b.load(cntTy, lSlot));\n            }\n            if (lenV == null) { w->locLen = scopeMark; return; }\n            /* clamp like C: rs = min(rs, len); re = min(re, len);\n             * if (re < rs) re = rs — size_t bounds, unsigned compares */\n            rsV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ugt, rsV, lenV)), lenV, rsV));\n            reV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ugt, reV, lenV)), lenV, reV));\n            reV = wvV(w->b.select(wvV(w->b.icmp(IrICmpPred::Ult, reV, rsV)), rsV, reV));\n            if (rsV == null || reV == null) { w->locLen = scopeMark; return; }\n            endSlot = wvV(w->b.alloca(cntTy));\n            if (endSlot == null) { w->locLen = scopeMark; return; }\n            w->b.store(rsV, iSlot);\n            w->b.store(reV, endSlot);\n        }\n        else w->b.store(w->ir->constInt(cntTy, 0), iSlot);\n    }\n    else\n    {\n        /* @iter collections are consumed through count()/at(), plus\n         * range() when bounds are given — both count and at must exist */\n        bool nfC = false;\n        bool nfA = false;\n        bool nfR = false;\n        NodeId mdefR = NodeId{ .index = 0 };\n        countFn = wvMethodFnFor(w, iterTy, w->ctx->intern(\"count\"), id, &nfC, &mdefC);\n        atFn = wvMethodFnFor(w, iterTy, w->ctx->intern(\"at\"), id, &nfA, &mdefA);\n        IrFunc* rangeFn = null;\n        if (ranged)\n            rangeFn = wvMethodFnFor(w, iterTy, w->ctx->intern(\"range\"), id, &nfR, &mdefR);\n        if (nfC || nfA)\n        {\n            wvErr(w, id, \"for-in over non-slice/array without @iter count()/at()\");\n            w->locLen = scopeMark;\n            return;\n        }\n        if (ranged && nfR)\n            { wvErr(w, id, \"for-in range() not found\"); w->locLen = scopeMark; return; }\n        if (countFn == null || atFn == null) { w->locLen = scopeMark; return; }\n        if (ranged && rangeFn == null) { w->locLen = scopeMark; return; }\n\n        if (ranged)\n        {\n            u8 skR = wvMethodSelfKind(w, mdefR);\n            IrValue*[3] rargs;\n            u32 rn = 0;\n            if (skR != 0) rargs[rn++] = recv;\n            rargs[rn++] = rsV;\n            rargs[rn++] = reV;\n            IrValue* rObj = wvV(w->b.call(&rangeFn->base, rargs, rn));\n            if (rObj == null || !wvIsAgg(rObj->type))\n                { wvErr(w, id, \"range() must return struct(usize, usize)\"); w->locLen = scopeMark; return; }\n            Ty rr = 0;\n            Node* mrn = wvNode(w, mdefR);\n            if (mrn->kind.tag == NodeKind::Decl &&\n                mrn->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n                rr = wvResolved(w, mrn->kind.payload.Decl.value.kind.payload.Func.returnType);\n            /* the bounds are the tuple `struct(usize, usize)`: elements 0/1 */\n            Ty rb = wvUnwrapTy(w, rr);\n            u32 si = 0xFFFFFFFF;\n            u32 ei = 0xFFFFFFFF;\n            u32 bGuard = 0;\n            while (rb != 0 && bGuard < 8)\n            {\n                bGuard++;\n                TypeEntry* be = w->ctx->types + rb;\n                if (be->kind.tag == TypeKind::Tuple)\n                {\n                    if (be->kind.payload.Tuple.elemsLen == 2) { si = 0; ei = 1; }\n                    break;\n                }\n                if (be->kind.tag == TypeKind::Named)\n                {\n                    NodeId td = wvFindTypeDecl(w, be->kind.payload.Named.name);\n                    if (td.index == 0) break;\n                    Node* dn = wvNode(w, td);\n                    if (dn->kind.tag != NodeKind::Decl) break;\n                    Decl* dd = &dn->kind.payload.Decl.value;\n                    if (dd->kind.tag != DeclKind::TypeAlias) break;\n                    rb = wvUnwrapTy(w, dd->kind.payload.TypeAlias.target);\n                    continue;\n                }\n                break;\n            }\n            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)\n            {\n                si = wvFieldIdx(w, rr, w->ctx->intern(\"start\"));\n                ei = wvFieldIdx(w, rr, w->ctx->intern(\"end\"));\n            }\n            if (si == 0xFFFFFFFF || ei == 0xFFFFFFFF)\n                { wvErr(w, id, \"range() must return struct(usize, usize)\"); w->locLen = scopeMark; return; }\n            IrType* stT = rObj->type->params[si];\n            IrType* etT = rObj->type->params[ei];\n            IrValue* sSlot = wvGepField(w, rObj, si);\n            IrValue* eSlot = wvGepField(w, rObj, ei);\n            if (sSlot == null || eSlot == null) { w->locLen = scopeMark; return; }\n            IrValue* sV = wvV(w->b.load(stT, sSlot));\n            IrValue* eV = wvV(w->b.load(etT, eSlot));\n            if (sV == null || eV == null) { w->locLen = scopeMark; return; }\n            sV = wvCast(w, sV, stT, cntTy, wvTyUnsigned(w, rr), true);\n            eV = wvCast(w, eV, etT, cntTy, wvTyUnsigned(w, rr), true);\n            if (sV == null || eV == null) { w->locLen = scopeMark; return; }\n            endSlot = wvV(w->b.alloca(cntTy));\n            if (endSlot == null) { w->locLen = scopeMark; return; }\n            w->b.store(sV, iSlot);\n            w->b.store(eV, endSlot);\n        }\n        else\n        {\n            u8 skC = wvMethodSelfKind(w, mdefC);\n            IrValue*[2] cargs;\n            u32 cn = 0;\n            if (skC != 0) cargs[cn++] = recv;\n            IrValue* nV = wvV(w->b.call(&countFn->base, cargs, cn));\n            if (nV == null) { w->locLen = scopeMark; return; }\n            Ty crt = 0;\n            Node* mcn = wvNode(w, mdefC);\n            if (mcn->kind.tag == NodeKind::Decl &&\n                mcn->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n                crt = wvResolved(w, mcn->kind.payload.Decl.value.kind.payload.Func.returnType);\n            nV = wvCast(w, nV, nV->type, cntTy, wvTyUnsigned(w, crt), true);\n            if (nV == null) { w->locLen = scopeMark; return; }\n            endSlot = wvV(w->b.alloca(cntTy));\n            if (endSlot == null) { w->locLen = scopeMark; return; }\n            w->b.store(nV, endSlot);\n            w->b.store(w->ir->constInt(cntTy, 0), iSlot);\n        }\n    }\n\n    /* bind slots are allocated once, before the loop; each iteration\n     * stores the element into them (multi-binding: one slot per name) */\n    bool multi = extraLen > 0;\n    u32 bindCount = 1 + extraLen;\n    Ty* bindTypes = s->kind.payload.ForIn.bindTypes;\n    u32 bindTypesLen = s->kind.payload.ForIn.bindTypesLen;\n    if (multi && (bindTypes == null || bindTypesLen != bindCount))\n    {\n        wvErr(w, id, \"for-in multi-binding requires a matching tuple element type\");\n        w->locLen = scopeMark;\n        return;\n    }\n    IrValue** bindSlots = (IrValue**)wvArr(w, (usize)bindCount, 8);\n    if (bindSlots == null) { w->locLen = scopeMark; return; }\n    u32 b = 0;\n    while (b < bindCount)\n    {\n        Ty bt = multi ? wvResolved(w, bindTypes[b]) : bindType;\n        IrType* birt = bt != 0 ? wvTy(w, bt, 0) : null;\n        if (birt == null || birt->kind == IrTypeKind::Void)\n        {\n            wvErr(w, id, \"for-in bind has no type\");\n            w->locLen = scopeMark;\n            return;\n        }\n        bindSlots[b] = wvIsAgg(birt) ? wvAggSlot(w, birt) : wvV(w->b.alloca(birt));\n        if (bindSlots[b] == null) { w->locLen = scopeMark; return; }\n        b++;\n    }\n\n    IrBlock* headBb = wvBlock(w, \"forin.head\");\n    IrBlock* bodyBb = wvBlock(w, \"forin.body\");\n    IrBlock* postBb = wvBlock(w, \"forin.post\");\n    IrBlock* exitBb = wvBlock(w, \"forin.end\");\n    w->b.br(headBb);\n\n    wvSetBlock(w, headBb);\n    {\n        IrValue* endV = null;\n        if (endSlot != null) endV = wvV(w->b.load(cntTy, endSlot));\n        else if (te->kind.tag == TypeKind::Slice)\n        {\n            IrValue* lSlot = wvGepField(w, stor, 1);\n            if (lSlot != null) endV = wvV(w->b.load(cntTy, lSlot));\n        }\n        else endV = w->ir->constInt(cntTy, (u64)te->kind.payload.Array.len);\n        IrValue* iv = wvV(w->b.load(cntTy, iSlot));\n        if (endV == null || iv == null) { w->locLen = scopeMark; return; }\n        IrValue* c = wvV(w->b.icmp(IrICmpPred::Ult, iv, endV));\n        if (c == null) { w->locLen = scopeMark; return; }\n        w->b.condBr(c, bodyBb, exitBb);\n    }\n\n    wvSetBlock(w, bodyBb);\n    IrBlock* savedBreak = w->breakT;\n    IrBlock* savedCont = w->contT;\n    w->breakT = exitBb;\n    w->contT = postBb;\n    w->loopDepth++;\n    {\n        /* this iteration's element: an indexed address, or at(recv, i) */\n        IrValue* eAddr = null;\n        IrValue* atVal = null;\n        if (indexed)\n        {\n            IrValue* iv = wvV(w->b.load(cntTy, iSlot));\n            if (iv == null) { wvErr(w, id, \"for-in index\"); w->locLen = scopeMark; return; }\n            if (te->kind.tag == TypeKind::Array)\n                eAddr = wvIndexAddr(w, stor, elemIr, iv, true);\n            else\n            {\n                IrValue* pSlot = wvGepField(w, stor, 0);\n                if (pSlot == null) { w->locLen = scopeMark; return; }\n                IrValue* p = wvV(w->b.load(w->ir->tyPtr(elemIr), pSlot));\n                if (p == null) { w->locLen = scopeMark; return; }\n                eAddr = wvIndexAddr(w, p, elemIr, iv, false);\n            }\n            if (eAddr == null) { wvErr(w, id, \"for-in element address\"); w->locLen = scopeMark; return; }\n        }\n        else\n        {\n            u8 skA = wvMethodSelfKind(w, mdefA);\n            IrValue*[2] aargs;\n            u32 an = 0;\n            if (skA != 0) aargs[an++] = recv;\n            IrValue* iv = wvV(w->b.load(cntTy, iSlot));\n            if (iv == null) { wvErr(w, id, \"for-in index\"); w->locLen = scopeMark; return; }\n            u32 ip = skA != 0 ? 1 : 0;\n            if (ip < atFn->nparams && atFn->paramTypes[ip] != null &&\n                atFn->paramTypes[ip]->kind == IrTypeKind::Int &&\n                atFn->paramTypes[ip]->width != iv->type->width)\n            {\n                iv = wvCast(w, iv, iv->type, atFn->paramTypes[ip], false, true);\n                if (iv == null) { w->locLen = scopeMark; return; }\n            }\n            aargs[an++] = iv;\n            atVal = wvV(w->b.call(&atFn->base, aargs, an));\n            if (atVal == null) { wvErr(w, id, \"for-in at()\"); w->locLen = scopeMark; return; }\n        }\n\n        /* store the element into the bind slots */\n        b = 0;\n        while (b < bindCount)\n        {\n            Ty bt = multi ? wvResolved(w, bindTypes[b]) : bindType;\n            IrType* birt = wvTy(w, bt, 0);\n            if (birt == null) { w->locLen = scopeMark; return; }\n            if (multi)\n            {\n                IrValue* tupleAddr = indexed ? eAddr : atVal;\n                if (tupleAddr == null) { w->locLen = scopeMark; return; }\n                IrValue* fa = wvGepField(w, tupleAddr, b);\n                if (fa == null) { w->locLen = scopeMark; return; }\n                if (wvIsAgg(birt))\n                {\n                    if (!wvCopyAgg(w, bindSlots[b], fa, birt, 0)) { w->locLen = scopeMark; return; }\n                }\n                else\n                {\n                    IrValue* fv = wvV(w->b.load(birt, fa));\n                    if (fv == null) { w->locLen = scopeMark; return; }\n                    w->b.store(fv, bindSlots[b]);\n                }\n            }\n            else if (indexed)\n            {\n                if (wvIsAgg(birt))\n                {\n                    if (!wvCopyAgg(w, bindSlots[b], eAddr, birt, 0)) { w->locLen = scopeMark; return; }\n                }\n                else\n                {\n                    IrValue* ev = wvV(w->b.load(birt, eAddr));\n                    if (ev == null) { w->locLen = scopeMark; return; }\n                    w->b.store(ev, bindSlots[b]);\n                }\n            }\n            else\n            {\n                if (wvIsAgg(birt))\n                {\n                    if (!wvCopyAgg(w, bindSlots[b], atVal, birt, 0)) { w->locLen = scopeMark; return; }\n                }\n                else w->b.store(atVal, bindSlots[b]);\n            }\n            b++;\n        }\n\n        b = 0;\n        while (b < bindCount)\n        {\n            Str bn = b == 0 ? bindName : s->kind.payload.ForIn.extraBindNames[b - 1];\n            wvPushLocal(w, bn, bindSlots[b], multi ? wvResolved(w, bindTypes[b]) : bindType);\n            b++;\n        }\n        wvStmt(w, bodyId);\n    }\n    w->loopDepth--;\n    w->breakT = savedBreak;\n    w->contT = savedCont;\n    if (!w->term) w->b.br(postBb);\n\n    wvSetBlock(w, postBb);\n    {\n        IrValue* iv = wvV(w->b.load(cntTy, iSlot));\n        if (iv == null) { w->locLen = scopeMark; return; }\n        IrValue* nv = wvV(w->b.add(iv, w->ir->constInt(cntTy, 1)));\n        if (nv == null) { w->locLen = scopeMark; return; }\n        w->b.store(nv, iSlot);\n        w->b.br(headBb);\n    }\n\n    wvSetBlock(w, exitBb);\n    w->locLen = scopeMark;\n}\n\n\npub void wvStmt(Wv* w, NodeId id)\n{\n    if (id.index == 0) return;\n    Node* n = wvNode(w, id);\n    if (n->kind.tag != NodeKind::Stmt)\n    {\n        wvErr(w, id, \"expected statement node\");\n        return;\n    }\n    if (w->term) return; // dead code after a terminator\n    Stmt* s = &n->kind.payload.Stmt.value;\n    switch (s->kind.tag)\n    {\n        StmtKind::ExprStmt => { wvExpr(w, s->kind.payload.ExprStmt.expr); },\n        StmtKind::VarDecl => { wvVarDecl(w, s, id); },\n        StmtKind::Return => {\n            NodeId vId = s->kind.payload.Return.value;\n            if (vId.index != 0)\n            {\n                IrValue* v = wvExpr(w, vId);\n                if (v != null) w->b.ret(v);\n            }\n            else w->b.retVoid();\n            wvTerm(w);\n        },\n        StmtKind::Block => {\n            /* block scope: locals declared inside vanish at the closing\n             * brace (sema enforces the same rule — see T0001 on escape) */\n            u32 scopeMark = w->locLen;\n            u32 i = 0;\n            while (i < s->kind.payload.Block.stmtsLen && !w->term)\n            {\n                wvStmt(w, s->kind.payload.Block.stmts[i]);\n                i++;\n            }\n            w->locLen = scopeMark;\n        },\n        StmtKind::Assign => {\n            Str opS = s->kind.payload.Assign.op;\n            if (opS == 0) return;\n            str ops = wvStr(w, opS);\n            wvAssignCommon(w, s->kind.payload.Assign.target,\n                           s->kind.payload.Assign.value, ops, id);\n        },\n        StmtKind::If => {\n            IrValue* c = wvCond(w, wvExpr(w, s->kind.payload.If.cond));\n            if (c == null) return;\n            IrBlock* thenBb = wvBlock(w, \"if.then\");\n            NodeId elseId = s->kind.payload.If.elseBody;\n            IrBlock* elseBb = elseId.index != 0 ? wvBlock(w, \"if.else\") : null;\n            IrBlock* joinBb = wvBlock(w, \"if.end\");\n            w->b.condBr(c, thenBb, elseBb != null ? elseBb : joinBb);\n\n            wvSetBlock(w, thenBb);\n            wvStmt(w, s->kind.payload.If.thenBody);\n            if (!w->term) w->b.br(joinBb);\n\n            if (elseBb != null)\n            {\n                wvSetBlock(w, elseBb);\n                wvStmt(w, elseId);\n                if (!w->term) w->b.br(joinBb);\n            }\n            wvSetBlock(w, joinBb);\n        },\n        StmtKind::While => {\n            IrBlock* headBb = wvBlock(w, \"while.head\");\n            IrBlock* bodyBb = wvBlock(w, \"while.body\");\n            IrBlock* exitBb = wvBlock(w, \"while.end\");\n            w->b.br(headBb);\n            wvSetBlock(w, headBb);\n            IrValue* c = wvCond(w, wvExpr(w, s->kind.payload.While.cond));\n            if (c == null) return;\n            w->b.condBr(c, bodyBb, exitBb);\n\n            wvSetBlock(w, bodyBb);\n            IrBlock* savedBreak = w->breakT;\n            IrBlock* savedCont = w->contT;\n            w->breakT = exitBb;\n            w->contT = headBb;\n            w->loopDepth++;\n            wvStmt(w, s->kind.payload.While.body);\n            w->loopDepth--;\n            w->breakT = savedBreak;\n            w->contT = savedCont;\n            if (!w->term) w->b.br(headBb);\n            wvSetBlock(w, exitBb);\n        },\n        StmtKind::Loop => {\n            /* `loop { ... }` — unconditionally re-enter the head block\n             * (an empty-trip body with no terminator: same shape as\n             * while(true)) */\n            IrBlock* headBb = wvBlock(w, \"loop.head\");\n            IrBlock* bodyBb = wvBlock(w, \"loop.body\");\n            IrBlock* exitBb = wvBlock(w, \"loop.end\");\n            w->b.br(headBb);\n            wvSetBlock(w, headBb);\n            w->b.br(bodyBb);\n\n            wvSetBlock(w, bodyBb);\n            IrBlock* savedBreak = w->breakT;\n            IrBlock* savedCont = w->contT;\n            w->breakT = exitBb;\n            w->contT = headBb;\n            w->loopDepth++;\n            wvStmt(w, s->kind.payload.Loop.body);\n            w->loopDepth--;\n            w->breakT = savedBreak;\n            w->contT = savedCont;\n            if (!w->term) w->b.br(headBb);\n            wvSetBlock(w, exitBb);\n        },\n        StmtKind::For => {\n            /* for (init; cond; post) — continue targets `post`, break\n             * targets the exit block. The init's locals are scoped to\n             * the whole loop (matching the C backend's for-scope). */\n            NodeId initId = s->kind.payload.For.init;\n            NodeId condId = s->kind.payload.For.cond;\n            NodeId postId = s->kind.payload.For.post;\n            bool hasPost = (s->kind.payload.For.flags & 4) != 0;\n            u32 scopeMark = w->locLen;\n\n            if (initId.index != 0) wvStmt(w, initId);\n\n            IrBlock* headBb = wvBlock(w, \"for.head\");\n            IrBlock* bodyBb = wvBlock(w, \"for.body\");\n            IrBlock* postBb = hasPost || postId.index != 0 ? wvBlock(w, \"for.post\") : null;\n            IrBlock* exitBb = wvBlock(w, \"for.end\");\n            w->b.br(headBb);\n\n            wvSetBlock(w, headBb);\n            if (condId.index != 0)\n            {\n                IrValue* c = wvCond(w, wvExpr(w, condId));\n                if (c == null) { w->locLen = scopeMark; return; }\n                w->b.condBr(c, bodyBb, exitBb);\n            }\n            else w->b.br(bodyBb); // no condition: run forever (break exits)\n\n            wvSetBlock(w, bodyBb);\n            IrBlock* savedBreak = w->breakT;\n            IrBlock* savedCont = w->contT;\n            w->breakT = exitBb;\n            w->contT = postBb != null ? postBb : headBb;\n            w->loopDepth++;\n            wvStmt(w, s->kind.payload.For.body);\n            w->loopDepth--;\n            w->breakT = savedBreak;\n            w->contT = savedCont;\n            if (!w->term) w->b.br(postBb != null ? postBb : headBb);\n\n            if (postBb != null)\n            {\n                wvSetBlock(w, postBb);\n                if (postId.index != 0) wvExpr(w, postId);\n                if (!w->term) w->b.br(headBb);\n            }\n            wvSetBlock(w, exitBb);\n            w->locLen = scopeMark;\n        },\n        StmtKind::Asm => {\n            /* gcc-style extended asm → one InlineAsm. Template pieces\n             * join; output/input sections are constraint/operand pairs\n             * that flatten to a comma-joined constraint list plus an\n             * ops array (outputs first, then inputs). Outputs and\n             * memory-class inputs go through wvAddrOf — the emitter\n             * reads and writes them through that pointer, so every\n             * read-back operand carries a Ptr(T) alloca. All buffers\n             * are arena-backed; inlineAsm dupStr's what it keeps. */\n            u32 tLen = s->kind.payload.Asm.templateLen;\n            u32 outLen = s->kind.payload.Asm.outputsLen;\n            u32 inLen = s->kind.payload.Asm.inputsLen;\n            u32 clobLen = s->kind.payload.Asm.clobbersLen;\n            if ((outLen & 1) != 0 || (inLen & 1) != 0)\n            {\n                wvErr(w, id, \"asm operand constraint needs a value\");\n                return;\n            }\n\n            /* template: string-literal pieces, escapes decoded like any\n             * other literal */\n            usize tcap = 0;\n            u32 i = 0;\n            while (i < tLen)\n            {\n                Node* tn = wvNode(w, s->kind.payload.Asm.template[i]);\n                if (tn->kind.tag != NodeKind::Expr ||\n                    tn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)\n                    { wvErr(w, id, \"asm template pieces must be string literals\"); return; }\n                tcap += wvStr(w, tn->kind.payload.Expr.value.kind.payload.StringLit.value).len;\n                i++;\n            }\n            u8* tbuf = (u8*)wvArr(w, tcap + 1, 1);\n            if (tbuf == null) { wvErr(w, id, \"asm template buffer\"); return; }\n            usize tlen = 0;\n            i = 0;\n            while (i < tLen)\n            {\n                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.template[i])\n                                ->kind.payload.Expr.value.kind.payload.StringLit.value);\n                usize b = 0;\n                usize e = tok.len;\n                if (e >= 2 && tok.ptr[0] == '\"') { b = 1; e = e - 1; }\n                tlen += wvDecodeLit(tok, b, e, tbuf + tlen);\n                i++;\n            }\n\n            /* constraints: raw token capacity first (validate the nodes),\n             * then decode outputs then inputs into one comma list */\n            usize ccap = 0;\n            i = 0;\n            while (i < outLen)\n            {\n                Node* cn = wvNode(w, s->kind.payload.Asm.outputs[i]);\n                if (cn->kind.tag != NodeKind::Expr ||\n                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)\n                    { wvErr(w, id, \"asm operand constraint must be a string literal\"); return; }\n                ccap += wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;\n                i += 2;\n            }\n            i = 0;\n            while (i < inLen)\n            {\n                Node* cn = wvNode(w, s->kind.payload.Asm.inputs[i]);\n                if (cn->kind.tag != NodeKind::Expr ||\n                    cn->kind.payload.Expr.value.kind.tag != ExprKind::StringLit)\n                    { wvErr(w, id, \"asm operand constraint must be a string literal\"); return; }\n                ccap += wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value).len + 1;\n                i += 2;\n            }\n            u8* cbuf = (u8*)wvArr(w, ccap + 1, 1);\n            if (cbuf == null) { wvErr(w, id, \"asm constraint buffer\"); return; }\n            usize clen = 0;\n            i = 0;\n            while (i < outLen)\n            {\n                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.outputs[i])\n                                ->kind.payload.Expr.value.kind.payload.StringLit.value);\n                usize b = 0;\n                usize e = tok.len;\n                if (e >= 2 && tok.ptr[0] == '\"') { b = 1; e = e - 1; }\n                if (clen > 0) { cbuf[clen] = ','; clen++; }\n                clen += wvDecodeLit(tok, b, e, cbuf + clen);\n                i = i + 2;\n            }\n            i = 0;\n            while (i < inLen)\n            {\n                str tok = wvStr(w, wvNode(w, s->kind.payload.Asm.inputs[i])\n                                ->kind.payload.Expr.value.kind.payload.StringLit.value);\n                usize b = 0;\n                usize e = tok.len;\n                if (e >= 2 && tok.ptr[0] == '\"') { b = 1; e = e - 1; }\n                if (clen > 0) { cbuf[clen] = ','; clen++; }\n                clen += wvDecodeLit(tok, b, e, cbuf + clen);\n                i = i + 2;\n            }\n\n            /* exactly one register-class output ⇒ value mode: the asm\n             * produces the result directly (no address escape), so\n             * mem2reg still promotes the local; the value is stored back\n             * to the lvalue right after. Multiple register outputs or\n             * all-memory outputs keep the pointer model. */\n            u32 nOut = outLen / 2;\n            u32 nIn = inLen / 2;\n            u32 regOut = 0;\n            u32 regOutIdx = 0;\n            bool regInOut = false;\n            i = 0;\n            while (i < outLen)\n            {\n                str raw = wvStr(w, wvNode(w, s->kind.payload.Asm.outputs[i])\n                                ->kind.payload.Expr.value.kind.payload.StringLit.value);\n                usize qi = 0;\n                bool isInOut = false;\n                while (qi < raw.len)\n                {\n                    u8 c = raw.ptr[qi];\n                    if (c == (u8)'+') isInOut = true;\n                    if (c == (u8)'\"' || c == (u8)'=' || c == (u8)'+' || c == (u8)'&') { qi++; continue; }\n                    break;\n                }\n                u8 cls = qi < raw.len ? raw.ptr[qi] : (u8)'r';\n                bool isTie = cls >= (u8)'0' && cls <= (u8)'9';\n                if (!isTie && cls != (u8)'m' && cls != (u8)'i' && cls != (u8)'f')\n                {\n                    regOut++;\n                    regOutIdx = i;\n                    if (isInOut) regInOut = true;\n                }\n                i += 2;\n            }\n            IrType* retT = null;\n            if (regOut == 1)\n            {\n                Node* en = wvNode(w, s->kind.payload.Asm.outputs[regOutIdx + 1]);\n                if (en->kind.tag == NodeKind::Expr && en->kind.payload.Expr.value.resolvedType != 0)\n                    retT = wvTy(w, wvResolved(w, en->kind.payload.Expr.value.resolvedType), 0);\n            }\n            bool valMode = regOut == 1 && retT != null;\n\n            u32 nops = nOut + nIn;\n            IrValue** ops = null;\n            if (nops > 0)\n            {\n                ops = (IrValue**)wvArr(w, (usize)nops, 8);\n                if (ops == null) { wvErr(w, id, \"asm operand array\"); return; }\n            }\n            u32 k = 0;\n            i = 0;\n            while (i < outLen)\n            {\n                if (valMode && i == regOutIdx)\n                {\n                    /* the single register output: value operand — inout\n                     * carries the current value, pure output carries\n                     * nothing (the result rides on the inst value) */\n                    ops[k] = regInOut ? wvExpr(w, s->kind.payload.Asm.outputs[i + 1]) : null;\n                }\n                else\n                {\n                    ops[k] = wvAddrOf(w, s->kind.payload.Asm.outputs[i + 1]);\n                    if (ops[k] == null) return;\n                }\n                k++;\n                i += 2;\n            }\n            i = 0;\n            while (i < inLen)\n            {\n                Node* cn = wvNode(w, s->kind.payload.Asm.inputs[i]);\n                str ctok = wvStr(w, cn->kind.payload.Expr.value.kind.payload.StringLit.value);\n                bool isMem = false;\n                usize qi = 0;\n                while (qi < ctok.len) { if (ctok.ptr[qi] == (u8)'m') isMem = true; qi++; }\n                NodeId vid = s->kind.payload.Asm.inputs[i + 1];\n                if (isMem) ops[k] = wvAddrOf(w, vid);\n                else ops[k] = wvExpr(w, vid);\n                if (ops[k] == null) return;\n                k++;\n                i += 2;\n            }\n\n            /* clobbers: bare string literals, comma-joined */\n            usize kcap = 0;\n            i = 0;\n            while (i < clobLen)\n            {\n                Node* kn = wvNode(w, s->kind.payload.Asm.clobbers[i]);\n                if (kn->kind.tag != NodeKind::Expr ||\n                  