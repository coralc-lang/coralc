{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-build/builder.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\nuse arena { Arena };\nuse ast { CrlbNode, CrlbNodeKind, Value, ValueArray, nodeKindName };\nuse common::slice { Slice };\nuse common::platform { hostOs, hostArch };\nimport core::cchar { cchar };\nimport platform::libc { printf, getenv };\nimport std::mman { alloc, dealloc, realloc, copy };\nimport std::result { Result };\nimport std::fios { FileHandle, fileOpen, fileRead, fileWrite, fileClose };\nimport std::fs { IoError, fileExists, openDir, readDirEntry, closeDir, createDirRecursive, Dirent, Dir, statPath, Stat };\n\n// small helpers\n\npub bool bEq(Slice a, str b)\n{\n    if (a.len != b.len) return false;\n    usize i = 0;\n    while (i < b.len)\n    {\n        if (a.ptr[i] != b.ptr[i]) return false;\n        i++;\n    }\n    return true;\n}\n\nbool bEndsWith(Slice a, str suffix)\n{\n    if (a.len < suffix.len) return false;\n    return bEq(Slice::from(a.ptr + (a.len - suffix.len), suffix.len), suffix);\n}\n\npub u8* bCStr(Arena* a, Slice s)\n{\n    u8* p = (u8*)a->alloc(s.len + 1, 1);\n    if (p == null) return null;\n    copy<u8>(p, s.ptr, s.len);\n    p[s.len] = 0;\n    return p;\n}\n\nu8* bConcat3(Arena* a, Slice x, str mid, Slice y)\n{\n    usize total = x.len + mid.len + y.len;\n    u8* p = (u8*)a->alloc(total + 1, 1);\n    if (p == null) return null;\n    copy<u8>(p, x.ptr, x.len);\n    copy<u8>(p + x.len, (u8*)mid.ptr, mid.len);\n    copy<u8>(p + x.len + mid.len, y.ptr, y.len);\n    p[total] = 0;\n    return p;\n}\n\npub usize bJoin(u8* out, usize cap, Slice dir, Slice name)\n{\n    usize n = 0;\n    usize i = 0;\n    while (i < dir.len && n + 1 < cap)\n    {\n        out[n] = dir.ptr[i];\n        n++;\n        i++;\n    }\n    if (n > 0 && out[n - 1] != '/' && n + 1 < cap)\n    {\n        out[n] = '/';\n        n++;\n    }\n    i = 0;\n    while (i < name.len && n + 1 < cap)\n    {\n        out[n] = name.ptr[i];\n        n++;\n        i++;\n    }\n    out[n] = 0;\n    return n;\n}\n\n// arena-owned `<dir>/<name>` join (mirrors bJoin's slash handling)\npub str bJoinStr(Arena* a, Slice dir, Slice name)\n{\n    usize cap = dir.len + name.len + 2;\n    u8* p = (u8*)a->alloc(cap, 1);\n    if (p == null) return str { .ptr = null, .len = 0 };\n    usize n = bJoin(p, cap, dir, name);\n    return str { .ptr = p, .len = n };\n}\n\nu64 bFnv(u64 h, u8* data, usize len)\n{\n    usize i = 0;\n    while (i < len)\n    {\n        h ^= (u64)data[i];\n        h *= 1099511628211; // also this, use compound assignment\n        i++;\n    }\n    return h;\n}\n\nusize bApp(u8* buf, usize cap, usize* len, str src)\n{\n    usize i = 0;\n    while (i < src.len && *len < cap)\n    {\n        buf[*len] = src.ptr[i];\n        *len += 1;\n        i++;\n    }\n    return *len;\n}\n\npub bool bFileExists(str path)\n{\n    return fileExists(path);\n}\n\nSlice bReadFile(Arena* a, str path, usize* outLen)\n{\n    *outLen = 0;\n    Result<FileHandle, IoError> fo = fileOpen(path, \"rb\");\n    if (fo.isErr()) return Slice::from(null, 0);\n    FileHandle fh = fo.unwrap();\n    usize cap = 65536;\n    u8* buf = alloc<u8>(cap);\n    if (buf == null)\n    {\n        fileClose(fh);\n        return Slice::from(null, 0);\n    }\n    usize len = 0;\n    while (true)\n    {\n        if (len >= cap)\n        {\n            usize newCap = cap * 2;\n            u8* fresh = realloc<u8>(buf, newCap);\n            if (fresh == null) break;\n            buf = fresh;\n            cap = newCap;\n        }\n        Result<usize, IoError> rr = fileRead(fh, buf + len, cap - len);\n        if (rr.isErr()) break;\n        usize got = rr.unwrap();\n        if (got == 0) break;\n        len += got;\n    }\n    fileClose(fh);\n    u8* cp = (u8*)a->alloc(len + 1, 1);\n    if (cp == null)\n    {\n        dealloc<u8>(buf);\n        return Slice::from(null, 0);\n    }\n    copy<u8>(cp, buf, len);\n    cp[len] = 0;\n    dealloc<u8>(buf);\n    *outLen = len;\n    return Slice::from(cp, len);\n}\n\npub struct DirEnt\n{\n    u8* name;\n    u8 dtype;\n}\n\npub DirEnt* bListDir(Arena* a, str path, u32* outLen)\n{\n    *outLen = 0;\n    Result<Dir, IoError> od = openDir(path);\n    if (od.isErr()) return null;\n    Dir dir = od.unwrap();\n    DirEnt* arr = (DirEnt*)a->alloc(64 * @sizeof(DirEnt), 8);\n    u32 cap = 64;\n    if (arr == null)\n    {\n        closeDir(dir);\n        return null;\n    }\n    u32 len = 0;\n    Dirent de;\n    while (readDirEntry(dir, &de))\n    {\n        u8 dtype = de.d_type;\n        usize nameLen = 0;\n        while (nameLen < 255 && de.d_name[nameLen] != 0) nameLen++;\n        if (len >= cap)\n        {\n            u32 newCap = cap * 2;\n            DirEnt* fresh = (DirEnt*)a->alloc((usize)newCap * @sizeof(DirEnt), 8);\n            if (fresh == null) break;\n            u32 i = 0;\n            while (i < len)\n            {\n                fresh[i] = arr[i];\n                i++;\n            }\n            arr = fresh;\n            cap *= 2;\n        }\n        u8* name = (u8*)a->alloc(nameLen + 1, 1);\n        copy<u8>(name, &de.d_name[0], nameLen);\n        name[nameLen] = 0;\n        arr[len].name = name;\n        arr[len].dtype = dtype;\n        len++;\n    }\n    closeDir(dir);\n    *outLen = len;\n    return arr;\n}\n\nbool bIsSkipped(Slice name, Slice* skips, u32 skipLen)\n{\n    u32 i = 0;\n    while (i < skipLen)\n    {\n        if (bEq(name, skips[i].asStr())) return true;\n        i++;\n    }\n    return false;\n}\n\nu32 bCollectCrl(Arena* a, Slice dirS, Slice* skips, u32 skipLen, Slice* out, u32 cap, u32* outLen, Slice* excludes, u32 excludeLen)\n{\n    DirEnt* ents = null;\n    u32 n = 0;\n    ents = bListDir(a, dirS.asStr(), &n);\n    u32 i = 0;\n    while (i < n)\n    {\n        usize nameLen = 0;\n        while (ents[i].name[nameLen] != 0) nameLen++;\n        Slice nm = Slice::from(ents[i].name, nameLen);\n        if (!bEq(nm, \".\") && !bEq(nm, \"..\"))\n        {\n            if (ents[i].dtype == 4)\n            {\n                if (!bIsSkipped(nm, skips, skipLen))\n                {\n                    bCollectCrl(a, Slice::fromStr(bJoinStr(a, dirS, nm)), skips, skipLen, out, cap, outLen, excludes, excludeLen);\n                }\n            }\n            else if (bEndsWith(nm, \".crl\"))\n            {\n                if (!bExcluded(nm, excludes, excludeLen) && *outLen < cap)\n                {\n                    out[*outLen] = Slice::fromStr(bJoinStr(a, dirS, nm));\n                    *outLen += 1;\n                }\n            }\n        }\n        i++;\n    }\n    return *outLen;\n}\n\nvoid bSortFiles(Slice* files, u32 len)\n{\n    u32 i = 1;\n    while (i < len)\n    {\n        Slice key = files[i];\n        i32 j = (i32)i - 1;\n        while (j >= 0)\n        {\n            bool less = false;\n            Slice cur = files[j];\n            usize minLen = cur.len;\n            if (key.len < minLen) minLen = key.len;\n            usize k = 0;\n            while (k < minLen)\n            {\n                if (cur.ptr[k] < key.ptr[k]) { less = true; break; }\n                if (cur.ptr[k] > key.ptr[k]) { less = false; break; }\n                k++;\n                if (k == minLen && cur.len < key.len) less = true;\n            }\n            if (!less) break;\n            files[j + 1] = files[j];\n            j--;\n        }\n        files[j + 1] = key;\n        i++;\n    }\n}\n\n// config extraction\n\nCrlbField* bFindField(CrlbNode* n, Slice name)\n{\n    u32 i = 0;\n    while (i < (u32)n->fields.len)\n    {\n        if (bEq(n->fields.data[i].name, name.asStr())) return n->fields.data + i;\n        i++;\n    }\n    return null;\n}\n\npub bool bFieldStr(CrlbNode* n, Slice name, Slice* out)\n{\n    CrlbField* f = bFindField(n, name);\n    if (f == null) return false;\n    Value v = f->value;\n    if (v.tag != Value::String) return false;\n    *out = v.payload.String.value;\n    return true;\n}\n\nbool bFieldBool(CrlbNode* n, Slice name, bool* out)\n{\n    CrlbField* f = bFindField(n, name);\n    if (f == null) return false;\n    Value v = f->value;\n    if (v.tag != Value::Boolean) return false;\n    *out = v.payload.Boolean.value;\n    return true;\n}\n\n/* ── profiles ─────────────────────────────────────────────────────── */\n\nCrlbNode* bFindProfileNode(CrlbNode* root, Slice name)\n{\n    usize i = 0;\n    while (i < root->children.len)\n    {\n        CrlbNode* c = root->children.data + i;\n        if (c->kind == CrlbNodeKind::Profile && c->hasLabel && bEq(c->label, name.asStr())) return c;\n        i++;\n    }\n    return null;\n}\n\nbool bProfileStored(Builder* b, Slice name)\n{\n    u32 i = 0;\n    while (i < b->profilesLen)\n    {\n        if (bEq(b->profileNames[i], name.asStr())) return true;\n        i++;\n    }\n    return false;\n}\n\n/* resolve a profile's extends chain (base fills gaps, child wins), then\n * store the effective profile. unknown base or a cycle returns false. */\nbool bCollectProfile(Builder* b, CrlbNode* root, CrlbNode* p, u32 depth)\n{\n    if (depth > 8) return false;\n    if (p->hasExtends)\n    {\n        CrlbNode* base = bFindProfileNode(root, p->extendsTarget);\n        if (base == null || base == p) return false;\n        if (!bCollectProfile(b, root, base, depth + 1)) return false;\n        usize m = 0;\n        while (m < base->fields.len)\n        {\n            CrlbField* bf = base->fields.data + m;\n            if (bFindField(p, bf->name) == null) p->addField(bf->name, bf->value);\n            m++;\n        }\n        p->hasExtends = false;\n    }\n    if (bProfileStored(b, p->label)) return true; // diamond: base already stored\n    if (b->profilesLen >= 64) return true;\n    u32 idx = b->profilesLen;\n    b->profileNames[idx] = p->label;\n    b->profileOpts[idx] = Slice::from(null, 0);\n    bFieldStr(p, Slice::fromStr(\"opt\"), &b->profileOpts[idx]);\n    Slice* fl = (Slice*)b->arena->alloc(32 * @sizeof(Slice), 8);\n    b->profileFlags[idx] = fl;\n    b->profileFlagLens[idx] = 0;\n    if (fl != null) b->profileFlagLens[idx] = bFieldList(p, Slice::fromStr(\"flags\"), b->arena, fl, 32);\n    b->profilesLen++;\n    return true;\n}\n\n/* ── override exclude matching ────────────────────────────────────── */\n\n/* `*suffix` matches by filename suffix, otherwise exact filename. */\nbool bExcluded(Slice name, Slice* ex, u32 exLen)\n{\n    u32 i = 0;\n    while (i < exLen)\n    {\n        Slice p = ex[i];\n        if (p.len > 1 && p.ptr[0] == 42)\n        {\n            Slice suf = Slice::from(p.ptr + 1, p.len - 1);\n            if (name.len >= suf.len && Slice::from(name.ptr + (name.len - suf.len), suf.len).eq(suf)) return true;\n        }\n        else if (name.eq(p)) return true;\n        i++;\n    }\n    return false;\n}\n\n// fills out[0..cap) with the list field's strings; returns count (0 = absent/invalid)\npub u32 bFieldList(CrlbNode* n, Slice name, Arena* a, Slice* out, u32 cap)\n{\n    CrlbField* f = bFindField(n, name);\n    if (f == null) return 0;\n    Value v = f->value;\n    if (v.tag != Value::List) return 0;\n    ValueArray* va = v.payload.List.value;\n    if (va == null) return 0;\n    if (va->len == 0) return 0;\n    if (va->len > (usize)cap) return 0;\n    u32 i = 0;\n    while (i < (u32)va->len)\n    {\n        Value item = va->data[i];\n        if (item.tag != Value::String) return 0;\n        out[i] = item.payload.String.value;\n        i++;\n    }\n    return (u32)va->len;\n}\n\npub struct AliasEnt\n{\n    Slice name;\n    Slice folder;\n}\n\npub struct ModNode\n{\n    Slice name;\n    u32* deps;\n    u32 depsLen;\n    u32 depsCap;\n    Slice* files;\n    u32 filesLen;\n    u64 fingerprint;\n    bool stale;\n}\n\npub struct Builder\n{\n    Arena* arena;\n    CrlbNode* cfg;\n    CrlbNode* build;\n    Slice rootDir;\n    Slice entry;\n    Slice output;\n    Slice mapPath;\n    Slice cacheDir;\n    Slice target;\n    Slice opt;\n    Slice* modules;\n    u32 modulesLen;\n    Slice* skips;\n    u32 skipsLen;\n    AliasEnt* aliases;\n    u32 aliasesLen;\n    ModNode* mods;\n    u32 topoLen;\n    u32* topoOrder;\n    u32 errors;\n    bool force;\n    bool dryRun;\n    bool emitMapOnly;\n    /* in-memory module table: key (`module`, `alias`, `module::name`,\n     * `alias::name`) → source path. The compiler's loader consumes this\n     * directly; the .map file is a debug dump, never an input. */\n    Slice* modKeys;\n    Slice* modVals;\n    u32 modLen;\n    u32 modCap;\n    /* build-file flags: k=v pairs feed the flag (NAME) table; recognized\n     * --option entries flip the bools below (CLI still wins where both\n     * set a flag: the parser first-match-wins and CLI flags load first) */\n    Slice* crlbFlagNames;\n    Slice* crlbFlagValues;\n    u32 crlbFlagPairs;\n    bool crlbAllowIntPtr;\n    bool crlbQuiet;\n    /* suppress every stdout summary/diagnostic (the LSP serves JSON on\n     * stdout; builder output would corrupt the protocol stream) */\n    bool quiet;\n    /* task decls: name → exec/output plus `after` deps (\"build\" is the\n     * pseudo-task of the compile+link pipeline itself) */\n    Slice* taskNames;\n    Slice* taskExecs;\n    Slice* taskOutputs;\n    Slice** taskAfters;\n    u32* taskAfterLens;\n    u32 tasksLen;\n    Slice entryPath;\n    bool anyStale;\n    /* false until the compile phase actually compiles modules. coralc.crl\n     * refuses to report build success while this is false. */\n    bool compilePhaseReached;\n    /* crlb `strict = true` (or CLI --strict): reject unknown build fields */\n    bool strict;\n    /* profile blocks: name → effective opt + flags (extends already merged;\n     * selected via `profile=NAME` flag pair or CLI --profile) */\n    Slice* profileNames;\n    Slice* profileOpts;\n    Slice** profileFlags;\n    u32* profileFlagLens;\n    u32 profilesLen;\n    /* override \"module\" { ... } blocks: per-module opt/flags/exclude */\n    Slice* ovrMods;\n    Slice* ovrOpts;\n    Slice** ovrFlags;\n    u32* ovrFlagLens;\n    Slice** ovrExcludes;\n    u32* ovrExcludeLens;\n    u32 overridesLen;\n}\n\nvoid bError(Builder* b, str code, str msg, str k1, str v1, str k2, str v2, str hint)\n{\n    b->errors++;\n    if (b->quiet) return;\n    printf(C\"%.*s  %.*s\\n\", (i32)code.len, code.ptr, (i32)msg.len, msg.ptr);\n    if (k1.ptr != null) printf(C\"  %.*s:   %.*s\\n\", (i32)k1.len, k1.ptr, (i32)v1.len, v1.ptr);\n    if (k2.ptr != null) printf(C\"  %.*s:   %.*s\\n\", (i32)k2.len, k2.ptr, (i32)v2.len, v2.ptr);\n    if (hint.ptr != null) printf(C\"  hint:   %.*s\\n\", (i32)hint.len, hint.ptr);\n}\n\nbool bInit(Builder* b, Arena* a, CrlbNode* root, bool forceIn, bool emitMapOnlyIn, bool quietIn)\n{\n    b->arena = a;\n    b->cfg = root;\n    b->build = null;\n    b->errors = 0;\n    b->force = forceIn;\n    b->dryRun = false;\n    b->emitMapOnly = emitMapOnlyIn;\n    b->quiet = quietIn;\n    b->compilePhaseReached = false;\n    b->rootDir = Slice::fromStr(\"\");  // root comes from the build file's root field\n    b->entry = Slice::from(null, 0);\n    b->output = Slice::from(null, 0);\n    b->mapPath = Slice::fromStr(\".coral/modules.map\");\n    b->cacheDir = Slice::fromStr(\".coral/cache\");\n    b->target = Slice::from(null, 0);\n    b->opt = Slice::fromStr(\"debug\");\n    b->modules = null;\n    b->modulesLen = 0;\n    b->skips = null;\n    b->skipsLen = 0;\n    b->aliases = null;\n    b->aliasesLen = 0;\n    b->mods = null;\n    b->topoOrder = null;\n    b->topoLen = 0;\n    b->modKeys = null;\n    b->modVals = null;\n    b->modLen = 0;\n    b->modCap = 0;\n    b->crlbFlagNames = null;\n    b->crlbFlagValues = null;\n    b->crlbFlagPairs = 0;\n    b->crlbAllowIntPtr = false;\n    b->crlbQuiet = false;\n    b->taskNames = null;\n    b->taskExecs = null;\n    b->taskOutputs = null;\n    b->taskAfters = null;\n    b->taskAfterLens = null;\n    b->tasksLen = 0;\n    b->entryPath = Slice::from(null, 0);\n    b->anyStale = false;\n    b->strict = false;\n    b->profileNames = null;\n    b->profileOpts = null;\n    b->profileFlags = null;\n    b->profileFlagLens = null;\n    b->profilesLen = 0;\n    b->ovrMods = null;\n    b->ovrOpts = null;\n    b->ovrFlags = null;\n    b->ovrFlagLens = null;\n    b->ovrExcludes = null;\n    b->ovrExcludeLens = null;\n    b->overridesLen = 0;\n\n    u32 i = 0;\n    while (i < (u32)root->children.len)\n    {\n        CrlbNode* c = root->children.data + i;\n        if (c->kind == CrlbNodeKind::Build)\n        {\n            b->build = c;\n            break;\n        }\n        i++;\n    }\n    if (b->build == null)\n    {\n        if (!b->quiet) printf(C\"E1000  no build block found\\n\");\n        b->errors++;\n        return false;\n    }\n\n    /* crlb `strict = true` */\n    {\n        usize ci = 0;\n        while (ci < root->children.len)\n        {\n            CrlbNode* c = root->children.data + ci;\n            if (c->kind == CrlbNodeKind::Strict)\n            {\n                bool sv = false;\n                if (bFieldBool(c, Slice::fromStr(\"strict\"), &sv) && sv) b->strict = true;\n                break;\n            }\n            ci++;\n        }\n    }\n\n    /* profile blocks: collect with extends resolved (base fills gaps) */\n    b->profileNames = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->profileOpts = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->profileFlags = (Slice**)a->alloc(64 * @sizeof(Slice*), 8);\n    b->profileFlagLens = (u32*)a->alloc(64 * @sizeof(u32), 4);\n    {\n        usize ci = 0;\n        while (ci < root->children.len && b->errors == 0)\n        {\n            CrlbNode* c = root->children.data + ci;\n            if (c->kind == CrlbNodeKind::Profile && c->hasLabel && !bProfileStored(b, c->label))\n            {\n                if (!bCollectProfile(b, root, c, 0))\n                {\n                    bError(b, \"E1012\", \"unknown profile in extends (or cycle)\", \"profile\", c->label.asStr(), \"extends\", c->extendsTarget.asStr(),\n                           \"define the base profile in this file\");\n                }\n            }\n            ci++;\n        }\n    }\n\n    /* override \"module\" { opt, flags, exclude } blocks */\n    b->ovrMods = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->ovrOpts = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->ovrFlags = (Slice**)a->alloc(64 * @sizeof(Slice*), 8);\n    b->ovrFlagLens = (u32*)a->alloc(64 * @sizeof(u32), 4);\n    b->ovrExcludes = (Slice**)a->alloc(64 * @sizeof(Slice*), 8);\n    b->ovrExcludeLens = (u32*)a->alloc(64 * @sizeof(u32), 4);\n    {\n        usize ci = 0;\n        while (ci < root->children.len && b->overridesLen < 64)\n        {\n            CrlbNode* c = root->children.data + ci;\n            if (c->kind == CrlbNodeKind::Override && c->hasLabel)\n            {\n                u32 oi = b->overridesLen;\n                b->ovrMods[oi] = c->label;\n                b->ovrOpts[oi] = Slice::from(null, 0);\n                bFieldStr(c, Slice::fromStr(\"opt\"), &b->ovrOpts[oi]);\n                Slice* fl = (Slice*)a->alloc(32 * @sizeof(Slice), 8);\n                Slice* ex = (Slice*)a->alloc(32 * @sizeof(Slice), 8);\n                b->ovrFlags[oi] = fl;\n                b->ovrFlagLens[oi] = 0;\n                b->ovrExcludes[oi] = ex;\n                b->ovrExcludeLens[oi] = 0;\n                if (fl != null) b->ovrFlagLens[oi] = bFieldList(c, Slice::fromStr(\"flags\"), a, fl, 32);\n                if (ex != null) b->ovrExcludeLens[oi] = bFieldList(c, Slice::fromStr(\"exclude\"), a, ex, 32);\n                b->overridesLen++;\n            }\n            ci++;\n        }\n    }\n\n    bFieldStr(b->build, Slice::fromStr(\"root\"), &b->rootDir);\n    bFieldStr(b->build, Slice::fromStr(\"entry\"), &b->entry);\n    bFieldStr(b->build, Slice::fromStr(\"output\"), &b->output);\n    bFieldStr(b->build, Slice::fromStr(\"module_map\"), &b->mapPath);\n    bFieldStr(b->build, Slice::fromStr(\"cache_dir\"), &b->cacheDir);\n    bFieldStr(b->build, Slice::fromStr(\"target\"), &b->target);\n    bFieldStr(b->build, Slice::fromStr(\"opt\"), &b->opt);\n    b->modules = (Slice*)a->alloc(512 * @sizeof(Slice), 8);\n    b->modulesLen = bFieldList(b->build, Slice::fromStr(\"modules\"), a, b->modules, 512);\n    b->skips = (Slice*)a->alloc(512 * @sizeof(Slice), 8);\n    b->skipsLen = bFieldList(b->build, Slice::fromStr(\"skip\"), a, b->skips, 512);\n\n    // build-file flags: k=v pairs (flag table) plus recognized options\n    b->crlbFlagNames = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->crlbFlagValues = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    Slice* rawFlags = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    u32 rawCount = bFieldList(b->build, Slice::fromStr(\"flags\"), a, rawFlags, 64);\n    if (rawCount > 0)\n    {\n        u32 rf = 0;\n        while (rf < rawCount)\n        {\n            Slice e = rawFlags[rf];\n            rf++;\n            if (e.len >= 3 && e.ptr[0] == 45 && e.ptr[1] == 45)\n            {\n                if (bEq(e, \"--allow-int-ptr\")) b->crlbAllowIntPtr = true; // stop freaking casting string literals to pointers, they are composite types with len youu fucktard\n                else if (bEq(e, \"--quiet\")) b->crlbQuiet = true;\n                else if (bEq(e, \"--strict\")) b->strict = true;\n            }\n            else\n            {\n                // k=v pair, split at the first '='\n                usize eq = 0;\n                while (eq < e.len && e.ptr[eq] != 61) eq++;\n                if (eq > 0 && eq < e.len && b->crlbFlagPairs < 64)\n                {\n                    b->crlbFlagNames[b->crlbFlagPairs] = Slice::from(e.ptr, (usize)eq);\n                    b->crlbFlagValues[b->crlbFlagPairs] = Slice::from(e.ptr + eq + 1, e.len - eq - 1);\n                    b->crlbFlagPairs++;\n                }\n            }\n        }\n    }\n\n    /* select and apply a profile: `profile=NAME` flag pair (from the crlb\n     * flags list or injected by the CLI --profile). opt overrides the build\n     * block's; profile flags append to the flag table. */\n    {\n        Slice profName = Slice::from(null, 0);\n        u32 fi = b->crlbFlagPairs;\n        while (fi > 0)\n        {\n            fi--;\n            if (bEq(b->crlbFlagNames[fi], \"profile\")) { profName = b->crlbFlagValues[fi]; break; }\n        }\n        if (profName.len > 0)\n        {\n            i32 pi = -1;\n            u32 p = 0;\n            while (p < b->profilesLen)\n            {\n                if (bEq(b->profileNames[p], profName.asStr())) { pi = (i32)p; break; }\n                p++;\n            }\n            if (pi < 0)\n            {\n                bError(b, \"E1012\", \"unknown profile\", \"profile\", profName.asStr(), str { .ptr = null, .len = 0 }, Slice::from(null, 0).asStr(),\n                       \"declare it with: profile \\\"name\\\" { ... }\");\n            }\n            else\n            {\n                u32 pui = (u32)pi;\n                if (b->profileOpts[pui].len > 0) b->opt = b->profileOpts[pui];\n                u32 fl = 0;\n                while (fl < b->profileFlagLens[pui] && b->crlbFlagPairs < 64)\n                {\n                    Slice e = b->profileFlags[pui][fl];\n                    usize eq = 0;\n                    while (eq < e.len && e.ptr[eq] != 61) eq++;\n                    if (eq > 0 && eq < e.len)\n                    {\n                        b->crlbFlagNames[b->crlbFlagPairs] = Slice::from(e.ptr, eq);\n                        b->crlbFlagValues[b->crlbFlagPairs] = Slice::from(e.ptr + eq + 1, e.len - eq - 1);\n                        b->crlbFlagPairs++;\n                    }\n                    fl++;\n                }\n            }\n        }\n    }\n\n    /* opt is now final (build block + profile) — validate it */\n    if (!(bEq(b->opt, \"debug\") || bEq(b->opt, \"release\") || bEq(b->opt, \"size\") || bEq(b->opt, \"O3\")))\n    {\n        if (!b->quiet) printf(C\"E1000  unknown opt \\\"%s\\\" (expected debug, release, size, or O3)\\n\", bCStr(b->arena, b->opt));\n        b->errors++;\n        return false;\n    }\n\n    /* override targets must name a listed module */\n    {\n        u32 oi = 0;\n        while (oi < b->overridesLen)\n        {\n            if (bModuleIdx(b, b->ovrMods[oi]) < 0)\n            {\n                bError(b, \"E1011\", \"override target is not a module\", \"override\", b->ovrMods[oi].asStr(), str { .ptr = null, .len = 0 }, Slice::from(null, 0).asStr(),\n                       \"list the module in modules = [...]\");\n            }\n            oi++;\n        }\n    }\n\n    /* strict: unknown fields in the build block are typos, not no-ops */\n    if (b->strict)\n    {\n        usize fxi = 0;\n        while (fxi < b->build->fields.len)\n        {\n            Slice nm = b->build->fields.data[fxi].name;\n            bool known = bEq(nm, \"root\") || bEq(nm, \"entry\") || bEq(nm, \"target\") ||\n                         bEq(nm, \"opt\") || bEq(nm, \"output\") || bEq(nm, \"module_map\") ||\n                         bEq(nm, \"cache_dir\") || bEq(nm, \"flags\") || bEq(nm, \"modules\") ||\n                         bEq(nm, \"skip\") || bEq(nm, \"doc\");\n            if (!known)\n            {\n                bError(b, \"E1010\", \"unknown build field\", \"field\", nm.asStr(), str { .ptr = null, .len = 0 }, Slice::from(null, 0).asStr(),\n                       \"known fields: root, entry, target, opt, output, module_map, cache_dir, flags, modules, skip, doc\");\n            }\n            fxi++;\n        }\n    }\n\n    if (b->modulesLen == 0)\n    {\n        if (!b->quiet) printf(C\"E1000  modules = [...] is required in build block\\n\");\n        b->errors++;\n        return false;\n    }\n\n    b->mods = (ModNode*)a->alloc((usize)b->modulesLen * @sizeof(ModNode), 8);\n    if (b->mods == null) return false;\n    u32 m = 0;\n    while (m < b->modulesLen)\n    {\n        b->mods[m].name = b->modules[m];\n        b->mods[m].deps = null;\n        b->mods[m].depsLen = 0;\n        b->mods[m].depsCap = 0;\n        b->mods[m].files = null;\n        b->mods[m].filesLen = 0;\n        b->mods[m].fingerprint = 14695981039346656037;\n        b->mods[m].stale = true;\n        m++;\n    }\n\n    u32 aliasCount = 0;\n    i = 0;\n    while (i < (u32)root->children.len)\n    {\n        if (root->children.data[i].kind == CrlbNodeKind::Alias) aliasCount++;\n        i++;\n    }\n    if (aliasCount > 0)\n    {\n        b->aliases = (AliasEnt*)a->alloc((usize)aliasCount * @sizeof(AliasEnt), 8);\n        if (b->aliases == null) return false;\n    }\n    i = 0;\n    while (i < (u32)root->children.len)\n    {\n        CrlbNode* c = root->children.data + i;\n        if (c->kind == CrlbNodeKind::Alias && c->hasLabel && c->hasPayload)\n        {\n            u8* tgt = c->payload.ptr;\n            usize tgtLen = c->payload.len;\n            u32 s = 0;\n            while (s < (u32)tgtLen)\n            {\n                if (tgt[s] == '/')\n                {\n                    tgtLen = (usize)s;\n                    break;\n                }\n                s++;\n            }\n            b->aliases[b->aliasesLen].name = c->label;\n            b->aliases[b->aliasesLen].folder = Slice::from(tgt, tgtLen);\n            b->aliasesLen++;\n        }\n        i++;\n    }\n\n    /* task decls (name, exec, output, after) */\n    b->taskNames = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->taskExecs = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->taskOutputs = (Slice*)a->alloc(64 * @sizeof(Slice), 8);\n    b->taskAfters = (Slice**)a->alloc(64 * @sizeof(Slice*), 8);\n    b->taskAfterLens = (u32*)a->alloc(64 * @sizeof(u32), 8);\n    if (b->taskNames == null || b->taskExecs == null || b->taskOutputs == null ||\n        b->taskAfters == null || b->taskAfterLens == null) return false;\n    i = 0;\n    while (i < (u32)root->children.len)\n    {\n        CrlbNode* c = root->children.data + i;\n        if (c->kind == CrlbNodeKind::Task && c->hasLabel && b->tasksLen < 64)\n        {\n            u32 t = b->tasksLen;\n            b->taskNames[t] = c->label;\n            b->taskExecs[t] = Slice::from(null, 0);\n            b->taskOutputs[t] = Slice::from(null, 0);\n            bFieldStr(c, Slice::fromStr(\"exec\"), &b->taskExecs[t]);\n            bFieldStr(c, Slice::fromStr(\"output\"), &b->taskOutputs[t]);\n            Slice* aft = (Slice*)a->alloc(16 * @sizeof(Slice), 8);\n            b->taskAfters[t] = aft;\n            b->taskAfterLens[t] = 0;\n            if (aft != null)\n            {\n                b->taskAfterLens[t] = bFieldList(c, Slice::fromStr(\"after\"), a, aft, 16);\n            }\n            b->tasksLen++;\n        }\n        i++;\n    }\n    return b->errors == 0;\n}\n\n// resolve alias or raw folder prefix to a module folder\nbool bResolvePrefix(Builder* b, Slice prefix, Slice* outFolder)\n{\n    u32 i = 0;\n    while (i < b->aliasesLen)\n    {\n        if (bEq(b->aliases[i].name, prefix.asStr()))\n        {\n            *outFolder = b->aliases[i].folder;\n            return true;\n        }\n        i++;\n    }\n    i = 0;\n    while (i < b->modulesLen)\n    {\n        if (bEq(b->modules[i], prefix.asStr()))\n        {\n            *outFolder = b->modules[i];\n            return true;\n        }\n        i++;\n    }\n    return false;\n}\n\ni32 bModuleIdx(Builder* b, Slice folder)\n{\n    u32 i = 0;\n    while (i < b->modulesLen)\n    {\n        if (bEq(b->modules[i], folder.asStr())) return (i32)i;\n        i++;\n    }\n    return -1;\n}\n\npub i32 bTaskIndex(Builder* b, str name)\n{\n    if (b->taskNames == null) return -1;\n    u32 i = 0;\n    while (i < b->tasksLen)\n    {\n        if (bEq(b->taskNames[i], name)) return (i32)i;\n        i++;\n    }\n    return -1;\n}\n\n// the builder verifies the module surface file exists (E1001) and later\n// line-scans it for `pub mod` re-exports (bBuildModuleTable); it never\n// runs the full Coral parser on user sources.\nbool bScanLib(Builder* b, Slice folder)\n{\n    str libDir = bJoinStr(b->arena, b->rootDir, folder);\n    if (libDir.ptr == null) return false;\n    str libPath = bJoinStr(b->arena, Slice::from((u8*)libDir.ptr, libDir.len), Slice::fromStr(\"lib.crl\"));\n    if (libPath.ptr == null) return false;\n    if (!bFileExists(libPath))\n    {\n        bError(b, \"E1001\", \"missing lib.crl\", \"module\", folder.asStr(), \"path\", libPath,\n               \"run `coralc init <module>` or add a lib.crl\");\n        return false;\n    }\n    return true;\n}\n\nbool bValidateAliases(Builder* b)\n{\n    u32 i = 0;\n    while (i < b->aliasesLen)\n    {\n        i32 idx = bModuleIdx(b, b->aliases[i].folder);\n        if (idx < 0)\n        {\n            bError(b, \"E1003\", \"alias points to unknown module\", \"alias\", b->aliases[i].name.asStr(), \"target\", b->aliases[i].folder.asStr(),\n                   \"list: modules = [...]\");\n            return false;\n        }\n        i++;\n    }\n    return true;\n}\n\npub bool bWriteFile(str path, const u8* data, usize len)\n{\n    Result<FileHandle, IoError> fo = fileOpen(path, \"w\");\n    if (fo.isErr()) return false;\n    FileHandle fh = fo.unwrap();\n    Result<usize, IoError> wr = fileWrite(fh, str { .ptr = (u8*)data, .len = len });\n    fileClose(fh);\n    return wr.isOk();\n}\n\n/* platform root for platform-first re-export resolution inside the\n * builder: crlb flags (platform=/arch=) > CORAL_PLATFORM > compile-time host.\n * Returns an arena-owned \"arch/os\" string (may be empty on alloc failure). */\nSlice bPlatformRoot(Builder* b)\n{\n    u8* plat = null;\n    usize platLen = 0;\n    u8* arch = null;\n    usize archLen = 0;\n    u32 fi = 0;\n    while (fi < b->crlbFlagPairs)\n    {\n        if (bEq(b->crlbFlagNames[fi], \"platform\")) { plat = b->crlbFlagValues[fi].ptr; platLen = b->crlbFlagValues[fi].len; }\n        if (bEq(b->crlbFlagNames[fi], \"arch\")) { arch = b->crlbFlagValues[fi].ptr; archLen = b->crlbFlagValues[fi].len; }\n        fi++;\n    }\n    if (plat == null)\n    {\n        u8* env = (u8*)getenv(C\"CORAL_PLATFORM\");\n        if (env != null)\n        {\n            usize el = 0;\n            while (env[el] != 0) el++;\n            if (el > 0) { plat = env; platLen = el; }\n        }\n    }\n    if (plat == null)\n    {\n        str a = hostArch();\n        str o = hostOs();\n        usize n = a.len + 1 + o.len;\n        u8* p = (u8*)b->arena->alloc(n + 1, 1);\n        if (p == null) return Slice::from(null, 0);\n        usize k = 0;\n        while (k < a.len) { p[k] = a.ptr[k]; k++; }\n        p[k] = 47; k++;\n        usize j = 0;\n        while (j < o.len) { p[k] = o.ptr[j]; k++; j++; }\n        p[k] = 0;\n        return Slice::from(p, n);\n    }\n    // full 'arch/os' value: use as-is\n    {\n        usize sc = 0;\n        usize q = 0;\n        while (q < platLen) { if (plat[q] == 47) sc++; q++; }\n        if (sc > 0)\n        {\n            u8* p = (u8*)b->arena->alloc(platLen + 1, 1);\n            if (p == null) return Slice::from(null, 0);\n            usize k = 0;\n            while (k < platLen) { p[k] = plat[k]; k++; }\n            p[platLen] = 0;\n            return Slice::from(p, platLen);\n        }\n    }\n    // bare OS name: prefix the arch (same shim as segsFromPlatformFlag)\n    if (arch == null) { str dfltArch = hostArch(); arch = (u8*)dfltArch.ptr; archLen = dfltArch.len; }\n    u8* p = (u8*)b->arena->alloc(archLen + 1 + platLen + 1, 1);\n    if (p == null) return Slice::from(null, 0);\n    usize k = 0;\n    while (k < archLen) { p[k] = arch[k]; k++; }\n    p[k] = 47; k++;\n    usize j = 0;\n    while (j < platLen) { p[k] = plat[j]; k++; j++; }\n    p[k] = 0;\n    return Slice::from(p, k);\n}\n\n// append key→value to the in-memory module table (arena-owned copies)\nbool bModTableAdd(Builder* b, Slice key, Slice val)\n{\n    if (b->modCap == 0)\n    {\n        b->modCap = 4096;\n        b->modKeys = (Slice*)b->arena->alloc((usize)b->modCap * @sizeof(Slice), 8);\n        b->modVals = (Slice*)b->arena->alloc((usize)b->modCap * @sizeof(Slice), 8);\n        if (b->modKeys == null || b->modVals == null) { b->modCap = 0; return false; }\n    }\n    if (b->modLen >= b->modCap) return true; // table full; probing still works\n    u8* k = bCStr(b->arena, key);\n    u8* v = bCStr(b->arena, val);\n    if (k == null || v == null) return false;\n    b->modKeys[b->modLen] = Slice::from(k, key.len);\n    b->modVals[b->modLen] = Slice::from(v, val.len);\n    b->modLen++;\n    return true;\n}\n\nbool bModTableHas(Builder* b, Slice key)\n{\n    u32 i = 0;\n    while (i < b->modLen)\n    {\n        if (bEq(b->modKeys[i], key.asStr())) return true;\n        i++;\n    }\n    return false;\n}\n\n/* register key under `prefix::NAME` and `NAME` for every alias of the\n * module folder plus the raw folder name */\nvoid bRegisterExport(Builder* b, Slice folder, Slice name, Slice val)\n{\n    // raw: folder::name\n    u8* k1 = (u8*)b->arena->alloc(folder.len + 2 + name.len + 1, 1);\n    if (k1 != null)\n    {\n        usize n = 0;\n        usize i = 0;\n        while (i < folder.len) { k1[n] = folder.ptr[i]; n++; i++; }\n        k1[n] = 58; k1[n + 1] = 58; n += 2;\n        i = 0;\n        while (i < name.len) { k1[n] = name.ptr[i]; n++; i++; }\n        k1[n] = 0;\n        if (!bModTableHas(b, Slice::from(k1, n))) bModTableAdd(b, Slice::from(k1, n), val);\n        else\n        {\n            if (!b->quiet)\n            {\n                printf(C\"E1002  duplicate module export\\n  key:    \");\n                usize q = 0;\n                while (q < n) { printf(C\"%c\", k1[q]); q++; }\n                printf(C\"\\n\");\n            }\n            b->errors++;\n        }\n    }\n    // alias: aliasname::name for each alias whose folder matches\n    u32 ai = 0;\n    while (ai < b->aliasesLen)\n    {\n        if (bEq(b->aliases[ai].folder, folder.asStr()))\n        {\n            u8* k2 = (u8*)b->arena->alloc(b->aliases[ai].name.len + 2 + name.len + 1, 1);\n            if (k2 != null)\n            {\n                usize n = 0;\n                usize i = 0;\n                while (i < b->aliases[ai].name.len) { k2[n] = b->aliases[ai].name.ptr[i]; n++; i++; }\n                k2[n] = 58; k2[n + 1] = 58; n += 2;\n                i = 0;\n                while (i < name.len) { k2[n] = name.ptr[i]; n++; i++; }\n                k2[n] = 0;\n                if (!bModTableHas(b, Slice::from(k2, n))) bModTableAdd(b, Slice::from(k2, n), val);\n            }\n        }\n        ai++;\n    }\n}\n\nbool bIsIdentChar(u8 c)\n{\n    if (c >= 97 && c <= 122) return true;\n    if (c >= 65 && c <= 90) return true;\n    if (c >= 48 && c <= 57) return true;\n    if (c == 95) return true;\n    return false;\n}\n\n/* try <base>/<path>.crl then <base>/<path>/lib.crl; returns a heap-allocated\n * path (release with dealloc<u8>) or null. base is a str. */\nu8* bProbePath(str base, Slice path)\n{\n    usize bl = base.len;\n    // room for BOTH candidates: base + '/' + path + \"/lib.crl\" + NUL\n    usize cand = bl + 1 + path.len + 9 + 1;\n    u8* p = alloc<u8>(cand);\n    if (p == null) return null;\n    usize n = 0;\n    usize i = 0;\n    while (i < bl) { p[n] = base.ptr[i]; n++; i++; }\n    p[n] = 47; n++;\n    i = 0;\n    while (i < path.len) { p[n] = path.ptr[i]; n++; i++; }\n    p[n] = 46; p[n + 1] = 99; p[n + 2] = 114; p[n + 3] = 108; p[n + 4] = 0;\n    if (bFileExists(str { .ptr = p, .len = n + 4 })) return p;\n    // <base>/<path>/lib.crl\n    p[n] = 47; n++;\n    str suf = \"/lib.crl\";\n    i = 0;\n    while (i < suf.len) { p[n] = suf.ptr[i]; n++; i++; }\n    p[n] = 0;\n    if (bFileExists(str { .ptr = p, .len = n })) return p;\n    dealloc<u8>(p);\n    return null;\n}\n\n/* line-scan one module's lib.crl for `pub mod NAME = import|use PATH;`\n * and register every export in the module table. PATH is a namespace path\n * (ident (:: ident)*) or a quoted string (legacy: quotes are stripped). */\nbool bScanReexports(Builder* b, Slice folder, str libPathC, Slice platRoot)\n{\n    usize len = 0;\n    Slice content = bReadFile(b->arena, libPathC, &len);\n    if (content.ptr == null) return true; // E1001 already covered existence\n    u8* modDir = alloc<u8>(4096);\n    if (modDir == null) return false;\n    usize modDirLen = bJoin(modDir, 4096, b->rootDir, folder);\n    usize i = 0;\n    while (i < len)\n    {\n        // skip whitespace\n        while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9 || content.ptr[i] == 10 || content.ptr[i] == 13)) i++;\n        if (i >= len) break;\n        // only `pub mod NAME = import ... ;` lines are re-exports\n        if (i + 7 <= len && content.ptr[i] == 112 && content.ptr[i + 1] == 117 && content.ptr[i + 2] == 98 &&\n            (i + 3 >= len || !bIsIdentChar(content.ptr[i + 3])))\n        {\n            i += 3;\n            while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;\n            if (i + 3 <= len && content.ptr[i] == 109 && content.ptr[i + 1] == 111 && content.ptr[i + 2] == 100 &&\n                (i + 3 >= len || !bIsIdentChar(content.ptr[i + 3])))\n            {\n                i += 3;\n                while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;\n                usize nameStart = i;\n                while (i < len && bIsIdentChar(content.ptr[i])) i++;\n                usize nameLen = i - nameStart;\n                while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;\n                if (i < len && content.ptr[i] == 61)\n                {\n                    i++;\n                    while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;\n                    // `import` (6 bytes) or `use` (3 bytes)\n                    usize kwLen = 0;\n                    if (i + 6 <= len && content.ptr[i] == 105 && content.ptr[i + 1] == 109 && content.ptr[i + 2] == 112 &&\n                        content.ptr[i + 3] == 111 && content.ptr[i + 4] == 114 && content.ptr[i + 5] == 116 &&\n                        (i + 6 >= len || !bIsIdentChar(content.ptr[i + 6])))\n                    {\n                        kwLen = 6;\n                    }\n                    else if (i + 3 <= len && content.ptr[i] == 117 && content.ptr[i + 1] == 115 && content.ptr[i + 2] == 101 &&\n                        (i + 3 >= len || !bIsIdentChar(content.ptr[i + 3])))\n                    {\n                        kwLen = 3;\n                    }\n                    if (kwLen > 0)\n                    {\n                        i += kwLen;\n                        while (i < len && (content.ptr[i] == 32 || content.ptr[i] == 9)) i++;\n                        u8* pathBuf = alloc<u8>(1024);\n                        if (pathBuf != null)\n                        {\n                            usize pathLen = 0;\n                            if (i < len && content.ptr[i] == 34)\n                            {\n                                i++;\n                                while (i < len && content.ptr[i] != 34 && content.ptr[i] != 10 && pathLen < 1023)\n                                {\n                                    pathBuf[pathLen] = content.ptr[i];\n                                    pathLen++;\n                                    i++;\n                                }\n                                if (i < len && content.ptr[i] == 34) i++;\n                            }\n                            else\n                            {\n                                while (i < len && pathLen < 1023)\n                                {\n                                    if (bIsIdentChar(content.ptr[i])) { pathBuf[pathLen] = content.ptr[i]; pathLen++; i++; }\n                                    else if (content.ptr[i] == 58 && i + 1 < len && content.ptr[i + 1] == 58 && pathLen < 1022)\n                                    {\n                                        pathBuf[pathLen] = 47; pathLen++; i += 2;\n                                    }\n                                    else break;\n                                }\n                            }\n                            // skip to statement end\n                            while (i < len && content.ptr[i] != 59 && content.ptr[i] != 10) i++;\n                            if (i < len && content.ptr[i] == 59) i++;\n                            if (nameLen > 0 && pathLen > 0)\n                            {\n                                /* resolve platform-first: <moddir>/<plat>/<path>.crl,\n                                 * …/<path>/lib.crl, then base <moddir>/<path>.crl, …/lib.crl */\n                                u8* resolved = null;\n                                if (platRoot.len > 0)\n                                {\n                                    u8* platBase = alloc<u8>(4096);\n                                    if (platBase != null)\n                                    {\n                                        usize pn = 0;\n                                        usize q = 0;\n                                        while (modDir[q] != 0 && pn < 4094) { platBase[pn] = modDir[q]; pn++; q++; }\n                                        if (pn > 0 && platBase[pn - 1] != 47 && pn < 4094) { platBase[pn] = 47; pn++; }\n                                        q = 0;\n                                        while (q < platRoot.len && pn < 4094) { platBase[pn] = platRoot.ptr[q]; pn++; q++; }\n                                        platBase[pn] = 0;\n                                        resolved = bProbePath(str { .ptr = platBase, .len = pn }, Slice::from(pathBuf, pathLen));\n                                        dealloc<u8>(platBase);\n                                    }\n                                }\n                                if (resolved == null) resolved = bProbePath(str { .ptr = modDir, .len = modDirLen }, Slice::from(pathBuf, pathLen));\n                                if (resolved != null)\n                                {\n                                    usize rl = 0;\n                                    while (resolved[rl] != 0) rl++;\n                                    Slice nameS = Slice::from(content.ptr + nameStart, (usize)nameLen);\n                                    bRegisterExport(b, folder, nameS, Slice::from(resolved, (usize)rl));\n                                    dealloc<u8>(resolved);\n                                }\n                                else\n                                {\n                                    if (!b->quiet)\n                                    {\n                                        printf(C\"E1004  unresolved module export\\n  module: \");\n                                        usize q = 0;\n                                        while (q < folder.len) { printf(C\"%c\", folder.ptr[q]); q++; }\n                                        printf(C\"\\n  export: \");\n                                        q = 0;\n                                        while (q < nameLen) { printf(C\"%c\", content.ptr[nameStart + q]); q++; }\n                                        printf(C\"\\n  path:   \");\n                                        q = 0;\n                                        while (q < pathLen) { printf(C\"%c\", pathBuf[q]); q++; }\n                                        printf(C\"\\n\");\n                                    }\n                                    b->errors++;\n                                }\n                            }\n                            dealloc<u8>(pathBuf);\n                        }\n                        continue;\n                    }\n                }\n            }\n        }\n        // not a re-export line: skip to end of line\n        while (i < len && content.ptr[i] != 10) i++;\n    }\n    dealloc<u8>(modDir);\n    return true;\n}\n\n/* build the in-memory module table: module surfaces + every `pub mod`\n * re-export they declare. Pass 1 registers surfaces (module + aliases),\n * pass 2 scans lib.crl files for exports. */\nbool bBuildModuleTable(Builder* b)\n{\n    u32 m = 0;\n    while (m < b->modulesLen)\n    {\n        u8* libP = alloc<u8>(4096);\n        if (libP == null) return false;\n        usize n = bJoin(libP, 4096, b->rootDir, b->modules[m]);\n        str suf = \"/lib.crl\";\n        usize k = 0;\n        while (k < suf.len && n < 4095) { libP[n] = suf.ptr[k]; n++; k++; }\n        libP[n] = 0;\n        if (bFileExists(str { .ptr = libP, .len = n }))\n        {\n            // module surface: `module` → lib.crl; alias → lib.crl\n            if (!bModTableHas(b, b->modules[m])) bModTableAdd(b, b->modules[m], Slice::from(libP, n));\n            u32 ai = 0;\n            while (ai < b->aliasesLen)\n            {\n                if (bEq(b->aliases[ai].folder, b->modules[m].asStr()))\n                {\n                    if (!bModTableHas(b, b->aliases[ai].name)) bModTableAdd(b, b->aliases[ai].name, Slice::from(libP, n));\n                }\n                ai++;\n            }\n        }\n        dealloc<u8>(libP);\n        m++;\n    }\n    Slice platRoot = bPlatformRoot(b);\n    m = 0;\n    while (m < b->modulesLen)\n    {\n        u8* libP = alloc<u8>(4096);\n        if (libP == null) return false;\n        usize n = bJoin(libP, 4096, b->rootDir, b->modules[m]);\n        str suf = \"/lib.crl\";\n        usize k = 0;\n        while (k < suf.len && n < 4095) { libP[n] = suf.ptr[k]; n++; k++; }\n        libP[n] = 0;\n        if (bFileExists(str { .ptr = libP, .len = n })) bScanReexports(b, b->modules[m], str { .ptr = libP, .len = n }, platRoot);\n        dealloc<u8>(libP);\n        m++;\n    }\n    return true;\n}\n\n/* resolve the entry module to a source file:\n * <root><entry> when entry already ends in .crl (names the file directly),\n * <root><entry>.crl, <root><entry>/main.crl, <root><entry>/lib.crl */\nbool bResolveEntry(Builder* b)\n{\n    if (b->entry.len == 0) return false;\n    u8* cand = alloc<u8>(4096);\n    if (cand == null) return false;\n    /* the build-file worked example spells entry as an explicit file\n     * (`entry = \"coral-frontend/coral.crl\"`): honor it instead of blindly\n     * appending .crl to the name */\n    bool hasCrl = b->entry.len >= 4;\n    if (hasCrl)\n    {\n        if (b->entry.ptr[b->entry.len - 4] != 46) hasCrl = false;\n        else if (b->entry.ptr[b->entry.len - 3] != 99) hasCrl = false;\n        else if (b->entry.ptr[b->entry.len - 2] != 114) hasCrl = false;\n        else if (b->entry.ptr[b->entry.len - 1] != 108) hasCrl = false;\n    }\n    usize n = bJoin(cand, 4096, b->rootDir, b->entry);\n    if (hasCrl)\n    {\n        if (bFileExists(str { .ptr = cand, .len = n }))\n        {\n            b->entryPath = Slice::from(bCStr(b->arena, Slice::from(cand, n)), n);\n            dealloc<u8>(cand);\n            return true;\n        }\n    }\n    if (n + 4 < 4095)\n    {\n        cand[n] = 46; cand[n + 1] = 99; cand[n + 2] = 114; cand[n + 3] = 108; cand[n + 4] = 0;\n        if (bFileExists(str { .ptr = cand, .len = n + 4 }))\n        {\n            b->entryPath = Slice::from(bCStr(b->arena, Slice::from(cand, n + 4)), n + 4);\n            dealloc<u8>(cand);\n            return true;\n        }\n    }\n    str mid = \"/main.crl\";\n    n = bJoin(cand, 4096, b->rootDir, b->entry);\n    usize k = 0;\n    while (k < mid.len && n < 4095) { cand[n] = mid.ptr[k]; n++; k++; }\n    cand[n] = 0;\n    if (bFileExists(str { .ptr = cand, .len = n }))\n    {\n        b->entryPath = Slice::from(bCStr(b->arena, Slice::from(cand, n)), n);\n        dealloc<u8>(cand);\n        return true;\n    }\n    str libSuf = \"/lib.crl\";\n    n = bJoin(cand, 4096, b->rootDir, b->entry);\n    k = 0;\n    while (k < libSuf.len && n < 4095) { cand[n] = libSuf.ptr[k]; n++; k++; }\n    cand[n] = 0;\n    if (bFileExists(str { .ptr = cand, .len = n }))\n    {\n        b->entryPath = Slice::from(bCStr(b->arena, Slice::from(cand, n)), n);\n        dealloc<u8>(cand);\n        return true;\n    }\n    dealloc<u8>(cand);\n    if (!b->quiet)\n    {\n        printf(C\"E1008  entry module not found\\n  entry:  \");\n        k = 0;\n        while (k < b->entry.len) { printf(C\"%c\", b->entry.ptr[k]); k++; }\n        printf(C\"\\n  tried:  <root><entry>.crl, <root><entry>/main.crl, <root><entry>/lib.crl\\n\");\n    }\n    b->errors++;\n    return false;\n}\n\n/* write every module's fingerprint after a successful compile so the\n * next build can skip up-to-date work */\npub bool bWriteAllFps(Builder* b)\n{\n    u32 m = 0;\n    bool ok = true;\n    while (m < b->modulesLen)\n    {\n        if (!bWriteFp(b, m)) ok = false;\n        m++;\n    }\n    return ok;\n}\n\n/* create the parent directory of a file path (for output=build/foo).\n * an existing directory is success (mkdir EEXIST). */\npub bool bMkdirParent(str path)\n{\n    i32 last = -1;\n    usize i = 0;\n    while (i < path.len) { if (path.ptr[i] == 47) last = (i32)i; i++; }\n    if (last <= 0) return true;\n    Result<bool, IoError> r = createDirRecursive(str { .ptr = path.ptr, .len = (usize)last }, 493);\n    return r.isOk();\n}\n\nbool bWriteMap(Builder* b)\n{\n    createDirRecursive(\".coral\", 493);\n\n    usize cap = 262144;\n    u8* buf = alloc<u8>(cap);\n    if (buf == null) return false;\n    usize len = 0;\n    str header = \"# coral modules.map v1 — debug dump written by `coralc build`; the compiler uses the in-memory table\\n\";\n    bApp(buf, cap, &len, header);\n\n    // module dirs: + <name> → <rootDir><name>\n    // the compiler reads these and expands each lib.crl itself\n    u32 t = 0;\n    while (t < b->modulesLen)\n    {\n        bApp(buf, cap, &len, \"+ \");\n        bApp(buf, cap, &len, b->modules[t].asStr());\n        usize pad = b->modules[t].len + 2;\n        while (pad < 24 && len < cap)\n        {\n            buf[len] = ' ';\n            len++;\n            pad++;\n        }\n        bApp(buf, cap, &len, \" →  \");\n        bApp(buf, cap, &len, bJoinStr(b->arena, b->rootDir, b->modules[t]));\n        if (len + 1 < cap)\n        {\n            buf[len] = '\\n';\n            len++;\n        }\n        t++;\n    }\n\n    // aliases: @ <name> → <folder>\n    if (b->aliasesLen > 0)\n    {\n        if (len + 1 < cap)\n        {\n            buf[len] = '\\n';\n            len++;\n        }\n        str ah = \"# aliases (from build file)\";\n        bApp(buf, cap, &len, ah);\n        if (len + 1 < cap)\n        {\n            buf[len] = '\\n';\n            len++;\n        }\n        u32 al = 0;\n        while (al < b->aliasesLen)\n        {\n            bApp(buf, cap, &len, \"@ \");\n            bApp(buf, cap, &len, b->aliases[al].name.asStr());\n            usize pad = b->aliases[al].name.len + 2;\n            while (pad < 24 && len < cap)\n            {\n                buf[len] = ' ';\n                len++;\n                pad++;\n            }\n            bApp(buf, cap, &len, \" →  \");\n            bApp(buf, cap, &len, b->aliases[al].folder.asStr());\n            if (len + 1 < cap)\n            {\n                buf[len] = '\\n';\n                len++;\n            }\n            al++;\n        }\n    }\n\n    u8* mapC = alloc<u8>(4096);\n    usize mi = 0;\n    while (mi < b->mapPath.len && mi < 4095) { mapC[mi] = b->mapPath.ptr[mi]; mi++; }\n    mapC[mi] = 0;\n    // resolved table: key → path (what the loader actually consumes)\n    if (b->modLen > 0)\n    {\n        if (len + 1 < cap)\n        {\n            buf[len] = '\\n';\n            len++;\n        }\n        str th = \"# resolved module table (key → path)\";\n        bApp(buf, cap, &len, th);\n        if (len + 1 < cap)\n        {\n            buf[len] = '\\n';\n            len++;\n        }\n        u32 e = 0;\n        while (e < b->modLen)\n        {\n            bApp(buf, cap, &len, b->modKeys[e].asStr());\n            bApp(buf, cap, &len, \" → \");\n            bApp(buf, cap, &len, b->modVals[e].asStr());\n            if (len + 1 < cap)\n            {\n                buf[len] = '\\n';\n                len++;\n            }\n            e++;\n        }\n    }\n    bool ok = bWriteFile(b->mapPath.asStr(), buf, len);\n    if (!ok)\n    {\n        if (!b->quiet) printf(C\"E1000  cannot write %s\\n\", mapC);\n        b->errors++;\n    }\n    dealloc<u8>(buf);\n    dealloc<u8>(mapC);\n    return ok;\n}\n\n// walk each module's files, store the list, and fold stat (size + mtime)\n// into the fingerprint — not the content: statting is ~free, while reading\n// and hashing every file cost ~35 ms of I/O on every build of a large\n// tree. use resolution is the compiler's job, not the builder's.\nbool bFingerprint(Builder* b)\n{\n    u32 m = 0;\n    while (m < b->modulesLen)\n    {\n        Slice dirS = Slice::fromStr(bJoinStr(b->arena, b->rootDir, b->modules[m]));\n        if (dirS.ptr == null) return false;\n\n        Slice* files = (Slice*)b->arena->alloc(512 * @sizeof(Slice), 8);\n        if (files == null) return false;\n        u32 filesLen = 0;\n        /* per-module override: exclude patterns filter the file walk */\n        Slice* ex = null;\n        u32 exLen = 0;\n        u32 oi = 0;\n        while (oi < b->overridesLen)\n        {\n            if (bEq(b->ovrMods[oi], b->modules[m].asStr()))\n            {\n                ex = b->ovrExcludes[oi];\n                exLen = b->ovrExcludeLens[oi];\n                break;\n            }\n            oi++;\n        }\n        bCollectCrl(b->arena, dirS, b->skips, b->skipsLen, files, 512, &filesLen, ex, exLen);\n        bSortFiles(files, filesLen);\n        b->mods[m].files = files;\n        b->mods[m].filesLen = filesLen;\n\n        u32 f = 0;\n        while (f < filesLen)\n        {\n            Stat st;\n            Option<bool> sr = statPath(files[f].asStr(), &st);\n            if (sr.isSome())\n            {\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, files[f].ptr, files[f].len);\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, (u8*)&st.st_size, 8);\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, (u8*)&st.st_mtime, 8);\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, (u8*)&st.st_mtimeNsec, 8);\n            }\n            f++;\n        }\n        /* build flags change codegen; fold them into every module's\n         * fingerprint (build_sys.md §12: flags_for(module)) */\n        u32 fl = 0;\n        while (fl < b->crlbFlagPairs)\n        {\n            b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, b->crlbFlagNames[fl].ptr, b->crlbFlagNames[fl].len);\n            b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, b->crlbFlagValues[fl].ptr, b->crlbFlagValues[fl].len);\n            fl++;\n        }\n        /* the module's override (opt/flags/exclude) changes codegen or the\n         * file set, so it must trigger a re-fingerprint too */\n        if (oi < b->overridesLen)\n        {\n            if (b->ovrOpts[oi].len > 0)\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, b->ovrOpts[oi].ptr, b->ovrOpts[oi].len);\n            u32 ofl = 0;\n            while (ofl < b->ovrFlagLens[oi])\n            {\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, b->ovrFlags[oi][ofl].ptr, b->ovrFlags[oi][ofl].len);\n                ofl++;\n            }\n            u32 oex = 0;\n            while (oex < b->ovrExcludeLens[oi])\n            {\n                b->mods[m].fingerprint = bFnv(b->mods[m].fingerprint, b->ovrExcludes[oi][oex].ptr, b->ovrExcludes[oi][oex].len);\n                oex++;\n            }\n        }\n        m++;\n    }\n    return true;\n}\n\n// DFS topo + cycle detect\nbool bDfs(Builder* b, u32 idx, u8* state, u32* stack, u32* stackLen, u32* out, u32* outLen)\n{\n    state[idx] = 1;\n    stack[*stackLen] = idx;\n    *stackLen += 1;\n    u32 d = 0;\n    while (d < b->mods[idx].depsLen)\n    {\n        u32 dep = b->mods[idx].deps[d];\n        if (state[dep] == 1)\n        {\n            if (!b->quiet)\n            {\n                printf(C\"E1006  dependency cycle\\n  cycle:  \");\n                u32 s = 0;\n                while (s < *stackLen)\n                {\n                    usize n = 0;\n                    u32 cIdx = stack[s];\n                    while (n < b->mods[cIdx].name.len) { printf(C\"%c\", b->mods[cIdx].name.ptr[n]); n++; }\n                    printf(C\" -> \");\n                    s++;\n                }\n                usize n = 0;\n                while (n < b->mods[dep].name.len) { printf(C\"%c\", b->mods[dep].name.ptr[n]); n++; }\n                printf(C\"\\n\");\n            }\n            b->errors++;\n            return false;\n        }\n        if (state[dep] == 0)\n        {\n            if (!bDfs(b, dep, state, stack, stackLen, out, outLen)) return false;\n        }\n        d++;\n    }\n    *stackLen -= 1;\n    state[idx] = 2;\n    out[*outLen] = idx;\n    *outLen += 1;\n    return true;\n}\n\nbool bTopo(Builder* b)\n{\n    u8* state = (u8*)b->arena->alloc((usize)b->modulesLen, 1);\n    u32* stack = (u32*)b->arena->alloc((usize)b->modulesLen * @sizeof(u32), 4);\n    u32* out = (u32*)b->arena->alloc((usize)b->modulesLen * @sizeof(u32), 4);\n    if (state == null || stack == null || out == null) return false;\n    u32 i = 0;\n    while (i < b->modulesLen) { state[i] = 0; i++; }\n    b->topoOrder = out;\n    b->topoLen = 0;\n    u32 stackLen = 0;\n    i = 0;\n    while (i < b->modulesLen)\n    {\n        if (state[i] == 0)\n        {\n            if (!bDfs(b, i, state, stack, &stackLen, out, &b->topoLen)) return false;\n        }\n        i++;\n    }\n    return true;\n}\n\npub bool bAddEdge(Builder* b, u32 from, u32 to)\n{\n    if (from >= b->modulesLen || to >= b->modulesLen) return false;\n    if (from == to) return true;\n    ModNode* node = b->mods + from;\n    u32 d = 0;\n    while (d < node->depsLen)\n    {\n        if (node->deps[d] == to) return true;\n        d++;\n    }\n    if (node->depsLen >= node->depsCap)\n    {\n        u32 newCap = 8;\n        if (node->depsCap != 0) newCap = node->depsCap * 2;\n        Arena* ar = b->arena;\n        u32* fresh = (u32*)ar->alloc((usize)newCap * @sizeof(u32), 4);\n        if (fresh == null) return false;\n        u32 d2 = 0;\n        while (d2 < node->depsLen)\n        {\n            fresh[d2] = node->deps[d2];\n            d2++;\n        }\n        node->deps = fresh;\n        node->depsCap = newCap;\n    }\n    node->deps[node->depsLen] = to;\n    node->depsLen++;\n    return true;\n}\n\n// load persisted edges: `.coral/graph` lines are `from -> to`, `#` comments\nbool bLoadGraph(Builder* b)\n{\n    usize len = 0;\n    Slice content = bReadFile(b->arena, \".coral/graph\", &len);\n    if (content.ptr == null) return true;\n    usize i = 0;\n    while (i < len)\n    {\n        usize lineStart = i;\n        while (i < len && content.ptr[i] != '\\n') i++;\n        usize lineEnd = i;\n        if (i < len) i++;\n        usize p = lineStart;\n        while (p < lineEnd && (content.ptr[p] == ' ' || content.ptr[p] == '\\t' || content.ptr[p] == '\\r')) p++;\n        if (p >= lineEnd) continue;\n        if (content.ptr[p] == '#') continue;\n        usize fromStart = p;\n        while (p < lineEnd && content.ptr[p] != ' ') p++;\n        Slice from = Slice::from(content.ptr + fromStart, p - fromStart);\n        while (p < lineEnd && content.ptr[p] == ' ') p++;\n        if (p + 1 >= lineEnd) continue;\n        if (content.ptr[p] != 45 || content.ptr[p + 1] != 62) continue;\n        p += 2;\n        while (p < lineEnd && content.ptr[p] == ' ') p++;\n        usize toStart = p;\n        while (p < lineEnd && content.ptr[p] != ' ' && content.ptr[p] != '\\r') p++;\n        Slice to = Slice::from(content.ptr + toStart, p - toStart);\n        if (from.len == 0 || to.len == 0) continue;\n        i32 fi = bModuleIdx(b, from);\n        i32 ti = bModuleIdx(b, to);\n        if (fi >= 0 && ti >= 0) bAddEdge(b, (u32)fi, (u32)ti);\n    }\n    return true;\n}\n\npub bool bWriteGraph(Builder* b)\n{\n    createDirRecursive(\".coral\", 493);\n    usize cap = 65536;\n    u8* buf = alloc<u8>(cap);\n    if (buf == null) return false;\n    usize len = 0;\n    str start = \"digraph coral {\\n  rankdir=BT;\\n\";\n    bApp(buf, cap, &len, start);\n    u32 m = 0;\n    while (m < b->modulesLen)\n    {\n        u32 d = 0;\n        while (d < b->mods[m].depsLen)\n        {\n            bApp(buf, cap, &len, \"  \\\"\");\n            bApp(buf, cap, &len, b->mods[m].name.asStr());\n            bApp(buf, cap, &len, \"\\\" -> \\\"\");\n            u32 dep = b->mods[m].deps[d];\n            bApp(buf, cap, &len, b->mods[dep].name.asStr());\n            bApp(buf, cap, &len, \"\\\";\\n\");\n            d++;\n        }\n        m++;\n    }\n    bApp(buf, cap, &len, \"}\\n\");\n    bool ok = bWriteFile(\".coral/graph.dot\", buf, len);\n    dealloc<u8>(buf);\n    if (!ok)\n    {\n        if (!b->quiet) printf(C\"E1000  cannot write .coral/graph.dot\\n\");\n        b->errors++;\n    }\n\n    usize cap2 = 65536;\n    u8* buf2 = alloc<u8>(cap2);\n    if (buf2 == null) return false;\n    usize len2 = 0;\n    str header2 = \"# coral module graph — `from -> to`, written by coralc\\n\";\n    bApp(buf2, cap2, &len2, header2);\n    u32 m2 = 0;\n    while (m2 < b->modulesLen)\n    {\n        u32 d2 = 0;\n        while (d2 < b->mods[m2].depsLen)\n        {\n            bApp(buf2, cap2, &len2, b->mods[m2].name.asStr());\n            bApp(buf2, cap2, &len2, \" -> \");\n            u32 dep2 = b->mods[m2].deps[d2];\n            bApp(buf2, cap2, &len2, b->mods[dep2].name.asStr());\n            bApp(buf2, cap2, &len2, \"\\n\");\n            d2++;\n        }\n        m2++;\n    }\n    bool ok2 = bWriteFile(\".coral/graph\", buf2, len2);\n    dealloc<u8>(buf2);\n    if (!ok2)\n    {\n        if (!b->quiet) printf(C\"E1000  cannot write .coral/graph\\n\");\n        b->errors++;\n    }\n    return ok && ok2;\n}\n\npub bool bWriteFp(Builder* b, u32 modIdx)\n{\n    createDirRecursive(\".coral\", 493);\n    createDirRecursive(\".coral/cache\", 493);\n    u8* pathC = alloc<u8>(512);\n    if (pathC == null) return false;\n    usize n = 0;\n    str pre = \".coral/cache/\";\n    while (n < pre.len) { pathC[n] = pre.ptr[n]; n++; }\n    usize i = 0;\n    while (i < b->mods[modIdx].name.len && n < 500) { pathC[n] = b->mods[modIdx].name.ptr[i]; n++; i++; }\n    str fp = \".fp\";\n    pathC[n] = fp.ptr[0]; pathC[n + 1] = fp.ptr[1]; pathC[n + 2] = fp.ptr[2]; pathC[n + 3] = 0;\n    u8* hex = alloc<u8>(17);\n    if (hex == null) { dealloc<u8>(pathC); return false; }\n    u64 v = b->mods[modIdx].fingerprint;\n    u32 s = 0;\n    while (s < 16)\n    {\n        u32 nib = (u32)((v >> ((u64)(15 - s) * 4)) & 15);\n        if (nib < 10) hex[s] = (u8)(48 + nib);\n        else hex[s] = (u8)(87 + nib);\n        s++;\n    }\n    hex[16] = 0;\n    bool ok = bWriteFile(str { .ptr = pathC, .len = n + 3 }, hex, 16);\n    dealloc<u8>(pathC);\n    dealloc<u8>(hex);\n    return ok;\n}\n\nbool bCheckFp(Builder* b, u32 modIdx)\n{\n    if (b->force) return true;\n    u8* pathC = alloc<u8>(512);\n    if (pathC == null) return true;\n    usize n = 0;\n    str pre = \".coral/cache/\";\n    while (n < pre.len) { pathC[n] = pre.ptr[n]; n++; }\n    usize i = 0;\n    while (i < b->mods[modIdx].name.len && n < 500) { pathC[n] = b->mods[modIdx].name.ptr[i]; n++; i++; }\n    str fp = \".fp\";\n    pathC[n] = fp.ptr[0]; pathC[n + 1] = fp.ptr[1]; pathC[n + 2] = fp.ptr[2]; pathC[n + 3] = 0;\n    usize len = 0;\n    Slice got = bReadFile(b->arena, str { .ptr = pathC, .len = n + 3 }, &len);\n    if (got.ptr == null || len < 16) { dealloc<u8>(pathC); return true; }\n    u8* hex = alloc<u8>(17);\n    if (hex == null) { dealloc<u8>(pathC); return true; }\n    u64 v = b->mods[modIdx].fingerprint;\n    u32 s = 0;\n    while (s < 16)\n    {\n        u32 nib = (u32)((v >> ((u64)(15 - s) * 4)) & 15);\n        if (nib < 10) hex[s] = (u8)(48 + nib);\n        else hex[s] = (u8)(87 + nib);\n        s++;\n    }\n    u32 c = 0;\n    while (c < 16)\n    {\n        if (got.ptr[c] != hex[c]) { dealloc<u8>(pathC); dealloc<u8>(hex); return true; }\n        c++;\n    }\n    dealloc<u8>(pathC);\n    dealloc<u8>(hex);\n    return false;\n}\n\npub i32 builderRunEx(CrlbNode* cfgRoot, Arena* a, bool forceIn, bool emitMapOnlyIn, bool dryRunIn, bool quietIn, Builder* out)\n{\n    Builder b;\n    if (!bInit(&b, a, cfgRoot, forceIn, emitMapOnlyIn, quietIn)) return (i32)b.errors;\n    b.dryRun = dryRunIn;\n\n    u32 m = 0;\n    while (m < b.modulesLen)\n    {\n        if (!bScanLib(&b, b.modules[m]))\n        {\n            m++;\n            continue;\n        }\n        m++;\n    }\n    if (b.errors > 0) return (i32)b.errors;\n\n    if (!bValidateAliases(&b)) return (i32)b.errors;\n    /* in-memory module table: surfaces + `pub mod` re-exports. The\n     * compiler's loader consumes this directly at compile time. */\n    if (!bBuildModuleTable(&b)) return (i32)b.errors;\n    if (!bResolveEntry(&b)) return (i32)b.errors;\n    // a dry run writes nothing: no modules.map, no graph, no cache\n    if (!dryRunIn && !bWriteMap(&b)) return (i32)b.errors;\n    if (emitMapOnlyIn)\n    {\n        if (!b.quiet)\n        {\n            if (dryRunIn) printf(C\"coral: module map (dry run): %d modules, %d aliases, not written\\n\", (i32)b.modulesLen, (i32)b.aliasesLen);\n            else printf(C\"coral: module map: %d modules, %d aliases -> .coral/modules.map\\n\", (i32)b.modulesLen, (i32)b.aliasesLen);\n        }\n        if (out != null) out[0] = b;\n        return (i32)b.errors;\n    }\n    /* always fingerprint — even under --force. the walk is ~35 ms, and\n     * the computed fps are persisted by bWriteAllFps after the build:\n     * skipping it under --force wrote FNV-basis fps to .coral/cache and\n     * made the NEXT non-force build spuriously all-stale (observed as a\n     * full rebuild after every forced build). --force still forces\n     * staleness — bCheckFp returns true whenever b.force is set. */\n    if (!bFingerprint(&b)) return (i32)b.errors;\n    if (!bLoadGraph(&b)) return (i32)b.errors;\n    if (!bTopo(&b)) return (i32)b.errors;\n    if (!dryRunIn && !bWriteGraph(&b)) return (i32)b.errors;\n\n    // staleness pass: fold dep fps into module fps (reverse topo = deps first)\n    u32 i = 0;\n    while (i < b.topoLen)\n    {\n        u32 idx = b.topoOrder[i];\n        u32 d = 0;\n        while (d < b.mods[idx].depsLen)\n        {\n            u32 dep = b.mods[idx].deps[d];\n            b.mods[idx].fingerprint = bFnv(b.mods[idx].fingerprint, (u8*)&b.mods[dep].fingerprint, 8);\n            d++;\n        }\n        b.mods[idx].stale = bCheckFp(&b, idx);\n        if (b.mods[idx].stale) b.anyStale = true;\n        i++;\n    }\n\n    if (!b.quiet)\n    {\n        /* one line, only what the reader acts on: how big the program is,\n         * how much of it will be rebuilt, and why (--force / dry run).\n         * The module order itself lives in .coral/modules.map for tools. */\n        u32 staleCount = 0;\n        if (forceIn) staleCount = b.modulesLen;\n        else\n        {\n            i = 0;\n            while (i < b.topoLen)\n            {\n                if (b.mods[b.topoOrder[i]].stale) staleCount++;\n                i++;\n            }\n        }\n        if (dryRunIn)\n            printf(C\"coral: build plan (dry run): %d modules, %d aliases, %d stale, .coral/modules.map not written\\n\",\n                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);\n        else if (forceIn)\n            printf(C\"coral: build plan: %d modules, %d aliases, %d stale (--force)\\n\",\n                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);\n        else\n            printf(C\"coral: build plan: %d modules, %d aliases, %d stale\\n\",\n                   (i32)b.modulesLen, (i32)b.aliasesLen, (i32)staleCount);\n\n        if (!dryRunIn)\n        {\n            i = 0;\n            while (i < b.topoLen)\n            {\n                u32 idx = b.topoOrder[i];\n                if (b.mods[idx].stale) printf(C\"   Compiling %.*s\\n\", (i32)b.mods[idx].name.len, b.mods[idx].name.ptr);\n                i++;\n            }\n        }\n    }\n\n    /* the compile phase runs in coralc.crl via compileUnitTo with this\n     * builder's module table; discovery/staleness ends builderRunEx. */\n    if (out != null) *out = b;\n    return (i32)b.errors;\n}\n\n// signature kept for `coralc map`; forwards with dryRunIn = false\npub i32 builderRun(CrlbNode* cfgRoot, Arena* a, bool forceIn, bool emitMapOnlyIn, Builder* out)\n{\n    return builderRunEx(cfgRoot, a, forceIn, emitMapOnlyIn, false, false, out);\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-build/parser.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\nuse lexer { CrlbLexer, mkSlice };\nuse token { CrlbToken, CrlbTokenKind };\nuse ast { CrlbNode, CrlbNodeKind, Value, ValueArray, nodeKindName, valueArrayPush };\nuse arena { Arena };\nuse common::slice { Slice };\nimport core::cchar { cchar };\nimport platform::libc { printf };\n\n// recursive-descent parser for the .crlb build-file grammar (build_sys.md)\npub struct CrlbParser\n{\n    CrlbLexer* lx;\n    CrlbToken prev;\n    CrlbToken cur;\n    CrlbToken next;\n    Arena* arena;\n    u32 errors;\n    /* suppress parse-error prints (LSP serves JSON on stdout) */\n    bool quiet;\n\n    void init(Arena* a, Slice src)\n    {\n        self.arena = a;\n        self.errors = 0;\n        self.quiet = false;\n        self.lx = (CrlbLexer*)self.arena->alloc(@sizeof(CrlbLexer), 8);\n        if (self.lx == null) return;\n        self.lx->init(src);\n        self.cur = self.lx->next();\n        self.prev = self.cur;\n        self.next = self.lx->next();\n    }\n\n    void advance()\n    {\n        self.prev = self.cur;\n        self.cur = self.next;\n        self.next = self.lx->next();\n    }\n\n    bool check(CrlbTokenKind k) { return self.cur.kind == k; }\n    bool checkNext(CrlbTokenKind k) { return self.next.kind == k; }\n\n    bool match(CrlbTokenKind k)\n    {\n        if (self.cur.kind != k) return false;\n        self.advance();\n        return true;\n    }\n\n    void errorAt(CrlbToken t, str msg)\n    {\n        self.errors++;\n        if (!self.quiet) printf(C\"%llu:%llu: parse error: %.*s\\n\", t.line, t.col, (i32)msg.len, msg.ptr);\n    }\n\n    void expect(CrlbTokenKind k, str msg)\n    {\n        if (self.cur.kind != k)\n        {\n            self.errorAt(self.cur, msg);\n            return;\n        }\n        self.advance();\n    }\n\n    bool isWord(CrlbToken t, str cstr)\n    {\n        if (t.kind != CrlbTokenKind::Ident) return false;\n        Slice s = t.text;\n        return s.eq(Slice::fromStr(cstr));\n    }\n\n    bool curIsWord(str cstr)\n    {\n        return self.isWord(self.cur, cstr);\n    }\n\n    // values\n\n    Value parseValue()\n    {\n        switch (self.cur.kind)\n        {\n            CrlbTokenKind::String => {\n                Value v = Value::String { .value = self.cur.text };\n                self.advance();\n                return v;\n            },\n            CrlbTokenKind::Number => {\n                Value v = Value::Number { .value = self.cur.numValue };\n                self.advance();\n                return v;\n            },\n            CrlbTokenKind::Bool => {\n                Value v = Value::Boolean { .value = self.cur.boolValue };\n                self.advance();\n                return v;\n            },\n            CrlbTokenKind::LBracket => {\n                self.advance();\n                ValueArray* arr = (ValueArray*)self.arena->alloc(@sizeof(ValueArray), 8);\n                if (arr != null)\n                {\n                    arr->data = null;\n                    arr->len = 0;\n                    arr->cap = 0;\n                    arr->arena = self.arena;\n                }\n                while (!self.check(CrlbTokenKind::RBracket) && !self.check(CrlbTokenKind::Eof))\n                {\n                    Value item = self.parseValue();\n                    if (arr != null) valueArrayPush(arr, item);\n                    if (!self.match(CrlbTokenKind::Comma)) break;\n                }\n                self.expect(CrlbTokenKind::RBracket, \"expected ] to close list\");\n                Value v = Value::List { .value = arr };\n                return v;\n            },\n            else => {\n                self.errorAt(self.cur, \"expected value\");\n                self.advance();\n                Value v = Value::Number { .value = 0 };\n                return v;\n            }\n        }\n    }\n\n    // children\n\n    bool childKind(Slice name, CrlbNodeKind* out)\n    {\n        if (name.eq(Slice::fromStr(\"override\"))) { *out = CrlbNodeKind::Override; return true; }\n        if (name.eq(Slice::fromStr(\"target\"))) { *out = CrlbNodeKind::Target; return true; }\n        if (name.eq(Slice::fromStr(\"link\"))) { *out = CrlbNodeKind::Link; return true; }\n        if (name.eq(Slice::fromStr(\"artifact\"))) { *out = CrlbNodeKind::Artifact; return true; }\n        if (name.eq(Slice::fromStr(\"features\"))) { *out = CrlbNodeKind::Features; return true; }\n        if (name.eq(Slice::fromStr(\"env\"))) { *out = CrlbNodeKind::Env; return true; }\n        if (name.eq(Slice::fromStr(\"log\"))) { *out = CrlbNodeKind::Log; return true; }\n        if (name.eq(Slice::fromStr(\"metrics\"))) { *out = CrlbNodeKind::Metrics; return true; }\n        if (name.eq(Slice::fromStr(\"test\"))) { *out = CrlbNodeKind::Test; return true; }\n        if (name.eq(Slice::fromStr(\"bench\"))) { *out = CrlbNodeKind::Bench; return true; }\n        if (name.eq(Slice::fromStr(\"hook\"))) { *out = CrlbNodeKind::Hook; return true; }\n        if (name.eq(Slice::fromStr(\"phase\"))) { *out = CrlbNodeKind::Phase; return true; }\n        if (name.eq(Slice::fromStr(\"task\"))) { *out = CrlbNodeKind::Task; return true; }\n        if (name.eq(Slice::fromStr(\"profile\"))) { *out = CrlbNodeKind::Profile; return true; }\n        if (name.eq(Slice::fromStr(\"workspace\"))) { *out = CrlbNodeKind::Workspace; return true; }\n        if (name.eq(Slice::fromStr(\"deps\"))) { *out = CrlbNodeKind::Deps; return true; }\n        if (name.eq(Slice::fromStr(\"remote\"))) { *out = CrlbNodeKind::Remote; return true; }\n        if (name.eq(Slice::fromStr(\"ci\"))) { *out = CrlbNodeKind::Ci; return true; }\n        if (name.eq(Slice::fromStr(\"lint\"))) { *out = CrlbNodeKind::Lint; return true; }\n        if (name.eq(Slice::fromStr(\"format\"))) { *out = CrlbNodeKind::Format