t.name)) return false;\n                Symbol* symbol = self.lookupAt(expr->kind.payload.Ident.name, id);\n                if (symbol != null)\n                {\n                    /* a bare type name is a comptime type value inside a\n                     * comptime block (`@typeof(x) == i32`); anywhere else\n                     * it is not a runtime value (`twoNum.new(...)`). */\n                    if (symbol->kind == 3)\n                    {\n                        if (self.comptimeDepth > 0)\n                        {\n                            self.setExprType(id, self.u64Type());\n                            return true;\n                        }\n                        String msg = String::new();\n                        msg.pushView(\"type '\");\n                        msg.pushView(self.nameTextView(symbol->name));\n                        msg.pushView(\"' is not a value\");\n                        self.semaErrorNodeHelp(ErrorCode::SemaTypeMismatch, id, msg.asView(),\n                            \"use `Type::method(...)` for an associated function, or an instance for a method call\");\n                        return false;\n                    }\n                    self.setExprType(id, symbol->typeNode);\n                }\n                return true;\n            },\n            ExprKind::TypeRef => {\n                if (expr->kind.payload.TypeRef.name != 0)\n                {\n                    if (!self.checkIdent(id, expr->kind.payload.TypeRef.name)) return false;\n                    /* `pick<self>(…)`: a type argument spelled `self` means the\n                     * receiver type, so resolve it before validation and before\n                     * the call binds generic params */\n                    if (self.currentSelfType != 0)\n                        expr->kind.payload.TypeRef.typeNode =\n                            self.resolveSelfTy(expr->kind.payload.TypeRef.typeNode, self.currentSelfType);\n                    if (!self.checkType(expr->kind.payload.TypeRef.typeNode)) return false;\n                    self.setExprType(id, expr->kind.payload.TypeRef.typeNode);\n                    return true;\n                }\n                /* primitive type keyword in expression position: a type\n                 * value, only meaningful in a comptime block */\n                if (!self.checkType(expr->kind.payload.TypeRef.typeNode)) return false;\n                if (self.comptimeDepth == 0)\n                {\n                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id,\n                        \"a type is not a runtime value\");\n                    return false;\n                }\n                self.setExprType(id, self.u64Type());\n                return true;\n            },\n            ExprKind::Path => { return self.checkPath(id); },\n            ExprKind::Call => {\n                if (!self.checkExpr(expr->kind.payload.Call.callee)) return false;\n                u32 i = 0;\n                while (i < expr->kind.payload.Call.argsLen)\n                {\n                    if (!self.checkExpr(expr->kind.payload.Call.args[i])) return false;\n                    i++;\n                }\n                Node* calleeNode = self.ctx->nodes + expr->kind.payload.Call.callee.index;\n                if (calleeNode->kind.tag == NodeKind::Expr &&\n                    calleeNode->kind.payload.Expr.value.kind.tag == ExprKind::Path &&\n                    calleeNode->kind.payload.Expr.value.kind.payload.Path.segmentsLen >= 2)\n                {\n                    NodeId* segs = calleeNode->kind.payload.Expr.value.kind.payload.Path.segments;\n                    Node* s0n = self.ctx->nodes + segs[0].index;\n                    Node* s1n = self.ctx->nodes + segs[1].index;\n                    if (s0n->kind.tag == NodeKind::Expr &&\n                        s0n->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef &&\n                        s1n->kind.tag == NodeKind::Expr &&\n                        s1n->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                    {\n                        /* static method on an instantiated generic type:\n                         * `Foo<i32>::new(3)`: the head segment is a TypeRef,\n                         * not an Ident, so the ident/module branch below never\n                         * matches. Resolve the static member on that type and\n                         * substitute the method's generic params through it. */\n                        Str mn = s1n->kind.payload.Expr.value.kind.payload.Ident.name;\n                        Ty ownerTy = s0n->kind.payload.Expr.value.kind.payload.TypeRef.typeNode;\n                        MemberInfo m = self.findMethod(ownerTy, mn);\n                        if (m.declaration.index == 0)\n                        {\n                            u8* mbuf = alloc<u8>(128);\n                            String msg = String::new();\n                            msg.pushView(\"static method '\");\n                            msg.pushView(self.nameTextView(mn));\n                            msg.pushView(\"' not found on type '\");\n                            if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView(\"?\");\n                            msg.pushView(\"'\");\n                            self.semaErrorNode(ErrorCode::SemaUnknownMember, id, msg.asView());\n                            dealloc<u8>(mbuf);\n                            return false;\n                        }\n                        Node* methodNode = self.ctx->nodes + m.declaration.index;\n                        Decl* md = &methodNode->kind.payload.Decl.value;\n                        if ((md->kind.payload.Func.flags & 4) == 0)\n                        {\n                            u8* mbuf = alloc<u8>(128);\n                            String msg = String::new();\n                            msg.pushView(\"method '\");\n                            msg.pushView(self.nameTextView(mn));\n                            msg.pushView(\"' on type '\");\n                            if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView(\"?\");\n                            msg.pushView(\"' is not static; it needs a receiver\");\n                            self.semaErrorNode(ErrorCode::SemaNeedsReceiver, id, msg.asView());\n                            dealloc<u8>(mbuf);\n                            return false;\n                        }\n                        u32 pLen = md->kind.payload.Func.paramsLen;\n                        if (pLen != expr->kind.payload.Call.argsLen)\n                        {\n                            String msg = String::new();\n                            msg.pushView(\"wrong number of arguments to static method '\");\n                            msg.pushView(self.nameTextView(md->kind.payload.Func.name));\n                            msg.pushView(\"': expected \");\n                            self.pushDec(&msg, (u64)pLen);\n                            msg.pushView(\", got \");\n                            self.pushDec(&msg, (u64)expr->kind.payload.Call.argsLen);\n                            self.semaErrorNode(ErrorCode::SemaArityMismatch, id, msg.asView());\n                            return false;\n                        }\n                        u32 kk = 0;\n                        while (kk < pLen)\n                        {\n                            NodeId ppid = md->kind.payload.Func.params[kk];\n                            Node* pn = self.ctx->nodes + ppid.index;\n                            if (pn->kind.tag == NodeKind::Param)\n                            {\n                                Param* pp = &pn->kind.payload.Param.value;\n                                Ty want = self.substituteFieldTy(pp->typeNode, ownerTy);\n                                if (!self.assignCompatible(expr->kind.payload.Call.args[kk], self.exprType(expr->kind.payload.Call.args[kk]), want))\n                                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, self.typeMismatchMsg(\"static method argument\", self.exprType(expr->kind.payload.Call.args[kk]), want));\n                            }\n                            kk++;\n                        }\n                        self.setExprType(id, self.substituteFieldTy(md->kind.payload.Func.returnType, ownerTy));\n                        return true;\n                    }\n                    if (s0n->kind.tag == NodeKind::Expr && s0n->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&\n                        s1n->kind.tag == NodeKind::Expr && s1n->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                    {\n                        Str tn = s0n->kind.payload.Expr.value.kind.payload.Ident.name;\n                        Str mn = s1n->kind.payload.Expr.value.kind.payload.Ident.name;\n                        /* module root: math::sqrt(a), a free function in the\n                         * module's namespace, not a static method on a type */\n                        Symbol* rootSym = self.lookupAt(tn, id);\n                        if (rootSym != null && rootSym->kind == 5)\n                        {\n                            Str reexportPath = 0;\n                            if (rootSym->declaration.index != 0)\n                            {\n                                Node* modNode = self.ctx->nodes + rootSym->declaration.index;\n                                if (modNode->kind.tag == NodeKind::Decl)\n                                {\n                                    Decl* rootDecl = &modNode->kind.payload.Decl.value;\n                                    if (rootDecl->kind.tag == DeclKind::ModReexport)\n                                        reexportPath = rootDecl->kind.payload.ModReexport.path;\n                                    if (!self.moduleExportsContain(rootDecl, mn))\n                                    {\n                                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, \"symbol not exported by module\");\n                                        return false;\n                                    }\n                                    if (!self.moduleMemberIsPub(modNode, mn))\n                                    {\n                                        self.semaErrorNode(ErrorCode::SemaUnknownMember, id, \"symbol not exported by module\");\n                                        return false;\n                                    }\n                                }\n                            }\n                            /* nested module path `platform::libc::malloc`: the\n                             * function is the LAST segment, not s1 (a module) */\n                            Str fname = mn;\n                            u32 segCount = calleeNode->kind.payload.Expr.value.kind.payload.Path.segmentsLen;\n                            if (segCount >= 3)\n                            {\n                                Symbol* s1Sym = self.lookupAt(mn, id);\n                                Node* s2n = self.ctx->nodes + segs[2].index;\n                                if (s1Sym != null && s1Sym->kind == 5 &&\n                                    s2n->kind.tag == NodeKind::Expr &&\n                                    s2n->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                                {\n                                    fname = s2n->kind.payload.Expr.value.kind.payload.Ident.name;\n                                }\n                            }\n                            /* resolve the callee in the MODULE's file, not\n                             * the local scope; `fios::fileOpen` must not\n                             * pick up this file's own `fileOpen`. A\n                             * `pub mod alias = import path` re-export\n                             * resolves through the target path, not the\n                             * alias the caller wrote. */\n                            Symbol* fsym = null;\n                            Str modPath = reexportPath;\n                            if (modPath == 0) modPath = self.modulePathPrefix(segs, segCount);\n                            if (modPath != 0)\n                            {\n                                Symbol** cands = alloc<Symbol*>(16);\n                                if (cands != null)\n                                {\n                                    u32 n = self.scopes->lookupAll(fname, cands, 16);\n                                    u32 m = 0;\n                                    while (m < n)\n                                    {\n                                        if (self.importPathInFile(modPath, cands[m]->fileId)) { fsym = cands[m]; break; }\n                                        m++;\n                                    }\n                                    dealloc<Symbol*>(cands);\n                                }\n                            }\n                            if (fsym == null) fsym = self.lookupAt(fname, id);\n                            if (fsym == null) return self.checkCall(id, fname, expr->kind.payload.Call.args, expr->kind.payload.Call.argsLen, 0);\n                            return self.checkCallResolved(id, fsym, expr->kind.payload.Call.args, expr->kind.payload.Call.argsLen, 0);\n                        }\n                        Ty ownerTy = self.namedType(tn);\n                        MemberInfo m = self.findMethod(ownerTy, mn);\n                        if (m.declaration.index == 0)\n                        {\n                            u8* mbuf = alloc<u8>(128);\n                            String msg = String::new();\n                            msg.pushView(\"static method '\");\n                            msg.pushView(self.nameTextView(mn));\n                            msg.pushView(\"' not found on type '\");\n                            if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView(\"?\");\n                            msg.pushView(\"'\");\n                            self.semaErrorNode(ErrorCode::SemaUnknownMember, id, msg.asView());\n                            dealloc<u8>(mbuf);\n                            return false;\n                        }\n                        Node* methodNode = self.ctx->nodes + m.declaration.index;\n                        Decl* md = &methodNode->kind.payload.Decl.value;\n                        if ((md->kind.payload.Func.flags & 4) == 0)\n                        {\n                            u8* mbuf = alloc<u8>(128);\n                            String msg = String::new();\n                            msg.pushView(\"method '\");\n                            msg.pushView(self.nameTextView(mn));\n                            msg.pushView(\"' on type '\");\n                            if (mbuf != null) msg.pushView(self.typeTextView(ownerTy, mbuf, 128)); else msg.pushView(\"?\");\n                            msg.pushView(\"' is not static; it needs a receiver\");\n                            self.semaErrorNode(ErrorCode::SemaNeedsReceiver, id, msg.asView());\n                            dealloc<u8>(mbuf);\n                            return false;\n                        }\n                        u32 pLen = md->kind.payload.Func.paramsLen;\n                        if (pLen != expr->kind.payload.Call.argsLen)\n                        {\n                            String msg = String::new();\n                            msg.pushView(\"wrong number of arguments to static method '\");\n                            msg.pushView(self.nameTextView(md->kind.payload.Func.name));\n                            msg.pushView(\"': expected \");\n                            self.pushDec(&msg, (u64)pLen);\n                            msg.pushView(\", got \");\n                            self.pushDec(&msg, (u64)expr->kind.payload.Call.argsLen);\n                            self.semaErrorNode(ErrorCode::SemaArityMismatch, id, msg.asView());\n                            return false;\n                        }\n                        u32 jj = 0;\n                        while (jj < pLen)\n                        {\n                            NodeId ppid = md->kind.payload.Func.params[jj];\n                            Node* pn = self.ctx->nodes + ppid.index;\n                            if (pn->kind.tag == NodeKind::Param)\n                            {\n                                Param* pp = &pn->kind.payload.Param.value;\n                                if (!self.assignCompatible(expr->kind.payload.Call.args[jj], self.exprType(expr->kind.payload.Call.args[jj]), pp->typeNode))\n                                {\n                                    u8* mbuf = alloc<u8>(128);\n                                    String msg = String::new();\n                                    msg.pushView(\"type mismatch in argument \");\n                                    self.pushDec(&msg, (u64)(jj + 1));\n                                    msg.pushView(\" of static call to '\");\n                                    msg.pushView(self.nameTextView(md->kind.payload.Func.name));\n                                    msg.pushView(\"': expected '\");\n                                    if (mbuf != null) msg.pushView(self.typeTextView(pp->typeNode, mbuf, 128)); else msg.pushView(\"?\");\n                                    msg.pushView(\"'\");\n                                    self.semaErrorNode(ErrorCode::SemaTypeMismatch, id, msg.asView());\n                                    dealloc<u8>(mbuf);\n                                }\n                            }\n                            jj++;\n                        }\n                        self.setExprType(id, md->kind.payload.Func.returnType);\n                        return true;\n                    }\n                }\n                if (calleeNode->kind.tag == NodeKind::Expr)\n   