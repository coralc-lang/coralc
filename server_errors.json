              stP(&cg->body, \" : \");\n                    u32 oi = 0;\n                    while (oi < s->kind.payload.Asm.outputsLen)\n                    {\n                        if (oi > 0) stP(&cg->body, \", \");\n                        Node* cn = cgNode(cg, s->kind.payload.Asm.outputs[oi]);\n                        if (cn->kind.tag == NodeKind::Expr && cn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)\n                        {\n                            Slice cs = cgUnquote(cg, cgIntern(cg, cn->kind.payload.Expr.value.kind.payload.StringLit.value));\n                            stCh(&cg->body, '\"');\n                            stPut(&cg->body, cs.ptr, cs.len);\n                            stCh(&cg->body, '\"');\n                        }\n                        else cgError(cg, \"asm operand constraint must be a string literal\");\n                        if (oi + 1 < s->kind.payload.Asm.outputsLen)\n                        {\n                            stCh(&cg->body, '(');\n                            stPS(&cg->body, cgExpr(cg, s->kind.payload.Asm.outputs[oi + 1]));\n                            stCh(&cg->body, ')');\n                            oi++;\n                        }\n                        oi++;\n                    }\n                }\n                if (needIn)\n                {\n                    stP(&cg->body, \" : \");\n                    u32 ii = 0;\n                    while (ii < s->kind.payload.Asm.inputsLen)\n                    {\n                        if (ii > 0) stP(&cg->body, \", \");\n                        Node* cn = cgNode(cg, s->kind.payload.Asm.inputs[ii]);\n                        if (cn->kind.tag == NodeKind::Expr && cn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)\n                        {\n                            Slice cs = cgUnquote(cg, cgIntern(cg, cn->kind.payload.Expr.value.kind.payload.StringLit.value));\n                            stCh(&cg->body, '\"');\n                            stPut(&cg->body, cs.ptr, cs.len);\n                            stCh(&cg->body, '\"');\n                        }\n                        else cgError(cg, \"asm operand constraint must be a string literal\");\n                        if (ii + 1 < s->kind.payload.Asm.inputsLen)\n                        {\n                            stCh(&cg->body, '(');\n                            stPS(&cg->body, cgExpr(cg, s->kind.payload.Asm.inputs[ii + 1]));\n                            stCh(&cg->body, ')');\n                            ii++;\n                        }\n                        ii++;\n                    }\n                }\n                if (s->kind.payload.Asm.clobbersLen > 0)\n                {\n                    stP(&cg->body, \" : \");\n                    u32 ci = 0;\n                    while (ci < s->kind.payload.Asm.clobbersLen)\n                    {\n                        if (ci > 0) stP(&cg->body, \", \");\n                        Node* cbn = cgNode(cg, s->kind.payload.Asm.clobbers[ci]);\n                        if (cbn->kind.tag == NodeKind::Expr && cbn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit)\n                        {\n                            Slice cs = cgUnquote(cg, cgIntern(cg, cbn->kind.payload.Expr.value.kind.payload.StringLit.value));\n                            stCh(&cg->body, '\"');\n                            stPut(&cg->body, cs.ptr, cs.len);\n                            stCh(&cg->body, '\"');\n                        }\n                        else cgError(cg, \"asm clobber must be a string literal\");\n                        ci++;\n                    }\n                }\n            }\n            stP(&cg->body, \");\");\n            return;\n        },\n\n        else => {\n            cgError(cg, \"unsupported statement kind\");\n            return;\n        },\n    }\n}\n\n/* ── declarations: prototypes, types, bodies ──────────────────── */\n\nbool cgDeclIsGeneric(Codegen* cg, NodeId declId)\n{\n    if (cg->mono == null) return false;\n    return cg->mono->genericCount(declId) != 0;\n}\n\n// does a type mention a generic parameter (skip such extends)?\nbool cgTyHasParam(Codegen* cg, Ty t)\n{\n    if (t == 0) return false;\n    TypeEntry* e = cg->ctx->types + t;\n    switch (e->kind.tag)\n    {\n        TypeKind::TypeParam => { return true; },\n        TypeKind::Pointer => { return cgTyHasParam(cg, e->kind.payload.Pointer.base); },\n        TypeKind::Const => { return cgTyHasParam(cg, e->kind.payload.Const.base); },\n        TypeKind::Comptime => { return cgTyHasParam(cg, e->kind.payload.Comptime.base); },\n        TypeKind::Slice => { return cgTyHasParam(cg, e->kind.payload.Slice.base); },\n        TypeKind::Array => {\n            return cgTyHasParam(cg, e->kind.payload.Array.base) ||\n                   e->kind.payload.Array.sizeParam != 4294967295;\n        },\n        TypeKind::Named => {\n            u32 i = 0;\n            while (i < e->kind.payload.Named.genericArgsLen) {\n                Ty arg = e->kind.payload.Named.genericArgs[i];\n                TypeEntry* ae = cg->ctx->types + arg;\n                /* a bare name used as a generic argument (`Option<T>`)\n                 * is a parameter reference */\n                if (ae->kind.tag == TypeKind::Named && ae->kind.payload.Named.genericArgsLen == 0)\n                    return true;\n                if (cgTyHasParam(cg, arg)) return true;\n                i++;\n            }\n            return false;\n        },\n        else => { return false; },\n    }\n    return false;\n}\n\n// parameter list → stream (comptime/type-level params are erased)\nvoid cgEmitParams(Codegen* cg, Stream* s, Decl* dd, Ty* paramTys, Slice owner, MonoInstance* inst)\n{\n    bool hadOne = false;\n    /* methods without an explicit `self` still take the receiver as their\n     * first parameter: sema declares an implicit `self` for them */\n    bool explicitSelf = false;\n    if (dd->kind.payload.Func.paramsLen > 0)\n    {\n        Node* p0n = cgNode(cg, dd->kind.payload.Func.params[0]);\n        if (p0n->kind.tag == NodeKind::Param && (p0n->kind.payload.Param.value.flags & 1) != 0) explicitSelf = true;\n    }\n    if (owner.len != 0 && !explicitSelf && (dd->kind.payload.Func.flags & 4) == 0)\n    {\n        stPS(s, owner);\n        stP(s, \"* self\");\n        hadOne = true;\n    }\n    u32 i = 0;\n    while (i < dd->kind.payload.Func.paramsLen)\n    {\n        Node* pn = cgNode(cg, dd->kind.payload.Func.params[i]);\n        if (pn->kind.tag == NodeKind::Param)\n        {\n            Param* p = &pn->kind.payload.Param.value;\n            if ((p->flags & 8) != 0) { i++; continue; }\n            if ((p->flags & 16) != 0)\n            {\n                /* a value-specialized instance whose comptime body\n                 * consumed runtime tail args names them explicitly\n                 * (`_varg0`, …) so the emitted body's references resolve;\n                 * call sites pass the args positionally either way */\n                if (inst != null && inst->tailLen > 0 && inst->tailArgNames != null)\n                {\n                    u32 k = 0;\n                    while (k < inst->tailLen)\n                    {\n                        if (hadOne) stP(s, \", \");\n                        Ty ttk = cgSubstTy(cg, inst->tailTypes[k]);\n                        if (ttk != 0 && (cg->ctx->types + ttk)->kind.tag == TypeKind::Array)\n                        {\n                            // an array parameter decays: `int32_t name[]`\n                            TypeEntry* tek = cg->ctx->types + ttk;\n                            stPS(s, tyStr(cg, tek->kind.payload.Array.base));\n                            stCh(s, ' ');\n                            stPS(s, cgIdent(cg, inst->tailArgNames[k]));\n                            stP(s, \"[]\");\n                        }\n                        else\n                        {\n                            stPS(s, tyStr(cg, ttk));\n                            stCh(s, ' ');\n                            stPS(s, cgIdent(cg, inst->tailArgNames[k]));\n                        }\n                        hadOne = true;\n                        k++;\n                    }\n                }\n                else\n                {\n                    if (hadOne) stP(s, \", \");\n                    stP(s, \"...\");\n                    hadOne = true;\n                }\n                i++;\n                continue;\n            }\n            if (hadOne) stP(s, \", \");\n            hadOne = true;\n            if ((p->flags & 1) != 0)\n            {\n                if (owner.len == 0) {\n                    cgError(cg, \"explicit self with unknown owner\");\n                    stP(s, \"rawptr* self\");\n                } else {\n                    stPS(s, owner);\n                    stP(s, \"* self\");\n                }\n            }\n            else\n            {\n                Ty pt = p->typeNode;\n                if (paramTys != null) pt = paramTys[i];\n                /* array params decay to pointers: `T name[]` */\n                if (pt != 0 && (cg->ctx->types + pt)->kind.tag == TypeKind::Array)\n                {\n                    TypeEntry* te = cg->ctx->types + pt;\n                    stPS(s, tyStr(cg, te->kind.payload.Array.base));\n                    stCh(s, ' ');\n                    if (p->name != 0) stPS(s, cgIdent(cg, p->name));\n                    else { stP(s, \"_p\"); stU64(s, (u64)i); }\n                    stP(s, \"[]\");\n                }\n                else\n                {\n                    stPS(s, tyStr(cg, pt));\n                    stCh(s, ' ');\n                    if (p->name != 0) stPS(s, cgIdent(cg, p->name));\n                    else { stP(s, \"_p\"); stU64(s, (u64)i); }\n                }\n            }\n        }\n        i++;\n    }\n    if (!hadOne) stP(s, \"void\");\n}\n\n/* `#[[inline]]` / `#[[inline_always]]` on the source decl: generic\n * instances share the decl node, so the qualifier is uniform across\n * them. `extern inline` keeps an out-of-line body in the object file so\n * an un-inlined call still links */\nu8 cgInlineKind(Codegen* cg, Decl* dd)\n{\n    if ((dd->attrBits & ATTR_INLINE_ALWAYS) != 0) return 2;\n    if ((dd->attrBits & ATTR_INLINE) != 0) return 1;\n    return 0;\n}\n\nvoid cgEmitProto(Codegen* cg, NodeId declId, Slice cname, Ty retTy, Ty* paramTys, MonoSubstitution* subs, u32 subsLen, Slice owner, MonoInstance* inst)\n{\n    Node* ddn = cgNode(cg, declId);\n    Decl* dd = &ddn->kind.payload.Decl.value;\n    MonoSubstitution* oldSubs = cg->subs;\n    u32 oldSubsLen = cg->subsLen;\n    cg->subs = subs;\n    cg->subsLen = subsLen;\n\n    stNL(&cg->protos, 0);\n    stPS(&cg->protos, tyStr(cg, retTy));\n    stCh(&cg->protos, ' ');\n    stPS(&cg->protos, cname);\n    stCh(&cg->protos, '(');\n    cgEmitParams(cg, &cg->protos, dd, paramTys, owner, inst);\n    stP(&cg->protos, \");\");\n\n    cg->subs = oldSubs;\n    cg->subsLen = oldSubsLen;\n}\n\n/* the monomorphised instance's rewritten body for this decl + subs:\n * comptime blocks were already evaluated into it; 0 when there is no\n * matching instance (callers fall back to the declaration's body) */\nNodeId cgInstanceBody(Codegen* cg, NodeId declId, MonoSubstitution* subs, u32 subsLen, u64 valueKey)\n{\n    if (cg->mono == null) return NodeId{ .index = 0 };\n    u32 k = 0;\n    while (k < cg->mono->instancesLen)\n    {\n        MonoInstance* inst = cg->mono->instances + k;\n        if (inst->kind == MonoInstanceKind::FunctionInstance &&\n            inst->declaration.index == declId.index &&\n            inst->substitutionsLen == subsLen &&\n            inst->valueKey == valueKey &&\n            inst->body.index != 0)\n        {\n            bool same = true;\n            u32 j = 0;\n            while (j < subsLen)\n            {\n                if (subs[j].parameter != inst->substitutions[j].parameter ||\n                    subs[j].typeNode != inst->substitutions[j].typeNode)\n                {\n                    same = false;\n                    break;\n                }\n                j++;\n            }\n            if (same) return inst->body;\n        }\n        k++;\n    }\n    return NodeId{ .index = 0 };\n}\n\nvoid cgEmitFuncCommon(Codegen* cg, NodeId declId, Slice cname, Ty retTy, Ty* paramTys, MonoSubstitution* subs, u32 subsLen, Slice owner, u8 isStatic, MonoInstance* inst)\n{\n    u64 valueKey = 0;\n    if (inst != null) valueKey = inst->valueKey;\n    Node* ddn = cgNode(cg, declId);\n    Decl* dd = &ddn->kind.payload.Decl.value;\n\n    MonoSubstitution* oldSubs = cg->subs;\n    u32 oldSubsLen = cg->subsLen;\n    cg->subs = subs;\n    cg->subsLen = subsLen;\n\n    // body first: it allocates temps whose declarations go at fn top\n    usize bodyStart = cg->body.len;\n    cg->tempsLen = 0;\n    cg->loopDepth = 0;\n    cg->breakDepth = 0;\n    cg->dropsLen = 0;\n    cg->fnDropMark = 0;\n    cg->ind = 1;\n    /* bound names: fresh set per function; params and `self` are\n     * locals (Ident refs to them stay raw) */\n    cg->localNamesLen = 0;\n    if (owner.len != 0) cgAddLocal(cg, cg->ctx->intern(\"self\"));\n    {\n        u32 pi = 0;\n        while (pi < dd->kind.payload.Func.paramsLen)\n        {\n            Node* pn = cgNode(cg, dd->kind.payload.Func.params[pi]);\n            if (pn->kind.tag == NodeKind::Param)\n            {\n                Param* p = &pn->kind.payload.Param.value;\n                cgAddLocal(cg, p->name);\n            }\n            pi++;\n        }\n    }\n    /* the instance's synthesized tail parameters are locals too: the\n     * emitted body references them by name (`_varg0`, …) */\n    if (inst != null && inst->tailLen > 0 && inst->tailArgNames != null)\n    {\n        u32 tk = 0;\n        while (tk < inst->tailLen)\n        {\n            cgAddLocal(cg, inst->tailArgNames[tk]);\n            tk++;\n        }\n    }\n    NodeId bodyId = dd->kind.payload.Func.body;\n    NodeId instBody = cgInstanceBody(cg, declId, subs, subsLen, valueKey);\n    if (instBody.index != 0) bodyId = instBody;\n    Node* bn = cgNode(cg, bodyId);\n    if (bn->kind.tag == NodeKind::Stmt && bn->kind.payload.Stmt.value.kind.tag == StmtKind::Block)\n    {\n        Stmt* bs = &bn->kind.payload.Stmt.value;\n        u32 i = 0;\n        while (i < bs->kind.payload.Block.stmtsLen)\n        {\n            cgStmt(cg, bs->kind.payload.Block.stmts[i]);\n            i++;\n        }\n    }\n    else\n    {\n        cgStmt(cg, bodyId);\n    }\n    /* fall-through end of the body: unwind every live local */\n    cgEmitDropsTo(cg, cg->fnDropMark);\n    Slice bodyText = stTail(&cg->body, bodyStart);\n\n    // header\n    stNL(&cg->bodies, 0);\n    {\n        u8 inl = cgInlineKind(cg, dd);\n        if (inl == 1) stP(&cg->bodies, \"extern inline \");\n        else if (inl == 2) stP(&cg->bodies, \"extern inline __attribute__((always_inline)) \");\n    }\n    stPS(&cg->bodies, tyStr(cg, retTy));\n    stCh(&cg->bodies, ' ');\n    stPS(&cg->bodies, cname);\n    stCh(&cg->bodies, '(');\n    cgEmitParams(cg, &cg->bodies, dd, paramTys, owner, inst);\n    stP(&cg->bodies, \") {\");\n    // temporaries declared at function top\n    u32 t = 0;\n    while (t < cg->tempsLen)\n    {\n        stP(&cg->bodies, \"\\n    \");\n        Slice tty = cg->tempTys[t];\n        /* an array type spells as `T[N]`; in a declaration the suffix\n         * must follow the name: split at the first '[' */\n        usize bi = 0;\n        while (bi < tty.len && tty.ptr[bi] != 91) bi++;\n        if (bi < tty.len)\n        {\n            usize j = 0;\n            while (j < bi) { stCh(&cg->bodies, tty.ptr[j]); j++; }\n            stCh(&cg->bodies, ' ');\n            stPS(&cg->bodies, cgTempName(cg, t));\n            j = bi;\n            while (j < tty.len) { stCh(&cg->bodies, tty.ptr[j]); j++; }\n            stP(&cg->bodies, \";\");\n        }\n        else\n        {\n            stPS(&cg->bodies, tty);\n            stCh(&cg->bodies, ' ');\n            stPS(&cg->bodies, cgTempName(cg, t));\n            stP(&cg->bodies, \";\");\n        }\n        t++;\n    }\n    stPS(&cg->bodies, bodyText);\n    stNL(&cg->bodies, 0);\n    stCh(&cg->bodies, '}');\n\n    cg->subs = oldSubs;\n    cg->subsLen = oldSubsLen;\n}\n\n// fwd typedefs: structs/unions/variants + type instances\nvoid cgEmitFwd(Codegen* cg)\n{\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        NodeId id = cg->file->decls[i];\n        Node* d = cgNode(cg, id);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            switch (dd->kind.tag)\n            {\n                DeclKind::Struct => {\n                    if (cgDeclIsGeneric(cg, id)) break;\n                    stP(&cg->fwd, \"typedef struct \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Struct.name, 0));\n                    stP(&cg->fwd, \" \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Struct.name, 0));\n                    stP(&cg->fwd, \";\\n\");\n                },\n                DeclKind::Union => {\n                    if (cgDeclIsGeneric(cg, id)) break;\n                    stP(&cg->fwd, \"typedef union \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Union.name, 0));\n                    stP(&cg->fwd, \" \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Union.name, 0));\n                    stP(&cg->fwd, \";\\n\");\n                },\n                DeclKind::Variant => {\n                    if (cgDeclIsGeneric(cg, id)) break;\n                    stP(&cg->fwd, \"typedef struct \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Variant.name, 0));\n                    stP(&cg->fwd, \" \");\n                    stPS(&cg->fwd, cgMangle(cg, id, dd->kind.payload.Variant.name, 0));\n                    stP(&cg->fwd, \";\\n\");\n                },\n                else => {},\n            }\n        }\n        i++;\n    }\n    if (cg->mono != null)\n    {\n        i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::TypeInstance)\n            {\n                Slice m = cgInstanceName(cg, inst->name, inst->arguments, inst->argumentsLen);\n                stP(&cg->fwd, \"typedef struct \");\n                stPS(&cg->fwd, m);\n                stCh(&cg->fwd, ' ');\n                stPS(&cg->fwd, m);\n                stP(&cg->fwd, \";\\n\");\n            }\n            i++;\n        }\n    }\n}\n\n/* import `as` alias refs mangle as `path__alias__name`: map each one\n * back to the canonical `path__name` definition. Exempt names (main,\n * CRT, extern) never carry the alias segment at the use site, and types\n * resolve through their declaring decl (TypeEntry.loc), so only\n * Func/Constant pairs (plus their monomorphised instances) need a\n * bridge. */\nvoid cgEmitAliasBridges(Codegen* cg)\n{\n    if (cg->sema == null) return;\n    u32 i = 0;\n    while (i < cg->sema->aliasLen)\n    {\n        Str alias = cg->sema->aliasNames[i];\n        NodeId declId = cg->sema->aliasDecls[i];\n        i++;\n        if (alias == 0 || declId.index == 0) continue;\n        Node* n = cgNode(cg, declId);\n        if (n->kind.tag != NodeKind::Decl) continue;\n        Decl* dd = &n->kind.payload.Decl.value;\n        if (dd->kind.tag != DeclKind::Func && dd->kind.tag != DeclKind::Constant) continue;\n        Str own = cgDeclOwnName(dd);\n        if (own == 0) continue;\n        if (cgMangleExempt(cg, declId, cgIntern(cg, own))) continue;\n        if (dd->kind.tag == DeclKind::Func && cgDeclIsGeneric(cg, declId))\n        {\n            if (cg->mono == null) continue;\n            u32 j = 0;\n            while (j < cg->mono->instancesLen)\n            {\n                MonoInstance* inst = cg->mono->instances + j;\n                if (inst->kind == MonoInstanceKind::FunctionInstance &&\n                    inst->declaration.index == declId.index)\n                {\n                    Slice inm = cgInstanceName(cg, inst->name, inst->arguments, inst->argumentsLen);\n                    if (!cgMangleExempt(cg, declId, inm))\n                    {\n                        stP(&cg->fwd, \"#define \");\n                        stPS(&cg->fwd, cgMangleS(cg, declId, inm, alias));\n                        stP(&cg->fwd, \" \");\n                        stPS(&cg->fwd, cgMangleS(cg, declId, inm, 0));\n                        stP(&cg->fwd, \"\\n\");\n                    }\n                }\n                j++;\n            }\n        }\n        else\n        {\n            stP(&cg->fwd, \"#define \");\n            stPS(&cg->fwd, cgMangle(cg, declId, own, alias));\n            stP(&cg->fwd, \" \");\n            stPS(&cg->fwd, cgMangle(cg, declId, own, 0));\n            stP(&cg->fwd, \"\\n\");\n        }\n    }\n}\n\nvoid cgEmitEnumDef(Codegen* cg, NodeId declId, Decl* dd)\n{\n    stP(&cg->defs, \"typedef enum {\\n\");\n    u32 v = 0;\n    i64 nextVal = 0;\n    while (v < dd->kind.payload.Enum.variantsLen)\n    {\n        Node* vn = cgNode(cg, dd->kind.payload.Enum.variants[v]);\n        if (vn->kind.tag == NodeKind::EnumVariant)\n        {\n            EnumVariant* ev = &vn->kind.payload.EnumVariant.value;\n            stP(&cg->defs, \"    \");\n            stPS(&cg->defs, cgMangle(cg, declId, dd->kind.payload.Enum.name, 0));\n            stCh(&cg->defs, '_');\n            stPS(&cg->defs, cgIdent(cg, ev->name));\n            if ((ev->flags & 1) != 0 && ev->value.index != 0)\n            {\n                /* explicit `= N` resets the auto-increment counter (the\n                 * Neg path covers `= -N`) */\n                Node* valNode = cgNode(cg, ev->value);\n                i64 evVal = 0;\n                bool evNeg = false;\n                bool evOk = false;\n                if (valNode->kind.tag == NodeKind::Expr)\n                {\n                    Expr* iv = &valNode->kind.payload.Expr.value;\n                    if (iv->kind.tag == ExprKind::IntLit)\n                    {\n                        evVal = (i64)iv->kind.payload.IntLit.value;\n                        evOk = true;\n                    }\n                    else if (iv->kind.tag == ExprKind::Neg)\n                    {\n                        Node* inn = cgNode(cg, iv->kind.payload.Neg.expr);\n                        if (inn->kind.tag == NodeKind::Expr && inn->kind.payload.Expr.value.kind.tag == ExprKind::IntLit)\n                        {\n                            evVal = (i64)inn->kind.payload.Expr.value.kind.payload.IntLit.value;\n                            evNeg = true;\n                            evOk = true;\n                        }\n                    }\n                }\n                if (evOk)\n                {\n                    stP(&cg->defs, \" = \");\n                    if (evNeg) stCh(&cg->defs, '-');\n                    stU64(&cg->defs, (u64)evVal);\n                    nextVal = evVal;\n                    if (evNeg) nextVal = -nextVal;\n                    nextVal++;\n                }\n                else\n                {\n                    cgError(cg, \"enum variant is not a literal\");\n                }\n            }\n            else\n            {\n                stP(&cg->defs, \" = \");\n                stI64(&cg->defs, nextVal);\n                nextVal++;\n            }\n            if (v + 1 < dd->kind.payload.Enum.variantsLen) stCh(&cg->defs, ',');\n            stP(&cg->defs, \"\\n\");\n        }\n        v++;\n    }\n    stP(&cg->defs, \"} \");\n    stPS(&cg->defs, cgMangle(cg, declId, dd->kind.payload.Enum.name, 0));\n    stP(&cg->defs, \";\\n\");\n}\n\n// `T name` / `T name[len]` at file scope (C puts array bounds after the name)\nvoid cgEmitGlobalDeclarator(Codegen* cg, Ty cty, Slice name)\n{\n    if (cty != 0 && (cg->ctx->types + cty)->kind.tag == TypeKind::Array)\n    {\n        Ty et = cty;\n        while ((cg->ctx->types + et)->kind.tag == TypeKind::Array)\n            et = (cg->ctx->types + et)->kind.payload.Array.base;\n        stPS(&cg->defs, tyStr(cg, et));\n        stCh(&cg->defs, ' ');\n        stPS(&cg->defs, name);\n        Ty w = cty;\n        while ((cg->ctx->types + w)->kind.tag == TypeKind::Array)\n        {\n            stCh(&cg->defs, '[');\n            stU64(&cg->defs, (u64)(cg->ctx->types + w)->kind.payload.Array.len);\n            stCh(&cg->defs, ']');\n            w = (cg->ctx->types + w)->kind.payload.Array.base;\n        }\n        return;\n    }\n    stPS(&cg->defs, tyStr(cg, cty));\n    stCh(&cg->defs, ' ');\n    stPS(&cg->defs, name);\n}\n\n/* initializer-position value. C forbids an array-typed expression inside\n * an aggregate initializer (\"array initialized from non-constant array\n * expression\"), so array literals lower as bare `{…}` braces here\n * (recursing through nested braces) instead of the compound literal\n * cgExpr emits in expression position; anything else falls back. */\nSlice cgInitValue(Codegen* cg, NodeId v)\n{\n    Node* n = cgNode(cg, v);\n    if (n->kind.tag == NodeKind::Expr && n->kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral)\n    {\n        Expr* al = &n->kind.payload.Expr.value;\n        Stream vs = stNew(cg->arena, 64);\n        stP(&vs, \"{\");\n        u32 i = 0;\n        while (i < al->kind.payload.ArrayLiteral.elemsLen)\n        {\n            if (i > 0) stP(&vs, \", \");\n            stPS(&vs, cgInitValue(cg, al->kind.payload.ArrayLiteral.elems[i]));\n            i++;\n        }\n        stCh(&vs, '}');\n        usize cs = cg->ebuf.len;\n        stPS(&cg->ebuf, stTail(&vs, 0));\n        return stTail(&cg->ebuf, cs);\n    }\n    return cgExpr(cg, v);\n}\n\n/* file-scope initializer value: brace literals stay inline (temp\n * statements cannot be emitted at file scope) and recurse into\n * nested braces; anything else falls back to cgExpr. */\nvoid cgEmitInitValue(Codegen* cg, NodeId v)\n{\n    Node* n = cgNode(cg, v);\n    if (n->kind.tag == NodeKind::Expr && n->kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral)\n    {\n        Expr* al = &n->kind.payload.Expr.value;\n        stP(&cg->defs, \"{\");\n        u32 i = 0;\n        while (i < al->kind.payload.ArrayLiteral.elemsLen)\n        {\n            if (i > 0) stP(&cg->defs, \", \");\n            cgEmitInitValue(cg, al->kind.payload.ArrayLiteral.elems[i]);\n            i++;\n        }\n        stCh(&cg->defs, '}');\n        return;\n    }\n    if (n->kind.tag == NodeKind::Expr && n->kind.payload.Expr.value.kind.tag == ExprKind::StructLiteral &&\n        n->kind.payload.Expr.value.kind.payload.StructLiteral.variantName == 0)\n    {\n        Expr* se = &n->kind.payload.Expr.value;\n        stP(&cg->defs, \"(\");\n        stPS(&cg->defs, tyStr(cg, se->kind.payload.StructLiteral.typeNode));\n        stP(&cg->defs, \"){\");\n        u32 i = 0;\n        while (i < se->kind.payload.StructLiteral.fieldValuesLen)\n        {\n            if (i > 0) stP(&cg->defs, \", \");\n            if (se->kind.payload.StructLiteral.fieldNames != 0)\n            {\n                stP(&cg->defs, \".\");\n                stPS(&cg->defs, cgIdent(cg, se->kind.payload.StructLiteral.fieldNames[i]));\n                stP(&cg->defs, \" = \");\n            }\n            cgEmitInitValue(cg, se->kind.payload.StructLiteral.fieldValues[i]);\n            i++;\n        }\n        stCh(&cg->defs, '}');\n        return;\n    }\n    /* const-shaped exprs lower inline: cgExpr would emit statement\n     * temps, which are illegal at file scope */\n    if (cgConstAtom(cg, v)) { cgConstExpr(cg, v); return; }\n    Slice ev = cgExpr(cg, v);\n    stPS(&cg->defs, ev);\n}\n\nvoid cgEmitStructFields(Codegen* cg, NodeId* fields, u32 fieldsLen, u32 indent)\n{\n    u32 f = 0;\n    bool hadOne = false;\n    while (f < fieldsLen)\n    {\n        Node* fn = cgNode(cg, fields[f]);\n        if (fn->kind.tag == NodeKind::Field)\n        {\n            Field* fd = &fn->kind.payload.Field.value;\n            stP(&cg->defs, \"\\n    \");\n            if (fd->typeNode != 0 &&\n                (cg->ctx->types + fd->typeNode)->kind.tag == TypeKind::Array)\n            {\n                /* strip every dim for the element type, then re-emit the\n                 * dims after the name: `T name[A][B];` */\n                Ty et = fd->typeNode;\n                while ((cg->ctx->types + et)->kind.tag == TypeKind::Array)\n                    et = (cg->ctx->types + et)->kind.payload.Array.base;\n                stPS(&cg->defs, tyStr(cg, et));\n                stCh(&cg->defs, ' ');\n                stPS(&cg->defs, cgIdent(cg, fd->name));\n                Ty w = fd->typeNode;\n                while ((cg->ctx->types + w)->kind.tag == TypeKind::Array)\n                {\n                    stCh(&cg->defs, '[');\n                    stU64(&cg->defs, cgSubsArrayLen(cg, (cg->ctx->types + w)->kind.payload.Array.sizeParam, (cg->ctx->types + w)->kind.payload.Array.sizeName, (u64)(cg->ctx->types + w)->kind.payload.Array.len));\n                    stCh(&cg->defs, ']');\n                    w = (cg->ctx->types + w)->kind.payload.Array.base;\n                }\n                stCh(&cg->defs, ';');\n            }\n            else\n            {\n                stPS(&cg->defs, tyStr(cg, fd->typeNode));\n                stCh(&cg->defs, ' ');\n                stPS(&cg->defs, cgIdent(cg, fd->name));\n                stCh(&cg->defs, ';');\n            }\n            hadOne = true;\n        }\n        f++;\n    }\n    /* C forbids an empty struct: give it a dummy member instead */\n    if (!hadOne) stP(&cg->defs, \"\\n    char _empty;\");\n}\n\nvoid cgEmitVariantDef(Codegen* cg, Decl* dd, Slice name)\n{\n    stP(&cg->defs, \"struct \");\n    stPS(&cg->defs, name);\n    /* tag holds the variant's ORDINAL: switch lowering and cgVariantCaseIdx\n       compare against the same 0-based order */\n    stP(&cg->defs, \" {\\n    int32_t tag;\");\n    if (dd->kind.payload.Variant.variantsLen > 0)\n    {\n        stP(&cg->defs, \"\\n    union {\");\n        u32 v = 0;\n        while (v < dd->kind.payload.Variant.variantsLen)\n        {\n            VariantVariant* vv = dd->kind.payload.Variant.variants + v;\n            stP(&cg->defs, \"\\n        struct {\");\n            if (vv->fieldsLen == 0) stP(&cg->defs, \" char _e;\"); /* empty case still needs a member */\n            u32 f = 0;\n            while (f < vv->fieldsLen)\n            {\n                stP(&cg->defs, \"\\n            \");\n                stPS(&cg->defs, tyStr(cg, vv->fieldTypes[f]));\n                stCh(&cg->defs, ' ');\n                stPS(&cg->defs, cgIdent(cg, vv->fieldNames[f]));\n                stCh(&cg->defs, ';');\n                f++;\n            }\n            stP(&cg->defs, \"\\n        } v\");\n            stU64(&cg->defs, (u64)v);\n            stCh(&cg->defs, ';');\n            v++;\n        }\n        stP(&cg->defs, \"\\n    } u;\");\n    }\n    stP(&cg->defs, \"\\n};\\n\");\n}\n\n/* a reference to a file-scope `const` whose own initializer is\n * constant-foldable: cgConstExpr can substitute the value, since C\n * rejects reading another object at file scope. Returns the Constant\n * decl's node id (0 when not foldable) */\nNodeId cgFoldableConstDecl(Codegen* cg, NodeId id)\n{\n    NodeId none;\n    none.index = 0;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return none;\n    Expr* e = &n->kind.payload.Expr.value;\n    if (e->kind.tag != ExprKind::Ident) return none;\n    Str nm = e->kind.payload.Ident.name;\n    if (cgIsLocalName(cg, nm)) return none;\n    Str alias = 0;\n    NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Constant, id, &alias);\n    if (rd.index == 0) return none;\n    Node* rn = cgNode(cg, rd);\n    if (rn->kind.tag != NodeKind::Decl) return none;\n    Decl* rdd = &rn->kind.payload.Decl.value;\n    if (rdd->kind.tag != DeclKind::Constant) return none;\n    /* flags bit 16 = `const`; a `var` global may change at runtime */\n    if ((rdd->kind.payload.Constant.flags & 16) == 0) return none;\n    if (rdd->kind.payload.Constant.value.index == 0) return none;\n    if (!cgConstAtom(cg, rdd->kind.payload.Constant.value)) return none;\n    return rd;\n}\n\n/* an ident naming a function is an address constant in C: file-scope\n * `const A = { .alloc = f }` initializers rely on this */\nbool cgConstFuncIdent(Codegen* cg, NodeId id)\n{\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* e = &n->kind.payload.Expr.value;\n    if (e->kind.tag != ExprKind::Ident) return false;\n    Str nm = e->kind.payload.Ident.name;\n    if (cgIsLocalName(cg, nm)) return false;\n    Str alias = 0;\n    NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Func, id, &alias);\n    if (rd.index == 0) return false;\n    Node* rn = cgNode(cg, rd);\n    return rn->kind.tag == NodeKind::Decl && rn->kind.payload.Decl.value.kind.tag == DeclKind::Func;\n}\n\n/* file-scope constant values must lower to C constant expressions:\n * literals, casts, and unary/binary operators over the same, plus\n * references to other file-scope `const` decls (folded by value) */\nbool cgConstAtom(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* e = &n->kind.payload.Expr.value;\n    u32 k = (u32)e->kind.tag;\n    if (k == ExprKind::IntLit || k == ExprKind::FloatLit || k == ExprKind::BoolLit ||\n        k == ExprKind::StringLit || k == ExprKind::CharLit || k == ExprKind::NullLit) return true;\n    if (k == ExprKind::Ident)\n    {\n        if (cg->foldDepth >= 32) return false;\n        cg->foldDepth++;\n        NodeId fd = cgFoldableConstDecl(cg, id);\n        bool foldable = fd.index != 0;\n        cg->foldDepth--;\n        if (foldable) return true;\n        return cgConstFuncIdent(cg, id);\n    }\n    if (k == ExprKind::Neg) return cgConstAtom(cg, e->kind.payload.Neg.expr);\n    if (k == ExprKind::Not) return cgConstAtom(cg, e->kind.payload.Not.expr);\n    if (k == ExprKind::BitNot) return cgConstAtom(cg, e->kind.payload.BitNot.expr);\n    if (k == ExprKind::AddressOf) return true;\n    if (k == ExprKind::Cast) return cgConstAtom(cg, e->kind.payload.Cast.expr);\n    if (k == ExprKind::Ternary)\n        return cgConstAtom(cg, e->kind.payload.Ternary.cond) && cgConstAtom(cg, e->kind.payload.Ternary.thenExpr) && cgConstAtom(cg, e->kind.payload.Ternary.elseExpr);\n    if (k == ExprKind::Add) return cgConstAtom(cg, e->kind.payload.Add.left) && cgConstAtom(cg, e->kind.payload.Add.right);\n    if (k == ExprKind::Sub) return cgConstAtom(cg, e->kind.payload.Sub.left) && cgConstAtom(cg, e->kind.payload.Sub.right);\n    if (k == ExprKind::Mul) return cgConstAtom(cg, e->kind.payload.Mul.left) && cgConstAtom(cg, e->kind.payload.Mul.right);\n    if (k == ExprKind::Div) return cgConstAtom(cg, e->kind.payload.Div.left) && cgConstAtom(cg, e->kind.payload.Div.right);\n    if (k == ExprKind::Mod) return cgConstAtom(cg, e->kind.payload.Mod.left) && cgConstAtom(cg, e->kind.payload.Mod.right);\n    if (k == ExprKind::Eq) return cgConstAtom(cg, e->kind.payload.Eq.left) && cgConstAtom(cg, e->kind.payload.Eq.right);\n    if (k == ExprKind::Ne) return cgConstAtom(cg, e->kind.payload.Ne.left) && cgConstAtom(cg, e->kind.payload.Ne.right);\n    if (k == ExprKind::Lt) return cgConstAtom(cg, e->kind.payload.Lt.left) && cgConstAtom(cg, e->kind.payload.Lt.right);\n    if (k == ExprKind::Le) return cgConstAtom(cg, e->kind.payload.Le.left) && cgConstAtom(cg, e->kind.payload.Le.right);\n    if (k == ExprKind::Gt) return cgConstAtom(cg, e->kind.payload.Gt.left) && cgConstAtom(cg, e->kind.payload.Gt.right);\n    if (k == ExprKind::Ge) return cgConstAtom(cg, e->kind.payload.Ge.left) && cgConstAtom(cg, e->kind.payload.Ge.right);\n    if (k == ExprKind::And) return cgConstAtom(cg, e->kind.payload.And.left) && cgConstAtom(cg, e->kind.payload.And.right);\n    if (k == ExprKind::Or) return cgConstAtom(cg, e->kind.payload.Or.left) && cgConstAtom(cg, e->kind.payload.Or.right);\n    if (k == ExprKind::BitAnd) return cgConstAtom(cg, e->kind.payload.BitAnd.left) && cgConstAtom(cg, e->kind.payload.BitAnd.right);\n    if (k == ExprKind::BitOr) return cgConstAtom(cg, e->kind.payload.BitOr.left) && cgConstAtom(cg, e->kind.payload.BitOr.right);\n    if (k == ExprKind::BitXor) return cgConstAtom(cg, e->kind.payload.BitXor.left) && cgConstAtom(cg, e->kind.payload.BitXor.right);\n    if (k == ExprKind::Shl) return cgConstAtom(cg, e->kind.payload.Shl.left) && cgConstAtom(cg, e->kind.payload.Shl.right);\n    if (k == ExprKind::Shr) return cgConstAtom(cg, e->kind.payload.Shr.left) && cgConstAtom(cg, e->kind.payload.Shr.right);\n    return false;\n}\n\n/* emit a cgConstAtom expression as inline C into cg.defs: literals go\n * through cgExpr (they emit no statements); operators recurse so file\n * scope never sees a statement temp */\nvoid cgConstExpr(Codegen* cg, NodeId id)\n{\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) { stPS(&cg->defs, cgExpr(cg, id)); return; }\n    Expr* e = &n->kind.payload.Expr.value;\n    u32 k = (u32)e->kind.tag;\n    if (k == ExprKind::IntLit || k == ExprKind::FloatLit || k == ExprKind::BoolLit ||\n        k == ExprKind::StringLit || k == ExprKind::CharLit || k == ExprKind::NullLit ||\n        k == ExprKind::Path)\n    {\n        stPS(&cg->defs, cgExpr(cg, id));\n        return;\n    }\n    if (k == ExprKind::Ident)\n    {\n        /* fold a reference to another file-scope `const` by value: C\n         * forbids reading another object in a file-scope initializer */\n        NodeId fd = cgFoldableConstDecl(cg, id);\n        if (fd.index != 0)\n        {\n            if (cg->foldDepth >= 32)\n            {\n                cgError(cg, \"constant initializer refers to itself\");\n                return;\n            }\n            Node* dn = cgNode(cg, fd);\n            Decl* fdd = &dn->kind.payload.Decl.value;\n            cg->foldDepth++;\n            stCh(&cg->defs, '(');\n            cgConstExpr(cg, fdd->kind.payload.Constant.value);\n            stCh(&cg->defs, ')');\n            cg->foldDepth--;\n            return;\n        }\n        stPS(&cg->defs, cgExpr(cg, id));\n        return;\n    }\n    if (k == ExprKind::Neg) { stP(&cg->defs, \"-(\"); cgConstExpr(cg, e->kind.payload.Neg.expr); stP(&cg->defs, \")\"); return; }\n    if (k == ExprKind::Not) { stP(&cg->defs, \"!(\"); cgConstExpr(cg, e->kind.payload.Not.expr); stP(&cg->defs, \")\"); return; }\n    if (k == ExprKind::BitNot) { stP(&cg->defs, \"~(\"); cgConstExpr(cg, e->kind.payload.BitNot.expr); stP(&cg->defs, \")\"); return; }\n    if (k == ExprKind::AddressOf) { stP(&cg->defs, \"&(\"); cgConstExpr(cg, e->kind.payload.AddressOf.expr); stP(&cg->defs, \")\"); return; }\n    if (k == ExprKind::Cast)\n    {\n        stP(&cg->defs, \"(\");\n        /* const exprs may lack resolvedType; the cast target is authoritative */\n        if (e->kind.payload.Cast.targetType != 0)\n            stPS(&cg->defs, tyStr(cg, cgSubstTy(cg, e->kind.payload.Cast.targetType)));\n        else\n            stPS(&cg->defs, cgResultTy(cg, id, e));\n        stP(&cg->defs, \")(\");\n        cgConstExpr(cg, e->kind.payload.Cast.expr);\n        stP(&cg->defs, \")\");\n        return;\n    }\n    if (k == ExprKind::Ternary)\n    {\n        stP(&cg->defs, \"(\");\n        cgConstExpr(cg, e->kind.payload.Ternary.cond);\n        stP(&cg->defs, \" ? \");\n        cgConstExpr(cg, e->kind.payload.Ternary.thenExpr);\n        stP(&cg->defs, \" : \");\n        cgConstExpr(cg, e->kind.payload.Ternary.elseExpr);\n        stP(&cg->defs, \")\");\n        return;\n    }\n    str op = \"+\";\n    switch (k)\n    {\n        ExprKind::Add, ExprKind::Sub, ExprKind::Mul, ExprKind::Div, ExprKind::Mod,\n        ExprKind::Eq, ExprKind::Ne, ExprKind::Lt, ExprKind::Le, ExprKind::Gt, ExprKind::Ge,\n        ExprKind::And, ExprKind::Or,\n        ExprKind::BitAnd, ExprKind::BitOr, ExprKind::BitXor, ExprKind::Shl, ExprKind::Shr => {\n            switch (k)\n            {\n                ExprKind::Add => { op = \"+\"; },\n                ExprKind::Sub => { op = \"-\"; },\n                ExprKind::Mul => { op = \"*\"; },\n                ExprKind::Div => { op = \"/\"; },\n                ExprKind::Mod => { op = \"%\"; },\n                ExprKind::Eq => { op = \"==\"; },\n                ExprKind::Ne => { op = \"!=\"; },\n                ExprKind::Lt => { op = \"<\"; },\n                ExprKind::Le => { op = \"<=\"; },\n                ExprKind::Gt => { op = \">\"; },\n                ExprKind::Ge => { op = \">=\"; },\n                ExprKind::And => { op = \"&&\"; },\n                ExprKind::Or => { op = \"||\"; },\n                ExprKind::BitAnd => { op = \"&\"; },\n                ExprKind::BitOr => { op = \"|\"; },\n                ExprKind::BitXor => { op = \"^\"; },\n                ExprKind::Shl => { op = \"<<\"; },\n                ExprKind::Shr => { op = \">>\"; },\n                else => {},\n            }\n            stCh(&cg->defs, '(');\n            cgConstExpr(cg, e->kind.payload.Add.left);\n            stP(&cg->defs, op);\n            cgConstExpr(cg, e->kind.payload.Add.right);\n            stCh(&cg->defs, ')');\n            return;\n        },\n        else => {},\n    }\n    stPS(&cg->defs, cgExpr(cg, id));\n}\n\n/* would cgEmitInitValue emit this initializer without statement temps\n * and without C runtime expressions? (mirrors its shape) */\nbool cgInitConstP(Codegen* cg, NodeId v)\n{\n    if (v.index == 0) return true;\n    Node* n = cgNode(cg, v);\n    if (n->kind.tag == NodeKind::Expr && n->kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral)\n    {\n        Expr* al = &n->kind.payload.Expr.value;\n        u32 i = 0;\n        while (i < al->kind.payload.ArrayLiteral.elemsLen)\n        {\n            if (!cgInitConstP(cg, al->kind.payload.ArrayLiteral.elems[i])) return false;\n            i++;\n        }\n        return true;\n    }\n    if (n->kind.tag == NodeKind::Expr && n->kind.payload.Expr.value.kind.tag == ExprKind::StructLiteral)\n    {\n        Expr* se = &n->kind.payload.Expr.value;\n        /* variant literals lower through cgExpr already; leave that path\n         * unchanged rather than reclassifying them */\n        if (se->kind.payload.StructLiteral.variantName != 0) return true;\n        u32 i = 0;\n        while (i < se->kind.payload.StructLiteral.fieldValuesLen)\n        {\n            if (!cgInitConstP(cg, se->kind.payload.StructLiteral.fieldValues[i])) return false;\n            i++;\n        }\n        return true;\n    }\n    return cgConstAtom(cg, v);\n}\n\nvoid cgAddDynInit(Codegen* cg, NodeId decl)\n{\n    if (cg->dynInitsLen >= cg->dynInitsCap)\n    {\n        cgError(cg, \"too many file-scope variables with runtime initializers\");\n        return;\n    }\n    cg->dynInits[cg->dynInitsLen] = decl;\n    cg->dynInitsLen++;\n}\n\n/* runtime `var` globals: the assignments run from a constructor before\n * main, so the emitted C storage stays plain zero-initialized */\nvoid cgEmitGlobalInit(Codegen* cg)\n{\n    if (cg->dynInitsLen == 0) return;\n    usize bodyStart = cg->body.len;\n    cg->tempsLen = 0;\n    cg->loopDepth = 0;\n    cg->breakDepth = 0;\n    cg->dropsLen = 0;\n    cg->fnDropMark = 0;\n    cg->ind = 1;\n    cg->localNamesLen = 0;\n    u32 i = 0;\n    while (i < cg->dynInitsLen)\n    {\n        Node* dn = cgNode(cg, cg->dynInits[i]);\n        Decl* dd = &dn->kind.payload.Decl.value;\n        stNL(&cg->body, cg->ind);\n        stPS(&cg->body, cgMangle(cg, cg->dynInits[i], dd->kind.payload.Constant.name, 0));\n        stP(&cg->body, \" = \");\n        Slice ev = cgExpr(cg, dd->kind.payload.Constant.value);\n        stPS(&cg->body, ev);\n        stCh(&cg->body, ';');\n        i++;\n    }\n    Slice bodyText = stTail(&cg->body, bodyStart);\n    stNL(&cg->bodies, 0);\n    stP(&cg->bodies, \"__attribute__((constructor)) static void coral_globals_init(void) {\");\n    // temporaries declared at function top (same shape as cgEmitFuncCommon)\n    u32 t = 0;\n    while (t < cg->tempsLen)\n    {\n        stP(&cg->bodies, \"\\n    \");\n        Slice tty = cg->tempTys[t];\n        usize bi = 0;\n        while (bi < tty.len && tty.ptr[bi] != 91) bi++;\n        if (bi < tty.len)\n        {\n            usize j = 0;\n            while (j < bi) { stCh(&cg->bodies, tty.ptr[j]); j++; }\n            stCh(&cg->bodies, ' ');\n            stPS(&cg->bodies, cgTempName(cg, t));\n            j = bi;\n            while (j < tty.len) { stCh(&cg->bodies, tty.ptr[j]); j++; }\n            stP(&cg->bodies, \";\");\n        }\n        else\n        {\n            stPS(&cg->bodies, tty);\n            stCh(&cg->bodies, ' ');\n            stPS(&cg->bodies, cgTempName(cg, t));\n            stP(&cg->bodies, \";\");\n        }\n        t++;\n    }\n    stPS(&cg->bodies, bodyText);\n    stNL(&cg->bodies, 0);\n    stCh(&cg->bodies, '}');\n}\n\n/* file-scope constants and variables, emitted after the prototypes so\n * fn-pointer initializers (`const A = { .alloc = f }`) see a prior\n * declaration of f */\nvoid cgEmitGlobals(Codegen* cg)\n{\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cgNode(cg, cg->file->decls[i]);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Constant)\n            {\n                u8 cflags = dd->kind.payload.Constant.flags;\n                NodeId cval = dd->kind.payload.Constant.value;\n                Ty cty = dd->kind.payload.Constant.typeNode;\n                Str cname = dd->kind.payload.Constant.name;\n                if ((cflags & 2) != 0)\n                {\n                    // extern variable: declaration only\n                    stP(&cg->defs, \"extern \");\n                    cgEmitGlobalDeclarator(cg, cty, cgMangle(cg, cg->file->decls[i], cname, 0));\n                    stP(&cg->defs, \";\\n\");\n                }\n                else\n                {\n                    /* `const c2 = cchar;` binds a name to a TYPE, used in\n                     * type position (`c2 cc = …`); there is no value to\n                     * initialize — lower it as a typedef of the bound\n                     * type, the way a TypeAlias decl lowers */\n                    bool typeNamed = false;\n                    if (cval.index != 0)\n                    {\n                        Node* vn = cgNode(cg, cval);\n                        if (vn->kind.tag == NodeKind::Expr &&\n                            vn->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&\n                            cgFindTypeDecl(cg, vn->kind.payload.Expr.value.kind.payload.Ident.name,\n                                            locFile(vn->loc)).index != 0)\n                            typeNamed = true;\n                    }\n                    if (typeNamed)\n                    {\n                        stP(&cg->defs, \"typedef \");\n                        stPS(&cg->defs, tyStr(cg, cty));\n                        stCh(&cg->defs, ' ');\n                        stPS(&cg->defs, cgMangle(cg, cg->file->decls[i], cname, 0));\n                        stP(&cg->defs, \";\\n\");\n                    }\n                    else\n                    {\n                    if ((cflags & 4) != 0) stP(&cg->defs, \"static \");\n                    cgEmitGlobalDeclarator(cg, cty, cgMangle(cg, cg->file->decls[i], cname, 0));\n                    if (cval.index != 0)\n                    {\n                        bool isArray = cty != 0 &&\n                            (cg->ctx->types + cty)->kind.tag == TypeKind::Array;\n                        Node* inn = cgNode(cg, cval);\n                        bool isArrLit = inn->kind.tag == NodeKind::Expr &&\n                            inn->kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral;\n                        if (isArray && !isArrLit)\n                            cgError(cg, \"array constant needs an array-literal initializer\");\n                        /* C only accepts constant expressions at file scope.\n                         * a `const` decl must be one; a runtime `var`\n                         * initializer is deferred to coral_globals_init() */\n                        bool constShaped = cgInitConstP(cg, cval);\n                        if (!constShaped && (cflags & 16) != 0)\n                        {\n                            cgErrorUnsupported(cg, cg->file->decls[i],\n                                \"initializer of a file-scope constant must be a constant expression\");\n                        }\n                        else if (!constShaped && isArray)\n                        {\n                            cgErrorUnsupported(cg, cg->file->decls[i],\n                                \"file-scope array initializer must be constant\");\n                        }\n                        else if (!constShaped)\n                        {\n                            cgAddDynInit(cg, cg->file->decls[i]);\n                        }\n                        else\n                        {\n                            stP(&cg->defs, \" = \");\n                            cgEmitInitValue(cg, cval);\n                        }\n                    }\n                    stP(&cg->defs, \";\\n\");\n                    }\n                }\n            }\n        }\n        i++;\n    }\n}\n\n/* completeness walk for by-value field ordering: pointer and slice\n * fields name an incomplete type legally; const/comptime/array wrap a\n * by-value element; a Named must already be emitted */\nvoid cgTypeCompleteDeps(Codegen* cg, Ty t, Slice* names, u8* emitted, u32 n, bool* ready)\n{\n    if (!*ready || t == 0 || names == null) return;\n    TypeKind k = (cg->ctx->types + t)->kind;\n    if (k.tag == TypeKind::Pointer) return;\n    if (k.tag == TypeKind::Slice) return;\n    if (k.tag == TypeKind::Const) { cgTypeCompleteDeps(cg, k.payload.Const.base, names, emitted, n, ready); return; }\n    if (k.tag == TypeKind::Comptime) { cgTypeCompleteDeps(cg, k.payload.Comptime.base, names, emitted, n, ready); return; }\n    if (k.tag == TypeKind::Array) { cgTypeCompleteDeps(cg, k.payload.Array.base, names, emitted, n, ready); return; }\n    if (k.tag == TypeKind::Named)\n    {\n        Slice want = tyStr(cg, t);\n        u32 j = 0;\n        while (j < n)\n        {\n            if (!emitted[j] && cgSliceEq(names[j], want)) { *ready = false; return; }\n            j++;\n        }\n    }\n}\n\nbool cgTypeBodyReady(Codegen* cg, NodeId declId, MonoInstance* inst, Slice* names, u8* emitted, u32 n)\n{\n    Node* d = cgNode(cg, declId);\n    if (d->kind.tag != NodeKind::Decl || names == null) return true;\n    Decl* dd = &d->kind.payload.Decl.value;\n    MonoSubstitution* oldSubs = cg->subs;\n    u32 oldSubsLen = cg->subsLen;\n    if (inst != null) { cg->subs = inst->substitutions; cg->subsLen = inst->substitutionsLen; }\n    else { cg->subs = null; cg->subsLen = 0; }\n    bool ready = true;\n    if (dd->kind.tag == DeclKind::Struct)\n    {\n        u32 f = 0;\n        while (f < dd->kind.payload.Struct.fieldsLen && ready)\n        {\n            Node* fn = cgNode(cg, dd->kind.payload.Struct.fields[f]);\n            if (fn->kind.tag == NodeKind::Field)\n                cgTypeCompleteDeps(cg, fn->kind.payload.Field.value.typeNode, names, emitted, n, &ready);\n            f++;\n        }\n    }\n    else if (dd->kind.tag == DeclKind::Union)\n    {\n        u32 f = 0;\n        while (f < dd->kind.payload.Union.fieldsLen && ready)\n        {\n            Node* fn = cgNode(cg, dd->kind.payload.Union.fields[f]);\n            if (fn->kind.tag == NodeKind::Field)\n                cgTypeCompleteDeps(cg, fn->kind.payload.Field.value.typeNode, names, emitted, n, &ready);\n            f++;\n        }\n    }\n    else if (dd->kind.tag == DeclKind::Variant)\n    {\n        u32 v = 0;\n        while (v < dd->kind.payload.Variant.variantsLen && ready)\n        {\n            u32 f = 0;\n            while (f < dd->kind.payload.Variant.variants[v].fieldsLen && ready)\n            {\n                cgTypeCompleteDeps(cg, dd->kind.payload.Variant.variants[v].fieldTypes[f], names, emitted, n, &ready);\n                f++;\n            }\n            v++;\n        }\n    }\n    cg->subs = oldSubs;\n    cg->subsLen = oldSubsLen;\n    return ready;\n}\n\nvoid cgEmitTypeBody(Codegen* cg, NodeId declId, MonoInstance* inst, Slice m)\n{\n    Node* d = cgNode(cg, declId);\n    if (d->kind.tag != NodeKind::Decl) return;\n    Decl* dd = &d->kind.payload.Decl.value;\n    MonoSubstitution* oldSubs = cg->subs;\n    u32 oldSubsLen = cg->subsLen;\n    if (inst != null) { cg->subs = inst->substitutions; cg->subsLen = inst->substitutionsLen; }\n    else { cg->subs = null; cg->subsLen = 0; }\n    if (dd->kind.tag == DeclKind::Struct)\n    {\n        stP(&cg->defs, \"struct \");\n        stPS(&cg->defs, m);\n        stP(&cg->defs, \" {\");\n        cgEmitStructFields(cg, dd->kind.payload.Struct.fields, dd->kind.payload.Struct.fieldsLen, 4);\n        stP(&cg->defs, \"\\n};\\n\");\n    }\n    else if (dd->kind.tag == DeclKind::Union)\n    {\n        stP(&cg->defs, \"union \");\n        stPS(&cg->defs, m);\n        stP(&cg->defs, \" {\");\n        cgEmitStructFields(cg, dd->kind.payload.Union.fields, dd->kind.payload.Union.fieldsLen, 4);\n        stP(&cg->defs, \"\\n};\\n\");\n    }\n    else if (dd->kind.tag == DeclKind::Variant) cgEmitVariantDef(cg, dd, m);\n    cg->subs = oldSubs;\n    cg->subsLen = oldSubsLen;\n}\n\nvoid cgEmitTypeDefs(Codegen* cg)\n{\n    u32 i = 0;\n    /* sweeps 1+2 target cg.typedefs (emitted before the registry\n     * typedefs — FnP typedefs name aliases like `File` by value, so the\n     * aliases must be complete before them). Re-bind the stream; growth\n     * reallocates, so copy the grown stream back. */\n    Stream defsSaved = cg->defs;\n    cg->defs = cg->typedefs;\n    // sweep 1: aliases\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cgNode(cg, cg->file->decls[i]);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::TypeAlias)\n            {\n                Ty tgt = dd->kind.payload.TypeAlias.target;\n                TypeKind tgtKind = (cg->ctx->types + tgt)->kind;\n                /* An alias of a registry type (FnPtr/Slice/Tuple) must\n                 * follow the registry typedef it names. The registry\n                 * stream is emitted after cg.typedefs, so emit these\n                 * aliases into tdecl, right after cgRegEnsure has\n                 * deposited the target definition. */\n                if (tgt != 0 && (tgtKind.tag == TypeKind::FnPtr ||\n                                 tgtKind.tag == TypeKind::Slice ||\n                                 tgtKind.tag == TypeKind::Tuple))\n                {\n                    cgRegEnsure(cg, tgt);\n                    stP(&cg->tdecl, \"typedef \");\n                    stPS(&cg->tdecl, tyStr(cg, tgt));\n                    stCh(&cg->tdecl, ' ');\n                    stPS(&cg->tdecl, cgMangle(cg, cg->file->decls[i], dd->kind.payload.TypeAlias.name, 0));\n                    stP(&cg->tdecl, \";\\n\");\n                }\n                else\n                {\n                    stP(&cg->defs, \"typedef \");\n                    stPS(&cg->defs, tyStr(cg, dd->kind.payload.TypeAlias.target));\n                    stCh(&cg->defs, ' ');\n                    stPS(&cg->defs, cgMangle(cg, cg->file->decls[i], dd->kind.payload.TypeAlias.name, 0));\n                    stP(&cg->defs, \";\\n\");\n                }\n            }\n            else if (dd->kind.tag == DeclKind::Distinct)\n            {\n                stP(&cg->defs, \"typedef \");\n                stPS(&cg->defs, tyStr(cg, dd->kind.payload.Distinct.baseType));\n                stCh(&cg->defs, ' ');\n                stPS(&cg->defs, cgMangle(cg, cg->file->decls[i], dd->kind.payload.Distinct.name, 0));\n                stP(&cg->defs, \";\\n\");\n            }\n        }\n        i++;\n    }\n    // sweep 2: enums (typedef names must exist before structs use them)\n    i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cgNode(cg, cg->file->decls[i]);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Enum) cgEmitEnumDef(cg, cg->file->decls[i], dd);\n        }\n        i++;\n    }\n    cg->typedefs = cg->defs;\n    cg->defs = defsSaved;\n    /* sweep 2b+3+5 combined: struct/union/variant bodies — file decls\n     * and monomorphised instances — in by-value dependency order.\n     * Instances hold file types by value (HashMapEntry<String,String>\n     * contains String) and file structs hold instances by value\n     * (entries as Vec<String>), so neither fixed order works: emit any\n     * body whose by-value named fields are already emitted, repeating\n     * until none remain. Pointer and slice fields need no ordering (the\n     * typedefs above make the names visible); a by-value cycle is\n     * illegal in Coral and falls back to source order. */\n    {\n        u32 count = 0;\n        i = 0;\n        while (i < cg->file->declsLen)\n        {\n            Node* d = cgNode(cg, cg->file->decls[i]);\n            if (d->kind.tag == NodeKind::Decl)\n            {\n                Decl* dd = &d->kind.payload.Decl.value;\n                if ((dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union || dd->kind.tag == DeclKind::Variant) &&\n                    !cgDeclIsGeneric(cg, cg->file->decls[i])) count++;\n            }\n            i++;\n        }\n        u32 instCount = 0;\n        if (cg->mono != null)\n        {\n            i = 0;\n            while (i < cg->mono->instancesLen)\n            {\n                MonoInstance* inst = cg->mono->instances + i;\n                if (inst->kind == MonoInstanceKind::TypeInstance)\n                {\n                    Node* d = cgNode(cg, inst->declaration);\n                    if (d->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* dd = &d->kind.payload.Decl.value;\n                        if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union || dd->kind.tag == DeclKind::Variant) instCount++;\n                    }\n                }\n                i++;\n            }\n        }\n        if (count + instCount > 0)\n        {\n            NodeId* declIds = alloc<NodeId>((usize)(count + instCount));\n            MonoInstance** insts = alloc<MonoInstance*>((usize)(count + instCount));\n            Slice* names = alloc<Slice>((usize)(count + instCount));\n            u8* emitted = alloc<u8>((usize)(count + instCount));\n            if (declIds != null && insts != null && names != null && emitted != null)\n            {\n                zero<u8>(emitted, (usize)(count + instCount));\n                u32 n = 0;\n                i = 0;\n                while (i < cg->file->declsLen)\n                {\n                    Node* d = cgNode(cg, cg->file->decls[i]);\n                    if (d->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* dd = &d->kind.payload.Decl.value;\n                        bool take = !cgDeclIsGeneric(cg, cg->file->decls[i]);\n                        Slice m = Slice::from(null, 0);\n                        if (take && dd->kind.tag == DeclKind::Struct) m = cgMangle(cg, cg->file->decls[i], dd->kind.payload.Struct.name, 0);\n                        else if (take && dd->kind.tag == DeclKind::Union) m = cgMangle(cg, cg->file->decls[i], dd->kind.payload.Union.name, 0);\n                        else if (take && dd->kind.tag == DeclKind::Variant) m = cgMangle(cg, cg->file->decls[i], dd->kind.payload.Variant.name, 0);\n                        else take = false;\n                        if (take)\n                        {\n                            declIds[n] = cg->file->decls[i];\n                            insts[n] = null;\n                            names[n] = m;\n                            n++;\n                        }\n                    }\n                    i++;\n                }\n                if (cg->mono != null)\n                {\n                    i = 0;\n                    while (i < cg->mono->instancesLen)\n                    {\n                        MonoInstance* inst = cg->mono->instances + i;\n                        if (inst->kind == MonoInstanceKind::TypeInstance)\n                        {\n                            Node* d = cgNode(cg, inst->declaration);\n                            if (d->kind.tag == NodeKind::Decl)\n                            {\n                                Decl* dd = &d->kind.payload.Decl.value;\n                                if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union || dd->kind.tag == DeclKind::Variant)\n                                {\n                                    declIds[n] = inst->declaration;\n                                    insts[n] = inst;\n                                    names[n] = cgInstanceName(cg, inst->name, inst->arguments, inst->argumentsLen);\n                                    n++;\n                                }\n                            }\n                        }\n                        i++;\n                    }\n                }\n                u32 remaining = n;\n                while (remaining > 0)\n                {\n                    u32 progress = 0;\n                    u32 bi = 0;\n                    while (bi < n)\n                    {\n                        if (!emitted[bi])\n                        {\n                            bool ready = cgTypeBodyReady(cg, declIds[bi], insts[bi], names, emitted, n);\n                            if (ready)\n                            {\n                                cgEmitTypeBody(cg, declIds[bi], insts[bi], names[bi]);\n                                emitted[bi] = 1;\n                                remaining--;\n                                progress++;\n                            }\n                        }\n                        bi++;\n                    }\n                    if (progress == 0)\n                    {\n                        bi = 0;\n                        while (bi < n)\n                        {\n                            if (!emitted[bi])\n                            {\n                                cgEmitTypeBody(cg, declIds[bi], insts[bi], names[bi]);\n                                emitted[bi] = 1;\n                                remaining--;\n                            }\n                            bi++;\n                        }\n                    }\n                }\n                dealloc<NodeId>(declIds);\n                dealloc<MonoInstance*>(insts);\n                dealloc<Slice>(names);\n                dealloc<u8>(emitted);\n            }\n            else\n            {\n                if (declIds != null) dealloc<NodeId>(declIds);\n                if (insts != null) dealloc<MonoInstance*>(insts);\n                if (names != null) dealloc<Slice>(names);\n                if (emitted != null) dealloc<u8>(emitted);\n                cg->errors++;\n            }\n        }\n    }\n    /* sweep 4 (file-scope constants) moved to cgEmitGlobals: it runs\n     * after the prototypes so fn-pointer initializers see a prior\n     * declaration of the function */\n}\n\n// owner prefix for methods of a type/extend decl\nSlice cgDeclOwner(Codegen* cg, Decl* dd)\n{\n    switch (dd->kind.tag)\n    {\n        DeclKind::Struct => { return cgIdent(cg, dd->kind.payload.Struct.name); },\n        DeclKind::Union => { return cgIdent(cg, dd->kind.payload.Union.name); },\n        DeclKind::Variant => { return cgIdent(cg, dd->kind.payload.Variant.name); },\n        DeclKind::Extend => { return cgOwnerName(cg, dd->kind.payload.Extend.selfType); },\n        DeclKind::ExtendTrait => { return cgOwnerName(cg, dd->kind.payload.ExtendTrait.selfType); },\n        else => { return Slice::from(null, 0); },\n    }\n    return Slice::from(null, 0);\n}\n\nbool cgOwnerGeneric(Codegen* cg, Decl* dd)\n{\n    switch (dd->kind.tag)\n    {\n        DeclKind::Struct => { return dd->kind.payload.Struct.genericParamsLen > 0; },\n        DeclKind::Union => { return dd->kind.payload.Union.genericParamsLen > 0; },\n        DeclKind::Variant => { return dd->kind.payload.Variant.genericParamsLen > 0; },\n        DeclKind::Extend => { return dd->kind.payload.Extend.genericParamsLen > 0 || cgTyHasParam(cg, dd->kind.payload.Extend.selfType); },\n        DeclKind::ExtendTrait => { return dd->kind.payload.ExtendTrait.genericParamsLen > 0 || cgTyHasParam(cg, dd->kind.payload.ExtendTrait.selfType); },\n        else => { return false; },\n    }\n    return false;\n}\n\nvoid cgEmitMethodSet(Codegen* cg, NodeId declId, bool withBodies)\n{\n    Node* od = cgNode(cg, declId);\n    if (od->kind.tag != NodeKind::Decl) return;\n    Decl* dd = &od->kind.payload.Decl.value;\n    if (cgOwnerGeneric(cg, dd)) return;\n    /* `owner` = the bare coral name: it forms the `owner_method` symbol\n     * suffix both def and call sides agree on. `paramOwner` = the self\n     * parameter's C type, path-mangled like every other type reference. */\n    Slice owner = cgDeclOwner(cg, dd);\n    Slice paramOwner = owner;\n    if (dd->kind.tag == DeclKind::Extend)\n        paramOwner = cgOwnerTypeName(cg, dd->kind.payload.Extend.selfType);\n    else if (dd->kind.tag == DeclKind::ExtendTrait)\n        paramOwner = cgOwnerTypeName(cg, dd->kind.payload.ExtendTrait.selfType);\n    else\n        paramOwner = cgMangle(cg, declId, cgDeclOwnName(dd), 0);\n    NodeId* methods = null;\n    u32 mlen = 0;\n    switch (dd->kind.tag)\n    {\n        DeclKind::Struct => { methods = dd->kind.payload.Struct.methods; mlen = dd->kind.payload.Struct.methodsLen; },\n        DeclKind::Union => { methods = dd->kind.payload.Union.methods; mlen = dd->kind.payload.Union.methodsLen; },\n        DeclKind::Variant => { methods = dd->kind.payload.Variant.methods; mlen = dd->kind.payload.Variant.methodsLen; },\n        DeclKind::Extend => { methods = dd->kind.payload.Extend.methods; mlen = dd->kind.payload.Extend.methodsLen; },\n        DeclKind::ExtendTrait => { methods = dd->kind.payload.ExtendTrait.methods; mlen = dd->kind.payload.ExtendTrait.methodsLen; },\n        else => { return; },\n    }\n    u32 m = 0;\n    while (m < mlen)\n    {\n        NodeId mid = methods[m];\n        Node* mn = cgNode(cg, mid);\n        if (mn->kind.tag == NodeKind::Decl && mn->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        {\n            Decl* md = &mn->kind.payload.Decl.value;\n            if (!cgDeclIsGeneric(cg, mid))\n            {\n                usize ns = cg->tybuf.len;\n                stPS(&cg->tybuf, owner);\n                stCh(&cg->tybuf, '_');\n                stPS(&cg->tybuf, cgIntern(cg, md->kind.payload.Func.name));\n                Slice cname = cgMangleS(cg, mid, stTail(&cg->tybuf, ns), 0);\n                u8 flags = md->kind.payload.Func.flags;\n                if (withBodies)\n                {\n                    if ((flags & 8) != 0 && (flags & 2) == 0)\n                        cgEmitFuncCommon(cg, mid, cname, md->kind.payload.Func.returnType, null, null, 0, paramOwner, (flags & 4) != 0 ? 1 : 0, null);\n                }\n                else\n                {\n                    /* extern method: emit the prototype too: nothing\n                       (system header) declares it for us anymore */\n                    cgEmitProto(cg, mid, cname, md->kind.payload.Func.returnType, null, null, 0, paramOwner, null);\n                }\n            }\n        }\n        m++;\n    }\n}\n\n// an extend's self type matched against a concrete instance\nbool cgSelfTyMatches(Codegen* cg, Ty selfTy, Str instName, Ty* args, u32 argsLen)\n{\n    if (selfTy == 0) return false;\n    TypeEntry* e = cg->ctx->types + selfTy;\n    if (e->kind.tag == TypeKind::Const) return cgSelfTyMatches(cg, e->kind.payload.Const.base, instName, args, argsLen);\n    if (e->kind.tag != TypeKind::Named) return false;\n    if (e->kind.payload.Named.name != instName) return false;\n    if (e->kind.payload.Named.genericArgsLen != argsLen) return false;\n    u32 i = 0;\n    while (i < argsLen)\n    {\n        Ty a = e->kind.payload.Named.genericArgs[i];\n        TypeEntry* ae = cg->ctx->types + a;\n        if (ae->kind.tag != TypeKind::TypeParam && a != args[i]) return false;\n        i++;\n    }\n    return true;\n}\n\nvoid cgEmitInstMethodList(Codegen* cg, NodeId* methods, u32 mlen, Slice m, MonoInstance* inst, bool withBodies)\n{\n    u32 k = 0;\n    while (k < mlen)\n    {\n        NodeId mid = methods[k];\n        Node* mn = cgNode(cg, mid);\n        if (mn->kind.tag == NodeKind::Decl && mn->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        {\n            Decl* md = &mn->kind.payload.Decl.value;\n            if (!cgDeclIsGeneric(cg, mid))\n            {\n                usize ns = cg->tybuf.len;\n                stPS(&cg->tybuf, m);\n                stCh(&cg->tybuf, '_');\n                stPS(&cg->tybuf, cgIntern(cg, md->kind.payload.Func.name));\n                Slice cname = cgMangleS(cg, mid, stTail(&cg->tybuf, ns), 0);\n                u8 flags = md->kind.payload.Func.flags;\n                if (withBodies)\n                {\n                    if ((flags & 8) != 0 && (flags & 2) == 0)\n                        cgEmitFuncCommon(cg, mid, cname, md->kind.payload.Func.returnType, null, inst->substitutions, inst->substitutionsLen, m, (flags & 4) != 0 ? 1 : 0, inst);\n                }\n                else\n                {\n                    cgEmitProto(cg, mid, cname, md->kind.payload.Func.returnType, null, inst->substitutions, inst->substitutionsLen, m, inst);\n                }\n            }\n        }\n        k++;\n    }\n}\n\n/* methods for a monomorphised type instance: the type's own methods plus\n * every extend whose self type matches it */\nvoid cgEmitInstanceMethods(Codegen* cg, Decl* dd, MonoInstance* inst, bool withBodies)\n{\n    Slice m = cgInstanceName(cg, inst->name, inst->arguments, inst->argumentsLen);\n    /* same alias-equal-args symbol collapse as FunctionInstance protos */\n    if (withBodies)\n    {\n        if (cgFnSeen(cg, m, false)) return;\n        cgFnSee(cg, m, false);\n    }\n    else\n    {\n        if (cgFnSeen(cg, m, true)) return;\n        cgFnSee(cg, m, true);\n    }\n    NodeId* methods = null;\n    u32 mlen = 0;\n    switch (dd->kind.tag)\n    {\n        DeclKind::Struct => { methods = dd->kind.payload.Struct.methods; mlen = dd->kind.payload.Struct.methodsLen; },\n        DeclKind::Union => { methods = dd->kind.payload.Union.methods; mlen = dd->kind.payload.Union.methodsLen; },\n        DeclKind::Variant => { methods = dd->kind.payload.Variant.methods; mlen = dd->kind.payload.Variant.methodsLen; },\n        else => {},\n    }\n    if (methods != null) cgEmitInstMethodList(cg, methods, mlen, m, inst, withBodies);\n    u32 d = 0;\n    while (d < cg->file->declsLen)\n    {\n        Node* dn = cgNode(cg, cg->file->decls[d]);\n        if (dn->kind.tag == NodeKind::Decl)\n        {\n            Decl* xd = &dn->kind.payload.Decl.value;\n            bool matches = false;\n            if (xd->kind.tag == DeclKind::Extend)\n                matches = cgSelfTyMatches(cg, xd->kind.payload.Extend.selfType, inst->name, inst->arguments, inst->argumentsLen);\n            else if (xd->kind.tag == DeclKind::ExtendTrait)\n                matches = cgSelfTyMatches(cg, xd->kind.payload.ExtendTrait.selfType, inst->name, inst->arguments, inst->argumentsLen);\n            if (matches)\n            {\n                NodeId* em = null;\n                u32 eml = 0;\n                if (xd->kind.tag == DeclKind::Extend) { em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen; }\n                else { em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen; }\n                cgEmitInstMethodList(cg, em, eml, m, inst, withBodies);\n            }\n        }\n        d++;\n    }\n}\n\nvoid cgEmitProtos(Codegen* cg)\n{\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        NodeId id = cg->file->decls[i];\n        Node* d = cgNode(cg, id);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Func)\n            {\n                if (cgDeclIsGeneric(cg, id)) { i++; continue; }\n                /* two extern decls of the same C name (libc's printf vs a\n                 * user redeclaration with a different pointer type) must\n                 * produce ONE prototype: C allows a name only once per\n                 * translation unit; first declaration wins */\n                if ((dd->kind.payload.Func.flags & 2) != 0)\n                {\n                    u32 j = 0;\n                    while (j < i)\n                    {\n                        Node* d2 = cgNode(cg, cg->file->decls[j]);\n                        if (d2->kind.tag == NodeKind::Decl)\n                        {\n                            Decl* d2d = &d2->kind.payload.Decl.value;\n                            if (d2d->kind.tag == DeclKind::Func && (d2d->kind.payload.Func.flags & 2) != 0 &&\n                                d2d->kind.payload.Func.name == dd->kind.payload.Func.name)\n                            { i++; break; }\n                        }\n                        j++;\n                    }\n                    if (j < i) continue;\n                }\n                /* emit prototypes for ALL extern fns too: the system\n                 * headers are gone, so coral's own decl is the only one */\n                cgEmitProto(cg, id, cgMangle(cg, id, dd->kind.payload.Func.name, 0),\n                            dd->kind.payload.Func.returnType, null, null, 0, Slice::from(null, 0), null);\n            }\n            else if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union ||\n                     dd->kind.tag == DeclKind::Variant || dd->kind.tag == DeclKind::Extend ||\n                     dd->kind.tag == DeclKind::ExtendTrait)\n            {\n                cgEmitMethodSet(cg, id, false);\n            }\n        }\n        i++;\n    }\n    if (cg->mono != null)\n    {\n        i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance)\n            {\n                Slice m = cgMangleS(cg, inst->declaration,\n                                    cgInstanceNameV(cg, inst->name, inst->arguments, inst->argumentsLen, inst->valueKey), 0);\n                /* alias-equal args (`u32` / `Str` / `Ty` all spell `uint32_t`)\n                 * compose one C symbol from several instances — emit once */\n                if (!cgFnSeen(cg, m, true))\n                {\n                    cgFnSee(cg, m, true);\n                    cgEmitProto(cg, inst->declaration, m, inst->returnType, inst->paramTypes,\n                                inst->substitutions, inst->substitutionsLen, Slice::from(null, 0), inst);\n                }\n            }\n            else if (inst->kind == MonoInstanceKind::TypeInstance)\n            {\n                Node* dn = cgNode(cg, inst->declaration);\n                if (dn->kind.tag == NodeKind::Decl)\n                {\n                    Decl* dd = &dn->kind.payload.Decl.value;\n                    if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union || dd->kind.tag == DeclKind::Variant)\n                        cgEmitInstanceMethods(cg, dd, inst, false);\n                }\n            }\n            i++;\n        }\n    }\n}\n\n/* emits every body the module owns: non-generic funcs, then each mono\n * function instance and every type instance's methods */\nvoid cgEmitBodies(Codegen* cg)\n{\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        NodeId id = cg->file->decls[i];\n        Node* d = cgNode(cg, id);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Func)\n            {\n                /* func flags: 2 = extern (declared, not defined), 4 = static, 8 = has a body */\n                u8 flags = dd->kind.payload.Func.flags;\n                if ((flags & 8) != 0 && (flags & 2) == 0 && !cgDeclIsGeneric(cg, id))\n                    cgEmitFuncCommon(cg, id, cgMangle(cg, id, dd->kind.payload.Func.name, 0),\n                                     dd->kind.payload.Func.returnType, null, null, 0,\n                                     Slice::from(null, 0), (flags & 4) != 0 ? 1 : 0, null);\n            }\n            else if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union ||\n                     dd->kind.tag == DeclKind::Variant || dd->kind.tag == DeclKind::Extend ||\n                     dd->kind.tag == DeclKind::ExtendTrait)\n            {\n                cgEmitMethodSet(cg, id, true);\n            }\n        }\n        i++;\n    }\n    if (cg->mono != null)\n    {\n        i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance)\n            {\n                Node* idn = cgNode(cg, inst->declaration);\n                Decl* dd = &idn->kind.payload.Decl.value;\n                if ((dd->kind.payload.Func.flags & 8) != 0 && (dd->kind.payload.Func.flags & 2) == 0)\n                {\n                    Slice m = cgMangleS(cg, inst->declaration,\n                                        cgInstanceNameV(cg, inst->name, inst->arguments, inst->argumentsLen, inst->valueKey), 0);\n                    if (!cgFnSeen(cg, m, false))\n                    {\n                        cgFnSee(cg, m, false);\n                        cgEmitFuncCommon(cg, inst->declaration, m, inst->returnType, inst->paramTypes,\n                                         inst->substitutions, inst->substitutionsLen, Slice::from(null, 0), 0, inst);\n                    }\n                }\n            }\n            else if (inst->kind == MonoInstanceKind::TypeInstance)\n            {\n                Node* dn = cgNode(cg, inst->declaration);\n                if (dn->kind.tag == NodeKind::Decl)\n                {\n                    Decl* dd = &dn->kind.payload.Decl.value;\n                    if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union || dd->kind.tag == DeclKind::Variant)\n                        cgEmitInstanceMethods(cg, dd, inst, true);\n                }\n            }\n            i++;\n        }\n    }\n}\n\n/* ── entry point: analyzed AST → flat C ──────────────────────── */\n\npub CodegenResult generateC(AstContext* ctx, File* file, MonoContext* mono, Arena* arena)\n{\n    Codegen cg;\n    cg.ctx = ctx;\n    cg.file = file;\n    cg.mono = mono;\n    cg.sema = null;\n    if (mono != null) cg.sema = mono->sema;\n    cg.arena = arena;\n    cg.out = stNew(arena, 4096);\n    cg.fwd = stNew(arena, 4096);\n    cg.defs = stNew(arena, 16384);\n    cg.protos = stNew(arena, 8192);\n    /* initial capacities only; stPut doubles a stream when it fills */\n    cg.bodies = stNew(arena, 65536);\n    cg.body = stNew(arena, 65536);\n    cg.ebuf = stNew(arena, 8192);\n    cg.tybuf = stNew(arena, 16384);\n    cg.tdecl = stNew(arena, 16384);\n    cg.typedefs = stNew(arena, 8192);\n    cg.protoFnCap = 16384;\n    cg.protoFnLen = 0;\n    cg.protoFnNames = (Slice*)arena->alloc(16384 * @sizeof(Slice), 8);\n    cg.bodyFnCap = 16384;\n    cg.bodyFnLen = 0;\n    cg.bodyFnNames = (Slice*)arena->alloc(16384 * @sizeof(Slice), 8);\n    cg.subs = null;\n    cg.subsLen = 0;\n    cg.errors = 0;\n    cg.declCacheLen = 0;\n    cg.declCacheNames = (Str*)cg.arena->alloc(32 * @sizeof(Str), 4);\n    cg.declCacheIds = (u32*)cg.arena->alloc(32 * @sizeof(u32), 4);\n    cg.declCacheTags = (u32*)cg.arena->alloc(32 * @sizeof(u32), 4);\n    if (cg.declCacheNames != null)\n    {\n        u32 dci = 0;\n        while (dci < 32) { cg.declCacheNames[dci] = 0; cg.declCacheIds[dci] = 0; cg.declCacheTags[dci] = 0; dci++; }\n    }\n    cg.labelSeq = 0;\n    cg.tempSeq = 0;\n    cg.localNames = null;\n    cg.localNamesLen = 0;\n    cg.localNamesCap = 0;\n    cg.tempsCap = 4096;\n    cg.tempsLen = 0;\n    cg.tempTys = (Slice*)arena->alloc(4096 * @sizeof(Slice), 8);\n    cg.tempArrs = (u32*)arena->alloc(4096 * @sizeof(u32), 8);\n    cg.loopCap = 64;\n    cg.loopDepth = 0;\n    cg.breakDepth = 0;\n    cg.switchSeq = 0;\n    cg.breakKinds = (u32*)arena->alloc(64 * @sizeof(u32), 8);\n    cg.breakLabels = (u32*)arena->alloc(64 * @sizeof(u32), 8);\n    cg.dropsCap = 4096;\n    cg.dropsLen = 0;\n    cg.fnDropMark = 0;\n    cg.drops = (DropEntry*)arena->alloc(4096 * @sizeof(DropEntry), 8);\n    cg.loopDropMarks = (u32*)arena->alloc(64 * @sizeof(u32), 8);\n    cg.breakDropMarks = (u32*)arena->alloc(64 * @sizeof(u32), 8);\n    cg.regCap = 512;\n    cg.regLen = 0;\n    cg.regNames = (Slice*)arena->alloc(512 * @sizeof(Slice), 8);\n    cg.dynInitsCap = 512;\n    cg.dynInitsLen = 0;\n    cg.dynInits = (NodeId*)arena->alloc(512 * @sizeof(NodeId), 8);\n    cg.foldDepth = 0;\n    cg.ind = 0;\n    if (cg.tempTys == null || cg.tempArrs == null || cg.regNames == null || cg.dynInits == null) {\n        CodegenResult r;\n        r.cCode = Slice::from(n