\n                    Slice ft = tyStr(cg, cgSubstTy(cg, tupleEntry->kind.payload.Tuple.elems[bj]));\n                    cgAddLocal(cg, bn);\n                    stNL(&cg->body, cg->ind);\n                    stPS(&cg->body, ft);\n                    stCh(&cg->body, ' ');\n                    stPS(&cg->body, cgIntern(cg, bn));\n                    stP(&cg->body, \" = \");\n                    stPS(&cg->body, elemTempName);\n                    stP(&cg->body, \"._\");\n                    stU64(&cg->body, (u64)(bj + 1));\n                    stCh(&cg->body, ';');\n                    bj++;\n                }\n            }\n\n            cgPushLoop(cg, loopMark);\n            cgStmtBraced(cg, s->kind.payload.ForIn.body);\n            cgPopLoop(cg);\n            cgEmitDropsTo(cg, loopMark);\n\n            cg->ind--;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '}');\n            cg->ind--;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '}');\n            return;\n        },\n\n        StmtKind::Switch => {\n            Slice scrut = cgExpr(cg, s->kind.payload.Switch.expr);\n            Ty scrutTy = 0;\n            {\n                Node* sn = cgNode(cg, s->kind.payload.Switch.expr);\n                if (sn->kind.tag == NodeKind::Expr) scrutTy = sn->kind.payload.Expr.value.resolvedType;\n            }\n            cgEmitSwitch(cg, scrut, scrutTy, s->kind.payload.Switch.cases, s->kind.payload.Switch.casesLen, Slice::from(null, 0));\n            return;\n        },\n\n        StmtKind::Defer => {\n            cgError(cg, \"defer is not supported\");\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"/* unsupported: defer */\");\n            return;\n        },\n\n        StmtKind::Comptime => {\n            /* comptime blocks are evaluated by the mono phase (CtEval),\n             * which replaces the enclosing function body with the surviving\n             * runtime statements. If codegen reaches a Comptime