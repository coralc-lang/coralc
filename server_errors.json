{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-ir/decl.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* coral-ir/decl.crl — mangling, function shells, extern protos\n *\n * Mangling follows mangle.md: `_C` + `N` root segment* `E` +\n * kind-suffix, where every ident is <decimal length><raw bytes>. The\n * root is `f` for files under the entry root (segments are the file's\n * path relative to it), `l<package>` for `lib/` files (segments are\n * every component after the package directory), and `r<stem>` for\n * files outside the entry tree. Functions encode `[M<self>]F<params>_\n * <ret>`, globals `G`; generic args attach to their segment as `I…E`.\n *\n * Exempt from mangling (raw source name): `main`, `extern` decls of any\n * form (`extern`, `extern(\"C\")`, `extern(\"kernel32\")` — detectxed by the\n * isExtern flag bit, not by convention string), and `#[[no_mangle]]`\n * decls. The C backend uses `__` instead of `$` (its C-text emission\n * cannot spell `$` in identifiers); the two backends intentionally\n * diverge — wallvm emits asm directly. */\nuse lower { Wv, wvNode, wvStr, wvMbReset, wvMbCh, wvMbP, wvMbSeg, wvMbStr, wvArr,\n               wvSubstTy, wvMbHex, wvMbDec, wvMbIdent, wvMbIdentStr,\n               wvTypeInstanceName };\nuse types { wvTy, wvFindTypeDecl };\nuse context::context { AstContext, InternEntry };\nuse mono::mono { MonoInstance };\nuse ast {\n    id { Str, NodeId, locFile },\n    types { Ty, TypeEntry, TypeKind },\n    node { Node, NodeKind },\n    expr { Expr, ExprKind },\n    stmt { Stmt, StmtKind },\n    decl { Decl, DeclKind, File, Param, Attribute, ATTR_NO_MANGLE }\n};\nuse common::slice { Slice };\nimport wallvm::irtypes { IrContext, IrModule, IrFunc, IrValue, IrType, IrValueKind };\n\n/* exempt from mangling: `main` (entry point), `extern` decls (flag bit 2\n * — any convention, incl. bare `extern` and `extern(\"kernel32\")`), and\n * `#[[no_mangle]]` decls (ATTR_NO_MANGLE bit). All keep their raw source\n * name. `main` is matched by precomputed FNV-1a, not a byte compare:\n * the hash literal appears once, here. */\npub bool wvMangleExempt(Wv* w, NodeId declId, str name)\n{\n    if (name.len == 0) return true;\n    if (name.len == 4 && w->ctx->hashStr(name) == 0xEA90E208) return true; /* FNV(\"main\") */\n    if (declId.index == 0) return false;\n    Node* n = wvNode(w, declId);\n    if (n->kind.tag != NodeKind::Decl) return false;\n    Decl* d = &n->kind.payload.Decl.value;\n    if (d->kind.tag == DeclKind::Func)\n    {\n        if ((d->kind.payload.Func.flags & 2) != 0) return true; // isExtern\n        if ((d->attrBits & ATTR_NO_MANGLE) != 0) return true;\n    }\n    else if (d->kind.tag == DeclKind::Constant)\n    {\n        if ((d->kind.payload.Constant.flags & 2) != 0) return true; // isExtern\n        if ((d->attrBits & ATTR_NO_MANGLE) != 0) return true;\n    }\n    return false;\n}\n\n/* ── mangle.md symbols ────────────────────────────────────────────────\n * `_C` scope kind-suffix, scope = `N` root segment* `E`, root `f` (entry\n * tree), `l<ident>` (lib package) or `r<ident>` (external path), and\n * every ident is <decimal length><raw bytes>. See mangle.md. */\n\n/* host platform directory names: `lib/std/x86_64/linux/error.crl` is\n * one module namespace, not a path through arch/os dirs. FNV-1a 32\n * constants keep the check to a hash load. */\nbool wvMbIsPlatformTag(Wv* w, u8* s, usize len)\n{\n    u32 h = w->ctx->hashStr(str { .ptr = s, .len = len });\n    if (len == 6 && h == 0x5FA00F30) return true; // x86_64\n    if (len == 3 && h == 0x92060801) return true; // x86\n    if (len == 7 && h == 0x1FA64776) return true; // aarch64\n    if (len == 5 && h == 0xB3715D77) return true; // arm64\n    if (len == 3 && h == 0x386F27B5) return true; // arm\n    if (len == 7 && h == 0x6B83E9AE) return true; // riscv64\n    if (len == 7 && h == 0x6F90BBED) return true; // riscv32\n    if (len == 6 && h == 0x0D246AB8) return true; // wasm32\n    if (len == 6 && h == 0x811CD28F) return true; // wasm64\n    if (len == 5 && h == 0xECBB951D) return true; // linux\n    if (len == 7 && h == 0xD59726EA) return true; // windows\n    if (len == 5 && h == 0x42747F82) return true; // macos\n    if (len == 6 && h == 0x097682A2) return true; // darwin\n    if (len == 3 && h == 0x80EB9BE6) return true; // ios\n    if (len == 7 && h == 0xFA1B0B2C) return true; // android\n    if (len == 7 && h == 0xF1F85674) return true; // freebsd\n    if (len == 7 && h == 0x6E12B2A6) return true; // openbsd\n    if (len == 6 && h == 0xC07B89D9) return true; // netbsd\n    if (len == 9 && h == 0x12ADE7EF) return true; // dragonfly\n    if (len == 7 && h == 0x1294D85A) return true; // solaris\n    if (len == 5 && h == 0xAB756201) return true; // haiku\n    if (len == 12 && h == 0x41E273FB) return true; // freestanding\n    return false;\n}\n\n/* emit the scope root + path segments of a source file; the caller\n * appends the decl-name segment and the closing `E`. */\nvoid wvMbPathScope(Wv* w, u8* path, usize pathLen)\n{\n    /* drop a trailing \".crl\" */\n    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&\n        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)\n        pathLen -= 4;\n\n    /* locate the lib/ root (leading \"lib/\" or any \"/lib/\") */\n    bool isLib = false;\n    usize libPos = 0;\n    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)\n    {\n        isLib = true;\n        libPos = 4;\n    }\n    usize q = 0;\n    while (!isLib && q + 5 <= pathLen)\n    {\n        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&\n            path[q + 3] == 98 && path[q + 4] == 47)\n        {\n            isLib = true;\n            libPos = q + 5;\n        }\n        q++;\n    }\n\n    if (isLib)\n    {\n        /* l<pkg> then every component after the package directory */\n        usize pkgEnd = libPos;\n        while (pkgEnd < pathLen && path[pkgEnd] != 47) pkgEnd++;\n        wvMbCh(w, 108); // 'l'\n        wvMbIdent(w, path + libPos, pkgEnd - libPos);\n        usize segStart = pkgEnd + 1;\n        /* platform dirs directly under the package (lib/std/x86_64/\n         * linux/error.crl) are build-host layout, not module identity:\n         * skip leading arch/os components. `target/x86_64` is real. */\n        u32 stripped = 0;\n        while (segStart < pathLen && stripped < 2)\n        {\n            usize segEnd = segStart;\n            while (segEnd < pathLen && path[segEnd] != 47) segEnd++;\n            if (!wvMbIsPlatformTag(w, path + segStart, segEnd - segStart)) break;\n            stripped++;\n            segStart = segEnd + 1;\n        }\n        usize i = segStart;\n        while (i <= pathLen)\n        {\n            if (i == pathLen || path[i] == 47)\n            {\n                if (i > segStart) wvMbIdent(w, path + segStart, i - segStart);\n                segStart = i + 1;\n            }\n            i++;\n        }\n        return;\n    }\n\n    /* local project files: the path relative to the entry file's\n     * directory (the module/use root), '/' as separator */\n    usize start = 0;\n    bool underRoot = false;\n    if (w->sema != null && w->sema->diag != null && w->sema->diag->fileCount > 0)\n    {\n        str entry = w->sema->diag->filePaths.at((usize)0);\n        usize dirLen = 0;\n        usize e = 0;\n        while (e < entry.len)\n        {\n            if (entry.ptr[e] == 47) dirLen = e + 1;\n            e++;\n        }\n        if (dirLen == 0)\n        {\n            underRoot = true;\n        }\n        else if (pathLen >= dirLen)\n        {\n            usize m = 0;\n            while (m < dirLen && path[m] == entry.ptr[m]) m++;\n            if (m == dirLen)\n            {\n                start = dirLen;\n                underRoot = true;\n            }\n        }\n    }\n    if (!underRoot && pathLen > 0 && path[0] == 47)\n    {\n        /* absolute path outside the entry's tree: keep only the stem so\n         * no system directories reach the symbol */\n        usize ls = 0;\n        usize i = 0;\n        while (i < pathLen)\n        {\n            if (path[i] == 47) ls = i + 1;\n            i++;\n        }\n        wvMbCh(w, 114); // 'r'\n        wvMbIdent(w, path + ls, pathLen - ls);\n        return;\n    }\n    while (start + 1 < pathLen && path[start] == 46 && path[start + 1] == 47)\n        start += 2;\n    wvMbCh(w, 102); // 'f'\n    usize segStart = start;\n    usize i = start;\n    while (i <= pathLen)\n    {\n        if (i == pathLen || path[i] == 47)\n        {\n            if (i > segStart) wvMbIdent(w, path + segStart, i - segStart);\n            segStart = i + 1;\n        }\n        i++;\n    }\n}\n\n/* scope root + path segments for the file declaring declId */\nvoid wvMbDeclScope(Wv* w, NodeId declId)\n{\n    u8* path = null;\n    usize pathLen = 0;\n    if (declId.index != 0 && w->sema != null && w->sema->diag != null)\n    {\n        Node* n = wvNode(w, declId);\n        u32 fid = locFile(n->loc);\n        if (fid < w->sema->diag->fileCount)\n        {\n            str fpath = w->sema->diag->filePaths.at((usize)fid);\n            if (fpath.ptr != null && fpath.len > 0)\n            {\n                path = (u8*)fpath.ptr;\n                pathLen = fpath.len;\n            }\n        }\n    }\n    if (pathLen == 0) { wvMbCh(w, 102); return; } // bare 'f'\n    wvMbPathScope(w, path, pathLen);\n}\n\n/* mangle.md type encoding. `subs` resolves TypeParam indices left in the\n * type by a generic declaration (instance arguments); the encoder\n * substitutes at any depth, unlike wvSubstTy (top-level only). Letters\n * beyond mangle.md's table: e=i128 q=u128 C=char Q<T>=slice U..E=tuple\n * D=variadic L<v>_=comptime int T<i>_=unresolved param. */\npub void wvMbTyEnc(Wv* w, Ty t, Ty* subs, u32 subsLen, u32 depth)\n{\n    if (t == 0 || depth > 10) { wvMbCh(w, 118); return; } // 'v'\n    TypeEntry* e = w->ctx->types + t;\n    switch (e->kind.tag)\n    {\n        TypeKind::Void => { wvMbCh(w, 118); },   // v\n        TypeKind::Bool => { wvMbCh(w, 98); },    // b\n        TypeKind::Char => { wvMbCh(w, 67); },    // C\n        TypeKind::I8 => { wvMbCh(w, 97); },      // a\n        TypeKind::U8 => { wvMbCh(w, 104); },     // h\n        TypeKind::I16 => { wvMbCh(w, 115); },    // s\n        TypeKind::U16 => { wvMbCh(w, 116); },    // t\n        TypeKind::I32 => { wvMbCh(w, 105); },    // i\n        TypeKind::U32 => { wvMbCh(w, 106); },    // j\n        TypeKind::I64 => { wvMbCh(w, 120); },    // x\n        TypeKind::U64 => { wvMbCh(w, 109); },    // m\n        TypeKind::I128 => { wvMbCh(w, 101); },   // e (not in mangle.md)\n        TypeKind::U128 => { wvMbCh(w, 113); },   // q (not in mangle.md)\n        TypeKind::F32 => { wvMbCh(w, 102); },    // f\n        TypeKind::F64 => { wvMbCh(w, 100); },    // d\n        TypeKind::Isize => { wvMbCh(w, 121); },  // y\n        TypeKind::Usize => { wvMbCh(w, 122); },  // z\n        TypeKind::Rawptr => { wvMbCh(w, 114); }, // r\n        TypeKind::Str => { wvMbCh(w, 83); },     // S\n        TypeKind::Error => { wvMbCh(w, 118); },  // v\n        TypeKind::Pointer => {\n            wvMbCh(w, 80); // P<T>\n            wvMbTyEnc(w, e->kind.payload.Pointer.base, subs, subsLen, depth + 1);\n        },\n        TypeKind::Const => {\n            wvMbCh(w, 75); // K<T>\n            wvMbTyEnc(w, e->kind.payload.Const.base, subs, subsLen, depth + 1);\n        },\n        TypeKind::Comptime => {\n            wvMbTyEnc(w, e->kind.payload.Comptime.base, subs, subsLen, depth + 1);\n        },\n        TypeKind::Slice => {\n            wvMbCh(w, 81); // Q<T> (not in mangle.md)\n            wvMbTyEnc(w, e->kind.payload.Slice.base, subs, subsLen, depth + 1);\n        },\n        TypeKind::Array => {\n            wvMbCh(w, 65); // A<n>_<T>\n            wvMbDec(w, (u64)e->kind.payload.Array.len);\n            wvMbCh(w, 95);\n            wvMbTyEnc(w, e->kind.payload.Array.base, subs, subsLen, depth + 1);\n        },\n        TypeKind::FnPtr => {\n            wvMbCh(w, 89); // Y<params>_<ret>E\n            u32 i = 0;\n            while (i < e->kind.payload.FnPtr.paramsLen)\n            {\n                wvMbTyEnc(w, e->kind.payload.FnPtr.params[i], subs, subsLen, depth + 1);\n                i++;\n            }\n            wvMbCh(w, 95);\n            wvMbTyEnc(w, e->kind.payload.FnPtr.returnType, subs, subsLen, depth + 1);\n            wvMbCh(w, 69);\n        },\n        TypeKind::Tuple => {\n            wvMbCh(w, 85); // U<elems>E (not in mangle.md)\n            u32 i = 0;\n            while (i < e->kind.payload.Tuple.elemsLen)\n            {\n                wvMbTyEnc(w, e->kind.payload.Tuple.elems[i], subs, subsLen, depth + 1);\n                i++;\n            }\n            wvMbCh(w, 69);\n        },\n        TypeKind::TypeParam => {\n            u32 idx = e->kind.payload.TypeParam.index;\n            if (subs != null && idx < subsLen && subs[idx] != 0 && subs[idx] != t)\n                wvMbTyEnc(w, subs[idx], subs, subsLen, depth + 1);\n            else\n            {\n                wvMbCh(w, 84); // T<i>_\n                wvMbDec(w, (u64)idx);\n                wvMbCh(w, 95);\n            }\n        },\n        TypeKind::ValueInt => {\n            wvMbCh(w, 76); // L<value>_\n            wvMbDec(w, e->kind.payload.ValueInt.value);\n            wvMbCh(w, 95);\n        },\n        TypeKind::Named => {\n            /* N root segments <type ident [I args E]> E */\n            wvMbCh(w, 78);\n            Str tn = e->kind.payload.Named.name;\n            NodeId td = wvFindTypeDecl(w, tn);\n            if (td.index != 0) wvMbDeclScope(w, td);\n            else wvMbCh(w, 102); // 'f' — opaque name only\n            wvMbIdentStr(w, wvStr(w, tn));\n            u32 gl = e->kind.payload.Named.genericArgsLen;\n            if (gl > 0)\n            {\n                wvMbCh(w, 73); // I\n                u32 i = 0;\n                while (i < gl)\n                {\n                    wvMbTyEnc(w, e->kind.payload.Named.genericArgs[i], subs, subsLen, depth + 1);\n                    i++;\n                }\n                wvMbCh(w, 69); // E\n            }\n            wvMbCh(w, 69);\n        },\n    }\n}\n\n/* emit \"<param encs>_<ret>\" — the caller writes the F prefix. The self\n * parameter (if any) is encoded by the M marker, not here. */\nvoid wvMbSig(Wv* w, Decl* d, Ty* subs, u32 subsLen)\n{\n    u32 np = d->kind.payload.Func.paramsLen;\n    u32 i = 0;\n    while (i < np)\n    {\n        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);\n        if (pn->kind.tag == NodeKind::Param)\n        {\n            Param* pp = &pn->kind.payload.Param.value;\n            if ((pp->flags & 1) != 0) { i++; continue; } // self lives in M\n            if ((pp->flags & 16) != 0) wvMbCh(w, 68);    // D — variadic\n            else wvMbTyEnc(w, pp->typeNode, subs, subsLen, 0);\n        }\n        i++;\n    }\n    wvMbCh(w, 95); // '_'\n    wvMbTyEnc(w, d->kind.payload.Func.returnType, subs, subsLen, 0);\n}\n\n/* compute the final linker name for a decl: raw for exempt decls, else\n * `_C N <root> <segments> <name> E <kind-suffix>`. The result is owned\n * by the reusable mangle buffer — copy it (via createFunc's irDupStr)\n * before the next wvMangle call. */\npub str wvMangle(Wv* w, NodeId declId, Str name)\n{\n    if (name == 0) return str::empty();\n    str nm = wvStr(w, name);\n    if (wvMangleExempt(w, declId, nm)) return nm;\n\n    wvMbReset(w);\n    wvMbP(w, \"_C\");\n    wvMbCh(w, 78); // N\n    wvMbDeclScope(w, declId);\n    wvMbIdentStr(w, nm);\n\n    Node* dn = null;\n    Decl* d = null;\n    if (declId.index != 0)\n    {\n        dn = wvNode(w, declId);\n        if (dn->kind.tag == NodeKind::Decl) d = &dn->kind.payload.Decl.value;\n    }\n    wvMbCh(w, 69); // E\n    if (d != null && d->kind.tag == DeclKind::Func)\n    {\n        wvMbCh(w, 70); // F\n        wvMbSig(w, d, null, 0);\n    }\n    else\n    {\n        wvMbCh(w, 71); // G\n    }\n    return wvMbStr(w);\n}\n\n/* declare an IrFunc shell for a Func decl under an already-composed\n * symbol name; selfTy, when non-null, is prepended as parameter 0 —\n * the receiver of a method whose Coral params never spell `self`.\n * ptypes comes from the Wv arena: wallvm stores the pointer in the\n * interned Func type for its whole lifetime. */\nIrFunc* wvDeclareFuncNamed(Wv* w, NodeId declId, Decl* d, str name, IrType* selfTy)\n{\n    /* stabilize the symbol before any wvTy below: instance-typed\n     * signatures rewrite w->mb through wvTypeInstanceName, and `name`\n     * is a view into it (the caller's compose would silently become\n     * the instance type name) */\n    if (name.ptr != null && name.len > 0)\n    {\n        Str ni = w->ctx->intern(name);\n        if (ni != 0) name = wvStr(w, ni);\n    }\n    IrType* retTy = wvTy(w, d->kind.payload.Func.returnType, 0);\n\n    u32 np = d->kind.payload.Func.paramsLen;\n    u32 extra = selfTy != null ? 1 : 0;\n    u32 realNp = 0;\n    IrType** ptypes = null;\n    if (np + extra > 0) ptypes = (IrType**)wvArr(w, (usize)(np + extra), 8);\n    if (selfTy != null && ptypes != null) { ptypes[0] = selfTy; realNp = 1; }\n    bool hasVararg = false;\n    u32 i = 0;\n    while (i < np)\n    {\n        Node* pn = wvNode(w, d->kind.payload.Func.params[i]);\n        if (pn->kind.tag == NodeKind::Param)\n        {\n            Param* pp = &pn->kind.payload.Param.value;\n            if ((pp->flags & 16) != 0) { hasVararg = true; i++; continue; }\n            ptypes[realNp] = wvTy(w, pp->typeNode, 0);\n            realNp++;\n        }\n        i++;\n    }\n    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);\n    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);\n    if ((d->kind.payload.Func.flags & 2) != 0)\n    {\n        f->isExtern = true;\n        /* wallvm externs registry: import-table/linker consumption reads\n         * {isExtern, externLib, externSym}. `extern(\"lib\")` carries the\n         * library; a bare extern leaves it empty (default libs). The\n         * symbol the import binds is the raw name — externs are\n         * mangle-exempt, so base.name is already it. */\n        Str lib = d->kind.payload.Func.externLib;\n        if (lib != 0) f->externLib = wvStr(w, lib);\n        f->externSym = f->base.name;\n    }\n    return f;\n}\n\n/* declare an IrFunc (extern or forward shell) for a Func decl; returns\n * the func, or null on error. */\npub IrFunc* wvDeclareFunc(Wv* w, NodeId declId, Decl* d)\n{\n    str name = wvMangle(w, declId, d->kind.payload.Func.name);\n    return wvDeclareFuncNamed(w, declId, d, name, null);\n}\n\n/* declare the shell for a method under its `owner_method` symbol */\npub IrFunc* wvDeclareMethod(Wv* w, NodeId mdef, Decl* d, str name, IrType* selfTy)\n{\n    return wvDeclareFuncNamed(w, mdef, d, name, selfTy);\n}\n\n/* how a method receives its receiver: 0 = static (no receiver), 1 =\n * implicit `self` (the receiver becomes parameter 0 — the only form\n * the parser accepts), 2 = an explicit self parameter (reserved,\n * rejected at parse time; kept so a half-parsed tree still lowers). */\npub u8 wvMethodSelfKind(Wv* w, NodeId mdef)\n{\n    Node* mn = wvNode(w, mdef);\n    if (mn->kind.tag != NodeKind::Decl) return 1;\n    Decl* md = &mn->kind.payload.Decl.value;\n    if (md->kind.tag != DeclKind::Func) return 1;\n    if ((md->kind.payload.Func.flags & 4) != 0) return 0; // static\n    if (md->kind.payload.Func.paramsLen > 0)\n    {\n        Node* p0 = wvNode(w, md->kind.payload.Func.params[0]);\n        if (p0->kind.tag == NodeKind::Param && (p0->kind.payload.Param.value.flags & 1) != 0)\n            return 2;\n    }\n    return 1;\n}\n\n/* the owner name a method symbol composes: def side (an extend's self\n * type) and call side (the receiver's type) both run it, so the two\n * spellings always agree. Pointer stripped like cgOwnerName; a generic\n * instance composes its `Vec_str`-style instance base; 0 when the type\n * has no bare name. Inside an instance body the active substitutions\n * are applied first so `self: Vec<T>` reaches the concrete instance. */\npub Str wvOwnerStr(Wv* w, Ty selfTy)\n{\n    if (selfTy == 0) return 0;\n    if (w->subsLen > 0) selfTy = wvSubstTy(w, selfTy);\n    if (selfTy == 0) return 0;\n    /* strip qualifiers/pointers in any order and depth — `const String*`\n     * parses as Const(Pointer(…)), which a pointer-first single step\n     * fell through on (owner 0 → \"cannot compose the method symbol\");\n     * the receiver resolver unwraps the same way */\n    Ty u = selfTy;\n    u32 guard = 0;\n    while (u != 0 && guard < 8)\n    {\n        guard++;\n        TypeEntry* ue = w->ctx->types + u;\n        if (ue->kind.tag == TypeKind::Pointer) u = ue->kind.payload.Pointer.base;\n        else if (ue->kind.tag == TypeKind::Const) u = ue->kind.payload.Const.base;\n        else if (ue->kind.tag == TypeKind::Comptime) u = ue->kind.payload.Comptime.base;\n        else break;\n    }\n    if (u == 0) return 0;\n    TypeEntry* ue = w->ctx->types + u;\n    if (ue->kind.tag == TypeKind::Named)\n    {\n        if (ue->kind.payload.Named.genericArgsLen != 0)\n        {\n            /* a receiver inside a generic body carries the raw type param\n             * (`self` in Vec<T>::push is Pointer(Named Vec<T>)) —\n             * wvSubstTy only matches a top-level TypeParam, so substitute\n             * each arg before composing the instance name, or the owner\n             * comes out `Vec_T0` and matches no decl or instance */\n            u32 gl = ue->kind.payload.Named.genericArgsLen;\n            Ty* ga = (Ty*)wvArr(w, (usize)gl, 4);\n            if (ga == null) return 0;\n            u32 gi = 0;\n            while (gi < gl)\n            {\n                ga[gi] = wvSubstTy(w, ue->kind.payload.Named.genericArgs[gi]);\n                gi++;\n            }\n            Str r = wvTypeInstanceName(w, ue->kind.payload.Named.name, ga, gl);\n            dealloc<Ty>(ga);\n            return r;\n        }\n        return ue->kind.payload.Named.name;\n    }\n    if (ue->kind.tag == TypeKind::Str) return w->ctx->tyIdxStrLit();\n    if (ue->kind.tag == TypeKind::Slice) return w->ctx->tyIdxSliceLit2();\n    if (ue->kind.tag == TypeKind::Rawptr) return w->ctx->tyIdxRawptrLit2();\n    return 0;\n}\n\n/* `<self>` marker for a method: v (implicit by-value receiver — the\n * pointer in lowering is an implementation detail), p (explicit self*),\n * c (explicit const self*), or 0 when the method is static (no M). */\nu8 wvSelfCode(Wv* w, NodeId mdef)\n{\n    u8 sk = wvMethodSelfKind(w, mdef);\n    if (sk == 0) return 0;\n    if (sk != 2) return 118; // 'v'\n    Node* mn = wvNode(w, mdef);\n    if (mn->kind.tag != NodeKind::Decl) return 118;\n    Decl* md = &mn->kind.payload.Decl.value;\n    if (md->kind.tag != DeclKind::Func || md->kind.payload.Func.paramsLen == 0) return 118;\n    Node* p0 = wvNode(w, md->kind.payload.Func.params[0]);\n    if (p0->kind.tag != NodeKind::Param) return 118;\n    Ty pt = p0->kind.payload.Param.value.typeNode;\n    if (pt == 0) return 118;\n    TypeEntry* pe = w->ctx->types + pt;\n    if (pe->kind.tag == TypeKind::Const)\n    {\n        Ty b = pe->kind.payload.Const.base;\n        if (b != 0 && (w->ctx->types + b)->kind.tag == TypeKind::Pointer) return 99; // 'c'\n        return 118;\n    }\n    if (pe->kind.tag == TypeKind::Pointer)\n    {\n        Ty b = pe->kind.payload.Pointer.base;\n        if (b != 0 && (w->ctx->types + b)->kind.tag == TypeKind::Const) return 99; // 'c'\n        return 112; // 'p'\n    }\n    return 118;\n}\n\n/* method symbol: `_C N <path> <owner segment>[I args E]<method> E <M?>F sig`\n * — the owner is the `owner` string composed by wvOwnerStr on both the\n * def and call sides; args come from the instance substitution list or,\n * when absent, from selfTy's Named generic arguments (instance methods). */\npub str wvMethodMangleEx(Wv* w, NodeId mdef, Str owner, Ty selfTy, Ty* subs,\n                         u32 subsLen, Str methName)\n{\n    if (owner == 0 || methName == 0) return str::empty();\n    str own = wvStr(w, owner);\n    str mn = wvStr(w, methName);\n    wvMbReset(w);\n    wvMbP(w, \"_C\");\n    wvMbCh(w, 78); // N\n    wvMbDeclScope(w, mdef);\n    wvMbIdentStr(w, own);\n\n    Ty* ga = subs;\n    u32 gl = subsLen;\n    if (gl == 0 && ga == null && selfTy != 0)\n    {\n        /* peel qualifiers and pointers to the receiver's Named type */\n        Ty u = selfTy;\n        u32 guard = 0;\n        while (u != 0 && guard < 8)\n        {\n            TypeEntry* ue = w->ctx->types + u;\n            if (ue->kind.tag == TypeKind::Pointer) u = ue->kind.payload.Pointer.base;\n            else if (ue->kind.tag == TypeKind::Const) u = ue->kind.payload.Const.base;\n            else if (ue->kind.tag == TypeKind::Comptime) u = ue->kind.payload.Comptime.base;\n            else break;\n            guard++;\n        }\n        if (u != 0)\n        {\n            TypeEntry* ue = w->ctx->types + u;\n            if (ue->kind.tag == TypeKind::Named)\n            {\n                ga = ue->kind.payload.Named.genericArgs;\n                gl = ue->kind.payload.Named.genericArgsLen;\n            }\n        }\n    }\n    /* inside a generic body the receiver's args can still be TypeParams\n     * (`Vec<T>` in Vec<T>::sortBy); resolve them through the active\n     * instance substitutions so def and call sides encode the same\n     * concrete types */\n    Ty* eff = ga;\n    u32 effLen = gl;\n    if (ga != null && gl > 0 && w->subsLen > 0)\n    {\n        Ty* tmp = (Ty*)wvArr(w, (usize)gl, 4);\n        if (tmp != null)\n        {\n            u32 i = 0;\n            while (i < gl) { tmp[i] = wvSubstTy(w, ga[i]); i++; }\n            eff = tmp;\n            effLen = gl;\n        }\n    }\n    if (effLen > 0 && eff != null)\n    {\n        wvMbCh(w, 73); // I\n        u32 i = 0;\n        while (i < effLen)\n        {\n            wvMbTyEnc(w, eff[i], null, 0, 0);\n            i++;\n        }\n        wvMbCh(w, 69); // E\n    }\n    wvMbIdentStr(w, mn);\n    wvMbCh(w, 69); // E\n\n    u8 sc = wvSelfCode(w, mdef);\n    if (sc != 0) { wvMbCh(w, 77); wvMbCh(w, sc); } // M<c>\n    wvMbCh(w, 70); // F\n    Node* mn2 = wvNode(w, mdef);\n    if (mn2->kind.tag == NodeKind::Decl && mn2->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        wvMbSig(w, &mn2->kind.payload.Decl.value, eff, effLen);\n    return wvMbStr(w);\n}\n\n/* path/static-call form: no receiver type, no substitutions */\npub str wvMethodMangle(Wv* w, NodeId mdef, Str owner, Str methName)\n{\n    return wvMethodMangleEx(w, mdef, owner, 0, null, 0, methName);\n}\n\n/* an instance's symbol: the generic args attach to the name segment\n * (I…E), a value-specialized instance appends `W<hex>_`, and the F\n * suffix encodes the concrete parameter and return types. The instance\n * index is gone: identical specializations are deduped by mono and\n * must compose the same symbol. */\npub str wvInstanceSymbol(Wv* w, MonoInstance* inst, u32 idx)\n{\n    if (inst == null || inst->name == 0) return str::empty();\n    wvMbReset(w);\n    wvMbP(w, \"_C\");\n    wvMbCh(w, 78); // N\n    wvMbDeclScope(w, inst->declaration);\n    wvMbIdentStr(w, wvStr(w, inst->name));\n    if (inst->argumentsLen > 0 && inst->arguments != null)\n    {\n        wvMbCh(w, 73); // I\n        u32 i = 0;\n        while (i < inst->argumentsLen)\n        {\n            wvMbTyEnc(w, inst->arguments[i], null, 0, 0);\n            i++;\n        }\n        wvMbCh(w, 69); // E\n    }\n    if (inst->valueKey != 0)\n    {\n        wvMbCh(w, 87); // W\n        wvMbHex(w, inst->valueKey);\n        wvMbCh(w, 95); // _\n    }\n    wvMbCh(w, 69); // E\n    wvMbCh(w, 70); // F\n    u32 pi = 0;\n    while (pi < inst->paramTypesLen)\n    {\n        wvMbTyEnc(w, inst->paramTypes[pi], null, 0, 0);\n        pi++;\n    }\n    u32 ti = 0;\n    while (ti < inst->tailLen)\n    {\n        wvMbTyEnc(w, inst->tailTypes[ti], null, 0, 0);\n        ti++;\n    }\n    wvMbCh(w, 95); // '_'\n    wvMbTyEnc(w, inst->returnType, null, 0, 0);\n    return wvMbStr(w);\n}\n\n/* declare the IrFunc for a monomorphised function instance: fixed\n * params carry the instance's substituted types, and the vararg slot is\n * either specialized into named tail params (the rewritten body\n * references them by name) or kept as a real `...` */\npub IrFunc* wvDeclareInstanceFunc(Wv* w, MonoInstance* inst, str name)\n{\n    Node* dn = wvNode(w, inst->declaration);\n    if (dn->kind.tag != NodeKind::Decl) return null;\n    Decl* dd = &dn->kind.payload.Decl.value;\n    if (dd->kind.tag != DeclKind::Func) return null;\n    /* same mb-stabilization as wvDeclareFuncNamed: substituted\n     * signatures may rewrite the view `name` points into */\n    if (name.ptr != null && name.len > 0)\n    {\n        Str ni = w->ctx->intern(name);\n        if (ni != 0) name = wvStr(w, ni);\n    }\n    IrType* retTy = wvTy(w, inst->returnType, 0);\n    u32 np = dd->kind.payload.Func.paramsLen;\n    u32 max = np + inst->tailLen + 1;\n    IrType** ptypes = null;\n    if (max > 0) ptypes = (IrType**)wvArr(w, (usize)max, 8);\n    if (max > 0 && ptypes == null) return null;\n    u32 realNp = 0;\n    bool hasVararg = false;\n    u32 i = 0;\n    while (i < np)\n    {\n        Node* pn = wvNode(w, dd->kind.payload.Func.params[i]);\n        if (pn->kind.tag == NodeKind::Param)\n        {\n            Param* pp = &pn->kind.payload.Param.value;\n            if ((pp->flags & 16) != 0)\n            {\n                if (inst->tailLen > 0 && inst->tailArgNames != null)\n                {\n                    u32 k = 0;\n                    while (k < inst->tailLen)\n                    {\n                        Ty tt = inst->tailTypes[k];\n                        if (tt != 0 && (w->ctx->types + tt)->kind.tag == TypeKind::Array)\n                            ptypes[realNp] = w->ir->tyPtr(\n                                wvTy(w, (w->ctx->types + tt)->kind.payload.Array.base, 0));\n                        else\n                            ptypes[realNp] = wvTy(w, tt, 0);\n                        realNp++;\n                        k++;\n                    }\n                }\n                else\n                    hasVararg = true;\n                i++;\n                continue;\n            }\n            Ty pt = i < inst->paramTypesLen ? inst->paramTypes[i] : pp->typeNode;\n            ptypes[realNp] = wvTy(w, pt, 0);\n            realNp++;\n        }\n        i++;\n    }\n    IrFunc* f = w->ir->createFunc(name, retTy, ptypes, realNp);\n    if (f == null) return null;\n    if (hasVararg) f->base.type = w->ir->tyFunc(retTy, ptypes, realNp, true);\n    return f;\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-backend/codegen.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* backend/codegen.crl: analyzed AST → flat C.\n *\n * Output shape: labels + gotos for control flow, three-address temporaries\n * for expression evaluation (declared at function entry). Types come from\n * Sema's resolvedType / the TypeKind table only: no name heuristics.\n *\n * The C is built into per-section Streams (all arena-owned) and assembled\n * once at the end by generateC; nothing is written to disk here.\n */\nuse context::context { AstContext, InternEntry };\nuse build::arena { Arena };\nimport core::error { __panic };\nuse common::slice { Slice };\nuse mono::mono { MonoContext, MonoSubstitution, MonoInstance, MonoInstanceKind };\nuse diag { engine { DiagnosticEngine }, code { ErrorCode } };\nuse sem {\n    sema { Sema },\n    scope { Symbol, ScopeStack }\n};\n\nuse ast { \n    id { Str, NodeId, locFile, SourceLoc },\n    types { Ty, TypeEntry, TypeKind },\n    node { Node, NodeKind },\n    expr { Expr, ExprKind, builtinImplHash,\n           BUILTIN_ASSERT, BUILTIN_ASSERTOUT, BUILTIN_PANIC, BUILTIN_UNREACHABLE,\n           BUILTIN_REPORT, BUILTIN_REPORTHEX, BUILTIN_ABORTNOW, BUILTIN_ASSERTEQ,\n           BUILTIN_ASSERTNE, BUILTIN_ASSERTLT, BUILTIN_ASSERTLE, BUILTIN_ASSERTGT,\n           BUILTIN_ASSERTGE, BUILTIN_ASSERTRANGE, BUILTIN_ASSERTNONNULL,\n           BUILTIN_ASSERTALIGNED, BUILTIN_BACKTRACETO },\n    stmt { Stmt, StmtKind, SwitchCase },\n    decl { Decl, DeclKind, File, Param, Field, EnumVariant, VariantVariant,\n           ATTR_INLINE, ATTR_INLINE_ALWAYS, ATTR_NO_MANGLE },\n    pat { Pat, PatKind }\n};\n\nimport std::mman { alloc, dealloc, realloc, zero };\nimport platform::libc { printf };\n\n// use platform libc, and then for allocations, i will refactor the whole allocator to use std::mman::alloc\n\npub struct CodegenResult\n{\n    Slice cCode;\n    u32 errors;\n}\n\n/* append-only output buffer; every section of the generated C (typedefs,\n * prototypes, bodies, …) is one. All streams live in the codegen arena:\n * individual buffers are never freed, the whole arena dies at once.\n * NUL-terminated after every write, so stTail slices pass as C strings. */\npub struct Stream\n{\n    u8* p;\n    usize len;\n    usize cap;\n    Arena* arena;\n}\n\npub Stream stNew(Arena* a, usize cap)\n{\n    Stream s;\n    s.arena = a;\n    s.cap = cap;\n    s.len = 0;\n    s.p = (u8*)a->alloc(cap, 1);\n    /* an exhausted arena would make every later stPut silently drop its\n     * bytes: stop with a clear message instead of emitting corrupt C */\n    if (s.p == null) __panic(\"coralc:\\nThe compiler could not allocate memory.\\nTry coralc --explain D0003\\n\");\n    return s;\n}\n\nvoid stPut(Stream* s, u8* data, usize n)\n{\n    if (s->p == null || s->arena == null)  __panic(\"coralc:\\nThe compiler could not allocate memory\\nTry coralc --explain D0003\\n\");\n    if (s->len + n + 1 > s->cap)\n    {\n        usize nc = s->cap * 2;\n        while (nc < s->len + n + 1) nc *= 2;\n        u8* np = (u8*)s->arena->alloc(nc, 1);\n        if (np == null)  __panic(\"coralc:\\nThe compiler could not allocate memory.\\nTry coralc --explain D0003\\n\");\n        memcpy(np, s->p, s->len);\n        s->p = np;\n        s->cap = nc;\n    }\n    memcpy(s->p + s->len, data, n);\n    s->len += n;\n    s->p[s->len] = 0;\n}\n\nvoid stP(Stream* s, str text)\n{\n    if (text.ptr == null) return;\n    stPut(s, (u8*)text.ptr, text.len);\n}\n\nvoid stPS(Stream* s, Slice v)\n{\n    if (v.ptr == null) return;\n    stPut(s, v.ptr, v.len);\n}\n\nvoid stCh(Stream* s, u8 c)\n{\n    stPut(s, &c, 1);\n}\n\nvoid stU64(Stream* s, u64 n)\n{\n    if (n == 0) {\n        stCh(s, '0');\n        return;\n    }\n    u64 div = 1;\n    while (n / div >= 10) div *= 10;\n    while (div > 0) {\n        stCh(s, (u8)(48 + ((n / div) % 10)));\n        div /= 10;\n    }\n}\n\nvoid stI64(Stream* s, i64 n)\n{\n    if (n < 0) {\n        stCh(s, '-');\n        /* 0 - n, not -n: negating the most-negative i64 is UB */\n        stU64(s, (u64)(0 - n));\n    } else {\n        stU64(s, (u64)n);\n    }\n}\n\n/* slice of [start, len), valid only until the next write: growth\n * reallocates and every slice points into the old buffer */\nSlice stTail(Stream* s, usize start)\n{\n    if (start > s->len) return Slice::from(null, 0);\n    return Slice::from(s->p + start, s->len - start);\n}\n\n/* cut back to a length a caller recorded before speculatively emitting\n * statements (while/for condition probes). The mark is a length, not a\n * pointer, so a realloc in between is harmless. */\nvoid stTrunc(Stream* s, usize n)\n{\n    if (n > s->len) return;\n    s->len = n;\n    s->p[s->len] = 0;\n}\n\nvoid stNL(Stream* s, u32 ind)\n{\n    stCh(s, '\\n');\n    u32 i = 0;\n    while (i < ind) {\n        stP(s, \"    \");\n        i += 1;\n    }\n}\n\n/* stream roles: out = the assembled result; fwd = forward typedefs and\n * use-alias #defines; defs = type defs + file-scope constants;\n * protos = function prototypes; bodies = finished bodies; body = the\n * body currently being built (reset per function); ebuf = expression\n * text scratch; tybuf = C type text / mangled-name scratch; tdecl =\n * registered slice/tuple/fn-pointer typedefs */\n/* one live local whose type declares `drop`: unwound innermost-first at\n * scope exit, on `return`, and on `break`/`continue` */\nstruct DropEntry\n{\n    Str name;\n    Ty typeNode;\n    NodeId mdef;\n}\n\npub struct Codegen\n{\n    AstContext* ctx;\n    File* file;\n    MonoContext* mono;\n    Sema* sema;\n    Arena* arena;\n    Stream out;\n    Stream fwd;\n    Stream defs;\n    Stream protos;\n    Stream bodies;\n    Stream body;\n    Stream ebuf;\n    Stream tybuf;\n    Stream tdecl;\n    /* alias/distinct/enum typedefs — emitted before tdecl so fn-pointer\n     * typedefs can name them */\n    Stream typedefs;\n    /* C-symbol registries for mono instances: alias-equal coral args\n     * (`u32`, `Str`, `Ty`) spell one C type, so several instances can\n     * compose the same symbol — emit it once per phase */\n    Slice* protoFnNames;\n    u32 protoFnLen;\n    u32 protoFnCap;\n    Slice* bodyFnNames;\n    u32 bodyFnLen;\n    u32 bodyFnCap;\n    MonoSubstitution* subs;\n    u32 subsLen;\n    u32 errors;\n\n    /* file-scope `var` globals whose initializer is not a C constant:\n     * storage stays zero-initialized and coral_globals_init() — a C\n     * constructor — assigns before main runs */\n    NodeId* dynInits;\n    u32 dynInitsLen;\n    u32 dynInitsCap;\n    /* recursion budget while folding `const` refs into initializers:\n     * a self-referential const errors instead of looping */\n    u32 foldDepth;\n\n    /* per-function emission state: __L<labelSeq> gotos, __t<tempsLen>\n     * temporaries (all declared at the function top) */\n    u32 labelSeq;\n    u32 tempSeq;\n    /* per-temp result type + array length (tempArrs is parallel to\n     * tempTys; only meaningful for array-typed temps) */\n    Slice* tempTys;\n    u32* tempArrs;\n    u32 tempsCap;\n    u32 tempsLen;\n\n    u32 loopDepth;\n    u32 loopCap;\n    u32* breakKinds;\n    u32* breakLabels;\n    u32 breakDepth;\n    u32 switchSeq;\n\n    /* RAII unwinding: drops is a stack of live locals with a resolved\n     * drop method; fnDropMark is its base for the current function,\n     * loopDropMarks[k] / breakDropMarks[k] record the stack length at\n     * the entry of loop k / breakable construct k so `break`/`continue`\n     * unwind exactly the scopes they exit */\n    DropEntry* drops;\n    u32 dropsLen;\n    u32 dropsCap;\n    u32 fnDropMark;\n    u32* loopDropMarks;\n    u32* breakDropMarks;\n\n    // small inline cache for cgFindDecl: the heaviest per-call scan\n    Str* declCacheNames;\n    u32* declCacheIds;\n    u32* declCacheTags;\n    u32 declCacheLen;\n\n    /* names bound in the current function (params, locals, loop/pattern\n     * binds): Ident refs to these stay raw, everything else goes\n     * through cgResolveRef → cgMangle */\n    Str* localNames;\n    u32 localNamesLen;\n    u32 localNamesCap;\n\n    /* registry of emitted slice/tuple/fn-pointer typedef texts: cgRegName\n     * dedups against these and emits dependencies first */\n    Slice* regNames;\n    u32 regLen;\n    u32 regCap;\n\n    u32 ind;\n}\n\nvoid cgError(Codegen* cg, str msg)\n{\n    cg->errors++;\n    if (cg->sema != null)\n    {\n        SourceLoc loc;\n        loc.data = 0;\n        cg->sema->semaError(ErrorCode::CodegenInternal, loc, msg);\n    }\n}\n\n/* codegen failure with a source position, so it renders like every other\n * diagnostic instead of surfacing as a gcc error in generated C */\nvoid cgErrorAt(Codegen* cg, NodeId at, str msg)\n{\n    cg->errors++;\n    if (cg->sema == null) return;\n    if (at.index != 0)\n    {\n        cg->sema->semaErrorNode(ErrorCode::CodegenInternal, at, msg);\n        return;\n    }\n    SourceLoc loc;\n    loc.data = 0;\n    cg->sema->semaError(ErrorCode::CodegenInternal, loc, msg);\n}\n\n/* G0001 instead of G0002: the language construct itself is fine, C's\n * file-scope rules just cannot express it as written */\nvoid cgErrorUnsupported(Codegen* cg, NodeId at, str msg)\n{\n    cg->errors++;\n    if (cg->sema == null) return;\n    if (at.index != 0)\n    {\n        cg->sema->semaErrorNode(ErrorCode::CodegenUnsupported, at, msg);\n        return;\n    }\n    SourceLoc loc;\n    loc.data = 0;\n    cg->sema->semaError(ErrorCode::CodegenUnsupported, loc, msg);\n}\n\nu32 cgLabel(Codegen* cg)\n{\n    cg->labelSeq++;\n    return cg->labelSeq;\n}\n\n/* hand out the next temp slot. arrLen is vestigial: array declarators\n * are split at the first '[' in cgEmitFuncCommon instead. */\nu32 cgNewTemp(Codegen* cg, Slice ty, u32 arrLen)\n{\n    if (cg->tempsLen >= cg->tempsCap) {\n        cgError(cg, \"temp capacity exceeded\");\n        return 0;\n    }\n    u32 t = cg->tempsLen;\n    cg->tempTys[t] = ty;\n    cg->tempArrs[t] = arrLen;\n    cg->tempsLen++;\n    return t;\n}\n\nSlice cgTempName(Codegen* cg, u32 t)\n{\n    usize start = cg->tybuf.len;\n    stP(&cg->tybuf, \"__t\");\n    stU64(&cg->tybuf, (u64)t);\n    return stTail(&cg->tybuf, start);\n}\n\nvoid cgPopLoop(Codegen* cg)\n{\n    if (cg->loopDepth > 0) cg->loopDepth--;\n    if (cg->breakDepth > 0) cg->breakDepth--;\n}\n\n/* mark = cg.dropsLen at the loop's entry; `continue`/`break` unwind to it */\nvoid cgPushLoop(Codegen* cg, u32 mark)\n{\n    if (cg->loopDepth < 64) cg->loopDropMarks[cg->loopDepth] = mark;\n    cg->loopDepth++;\n    if (cg->breakDepth < 64)\n    {\n        cg->breakKinds[cg->breakDepth] = 0;\n        cg->breakLabels[cg->breakDepth] = 0;\n        cg->breakDropMarks[cg->breakDepth] = mark;\n        cg->breakDepth++;\n    }\n}\n\nvoid cgPushSwitch(Codegen* cg, u32 label, u32 mark)\n{\n    if (cg->breakDepth < 64)\n    {\n        cg->breakKinds[cg->breakDepth] = 1;\n        cg->breakLabels[cg->breakDepth] = label;\n        cg->breakDropMarks[cg->breakDepth] = mark;\n        cg->breakDepth++;\n    }\n}\n\nvoid cgPushDrop(Codegen* cg, Str name, Ty ty, NodeId mdef)\n{\n    if (cg->dropsLen >= cg->dropsCap)\n    {\n        cgError(cg, \"too many live locals with drop methods\");\n        return;\n    }\n    DropEntry e;\n    e.name = name;\n    e.typeNode = ty;\n    e.mdef = mdef;\n    cg->drops[cg->dropsLen] = e;\n    cg->dropsLen++;\n}\n\nvoid cgEmitDropEntry(Codegen* cg, DropEntry* e)\n{\n    Ty ty = cgTyUnwrap(cg, cgSubstTy(cg, e->typeNode));\n    if (ty == 0) return;\n    Slice owner = cgOwnerName(cg, ty);\n    usize cs = cg->ebuf.len;\n    stPS(&cg->ebuf, owner);\n    stCh(&cg->ebuf, '_');\n    stPS(&cg->ebuf, cgIntern(cg, cg->ctx->intern(\"drop\")));\n    Slice raw = stTail(&cg->ebuf, cs);\n    Slice callee = cgMangleS(cg, e->mdef, raw, 0);\n    stNL(&cg->body, cg->ind);\n    stPS(&cg->body, callee);\n    stP(&cg->body, \"(&\");\n    stPS(&cg->body, cgIdent(cg, e->name));\n    stP(&cg->body, \");\");\n}\n\n/* emit `T_drop(&name);` for every live local above `mark`, innermost\n * first; the stack is popped as a side effect */\nvoid cgEmitDropsTo(Codegen* cg, u32 mark)\n{\n    cgEmitDropsExcept(cg, mark, -1);\n}\n\n/* like cgEmitDropsTo but skips one stack slot (`skip` = moved-out local,\n * `return s;`): the skipped local transfers ownership to the caller */\nvoid cgEmitDropsExcept(Codegen* cg, u32 mark, i32 skip)\n{\n    i32 i = (i32)cg->dropsLen - 1;\n    while (i >= (i32)mark)\n    {\n        if (i != skip) cgEmitDropEntry(cg, &cg->drops[i]);\n        i--;\n    }\n    /* scope end: pop the locals above `mark`. never raise: a branch that\n     * already unwound (return/break/continue) leaves dropsLen below the\n     * stale marks captured in enclosing scopes; restoring such a mark\n     * would resurrect dead entries and later scope exits would emit\n     * duplicate drops for live locals */\n    if (cg->dropsLen > mark) cg->dropsLen = mark;\n}\n\n/* branch unwind: emits the drops for a return/break/continue but leaves\n * the live set alone. the statements after the branch still run on the\n * other paths and keep their registrations */\nvoid cgEmitDropsBranch(Codegen* cg, u32 mark, i32 skip)\n{\n    i32 i = (i32)cg->dropsLen - 1;\n    while (i >= (i32)mark)\n    {\n        if (i != skip) cgEmitDropEntry(cg, &cg->drops[i]);\n        i--;\n    }\n}\n\n/* index of the innermost live local named `name`, or -1 */\ni32 cgFindDrop(Codegen* cg, Str name)\n{\n    if (name == 0) return -1;\n    i32 i = (i32)cg->dropsLen - 1;\n    while (i >= 0)\n    {\n        if (cg->drops[i].name == name) return i;\n        i--;\n    }\n    return -1;\n}\n\nvoid cgRemoveDropAt(Codegen* cg, u32 idx)\n{\n    if (idx >= cg->dropsLen) return;\n    u32 i = idx;\n    while (i + 1 < cg->dropsLen)\n    {\n        cg->drops[i] = cg->drops[i + 1];\n        i++;\n    }\n    cg->dropsLen--;\n}\n\n/* a bare identifier argument is passed by value: the callee takes\n * ownership, so the caller's pending drop is cancelled (same discipline\n * as `return s;` and `T x = y;` moves). Without this the caller would\n * drop a buffer the callee already owns (double free). */\nvoid cgMoveArg(Codegen* cg, NodeId arg)\n{\n    Node* an = cgNode(cg, arg);\n    if (an->kind.tag != NodeKind::Expr) return;\n    if (an->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return;\n    i32 mv = cgFindDrop(cg, an->kind.payload.Expr.value.kind.payload.Ident.name);\n    if (mv >= 0) cgRemoveDropAt(cg, (u32)mv);\n}\n\n/* consuming methods `x.dispose()` / `x.free()` release the receiver\n * immediately: cancel its pending drop so a later automatic drop at a\n * scope exit cannot free the same buffer twice */\nvoid cgMoveDisposeRecv(Codegen* cg, Str methName, Node* recvNode)\n{\n    if (!cg->ctx->internEqHashLen(methName, 0x95DA0566, 7) && /* FNV(\"dispose\") */\n        !cg->ctx->internEqHashLen(methName, 0x99B3EEDB, 4)) return; /* FNV(\"free\") */\n    if (recvNode->kind.tag != NodeKind::Expr) return;\n    if (recvNode->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return;\n    i32 ci = cgFindDrop(cg, recvNode->kind.payload.Expr.value.kind.payload.Ident.name);\n    if (ci >= 0) cgRemoveDropAt(cg, (u32)ci);\n}\n\nvoid cgPopSwitch(Codegen* cg)\n{\n    if (cg->breakDepth > 0) cg->breakDepth--;\n}\n\nSlice cgIntern(Codegen* cg, Str s)\n{\n    if (s == 0) return Slice::from(null, 0);\n    InternEntry* e = cg->ctx->interns + s;\n    return Slice::from(e->ptr, e->len);\n}\n\nSlice cgTail(Codegen* cg, Stream* s, usize start)\n{\n    return stTail(s, start);\n}\n\n/* ── monomorphisation context ────────────────────────────────── */\n\n/* Resolve a type through the current instance's substitutions\n * (mirrors mono findSubstitution: TypeParam by index/name, or a bare\n * Named whose name matches a generic parameter). Returns t if none. */\nTy cgSubstTy(Codegen* cg, Ty t)\n{\n    if (t == 0 || cg->subsLen == 0 || cg->subs == null) return t;\n    TypeEntry* e = cg->ctx->types + t;\n    if (e->kind.tag == TypeKind::TypeParam) {\n        u32 i = 0;\n        while (i < cg->subsLen) {\n            if (cg->subs[i].index == e->kind.payload.TypeParam.index ||\n                cg->subs[i].parameter == e->kind.payload.TypeParam.name)\n                return cg->subs[i].typeNode;\n            i++;\n        }\n        return t;\n    }\n    if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.genericArgsLen == 0) {\n        u32 i = 0;\n        while (i < cg->subsLen) {\n            if (cg->subs[i].parameter == e->kind.payload.Named.name)\n                return cg->subs[i].typeNode;\n            i++;\n        }\n    }\n    return t;\n}\n\n/* Resolve a symbolic array size (`T data[N]`) through the current\n * instance substitutions; a ValueInt binding hands back its value,\n * anything else keeps `fallback`. Struct fields keep the written name\n * (the parser only rebinds funcs to a param index), so match by\n * sizeParam index first, then by sizeName — the same by-name idiom\n * cgSubstTy uses for a bare `T`. */\nu64 cgSubsArrayLen(Codegen* cg, u32 sizeParam, Str sizeName, u64 fallback)\n{\n    if (cg->subs == null) return fallback;\n    u32 i = 0;\n    while (i < cg->subsLen)\n    {\n        bool match = (sizeParam != 4294967295 && cg->subs[i].index == sizeParam) ||\n                     (sizeParam == 4294967295 && sizeName != 0 && cg->subs[i].parameter == sizeName);\n        if (match)\n        {\n            TypeEntry* se = cg->ctx->types + cg->subs[i].typeNode;\n            if (se->kind.tag == TypeKind::ValueInt) return se->kind.payload.ValueInt.value;\n            return fallback;\n        }\n        i++;\n    }\n    return fallback;\n}\n\n/* Sanitize a C type spelling into a mangled identifier fragment.\n * tyStr almost always returns a slice of tybuf; in that case rewrite\n * in place (each input char maps to exactly one output char), so an\n * enclosing mangled name (cgInstanceName) sees only sanitized chars\n * and never the raw spelling. External slices (tyStr(0) returns a\n * literal) are sanitized into tybuf after the raw text. */\nSlice cgMangleTy(Codegen* cg, Ty t)\n{\n    Slice s = tyStr(cg, t);\n    bool inBuf = s.len > 0 && s.ptr >= cg->tybuf.p &&\n                 (s.ptr + s.len) <= (cg->tybuf.p + cg->tybuf.len);\n    usize i = 0;\n    if (inBuf)\n    {\n        while (i < s.len)\n        {\n            u8 c = s.ptr[i];\n            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;\n            if (ok) { }\n            else if (c == 42) s.ptr[i] = 112;\n            else s.ptr[i] = 95;\n            i++;\n        }\n        return s;\n    }\n    usize st = cg->tybuf.len;\n    while (i < s.len)\n    {\n        u8 c = s.ptr[i];\n        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;\n        if (ok) stCh(&cg->tybuf, c);\n        else if (c == 42) stCh(&cg->tybuf, 112);\n        else stCh(&cg->tybuf, 95);\n        i++;\n    }\n    return stTail(&cg->tybuf, st);\n}\n\n// name + \"_\" + mangled arg types: the C name for a mono instance.\nSlice cgInstanceName(Codegen* cg, Str name, Ty* args, u32 argsLen)\n{\n    usize st = cg->tybuf.len;\n    stPS(&cg->tybuf, cgIntern(cg, name));\n    u32 i = 0;\n    while (i < argsLen)\n    {\n        stCh(&cg->tybuf, 95);\n        cgMangleTy(cg, args[i]);\n        i++;\n    }\n    return stTail(&cg->tybuf, st);\n}\n\n/* hex without leading zeros (0 → \"0\"): value keys end up inside mangled\n * C identifiers, where only [0-9a-zA-Z_] may appear */\nvoid cgWriteHex(Stream* s, u64 v)\n{\n    str digits = \"0123456789abcdef\";\n    i32 sh = 60;\n    bool started = false;\n    while (sh >= 0)\n    {\n        u32 d = (u32)((v >> (u64)sh) & 15);\n        if (d != 0 || started || sh == 0)\n        {\n            stCh(s, digits.ptr[d]);\n            started = true;\n        }\n        sh -= 4;\n    }\n}\n\n/* instance name with the Zig-style value-specialization key appended:\n * `println` of \"hello\" and of \"bye\" are distinct C symbols; key 0 (no\n * recorded call-site values) keeps the plain name */\nSlice cgInstanceNameV(Codegen* cg, Str name, Ty* args, u32 argsLen, u64 valueKey)\n{\n    usize st = cg->tybuf.len;\n    stPS(&cg->tybuf, cgIntern(cg, name));\n    u32 i = 0;\n    while (i < argsLen)\n    {\n        stCh(&cg->tybuf, 95);\n        cgMangleTy(cg, args[i]);\n        i++;\n    }\n    if (valueKey != 0)\n    {\n        stP(&cg->tybuf, \"_v\");\n        cgWriteHex(&cg->tybuf, valueKey);\n    }\n    return stTail(&cg->tybuf, st);\n}\n\n/* ── name mangling (coral-docs/mangle_asm.md; C keeps the `__\n *      separator instead of asm's `$`) ───────────────────────────\n *\n *   crl__<scope>__<seg…>[__<alias>]__<name>\n *\n * scope: `lib` for files under a lib/ tree, `loc` otherwise.\n * segs: lib → the path under lib/ (package root first); loc → the\n * parent-directory name, then the file stem. extern decls, `main`,\n * and CRT passthrough names emit raw. */\n\n/* one path segment restricted to [A-Za-z0-9_]; a leading digit gets\n * a `_` prefix so every piece stays a valid C identifier fragment */\nvoid cgMangleSeg(Stream* s, u8* p, usize len)\n{\n    if (p == null || len == 0) return;\n    usize i = 0;\n    while (i < len)\n    {\n        u8 c = p[i];\n        bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||\n                  (c >= 48 && c <= 57) || c == 95;\n        if (!ok) c = 95;\n        if (i == 0 && c >= 48 && c <= 57) stCh(s, 95);\n        stCh(s, c);\n        i++;\n    }\n}\n\n// declaring name of a decl: 0 for nameless kinds (Import, Extend, …)\nStr cgDeclOwnName(Decl* dd)\n{\n    Str dn = 0;\n    switch (dd->kind.tag)\n    {\n        DeclKind::Func => { dn = dd->kind.payload.Func.name; },\n        DeclKind::Struct => { dn = dd->kind.payload.Struct.name; },\n        DeclKind::Enum => { dn = dd->kind.payload.Enum.name; },\n        DeclKind::Variant => { dn = dd->kind.payload.Variant.name; },\n        DeclKind::Union => { dn = dd->kind.payload.Union.name; },\n        DeclKind::TypeAlias => { dn = dd->kind.payload.TypeAlias.name; },\n        DeclKind::Distinct => { dn = dd->kind.payload.Distinct.name; },\n        DeclKind::Constant => { dn = dd->kind.payload.Constant.name; },\n        else => {},\n    }\n    return dn;\n}\n\n/* extern decls, `#[[no_mangle]]` (ATTR_NO_MANGLE bit), and `main` keep\n * their raw C spelling (externs bind system symbols; main is the entry\n * point; no_mangle opts out of mangling by flag, not by name list) */\nbool cgMangleExempt(Codegen* cg, NodeId declId, Slice name)\n{\n    if (name.ptr == null || name.len == 0) return true;\n    if (name.len == 4 &&\n        cg->ctx->hashStr(str { .ptr = name.ptr, .len = name.len }) == 0xEA90E208) return true; /* FNV(\"main\") */\n    if (declId.index != 0)\n    {\n        Node* n = cgNode(cg, declId);\n        if (n->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &n->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Func && (dd->kind.payload.Func.flags & 2) != 0) return true;\n            if (dd->kind.tag == DeclKind::Constant && (dd->kind.payload.Constant.flags & 2) != 0) return true;\n            if ((dd->attrBits & ATTR_NO_MANGLE) != 0) return true;\n            /* a definition whose file also declares an extern(\"C\") proto\n             * of the same name is C-visible: calls bind the proto (which\n             * is exempt), so the definition must spell bare as well. Only\n             * same-source-file protos count: the merged unit holds every\n             * file, so a libc extern(\"C\") sleep must not strip the prefix\n             * from concurrent::async's unrelated sleep */\n            if (dd->kind.tag == DeclKind::Func && cg->file != null)\n            {\n                u32 defFid = locFile(n->loc);\n                u32 fi = 0;\n                while (fi < cg->file->declsLen)\n                {\n                    Node* fn = cg->ctx->nodes + cg->file->decls[fi].index;\n                    if (fn->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* fd = &fn->kind.payload.Decl.value;\n                        if (fd->kind.tag == DeclKind::Func && (fd->kind.payload.Func.flags & 2) != 0 &&\n                            locFile(fn->loc) == defFid &&\n                            cgSliceEq(name, cgIntern(cg, fd->kind.payload.Func.name)))\n                            return true;\n                    }\n                    fi++;\n                }\n            }\n        }\n    }\n    return false;\n}\n\n/* mangled spelling: path segments from the declaring file, then an\n * optional import alias, then the declaring name; built into a fresh\n * arena stream so nested calls never clobber each other's tails */\nSlice cgMangleS(Codegen* cg, NodeId declId, Slice name, Str alias)\n{\n    if (cgMangleExempt(cg, declId, name)) return name;\n    u8* path = null;\n    usize pathLen = 0;\n    if (declId.index != 0 && cg->sema != null && cg->sema->diag != null)\n    {\n        Node* n = cgNode(cg, declId);\n        u32 fid = locFile(n->loc);\n        if (fid < cg->sema->diag->fileCount)\n        {\n            str fpath = cg->sema->diag->filePaths.at((usize)fid);\n            if (fpath.ptr != null && fpath.len > 0)\n            {\n                path = (u8*)fpath.ptr;\n                pathLen = fpath.len;\n            }\n        }\n    }\n    // drop a trailing \".crl\"\n    if (pathLen >= 4 && path[pathLen - 4] == 46 && path[pathLen - 3] == 99 &&\n        path[pathLen - 2] == 114 && path[pathLen - 1] == 108)\n        pathLen -= 4;\n    Stream s = stNew(cg->arena, 96);\n    stP(&s, \"crl__\");\n    // a \"/lib/\" anywhere (or a leading \"lib/\") → lib + path under lib/\n    bool isLib = false;\n    usize libPos = 0;\n    if (pathLen >= 4 && path[0] == 108 && path[1] == 105 && path[2] == 98 && path[3] == 47)\n    {\n        isLib = true;\n        libPos = 4;\n    }\n    usize q = 0;\n    while (!isLib && q + 5 <= pathLen)\n    {\n        if (path[q] == 47 && path[q + 1] == 108 && path[q + 2] == 105 &&\n            path[q + 3] == 98 && path[q + 4] == 47)\n        {\n            isLib = true;\n            libPos = q + 5;\n        }\n        q++;\n    }\n    if (isLib)\n    {\n        stP(&s, \"lib__\");\n        usize i = libPos;\n        usize segStart = i;\n        bool firstSeg = true;\n        while (i <= pathLen)\n        {\n            if (i == pathLen || path[i] == 47)\n            {\n                if (i > segStart)\n                {\n                    if (!firstSeg) { stCh(&s, 95); stCh(&s, 95); }\n                    cgMangleSeg(&s, path + segStart, i - segStart);\n                    firstSeg = false;\n                }\n                segStart = i + 1;\n            }\n            i++;\n        }\n    }\n    else\n    {\n        stP(&s, \"loc__\");\n        // the last '/' splits the parent dir from the file stem\n        usize lastSlash = pathLen;\n        usize i = 0;\n        while (i < pathLen)\n        {\n            if (path[i] == 47) lastSlash = i;\n            i++;\n        }\n        usize prevSlash = 0;\n        i = 0;\n        while (i < lastSlash)\n        {\n            if (path[i] == 47) prevSlash = i + 1;\n            i++;\n        }\n        bool firstSeg = true;\n        if (lastSlash < pathLen && lastSlash > prevSlash)\n        {\n            cgMangleSeg(&s, path + prevSlash, lastSlash - prevSlash);\n            firstSeg = false;\n        }\n        usize stemStart = pathLen;\n        if (lastSlash < pathLen) stemStart = lastSlash + 1;\n        if (pathLen > stemStart)\n        {\n            if (!firstSeg) { stCh(&s, 95); stCh(&s, 95); }\n            cgMangleSeg(&s, path + stemStart, pathLen - stemStart);\n        }\n    }\n    if (alias != 0)\n    {\n        Slice a = cgIntern(cg, alias);\n        stCh(&s, 95);\n        stCh(&s, 95);\n        cgMangleSeg(&s, a.ptr, a.len);\n    }\n    stCh(&s, 95);\n    stCh(&s, 95);\n    cgMangleSeg(&s, name.ptr, name.len);\n    return stTail(&s, 0);\n}\n\n// Str wrapper: exempt names keep the keyword escape\nSlice cgMangle(Codegen* cg, NodeId declId, Str name, Str alias)\n{\n    if (name == 0) return cgIdent(cg, name);\n    if (cgMangleExempt(cg, declId, cgIntern(cg, name))) return cgIdent(cg, name);\n    return cgMangleS(cg, declId, cgIntern(cg, name), alias);\n}\n\n/* file-preferred decl lookup: match in refFile first, else the first\n * candidate (cgFindDecl's unqualified behaviour when refFile == 0) */\nNodeId cgFindDeclFrom(Codegen* cg, Str name, u32 tag, u32 refFile)\n{\n    if (refFile == 0 || cg->file == null || name == 0) return cgFindDecl(cg, name, tag);\n    NodeId first;\n    first.index = 0;\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cg->ctx->nodes + cg->file->decls[i].index;\n        if (d->kind.tag == NodeKind::Decl && (u32)d->kind.payload.Decl.value.kind.tag == tag)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (cgDeclOwnName(dd) == name)\n            {\n                if (locFile(d->loc) == refFile) return cg->file->decls[i];\n                if (first.index == 0) first = cg->file->decls[i];\n            }\n        }\n        i++;\n    }\n    return first;\n}\n\n/* type-decl resolution only (struct/union/variant/enum/alias/distinct):\n * prefers a decl in the type's own file: TypeEntry.loc records where the\n * name was spelled; else the first match by name. Constants are never\n * followed here — the entry point below adds that layer. */\nNodeId cgFindTypeDeclTy(Codegen* cg, Str name, u32 refFile)\n{\n    NodeId none;\n    none.index = 0;\n    if (cg->file == null || name == 0) return none;\n    /* resolve the way sema did: the binding visible from the spelling\n     * site — `File` spelled in parser/file.crl binds to ast's struct,\n     * not to the first same-named decl in the merged unit (lib's fs\n     * distinct File) */\n    if (cg->sema != null && refFile != 0)\n    {\n        ScopeStack* tyScopes = cg->sema->scopes;\n        Symbol* sym = null;\n        if (tyScopes != null) sym = tyScopes->lookupFrom(name, refFile);\n        if (sym != null && sym->declaration.index != 0)\n        {\n            Node* sn = cgNode(cg, sym->declaration);\n            if (sn->kind.tag == NodeKind::Decl)\n            {\n                u32 stag = (u32)sn->kind.payload.Decl.value.kind.tag;\n                if (stag == DeclKind::Struct || stag == DeclKind::Enum ||\n                    stag == DeclKind::Variant || stag == DeclKind::Union ||\n                    stag == DeclKind::TypeAlias || stag == DeclKind::Distinct)\n                    return sym->declaration;\n            }\n        }\n    }\n    NodeId first;\n    first.index = 0;\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cg->ctx->nodes + cg->file->decls[i].index;\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            u32 tag = (u32)dd->kind.tag;\n            bool isTy = tag == DeclKind::Struct || tag == DeclKind::Enum ||\n                        tag == DeclKind::Variant || tag == DeclKind::Union ||\n                        tag == DeclKind::TypeAlias || tag == DeclKind::Distinct;\n            if (isTy && cgDeclOwnName(dd) == name)\n            {\n                if (refFile != 0 && locFile(d->loc) == refFile) return cg->file->decls[i];\n                if (first.index == 0) first = cg->file->decls[i];\n            }\n        }\n        i++;\n    }\n    return first;\n}\n\n/* the type-decl a Named type refers to. `const c2 = cchar;` binds a name\n * to a TYPE through a constant: its typedef lands in cgEmitGlobals under\n * the const's own mangling — resolve the const decl too so type uses\n * spell that same mangled name. Only one layer: the const's value must be\n * a plain type name (chained consts keep the old raw-name spelling). */\nNodeId cgFindTypeDecl(Codegen* cg, Str name, u32 refFile)\n{\n    NodeId d = cgFindTypeDeclTy(cg, name, refFile);\n    if (d.index != 0) return d;\n    NodeId none;\n    none.index = 0;\n    if (cg->file == null || name == 0) return none;\n    NodeId cd;\n    cd.index = 0;\n    if (cg->sema != null && refFile != 0 && cg->sema->scopes != null)\n    {\n        Symbol* sym = cg->sema->scopes->lookupFrom(name, refFile);\n        if (sym != null && sym->declaration.index != 0) cd = sym->declaration;\n    }\n    if (cd.index == 0)\n    {\n        u32 i = 0;\n        while (i < cg->file->declsLen)\n        {\n            Node* d2 = cg->ctx->nodes + cg->file->decls[i].index;\n            if (d2->kind.tag == NodeKind::Decl &&\n                d2->kind.payload.Decl.value.kind.tag == DeclKind::Constant &&\n                cgDeclOwnName(&d2->kind.payload.Decl.value) == name)\n            {\n                cd = cg->file->decls[i];\n                break;\n            }\n            i++;\n        }\n    }\n    if (cd.index == 0) return none;\n    Node* cn = cgNode(cg, cd);\n    if (cn->kind.tag != NodeKind::Decl) return none;\n    Decl* cdd = &cn->kind.payload.Decl.value;\n    if (cdd->kind.tag != DeclKind::Constant) return none;\n    NodeId v = cdd->kind.payload.Constant.value;\n    if (v.index == 0) return none;\n    Node* vn = cgNode(cg, v);\n    if (vn->kind.tag != NodeKind::Expr ||\n        vn->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return none;\n    Str iname = vn->kind.payload.Expr.value.kind.payload.Ident.name;\n    if (cgFindTypeDeclTy(cg, iname, locFile(vn->loc)).index == 0) return none;\n    return cd;\n}\n\n/* resolve a plain-name reference the way sema did: the innermost\n * binding visible at refSite; *outAlias receives the use-site name when\n * it differs from the declaration's own (import `as` rename). A found\n * binding of the wrong kind shadows any outer decl → returns 0 (the\n * caller then emits the raw local name). wantKind 0 = Func or Constant. */\nNodeId cgResolveRef(Codegen* cg, Str localName, u32 wantKind, NodeId refSite, Str* outAlias)\n{\n    NodeId none;\n    none.index = 0;\n    *outAlias = 0;\n    if (localName == 0) return none;\n    u32 refFile = 0;\n    if (refSite.index != 0)\n    {\n        Node* rn = cgNode(cg, refSite);\n        refFile = locFile(rn->loc);\n    }\n    if (cg->sema != null && cg->sema->scopes != null)\n    {\n        /* bind the receiver: a nested chain (`cg.sema.scopes.m(...)`)\n         * lowers as field access: single-level receivers are fine */\n        ScopeStack* scopes = cg->sema->scopes;\n        Symbol* sym = scopes->lookupFrom(localName, refFile);\n        if (sym != null)\n        {\n            if (sym->declaration.index == 0) return none;\n            Node* sn = cgNode(cg, sym->declaration);\n            if (sn->kind.tag != NodeKind::Decl) return none;\n            Decl* sd = &sn->kind.payload.Decl.value;\n            bool ok = false;\n            if (wantKind == 0)\n                ok = sd->kind.tag == DeclKind::Func || sd->kind.tag == DeclKind::Constant;\n            else if ((u32)sd->kind.tag == wantKind) ok = true;\n            if (!ok) return none;\n            Str own = cgDeclOwnName(sd);\n            if (own != 0 && localName != own) *outAlias = localName;\n            return sym->declaration;\n        }\n    }\n    // no scope binding (or no sema): fall back to a file-preferred scan\n    NodeId d = cgFindDeclFrom(cg, localName, wantKind == 0 ? (u32)DeclKind::Func : wantKind, refFile);\n    if (d.index == 0 && wantKind == 0)\n        d = cgFindDeclFrom(cg, localName, (u32)DeclKind::Constant, refFile);\n    return d;\n}\n\n/* ── the current function's bound names (locals stay raw) ────── */\n\nvoid cgAddLocal(Codegen* cg, Str name)\n{\n    if (name == 0) return;\n    u32 i = 0;\n    while (i < cg->localNamesLen)\n    {\n        if (cg->localNames[i] == name) return;\n        i++;\n    }\n    if (cg->localNamesLen >= cg->localNamesCap)\n    {\n        u32 nc = cg->localNamesCap == 0 ? 16 : cg->localNamesCap * 2;\n        Str* np = realloc<Str>(cg->localNames, (usize)nc);\n        if (np == null) return;\n        cg->localNames = np;\n        cg->localNamesCap = nc;\n    }\n    cg->localNames[cg->localNamesLen] = name;\n    cg->localNamesLen++;\n}\n\nbool cgIsLocalName(Codegen* cg, Str name)\n{\n    u32 i = 0;\n    while (i < cg->localNamesLen)\n    {\n        if (cg->localNames[i] == name) return true;\n        i++;\n    }\n    return false;\n}\n\n/* ── method-decl resolution (owner_method → the method's own decl) ── */\n\nbool cgSliceEq(Slice a, Slice b)\n{\n    if (a.len != b.len) return false;\n    if (a.len == 0) return true;\n    if (a.ptr == null || b.ptr == null) return false;\n    usize i = 0;\n    while (i < a.len)\n    {\n        if (a.ptr[i] != b.ptr[i]) return false;\n        i++;\n    }\n    return true;\n}\n\nbool cgStrFieldIs(Codegen* cg, Str s, str lit)\n{\n    Slice t = cgIntern(cg, s);\n    if (t.len != lit.len) return false;\n    usize i = 0;\n    while (i < lit.len)\n    {\n        if (t.ptr[i] != lit.ptr[i]) return false;\n        i++;\n    }\n    return true;\n}\n\n// `x.payload` access node inside a field chain\nbool cgIsPayloadAccess(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* e = &n->kind.payload.Expr.value;\n    if (e->kind.tag == ExprKind::Field)\n        return cgStrFieldIs(cg, e->kind.payload.Field.field, \"payload\");\n    if (e->kind.tag == ExprKind::DerefField)\n        return cgStrFieldIs(cg, e->kind.payload.DerefField.field, \"payload\");\n    return false;\n}\n\nNodeId cgFieldAccessObj(Codegen* cg, NodeId id)\n{\n    Node* n = cgNode(cg, id);\n    Expr* e = &n->kind.payload.Expr.value;\n    if (e->kind.tag == ExprKind::Field) return e->kind.payload.Field.obj;\n    return e->kind.payload.DerefField.obj;\n}\n\n/* `V::Case` as a bare value: the C form is the ordinal of the case;\n * false when the path is not a variant case */\nbool cgVariantCaseIdx(Codegen* cg, NodeId id, u64* outIdx)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* e = &n->kind.payload.Expr.value;\n    if (e->kind.tag != ExprKind::Path) return false;\n    if (e->kind.payload.Path.segmentsLen != 2) return false;\n    Node* s0n = cgNode(cg, e->kind.payload.Path.segments[0]);\n    Node* s1n = cgNode(cg, e->kind.payload.Path.segments[1]);\n    if (s0n->kind.tag != NodeKind::Expr || s1n->kind.tag != NodeKind::Expr) return false;\n    if (s0n->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;\n    if (s1n->kind.payload.Expr.value.kind.tag != ExprKind::Ident) return false;\n    Str root = s0n->kind.payload.Expr.value.kind.payload.Ident.name;\n    Str member = s1n->kind.payload.Expr.value.kind.payload.Ident.name;\n    NodeId vd = cgFindDecl(cg, root, (u32)DeclKind::Variant);\n    if (vd.index == 0) return false;\n    Node* dn = cgNode(cg, vd);\n    Decl* dd = &dn->kind.payload.Decl.value;\n    u32 v = 0;\n    while (v < dd->kind.payload.Variant.variantsLen)\n    {\n        if (dd->kind.payload.Variant.variants[v].name == member)\n        {\n            *outIdx = (u64)v;\n            return true;\n        }\n        v++;\n    }\n    return false;\n}\n\nSlice cgU64Text(Codegen* cg, u64 v)\n{\n    usize s = cg->ebuf.len;\n    stU64(&cg->ebuf, v);\n    return stTail(&cg->ebuf, s);\n}\n\n/* assignment RHS: `x.tag = V::Case` writes the ordinal; other variant-case\n * uses keep the struct form */\nSlice cgAssignValue(Codegen* cg, NodeId target, NodeId value)\n{\n    Node* tn = cgNode(cg, target);\n    if (tn->kind.tag == NodeKind::Expr)\n    {\n        Expr* te = &tn->kind.payload.Expr.value;\n        bool tagTarget = false;\n        if (te->kind.tag == ExprKind::Field &&\n            cgStrFieldIs(cg, te->kind.payload.Field.field, \"tag\")) tagTarget = true;\n        if (te->kind.tag == ExprKind::DerefField &&\n            cgStrFieldIs(cg, te->kind.payload.DerefField.field, \"tag\")) tagTarget = true;\n        if (tagTarget)\n        {\n            u64 cidx = 0;\n            if (cgVariantCaseIdx(cg, value, &cidx)) return cgU64Text(cg, cidx);\n        }\n    }\n    return cgExpr(cg, value);\n}\n\nNodeId cgMethodsContain(Codegen* cg, NodeId* methods, u32 mlen, Str methName)\n{\n    NodeId none;\n    none.index = 0;\n    if (methods == null || methName == 0) return none;\n    u32 m = 0;\n    while (m < mlen)\n    {\n        Node* mn = cgNode(cg, methods[m]);\n        if (mn->kind.tag == NodeKind::Decl && mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&\n            mn->kind.payload.Decl.value.kind.payload.Func.name == methName)\n            return methods[m];\n        m++;\n    }\n    return none;\n}\n\n/* the method's declaring node for an owner spelling: the type's own\n * methods plus every extend whose owner text matches (cgEmitMethodSet /\n * cgEmitInstMethodList compose the same `owner_method` base) */\n\n/* owner text as the definition side spells it: builtin `str` mangles by\n * its C typedef name (`_coral_str`), everything else by its ident */\nSlice cgOwnerSpelling(Codegen* cg, Slice owner)\n{\n    if (cgSliceEq(owner, Slice::fromStr(\"str\")))\n        return Slice::fromStr(\"_coral_str\");\n    return owner;\n}\n\nNodeId cgFindMethodDeclOwner(Codegen* cg, Slice owner, Str methName)\n{\n    NodeId none;\n    none.index = 0;\n    if (owner.len == 0 || methName == 0 || cg->file == null) return none;\n    /* the builtin `str` type is declared as `extend str` but its methods\n     * mangle by the C typedef name: match the spelling the call site\n     * produced (the coral type name) */\n    owner = cgOwnerSpelling(cg, owner);\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cg->ctx->nodes + cg->file->decls[i].index;\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            if (dd->kind.tag == DeclKind::Struct || dd->kind.tag == DeclKind::Union ||\n                dd->kind.tag == DeclKind::Variant || dd->kind.tag == DeclKind::Extend ||\n                dd->kind.tag == DeclKind::ExtendTrait)\n            {\n                /* generic extends never match a concrete owner textually,\n                 * and cgDeclOwner would tyStr an unresolved TypeParam */\n                bool eligible = true;\n                if (dd->kind.tag == DeclKind::Extend || dd->kind.tag == DeclKind::ExtendTrait)\n                    if (cgOwnerGeneric(cg, dd)) eligible = false;\n                if (eligible && cgSliceEq(cgDeclOwner(cg, dd), owner))\n                {\n                    NodeId* methods = null;\n                    u32 mlen = 0;\n                    switch (dd->kind.tag)\n                    {\n                        DeclKind::Struct => { methods = dd->kind.payload.Struct.methods; mlen = dd->kind.payload.Struct.methodsLen; },\n                        DeclKind::Union => { methods = dd->kind.payload.Union.methods; mlen = dd->kind.payload.Union.methodsLen; },\n                        DeclKind::Variant => { methods = dd->kind.payload.Variant.methods; mlen = dd->kind.payload.Variant.methodsLen; },\n                        DeclKind::Extend => { methods = dd->kind.payload.Extend.methods; mlen = dd->kind.payload.Extend.methodsLen; },\n                        DeclKind::ExtendTrait => { methods = dd->kind.payload.ExtendTrait.methods; mlen = dd->kind.payload.ExtendTrait.methodsLen; },\n                        else => {},\n                    }\n                    NodeId hit = cgMethodsContain(cg, methods, mlen, methName);\n                    if (hit.index != 0) return hit;\n                }\n            }\n        }\n        i++;\n    }\n    /* monomorphised owner (`Foo_int32_t`): the instance's type decl plus\n     * every extend its self type matches; mirrors cgEmitInstanceMethods */\n    if (cg->mono != null)\n    {\n        i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::TypeInstance &&\n                cgSliceEq(cgInstanceName(cg, inst->name, inst->arguments, inst->argumentsLen), owner))\n            {\n                Node* dn = cgNode(cg, inst->declaration);\n                if (dn->kind.tag == NodeKind::Decl)\n                {\n                    Decl* td = &dn->kind.payload.Decl.value;\n                    NodeId* methods = null;\n                    u32 mlen = 0;\n                    switch (td->kind.tag)\n                    {\n                        DeclKind::Struct => { methods = td->kind.payload.Struct.methods; mlen = td->kind.payload.Struct.methodsLen; },\n                        DeclKind::Union => { methods = td->kind.payload.Union.methods; mlen = td->kind.payload.Union.methodsLen; },\n                        DeclKind::Variant => { methods = td->kind.payload.Variant.methods; mlen = td->kind.payload.Variant.methodsLen; },\n                        else => {},\n                    }\n                    NodeId hit = cgMethodsContain(cg, methods, mlen, methName);\n                    if (hit.index != 0) return hit;\n                }\n                u32 d = 0;\n                while (d < cg->file->declsLen)\n                {\n                    Node* dn2 = cgNode(cg, cg->file->decls[d]);\n                    if (dn2->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* xd = &dn2->kind.payload.Decl.value;\n                        bool matches = false;\n                        if (xd->kind.tag == DeclKind::Extend)\n                            matches = cgSelfTyMatches(cg, xd->kind.payload.Extend.selfType, inst->name, inst->arguments, inst->argumentsLen);\n                        else if (xd->kind.tag == DeclKind::ExtendTrait)\n                            matches = cgSelfTyMatches(cg, xd->kind.payload.ExtendTrait.selfType, inst->name, inst->arguments, inst->argumentsLen);\n                        if (matches)\n                        {\n                            NodeId* em = null;\n                            u32 eml = 0;\n                            if (xd->kind.tag == DeclKind::Extend) { em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen; }\n                            else { em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen; }\n                            NodeId hit2 = cgMethodsContain(cg, em, eml, methName);\n                            if (hit2.index != 0) return hit2;\n                        }\n                    }\n                    d++;\n                }\n            }\n            i++;\n        }\n    }\n    return none;\n}\n\n// the method's declaring node for a receiver type (unwraps ptr/const)\nNodeId cgFindMethodDecl(Codegen* cg, Ty recvTy, Str methName)\n{\n    NodeId none;\n    none.index = 0;\n    if (recvTy == 0 || methName == 0) return none;\n    Ty t = cgTyUnwrap(cg, cgSubstTy(cg, recvTy));\n    if (t != 0 && (cg->ctx->types + t)->kind.tag == TypeKind::Pointer)\n        t = cgTyUnwrap(cg, (cg->ctx->types + t)->kind.payload.Pointer.base);\n    if (t == 0) return none;\n    return cgFindMethodDeclOwner(cg, cgOwnerName(cg, t), methName);\n}\n\n// true when a value expression has type str\nbool cgIsStrTy(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Ty t = cgSubstTy(cg, n->kind.payload.Expr.value.resolvedType);\n    if (t == 0) return false;\n    return (cg->ctx->types + t)->kind.tag == TypeKind::Str;\n}\n\n// true when the expr's type is a `struct` decl (Named → DeclKind::Struct)\nbool cgIsStructTy(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Ty t = cgSubstTy(cg, n->kind.payload.Expr.value.resolvedType);\n    while (t != 0 && ((cg->ctx->types + t)->kind.tag == TypeKind::Const ||\n                      (cg->ctx->types + t)->kind.tag == TypeKind::Comptime))\n    {\n        if ((cg->ctx->types + t)->kind.tag == TypeKind::Const) t = (cg->ctx->types + t)->kind.payload.Const.base;\n        else t = (cg->ctx->types + t)->kind.payload.Comptime.base;\n    }\n    if (t == 0) return false;\n    if ((cg->ctx->types + t)->kind.tag != TypeKind::Named) return false;\n    NodeId d = cgFindDecl(cg, (cg->ctx->types + t)->kind.payload.Named.name, (u32)DeclKind::Struct);\n    return d.index != 0;\n}\n\n/* variant-typed value: a Named type resolving to a Variant decl. C maps\n * variants to a struct with an int `tag`, so ordering/equality compares\n * must go through `.tag` — the struct itself has no C operators */\nbool cgIsVariantTy(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Ty t = cgSubstTy(cg, n->kind.payload.Expr.value.resolvedType);\n    while (t != 0 && ((cg->ctx->types + t)->kind.tag == TypeKind::Const ||\n                      (cg->ctx->types + t)->kind.tag == TypeKind::Comptime))\n    {\n        if ((cg->ctx->types + t)->kind.tag == TypeKind::Const) t = (cg->ctx->types + t)->kind.payload.Const.base;\n        else t = (cg->ctx->types + t)->kind.payload.Comptime.base;\n    }\n    if (t == 0) return false;\n    if ((cg->ctx->types + t)->kind.tag != TypeKind::Named) return false;\n    NodeId d = cgFindDecl(cg, (cg->ctx->types + t)->kind.payload.Named.name, (u32)DeclKind::Variant);\n    return d.index != 0;\n}\n\n/* first decl with this name+kind in the current file (decl order wins);\n * hits are cached in the 32-slot declCache: the miss path rescans */\nNodeId cgFindDecl(Codegen* cg, Str name, u32 tag)\n{\n    NodeId none;\n    none.index = 0;\n    if (cg->file == null || name == 0) return none;\n    u32 c = 0;\n    while (c < cg->declCacheLen)\n    {\n        if (cg->declCacheNames[c] == name && cg->declCacheTags[c] == tag)\n        {\n            NodeId hit;\n            hit.index = cg->declCacheIds[c];\n            return hit;\n        }\n        c++;\n    }\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cg->ctx->nodes + cg->file->decls[i].index;\n        if (d->kind.tag == NodeKind::Decl && (u32)d->kind.payload.Decl.value.kind.tag == tag)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            Str dn = 0;\n            switch (dd->kind.tag)\n            {\n                DeclKind::Func => { dn = dd->kind.payload.Func.name; },\n                DeclKind::Struct => { dn = dd->kind.payload.Struct.name; },\n                DeclKind::Enum => { dn = dd->kind.payload.Enum.name; },\n                DeclKind::Variant => { dn = dd->kind.payload.Variant.name; },\n                DeclKind::Union => { dn = dd->kind.payload.Union.name; },\n                DeclKind::TypeAlias => { dn = dd->kind.payload.TypeAlias.name; },\n                DeclKind::Constant => { dn = dd->kind.payload.Constant.name; },\n                else => {},\n            }\n            if (dn == name)\n            {\n                NodeId found = cg->file->decls[i];\n                if (cg->declCacheLen < 32)\n                {\n                    cg->declCacheNames[cg->declCacheLen] = name;\n                    cg->declCacheIds[cg->declCacheLen] = found.index;\n                    cg->declCacheTags[cg->declCacheLen] = tag;\n                    cg->declCacheLen++;\n                }\n                return found;\n            }\n        }\n        i++;\n    }\n    return none;\n}\n\n/* str → const T* argument decay: true when the callee's parameter is a\n * pointer and the argument expression has type str (emit `<arg>.ptr`) */\nbool cgStrToPtr(Codegen* cg, Ty paramTy, NodeId argId)\n{\n    if (paramTy == 0) return false;\n    Node* an = cgNode(cg, argId);\n    if (an->kind.tag != NodeKind::Expr) return false;\n    Ty at = cgSubstTy(cg, an->kind.payload.Expr.value.resolvedType);\n    if (at == 0) return false;\n    if ((cg->ctx->types + at)->kind.tag != TypeKind::Str) return false;\n    Ty t = paramTy;\n    TypeEntry* e = cg->ctx->types + t;\n    while (e->kind.tag == TypeKind::Const || e->kind.tag == TypeKind::Comptime)\n    {\n        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else t = e->kind.payload.Comptime.base;\n        if (t == 0) return false;\n        e = cg->ctx->types + t;\n    }\n    return e->kind.tag == TypeKind::Pointer;\n}\n\n/* array → slice decay: returns the slice type when paramTy is `T[]` and\n * the arg is a `T[N]` array (0 otherwise; const/comptime stripped) */\nTy cgArrayToSliceParam(Codegen* cg, Ty paramTy, NodeId argId)\n{\n    if (paramTy == 0) return 0;\n    Node* an = cgNode(cg, argId);\n    if (an->kind.tag != NodeKind::Expr) return 0;\n    Ty at = cgSubstTy(cg, an->kind.payload.Expr.value.resolvedType);\n    if (at == 0) return 0;\n    if ((cg->ctx->types + at)->kind.tag != TypeKind::Array) return 0;\n    Ty t = paramTy;\n    TypeEntry* e = cg->ctx->types + t;\n    while (e->kind.tag == TypeKind::Const || e->kind.tag == TypeKind::Comptime)\n    {\n        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else t = e->kind.payload.Comptime.base;\n        if (t == 0) return 0;\n        e = cg->ctx->types + t;\n    }\n    if (e->kind.tag != TypeKind::Slice) return 0;\n    return t;\n}\n\n/* `((Slice_T){ (elemTy*)(arr), N })` — the C lowering of an array value\n * flowing into a slice slot (call args, casts). arrText is borrowed. */\nvoid cgEmitSliceFromArr(Codegen* cg, Ty sliceTy, Ty arrTy, Slice arrText)\n{\n    TypeEntry* se = cg->ctx->types + sliceTy;\n    TypeEntry* ae = cg->ctx->types + arrTy;\n    stP(&cg->ebuf, \"((\");\n    stPS(&cg->ebuf, tyStr(cg, sliceTy));\n    stP(&cg->ebuf, \"){ (\");\n    stPS(&cg->ebuf, tyStr(cg, se->kind.payload.Slice.base));\n    stP(&cg->ebuf, \"*)(\");\n    stPS(&cg->ebuf, arrText);\n    stP(&cg->ebuf, \"), \");\n    if (ae->kind.payload.Array.sizeName == 0)\n        stU64(&cg->ebuf, (u64)ae->kind.payload.Array.len);\n    else\n    {\n        /* symbolic size `T data[N]`: derive from the value */\n        stP(&cg->ebuf, \"sizeof(\");\n        stPS(&cg->ebuf, arrText);\n        stP(&cg->ebuf, \")/sizeof((\");\n        stPS(&cg->ebuf, arrText);\n        stP(&cg->ebuf, \")[0])\");\n    }\n    stP(&cg->ebuf, \" })\");\n}\n\n/* variant decl behind a (possibly pointer/const-qualified) type plus the\n * ordinal of `variantName` within it; returns the decl or index 0 */\nNodeId cgFindVariantOfTy(Codegen* cg, Ty t, Str variantName, u32* outIdx)\n{\n    NodeId none;\n    none.index = 0;\n    *outIdx = 0;\n    if (t == 0 || variantName == 0) return none;\n    TypeEntry* e = cg->ctx->types + t;\n    while (e->kind.tag == TypeKind::Pointer || e->kind.tag == TypeKind::Const ||\n           e->kind.tag == TypeKind::Comptime)\n    {\n        if (e->kind.tag == TypeKind::Pointer) t = e->kind.payload.Pointer.base;\n        else if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else t = e->kind.payload.Comptime.base;\n        if (t == 0) return none;\n        e = cg->ctx->types + t;\n    }\n    if (e->kind.tag != TypeKind::Named) return none;\n    NodeId d = cgFindDecl(cg, e->kind.payload.Named.name, (u32)DeclKind::Variant);\n    if (d.index == 0) return none;\n    Node* dn = cgNode(cg, d);\n    Decl* dd = &dn->kind.payload.Decl.value;\n    u32 v = 0;\n    while (v < dd->kind.payload.Variant.variantsLen)\n    {\n        if (dd->kind.payload.Variant.variants[v].name == variantName)\n        {\n            *outIdx = v;\n            return d;\n        }\n        v++;\n    }\n    return none;\n}\n\n/* Resolve the callee of a call: plain name for non-generic functions,\n * mangled instance name for generic ones. Sets *outRet to the concrete\n * return type. Returns null slice when the declaration is unknown. */\nSlice cgCallFromDecl(Codegen* cg, NodeId declId, Str alias, NodeId* args, u32 argsLen,\n                     Ty* outRet, bool* found, NodeId* outDecl)\n{\n    *found = false;\n    *outRet = 0;\n    if (outDecl != null) { outDecl->index = 0; }\n    if (declId.index == 0) return Slice::from(null, 0);\n    Node* ddn = cgNode(cg, declId);\n    Decl* dd = &ddn->kind.payload.Decl.value;\n    if (ddn->kind.tag != NodeKind::Decl || dd->kind.tag != DeclKind::Func) return Slice::from(null, 0);\n    if (outDecl != null) *outDecl = declId;\n    if (cg->mono == null || cg->mono->genericCount(declId) == 0) {\n        *found = true;\n        *outRet = dd->kind.payload.Func.returnType;\n        return cgMangle(cg, declId, dd->kind.payload.Func.name, alias);\n    }\n    /* generic: pick the mono instance whose collected argument types and\n     * Zig-style value key match this call site (the key is computed over\n     * the same arg nodes collectCall saw, including the substituted type\n     * of every arg, so runtime-tail types select their own instance) */\n    u64 callKey = cg->mono->callValueKeyTyped(args, argsLen, cg->subs, cg->subsLen);\n    u32 gcount = cg->mono->genericCount(declId);\n    Ty* want = null;\n    if (gcount > 0)\n    {\n        want = alloc<Ty>((usize)gcount);\n        if (want == null) { cgError(cg, \"out of memory\"); return Slice::from(null, 0); }\n        zero<Ty>(want, (usize)gcount);\n        cg->mono->inferCallArgs(declId, args, argsLen, cg->subs, cg->subsLen, want);\n    }\n    u32 total = 0;\n    u32 firstTotal = 0;\n    u32 keyPick = 0;\n    u32 typePick = 0;\n    u32 typeMatches = 0;\n    u32 i = 0;\n    while (i < cg->mono->instancesLen)\n    {\n        MonoInstance* inst = cg->mono->instances + i;\n        if (inst->kind == MonoInstanceKind::FunctionInstance && inst->declaration.index == declId.index)\n        {\n            if (total == 0) firstTotal = i;\n            total++;\n            bool ok = true;\n            if (inst->argumentsLen == gcount) {\n                u32 k = 0;\n                while (k < gcount) {\n                    if (want == null || want[k] == 0 ||\n                        !cg->sema->sameType(want[k], inst->arguments[k])) { ok = false; break; }\n                    k++;\n                }\n            } else {\n                ok = false;\n            }\n            if (ok) {\n                typeMatches++;\n                if (typePick == 0) typePick = i + 1;\n                if (keyPick == 0 && inst->valueKey == callKey) keyPick = i + 1;\n            }\n        }\n        i++;\n    }\n    if (want != null) dealloc<Ty>(want);\n    if (total == 0) return Slice::from(null, 0);\n    /* preference: exact value-key match; else the lone argument-type\n     * match when it carries no value key; else the first instance of the\n     * decl, with a diagnostic */\n    u32 pick = firstTotal;\n    if (keyPick != 0) pick = keyPick - 1;\n    else if (typeMatches == 1 && cg->mono->instances[typePick - 1].valueKey == 0) pick = typePick - 1;\n    else {\n        /* no argument+value match, and the fallback (a lone unkeyed\n           instance) is unavailable: surface the mismatch */\n        cgError(cg, \"no unique mono instance for call\");\n    }\n    MonoInstance* p = cg->mono->instances + pick;\n    *found = true;\n    *outRet = p->returnType;\n    return cgMangleS(cg, p->declaration,\n                     cgInstanceNameV(cg, p->name, p->arguments, p->argumentsLen, p->valueKey), alias);\n}\n\nSlice cgResolveCall(Codegen* cg, Str name, NodeId* args, u32 argsLen, Ty* outRet, bool* found, NodeId refSite, NodeId* outDecl)\n{\n    *found = false;\n    *outRet = 0;\n    if (outDecl != null) { outDecl->index = 0; }\n    Str alias = 0;\n    NodeId declId = cgResolveRef(cg, name, (u32)DeclKind::Func, refSite, &alias);\n    Slice r = cgCallFromDecl(cg, declId, alias, args, argsLen, outRet, found, outDecl);\n    if (*found) return r;\n    /* the scope binding (or file preference) pointed at a generic\n     * template with no usable instance: any non-generic decl of the\n     * same name still emits (matches the pre-mangling decl-order pick) */\n    if (cg->file != null && name != 0)\n    {\n        u32 q = 0;\n        while (q < cg->file->declsLen)\n        {\n            NodeId qid = cg->file->decls[q];\n            Node* dnq = cg->ctx->nodes + qid.index;\n            if (dnq->kind.tag == NodeKind::Decl)\n            {\n                Decl* ddq = &dnq->kind.payload.Decl.value;\n                if (ddq->kind.tag == DeclKind::Func && ddq->kind.payload.Func.name == name &&\n                    !cgDeclIsGeneric(cg, qid))\n                {\n                    return cgCallFromDecl(cg, qid, 0, args, argsLen, outRet, found, outDecl);\n                }\n            }\n            q++;\n        }\n    }\n    return r;\n}\n\n/* fileId of the file a module import path points at: the path joined\n * with '/' (+ \".crl\") must be a suffix of the file's own path (lib files\n * carry extra platform segments in between) */\nu32 cgFileForModulePath(Codegen* cg, Str path)\n{\n    if (path == 0 || cg->sema == null || cg->sema->diag == null) return 0;\n    Slice p = cgIntern(cg, path);\n    if (p.len == 0 || cg->sema->diag->fileCount == 0) return 0;\n    Stream s = stNew(cg->arena, 64);\n    usize i = 0;\n    while (i < p.len)\n    {\n        if (i + 1 < p.len && p.ptr[i] == 58 && p.ptr[i + 1] == 58) { stCh(&s, '/'); i += 2; }\n        else { stCh(&s, p.ptr[i]); i++; }\n    }\n    bool hasCrl = s.len >= 4 && s.p[s.len - 4] == 46 && s.p[s.len - 3] == 99 &&\n                  s.p[s.len - 2] == 114 && s.p[s.len - 1] == 108;\n    if (!hasCrl) stP(&s, \".crl\");\n    if (s.len == 0) return 0;\n    u32 f = 0;\n    while (f < cg->sema->diag->fileCount)\n    {\n        str fp = cg->sema->diag->filePaths.at((usize)f);\n        if (fp.ptr != null && fp.len >= s.len)\n        {\n            bool ok = true;\n            usize j = 0;\n            while (j < s.len)\n            {\n                if (fp.ptr[fp.len - s.len + j] != s.p[j]) { ok = false; break; }\n                j++;\n            }\n            if (ok) return f;\n        }\n        f++;\n    }\n    return 0;\n}\n\n/* Name for an explicit-generic call `f<T>(...)`: the mono instance bound to\n * the callee's generic arguments. When several instances share the same\n * generic args, the call site's value key (computed from the call's own\n * arg nodes, exactly like cgCallFromDecl) picks the right one: first\n * match otherwise. Null slice when no instance matches; *outDecl always\n * receives the callee's declaration when found. */\nSlice cgResolveGenericCall(Codegen* cg, Str fname, Ty namedTy, Ty* outRet, bool* found, NodeId* outDecl, NodeId refSite,\n                           NodeId* args, u32 argsLen)\n{\n    *found = false;\n    *outRet = 0;\n    if (outDecl != null) { outDecl->index = 0; }\n    u64 wantKey = 0;\n    if (cg->mono != null) wantKey = cg->mono->callValueKeyTyped(args, argsLen, cg->subs, cg->subsLen);\n    Ty* gargs = null;\n    u32 glen = 0;\n    Ty* gbuf = null;\n    if (namedTy != 0)\n    {\n        TypeEntry* ne = cg->ctx->types + namedTy;\n        if (ne->kind.tag == TypeKind::Named)\n        {\n            gargs = ne->kind.payload.Named.genericArgs;\n            glen = ne->kind.payload.Named.genericArgsLen;\n        }\n    }\n    if (glen > 0 && cg->subs != null && cg->subsLen > 0)\n    {\n        /* inside an instance body the callee's explicit args may be the\n         * template's own params (`dealloc<T>` in realloc<cchar>): resolve\n         * them through the current substitutions before instance matching */\n        gbuf = alloc<Ty>((usize)glen);\n        if (gbuf != null)\n        {\n            u32 gi = 0;\n            while (gi < glen)\n            {\n                gbuf[gi] = cg->mono->substituteType(gargs[gi], cg->subs, cg->subsLen);\n                gi++;\n            }\n            gargs = gbuf;\n        }\n    }\n    /* the declaring file's decl owns the instance (the name may be\n     * ambiguous across merged files: libc's extern realloc vs mman's\n     * realloc<T>): resolve through sema like every other reference */\n    Str alias = 0;\n    NodeId declId = cgResolveRef(cg, fname, (u32)DeclKind::Func, refSite, &alias);\n    if (declId.index != 0 && cg->mono != null && cg->sema != null && glen > 0)\n    {\n        u32 pick = 0;\n        u32 i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance && inst->declaration.index == declId.index &&\n                inst->argumentsLen == glen)\n            {\n                bool ok = true;\n                u32 k = 0;\n                while (k < glen)\n                {\n                    if (!cg->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }\n                    k++;\n                }\n                if (ok)\n                {\n                    if (pick == 0) pick = i + 1;\n                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }\n                }\n            }\n            i++;\n        }\n        if (pick != 0)\n        {\n            MonoInstance* inst = cg->mono->instances + pick - 1;\n            *found = true;\n            *outRet = inst->returnType;\n            if (outDecl != null) *outDecl = inst->declaration;\n            if (gbuf != null) dealloc<Ty>(gbuf);\n            return cgMangleS(cg, inst->declaration,\n                             cgInstanceNameV(cg, inst->name, inst->arguments, inst->argumentsLen, inst->valueKey), alias);\n        }\n    }\n    // unresolved decl: fall back to a name+args instance scan (no alias)\n    if (cg->mono != null && cg->sema != null && glen > 0)\n    {\n        u32 pick = 0;\n        u32 i = 0;\n        while (i < cg->mono->instancesLen)\n        {\n            MonoInstance* inst = cg->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance && inst->name == fname &&\n                inst->argumentsLen == glen)\n            {\n                bool ok = true;\n                u32 k = 0;\n                while (k < glen)\n                {\n                    if (!cg->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }\n                    k++;\n                }\n                if (ok)\n                {\n                    if (pick == 0) pick = i + 1;\n                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }\n                }\n            }\n            i++;\n        }\n        if (pick != 0)\n        {\n            MonoInstance* inst = cg->mono->instances + pick - 1;\n            *found = true;\n            *outRet = inst->returnType;\n            if (outDecl != null) *outDecl = inst->declaration;\n            if (gbuf != null) dealloc<Ty>(gbuf);\n            return cgMangleS(cg, inst->declaration,\n                             cgInstanceNameV(cg, inst->name, inst->arguments, inst->argumentsLen, inst->valueKey), 0);\n        }\n    }\n    if (declId.index != 0 && outDecl != null) *outDecl = declId;\n    if (gbuf != null) dealloc<Ty>(gbuf);\n    return Slice::from(null, 0);\n}\n\n/* StringLit token text keeps its surrounding quotes (cgExpr strips them\n   on emission): asm pieces/constraints are stored raw, so unquote here */\nSlice cgUnquote(Codegen* cg, Slice s)\n{\n    if (s.len >= 2 && s.ptr[0] == '\"') return Slice::from(s.ptr + 1, s.len - 2);\n    return s;\n}\n\n/* ── C type emission ─────────────────────────────────────────── */\n\nextern(\"C\") Slice tyStr(Codegen* cg, Ty t);\n\n/* append text at [start, ...): tyStr arms all write into tybuf so nested\n   composition never re-appends a slice of the same buffer */\nSlice tyStrPut(Codegen* cg, Slice text, usize start)\n{\n    stPS(&cg->tybuf, text);\n    return stTail(&cg->tybuf, start);\n}\n\n/* C text of a pointer-to-array type for array Ty arr: `E(*)[N][M]`.\n * C has no `E[N][M]*` spelling (that would be an array of pointers), so\n * every consumer of Pointer(Array) — decls, casts — funnels through here */\nSlice cgPtrToArrTyStr(Codegen* cg, Ty arr)\n{\n    usize start = cg->tybuf.len;\n    Ty w = arr;\n    u64[16] dims;\n    u32 nd = 0;\n    while (w != 0 && (cg->ctx->types + w)->kind.tag == TypeKind::Array && nd < 16)\n    {\n        TypeEntry* we = cg->ctx->types + w;\n        dims[nd] = cgSubsArrayLen(cg, we->kind.payload.Array.sizeParam, we->kind.payload.Array.sizeName, (u64)we->kind.payload.Array.len);\n        nd++;\n        w = we->kind.payload.Array.base;\n    }\n    if (nd == 0 || w == 0) return tyStrPut(cg, Slice::fromStr(\"void*\"), start);\n    tyStr(cg, w);\n    stP(&cg->tybuf, \"(*)[\");\n    u32 di = 0;\n    while (di < nd)\n    {\n        if (di > 0) { stCh(&cg->tybuf, ']'); stCh(&cg->tybuf, '['); }\n        stU64(&cg->tybuf, (u64)dims[di]);\n        di++;\n    }\n    stCh(&cg->tybuf, ']');\n    return stTail(&cg->tybuf, start);\n}\n\nSlice tyStr(Codegen* cg, Ty t)\n{\n    if (t == 0) return Slice::fromStr(\"void*\");\n    TypeEntry* e = cg->ctx->types + t;\n    TypeKind k = e->kind;\n    usize start = cg->tybuf.len;\n    switch (k.tag)\n    {\n        TypeKind::Void => { return tyStrPut(cg, Slice::fromStr(\"void\"), start); },\n        TypeKind::Bool => { return tyStrPut(cg, Slice::fromStr(\"_Bool\"), start); },\n        // char = UTF-32 codepoint (u32 width), never C's 1-byte char\n        TypeKind::Char => { return tyStrPut(cg, Slice::fromStr(\"uint32_t\"), start); },\n        TypeKind::I8 => { return tyStrPut(cg, Slice::fromStr(\"int8_t\"), start); },\n        TypeKind::U8 => { return tyStrPut(cg, Slice::fromStr(\"uint8_t\"), start); },\n        TypeKind::I16 => { return tyStrPut(cg, Slice::fromStr(\"int16_t\"), start); },\n        TypeKind::U16 => { return tyStrPut(cg, Slice::fromStr(\"uint16_t\"), start); },\n        TypeKind::I32 => { return tyStrPut(cg, Slice::fromStr(\"int32_t\"), start); },\n        TypeKind::U32 => { return tyStrPut(cg, Slice::fromStr(\"uint32_t\"), start); },\n        TypeKind::I64 => { return tyStrPut(cg, Slice::fromStr(\"int64_t\"), start); },\n        TypeKind::U64 => { return tyStrPut(cg, Slice::fromStr(\"uint64_t\"), start); },\n        TypeKind::I128 => { return tyStrPut(cg, Slice::fromStr(\"__int128_t\"), start); },\n        TypeKind::U128 => { return tyStrPut(cg, Slice::fromStr(\"__uint128_t\"), start); },\n        TypeKind::F32 => { return tyStrPut(cg, Slice::fromStr(\"float\"), start); },\n        TypeKind::F64 => { return tyStrPut(cg, Slice::fromStr(\"double\"), start); },\n        TypeKind::Isize => { return tyStrPut(cg, Slice::fromStr(\"intptr_t\"), start); },\n        TypeKind::Usize => { return tyStrPut(cg, Slice::fromStr(\"size_t\"), start); },\n        TypeKind::Rawptr => { return tyStrPut(cg, Slice::fromStr(\"void*\"), start); },\n        // str = immutable slice view { ptr, len } (preamble typedef)\n        TypeKind::Str => { return tyStrPut(cg, Slice::fromStr(\"_coral_str\"), start); },\n        TypeKind::Error => { return tyStrPut(cg, Slice::fromStr(\"void\"), start); },\n        TypeKind::Named => {\n            // inside an instance: resolve a bare generic parameter name\n            Ty sub = cgSubstTy(cg, t);\n            if (sub != t) return tyStr(cg, sub);\n            Str name = k.payload.Named.name;\n            /* cchar = the C-ABI byte type → C's plain `char` (the platform\n             * char signedness matches cchar's flag(i8/u8) arms, and libc\n             * prototypes take `char`). coral `char` itself is utf32 and\n             * emits uint32_t, never C's char. */\n            if (cg->ctx->internEqHashLen(name, 0xEF122686, 5)) /* FNV(\"cchar\") */\n                return tyStrPut(cg, Slice::fromStr(\"char\"), start);\n            if (k.payload.Named.genericArgsLen > 0) {\n                return cgInstanceName(cg, name, k.payload.Named.genericArgs, k.payload.Named.genericArgsLen);\n            }\n            // alias? find `typedef` decl with this name and follow it\n            File* file = cg->file;\n            if (file != null) {\n                u32 i = 0;\n                while (i < file->declsLen)\n                {\n                    Node* d = cg->ctx->nodes + file->decls[i].index;\n                    if (d->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* dd = &d->kind.payload.Decl.value;\n                        if (dd->kind.tag == DeclKind::TypeAlias)\n                        {\n                            if (dd->kind.payload.TypeAlias.name == name)\n                                return tyStr(cg, dd->kind.payload.TypeAlias.target);\n                        }\n                        else if (dd->kind.tag == DeclKind::Constant &&\n                                 dd->kind.payload.Constant.name == name &&\n                                 dd->kind.payload.Constant.typeNode != 0 &&\n                                 (cg->ctx->types + dd->kind.payload.Constant.typeNode)->kind.tag == TypeKind::FnPtr)\n                        {\n                            /* a fn-ptr global doubles as its own type name:\n                             * `void(u32) F;` then `F f;` — spell the typedef */\n                            return tyStr(cg, dd->kind.payload.Constant.typeNode);\n                        }\n                    }\n                    i++;\n                }\n            }\n            /* mangle through the declaring decl: the type's own file\n             * (TypeEntry.loc) picks the right one when several files\n             * declare the same type name */\n            NodeId td = cgFindTypeDecl(cg, name, locFile(e->loc));\n            if (td.index != 0) return tyStrPut(cg, cgMangle(cg, td, name, 0), start);\n            return tyStrPut(cg, cgIdent(cg, name), start);\n        },\n        TypeKind::Pointer => {\n            /* pointer-to-array (`i32[4]*`) — a typedef name (`PA_int32_t_4`)\n             * because C declarations need the identifier inside the\n             * declarator (`E (*pa)[N]`); const on the target is dropped\n             * (exotic) */\n            Ty pu = k.payload.Pointer.base;\n            while (pu != 0 && ((cg->ctx->types + pu)->kind.tag == TypeKind::Const ||\n                                (cg->ctx->types + pu)->kind.tag == TypeKind::Comptime))\n                pu = (cg->ctx->types + pu)->kind.payload.Const.base;\n            if (pu != 0 && (cg->ctx->types + pu)->kind.tag == TypeKind::Array)\n                return cgRegName(cg, t);\n            tyStr(cg, k.payload.Pointer.base);\n            stCh(&cg->tybuf, '*');\n            return stTail(&cg->tybuf, start);\n        },\n        TypeKind::Const => {\n            Ty base = k.payload.Const.base;\n            TypeEntry* be = cg->ctx->types + base;\n            if (be->kind.tag == TypeKind::Pointer) {\n                tyStr(cg, base);\n                stP(&cg->tybuf, \" const\");\n                return stTail(&cg->tybuf, start);\n            }\n            stP(&cg->tybuf, \"const \");\n            tyStr(cg, base);\n            return stTail(&cg->tybuf, start);\n        },\n        TypeKind::Comptime => { return tyStr(cg, k.payload.Comptime.base); },\n        TypeKind::TypeParam => {\n            Ty sub = cgSubstTy(cg, t);\n            if (sub != t) return tyStr(cg, sub);\n            cgError(cg, \"unresolved type param in codegen\");\n            return tyStrPut(cg, Slice::fromStr(\"void*\"), start);\n        },\n        TypeKind::Slice => { return cgRegName(cg, t); },\n        TypeKind::FnPtr => { return cgRegName(cg, t); },\n        TypeKind::Tuple => { return cgRegName(cg, t); },\n        /* comptime value mangling fragment: `Arr_int32_t_4` */\n        TypeKind::ValueInt => {\n            stU64(&cg->tybuf, k.payload.ValueInt.value);\n            return stTail(&cg->tybuf, start);\n        },\n        TypeKind::Array => {\n            tyStr(cg, k.payload.Array.base);\n            stCh(&cg->tybuf, '[');\n            stU64(&cg->tybuf, cgSubsArrayLen(cg, k.payload.Array.sizeParam, k.payload.Array.sizeName, (u64)k.payload.Array.len));\n            stCh(&cg->tybuf, ']');\n            return stTail(&cg->tybuf, start);\n        },\n        else => { return tyStrPut(cg, Slice::fromStr(\"void*\"), start); },\n    }\n    return stTail(&cg->tybuf, start);\n}\n\n/* ── registered typedefs (slices, tuples, fn pointers) ───────── */\n\n/* registry of already-emitted typedef names (slices/tuples/fn pointers):\n * cgRegName dedups against it, cgRegAdd records a fresh name right before\n * its text lands in tdecl */\nbool cgRegHas(Codegen* cg, Slice name)\n{\n    u32 i = 0;\n    while (i < cg->regLen)\n    {\n        Slice r = cg->regNames[i];\n        if (r.len == name.len) {\n            bool eq = true;\n            usize j = 0;\n            while (j < name.len) {\n                if (r.ptr[j] != name.ptr[j]) { eq = false; break; }\n                j++;\n            }\n            if (eq) return true;\n        }\n        i++;\n    }\n    return false;\n}\n\nvoid cgRegAdd(Codegen* cg, Slice name)\n{\n    if (cg->regLen >= cg->regCap) return;\n    cg->regNames[cg->regLen] = name;\n    cg->regLen++;\n}\n\n/* has the C symbol already been emitted in this phase (protos / bodies)?\n * `proto` picks the registry so the body pass still runs after the\n * proto pass has seen the same name */\nbool cgFnSeen(Codegen* cg, Slice name, bool proto)\n{\n    Slice* names = cg->bodyFnNames;\n    u32 len = cg->bodyFnLen;\n    if (proto) { names = cg->protoFnNames; len = cg->protoFnLen; }\n    if (names == null) return false;\n    u32 i = 0;\n    while (i < len)\n    {\n        if (cgSliceEq(names[i], name)) return true;\n        i++;\n    }\n    return false;\n}\n\nvoid cgFnSee(Codegen* cg, Slice name, bool proto)\n{\n    if (proto)\n    {\n        if (cg->protoFnNames != null && cg->protoFnLen < cg->protoFnCap)\n        {\n            cg->protoFnNames[cg->protoFnLen] = name;\n            cg->protoFnLen++;\n        }\n    }\n    else\n    {\n        if (cg->bodyFnNames != null && cg->bodyFnLen < cg->bodyFnCap)\n        {\n            cg->bodyFnNames[cg->bodyFnLen] = name;\n            cg->bodyFnLen++;\n        }\n    }\n}\n\nextern(\"C\") Slice cgRegName(Codegen* cg, Ty t);\n\nSlice cgRegName(Codegen* cg, Ty t)\n{\n    TypeEntry* e = cg->ctx->types + t;\n    TypeKind k = e->kind;\n    usize nstart = cg->tybuf.len;\n\n    if (k.tag == TypeKind::Slice) {\n        stP(&cg->tybuf, \"Slice_\");\n        tyStr(cg, k.payload.Slice.base);\n    } else if (k.tag == TypeKind::FnPtr) {\n        /* name from the SUBSTITUTED spelling: `bool(T,T)` under Vec<str>\n         * and Vec<i32> shares one type id but needs two typedefs */\n        stP(&cg->tybuf, \"FnP_\");\n        tyStr(cg, k.payload.FnPtr.returnType);\n        u32 fi = 0;\n        while (fi < k.payload.FnPtr.paramsLen)\n        {\n            stCh(&cg->tybuf, 95);\n            tyStr(cg, k.payload.FnPtr.params[fi]);\n            fi++;\n        }\n        // same mapping as cgMangleTy: `int32_t*` → `int32_t_p`\n        usize si = nstart;\n        while (si < cg->tybuf.len)\n        {\n            u8 c = cg->tybuf.p[si];\n            bool ok = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 95;\n            if (ok) { }\n            else if (c == 42) cg->tybuf.p[si] = 112;\n            else cg->tybuf.p[si] = 95;\n            si++;\n        }\n    } else if (k.tag == TypeKind::Pointer &&\n               k.payload.Pointer.base != 0 &&\n               (cg->ctx->types + k.payload.Pointer.base)->kind.tag == TypeKind::Array) {\n        /* pointer-to-array (`i32[4]*`): declarations need C's\n         * `E (*name)[N]` spelling, which a context-free tyStr cannot\n         * produce (the identifier sits inside the declarator) — a\n         * typedef name works in declarations, params, fields AND casts */\n        stP(&cg->tybuf, \"PA_\");\n        Ty pw = k.payload.Pointer.base;\n        while (pw != 0 && ((cg->ctx->types + pw)->kind.tag == TypeKind::Const ||\n                            (cg->ctx->types + pw)->kind.tag == TypeKind::Comptime))\n            pw = (cg->ctx->types + pw)->kind.payload.Const.base;\n        u64[16] pdims;\n        u32 pnd = 0;\n        while (pw != 0 && (cg->ctx->types + pw)->kind.tag == TypeKind::Array && pnd < 16)\n        {\n            TypeEntry* pwe = cg->ctx->types + pw;\n            pdims[pnd] = cgSubsArrayLen(cg, pwe->kind.payload.Array.sizeParam, pwe->kind.payload.Array.sizeName, (u64)pwe->kind.payload.Array.len);\n            pnd++;\n            pw = pwe->kind.payload.Array.base;\n        }\n        tyStr(cg, pw);\n        u32 pdi = 0;\n        while (pdi < pnd)\n        {\n            stCh(&cg->tybuf, 95);\n            stU64(&cg->tybuf, pdims[pdi]);\n            pdi++;\n        }\n        // same mapping as cgMangleTy: `int32_t*` → `int32_t_p`\n        usize si2 = nstart;\n        while (si2 < cg->tybuf.len)\n        {\n            u8 c2 = cg->tybuf.p[si2];\n            bool ok2 = (c2 >= 97 && c2 <= 122) || (c2 >= 65 && c2 <= 90) || (c2 >= 48 && c2 <= 57) || c2 == 95;\n            if (ok2) { }\n            else if (c2 == 42) cg->tybuf.p[si2] = 112;\n            else cg->tybuf.p[si2] = 95;\n            si2++;\n        }\n    } else {\n        stP(&cg->tybuf, \"_coral_tuple_\");\n        u32 i = 0;\n        while (i < k.payload.Tuple.elemsLen)\n        {\n            if (i > 0) stCh(&cg->tybuf, '_');\n            tyStr(cg, k.payload.Tuple.elems[i]);\n            i++;\n        }\n    }\n    Slice name = stTail(&cg->tybuf, nstart);\n    if (cgRegHas(cg, name)) return name;\n    cgRegAdd(cg, name);\n\n    // dependency typedefs first\n    if (k.tag == TypeKind::Slice) cgRegEnsure(cg, k.payload.Slice.base);\n    if (k.tag == TypeKind::FnPtr) {\n        cgRegEnsure(cg, k.payload.FnPtr.returnType);\n        u32 i = 0;\n        while (i < k.payload.FnPtr.paramsLen) {\n            cgRegEnsure(cg, k.payload.FnPtr.params[i]);\n            i++;\n        }\n    }\n    if (k.tag == TypeKind::Tuple) {\n        u32 i = 0;\n        while (i < k.payload.Tuple.elemsLen) {\n            cgRegEnsure(cg, k.payload.Tuple.elems[i]);\n            i++;\n        }\n    }\n\n    // emit the typedef\n    if (k.tag == TypeKind::Slice) {\n        stP(&cg->tdecl, \"typedef struct \");\n        stPS(&cg->tdecl, name);\n        stP(&cg->tdecl, \" { \");\n        stPS(&cg->tdecl, tyStr(cg, k.payload.Slice.base));\n        stP(&cg->tdecl, \"* ptr; size_t len; } \");\n        stPS(&cg->tdecl, name);\n        stP(&cg->tdecl, \";\\n\");\n    } else if (k.tag == TypeKind::FnPtr) {\n        stP(&cg->tdecl, \"typedef \");\n        stPS(&cg->tdecl, tyStr(cg, k.payload.FnPtr.returnType));\n        stP(&cg->tdecl, \" (*\");\n        stPS(&cg->tdecl, name);\n        stP(&cg->tdecl, \")(\");\n        u32 i = 0;\n        while (i < k.payload.FnPtr.paramsLen)\n        {\n            if (i > 0) stP(&cg->tdecl, \", \");\n            stPS(&cg->tdecl, tyStr(cg, k.payload.FnPtr.params[i]));\n            i++;\n        }\n        stP(&cg->tdecl, \");\\n\");\n    } else if (k.tag == TypeKind::Pointer &&\n               k.payload.Pointer.base != 0 &&\n               (cg->ctx->types + k.payload.Pointer.base)->kind.tag == TypeKind::Array) {\n        Ty pw2 = k.payload.Pointer.base;\n        while (pw2 != 0 && ((cg->ctx->types + pw2)->kind.tag == TypeKind::Const ||\n                             (cg->ctx->types + pw2)->kind.tag == TypeKind::Comptime))\n            pw2 = (cg->ctx->types + pw2)->kind.payload.Const.base;\n        u64[16] pdims2;\n        u32 pnd2 = 0;\n        while (pw2 != 0 && (cg->ctx->types + pw2)->kind.tag == TypeKind::Array && pnd2 < 16)\n        {\n            TypeEntry* pwe2 = cg->ctx->types + pw2;\n            pdims2[pnd2] = cgSubsArrayLen(cg, pwe2->kind.payload.Array.sizeParam, pwe2->kind.payload.Array.sizeName, (u64)pwe2->kind.payload.Array.len);\n            pnd2++;\n            pw2 = pwe2->kind.payload.Array.base;\n        }\n        cgRegEnsure(cg, pw2);\n        stP(&cg->tdecl, \"typedef \");\n        stPS(&cg->tdecl, tyStr(cg, pw2));\n        stP(&cg->tdecl, \" (*\");\n        stPS(&cg->tdecl, name);\n        stCh(&cg->tdecl, ')');\n        u32 pdj = 0;\n        while (pdj < pnd2)\n        {\n            stP(&cg->tdecl, \"[\");\n            stU64(&cg->tdecl, pdims2[pdj]);\n            stP(&cg->tdecl, \"]\");\n            pdj++;\n        }\n        stP(&cg->tdecl, \";\\n\");\n    } else {\n        stP(&cg->tdecl, \"typedef struct \");\n        stPS(&cg->tdecl, name);\n        stP(&cg->tdecl, \" {\\n\");\n        u32 i = 0;\n        while (i < k.payload.Tuple.elemsLen)\n        {\n            stP(&cg->tdecl, \"    \");\n            stPS(&cg->tdecl, tyStr(cg, k.payload.Tuple.elems[i]));\n            stP(&cg->tdecl, \" _\");\n            stU64(&cg->tdecl, (u64)(i + 1));\n            stP(&cg->tdecl, \";\\n\");\n            i++;\n        }\n        stP(&cg->tdecl, \"} \");\n        stPS(&cg->tdecl, name);\n        stP(&cg->tdecl, \";\\n\");\n    }\n    /* restore the scratch length: the typedef emission above appended the\n     * dependency spellings (tyStr of ret/params) after the name, and\n     * composing tyStr arms (`const T`, `T*`, `T[N]`) return stTail over the\n     * whole span — the residue would leak into their output */\n    stTrunc(&cg->tybuf, nstart + name.len);\n    return name;\n}\n\nvoid cgRegEnsure(Codegen* cg, Ty t)\n{\n    if (t == 0) return;\n    TypeEntry* e = cg->ctx->types + t;\n    TypeKind k = e->kind;\n    if (k.tag == TypeKind::Slice || k.tag == TypeKind::FnPtr || k.tag == TypeKind::Tuple)\n        cgRegName(cg, t);\n    if (k.tag == TypeKind::Pointer && k.payload.Pointer.base != 0 &&\n        (cg->ctx->types + k.payload.Pointer.base)->kind.tag == TypeKind::Array)\n        cgRegName(cg, t);\n}\n\n/* ── helpers ─────────────────────────────────────────────────── */\n\nNode* cgNode(Codegen* cg, NodeId id)\n{\n    return cg->ctx->nodes + id.index;\n}\n\n// C type text for a value expression node (0-safe).\nSlice cgValExprTy(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return Slice::fromStr(\"void*\");\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return Slice::fromStr(\"void*\");\n    return cgResultTy(cg, id, &n->kind.payload.Expr.value);\n}\n\n/* --allow-int-ptr lowering: sema waived an integer→pointer bind, but gcc\n * still rejects the bare conversion: emit the explicit C cast instead */\nbool cgIntTyTag(Codegen* cg, Ty t)\n{\n    if (t == 0) return false;\n    TypeEntry* e = cg->ctx->types + t;\n    return e->kind.tag == TypeKind::U8 || e->kind.tag == TypeKind::U16 || e->kind.tag == TypeKind::U32 ||\n           e->kind.tag == TypeKind::U64 || e->kind.tag == TypeKind::U128 || e->kind.tag == TypeKind::I8 ||\n           e->kind.tag == TypeKind::I16 || e->kind.tag == TypeKind::I32 || e->kind.tag == TypeKind::I64 ||\n           e->kind.tag == TypeKind::I128 || e->kind.tag == TypeKind::Usize || e->kind.tag == TypeKind::Isize ||\n           e->kind.tag == TypeKind::Char;\n}\n\nbool cgPtrTyTag(Codegen* cg, Ty t)\n{\n    while (t != 0)\n    {\n        TypeEntry* e = cg->ctx->types + t;\n        if (e->kind.tag == TypeKind::Pointer || e->kind.tag == TypeKind::Rawptr) return true;\n        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;\n        else return false;\n    }\n    return false;\n}\n\nbool cgIntToPtrInit(Codegen* cg, NodeId value, Ty targetTy)\n{\n    if (value.index == 0 || targetTy == 0) return false;\n    if (!cgPtrTyTag(cg, targetTy)) return false;\n    Node* n = cgNode(cg, value);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* ev = &n->kind.payload.Expr.value;\n    if (ev->kind.tag == ExprKind::IntLit) return true;\n    return cgIntTyTag(cg, ev->resolvedType);\n}\n\nSlice cgWrapPtrCast(Codegen* cg, Slice tyText, Slice inner)\n{\n    usize rs = cg->ebuf.len;\n    stP(&cg->ebuf, \"((\");\n    stPS(&cg->ebuf, tyText);\n    stP(&cg->ebuf, \")(\");\n    stPS(&cg->ebuf, inner);\n    stP(&cg->ebuf, \"))\");\n    return stTail(&cg->ebuf, rs);\n}\n\n/* C type text for an expression: sema's resolvedType when present, else\n * derived from the kind (Not → _Bool, AddressOf → base + '*', assignments\n * → the assigned value's type) */\nSlice cgResultTy(Codegen* cg, NodeId id, Expr* e)\n{\n    if (e->resolvedType != 0) return tyStr(cg, cgSubstTy(cg, e->resolvedType));\n    switch (e->kind.tag)\n    {\n        ExprKind::Not => { return Slice::fromStr(\"_Bool\"); },\n        ExprKind::AddressOf => {\n            NodeId c = e->kind.payload.AddressOf.expr;\n            Node* cn = cgNode(cg, c);\n            Slice base = Slice::fromStr(\"void*\");\n            usize s = cg->tybuf.len;\n            if (cn->kind.tag == NodeKind::Expr)\n                base = cgResultTy(cg, c, &cn->kind.payload.Expr.value);\n            /* base usually IS the tail of tybuf already; appending it\n             * again would print the type twice, so only copy when it\n             * came from somewhere else */\n            if (!(base.ptr + base.len == cg->tybuf.p + cg->tybuf.len))\n                stPS(&cg->tybuf, base);\n            stCh(&cg->tybuf, '*');\n            return stTail(&cg->tybuf, s);\n        },\n        ExprKind::Assign => { return cgValExprTy(cg, e->kind.payload.Assign.value); },\n        ExprKind::AssignAdd => { return cgValExprTy(cg, e->kind.payload.AssignAdd.value); },\n        ExprKind::AssignSub => { return cgValExprTy(cg, e->kind.payload.AssignSub.value); },\n        ExprKind::AssignMul => { return cgValExprTy(cg, e->kind.payload.AssignMul.value); },\n        ExprKind::AssignDiv => { return cgValExprTy(cg, e->kind.payload.AssignDiv.value); },\n        ExprKind::AssignMod => { return cgValExprTy(cg, e->kind.payload.AssignMod.value); },\n        ExprKind::AssignBitAnd => { return cgValExprTy(cg, e->kind.payload.AssignBitAnd.value); },\n        ExprKind::AssignBitOr => { return cgValExprTy(cg, e->kind.payload.AssignBitOr.value); },\n        ExprKind::AssignBitXor => { return cgValExprTy(cg, e->kind.payload.AssignBitXor.value); },\n        ExprKind::AssignShl => { return cgValExprTy(cg, e->kind.payload.AssignShl.value); },\n        ExprKind::AssignShr => { return cgValExprTy(cg, e->kind.payload.AssignShr.value); },\n        else => {},\n    }\n    return Slice::fromStr(\"void*\");\n}\n\nvoid cgEmitStmt(Codegen* cg, str text)\n{\n    stNL(&cg->body, cg->ind);\n    stPS(&cg->body, Slice::fromStr(text));\n    stCh(&cg->body, ';');\n}\n\nvoid cgEmitLine(Codegen* cg, Slice a, str mid, Slice b)\n{\n    stNL(&cg->body, cg->ind);\n    stPS(&cg->body, a);\n    stP(&cg->body, mid);\n    stPS(&cg->body, b);\n    stCh(&cg->body, ';');\n}\n\nvoid cgEmitLabel(Codegen* cg, u32 lab)\n{\n    stNL(&cg->body, cg->ind);\n    stP(&cg->body, \"__L\");\n    stU64(&cg->body, (u64)lab);\n    stP(&cg->body, \": ;\"); // a label must precede a statement: the empty one\n}\n\nvoid cgEmitGoto(Codegen* cg, u32 lab)\n{\n    stNL(&cg->body, cg->ind);\n    stP(&cg->body, \"goto __L\");\n    stU64(&cg->body, (u64)lab);\n    stCh(&cg->body, ';');\n}\n\nbool slEqU8(Slice a, str b)\n{\n    if (a.len != b.len) return false;\n    usize i = 0;\n    while (i < b.len) {\n        if (a.ptr[i] != b.ptr[i]) return false;\n        i++;\n    }\n    return true;\n}\n\n/* identifiers that collide with a C keyword (or a stdlib macro) get a\n * trailing underscore so the generated C stays valid */\nSlice cgIdent(Codegen* cg, Str name)\n{\n    Slice t = cgIntern(cg, name);\n    if (slEqU8(t, \"auto\") ||\n        slEqU8(t, \"break\") ||\n        slEqU8(t, \"case\") ||\n        slEqU8(t, \"char\") ||\n        slEqU8(t, \"const\") ||\n        slEqU8(t, \"continue\") ||\n        slEqU8(t, \"default\") ||\n        slEqU8(t, \"do\") ||\n        slEqU8(t, \"double\") ||\n        slEqU8(t, \"else\") ||\n        slEqU8(t, \"enum\") ||\n        slEqU8(t, \"extern\") ||\n        slEqU8(t, \"float\") ||\n        slEqU8(t, \"for\") ||\n        slEqU8(t, \"goto\") ||\n        slEqU8(t, \"if\") ||\n        slEqU8(t, \"inline\") ||\n        slEqU8(t, \"int\") ||\n        slEqU8(t, \"long\") ||\n        slEqU8(t, \"register\") ||\n        slEqU8(t, \"restrict\") ||\n        slEqU8(t, \"return\") ||\n        slEqU8(t, \"short\") ||\n        slEqU8(t, \"signed\") ||\n        slEqU8(t, \"sizeof\") ||\n        slEqU8(t, \"static\") ||\n        slEqU8(t, \"struct\") ||\n        slEqU8(t, \"switch\") ||\n        slEqU8(t, \"typedef\") ||\n        slEqU8(t, \"union\") ||\n        slEqU8(t, \"unsigned\") ||\n        slEqU8(t, \"void\") ||\n        slEqU8(t, \"volatile\") ||\n        slEqU8(t, \"while\") ||\n        slEqU8(t, \"bool\") ||\n        slEqU8(t, \"true\") ||\n        slEqU8(t, \"false\") ||\n        slEqU8(t, \"size_t\") ||\n        slEqU8(t, \"NULL\"))\n    {\n        usize ns = cg->tybuf.len;\n        stPS(&cg->tybuf, t);\n        stCh(&cg->tybuf, '_');\n        return stTail(&cg->tybuf, ns);\n    }\n    return t;\n}\n\n// owner name for a method receiver type: strip one pointer level\nSlice cgOwnerName(Codegen* cg, Ty selfTy)\n{\n    TypeEntry* e = cg->ctx->types + selfTy;\n    Ty u = selfTy;\n    if (e->kind.tag == TypeKind::Pointer) u = e->kind.payload.Pointer.base;\n    TypeEntry* ue = cg->ctx->types + u;\n    /* method symbol suffixes key off the bare coral owner name: def and\n     * call sides both compose `owner_method` from it; but tyStr now\n     * path-mangles type names, so a plain non-generic Named must not go\n     * through it (the self *parameter* uses cgOwnerTypeName instead) */\n    if (ue->kind.tag == TypeKind::Named && ue->kind.payload.Named.genericArgsLen == 0)\n    {\n        Ty sub = cgSubstTy(cg, u);\n        if (sub == u) return cgIdent(cg, ue->kind.payload.Named.name);\n        return tyStr(cg, sub);\n    }\n    return tyStr(cg, u);\n}\n\n/* the receiver's C type name for the self parameter: tyStr (path-mangled\n * through the type's declaring decl), pointer level stripped like\n * cgOwnerName: cgOwnerName stays bare because it also forms symbol\n * suffixes */\nSlice cgOwnerTypeName(Codegen* cg, Ty selfTy)\n{\n    Ty u = selfTy;\n    TypeEntry* e = cg->ctx->types + selfTy;\n    if (e->kind.tag == TypeKind::Pointer) u = e->kind.payload.Pointer.base;\n    TypeEntry* e2 = cg->ctx->types + u;\n    if (e2->kind.tag == TypeKind::Const) u = e2->kind.payload.Const.base;\n    return tyStr(cg, u);\n}\n\n/* does the receiver's named struct/union declare field `name`? Used to\n * spot fn-pointer field calls (`p->alloc(ctx, size)` parses as a method) */\nbool cgHasField(Codegen* cg, Ty t, Str name)\n{\n    Ty u = cgTyUnwrap(cg, t);\n    if (u != 0 && (cg->ctx->types + u)->kind.tag == TypeKind::Pointer)\n        u = cgTyUnwrap(cg, (cg->ctx->types + u)->kind.payload.Pointer.base);\n    if (u == 0 || (cg->ctx->types + u)->kind.tag != TypeKind::Named) return false;\n    Str tn = (cg->ctx->types + u)->kind.payload.Named.name;\n    NodeId d = cgFindDecl(cg, tn, (u32)DeclKind::Struct);\n    if (d.index == 0) d = cgFindDecl(cg, tn, (u32)DeclKind::Union);\n    if (d.index == 0) return false;\n    Node* dn = cgNode(cg, d);\n    if (dn->kind.tag != NodeKind::Decl) return false;\n    Decl* dd = &dn->kind.payload.Decl.value;\n    NodeId* fields = null;\n    u32 flen = 0;\n    if (dd->kind.tag == DeclKind::Struct) {\n        fields = dd->kind.payload.Struct.fields;\n        flen = dd->kind.payload.Struct.fieldsLen;\n    } else if (dd->kind.tag == DeclKind::Union) {\n        fields = dd->kind.payload.Union.fields;\n        flen = dd->kind.payload.Union.fieldsLen;\n    } else return false;\n    u32 i = 0;\n    while (i < flen)\n    {\n        Node* fn = cgNode(cg, fields[i]);\n        if (fn->kind.tag == NodeKind::Field && fn->kind.payload.Field.value.name == name) return true;\n        i++;\n    }\n    return false;\n}\n\n/* receiver for a method call: 0 = none (static), 1 = by value,\n * 2 = explicit `self` parameter (pointer); *found = the method exists\n * on the receiver type (false = not a real method, e.g. a fn-pointer\n * field call like `alloc->fallback->alloc(...)`) */\nu8 cgMethodRecvKind(Codegen* cg, Ty recvTy, Str method, bool* found)\n{\n    *found = false;\n    if (recvTy == 0 || cg->file == null) return 1;\n    TypeEntry* e = cg->ctx->types + recvTy;\n    while (e->kind.tag == TypeKind::Pointer || e->kind.tag == TypeKind::Const || e->kind.tag == TypeKind::Comptime)\n    {\n        if (e->kind.tag == TypeKind::Pointer) recvTy = e->kind.payload.Pointer.base;\n        else if (e->kind.tag == TypeKind::Const) recvTy = e->kind.payload.Const.base;\n        else recvTy = e->kind.payload.Comptime.base;\n        e = cg->ctx->types + recvTy;\n    }\n    if (e->kind.tag != TypeKind::Named) return 1;\n    Str typeName = e->kind.payload.Named.name;\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        Node* d = cg->ctx->nodes + cg->file->decls[i].index;\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            NodeId* methods = null;\n            u32 mlen = 0;\n            switch (dd->kind.tag)\n            {\n                DeclKind::Struct => {\n                    if (dd->kind.payload.Struct.name != typeName) break;\n                    methods = dd->kind.payload.Struct.methods;\n                    mlen = dd->kind.payload.Struct.methodsLen;\n                },\n                DeclKind::Union => {\n                    if (dd->kind.payload.Union.name != typeName) break;\n                    methods = dd->kind.payload.Union.methods;\n                    mlen = dd->kind.payload.Union.methodsLen;\n                },\n                DeclKind::Variant => {\n                    if (dd->kind.payload.Variant.name != typeName) break;\n                    methods = dd->kind.payload.Variant.methods;\n                    mlen = dd->kind.payload.Variant.methodsLen;\n                },\n                /* an extend's methods belong to its self type — without\n                 * this filter a fn-pointer field call (`p->alloc(...)`,\n                 * where some OTHER type has an `alloc` method) matches\n                 * this unrelated extend and composes a bogus method call */\n                DeclKind::Extend => {\n                    Ty st = cgTyUnwrap(cg, dd->kind.payload.Extend.selfType);\n                    if (st != 0 && (cg->ctx->types + st)->kind.tag == TypeKind::Pointer)\n                        st = cgTyUnwrap(cg, (cg->ctx->types + st)->kind.payload.Pointer.base);\n                    if (st == 0 || (cg->ctx->types + st)->kind.tag != TypeKind::Named ||\n                        (cg->ctx->types + st)->kind.payload.Named.name != typeName) break;\n                    methods = dd->kind.payload.Extend.methods;\n                    mlen = dd->kind.payload.Extend.methodsLen;\n                },\n                DeclKind::ExtendTrait => {\n                    Ty st = cgTyUnwrap(cg, dd->kind.payload.ExtendTrait.selfType);\n                    if (st != 0 && (cg->ctx->types + st)->kind.tag == TypeKind::Pointer)\n                        st = cgTyUnwrap(cg, (cg->ctx->types + st)->kind.payload.Pointer.base);\n                    if (st == 0 || (cg->ctx->types + st)->kind.tag != TypeKind::Named ||\n                        (cg->ctx->types + st)->kind.payload.Named.name != typeName) break;\n                    methods = dd->kind.payload.ExtendTrait.methods;\n                    mlen = dd->kind.payload.ExtendTrait.methodsLen;\n                },\n                else => {},\n            }\n            if (methods != null)\n            {\n                u32 m = 0;\n                while (m < mlen)\n                {\n                    Node* mn = cg->ctx->nodes + methods[m].index;\n                    if (mn->kind.tag == NodeKind::Decl && mn->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n                    {\n                        Decl* md = &mn->kind.payload.Decl.value;\n                        if (md->kind.payload.Func.name == method)\n                        {\n                            *found = true;\n                            if ((md->kind.payload.Func.flags & 4) != 0) return 0;\n                            if (md->kind.payload.Func.paramsLen > 0)\n                            {\n                                Node* p0 = cg->ctx->nodes + md->kind.payload.Func.params[0].index;\n                                if (p0->kind.tag == NodeKind::Param && (p0->kind.payload.Param.value.flags & 1) != 0) return 2;\n                            }\n                            return 1;\n                        }\n                    }\n                    m++;\n                }\n            }\n        }\n        i++;\n    }\n    return 1;\n}\n\n/* ── expressions ─────────────────────────────────────────────── */\n\n/* the Func decl in the module tree whose interned name matches a\n * precomputed FNV hash+length; 0 when the unit does not contain it.\n * no probe string is interned. */\nNodeId cgFindDeclByHash(Codegen* cg, u32 hash, u32 len)\n{\n    NodeId none;\n    none.index = 0;\n    if (cg->file == null) return none;\n    u32 i = 0;\n    while (i < cg->file->declsLen)\n    {\n        NodeId did = cg->file->decls[i];\n        Node* n = cg->ctx->nodes + did.index;\n        if (n->kind.tag == NodeKind::Decl &&\n            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        {\n            Decl* d = &n->kind.payload.Decl.value;\n            if (cg->ctx->internEqHashLen(d->kind.payload.Func.name, hash, len)) return did;\n        }\n        i++;\n    }\n    return none;\n}\n\n/* comma-separated argument text for a call against `fdecl`'s parameter\n * list (0 = unknown): comptime params are skipped, str→ptr and\n * array→slice params decay, by-value args are moved. */\nSlice cgCallArgsText(Codegen* cg, NodeId fdecl, NodeId* args, u32 argsLen)\n{\n    Stream abuf = stNew(cg->arena, 64);\n    bool first = true;\n    u32 i = 0;\n    while (i < argsLen && i < 16) {\n        bool skip = false;\n        bool dec = false;\n        Ty sliceTy = 0;\n        if (fdecl.index != 0) {\n            Node* fdn = cgNode(cg, fdecl);\n            Decl* fd = &fdn->kind.payload.Decl.value;\n            if (i < fd->kind.payload.Func.paramsLen) {\n                Node* pn = cgNode(cg, fd->kind.payload.Func.params[i]);\n                if (pn->kind.tag == NodeKind::Param) {\n                    Param* pp = &pn->kind.payload.Param.value;\n                    if ((pp->flags & 8) != 0) skip = true;\n                    else dec = cgStrToPtr(cg, pp->typeNode, args[i]);\n                    if (!dec) sliceTy = cgArrayToSliceParam(cg, pp->typeNode, args[i]);\n                }\n            }\n        }\n        if (!skip) {\n            if (first) first = false;\n            else stP(&abuf, \", \");\n            if (sliceTy != 0)\n            {\n                Node* san = cgNode(cg, args[i]);\n                Ty sat = cgSubstTy(cg, san->kind.payload.Expr.value.resolvedType);\n                cgEmitSliceFromArr(cg, sliceTy, sat, cgExpr(cg, args[i]));\n            }\n            else\n            {\n                /* str→ptr decay borrows the buffer; a plain by-value\n                 * arg moves it */\n                if (!dec) cgMoveArg(cg, args[i]);\n                stPS(&abuf, cgExpr(cg, args[i]));\n                if (dec) stP(&abuf, \".ptr\");\n            }\n        }\n        i++;\n    }\n    if (argsLen > 16) cgError(cg, \"too many arguments (cap 16)\");\n    return stTail(&abuf, 0);\n}\n\nextern(\"C\") Slice cgExpr(Codegen* cg, NodeId id);\nextern(\"C\") Slice cgLvalue(Codegen* cg, NodeId id);\nextern(\"C\") Slice cgValBody(Codegen* cg, NodeId id);\nextern(\"C\") void cgStmt(Codegen* cg, NodeId id);\nextern(\"C\") Slice cgAddrOfValue(Codegen* cg, NodeId oid, Slice vtext);\nextern(\"C\") Slice cgInitValue(Codegen* cg, NodeId v);\n\nSlice cgExpr(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) {\n        stP(&cg->ebuf, \"0\");\n        return stTail(&cg->ebuf, cg->ebuf.len - 1);\n    }\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) {\n        stP(&cg->ebuf, \"0\");\n        return stTail(&cg->ebuf, cg->ebuf.len - 1);\n    }\n    Expr* e = &n->kind.payload.Expr.value;\n    usize es = cg->ebuf.len;\n\n    switch (e->kind.tag)\n    {\n        // atoms\n        ExprKind::IntLit => {\n            /* Give the C literal the type sema assigned. A bare decimal\n             * is `int`, so `1 << 32` (from a u64 literal) shifts a 32-bit\n             * value and is undefined in C; `((uint64_t)1)` is not. */\n            Ty rt = e->resolvedType != 0 ? cgSubstTy(cg, e->resolvedType) : 0;\n            while (rt != 0)\n            {\n                TypeEntry* te = cg->ctx->types + rt;\n                if (te->kind.tag == TypeKind::Const) rt = te->kind.payload.Const.base;\n                else if (te->kind.tag == TypeKind::Comptime) rt = te->kind.payload.Comptime.base;\n                else break;\n            }\n            bool wrap = false;\n            if (rt != 0)\n            {\n                TypeEntry* te = cg->ctx->types + rt;\n                switch (te->kind.tag)\n                {\n                    TypeKind::I8 | TypeKind::U8 | TypeKind::I16 | TypeKind::U16 |\n                    TypeKind::I32 | TypeKind::U32 | TypeKind::I64 | TypeKind::U64 |\n                    TypeKind::I128 | TypeKind::U128 | TypeKind::Isize | TypeKind::Usize |\n                    TypeKind::Char => { wrap = true; },\n                    else => { },\n                }\n            }\n            if (wrap)\n            {\n                Slice tn = tyStr(cg, rt);\n                stP(&cg->ebuf, \"((\");\n                stPS(&cg->ebuf, tn);\n                stP(&cg->ebuf, \")\");\n                stU64(&cg->ebuf, e->kind.payload.IntLit.value);\n                stP(&cg->ebuf, \")\");\n            }\n            else\n            {\n                stU64(&cg->ebuf, e->kind.payload.IntLit.value);\n            }\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::FloatLit => {\n            stPS(&cg->ebuf, cgIntern(cg, e->kind.payload.FloatLit.value));\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::StringLit => {\n            /* C\"...\" → plain NUL-terminated C string literal; any other\n             * string literal → immutable slice, the compiler counts the len */\n            Slice s = cgIntern(cg, e->kind.payload.StringLit.value);\n            bool isC = (e->kind.payload.StringLit.flags & 1) != 0;\n            if (isC) stP(&cg->ebuf, \"\\\"\");\n            else stP(&cg->ebuf, \"(_coral_str){ (const uint8_t*)\\\"\");\n            usize begin = 0;\n            usize end = s.len;\n            if (isC) {\n                // token text is `C\"…\"`: drop the prefix and both quotes\n                if (s.len >= 3 && s.ptr[0] == 'C' && s.ptr[1] == '\"') { begin = 2; end = s.len - 1; }\n            } else if (s.len >= 2 && s.ptr[0] == '\"') { begin = 1; end = s.len - 1; }\n            usize i = begin;\n            /* decoded length for the slice: every escape counts as ONE\n             * byte, which is what a coral `str` len means */\n            usize dlen = 0;\n            while (i < end)\n            {\n                u8 c = s.ptr[i];\n                if (c == '\\\\' && i + 1 < end) {\n                    u8 esc = s.ptr[i + 1];\n                    if (esc == 'n') stP(&cg->ebuf, \"\\\\n\");\n                    else if (esc == 't') stP(&cg->ebuf, \"\\\\t\");\n                    else if (esc == 'r') stP(&cg->ebuf, \"\\\\r\");\n                    else if (esc == '0') stP(&cg->ebuf, \"\\\\0\");\n                    else if (esc == '\"' || esc == '\\\\' || esc == '\\'') { stCh(&cg->ebuf, '\\\\'); stCh(&cg->ebuf, esc); }\n                    else { stCh(&cg->ebuf, esc); }\n                    dlen++;\n                    i += 2;\n                } else if (c == '\"') {\n                    stP(&cg->ebuf, \"\\\\\\\"\");\n                    dlen++;\n                    i++;\n                } else if (c < 32 || c > 126) {\n                    /* non-printables as 3-digit octal so the C literal\n                     * stays portable (hex escapes would eat following\n                     * hex digits of the next char) */\n                    stP(&cg->ebuf, \"\\\\\");\n                    u8 v = c;\n                    stCh(&cg->ebuf, (u8)(48 + (v / 64)));\n                    stCh(&cg->ebuf, (u8)(48 + ((v / 8) % 8)));\n                    stCh(&cg->ebuf, (u8)(48 + (v % 8)));\n                    dlen++;\n                    i++;\n                } else {\n                    stCh(&cg->ebuf, c);\n                    dlen++;\n                    i++;\n                }\n            }\n            if (isC) {\n                stP(&cg->ebuf, \"\\\"\");\n            } else {\n                stP(&cg->ebuf, \"\\\", \");\n                stU64(&cg->ebuf, (u64)dlen);\n                stP(&cg->ebuf, \" }\");\n            }\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::CharLit => {\n            u32 v = e->kind.payload.CharLit.value;\n            /* `'` (39) and `\\` (92) need an escape; printable chars go\n             * out as C chars, everything else as a numeric cast */\n            if (v == 39 || v == 92) {\n                stCh(&cg->ebuf, '\\'');\n                stCh(&cg->ebuf, '\\\\');\n                stCh(&cg->ebuf, (u8)v);\n                stCh(&cg->ebuf, '\\'');\n            } else if (v >= 32 && v < 127) {\n                stCh(&cg->ebuf, '\\'');\n                stCh(&cg->ebuf, (u8)v);\n                stCh(&cg->ebuf, '\\'');\n            } else {\n                stP(&cg->ebuf, \"(uint32_t)\");\n                stU64(&cg->ebuf, (u64)v);\n            }\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::BoolLit => {\n            if (e->kind.payload.BoolLit.flags & 1) stP(&cg->ebuf, \"1\");\n            else stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::NullLit => {\n            /* `null` in a str position is the empty slice, not C NULL */\n            Ty nt = cgSubstTy(cg, e->resolvedType);\n            if (nt != 0 && (cg->ctx->types + nt)->kind.tag == TypeKind::Str)\n            {\n                stP(&cg->ebuf, \"(_coral_str){0}\");\n                return stTail(&cg->ebuf, es);\n            }\n            stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::Ident => {\n            /* generic value parameter in an instance body (`N` in\n             * `Arr<T, N>`: `return N;`, `self.data[N - 1]`): sema typed the\n             * ident as the param; emit the instance's argument value */\n            Ty vt = cgSubstTy(cg, e->resolvedType);\n            if (vt != e->resolvedType && vt != 0)\n            {\n                TypeEntry* ve = cg->ctx->types + vt;\n                if (ve->kind.tag == TypeKind::ValueInt)\n                {\n                    stU64(&cg->ebuf, ve->kind.payload.ValueInt.value);\n                    return stTail(&cg->ebuf, es);\n                }\n            }\n            Str nm = e->kind.payload.Ident.name;\n            if (!cgIsLocalName(cg, nm))\n            {\n                Str alias = 0;\n                NodeId rd = cgResolveRef(cg, nm, 0, id, &alias);\n                if (rd.index != 0)\n                {\n                    Node* rn = cgNode(cg, rd);\n                    if (rn->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* rdd = &rn->kind.payload.Decl.value;\n                        if (rdd->kind.tag == DeclKind::Func || rdd->kind.tag == DeclKind::Constant)\n                        {\n                            Str own = cgDeclOwnName(rdd);\n                            if (own != 0)\n                            {\n                                stPS(&cg->ebuf, cgMangle(cg, rd, own, alias));\n                                return stTail(&cg->ebuf, es);\n                            }\n                        }\n                    }\n                }\n            }\n            stPS(&cg->ebuf, cgIdent(cg, nm));\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::Path => {\n            u32 last = e->kind.payload.Path.segmentsLen;\n            if (last == 0) { stP(&cg->ebuf, \"0\"); return stTail(&cg->ebuf, es); }\n            // enum value: `Color::Red` → Color_Red\n            if (last == 2) {\n                Node* seg0 = cgNode(cg, e->kind.payload.Path.segments[0]);\n                if (seg0->kind.tag == NodeKind::Expr && seg0->kind.payload.Expr.value.kind.tag == ExprKind::Ident) {\n                    Str root = seg0->kind.payload.Expr.value.kind.payload.Ident.name;\n                    NodeId ed = cgFindDecl(cg, root, (u32)DeclKind::Enum);\n                    if (ed.index != 0) {\n                        Node* seg1 = cgNode(cg, e->kind.payload.Path.segments[1]);\n                        if (seg1->kind.tag == NodeKind::Expr && seg1->kind.payload.Expr.value.kind.tag == ExprKind::Ident) {\n                            stPS(&cg->ebuf, cgMangle(cg, ed, root, 0));\n                            stCh(&cg->ebuf, '_');\n                            stPS(&cg->ebuf, cgIntern(cg, seg1->kind.payload.Expr.value.kind.payload.Ident.name));\n                            return stTail(&cg->ebuf, es);\n                        }\n                    }\n                }\n            }\n            // variant: `Option<f64>::None` → (Option_f64){ .tag = v }\n            if (last == 2)\n            {\n                Node* s0n = cgNode(cg, e->kind.payload.Path.segments[0]);\n                Node* s1n = cgNode(cg, e->kind.payload.Path.segments[1]);\n                if (s0n->kind.tag == NodeKind::Expr && s1n->kind.tag == NodeKind::Expr)\n                {\n                    Expr* s0 = &s0n->kind.payload.Expr.value;\n                    Expr* s1 = &s1n->kind.payload.Expr.value;\n                    if (s1->kind.tag == ExprKind::Ident)\n                    {\n                        Ty hty = 0;\n                        if (s0->kind.tag == ExprKind::TypeRef) hty = s0->kind.payload.TypeRef.typeNode;\n                        else if (s0->kind.tag == ExprKind::Ident) hty = e->resolvedType;\n                        if (hty != 0)\n                        {\n                            u32 vidx = 0;\n                            NodeId vd = cgFindVariantOfTy(cg, hty, s1->kind.payload.Ident.name, &vidx);\n                            if (vd.index != 0)\n                            {\n                                Ty rty = e->resolvedType;\n                                if (rty == 0) rty = hty;\n                                Slice lty = tyStr(cg, cgSubstTy(cg, rty));\n                                usize vs = cg->ebuf.len;\n                                stP(&cg->ebuf, \"((\");\n                                stPS(&cg->ebuf, lty);\n                                stP(&cg->ebuf, \"){ .tag = \");\n                                stU64(&cg->ebuf, (u64)vidx);\n                                stP(&cg->ebuf, \"})\");\n                                return stTail(&cg->ebuf, vs);\n                            }\n                        }\n                    }\n                }\n            }\n            return cgExpr(cg, e->kind.payload.Path.segments[last - 1]);\n        },\n        ExprKind::Sizeof => {\n            stP(&cg->ebuf, \"sizeof(\");\n            stPS(&cg->ebuf, tyStr(cg, e->kind.payload.Sizeof.targetType));\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::Alignof => {\n            stP(&cg->ebuf, \"__alignof__(\");\n            stPS(&cg->ebuf, tyStr(cg, e->kind.payload.Alignof.targetType));\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, es);\n        },\n\n        // pure inline: children become temps first, result parenthesized\n        ExprKind::Neg => {\n            Slice c = cgExpr(cg, e->kind.payload.Neg.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"(-(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::BitNot => {\n            Slice c = cgExpr(cg, e->kind.payload.BitNot.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"(~(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::Not => {\n            Slice c = cgExpr(cg, e->kind.payload.Not.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"(!(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::AddressOf => {\n            NodeId oid = e->kind.payload.AddressOf.expr;\n            Slice vt = cgExpr(cg, oid);\n            return cgAddrOfValue(cg, oid, vt);\n        },\n        ExprKind::Deref => {\n            Slice c = cgExpr(cg, e->kind.payload.Deref.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"(*(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::Cast => {\n            /* str literal → pointer: emit the C string token directly (a\n             * slice struct cannot be cast to a pointer) */\n            NodeId cin = e->kind.payload.Cast.expr;\n            Node* cn = cgNode(cg, cin);\n            bool ptrCast = false;\n            {\n                Ty ctk = e->kind.payload.Cast.targetType;\n                while (ctk != 0 && ((cg->ctx->types + ctk)->kind.tag == TypeKind::Const ||\n                                    (cg->ctx->types + ctk)->kind.tag == TypeKind::Comptime))\n                    ctk = (cg->ctx->types + ctk)->kind.payload.Const.base;\n                if (ctk != 0 && (cg->ctx->types + ctk)->kind.tag == TypeKind::Pointer) ptrCast = true;\n            }\n            if (ptrCast && cn != null && cn->kind.tag == NodeKind::Expr &&\n                cn->kind.payload.Expr.value.kind.tag == ExprKind::StringLit &&\n                (cn->kind.payload.Expr.value.kind.payload.StringLit.flags & 1) == 0)\n            {\n                Slice lit = cgIntern(cg, cn->kind.payload.Expr.value.kind.payload.StringLit.value);\n                usize rs2 = cg->ebuf.len;\n                stP(&cg->ebuf, \"((\");\n                stPS(&cg->ebuf, tyStr(cg, e->kind.payload.Cast.targetType));\n                stP(&cg->ebuf, \")(\");\n                usize begin = 0;\n                usize end = lit.len;\n                if (end >= 2 && lit.ptr[0] == 34) { begin = 1; end--; }\n                stCh(&cg->ebuf, 34);\n                usize i2 = begin;\n                while (i2 < end)\n                {\n                    u8 c2 = lit.ptr[i2];\n                    if (c2 == 92 && i2 + 1 < end)\n                    {\n                        u8 esc = lit.ptr[i2 + 1];\n                        if (esc == 'n') stP(&cg->ebuf, \"\\\\n\");\n                        else if (esc == 't') stP(&cg->ebuf, \"\\\\t\");\n                        else if (esc == 'r') stP(&cg->ebuf, \"\\\\r\");\n                        else if (esc == '0') stP(&cg->ebuf, \"\\\\0\");\n                        else if (esc == 34 || esc == 92 || esc == 39) { stCh(&cg->ebuf, 92); stCh(&cg->ebuf, esc); }\n                        else { stCh(&cg->ebuf, esc); }\n                        i2 += 2;\n                    }\n                    else if (c2 < 32 || c2 > 126)\n                    {\n                        stCh(&cg->ebuf, 92);\n                        stCh(&cg->ebuf, (u8)(48 + (c2 / 64)));\n                        stCh(&cg->ebuf, (u8)(48 + ((c2 / 8) % 8)));\n                        stCh(&cg->ebuf, (u8)(48 + (c2 % 8)));\n                        i2++;\n                    }\n                    else\n                    {\n                        stCh(&cg->ebuf, c2);\n                        i2++;\n                    }\n                }\n                stCh(&cg->ebuf, 34);\n                stP(&cg->ebuf, \"))\");\n                return stTail(&cg->ebuf, rs2);\n            }\n            /* `(u32)V::Case` is the case's ordinal, not its struct form */\n            {\n                u64 vcase = 0;\n                if (cgVariantCaseIdx(cg, cin, &vcase))\n                {\n                    usize rv = cg->ebuf.len;\n                    stP(&cg->ebuf, \"((\");\n                    stPS(&cg->ebuf, tyStr(cg, e->kind.payload.Cast.targetType));\n                    stP(&cg->ebuf, \")\");\n                    stU64(&cg->ebuf, vcase);\n                    stP(&cg->ebuf, \")\");\n                    return stTail(&cg->ebuf, rv);\n                }\n            }\n            /* casting a void call (`(usize)f()`) drops the value; C has\n             * no cast-from-void */\n            {\n                Ty cit = 0;\n                if (cn != null && cn->kind.tag == NodeKind::Expr)\n                    cit = cgSubstTy(cg, cn->kind.payload.Expr.value.resolvedType);\n                if (cit != 0 && (cg->ctx->types + cit)->kind.tag == TypeKind::Void)\n                    return cgExpr(cg, cin);\n            }\n            /* `(T[])arr`: array → slice construction; a C cast of an\n             * array to the slice struct is invalid */\n            {\n                Ty cit = 0;\n                if (cn != null && cn->kind.tag == NodeKind::Expr)\n                    cit = cgSubstTy(cg, cn->kind.payload.Expr.value.resolvedType);\n                if (cit != 0 && (cg->ctx->types + cit)->kind.tag == TypeKind::Array)\n                {\n                    Ty ctt = e->kind.payload.Cast.targetType;\n                    while (ctt != 0 && ((cg->ctx->types + ctt)->kind.tag == TypeKind::Const ||\n                                        (cg->ctx->types + ctt)->kind.tag == TypeKind::Comptime))\n                        ctt = (cg->ctx->types + ctt)->kind.payload.Const.base;\n                    if (ctt != 0 && (cg->ctx->types + ctt)->kind.tag == TypeKind::Slice)\n                    {\n                        Slice ca = cgExpr(cg, cin);\n                        usize rs3 = cg->ebuf.len;\n                        cgEmitSliceFromArr(cg, ctt, cit, ca);\n                        return stTail(&cg->ebuf, rs3);\n                    }\n                }\n            }\n            /* `(T[N])p` — pointer→array (or array→array) reinterpreting\n             * cast: C forbids casting TO an array type, so lower to a\n             * deref of a pointer-to-array — `*(T(*)[N])(p)`, an array\n             * lvalue the caller memcpy-inits or indexes. array sources\n             * reinterprete through `&arr`. sema already restricted the\n             * source to pointer/array; anything else is unreachable */\n            {\n                Ty cit2 = 0;\n                if (cn != null && cn->kind.tag == NodeKind::Expr)\n                    cit2 = cgSubstTy(cg, cn->kind.payload.Expr.value.resolvedType);\n                Ty ctt2 = e->kind.payload.Cast.targetType;\n                while (ctt2 != 0 && ((cg->ctx->types + ctt2)->kind.tag == TypeKind::Const ||\n                                     (cg->ctx->types + ctt2)->kind.tag == TypeKind::Comptime))\n                    ctt2 = (cg->ctx->types + ctt2)->kind.payload.Const.base;\n                bool srcOk2 = false;\n                bool srcArr2 = false;\n                if (cit2 != 0)\n                {\n                    Ty cs2 = cit2;\n                    while (cs2 != 0 && ((cg->ctx->types + cs2)->kind.tag == TypeKind::Const ||\n                                        (cg->ctx->types + cs2)->kind.tag == TypeKind::Comptime))\n                        cs2 = (cg->ctx->types + cs2)->kind.payload.Const.base;\n                    if (cs2 != 0)\n                    {\n                        i32 csk2 = (cg->ctx->types + cs2)->kind.tag;\n                        if (csk2 == TypeKind::Pointer || csk2 == TypeKind::Rawptr) srcOk2 = true;\n                        if (csk2 == TypeKind::Array) { srcOk2 = true; srcArr2 = true; }\n                    }\n                }\n                if (srcOk2 && ctt2 != 0 && (cg->ctx->types + ctt2)->kind.tag == TypeKind::Array)\n                {\n                    Slice ca2 = cgExpr(cg, cin);\n                    usize rs4 = cg->ebuf.len;\n                    stP(&cg->ebuf, \"*(\");\n                    stPS(&cg->ebuf, cgPtrToArrTyStr(cg, ctt2));\n                    stP(&cg->ebuf, \")(\");\n                    if (srcArr2) stCh(&cg->ebuf, '&');\n                    stPS(&cg->ebuf, ca2);\n                    stP(&cg->ebuf, \")\");\n                    return stTail(&cg->ebuf, rs4);\n                }\n            }\n            Slice c = cgExpr(cg, e->kind.payload.Cast.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, tyStr(cg, e->kind.payload.Cast.targetType));\n            stP(&cg->ebuf, \")(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n\n        // binary → three-address temp\n        ExprKind::Add, ExprKind::Sub, ExprKind::Mul, ExprKind::Div, ExprKind::Mod,\n        ExprKind::Eq, ExprKind::Ne, ExprKind::Lt, ExprKind::Le, ExprKind::Gt, ExprKind::Ge,\n        ExprKind::BitAnd, ExprKind::BitOr, ExprKind::BitXor, ExprKind::Shl, ExprKind::Shr => {\n            NodeId left;\n            NodeId right;\n            str op = \"+\";\n            switch (e->kind.tag)\n            {\n                ExprKind::Add => { op = \" + \"; },\n                ExprKind::Sub => { op = \" - \"; },\n                ExprKind::Mul => { op = \" * \"; },\n                ExprKind::Div => { op = \" / \"; },\n                ExprKind::Mod => { op = \" % \"; },\n                ExprKind::Eq => { op = \" == \"; },\n                ExprKind::Ne => { op = \" != \"; },\n                ExprKind::Lt => { op = \" < \"; },\n                ExprKind::Le => { op = \" <= \"; },\n                ExprKind::Gt => { op = \" > \"; },\n                ExprKind::Ge => { op = \" >= \"; },\n                ExprKind::BitAnd => { op = \" & \"; },\n                ExprKind::BitOr => { op = \" | \"; },\n                ExprKind::BitXor => { op = \" ^ \"; },\n                ExprKind::Shl => { op = \" << \"; },\n                ExprKind::Shr => { op = \" >> \"; },\n                else => {},\n            }\n            left = e->kind.payload.Add.left;\n            right = e->kind.payload.Add.right;\n            Slice l;\n            Slice r;\n            /* variant operands compare by tag ordinal: `V::Case` lowers to\n             * its declaration index, a variant-typed value reads `.tag`.\n             * covers ==/!= directly and the ordering ops (declaration order) */\n            {\n                u64 cidx = 0;\n                bool isCmp = e->kind.tag == ExprKind::Eq || e->kind.tag == ExprKind::Ne ||\n                             e->kind.tag == ExprKind::Lt || e->kind.tag == ExprKind::Le ||\n                             e->kind.tag == ExprKind::Gt || e->kind.tag == ExprKind::Ge;\n                if (isCmp && cgVariantCaseIdx(cg, left, &cidx)) l = cgU64Text(cg, cidx);\n                else\n                {\n                    l = cgExpr(cg, left);\n                    /* extend the slice over the appended \".tag\" */\n                    if (isCmp && cgIsVariantTy(cg, left)) { stP(&cg->ebuf, \".tag\"); l.len += 4; }\n                }\n                if (isCmp && cgVariantCaseIdx(cg, right, &cidx)) r = cgU64Text(cg, cidx);\n                else\n                {\n                    r = cgExpr(cg, right);\n                    if (isCmp && cgIsVariantTy(cg, right)) { stP(&cg->ebuf, \".tag\"); r.len += 4; }\n                }\n            }\n            // str is a slice view: compare by content, not by struct bits\n            if (cgIsStrTy(cg, left) &&\n                (e->kind.tag == ExprKind::Eq || e->kind.tag == ExprKind::Ne))\n            {\n                usize cs = cg->ebuf.len;\n                if (e->kind.tag == ExprKind::Ne) stP(&cg->ebuf, \"!\");\n                stP(&cg->ebuf, \"_coral_streq(\");\n                stPS(&cg->ebuf, l);\n                stP(&cg->ebuf, \", \");\n                stPS(&cg->ebuf, r);\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, cs);\n            }\n            /* structs have no C `==`: compare their bytes (like str above,\n             * deterministic for same-type values of POD structs) */\n            if (cgIsStructTy(cg, left) &&\n                (e->kind.tag == ExprKind::Eq || e->kind.tag == ExprKind::Ne))\n            {\n                Node* ln = cgNode(cg, left);\n                Slice lty = ln->kind.tag == NodeKind::Expr\n                    ? cgResultTy(cg, left, &ln->kind.payload.Expr.value)\n                    : Slice::fromStr(\"void*\");\n                usize cs = cg->ebuf.len;\n                stP(&cg->ebuf, \"((memcmp(&(\");\n                stPS(&cg->ebuf, l);\n                stP(&cg->ebuf, \"), &(\");\n                stPS(&cg->ebuf, r);\n                stP(&cg->ebuf, \"), sizeof(\");\n                stPS(&cg->ebuf, lty);\n                stP(&cg->ebuf, \")) \");\n                if (e->kind.tag == ExprKind::Eq) stP(&cg->ebuf, \"== 0))\");\n                else stP(&cg->ebuf, \"!= 0))\");\n                return stTail(&cg->ebuf, cs);\n            }\n            usize cs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, l);\n            stP(&cg->ebuf, op);\n            stPS(&cg->ebuf, r);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, cs);\n        },\n\n        // short-circuit: C `&&`/`||` evaluate left first and skip right\n        ExprKind::And => {\n            Slice l = cgExpr(cg, e->kind.payload.And.left);\n            Slice r = cgExpr(cg, e->kind.payload.And.right);\n            usize cs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, l);\n            stP(&cg->ebuf, \") && (\");\n            stPS(&cg->ebuf, r);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, cs);\n        },\n        ExprKind::Or => {\n            Slice l = cgExpr(cg, e->kind.payload.Or.left);\n            Slice r = cgExpr(cg, e->kind.payload.Or.right);\n            usize cs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, l);\n            stP(&cg->ebuf, \") || (\");\n            stPS(&cg->ebuf, r);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, cs);\n        },\n\n        ExprKind::Call => {\n            NodeId calleeId = e->kind.payload.Call.callee;\n            Node* cn = cgNode(cg, calleeId);\n            Slice calleeText;\n            #[[maybe_unused]]\n            Slice retTy;\n            Ty rty = 0;\n            bool resolved = false;\n            NodeId fdecl;\n            fdecl.index = 0;\n            if (cn->kind.tag == NodeKind::Expr && cn->kind.payload.Expr.value.kind.tag == ExprKind::Path &&\n                cn->kind.payload.Expr.value.kind.payload.Path.segmentsLen >= 2)\n            {\n                NodeId* segs = cn->kind.payload.Expr.value.kind.payload.Path.segments;\n                u32 sn = cn->kind.payload.Expr.value.kind.payload.Path.segmentsLen;\n                Node* s0 = cgNode(cg, segs[0]);\n                Node* s1 = cgNode(cg, segs[sn - 1]);\n                if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&\n                    s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                {\n                    /* resolve through the declaration: the C name is the\n                       function's own name (flat), not `module_fn` */\n                    Str s1name = s1->kind.payload.Expr.value.kind.payload.Ident.name;\n                    if (!resolved)\n                    {\n                        /* qualified member: try the module's own file first;\n                         * lookupFrom prefers the reference site's file, which\n                         * for `libc::realloc` points at the wrong (generic)\n                         * decl */\n                        Str root = s0->kind.payload.Expr.value.kind.payload.Ident.name;\n                        if (cg->sema != null && cg->sema->scopes != null)\n                        {\n                            u32 refF = 0;\n                            if (id.index != 0)\n                            {\n                                Node* rn2 = cgNode(cg, id);\n                                refF = locFile(rn2->loc);\n                            }\n                            ScopeStack* scopes2 = cg->sema->scopes;\n                            Symbol* rsym = scopes2->lookupFrom(root, refF);\n                            if (rsym != null && rsym->kind == 5 && rsym->declaration.index != 0)\n                            {\n                                Node* imn = cgNode(cg, rsym->declaration);\n                                if (imn->kind.tag == NodeKind::Decl)\n                                {\n                                    Decl* imd = &imn->kind.payload.Decl.value;\n                                    Str mpath = 0;\n                                    if (imd->kind.tag == DeclKind::Import) mpath = imd->kind.payload.Import.path;\n                                    else if (imd->kind.tag == DeclKind::ModReexport) mpath = imd->kind.payload.ModReexport.path;\n                                    u32 mf = cgFileForModulePath(cg, mpath);\n                                    if (mf != 0)\n                                    {\n                                        NodeId md = cgFindDeclFrom(cg, s1name, (u32)DeclKind::Func, mf);\n                                        if (md.index != 0)\n                                            calleeText = cgCallFromDecl(cg, md, 0, e->kind.payload.Call.args,\n                                                                        e->kind.payload.Call.argsLen,\n                                                                        &rty, &resolved, &fdecl);\n                                    }\n                                }\n                            }\n                        }\n                    }\n                    if (!resolved)\n                    {\n                        /* `Type::method(...)` / `str::fromParts(...)`: the\n                         * head is a struct/extend owner, not a module:\n                         * resolve the method decl through the owner text */\n                        Str rootT = s0->kind.payload.Expr.value.kind.payload.Ident.name;\n                        NodeId sdecl = cgFindMethodDeclOwner(cg, cgIntern(cg, rootT), s1name);\n                        if (sdecl.index != 0 && !cgDeclIsGeneric(cg, sdecl))\n                        {\n                            Node* sdn = cgNode(cg, sdecl);\n                            Decl* sdd = &sdn->kind.payload.Decl.value;\n                            if (sdn->kind.tag == NodeKind::Decl)\n                            {\n                                /* suffix = the same owner+name the def side\n                                 * composes (the C spelling for builtin owners\n                                 * like str → `_coral_str`) */\n                                usize rcs = cg->ebuf.len;\n                                stPS(&cg->ebuf, cgOwnerSpelling(cg, cgIdent(cg, rootT)));\n                                stCh(&cg->ebuf, '_');\n                                stPS(&cg->ebuf, cgIntern(cg, s1name));\n                                calleeText = cgMangleS(cg, sdecl, stTail(&cg->ebuf, rcs), 0);\n                                fdecl = sdecl;\n                                if (sdd->kind.tag == DeclKind::Func)\n                                    rty = sdd->kind.payload.Func.returnType;\n                                resolved = true;\n                            }\n                        }\n                    }\n                    if (!resolved)\n                        calleeText = cgResolveCall(cg, s1name, e->kind.payload.Call.args, e->kind.payload.Call.argsLen, &rty, &resolved, id, &fdecl);\n                    if (resolved) {\n                                            retTy = tyStr(cg, cgSubstTy(cg, rty));\n                    } else {\n                        if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))\n                            cgErrorAt(cg, id, \"no monomorphized instance for generic call; the call site was not collected\");\n                        usize cs = cg->ebuf.len;\n                        stPS(&cg->ebuf, cgIntern(cg, s0->kind.payload.Expr.value.kind.payload.Ident.name));\n                        stCh(&cg->ebuf, '_');\n                        stPS(&cg->ebuf, cgIntern(cg, s1name));\n                        calleeText = stTail(&cg->ebuf, cs);\n                        retTy = cgResultTy(cg, id, e);\n                        resolved = true;\n                    }\n                }\n                else if (s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef)\n                {\n                    // `mod::f<T>(...)`: explicit generic args on the last segment\n                    calleeText = cgResolveGenericCall(cg, s1->kind.payload.Expr.value.kind.payload.TypeRef.name,\n                                                      s1->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,\n                                                      &rty, &resolved, &fdecl, id,\n                                                      e->kind.payload.Call.args, e->kind.payload.Call.argsLen);\n                    if (resolved) {\n                                            retTy = tyStr(cg, cgSubstTy(cg, rty));\n                    } else {\n                        if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))\n                            cgErrorAt(cg, id, \"no monomorphized instance for generic call; the call site was not collected\");\n                        calleeText = cgExpr(cg, calleeId);\n                        retTy = cgResultTy(cg, id, e);\n                    }\n                }\n                else if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef &&\n                         s1->kind.tag == NodeKind::Expr && s1->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                {\n                    /* static method on a generic instance: `Foo<i32>::new(...)`:\n                       <instance>_<method>, matching cgEmitInstMethodList */\n                    Ty ownerTy = s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode;\n                    Str s1name2 = s1->kind.payload.Expr.value.kind.payload.Ident.name;\n                    Slice owner = cgOwnerName(cg, ownerTy);\n                    usize cs2 = cg->ebuf.len;\n                    stPS(&cg->ebuf, owner);\n                    stCh(&cg->ebuf, '_');\n                    stPS(&cg->ebuf, cgIntern(cg, s1name2));\n                    Slice rawCallee = stTail(&cg->ebuf, cs2);\n                    NodeId mdecl = cgFindMethodDeclOwner(cg, owner, s1name2);\n                    if (mdecl.index != 0) calleeText = cgMangleS(cg, mdecl, rawCallee, 0);\n                    else calleeText = rawCallee;\n                    fdecl = mdecl;\n                    retTy = cgResultTy(cg, id, e);\n                }\n                else\n                {\n                    calleeText = cgExpr(cg, calleeId);\n                    retTy = cgResultTy(cg, id, e);\n                }\n            }\n            else if (cn->kind.tag == NodeKind::Expr && cn->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef) {\n                /* `f<T>(...)`, explicit generic call: pick the mono\n                   instance for the callee's generic arguments */\n                calleeText = cgResolveGenericCall(cg, cn->kind.payload.Expr.value.kind.payload.TypeRef.name,\n                                                  cn->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,\n                                                  &rty, &resolved, &fdecl, id,\n                                                  e->kind.payload.Call.args, e->kind.payload.Call.argsLen);\n                if (resolved) {\n                                        retTy = tyStr(cg, cgSubstTy(cg, rty));\n                } else {\n                    if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))\n                        cgErrorAt(cg, id, \"no monomorphized instance for generic call; the call site was not collected\");\n                    calleeText = cgExpr(cg, calleeId);\n                    retTy = cgResultTy(cg, id, e);\n                }\n            }\n            else if (cn->kind.tag == NodeKind::Expr && cn->kind.payload.Expr.value.kind.tag == ExprKind::Ident) {\n                Str fname = cn->kind.payload.Expr.value.kind.payload.Ident.name;\n                calleeText = cgResolveCall(cg, fname, e->kind.payload.Call.args, e->kind.payload.Call.argsLen, &rty, &resolved, id, &fdecl);\n                if (resolved) {\n                                        retTy = tyStr(cg, cgSubstTy(cg, rty));\n                } else {\n                    if (fdecl.index != 0 && cgDeclIsGeneric(cg, fdecl))\n                        cgErrorAt(cg, id, \"no monomorphized instance for generic call; the call site was not collected\");\n                    calleeText = cgExpr(cg, calleeId);\n                    retTy = cgResultTy(cg, id, e);\n                }\n            } else {\n                calleeText = cgExpr(cg, calleeId);\n                retTy = cgResultTy(cg, id, e);\n            }\n            /* comptime (type-level) parameters are erased from the C\n               signature: skip their arguments here as well */\n            Slice argTexts = cgCallArgsText(cg, fdecl, e->kind.payload.Call.args,\n                                            e->kind.payload.Call.argsLen);\n            usize ccs = cg->ebuf.len;\n            stPS(&cg->ebuf, calleeText);\n            stCh(&cg->ebuf, '(');\n            stPS(&cg->ebuf, argTexts);\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, ccs);\n        },\n\n        ExprKind::MethodCall => {\n            NodeId recv = e->kind.payload.MethodCall.receiver;\n            Node* rn = cgNode(cg, recv);\n            Ty recvTy = 0;\n            if (rn->kind.tag == NodeKind::Expr) recvTy = rn->kind.payload.Expr.value.resolvedType;\n            Slice owner;\n            if (recvTy != 0) {\n                /* const receivers may wrap Pointer in Const: unwrap both\n                 * so the owner name matches the definition side */\n                recvTy = cgTyUnwrap(cg, recvTy);\n                if (recvTy != 0 && (cg->ctx->types + recvTy)->kind.tag == TypeKind::Pointer)\n                    recvTy = cgTyUnwrap(cg, (cg->ctx->types + recvTy)->kind.payload.Pointer.base);\n                if (recvTy != 0) owner = cgOwnerName(cg, recvTy);\n                else owner = Slice::fromStr(\"Unknown\");\n            } else {\n                owner = Slice::fromStr(\"Unknown\");\n            }\n            Slice recvText = cgExpr(cg, recv);\n            bool recvIsPtr = false;\n            Ty rawRecvTy = 0;\n            if (rn->kind.tag == NodeKind::Expr) {\n                rawRecvTy = rn->kind.payload.Expr.value.resolvedType;\n                if (rawRecvTy != 0 && cgTyIsPtr(cg, rawRecvTy)) recvIsPtr = true;\n            }\n            Str methName = e->kind.payload.MethodCall.method;\n            cgMoveDisposeRecv(cg, methName, rn);\n            bool mFound = false;\n            u8 recvKind = cgMethodRecvKind(cg, rawRecvTy, methName, &mFound);\n            /* `p->alloc(ctx, size)` parses as a method call but names a\n             * fn-pointer field: lower to `(p->alloc)(ctx, size)` */\n            bool fieldCall = !mFound && cgHasField(cg, rawRecvTy, methName);\n            Slice callee;\n            NodeId mdef;\n            mdef.index = 0;\n            if (fieldCall)\n            {\n                usize cfs = cg->ebuf.len;\n                stP(&cg->ebuf, \"(\");\n                stPS(&cg->ebuf, recvText);\n                if (recvIsPtr) stP(&cg->ebuf, \"->\");\n                else stCh(&cg->ebuf, '.');\n                stPS(&cg->ebuf, cgIdent(cg, methName));\n                stCh(&cg->ebuf, ')');\n                callee = stTail(&cg->ebuf, cfs);\n            }\n            else\n            {\n                usize cs = cg->ebuf.len;\n                stPS(&cg->ebuf, owner);\n                stCh(&cg->ebuf, '_');\n                stPS(&cg->ebuf, cgIntern(cg, methName));\n                Slice rawCallee = stTail(&cg->ebuf, cs);\n                /* resolve the method's own decl for file-correct mangling\n                   (def side: cgEmitMethodSet composes the same base) */\n                mdef = cgFindMethodDecl(cg, rawRecvTy, methName);\n                if (mdef.index != 0) callee = cgMangleS(cg, mdef, rawCallee, 0);\n                else callee = rawCallee;\n            }\n\n            Slice argTexts = Slice::from(null, 0);\n            u32 n = 0;\n            {\n                Stream abuf = stNew(cg->arena, 64);\n                bool first = true;\n                bool passRecv = recvKind != 0 && !fieldCall;\n                if (passRecv) {\n                    /* self is a pointer in C: pass the address of a value\n                     * receiver (materialized when the receiver is a\n                     * temporary), or the receiver itself when already a\n                     * pointer */\n                    if (!recvIsPtr) {\n                        Slice rt = cgAddrOfValue(cg, recv, recvText);\n                        stPS(&abuf, rt);\n                    } else {\n                        stPS(&abuf, recvText);\n                    }\n                    first = false;\n                    n++;\n                }\n                NodeId* args = e->kind.payload.MethodCall.args;\n                u32 argsLen = e->kind.payload.MethodCall.argsLen;\n                u32 i = 0;\n                while (i < argsLen && n < 16) {\n                    if (first) first = false;\n                    else stP(&abuf, \", \");\n                    /* `null` in a str parameter position is the empty slice */\n                    bool nullStr = false;\n                    if (mdef.index != 0)\n                    {\n                        Node* mdn = cgNode(cg, mdef);\n                        Node* an2 = cgNode(cg, args[i]);\n                        if (mdn->kind.tag == NodeKind::Decl && an2->kind.tag == NodeKind::Expr &&\n                            an2->kind.payload.Expr.value.kind.tag == ExprKind::NullLit &&\n                            i < mdn->kind.payload.Decl.value.kind.payload.Func.paramsLen)\n                        {\n                            Node* mpn = cgNode(cg, mdn->kind.payload.Decl.value.kind.payload.Func.params[i]);\n                            if (mpn->kind.tag == NodeKind::Param)\n                            {\n                                Ty pt = mpn->kind.payload.Param.value.typeNode;\n                                while (pt != 0 && ((cg->ctx->types + pt)->kind.tag == TypeKind::Const ||\n                                                   (cg->ctx->types + pt)->kind.tag == TypeKind::Comptime))\n                                {\n                                    if ((cg->ctx->types + pt)->kind.tag == TypeKind::Const)\n                                        pt = (cg->ctx->types + pt)->kind.payload.Const.base;\n                                    else pt = (cg->ctx->types + pt)->kind.payload.Comptime.base;\n                                }\n                                if (pt != 0 && (cg->ctx->types + pt)->kind.tag == TypeKind::Str) nullStr = true;\n                            }\n                        }\n                    }\n                    if (nullStr) stP(&abuf, \"(_coral_str){0}\");\n                    else\n                    {\n                        /* array → slice decay, as in plain calls */\n                        Ty msliceTy = 0;\n                        if (mdef.index != 0)\n                        {\n                            Node* mdn2 = cgNode(cg, mdef);\n                            if (mdn2->kind.tag == NodeKind::Decl &&\n                                i < mdn2->kind.payload.Decl.value.kind.payload.Func.paramsLen)\n                            {\n                                Node* mpn2 = cgNode(cg, mdn2->kind.payload.Decl.value.kind.payload.Func.params[i]);\n                                if (mpn2->kind.tag == NodeKind::Param)\n                                    msliceTy = cgArrayToSliceParam(cg, mpn2->kind.payload.Param.value.typeNode, args[i]);\n                            }\n                        }\n                        if (msliceTy != 0)\n                        {\n                            Node* san = cgNode(cg, args[i]);\n                            Ty sat = cgSubstTy(cg, san->kind.payload.Expr.value.resolvedType);\n                            cgEmitSliceFromArr(cg, msliceTy, sat, cgExpr(cg, args[i]));\n                        }\n                        else\n                        {\n                            cgMoveArg(cg, args[i]);\n                            stPS(&abuf, cgExpr(cg, args[i]));\n                        }\n                    }\n                    n++;\n                    i++;\n                }\n                if (argsLen + (u32)(passRecv ? 1 : 0) > 16) cgError(cg, \"too many arguments (cap 16)\");\n                argTexts = stTail(&abuf, 0);\n            }\n            #[[maybe_unused]]\n            Slice methResTy = cgResultTy(cg, id, e);\n            usize mcs = cg->ebuf.len;\n            stPS(&cg->ebuf, callee);\n            stCh(&cg->ebuf, '(');\n            stPS(&cg->ebuf, argTexts);\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, mcs);\n        },\n\n        ExprKind::StaticCall => {\n            usize cs = cg->ebuf.len;\n            stPS(&cg->ebuf, cgIntern(cg, e->kind.payload.StaticCall.typeName));\n            stCh(&cg->ebuf, '_');\n            stPS(&cg->ebuf, cgIntern(cg, e->kind.payload.StaticCall.method));\n            Slice rawCallee = stTail(&cg->ebuf, cs);\n            NodeId smdecl = cgFindMethodDeclOwner(cg, cgIntern(cg, e->kind.payload.StaticCall.typeName),\n                                                  e->kind.payload.StaticCall.method);\n            Slice callee;\n            if (smdecl.index != 0)\n            {\n                Node* sdn = cgNode(cg, smdecl);\n                if (sdn->kind.tag == NodeKind::Decl)\n                {\n                    /* suffix = def-side owner+method (C spelling of builtin\n                     * owners: str → `_coral_str`) */\n                    usize rcs = cg->ebuf.len;\n                    stPS(&cg->ebuf, cgOwnerSpelling(cg, cgIdent(cg, e->kind.payload.StaticCall.typeName)));\n                    stCh(&cg->ebuf, '_');\n                    stPS(&cg->ebuf, cgIntern(cg, e->kind.payload.StaticCall.method));\n                    callee = cgMangleS(cg, smdecl, stTail(&cg->ebuf, rcs), 0);\n                }\n                else callee = rawCallee;\n            }\n            else callee = rawCallee;\n            Slice argTexts = Slice::from(null, 0);\n            u32 n = 0;\n            {\n                Stream abuf = stNew(cg->arena, 64);\n                bool first = true;\n                NodeId* args = e->kind.payload.StaticCall.args;\n                u32 argsLen = e->kind.payload.StaticCall.argsLen;\n                u32 i = 0;\n                while (i < argsLen && n < 16) {\n                    if (first) first = false;\n                    else stP(&abuf, \", \");\n                    cgMoveArg(cg, args[i]);\n                    stPS(&abuf, cgExpr(cg, args[i]));\n                    n++;\n                    i++;\n                }\n                if (argsLen > 16) cgError(cg, \"too many arguments (cap 16)\");\n                argTexts = stTail(&abuf, 0);\n            }\n            #[[maybe_unused]]\n            Slice statResTy = cgResultTy(cg, id, e);\n            usize scs = cg->ebuf.len;\n            stPS(&cg->ebuf, callee);\n            stCh(&cg->ebuf, '(');\n            stPS(&cg->ebuf, argTexts);\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, scs);\n        },\n\n        ExprKind::Field, ExprKind::DerefField => {\n            NodeId obj;\n            Str field;\n            if (e->kind.tag == ExprKind::Field) {\n                obj = e->kind.payload.Field.obj;\n                field = e->kind.payload.Field.field;\n            } else {\n                obj = e->kind.payload.DerefField.obj;\n                field = e->kind.payload.DerefField.field;\n            }\n            /* `x.payload.Case`: lower to the union member slot of the\n             * case's ordinal: `x.u.v<idx>` (only when the base is a variant\n             * and the case exists; a plain `payload` struct field is not) */\n            if (cgIsPayloadAccess(cg, obj))\n            {\n                NodeId base = cgFieldAccessObj(cg, obj);\n                Node* bn = cgNode(cg, base);\n                Ty bty = 0;\n                if (bn->kind.tag == NodeKind::Expr) bty = bn->kind.payload.Expr.value.resolvedType;\n                u32 vidx = 0;\n                NodeId vd = cgFindVariantOfTy(cg, bty, field, &vidx);\n                if (vd.index != 0)\n                {\n                    bool basePtr = cgTyIsPtr(cg, bty);\n                    Slice o = basePtr ? cgExpr(cg, base) : cgLvalue(cg, base);\n                    usize cs = cg->ebuf.len;\n                    stPS(&cg->ebuf, o);\n                    if (basePtr) stP(&cg->ebuf, \"->\");\n                    else stCh(&cg->ebuf, '.');\n                    stP(&cg->ebuf, \"u.v\");\n                    stU64(&cg->ebuf, (u64)vidx);\n                    return stTail(&cg->ebuf, cs);\n                }\n            }\n            Slice o = cgExpr(cg, obj);\n            Node* on = cgNode(cg, obj);\n            bool isPtr = false;\n            if (on->kind.tag == NodeKind::Expr) {\n                Ty ot = on->kind.payload.Expr.value.resolvedType;\n                if (ot != 0 && cgTyIsPtr(cg, ot)) isPtr = true;\n            }\n            usize cs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            if (isPtr) stP(&cg->ebuf, \"->\");\n            else stCh(&cg->ebuf, '.');\n            stPS(&cg->ebuf, cgIdent(cg, field));\n            Slice fieldText = stTail(&cg->ebuf, cs);\n            return fieldText;\n        },\n\n        ExprKind::Index => {\n            Slice o = cgExpr(cg, e->kind.payload.Index.obj);\n            Slice ix = cgExpr(cg, e->kind.payload.Index.index);\n            bool isStr = cgIsStrTy(cg, e->kind.payload.Index.obj);\n            usize cs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            if (isStr) stP(&cg->ebuf, \".ptr\");\n            stCh(&cg->ebuf, '[');\n            stPS(&cg->ebuf, ix);\n            stCh(&cg->ebuf, ']');\n            Slice idxText = stTail(&cg->ebuf, cs);\n            return idxText;\n        },\n\n        ExprKind::TupleField => {\n            Slice o = cgExpr(cg, e->kind.payload.TupleField.obj);\n            usize cs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            stCh(&cg->ebuf, '.');\n            stP(&cg->ebuf, \"_\");\n            stU64(&cg->ebuf, (u64)e->kind.payload.TupleField.index);\n            Slice ttext = stTail(&cg->ebuf, cs);\n            return ttext;\n        },\n\n        ExprKind::StructLiteral => {\n            u32 fvLen = e->kind.payload.StructLiteral.fieldValuesLen;\n            Stream vs = stNew(cg->arena, 64);\n            bool first = true;\n            u32 i = 0;\n            while (i < fvLen) {\n                if (first) first = false;\n                else stP(&vs, \", \");\n                if (e->kind.payload.StructLiteral.fieldNames != 0) {\n                    stP(&vs, \".\");\n                    stPS(&vs, cgIdent(cg, e->kind.payload.StructLiteral.fieldNames[i]));\n                    stP(&vs, \" = \");\n                }\n                stPS(&vs, cgInitValue(cg, e->kind.payload.StructLiteral.fieldValues[i]));\n                i++;\n            }\n            if (fvLen > 256) cgError(cg, \"too many struct fields (cap 256)\");\n            Slice lty = tyStr(cg, e->kind.payload.StructLiteral.typeNode);\n            usize lcs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, lty);\n            stP(&cg->ebuf, \"){\");\n            Str vname = e->kind.payload.StructLiteral.variantName;\n            if (vname != 0)\n            {\n                // variant construction: tag + payload union member\n                u32 vidx = 0;\n                NodeId vd = cgFindVariantOfTy(cg, e->kind.payload.StructLiteral.typeNode, vname, &vidx);\n                if (vd.index == 0) cgError(cg, \"variant case not found\");\n                stP(&cg->ebuf, \" .tag = \");\n                stU64(&cg->ebuf, (u64)vidx);\n                if (fvLen > 0)\n                {\n                    stP(&cg->ebuf, \", .u.v\");\n                    stU64(&cg->ebuf, (u64)vidx);\n                    stP(&cg->ebuf, \" = {\");\n                    stPS(&cg->ebuf, stTail(&vs, 0));\n                    stCh(&cg->ebuf, '}');\n                }\n            }\n            else\n            {\n                stPS(&cg->ebuf, stTail(&vs, 0));\n            }\n            stP(&cg->ebuf, \"})\");\n            return stTail(&cg->ebuf, lcs);\n        },\n\n        ExprKind::ArrayLiteral => {\n            u32 alen = e->kind.payload.ArrayLiteral.elemsLen;\n            Stream vs = stNew(cg->arena, 64);\n            bool first = true;\n            u32 i = 0;\n            while (i < alen) {\n                if (first) first = false;\n                else stP(&vs, \", \");\n                stPS(&vs, cgInitValue(cg, e->kind.payload.ArrayLiteral.elems[i]));\n                i++;\n            }\n            if (alen > 16) cgError(cg, \"too many array elements (cap 16)\");\n            Slice aty = cgResultTy(cg, id, e);\n            usize acs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, aty);\n            stP(&cg->ebuf, \"){\");\n            stPS(&cg->ebuf, stTail(&vs, 0));\n            stP(&cg->ebuf, \"})\");\n            return stTail(&cg->ebuf, acs);\n        },\n\n        ExprKind::TupleExpr => {\n            u32 elen = e->kind.payload.TupleExpr.elemsLen;\n            Stream vs = stNew(cg->arena, 64);\n            bool first = true;\n            u32 i = 0;\n            while (i < elen) {\n                if (first) first = false;\n                else stP(&vs, \", \");\n                stPS(&vs, cgInitValue(cg, e->kind.payload.TupleExpr.elems[i]));\n                i++;\n            }\n            if (elen > 16) cgError(cg, \"too many tuple elements (cap 16)\");\n            Slice tty = cgResultTy(cg, id, e);\n            usize tcs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, tty);\n            stP(&cg->ebuf, \"){\");\n            stPS(&cg->ebuf, stTail(&vs, 0));\n            stP(&cg->ebuf, \"})\");\n            return stTail(&cg->ebuf, tcs);\n        },\n\n        ExprKind::Ternary => {\n            Slice c = cgExpr(cg, e->kind.payload.Ternary.cond);\n            Slice tt = cgExpr(cg, e->kind.payload.Ternary.thenExpr);\n            Slice ee = cgExpr(cg, e->kind.payload.Ternary.elseExpr);\n            usize cs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \") ? (\");\n            stPS(&cg->ebuf, tt);\n            stP(&cg->ebuf, \") : (\");\n            stPS(&cg->ebuf, ee);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, cs);\n        },\n\n        ExprKind::IfExpr => {\n            Slice c = cgExpr(cg, e->kind.payload.IfExpr.cond);\n            u32 t = cgNewTemp(cg, cgResultTy(cg, id, e), 0);\n            Slice tn = cgTempName(cg, t);\n            u32 le = cgLabel(cg);\n            u32 lend = cgLabel(cg);\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"if (!(\");\n            stPS(&cg->body, c);\n            stP(&cg->body, \")) goto __L\");\n            stU64(&cg->body, (u64)le);\n            stCh(&cg->body, ';');\n            Slice thenc = cgValBody(cg, e->kind.payload.IfExpr.thenBody);\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, tn);\n            stP(&cg->body, \" = (\");\n            stPS(&cg->body, thenc);\n            stP(&cg->body, \");\");\n            cgEmitGoto(cg, lend);\n            cgEmitLabel(cg, le);\n            Slice elsec = cgValBody(cg, e->kind.payload.IfExpr.elseBody);\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, tn);\n            stP(&cg->body, \" = (\");\n            stPS(&cg->body, elsec);\n            stP(&cg->body, \");\");\n            cgEmitLabel(cg, lend);\n            return tn;\n        },\n\n        ExprKind::BlockExpr => {\n            u32 i = 0;\n            u32 n = e->kind.payload.BlockExpr.stmtsLen;\n            while (i < n) {\n                cgStmt(cg, e->kind.payload.BlockExpr.stmts[i]);\n                i++;\n            }\n            if (e->kind.payload.BlockExpr.result.index != 0)\n                return cgExpr(cg, e->kind.payload.BlockExpr.result);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, rs);\n        },\n\n        ExprKind::PostInc, ExprKind::PostDec, ExprKind::PreInc, ExprKind::PreDec => {\n            NodeId target;\n            str op = \"++\";\n            if (e->kind.tag == ExprKind::PostInc) { target = e->kind.payload.PostInc.expr; op = \"++\"; }\n            if (e->kind.tag == ExprKind::PostDec) { target = e->kind.payload.PostDec.expr; op = \"--\"; }\n            if (e->kind.tag == ExprKind::PreInc) { target = e->kind.payload.PreInc.expr; op = \"++\"; }\n            if (e->kind.tag == ExprKind::PreDec) { target = e->kind.payload.PreDec.expr; op = \"--\"; }\n            Slice lv = cgLvalue(cg, target);\n            usize ics = cg->ebuf.len;\n            if (e->kind.tag == ExprKind::PostInc || e->kind.tag == ExprKind::PostDec) {\n                stP(&cg->ebuf, \"((\");\n                stPS(&cg->ebuf, lv);\n                stCh(&cg->ebuf, ')');\n                stP(&cg->ebuf, op);\n                stCh(&cg->ebuf, ')');\n            } else {\n                stP(&cg->ebuf, \"((\");\n                stP(&cg->ebuf, op);\n                stPS(&cg->ebuf, lv);\n                stP(&cg->ebuf, \"))\");\n            }\n            return stTail(&cg->ebuf, ics);\n        },\n\n        ExprKind::Assign, ExprKind::AssignAdd, ExprKind::AssignSub,\n        ExprKind::AssignMul, ExprKind::AssignDiv, ExprKind::AssignMod,\n        ExprKind::AssignBitAnd, ExprKind::AssignBitOr, ExprKind::AssignBitXor,\n        ExprKind::AssignShl, ExprKind::AssignShr => {\n            NodeId target;\n            NodeId value;\n            str op = \"=\";\n            if (e->kind.tag == ExprKind::Assign) { target = e->kind.payload.Assign.target; value = e->kind.payload.Assign.value; }\n            else if (e->kind.tag == ExprKind::AssignAdd) { target = e->kind.payload.AssignAdd.target; value = e->kind.payload.AssignAdd.value; op = \"+=\"; }\n            else if (e->kind.tag == ExprKind::AssignSub) { target = e->kind.payload.AssignSub.target; value = e->kind.payload.AssignSub.value; op = \"-=\"; }\n            else if (e->kind.tag == ExprKind::AssignMul) { target = e->kind.payload.AssignMul.target; value = e->kind.payload.AssignMul.value; op = \"*=\"; }\n            else if (e->kind.tag == ExprKind::AssignDiv) { target = e->kind.payload.AssignDiv.target; value = e->kind.payload.AssignDiv.value; op = \"/=\"; }\n            else if (e->kind.tag == ExprKind::AssignMod) { target = e->kind.payload.AssignMod.target; value = e->kind.payload.AssignMod.value; op = \"%=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitAnd) { target = e->kind.payload.AssignBitAnd.target; value = e->kind.payload.AssignBitAnd.value; op = \"&=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitOr) { target = e->kind.payload.AssignBitOr.target; value = e->kind.payload.AssignBitOr.value; op = \"|=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitXor) { target = e->kind.payload.AssignBitXor.target; value = e->kind.payload.AssignBitXor.value; op = \"^=\"; }\n            else if (e->kind.tag == ExprKind::AssignShl) { target = e->kind.payload.AssignShl.target; value = e->kind.payload.AssignShl.value; op = \"<<=\"; }\n            else { target = e->kind.payload.AssignShr.target; value = e->kind.payload.AssignShr.value; op = \">>=\"; }\n            Slice lv = cgLvalue(cg, target);\n            Slice rv = cgAssignValue(cg, target, value);\n            if (e->kind.tag == ExprKind::Assign)\n            {\n                Node* tn = cgNode(cg, target);\n                Ty tt = 0;\n                if (tn->kind.tag == NodeKind::Expr) tt = tn->kind.payload.Expr.value.resolvedType;\n                /* C forbids array assignment: lower `x = {…}` / `a = b`\n                 * on arrays to a memcpy of the target's bytes */\n                if (tt != 0 && (cg->ctx->types + cgTyUnwrap(cg, tt))->kind.tag == TypeKind::Array)\n                {\n                    Stream ms = stNew(cg->arena, 64);\n                    stP(&ms, \"((void)memcpy(&(\");\n                    stPS(&ms, lv);\n                    stP(&ms, \"), &(\");\n                    stPS(&ms, rv);\n                    stP(&ms, \"), sizeof(\");\n                    stPS(&ms, lv);\n                    stP(&ms, \")))\");\n                    usize cs = cg->ebuf.len;\n                    stPS(&cg->ebuf, stTail(&ms, 0));\n                    return stTail(&cg->ebuf, cs);\n                }\n                if (cgIntToPtrInit(cg, value, tt)) rv = cgWrapPtrCast(cg, tyStr(cg, tt), rv);\n                /* RAII move semantics `x = y;` on droppable locals: the\n                 * overwritten value of x drops now and y's pending drop\n                 * is cancelled (x owns the new value at its exit) */\n                Node* tgn = cgNode(cg, target);\n                Node* vgn = cgNode(cg, value);\n                bool tIsIdent = tgn->kind.tag == NodeKind::Expr &&\n                                tgn->kind.payload.Expr.value.kind.tag == ExprKind::Ident;\n                bool vIsIdent = vgn->kind.tag == NodeKind::Expr &&\n                                vgn->kind.payload.Expr.value.kind.tag == ExprKind::Ident;\n                i32 ti = tIsIdent ? cgFindDrop(cg, tgn->kind.payload.Expr.value.kind.payload.Ident.name) : -1;\n                i32 vi = vIsIdent ? cgFindDrop(cg, vgn->kind.payload.Expr.value.kind.payload.Ident.name) : -1;\n                if (ti >= 0 && vi != ti)\n                    cgEmitDropEntry(cg, &cg->drops[ti]); // old value of x\n                if (vi >= 0 && vi != ti)\n                    cgRemoveDropAt(cg, (u32)vi); // y moved into x\n            }\n            usize ascs = cg->ebuf.len;\n            stP(&cg->ebuf, \"((\");\n            stPS(&cg->ebuf, lv);\n            stP(&cg->ebuf, \" \");\n            stP(&cg->ebuf, op);\n            stP(&cg->ebuf, \" \");\n            stPS(&cg->ebuf, rv);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, ascs);\n        },\n\n        ExprKind::BuiltinCall => {\n            u32 bn = e->kind.payload.BuiltinCall.builtin;\n            u32 implHash = 0;\n            u32 implLen = 0;\n            if (!builtinImplHash(bn, &implHash, &implLen)) {\n                /* compile-time builtins (compileError / isFormatLiteral /\n                 * typeof) are consumed by sema and mono and must never\n                 * arrive here */\n                cgError(cg, \"unsupported builtin call\");\n                stP(&cg->ebuf, \"0\");\n                return stTail(&cg->ebuf, es);\n            }\n            /* @assertOut(cond) without a message is @assert(cond) */\n            if (bn == BUILTIN_ASSERTOUT && e->kind.payload.BuiltinCall.argsLen < 2)\n                builtinImplHash(BUILTIN_ASSERT, &implHash, &implLen);\n            /* the tag only names the implementation; resolve its decl in\n             * the module tree and emit the resolved mangled symbol */\n            NodeId implId = cgFindDeclByHash(cg, implHash, implLen);\n            if (implId.index == 0) {\n                cgErrorAt(cg, id, \"the @-error builtins are not in this unit (import core::error)\");\n                stP(&cg->ebuf, \"0\");\n                return stTail(&cg->ebuf, es);\n            }\n            Ty rty = 0;\n            bool found = false;\n            NodeId fdecl;\n            fdecl.index = 0;\n            Slice callee = cgCallFromDecl(cg, implId, 0, e->kind.payload.BuiltinCall.args,\n                                          e->kind.payload.BuiltinCall.argsLen,\n                                          &rty, &found, &fdecl);\n            Slice argTexts = cgCallArgsText(cg, fdecl, e->kind.payload.BuiltinCall.args,\n                                            e->kind.payload.BuiltinCall.argsLen);\n            usize ccs = cg->ebuf.len;\n            stPS(&cg->ebuf, callee);\n            stCh(&cg->ebuf, '(');\n            stPS(&cg->ebuf, argTexts);\n            stCh(&cg->ebuf, ')');\n            return stTail(&cg->ebuf, ccs);\n        },\n\n        ExprKind::SwitchExpr => {\n            Slice scrut = cgExpr(cg, e->kind.payload.SwitchExpr.expr);\n            Ty scrutTy = 0;\n            {\n                Node* sn = cgNode(cg, e->kind.payload.SwitchExpr.expr);\n                if (sn->kind.tag == NodeKind::Expr) scrutTy = sn->kind.payload.Expr.value.resolvedType;\n            }\n            u32 t = cgNewTemp(cg, cgResultTy(cg, id, e), 0);\n            Slice tn = cgTempName(cg, t);\n            cgEmitSwitch(cg, scrut, scrutTy, e->kind.payload.SwitchExpr.cases, e->kind.payload.SwitchExpr.casesLen, tn);\n            return tn;\n        },\n\n        ExprKind::TypeRef => {\n            cgError(cg, \"unresolved TypeRef\");\n            stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::Spread => {\n            /* `...pack`: after comptime eval the pack is gone; if one\n             * survives to codegen it is just its inner expression */\n            return cgExpr(cg, e->kind.payload.Spread.expr);\n        },\n        ExprKind::Typeof => {\n            cgError(cg, \"typeof not supported\");\n            stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, es);\n        },\n\n        else => {\n            cgError(cg, \"unsupported expression kind\");\n            stP(&cg->ebuf, \"0\");\n            return stTail(&cg->ebuf, es);\n        },\n    }\n    return stTail(&cg->ebuf, es);\n}\n\n/* A field of a temporary (`f().field`) is not a C lvalue even though\n * the field expression itself is an lvalue shape; walk back through\n * value receivers until a real storage location or a pointer base. */\nbool cgExprIsLvalue(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return false;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) return false;\n    Expr* e = &n->kind.payload.Expr.value;\n    switch (e->kind.tag)\n    {\n        ExprKind::Ident, ExprKind::Deref, ExprKind::Index => { return true; },\n        ExprKind::Field, ExprKind::DerefField => {\n            NodeId obj = e->kind.tag == ExprKind::Field\n                             ? e->kind.payload.Field.obj\n                             : e->kind.payload.DerefField.obj;\n            Node* on = cgNode(cg, obj);\n            if (on->kind.tag == NodeKind::Expr)\n            {\n                Ty ot = on->kind.payload.Expr.value.resolvedType;\n                if (ot != 0 && cgTyIsPtr(cg, ot)) return true;\n            }\n            return cgExprIsLvalue(cg, obj);\n        },\n        ExprKind::TupleField => { return cgExprIsLvalue(cg, e->kind.payload.TupleField.obj); },\n        else => { return false; }\n    }\n}\n\n/* `&expr`: C cannot take the address of a temporary, so a non-lvalue\n * operand is materialized into a hidden local first. vtext is the\n * already-lowered operand text. */\nSlice cgAddrOfValue(Codegen* cg, NodeId oid, Slice vtext)\n{\n    Node* on = cgNode(cg, oid);\n    bool lv = cgExprIsLvalue(cg, oid);\n    Slice c = vtext;\n    if (!lv) {\n        Slice oty;\n        if (on->kind.tag == NodeKind::Expr && on->kind.payload.Expr.value.resolvedType != 0) {\n            Ty ot = cgSubstTy(cg, on->kind.payload.Expr.value.resolvedType);\n            oty = tyStr(cg, cgTyUnwrap(cg, ot));\n        } else if (on->kind.tag == NodeKind::Expr) {\n            oty = cgResultTy(cg, oid, &on->kind.payload.Expr.value);\n        } else {\n            oty = Slice::fromStr(\"void*\");\n        }\n        u32 t = cgNewTemp(cg, oty, 0);\n        Slice tn = cgTempName(cg, t);\n        stNL(&cg->body, cg->ind);\n        stPS(&cg->body, tn);\n        stP(&cg->body, \" = \");\n        stPS(&cg->body, c);\n        stCh(&cg->body, ';');\n        c = tn;\n    }\n    usize rs = cg->ebuf.len;\n    stP(&cg->ebuf, \"(&(\");\n    stPS(&cg->ebuf, c);\n    stP(&cg->ebuf, \"))\");\n    return stTail(&cg->ebuf, rs);\n}\n\n/* Receiver expression for a for-in @iter loop. A bare variable needs no\n * temp: use the pointer directly, or `&name` at each call site. Complex\n * receivers were already materialized into a pointer temp by the caller. */\nSlice cgForInRecv(Codegen* cg, bool simpleIter, bool iterIsPtr, Str simpleName, u32 rt)\n{\n    if (!simpleIter) return cgTempName(cg, rt);\n    Slice name = cgIdent(cg, simpleName);\n    if (iterIsPtr) return name;\n    usize rs = cg->tybuf.len;\n    stP(&cg->tybuf, \"(&(\");\n    stPS(&cg->tybuf, name);\n    stP(&cg->tybuf, \"))\");\n    return stTail(&cg->tybuf, rs);\n}\n\nSlice cgLvalue(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) {\n        stP(&cg->ebuf, \"0\");\n        return stTail(&cg->ebuf, cg->ebuf.len - 1);\n    }\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Expr) {\n        cgError(cg, \"expected expression node\");\n        stP(&cg->ebuf, \"0\");\n        return stTail(&cg->ebuf, cg->ebuf.len - 1);\n    }\n    Expr* e = &n->kind.payload.Expr.value;\n    usize es = cg->ebuf.len;\n    switch (e->kind.tag)\n    {\n        ExprKind::Ident => {\n            Str iname = e->kind.payload.Ident.name;\n            /* self is a pointer parameter: an lvalue assignment to it\n             * writes through the pointer */\n            if (cgTyIsPtr(cg, e->resolvedType) && cg->ctx->internEqHashLen(iname, 0x645BA277, 4)) { /* FNV(\"self\") */\n                stP(&cg->ebuf, \"*(\");\n                stPS(&cg->ebuf, cgIdent(cg, iname));\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, es);\n            }\n            if (!cgIsLocalName(cg, iname))\n            {\n                Str alias = 0;\n                NodeId rd = cgResolveRef(cg, iname, 0, id, &alias);\n                if (rd.index != 0)\n                {\n                    Node* rn = cgNode(cg, rd);\n                    if (rn->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* rdd = &rn->kind.payload.Decl.value;\n                        if (rdd->kind.tag == DeclKind::Func || rdd->kind.tag == DeclKind::Constant)\n                        {\n                            Str own = cgDeclOwnName(rdd);\n                            if (own != 0)\n                            {\n                                stPS(&cg->ebuf, cgMangle(cg, rd, own, alias));\n                                return stTail(&cg->ebuf, es);\n                            }\n                        }\n                    }\n                }\n            }\n            stPS(&cg->ebuf, cgIdent(cg, iname));\n            return stTail(&cg->ebuf, es);\n        },\n        ExprKind::Deref => {\n            Slice c = cgExpr(cg, e->kind.payload.Deref.expr);\n            usize rs = cg->ebuf.len;\n            stP(&cg->ebuf, \"(*(\");\n            stPS(&cg->ebuf, c);\n            stP(&cg->ebuf, \"))\");\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::Field, ExprKind::DerefField => {\n            NodeId obj;\n            Str field;\n            if (e->kind.tag == ExprKind::Field) {\n                obj = e->kind.payload.Field.obj;\n                field = e->kind.payload.Field.field;\n            } else {\n                obj = e->kind.payload.DerefField.obj;\n                field = e->kind.payload.DerefField.field;\n            }\n            /* `x.payload.Case`: lower to the union member slot of the\n             * case's ordinal: `x.u.v<idx>` (only when the base is a variant\n             * and the case exists; a plain `payload` struct field is not) */\n            if (cgIsPayloadAccess(cg, obj))\n            {\n                NodeId base = cgFieldAccessObj(cg, obj);\n                Node* bn = cgNode(cg, base);\n                Ty bty = 0;\n                if (bn->kind.tag == NodeKind::Expr) bty = bn->kind.payload.Expr.value.resolvedType;\n                u32 vidx = 0;\n                NodeId vd = cgFindVariantOfTy(cg, bty, field, &vidx);\n                if (vd.index != 0)\n                {\n                    bool basePtr = cgTyIsPtr(cg, bty);\n                    Slice o = basePtr ? cgExpr(cg, base) : cgLvalue(cg, base);\n                    usize cs = cg->ebuf.len;\n                    stPS(&cg->ebuf, o);\n                    if (basePtr) stP(&cg->ebuf, \"->\");\n                    else stCh(&cg->ebuf, '.');\n                    stP(&cg->ebuf, \"u.v\");\n                    stU64(&cg->ebuf, (u64)vidx);\n                    return stTail(&cg->ebuf, cs);\n                }\n            }\n            Node* on = cgNode(cg, obj);\n            bool isPtr = false;\n            if (on->kind.tag == NodeKind::Expr) {\n                Ty ot = on->kind.payload.Expr.value.resolvedType;\n                if (ot != 0 && cgTyIsPtr(cg, ot)) isPtr = true;\n            }\n            /* `base->field`: the base is a pointer *value*, so take the\n             * value form (an lvalue deref like `*(self)` would bind as\n             * `*((self)->field)`); a plain field still needs an lvalue */\n            Slice o = isPtr ? cgExpr(cg, obj) : cgLvalue(cg, obj);\n            usize rs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            if (isPtr) stP(&cg->ebuf, \"->\");\n            else stCh(&cg->ebuf, '.');\n            stPS(&cg->ebuf, cgIdent(cg, field));\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::Index => {\n            Slice o = cgExpr(cg, e->kind.payload.Index.obj);\n            Slice ix = cgExpr(cg, e->kind.payload.Index.index);\n            bool isStr = cgIsStrTy(cg, e->kind.payload.Index.obj);\n            usize rs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            if (isStr) stP(&cg->ebuf, \".ptr\");\n            stCh(&cg->ebuf, '[');\n            stPS(&cg->ebuf, ix);\n            stCh(&cg->ebuf, ']');\n            return stTail(&cg->ebuf, rs);\n        },\n        ExprKind::TupleField => {\n            Slice o = cgLvalue(cg, e->kind.payload.TupleField.obj);\n            usize rs = cg->ebuf.len;\n            stPS(&cg->ebuf, o);\n            stCh(&cg->ebuf, '.');\n            stP(&cg->ebuf, \"_\");\n            stU64(&cg->ebuf, (u64)e->kind.payload.TupleField.index);\n            return stTail(&cg->ebuf, rs);\n        },\n        else => {\n            // not an lvalue: fall back to value path (error surfaces in C)\n            return cgExpr(cg, id);\n        },\n    }\n    return stTail(&cg->ebuf, es);\n}\n\n/* ── value of a body used as expression (if/switch branches) ─── */\n\nSlice cgValBody(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return Slice::fromStr(\"0\");\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag == NodeKind::Expr) return cgExpr(cg, id);\n    if (n->kind.tag != NodeKind::Stmt) {\n        cgError(cg, \"expected lvalue node\");\n        return Slice::fromStr(\"0\");\n    }\n    Stmt* s = &n->kind.payload.Stmt.value;\n    if (s->kind.tag == StmtKind::ExprStmt) return cgExpr(cg, s->kind.payload.ExprStmt.expr);\n    if (s->kind.tag == StmtKind::Block)\n    {\n        u32 i = 0;\n        u32 cnt = s->kind.payload.Block.stmtsLen;\n        while (i + 1 < cnt)\n        {\n            cgStmt(cg, s->kind.payload.Block.stmts[i]);\n            i++;\n        }\n        if (cnt == 0) return Slice::fromStr(\"0\");\n        NodeId last = s->kind.payload.Block.stmts[cnt - 1];\n        Node* ln = cgNode(cg, last);\n        if (ln->kind.tag == NodeKind::Stmt && ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)\n            return cgExpr(cg, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);\n        cgStmt(cg, last);\n        return Slice::fromStr(\"0\");\n    }\n    cgError(cg, \"expected statement node\");\n    return Slice::fromStr(\"0\");\n}\n\n/* ── switch lowering: compare chains + labels ────────────────── */\n\n/* strip Const/Comptime wrappers: `const T*` receivers carry the const\n * on the outside, so Pointer/Array checks must look through it */\nTy cgTyUnwrap(Codegen* cg, Ty t)\n{\n    while (t != 0 && ((cg->ctx->types + t)->kind.tag == TypeKind::Const ||\n                      (cg->ctx->types + t)->kind.tag == TypeKind::Comptime))\n    {\n        if ((cg->ctx->types + t)->kind.tag == TypeKind::Const) t = (cg->ctx->types + t)->kind.payload.Const.base;\n        else t = (cg->ctx->types + t)->kind.payload.Comptime.base;\n    }\n    return t;\n}\n\nbool cgTyIsPtr(Codegen* cg, Ty t)\n{\n    if (t == 0) return false;\n    TypeEntry* e = cg->ctx->types + t;\n    while (e->kind.tag == TypeKind::Const || e->kind.tag == TypeKind::Comptime)\n    {\n        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else t = e->kind.payload.Comptime.base;\n        if (t == 0) return false;\n        e = cg->ctx->types + t;\n    }\n    return e->kind.tag == TypeKind::Pointer;\n}\n\nextern(\"C\") Slice cgPatTest(Codegen* cg, NodeId patId, Slice scrut, Ty scrutTy, bool* isWildcard);\n\nSlice cgPatTest(Codegen* cg, NodeId patId, Slice scrut, Ty scrutTy, bool* isWildcard)\n{\n    *isWildcard = false;\n    if (patId.index == 0) { *isWildcard = true; return Slice::from(null, 0); }\n    Node* n = cgNode(cg, patId);\n    if (n->kind.tag == NodeKind::Pat)\n    {\n        Pat* p = &n->kind.payload.Pat.value;\n        switch (p->kind.tag)\n        {\n            PatKind::Wildcard => { *isWildcard = true; return Slice::from(null, 0); },\n            PatKind::Variant => {\n                /* enum scrutinee: members are C enum constants\n                 * `Root_Name`: compare the value directly (variant decls\n                 * are structs and compare their .tag field below) */\n                {\n                    Ty et = scrutTy;\n                    while (et != 0)\n                    {\n                        TypeEntry* ee = cg->ctx->types + et;\n                        if (ee->kind.tag == TypeKind::Pointer) et = ee->kind.payload.Pointer.base;\n                        else if (ee->kind.tag == TypeKind::Const) et = ee->kind.payload.Const.base;\n                        else if (ee->kind.tag == TypeKind::Comptime) et = ee->kind.payload.Comptime.base;\n                        else break;\n                    }\n                    if (et != 0 && (cg->ctx->types + et)->kind.tag == TypeKind::Named)\n                    {\n                        Str root = (cg->ctx->types + et)->kind.payload.Named.name;\n                        NodeId ed = cgFindDecl(cg, root, (u32)DeclKind::Enum);\n                        if (ed.index != 0)\n                        {\n                            usize es = cg->ebuf.len;\n                            stCh(&cg->ebuf, '(');\n                            stPS(&cg->ebuf, scrut);\n                            stP(&cg->ebuf, \" == \");\n                            stPS(&cg->ebuf, cgMangle(cg, ed, root, 0));\n                            stCh(&cg->ebuf, '_');\n                            stPS(&cg->ebuf, cgIntern(cg, p->kind.payload.Variant.variantName));\n                            stCh(&cg->ebuf, ')');\n                            return stTail(&cg->ebuf, es);\n                        }\n                    }\n                }\n                u32 vidx = 0;\n                NodeId vd = cgFindVariantOfTy(cg, scrutTy, p->kind.payload.Variant.variantName, &vidx);\n                bool tagField = vd.index != 0;\n                if (vd.index == 0 && p->kind.payload.Variant.typeName != 0)\n                {\n                    /* `switch (x.kind.tag)`: the scrutinee is already the\n                     * ordinal; resolve the variant behind the pattern head */\n                    vd = cgFindDecl(cg, p->kind.payload.Variant.typeName, (u32)DeclKind::Variant);\n                    if (vd.index != 0)\n                    {\n                        Node* dn = cgNode(cg, vd);\n                        Decl* dd = &dn->kind.payload.Decl.value;\n                        u32 v = 0;\n                        bool found = false;\n                        while (v < dd->kind.payload.Variant.variantsLen)\n                        {\n                            if (dd->kind.payload.Variant.variants[v].name == p->kind.payload.Variant.variantName)\n                            {\n                                vidx = v;\n                                found = true;\n                                break;\n                            }\n                            v++;\n                        }\n                        if (!found) vd.index = 0;\n                    }\n                }\n                if (vd.index == 0) {\n                    cgError(cg, \"pattern lowering failed\");\n                    *isWildcard = true;\n                    return Slice::from(null, 0);\n                }\n                usize s = cg->ebuf.len;\n                stCh(&cg->ebuf, '(');\n                stPS(&cg->ebuf, scrut);\n                if (tagField)\n                {\n                    if (cgTyIsPtr(cg, scrutTy)) stP(&cg->ebuf, \"->tag == \");\n                    else stP(&cg->ebuf, \".tag == \");\n                }\n                else stP(&cg->ebuf, \" == \");\n                stU64(&cg->ebuf, (u64)vidx);\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, s);\n            },\n            PatKind::Ident => {\n                /* a bare name in a value switch is a file-scope constant:\n                 * `switch (sig) { SIGSEGV_ => … }`. resolve it the way an\n                 * Ident expression would, then compare the scrutinee. */\n                Str nm = p->kind.payload.Ident.name;\n                Str alias = 0;\n                NodeId rd = cgResolveRef(cg, nm, (u32)DeclKind::Constant, patId, &alias);\n                Node* rn = rd.index != 0 ? cgNode(cg, rd) : null;\n                if (rn != null && rn->kind.tag == NodeKind::Decl &&\n                    rn->kind.payload.Decl.value.kind.tag == DeclKind::Constant)\n                {\n                    Decl* cd = &rn->kind.payload.Decl.value;\n                    Str own = cgDeclOwnName(cd);\n                    usize s = cg->ebuf.len;\n                    stCh(&cg->ebuf, '(');\n                    stPS(&cg->ebuf, scrut);\n                    stP(&cg->ebuf, \" == \");\n                    stPS(&cg->ebuf, cgMangle(cg, rd, own, alias));\n                    stCh(&cg->ebuf, ')');\n                    return stTail(&cg->ebuf, s);\n                }\n                cgError(cg, \"pattern names an unknown constant\");\n                *isWildcard = true;\n                return Slice::from(null, 0);\n            },\n            PatKind::Lit => {\n                Slice l = cgExpr(cg, p->kind.payload.Lit.expr);\n                usize s = cg->ebuf.len;\n                stCh(&cg->ebuf, '(');\n                stPS(&cg->ebuf, scrut);\n                stP(&cg->ebuf, \" == \");\n                stPS(&cg->ebuf, l);\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, s);\n            },\n            PatKind::Or => {\n                /* Render each alternative, collect the parts, then build the\n                 * wrapping text from scratch: appending each part slice\n                 * directly into cg.ebuf duplicates it (inner expr artifacts\n                 * + the real text land in the same stream). */\n                Slice altsText = Slice::from(null, 0);\n                {\n                    Stream abuf = stNew(cg->arena, 64);\n                    u32 i = 0;\n                    while (i < p->kind.payload.Or.alternativesLen)\n                    {\n                        bool w = false;\n                        Slice t = cgPatTest(cg, p->kind.payload.Or.alternatives[i], scrut, scrutTy, &w);\n                        if (i > 0) stP(&abuf, \" || \");\n                        if (w) stP(&abuf, \"1\");\n                        else stPS(&abuf, t);\n                        i++;\n                    }\n                    altsText = stTail(&abuf, 0);\n                }\n                usize s = cg->ebuf.len;\n                stCh(&cg->ebuf, '(');\n                stPS(&cg->ebuf, altsText);\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, s);\n            },\n            PatKind::Range => {\n                Slice a = cgExpr(cg, p->kind.payload.Range.start);\n                Slice b = cgExpr(cg, p->kind.payload.Range.end);\n                usize s = cg->ebuf.len;\n                stCh(&cg->ebuf, '(');\n                stPS(&cg->ebuf, scrut);\n                stP(&cg->ebuf, \" >= \");\n                stPS(&cg->ebuf, a);\n                if (p->kind.payload.Range.flags & 1) stP(&cg->ebuf, \" && \");\n                else stP(&cg->ebuf, \" && \");\n                stPS(&cg->ebuf, scrut);\n                if (p->kind.payload.Range.flags & 1) stP(&cg->ebuf, \" <= \");\n                else stP(&cg->ebuf, \" < \");\n                stPS(&cg->ebuf, b);\n                stCh(&cg->ebuf, ')');\n                return stTail(&cg->ebuf, s);\n            },\n            else => {\n                cgError(cg, \"pattern lowering failed\");\n                *isWildcard = true;\n                return Slice::from(null, 0);\n            },\n        }\n    }\n    if (n->kind.tag == NodeKind::Expr)\n    {\n        // bare expression pattern (e.g. enum variant)\n        Slice l = cgExpr(cg, patId);\n        usize s = cg->ebuf.len;\n        stCh(&cg->ebuf, '(');\n        stPS(&cg->ebuf, scrut);\n        stP(&cg->ebuf, \" == \");\n        stPS(&cg->ebuf, l);\n        stCh(&cg->ebuf, ')');\n        return stTail(&cg->ebuf, s);\n    }\n    cgError(cg, \"pattern lowering failed\");\n    *isWildcard = true;\n    return Slice::from(null, 0);\n}\n\n/* variant-field bindings for one case's pattern(s): declared before the\n * chain, assigned when the case is entered */\nvoid cgSwitchBinds(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* c)\n{\n    u32 pp = 0;\n    while (pp < c->patternsLen)\n    {\n        Node* pn = cgNode(cg, c->patterns[pp]);\n        if (pn->kind.tag == NodeKind::Pat)\n        {\n            Pat* pv = &pn->kind.payload.Pat.value;\n            if (pv->kind.tag == PatKind::Variant && pv->kind.payload.Variant.fieldNamesLen > 0)\n            {\n                u32 vidx = 0;\n                NodeId vd = cgFindVariantOfTy(cg, scrutTy, pv->kind.payload.Variant.variantName, &vidx);\n                if (vd.index != 0)\n                {\n                    u32 ff = 0;\n                    while (ff < pv->kind.payload.Variant.fieldNamesLen)\n                    {\n                        Str fname = pv->kind.payload.Variant.fieldNames[ff];\n                        stNL(&cg->body, cg->ind);\n                        stPS(&cg->body, cgIntern(cg, fname));\n                        stP(&cg->body, \" = \");\n                        stPS(&cg->body, scrut);\n                        if (cgTyIsPtr(cg, scrutTy)) stP(&cg->body, \"->u.v\");\n                        else stP(&cg->body, \".u.v\");\n                        stU64(&cg->body, (u64)vidx);\n                        stCh(&cg->body, '.');\n                        stPS(&cg->body, cgIntern(cg, fname));\n                        stCh(&cg->body, ';');\n                        ff++;\n                    }\n                }\n            }\n        }\n        pp++;\n    }\n}\n\n// one case's body: statement bodies, or value bodies assigning resultTemp\nvoid cgSwitchBody(Codegen* cg, SwitchCase* c, Slice resultTemp)\n{\n    Node* bn = cgNode(cg, c->body);\n    if (bn->kind.tag == NodeKind::Expr && resultTemp.len > 0)\n    {\n        Slice v = cgExpr(cg, c->body);\n        stNL(&cg->body, cg->ind);\n        stPS(&cg->body, resultTemp);\n        stP(&cg->body, \" = (\");\n        stPS(&cg->body, v);\n        stP(&cg->body, \");\");\n    }\n    else if (bn->kind.tag == NodeKind::Stmt && bn->kind.payload.Stmt.value.kind.tag == StmtKind::Block && resultTemp.len > 0)\n    {\n        // value block: stmts then last expr result\n        Stmt* bs = &bn->kind.payload.Stmt.value;\n        u32 si = 0;\n        u32 cnt = bs->kind.payload.Block.stmtsLen;\n        while (si + 1 < cnt) {\n            cgStmt(cg, bs->kind.payload.Block.stmts[si]);\n            si++;\n        }\n        if (cnt > 0) {\n            NodeId last = bs->kind.payload.Block.stmts[cnt - 1];\n            Node* ln = cgNode(cg, last);\n            if (ln->kind.tag == NodeKind::Stmt && ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt) {\n                Slice v = cgExpr(cg, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);\n                stNL(&cg->body, cg->ind);\n                stPS(&cg->body, resultTemp);\n                stP(&cg->body, \" = (\");\n                stPS(&cg->body, v);\n                stP(&cg->body, \");\");\n            }\n        }\n    }\n    else\n    {\n        if (c->body.index != 0) cgStmt(cg, c->body);\n        if (resultTemp.len > 0) {\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, resultTemp);\n            stP(&cg->body, \" = 0;\");\n        }\n    }\n}\n\n/* if/else-if chain over cases[start..]. A guarded case whose guard fails\n * nests the remaining chain in its else. No fallthrough. `break` in a case\n * jumps to the chain's `__Lsw<n>` label (cgPushSwitch/cgPopSwitch) so it\n * exits the switch only, matching the reference (real C switch). */\nvoid cgEmitSwitchChain(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* cases, u32 casesLen, u32 start, Slice resultTemp, bool first)\n{\n    u32 j = start;\n    while (j < casesLen) {\n        SwitchCase* cc = cases + j;\n        if ((cc->flags & 4) == 0 && cc->patternsLen > 0) break;\n        j++;\n    }\n    if (j == casesLen)\n    {\n        // default (any source position) runs only when nothing matched\n        u32 d = 0;\n        while (d < casesLen) {\n            SwitchCase* cc = cases + d;\n            if ((cc->flags & 4) != 0 || cc->patternsLen == 0) break;\n            d++;\n        }\n        if (d < casesLen)\n        {\n            stNL(&cg->body, cg->ind);\n            if (first) stP(&cg->body, \"{\");\n            else stP(&cg->body, \"else\");\n            if (!first) { stNL(&cg->body, cg->ind); stP(&cg->body, \"{\"); }\n            cg->ind++;\n            cgSwitchBinds(cg, scrut, scrutTy, cases + d);\n            cgSwitchBody(cg, cases + d, resultTemp);\n            cg->ind--;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '}');\n        }\n        return;\n    }\n\n    SwitchCase* c = cases + j;\n    Slice testText;\n    {\n        Stream pbuf = stNew(cg->arena, 64);\n        u32 p = 0;\n        while (p < c->patternsLen)\n        {\n            bool w = false;\n            Slice t = cgPatTest(cg, c->patterns[p], scrut, scrutTy, &w);\n            if (p > 0) stP(&pbuf, \" || \");\n            if (w) { stP(&pbuf, \"1\"); break; }\n            stPS(&pbuf, t);\n            p++;\n        }\n        testText = stTail(&pbuf, 0);\n    }\n\n    stNL(&cg->body, cg->ind);\n    if (first) stP(&cg->body, \"if (\");\n    else stP(&cg->body, \"else if (\");\n    stPS(&cg->body, testText);\n    stCh(&cg->body, ')');\n    stNL(&cg->body, cg->ind);\n    stCh(&cg->body, '{');\n    cg->ind++;\n    cgSwitchBinds(cg, scrut, scrutTy, c);\n    bool hasGuard = ((c->flags & 1) != 0 && c->guard.index != 0);\n    if (hasGuard)\n    {\n        Slice g = cgExpr(cg, c->guard);\n        stNL(&cg->body, cg->ind);\n        stP(&cg->body, \"if (\");\n        stPS(&cg->body, g);\n        stCh(&cg->body, ')');\n        stNL(&cg->body, cg->ind);\n        stCh(&cg->body, '{');\n        cg->ind++;\n        cgSwitchBody(cg, c, resultTemp);\n        cg->ind--;\n        stNL(&cg->body, cg->ind);\n        stCh(&cg->body, '}');\n        // guard failed: try the remaining cases\n        stNL(&cg->body, cg->ind);\n        stP(&cg->body, \"else\");\n        stNL(&cg->body, cg->ind);\n        stCh(&cg->body, '{');\n        cg->ind++;\n        cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, j + 1, resultTemp, true);\n        cg->ind--;\n        stNL(&cg->body, cg->ind);\n        stCh(&cg->body, '}');\n    }\n    else\n    {\n        cgSwitchBody(cg, c, resultTemp);\n    }\n    cg->ind--;\n    stNL(&cg->body, cg->ind);\n    stCh(&cg->body, '}');\n    if (!hasGuard)\n        cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, j + 1, resultTemp, false);\n}\n\n/* cases: statement bodies (resultTemp empty) or expression bodies\n * (resultTemp names the variable each branch assigns). */\nvoid cgEmitSwitch(Codegen* cg, Slice scrut, Ty scrutTy, SwitchCase* cases, u32 casesLen, Slice resultTemp)\n{\n    if (casesLen > 256) {\n        cgError(cg, \"too many switch cases (cap 256)\");\n        return;\n    }\n    u32 swLabel = cg->switchSeq;\n    cg->switchSeq++;\n    cgPushSwitch(cg, swLabel, cg->dropsLen);\n\n    // pattern bindings: declared up front, assigned on case entry\n    {\n        Str* bindNames = (Str*)cg->arena->alloc(256 * 4, 4);\n        u32 bindCount = 0;\n        if (bindNames != null)\n        {\n            u32 ci = 0;\n            while (ci < casesLen)\n            {\n                SwitchCase* cc = cases + ci;\n                u32 pp = 0;\n                while (pp < cc->patternsLen)\n                {\n                    Node* pn = cgNode(cg, cc->patterns[pp]);\n                    if (pn->kind.tag == NodeKind::Pat)\n                    {\n                        Pat* pv = &pn->kind.payload.Pat.value;\n                        if (pv->kind.tag == PatKind::Variant && pv->kind.payload.Variant.fieldNamesLen > 0 && bindCount < 256)\n                        {\n                            u32 vidx0 = 0;\n                            NodeId vd0 = cgFindVariantOfTy(cg, scrutTy, pv->kind.payload.Variant.variantName, &vidx0);\n                            if (vd0.index != 0)\n                            {\n                                Node* vdn = cgNode(cg, vd0);\n                                Decl* vdd = &vdn->kind.payload.Decl.value;\n                                VariantVariant* vv0 = vdd->kind.payload.Variant.variants + vidx0;\n                                u32 ff = 0;\n                                while (ff < pv->kind.payload.Variant.fieldNamesLen && bindCount < 256)\n                                {\n                                    Str fname = pv->kind.payload.Variant.fieldNames[ff];\n                                    u32 kk = 0;\n                                    bool dup = false;\n                                    while (kk < bindCount) { if (bindNames[kk] == fname) { dup = true; break; } kk++; }\n                                    Ty ft = 0;\n                                    u32 fi = 0;\n                                    while (fi < vv0->fieldsLen)\n                                    {\n                                        if (vv0->fieldNames[fi] == fname) { ft = vv0->fieldTypes[fi]; break; }\n                                        fi++;\n                                    }\n                                    if (ft != 0 && !dup)\n                                    {\n                                        /* the field type comes from the generic\n                                         * variant declaration (`T value`), so bind\n                                         * it through the scrutinee's concrete\n                                         * arguments before emitting the C type */\n                                        Ty boundFt = cg->sema->substituteFieldTy(cgSubstTy(cg, ft), scrutTy);\n                                        stNL(&cg->body, cg->ind);\n                                        stPS(&cg->body, tyStr(cg, cgSubstTy(cg, boundFt)));\n                                        stCh(&cg->body, ' ');\n                                        stPS(&cg->body, cgIntern(cg, fname));\n                                        stCh(&cg->body, ';');\n                                        bindNames[bindCount] = fname;\n                                        bindCount++;\n                                        cgAddLocal(cg, fname);\n                                    }\n                                    ff++;\n                                }\n                            }\n                        }\n                    }\n                    pp++;\n                }\n                ci++;\n            }\n        }\n    }\n\n    cgEmitSwitchChain(cg, scrut, scrutTy, cases, casesLen, 0, resultTemp, true);\n    stNL(&cg->body, cg->ind);\n    stP(&cg->body, \"__Lsw\");\n    stU64(&cg->body, (u64)swLabel);\n    stP(&cg->body, \":;\");\n    cgPopSwitch(cg);\n}\n\n/* ── statements ──────────────────────────────────────────────── */\n\nextern(\"C\") void cgStmt(Codegen* cg, NodeId id);\n\n/* a body in statement position must be a block (a bare decl after\n * `if (c)` is invalid C): wrap non-block bodies in braces */\nvoid cgStmtBraced(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) {\n        stNL(&cg->body, cg->ind);\n        stP(&cg->body, \"{}\");\n        return;\n    }\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag == NodeKind::Stmt && n->kind.payload.Stmt.value.kind.tag == StmtKind::Block)\n    {\n        cgStmt(cg, id);\n        return;\n    }\n    stNL(&cg->body, cg->ind);\n    stCh(&cg->body, '{');\n    cg->ind++;\n    cgStmt(cg, id);\n    cg->ind--;\n    stNL(&cg->body, cg->ind);\n    stCh(&cg->body, '}');\n}\n\nvoid cgStmt(Codegen* cg, NodeId id)\n{\n    if (id.index == 0) return;\n    Node* n = cgNode(cg, id);\n    if (n->kind.tag != NodeKind::Stmt) {\n        if (n->kind.tag == NodeKind::Expr) {\n            Slice t = cgExpr(cg, id);\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, t);\n            stCh(&cg->body, ';');\n            return;\n        }\n        cgError(cg, \"expected statement node\");\n        return;\n    }\n    Stmt* s = &n->kind.payload.Stmt.value;\n\n    switch (s->kind.tag)\n    {\n        StmtKind::Block => {\n            u32 dropMark = cg->dropsLen;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '{');\n            cg->ind++;\n            u32 i = 0;\n            while (i < s->kind.payload.Block.stmtsLen)\n            {\n                cgStmt(cg, s->kind.payload.Block.stmts[i]);\n                i++;\n            }\n            /* scope exit: unwind the block's locals, innermost first */\n            cgEmitDropsTo(cg, dropMark);\n            cg->ind--;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '}');\n            return;\n        },\n\n        StmtKind::ExprStmt => {\n            Slice t = cgExpr(cg, s->kind.payload.ExprStmt.expr);\n            if (t.len == 0) return; // void call already emitted inline\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, t);\n            stCh(&cg->body, ';');\n            return;\n        },\n\n        StmtKind::VarDecl => {\n            Str name = s->kind.payload.VarDecl.name;\n            Ty ty = s->kind.payload.VarDecl.typeNode;\n            NodeId init = s->kind.payload.VarDecl.init;\n            cgAddLocal(cg, name);\n            Slice tyText;\n            if (ty != 0) tyText = tyStr(cg, ty);\n            else if (init.index != 0) {\n                Node* inn = cgNode(cg, init);\n                if (inn->kind.tag == NodeKind::Expr)\n                    tyText = cgResultTy(cg, init, &inn->kind.payload.Expr.value);\n                else tyText = Slice::fromStr(\"void*\");\n            } else tyText = Slice::fromStr(\"void*\");\n\n            // array-typed local: declarator form, braced initializer\n            bool isArray = false;\n            if (ty != 0 && (cg->ctx->types + ty)->kind.tag == TypeKind::Array) isArray = true;\n\n            Node* inn = (init.index != 0) ? cgNode(cg, init) : null;\n            bool initIsArrayLit = false;\n            if (inn != null && inn->kind.tag == NodeKind::Expr &&\n                inn->kind.payload.Expr.value.kind.tag == ExprKind::ArrayLiteral) initIsArrayLit = true;\n\n            /* non-literal init of an array local (`T[N] x = y;` /\n             * `T[N] x = (T[N])p;`): C forbids initializing an array from\n             * an expression, so emit the bare decl then a memcpy of the\n             * source bytes — the same lowering `x = y` uses. cgExpr runs\n             * BEFORE any of this function's own body emission so any\n             * statements it hoists land before the decl */\n            bool arrMemcpyInit = isArray && init.index != 0 && !initIsArrayLit;\n            Slice initSrc;\n            if (arrMemcpyInit) initSrc = cgExpr(cg, init);\n            bool declTerminated = false;\n\n            if (isArray) {\n                stNL(&cg->body, cg->ind);\n                if ((s->kind.payload.VarDecl.flags & 4) != 0) stP(&cg->body, \"static \");\n                Ty et = ty;\n                while ((cg->ctx->types + et)->kind.tag == TypeKind::Array)\n                    et = (cg->ctx->types + et)->kind.payload.Array.base;\n                stPS(&cg->body, tyStr(cg, et));\n                stCh(&cg->body, ' ');\n                stPS(&cg->body, cgIdent(cg, name));\n                Ty w = ty;\n                while ((cg->ctx->types + w)->kind.tag == TypeKind::Array)\n                {\n                    stCh(&cg->body, '[');\n                    stU64(&cg->body, (u64)(cg->ctx->types + w)->kind.payload.Array.len);\n                    stCh(&cg->body, ']');\n                    w = (cg->ctx->types + w)->kind.payload.Array.base;\n                }\n                if (initIsArrayLit) {\n                    Expr* al = &inn->kind.payload.Expr.value;\n                    stP(&cg->body, \" = {\");\n                    u32 i = 0;\n                    while (i < al->kind.payload.ArrayLiteral.elemsLen) {\n                        if (i > 0) stP(&cg->body, \", \");\n                        Slice v = cgInitValue(cg, al->kind.payload.ArrayLiteral.elems[i]);\n                        stPS(&cg->body, v);\n                        i++;\n                    }\n                    stCh(&cg->body, '}');\n                } else if (arrMemcpyInit) {\n                    stCh(&cg->body, ';');\n                    stNL(&cg->body, cg->ind);\n                    stP(&cg->body, \"((void)memcpy(&(\");\n                    stPS(&cg->body, cgIdent(cg, name));\n                    stP(&cg->body, \"), &(\");\n                    stPS(&cg->body, initSrc);\n                    stP(&cg->body, \"), sizeof(\");\n                    stPS(&cg->body, cgIdent(cg, name));\n                    stP(&cg->body, \")));\");\n                    declTerminated = true;\n                } else {\n                    stP(&cg->body, \" = {0}\");\n                }\n            } else {\n                bool hasInit = init.index != 0;\n                Slice initText;\n                if (hasInit) initText = cgExpr(cg, init);\n                if (hasInit && cgIntToPtrInit(cg, init, ty)) initText = cgWrapPtrCast(cg, tyText, initText);\n                stNL(&cg->body, cg->ind);\n                if ((s->kind.payload.VarDecl.flags & 4) != 0) stP(&cg->body, \"static \");\n                stPS(&cg->body, tyText);\n                stCh(&cg->body, ' ');\n                stPS(&cg->body, cgIdent(cg, name));\n                if (hasInit) {\n                    stP(&cg->body, \" = \");\n                    stPS(&cg->body, initText);\n                }\n            }\n            if (!declTerminated) stCh(&cg->body, ';');\n            /* RAII: register the local so its drop runs at scope exit.\n             * `T x = y;` with y a droppable local moves the value: y is\n             * unregistered and x's future drop owns the buffer */\n            if (s->kind.payload.VarDecl.dropMethod.index != 0 &&\n                (s->kind.payload.VarDecl.flags & 4) == 0 && ty != 0)\n            {\n                if (init.index != 0)\n                {\n                    Node* inn2 = cgNode(cg, init);\n                    if (inn2->kind.tag == NodeKind::Expr &&\n                        inn2->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                    {\n                        i32 si = cgFindDrop(cg, inn2->kind.payload.Expr.value.kind.payload.Ident.name);\n                        if (si >= 0) cgRemoveDropAt(cg, (u32)si);\n                    }\n                }\n                cgPushDrop(cg, name, ty, s->kind.payload.VarDecl.dropMethod);\n            }\n            return;\n        },\n\n        StmtKind::Assign => {\n            Slice lv = cgLvalue(cg, s->kind.payload.Assign.target);\n            Slice rv = cgAssignValue(cg, s->kind.payload.Assign.target, s->kind.payload.Assign.value);\n            Slice op = cgIntern(cg, s->kind.payload.Assign.op);\n            /* plain `=` of an integer into a pointer (only reachable with\n             * --allow-int-ptr): gcc needs the cast; `+=` is pointer\n             * arithmetic and needs none */\n            if (op.len == 1 && op.ptr[0] == 61)\n            {\n                Node* tn = cgNode(cg, s->kind.payload.Assign.target);\n                Ty tt = 0;\n                if (tn->kind.tag == NodeKind::Expr) tt = tn->kind.payload.Expr.value.resolvedType;\n                if (cgIntToPtrInit(cg, s->kind.payload.Assign.value, tt)) rv = cgWrapPtrCast(cg, tyStr(cg, tt), rv);\n                /* RAII move semantics for `x = y;` on droppable locals:\n                 * the overwritten value of x drops now, and y's pending\n                 * drop is cancelled (x's exit drop owns the new value) */\n                Node* tgn = cgNode(cg, s->kind.payload.Assign.target);\n                Node* vgn = cgNode(cg, s->kind.payload.Assign.value);\n                bool tIsIdent = tgn->kind.tag == NodeKind::Expr &&\n                                tgn->kind.payload.Expr.value.kind.tag == ExprKind::Ident;\n                bool vIsIdent = vgn->kind.tag == NodeKind::Expr &&\n                                vgn->kind.payload.Expr.value.kind.tag == ExprKind::Ident;\n                i32 ti = tIsIdent ? cgFindDrop(cg, tgn->kind.payload.Expr.value.kind.payload.Ident.name) : -1;\n                i32 vi = vIsIdent ? cgFindDrop(cg, vgn->kind.payload.Expr.value.kind.payload.Ident.name) : -1;\n                if (ti >= 0 && vi != ti)\n                    cgEmitDropEntry(cg, &cg->drops[ti]); // old value of x\n                if (vi >= 0 && vi != ti)\n                    cgRemoveDropAt(cg, (u32)vi); // y moved into x\n            }\n            stNL(&cg->body, cg->ind);\n            stPS(&cg->body, lv);\n            stCh(&cg->body, ' ');\n            stPS(&cg->body, op);\n            stCh(&cg->body, ' ');\n            stPS(&cg->body, rv);\n            stCh(&cg->body, ';');\n            return;\n        },\n\n        StmtKind::Return => {\n            NodeId v = s->kind.payload.Return.value;\n            if (v.index == 0) {\n                cgEmitDropsBranch(cg, cg->fnDropMark, -1);\n                cgEmitStmt(cg, \"return\");\n                return;\n            }\n            Slice t = cgExpr(cg, v);\n            if (cg->dropsLen > cg->fnDropMark)\n            {\n                /* `return s;` moves the local out: its drop must not run,\n                 * the caller owns the value now */\n                i32 moved = -1;\n                Node* vn = cgNode(cg, v);\n                if (vn->kind.tag == NodeKind::Expr &&\n                    vn->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                    moved = cgFindDrop(cg, vn->kind.payload.Expr.value.kind.payload.Ident.name);\n                if (moved >= 0)\n                {\n                    cgEmitDropsBranch(cg, cg->fnDropMark, moved);\n                    stNL(&cg->body, cg->ind);\n                    stP(&cg->body, \"return \");\n                    stPS(&cg->body, t);\n                    stCh(&cg->body, ';');\n                    return;\n                }\n                /* other returns may alias dropped locals (slices into a\n                 * local buffer): materialize the value first */\n                Slice rt = Slice::fromStr(\"long\");\n                if (vn->kind.tag == NodeKind::Expr)\n                {\n                    Slice rtyp = cgResultTy(cg, v, &vn->kind.payload.Expr.value);\n                    if (rtyp.len > 0) rt = rtyp;\n                }\n                u32 ti = cgNewTemp(cg, rt, 0);\n                Slice tn = cgTempName(cg, ti);\n                stNL(&cg->body, cg->ind);\n                stPS(&cg->body, tn);\n                stP(&cg->body, \" = \");\n                stPS(&cg->body, t);\n                stCh(&cg->body, ';');\n                cgEmitDropsBranch(cg, cg->fnDropMark, -1);\n                stNL(&cg->body, cg->ind);\n                stP(&cg->body, \"return \");\n                stPS(&cg->body, tn);\n                stCh(&cg->body, ';');\n                return;\n            }\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"return \");\n            stPS(&cg->body, t);\n            stCh(&cg->body, ';');\n            return;\n        },\n\n        StmtKind::Break => {\n            if (cg->breakDepth > 0 && cg->breakKinds[cg->breakDepth - 1] == 1) {\n                cgEmitDropsBranch(cg, cg->breakDropMarks[cg->breakDepth - 1], -1);\n                stNL(&cg->body, cg->ind);\n                stP(&cg->body, \"goto __Lsw\");\n                stU64(&cg->body, (u64)cg->breakLabels[cg->breakDepth - 1]);\n                stCh(&cg->body, ';');\n                return;\n            }\n            if (cg->loopDepth == 0) { cgError(cg, \"break outside of loop\"); return; }\n            if (cg->loopDepth > 0) cgEmitDropsBranch(cg, cg->loopDropMarks[cg->loopDepth - 1], -1);\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"break;\");\n            return;\n        },\n\n        StmtKind::Continue => {\n            if (cg->loopDepth == 0) { cgError(cg, \"continue outside of loop\"); return; }\n            cgEmitDropsBranch(cg, cg->loopDropMarks[cg->loopDepth - 1], -1);\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"continue;\");\n            return;\n        },\n\n        StmtKind::If => {\n            Slice c = cgExpr(cg, s->kind.payload.If.cond);\n            bool hasElse = s->kind.payload.If.elseBody.index != 0;\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"if (\");\n            stPS(&cg->body, c);\n            stCh(&cg->body, ')');\n            cgStmtBraced(cg, s->kind.payload.If.thenBody);\n            if (hasElse) {\n                stNL(&cg->body, cg->ind);\n                stP(&cg->body, \"else\");\n                cgStmtBraced(cg, s->kind.payload.If.elseBody);\n            }\n            return;\n        },\n\n        StmtKind::While => {\n            u32 loopMark = cg->dropsLen;\n            usize b0 = cg->body.len;\n            Slice c = cgExpr(cg, s->kind.payload.While.cond);\n            bool condStmts = cg->body.len > b0;\n            if (!condStmts)\n            {\n                stNL(&cg->body, cg->ind);\n                stP(&cg->body, \"while (\");\n                stPS(&cg->body, c);\n                stCh(&cg->body, ')');\n                cgPushLoop(cg, loopMark);\n                cgStmtBraced(cg, s->kind.payload.While.body);\n                cgPopLoop(cg);\n                cgEmitDropsTo(cg, loopMark);\n                return;\n            }\n            // the condition carried statements: keep them inside the loop\n            stTrunc(&cg->body, b0);\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"while (1)\");\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '{');\n            cg->ind++;\n            c = cgExpr(cg, s->kind.payload.While.cond);\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"if (!(\");\n            stPS(&cg->body, c);\n            stP(&cg->body, \")) break;\");\n            cgPushLoop(cg, loopMark);\n            cgStmtBraced(cg, s->kind.payload.While.body);\n            cgPopLoop(cg);\n            cgEmitDropsTo(cg, loopMark);\n            cg->ind--;\n            stNL(&cg->body, cg->ind);\n            stCh(&cg->body, '}');\n            return;\n        },\n\n        StmtKind::Loop => {\n            u32 loopMark = cg->dropsLen;\n            stNL(&cg->body, cg->ind);\n            stP(&cg->body, \"while (1)\");\n            cgPushLoop(cg, loopMark);\n            cgStmtBraced(cg, s->kind.payl