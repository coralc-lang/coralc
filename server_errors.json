\n                {\n                    arguments[next] = self.sema->exprType(call->kind.payload.Call.args[p]);\n                    if (self.activeSubsLen > 0 && self.activeSubs != null)\n                        arguments[next] = self.substituteType(arguments[next], self.activeSubs, self.activeSubsLen);\n                }\n                next++;\n            }\n            else\n            {\n                /* named param whose type is a generic (`T fmt`): the type\n                 * is TypeParam{index} after parser rebind: bind the call\n                 * arg at this position to that generic slot */\n                Node* pn = self.nodeAt(paramId);\n                if (pn != null && pn->kind.tag == NodeKind::Param)\n                {\n                    Ty pt = pn->kind.payload.Param.value.typeNode;\n                    while (pt != 0)\n                    {\n                        TypeEntry* te2 = self.ast->types + pt;\n                        if (te2->kind.tag == TypeKind::Comptime) pt = te2->kind.payload.Comptime.base;\n                        else if (te2->kind.tag == TypeKind::Const) pt = te2->kind.payload.Const.base;\n                        else break;\n                    }\n                    if (pt != 0)\n                    {\n                        TypeEntry* te3 = self.ast->types + pt;\n                        u32 slot = 0;\n                        bool haveSlot = false;\n                        if (te3->kind.tag == TypeKind::TypeParam)\n                        {\n                            slot = te3->kind.payload.TypeParam.index;\n                            haveSlot = true;\n                        }\n                        else if (te3->kind.tag == TypeKind::Named)\n                        {\n                            Str tn = te3->kind.payload.Named.name;\n                            u32 gi = 0;\n                            while (gi < gdecl->kind.payload.Func.genericParamsLen)\n                            {\n                                Node* gpn = self.nodeAt(gdecl->kind.payload.Func.genericParams[gi]);\n                                if (gpn != null && gpn->kind.tag == NodeKind::GenericParam &&\n                                    gpn->kind.payload.GenericParam.value.name == tn)\n                                {\n                                    slot = gi;\n                                    haveSlot = true;\n                                    break;\n                                }\n                                gi++;\n                            }\n                        }\n                        if (haveSlot && slot < gcount &&\n                            arguments[slot] == 0 && p < call->kind.payload.Call.argsLen)\n                        {\n                            arguments[slot] = self.sema->exprType(call->kind.payload.Call.args[p]);\n                            if (self.activeSubsLen > 0 && self.activeSubs != null)\n                                arguments[slot] = self.substituteType(arguments[slot], self.activeSubs, self.activeSubsLen);\n                        }\n                    }\n                    /* fixed named param: count it for the variadic-tail\n                     * arity and record a literal call arg so the instance\n                     * can bind the parameter's comptime value */\n                    if ((pn->kind.payload.Param.value.flags & 16) == 0)\n                    {\n                        namedCount++;\n                        if (p < call->kind.payload.Call.argsLen &&\n                            pn->kind.payload.Param.value.name != 0)\n                        {\n                            NodeId avId = call->kind.payload.Call.args[p];\n                            Node* avn = self.nodeAt(avId);\n                            bool isLit = false;\n                            if (avn != null && avn->kind.tag == NodeKind::Expr)\n                            {\n                                Expr* ave = &avn->kind.payload.Expr.value;\n                                if (ave->kind.tag == ExprKind::StringLit ||\n                                    ave->kind.tag == ExprKind::IntLit ||\n                                    ave->kind.tag == ExprKind::CharLit ||\n                                    ave->kind.tag == ExprKind::BoolLit) isLit = true;\n                                else if (ave->kind.tag == ExprKind::Ident)\n                                {\n                                    NodeId cv = self.constLiteralNode(ave->kind.payload.Ident.name);\n                                    if (cv.index != 0) { avId = cv; isLit = true; }\n                                }\n                            }\n                            if (isLit && litNames != null && litNodes != null && litsLen < litCap)\n                            {\n                                litNames[litsLen] = pn->kind.payload.Param.value.name;\n                                litNodes[litsLen] = avId;\n                                litsLen++;\n                            }\n                        }\n                    }\n                }\n            }\n            p++;\n        }\n        /* trailing args past the fixed params are the variadic tail: record\n         * each one's concrete type + node so the instance can fold literal\n         * tails and give runtime tails named C parameters. A bare `...`\n         * forwards the caller's pack: it is not a concrete tail arg and\n         * must not count toward the arity (`_printEmit(&out, fmt, ...)`\n         * forwarded through `println(\"hello\")` stays an arity-0 site). */\n        u32 ti = namedCount;\n        while (ti < call->kind.payload.Call.argsLen)\n        {\n            NodeId avId = call->kind.payload.Call.args[ti];\n            Node* avn = self.nodeAt(avId);\n            bool isSpread = false;\n            if (avn != null && avn->kind.tag == NodeKind::Expr &&\n                avn->kind.payload.Expr.value.kind.tag == ExprKind::Spread) isSpread = true;\n            if (!isSpread && tailTypes != null && tailNodes != null && tailLen < litCap)\n            {\n                Ty tt = 0;\n                if (avn != null && avn->kind.tag == NodeKind::Expr)\n                    tt = self.sema->exprType(avId);\n                if (self.activeSubsLen > 0 && self.activeSubs != null)\n                    tt = self.substituteType(tt, self.activeSubs, self.activeSubsLen);\n                tailTypes[tailLen] = tt;\n                tailNodes[tailLen] = avId;\n                tailLen++;\n            }\n            ti++;\n        }\n        u32 arity = tailLen; /* pack arity: how many `_vargN` params the instance gets */\n        u64 key = self.callValueKeyTyped(call->kind.payload.Call.args, call->kind.payload.Call.argsLen,\n                                         self.activeSubs, self.activeSubsLen);\n        bool ok = self.enqueueVal(MonoDeclKind::FunctionDecl, declaration, arguments, gcount,\n                                  key, arity, litNames, litNodes, litsLen,\n                                  tailTypes, tailNodes, tailLen, callId);\n        if (litNames != null) dealloc<Str>(litNames);\n        if (litNodes != null) dealloc<NodeId>(litNodes);\n        if (tailTypes != null) dealloc<Ty>(tailTypes);\n        if (tailNodes != null) dealloc<NodeId>(tailNodes);\n        dealloc<Ty>(arguments);\n        return ok;\n    }\n\n    /* dispatch a node that may be either a statement or an expression.\n     * Switch/if-expression arms use this because their bodies can be\n     * written in either form. */\n    bool collectNode(NodeId id)\n    {\n        Node* node = self.nodeAt(id);\n        if (node == null) return true;\n        if (node->kind.tag == NodeKind::Stmt) return self.collectStmt(id);\n        if (node->kind.tag == NodeKind::Expr) return self.collectExpr(id);\n        return true;\n    }\n\n    /* Recursively collect every expression subtree. A generic call can\n     * hide under any operator, literal, block, switch, or if-expression;\n     * missing one means codegen later emits an uninstantiated callee. */\n    bool collectExpr(NodeId id)\n    {\n        Node* node = self.nodeAt(id);\n        if (node == null) return true;\n        if (node->kind.tag != NodeKind::Expr) return true;\n        Expr* expr = &node->kind.payload.Expr.value;\n        switch (expr->kind.tag)\n        {\n            ExprKind::TypeRef => { return self.collectType(expr->kind.payload.TypeRef.typeNode); },\n\n            ExprKind::Field => { return self.collectExpr(expr->kind.payload.Field.obj); },\n            ExprKind::DerefField => { return self.collectExpr(expr->kind.payload.DerefField.obj); },\n            ExprKind::TupleField => { return self.collectExpr(expr->kind.payload.TupleField.obj); },\n\n            ExprKind::Cast => {\n                if (!self.collectType(expr->kind.payload.Cast.targetType)) return false;\n                return self.collectExpr(expr->kind.payload.Cast.expr);\n            },\n            ExprKind::Sizeof => { return self.collectType(expr->kind.payload.Sizeof.targetType); },\n            ExprKind::Alignof => { return self.collectType(expr->kind.payload.Alignof.targetType); },\n            ExprKind::Typeof => { return self.collectExpr(expr->kind.payload.Typeof.expr); },\n\n            ExprKind::AddressOf => { return self.collectExpr(expr->kind.payload.AddressOf.expr); },\n            ExprKind::Deref => { return self.collectExpr(expr->kind.payload.Deref.expr); },\n            ExprKind::Neg => { return self.collectExpr(expr->kind.payload.Neg.expr); },\n            ExprKind::BitNot => { return self.collectExpr(expr->kind.payload.BitNot.expr); },\n            ExprKind::Not => { return self.collectExpr(expr->kind.payload.Not.expr); },\n\n            ExprKind::PostInc => { return self.collectExpr(expr->kind.payload.PostInc.expr); },\n            ExprKind::PostDec => { return self.collectExpr(expr->kind.payload.PostDec.expr); },\n            ExprKind::PreInc => { return self.collectExpr(expr->kind.payload.PreInc.expr); },\n            ExprKind::PreDec => { return self.collectExpr(expr->kind.payload.PreDec.expr); },\n\n            ExprKind::Spread => { return self.collectExpr(expr->kind.payload.Spread.expr); },\n\n            ExprKind::StructLiteral => {\n                if (!self.collectType(expr->kind.payload.StructLiteral.typeNode)) return false;\n                u32 i = 0;\n                while (i < expr->kind.payload.StructLiteral.fieldValuesLen)\n                {\n                    if (!self.collectExpr(expr->kind.payload.StructLiteral.fieldValues[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n\n            ExprKind::ArrayLiteral => {\n                u32 i = 0;\n                while (i < expr->kind.payload.ArrayLiteral.elemsLen)\n                {\n                    if (!self.collectExpr(expr->kind.payload.ArrayLiteral.elems[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n\n            ExprKind::TupleExpr => {\n                u32 i = 0;\n                while (i < expr->kind.payload.TupleExpr.elemsLen)\n                {\n                    if (!self.collectExpr(expr->kind.payload.TupleExpr.elems[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n\n            ExprKind::Call => {\n                if (!self.collectExpr(expr->kind.payload.Call.callee)) return false;\n                u32 i = 0;\n                while (i < expr->kind.payload.Call.argsLen)\n                {\n                    if (!self.collectExpr(expr->kind.payload.Call.args[i])) return false;\n                    i++;\n                }\n                return self.collectCall(id);\n            },\n\n            ExprKind::MethodCall => {\n                if (!self.collectExpr(expr->kind.payload.MethodCall.receiver)) return false;\n                u32 i = 0;\n                while (i < expr