e + load one `import`-style module; used for the builtin `str`\n * prelude that every unit merges */\nvoid libLoadModulePath(LibLoader* L, str ns)\n{\n    u8* nsPtr = (u8*)ns.ptr;\n    usize nsLen = ns.len;\n    u8* resolved = libResolve(L, nsPtr, nsLen);\n    if (resolved == null)\n    {\n        errWrite(\"coralc: cannot resolve import\");\n        errWrite(ns);\n        errWrite(\"\\n\");\n        L->errors++;\n        return;\n    }\n    if (libHas(L, resolved))\n    {\n        dealloc<u8>(resolved);\n        return;\n    }\n    if (!libPush(L, resolved))\n    {\n        L->errors++;\n        return;\n    }\n    usize len = 0;\n    u8* buf = libRead(resolved, &len);\n    if (buf == null)\n    {\n        errWrite(\"coralc: cannot read import file\");\n        errWrite(str { .ptr = resolved, .len = libLen(resolved) });\n        errWrite(\"\\n\");\n        L->errors++;\n        return;\n    }\n    u32 fid = 0;\n    DiagnosticEngine* dg = L->diag;\n    if (dg != null) fid = dg->addFile(resolved, libLen(resolved), buf, buf + len);\n    if (L->bufsLen >= L->bufsCap)\n    {\n        u32 newCap = L->bufsCap == 0 ? 8 : L->bufsCap * 2;\n        rawptr raw = realloc<u8*>(L->bufs, (usize)newCap);\n        if (raw != null) { L->bufs = (u8**)raw; L->bufsCap = newCap; }\n    }\n    if (L->bufsLen < L->bufsCap) L->bufs[L->bufsLen] = buf;\n    else dealloc<u8>(buf);\n    L->bufsLen++;\n    File* lf = libParse(L, buf, len, resolved, dg, fid);\n    if (lf == null)\n    {\n        errWrite(\"coralc: cannot read import file\");\n        errWrite(str { .ptr = resolved, .len = libLen(resolved) });\n        errWrite(\"\\n\");\n        L->errors++;\n        return;\n    }\n    libLoadImports(L, lf);   // dependencies first\n    libLoadSiblingImports(L, lf, null, null, 0, true);\n    if (!libPushFile(L, lf)) L->errors++;\n}\n\n bool libIsRootSeg(u8* p, usize n)\n {\n     /* `lib` is a module-root name and never a sibling; `file` was excluded\n      * too, which made a user module named file.crl impossible to use.\n      * Sibling loading only happens when <dir>/<name>crl exists, and\n      * libHas() dedupes modules already pulled in by the build, so `file`\n      * is safe to resolve as a sibling. */\n     if (n == 3 && p[0] == 108 && p[1] == 105 && p[2] == 98) return true;\n     return false;\n }\n\n /* non-lib `import a { … }`: load the sibling file <dir-of-f>/a.crl and\n   * merge it flat, like `import` files. Nested imports recurse;\n   * already-loaded paths are skipped (libHas dedupes). A missing file is\n   * not an error here; sema then falls back to module-symbol lookup.\n   * Bare `pub mod X = use X` re-exports chase only when chaseAll (an\n   * unqualified load or a caller without symbol context) or the alias is\n   * marked in want — an unreferenced re-export target stays unloaded.\n   * Explicit use-side imports always load (the source asked for them). */\n void libLoadSiblingImports(LibLoader* L, File* f, Str* wantAliases, u8* want, u32 wantCount, bool chaseAll)\n {\n    if (f == null || f->path == 0) return;\n    InternEntry* pe = L->ctx->interns + f->path;\n    u8* dir = libDir(pe->ptr);\n    /* a bare entry filename (coralc main.crl) has no directory component,\n     * so libDir is null; the sibling lives in the current directory. A\n     * root file (/main.crl) resolves against \"/\" instead. */\n    if (dir == null)\n    {\n        dir = alloc<u8>(2);\n        if (dir == null) return;\n        dir[0] = (pe->len > 0 && pe->ptr[0] == 47) ? 47 : 46; // '/' or '.'\n        dir[1] = 0;\n    }\n    usize dirLen = libLen(dir);\n     u32 i = 0;\n     while (i < f->declsLen)\n     {\n         Node* dn = L->ctx->nodes + f->decls[i].index;\n         if (dn->kind.tag == NodeKind::Decl)\n         {\n             Decl* dd = &dn->kind.payload.Decl.value;\n             /* normalize use-side Import and use-side ModReexport\n              * (`pub mod X = use …`) into one path */\n             Str sibPath = 0;\n             bool sibLike = false;\n             bool sibChase = true;\n             if (dd->kind.tag == DeclKind::Import && (dd->kind.payload.Import.flags & 1) == 0 && dd->kind.payload.Import.path != 0)\n             {\n                 sibPath = dd->kind.payload.Import.path;\n                 sibLike = true;\n             }\n             else if (dd->kind.tag == DeclKind::ModReexport && (dd->kind.payload.ModReexport.flags & 1) == 0 && dd->kind.payload.ModReexport.path != 0)\n             {\n                 sibPath = dd->kind.payload.ModReexport.path;\n                 sibLike = true;\n                 if (!chaseAll && wantAliases != null && want != null)\n                 {\n                     sibChase = false;\n                     Str sibAlias = dd->kind.payload.ModReexport.alias;\n                     u32 w = 0;\n                     while (w < wantCount)\n                     {\n                         if (wantAliases[w] == sibAlias && want[w] != 0) { sibChase = true; break; }\n                         w++;\n                     }\n                 }\n             }\n             if (sibLike && sibChase)\n             {\n                 InternEntry* ie = L->ctx->interns + sibPath;\n                 bool sibling = ie->len > 0;\n                 if (sibling && libIsRootSeg(ie->ptr, ie->len)) sibling = false;\n                 usize q = 0;\n                 while (sibling && q < ie->len)\n                 {\n                     if (ie->ptr[q] == 58) sibling = false;\n                     q++;\n                 }\n                 if (sibling)\n                 {\n                     u8* cand = libCandidate(dir, dirLen, ie->ptr, ie->len, \".crl\");\n                     if (cand != null)\n                     {\n                        if (libHas(L, cand))\n                        {\n                            dealloc<u8>(cand);\n                        }\n                        else\n                        {\n                            usize len = 0;\n                            u8* buf = libRead(cand, &len);\n                            if (buf == null)\n                            {\n                                dealloc<u8>(cand);\n                            }\n                            else if (!libPush(L, cand))\n                            {\n                                L->errors++;\n                                dealloc<u8>(cand);\n                                dealloc<u8>(buf);\n                            }\n                            else\n                            {\n                                u32 fid = 0;\n                                DiagnosticEngine* dg = L->diag;\n                                if (dg != null) fid = dg->addFile(cand, libLen(cand), buf, buf + len);\n                                if (L->bufsLen >= L->bufsCap)\n                                {\n                                    u32 newCap = L->bufsCap == 0 ? 8 : L->bufsCap * 2;\n                                    rawptr raw = realloc<u8*>(L->bufs, (usize)newCap);\n                                    if (raw != null) { L->bufs = (u8**)raw; L->bufsCap = newCap; }\n                                }\n                                if (L->bufsLen < L->bufsCap) L->bufs[L->bufsLen] = buf;\n                                else dealloc<u8>(buf);\n                                L->bufsLen++;\n                                File* lf = libParse(L, buf, len, cand, dg, fid);\n                                if (lf == null)\n                                {\n                                    errWrite(\"coralc: cannot parse sibling impor\");\n                                    errWrite(str { .ptr = cand, .len = libLen(cand) });\n                                    errWrite(\"\\n\");\n                                    L->errors++;\n                                }\n                                 else\n                                 {\n                                     libLoadImports(L, lf);\n                                     libLoadSiblingImports(L, lf, wantAliases, want, wantCount, chaseAll);\n                                     if (!libPushFile(L, lf)) L->errors++;\n                                 }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n        i++;\n    }\n}\n\nbool libIdentByte(u8 c)\n{\n    if (c >= 97 && c <= 122) return true;\n    if (c >= 65 && c <= 90) return true;\n    if (c >= 48 && c <= 57) return true;\n    if (c == 95) return true;\n    return false;\n}\n\nbool libDeclLineHasName(u8* p, usize n, u8* sym, usize symLen)\n{\n    if (sym == null || symLen == 0) return false;\n    usize i = 0;\n    while (i < n && (p[i] == 32 || p[i] == 9)) i++;\n    if (i + 3 > n) return false;\n    if (p[i] != 112 || p[i + 1] != 117 || p[i + 2] != 98) return false;\n    if (i + 3 < n && libIdentByte(p[i + 3])) return false;\n    usize end = i + 3;\n    while (end < n && p[end] != 40 && p[end] != 123 && p[end] != 61 && p[end] != 59 && p[end] != 58) end++;\n    usize k = i + 3;\n    while (k + symLen <= end)\n    {\n        if ((k == 0 || !libIdentByte(p[k - 1])) && (k + symLen >= n || !libIdentByte(p[k + symLen])))\n        {\n            usize q = 0;\n            bool hit = true;\n            while (q < symLen)\n            {\n                if (p[k + q] != sym[q]) { hit = false; break; }\n                q++;\n            }\n            if (hit) return true;\n        }\n        k++;\n    }\n    return false;\n}\n\nbool libSourceDeclares(LibLoader* L, u8* buf, usize len, ImportSymbol* syms, u32 symCount)\n{\n    if (L == null || buf == null || syms == null || symCount == 0) return false;\n    usize lineStart = 0;\n    while (lineStart < len)\n    {\n        usize lineEnd = lineStart;\n        while (lineEnd < len && buf[lineEnd] != 10) lineEnd++;\n        u32 s = 0;\n        while (s < symCount)\n        {\n            Str nm = syms[s].name;\n            if (nm != 0)\n            {\n                InternEntry* se = L->ctx->interns + nm;\n                if (libDeclLineHasName(buf + lineStart, lineEnd - lineStart, se->ptr, se->len)) return true;\n            }\n            s++;\n        }\n        lineStart = lineEnd + 1;\n    }\n    return false;\n}\n\nbool libReexportDeclares(LibLoader* L, u8* target, usize targetLen, Str alias, ImportSymbol* syms, u32 symCount)\n{\n    if (L == null || target == null || alias == 0 || syms == null || symCount == 0) return false;\n    InternEntry* ae = L->ctx->interns + alias;\n    u8* path = alloc<u8>(targetLen + 2 + ae->len);\n    if (path == null) return false;\n    usize w = 0;\n    while (w < targetLen) { path[w] = target[w]; w++; }\n    path[targetLen] = 58;\n    path[targetLen + 1] = 58;\n    w = 0;\n    while (w < ae->len) { path[targetLen + 2 + w] = ae->ptr[w]; w++; }\n    u8* resolved = libResolve(L, path, targetLen + 2 + ae->len);\n    dealloc<u8>(path);\n    if (resolved == null) return false;\n    usize len = 0;\n    u8* buf = libRead(resolved, &len);\n    dealloc<u8>(resolved);\n    if (buf == null) return false;\n    bool found = libSourceDeclares(L, buf, len, syms, symCount);\n    dealloc<u8>(buf);\n    return found;\n}\n\nvoid libLoadImports(LibLoader* L, File* f)\n{\n    if (f == null) return;\n    u32 i = 0;\n    while (i < f->declsLen)\n    {\n        Node* dn = L->ctx->nodes + f->decls[i].index;\n        if (dn->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &dn->kind.payload.Decl.value;\n            /* normalize Import and lib-side ModReexport (`pub mod X = import …`)\n             * into locals so one load path serves both; bare `use` re-exports\n             * are sibling loads handled by libLoadSiblingImports */\n            Str impPath = 0;\n            ImportSymbol* impSymbols = null;\n            u32 impSymbolsLen = 0;\n            u8 impFlags = 0;\n            bool isImportLike = false;\n            if (dd->kind.tag == DeclKind::Import && dd->kind.payload.Import.path != 0)\n            {\n                impPath = dd->kind.payload.Import.path;\n                impSymbols = dd->kind.payload.Import.symbols;\n                impSymbolsLen = dd->kind.payload.Import.symbolsLen;\n                impFlags = dd->kind.payload.Import.flags;\n                isImportLike = true;\n            }\n            else if (dd->kind.tag == DeclKind::ModReexport && dd->kind.payload.ModReexport.path != 0 && (dd->kind.payload.ModReexport.flags & 1) != 0)\n            {\n                impPath = dd->kind.payload.ModReexport.path;\n                impSymbols = dd->kind.payload.ModReexport.symbols;\n                impSymbolsLen = dd->kind.payload.ModReexport.symbolsLen;\n                impFlags = dd->kind.payload.ModReexport.flags;\n                isImportLike = true;\n            }\n            if (isImportLike)\n            {\n                /* route: `import` (lib) always; plain `use a::b` too: a\n                 * namespace path is a module use, resolved via the\n                 * module table / lib roots, not a sibling file. Bare\n                 * `use name` stays with libLoadSiblingImports. */\n                bool colonPath = false;\n                {\n                    InternEntry* cp = L->ctx->interns + impPath;\n                    usize cq = 0;\n                    while (cq < cp->len)\n                    {\n                        if (cp->ptr[cq] == 58) { colonPath = true; break; }\n                        cq++;\n                    }\n                }\n                bool hasGroups = false;\n                {\n                    u32 gi = 0;\n                    while (gi < impSymbolsLen)\n                    {\n                        Str gn = impSymbols[gi].name;\n                        if (gn != 0)\n                        {\n                            InternEntry* ge = L->ctx->interns + gn;\n                            usize gq = 0;\n                            while (gq + 1 < ge->len)\n                            {\n                                if (ge->ptr[gq] == 58 && ge->ptr[gq + 1] == 58) { hasGroups = true; break; }\n                                gq++;\n                            }\n                        }\n                        if (hasGroups) break;\n                        gi++;\n                    }\n                }\n                bool bareModule = false;\n                if ((impFlags & 1) == 0 && !colonPath && !hasGroups && f->path != 0)\n                {\n                    InternEntry* pe0 = L->ctx->interns + impPath;\n                    InternEntry* fe0 = L->ctx->interns + f->path;\n                    u8* dir0 = libDir(fe0->ptr);\n                    u8* sib0 = null;\n                    if (dir0 != null) sib0 = libCandidate(dir0, libLen(dir0), pe0->ptr, pe0->len, \".crl\");\n                    if (sib0 == null)\n                    {\n                        bareModule = true;\n                    }\n                    else\n                    {\n                        usize sl0 = 0;\n                        u8* sbuf0 = libRead(sib0, &sl0);\n                        if (sbuf0 == null) bareModule = true;\n                        else dealloc<u8>(sbuf0);\n                        dealloc<u8>(sib0);\n                    }\n                }\n                if ((impFlags & 1) == 0 && !colonPath && !hasGroups && !bareModule)\n                {\n                    i++;\n                    continue;\n                }\n                /* copy out before libResolve; parsing manifests grows the\n                 * intern table, invalidating InternEntry pointers */\n                InternEntry* ie = L->ctx->interns + impPath;\n                u8* nsPtr = ie->ptr;\n                usize nsLen = ie->len;\n                /* targets: the use path itself, plus `path::mod` for\n                 * every nested item group `mod::{ … }`; the submodule file\n                 * must be merged too, not just the directory manifest */\n                u32 symCount = impSymbolsLen;\n                usize compsSize = 0;\n                u32 groupCount = 0;\n                u32 si = 0;\n                while (si < symCount)\n                {\n                    Str nm = impSymbols[si].name;\n                    if (nm != 0)\n                    {\n                        InternEntry* se = L->ctx->interns + nm;\n                        usize lastCol = 0;\n                        usize q = 0;\n                        while (q + 1 < se->len)\n                        {\n                            if (se->ptr[q] == 58 && se->ptr[q + 1] == 58) lastCol = q;\n                            q++;\n                        }\n                        if (lastCol > 0 && lastCol + 2 < se->len)\n                        {\n                            groupCount++;\n                            compsSize += nsLen + 2 + lastCol;\n                        }\n                    }\n                    si++;\n                }\n                u8* comps = null;\n                u8** tPtrs = null;\n                usize* tLens = null;\n                u32 targets = 1;\n                if (groupCount > 0)\n                {\n                    comps = alloc<u8>(compsSize);\n                    tPtrs = alloc<u8*>((usize)1 + (usize)groupCount);\n                    tLens = alloc<usize>((usize)1 + (usize)groupCount);\n                    if (comps == null || tPtrs == null || tLens == null)\n                    {\n                        if (comps != null) dealloc<u8>(comps);\n                        if (tPtrs != null) dealloc<u8*>(tPtrs);\n                        if (tLens != null) dealloc<usize>(tLens);\n                        comps = null;\n                        tPtrs = null;\n                        tLens = null;\n                        L->errors++;\n                    }\n                    else\n                    {\n                        usize off = 0;\n                        si = 0;\n                        while (si < symCount)\n                        {\n                            Str nm = impSymbols[si].name;\n                            if (nm != 0)\n                            {\n                                InternEntry* se = L->ctx->interns + nm;\n                                usize lastCol = 0;\n                                usize q = 0;\n                                while (q + 1 < se->len)\n                                {\n                                    if (se->ptr[q] == 58 && se->ptr[q + 1] == 58) lastCol = q;\n                                    q++;\n                                }\n                                if (lastCol > 0 && lastCol + 2 < se->len)\n                                {\n                                    bool absolute = lastCol > nsLen + 1;\n                                    if (absolute)\n                                    {\n                                        usize c = 0;\n                                        while (c < nsLen)\n                                        {\n                                            if (se->ptr[c] != nsPtr[c]) { absolute = false; break; }\n                                            c++;\n                                        }\n                                        if (absolute && (se->ptr[nsLen] != 58 || se->ptr[nsLen + 1] != 58)) absolute = false;\n                                    }\n                                    u8* dst = comps + off;\n                                    usize d = 0;\n                                    if (absolute)\n                                    {\n                                        while (d < lastCol) { dst[d] = se->ptr[d]; d++; }\n                                        tPtrs[targets] = dst;\n                                        tLens[targets] = lastCol;\n                                        targets++;\n                                        off += lastCol;\n                                    }\n                                    else\n                                    {\n                                        while (d < nsLen) { dst[d] = nsPtr[d]; d++; }\n                                        dst[nsLen] = 58;\n                                        dst[nsLen + 1] = 58;\n                                        d = 0;\n                                        while (d < lastCol) { dst[nsLen + 2 + d] = se->ptr[d]; d++; }\n                                        tPtrs[targets] = dst;\n                                        tLens[targets] = nsLen + 2 + lastCol;\n                                        targets++;\n                                        off += nsLen + 2 + lastCol;\n                                    }\n                                }\n                            }\n                            si++;\n                        }\n                    }\n                }\n                u32 tCap = targets;\n                u8* tHard = null;\n                u8** tOwned = null;\n                if (tPtrs == null)\n                {\n                    tPtrs = alloc<u8*>(1);\n                    tLens = alloc<usize>(1);\n                    tHard = alloc<u8>(1);\n                    tOwned = alloc<u8*>(1);\n                    if (tPtrs == null || tLens == null || tHard == null || tOwned == null)\n                    {\n                        if (tPtrs != null) dealloc<u8*>(tPtrs);\n                        if (tLens != null) dealloc<usize>(tLens);\n                        if (tHard != null) dealloc<u8>(tHard);\n                        if (tOwned != null) dealloc<u8*>(tOwned);\n                        tPtrs = null;\n                        tLens = null;\n                        tHard = null;\n                        tOwned = null;\n                        L->errors++;\n                    }\n                    else tCap = 1;\n                }\n                if (tPtrs == null)\n                {\n                    if (comps != null) dealloc<u8>(comps);\n                     continue;\n                }\n                /* hard = missing file is an error; chased re-export\n                 * targets are soft (a dead re-export may not exist here) */\n                if (tHard == null || tOwned == null)\n                {\n                    u8* nh = alloc<u8>((usize)tCap);\n                    u8** no = alloc<u8*>((usize)tCap);\n                    if (nh != null && no != null)\n                    {\n                        tHard = nh;\n                        tOwned = no;\n                    }\n                    else\n                    {\n                        if (nh != null) dealloc<u8>(nh);\n                        if (no != null) dealloc<u8*>(no);\n                        dealloc<u8*>(tPtrs);\n                        dealloc<usize>(tLens);\n                        if (comps != null) dealloc<u8>(comps);\n                        tPtrs = null;\n                        continue;\n                    }\n                }\n                u32 zi = 0;\n                while (zi < tCap)\n                {\n                    tHard[zi] = 1;\n                    tOwned[zi] = null;\n                    zi++;\n                }\n                if (bareModule) tHard[0] = 0;\n                tPtrs[0] = nsPtr;\n                tLens[0] = nsLen;\n                u32 k = 0;\n                while (k < targets && tPtrs != null)\n                {\n                    u8* target = tPtrs[k];\n                    usize targetLen = tLens[k];\n                    u8* resolved = libResolve(L, target, targetLen);\n                    if (resolved == null)\n                    {\n                        if (tHard[k] != 0)\n                        {\n                            if ((impFlags & 1) != 0)\n                                errWrite(\"coralc: cannot resolve import: \");\n                            else\n                                errWrite(\"coralc: cannot resolve use: \");\n                            errWrite(str { .ptr = target, .len = targetLen });\n                            errWrite(\"\\n\");\n                            /* with a module table present, name the\n                             * likely cause: an unlisted module */\n                            if (L->modKeys != null && L->modLen > 0)\n                                errWrite(\"  note: not in the module table; check modules/aliases in the build file\\n\");\n                            L->errors++;\n                        }\n                    }\n                    else\n                    {\n                        if (getenv(C\"CORAL_TRACE_LOAD\") != null)\n                        {\n                            errWrite(\"coralc: load\");\n                            errWrite(str { .ptr = resolved, .len = libLen(resolved) });\n                            errWrite(\"\\n\");\n                        }\n                        if (libHas(L, resolved))\n                        {\n                            dealloc<u8>(resolved);\n                        }\n                        else if (!libPush(L, resolved))\n                        {\n                            L->errors++;\n                        }\n                        else\n                        {\n                            usize len = 0;\n                            u8* buf = libRead(resolved, &len);\n                            File* lf = null;\n                            if (buf != null)\n                            {\n                                u32 fid = 0;\n                                DiagnosticEngine* dg = L->diag;\n                                if (dg != null) fid = dg->addFile(resolved, libLen(resolved), buf, buf + len);\n                                if (L->bufsLen >= L->bufsCap)\n                                {\n                                    u32 newCap = L->bufsCap == 0 ? 8 : L->bufsCap * 2;\n                                    rawptr raw = realloc<u8*>(L->bufs, (usize)newCap);\n                                    if (raw != null) { L->bufs = (u8**)raw; L->bufsCap = newCap; }\n                                }\n                                if (L->bufsLen < L->bufsCap) L->bufs[L->bufsLen] = buf;\n                                else dealloc<u8>(buf);\n                                L->bufsLen++;\n                                lf = libParse(L, buf, len, resolved, dg, fid);\n                            }\n                            if (lf == null)\n                            {\n                                errWrite(\"coralc: cannot read import file\");\n                                errWrite(str { .ptr = resolved, .len = libLen(resolved) });\n                                errWrite(\"\\n\");\n                                L->errors++;\n                            }\n                            else\n                            {\n                                libLoadImports(L, lf);   // dependencies first\n\n                               /* directory-manifest re-exports: a path that\n                                * lands on <dir>/lib.crl must chase its\n                                * `pub mod X = import …` targets so members\n                                * resolve (std::math → math/lib.crl →\n                                * math/math.crl). A selective use chases\n                                * aliases matching its names or defining a\n                                * requested top-level decl; unqualified\n                                * imports chase every alias. Targets are soft. */\n                                Str* rxAliases = alloc<Str>((usize)lf->declsLen + 1);\n                                u8* rxWant = null;\n                                u32 rxCount = 0;\n                                if (rxAliases != null)\n                                {\n                                    u32 rx = 0;\n                                    while (rx < lf->declsLen)\n                                    {\n                                        Node* rn = L->ctx->nodes + lf->decls[rx].index;\n                                        if (rn->kind.tag == NodeKind::Decl)\n                                        {\n                                            Decl* rd = &rn->kind.payload.Decl.value;\n                                            if (rd->kind.tag == DeclKind::ModReexport)\n                                            {\n                                                rxAliases[rxCount] = rd->kind.payload.ModReexport.alias;\n                                                rxCount++;\n                                            }\n                                        }\n                                        rx++;\n                                    }\n                                }\n                                if (rxAliases != null && rxCount > 0)\n                                {\n                                    rxWant = alloc<u8>((usize)rxCount);\n                                    if (rxWant != null)\n                                    {\n                                        u32 a = 0;\n                                        while (a < rxCount)\n                                        {\n                                            rxWant[a] = 0;\n                                            if (symCount > 0)\n                                            {\n                                                u32 s2 = 0;\n                                                while (s2 < symCount)\n                                                {\n                                                    Str nm = impSymbols[s2].name;\n                                                    if (nm != 0)\n                                                    {\n                                                        if (nm == rxAliases[a]) rxWant[a] = 1;\n                                                        else\n                                                        {\n                                                            InternEntry* se2 = L->ct