               u32 d = 0;\n                while (d < mf->declsLen)\n                {\n                    Node* dn = L->ctx->nodes + mf->decls[d].index;\n                    if (dn->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* dd = &dn->kind.payload.Decl.value;\n                        if (dd->kind.tag == DeclKind::ModReexport && dd->kind.payload.ModReexport.path != 0)\n                        {\n                            InternEntry* entry = L->ctx->interns + dd->kind.payload.ModReexport.alias;\n                            if (libBytesEq(entry->ptr, entry->len, segs[1].ptr, (usize)segs[1].len))\n                            {\n                                InternEntry* target = L->ctx->interns + dd->kind.payload.ModReexport.path;\n                                u32 maxT = (u32)(target->len / 2) + 1;\n                                LibSeg* next = alloc<LibSeg>((usize)maxT + (usize)n);\n                                if (next != null)\n                                {\n                                    u32 got = libSplit(target->ptr, target->len, next, maxT);\n                                    u32 j = 2;\n                                    while (j < n)\n                                    {\n                                        next[got] = segs[j];\n                                        got++;\n                                        j++;\n                                    }\n                                    u8* r = libResolveSegs(L, next, got, sub, subLen, depth + 1);\n                                    dealloc<LibSeg>(next);\n                                    if (r != null)\n                                    {\n                                        dealloc<u8>(mpath);\n                                        return r;\n                                    }\n                                }\n                            }\n                        }\n                    }\n                    d++;\n