cl* decl, u32 argsLen, u8* slots)\n    {\n        if (decl == null || decl->kind.tag != DeclKind::Func || slots == null) return;\n        u32 gcount = decl->kind.payload.Func.genericParamsLen;\n        u32 next = 0;\n        u32 p = 0;\n        while (p < decl->kind.payload.Func.paramsLen && next < gcount)\n        {\n            Node* pn = self.ctx->nodes + decl->kind.payload.Func.params[p].index;\n            if (pn->kind.tag != NodeKind::Param) { p++; continue; }\n            Param* param = &pn->kind.payload.Param.value;\n            if ((param->flags & 16) != 0) break;\n            Ty base = param->typeNode;\n            TypeEntry* entry = null;\n            if (base != 0) entry = self.ctx->types + base;\n            while (entry != null && (entry->kind.tag == TypeKind::Const || entry->kind.tag == TypeKind::Comptime))\n            {\n                base = entry->kind.tag == TypeKind::Const ? entry->kind.payload.Const.base : entry->kind.payload.Comptime.base;\n                if (base == 0) { entry = null; break; }\n                entry = self.ctx->types + base;\n            }\n            u32 slot = gcount;\n            bool direct = false;\n            if (entry != null && (param->flags & 8) != 0 &&\n                (entry->kind.tag == TypeKind::TypeParam || entry->kind.tag == TypeKind::Named))\n            {\n                direct = true;\n                slot = next;\n                next++;\n            }\n            if (!direct && entry != null)\n            {\n                if (entry->kind.tag == TypeKind::TypeParam) slot = entry->kind.payload.TypeParam.index;\n                else if (entry->kind.tag == TypeKind::Named)\n                {\n                    Str tn = entry->kind.payload.Named.name;\n                    u32 gi = 0;\n                    while (gi < gcount)\n                    {\n                        Node* gpn = self.ctx->nodes + decl->kind.payload.Func.genericParams[gi].index;\n                        if (gpn->kind.tag == NodeKind::GenericParam &&\n                            gpn->kind.payload.GenericParam.value.name == tn) { slot = gi; break; }\n                        gi++;\n                    }\n                }\n            }\n            if (slot < gcount && p < argsLen) slots[slot] = 1;\n            p++;\n        }\n    }\n\n    bool genericArgParam(Decl* decl, Param* param)\n    {\n        if (decl == null || param == null) return false;\n        if (decl->kind.tag != DeclKind::Func) return false;\n        if (param->typeNode == 0) return false;\n        Ty base = param->typeNode;\n        TypeEntry* entry = self.ctx->types + base;\n        while (entry != null && entry->kind.tag == TypeKind::Const)\n        {\n            base = entry->kind.payload.Const.base;\n            if (base == 0) return false;\n            entry = self.ctx->types + base;\n        }\n        if (entry == null) return false;\n        if (entry->kind.tag == TypeKind::TypeParam) return true;\n        if (entry->kind.tag != TypeKind::Named) return false;\n        if ((param->flags & 8) != 0) return true;\n        Str name = entry->kind.payload.Named.name;\n        u32 i = 0;\n        while (i < decl->kind.payload.Func.genericParamsLen)\n        {\n            Node* genericNode = self.ctx->nodes + decl->kind.payload.Func.genericParams[i].index;\n            if (genericNode->kind.tag == NodeKind::GenericParam)\n            {\n                GenericParam* generic = &genericNode->kind.payload.GenericParam.value;\n                if (generic->name == name) return true;\n            }\n            i++;\n        }\n        return false;\n    }\n\n    // pull the generic param list out of any decl kind that can carry one;\n    // *outParams is borrowed from the AST, not a copy\n    u32 declGenericParams(Decl* decl, NodeId** outParams)\n    {\n        *outParams = null;\n        if (decl == null) return 0;\n        if (decl->kind.tag == DeclKind::Struct) {\n            *outParams = decl->kind.payload.Struct.genericParams;\n            return decl->kind.payload.Struct.genericParamsLen;\n        }\n        if (decl->kind.tag == DeclKind::Func) {\n            *outParams = decl->kind.payload.Func.genericParams;\n            return decl->kind.payload.Func.genericParamsLen;\n        }\n        if (decl->kind.tag == DeclKind::Variant) {\n            *outParams = decl->kind.payload.Variant.genericParams;\n            return decl->kind.payload.Variant.genericParamsLen;\n        }\n        if (decl->kind.tag == DeclKind::Union) {\n            *outParams = decl->kind.payload.Union.genericParams;\n            return decl->kind.payload.Union.genericParamsLen;\n        }\n        if (decl->kind.tag == DeclKind::Trait) {\n            *outParams = decl->kind.payload.Trait.genericParams;\n            return decl->kind.payload.Trait.genericParamsLen;\n        }\n        return 0;\n    }\n\n    Str structParamName(Ty objectType, u32 index)\n    {\n        if (objectType == 0) return 0;\n        TypeEntry* obj = self.ctx->types + objectType;\n        if (obj->kind.tag != TypeKind::Named) return 0;\n        Str name = obj->kind.payload.Named.name;\n        Decl* decl = null;\n        Symbol* symbol = self.lookupType(name, obj->loc);\n        if (symbol != null && symbol->declaration.index != 0)\n        {\n            Node* declNode = self.ctx->nodes + symbol->declaration.index;\n            if (declNode->kind.tag == NodeKind::Decl) decl = &declNode->kind.payload.Decl.value;\n        }\n        NodeId* generics = null;\n        u32 count = self.declGenericParams(decl, &generics);\n        if (generics == null || index >= count)\n        {\n            /* the plain scope lookup can bind a same-named non-generic\n             * declaration (libc's extern realloc shadows mman's realloc<T>);\n             * search all candidates for one with a generic param at index */\n            generics = null;\n            count = 0;\n            Symbol** cands = alloc<Symbol*>(16);\n            if (cands != null)\n            {\n                u32 n = self.scopes->lookupAll(name, cands, 16);\n                u32 m = 0;\n                while (m < n)\n                {\n                    if (cands[m]->declaration.index != 0)\n                    {\n                        Node* dn = self.ctx->nodes + cands[m]->declaration.index;\n                        if (dn->kind.tag == NodeKind::Decl)\n                        {\n                            NodeId* g2 = null;\n                            u32 c2 = self.declGenericParams(&dn->kind.payload.Decl.value, &g2);\n                            if (g2 != null && index < c2)\n                            {\n                                decl = &dn->kind.payload.Decl.value;\n                                generics = g2;\n                                count = c2;\n                                m = n;\n                                break;\n                            }\n                        }\n                    }\n                    m++;\n                }\n                dealloc<Symbol*>(cands);\n            }\n        }\n        if (generics == null || index >= count) return 0;\n        Node* genericNode = self.ctx->nodes + generics[index].index;\n        if (genericNode->kind.tag != NodeKind::GenericParam) return 0;\n        return genericNode->kind.payload.GenericParam.value.name;\n    }\n\n    /* Structural match where TypeParam entries in `pattern` act as wildcards.\n     * used to match an extend's self type (`Option<T>`) against a concrete\n     * receiver (`Option<f64>`) */\n    bool sameTypePattern(Ty pattern, Ty concrete)\n    {\n        if (pattern == concrete) return true;\n        if (pattern == 0 || concrete == 0) return false;\n        TypeEntry* a = self.ctx->types + pattern;\n        TypeEntry* b = self.ctx->types + concrete;\n        if (a->kind.tag == TypeKind::TypeParam) return true;\n        if (a->kind.tag != b->kind.tag) return false;\n        switch (a->kind.tag)\n        {\n            TypeKind::Named => {\n                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;\n                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;\n                u32 i = 0;\n                while (i < a->kind.payload.Named.genericArgsLen)\n                {\n                    if (!self.sameTypePattern(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            TypeKind::Pointer => { return self.sameTypePattern(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },\n            TypeKind::Const => { return self.sameTypePattern(a->kind.payload.Const.base, b->kind.payload.Const.base); },\n            TypeKind::Comptime => { return self.sameTypePattern(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },\n            TypeKind::Slice => { return self.sameTypePattern(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },\n            TypeKind::Array => {\n                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;\n                if (a->kind.payload.Array.sizeParam != b->kind.payload.Array.sizeParam) return false;\n                return self.sameTypePattern(a->kind.payload.Array.base, b->kind.payload.Array.base);\n            },\n            TypeKind::FnPtr => {\n                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;\n                if (!self.sameTypePattern(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;\n                u32 i = 0;\n                while (i < a->kind.payload.FnPtr.paramsLen) {\n                    if (!self.sameTypePattern(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            TypeKi