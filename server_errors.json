 NodeId* genericParams, u32 genericParamsLen)\n    {\n        if (genericParamsLen == 0) return self.namedType(name);\n        TypeKind kind;\n        Ty* args = null;\n        if (genericParamsLen > 0) args = alloc<Ty>((usize)genericParamsLen);\n        u32 i = 0;\n        while (i < genericParamsLen)\n        {\n            Node* gn = self.ctx->nodes + genericParams[i].index;\n            Str pname = 0;\n            if (gn->kind.tag == NodeKind::GenericParam) pname = gn->kind.payload.GenericParam.value.name;\n            args[i] = self.typeParamType(pname, i);\n            i++;\n        }\n        kind = TypeKind::Named { .name = name, .genericArgs = args, .genericArgsLen = genericParamsLen };\n        return self.allocType(kind);\n    }\n\n    /* dedup is by bare name: the first Named entry with this name wins even\n     * if it carries generic args; callers that want Vec<i32> build the args\n     * themselves (selfNamedType / the parser). */\n    Ty namedType(Str name)\n    {\n        /* `str` is a builtin; `str::…` static calls route here via the\n         * type-static arm of checkCall, so it must map to the singleton */\n        if (name == self.ctx->tyIdxStrLit()) return self.strType();\n        Ty t = self.ctx->tyIdxFindNamed(name, false);\n        if (t != 0) return t;\n        u32 i = 1;\n        while (i < self.ctx->typesLen) {\n            TypeEntry* entry = self.ctx->types + i;\n            if (entry->kind.tag == TypeKind::Named && entry->kind.payload.Named.name == name) {\n                TypeKind q;\n                q.tag = TypeKind::Named;\n                q.payload.Named.name = name;\n                q.payload.Named.genericArgs = null;\n                q.payload.Named.genericArgsLen = 0;\n                self.ctx->tyIdxInsert(q, i);\n                return i;\n            }\n            i++;\n        }\n        TypeKind kind = TypeKind::Named { .name = name, .genericArgs = null, .genericArgsLen = 0 };\n        t = self.allocType(kind);\n        if (t != 0) self.ctx->tyIdxInsert(kind, t);\n        return t;\n    }\n\n    // index = the param's position in the generic list; substitution uses it\n    // to find which generic arg replaces this `T`\n    Ty typeParamType(Str name, u32 index)\n    {\n        TypeKind kind = TypeKind::TypeParam { .name = name, .index = index };\n        return self.allocType(kind);\n    }\n\n    void setExprType(NodeId id, Ty typeNode)\n    {\n        if (id.index == 0) return;\n        Node* node = self.ctx->nodes + id.index;\n        if (node->kind.tag == NodeKind::Expr)\n            node->kind.payload.Expr.value.resolvedType = typeNode;\n    }\n\n    Ty exprType(NodeId id)\n    {\n        if (id.index == 0) return 0;\n        Node* node = self.ctx->nodes + id.index;\n        if (node->kind.tag != NodeKind::Expr) return 0;\n        return node->kind.payload.Expr.value.resolvedType;\n    }\n\n    /* structural equality. tag must match, then shape: Named compares names\n     * and args, pointers/const/slice/etc recurse. primitive tags fall into\n     * the else and are equal by tag alone. */\n    bool sameType(Ty left, Ty right)\n    {\n        if (left == right) return true;\n        if (left == 0 || right == 0) return false;\n        TypeEntry* a = self.ctx->types + left;\n        TypeEntry* b = self.ctx->types + right;\n        /* During generic checking a type param may appear on one side and its\n         * unparameterised Named placeholder (pre-binding parse form) on the\n         * other; they denote the same type when the names match. */\n        if (a->kind.tag == TypeKind::TypeParam && b->kind.tag == TypeKind::Named && b->kind.payload.Named.genericArgsLen == 0 &&\n            a->kind.payload.TypeParam.name == b->kind.payload.Named.name) return true;\n        if (b->kind.tag == TypeKind::TypeParam && a->kind.tag == TypeKind::Named && a->kind.payload.Named.genericArgsLen == 0 &&\n            b->kind.payload.TypeParam.name == a->kind.payload.Named.name) return true;\n        if (a->kind.tag != b->kind.tag) return false;\n        switch (a->kind.tag)\n        {\n            TypeKind::Named => {\n                if (a->kind.payload.Named.name != b->kind.payload.Named.name) return false;\n                if (a->kind.payload.Named.genericArgsLen != b->kind.payload.Named.genericArgsLen) return false;\n                u32 i = 0;\n                while (i < a->kind.payload.Named.genericArgsLen)\n                {\n                    if (!self.sameType(a->kind.payload.Named.genericArgs[i], b->kind.payload.Named.genericArgs[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            \n            TypeKind::Pointer => { return self.sameType(a->kind.payload.Pointer.base, b->kind.payload.Pointer.base); },\n            TypeKind::Const => { return self.sameType(a->kind.payload.Const.base, b->kind.payload.Const.base); },\n            TypeKind::Comptime => { return self.sameType(a->kind.payload.Comptime.base, b->kind.payload.Comptime.base); },\n            TypeKind::Slice => { return self.sameType(a->kind.payload.Slice.base, b->kind.payload.Slice.base); },\n\n            TypeKind::Array => {\n                if (a->kind.payload.Array.len != b->kind.payload.Array.len) return false;\n                if (a->kind.payload.Array.sizeParam != b->kind.payload.Array.sizeParam) return false;\n                if (a->kind.payload.Array.sizeName != b->kind.payload.Array.sizeName) return false;\n                return self.sameType(a->kind.payload.Array.base, b->kind.payload.Array.base);\n            },\n            \n            TypeKind::FnPtr => {\n                if (a->kind.payload.FnPtr.paramsLen != b->kind.payload.FnPtr.paramsLen) return false;\n                if (!self.sameType(a->kind.payload.FnPtr.returnType, b->kind.payload.FnPtr.returnType)) return false;\n                u32 i = 0;\n                while (i < a->kind.payload.FnPtr.paramsLen) {\n                    if (!self.sameType(a->kind.payload.FnPtr.params[i], b->kind.payload.FnPtr.params[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n\n            TypeKind::Tuple => {\n                if (a->kind.payload.Tuple.elemsLen != b->kind.payload.Tuple.elemsLen) return false;\n                u32 i = 0;\n                while (i < a->kind.payload.Tuple.elemsLen) {\n                    if (!self.sameType(a->kind.payload.Tuple.elems[i], b->kind.payload.Tuple.elems[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            \n            TypeKind::TypeParam => { return a->kind.payload.TypeParam.name == b->kind.payload.TypeParam.name; },\n            /* comptime value args are equal only when the values match:\n             * `Arr<i32, 4>` and `Arr<i32, 9>` are different instances */\n            TypeKind::ValueInt => { return a->kind.payload.ValueInt.value == b->kind.payload.ValueInt.value; },\n            else => { return true; }\n        }\n    }\n\n    /* typedefs (Str = u32, Ty = u32, ...) are transparent for scalar\n     * compatibility; they lower to their C base types */\n    Ty resolveScalarAlias(Ty t)\n    {\n        u32 guard = 0; // alias cycles (A = B; B = A) must not spin forever\n        while (t != 0 && guard < 32)\n        {\n            guard++;\n            TypeEntry* entry = self.ctx->types + t;\n            if (entry->kind.tag == TypeKind::Const || entry->kind.tag == TypeKind::Comptime)\n            {\n                if (entry->kind.tag == TypeKind::Const) t = entry->kind.payload.Const.base;\n                else t = entry->kind.payload.Comptime.base;\n                continue;\n            }\n            if (entry->kind.tag != TypeKind::Named) return t;\n            if (entry->kind.payload.Named.genericArgsLen != 0) return t;\n            Symbol* symbol = self.lookupType(entry->kind.payload.Named.name, entry->loc);\n            if (symbol == null || symbol->declaration.index == 0) return t;\n            Node* declNode = self.ctx->nodes + symbol->declaration.index;\n            if (declNode->kind.tag != NodeKind::Decl) return t;\n            Decl* decl = &declNode->kind.payload.Decl.value;\n            if (decl->kind.tag == DeclKind::TypeAlias)\n            {\n                if (decl->kind.payload.TypeAlias.target == 0) return t;\n                t = decl->kind.payload.TypeAlias.target;\n                continue;\n            }\n            if (decl->kind.tag == DeclKind::Distinct)\n            {\n                if (decl->kind.payload.Distinct.baseType == 0) return t;\n                t = decl->kind.payload.Distinct.baseType;\n                continue;\n            }\n            return t;\n        }\n        return t;\n    }\n\n    u32 intWidth(Ty t)\n    {\n        if (t == 0) return 0;\n        t = self.resolveScalarAlias(t);\n        TypeEntry* entry = self.ctx->types + t;\n        switch (entry->kind.tag)\n        {\n            TypeKind::U8, TypeKind::I8 => { return 8; },\n            /* char is a UTF-32 codepoint (u32 width), never a byte;\n             * bytes are u8/cchar */\n            TypeKind::Char => { return 32; },\n            TypeKind::U16, TypeKind::I16 => { return 16; },\n            TypeKind::U32, TypeKind::I32 => { return 32; },\n            TypeKind::U64, TypeKind::I64, TypeKind::Usize, TypeKind::Isize => { return 64; },\n            TypeKind::U128, TypeKind::I128 => { return 128; },\n            else => { return 0; },\n        }\n    }\n\n    bool intSigned(Ty t)\n    {\n        if (t == 0) return false;\n        t = self.resolveScalarAlias(t);\n        TypeEntry* entry = self.ctx->types + t;\n        switch (entry->kind.tag)\n        {\n            TypeKind::I8, TypeKind::I16, TypeKind::I32, TypeKind::I64, TypeKind::Isize, TypeKind::I128 => { return true; },\n            else => { return false; },\n        }\n    }\n\n    /* T0010: a literal being stored into a narrower integer type must fit\n     * (u8 x = 300 is an error even though the generic-literal rules widen\n     * it for arithmetic). Only the plainly-written shapes are checked:\n     * `N` and `-N`. */\n    void checkIntLitFit(NodeId initId, Ty declared)\n    {\n        if (initId.index == 0 || declared == 0) return;\n        u32 w = self.intWidth(declared);\n        if (w == 0 || w >= 64) return;\n        bool signed = self.intSigned(declared);\n        Node* n = self.ctx->nodes + initId.index;\n        if (n->kind.tag != NodeKind::Expr) return;\n        Expr* e = &n->kind.payload.Expr.value;\n        u64 mag = 0;\n        bool neg = false;\n        if (e->kind.tag == ExprKind::IntLit) mag = e->kind.payload.IntLit.value;\n        else if (e->kind.tag == ExprKind::Neg)\n        {\n            neg = true;\n            NodeId inner = e->kind.payload.Neg.expr;\n            if (inner.index == 0) return;\n            Node* in = self.ctx->nodes + inner.index;\n            if (in->kind.tag != NodeKind::Expr) return;\n            Expr* ie = &in->kind.payload.Expr.value;\n            if (ie->kind.tag != ExprKind::IntLit) return;\n            mag = ie->kind.payload.IntLit.value;\n        }\n        else return;\n        bool overflow = false;\n        if (!signed)\n        {\n            if (neg) overflow = true;\n            else if (mag >= (((u64)1) << (u64)w)) overflow = true;\n        }\n        else\n        {\n            u64 limit = ((u64)1) << (u64)(w - 1);\n            if (neg) { if (mag > limit) overflow = true; }\n            else { if (mag >= limit) overflow = true; }\n        }\n        if (!overflow) return;\n        String msg = String::new();\n        if (neg) msg.pushView(\"integer literal '-\");\n        else msg.pushView(\"integer literal '\");\n        self.pushDec(&msg, mag);\n        msg.pushView(\"' does not fit in the declared integer type\");\n        self.semaErrorNode(ErrorCode::SemaLiteralOverflow, initId, msg.asView());\n    }\n\n    bool integerType(Ty typeNode)\n    {\n        if (typeNode == 0) return false;\n        typeNode = self.resolveScalarAlias(typeNode);\n        TypeEntry* entry = self.ctx->types + typeNode;\n        if (entry->kind.tag == TypeKind::U8 || entry->kind.tag == TypeKind::U16 || entry->kind.tag == TypeKind::U32 || entry->kind.tag == TypeKind::U64 || entry->kind.tag == TypeKind::U128 || entry->kind.tag == TypeKind::I8 || entry->kind.tag == TypeKind::I16 || entry->kind.tag == TypeKind::I32 || entry->kind.tag == TypeKind::I64 || entry->kind.tag == TypeKind::I128 || entry->kind.tag == TypeKind::Usize || entry->kind.tag == TypeKind::Isize || entry->kind.tag == TypeKind::Char) return true;\n        /* `cchar` is the C ABI byte type (Named); it participates in integer\n         * expressions (`*endptr != 0`) the way u8/i8 do */\n        if (entry->kind.tag == TypeKind::Named && entry->kind.payload.Named.genericArgsLen == 0 &&\n            self.ctx->internEqHashLen(entry->kind.payload.Named.name, 0xEF122686, 5) /* FNV(\"cchar\") */) return true;\n        /* a generic parameter used in value position is a comptime integer\n         * (`Arr<T, N>`: `self.data[N - 1]`, `return N`); pure type params\n         * never reach value position in valid code */\n        if (entry->kind.tag == TypeKind::TypeParam) return true;\n        return false;\n    }\n\n    bool floatType(Ty typeNode)\n    {\n        if (typeNode == 0) return false;\n        typeNode = self.resolveScalarAlias(typeNode);\n        TypeEntry* entry = self.ctx->types + typeNode;\n        return entry->kind.tag == TypeKind::F32 || entry->kind.tag == TypeKind::F64;\n    }\n\n    u32 genericCount(NodeId id)\n    {\n        if (id.index == 0) return 0;\n        Node* node = self.ctx->nodes + id.index;\n        if (node->kind.tag != NodeKind::Decl) return 0;\n        Decl* decl = &node->kind.payload.Decl.value;\n        switch (decl->kind.tag)\n        {\n            DeclKind::Func => { return decl->kind.payload.Func.genericParamsLen; },\n            DeclKind::Struct => { return decl->kind.payload.Struct.genericParamsLen; },\n            DeclKind::Variant => { return decl->kind.payload.Variant.genericParamsLen; },\n            DeclKind::Union => { return decl->kind.payload.Union.genericParamsLen; },\n            DeclKind::Trait => { return decl->kind.payload.Trait.genericParamsLen; },\n            DeclKind::Extend => { return decl->kind.payload.Extend.genericParamsLen; },\n            DeclKind::ExtendTrait => { return decl->kind.payload.ExtendTrait.genericParamsLen; },\n            else => { return 0; }\n        }\n    }\n\n    bool checkType(Ty typeNode)\n    {\n        if (typeNode == 0) return true;\n        TypeEntry* entry = self.ctx->types + typeNode;\n        switch (entry->kind.tag)\n        {\n            TypeKind::Named => {\n                Str tn = entry->kind.payload.Named.name;\n                Symbol* symbol = self.lookupType(tn, entry->loc);\n                if (symbol == null) {\n                    self.semaError(ErrorCode::SemaUndeclaredIdent, entry->loc, self.nameMsg(\"unknown type name: \", tn));\n                    return false;\n                }\n                /* a value in type position (`a { 4 }` where `a` is a\n                 * local) is not a type, even though lookup finds it. A\n                 * function name is a valid *generic callee* spelling\n                 * (`copy<rawptr>(...)`), so it passes when it carries\n                 * explicit generic arguments. */\n                /* modules pass too: `cchar::cchar` parses as Named(\"cchar\")\n                 * and lookup finds the imported module namespace there */\n                if (symbol->kind != 3 && symbol->kind != 4 && symbol->kind != 5 &&\n                    !(symbol->kind == 2 && entry->kind.payload.Named.genericArgsLen > 0)) {\n                    self.semaError(ErrorCode::SemaTypeMismatch, entry->loc,\n                        self.nameMsgS(\"`\", tn, \"` is not a type\"));\n                    return false;\n                }\n                u32 want = entry->kind.payload.Named.genericArgsLen;\n                u32 expected = self.genericCount(symbol->declaration);\n                if (expected != want)\n                {\n                    /* merged files may declare the same name (libc's extern\n                     * realloc vs mman's realloc<T>); prefer a decl whose\n                     * generic arity matches the explicit arguments */\n                    Symbol** cands = alloc<Symbol*>(16);\n                    if (cands != null)\n                    {\n                        u32 n = self.scopes->lookupAll(tn, cands, 16);\n                        u32 a = 0;\n                        while (a < n)\n                        {\n                            if (self.genericCount(cands[a]->declaration) == want)\n                            {\n                                symbol = cands[a];\n                                break;\n                            }\n                            a++;\n                        }\n                        dealloc<Symbol*>(cands);\n                    }\n                    expected = self.genericCount(symbol->declaration);\n                }\n                if (expected != want) {\n                    String msg = String::new();\n                    msg.pushView(\"type '\");\n                    msg.pushView(self.nameTextView(tn));\n                    msg.pushView(\"': wrong number of generic arguments, expected \");\n                    self.pushDec(&msg, (u64)expected);\n                    msg.pushView(\", got \");\n                    self.pushDec(&msg, (u64)want);\n                    self.semaError(ErrorCode::SemaArityMismatch, entry->loc, msg.asView());\n                    return false;\n                }\n                u32 i = 0;\n                while (i < entry->kind.payload.Named.genericArgsLen) {\n                    if (!self.checkType(entry->kind.payload.Named.genericArgs[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            \n            TypeKind::ValueInt => { return true; },\n            TypeKind::Pointer => { return self.checkType(entry->kind.payload.Pointer.base); },\n            TypeKind::Const => { return self.checkType(entry->kind.payload.Const.base); },\n            TypeKind::Comptime => { return self.checkType(entry->kind.payload.Comptime.base); },\n            TypeKind::Slice => { return self.checkType(entry->kind.payload.Slice.base); },\n            TypeKind::Array => {\n                if (entry->kind.payload.Array.sizeName != 0 && entry->kind.payload.Array.sizeParam == 4294967295)\n                {\n                    self.semaError(ErrorCode::SemaNonConstArraySize, entry->loc,\n                        self.nameMsg(\"array size is not a compile-time constant: \", entry->kind.payload.Array.sizeName));\n                    return false;\n                }\n                return self.checkType(entry->kind.payload.Array.base);\n            },\n            \n            TypeKind::FnPtr => {\n                if (!self.checkType(entry->kind.payload.FnPtr.returnType)) return false;\n                u32 i = 0;\n                while (i < entry->kind.payload.FnPtr.paramsLen) {\n                    if (!self.checkType(entry->kind.payload.FnPtr.params[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            \n            TypeKind::Tuple => {\n                u32 i = 0;\n                while (i < entry->kind.payload.Tuple.elemsLen) {\n                    if (!self.checkType(entry->kind.payload.Tuple.elems[i])) return false;\n                    i++;\n                }\n                return true;\n            },\n            else => { return true; }\n        }\n    }\n\n    /* does `t` mention a type parameter anywhere? a bare `T` parsed as Named\n     * still counts via the kind-4 symbol check below. two dependent types\n     * are not interchangeable;