          }\n                Ty baseTy = cgTyUnwrap(cg, iterTy);\n                iterIsPtr = baseTy != 0 && (cg->ctx->types + baseTy)->kind.tag == TypeKind::Pointer;\n                if (iterIsPtr) baseTy = cgTyUnwrap(cg, (cg->ctx->types + baseTy)->kind.payload.Pointer.base);\n                if (baseTy == 0) { cgError(cg, \"for-in over unknown iterator type\"); return; }\n\n                if (!simpleIter)\n                {\n                    usize ps = cg->tybuf.len;\n                    tyStr(cg, baseTy);\n                    stCh(&cg->tybuf, '*');\n                    Slice ptrTy = stTail(&cg->tybuf, ps);\n                    rt = cgNewTemp(cg, ptrTy, 0);\n                    if (iterIsPtr) {\n                        stNL(&cg->body, cg->ind);\n                        stPS(&cg->body, cgTempName(cg, rt));\n                        stP(&cg->body, \" = (\");\n                        stPS(&cg->body, ptrTy);\n                        stP(&cg->body, \")\");\n                        stPS(&cg->body, it);\n                        stCh(&cg->body, ';');\n                    } else {\n                        /* Materialize the iterable before assigning its address:\n                         * cgAddrOfValue emits its own temp assignment, and that\n                         * statement must finish before this `recv = &temp;`. */\n                        Slice ptrExpr = cgAddrOfValue(cg, iter, it);\n                        stNL(&cg->body, cg->ind);\n                        stPS(&cg->body, cgTempName(cg, rt));\n                        stP(&cg->body, \" = \");\n                        stPS(&cg->body, ptrExpr);\n                        stCh(&cg->body, ';');\n                    }\n                }\n\n                if (ranged)\n                {\n                    rangeLabel = cgLabel(cg);\n                    stNL(&cg->body, cg->ind);\n                    stP(&cg->body, \"size_t coral_rs\");\n                    stU64(&cg->body, (u64)rangeLabel);\n                    stP(&cg