lain Ident */\n    /* report the first non-ASCII lookalike codepoint of one identifier */\n    void reportHomoglyph(u8* cpStart, u32 cp, bool* reported)\n    {\n        if (reported[0]) return;\n        u32 mimic = homoglyphAscii(cp);\n        if (mimic == 0) return;\n        reported[0] = true;\n        u8[96] mbuf;\n        usize mn = 0;\n        mn = putBytes(mbuf, mn, \"identifier contains a non-ASCII lookalike character (U+\");\n        mn = putHex4(mbuf, mn, cp);\n        mn = putBytes(mbuf, mn, \") that mimics ASCII '\");\n        mbuf[mn] = (u8)mimic;\n        mn += 1;\n        mn = putBytes(mbuf, mn, \"' (U+\");\n        mn = putHex4(mbuf, mn, mimic);\n        mn = putBytes(mbuf, mn, \")\");\n        self.reportErrorCode(ErrorCode::LexHomoglyph, self.bufStart, self.bufEnd, cpStart,\n                             str { .ptr = mbuf, .len = mn });\n    }\n\n    Token lexIdentifier(u8* start)\n    {\n        bool reported = false;\n        /* the dispatcher already consumed the first byte: check it too\n         * (a Cyrillic `а` can START an identifier) */\n        {\n            usize len0 = 0;\n            u32 cp0 = decodeUtf8(start, self.bufEnd, &len0);\n            if (len0 > 0 && cp0 >= 128) self.reportHomoglyph(start, cp0, &reported);\n        }\n        while (!self.isAtEnd())\n        {\n            usize len;\n            u8* cpStart = self.cur;\n            u32 cp = decodeUtf8(self.cur, self.bufEnd, &len);\n            if (len == 0 || !isXidContinue(cp)) break;\n            if (cp >= 128) self.reportHomoglyph(cpStart, cp, &reported);\n            self.cur += len;\n        }\n        usize len = (usize)(self.cur - start);\n        \n        if (self.idents == null) {\n            Token t = self.makeToken(TokenKind::Ident, start);\n            return t;\n        }\n        \n        IdentifierInfo* ii = self.idents->get(str { .ptr = start, .len = len });\n        if (ii == null)\n            return self.makeToken(TokenKind::Ident, start);\n        Token t = self.makeToken(ii->kind, start);\n        t.info = ii;\n        return t;\n    }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-build/arena.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\nimport std::mman { alloc, dealloc };\n\npub struct ArenaBlock\n{\n    u8* data;\n    usize size;\n    usize used;\n    ArenaBlock* next;\n}\n\npub ArenaBlock* arenaNewBlock(usize size)\n{\n    ArenaBlock* b = alloc<ArenaBlock>(1);\n    if (b == null) return null;\n    b->data = alloc<u8>(size);\n    b->size = size;\n    b->used = 0;\n    b->next = null;\n    if (b->data == null)\n    {\n        dealloc<ArenaBlock>(b);\n        return null;\n    }\n    return b;\n}\n\npub struct Arena\n{\n    ArenaBlock* head;\n    usize blockSize;\n}\n\nextend Arena\n{\n    void init(usize size)\n    {\n        if (size < 64) size = 64;\n        self.blockSize = size;\n        self.head = arenaNewBlock(size);\n    }\n\n    rawptr alloc(usize size, usize align)\n    {\n        if (align == 0) align = 1;\n        if (self.head == null) self.head = arenaNewBlock(self.blockSize);\n        ArenaBlock* b = self.head;\n        if (b == null) return null;\n        usize used = (b->used + align - 1) & ~(align - 1);\n        if (used + size > b->size)\n        {\n            usize newSize = self.blockSize;\n            if (size + align + align > newSize) newSize = size + align + align;\n            ArenaBlock* nb = arenaNewBlock(newSize);\n            if (nb == null) return null;\n            nb->next = b;\n            self.head = nb;\n            b = nb;\n            used = 0;\n        }\n        rawptr ptr = (rawptr)((usize)(b->data) + used);\n        b->used = used + size;\n        return ptr;\n    }\n\n    void freeAll()\n    {\n        ArenaBlock* b = self.head;\n        while (b != null)\n        {\n            ArenaBlock* nxt = b->next;\n            dealloc<u8>(b->data);\n            dealloc<ArenaBlock>(b);\n            b = nxt;\n        }\n        self.head = arenaNewBlock(self.blockSize);\n    }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-mono/mono.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* mono/mono.crl: monomorphization state and type substitution.\n *\n * MonoContext owns the three tables this pass builds: declarations that\n * mention generics, pending work items (collect enqueues, instantiate\n * drains), and the concrete instances themselves. Substitution walks\n * types recursively and interns a FRESH node for every composite it\n * touches: see typeDigest for why hashes must never compare those Ty\n * indices across phases. */\n\nuse ast::id { Str, NodeId, SourceLoc };\nuse ast::types { Ty, TypeEntry, TypeKind };\nuse ast::node { Node, NodeKind };\nuse ast::decl { File, Decl, DeclKind, GenericParam, Param, Field, Attribute, VariantVariant };\nuse ast::expr { Expr, ExprKind };\nuse ast::stmt { Stmt, StmtKind, SwitchCase };\nuse ast::pat { Pat, PatKind };\nuse context::context { AstContext };\nuse sem::sema { Sema };\nuse sem::typecheck;\n\nimport std::mman { alloc, dealloc, realloc };\n\npub enum MonoDeclKind\n{\n    TypeDecl,\n    FunctionDecl\n}\n\npub enum MonoInstanceKind\n{\n    TypeInstance,\n    FunctionInstance\n}\n\npub struct MonoDecl\n{\n    MonoDeclKind kind;\n    Str name;\n    NodeId declaration;\n}\n\n/* one generic param → concrete type. `index` is the slot for bare `T`\n * params, `parameter` the name for explicit `<T>` lists: lookups match\n * whichever the type site can provide. */\npub struct MonoSubstitution\n{\n    Str parameter;\n    u32 index;\n    NodeId declaration;\n    Ty typeNode;\n}\n\npub struct MonoInstance\n{\n    MonoInstanceKind kind;\n    Str name;\n    NodeId declaration;\n    NodeId callSite;\n    Ty typeNode;\n    Ty returnType;\n    Ty* paramTypes;\n    u32 paramTypesLen;\n    Ty* arguments;\n    u32 argumentsLen;\n    MonoSubstitution* substitutions;\n    u32 substitutionsLen;\n    NodeId body;\n    Attribute* attributes;\n    u32 attributesLen;\n    u8 validationAttempted;\n    u8 validated;\n    /* Zig-style value specialization: instances of the same declaration\n     * with the same type arguments but different comptime-visible call\n     * values (literal formats, argument arity) are distinct instances */\n    u64 valueKey;\n    u32 packArity;\n    Str* literalNames;\n    NodeId* literalNodes;\n    u32 literalsLen;\n    /* trailing variadic call args: their concrete types + original arg\n     * nodes (literal tails fold during evalComptimeBody, runtime tails\n     * become named C parameters `_varg0`, `_varg1`, … whose names are\n     * synthesized during eval and stored in tailArgNames) */\n    Ty* tailTypes;\n    NodeId* tailNodes;\n    Str* tailArgNames;\n    u32 tailLen;\n}\n\n/* a queued instantiation. Its argument/substitution/literal/tail\n * arrays are alloc'd copies made by the enqueuer; clear() frees them\n * per item. */\npub struct MonoWorkItem\n{\n    MonoDeclKind kind;\n    NodeId declaration;\n    NodeId callSite;\n    Ty* arguments;\n    u32 argumentsLen;\n    MonoSubstitution* inherited;\n    u32 inheritedLen;\n    u64 valueKey;\n    u32 packArity;\n    Str* literalNames;\n    NodeId* literalNodes;\n    u32 literalsLen;\n    Ty* tailTypes;\n    NodeId* tailNodes;\n    u32 tailLen;\n}\n\npub struct MonoContext\n{\n    AstContext* ast;\n    Sema* sema;\n    File* file;\n    MonoDecl* declarations;\n    u32 declarationsLen;\n    u32 declarationsCap;\n    MonoWorkItem* work;\n    u32 workLen;\n    u32 workCap;\n    MonoInstance* instances;\n    u32 instancesLen;\n    u32 instancesCap;\n    u32 errors;\n    /* substitutions of the instance whose body is currently being\n     * re-collected; generic calls inside instance bodies enqueue with\n     * these applied so `alloc<T>` inside Vec<str> yields alloc<str> */\n    MonoSubstitution* activeSubs;\n    u32 activeSubsLen;\n    /* depth of recursive collectStmt calls inside `comptime` blocks:\n     * generic calls there are inlined by the evaluator and must not be\n     * instantiated as runtime functions */\n    u32 comptimeCollect;\n    /* top-level non-generic functions with a top-level comptime block:\n     * they never get an instance, so their blocks are evaluated after\n     * the work list drains, once per recorded call site (callSite 0\n     * means \"uncalled\", used when no call site was recorded) */\n    NodeId* staticCtDecls;\n    NodeId* staticCtCalls;\n    u32 staticCtLen;\n    u32 staticCtCap;\n}\n\npub extend MonoContext\n{\n    void init(AstContext* ast, Sema* sema)\n    {\n        self.ast = ast;\n        self.sema = sema;\n        self.file = null;\n        self.declarations = null;\n        self.declarationsLen = 0;\n        self.declarationsCap = 0;\n        self.work = null;\n        self.workLen = 0;\n        self.workCap = 0;\n        self.instances = null;\n        self.instancesLen = 0;\n        self.instancesCap = 0;\n        self.errors = 0;\n        self.activeSubs = null;\n        self.activeSubsLen = 0;\n        self.comptimeCollect = 0;\n        self.staticCtDecls = null;\n        self.staticCtCalls = null;\n        self.staticCtLen = 0;\n        self.staticCtCap = 0;\n        /* no ast = nothing to mono; surface it as an error so callers bail */\n        if (ast == null) self.errors = 1;\n    }\n\n    /* drops every alloc<T> array this context owns. None of it is\n     * arena-backed, so each array goes back through the matching\n     * dealloc<T> below. */\n    void clear()\n    {\n        u32 i = 0;\n        while (i < self.workLen)\n        {\n            if (self.work[i].arguments != null) dealloc<Ty>(self.work[i].arguments);\n            if (self.work[i].inherited != null) dealloc<MonoSubstitution>(self.work[i].inherited);\n            if (self.work[i].literalNames != null) dealloc<Str>(self.work[i].literalNames);\n            if (self.work[i].literalNodes != null) dealloc<NodeId>(self.work[i].literalNodes);\n            if (self.work[i].tailTypes != null) dealloc<Ty>(self.work[i].tailTypes);\n            if (self.work[i].tailNodes != null) dealloc<NodeId>(self.work[i].tailNodes);\n            i++;\n        }\n        if (self.work != null) dealloc<MonoWorkItem>(self.work);\n        i = 0;\n        while (i < self.instancesLen)\n        {\n            if (self.instances[i].arguments != null) dealloc<Ty>(self.instances[i].arguments);\n             if (self.instances[i].paramTypes != null) dealloc<Ty>(self.instances[i].paramTypes);\n             if (self.instances[i].substitutions != null) dealloc<MonoSubstitution>(self.instances[i].substitutions);\n            if (self.instances[i].literalNames != null) dealloc<Str>(self.instances[i].literalNames);\n            if (self.instances[i].literalNodes != null) dealloc<NodeId>(self.instances[i].literalNodes);\n            if (self.instances[i].tailTypes != null) dealloc<Ty>(self.instances[i].tailTypes);\n            if (self.instances[i].tailNodes != null) dealloc<NodeId>(self.instances[i].tailNodes);\n            if (self.instances[i].tailArgNames != null) dealloc<Str>(self.instances[i].tailArgNames);\n            i++;\n        }\n        if (self.instances != null) dealloc<MonoInstance>(self.instances);\n        if (self.declarations != null) dealloc<MonoDecl>(self.declarations);\n        if (self.staticCtDecls != null) dealloc<NodeId>(self.staticCtDecls);\n        if (self.staticCtCalls != null) dealloc<NodeId>(self.staticCtCalls);\n        self.staticCtDecls = null;\n        self.staticCtCalls = null;\n        self.staticCtLen = 0;\n        self.staticCtCap = 0;\n        self.file = null;\n        self.work = null;\n        self.workLen = 0;\n        self.workCap = 0;\n        self.instances = null;\n        self.instancesLen = 0;\n        self.instancesCap = 0;\n        self.declarations = null;\n        self.declarationsLen = 0;\n        self.declarationsCap = 0;\n        self.errors = 0;\n        self.activeSubs = null;\n        self.activeSubsLen = 0;\n    }\n\n    void deinit()\n    {\n        self.clear();\n        self.ast = null;\n        self.sema = null;\n    }\n\n    Ty findSubstitution(Ty typeNode, MonoSubstitution* substitutions, u32 substitutionsLen)\n    {\n        TypeEntry* entry = self.typeEntryAt(typeNode);\n        if (entry == null || entry->kind.tag != TypeKind::TypeParam) return 0;\n        u32 i = 0;\n        while (i < substitutionsLen)\n        {\n            if (substitutions[i].index == entry->kind.payload.TypeParam.index ||\n                substitutions[i].parameter == entry->kind.payload.TypeParam.name)\n                return substitutions[i].typeNode;\n            i++;\n        }\n        return 0;\n    }\n\n    /* rebuilds `typeNode` with `substitutions` applied. Every composite\n     * node comes back freshly interned: two calls that produce the\n     * same shape hand out different Ty indices, which is exactly why\n     * typeDigest hashes names instead of indices. */\n    Ty substituteType(Ty typeNode, MonoSubstitution* substitutions, u32 substitutionsLen)\n    {\n        if (typeNode == 0) return 0;\n        TypeEntry* entry = self.typeEntryAt(typeNode);\n        if (entry == null) return 0;\n        switch (entry->kind.tag)\n        {\n            TypeKind::TypeParam => { return self.findSubstitution(typeNode, substitutions, substitutionsLen); },\n            /* a comptime value arg is already concrete */\n            TypeKind::ValueInt => { return typeNode; },\n            TypeKind::Named => {\n                u32 i = 0;\n                while (i < substitutionsLen)\n                {\n                    if (substitutions[i].parameter == entry->kind.payload.Named.name && entry->kind.payload.Named.genericArgsLen == 0)\n                        return substitutions[i].typeNode;\n                    i++;\n                }\n                Ty* args = self.copyTypes(entry->kind.payload.Named.genericArgs, entry->kind.payload.Named.genericArgsLen);\n                self.ast->track((rawptr)args);\n                u32 j = 0;\n                while (j < entry->kind.payload.Named.genericArgsLen)\n                {\n                    args[j] = self.substituteType(args[j], substitutions, substitutionsLen);\n                    j++;\n                }\n                TypeKind kind = TypeKind::Named{ .name = entry->kind.payload.Named.name, .genericArgs = args, .genericArgsLen = entry->kind.payload.Named.genericArgsLen };\n                Ty nt = self.sema->allocType(kind);\n                TypeEntry* ne = self.ast->types + nt;\n                ne->loc = entry->loc;\n                return nt;\n            },\n            \n            TypeKind::Pointer => {\n                TypeKind kind = TypeKind::Pointer{ .base = self.substituteType(entry->kind.payload.Pointer.base, substitutions, substitutionsLen) };\n                return self.sema->allocType(kind);\n            },\n\n            TypeKind::Const => {\n                TypeKind kind = TypeKind::Const{ .base = self.substituteType(entry->kind.payload.Const.base, substitutions, substitutionsLen) };\n                return self.sema->allocType(kind);\n            },\n\n            TypeKind::Comptime => {\n                TypeKind kind = TypeKind::Comptime{ .base = self.substituteType(entry->kind.payload.Comptime.base, substitutions, substitutionsLen) };\n                return self.sema->allocType(kind);\n            },\n\n            TypeKind::Slice => {\n                TypeKind kind = TypeKind::Slice{ .base = self.substituteType(entry->kind.payload.Slice.base, substitutions, substitutionsLen) };\n                return self.sema->allocType(kind);\n            },\n\n            TypeKind::Array => {\n                /* symbolic size `T data[N]`: resolve N through the instance's\n                 * substitutions; a ValueInt argument pins the length and\n                 * clears the symbolic reference */\n                u32 len = entry->kind.payload.Array.len;\n                u32 sizeParam = entry->kind.payload.Array.sizeParam;\n                Str sizeName = entry->kind.payload.Array.sizeName;\n                u32 si = 0;\n                while (si < substitutionsLen)\n                {\n                    /* fields keep the written name (no parser rebind), so\n                     * match by param index or by name; funcs get index'd */\n                    bool match = (sizeParam != 4294967295 && substitutions[si].index == sizeParam) ||\n                                 (sizeParam == 4294967295 && sizeName != 0 && substitutions[si].parameter == sizeName);\n                    if (match)\n                    {\n                        TypeEntry* se = self.typeEntryAt(substitutions[si].typeNode);\n                        if (se != null && se->kind.tag == TypeKind::ValueInt)\n                        {\n                            len = (u32)se->kind.payload.ValueInt.value;\n                            sizeParam = 4294967295;\n                            sizeName = 0;\n                        }\n                        break;\n                    }\n                    si++;\n                }\n                TypeKind kind = TypeKind::Array{ .base = self.substituteType(entry->kind.payload.Array.base, substitutions, substitutionsLen), .len = len,\n                                                 .sizeParam = sizeParam, .sizeName = sizeName };\n                return self.sema->allocType(kind);\n            },\n\n            /* fn-pointer params carry the generic params too:\n             * `bool(T,T) less` must become `bool(i32,i32)` per instance,\n             * not stay the first instantiation's spelling */\n            TypeKind::FnPtr => {\n                Ty* params = self.copyTypes(entry->kind.payload.FnPtr.params, entry->kind.payload.FnPtr.paramsLen);\n                self.ast->track((rawptr)params);\n                u32 k = 0;\n                while (k < entry->kind.payload.FnPtr.paramsLen)\n                {\n                    params[k] = self.substituteType(params[k], substitutions, substitutionsLen);\n                    k++;\n                }\n                TypeKind kind = TypeKind::FnPtr{ .returnType = self.substituteType(entry->kind.payload.FnPtr.returnType, substitutions, substitutionsLen), .params = params, .paramsLen = entry->kind.payload.FnPtr.paramsLen, .name = entry->kind.payload.FnPtr.name };\n                return self.sema->allocType(kind);\n            },\n            else => { return typeNode; },\n        }\n    }\n\n    /* cap-doubling growth; callers check the bool and bail on OOM.\n     * The work set is tiny (one entry per generic call site), so\n     * doubling is plenty. */\n    bool reserveDeclarations()\n    {\n        if (self.declarationsLen < self.declarationsCap) return true;\n        u32 newCap = self.declarationsCap * 2;\n        if (newCap == 0) newCap = 16;\n        MonoDecl* raw = realloc<MonoDecl>(self.declarations, (usize)newCap);\n        if (raw == null)\n        {\n            self.errors++;\n            return false;\n        }\n        self.declarations = raw;\n        self.declarationsCap = newCap;\n        return true;\n    }\n\n    bool reserveWork()\n    {\n        if (self.workLen < self.workCap) return true;\n        u32 newCap = self.workCap * 2;\n        if (newCap == 0) newCap = 16;\n        MonoWorkItem* raw = realloc<MonoWorkItem>(self.work, (usize)newCap);\n        if (raw == null)\n        {\n            self.errors++;\n            return false;\n        }\n        self.work = raw;\n        self.workCap = newCap;\n        return true;\n    }\n\n    bool reserveInstances()\n    {\n        if (self.instancesLen < self.instancesCap) return true;\n        u32 newCap = self.instancesCap * 2;\n        if (newCap == 0) newCap = 16;\n        MonoInstance* raw = realloc<MonoInstance>(self.instances, (usize)newCap);\n        if (raw == null)\n        {\n            self.errors++;\n            return false;\n        }\n        self.instances = raw;\n        self.instancesCap = newCap;\n        return true;\n    }\n\n    bool reserveStaticCt()\n    {\n        if (self.staticCtLen < self.staticCtCap) return true;\n        u32 newCap = self.staticCtCap * 2;\n        if (newCap == 0) newCap = 16;\n        NodeId* decls = realloc<NodeId>(self.staticCtDecls, (usize)newCap);\n        if (decls == null)\n        {\n            self.errors++;\n            return false;\n        }\n        self.staticCtDecls = decls;\n        NodeId* calls = realloc<NodeId>(self.staticCtCalls, (usize)newCap);\n        if (calls == null)\n        {\n            self.errors++;\n            return false;\n        }\n        self.staticCtCalls = calls;\n        self.staticCtCap = newCap;\n        return true;\n    }\n\n    /* heap copies owned by the caller; the source is usually an arena\n     * slice or an interned type table that a later pass rewrites. */\n    Ty* copyTypes(Ty* values, u32 len)\n    {\n        if (len == 0) return null;\n        Ty* result = alloc<Ty>((usize)len);\n        if (result == null)\n        {\n            self.errors++;\n            return null;\n        }\n        u32 i = 0;\n        while (i < len)\n        {\n            result[i] = values[i];\n            i++;\n        }\n        return result;\n    }\n\n    MonoSubstitution* copySubstitutions(MonoSubstitution* values, u32 len)\n    {\n        if (len == 0) return null;\n        MonoSubstitution* result = alloc<MonoSubstitution>((usize)len);\n        if (result == null)\n        {\n            self.errors++;\n            return null;\n        }\n        u32 i = 0;\n        while (i < len)\n        {\n            result[i] = values[i];\n            i++;\n        }\n        return result;\n    }\n\n    Node* nodeAt(NodeId id)\n    {\n        if (self.ast == null || id.index == 0 || id.index >= self.ast->nodesLen) return null;\n        return self.ast->nodes + id.index;\n    }\n\n    Decl* declAt(NodeId id)\n    {\n        Node* node = self.nodeAt(id);\n        if (node == null || node->kind.tag != NodeKind::Decl) return null;\n        return &node->kind.payload.Decl.value;\n    }\n\n    /* FNV-1a over the call's per-argument comptime-visible identity:\n     * a literal token (string bytes / int / char / bool value) or 'R'\n     * for runtime args. Two call sites to the same generic function\n     * produce the same valueKey iff their literal args are equal (and\n     * the arity matches): this is the value half of instance identity\n     * (Zig-style: `println(\"a\")` and `println(\"b\")` are distinct\n     * instances, `println(fmt)` with a runtime fmt shares the runtime\n     * instance). Computed identically at collect time (collectCall) and\n     * at codegen time (cgCallFromDecl), both over the call's arg nodes. */\n    u64 callValueKey(NodeId* args, u32 argsLen)\n    {\n        u64 h = 1469598103934665603;\n        h = (h ^ (u64)argsLen) * 1099511628211;\n        u32 i = 0;\n        while (i < argsLen)\n        {\n            u64 tag = 82; // 'R': runtime value\n            u64 val = 0;\n            u8* sp = null;\n            usize sl = 0;\n            Node* an = self.nodeAt(args[i]);\n            if (an != null && an->kind.tag == NodeKind::Expr)\n            {\n                Expr* e = &an->kind.payload.Expr.value;\n                if (e->kind.tag == ExprKind::StringLit)\n                {\n                    tag = 83; // 'S'\n                    Str s = e->kind.payload.StringLit.value;\n                    if (s != 0 && s < self.ast->internsLen)\n                    {\n                        sp = self.ast->interns[s].ptr;\n                        sl = self.ast->interns[s].len;\n                    }\n                }\n                else if (e->kind.tag == ExprKind::IntLit) { tag = 73; val = e->kind.payload.IntLit.value; } // 'I'\n                else if (e->kind.tag == ExprKind::CharLit) { tag = 67; val = (u64)e->kind.payload.CharLit.value; } // 'C'\n                else if (e->kind.tag == ExprKind::BoolLit) { tag = 66; val = (u64)(e->kind.payload.BoolLit.flags & 1); } // 'B'\n                else if (e->kind.tag == ExprKind::Spread && e->kind.payload.Spread.expr.index == 0) tag = 80; // 'P' bare spread\n            }\n            h = (h ^ tag) * 1099511628211;\n            h = (h ^ val) * 1099511628211;\n            usize b = 0;\n            while (b < sl)\n            {\n                h = (h ^ (u64)sp[b]) * 1099511628211;\n                b++;\n            }\n            i++;\n        }\n        return h;\n    }\n\n    /* structural, allocation-free hash of a type as seen through a\n     * substitution list. Must be stable between collect time and codegen\n     * time: `substituteType` interns a FRESH copy for every Named /\n     * Pointer / Slice / … it walks, so hashing its result would compare\n     * two different indices (a struct-typed runtime arg then never finds\n     * its instance). Names / primitive indices are the same in both\n     * phases, so hash those. */\n    u64 typeDigest(Ty t, MonoSubstitution* subs, u32 subsLen)\n    {\n        if (t == 0) return 0;\n        TypeEntry* te = self.typeEntryAt(t);\n        if (te == null) return 0;\n        switch (te->kind.tag)\n        {\n            TypeKind::TypeParam => {\n                Ty st = self.findSubstitution(t, subs, subsLen);\n                if (st != 0 && st != t) return self.typeDigest(st, null, 0);\n                /* still unsubstituted: tag the raw index so it can't be\n                 * mistaken for a primitive's canonical index */\n                return ((u64)t << 1) | 1;\n            },\n            /* comptime value args hash by value: `Arr<i32,4>` != `Arr<i32,9>` */\n            TypeKind::ValueInt => {\n                return (te->kind.payload.ValueInt.value * 1099511628211) ^ 97;\n            },\n            TypeKind::Named => {\n                u64 h = 1469598103934665603 ^ (u64)te->kind.payload.Named.name;\n                u32 i = 0;\n                while (i < te->kind.payload.Named.genericArgsLen)\n                {\n                    h *= 1099511628211;\n                    h ^= self.typeDigest(te->kind.payload.Named.genericArgs[i], subs, subsLen);\n                    i++;\n                }\n                return h;\n            },\n            TypeKind::Pointer => {\n                u64 hp = self.typeDigest(te->kind.payload.Pointer.base, subs, subsLen) * 1099511628211;\n                return hp ^ 81;\n            },\n            TypeKind::Const => {\n                u64 hc = self.typeDigest(te->kind.payload.Const.base, subs, subsLen) * 1099511628211;\n                return hc ^ 82;\n            },\n            TypeKind::Comptime => {\n                u64 hk = self.typeDigest(te->kind.payload.Comptime.base, subs, subsLen) * 1099511628211;\n                return hk ^ 83;\n            },\n            TypeKind::Slice => {\n                u64 hs = self.typeDigest(te->kind.payload.Slice.base, subs, subsLen) * 1099511628211;\n                return hs ^ 84;\n            },\n            TypeKind::Array => {\n                u64 ha = self.typeDigest(te->kind.payload.Array.base, subs, subsLen) * 1099511628211;\n                ha ^= 85;\n                ha ^= ((u64)te->kind.payload.Array.len << 32);\n                return ha;\n            },\n            TypeKind::FnPtr => {\n                u64 h = self.typeDigest(te->kind.payload.FnPtr.returnType, subs, subsLen) * 1099511628211;\n                h ^= 86;\n                u32 k = 0;\n                while (k < te->kind.payload.FnPtr.paramsLen)\n                {\n                    h *= 1099511628211;\n                    h ^= self.typeDigest(te->kind.payload.FnPtr.params[k], subs, subsLen);\n                    k++;\n                }\n                return h;\n            },\n            // primitives: the interned index is canonical and stable\n            else => { return (u64)t; },\n        }\n    }\n\n    /* valueKey + the substituted resolved type of every call arg: two\n     * call sites with equal value tokens but different runtime argument\n     * types (`println(\"{}\", x)` with x:i32 vs y:f64) must not share an\n     * instance, and the instance's named tail parameters are typed from\n     * these. Computed identically at collect time (activeSubs) and at\n     * codegen time (cg.subs) over the same arg nodes. */\n    u64 callValueKeyTyped(NodeId* args, u32 argsLen, MonoSubstitution* subs, u32 subsLen)\n    {\n        u64 h = self.callValueKey(args, argsLen);\n        u32 i = 0;\n        while (i < argsLen)\n        {\n            Ty t = 0;\n            Node* an = self.nodeAt(args[i]);\n            if (an != null && an->kind.tag == NodeKind::Expr) t = an->kind.payload.Expr.value.resolvedType;\n            h = (h ^ self.typeDigest(t, subs, subsLen)) * 1099511628211;\n            i++;\n        }\n        return h;\n    }\n\n    /* fill out[genericCount] with the call-arg type bound to each generic\n     * slot: mirrors collectCall's inference (a bare type-param param, or\n     * a param whose type is that type param) so codegen can test whether a\n     * call site matches a collected instance. Unfilled slots stay 0. */\n    void inferCallArgs(NodeId declaration, NodeId* args, u32 argsLen,\n                       MonoSubstitution* subs, u32 subsLen, Ty* out)\n    {\n        Decl* decl = self.declAt(declaration);\n        if (decl == null || decl->kind.tag != DeclKind::Func) return;\n        u32 gcount = self.genericCount(declaration);\n        u32 next = 0;\n        u32 p = 0;\n        while (p < decl->kind.payload.Func.paramsLen && next < gcount)\n        {\n            NodeId paramId = decl->kind.payload.Func.params[p];\n            if (self.isTypeParameter(paramId))\n            {\n                if (p < argsLen)\n                {\n                    Ty at = 0;\n                    Node* an = self.nodeAt(args[p]);\n                    if (an != null && an->kind.tag == NodeKind::Expr) at = an->kind.payload.Expr.value.resolvedType;\n                    out[next] = self.substituteType(at, subs, subsLen);\n                }\n                next++;\n            }\n            else\n            {\n                Node* pn = self.nodeAt(paramId);\n                if (pn != null && pn->kind.tag == NodeKind::Param)\n                {\n                    Ty pt = pn->kind.payload.Param.value.typeNode;\n                    while (pt != 0)\n                    {\n                        TypeEntry* te2 = self.ast->types + pt;\n                        if (te2->kind.tag == TypeKind::Comptime) pt = te2->kind.payload.Comptime.base;\n                        else if (te2->kind.tag == TypeKind::Const) pt = te2->kind.payload.Const.base;\n                        else break;\n                    }\n                    if (pt != 0)\n                    {\n                        TypeEntry* te3 = self.ast->types + pt;\n                        u32 slot = 0;\n                        bool haveSlot = false;\n                        if (te3->kind.tag == TypeKind::TypeParam)\n                        {\n                            slot = te3->kind.payload.TypeParam.index;\n                            haveSlot = true;\n                        }\n                        else if (te3->kind.tag == TypeKind::Named)\n                        {\n                            /* explicit `<T>` param: resolve its slot by name */\n                            Str tn = te3->kind.payload.Named.name;\n                            u32 gi = 0;\n                            while (gi < decl->kind.payload.Func.genericParamsLen)\n                            {\n                                Node* gpn = self.nodeAt(decl->kind.payload.Func.genericParams[gi]);\n                                if (gpn != null && gpn->kind.tag == NodeKind::GenericParam &&\n                                    gpn->kind.payload.GenericParam.value.name == tn)\n                                {\n                                    slot = gi;\n                                    haveSlot = true;\n                                    break;\n                                }\n                                gi++;\n                            }\n                        }\n                        if (haveSlot && slot < gcount && out[slot] == 0 && p < argsLen)\n                        {\n                            Ty at = 0;\n                            Node* an = self.nodeAt(args[p]);\n                            if (an != null && an->kind.tag == NodeKind::Expr) at = an->kind.payload.Expr.value.resolvedType;\n                            out[slot] = self.substituteType(at, subs, subsLen);\n                        }\n                    }\n                }\n            }\n            p++;\n        }\n    }\n\n    TypeEntry* typeEntryAt(Ty typeNode)\n    {\n        if (self.ast == null || typeNode == 0 || typeNode >= self.ast->typesLen) return null;\n        return self.ast->types + typeNode;\n    }\n\n    u32 nodeCount()\n    {\n        if (self.ast == null) return 0;\n        return self.ast->nodesLen;\n    }\n\n    /* 1 = type-ish decl, 2 = func, 0 = anything else. Currently no\n     * callers; the pipeline discriminates decls by tag directly. */\n    u8 declarationKind(NodeId id)\n    {\n        Decl* decl = self.declAt(id);\n        if (decl == null) return 0;\n        switch (decl->kind.tag)\n        {\n            DeclKind::Struct => { return 1; },\n            DeclKind::Enum => { return 1; },\n            DeclKind::Variant => { return 1; },\n            DeclKind::Union => { return 1; },\n            DeclKind::Trait => { return 1; },\n            DeclKind::Func => { return 2; },\n            else => { return 0; },\n        }\n    }\n\n    Str declarationName(NodeId id)\n    {\n        Decl* decl = self.declAt(id);\n        if (decl == null) return 0;\n        switch (decl->kind.tag)\n        {\n            DeclKind::Struct => { return decl->kind.payload.Struct.name; },\n            DeclKind::Enum => { return decl->kind.payload.Enum.name; },\n            DeclKind::Variant => { return decl->kind.payload.Variant.name; },\n            DeclKind::Union => { return decl->kind.payload.Union.name; },\n            DeclKind::Trait => { return decl->kind.payload.Trait.name; },\n            DeclKind::Func => { return decl->kind.payload.Func.name; },\n            else => { return 0; },\n        }\n    }\n\n    /* the param's spelling: its name, or, for a bare `T` param, which\n     * has no name: the type name it stands for. Call-arg binding and\n     * slot naming both key off this. */\n    Str parameterName(NodeId id)\n    {\n        Node* node = self.nodeAt(id);\n        if (node == null || node->kind.tag != NodeKind::Param) return 0;\n        Param* param = &node->kind.payload.Param.value;\n        if (param->name != 0) return param->name;\n        TypeEntry* entry = self.typeEntryAt(param->typeNode);\n        if (entry != null && entry->kind.tag == TypeKind::Comptime)\n        {\n            TypeEntry* base = self.typeEntryAt(entry->kind.payload.Comptime.base);\n            if (base != null && base->kind.tag == TypeKind::Named)\n                return base->kind.payload.Named.name;\n        }\n        return 0;\n    }\n\n    /* a parameter that occupies a generic slot: the parser tags bare\n     * type params (`T`, `comptime T`) with flags & 8, and the resolved\n     * typeNode must still be Named/TypeParam for the slot to count. */\n    bool isTypeParameter(NodeId id)\n    {\n        Node* node = self.nodeAt(id);\n        if (node == null || node->kind.tag != NodeKind::Param) return false;\n        Param* param = &node->kind.payload.Param.value;\n        if ((param->flags & 8) == 0) return false;\n        Ty base = param->typeNode;\n        if (base == 0) return false;\n        TypeEntry* entry = self.typeEntryAt(base);\n        while (entry != null && entry->kind.tag == TypeKind::Const)\n        {\n            base = entry->kind.payload.Const.base;\n            if (base == 0) return false;\n            entry = self.typeEntryAt(base);\n        }\n        if (entry == null) return false;\n        return entry->kind.tag == TypeKind::Named || entry->kind.tag == TypeKind::TypeParam;\n    }\n\n    /* written `<T, U>` slots only; genericCount adds the implied ones */\n    u32 explicitGenericCount(NodeId id)\n    {\n        Decl* decl = self.declAt(id);\n        if (decl == null) return 0;\n        switch (decl->kind.tag)\n        {\n            DeclKind::Struct => { return decl->kind.payload.Struct.genericParamsLen; },\n            DeclKind::Variant => { return decl->kind.payload.Variant.genericParamsLen; },\n            DeclKind::Union => { return decl->kind.payload.Union.genericParamsLen; },\n            DeclKind::Trait => { return decl->kind.payload.Trait.genericParamsLen; },\n            DeclKind::Func => { return decl->kind.payload.Func.genericParamsLen; },\n            else => { return 0; },\n        }\n    }\n\n    bool nameInGenericParams(NodeId id, Str name)\n    {\n        Decl* decl = self.declAt(id);\n        if (decl == null) return false;\n        NodeId* params = null;\n        u32 len = 0;\n        switch (decl->kind.tag)\n        {\n            DeclKind::Struct => {\n                params = decl->kind.payload.Struct.genericParams;\n                len = decl->kind.payload.Struct.genericParamsLen;\n            },\n            DeclKind::Variant => {\n                params = decl->kind.payload.Variant.genericParams;\n                len = decl->kind.payload.Variant.genericParamsLen;\n            },\n            DeclKind::Union => {\n                params = decl->kind.payload.Union.genericParams;\n                len = decl->kind.payload.Union.genericParamsLen;\n            },\n            DeclKind::Trait => {\n                params = decl->kind.payload.Trait.genericParams;\n                len = decl->kind.payload.Trait.genericParamsLen;\n            },\n            DeclKind::Func => {\n                params = decl->kind.payload.Func.genericParams;\n                len = decl->kind.payload.Func.genericParamsLen;\n            },\n            else => { return false; },\n        }\n        u32 i = 0;\n        while (i < len)\n        {\n            Node* node = self.nodeAt(params[i]);\n            if (node != null && node->kind.tag == NodeKind::GenericParam)\n            {\n                GenericParam* param = &node->kind.payload.GenericParam.value;\n                if (param->name == name) return true;\n            }\n            i++;\n        }\n        return false;\n    }\n\n    /* full generic arity: explicit `<...>` entries plus bare-T params\n     * that weren't named there (`T fmt` style); those count as slots\n     * too, keyed by the parameter's name. */\n    u32 genericCount(NodeId id)\n    {\n        u32 count = self.explicitGenericCount(id);\n        Decl* decl = self.declAt(id);\n        if (decl == null || decl->kind.tag != DeclKind::Func) return count;\n        u32 i = 0;\n        while (i < decl->kind.payload.Func.paramsLen)\n        {\n            NodeId paramId = decl->kind.payload.Func.params[i];\n            if (self.isTypeParameter(paramId))\n            {\n                Str name = self.parameterName(paramId);\n                if (!self.nameInGenericParams(id, name)) count++;\n            }\n            i++;\n        }\n        return count;\n    }\n\n    bool isGenericDeclaration(NodeId id) { return self.genericCount(id) != 0; }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-parser/file.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n\n// parser/file.crl: file-level driver, parse decls until EOF\n\nimport std::mman { alloc };\nuse common::token { TokenKind };\nuse diag::code { ErrorCode };\nuse context::context { AstContext, NodeListBuilder };\nuse ast::decl { File, Attribute, ATTR_NO_DROP_ALL };\nuse ast::id { Str, NodeId, SourceLoc };\nuse ast::node { Node, NodeKind };\nuse base { Parser, ParserMark };\n\npub extend Parser\n{\n    /* one File per source. prescan const ints, then parse decls under the\n     * standard progress/error guard; unknown tokens and stray closers are\n     * reported and eaten here because no lower level wants them. returns\n     * null only when the File allocation fails. `path` is an interned Str,\n     * so the File owns no string bytes */\n    File* parseFile(Str path)\n    {\n        /* declare-all consts first (text.txt pass 1 fast variant) so\n         * array sizes resolve regardless of declaration order */\n        self.prescanConstInts();\n        /* `#[[no_drop_all]]` at the very top attaches to the file; any\n         * other leading attribute belongs to the first declaration, so\n         * peek the first name before consuming the group */\n        Attribute* fattrs = null;\n        u32 fattrsLen = 0;\n        u32 fattrsBits = 0;\n        while (self.current.kind == TokenKind::Hash && fattrsLen == 0)\n        {\n            ParserMark m = self.save();\n            SourceLoc attrLoc = self.tokenLoc(self.current);\n            self.advance();\n            self.match(TokenKind::LBracket);\n            self.match(TokenKind::LBracket);\n            Str nm = 0;\n            if (self.current.kind == TokenKind::Ident)\n            {\n                nm = self.ctx->intern(self.current.data.asStr());\n                self.advance();\n            }\n            self.restore(m);\n            if (self.attrBitOf(nm) != ATTR_NO_DROP_ALL) break;\n            self.expect(TokenKind::Hash);\n            self.expect(TokenKind::LBracket);\n            self.expect(TokenKind::LBracket);\n            self.expect(TokenKind::Ident);\n            self.expect(TokenKind::RBracket);\n            self.expect(TokenKind::RBracket);\n            Attribute* raw = alloc<Attribute>(1);\n            if (raw == null) { self.reportAllocFailed(); break; }\n            raw[0] = Attribute{ .name = nm, .args = null, .argsLen = 0, .loc = attrLoc };\n            fattrs = raw;\n            fattrsLen = 1;\n            fattrsBits = ATTR_NO_DROP_ALL;\n        }\n        NodeListBuilder decls;\n        self.ctx->nodeListInit(&decls);\n        while (!self.atEnd())\n        {\n            // Unknown token (stray byte). nothing has reported it (the\n            // lexer's unknown-char diag is dead), so just get past it\n             if (self.current.kind == TokenKind::Unknown)\n            {\n                self.advance();\n                continue;\n            }\n            // stray closer at top level: report and eat it, nobody else will\n             if (self.current.kind == TokenKind::RBrace || self.current.kind == TokenKind::RParen ||\n                 self.current.kind == TokenKind::RBracket)\n            {\n                self.reportExpectedWith(ErrorCode::ParseUnexpectedClosingToken, \"unexpected closing token at file scope\");\n                self.advance();\n                continue;\n            }\n\n            u32 errorsBefore = self.errorCount();\n            u32 posBefore = self.pos;\n            Token tokenBefore = self.current;\n            NodeId decl = self.parseDecl();\n            if (!self.ctx->nodeListAppend(&decls, decl)) self.reportAllocFailed();\n\n            /* if parseDecl returned without moving the cursor, force it;\n             * otherwise a decl that reports an error before consuming\n             * anything spins this loop forever */\n            bool progressed = self.pos != posBefore ||\n                              self.current.kind != tokenBefore.kind ||\n                              self.current.data.ptr != tokenBefore.data.ptr;\n            if (!progressed && !self.atEnd()) self.advance();\n            /* P0012 only flags an attribute name; the decl itself parsed,\n             * so a resync here would skip the next decl's attributes */\n            if (self.errorCount() > errorsBefore && !self.attrNameError) self.synchronize();\n            self.attrNameError = false;\n        }\n        u32 count = decls.len;\n        NodeId* values = self.ctx->nodeListFinish(&decls);\n        /* file-level attrs ride on every top-level decl: merged lib files\n         * concatenate decls into one File, so File.attrs alone would lose\n         * them (sema reads attrs off the function decl) */\n        if (fattrsLen > 0 && values != null)\n        {\n            u32 vi = 0;\n            while (vi < count)\n            {\n                Node* dn = self.ctx->nodes + values[vi].index;\n                if (dn->kind.tag == NodeKind::Decl)\n                {\n                    dn->kind.payload.Decl.value.attrBits |= fattrsBits;\n                    u32 oldLen = dn->kind.payload.Decl.value.attrsLen;\n                    if (oldLen == 0)\n                    {\n                        dn->kind.payload.Decl.value.attrs = fattrs;\n                        dn->kind.payload.Decl.value.attrsLen = fattrsLen;\n                    }\n                    else\n                    {\n                        Attribute* merged = alloc<Attribute>((usize)(oldLen + fattrsLen));\n                        if (merged != null)\n                        {\n                            u32 mi = 0;\n                            while (mi < oldLen) { merged[mi] = dn->kind.payload.Decl.value.attrs[mi]; mi++; }\n                            u32 fi = 0;\n                            while (fi < fattrsLen) { merged[oldLen + fi] = fattrs[fi]; fi++; }\n                            dn->kind.payload.Decl.value.attrs = merged;\n                            dn->kind.payload.Decl.value.attrsLen = oldLen + fattrsLen;\n                        }\n                    }\n                }\n                vi++;\n            }\n        }\n        File* file = self.ctx->allocFile();\n        if (file == null)\n        {\n            self.reportAllocFailed();\n            self.freeConstTable();\n            self.freeTokens();\n            return null;\n        }\n        file->path = path;\n        file->decls = values;\n        file->declsLen = count;\n        file->attrs = fattrs;\n        file->attrsLen = fattrsLen;\n        // per-file scratch, must not outlive the parse\n        self.freeConstTable();\n        self.freeTokens();\n        return file;\n    }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-parser/parser.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n\n// parser/parser.crl: cursor plumbing: advance/match/expect, node\n// constructors, and the speculative save()/restore() machinery\n\nimport std::mman { dealloc, realloc };\nuse diag::code { ErrorCode };\nuse common::token { Token, TokenKind };\nuse lexer::lexer { Lexer };\nuse context::context { AstContext };\nuse ast {\n    id { NodeId, SourceLoc, makeLoc },\n    node { Node, NodeKind },\n    pat { Pat, PatKind }\n};\nuse base { Parser, ParserMark };\n\npub extend Parser\n{\n    /* lex the whole source once into the token array, then run the parse\n     * purely over indices. Lexer diagnostics fire here, exactly once per\n     * token, instead of re-emitting on every speculative re-lex */\n    static Parser init(Lexer* lexer, AstContext* ctx, u32 fileId)\n    {\n        Parser p = Parser {\n            .lexer = lexer,\n            .ctx = ctx,\n            .panicMode = 0,\n            .specDepth = 0,\n            .pendingGreater = false,\n            .fileId = fileId,\n            /* Eof sentinel: survives a token-buffer OOM so atEnd() and\n             * advance() stay safe with toks == null */\n            .current = Token { .kind = TokenKind::Eof },\n            .previous = Token { .kind = TokenKind::Eof },\n        };\n        while (true)\n        {\n            Token t = lexer->nextToken();\n            if (!p.pushTok(t)) break;\n            if (t.kind == TokenKind::Eof) break;\n        }\n        if (p.toksLen > 0)\n        {\n            p.pos = 0;\n            p.current = p.toks[0];\n            p.previous = p.current;\n        }\n        return p;\n    }\n\n    bool pushTok(Token t)\n    {\n        if (self.toksLen >= self.toksCap)\n        {\n            u32 newCap = self.toksCap;\n            if (newCap == 0) newCap = 1024;\n            else newCap *= 2;\n            Token* grown = realloc<Token>(self.toks, (usize)newCap);\n            if (grown == null)\n            {\n                self.reportAllocFailed();\n                return false;\n            }\n            self.toks = grown;\n            self.toksCap = newCap;\n        }\n        self.toks[self.toksLen] = t;\n        self.toksLen++;\n        return true;\n    }\n\n    void freeTokens()\n    {\n        if (self.toks != null) dealloc<Token>(self.toks);\n        self.toks = null;\n        self.toksLen = 0;\n        self.toksCap = 0;\n        self.pos = 0;\n    }\n\n    Token advance()\n    {\n        self.previous = self.current;\n        if (self.toks != null && self.pos + 1 < self.toksLen)\n        {\n            self.pos++;\n            self.current = self.toks[self.pos];\n        }\n        return self.previous;\n    }\n\n    bool match(TokenKind kind)\n    {\n        if (self.current.kind == kind)\n        {\n            self.advance();\n            return true;\n        }\n        return false;\n    }\n\n    Token expect(TokenKind kind)\n    {\n        if (self.current.kind == kind)\n        {\n            return self.advance();\n        }\n        self.reportExpected(kind);\n        if (self.atEnd()) return self.current;\n        /* on mismatch, only consume the offending token when it can't\n         * belong to an enclosing construct; swallowing a `)` or `}` here\n         * would desync every level above us */\n        bool closeExpected = kind == TokenKind::RParen ||\n                             kind == TokenKind::RBrace ||\n                             kind == TokenKind::RBracket;\n        if (closeExpected || self.isRecoveryBoundary(self.current.kind))\n            return self.current;\n        return self.advance();\n    }\n\n    bool atEnd() { return self.current.kind == TokenKind::Eof; }\n    NodeId noneNode() { return self.ctx->noneNode(); }\n\n    SourceLoc tokenLoc(Token token)\n    {\n        return makeLoc(self.fileId, (u32)token.line, (u32)token.col);\n    }\n\n    NodeId storeNode(NodeKind kind)\n    {\n        NodeId id = self.ctx->allocNodeSlot();\n        if (id.index == 0)\n        {\n            self.reportAllocFailed();\n            return id;\n        }\n        Node* node = self.ctx->nodes + id.index;\n        node->kind = kind;\n        node->loc = self.tokenLoc(self.previous);\n        return id;\n    }\n\n    /* storeNode lands on the token that closed a construct (the `)` of a\n     * call); point the node at the item instead so diagnostics show the\n     * callee/receiver, not end-of-line */\n    void pointAt(NodeId nodeId, NodeId at)\n    {\n        if (nodeId.index == 0 || at.index == 0) return;\n        Node* n = self.ctx->nodes + nodeId.index;\n        Node* a = self.ctx->nodes + at.index;\n        n->loc = a->loc;\n        if (n->kind.tag == NodeKind::Expr) n->kind.payload.Expr.value.loc = a->loc;\n    }\n\n    NodeId storePat(PatKind kind)\n    {\n        Pat p;\n        p.kind = kind;\n        p.loc = self.tokenLoc(self.previous);\n        return self.storeNode(NodeKind::Pat{ .value = p });\n    }\n\n    NodeId allocNode()\n    {\n        return self.storeNode(NodeKind::Invalid{ .flags = 0 });\n    }\n\n    /* speculative-parse bookmark. save() bumps specDepth so any diagnostic\n     * from a lookahead is dropped (see recovery.crl reportError); restore()\n     * rewinds both arenas. Nodes and types are discarded together because\n     * a speculative parse must not leave reachable or stale entries behind:\n     * duplicate primitive type entries break sema's index equality\n     * (boolType() returns the FIRST Bool entry), and orphaned nodes bloat\n     * later full-arena scans. */\n    ParserMark save()\n    {\n        ParserMark m = ParserMark {\n            .pos = self.pos,\n            .current = self.current,\n            .previous = self.previous,\n            .panicMode = self.panicMode,\n            .specDepth = self.specDepth,\n            .pendingGreater = self.pendingGreater,\n            .typesLen = self.ctx->typesLen,\n            .nodesLen = self.ctx->nodesLen\n        };\n        self.beginSpeculation();\n        return m;\n    }\n\n    void restore(ParserMark m)\n    {\n        /* pure index rewind: the token array already holds everything the\n         * discarded parse consumed, so no byte cursors and no re-lex */\n        self.pos = m.pos;\n        self.current = m.current;\n        self.previous = m.previous;\n        self.panicMode = m.panicMode;\n        self.specDepth = m.specDepth;\n        self.pendingGreater = m.pendingGreater;\n        self.ctx->typesLen = m.typesLen;\n        self.ctx->nodesLen = m.nodesLen;\n    }\n\n    /* close one `>` of a generic list. `>>` lexes as a single Shr token, so\n     * the first consumeGreater() eats the whole token and remembers that a\n     * second closer is still owed; that's what pendingGreater is for.\n     * parseTypeSuffix/parseBaseType check it before absorbing a `(` as a\n     * fn-type suffix: `zero<E<i32, i32>>(a)` has a call there, not params */\n    bool consumeGreater()\n    {\n        if (self.pendingGreater) {\n            self.pendingGreater = false;\n            return true;\n        }\n        \n        switch (self.current.kind) {\n            TokenKind::Greater => { self.advance(); return true; },\n            TokenKind::Shr => {\n                self.advance();\n                self.pendingGreater = true;\n                return true;\n            },\n            else => { return false; },\n        }\n    }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-ir/expr.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* coral-ir/expr.crl — expression lowering\n *\n * Phase 1: integer/float literals, arithmetic, comparisons, boolean\n * logic, locals, direct calls, address-of/deref, casts, sizeof. Returns\n * the IrValue* for the expression; null on void/unhandled. Unhandled\n * forms report G0001. Callee resolution goes through the sema scope\n * stack (lookupFrom) → declId → the collection pass's fn map — no\n * per-reference re-mangling, no linear decl scans. */\nuse lower { Wv, wvNode, wvErr, wvStr, wvResolved, wvSubstTy, wvFindLocal,\n               wvLocalTy, wvSlotTy,\n               wvPushLocal, wvFnMapGet, wvFnMapPut, wvGMapGet, wvGMapPut, wvBlock,\n               wvSetBlock, wvTerm, wvPos, wvArr, wvMbCh, wvMbStr,\n               WvNameEnt, wvNamesFind, wvTypeInstanceName };\nuse types { wvTy, wvFindTypeDecl, wvTyHasParam };\nuse decl { wvMangle, wvDeclareFunc, wvDeclareMethod, wvMethodSelfKind,\n               wvOwnerStr, wvMethodMangle, wvMethodMangleEx };\nuse stmt;\nuse context::context { AstContext };\nuse mono::mono { MonoContext, MonoInstance, MonoInstanceKind };\nuse sem { scope { Symbol, ScopeStack } };\nuse ast {\n    id { Str, NodeId, locFile },\n    types { Ty, TypeEntry, TypeKind },\n    node { Node, NodeKind },\n    expr { Expr, ExprKind, builtinImplHash,\n           BUILTIN_ASSERT, BUILTIN_ASSERTOUT, BUILTIN_PANIC, BUILTIN_UNREACHABLE,\n           BUILTIN_REPORT, BUILTIN_REPORTHEX, BUILTIN_ABORTNOW, BUILTIN_ASSERTEQ,\n           BUILTIN_ASSERTNE, BUILTIN_ASSERTLT, BUILTIN_ASSERTLE, BUILTIN_ASSERTGT,\n           BUILTIN_ASSERTGE, BUILTIN_ASSERTRANGE, BUILTIN_ASSERTNONNULL,\n           BUILTIN_ASSERTALIGNED, BUILTIN_BACKTRACETO },\n    stmt { Stmt, StmtKind, SwitchCase },\n    decl { Decl, DeclKind, Field, Param, File }\n};\nuse common::slice { Slice };\nimport wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrValue, IrValueKind, IrType, IrTypeKind, IrInst, IrStringConst, IrGlobal };\nimport wallvm::irOps { IrICmpPred, IrFCmpPred };\nimport wallvm::irBuilder { IrBuilder };\nimport std::mman { alloc, dealloc, copy, zero };\nimport platform::libc { strtod };\nimport core::cchar { cchar };\n\n/* builder ops return IrInst*; the SSA value is the instruction's base */\npub IrValue* wvV(IrInst* inst) { return inst != null ? &inst->base : null; }\n\n/* is the resolved Coral type an unsigned integer? (drives signedness of\n * div/rem/shr/casts — wallvm IrType carries no signed flag) */\npub bool wvTyUnsigned(Wv* w, Ty t)\n{\n    Ty rt = wvResolved(w, t);\n    if (rt == 0) return false;\n    TypeEntry* te = w->ctx->types + rt;\n    switch (te->kind.tag)\n    {\n        TypeKind::U8 | TypeKind::U16 | TypeKind::U32 | TypeKind::U64 |\n        TypeKind::U128 | TypeKind::Usize | TypeKind::Char | TypeKind::Bool =>\n            { return true; },\n        else => { return false; },\n    }\n}\n\n// pub IrValue* wvExpr(Wv* w, NodeId id);\n\n\n/* the silent half of callee resolution: sema scope lookup → declId →\n * the collection pass's IrFunc, or a shell for an extern the pass never\n * saw. Null when the name is not a function at all — callers that probe\n * (a value that may be a function or a variable) must not report. */\npub IrFunc* wvLookupFunc(Wv* w, Str name, NodeId refSite)\n{\n    if (name == 0) return null;\n    u32 refFile = 0;\n    if (refSite.index != 0)\n    {\n        Node* rn = wvNode(w, refSite);\n        refFile = locFile(rn->loc);\n    }\n    if (w->sema == null || w->sema->scopes == null) return null;\n    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);\n    if (sym == null || sym->declaration.index == 0) return null;\n    /* generic templates never get a shell: their calls resolve through\n     * the mono instance pick, and probes must not mint one */\n    if (w->mono != null && w->mono->genericCount(sym->declaration) != 0) return null;\n    IrFunc* f = wvFnMapGet(w, sym->declaration.index);\n    if (f != null) return f;\n    Node* sn = wvNode(w, sym->declaration);\n    if (sn->kind.tag == NodeKind::Decl)\n    {\n        Decl* sd = &sn->kind.payload.Decl.value;\n        if (sd->kind.tag == DeclKind::Func)\n        {\n            IrFunc* shell = wvDeclareFunc(w, sym->declaration, sd);\n            /* keep the shell: a second reference reuses it instead of\n             * minting another IrFunc of the same symbol */\n            if (shell != null) wvFnMapPut(w, sym->declaration.index, shell);\n            return shell;\n        }\n    }\n    return null;\n}\n\n/* the Func decl named `name` declared in file `refFile` (first match\n * when the file has none) — the module-qualified call's lookup, after\n * cgFindDeclFrom. */\nNodeId wvFindFuncDeclFrom(Wv* w, Str name, u32 refFile)\n{\n    NodeId first;\n    first.index = 0;\n    if (w->file == null || name == 0) return first;\n    File* file = w->file;\n    u32 i = 0;\n    while (i < file->declsLen)\n    {\n        NodeId id = file->decls[i];\n        Node* n = wvNode(w, id);\n        if (n->kind.tag == NodeKind::Decl &&\n            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        {\n            Decl* dd = &n->kind.payload.Decl.value;\n            if (dd->kind.payload.Func.name == name)\n            {\n                if (refFile != 0 && locFile(n->loc) == refFile) return id;\n                if (first.index == 0) first = id;\n            }\n        }\n        i++;\n    }\n    return first;\n}\n\n/* a module path (`std::fs`) → the diagnostic file id of its source:\n * `::` becomes `/`, `.crl` is appended when missing, then suffix-matched\n * against sema's file table (mirror of cgFileForModulePath). */\nu32 wvFileForModulePath(Wv* w, Str path)\n{\n    if (path == 0 || w->sema == null || w->sema->diag == null) return 0;\n    if (w->sema->diag->fileCount == 0) return 0;\n    str p = wvStr(w, path);\n    if (p.len == 0) return 0;\n    bool hasCrl = p.len >= 4 && p.ptr[p.len - 4] == 46 && p.ptr[p.len - 3] == 99 &&\n                  p.ptr[p.len - 2] == 114 && p.ptr[p.len - 1] == 108;\n    usize dc = 0;\n    usize c = 0;\n    while (c + 1 < p.len)\n    {\n        if (p.ptr[c] == 58 && p.ptr[c + 1] == 58) dc++;\n        c++;\n    }\n    usize n = p.len - dc + (hasCrl ? 0 : 4);\n    u8* buf = (u8*)wvArr(w, n, 1);\n    if (buf == null) return 0;\n    usize j = 0;\n    usize k = 0;\n    while (j < p.len)\n    {\n        if (j + 1 < p.len && p.ptr[j] == 58 && p.ptr[j + 1] == 58)\n            { buf[k] = 47; k++; j += 2; } // \"::\" → '/'\n        else { buf[k] = p.ptr[j]; k++; j++; }\n    }\n    if (!hasCrl) { buf[k] = 46; buf[k + 1] = 99; buf[k + 2] = 114; buf[k + 3] = 108; }\n    u32 f = 0;\n    while (f < w->sema->diag->fileCount)\n    {\n        str fp = w->sema->diag->filePaths.at((usize)f);\n        if (fp.ptr != null && fp.len >= n)\n        {\n            bool ok = true;\n            usize q = 0;\n            while (q < n)\n            {\n                if (fp.ptr[fp.len - n + q] != buf[q]) { ok = false; break; }\n                q++;\n            }\n            if (ok) return f;\n        }\n        f++;\n    }\n    return 0;\n}\n\n/* `root::name(...)`: resolve through the module namespace the root\n * names — use symbol → its source file → the Func declared there.\n * Null when the root is not a module (the caller tries the next form). */\nIrFunc* wvLookupPathModule(Wv* w, Str root, Str fname, NodeId refSite)\n{\n    if (root == 0 || fname == 0 || w->sema == null || w->sema->scopes == null) return null;\n    u32 refFile = 0;\n    if (refSite.index != 0)\n    {\n        Node* rn = wvNode(w, refSite);\n        refFile = locFile(rn->loc);\n    }\n    Symbol* rsym = w->sema->scopes->lookupFrom(root, refFile);\n    if (rsym == null || rsym->kind != 5 || rsym->declaration.index == 0) return null;\n    Node* imn = wvNode(w, rsym->declaration);\n    if (imn->kind.tag != NodeKind::Decl) return null;\n    Decl* imd = &imn->kind.payload.Decl.value;\n    Str mpath = 0;\n    if (imd->kind.tag == DeclKind::Import) mpath = imd->kind.payload.Import.path;\n    else if (imd->kind.tag == DeclKind::ModReexport) mpath = imd->kind.payload.ModReexport.path;\n    else return null;\n    u32 mf = wvFileForModulePath(w, mpath);\n    if (mf == 0) return null;\n    NodeId md = wvFindFuncDeclFrom(w, fname, mf);\n    if (md.index == 0) return null;\n    if (w->mono != null && w->mono->genericCount(md) != 0) return null;\n    IrFunc* f = wvFnMapGet(w, md.index);\n    if (f != null) return f;\n    Node* fdn = wvNode(w, md);\n    if (fdn->kind.tag != NodeKind::Decl) return null;\n    Decl* fd = &fdn->kind.payload.Decl.value;\n    if (fd->kind.tag != DeclKind::Func) return null;\n    f = wvDeclareFunc(w, md, fd);\n    if (f == null) return null;\n    w->module->addFunc(f);\n    wvFnMapPut(w, md.index, f);\n    return f;\n}\n\n/* `Owner::method(...)`: the declaring node of a method whose owner\n * text matches (the def side composes the same `owner_method` symbol).\n * Generic owners are skipped — mono does not reach methods yet. */\npub NodeId wvFindMethodDeclOwner(Wv* w, Str owner, Str methName)\n{\n    NodeId none;\n    none.index = 0;\n    if (owner == 0 || methName == 0 || w->file == null) return none;\n    File* file = w->file;\n    u32 i = 0;\n    while (i < file->declsLen)\n    {\n        Node* d = wvNode(w, file->decls[i]);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            Str ow = 0;\n            NodeId* methods = null;\n            u32 mlen = 0;\n            if (dd->kind.tag == DeclKind::Struct)\n            {\n                if (dd->kind.payload.Struct.genericParamsLen != 0) { i++; continue; }\n                ow = dd->kind.payload.Struct.name;\n                methods = dd->kind.payload.Struct.methods;\n                mlen = dd->kind.payload.Struct.methodsLen;\n            }\n            else if (dd->kind.tag == DeclKind::Union)\n            {\n                if (dd->kind.payload.Union.genericParamsLen != 0) { i++; continue; }\n                ow = dd->kind.payload.Union.name;\n                methods = dd->kind.payload.Union.methods;\n                mlen = dd->kind.payload.Union.methodsLen;\n            }\n            else if (dd->kind.tag == DeclKind::Variant)\n            {\n                if (dd->kind.payload.Variant.genericParamsLen != 0) { i++; continue; }\n                ow = dd->kind.payload.Variant.name;\n                methods = dd->kind.payload.Variant.methods;\n                mlen = dd->kind.payload.Variant.methodsLen;\n            }\n            else if (dd->kind.tag == DeclKind::Extend)\n            {\n                if (dd->kind.payload.Extend.genericParamsLen != 0) { i++; continue; }\n                if (wvTyHasParam(w, dd->kind.payload.Extend.selfType, 0)) { i++; continue; }\n                ow = wvOwnerStr(w, dd->kind.payload.Extend.selfType);\n                methods = dd->kind.payload.Extend.methods;\n                mlen = dd->kind.payload.Extend.methodsLen;\n            }\n            else if (dd->kind.tag == DeclKind::ExtendTrait)\n            {\n                if (dd->kind.payload.ExtendTrait.genericParamsLen != 0) { i++; continue; }\n                if (wvTyHasParam(w, dd->kind.payload.ExtendTrait.selfType, 0)) { i++; continue; }\n                ow = wvOwnerStr(w, dd->kind.payload.ExtendTrait.selfType);\n                methods = dd->kind.payload.ExtendTrait.methods;\n                mlen = dd->kind.payload.ExtendTrait.methodsLen;\n            }\n            else { i++; continue; }\n            if (ow == owner && methods != null)\n            {\n                u32 m = 0;\n                while (m < mlen)\n                {\n                    Node* mn = wvNode(w, methods[m]);\n                    if (mn->kind.tag == NodeKind::Decl &&\n                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&\n                        mn->kind.payload.Decl.value.kind.payload.Func.name == methName)\n                        return methods[m];\n                    m++;\n                }\n            }\n        }\n        i++;\n    }\n    /* monomorphised owner (`Vec_i32`): the instance's type decl plus\n     * every extend its self type matches; mirrors cgFindMethodDeclOwner\n     * phases 2/3 — one mdef serves every instance, the names table binds\n     * the per-instance symbols */\n    if (w->mono != null)\n    {\n        u32 ii = 0;\n        while (ii < w->mono->instancesLen)\n        {\n            MonoInstance* inst = w->mono->instances + ii;\n            if (inst->kind == MonoInstanceKind::TypeInstance &&\n                wvTypeInstanceName(w, inst->name, inst->arguments,\n                                   inst->argumentsLen) == owner)\n            {\n                Node* dn = wvNode(w, inst->declaration);\n                if (dn->kind.tag == NodeKind::Decl)\n                {\n                    Decl* td = &dn->kind.payload.Decl.value;\n                    NodeId* methods = null;\n                    u32 mlen = 0;\n                    if (td->kind.tag == DeclKind::Struct)\n                        { methods = td->kind.payload.Struct.methods; mlen = td->kind.payload.Struct.methodsLen; }\n                    else if (td->kind.tag == DeclKind::Union)\n                        { methods = td->kind.payload.Union.methods; mlen = td->kind.payload.Union.methodsLen; }\n                    else if (td->kind.tag == DeclKind::Variant)\n                        { methods = td->kind.payload.Variant.methods; mlen = td->kind.payload.Variant.methodsLen; }\n                    u32 m = 0;\n                    while (methods != null && m < mlen)\n                    {\n                        Node* mn = wvNode(w, methods[m]);\n                        if (mn->kind.tag == NodeKind::Decl &&\n                            mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&\n                            mn->kind.payload.Decl.value.kind.payload.Func.name == methName)\n                            return methods[m];\n                        m++;\n                    }\n                }\n                u32 d = 0;\n                while (d < file->declsLen)\n                {\n                    Node* dn2 = wvNode(w, file->decls[d]);\n                    if (dn2->kind.tag == NodeKind::Decl)\n                    {\n                        Decl* xd = &dn2->kind.payload.Decl.value;\n                        NodeId* em = null;\n                        u32 eml = 0;\n                        if (xd->kind.tag == DeclKind::Extend &&\n                            wvSelfTyMatches(w, xd->kind.payload.Extend.selfType,\n                                            inst->name, inst->arguments, inst->argumentsLen))\n                            { em = xd->kind.payload.Extend.methods; eml = xd->kind.payload.Extend.methodsLen; }\n                        else if (xd->kind.tag == DeclKind::ExtendTrait &&\n                                 wvSelfTyMatches(w, xd->kind.payload.ExtendTrait.selfType,\n                                                 inst->name, inst->arguments, inst->argumentsLen))\n                            { em = xd->kind.payload.ExtendTrait.methods; eml = xd->kind.payload.ExtendTrait.methodsLen; }\n                        u32 m = 0;\n                        while (em != null && m < eml)\n                        {\n                            Node* mn = wvNode(w, em[m]);\n                            if (mn->kind.tag == NodeKind::Decl &&\n                                mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&\n                                mn->kind.payload.Decl.value.kind.payload.Func.name == methName)\n                                return em[m];\n                            m++;\n                        }\n                    }\n                    d++;\n                }\n            }\n            ii++;\n        }\n    }\n    return none;\n}\n\n/* does an extend's self type match the type instance `instName<args…>`?\n * Mirrors the C backend's cgSelfTyMatches: the self type must be Named\n * with the same owner name and arity, and each self-type arg is either\n * a type param (matches any instance arg) or exactly the instance arg. */\npub bool wvSelfTyMatches(Wv* w, Ty selfTy, Str instName, Ty* args, u32 argsLen)\n{\n    if (selfTy == 0 || instName == 0) return false;\n    Ty t = wvUnwrapTy(w, selfTy);\n    if (t == 0) return false;\n    TypeEntry* te = w->ctx->types + t;\n    if (te->kind.tag != TypeKind::Named) return false;\n    if (te->kind.payload.Named.name != instName) return false;\n    if (te->kind.payload.Named.genericArgsLen != argsLen) return false;\n    u32 i = 0;\n    while (i < argsLen)\n    {\n        Ty a = te->kind.payload.Named.genericArgs[i];\n        if ((w->ctx->types + a)->kind.tag == TypeKind::TypeParam) { i++; continue; }\n        if (!w->sema->sameType(a, args[i])) return false;\n        i++;\n    }\n    return true;\n}\n\n/* a `root::name(...)` callee: module function, then static method on\n * an owner type, then the bare name as a last resort (the order the C\n * backend resolves in). Null only after the last form also fails to\n * name a function — that failure is reported by the bare resolver. */\nIrFunc* wvResolveCalleePath(Wv* w, NodeId calleeId, NodeId refSite, NodeId* args, u32 argsLen)\n{\n    Node* cn = wvNode(w, calleeId);\n    if (cn->kind.tag != NodeKind::Expr) return null;\n    Expr* ce = &cn->kind.payload.Expr.value;\n    NodeId* segs = ce->kind.payload.Path.segments;\n    u32 sn = ce->kind.payload.Path.segmentsLen;\n    if (sn == 0) return null;\n    if (sn >= 2)\n    {\n        Node* s0 = wvNode(w, segs[0]);\n        Node* sl = wvNode(w, segs[sn - 1]);\n        if (s0->kind.tag == NodeKind::Expr && sl->kind.tag == NodeKind::Expr &&\n            s0->kind.payload.Expr.value.kind.tag == ExprKind::Ident &&\n            sl->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n        {\n            Str root = s0->kind.payload.Expr.value.kind.payload.Ident.name;\n            Str fname = sl->kind.payload.Expr.value.kind.payload.Ident.name;\n            IrFunc* f = wvLookupPathModule(w, root, fname, refSite);\n            if (f != null) return f;\n            NodeId mdef = wvFindMethodDeclOwner(w, root, fname);\n            if (mdef.index != 0)\n            {\n                if (w->mono != null && w->mono->genericCount(mdef) != 0)\n                    { wvErr(w, refSite, \"call to a generic method (Phase 2)\"); return null; }\n                if (wvMethodSelfKind(w, mdef) != 0)\n                    { wvErr(w, refSite, \"instance method needs a receiver expression\"); return null; }\n                str msym = wvMethodMangle(w, mdef, root, fname);\n                if (msym.len == 0) return null;\n                /* the names table first: it is the one binding whose key\n                 * differs per instance (the fn map is keyed by declId and\n                 * one mdef is shared by every instance of the type) */\n                if (w->names != null)\n                {\n                    WvNameEnt* ent = wvNamesFind(w->names, msym);\n                    if (ent != null && ent->f != null) return ent->f;\n                }\n                f = wvFnMapGet(w, mdef.index);\n                if (f != null) return f;\n                Node* mn = wvNode(w, mdef);\n                if (mn->kind.tag != NodeKind::Decl) return null;\n                Decl* md = &mn->kind.payload.Decl.value;\n                if (md->kind.tag != DeclKind::Func) return null;\n                f = wvDeclareMethod(w, mdef, md, msym, null);\n                if (f == null) return null;\n                w->module->addFunc(f);\n                wvFnMapPut(w, mdef.index, f);\n                return f;\n            }\n        }\n        else if (s0->kind.tag == NodeKind::Expr && s0->kind.payload.Expr.value.kind.tag == ExprKind::TypeRef &&\n                 sl->kind.tag == NodeKind::Expr && sl->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n        {\n            /* static method on a generic instance: `Foo<i32>::new(...)` —\n             * owner = the composed instance name (mirror cgResolveCall's\n             * TypeRef-root arm); its sweep-declared shell lives in the\n             * names table under `<instance>_<method>` */\n            Str fname = sl->kind.payload.Expr.value.kind.payload.Ident.name;\n            Str owner = wvOwnerStr(w, s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode);\n            if (owner != 0)\n            {\n                NodeId mdef = wvFindMethodDeclOwner(w, owner, fname);\n                if (mdef.index != 0)\n                {\n                    if (w->mono != null && w->mono->genericCount(mdef) != 0)\n                        { wvErr(w, refSite, \"call to a generic method (Phase 2)\"); return null; }\n                    if (wvMethodSelfKind(w, mdef) != 0)\n                        { wvErr(w, refSite, \"instance method needs a receiver expression\"); return null; }\n                    str msym = wvMethodMangleEx(w, mdef, owner,\n                                                s0->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,\n                                                null, 0, fname);\n                    if (msym.len == 0) return null;\n                    if (w->names != null)\n                    {\n                        WvNameEnt* ent = wvNamesFind(w->names, msym);\n                        if (ent != null && ent->f != null) return ent->f;\n                    }\n                    /* every reachable instance method was declared by the\n                     * sweep: declaring ad hoc here would let the declId-keyed\n                     * fn map bind one instance's shell for all its siblings */\n                    wvErr(w, refSite, \"instance method was not declared (method sweep gap)\");\n                    return null;\n                }\n            }\n            /* no such method — the bare last-segment form answers below */\n        }\n    }\n    /* last segment as a plain name */\n    Node* sl2 = wvNode(w, segs[sn - 1]);\n    if (sl2->kind.tag == NodeKind::Expr &&\n        sl2->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n        return wvResolveCallee(w, sl2->kind.payload.Expr.value.kind.payload.Ident.name,\n                               refSite, args, argsLen);\n    return null;\n}\n\n/* the mono FunctionInstance of declId whose collected argument types and\n * Zig-style value key match this call site (mirror of cgCallFromDecl).\n * Reports and returns null when no unique instance applies. */\nIrFunc* wvPickInstanceForDecl(Wv* w, NodeId declId, NodeId* args, u32 argsLen, NodeId refSite)\n{\n    if (w->mono == null || w->sema == null) return null;\n    if (args == null)\n    {\n        wvErr(w, refSite, \"call to a generic function (Phase 2)\");\n        return null;\n    }\n    u64 callKey = w->mono->callValueKeyTyped(args, argsLen, w->subs, w->subsLen);\n    u32 gcount = w->mono->genericCount(declId);\n    Ty* want = null;\n    if (gcount > 0)\n    {\n        want = alloc<Ty>((usize)gcount);\n        if (want == null) { wvErr(w, refSite, \"out of memory resolving generic call\"); return null; }\n        zero<Ty>(want, (usize)gcount);\n        w->mono->inferCallArgs(declId, args, argsLen, w->subs, w->subsLen, want);\n    }\n    u32 total = 0;\n    u32 firstTotal = 0;\n    u32 keyPick = 0;\n    u32 typePick = 0;\n    u32 typeMatches = 0;\n    u32 i = 0;\n    while (i < w->mono->instancesLen)\n    {\n        MonoInstance* inst = w->mono->instances + i;\n        if (inst->kind == MonoInstanceKind::FunctionInstance && inst->declaration.index == declId.index)\n        {\n            if (total == 0) firstTotal = i;\n            total++;\n            bool ok = true;\n            if (inst->argumentsLen == gcount)\n            {\n                u32 k = 0;\n                while (k < gcount)\n                {\n                    if (want == null || want[k] == 0 ||\n                        !w->sema->sameType(want[k], inst->arguments[k])) { ok = false; break; }\n                    k++;\n                }\n            }\n            else\n                ok = false;\n            if (ok)\n            {\n                typeMatches++;\n                if (typePick == 0) typePick = i + 1;\n                if (keyPick == 0 && inst->valueKey == callKey) keyPick = i + 1;\n            }\n        }\n        i++;\n    }\n    if (want != null) dealloc<Ty>(want);\n    if (total == 0)\n    {\n        wvErr(w, refSite, \"no monomorphized instance for generic call (the call site was not collected)\");\n        return null;\n    }\n    u32 pick = firstTotal;\n    if (keyPick != 0) pick = keyPick - 1;\n    else if (typeMatches == 1 && w->mono->instances[typePick - 1].valueKey == 0) pick = typePick - 1;\n    else\n    {\n        wvErr(w, refSite, \"no unique mono instance for call\");\n        return null;\n    }\n    if (w->instFns == null || pick >= w->instFnsLen || w->instFns[pick] == null)\n    {\n        wvErr(w, refSite, \"mono instance was not lowered\");\n        return null;\n    }\n    return w->instFns[pick];\n}\n\n/* callee written with explicit type arguments (`f<T>(…)` — the parser\n * hands it over as ExprKind::TypeRef): pick the instance whose collected\n * arguments equal the written ones (resolved through any active\n * substitutions), preferring the exact value key. Mirror of\n * cgResolveGenericCall. */\nIrFunc* wvResolveGenericCall(Wv* w, Str fname, Ty namedTy, NodeId refSite,\n                             NodeId* args, u32 argsLen)\n{\n    if (w->mono == null || w->sema == null)\n    {\n        wvErr(w, refSite, \"no monomorphized instance for generic call (the call site was not collected)\");\n        return null;\n    }\n    Ty* gargs = null;\n    u32 glen = 0;\n    if (namedTy != 0)\n    {\n        TypeEntry* te = w->ctx->types + namedTy;\n        if (te->kind.tag == TypeKind::Named)\n        {\n            gargs = te->kind.payload.Named.genericArgs;\n            glen = te->kind.payload.Named.genericArgsLen;\n        }\n    }\n    Ty* gbuf = null;\n    if (glen > 0 && w->subs != null && w->subsLen > 0)\n    {\n        /* inside an instance body the written args may be the template's\n         * own params (`dealloc<T>` in realloc<cchar>): resolve them\n         * through the current substitutions before instance matching */\n        gbuf = alloc<Ty>((usize)glen);\n        if (gbuf != null)\n        {\n            u32 gi = 0;\n            while (gi < glen)\n            {\n                gbuf[gi] = w->mono->substituteType(gargs[gi], w->subs, w->subsLen);\n                gi++;\n            }\n            gargs = gbuf;\n        }\n    }\n    if (glen == 0)\n    {\n        if (gbuf != null) dealloc<Ty>(gbuf);\n        wvErr(w, refSite, \"generic call without type arguments\");\n        return null;\n    }\n    u64 wantKey = w->mono->callValueKeyTyped(args, argsLen, w->subs, w->subsLen);\n    /* the declaring file's decl owns the instance: resolve through sema\n     * like every other reference (name-based scan as the fallback) */\n    NodeId declId;\n    declId.index = 0;\n    u32 refFile = 0;\n    if (refSite.index != 0) refFile = locFile(wvNode(w, refSite)->loc);\n    if (fname != 0 && w->sema->scopes != null)\n    {\n        Symbol* sym = w->sema->scopes->lookupFrom(fname, refFile);\n        if (sym != null) declId = sym->declaration;\n    }\n    u32 pick = 0;\n    if (declId.index != 0)\n    {\n        u32 i = 0;\n        while (i < w->mono->instancesLen)\n        {\n            MonoInstance* inst = w->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance &&\n                inst->declaration.index == declId.index && inst->argumentsLen == glen)\n            {\n                bool ok = true;\n                u32 k = 0;\n                while (k < glen)\n                {\n                    if (!w->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }\n                    k++;\n                }\n                if (ok)\n                {\n                    if (pick == 0) pick = i + 1;\n                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }\n                }\n            }\n            i++;\n        }\n    }\n    if (pick == 0 && fname != 0)\n    {\n        u32 i = 0;\n        while (i < w->mono->instancesLen)\n        {\n            MonoInstance* inst = w->mono->instances + i;\n            if (inst->kind == MonoInstanceKind::FunctionInstance &&\n                inst->name == fname && inst->argumentsLen == glen)\n            {\n                bool ok = true;\n                u32 k = 0;\n                while (k < glen)\n                {\n                    if (!w->sema->sameType(inst->arguments[k], gargs[k])) { ok = false; break; }\n                    k++;\n                }\n                if (ok)\n                {\n                    if (pick == 0) pick = i + 1;\n                    if (wantKey != 0 && inst->valueKey == wantKey) { pick = i + 1; break; }\n                }\n            }\n            i++;\n        }\n    }\n    if (gbuf != null) dealloc<Ty>(gbuf);\n    if (pick == 0)\n    {\n        wvErr(w, refSite, \"no monomorphized instance for generic call (the call site was not collected)\");\n        return null;\n    }\n    if (w->instFns == null || pick - 1 >= w->instFnsLen || w->instFns[pick - 1] == null)\n    {\n        wvErr(w, refSite, \"mono instance was not lowered\");\n        return null;\n    }\n    return w->instFns[pick - 1];\n}\n\n/* resolve a bare-name call target. Null means the name is not a\n * function — reported here because every call site wants that said. */\npub IrFunc* wvResolveCallee(Wv* w, Str name, NodeId refSite, NodeId* args, u32 argsLen)\n{\n    if (name != 0 && w->mono != null && w->sema != null && w->sema->scopes != null)\n    {\n        u32 refFile = 0;\n        if (refSite.index != 0) refFile = locFile(wvNode(w, refSite)->loc);\n        Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);\n        if (sym != null && sym->declaration.index != 0 &&\n            w->mono->genericCount(sym->declaration) != 0)\n            return wvPickInstanceForDecl(w, sym->declaration, args, argsLen, refSite);\n    }\n    IrFunc* f = wvLookupFunc(w, name, refSite);\n    if (f == null) wvErr(w, refSite, \"unresolved call target\");\n    return f;\n}\n\n/* resolve a bare name to a file-scope constant declaration: sema scope\n * lookup (the same walk calls use) → declId, kept only when it really\n * is a constant. Null when the name is not one — the caller decides\n * whether that is an error or falls through to another resolution. */\npub NodeId wvResolveConst(Wv* w, Str name, NodeId refSite)\n{\n    NodeId none;\n    none.index = 0;\n    if (name == 0 || w->sema == null || w->sema->scopes == null) return none;\n    u32 refFile = 0;\n    if (refSite.index != 0)\n    {\n        Node* rn = wvNode(w, refSite);\n        refFile = locFile(rn->loc);\n    }\n    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);\n    if (sym == null || sym->declaration.index == 0) return none;\n    Node* sn = wvNode(w, sym->declaration);\n    if (sn->kind.tag != NodeKind::Decl) return none;\n    if (sn->kind.payload.Decl.value.kind.tag != DeclKind::Constant) return none;\n    /* a name that keeps storage (`var`, `static`, `extern`) is not a\n     * value to fold — references reach its global through the map */\n    if ((sn->kind.payload.Decl.value.kind.payload.Constant.flags & 16) == 0) return none;\n    return sym->declaration;\n}\n\n/* a name that keeps storage → its address value. The collection pass\n * registered one IrGlobal per declaring node, so the sema symbol's\n * declaration indexes straight into that map. */\npub IrValue* wvResolveGlobal(Wv* w, Str name, NodeId refSite)\n{\n    if (name == 0 || w->sema == null || w->sema->scopes == null) return null;\n    u32 refFile = 0;\n    if (refSite.index != 0)\n    {\n        Node* rn = wvNode(w, refSite);\n        refFile = locFile(rn->loc);\n    }\n    Symbol* sym = w->sema->scopes->lookupFrom(name, refFile);\n    if (sym == null || sym->declaration.index == 0) return null;\n    IrGlobal* g = wvGMapGet(w, sym->declaration.index);\n    if (g == null) return null;\n    return &g->base;\n}\n\n/* strtod over a NUL-terminated arena copy of the literal text */\npub f64 wvParseFloat(Wv* w, Str value)\n{\n    str sv = wvStr(w, value);\n    if (w->arena == null) return 0;\n    rawptr buf = w->arena->alloc(sv.len + 1, 1);\n    if (buf == null) return 0;\n    u8* bp = (u8*)buf;\n    usize i = 0;\n    while (i < sv.len) { bp[i] = sv.ptr[i]; i++; }\n    bp[sv.len] = 0;\n    return strtod((const cchar*)bp, null);\n}\n\n/* the f64 a ConstFloat carries, read back out of its raw bits */\nf64 wvConstFloatBits(IrValue* v)\n{\n    f64 d = 0;\n    copy<u8>((u8*)&d, (u8*)&v->valData, 8);\n    return d;\n}\n\n// pub IrValue* wvConstInit(Wv* w, NodeId initId, IrType* dt);\n\n/* fold an initializer and read it back as an integer / an f64. Both\n * answer false without touching `out` when the node does not fold that\n * way — the caller then reports. */\nbool wvConstU64(Wv* w, NodeId id, IrType* dt, u64* out)\n{\n    IrValue* v = wvConstInit(w, id, dt);\n    if (v == null || v->kind != IrValueKind::ConstInt) return false;\n    *out = v->valData;\n    return true;\n}\n\nbool wvConstF64(Wv* w, NodeId id, IrType* dt, f64* out)\n{\n    IrValue* v = wvConstInit(w, id, dt);\n    if (v == null || v->kind != IrValueKind::ConstFloat) return false;\n    *out = wvConstFloatBits(v);\n    return true;\n}\n\n/* compile-time initializer for static storage: literals, their negation\n * and a cast over either fold into an IrValue of the storage's own type;\n * anything else would need code at load time (Phase 3). */\npub IrValue* wvConstInit(Wv* w, NodeId initId, IrType* dt)\n{\n    if (initId.index == 0 || dt == null) return null;\n    Node* n = wvNode(w, initId);\n    if (n->kind.tag != NodeKind::Expr)\n    {\n        wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\");\n        return null;\n    }\n    Expr* e = &n->kind.payload.Expr.value;\n    switch (e->kind.tag)\n    {\n        ExprKind::IntLit => { return w->ir->constInt(dt, e->kind.payload.IntLit.value); },\n        ExprKind::BoolLit => {\n            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;\n            return w->ir->constInt(dt, v);\n        },\n        ExprKind::CharLit => { return w->ir->constInt(dt, (u64)e->kind.payload.CharLit.value); },\n        ExprKind::NullLit => { return w->ir->constInt(dt, 0); },\n        ExprKind::FloatLit => {\n            return w->ir->constFloat(dt, wvParseFloat(w, e->kind.payload.FloatLit.value));\n        },\n        ExprKind::Neg => {\n            IrValue* v = wvConstInit(w, e->kind.payload.Neg.expr, dt);\n            if (v == null) return null;\n            if (v->kind == IrValueKind::ConstFloat)\n            {\n                f64 d = 0;\n                copy<u8>((u8*)&d, (u8*)&v->valData, 8);\n                return w->ir->constFloat(dt, -d);\n            }\n            return w->ir->constInt(dt, (u64)(0 - (i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL)));\n        },\n        ExprKind::Ident => {\n            Str name = e->kind.payload.Ident.name;\n            /* a function reference is its symbol address */\n            IrFunc* f = wvLookupFunc(w, name, initId);\n            if (f != null) return &f->base;\n            /* another name that keeps storage: its address */\n            IrValue* gv = wvResolveGlobal(w, name, initId);\n            if (gv != null) return gv;\n            /* a plain constant folds to its own initializer */\n            NodeId cd = wvResolveConst(w, name, initId);\n            if (cd.index != 0)\n            {\n                Node* cn = wvNode(w, cd);\n                NodeId inner = cn->kind.payload.Decl.value.kind.payload.Constant.value;\n                if (inner.index != 0) return wvConstInit(w, inner, dt);\n            }\n            wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\");\n            return null;\n        },\n        ExprKind::StringLit => {\n            str tok = wvStr(w, e->kind.payload.StringLit.value);\n            bool isC = (e->kind.payload.StringLit.flags & 1) != 0;\n            usize begin = 0;\n            usize end = tok.len;\n            if (isC)\n            {\n                if (tok.len >= 3 && tok.ptr[0] == 67 && tok.ptr[1] == 34)\n                    { begin = 2; end = tok.len - 1; }\n            }\n            else if (tok.len >= 2 && tok.ptr[0] == 34)\n                { begin = 1; end = tok.len - 1; }\n            u8* buf = (u8*)wvArr(w, (end - begin) + 4, 1);\n            if (buf == null) { wvErr(w, initId, \"string literal buffer\"); return null; }\n            usize dlen = wvDecodeLit(tok, begin, end, buf);\n            str bytes = str::fromParts(buf, dlen);\n            IrStringConst* sc = w->module->findConstString(bytes, (u32)dlen);\n            if (sc == null)\n            {\n                sc = w->ir->createStringConst(bytes, (u32)dlen);\n                if (sc == null) { wvErr(w, initId, \"string constant creation failed\"); return null; }\n                w->module->addConstString(sc);\n            }\n            if (isC) return &sc->base;\n            /* a `str` is { ptr, len } laid out statically */\n            Ty rt = wvResolved(w, e->resolvedType);\n            IrType* st = rt != 0 ? wvTy(w, rt, 0) : null;\n            if (st == null || st->kind != IrTypeKind::Struct)\n                { wvErr(w, initId, \"str literal needs the str type\"); return null; }\n            IrValue*[2] parts;\n            parts[0] = &sc->base;\n            parts[1] = w->ir->constInt(w->ir->tyInt(64), (u64)dlen);\n            return w->ir->createStructConst(st, parts, 2);\n        },\n        ExprKind::StructLiteral => {\n            if (e->kind.payload.StructLiteral.variantName != 0)\n                { wvErr(w, initId, \"variant construction in static storage (Phase 3)\"); return null; }\n            Ty stw = wvResolved(w, e->kind.payload.StructLiteral.typeNode);\n            /* the storage's own type decides the layout; the literal's\n             * type node only gives the field names their order */\n            IrType* irt = dt->kind == IrTypeKind::Struct ? dt\n                          : (stw != 0 ? wvTy(w, stw, 0) : null);\n            if (irt == null || irt->kind != IrTypeKind::Struct)\n                { wvErr(w, initId, \"struct literal needs a struct type\"); return null; }\n            u32 n = irt->nparams;\n            IrValue** fields = (IrValue**)wvArr(w, (usize)n, 8);\n            if (fields == null) return null;\n            u32 z = 0;\n            while (z < n) { fields[z] = null; z++; }\n            u32 i = 0;\n            u32 m = e->kind.payload.StructLiteral.fieldValuesLen;\n            Str* fnames = e->kind.payload.StructLiteral.fieldNames;\n            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;\n            while (i < m)\n            {\n                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }\n                u32 fi = wvFieldIdx(w, stw, fnames[i]);\n                if (fi == 0xFFFFFFFF || fi >= n)\n                    { wvErr(w, initId, \"unknown struct literal field\"); return null; }\n                fields[fi] = wvConstInit(w, fvals[i], irt->params[fi]);\n                i++;\n            }\n            return w->ir->createStructConst(irt, fields, n);\n        },\n        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {\n            IrType* irt = dt;\n            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))\n                { wvErr(w, initId, \"aggregate literal needs an aggregate type\"); return null; }\n            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral\n                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;\n            u32 cnt = e->kind.tag == ExprKind::ArrayLiteral\n                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;\n            u32 cap = irt->kind == IrTypeKind::Array ? (irt->count > 0 ? irt->count : cnt) : irt->nparams;\n            if (cap < cnt) cap = cnt;\n            IrValue** evs = (IrValue**)wvArr(w, (usize)cap, 8);\n            if (evs == null) return null;\n            u32 i = 0;\n            while (i < cap)\n            {\n                evs[i] = null;\n                i++;\n            }\n            i = 0;\n            while (i < cnt && elems != null)\n            {\n                if (elems[i].index != 0)\n                {\n                    IrType* et = irt->kind == IrTypeKind::Array ? irt->elem\n                        : (i < irt->nparams ? irt->params[i] : null);\n                    if (et != null) evs[i] = wvConstInit(w, elems[i], et);\n                }\n                i++;\n            }\n            if (irt->kind == IrTypeKind::Array) return w->ir->constArray(irt, evs, cnt);\n            return w->ir->createStructConst(irt, evs, cap);\n        },\n        ExprKind::Sizeof => {\n            Ty st = wvResolved(w, e->kind.payload.Sizeof.targetType);\n            IrType* stt = st != 0 ? wvTy(w, st, 0) : null;\n            if (stt == null) { wvErr(w, initId, \"sizeof of an unknown type in an initializer\"); return null; }\n            return w->ir->constInt(dt, (u64)w->ir->irTypeSizeOf(stt));\n        },\n        ExprKind::Alignof => {\n            Ty st = wvResolved(w, e->kind.payload.Alignof.targetType);\n            IrType* stt = st != 0 ? wvTy(w, st, 0) : null;\n            if (stt == null) { wvErr(w, initId, \"alignof of an unknown type in an initializer\"); return null; }\n            u32 al = w->ir->irTypeAlignOf(stt);\n            if (al == 0) al = 1;\n            return w->ir->constInt(dt, (u64)al);\n        },\n        ExprKind::Cast => {\n            IrValue* v = wvConstInit(w, e->kind.payload.Cast.expr, dt);\n            if (v == null) return null;\n            /* both sides already carry the storage's type: only a float\n             * narrowed to an integer needs an actual conversion */\n            if (v->kind == IrValueKind::ConstFloat && dt->kind != IrTypeKind::Float)\n            {\n                f64 d = 0;\n                copy<u8>((u8*)&d, (u8*)&v->valData, 8);\n                return w->ir->constInt(dt, (u64)(i64)d);\n            }\n            if (v->kind == IrValueKind::ConstFloat) return w->ir->constFloat(dt, wvConstFloatBits(v));\n            if (dt->kind == IrTypeKind::Float)\n                return w->ir->constFloat(dt, (f64)(i64)(v->valData & 0xFFFFFFFFFFFFFFFFUL));\n            return w->ir->constInt(dt, v->valData);\n        },\n        ExprKind::BitNot | ExprKind::Not => {\n            if (dt->kind != IrTypeKind::Int)\n                { wvErr(w, initId, \"bitwise not of a non-integer constant (Phase 3)\"); return null; }\n            NodeId inner = e->kind.tag == ExprKind::BitNot\n                ? e->kind.payload.BitNot.expr : e->kind.payload.Not.expr;\n            u64 v = 0;\n            if (!wvConstU64(w, inner, dt, &v))\n                { wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\"); return null; }\n            if (e->kind.tag == ExprKind::BitNot) return w->ir->constInt(dt, ~v);\n            return w->ir->constInt(dt, v == 0 ? 1 : 0);\n        },\n        ExprKind::Add | ExprKind::Sub | ExprKind::Mul | ExprKind::Div |\n        ExprKind::Mod | ExprKind::BitAnd | ExprKind::BitOr | ExprKind::BitXor |\n        ExprKind::Shl | ExprKind::Shr | ExprKind::And | ExprKind::Or => {\n            NodeId lid = e->kind.payload.Add.left;\n            NodeId rid = e->kind.payload.Add.right;\n            bool isArith = e->kind.tag == ExprKind::Add || e->kind.tag == ExprKind::Sub ||\n                           e->kind.tag == ExprKind::Mul || e->kind.tag == ExprKind::Div ||\n                           e->kind.tag == ExprKind::Mod;\n            if (dt->kind == IrTypeKind::Float)\n            {\n                if (!isArith || e->kind.tag == ExprKind::Mod)\n                    { wvErr(w, initId, \"operator has no constant float form (Phase 3)\"); return null; }\n                f64 a = 0;\n                f64 b = 0;\n                if (!wvConstF64(w, lid, dt, &a) || !wvConstF64(w, rid, dt, &b))\n                    { wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\"); return null; }\n                f64 r = 0;\n                if (e->kind.tag == ExprKind::Add) r = a + b;\n                else if (e->kind.tag == ExprKind::Sub) r = a - b;\n                else if (e->kind.tag == ExprKind::Mul) r = a * b;\n                else if (b != 0) r = a / b;\n                return w->ir->constFloat(dt, r);\n            }\n            if (dt->kind != IrTypeKind::Int)\n                { wvErr(w, initId, \"arithmetic on a non-numeric constant (Phase 3)\"); return null; }\n            u64 a = 0;\n            u64 b = 0;\n            if (!wvConstU64(w, lid, dt, &a) || !wvConstU64(w, rid, dt, &b))\n                { wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\"); return null; }\n            /* signedness comes from the expression's own resolved type:\n             * the IR type carries only a width */\n            Ty ct = wvResolved(w, e->resolvedType);\n            bool uns = ct != 0 && wvTyUnsigned(w, ct);\n            i32 k = e->kind.tag;\n            u64 r = 0;\n            if (k == ExprKind::Add) r = a + b;\n            else if (k == ExprKind::Sub) r = a - b;\n            else if (k == ExprKind::Mul) r = a * b;\n            else if (k == ExprKind::BitAnd) r = a & b;\n            else if (k == ExprKind::BitOr) r = a | b;\n            else if (k == ExprKind::BitXor) r = a ^ b;\n            else if (k == ExprKind::And) r = (a != 0 && b != 0) ? 1 : 0;\n            else if (k == ExprKind::Or) r = (a != 0 || b != 0) ? 1 : 0;\n            else if (k == ExprKind::Shl) r = b >= 64 ? 0 : (a << b);\n            else if (k == ExprKind::Shr)\n                r = b >= 64 ? (uns ? 0 : 0)\n                            : (uns ? (a >> b) : (u64)((i64)a >> (i64)b));\n            else if (k == ExprKind::Div || k == ExprKind::Mod)\n            {\n                if (b == 0)\n                    { wvErr(w, initId, \"division by zero in a constant expression\"); return null; }\n                if (uns) r = (k == ExprKind::Div) ? (a / b) : (a % b);\n                else\n                {\n                    i64 sa = (i64)a;\n                    i64 sb = (i64)b;\n                    r = (k == ExprKind::Div) ? (u64)(sa / sb) : (u64)(sa % sb);\n                }\n            }\n            return w->ir->constInt(dt, r);\n        },\n        else => {\n            wvErr(w, initId, \"initializer of static storage must be a constant (Phase 3)\");\n            return null;\n        },\n    }\n}\n\n/* static storage for one name: an IrGlobal registered under the\n * declaring node, typed as a pointer to the data so loads, stores and\n * geppes all reach it. `disambiguator` (0 for file scope) keeps two\n * same-named statics in one file from sharing a symbol. */\npub IrValue* wvMakeGlobal(Wv* w, NodeId declId, Str name, Ty vt, NodeId initId,\n                          bool isConst, bool isExtern, u32 disambiguator)\n{\n    IrGlobal* seen = wvGMapGet(w, declId.index);\n    if (seen != null) return &seen->base;\n    if (vt == 0 && initId.index != 0)\n    {\n        /* `const NAME = value;` carries no type node: take the type the\n         * initializer resolved to */\n        Node* in = wvNode(w, initId);\n        if (in->kind.tag == NodeKind::Expr)\n            vt = wvResolved(w, in->kind.payload.Expr.value.resolvedType);\n    }\n    IrType* dt = vt != 0 ? wvTy(w, vt, 0) : null;\n    if (dt == null || dt->kind == IrTypeKind::Void)\n    {\n        wvErr(w, declId, \"cannot give this name storage\");\n        return null;\n    }\n    IrValue* init = null;\n    if (initId.index != 0 && !isExtern) init = wvConstInit(w, initId, dt);\n    str mangled = wvMangle(w, declId, name);\n    if (disambiguator != 0)\n    {\n        wvMbCh(w, 36); // '$'\n        u32 d = disambiguator;\n        u8[10] tmp;\n        u32 k = 0;\n        if (d == 0) tmp[k++] = 48;\n        while (d > 0) { tmp[k++] = (u8)(48 + (d % 10)); d /= 10; }\n        while (k > 0) { k--; wvMbCh(w, tmp[k]); }\n        mangled = wvMbStr(w);\n    }\n    IrGlobal* g = w->ir->createGlobal(mangled, w->ir->tyPtr(dt), isConst, isExtern,\n                                      init, w->ir->irTypeAlignOf(dt));\n    w->module->addGlobal(g);\n    wvGMapPut(w, declId.index, g);\n    return &g->base;\n}\n\n/* C default-argument promotions for variadic args: int < 32-bit →\n * zext/sext to i32, float < 64-bit → fpext to f64 */\npub IrValue* wvPromoteVararg(Wv* w, IrValue* v, Ty coralTy)\n{\n    if (v == null || v->type == null) return v;\n    Ty rt = wvResolved(w, coralTy);\n    if (rt == 0) return v;\n    TypeEntry* te = w->ctx->types + rt;\n    bool uns = wvTyUnsigned(w, coralTy);\n    switch (te->kind.tag)\n    {\n        TypeKind::I8 | TypeKind::I16 => {\n            return wvV(w->b.sext(v, w->ir->tyInt(32)));\n        },\n        TypeKind::U8 | TypeKind::U16 | TypeKind::Bool => {\n            return wvV(w->b.zext(v, w->ir->tyInt(32)));\n        },\n        TypeKind::Char => {\n            return uns ? wvV(w->b.zext(v, w->ir->tyInt(32)))\n                       : wvV(w->b.sext(v, w->ir->tyInt(32)));\n        },\n        TypeKind::F32 => { return wvV(w->b.fpExt(v, w->ir->tyDouble())); },\n        else => { return v; },\n    }\n}\n\n\n/* evaluate a call's argument list: an optional receiver first, then\n * every listed argument (with vararg promotion past the fixed prefix).\n * Shared by bare calls and method calls. On failure *fail is set and\n * the array (if any) is already freed. */\npub IrValue** wvBuildCallArgs(Wv* w, IrFunc* f, NodeId* argv, u32 argvLen,\n                              IrValue* recv, bool passRecv, u32* outN, bool* fail)\n{\n    *fail = false;\n    *outN = 0;\n    u32 n = argvLen + (passRecv ? 1 : 0);\n    IrValue** args = null;\n    if (n > 0)\n    {\n        args = alloc<IrValue*>((usize)n);\n        if (args == null) { *fail = true; return null; }\n    }\n    u32 j = 0;\n    if (passRecv) { args[0] = recv; j = 1; }\n    bool vararg = f != null && f->base.type != null && f->base.type->isVararg;\n    u32 fixed = f != null ? f->nparams : 0;\n    u32 i = 0;\n    while (i < argvLen)\n    {\n        IrValue* av = wvExpr(w, argv[i]);\n        if (av == null)\n        {\n            *fail = true;\n            if (args != null) dealloc<IrValue*>(args);\n            return null;\n        }\n        if (vararg && (i + (passRecv ? 1 : 0)) >= fixed)\n        {\n            Node* an = wvNode(w, argv[i]);\n            Ty at = an->kind.tag == NodeKind::Expr ? an->kind.payload.Expr.value.resolvedType : 0;\n            av = wvPromoteVararg(w, av, at);\n        }\n        args[j] = av;\n        j++;\n        i++;\n    }\n    *outN = n;\n    return args;\n}\n\n/* the Func decl in the module tree whose interned name matches a\n * precomputed FNV hash+length; id 0 when the unit does not contain it\n * (e.g. core::error was not imported). no probe string is interned. */\npub NodeId wvFindDeclByHash(Wv* w, u32 hash, u32 len)\n{\n    NodeId none;\n    none.index = 0;\n    if (w->file == null) return none;\n    File* file = w->file;\n    u32 i = 0;\n    while (i < file->declsLen)\n    {\n        NodeId did = file->decls[i];\n        Node* n = wvNode(w, did);\n        if (n->kind.tag == NodeKind::Decl &&\n            n->kind.payload.Decl.value.kind.tag == DeclKind::Func)\n        {\n            Decl* d = &n->kind.payload.Decl.value;\n            if (w->ctx->internEqHashLen(d->kind.payload.Func.name, hash, len)) return did;\n        }\n        i++;\n    }\n    return none;\n}\n\n/* resolve a method's IrFunc: name-table hit first (the one binding whose\n * key differs per instance — an instance shares mdef with its siblings),\n * otherwise the declId-keyed fn map, otherwise declare a shell under the\n * composed `owner_method` symbol. `owner` is the bare owner spelling\n * (receiver side or the call site's own text), `recvTy` the receiver type\n * used to derive the implicit self pointee (0 when the caller knows the\n * method is static). *notFound distinguishes \"no such method\" (silent —\n * callers fall back or word their own error) from a lowering failure\n * (already reported). */\nIrFunc* wvMethodShell(Wv* w, NodeId mdef, Str owner, Ty recvTy, Str methName,\n                      NodeId id, bool* notFound)\n{\n    if (notFound != null) *notFound = false;\n    if (mdef.index == 0)\n    {\n        if (notFound != null) *notFound = true;\n        return null;\n    }\n    Node* mn = wvNode(w, mdef);\n    if (mn->kind.tag != NodeKind::Decl ||\n        mn->kind.payload.Decl.value.kind.tag != DeclKind::Func)\n        { wvErr(w, id, \"method is not a function\"); return null; }\n    Decl* md = &mn->kind.payload.Decl.value;\n    if (w->mono != null && w->mono->genericCount(mdef) != 0)\n        { wvErr(w, id, \"call to a generic method (Phase 2)\"); return null; }\n    str msym = wvMethodMangleEx(w, mdef, owner, recvTy, null, 0, methName);\n    if (msym.len == 0) { wvErr(w, id, \"cannot compose the method symbol\"); return null; }\n    if (w->names != null)\n    {\n        WvNameEnt* ent = wvNamesFind(w->names, msym);\n        if (ent != null && ent->f != null) return ent->f;\n    }\n    /* an instance receiver with no declared shell means the sweep missed\n     * it — declaring ad hoc would let the declId-keyed fn map bind one\n     * instance's shell for all its siblings */\n    if (recvTy != 0)\n    {\n        Ty gu = wvUnwrapTy(w, recvTy);\n        if (gu != 0 && (w->ctx->types + gu)->kind.tag == TypeKind::Pointer)\n            gu = wvUnwrapTy(w, (w->ctx->types + gu)->kind.payload.Pointer.base);\n        if (gu != 0 && (w->ctx->types + gu)->kind.tag == TypeKind::Named &&\n            (w->ctx->types + gu)->kind.payload.Named.genericArgsLen != 0)\n            { wvErr(w, id, \"instance method was not declared (method sweep gap)\"); return null; }\n    }\n    IrFunc* f = wvFnMapGet(w, mdef.index);\n    if (f != null) return f;\n    IrType* selfPt = null;\n    if (wvMethodSelfKind(w, mdef) == 1 && recvTy != 0)\n    {\n        Ty u = wvUnwrapTy(w, recvTy);\n        if (u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer)\n            u = wvUnwrapTy(w, (w->ctx->types + u)->kind.payload.Pointer.base);\n        if (u != 0) selfPt = w->ir->tyPtr(wvTy(w, u, 0));\n    }\n    f = wvDeclareMethod(w, mdef, md, msym, selfPt);\n    if (f == null) { wvErr(w, id, \"cannot declare the method\"); return null; }\n    w->module->addFunc(f);\n    wvFnMapPut(w, mdef.index, f);\n    return f;\n}\n\n/* the receiver-typed form: find the method on recvTy's owner, then the\n * shared shell. Used by method calls and for-in's count()/at()/range().\n * *outDef (optional) receives the method decl so callers can ask about\n * the receiver parameter. */\npub IrFunc* wvMethodFnFor(Wv* w, Ty recvTy, Str methName, NodeId id,\n                          bool* notFound, NodeId* outDef)\n{\n    NodeId mdef = wvFindMethodDecl(w, recvTy, methName);\n    if (outDef != null) *outDef = mdef;\n    return wvMethodShell(w, mdef, wvOwnerStr(w, recvTy), recvTy, methName, id, notFound);\n}\n\npub IrValue* wvCall(Wv* w, Expr* e, NodeId id)\n{\n    NodeId calleeId = e->kind.payload.Call.callee;\n    Node* cn = wvNode(w, calleeId);\n    if (cn->kind.tag != NodeKind::Expr)\n    {\n        wvErr(w, id, \"unsupported callee form (Phase 1: bare-name calls only)\");\n        return null;\n    }\n    i32 ck = cn->kind.payload.Expr.value.kind.tag;\n    IrFunc* f = null;\n    if (ck == ExprKind::Ident)\n    {\n        /* a fn-pointer local/param called bare (`less(a, b)` in\n         * isSortedBy): the callee lives in the local's slot — call\n         * through the loaded pointer, the same form the method fallback\n         * uses for a fn-pointer field. Checked before wvResolveCallee,\n         * which reports an unresolved name outright and would fire for\n         * a parameter that is not a file-scope function at all. */\n        Str cname = cn->kind.payload.Expr.value.kind.payload.Ident.name;\n        IrValue* cslot = wvFindLocal(w, cname);\n        IrType* cfty = cslot != null ? wvSlotTy(cslot->type) : null;\n        if (cfty != null && cfty->kind == IrTypeKind::Func)\n        {\n            IrValue* fval = wvV(w->b.load(cfty, cslot));\n            if (fval == null) return null;\n            u32 pnargs = 0;\n            bool pfail = false;\n            IrValue** pargs = wvBuildCallArgs(w, null, e->kind.payload.Call.args,\n                                              e->kind.payload.Call.argsLen,\n                                              null, false, &pnargs, &pfail);\n            if (pfail) return null;\n            IrValue* pres = wvV(w->b.call(fval, pargs, pnargs));\n            if (pargs != null) dealloc<IrValue*>(pargs);\n            if (pres == null) return null;\n            if (cfty->ret == null || cfty->ret->kind == IrTypeKind::Void) return null;\n            return pres;\n        }\n        f = wvResolveCallee(w, cn->kind.payload.Expr.value.kind.payload.Ident.name, calleeId,\n                            e->kind.payload.Call.args, e->kind.payload.Call.argsLen);\n    }\n    else if (ck == ExprKind::Path)\n        f = wvResolveCalleePath(w, calleeId, id,\n                                e->kind.payload.Call.args, e->kind.payload.Call.argsLen);\n    else if (ck == ExprKind::TypeRef)\n        f = wvResolveGenericCall(w, cn->kind.payload.Expr.value.kind.payload.TypeRef.name,\n                                 cn->kind.payload.Expr.value.kind.payload.TypeRef.typeNode,\n                                 calleeId, e->kind.payload.Call.args,\n                                 e->kind.payload.Call.argsLen);\n    else\n    {\n        wvErr(w, id, \"unsupported callee form (Phase 1: bare-name calls only)\");\n        return null;\n    }\n    if (f == null) return null;\n\n    u32 nargs = 0;\n    bool fail = false;\n    IrValue** args = wvBuildCallArgs(w, f, e->kind.payload.Call.args,\n                                     e->kind.payload.Call.argsLen,\n                                     null, false, &nargs, &fail);\n    if (fail) return null;\n    IrValue* res = wvV(w->b.call(&f->base, args, nargs));\n    if (args != null) dealloc<IrValue*>(args);\n    if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;\n    return res;\n}\n\n/* `recv.method(args...)`: a real method when the receiver's type (or a\n * matching extend) declares one — the receiver becomes the shell's\n * parameter 0 unless the method is static — otherwise a fn-pointer\n * field of the receiver called with only the listed arguments. */\npub IrValue* wvMethodCall(Wv* w, Expr* e, NodeId id)\n{\n    NodeId recvNode = e->kind.payload.MethodCall.receiver;\n    Str meth = e->kind.payload.MethodCall.method;\n    NodeId* argv = e->kind.payload.MethodCall.args;\n    u32 argvLen = e->kind.payload.MethodCall.argsLen;\n\n    Node* rn = wvNode(w, recvNode);\n    Ty recvTy = rn->kind.tag == NodeKind::Expr\n        ? rn->kind.payload.Expr.value.resolvedType : 0;\n\n    bool nf = false;\n    NodeId mdef = NodeId{ .index = 0 };\n    IrFunc* f = wvMethodFnFor(w, recvTy, meth, id, &nf, &mdef);\n    if (f != null)\n    {\n        u8 sk = wvMethodSelfKind(w, mdef);\n        IrValue* recvVal = null;\n        bool passRecv = sk != 0;\n        if (passRecv)\n        {\n            Ty rt = wvUnwrapTy(w, recvTy);\n            bool recvIsPtr = rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::Pointer;\n            recvVal = recvIsPtr ? wvExpr(w, recvNode) : wvAddrOf(w, recvNode);\n            if (recvVal == null) return null;\n        }\n        u32 nargs = 0;\n        bool fail = false;\n        IrValue** args = wvBuildCallArgs(w, f, argv, argvLen, recvVal, passRecv,\n                                         &nargs, &fail);\n        if (fail) return null;\n        IrValue* res = wvV(w->b.call(&f->base, args, nargs));\n        if (args != null) dealloc<IrValue*>(args);\n        if (f->retType != null && f->retType->kind == IrTypeKind::Void) return null;\n        return res;\n    }\n    if (!nf) return null; // the shell reported why\n\n    /* not a method: a fn-pointer field, called as `(recv.field)(args)` */\n    if (wvHasField(w, recvTy, meth))\n    {\n        IrValue* faddr = wvFieldAddr(w, recvNode, meth, id);\n        if (faddr == null) return null;\n        IrType* fty = faddr->type != null ? faddr->type->elem : null;\n        if (fty == null || fty->kind != IrTypeKind::Func)\n            { wvErr(w, id, \"field is not a function pointer\"); return null; }\n        IrValue* fval = wvV(w->b.load(fty, faddr));\n        if (fval == null) return null;\n        u32 nargs = 0;\n        bool fail = false;\n        IrValue** args = wvBuildCallArgs(w, null, argv, argvLen, null, false,\n                                         &nargs, &fail);\n        if (fail) return null;\n        IrValue* res = wvV(w->b.call(fval, args, nargs));\n        if (args != null) dealloc<IrValue*>(args);\n        if (fty->ret == null || fty->ret->kind == IrTypeKind::Void) return null;\n        return res;\n    }\n\n    wvErr(w, id, \"no such method or function-pointer field\");\n    return null;\n}\n\n\n/* value-level arithmetic: l and r are already evaluated. Shared by\n * binary expressions and compound assignment (`x += e` = load, apply,\n * store). */\npub IrValue* wvArithVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)\n{\n    if (l == null || r == null) return null;\n    Ty rt = wvResolved(w, ct);\n    bool isFloat = false;\n    if (rt != 0)\n    {\n        TypeEntry* te = w->ctx->types + rt;\n        isFloat = te->kind.tag == TypeKind::F32 || te->kind.tag == TypeKind::F64;\n    }\n    bool uns = wvTyUnsigned(w, ct);\n    switch (k.tag)\n    {\n        ExprKind::Add => { return wvV(isFloat ? w->b.fadd(l, r) : w->b.add(l, r)); },\n        ExprKind::Sub => { return wvV(isFloat ? w->b.fsub(l, r) : w->b.sub(l, r)); },\n        ExprKind::Mul => { return wvV(isFloat ? w->b.fmul(l, r) : w->b.mul(l, r)); },\n        ExprKind::Div => {\n            if (isFloat) return wvV(w->b.fdiv(l, r));\n            return wvV(uns ? w->b.udiv(l, r) : w->b.sdiv(l, r));\n        },\n        ExprKind::Mod => {\n            if (isFloat) { wvErr(w, id, \"float modulo (needs fmod lowering, Phase 2)\"); return null; }\n            return wvV(uns ? w->b.urem(l, r) : w->b.srem(l, r));\n        },\n        ExprKind::BitAnd => { return wvV(w->b.andOp(l, r)); },\n        ExprKind::BitOr => { return wvV(w->b.orOp(l, r)); },\n        ExprKind::BitXor => { return wvV(w->b.xorOp(l, r)); },\n        ExprKind::Shl => { return wvV(w->b.shl(l, r)); },\n        ExprKind::Shr => { return wvV(uns ? w->b.lshr(l, r) : w->b.ashr(l, r)); },\n        else => { wvErr(w, id, \"unhandled binary op\"); return null; },\n    }\n}\n\npub IrValue* wvBinaryArith(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)\n{\n    IrValue* l = wvExpr(w, lid);\n    IrValue* r = wvExpr(w, rid);\n    return wvArithVals(w, k, l, r, id, ct);\n}\n\n/* value-level comparison (see wvArithVals) */\npub IrValue* wvCompareVals(Wv* w, ExprKind k, IrValue* l, IrValue* r, NodeId id, Ty ct)\n{\n    if (l == null || r == null) return null;\n    Ty rt = wvResolved(w, ct);\n    bool isFloat = false;\n    if (rt != 0)\n    {\n        TypeEntry* te = w->ctx->types + rt;\n        isFloat = te->kind.tag == TypeKind::F32 || te->kind.tag == TypeKind::F64;\n    }\n    bool uns = wvTyUnsigned(w, ct);\n    switch (k.tag)\n    {\n        ExprKind::Eq => {\n            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::Oeq, l, r)\n                               : w->b.icmp(IrICmpPred::Eq, l, r));\n        },\n        ExprKind::Ne => {\n            return wvV(isFloat ? w->b.fcmp(IrFCmpPred::One, l, r)\n                               : w->b.icmp(IrICmpPred::Ne, l, r));\n        },\n        ExprKind::Lt => {\n            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Olt, l, r));\n            return wvV(w->b.icmp(uns ? IrICmpPred::Ult : IrICmpPred::Slt, l, r));\n        },\n        ExprKind::Le => {\n            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ole, l, r));\n            return wvV(w->b.icmp(uns ? IrICmpPred::Ule : IrICmpPred::Sle, l, r));\n        },\n        ExprKind::Gt => {\n            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Ogt, l, r));\n            return wvV(w->b.icmp(uns ? IrICmpPred::Ugt : IrICmpPred::Sgt, l, r));\n        },\n        ExprKind::Ge => {\n            if (isFloat) return wvV(w->b.fcmp(IrFCmpPred::Oge, l, r));\n            return wvV(w->b.icmp(uns ? IrICmpPred::Uge : IrICmpPred::Sge, l, r));\n        },\n        else => { wvErr(w, id, \"unhandled comparison\"); return null; },\n    }\n}\n\npub IrValue* wvCompare(Wv* w, ExprKind k, NodeId lid, NodeId rid, NodeId id, Ty ct)\n{\n    IrValue* l = wvExpr(w, lid);\n    IrValue* r = wvExpr(w, rid);\n    return wvCompareVals(w, k, l, r, id, ct);\n}\n\n/* short-circuit And/Or via result alloca + condBr (no phis) */\npub IrValue* wvShortCircuit(Wv* w, Expr* e, NodeId id)\n{\n    IrType* bt = w->ir->tyInt(1);\n    IrValue* resSlot = wvV(w->b.alloca(bt));\n    IrValue* l = wvExpr(w, e->kind.payload.And.left);\n    if (l == null) return null;\n    /* truthiness == wvCond's: != 0 (i1/int/ptr; sema rejects floats in\n     * &&/||) — `ne 1` inverted every condition (`true && x` folded false) */\n    IrValue* lz = wvV(w->b.icmp(IrICmpPred::Ne, l, w->ir->constInt(l->type, 0)));\n    IrBlock* rhsBb = wvBlock(w, \"sc.rhs\");\n    IrBlock* endBb = wvBlock(w, \"sc.end\");\n    bool isAnd = e->kind.tag == ExprKind::And;\n    if (isAnd) w->b.condBr(lz, rhsBb, endBb);\n    else w->b.condBr(lz, endBb, rhsBb);\n\n    /* short-circuit path: store the known result, branch to join */\n    wvSetBlock(w, endBb);\n    w->b.store(w->ir->constInt(bt, isAnd ? 0 : 1), resSlot);\n    IrBlock* joinBb = wvBlock(w, \"sc.join\");\n    w->b.br(joinBb);\n\n    /* rhs path: evaluate, store, branch to join */\n    wvSetBlock(w, rhsBb);\n    IrValue* r = wvExpr(w, e->kind.payload.And.right);\n    if (r == null) return null;\n    IrValue* rz = wvV(w->b.icmp(IrICmpPred::Ne, r, w->ir->constInt(r->type, 0)));\n    w->b.store(rz, resSlot);\n    w->b.br(joinBb);\n\n    wvSetBlock(w, joinBb);\n    return wvV(w->b.load(bt, resSlot));\n}\n\n/* scalar cast between two IrTypes, using Coral signedness for the\n * int↔int / int→float choice (IrType has no signed flag) */\npub IrValue* wvCast(Wv* w, IrValue* v, IrType* st, IrType* dt, bool srcUnsigned, bool dstUnsigned)\n{\n    if (v == null || dt == null) return v;\n    if (st == dt) return v;\n    if (st->kind == IrTypeKind::Ptr && dt->kind == IrTypeKind::Ptr) return v;\n    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Int)\n    {\n        if (dt->width == st->width) return v;\n        if (dt->width < st->width) return wvV(w->b.trunc(v, dt));\n        return wvV(srcUnsigned ? w->b.zext(v, dt) : w->b.sext(v, dt));\n    }\n    if (st->kind == IrTypeKind::Int && dt->kind == IrTypeKind::Float)\n        return wvV(srcUnsigned ? w->b.uiToFp(v, dt) : w->b.siToFp(v, dt));\n    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Int)\n        return wvV(dstUnsigned ? w->b.fpToUi(v, dt) : w->b.fpToSi(v, dt));\n    if (st->kind == IrTypeKind::Float && dt->kind == IrTypeKind::Float)\n    {\n        if (dt->width < st->width) return wvV(w->b.fpTrunc(v, dt));\n        return wvV(w->b.fpExt(v, dt));\n    }\n    return wvV(w->b.bitcast(v, dt));\n}\n\n\n/* coerce any expression value to an i1 condition: i1 passes through,\n * other ints and pointers compare against 0 (C truthiness: `if (2)` and\n * `if (ptr)` are true, `if (0)`/`if (null)` false), floats against 0.0.\n * Returns null on failure. */\npub IrValue* wvCond(Wv* w, IrValue* v)\n{\n    if (v == null || v->type == null) return null;\n    if (v->type->kind == IrTypeKind::Int && v->type->width == 1) return v;\n    if (v->type->kind == IrTypeKind::Float)\n        return wvV(w->b.fcmp(IrFCmpPred::One, v, w->ir->constFloat(v->type, 0.0)));\n    return wvV(w->b.icmp(IrICmpPred::Ne, v, w->ir->constInt(v->type, 0)));\n}\n\n// pub IrValue* wvAddrOf(Wv* w, NodeId id);\n\n/* strip Const/Comptime wrappers; Named alias/distinct unwrapping happens\n * where the decl is needed */\npub Ty wvUnwrapTy(Wv* w, Ty t)\n{\n    u32 guard = 0;\n    while (t != 0 && guard < 8)\n    {\n        TypeEntry* e = w->ctx->types + t;\n        if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;\n        else return t;\n        guard++;\n    }\n    return t;\n}\n\n/* is this IR type an aggregate (address-copied, never register-loaded)? */\npub bool wvIsAgg(IrType* t)\n{\n    return t != null && (t->kind == IrTypeKind::Struct ||\n                         t->kind == IrTypeKind::Array ||\n                         t->kind == IrTypeKind::Vector);\n}\n\n/* declaration-order field index of `name` in struct type `t` — the same\n * order wvStructTy feeds createStructType, which is the order wallvm's\n * emitGep walks for field offsets. Str/Slice expose the fixed {ptr,len}\n * pair. 0xFFFFFFFF when the field is unknown. */\n/* the field's address: pointer receivers pass the value through, value\n * receivers contribute their address — shared by `x.f`, `x?.f`-style\n * chains and the fn-pointer-field call form of a method call. */\npub IrValue* wvFieldAddr(Wv* w, NodeId obj, Str fname, NodeId errId)\n{\n    Node* on = wvNode(w, obj);\n    if (on->kind.tag != NodeKind::Expr)\n        { wvErr(w, errId, \"field base is not an expression\"); return null; }\n    Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));\n    /* comptime-arm base sema never stamped: fall back to the local's\n     * declared type (only Idents live in that table — see wvLocalTy) */\n    if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n        obt = wvUnwrapTy(w, wvResolved(w, wvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));\n    IrValue* base; Ty sty;\n    if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)\n    {\n        sty = (w->ctx->types + obt)->kind.payload.Pointer.base;\n        base = wvExpr(w, obj); // the pointer value\n    }\n    else\n    {\n        sty = obt;\n        base = wvAddrOf(w, obj); // address of the struct value\n    }\n    if (base == null) return null;\n    u32 fi = wvFieldIdx(w, sty, fname);\n    if (fi == 0xFFFFFFFF) { wvErr(w, errId, \"unknown struct field\"); return null; }\n    return wvGepField(w, base, fi);\n}\n\n/* the declaring node of a method on a receiver type — the same walk\n * cgMethodRecvKind performs: unwrap ptr/const/comptime to the named\n * type, then scan the type's own methods and the extends whose self\n * type matches. 0 when the name is not a method at all. */\npub NodeId wvFindMethodDecl(Wv* w, Ty recvTy, Str method)\n{\n    NodeId none;\n    none.index = 0;\n    if (recvTy == 0 || method == 0 || w->file == null) return none;\n    Ty t = recvTy;\n    u32 guard = 0;\n    while (t != 0 && guard < 8)\n    {\n        guard++;\n        TypeEntry* e = w->ctx->types + t;\n        if (e->kind.tag == TypeKind::Pointer) t = e->kind.payload.Pointer.base;\n        else if (e->kind.tag == TypeKind::Const) t = e->kind.payload.Const.base;\n        else if (e->kind.tag == TypeKind::Comptime) t = e->kind.payload.Comptime.base;\n        else break;\n    }\n    if (t == 0) return none;\n    /* the receiver's owner name — builtins match their extend too\n     * (`extend str`'s methods live behind TypeKind::Str, which is not\n     * a Named and used to bail out here) */\n    Str typeName = wvOwnerStr(w, t);\n    if (typeName == 0) return none;\n    File* file = w->file;\n    u32 i = 0;\n    while (i < file->declsLen)\n    {\n        Node* d = wvNode(w, file->decls[i]);\n        if (d->kind.tag == NodeKind::Decl)\n        {\n            Decl* dd = &d->kind.payload.Decl.value;\n            NodeId* methods = null;\n            u32 mlen = 0;\n            switch (dd->kind.tag)\n            {\n                DeclKind::Struct => {\n                    if (dd->kind.payload.Struct.name != typeName) break;\n                    methods = dd->kind.payload.Struct.methods;\n                    mlen = dd->kind.payload.Struct.methodsLen;\n                },\n                DeclKind::Union => {\n                    if (dd->kind.payload.Union.name != typeName) break;\n                    methods = dd->kind.payload.Union.methods;\n                    mlen = dd->kind.payload.Union.methodsLen;\n                },\n                DeclKind::Variant => {\n                    if (dd->kind.payload.Variant.name != typeName) break;\n                    methods = dd->kind.payload.Variant.methods;\n                    mlen = dd->kind.payload.Variant.methodsLen;\n                },\n                /* an extend's methods belong to its self type — without\n                 * this filter a fn-pointer field call (`p->alloc(...)`,\n                 * where some OTHER type has an `alloc` method) matches\n                 * this unrelated extend and composes a bogus call */\n                DeclKind::Extend | DeclKind::ExtendTrait => {\n                    Ty st = dd->kind.tag == DeclKind::Extend\n                        ? dd->kind.payload.Extend.selfType\n                        : dd->kind.payload.ExtendTrait.selfType;\n                    st = wvUnwrapTy(w, st);\n                    if (st != 0 && (w->ctx->types + st)->kind.tag == TypeKind::Pointer)\n                        st = wvUnwrapTy(w, (w->ctx->types + st)->kind.payload.Pointer.base);\n                    if (st == 0 || wvOwnerStr(w, st) != typeName) break;\n                    methods = dd->kind.tag == DeclKind::Extend\n                        ? dd->kind.payload.Extend.methods\n                        : dd->kind.payload.ExtendTrait.methods;\n                    mlen = dd->kind.tag == DeclKind::Extend\n                        ? dd->kind.payload.Extend.methodsLen\n                        : dd->kind.payload.ExtendTrait.methodsLen;\n                },\n                else => {},\n            }\n            if (methods != null)\n            {\n                u32 m = 0;\n                while (m < mlen)\n                {\n                    Node* mn = wvNode(w, methods[m]);\n                    if (mn->kind.tag == NodeKind::Decl &&\n                        mn->kind.payload.Decl.value.kind.tag == DeclKind::Func &&\n                        mn->kind.payload.Decl.value.kind.payload.Func.name == method)\n                        return methods[m];\n                    m++;\n                }\n            }\n        }\n        i++;\n    }\n    /* a monomorphised owner (`Vec_i32` composes no decl of its own here)\n     * reaches the shared resolver's instance phases */\n    return wvFindMethodDeclOwner(w, typeName, method);\n}\n\n/* does the receiver's named struct/union declare field `name`? (the\n * fn-pointer field form a method call may fall back to) */\npub bool wvHasField(Wv* w, Ty recvTy, Str name)\n{\n    if (recvTy == 0 || name == 0) return false;\n    Ty u = wvUnwrapTy(w, recvTy);\n    if (u != 0 && (w->ctx->types + u)->kind.tag == TypeKind::Pointer)\n        u = wvUnwrapTy(w, (w->ctx->types + u)->kind.payload.Pointer.base);\n    if (u == 0 || (w->ctx->types + u)->kind.tag != TypeKind::Named) return false;\n    Str tn = (w->ctx->types + u)->kind.payload.Named.name;\n    NodeId d = wvFindTypeDecl(w, tn);\n    if (d.index == 0) return false;\n    Node* dn = wvNode(w, d);\n    if (dn->kind.tag != NodeKind::Decl) return false;\n    Decl* dd = &dn->kind.payload.Decl.value;\n    NodeId* fields = null;\n    u32 flen = 0;\n    if (dd->kind.tag == DeclKind::Struct)\n    {\n        fields = dd->kind.payload.Struct.fields;\n        flen = dd->kind.payload.Struct.fieldsLen;\n    }\n    else if (dd->kind.tag == DeclKind::Union)\n    {\n        fields = dd->kind.payload.Union.fields;\n        flen = dd->kind.payload.Union.fieldsLen;\n    }\n    else return false;\n    u32 i = 0;\n    while (i < flen)\n    {\n        Node* fn = wvNode(w, fields[i]);\n        if (fn->kind.tag == NodeKind::Field && fn->kind.payload.Field.value.name == name)\n            return true;\n        i++;\n    }\n    return false;\n}\n\npub u32 wvFieldIdx(Wv* w, Ty t, Str name)\n{\n    u32 none = 0xFFFFFFFF;\n    if (name == 0) return none;\n    t = wvUnwrapTy(w, t);\n    u32 guard = 0;\n    while (t != 0 && guard < 8)\n    {\n        guard++;\n        TypeEntry* e = w->ctx->types + t;\n        if (e->kind.tag == TypeKind::Str || e->kind.tag == TypeKind::Slice)\n        {\n            if (w->ctx->internEqHashLen(name, 0x55764C09, 3)) return 0; /* FNV(\"ptr\") */\n            if (w->ctx->internEqHashLen(name, 0x366ADB0C, 3)) return 1; /* FNV(\"len\") */\n            return none;\n        }\n        if (e->kind.tag != TypeKind::Named) return none;\n        NodeId td = wvFindTypeDecl(w, e->kind.payload.Named.name);\n        if (td.index == 0) return none;\n        Node* dn = wvNode(w, td);\n        if (dn->kind.tag != NodeKind::Decl) return none;\n        Decl* dd = &dn->kind.payload.Decl.value;\n        if (dd->kind.tag == DeclKind::Struct)\n        {\n            u32 i = 0;\n            while (i < dd->kind.payload.Struct.fieldsLen)\n            {\n                Node* fn = wvNode(w, dd->kind.payload.Struct.fields[i]);\n                if (fn->kind.tag == NodeKind::Field &&\n                    fn->kind.payload.Field.value.name == name) return i;\n                i++;\n            }\n            return none;\n        }\n        if (dd->kind.tag == DeclKind::TypeAlias)\n            { t = wvUnwrapTy(w, dd->kind.payload.TypeAlias.target); continue; }\n        if (dd->kind.tag == DeclKind::Distinct)\n            { t = wvUnwrapTy(w, dd->kind.payload.Distinct.baseType); continue; }\n        return none;\n    }\n    return none;\n}\n\n/* address of element `idx` reached through `base`.\n *\n * byElement: base already points INTO an array (a local array slot or a\n * ptr-to-array's interior) — a plain gep strides by the array element\n * size, which wallvm's emitGep walks correctly.\n *\n * otherwise base points AT `pointee` (T*, a struct*, a slice's data\n * pointer): wallvm's emitGep silently DROPS the index when the pointee is\n * a scalar (the walk breaks out with offset 0). Retype the base as\n * [0 x pointee]* first, so the stride becomes sizeOf(pointee) — plain C\n * pointer arithmetic — and cast the result back to pointee*. */\npub IrValue* wvIndexAddr(Wv* w, IrValue* base, IrType* pointee, IrValue* idx, bool byElement)\n{\n    if (base == null || pointee == null || idx == null) return null;\n    IrValue*[1] idxs;\n    idxs[0] = idx;\n    if (byElement) return wvV(w->b.gep(base, idxs, 1));\n    IrType* arrT = w->ir->tyArray(pointee, 0);\n    IrValue* bc = wvV(w->b.bitcast(base, w->ir->tyPtr(arrT)));\n    if (bc == null) return null;\n    IrValue* g = wvV(w->b.gep(bc, idxs, 1));\n    if (g == null) return null;\n    return wvV(w->b.bitcast(g, w->ir->tyPtr(pointee)));\n}\n\n/* gep to struct field `fi` of the aggregate at `base` */\npub IrValue* wvGepField(Wv* w, IrValue* base, u32 fi)\n{\n    if (base == null) return null;\n    IrValue*[1] idxs;\n    idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)fi);\n    return wvV(w->b.gep(base, idxs, 1));\n}\n\n/* An aggregate value IS its address, so the alloca that holds one is\n * typed as the aggregate itself: call/return ABI classification reads\n * the struct words through that address (kind 3/4), which it only does\n * when the value's type says Struct. Scalar slots stay ptr-typed — they\n * are loaded into registers instead. */\npub IrValue* wvAggSlot(Wv* w, IrType* ty)\n{\n    IrValue* slot = wvV(w->b.alloca(ty));\n    if (slot != null) slot->type = ty;\n    return slot;\n}\n\n/* decode Coral string-literal token text [begin,end) into out — every\n * escape becomes one byte (\\n \\t \\r \\0 \\a \\b \\f \\v \\\\ \\\" \\' \\xNN,\n * \\NNN octal; unknown escapes drop the backslash, like C). out must hold\n * at least end-begin bytes; returns the decoded length. Shared by string\n * literals and asm template pieces so both reach IR as identical bytes. */\npub usize wvDecodeLit(str tok, usize begin, usize end, u8* out)\n{\n    usize dlen = 0;\n    usize i = begin;\n    while (i < end)\n    {\n        u8 c = tok.ptr[i];\n        if (c != '\\\\' || i + 1 >= end) { out[dlen++] = c; i++; continue; }\n        u8 esc = tok.ptr[i + 1];\n        if (esc == 'n') { out[dlen++] = 10; i += 2; continue; }\n        if (esc == 't') { out[dlen++] = 9; i += 2; continue; }\n        if (esc == 'r') { out[dlen++] = 13; i += 2; continue; }\n        if (esc == '0') { out[dlen++] = 0; i += 2; continue; }\n        if (esc == 'a') { out[dlen++] = 7; i += 2; continue; }\n        if (esc == 'b') { out[dlen++] = 8; i += 2; continue; }\n        if (esc == 'f') { out[dlen++] = 12; i += 2; continue; }\n        if (esc == 'v') { out[dlen++] = 11; i += 2; continue; }\n        if (esc == '\\\\' || esc == '\"' || esc == '\\'') { out[dlen++] = esc; i += 2; continue; }\n        if (esc == 'x')\n        {\n            u32 v = 0;\n            usize j = i + 2;\n            u32 used = 0;\n            while (j < end && used < 2)\n            {\n                u8 h = tok.ptr[j];\n                u32 d;\n                if (h >= '0' && h <= '9') d = (u32)(h - '0');\n                else if (h >= 'a' && h <= 'f') d = (u32)(h - 'a' + 10);\n                else if (h >= 'A' && h <= 'F') d = (u32)(h - 'A' + 10);\n                else break;\n                v = v * 16 + d;\n                j++; used++;\n            }\n            if (used == 0) { out[dlen++] = 'x'; i += 2; continue; }\n            out[dlen++] = (u8)v;\n            i = j;\n            continue;\n        }\n        if (esc >= '0' && esc <= '7')\n        {\n            u32 v = 0;\n            usize j = i + 1;\n            u32 used = 0;\n            while (j < end && used < 3)\n            {\n                u8 h = tok.ptr[j];\n                if (h < '0' || h > '7') break;\n                v = v * 8 + (u32)(h - '0');\n                j++; used++;\n            }\n            out[dlen++] = (u8)v;\n            i = j;\n            continue;\n        }\n        /* unknown escape: the backslash drops, like C */\n        out[dlen++] = esc;\n        i += 2;\n    }\n    return dlen;\n}\n\n/* StringLit → address of merged rodata.\n *   C\"...\" → the pointer value itself (record is NUL-terminated)\n *   \"...\"  → { ptr, len } in an aggregate slot, field-wise initialized\n * Token text keeps its quotes and escapes; decoding happens here the way\n * the C backend lets the C compiler do it: every escape is one byte of\n * the str's len. */\npub IrValue* wvStringLit(Wv* w, NodeId id)\n{\n    Node* n = wvNode(w, id);\n    if (n == null || n->kind.tag != NodeKind::Expr)\n        { wvErr(w, id, \"string literal\"); return null; }\n    Expr* e = &n->kind.payload.Expr.value;\n    str tok = wvStr(w, e->kind.payload.StringLit.value);\n    bool isC = (e->kind.payload.StringLit.flags & 1) != 0;\n    usize begin = 0;\n    usize end = tok.len;\n    if (isC)\n    {\n        /* token text is `C\"…\"`: drop the prefix and both quotes */\n        if (tok.len >= 3 && tok.ptr[0] == 'C' && tok.ptr[1] == '\"')\n            { begin = 2; end = tok.len - 1; }\n    }\n    else if (tok.len >= 2 && tok.ptr[0] == '\"')\n        { begin = 1; end = tok.len - 1; }\n\n    u8* buf = (u8*)wvArr(w, (end - begin) + 4, 1);\n    if (buf == null) { wvErr(w, id, \"string literal buffer\"); return null; }\n    usize dlen = wvDecodeLit(tok, begin, end, buf);\n\n\n    IrValue*[1] z;\n    z[0] = w->ir->constInt(w->ir->tyInt(32), 0);\n    str bytes = str::fromParts(buf, dlen);\n    IrStringConst* sc = w->module->findConstString(bytes, (u32)dlen);\n    if (sc == null)\n    {\n        sc = w->ir->createStringConst(bytes, (u32)dlen);\n        if (sc == null) { wvErr(w, id, \"string constant creation failed\"); return null; }\n        w->module->addConstString(sc);\n    }\n    IrValue* addr = wvV(w->b.gep(&sc->base, z, 1));\n    if (addr == null) return null;\n    if (isC) return addr;\n\n    Ty rt = wvResolved(w, e->resolvedType);\n    IrType* st = wvTy(w, rt, 0);\n    if (st == null || st->kind != IrTypeKind::Struct)\n        { wvErr(w, id, \"str literal needs the str type\"); return null; }\n    IrValue* slot = wvAggSlot(w, st);\n    if (slot == null) return null;\n    w->b.store(addr, slot);\n    IrValue* lenF = wvGepField(w, slot, 1);\n    if (lenF == null) return null;\n    w->b.store(w->ir->constInt(w->ir->tyInt(64), (u64)dlen), lenF);\n    return slot;\n}\n\n/* the address of an lvalue expression: local slot, deref pointee, or a\n * gep chain (field / tuple field / index). Used by plain assignment,\n * compound assignment and aggregate copies alike. */\npub IrValue* wvAddrOf(Wv* w, NodeId id)\n{\n    if (id.index == 0) return null;\n    Node* n = wvNode(w, id);\n    if (n->kind.tag != NodeKind::Expr) { wvErr(w, id, \"not an lvalue\"); return null; }\n    Expr* e = &n->kind.payload.Expr.value;\n    switch (e->kind.tag)\n    {\n        ExprKind::Ident => {\n            Str name = e->kind.payload.Ident.name;\n            IrValue* slot = wvFindLocal(w, name);\n            if (slot != null) return slot;\n            IrValue* gv = wvResolveGlobal(w, name, id);\n            if (gv != null) return gv;\n            wvErr(w, id, \"cannot assign to a non-local name\");\n            return null;\n        },\n        ExprKind::Deref => { return wvExpr(w, e->kind.payload.Deref.expr); },\n        ExprKind::Field | ExprKind::DerefField => {\n            NodeId obj; Str fname;\n            if (e->kind.tag == ExprKind::Field)\n                { obj = e->kind.payload.Field.obj; fname = e->kind.payload.Field.field; }\n            else\n                { obj = e->kind.payload.DerefField.obj; fname = e->kind.payload.DerefField.field; }\n            return wvFieldAddr(w, obj, fname, id);\n        },\n        ExprKind::TupleField => {\n            NodeId obj = e->kind.payload.TupleField.obj;\n            u32 ti = e->kind.payload.TupleField.index;\n            /* source tuple indices are 1-based (sema `._1`), the struct\n             * layout is 0-based */\n            if (ti == 0)\n                { wvErr(w, id, \"tuple index 0\"); return null; }\n            Node* on = wvNode(w, obj);\n            if (on->kind.tag != NodeKind::Expr)\n                { wvErr(w, id, \"tuple base is not an expression\"); return null; }\n            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));\n            if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                obt = wvUnwrapTy(w, wvResolved(w, wvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));\n            IrValue* base;\n            if (obt != 0 && (w->ctx->types + obt)->kind.tag == TypeKind::Pointer)\n                base = wvExpr(w, obj);\n            else\n                base = wvAddrOf(w, obj);\n            return wvGepField(w, base, ti - 1);\n        },\n        ExprKind::Index => {\n            NodeId obj = e->kind.payload.Index.obj;\n            NodeId ixId = e->kind.payload.Index.index;\n            Node* on = wvNode(w, obj);\n            if (on->kind.tag != NodeKind::Expr)\n                { wvErr(w, id, \"index base is not an expression\"); return null; }\n            Ty obt = wvUnwrapTy(w, wvResolved(w, on->kind.payload.Expr.value.resolvedType));\n            if (obt == 0 && on->kind.payload.Expr.value.kind.tag == ExprKind::Ident)\n                obt = wvUnwrapTy(w, wvResolved(w, wvLocalTy(w, on->kind.payload.Expr.value.kind.payload.Ident.name)));\n            IrValue* base = null;\n            IrType* pointee = null;\n            bool byElement = false;\n            if (obt != 0)\n            {\n                TypeEntry* oe = w->ctx->types + obt;\n                if (oe->kind.tag == TypeKind::Array)\n                {\n                    /* an array value: its address points at element 0 */\n                    base = wvAddrOf(w, obj);\n                    pointee = wvTy(w, oe->kind.payload.Array.base, 0);\n                    byElement = true;\n                }\n                else if (oe->kind.tag == TypeKind::Pointer)\n                {\n                    /* p[i]: C pointer arithmetic steps sizeOf(pointee) */\n                    base = wvExpr(w, obj);\n                    Ty pe = wvUnwrapTy(w, oe->kind.payload.Pointer.base);\n                    TypeEntry* peE = pe != 0 ? w->ctx->types + pe : null;\n                    if (peE != null && peE->kind.tag == TypeKind::Array)\n                        pointee = wvTy(w, pe, 0);           // whole-array step\n                    else\n                        pointee = wvTy(w, pe, 0);           // scalar/struct step\n                }\n                else if (oe->kind.tag == TypeKind::Slice || oe->kind.tag == TypeKind::Str)\n                {\n                    Ty et = oe->kind.tag == TypeKind::Slice\n                        ? oe->kind.payload.Slice.base : (Ty)0;\n                    IrType* eir = et != 0 ? wvTy(w, et, 0) : w->ir->tyInt(8);\n                    IrValue* va = wvAddrOf(w, obj);\n                    if (va == null) return null;\n                    IrValue* pSlot = wvGepField(w, va, 0); // { ptr, len } layout\n                    if (pSlot == null) return null;\n                    base = wvV(w->b.load(w->ir->tyPtr(eir), pSlot));\n                    pointee = eir;\n                }\n            }\n            else\n            {\n                /* comptime-arm base sema never stamped: an array or a\n                 * pointer still identifies itself from the lvalue's IR\n                 * type (a str/slice base needs the sema type — Idents get\n                 * it from wvLocalTy above) */\n                IrValue* probe = wvAddrOf(w, obj);\n                if (probe == null) return null;\n                IrType* vt = wvSlotTy(probe->type);\n                if (vt != null && vt->kind == IrTypeKind::Array)\n                    { base = probe; pointee = vt->elem; byElement = true; }\n                else if (vt != null && vt->kind == IrTypeKind::Ptr)\n                    { base = wvExpr(w, obj); pointee = vt->elem; }\n            }\n            if (base == null || pointee == null)\n                { wvErr(w, id, \"unsupported index base\"); return null; }\n            IrValue* idx = wvExpr(w, ixId);\n            if (idx == null) return null;\n            return wvIndexAddr(w, base, pointee, idx, byElement);\n        },\n        ExprKind::StructLiteral => {\n            Ty st = wvResolved(w, e->kind.payload.StructLiteral.typeNode);\n            if (e->kind.payload.StructLiteral.variantName != 0)\n                { wvErr(w, id, \"variant construction (Phase 3)\"); return null; }\n            IrType* irt = st != 0 ? wvTy(w, st, 0) : null;\n            if (irt == null || irt->kind != IrTypeKind::Struct)\n                { wvErr(w, id, \"struct literal needs a struct type\"); return null; }\n            IrValue* slot = wvAggSlot(w, irt);\n            if (slot == null) return null;\n            u32 i = 0;\n            u32 n = e->kind.payload.StructLiteral.fieldValuesLen;\n            Str* fnames = e->kind.payload.StructLiteral.fieldNames;\n            NodeId* fvals = e->kind.payload.StructLiteral.fieldValues;\n            while (i < n)\n            {\n                if (fnames == null || fvals == null || fvals[i].index == 0) { i++; continue; }\n                u32 fi = wvFieldIdx(w, st, fnames[i]);\n                if (fi == 0xFFFFFFFF || fi >= irt->nparams)\n                    { wvErr(w, id, \"unknown struct literal field\"); return null; }\n                IrValue* fa = wvGepField(w, slot, fi);\n                if (fa == null) return null;\n                IrType* ft = irt->params[fi];\n                if (wvIsAgg(ft))\n                {\n                    IrValue* sv = wvAddrOf(w, fvals[i]);\n                    if (sv == null) return null;\n                    if (!wvCopyAgg(w, fa, sv, ft, 0)) return null;\n                }\n                else\n                {\n                    IrValue* v = wvExpr(w, fvals[i]);\n                    if (v == null) return null;\n                    w->b.store(v, fa);\n                }\n                i++;\n            }\n            return slot;\n        },\n        ExprKind::ArrayLiteral | ExprKind::TupleExpr => {\n            Ty at = wvResolved(w, e->resolvedType);\n            IrType* irt = at != 0 ? wvTy(w, at, 0) : null;\n            if (irt == null || (irt->kind != IrTypeKind::Array && irt->kind != IrTypeKind::Struct))\n                { wvErr(w, id, \"array/tuple literal needs an aggregate type\"); return null; }\n            IrValue* slot = wvAggSlot(w, irt);\n            if (slot == null) return null;\n            NodeId* elems = e->kind.tag == ExprKind::ArrayLiteral\n                ? e->kind.payload.ArrayLiteral.elems : e->kind.payload.TupleExpr.elems;\n            u32 n = e->kind.tag == ExprKind::ArrayLiteral\n                ? e->kind.payload.ArrayLiteral.elemsLen : e->kind.payload.TupleExpr.elemsLen;\n            u32 i = 0;\n            while (i < n)\n            {\n                if (elems == null || elems[i].index == 0) { i++; continue; }\n                if (irt->kind == IrTypeKind::Array && i >= irt->count) { i++; continue; }\n                IrValue*[1] idxs;\n                idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);\n                IrValue* ea = wvV(w->b.gep(slot, idxs, 1));\n                if (ea == null) return null;\n                IrType* et = irt->kind == IrTypeKind::Array ? irt->elem\n                    : (i < irt->nparams ? irt->params[i] : null);\n                if (et == null) { i++; continue; }\n                if (wvIsAgg(et))\n                {\n                    IrValue* sv = wvAddrOf(w, elems[i]);\n                    if (sv == null) return null;\n                    if (!wvCopyAgg(w, ea, sv, et, 0)) return null;\n                }\n                else\n                {\n                    IrValue* v = wvExpr(w, elems[i]);\n                    if (v == null) return null;\n                    w->b.store(v, ea);\n                }\n                i++;\n            }\n            return slot;\n        },\n        ExprKind::StringLit => { return wvStringLit(w, id); },\n        ExprKind::Call | ExprKind::MethodCall => {\n            /* an aggregate result is address-valued like every aggregate:\n             * the call result's struct-typed value is the address ABI\n             * materialises into caller storage (see wvAggSlot) */\n            IrValue* res = e->kind.tag == ExprKind::Call\n                ? wvCall(w, e, id) : wvMethodCall(w, e, id);\n            if (res == null) return null;\n            if (res->type != null &&\n                (res->type->kind == IrTypeKind::Struct ||\n                 res->type->kind == IrTypeKind::Array ||\n                 res->type->kind == IrTypeKind::Vector))\n                return res;\n            if (res->type == null || res->type->kind == IrTypeKind::Void)\n                { wvErr(w, id, \"cannot take the address of a void call\"); return null; }\n            IrValue* slot = wvV(w->b.alloca(res->type));\n            if (slot == null) return null;\n            w->b.store(res, slot);\n            return slot;\n        },\n        else => { wvErr(w, id, \"unsupported assignment target\"); return null; },\n    }\n}\n\n/* element-wise aggregate copy through addresses (structs/arrays are never\n * register values in this lowering — see the aggregate rule in expr.crl) */\npub bool wvCopyAgg(Wv* w, IrValue* dst, IrValue* src, IrType* ty, u32 depth)\n{\n    if (dst == null || src == null || ty == null) return false;\n    if (depth > 16) { wvErr(w, NodeId{ .index = 0 }, \"aggregate copy too deep\"); return false; }\n    if (ty->kind == IrTypeKind::Struct)\n    {\n        u32 i = 0;\n        while (i < ty->nparams)\n        {\n            IrValue* d = wvGepField(w, dst, i);\n            IrValue* s = wvGepField(w, src, i);\n            if (d == null || s == null) return false;\n            if (!wvCopyAgg(w, d, s, ty->params[i], depth + 1)) return false;\n            i++;\n        }\n        return true;\n    }\n    if (ty->kind == IrTypeKind::Array || ty->kind == IrTypeKind::Vector)\n    {\n        u32 i = 0;\n        while (i < ty->count)\n        {\n            IrValue*[1] idxs;\n            idxs[0] = w->ir->constInt(w->ir->tyInt(32), (u64)i);\n            IrValue* d = wvV(w->b.gep(dst, idxs, 1));\n            IrValue* s = wvV(w->b.gep(src, idxs, 1));\n            if (d == null || s == null) return false;\n            if (!wvCopyAgg(w, d, s, ty->elem, depth + 1)) return false;\n            i++;\n        }\n        return true;\n    }\n    /* scalar: wallvm loads at most 8 bytes into one register */\n    u32 sz = w->ir->irTypeSizeOf(ty);\n    if (sz == 0 || sz > 8)\n    {\n        wvErr(w, NodeId{ .index = 0 }, \"scalar wider than 8 bytes in aggregate copy (Phase 2)\");\n        return false;\n    }\n    IrValue* v = wvV(w->b.load(ty, src));\n    if (v == null) return false;\n    w->b.store(v, dst);\n    return true;\n}\n\n/* compound-assignment operator: op is the Coral source operator\n * (\"+=\", \"-=\", ...); cur is the loaded lhs, rhs the evaluated rhs.\n * Returns the stored result. */\npub IrValue* wvCompoundOp(Wv* w, str op, IrValue* cur, IrValue* rhs, Ty ct, NodeId id)\n{\n    if (cur == null || rhs == null) return null;\n    ExprKind k;\n    if (op.equals(\"+=\")) k.tag = ExprKind::Add;\n    else if (op.equals(\"-=\")) k.tag = ExprKind::Sub;\n    else if (op.equals(\"*=\")) k.tag = ExprKind::Mul;\n    else if (op.equals(\"/=\")) k.tag = ExprKind::Div;\n    else if (op.equals(\"%=\")) k.tag = ExprKind::Mod;\n    else if (op.equals(\"&=\")) k.tag = ExprKind::BitAnd;\n    else if (op.equals(\"|=\")) k.tag = ExprKind::BitOr;\n    else if (op.equals(\"^=\")) k.tag = ExprKind::BitXor;\n    else if (op.equals(\"<<=\")) k.tag = ExprKind::Shl;\n    else if (op.equals(\">>=\")) k.tag = ExprKind::Shr;\n    else { wvErr(w, id, \"unsupported assignment operator\"); return null; }\n    return wvArithVals(w, k, cur, rhs, id, ct);\n}\n\n/* one assignment: address the target, then store (plain) or\n * load–combine–store (compound). Aggregates copy element-wise. Shared by\n * the ExprKind::Assign* family and StmtKind::Assign. Returns the stored\n * value, or null (void / aggregate / error). */\npub IrValue* wvAssignCommon(Wv* w, NodeId target, NodeId value, str op, NodeId id)\n{\n    IrValue* addr = wvAddrOf(w, target);\n    if (addr == null) return null;\n    Node* tn = wvNode(w, target);\n    Ty tgtTy = tn->kind.tag == NodeKind::Expr\n        ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;\n    IrType* vt = tgtTy != 0 ? wvTy(w, tgtTy, 0) : wvSlotTy(addr->type);\n    if (vt == null || vt->kind == IrTypeKind::Void)\n        { wvErr(w, id, \"cannot type assignment target\"); return null; }\n\n    if (op.equals(\"=\"))\n    {\n        if (wvIsAgg(vt))\n        {\n            IrValue* src = wvAddrOf(w, value);\n            if (src == null) return null;\n            if (!wvCopyAgg(w, addr, src, vt, 0)) return null;\n            return null;\n        }\n        IrValue* val = wvExpr(w, value);\n        if (val == null) return null;\n        w->b.store(val, addr);\n        return val;\n    }\n    if (wvIsAgg(vt)) { wvErr(w, id, \"compound assign on aggregate (Phase 2)\"); return null; }\n    IrValue* cur = wvV(w->b.load(vt, addr));\n    IrValue* rhs = wvExpr(w, value);\n    IrValue* res = wvCompoundOp(w, op, cur, rhs, tgtTy, id);\n    if (res == null) return null;\n    w->b.store(res, addr);\n    return res;\n}\n\n\n/* the value of a body node: an expression, an expression statement, or\n * a block whose last statement is one — everything before it lowers as\n * statements in its own scope. `vt` is the result type (null = no\n * value); a body that yields nothing falls back to a zero constant. */\npub IrValue* wvValBody(Wv* w, NodeId id, IrType* vt)\n{\n    if (id.index == 0) return vt != null ? w->ir->constInt(vt, 0) : null;\n    Node* n = wvNode(w, id);\n    if (n->kind.tag == NodeKind::Expr) return wvExpr(w, id);\n    if (n->kind.tag != NodeKind::Stmt)\n        { wvErr(w, id, \"expected a statement or expression body\"); return null; }\n    Stmt* s = &n->kind.payload.Stmt.value;\n    if (s->kind.tag == StmtKind::ExprStmt) return wvExpr(w, s->kind.payload.ExprStmt.expr);\n    if (s->kind.tag == StmtKind::Block)\n    {\n        u32 scopeMark = w->locLen;\n        u32 cnt = s->kind.payload.Block.stmtsLen;\n        u32 i = 0;\n        while (i + 1 < cnt && !w->term) { stmt::wvStmt(w, s->kind.payload.Block.stmts[i]); i++; }\n        IrValue* res = null;\n        if (cnt == 0 || w->term) res = vt != null ? w->ir->constInt(vt, 0) : null;\n        else\n        {\n            NodeId last = s->kind.payload.Block.stmts[cnt - 1];\n            Node* ln = wvNode(w, last);\n            if (ln->kind.tag == NodeKind::Stmt &&\n                ln->kind.payload.Stmt.value.kind.tag == StmtKind::ExprStmt)\n                res = wvExpr(w, ln->kind.payload.Stmt.value.kind.payload.ExprStmt.expr);\n            else\n            {\n                stmt::wvStmt(w, last);\n                res = vt != null ? w->ir->constInt(vt, 0) : null;\n            }\n        }\n        w->locLen = scopeMark;\n        return res;\n    }\n    wvErr(w, id, \"expected a statement or expression body\");\n    return null;\n}\n\n/* a zero-argument libc extern the source never declares (`abort` for\n * @assert). Declared once per module under its bare C name. */\nIrFunc* wvExternFn0(Wv* w, str name)\n{\n    u32 i = 0;\n    while (i < w->module->nfuncs)\n    {\n        IrFunc* f = w->module->funcs[i];\n        if (f != null && f->base.name.equals(name)) return f;\n        i++;\n    }\n    IrFunc* f = w->ir->createFunc(name, w->ir->tyVoid(), null, 0);\n    if (f == null) return null;\n    f->isExtern = true;\n    w->module->addFunc(f);\n    return f;\n}\n\n\npub IrValue* wvExpr(Wv* w, NodeId id)\n{\n    if (id.index == 0) return null;\n    Node* n = wvNode(w, id);\n    if (n->kind.tag != NodeKind::Expr)\n    {\n        wvErr(w, id, \"expected expression node\");\n        return null;\n    }\n    Expr* e = &n->kind.payload.Expr.value;\n    Ty rt = wvResolved(w, e->resolvedType);\n    switch (e->kind.tag)\n    {\n        ExprKind::IntLit => {\n            IrType* it = rt != 0 ? wvTy(w, rt, 0)\n                                 : w->ir->tyInt(32);\n            return w->ir->constInt(it, e->kind.payload.IntLit.value);\n        },\n        ExprKind::BoolLit => {\n            u64 v = (e->kind.payload.BoolLit.flags & 1) != 0 ? 1 : 0;\n            return w->ir->constInt(w->ir->tyInt(1), v);\n        },\n        ExprKind::CharLit => {\n            return w->ir->constInt(w->ir->tyInt(8), (u64)e->kind.payload.CharLit.value);\n        },\n        ExprKind::NullLit => {\n            return w->ir->constInt(w->ir->tyPtr(w->ir->tyInt(8)), 0);\n        },\n        ExprKind::FloatLit => {\n            f64 d = wvParseFloat(w, e->kind.payload.FloatLit.value);\n            IrType* ft = w->ir->tyDouble();\n            if (rt != 0 && (w->ctx->types + rt)->kind.tag == TypeKind::F32)\n                ft = w->ir->tyFloat();\n            IrValue* dv = w->ir->constFloat(w->ir->tyDouble(), d);\n            if (ft->width == 32) return wvV(w->b.fpTrunc(dv, ft));\n            return dv;\n        },\n        ExprKind::StringLit => { return wvStringLit(w, id); },\n        ExprKind::StructLiteral | ExprKind::ArrayLiteral | ExprKind::TupleExpr => {\n            /* aggregates are address-valued: the literal's slot IS the value */\n            return wvAddrOf(w, id);\n        },\n        ExprKind::Ident => {\n            Str name = e->kind.payload.Ident.name;\n            IrValue* slot = wvFindLocal(w, name);\n            if (slot != null)\n            {\n                /* rt==0: expr inside a comptime switch arm — sema skips\n                 * those arms (typecheck comptimeDepth guard) and CtEval\n                 * emits the selected one, so type from the pushed slot */\n                IrType* vt = rt != 0 ? wvTy(w, rt, 0) : wvSlotTy(slot->type);\n                if (vt == null || vt->kind == IrTypeKind::Void) return null;\n                /* an aggregate's value is its address — no load */\n                if (wvIsAgg(vt)) return slot;\n                return wvV(w->b.load(vt, slot));\n            }\n            IrValue* gv = wvResolveGlobal(w, name, id);\n            /* a function in value position is a pointer to itself. This\n             * must come before the void/aggregate guards: a function\n             * symbol is stamped with its return type (decl.crl), so a\n             * void-returning function reaches here with rt==void and\n             * would be dropped as a \"void\" name before the lookup */\n            IrFunc* fv = wvLookupFunc(w, name, id);\n            if (fv != null) return &fv->base;\n            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;\n            if (vt != null && vt->kind == IrTypeKind::Void) return null;\n            /* an aggregate's value is its address, and that address is\n             * one copy in storage — never re-materialised per use */\n            if (vt != null && wvIsAgg(vt))\n            {\n                if (gv != null) return gv;\n                wvErr(w, id, \"aggregate name has no storage\");\n                return null;\n            }\n            /* a scalar constant has no storage to read: fold it */\n            NodeId cd = wvResolveConst(w, name, id);\n            if (cd.index != 0)\n            {\n                Node* cn = wvNode(w, cd);\n                NodeId init = cn->kind.payload.Decl.value.kind.payload.Constant.value;\n                if (init.index != 0) return wvExpr(w, init);\n            }\n            /* a name that keeps storage reads through its global */\n            if (gv != null)\n            {\n                if (vt == null) vt = wvSlotTy(gv->type);\n                if (vt == null || vt->kind == IrTypeKind::Void) return null;\n                if (wvIsAgg(vt)) return gv;\n                return wvV(w->b.load(vt, gv));\n            }\n            wvErr(w, id, \"unresolved identifier\");\n            return null;\n        },\n        ExprKind::Field | ExprKind::DerefField | ExprKind::TupleField |\n        ExprKind::Index => {\n            IrValue* addr = wvAddrOf(w, id);\n            if (addr == null) return null;\n            /* rt==0 (comptime arm): the gep result already carries the\n             * field's address type — its pointee is the value type */\n            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : wvSlotTy(addr->type);\n            if (vt == null || vt->kind == IrTypeKind::Void) return null;\n            /* an aggregate's value is its address — same convention as\n             * idents and literals (array->pointer decay for a `u8*`\n             * argument is exactly this address) */\n            if (wvIsAgg(vt)) return addr;\n            return wvV(w->b.load(vt, addr));\n        },\n        ExprKind::Assign | ExprKind::AssignAdd | ExprKind::AssignSub |\n        ExprKind::AssignMul | ExprKind::AssignDiv | ExprKind::AssignMod |\n        ExprKind::AssignBitAnd | ExprKind::AssignBitOr | ExprKind::AssignBitXor |\n        ExprKind::AssignShl | ExprKind::AssignShr => {\n            NodeId target; NodeId value;\n            str op = \"=\";\n            if (e->kind.tag == ExprKind::Assign)\n                { target = e->kind.payload.Assign.target; value = e->kind.payload.Assign.value; }\n            else if (e->kind.tag == ExprKind::AssignAdd)\n                { target = e->kind.payload.AssignAdd.target; value = e->kind.payload.AssignAdd.value; op = \"+=\"; }\n            else if (e->kind.tag == ExprKind::AssignSub)\n                { target = e->kind.payload.AssignSub.target; value = e->kind.payload.AssignSub.value; op = \"-=\"; }\n            else if (e->kind.tag == ExprKind::AssignMul)\n                { target = e->kind.payload.AssignMul.target; value = e->kind.payload.AssignMul.value; op = \"*=\"; }\n            else if (e->kind.tag == ExprKind::AssignDiv)\n                { target = e->kind.payload.AssignDiv.target; value = e->kind.payload.AssignDiv.value; op = \"/=\"; }\n            else if (e->kind.tag == ExprKind::AssignMod)\n                { target = e->kind.payload.AssignMod.target; value = e->kind.payload.AssignMod.value; op = \"%=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitAnd)\n                { target = e->kind.payload.AssignBitAnd.target; value = e->kind.payload.AssignBitAnd.value; op = \"&=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitOr)\n                { target = e->kind.payload.AssignBitOr.target; value = e->kind.payload.AssignBitOr.value; op = \"|=\"; }\n            else if (e->kind.tag == ExprKind::AssignBitXor)\n                { target = e->kind.payload.AssignBitXor.target; value = e->kind.payload.AssignBitXor.value; op = \"^=\"; }\n            else if (e->kind.tag == ExprKind::AssignShl)\n                { target = e->kind.payload.AssignShl.target; value = e->kind.payload.AssignShl.value; op = \"<<=\"; }\n            else\n                { target = e->kind.payload.AssignShr.target; value = e->kind.payload.AssignShr.value; op = \">>=\"; }\n            return wvAssignCommon(w, target, value, op, id);\n        },\n        \n        ExprKind::PostInc | ExprKind::PostDec |\n        ExprKind::PreInc | ExprKind::PreDec => {\n            NodeId tgt = e->kind.payload.PostInc.expr;\n            IrValue* addr = wvAddrOf(w, tgt);\n            if (addr == null) return null;\n            Node* tn = wvNode(w, tgt);\n            Ty tt = tn->kind.tag == NodeKind::Expr\n                ? wvResolved(w, tn->kind.payload.Expr.value.resolvedType) : 0;\n            IrType* vt = tt != 0 ? wvTy(w, tt, 0) : wvSlotTy(addr->type);\n            if (vt == null || wvIsAgg(vt)) { wvErr(w, id, \"increment target is not scalar\"); return null; }\n            IrValue* cur = wvV(w->b.load(vt, addr));\n            bool dec = e->kind.tag == ExprKind::PostDec || e->kind.tag == ExprKind::PreDec;\n            IrValue* nv;\n            if (vt->kind == IrTypeKind::Float)\n            {\n                IrValue* one = w->ir->constFloat(vt, 1.0);\n                nv = wvV(dec ? w->b.fsub(cur, one) : w->b.fadd(cur, one));\n            }\n            else {\n                IrValue* one = w->ir->constInt(vt, 1);\n                nv = wvV(dec ? w->b.sub(cur, one) : w->b.add(cur, one));\n            }\n            if (nv == null) return null;\n            w->b.store(nv, addr);\n            bool post = e->kind.tag == ExprKind::PostInc || e->kind.tag == ExprKind::PostDec;\n            return post ? cur : nv;\n        },\n        \n        ExprKind::Ternary => {\n            IrValue* c = wvCond(w, wvExpr(w, e->kind.payload.Ternary.cond));\n            if (c == null) return null;\n            IrType* vt = rt != 0 ? wvTy(w, rt, 0) : null;\n            if (vt == null || vt->kind == IrTypeKind::Void)\n            {\n                /* void ternary: lower both arms as statements */\n                IrBlock* tBb = wvBlock(w, \"sel.then\");\n                IrBlock* fBb = wvBlock(w, \"sel.else\");\n                IrBlock* jBb = wvBlock(w, \"sel.end\");\n                w->b.condBr(c, tBb, fBb);\n                wvSetBlock(w, tBb);\n                wvExpr(w, e->kind.payload.Ternary.thenExpr);\n                if (!w->term) w->b.br(jBb);\n                wvSetBlock(w, fBb);\n                wvExpr(w, e->kind.payload.Ternary.elseExpr);\n                if (!w->term) w->b.br(jBb);\n                wvSetBlock(w, jBb);\n                return null;\n            }\n            if (wvIsAgg(vt)) { wvErr(w, id, \"aggregate ternary (Phase 2)\"); return null; }\n            IrValue* slot = wvV(w->b.alloca(vt));\n            if (slot == null) return null;\n            IrBlock* tBb = wvBlock(w, \"sel.then\");\n            IrBlock* fBb = wvBlock(w, \"sel.else\");\n            IrBlock* jBb = wvBlock(w, \"sel.end\");\n            w->b.condBr(c, tBb, fBb);\n            wvSetBlock(w, tBb);\n            IrValue* tv = wvExpr(w, e->kind.payload.Ternary.thenExpr);\n            if (tv != null) w->b.store(tv, slot);\n            w->b.br(jBb);\n            wvSetBlock(w, fBb);\n            IrValue* fv = wvExpr(w, e->kind.payload.Ternary.elseExpr);\n            if (fv != null) w->b.store(fv, slot);\n            w->b.br(jBb);\n            wvSetBlock(w, jBb);\n            return wvV(w->b.load(vt, slot));\n        },\n        \n        ExprKind::Call => { return wvCall(w, e, id); },\n        ExprKind::MethodCall => { return wvMethodCall(w, e, id); },\n        \n        ExprKind::Path => {\n            NodeId* segs = e->kind.payload.Path.segments;\n            u32 sn = e->kind.payload.Path.segmentsLen;\n            if (sn == 0) { wvErr(w, id, \"empty path expression\"); return null; }\n            /* a value reference through a namespace resolves to its\n             * final segment (a function becomes its address, a constant\n             * folds, an enum/variant name reports and gets fixed when\n             * the layout work lands) */\n            retu