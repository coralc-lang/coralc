keyword in expression position is a type\n                 * value: `@typeof(x) == i32` in a comptime block. sema\n                 * rejects it everywhere a runtime value is required. */\n                if (self.isTypeStart() &&\n                    self.current.kind != TokenKind::Ident &&\n                    self.current.kind != TokenKind::LParen &&\n                    self.current.kind != TokenKind::Const &&\n                    self.current.kind != TokenKind::Comptime &&\n                    self.current.kind != TokenKind::Flag &&\n                    self.current.kind != TokenKind::Struct)\n                {\n                    Ty typeValue = self.parseType();\n                    return self.storeExpr(ExprKind::TypeRef{ .name = 0, .typeNode = typeValue });\n                }\n                /* a reserved keyword is not a missing expression — name it,\n                 * so `return any;`/`x + struct;` don't read as P0002 noise */\n                if (self.current.info != null && self.current.info->isKeyword)\n                {\n                    Token kwTok = self.current;\n                    self.reportKeywordAsIdent(kwTok);\n                    if (!self.atEnd()) self.advance();\n                    return self.noneNode();\n                }\n                // consume a token (unless at EOF) so callers can't spin on us\n                self.reportExpectedWith(ErrorCode::ParseExpectedExpr, \"expected an expression\");\n                if (!self.atEnd()) self.advance();\n                return self.noneNode();\n            }\n        }\n    }\n\n    /* `{ .name = expr, ... }` fields of a struct literal, or of a\n     * variant construction (`Type::Variant { ... }`, variant != 0).\n     * When no entry carries `name =` the literal is positional:\n     * values map onto fields in declaration order (same as the\n     * untyped brace form `T x = { v1, v2 }`). */\n    NodeId parseLiteralFields(Ty typeNode, Str variantName)\n    {\n        self.expect(TokenKind::LBrace);\n        // lookahead: `ident =` means named fields, anything else positional\n        bool positional = false;\n        if (self.current.kind != TokenKind::RBrace && self.current.kind != TokenKind::Dot)\n        {\n            if (self.current.kind == TokenKind::Ident)\n            {\n                ParserMark m = self.save();\n                self.advance();\n                positional = self.current.kind != TokenKind::Equal;\n                self.restore(m);\n            }\n            else positional = true;\n        }\n        StrListBuilder fields;\n        NodeListBuilder values;\n        self.ctx->strListInit(&fields);\n        self.ctx->nodeListInit(&values);\n        if (positional)\n        {\n            while (self.current.kind != TokenKind::RBrace && !self.atEnd())\n            {\n                NodeId value = self.parseInitExpr();\n                if (!self.ctx->nodeListAppend(&values, value)) self.reportAllocFailed();\n                if (!self.match(TokenKind::Comma)) break;\n            }\n        }\n        else\n        {\n            while (self.current.kind != TokenKind::RBrace && !self.atEnd())\n            {\n                // leading dot is optional inside the braces\n                self.match(TokenKind::Dot);\n                Token field = self.expectName();\n                Str fieldName = self.ctx->intern(field.data.asStr());\n                self.expect(TokenKind::Equal);\n                // initializer position, like the positional branch: a\n                // nested `{ … }` is an array literal, not a block\n                NodeId value = self.parseInitExpr();\n                if (!self.ctx->strListAppend(&fields, fieldName)) self.reportAllocFailed();\n                if (!self.ctx->nodeListAppend(&values, value)) self.reportAllocFailed();\n                if (!self.match(TokenKind::Comma)) break;\n            }\n        }\n        self.expect(TokenKind::RBrace);\n        // positional literals carry values only: fieldNames stays null and\n        // the field count comes from the values array\n        u32 count = positional ? values.len : fields.len;\n        Str* fieldNames = self.ctx->strListFinish(&fields);\n        if (positional) fieldNames = null;\n        NodeId* fieldValues = self.ctx->nodeListFinish(&values);\n        return self.storeExpr(ExprKind::StructLiteral{ .typeNode = typeNode, .variantName = variantName, .fieldNames = fieldNames, .fieldValues = fieldValues, .fieldValuesLen = count });\n    }\n\n    // type carried by the head segment of a path (for `T::V { ... }`)\n    Ty pathHeadType(NodeId e)\n    {\n        Node* n = self.ctx->nodes + e.index;\n        if (n->kind.tag != NodeKind::Expr) return 0;\n        Expr* x = &n->kind.payload.Expr.value;\n        if (x->kind.tag == ExprKind::TypeRef) return x->kind.payload.TypeRef.typeNode;\n        if (x->kind.tag == ExprKind::Ident) return self.makeNamed(x->kind.payload.Ident.name);\n        if (x->kind.tag == ExprKind::Path) {\n            if (x->kind.payload.Path.segmentsLen > 0) return self.pathHeadType(x->kind.payload.Path.segments[0]);\n        }\n        return 0;\n    }\n\n    /* one arm: `pat | pat, pat if guard => body`. flags bit 0 = guard\n     * present (codegen checks it); bit 2 (4) = else arm. the ast header\n     * lists bit 1 as fallthrough, but nothing here sets that; codegen\n     * only ever reads bits 0 and 2 */\n    SwitchCase parseSwitchExprCase()\n    {\n        SwitchCase c;\n        c.patterns = null;\n        c.patternsLen = 0;\n        c.guard = self.noneNode();\n        c.body = self.noneNode();\n        c.flags = 0;\n\n        if (self.match(TokenKind::Else)) {\n            c.flags = 4;\n            self.expect(TokenKind::FatArrow);\n            c.body = self.parseExpr();\n            self.match(TokenKind::Comma);\n            return c;\n        }\n\n        NodeListBuilder patterns;\n        self.ctx->nodeListInit(&patterns);\n        NodeId pattern = self.parseSwitchPattern();\n        if (!self.ctx->nodeListAppend(&patterns, pattern)) self.reportAllocFailed();\n        while (self.match(TokenKind::Pipe)) {\n            pattern = self.parseSwitchPattern();\n            if (!self.ctx->nodeListAppend(&patterns, pattern)) self.reportAllocFailed();\n        }\n        while (self.match(TokenKind::Comma)) {\n            pattern = self.parseSwitchPattern();\n            if (!self.ctx->nodeListAppend(&patterns, pattern)) self.reportAllocFailed();\n        }\n        c.patternsLen = patterns.len;\n        c.patterns = self.ctx->nodeListFinish(&patterns);\n        if (self.match(TokenKind::If)) {\n            c.guard = self.parseExpr();\n            c.flags |= 1;\n        }\n        self.expect(TokenKind::FatArrow);\n        c.body = self.parseExpr();\n        self.match(TokenKind::Comma);\n        return c;\n    }\n\n    NodeId parseSwitchExprPattern() { return self.parseSwitchPattern(); }\n}"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-parser/pattern.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n\n// parser/pattern.crl: switch patterns\n//\n// raw tokens to Pat nodes: idents, `T::V {}` / `V {}` variants, struct\n// shapes, tuples, literals, `any <trait>`. type-prefix forms (`const T*`,\n// `T*`) are captured as source text into a scratch buffer, interned, and\n// the buffer freed; no structured type ever comes out of those branches.\n\nimport std::mman { alloc, dealloc };\nuse common::token { Token, TokenKind };\nuse diag::code { ErrorCode };\nuse context::context { AstContext, NodeListBuilder, StrListBuilder };\nuse ast::id { NodeId, Str };\nuse ast::pat { Pat, PatKind };\nuse ast::node { Node, NodeKind };\nuse base { Parser };\n\npub extend Parser\n{\n    // leading `|` opens an or-group (`| A | B`); the `A | B` delimiter\n    // form is folded by the case parsers, each `|` must be followed by one\n    NodeId parseSwitchPattern()\n    {\n        TokenKind k = self.current.kind;\n        if (k == TokenKind::Pipe)\n        {\n            NodeListBuilder alternatives;\n            self.ctx->nodeListInit(&alternatives);\n            while (self.match(TokenKind::Pipe))\n            {\n                NodeId pat = self.parseSwitchPattern();\n                if (!self.ctx->nodeListAppend(&alternatives, pat)) self.reportAllocFailed();\n            }\n            u32 count = alternatives.len;\n            NodeId* values = self.ctx->nodeListFinish(&alternatives);\n            return self.storePat(PatKind::Or{ .alternatives = values, .alternativesLen = count });\n        }\n        if (k == TokenKind::Any)\n        {\n            self.advance(); // any\n            Token tTok = self.expect(TokenKind::Ident);\n            Str tn = self.ctx->intern(tTok.data.asStr());\n            /* stored as a nominal pattern naming `any <trait>`; semantic\n             * refinement plus codegen-on-AnyTrait is a later todo */\n            return self.storePat(PatKind::Ident{ .name = tn });\n        }\n        if (k == TokenKind::Const)\n        {\n            /* `const T*` style pattern-name: read a type prefix and turn it\n             * into a nominal pattern storing its source text (the pattern\n             * selector in control flow will be this text). */\n            u8* buf = alloc<u8>(256);\n            usize bpos = 0;\n            // current is TokenKind::Const\n            while (true)\n            {\n                TokenKind kk = self.current.kind;\n                bool takes = false;\n                if (kk == TokenKind::Ident || kk == TokenKind::Void || kk == TokenKind::Bool ||\n                    kk == TokenKind::Char || kk == TokenKind::U8 || kk == TokenKind::I8 ||\n                    kk == TokenKind::U16 || kk == TokenKind::I16 || kk == TokenKind::U32 ||\n                    kk == TokenKind::I32 || kk == TokenKind::U64 || kk == TokenKind::I64 ||\n                    kk == TokenKind::U128 || kk == TokenKind::I128 || kk == TokenKind::F32 ||\n                    kk == TokenKind::F64 || kk == TokenKind::Usize || kk == TokenKind::Isize ||\n                    kk == TokenKind::Rawptr || kk == TokenKind::Str || kk == TokenKind::Const ||\n                    kk == TokenKind::Star || kk == TokenKind::Ampersand || kk == TokenKind::LParen ||\n                    kk == TokenKind::RParen || kk == TokenKind::LBracket || kk == TokenKind::RBracket ||\n                    kk == TokenKind::Less || kk == TokenKind::Greater || kk == TokenKind::ColonColon)\n                {\n                    takes = true;\n                }\n                if (!takes) break;\n                Token tk2 = self.advance();\n                if (bpos > 0 && bpos + tk2.data.len < 255)\n                {\n                    // separate two alphanums with a space, the rest flush\n                    if (tk2.kind != TokenKind::Star && tk2.kind != TokenKind::R