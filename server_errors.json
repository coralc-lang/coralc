uals, \"expected = after string key\");\n                CrlbNode child;\n                child.init(CrlbNodeKind::DepEntry, self.arena);\n                child.label = key;\n                child.hasLabel = true;\n                if (self.check(CrlbTokenKind::LBrace)) self.parseBlockInto(&child);\n                self.expect(CrlbTokenKind::Semi, \"expected ; after entry\");\n                node->addChild(&child);\n                continue;\n            }\n            self.errorAt(self.cur, \"unexpected token in block\");\n            self.advance();\n        }\n        self.expect(CrlbTokenKind::RBrace, \"expected } to close block\");\n    }\n\n    // ── top-level declarations ───────────────────────────────────────\n\n    CrlbNode* parseTopDecl()\n    {\n        if (!self.check(CrlbTokenKind::Ident))\n        {\n            self.errorAt(self.cur, \"expected declaration\");\n            self.advance();\n            return null;\n        }\n        Slice kw = self.cur.text;\n        self.advance();\n\n        // schema = 1;   strict = true;\n        if (kw.eq(Slice::fromStr(\"schema\")) || kw.eq(Slice::fromStr(\"strict\")))\n        {\n            CrlbNodeKind k = CrlbNodeKind::Schema;\n            if (kw.eq(Slice::fromStr(\"strict\"))) k = CrlbNodeKind::Strict;\n            CrlbNode* n = (CrlbNode*)self.arena->alloc(@sizeof(CrlbNode), 8);\n            if (n == null) return null;\n            n->init(k, self.arena);\n            self.expect(CrlbTokenKind::Equals, \"expected = in schema/strict decl\");\n            Value v = self.parseValue();\n            self.expect(CrlbTokenKind::Semi, \"expected ; after schema/strict\");\n            n->addField(kw, v);\n            return n;\n        }\n\n        // alias name = \"target\";\n        if (kw.eq(Slice::fromStr(\"alias\")))\n        {\n            CrlbNode* n = (CrlbNode*)self.arena->alloc(@sizeof(CrlbNode), 8);\n            if (n == null) return null;\n            n->init(CrlbNodeKind::Alias, self.arena);\n       