{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-semantics/typecheck.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* typecheck.crl: type identity and compatibility: sameType (structural),\n * compatible (assignment leniency), substituteFieldTy (generic object →\n * field type), and the singleton getters for primitive types. the dump of\n * `compatible` rules at the bottom is the one that decides what compiles. */\nuse ast::id { Str, NodeId };\nuse ast::types { Ty, TypeEntry, TypeKind };\nuse ast::node { Node, NodeKind };\nuse ast::expr { Expr };\nuse ast::decl { Decl, DeclKind, GenericParam, Param };\nuse scope { Symbol };\nuse sema { Sema };\nuse diag::code { ErrorCode };\nuse expr;\nimport std::mman { alloc, dealloc };\n\npub extend Sema\n{\n    // primitive type singletons\n\n    /* synthesize a type-table slot. the local is ceremony; the loc reset is\n     * the point: a synthesized type has no source site, so lookupType falls\n     * back to plain scope lookup instead of file-preferred resolution. */\n    Ty allocType(TypeKind kind)\n    {\n        Ty id = self.ctx->allocTypeSlot();\n        if (id == 0) {\n            self.semaErrorNode(ErrorCode::SemaInternal, self.ctx->noneNode(), \"allocTypeSlot failed (type table full)\");\n            return 0;\n        }\n        TypeEntry* entry = self.ctx->types + id;\n        entry->kind = kind;\n        entry->loc.data = 0;\n        return id;\n    }\n\n    /* one singleton per primitive. the type arena hash index answers the\n     * \"first entry with this shape\" question in O(1); the linear scan stays\n     * as the fallback ground truth (the table only grows and slots are\n     * never removed, so the first hit is stable). */\n    Ty pureType(TypeKind q)\n    {\n        Ty t = self.ctx->tyIdxFind(q);\n        if (t != 0) return t;\n        u32 i = 1;\n        while (i < self.ctx->typesLen) {\n            if (self.ctx->types[i].kind.tag == q.tag) {\n                self.ctx->tyIdxInsert(q, i);\n                return i;\n            }\n            i++;\n        }\n        t = self.allocType(q);\n        if (t != 0) self.ctx->tyIdxInsert(q, t);\n        return t;\n    }\n\n    Ty boolType()\n    {\n        TypeKind q;\n        q.tag = TypeKind::Bool;\n        return self.pureType(q);\n    }\n\n    Ty u32Type()\n    {\n        TypeKind q;\n        q.tag = TypeKind::U32;\n        return self.pureType(q);\n    }\n\n    Ty u8Type()\n    {\n        TypeKind q;\n        q.tag = TypeKind::U8;\n        return self.pureType(q);\n    }\n\n    Ty u16Type()\n    {\n        TypeKind q;\n        q.tag = TypeKind::U16;\n        return self.pureType(q);\n    }\n\n    Ty u64Type()\n    {\n        TypeKind q;\n        q.tag = TypeKind::U64;\n        return self.pureType(q);\n    }\n\n    Ty rawptrType()\n    {\n        TypeKind q;\n        q.tag = TypeKind::Rawptr;\n        return self.pureType(q);\n    }\n\n    Ty usizeType()\n    {\n        TypeKind q;\n        q.tag = TypeKind::Usize;\n        return self.pureType(q);\n    }\n\n    /* str.ptr: u8* (byte view into the literal/storage; str is a byte\n     * string, `char` is utf32 and never a byte). The shape matches what\n     * `const u8*` spells — const is shallow and stripped on both sides by\n     * compatible(), so Pointer{Const{u8}} would only differ structurally\n     * while behaving identically. */\n    Ty strPtrType()\n    {\n        return self.slicePtrType(self.u8Type());\n    }\n\n    /* slice.ptr: T* into the slice's storage (mutable — unlike str's\n     * const byte view, a T[] may alias writable data) */\n    Ty slicePtrType(Ty base)\n    {\n        if (base == 0) return 0;\n        TypeKind q;\n        q.tag = TypeKind::Pointer;\n        q.payload.Pointer.base = base;\n        Ty t = self.ctx->tyIdxFind(q);\n        if (t != 0) return t;\n        u32 i = 1;\n        while (i < self.ctx->typesLen) {\n            TypeEntry* e = self.ctx->types + i;\n            if (e->kind.tag == TypeKind::Pointer && e->kind.payload.Pointer.base == base) {\n                self.ctx->tyIdxInsert(q, i);\n                return i;\n            }\n            i++;\n        }\n        t = self.allocType(q);\n        if (t != 0) self.ctx->tyIdxInsert(q, t);\n        return t;\n    }\n\n    /* C\"...\" → const cchar*, NUL-terminated C-ABI byte string, matching\n     * libc's `const cchar*` params (printf/snprintf/...). Built by name so\n     * the literal type-checks against those params without the calling\n     * file importing cchar itself; sameType compares Named by name. */\n    Ty ccharPtrType()\n    {\n        Str cn = self.ctx->tyIdxCcharLit();\n        TypeKind qn;\n        qn.tag = TypeKind::Named;\n        qn.payload.Named.name = cn;\n        qn.payload.Named.genericArgs = null;\n        qn.payload.Named.genericArgsLen = 0;\n        Ty named = self.ctx->tyIdxFindNamed(cn, true);\n        if (named == 0) {\n            u32 i = 1;\n            while (i < self.ctx->typesLen) {\n                TypeEntry* e = self.ctx->types + i;\n                if (e->kind.tag == TypeKind::Named && e->kind.payload.Named.name == cn &&\n                    e->kind.payload.Named.genericArgsLen == 0) { named = i; break; }\n                i++;\n            }\n            if (named == 0) named = self.allocType(qn);\n            if (named != 0) self.ctx->tyIdxInsert(qn, named);\n        }\n        /* Const{Pointer{Named}}: the shape `const cchar*` params parse to\n         * (type-position const wraps the whole type) and, via compatible()'s\n         * source-const strip, also assignable to statement-const locals\n         * (`const cchar* s` = bare Pointer + const flag). both halves are\n         * indexed — the old code allocated a fresh Pointer+Const per call. */\n        TypeKind pk;\n        pk.tag = TypeKind::Pointer;\n        pk.payload.Pointer.base = named;\n        Ty ptr = self.ctx->tyIdxFind(pk);\n        if (ptr 