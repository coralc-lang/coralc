=> {\n                self.advance();\n                self.expect(TokenKind::LParen);\n                NodeId typeofExpr = self.parseExpr();\n                self.expect(TokenKind::RParen);\n                return self.storeExpr(ExprKind::Typeof{ .expr = typeofExpr });\n            },\n            \n            TokenKind::BuiltinAssert => {\n                self.advance();\n                self.expect(TokenKind::LParen);\n                NodeListBuilder bargs;\n                self.ctx->nodeListInit(&bargs);\n                if (self.current.kind != TokenKind::RParen) {\n                    NodeId barg = self.parseExpr();\n                    if (!self.ctx->nodeListAppend(&bargs, barg)) self.reportAllocFailed();\n                    while (self.match(TokenKind::Comma)) {\n                        barg = self.parseExpr();\n                        if (!self.ctx->nodeListAppend(&bargs, barg)) self.reportAllocFailed();\n                    }\n                }\n                self.expect(TokenKind::RParen);\n                u32 bargCount = bargs.len;\n                NodeId* bargValues = self.ctx->nodeListFinish(&bargs);\n                return self.storeExpr(ExprKind::BuiltinCall{ .name = self.ctx->intern(\"assert\"), .builtin = BUILTIN_ASSERT, .args = bargValues, .argsLen = bargCount });\n            },\n            \n            TokenKind::Flag => { return self.parseFlagExpr(); },\n\n            TokenKind::At => {\n                self.advance();\n                if (self.current.kind == TokenKind::BuiltinSizeof)\n                {\n                    self.advance();\n                    self.expect(TokenKind::LParen);\n                    Ty szType = self.parseType();\n                    self.expect(TokenKind::RParen);\n                    return self.storeExpr(ExprKind::Sizeof{ .targetType = szType });\n                }\n                // a couple of builtins lex as keywords, the rest as idents;\n                // the BUILTIN_* identity is assigned here, once