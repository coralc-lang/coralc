{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-parser/expr.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* parser/expr.crl: expression parsing\n *\n * Clang-style precedence climbing: one function handles all\n * binary operators, parameterized by minimum precedence.\n *\n * the descent chain is parseExpr → parseBinaryExpr → parseUnaryExpr →\n * parsePostfixExpr → parsePrimaryExpr, one layer per precedence class.\n * there's no nesting guard anywhere in the parser: a pathological\n * `((((...` file recurses until the process stack gives out.\n */\n\nuse parser;\nuse diag::code { ErrorCode };\nuse base { Parser, ParserMark };\nuse context::context { AstContext, NodeListBuilder, StrListBuilder, SwitchListBuilder };\nuse common::token { Token, TokenKind };\nuse lexer {\n    escape { EscapeResult },\n    ident { decodeUtf8 },\n};\nuse ast {\n    id { NodeId, Str },\n    types { Ty, TypeEntry },\n    expr { Expr, ExprKind, BUILTIN_NONE, BUILTIN_ASSERT, BUILTIN_ASSERTOUT,\n           BUILTIN_COMPILEERROR, BUILTIN_ISFORMATLITERAL, BUILTIN_TYPEOF,\n           BUILTIN_PANIC, BUILTIN_UNREACHABLE, BUILTIN_REPORT, BUILTIN_REPORTHEX,\n           BUILTIN_ABORTNOW, BUILTIN_ASSERTEQ, BUILTIN_ASSERTNE, BUILTIN_ASSERTLT,\n           BUILTIN_ASSERTLE, BUILTIN_ASSERTGT, BUILTIN_ASSERTGE,\n           BUILTIN_ASSERTRANGE, BUILTIN_ASSERTNONNULL, BUILTIN_ASSERTALIGNED,\n           BUILTIN_BACKTRACETO },\n    stmt { SwitchCase },\n    node { Node, NodeKind }\n};\n\npub extend Parser\n{\n    /* ── operator table ── */\n\n    /* binding powers for parseBinaryExpr. assignment sits at 1 and is\n     * right-assoc (handled by parseExpr itself); higher number = tighter.\n     * left-assoc operators recurse with p+1, right-assoc with p-1, so a\n     * gap of at least 1 between any two levels is load-bearing */\n    i32 prec(TokenKind kind)\n    {\n        switch (kind)\n        {\n            TokenKind::Equal => { return 1; },\n            TokenKind::PlusEqual => { return 1; },\n            TokenKind::MinusEqual => { return 1; },\n            TokenKind::StarEqual => { return 1; },\n            TokenKind::SlashEqual => { return 1; },\n            TokenKind::PercentEqual => { return 1; },\n            TokenKind::AmpEqual => { return 1; },\n            TokenKind::PipeEqual => { return 1; },\n            TokenKind::CaretEqual => { return 1; },\n            TokenKind::ShlEqual => { return 1; },\n            TokenKind::ShrEqual => { return 1; },\n            TokenKind::NegEqual => { return 1; },\n            TokenKind::Or => { return 2; },\n            TokenKind::And => { return 3; },\n            TokenKind::Pipe => { return 4; },\n            TokenKind::Caret => { return 5; },\n            TokenKind::Ampersand => { return 6; },\n            TokenKind::EqualEqual => { return 7; },\n            TokenKind::NotEqual => { return 7; },\n            TokenKind::Less => { return 8; },\n            TokenKind::LessEqual => { return 8; },\n            TokenKind::Greater => { return 8; },\n            TokenKind::GreaterEqual => { return 8; },\n            TokenKind::Shl => { return 9; },\n            TokenKind::Shr => { return 9; },\n            TokenKind::Plus => { return 10; },\n            TokenKind::Minus => { return 10; },\n            TokenKind::Star => { return 11; },\n            TokenKind::Slash => { return 11; },\n            TokenKind::Percent => { return 11; },\n            else => { return 0; }\n        }\n    }\n\n    // must agree with prec() == 1: parseExpr and parseBinaryExpr both lean on it\n    bool isAssignOp(TokenKind kind)\n    {\n        return kind == TokenKind::Equal ||\n               kind == TokenKind::PlusEqual ||\n               kind == TokenKind::MinusEqual ||\n               kind == TokenKind::StarEqual ||\n               kind == TokenKind::SlashEqual ||\n               kind == TokenKind::PercentEqual ||\n               kind == TokenKind::AmpEqual ||\n               kind == TokenKind::PipeEqual ||\n               kind == TokenKind::CaretEqual ||\n               kind == TokenKind::ShlEqual ||\n               kind == TokenKind::ShrEqual ||\n               kind == TokenKind::NegEqual;\n    }\n\n    // fresh expr node stamped with the last consumed token; resolvedType\n    // starts 0 and sema fills it in later (typecheck.crl)\n    NodeId storeExpr(ExprKind kind)\n    {\n        return self.storeNode(NodeKind::Expr{\n            .value = Expr {\n                .kind = kind,\n                .loc = self.tokenLoc(self.previous),\n                .resolvedType = 0 \n            }\n        });\n    }\n\n    /* ── call arguments ── */\n\n    /* parses `a, b, ...` up to (not including) the closing `)`. trailing\n     * comma is legal. the builder belongs to the caller; finish() hands\n     * the array to the ctx, which owns it until deinit */\n    void parseCallArgs(NodeListBuilder* args)\n    {\n        self.ctx->nodeListInit(args);\n        if (self.current.kind == TokenKind::RParen) return;\n        NodeId arg = self.parseCallArg();\n        if (!self.ctx->nodeListAppend(args, arg)) self.reportAllocFailed();\n        while (self.match(TokenKind::Comma))\n        {\n            if (self.current.kind == TokenKind::RParen) break;\n            arg = self.parseCallArg();\n            if (!self.ctx->nodeListAppend(args, arg)) self.reportAllocFailed();\n        }\n    }\n\n    /* one call argument: `...expr` spreads a variadic pack; a bare `...`\n     * forwards all remaining variadic args (empty expr); otherwise a\n     * plain expression */\n    NodeId parseCallArg()\n    {\n        if (self.current.kind == TokenKind::Ellipsis)\n        {\n            self.advance();\n            // bare `...` immediately before `)` or `,` = spread-all\n            if (self.current.kind == TokenKind::RParen || self.current.kind == TokenKind::Comma)\n            {\n                NodeId noneId;\n                noneId.index = 0;\n                return self.storeExpr(ExprKind::Spread{ .expr = noneId });\n            }\n            NodeId inner = self.parseExpr();\n            return self.storeExpr(ExprKind::Spread{ .expr = inner });\n        }\n        return self.parseExpr();\n    }\n\n    /* Initializer lists for array/const-array decls: `= { a, b, ... }`.\n     * In expression position a bare `{` still parses as a block. */\n    NodeId parseInitExpr()\n    {\n        if (self.current.kind == TokenKind::LBrace)\n        {\n            /* `{ .field = … }`: a bare designated struct literal; the type\n             * comes from the declarator (patched in during sema) */\n            {\n                // `{ .` lookahead: designated fields, not a block\n                ParserMark m = self.save();\n                self.advance();\n                bool designated = self.current.kind == TokenKind::Dot;\n                self.restore(m);\n                if (designated) return self.parseLiteralFields(0, 0);\n            }\n            self.advance();\n            NodeListBuilder elems;\n            self.ctx->nodeListInit(&elems);\n            while (self.current.kind != TokenKind::RBrace && !self.atEnd())\n            {\n                NodeId e = self.parseInitExpr();\n                if (!self.ctx->nodeListAppend(&elems, e)) self.reportAllocFailed();\n                if (!self.match(TokenKind::Comma)) break;\n            }\n            self.expect(TokenKind::RBrace);\n            u32 count = elems.len;\n            NodeId* values = self.ctx->nodeListFinish(&elems);\n            return self.storeExpr(ExprKind::ArrayLiteral{ .elems = values, .elemsLen = count });\n        }\n        return self.parseExpr();\n    }\n\n    /* `T name[] = { … }`: an empty `[]` declarator parses as a Slice (type.crl\n     * has no \"unsized array\" kind), but a brace initializer means C's array\n     * sized from its elements. rewrite the type before sema ever sees it. */\n    Ty inferArrayFromInit(Ty ty, NodeId init)\n    {\n        if (ty == 0 || init.index == 0) return ty;\n        TypeEntry* te = self.ctx->types + ty;\n        if (te->kind.tag != TypeKind::Slice) return ty;\n        Node* n = self.ctx->nodes + init.index;\n        if (n->kind.tag != NodeKind::Expr) return ty;\n        Expr* e = &n->kind.payload.Expr.value;\n        if (e->kind.tag != ExprKind::ArrayLiteral) return ty;\n        return self.makeArray(te->kind.payload.Slice.base, (u32)e->kind.payload.ArrayLiteral.elemsLen);\n    }\n\n    /* ── the entry level: assignment and ternary ── */\n\n    /* everything funnels through here. assignment binds right (`a = b = c`\n     * is `a = (b = c)`) and ternary branches are full parseExpr calls, so\n     * `a = b ? c : d` means `a = (b ? c : d)` like C. binary parsing starts\n     * at 2 because assignment is prec 1 and handled right here; the op's\n     * text pointer is stashed for stmt.crl's #[[condassign]] check */\n    NodeId parseExpr()\n    {\n        NodeId cond = self.parseBinaryExpr(2);\n        if (self.match(TokenKind::Question))\n        {\n            NodeId thenExpr = self.parseExpr();\n            self.expect(TokenKind::Colon);\n            NodeId elseExpr = self.parseExpr();\n            return self.storeExpr(ExprKind::Ternary{ .cond = cond, .thenExpr = thenExpr, .elseExpr = elseExpr });\n        }\n        if (self.isAssignOp(self.current.kind))\n        {\n            Token op = self.advance();\n            self.lastAssignLine = op.line;\n            self.lastAssignCol = op.col;\n            /* `x = { … }` is an initializer, not a block. only plain `=`\n             * adopts brace literals; compound ops keep the block reading */\n            NodeId right;\n            if (op.kind == TokenKind::Equal) right = self.parseInitExpr();\n            else right = self.parseExpr();\n            return self.makeBinOp(op.kind, cond, right);\n        }\n        return cond;\n    }\n\n    /* precedence climbing proper: consume operators while they bind at\n     * least as tight as minPrec. the p+1/p-1 recursion split (see prec)\n     * is what makes associativity fall out of one loop */\n    NodeId parseBinaryExpr(i32 minPrec)\n    {\n        NodeId left = self.parseUnaryExpr();\n\n        while (true)\n        {\n            i32 p = self.prec(self.current.kind);\n            // 0 = not a binary op, or one that binds looser than this level\n            if (p == 0 || p < minPrec) break;\n\n            Token op = self.advance();\n            // assignment is right-assoc: `a = b = c` means `a = (b = c)`\n            bool rightAssoc = self.isAssignOp(op.kind);\n            if (rightAssoc) { self.lastAssignLine = op.line; self.lastAssignCol = op.col; }\n            NodeId right;\n            if (rightAssoc) {\n                right = self.parseBinaryExpr(p - 1); }\n            else {\n                right = self.parseBinaryExpr(p + 1); }\n            left = self.makeBinOp(op.kind, left, right);\n        }\n\n        return left;\n    }\n\n    NodeId makeBinOp(TokenKind op, NodeId left, NodeId right)\n    {\n        switch (op)\n        {\n            TokenKind::Plus => { return self.storeExpr(ExprKind::Add{ .left = left, .right = right }); },\n            TokenKind::Minus => { return self.storeExpr(ExprKind::Sub{ .left = left, .right = right }); },\n            TokenKind::Star => { return self.storeExpr(ExprKind::Mul{ .left = left, .right = right }); },\n            TokenKind::Slash => { return self.storeExpr(ExprKind::Div{ .left = left, .right = right }); },\n            TokenKind::Percent => { return self.storeExpr(ExprKind::Mod{ .left = left, .right = right }); },\n            TokenKind::EqualEqual => { return self.storeExpr(ExprKind::Eq{ .left = left, .right = right }); },\n            TokenKind::NotEqual => { return self.storeExpr(ExprKind::Ne{ .left = left, .right = right }); },\n            TokenKind::Less => { return self.storeExpr(ExprKind::Lt{ .left = left, .right = right }); },\n            TokenKind::LessEqual => { return self.storeExpr(ExprKind::Le{ .left = left, .right = right }); },\n            TokenKind::Greater => { return self.storeExpr(ExprKind::Gt{ .left = left, .right = right }); },\n            TokenKind::GreaterEqual => { return self.storeExpr(ExprKind::Ge{ .left = left, .right = right }); },\n            TokenKind::And => { return self.storeExpr(ExprKind::And{ .left = left, .right = right }); },\n            TokenKind::Or => { return self.storeExpr(ExprKind::Or{ .left = left, .right = right }); },\n            TokenKind::Ampersand => { return self.storeExpr(ExprKind::BitAnd{ .left = left, .right = right }); },\n            TokenKind::Pipe => { return self.storeExpr(ExprKind::BitOr{ .left = left, .right = right }); },\n            TokenKind::Caret => { return self.storeExpr(ExprKind::BitXor{ .left = left, .right = right }); },\n            TokenKind::Shl => { return self.storeExpr(ExprKind::Shl{ .left = left, .right = right }); },\n            TokenKind::Shr => { return self.storeExpr(ExprKind::Shr{ .left = left, .right = right }); },\n            TokenKind::Equal => { return self.storeExpr(ExprKind::Assign{ .target = left, .value = right }); },\n            TokenKind::PlusEqual => { return self.storeExpr(ExprKind::AssignAdd{ .target = left, .value = right }); },\n            TokenKind::MinusEqual => { return self.storeExpr(ExprKind::AssignSub{ .target = left, .value = right }); },\n            TokenKind::StarEqual => { return self.storeExpr(ExprKind::AssignMul{ .target = left, .value = right }); },\n            TokenKind::SlashEqual => { return self.storeExpr(ExprKind::AssignDiv{ .target = left, .value = right }); },\n            TokenKind::PercentEqual => { return self.storeExpr(ExprKind::AssignMod{ .target = left, .value = right }); },\n            TokenKind::AmpEqual => { return self.storeExpr(ExprKind::AssignBitAnd{ .target = left, .value = right }); },\n            TokenKind::PipeEqual => { return self.storeExpr(ExprKind::AssignBitOr{ .target = left, .value = right }); },\n            TokenKind::CaretEqual => { return self.storeExpr(ExprKind::AssignBitXor{ .target = left, .value = right }); },\n            TokenKind::ShlEqual => { return self.storeExpr(ExprKind::AssignShl{ .target = left, .value = right }); },\n            TokenKind::ShrEqual => { return self.storeExpr(ExprKind::AssignShr{ .target = left, .value = right }); },\n            /* `~=` is coral's neg-assign; there's no ExprKind for it, so\n             * desugar to Assign(target, BitNot(right)) */\n            TokenKind::NegEqual => { return self.storeExpr(ExprKind::Assign{ .target = left, .value = self.storeExpr(ExprKind::BitNot{ .expr = right }) }); },\n            else => { return self.allocNode(); }\n        }\n    }\n\n    // prefix operators; all recurse into parseUnaryExpr so they stack\n    NodeId parseUnaryExpr()\n    {\n        if (self.current.kind == TokenKind::Not) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::Not{ .expr = expr });\n        }\n        if (self.current.kind == TokenKind::Minus) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::Neg{ .expr = expr });\n        }\n        if (self.current.kind == TokenKind::Star) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::Deref{ .expr = expr });\n        }\n        if (self.current.kind == TokenKind::Ampersand) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::AddressOf{ .expr = expr });\n        }\n        // `~` (TokenKind::Neg) is bitwise not; arithmetic negation is Minus\n        if (self.current.kind == TokenKind::Neg) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::BitNot{ .expr = expr });\n        }\n        if (self.current.kind == TokenKind::PlusPlus) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::PreInc{ .expr = expr });\n        }\n        if (self.current.kind == TokenKind::MinusMinus) {\n            self.advance();\n            NodeId expr = self.parseUnaryExpr();\n            return self.storeExpr(ExprKind::PreDec{ .expr = expr });\n        }\n        return self.parsePostfixExpr();\n    }\n\n    /* ── postfix chains ── */\n\n    /* greedy: call, `.`/`->` field, `.0` tuple index, method call, `::`\n     * path, index, postfix ++/--. call and method nodes get the receiver's\n     * loc via pointAt so a diagnostic points at `foo`, not the `)` */\n    NodeId parsePostfixExpr()\n    {\n        NodeId expr = self.parsePrimaryExpr();\n        while (true)\n        {\n            if (self.current.kind == TokenKind::LParen)\n            {\n                self.advance();\n                NodeListBuilder args;\n                self.parseCallArgs(&args);\n                u32 count = args.len;\n                NodeId* values = self.ctx->nodeListFinish(&args);\n                self.expect(TokenKind::RParen);\n                NodeId callee = expr;\n                expr = self.storeExpr(ExprKind::Call{ .callee = expr, .args = values, .argsLen = count });\n                self.pointAt(expr, callee);\n            } else if (self.current.kind == TokenKind::Dot || self.current.kind == TokenKind::Arrow) {\n                /* `.` and `->` are distinct: `.` only works on values\n                 * (methods get the implicit-pointer `self` exception in\n                 * sema), `->` dereferences first */\n                bool isArrow = self.current.kind == TokenKind::Arrow;\n                self.advance();\n                // `.0`: tuple index; a name after the dot is a field instead\n                if (self.current.kind == TokenKind::Dec) {\n                    Token index = self.advance();\n                    u32 field = (u32)index.number;\n                    NodeId tupObj = expr;\n                    if (isArrow) tupObj = self.storeExpr(ExprKind::Deref{ .expr = expr });\n                    expr = self.storeExpr(ExprKind::TupleField{ .obj = tupObj, .index = field });\n                }\n                else {\n                    Token field = self.expectName();\n                    Str fieldName = self.ctx->intern(field.data.asStr());\n                    if (self.current.kind == TokenKind::LParen) {\n                        self.advance();\n                        NodeListBuilder args;\n                        self.parseCallArgs(&args);\n                        u32 count = args.len;\n                        NodeId* values = self.ctx->nodeListFinish(&args);\n                        self.expect(TokenKind::RParen);\n                        NodeId recv = expr;\n                        NodeId callRecv = expr;\n                        if (isArrow) callRecv = self.storeExpr(ExprKind::Deref{ .expr = expr });\n                        expr = self.storeExpr(ExprKind::MethodCall{ .receiver = callRecv, .method = fieldName, .args = values, .argsLen = count });\n                        self.pointAt(expr, recv);\n                    }\n                    else if (isArrow) expr = self.storeExpr(ExprKind::DerefField{ .obj = expr, .field = fieldName });\n                    else expr = self.storeExpr(ExprKind::Field{ .obj = expr, .field = fieldName });\n                }\n            } else if (self.current.kind == TokenKind::ColonColon) {\n                self.advance();\n                Token part = self.expectName();\n                Str partName = self.ctx->intern(part.data.asStr());\n                NodeId segment = self.storeExpr(ExprKind::Ident{ .name = partName });\n                NodeListBuilder segments;\n                self.ctx->nodeListInit(&segments);\n                if (!self.ctx->nodeListAppend(&segments, expr)) self.reportAllocFailed();\n                if (!self.ctx->nodeListAppend(&segments, segment)) self.reportAllocFailed();\n                u32 count = segments.len;\n                NodeId* values = self.ctx->nodeListFinish(&segments);\n                expr = self.storeExpr(ExprKind::Path{ .segments = values, .segmentsLen = count });\n                \n                // `T::V { ... }`: variant literal, type taken from the path head\n                if (self.current.kind == TokenKind::LBrace) {\n                    Ty litTy = self.pathHeadType(expr);\n                    expr = self.parseLiteralFields(litTy, partName);\n                }\n            } else if (self.current.kind == TokenKind::LBracket) {\n                self.advance();\n                NodeId index = self.parseExpr();\n                self.expect(TokenKind::RBracket);\n                expr = self.storeExpr(ExprKind::Index{ .obj = expr, .index = index });\n            } else if (self.current.kind == TokenKind::PlusPlus) {\n                self.advance();\n                expr = self.storeExpr(ExprKind::PostInc{ .expr = expr });\n            } else if (self.current.kind == TokenKind::MinusMinus) {\n                self.advance();\n                expr = self.storeExpr(ExprKind::PostDec{ .expr = expr });\n            }\n            else { break; }\n        }\n        return expr;\n    }\n\n    /* `flag (NAME) { key => expr, ..., else => expr }`: compile-time arm\n     * selection against ctx.flags (`--flag` / manifest). every arm body is\n     * still parsed so its syntax gets checked; only the matching one comes\n     * back. no match and no else arm is an error. */\n    NodeId parseFlagExpr()\n    {\n        self.advance(); // flag\n        self.expect(TokenKind::LParen);\n        Token tknn = self.expect(TokenKind::Ident);\n        Str nameStr = self.ctx->intern(tknn.data.asStr());\n        self.expect(TokenKind::RParen);\n        self.expect(TokenKind::LBrace);\n\n        NodeId chosenNodeId = self.noneNode();\n        NodeId elseNodeId = self.noneNode();\n\n        while (!self.atEnd() && self.current.kind != TokenKind::RBrace)\n        {\n            bool isElse = false;\n            Str keyStr = 0;\n            if (self.match(TokenKind::Else)) isElse = true;\n            else\n            {\n                Token ky = self.expect(TokenKind::Ident);\n                keyStr = self.ctx->intern(ky.data.asStr());\n            }\n            self.expect(TokenKind::FatArrow);\n            NodeId bodyNodeId = self.noneNode();\n            if (self.current.kind == TokenKind::LBrace)\n            {\n                self.advance();\n                bodyNodeId = self.parseExpr();\n                self.expect(TokenKind::RBrace);\n            }\n            else\n            {\n                bodyNodeId = self.parseExpr();\n            }\n            if (isElse) elseNodeId = bodyNodeId;\n            else\n            {\n                Str flagValStr = 0;\n                u32 ii = 0;\n                while (ii < self.ctx->flagsLen)\n                {\n                    if (self.ctx->flagNames[ii] == nameStr) { flagValStr = self.ctx->flagValues[ii]; break; }\n                    ii++;\n                }\n                if (flagValStr != 0 && flagValStr == keyStr) chosenNodeId = bodyNodeId;\n            }\n            if (!self.match(TokenKind::Comma)) break;\n        }\n        self.expect(TokenKind::RBrace);\n        if (chosenNodeId.index != 0) return chosenNodeId;\n        if (elseNodeId.index != 0) return elseNodeId;\n        self.reportCurrentError(ErrorCode::ParseNoFlagArm, \"no arm of this flag expression matched; add an `else` arm\");\n        return self.noneNode();\n    }\n\n    /* the BUILTIN_* identity for an `@name` spelling — assigned once,\n     * here; every later stage switches on the tag, never on the name.\n     * unknown spellings stay BUILTIN_NONE (registered later when the\n     * error.crl series gets its lowering). */\n    u32 builtinIdOf(Str name)\n    {\n        if (self.ctx->internEqHashLen(name, 0xA5655C7B, 6)) return BUILTIN_ASSERT;          /* FNV(\"assert\") */\n        if (self.ctx->internEqHashLen(name, 0xA464B2ED, 9)) return BUILTIN_ASSERTOUT;       /* FNV(\"assertOut\") */\n        if (self.ctx->internEqHashLen(name, 0x23535EE8, 12)) return BUILTIN_COMPILEERROR;   /* FNV(\"compileError\") */\n        if (self.ctx->internEqHashLen(name, 0x0A5430A1, 15)) return BUILTIN_ISFORMATLITERAL;/* FNV(\"isFormatLiteral\") */\n        if (self.ctx->internEqHashLen(name, 0x9A90A8A0, 6)) return BUILTIN_TYPEOF;          /* FNV(\"typeof\") */\n        if (self.ctx->internEqHashLen(name, 0xF5F3FF74, 5)) return BUILTIN_PANIC;           /* FNV(\"panic\") */\n        if (self.ctx->internEqHashLen(name, 0xD89E21F1, 11)) return BUILTIN_UNREACHABLE;    /* FNV(\"unreachable\") */\n        if (self.ctx->internEqHashLen(name, 0x19BB34EB, 6)) return BUILTIN_REPORT;          /* FNV(\"report\") */\n        if (self.ctx->internEqHashLen(name, 0xFF0DE124, 9)) return BUILTIN_REPORTHEX;       /* FNV(\"reportHex\") */\n        if (self.ctx->internEqHashLen(name, 0xDEF74C7B, 8)) return BUILTIN_ABORTNOW;        /* FNV(\"abortNow\") */\n        if (self.ctx->internEqHashLen(name, 0x6204E0F1, 8)) return BUILTIN_ASSERTEQ;        /* FNV(\"assertEq\") */\n        if (self.ctx->internEqHashLen(name, 0x55ED74BE, 8)) return BUILTIN_ASSERTNE;        /* FNV(\"assertNe\") */\n        if (self.ctx->internEqHashLen(name, 0x52F38033, 8)) return BUILTIN_ASSERTLT;        /* FNV(\"assertLt\") */\n        if (self.ctx->internEqHashLen(name, 0x61F397D0, 8)) return BUILTIN_ASSERTLE;        /* FNV(\"assertLe\") */\n        if (self.ctx->internEqHashLen(name, 0x50FEB600, 8)) return BUILTIN_ASSERTGT;        /* FNV(\"assertGt\") */\n        if (self.ctx->internEqHashLen(name, 0x61FED0C3, 8)) return BUILTIN_ASSERTGE;        /* FNV(\"assertGe\") */\n        if (self.ctx->internEqHashLen(name, 0x0679C810, 11)) return BUILTIN_ASSERTRANGE;    /* FNV(\"assertRange\") */\n        if (self.ctx->internEqHashLen(name, 0xBC9953FB, 13)) return BUILTIN_ASSERTNONNULL;  /* FNV(\"assertNonNull\") */\n        if (self.ctx->internEqHashLen(name, 0x35971841, 13)) return BUILTIN_ASSERTALIGNED;  /* FNV(\"assertAligned\") */\n        if (self.ctx->internEqHashLen(name, 0xCEB36FDA, 11)) return BUILTIN_BACKTRACETO;    /* FNV(\"backtraceTo\") */\n        return BUILTIN_NONE;\n    }\n\n    /* ── primaries: literals, names, parens, blocks, builtins ── */\n\n    NodeId parsePrimaryExpr()\n    {\n        TokenKind k = self.current.kind;\n        switch (k)\n        {\n            TokenKind::Dec => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::IntLit{ .value = tok.number, .flags = tok.numFlags });\n            },\n\n            TokenKind::Hex => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::IntLit{ .value = tok.number, .flags = tok.numFlags });\n            },\n\n            TokenKind::Bin => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::IntLit{ .value = tok.number, .flags = tok.numFlags });\n            },\n\n            TokenKind::Oct => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::IntLit{ .value = tok.number, .flags = tok.numFlags });\n            },\n\n            TokenKind::Float => {\n                Token tok = self.advance();\n                // raw text, interned; the lexer does not parse floats\n                return self.storeExpr(ExprKind::FloatLit{ .value = self.ctx->intern(tok.data.asStr()), .flags = tok.numFlags });\n            },\n\n            TokenKind::String => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::StringLit{ .value = self.ctx->intern(tok.data.asStr()), .flags = 0 });\n            },\n\n            TokenKind::CString => {\n                Token tok = self.advance();\n                // flags 1 = c-string: codegen appends the trailing NUL\n                return self.storeExpr(ExprKind::StringLit{ .value = self.ctx->intern(tok.data.asStr()), .flags = 1 });\n            },\n\n            TokenKind::RawString => {\n                Token tok = self.advance();\n                return self.storeExpr(ExprKind::StringLit{ .value = self.ctx->intern(tok.data.asStr()), .flags = 0 });\n            },\n\n            TokenKind::CharLit => {\n                Token tok = self.advance();\n                u32 value = 0;\n                /* the token span includes both quotes; decode the content\n                 * (`'a'` → 97, `'\\n'` → 10; a bare `ptr[0]` would read the\n                 * opening quote and make every literal 39) */\n                if (tok.data.len >= 3)\n                {\n                    u8* p = tok.data.ptr + 1;\n                    u8* end = tok.data.ptr + tok.data.len - 1;\n                    if (p[0] == 92 && end - p >= 2)\n                    {\n                        EscapeResult esc = EscapeResult::decodeEscapeSequence(p, end);\n                        if (esc.isValid && esc.bytesConsumed > 0) value = esc.codepoint;\n                        else value = (u32)p[(u32)1];\n                    }\n                    else\n                    {\n                        usize len = 0;\n                        u32 cp = decodeUtf8(p, end, &len);\n                        if (len > 0) value = cp;\n                        else value = (u32)p[0];\n                    }\n                }\n                return self.storeExpr(ExprKind::CharLit{ .value = value });\n            },\n            \n            TokenKind::True => {\n                self.advance();\n                return self.storeExpr(ExprKind::BoolLit{ .flags = 1 });\n            },\n            \n            TokenKind::False => {\n                self.advance();\n                return self.storeExpr(ExprKind::BoolLit{ .flags = 0 });\n            },\n            \n            TokenKind::Null => {\n                self.advance();\n                return self.storeExpr(ExprKind::NullLit);\n            },\n            \n            TokenKind::Ident => {\n                Token nameTok = self.advance();\n                Str name = self.ctx->intern(nameTok.data.asStr());\n                // `T<A, B>` type ref or a plain name; a following `{` makes\n                // it a struct literal instead\n                Ty* genericArgs = null;\n                u32 genericArgsLen = 0;\n                bool hasGenericArgs = self.parseGenericArguments((rawptr*)&genericArgs, &genericArgsLen);\n                Ty namedType = self.makeNamedArgs(name, genericArgs, genericArgsLen);\n                if (self.current.kind == TokenKind::LBrace)\n                {\n                     return self.parseLiteralFields(namedType, 0);\n                }\n                if (hasGenericArgs)\n                    return self.storeExpr(ExprKind::TypeRef{ .name = name, .typeNode = namedType });\n                return self.storeExpr(ExprKind::Ident{ .name = name });\n            },\n\n            TokenKind::Str => {\n                Token nameTok = self.advance();\n                Str name = self.ctx->intern(nameTok.data.asStr());\n                if (self.current.kind == TokenKind::LBrace)\n                {\n                    // a pure Str tuple value: `str { .ptr = p, .len = n }`\n                    TypeKind k;\n                    k.tag = TypeKind::Str;\n                    Ty ty = self.allocTypeKind(k);\n                    return self.parseLiteralFields(ty, 0);\n                }\n                /* `str::foo(...)`: allow `str` as an identifier in a\n                 * path position (e.g. calls like str::fromParts); the\n                 * postfix loop handles the rest. */\n                if (self.current.kind == TokenKind::ColonColon)\n                {\n                    return self.storeExpr(ExprKind::Ident{ .name = name });\n                }\n                self.reportCurrentError(ErrorCode::ParseExpectedStrExpr, \"expected a path, call or struct literal after `str`\");\n                return self.noneNode();\n            },\n\n            TokenKind::Self => {\n                self.advance();\n                return self.storeExpr(ExprKind::Ident{ .name = self.ctx->intern(\"self\") });\n            },\n            \n            TokenKind::LParen => {\n                self.advance();\n                /* cast: (type)operand, keyword types, or Named* pointer\n                 * types (bootstrap parity: an Ident is only a cast type\n                 * when followed by `*`, so `(x)` stays a paren expr) */\n                bool castable = false;\n                if (self.isTypeStart() &&\n                    self.current.kind != TokenKind::Ident &&\n                    self.current.kind != TokenKind::LParen)\n                {\n                    castable = true;\n                }\n                else if (self.current.kind == TokenKind::Ident)\n                {\n                    ParserMark mk0 = self.save();\n                    self.advance();\n                    if (self.current.kind == TokenKind::Star ||\n                        self.current.kind == TokenKind::RParen ||\n                        self.current.kind == TokenKind::Less ||\n                        self.current.kind == TokenKind::ColonColon)\n                    {\n                        castable = true;\n                    }\n                    self.restore(mk0);\n                }\n                if (castable)\n                {\n                    ParserMark cm = self.save();\n                    Ty ctype = self.parseType();\n                    // parseType closed on `)`; this really is a cast. the\n                    // save() above bumped specDepth; close it out here since\n                    // the speculative branch won\n                    if (self.current.kind == TokenKind::RParen)\n                    {\n                        self.advance();\n                        self.endSpeculation();\n                        NodeId cinner = self.parseUnaryExpr();\n                        return self.storeExpr(ExprKind::Cast{ .expr = cinner, .targetType = ctype });\n                    }\n                    // not a cast after all (plain `(expr)`): rewind everything\n                    self.restore(cm);\n                }\n                if (self.current.kind == TokenKind::RParen) {\n                    self.advance();\n                    return self.storeExpr(ExprKind::TupleExpr{ .elems = null, .elemsLen = 0 });\n                }\n                NodeListBuilder elems;\n                self.ctx->nodeListInit(&elems);\n                NodeId elem = self.parseExpr();\n                if (!self.ctx->nodeListAppend(&elems, elem)) self.reportAllocFailed();\n                while (self.match(TokenKind::Comma))\n                {\n                    if (self.current.kind == TokenKind::RParen) break;\n                    elem = self.parseExpr();\n                    if (!self.ctx->nodeListAppend(&elems, elem)) self.reportAllocFailed();\n                }\n                self.expect(TokenKind::RParen);\n                u32 count = elems.len;\n                NodeId* values = self.ctx->nodeListFinish(&elems);\n                // `(x)` is a parenthesized expr, not a one-tuple\n                if (count == 1) return values[0];\n                return self.storeExpr(ExprKind::TupleExpr{ .elems = values, .elemsLen = count });\n            },\n            \n            TokenKind::LBrace => {\n                /* a block in expression position. per item: statement\n                 * keywords go to parseStmt, everything else is an expr, and\n                 * the last item parsed becomes the block's value. bail on\n                 * the first new error so recovery doesn't cascade */\n                self.advance();\n                NodeListBuilder stmts;\n                self.ctx->nodeListInit(&stmts);\n                NodeId result = self.noneNode();\n                while (self.current.kind != TokenKind::RBrace && !self.atEnd())\n                {\n                    u32 errorsBefore = self.errorCount();\n                    bool isStatement = false;\n                    switch (self.current.kind)\n                    {\n                        TokenKind::Return |  TokenKind::If | TokenKind::While | \n                        TokenKind::For |  TokenKind::Loop | TokenKind::Switch | \n                        TokenKind::Defer |  TokenKind::Break |  TokenKind::Continue | \n                        TokenKind::LBrace |  TokenKind::Comptime |  TokenKind::Var | \n                        TokenKind::Const => { isStatement = true; },\n                        else => {}\n                    }\n                    if (isStatement)\n                    {\n                        result = self.parseStmt();\n                        if (!self.ctx->nodeListAppend(&stmts, result)) self.reportAllocFailed();\n                    }\n                    else {\n                        result = self.parseExpr();\n                        if (!self.ctx->nodeListAppend(&stmts, result)) self.reportAllocFailed();\n                        self.match(TokenKind::Semicolon);\n                    }\n                         if (self.errorCount() > errorsBefore) break;\n                }\n                self.expect(TokenKind::RBrace);\n                u32 count = stmts.len;\n                NodeId* values = self.ctx->nodeListFinish(&stmts);\n                return self.storeExpr(ExprKind::BlockExpr{ .stmts = values, .stmtsLen = count, .result = result });\n            },\n            \n            TokenKind::If => {\n                self.advance();\n                self.expect(TokenKind::LParen);\n                NodeId cond = self.parseExpr();\n                self.expect(TokenKind::RParen);\n                NodeId thenB = self.parseExpr();\n                NodeId elseB = self.noneNode();\n                if (self.match(TokenKind::Else))