   {\n        CrlbNode* bn = null;\n        usize bni = 0;\n        while (bni < root->children.len)\n        {\n            if (root->children.data[bni].kind == CrlbNodeKind::Build) { bn = root->children.data + bni; break; }\n            bni++;\n        }\n        if (bn != null)\n        {\n            CrlbField* ff = null;\n            usize fxi = 0;\n            while (fxi < bn->fields.len)\n            {\n                if (bn->fields.data[fxi].name.eq(Slice::fromStr(\"flags\"))) { ff = bn->fields.data + fxi; break; }\n                fxi++;\n            }\n            if (ff != null && ff->value.tag == Value::List && ff->value.payload.List.value != null)\n            {\n                ValueArray* arr = ff->value.payload.List.value;\n                if (opts.strict)\n                {\n                    Value sv = Value::String { .value = Slice::fromStr(\"--strict\") };\n                    valueArrayPush(arr, sv);\n                }\n                if (opts.profileSet)\n                {\n                    usize plen = 8 + opts.profile.len;\n                    u8* pbuf = alloc<u8>(plen);\n                    if (pbuf != null)\n                    {\n                        Slice tag = Slice::fromStr(\"profile=\");\n                        usize pi = 0;\n                        while (pi < 8) { pbuf[pi] = tag.ptr[pi]; pi++; }\n                        pi = 0;\n                        while (pi < opts.profile.len) { pbuf[8 + pi] = opts.profile.ptr[pi]; pi++; }\n                        Value pv = Value::String { .value = Slice { pbuf, plen } };\n                        valueArrayPush(arr, pv);\n                    }\n                }\n            }\n        }\n    }\n\n    Builder b;\n    b.compilePhaseReached = false;\n    Timespec buildStart = nowMonotonic();\n    i32 errs = builderRunEx(root, &a, opts.force, opts.mapOnly, opts.dryRun, false, &b);\n    if (errs != 0) return 3;\n    if (opts.mapOnly) return 0;\n\n    /* env = { NAME = \"value\"; } in the