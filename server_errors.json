ool isXidContinue(u32 cp)\n{\n    if (isXidStart(cp)) return true;\n    if (cp < 128) return cp >= '0' && cp <= '9';\n    if (cp >= 0x0300 && cp <= 0x036F) return true;\n    if (cp >= 0x1AB0 && cp <= 0x1AFF) return true;\n    if (cp >= 0x1DC0 && cp <= 0x1DFF) return true;\n    if (cp >= 0xFE20 && cp <= 0xFE2F) return true;\n    if (cp >= 0xFE00 && cp <= 0xFE0F) return true;\n    if (cp >= 0xFE10 && cp <= 0xFE1F) return true;\n    if (cp >= 0x20DD && cp <= 0x20E0) return true;\n    return false;\n}\n\n/* ASCII byte a non-ASCII codepoint is visually confusable with, 0 when\n * it isn't one. Cyrillic/Greek/fullwidth lookalikes of the Latin letters\n * that dominate identifiers (L0009) */\nu32 homoglyphAscii(u32 cp)\n{\n    /* Cyrillic */\n    if (cp == 0x0430 || cp == 0x03B1 || cp == 0xFF41) return 97;  // а α ａ -> a\n    if (cp == 0x0410 || cp == 0x0391 || cp == 0xFF21) return 65;  // А Α Ａ -> A\n    if (cp == 0x0435 || cp == 0x03B5 || cp == 0xFF45) return 101; // е ε ｅ -> e\n    if (cp == 0x0415 || cp == 0x0395 || cp == 0xFF25) return 69;  // Е Ε Ｅ -> E\n    if (cp == 0x043E || cp == 0x03BF || cp == 0xFF4F) return 111; // о ο ｏ -> o\n    if (cp == 0x041E || cp == 0x039F || cp == 0xFF2F) return 79;  // О Ο Ｏ -> O\n    if (cp == 0x0440 || cp == 0x03C1 || cp == 0xFF50) return 112; // р ρ ｐ -> p\n    if (cp == 0x0420 || cp == 0x03A1 || cp == 0xFF30) return 80;  // Р Ρ Ｐ -> P\n    if (cp == 0x0441 || cp == 0xFF43) return 99;                  // с ｃ -> c\n    if (cp == 0x0421 || cp == 0xFF23) return 67;                  // С Ｃ -> C\n    if (cp == 0x0445 || cp == 0x03C7 || cp == 0xFF58) return 120; // х χ ｘ -> x\n    if (cp == 0x0425 || cp == 0x03A7 || cp == 0xFF38) return 88;  // Х Χ Ｘ -> X\n    if (cp == 0x0443 || cp == 0x03B3 || cp == 0xFF59) return 121; // у γ ｙ -> y\n    if (cp == 0x03A5 || cp == 0xFF39) return 89;                  // Υ Ｙ -> Y\n    if (cp == 0x0456 || cp == 0x03B9 || cp == 0xFF49) return 105; // і ι ｉ -> i\n    if (cp == 0x0406 || cp == 0x0399 || cp ==