nd::Ident) && self.curIsWord(\"extends\"))\n        {\n            self.advance();\n            if (self.check(CrlbTokenKind::String))\n            {\n                n->extendsTarget = self.cur.text;\n                n->hasExtends = true;\n                self.advance();\n            }\n        }\n        self.parseBlockInto(n);\n        return n;\n    }\n\n    CrlbNode* parseFile()\n    {\n        CrlbNode* root = (CrlbNode*)self.arena->alloc(@sizeof(CrlbNode), 8);\n        if (root == null) return null;\n        root->init(CrlbNodeKind::Root, self.arena);\n        while (!self.check(CrlbTokenKind::Eof))\n        {\n            CrlbNode* decl = self.parseTopDecl();\n            if (decl != null) root->addChild(decl);\n            if (self.errors > 64) break;\n        }\n        if (self.lx->hadError) self.errors++;\n        return root;\n    }\n}\n"}}}
