.input.ptr);\n            return 2;\n        }\n        haveTask = true;\n    }\n    else if (opts.cmd == Command::Run)\n    {\n        haveTask = bTaskIndex(&b, \"run\") >= 0;\n    }\n\n    // up to date: nothing stale, the output binary exists, no --force\n    u8* outZ = sliceCStr(b.output);\n    if (outZ == null || b.output.len == 0)\n    {\n        printf(C\"coralc: build block needs output = \\\"path\\\" (the linked binary)\\n\");\n        return 3;\n    }\n    if (!opts.force && !b.anyStale && !opts.dryRun && bFileExists(b.output.asStr()))\n    {\n        printf(C\"coralc: up to date (%s)\\n\", outZ);\n        b.compilePhaseReached = true;\n        if (wantTask)\n        {\n            if (haveTask)\n            {\n                i32 st = runTask(&b, taskName, 0);\n                if (st != 0) return st;\n            }\n            else\n            {\n                i32 st = system((const cchar*)outZ);\n                if (st != 0) return 3;\n            }\n        }\n        return 0;\n    }\n\n    /* compile phase: one unit (the entry module's closure) → one binary.\n     * the loader resolves imports through the builder's in-memory module\n     * table first, then falls back to lib-root probing. */\n    if (!bMkdirParent(b.output.asStr()))\n    {\n        printf(C\"coralc: cannot create output directory for %s\\n\", outZ);\n        return 3;\n    }\n    if (b.entryPath.ptr == null)\n    {\n        printf(C\"coralc: entry module not resolved\\n\");\n        return 3;\n    }\n    i32 rc = compileUnitTo(b.entryPath.asStr(), b.output.asStr(), &opts, b.modKeys, b.modVals, b.modLen);\n    if (rc == 0)\n    {\n        b.compilePhaseReached = true;\n        if (!opts.dryRun) bWriteAllFps(&b);\n        if (!opts.quiet && !opts.dryRun)\n        {\n            Timespec buildEnd = subTimespec(nowMonotonic(), buildStart);\n            printf(C\"    Finished %s in %d.%02ds\\n\", outZ, (i32)buildEnd.sec, (i32)(buildEnd.nsec / 10000000));\n        }\n        if (wantTask)\n        {\n            if (haveTask)\n            {\n                i32 st = runTask(&b, taskName, 0);\n                if (st != 0) return st;\n            }\n            else\n            {\n                i32 st = system((const cchar*)outZ);\n                if (st != 0) return 3;\n            }\n        }\n        return 0;\n    }\n    return 3;\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-parser/recovery.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n\n/* parser/recovery.crl: panic-mode error reporting and resynchronisation\n *\n * panicMode packs two things into one word (see base.crl): the low 30\n * bits are the error count, 0x40000000 says \"recovery is in progress\".\n * counting lives here, the skip-to-safety loops live below. nothing\n * reads the in-progress bit today; only begin/endRecovery touch it. */\n\nimport std::string { String };\nuse common::token { Token, TokenKind };\nuse diag::code { ErrorCode };\nuse diag::engine { DiagnosticEngine };\nuse base { Parser };\n\npub extend Parser\n{\n    /* ── counters and flags ── */\n\n    u32 errorCount() { return self.panicMode & 0x3fffffff; }\n    bool hasParseErrors() { return self.errorCount() != 0; }\n    bool isRecovering() { return (self.panicMode & 0x40000000) != 0; }\n    bool isSpeculating() { return self.specDepth != 0; }\n    void beginSpeculation() { self.specDepth++; }\n    void endSpeculation() { if (self.specDepth != 0) self.specDepth--; }\n    void beginRecovery() { self.panicMode |= 0x40000000; }\n    void endRecovery() { self.panicMode &= 0xbfffffff; }\n    void reportCurrentError(ErrorCode code, str msg) { self.reportError(code, self.current, msg); }\n    void reportAllocFailed() { self.reportError(ErrorCode::DriverOutOfMemory, self.current, \"out of memory while parsing\"); }\n\n    // saturating; the count shares its word with the recovery flag\n    void addError()\n    {\n        u32 count = self.errorCount();\n        if (count < 0x3fffffff)\n            self.panicMode = (self.panicMode & 0xc0000000) | (count + 1);\n    }\n\n    /* diagnostics from speculative passes (cast/decl/type lookaheads) are\n     * dropped on the floor; if the guess is wrong, its errors are noise.\n     * also tolerates a parser with no lexer/diag wired up (tests) */\n    void reportError(ErrorCode code, Token token, str msg)\n    {\n        if (self.isSpeculating()) return;\n        self.attrNameError = false;\n        self.addError();\n        if (self.lexer == null) return;\n        DiagnosticEngine* diag = self.lexer->diag;\n        if (diag == null) return;\n        diag->emitError(code, self.tokenLoc(token), msg, null);\n    }\n\n    /* like reportError but doesn't count against the error budget */\n    void reportWarning(ErrorCode code, Token token, str msg)\n    {\n        if (self.isSpeculating()) return;\n        if (self.lexer == null) return;\n        DiagnosticEngine* diag = self.lexer->diag;\n        if (diag == null) return;\n        diag->emitWarning(code, self.tokenLoc(token), msg, null);\n    }\n\n    /* error at an already-recorded location (an attribute's own loc is\n     * captured before its args are skipped, so it is not self.current) */\n    void reportErrorAtHelp(ErrorCode code, SourceLoc loc, str msg, str help)\n    {\n        if (self.isSpeculating()) return;\n        if (code == ErrorCode::ParseUnknownAttr) self.attrNameError = true;\n        self.addError();\n        if (self.lexer == null) return;\n        DiagnosticEngine* diag = self.lexer->diag;\n        if (diag == null) return;\n        diag->emitError(code, loc, msg, help);\n    }\n\n    /* warning at an already-recorded location (e.g. an attribute parsed\n     * into the attribute list, far from self.current) */\n    void reportWarningAt(ErrorCode code, SourceLoc loc, str msg)\n    {\n        if (self.isSpeculating()) return;\n        if (self.lexer == null) return;\n        DiagnosticEngine* diag = self.lexer->diag;\n        if (diag == null) return;\n        diag->emitWarning(code, loc, msg, null);\n    }\n\n    str expectedTokenText(TokenKind kind)\n    {\n        switch (kind)\n        {\n            TokenKind::LParen => { return \"expected '('\"; },\n            TokenKind::RParen => { return \"expected ')'\"; },\n            TokenKind::LBrace => { return \"expected '{'\"; },\n            TokenKind::RBrace => { return \"expected '}'\"; },\n            TokenKind::LBracket => { return \"expected '['\"; },\n            TokenKind::RBracket => { return \"expected ']'\"; },\n            TokenKind::Ident => { return \"expected identifier\"; },\n            TokenKind::Equal => { return \"expected '='\"; },\n            TokenKind::Semicolon => { return \"expected ';'\"; },\n            TokenKind::Comma => { return \"expected ','\"; },\n            TokenKind::Colon => { return \"expected ':'\"; },\n            TokenKind::FatArrow => { return \"expected '=>'\"; },\n            TokenKind::Less => { return \"expected '<'\"; },\n            TokenKind::Greater => { return \"expected '>'\"; },\n            else => { return \"expected token\"; },\n        }\n    }\n\n    void reportExpected(TokenKind kind)\n    {\n        if (self.current.kind == TokenKind::Eof)\n        {\n            self.reportError(ErrorCode::ParseUnexpectedEof, self.current, \"unexpected end of file\");\n            return;\n        }\n        /* \"expected ';', found 'x'\", built with String; reportError renders\n         * the view synchronously, the buffer dies with the scope */\n        str base = self.expectedTokenText(kind);\n        Token t = self.current;\n        // cap the echoed token at 64 bytes; a huge string literal token\n        // otherwise dumps into the diagnostic\n        usize tl = t.data.len;\n        if (tl > 64) tl = 64;\n        String sb = String::from(base);\n        if (sb.ptr == null)\n        {\n            self.reportError(ErrorCode::ParseExpectedToken, t, base);\n            return;\n        }\n        // a keyword found-token reads \"found keyword 'any'\" so the\n        // reserved word is not mistaken for a plain identifier\n        if (t.info != null && t.info->isKeyword) sb.pushView(\", found keyword '\");\n        else sb.pushView(\", found '\");\n        sb.pushView(str { .ptr = t.data.ptr, .len = tl });\n        sb.pushByte(39);                     // \\'\n        self.reportError(ErrorCode::ParseExpectedToken, t, sb.asView());\n    }\n\n    /* same \", found '⟨tok⟩'\" shape as reportExpected, for sites that keep\n     * their own code (P0002/P0003/P0004/P0016 and the const-name site)\n     * instead of the P0001 funnel; <eof> renders by name since its token\n     * has no bytes */\n    void reportExpectedWith(ErrorCode code, str base)\n    {\n        Token t = self.current;\n        String sb = String::from(base);\n        if (sb.ptr != null)\n        {\n            if (t.info != null && t.info->isKeyword) sb.pushView(\", found keyword '\");\n            else sb.pushView(\", found '\");\n            if (t.kind == TokenKind::Eof) sb.pushView(\"<eof>\");\n            else\n            {\n                usize tl = t.data.len;\n                if (tl > 64) tl = 64;\n                sb.pushView(str { .ptr = t.data.ptr, .len = tl });\n            }\n            sb.pushByte(39);\n            self.reportError(code, t, sb.asView());\n            return;\n        }\n        self.reportError(code, t, base);\n    }\n\n    /* a reserved keyword sitting where an identifier was wanted. fields,\n     * methods, parameters and use symbols may still collide with\n     * keywords — those go through expectName untouched; this is the\n     * rejection for local/global names, expression position and the\n     * declaration-start fallback. `any` gets its trait-type hint since\n     * it is the one keyword users hit as a would-be type/name */\n    void reportKeywordAsIdent(Token nameTok)\n    {\n        if (nameTok.info == null || !nameTok.info->isKeyword) return;\n        String sb = String::from(\"`\");\n        if (sb.ptr == null)\n        {\n            self.reportError(ErrorCode::ParseKeywordAsIdent, nameTok, \"keyword used as an identifier\");\n            return;\n        }\n        usize tl = nameTok.data.len;\n        if (tl > 64) tl = 64;\n        sb.pushView(str { .ptr = nameTok.data.ptr, .len = tl });\n        sb.pushView(\"` is a keyword; it cannot be used as an identifier\");\n        if (nameTok.kind == TokenKind::Any)\n            self.reportErrorAtHelp(ErrorCode::ParseKeywordAsIdent, self.tokenLoc(nameTok), sb.asView(),\n                \"`any` introduces a trait type: write `any Trait` (like Rust's `dyn Trait`)\");\n        else\n            self.reportError(ErrorCode::ParseKeywordAsIdent, nameTok, sb.asView());\n    }\n\n    // tokens that end a construct on their own and must not be skipped:\n    // swallowing a closer desyncs every enclosing level\n    bool isRecoveryBoundary(TokenKind kind)\n    {\n        return kind == TokenKind::Eof || kind == TokenKind::Semicolon ||\n               kind == TokenKind::RBrace || kind == TokenKind::RParen ||\n               kind == TokenKind::RBracket || kind == TokenKind::LBrace;\n    }\n\n    /* ── resynchronisation ── */\n\n    /* skip to the end of the current declaration. depth counters keep a\n     * `;` inside parens/brackets/braces from ending recovery early; a\n     * closer stops the skip (leave it for the construct that owns it);\n     * a fresh line starting a decl keyword stops it too */\n    void synchronize()\n    {\n        self.beginRecovery();\n        u32 braceDepth = 0;\n        u32 parenDepth = 0;\n        u32 bracketDepth = 0;\n        usize startLine = self.current.line;\n        while (!self.atEnd())\n        {\n            TokenKind kind = self.current.kind;\n            if (braceDepth == 0 && parenDepth == 0 && bracketDepth == 0)\n            {\n                if (kind == TokenKind::Semicolon)\n                {\n                    self.advance();\n                    break;\n                }\n                if (kind == TokenKind::RBrace || kind == TokenKind::RParen ||\n                    kind == TokenKind::RBracket)\n                    break;\n                if (self.current.line > startLine && self.isDeclarationStart()) break;\n            }\n            if (kind == TokenKind::LBrace) braceDepth++;\n            else if (kind == TokenKind::RBrace)\n            {\n                if (braceDepth > 0) braceDepth--;\n            }\n            else if (kind == TokenKind::LParen) parenDepth++;\n            else if (kind == TokenKind::RParen)\n            {\n                if (parenDepth > 0) parenDepth--;\n            }\n            else if (kind == TokenKind::LBracket) bracketDepth++;\n            else if (kind == TokenKind::RBracket)\n            {\n                if (bracketDepth > 0) bracketDepth--;\n            }\n            self.advance();\n        }\n        self.endRecovery();\n    }\n\n    // same idea, statement granularity: consume through the next `;`, or\n    // stop at a closer. no depth tracking; a `;` in a for-header would\n    // end the skip early, which costs one extra diagnostic at worst\n    void synchronizeStatement()\n    {\n        self.beginRecovery();\n        while (!self.atEnd())\n        {\n            TokenKind kind = self.current.kind;\n            if (kind == TokenKind::RBrace || kind == TokenKind::RParen ||\n                kind == TokenKind::RBracket)\n                break;\n            if (kind == TokenKind::Semicolon)\n            {\n                self.advance();\n                break;\n            }\n            self.advance();\n        }\n        self.endRecovery();\n    }\n\n    // stop at anything that can follow an expression; consume nothing\n    void synchronizeExpression()\n    {\n        self.beginRecovery();\n        while (!self.atEnd())\n        {\n            TokenKind kind = self.current.kind;\n            if (kind == TokenKind::Comma || kind == TokenKind::Semicolon ||\n                kind == TokenKind::RParen || kind == TokenKind::RBrace ||\n                kind == TokenKind::RBracket)\n                break;\n            self.advance();\n        }\n        self.endRecovery();\n    }\n\n    // case granularity: `,` / `=>` / `}` all start the next arm\n    void synchronizeCase()\n    {\n        self.beginRecovery();\n        while (!self.atEnd())\n        {\n            TokenKind kind = self.current.kind;\n            if (kind == TokenKind::Comma || kind == TokenKind::FatArrow ||\n                kind == TokenKind::RBrace)\n                break;\n            self.advance();\n        }\n        self.endRecovery();\n    }\n}\n"}}}
{"jsonrpc":"2.0","method":"textDocument/didOpen","params":{"textDocument":{"uri":"file:///home/cerie/Documents/coral/compiler/coral-mono/collect.crl","languageId":"coral","version":0,"text":"#[[no_drop_all]]\n/* mono/collect.crl: the collect pass: walks the analyzed AST and\n * enqueues every generic instantiation it can name (type refs, calls),\n * with bindings and comptime-visible call values attached. instantiate\n * drains the queue later; this file emits nothing. Assumes sema has\n * already resolved every expr's type. */\n\nuse ast::id { Str, NodeId };\nuse ast::types { Ty, TypeEntry, TypeKind };\nuse ast::node { Node, NodeKind };\nuse ast::decl { File, Decl, DeclKind, Param, GenericParam };\nuse ast::expr { Expr, ExprKind };\nuse ast::stmt { Stmt, StmtKind, SwitchCase };\nuse mono { MonoContext, MonoDeclKind, MonoWorkItem };\nuse sem::sema { Sema };\nuse sem::scope { Symbol, ScopeStack };\nuse context::context { AstContext, InternEntry };\n\nimport std::mman { alloc, dealloc, zero };\nimport platform::libc { printf };\n\npub extend MonoContext\n{\n    /* decl lookup for mono's purposes: this file's decls first, then\n     * sema's merged scope. NodeId 0 means nothing found. */\n    NodeId findDeclaration(Str name)\n    {\n        if (self.file != null)\n        {\n            u32 i = 0;\n            while (i < self.file->declsLen)\n            {\n                if (self.declarationName(self.file->decls[i]) == name) return self.file->decls[i];\n                i++;\n            }\n        }\n        /* fallback: sema's merged scope; types like core's `cchar` may be\n         * visible to sema without being merged into this unit's file */\n        if (self.sema != null)\n        {\n            ScopeStack* scopes = self.sema->scopes;\n            if (scopes != null)\n            {\n                Symbol* sym = scopes->lookup(name);\n                if (sym != null && sym->declaration.index != 0) return sym->declaration;\n            }\n        }\n        NodeId none;\n        none.index = 0;\n        return none;\n    }\n\n    /* explicit generic args on a named type: prefer the decl whose generic\n     * arity matches (libc's extern realloc vs mman's realloc<T>) */\n    NodeId findGenericDeclaration(Str name, u32 want)\n    {\n        if (self.file != null)\n        {\n            u32 i = 0;\n            while (i < self.file->declsLen)\n            {\n                if (self.declarationName(self.file->decls[i]) == name &&\n                    self.genericCount(self.file->decls[i]) == want)\n                    return self.file->decls[i];\n                i++;\n            }\n        }\n        if (self.sema != null)\n        {\n            ScopeStack* scopes = self.sema->scopes;\n            if (scopes != null)\n            {\n                Symbol** cands = alloc<Symbol*>(16);\n                if (cands != null)\n                {\n                    u32 n = scopes->lookupAll(name, cands, 16);\n                    u32 m = 0;\n                    while (m < n)\n                    {\n                        if (cands[m]->declaration.index != 0 &&\n                            self.genericCount(cands[m]->declaration) == want)\n                        {\n                            NodeId found = cands[m]->declaration;\n                            dealloc<Symbol*>(cands);\n                            return found;\n                        }\n                        m++;\n                    }\n                    dealloc<Symbol*>(cands);\n                }\n            }\n        }\n        NodeId none;\n        none.index = 0;\n        return none;\n    }\n\n    /* true when a type can name a concrete instance: recursion is the\n     * point: `Vec<T>` is not concrete until every arg bottoms out in a\n     * declared type. Unresolvable names count as non-concrete. */\n    bool isConcreteType(Ty typeNode)\n    {\n        if (typeNode == 0) return false;\n        TypeEntry* entry = self.typeEntryAt(typeNode);\n        if (entry == null) return false;\n        if (entry->kind.tag == TypeKind::TypeParam) return false;\n        /* builtin scalar/string types are always concrete; they have no\n         * file declaration for findDeclaration to resolve */\n        if (entry->kind.tag == TypeKind::Str || entry->kind.tag == TypeKind::Char ||\n            entry->kind.tag == TypeKind::Bool || entry->kind.tag == TypeKind::Void ||\n            entry->kind.tag == TypeKind::U8 || entry->kind.tag == TypeKind::U16 ||\n            entry->kind.tag == TypeKind::U32 || entry->kind.tag == TypeKind::U64 ||\n            entry->kind.tag == TypeKind::U128 || entry->kind.tag == TypeKind::I8 ||\n            entry->kind.tag == TypeKind::I16 || entry->kind.tag == TypeKind::I32 ||\n            entry->kind.tag == TypeKind::I64 || entry->kind.tag == TypeKind::I128 ||\n            entry->kind.tag == TypeKind::F32 || entry->kind.tag == TypeKind::F64 ||\n            entry->kind.tag == TypeKind::Usize || entry->kind.tag == TypeKind::Isize ||\n            entry->kind.tag == TypeKind::Rawptr)\n            return true;\n        /* wrappers are concrete only when what they wrap is: `V*`,\n         * `Vec<V>*` etc. must not name an instance while V is still a\n         * type param (the enclosing body re-collects with activeSubs\n         * once the concrete argument is known) */\n        if (entry->kind.tag == TypeKind::Pointer)\n            return self.isConcreteType(entry->kind.payload.Pointer.base);\n        if (entry->kind.tag == TypeKind::Slice)\n            return self.isConcreteType(entry->kind.payload.Slice.base);\n        if (entry->kind.tag == TypeKind::Array)\n            return self.isConcreteType(entry->kind.payload.Array.base);\n        if (entry->kind.tag == TypeKind::Const)\n            return self.isConcreteType(entry->kind.payload.Const.base);\n        if (entry->kind.tag == TypeKind::Comptime)\n            return self.isConcreteType(entry->kind.payload.Comptime.base);\n        if (entry->kind.tag == TypeKind::Named)\n        {\n            NodeId declId = self.findDeclaration(entry->kind.payload.Named.name);\n            if (declId.index == 0) return false;\n            /* only a type-bearing decl makes the name concrete: a\n             * same-named constant (`const u32 K[64]` in sha256) colliding\n             * with a generic param (`HashMap<K, V>`) must not turn the\n             * unbound `K` into a concrete instance argument */\n            Decl* namedDecl = self.declAt(declId);\n            if (namedDecl == null) return false;\n            if (namedDecl->kind.tag != DeclKind::Struct &&\n                namedDecl->kind.tag != DeclKind::Enum &&\n                namedDecl->kind.tag != DeclKind::Variant &&\n                namedDecl->kind.tag != DeclKind::Union &&\n                namedDecl->kind.tag != DeclKind::Trait &&\n                namedDecl->kind.tag != DeclKind::TypeAlias &&\n                namedDecl->kind.tag != DeclKind::Distinct)\n                return false;\n            u32 i = 0;\n            while (i < entry->kind.payload.Named.genericArgsLen)\n            {\n                if (!self.isConcreteType(entry->kind.payload.Named.genericArgs[i])) return false;\n                i++;\n            }\n        }\n        return true;\n    }\n\n    bool areConcreteTypes(Ty* types, u32 len)\n    {\n        u32 i = 0;\n        while (i < len)\n        {\n            if (!self.isConcreteType(types[i])) return false;\n            i++;\n        }\n        return true;\n    }\n\n    bool enqueue(MonoDeclKind kind, NodeId declaration, Ty* arguments, u32 argumentsLen)\n    {\n        NodeId noCall;\n        noCall.index = 0;\n        return self.enqueueVal(kind, declaration, arguments, argumentsLen, 0, 0, null, null, 0, null, null, 0, noCall);\n    }\n\n    /* dedup by (kind, decl, sameType args, valueKey, tail types) before\n     * appending; an enqueue is idempotent. Copies every array into the\n     * work item; the caller keeps ownership of its originals. */\n    bool enqueueVal(MonoDeclKind kind, NodeId declaration, Ty* arguments, u32 argumentsLen,\n                    u64 valueKey, u32 packArity, Str* literalNames, NodeId* literalNodes, u32 literalsLen,\n                    Ty* tailTypes, NodeId* tailNodes, u32 tailLen, NodeId callSite)\n    {\n        if (self.genericCount(declaration) != argumentsLen)\n        {\n            self.errors++;\n            return false;\n        }\n        /* still contains type params: skip silently; the site gets\n         * re-collected with activeSubs once its enclosing instance is\n         * known (collectType/collectCall substitute before enqueueing) */\n        if (!self.areConcreteTypes(arguments, argumentsLen)) return true;\n        /* head check: same decl, same arg types, same valueKey, same\n         * tail arity + types ⇒ same instance, nothing to do. The tail\n         * compare is what lets `println(\"a\", x)` and `println(\"a\", y)`\n         * with x,y:i32 collapse but x:i32,y:str stay separate. */\n        u32 i = 0;\n        while (i < self.workLen)\n        {\n            if (self.work[i].kind == kind && self.work[i].declaration.index == declaration.index)\n            {\n                u32 j = 0;\n                while (j < argumentsLen)\n                {\n                    if (!self.sema->sameType(self.work[i].arguments[j], arguments[j])) break;\n                    j++;\n                }\n                if (j == argumentsLen && self.work[i].valueKey == valueKey &&\n                    self.work[i].tailLen == tailLen)\n                {\n                    bool sameTail = true;\n                    u32 tt = 0;\n                    while (tt < tailLen)\n                    {\n                        if (!self.sema->sameType(self.work[i].tailTypes[tt], tailTypes[tt])) { sameTail = false; break; }\n                        tt++;\n                    }\n                    if (sameTail) return true;\n                }\n            }\n            i++;\n        }\n        if (!self.reserveWork()) return false;\n        MonoWorkItem* item = self.work + self.workLen;\n        item->kind = kind;\n        item->declaration = declaration;\n        item->callSite = callSite;\n        item->arguments = self.copyTypes(arguments, argumentsLen);\n        item->argumentsLen = argumentsLen;\n        item->inherited = null;\n        item->inheritedLen = 0;\n        item->valueKey = valueKey;\n        item->packArity = packArity;\n        item->literalNames = null;\n        item->literalNodes = null;\n        item->literalsLen = 0;\n        item->tailTypes = null;\n        item->tailNodes = null;\n        item->tailLen = 0;\n        if (tailLen > 0 && tailTypes != null && tailNodes != null)\n        {\n            Ty* ttypes = alloc<Ty>((usize)tailLen);\n            NodeId* tnodes = alloc<NodeId>((usize)tailLen);\n            if (ttypes != null && tnodes != null)\n            {\n                u32 k = 0;\n                while (k < tailLen)\n                {\n                    ttypes[k] = tailTypes[k];\n                    tnodes[k] = tailNodes[k];\n                    k++;\n                }\n                item->tailTypes = ttypes;\n                item->tailNodes = tnodes;\n                item->tailLen = tailLen;\n            }\n            else\n            {\n                if (ttypes != null) dealloc<Ty>(ttypes);\n                if (tnodes != null) dealloc<NodeId>(tnodes);\n            }\n        }\n        if (literalsLen > 0)\n        {\n            Str* lnames = alloc<Str>((usize)literalsLen);\n            NodeId* lnodes = alloc<NodeId>((usize)literalsLen);\n            if (lnames != null && lnodes != null)\n            {\n                u32 k = 0;\n                while (k < literalsLen)\n                {\n                    lnames[k] = literalNames[k];\n                    lnodes[k] = literalNodes[k];\n                    k++;\n                }\n                item->literalNames = lnames;\n                item->literalNodes = lnodes;\n                item->literalsLen = literalsLen;\n            }\n            else\n            {\n                if (lnames != null) dealloc<Str>(lnames);\n                if (lnodes != null) dealloc<NodeId>(lnodes);\n            }\n        }\n        self.workLen++;\n        return item->arguments != null || argumentsLen == 0;\n    }\n\n    /* enqueues the Named type itself (when it has generic args) and\n     * recurses into the args: Pointer/Slice/Array wrappers exist here\n     * only to carry the walk inward. */\n    bool collectType(Ty typeNode)\n    {\n        if (typeNode == 0) return true;\n        TypeEntry* entry = self.typeEntryAt(typeNode);\n        if (entry == null) return false;\n        if (entry->kind.tag == TypeKind::Named)\n        {\n            NodeId declId = self.findDeclaration(entry->kind.payload.Named.name);\n            if (entry->kind.payload.Named.genericArgsLen > 0)\n            {\n                NodeId pref = self.findGenericDeclaration(entry->kind.payload.Named.name,\n                                                          entry->kind.payload.Named.genericArgsLen);\n                if (pref.index != 0) declId = pref;\n            }\n            if (declId.index == 0) return true; /* unresolved name: nothing to enqueue */\n            if (entry->kind.payload.Named.genericArgsLen > 0)\n            {\n                u32 gaLen = entry->kind.payload.Named.genericArgsLen;\n                Ty* ga = entry->kind.payload.Named.genericArgs;\n                if (self.activeSubsLen > 0 && self.activeSubs != null)\n                {\n                    // instance-body re-collection: `alloc<T>` becomes alloc<str>\n                    Ty* subst = alloc<Ty>((usize)gaLen);\n                    if (subst != null)\n                    {\n                        u32 q = 0;\n                        while (q < gaLen)\n                        {\n                            subst[q] = self.substituteType(ga[q], self.activeSubs, self.activeSubsLen);\n                            q++;\n                        }\n                        bool okE = self.enqueue(MonoDeclKind::TypeDecl, declId, subst, gaLen);\n                        dealloc<Ty>(subst);\n                        if (!okE) return false;\n                    }\n                }\n                else if (!self.enqueue(MonoDeclKind::TypeDecl, declId, ga, gaLen)) return false;\n            }\n            u32 i = 0;\n            while (i < entry->kind.payload.Named.genericArgsLen)\n            {\n                if (!self.collectType(entry->kind.payload.Named.genericArgs[i])) return false;\n                i++;\n            }\n            return true;\n        }\n        if (entry->kind.tag == TypeKind::Pointer) return self.collectType(entry->kind.payload.Pointer.base);\n        if (entry->kind.tag == TypeKind::Const) return self.collectType(entry->kind.payload.Const.base);\n        if (entry->kind.tag == TypeKind::Comptime) return self.collectType(entry->kind.payload.Comptime.base);\n        if (entry->kind.tag == TypeKind::Slice) return self.collectType(entry->kind.payload.Slice.base);\n        if (entry->kind.tag == TypeKind::Array) return self.collectType(entry->kind.payload.Array.base);\n        if (entry->kind.tag == TypeKind::FnPtr)\n        {\n            if (!self.collectType(entry->kind.payload.FnPtr.returnType)) return false;\n            u32 i = 0;\n            while (i < entry->kind.payload.FnPtr.paramsLen)\n            {\n                if (!self.collectType(entry->kind.payload.FnPtr.params[i])) return false;\n                i++;\n            }\n        }\n        if (entry->kind.tag == TypeKind::Tuple)\n        {\n            u32 i = 0;\n            while (i < entry->kind.payload.Tuple.elemsLen)\n            {\n                if (!self.collectType(entry->kind.payload.Tuple.elems[i])) return false;\n                i++;\n            }\n        }\n        return true;\n    }\n\n    /* the trailing param of a variadic function carries flag bit 16;\n     * its pack only exists per call site, so such functions are never\n     * statically evaluated */\n    bool hasVariadicParam(Decl* d)\n    {\n        if (d == null || d->kind.tag != DeclKind::Func) return false;\n        if (d->kind.payload.Func.paramsLen == 0) return false;\n        NodeId lastId = d->kind.payload.Func.params[d->kind.payload.Func.paramsLen - 1];\n        Node* pn = self.nodeAt(lastId);\n        return pn != null && pn->kind.tag == NodeKind::Param &&\n               (pn->kind.payload.Param.value.flags & 16) != 0;\n    }\n\n    bool recordStaticDecl(NodeId declId)\n    {\n        u32 i = 0;\n        while (i < self.staticCtLen)\n        {\n            if (self.staticCtDecls[i].index == declId.index) return true;\n            i++;\n        }\n        if (!self.reserveStaticCt()) return false;\n        NodeId none;\n        none.index = 0;\n        self.staticCtDecls[self.staticCtLen] = declId;\n        self.staticCtCalls[self.staticCtLen] = none;\n        self.staticCtLen++;\n        return true;\n    }\n\n    bool recordStaticCall(NodeId declId, NodeId callId)\n    {\n        u32 first = 0;\n        bool haveFirst = false;\n        u32 i = 0;\n        while (i < self.staticCtLen)\n        {\n            if (self.staticCtDecls[i].index == declId.index)\n            {\n                if (self.staticCtCalls[i].index == callId.index) return true;\n                if (!haveFirst) { first = i; haveFirst = true; }\n            }\n            i++;\n        }\n        if (!haveFirst) return true; /* decl not recorded: not static */\n        /* the placeholder entry carries the first use site; later use\n         * sites get their own entry so each literal call is checked */\n        if (self.staticCtCalls[first].index == 0)\n        {\n            self.staticCtCalls[first] = callId;\n            return true;\n        }\n        if (!self.reserveStaticCt()) return false;\n        self.staticCtDecls[self.staticCtLen] = declId;\n        self.staticCtCalls[self.staticCtLen] = callId;\n        self.staticCtLen++;\n        return true;\n    }\n\n    /* a function whose body starts with a top-level `comptime` block is\n     * inlined by the evaluator; calls to it inside another comptime block\n     * never become runtime calls and need no instance. */\n    bool declHasTopComptime(NodeId declId)\n    {\n        Node* dn = self.nodeAt(declId);\n        if (dn == null || dn->kind.tag != NodeKind::Decl) return false;\n        Decl* d = &dn->kind.payload.Decl.value;\n        if (d->kind.tag != DeclKind::Func) return false;\n        Node* bn = self.nodeAt(d->kind.payload.Func.body);\n        if (bn == null || bn->kind.tag != NodeKind::Stmt) return false;\n        Stmt* bs = &bn->kind.payload.Stmt.value;\n        if (bs->kind.tag == StmtKind::Comptime) return true;\n        if (bs->kind.tag == StmtKind::Block)\n        {\n            u32 i = 0;\n            while (i < bs->kind.payload.Block.stmtsLen)\n            {\n                Node* sn = self.nodeAt(bs->kind.payload.Block.stmts[i]);\n                if (sn != null && sn->kind.tag == NodeKind::Stmt &&\n                    sn->kind.payload.Stmt.value.kind.tag == StmtKind::Comptime)\n                    return true;\n                i++;\n            }\n        }\n        return false;\n    }\n\n    /* follows a bare name to a global `const` whose value is a literal,\n     * so value specialization binds `print(FMT, x)` exactly like\n     * `print(\"...\", x)` instead of leaving the format unfolded */\n    NodeId constLiteralNode(Str name)\n    {\n        NodeId declId = self.findDeclaration(name);\n        u32 depth = 0;\n        while (declId.index != 0 && depth < 8)\n        {\n            Decl* d = self.declAt(declId);\n            if (d == null || d->kind.tag != DeclKind::Constant) break;\n            NodeId valueId = d->kind.payload.Constant.value;\n            Node* vn = self.nodeAt(valueId);\n            if (vn == null || vn->kind.tag != NodeKind::Expr) break;\n            Expr* ve = &vn->kind.payload.Expr.value;\n            if (ve->kind.tag == ExprKind::StringLit || ve->kind.tag == ExprKind::IntLit ||\n                ve->kind.tag == ExprKind::CharLit || ve->kind.tag == ExprKind::BoolLit)\n                return valueId;\n            if (ve->kind.tag != ExprKind::Ident) break;\n            declId = self.findDeclaration(ve->kind.payload.Ident.name);\n            depth++;\n        }\n        NodeId none;\n        none.index = 0;\n        return none;\n    }\n\n    /* generic-call detector: resolves the callee, fills one binding per\n     * generic slot from the call args, and enqueues with value key plus\n     * literal/tail metadata. Non-generic and unresolved callees return\n     * true: there is simply nothing to instantiate. */\n    bool collectCall(NodeId callId)\n    {\n        Node* callNode = self.nodeAt(callId);\n        if (callNode == null || callNode->kind.tag != NodeKind::Expr) return true;\n        Expr* call = &callNode->kind.payload.Expr.value;\n        if (call->kind.tag != ExprKind::Call) return true;\n        Node* calleeNode = self.nodeAt(call->kind.payload.Call.callee);\n        if (calleeNode == null || calleeNode->kind.tag != NodeKind::Expr) return true;\n        Expr* callee = &calleeNode->kind.payload.Expr.value;\n        if (callee->kind.tag != ExprKind::Ident) return true;\n        NodeId declaration = self.findDeclaration(callee->kind.payload.Ident.name);\n        u32 gcount = self.genericCount(declaration);\n        if (declaration.index == 0 || gcount == 0)\n        {\n            /* non-generic callee: remember the use site of a function\n             * whose comptime block will be evaluated statically */\n            if (declaration.index != 0 && gcount == 0 && self.comptimeCollect == 0)\n            {\n                if (!self.recordStaticCall(declaration, callId)) return false;\n            }\n            return true;\n        }\n        /* inside a comptime block,