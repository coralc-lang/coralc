mod types = import("typecheck/types.crl");
mod ast = import("ast/ast.crl");
mod scopes = import("typecheck/scopes.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");
mod expr = import("typecheck/expr.crl");

// ---------------------------------------------------------------------------
// helpers
// ---------------------------------------------------------------------------

static void pushMangledName(str.String* out, str.strView name)
{
    char buf[256]; u32 n = 0;
    for (u32 i = 0; i < name.len && n < 255; i++)
    {
        u8 c = name.ptr[i];
        if (c == (u8)'<') { buf[n++]='_'; buf[n++]='_'; }
        else if (c == (u8)'>' || c == (u8)' ' || c == (u8)'*') { }
        else if (c == (u8)',') buf[n++]='_';
        else if (c == (u8)'[' || c == (u8)']') { }
        else buf[n++] = (char)c;
    }
    buf[n]=0;
    out.pushCstr(buf);
}

static bool hasGenericMark(str.strView name)
{
    for (u32 i = 0; i < name.len; i++) if (name.ptr[i] == (u8)'<') return true;
    return false;
}

static void pushQualName(str.String* out, str.strView name)
{
    if (hasGenericMark(name)) { pushMangledName(out, name); return; }
    u32 dot = (u32)-1;
    for (u32 i = 0; i < name.len; i++) if (name.ptr[i] == '.') dot = i;
    if (dot != (u32)-1) out.pushView(str.strView::fromParts(name.ptr + dot + 1, name.len - dot - 1));
    else out.pushView(name);
}

static void pushType(str.String* out, types.CType* ct)
{
    if (ct == null) { out.pushCstr("void"); return; }
    switch (ct->kind)
    {
    case types.TY_VOID: out.pushCstr("void"); return;
    case types.TY_BOOL: out.pushCstr("bool"); return;
    case types.TY_CHAR: out.pushCstr("char"); return;
    case types.TY_INT:
        if (ct->width == 8) out.pushCstr(ct->isSigned ? "int8_t" : "uint8_t");
        else if (ct->width == 16) out.pushCstr(ct->isSigned ? "int16_t" : "uint16_t");
        else if (ct->width == 32) out.pushCstr(ct->isSigned ? "int32_t" : "uint32_t");
        else if (ct->width == 64) out.pushCstr(ct->isSigned ? "int64_t" : "uint64_t");
        else out.pushCstr(ct->isSigned ? "int" : "unsigned");
        return;
    case types.TY_FLOAT: out.pushCstr(ct->width == 32 ? "float" : "double"); return;
    case types.TY_PTR: pushType(out, ct->elem); out.pushCstr(ct->isConstPtr ? " const*" : "*"); return;
    case types.TY_SLICE:
    case types.TY_ARRAY: pushType(out, ct->elem); out.pushCstr("*"); return;
    case types.TY_FUNC:
        pushType(out, ct->ret);
        out.pushCstr(" (*)(");
        for (u32 i = 0; i < ct->nparams; i++) { if (i) out.pushCstr(", "); pushType(out, ct->params[i]); }
        if (ct->variadic) out.pushCstr(ct->nparams ? ", ..." : "...");
        out.pushCstr(")"); return;
    case types.TY_NAMED:
        if (ct->name.len > 0) pushQualName(out, ct->name);
        else out.pushCstr("void");
        return;
    default:
        if (ct->name.len > 0) pushQualName(out, ct->name);
        else out.pushCstr("void");
        return;
    }
}

static types.CType* resolve(scopes.Scope* top, scopes.ModuleTable* mods, ast.TypeExpr* te)
{
    if (te == null) return null;
    return scopes.resolveTypeExpr(te, top, mods, null, 0);
}

static types.CType* inferType(ast.Expr* e)
{
    return expr.inferredType(e);
}

static void pushU64(str.String* out, u64 v)
{
    if (v == 0) { out.pushCstr("0"); return; }
    char buf[24]; u32 i = 0;
    while (v > 0) { buf[i++] = (char)('0' + (char)(v % 10)); v = v / 10; }
    while (i > 0) { out.pushChar(buf[--i]); }
}

// ---------------------------------------------------------------------------
// expression emitter
// ---------------------------------------------------------------------------

static void genExpr(str.String* out, ast.Expr* e, u32 indent);

static void pushIndent(str.String* out, u32 depth)
{
    for (u32 i = 0; i < depth; i++) out.pushCstr("    ");
}

static void genExpr(str.String* out, ast.Expr* e, u32 indent)
{
    if (e == null) { out.pushCstr("0"); return; }
    switch (e->kind)
    {
    case ast.EX_INT:
        out.pushView(e->text);
        break;
    case ast.EX_FLOAT:
        out.pushView(e->text);
        break;
    case ast.EX_STR:
        out.pushView(e->text);
        break;
    case ast.EX_CHAR:
        out.pushView(e->text);
        break;
    case ast.EX_BOOL:
        if (e->text.len == 4 && e->text.ptr[0] == 't') out.pushCstr("true");
        else out.pushCstr("false");
        break;
    case ast.EX_NULL:
        out.pushCstr("nullptr");
        break;
    case ast.EX_IDENT:
        pushQualName(out, e->text);
        break;
    case ast.EX_PAREN:
        out.pushCstr("(");
        genExpr(out, e->a, indent);
        out.pushCstr(")");
        break;
    case ast.EX_UNARY:
        if (e->post) {
            genExpr(out, e->a, indent);
            out.pushView(e->text);
        } else {
            out.pushView(e->text);
            genExpr(out, e->a, indent);
        }
        break;
    case ast.EX_BINARY:
        genExpr(out, e->a, indent);
        out.pushCstr(" ");
        out.pushView(e->text);
        out.pushCstr(" ");
        genExpr(out, e->b, indent);
        break;
    case ast.EX_TERNARY:
        genExpr(out, e->a, indent);
        out.pushCstr(" ? ");
        genExpr(out, e->b, indent);
        out.pushCstr(" : ");
        genExpr(out, e->c, indent);
        break;
    case ast.EX_CALL:
        genExpr(out, e->a, indent);
        out.pushCstr("(");
        for (u32 i = 0; i < e->nargs; i++) {
            if (i) out.pushCstr(", ");
            genExpr(out, e->args[i], indent);
        }
        out.pushCstr(")");
        break;
    case ast.EX_DOT:
        genExpr(out, e->a, indent);
        out.pushCstr(".");
        pushQualName(out, e->text);
        break;
    case ast.EX_ARROW:
        genExpr(out, e->a, indent);
        out.pushCstr("->");
        pushQualName(out, e->text);
        break;
    case ast.EX_INDEX:
        genExpr(out, e->a, indent);
        out.pushCstr("[");
        genExpr(out, e->b, indent);
        out.pushCstr("]");
        break;
    case ast.EX_DEREF:
        out.pushCstr("*");
        genExpr(out, e->a, indent);
        break;
    case ast.EX_ADDR:
        out.pushCstr("&");
        genExpr(out, e->a, indent);
        break;
    case ast.EX_CAST:
        {
            types.CType* ct = resolve(null, null, e->type);
            out.pushCstr("static_cast<");
            pushType(out, ct);
            out.pushCstr(">(");
            genExpr(out, e->a, indent);
            out.pushCstr(")");
        }
        break;
    case ast.EX_SIZEOF:
        {
            types.CType* ct = resolve(null, null, e->type);
            out.pushCstr("sizeof(");
            pushType(out, ct);
            out.pushCstr(")");
        }
        break;
    case ast.EX_INIT:
        {
            types.CType* ct = resolve(null, null, e->type);
            pushType(out, ct);
            out.pushCstr("{");
            for (u32 i = 0; i < e->nargs; i++) {
                if (i) out.pushCstr(", ");
                genExpr(out, e->args[i], indent);
            }
            out.pushCstr("}");
        }
        break;
    case ast.EX_TYPELIT:
        {
            types.CType* ct = resolve(null, null, e->type);
            pushType(out, ct);
        }
        break;
    default:
        out.pushCstr("/*TODO:expr*/");
        break;
    }
}

// ---------------------------------------------------------------------------
// statement emitter
// ---------------------------------------------------------------------------

static void genStmt(str.String* out, ast.Stmt* s, u32 indent);

static void genStmts(str.String* out, ast.Stmt** stmts, u32 n, u32 indent)
{
    for (u32 i = 0; i < n; i++) genStmt(out, stmts[i], indent);
}

static void genBlock(str.String* out, ast.Stmt* s, u32 indent)
{
    if (s == null) { pushIndent(out, indent); out.pushCstr("{}\n"); return; }
    if (s->kind == ast.ST_BLOCK) {
        genStmts(out, s->stmts, s->nstmts, indent);
    } else {
        genStmt(out, s, indent);
    }
}

static void genStmt(str.String* out, ast.Stmt* s, u32 indent)
{
    if (s == null) return;
    switch (s->kind)
    {
    case ast.ST_BLOCK:
        pushIndent(out, indent);
        out.pushCstr("{\n");
        genStmts(out, s->stmts, s->nstmts, indent + 1);
        pushIndent(out, indent);
        out.pushCstr("}\n");
        break;
    case ast.ST_VAR:
        {
            types.CType* ct = resolve(null, null, s->type);
            pushIndent(out, indent);
            pushType(out, ct);
            out.pushCstr(" ");
            out.pushView(s->text);
            if (s->a != null) {
                out.pushCstr(" = ");
                genExpr(out, s->a, indent);
            }
            out.pushCstr(";\n");
        }
        break;
    case ast.ST_RETURN:
        pushIndent(out, indent);
        if (s->a != null) {
            out.pushCstr("return ");
            genExpr(out, s->a, indent);
            out.pushCstr(";\n");
        } else {
            out.pushCstr("return;\n");
        }
        break;
    case ast.ST_IF:
        pushIndent(out, indent);
        out.pushCstr("if (");
        genExpr(out, s->a, indent);
        out.pushCstr(")\n");
        genBlock(out, s->body, indent + 1);
        if (s->body2 != null) {
            pushIndent(out, indent);
            out.pushCstr("else\n");
            genBlock(out, s->body2, indent + 1);
        }
        break;
    case ast.ST_WHILE:
        pushIndent(out, indent);
        out.pushCstr("while (");
        genExpr(out, s->a, indent);
        out.pushCstr(")\n");
        genBlock(out, s->body, indent + 1);
        break;
    case ast.ST_FOR:
        {
            pushIndent(out, indent);
            out.pushCstr("for (");
            if (s->init != null) {
                if (s->init->kind == ast.ST_VAR) {
                    types.CType* ct = resolve(null, null, s->init->type);
                    pushType(out, ct);
                    out.pushCstr(" ");
                    out.pushView(s->init->text);
                    if (s->init->a != null) { out.pushCstr(" = "); genExpr(out, s->init->a, indent); }
                } else if (s->init->kind == ast.ST_EXPR) {
                    genExpr(out, s->init->a, indent);
                }
            }
            out.pushCstr("; ");
            genExpr(out, s->b, indent);
            out.pushCstr("; ");
            genExpr(out, s->c, indent);
            out.pushCstr(")\n");
            genBlock(out, s->body, indent + 1);
        }
        break;
    case ast.ST_FORIN:
        {
            pushIndent(out, indent);
            out.pushCstr("for (auto& ");
            out.pushView(s->text);
            out.pushCstr(" : ");
            genExpr(out, s->a, indent);
            out.pushCstr(")\n");
            genBlock(out, s->body, indent + 1);
        }
        break;
    case ast.ST_LOOP:
        pushIndent(out, indent);
        out.pushCstr("for (;;)\n");
        genBlock(out, s->body, indent + 1);
        break;
    case ast.ST_EXPR:
        pushIndent(out, indent);
        genExpr(out, s->a, indent);
        out.pushCstr(";\n");
        break;
    case ast.ST_ASSERT:
        pushIndent(out, indent);
        out.pushCstr("if (!(");
        genExpr(out, s->a, indent);
        out.pushCstr(")) __builtin_unreachable();\n");
        break;
    case ast.ST_BREAK:
        pushIndent(out, indent);
        out.pushCstr("break;\n");
        break;
    case ast.ST_CONTINUE:
        pushIndent(out, indent);
        out.pushCstr("continue;\n");
        break;
    case ast.ST_ASM:
        pushIndent(out, indent);
        out.pushCstr("asm volatile(\"");
        out.pushView(s->text);
        out.pushCstr("\");\n");
        break;
    case ast.ST_DEFER:
        // C++ doesn't have defer; emit as block with a comment
        pushIndent(out, indent);
        out.pushCstr("/* defer { */\n");
        genBlock(out, s->body, indent);
        pushIndent(out, indent);
        out.pushCstr("/* } */\n");
        break;
    case ast.ST_SWITCH:
        {
            pushIndent(out, indent);
            out.pushCstr("switch (");
            genExpr(out, s->a, indent);
            out.pushCstr(") {\n");
            for (u32 i = 0; i < s->ncases; i++) {
                ast.StmtCase* sc = s->cases[i];
                pushIndent(out, indent + 1);
                if (sc->value != null) {
                    out.pushCstr("case ");
                    genExpr(out, sc->value, indent);
                    out.pushCstr(":\n");
                } else {
                    out.pushCstr("default:\n");
                }
                genStmts(out, sc->body, sc->nbody, indent + 2);
                pushIndent(out, indent + 2);
                out.pushCstr("break;\n");
            }
            pushIndent(out, indent);
            out.pushCstr("}\n");
        }
        break;
    default:
        pushIndent(out, indent);
        out.pushCstr("/*TODO:stmt*/\n");
        break;
    }
}

// ---------------------------------------------------------------------------
// function body emitter
// ---------------------------------------------------------------------------

static void emitFuncBody(str.String* out, ast.Decl* d, u32 indent)
{
    if (d->body == null) {
        pushIndent(out, indent);
        out.pushCstr(";\n");
        return;
    }
    pushIndent(out, indent);
    out.pushCstr("{\n");
    genStmts(out, d->body->stmts, d->body->nstmts, indent + 1);
    pushIndent(out, indent);
    out.pushCstr("}\n");
}

// ---------------------------------------------------------------------------
// main entry: emitCpp — writes .hpp (types) + .cpp (bodies), returns .cpp path
// ---------------------------------------------------------------------------

pub str.strView emitCpp(ast.Program* prog, scopes.Scope* top, loader.Loader* ld,
                        scopes.ModuleTable* mods, str.strView path,
                        u32 optLevel, bool debug)
{
    // ---- .hpp ----
    str.String hpp = str.String::new();
    hpp.pushCstr("// Coral C++ header\n#pragma once\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n\n");

    // ---- .cpp ----
    str.String cpp = str.String::new();
    cpp.pushCstr("// Coral C++ source\n#include <stdint.h>\n#include <stdbool.h>\n#include <stddef.h>\n\n");

    // extract base name for #include
    u32 lastSlash = 0;
    for (u32 i = 0; i < path.len; i++) if (path.ptr[i] == (u8)'/') lastSlash = i;
    str.strView baseName = str.strView::fromParts(path.ptr + lastSlash, path.len - lastSlash);
    u32 dotPos = baseName.len;
    for (u32 i = 0; i < baseName.len; i++) if (baseName.ptr[i] == (u8)'.') { dotPos = i; break; }
    cpp.pushCstr("#include \"");
    cpp.pushView(str.strView::fromParts(baseName.ptr, dotPos));
    cpp.pushCstr(".hpp\"\n\n");

    // forward decls in header
    for (u32 i = 0; i < prog->ndecls; i++)
    {
        ast.Decl* d = prog->decls[i];
        if (d != null && d->kind == ast.DT_STRUCT && d->ngenerics == 0)
        {
            hpp.pushCstr("struct ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(";\n");
        }
    }
    if (prog->ndecls > 0) hpp.pushCstr("\n");

    // ---- emit each declaration ----
    for (u32 i = 0; i < prog->ndecls; i++)
    {
        ast.Decl* d = prog->decls[i];
        if (d == null) continue;
        if (d->ngenerics > 0) continue;
        switch (d->kind)
        {
        case ast.DT_STRUCT:
        {
            hpp.pushCstr("struct ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(" {\n");
            // fields
            for (u32 f = 0; f < d->nfields; f++)
            {
                types.CType* ft = resolve(top, mods, d->fields[f].type);
                hpp.pushCstr("    ");
                pushType(&hpp, ft);
                hpp.pushCstr(" ");
                pushQualName(&hpp, d->fields[f].name);
                hpp.pushCstr(";\n");
            }
            // methods from DT_FUNC with structName
            for (u32 j = 0; j < prog->ndecls; j++)
            {
                ast.Decl* m = prog->decls[j];
                if (m == null || m->kind != ast.DT_FUNC) continue;
                if (m->structName.len == 0 || !strEq(m->structName, d->name)) continue;
                if (m->ngenerics > 0) continue;
                types.CType* ret = resolve(top, mods, m->type);
                hpp.pushCstr("    ");
                pushType(&hpp, ret);
                hpp.pushCstr(" ");
                pushQualName(&hpp, m->name);
                hpp.pushCstr("(");
                for (u32 p = 0; p < m->nparams; p++) {
                    if (p) hpp.pushCstr(", ");
                    types.CType* pt = resolve(top, mods, m->params[p].type);
                    pushType(&hpp, pt);
                    if (m->params[p].name.len > 0) { hpp.pushCstr(" "); pushQualName(&hpp, m->params[p].name); }
                }
                if (m->variadic) hpp.pushCstr(m->nparams ? ", ..." : "...");
                if (m->body != null) hpp.pushCstr(");\n");
                else hpp.pushCstr(");\n");
            }
            // methods from DT_METHODBLOCK
            for (u32 j = 0; j < prog->ndecls; j++)
            {
                ast.Decl* mb = prog->decls[j];
                if (mb == null || mb->kind != ast.DT_METHODBLOCK) continue;
                if (!strEq(mb->name, d->name)) continue;
                for (u32 k = 0; k < mb->ndecls; k++)
                {
                    ast.Decl* m = mb->decls[k];
                    if (m == null || m->kind != ast.DT_FUNC) continue;
                    if (m->ngenerics > 0) continue;
                    types.CType* ret = resolve(top, mods, m->type);
                    hpp.pushCstr("    ");
                    pushType(&hpp, ret);
                    hpp.pushCstr(" ");
                    pushQualName(&hpp, m->name);
                    hpp.pushCstr("(");
                    u32 start = 0;
                    if (m->nparams > 0 && m->params[0].name.len == 0) start = 1;
                    else if (m->nparams > 0 && strEq(m->params[0].name, str.strView::fromCstr("self"))) start = 1;
                    for (u32 p = start; p < m->nparams; p++) {
                        if (p > start) hpp.pushCstr(", ");
                        types.CType* pt = resolve(top, mods, m->params[p].type);
                        pushType(&hpp, pt);
                        if (m->params[p].name.len > 0) { hpp.pushCstr(" "); pushQualName(&hpp, m->params[p].name); }
                    }
                    if (m->variadic) hpp.pushCstr((m->nparams > start) ? ", ..." : "...");
                    hpp.pushCstr(");\n");
                }
            }
            hpp.pushCstr("};\n\n");

            // ---- emit method bodies in .cpp ----
            // DT_FUNC methods
            for (u32 j = 0; j < prog->ndecls; j++)
            {
                ast.Decl* m = prog->decls[j];
                if (m == null || m->kind != ast.DT_FUNC) continue;
                if (m->structName.len == 0 || !strEq(m->structName, d->name)) continue;
                if (m->ngenerics > 0 || m->body == null) continue;
                types.CType* ret = resolve(top, mods, m->type);
                pushType(&cpp, ret);
                cpp.pushCstr(" ");
                pushQualName(&cpp, d->name);
                cpp.pushCstr("::");
                pushQualName(&cpp, m->name);
                cpp.pushCstr("(");
                for (u32 p = 0; p < m->nparams; p++) {
                    if (p) cpp.pushCstr(", ");
                    types.CType* pt = resolve(top, mods, m->params[p].type);
                    pushType(&cpp, pt);
                    if (m->params[p].name.len > 0) { cpp.pushCstr(" "); pushQualName(&cpp, m->params[p].name); }
                }
                if (m->variadic) cpp.pushCstr(m->nparams ? ", ..." : "...");
                cpp.pushCstr(")\n");
                emitFuncBody(&cpp, m, 0);
                cpp.pushCstr("\n");
            }
            // DT_METHODBLOCK methods
            for (u32 j = 0; j < prog->ndecls; j++)
            {
                ast.Decl* mb = prog->decls[j];
                if (mb == null || mb->kind != ast.DT_METHODBLOCK) continue;
                if (!strEq(mb->name, d->name)) continue;
                for (u32 k = 0; k < mb->ndecls; k++)
                {
                    ast.Decl* m = mb->decls[k];
                    if (m == null || m->kind != ast.DT_FUNC) continue;
                    if (m->ngenerics > 0 || m->body == null) continue;
                    types.CType* ret = resolve(top, mods, m->type);
                    pushType(&cpp, ret);
                    cpp.pushCstr(" ");
                    pushQualName(&cpp, d->name);
                    cpp.pushCstr("::");
                    pushQualName(&cpp, m->name);
                    cpp.pushCstr("(");
                    u32 start = 0;
                    if (m->nparams > 0 && m->params[0].name.len == 0) start = 1;
                    else if (m->nparams > 0 && strEq(m->params[0].name, str.strView::fromCstr("self"))) start = 1;
                    for (u32 p = start; p < m->nparams; p++) {
                        if (p > start) cpp.pushCstr(", ");
                        types.CType* pt = resolve(top, mods, m->params[p].type);
                        pushType(&cpp, pt);
                        if (m->params[p].name.len > 0) { cpp.pushCstr(" "); pushQualName(&cpp, m->params[p].name); }
                    }
                    if (m->variadic) cpp.pushCstr((m->nparams > start) ? ", ..." : "...");
                    cpp.pushCstr(")\n");
                    emitFuncBody(&cpp, m, 0);
                    cpp.pushCstr("\n");
                }
            }
            break;
        }
        case ast.DT_ENUM:
        {
            hpp.pushCstr("enum class ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(" {\n");
            for (u32 v = 0; v < d->nvariants; v++) {
                hpp.pushCstr("    ");
                pushQualName(&hpp, d->variants[v].name);
                if (d->variants[v].value != null) {
                    hpp.pushCstr(" = ");
                    genExpr(&hpp, d->variants[v].value, 0);
                }
                hpp.pushCstr(",\n");
            }
            hpp.pushCstr("};\n\n");
            break;
        }
        case ast.DT_TYPEDEF:
        {
            types.CType* underlying = resolve(top, mods, d->type);
            hpp.pushCstr("using ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(" = ");
            pushType(&hpp, underlying);
            hpp.pushCstr(";\n\n");
            break;
        }
        case ast.DT_DISTINCT:
        {
            types.CType* underlying = resolve(top, mods, d->type);
            hpp.pushCstr("struct ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(" { ");
            pushType(&hpp, underlying);
            hpp.pushCstr(" value; };\n\n");
            break;
        }
        case ast.DT_CONST:
        {
            if (d->value == null) break;
            types.CType* ct = resolve(top, mods, d->type);
            hpp.pushCstr("constexpr ");
            pushType(&hpp, ct);
            hpp.pushCstr(" ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(" = ");
            genExpr(&hpp, d->value, 0);
            hpp.pushCstr(";\n\n");
            break;
        }
        case ast.DT_VAR:
        {
            types.CType* ct = resolve(top, mods, d->type);
            hpp.pushCstr("extern ");
            pushType(&hpp, ct);
            hpp.pushCstr(" ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr(";\n");
            cpp.pushType(&cpp, ct);
            cpp.pushCstr(" ");
            pushQualName(&cpp, d->name);
            if (d->value != null) {
                cpp.pushCstr(" = ");
                genExpr(&cpp, d->value, 0);
            }
            cpp.pushCstr(";\n");
            break;
        }
        case ast.DT_EXTERN:
        {
            if (d->isVar) {
                types.CType* ct = resolve(top, mods, d->type);
                hpp.pushCstr("extern \"C\" ");
                pushType(&hpp, ct);
                hpp.pushCstr(" ");
                pushQualName(&hpp, d->name);
                hpp.pushCstr(";\n");
            } else {
                hpp.pushCstr("extern \"C\" ");
                types.CType* ret = resolve(top, mods, d->type);
                pushType(&hpp, ret);
                hpp.pushCstr(" ");
                pushQualName(&hpp, d->name);
                hpp.pushCstr("(");
                for (u32 p = 0; p < d->nparams; p++) {
                    if (p) hpp.pushCstr(", ");
                    types.CType* pt = resolve(top, mods, d->params[p].type);
                    pushType(&hpp, pt);
                }
                if (d->variadic) hpp.pushCstr(d->nparams ? ", ..." : "...");
                hpp.pushCstr(");\n");
            }
            break;
        }
        case ast.DT_FUNC:
        {
            if (d->structName.len > 0) break;
            if (d->body == null) {
                // declaration only
                types.CType* ret = resolve(top, mods, d->type);
                hpp.pushCstr("extern \"C\" ");
                pushType(&hpp, ret);
                hpp.pushCstr(" ");
                pushQualName(&hpp, d->name);
                hpp.pushCstr("(");
                for (u32 p = 0; p < d->nparams; p++) {
                    if (p) hpp.pushCstr(", ");
                    types.CType* pt = resolve(top, mods, d->params[p].type);
                    pushType(&hpp, pt);
                    if (d->params[p].name.len > 0) { hpp.pushCstr(" "); pushQualName(&hpp, d->params[p].name); }
                }
                if (d->variadic) hpp.pushCstr(d->nparams ? ", ..." : "...");
                hpp.pushCstr(");\n\n");
                break;
            }
            // free function with body
            types.CType* ret = resolve(top, mods, d->type);
            // header: declaration
            pushType(&hpp, ret);
            hpp.pushCstr(" ");
            pushQualName(&hpp, d->name);
            hpp.pushCstr("(");
            for (u32 p = 0; p < d->nparams; p++) {
                if (p) hpp.pushCstr(", ");
                types.CType* pt = resolve(top, mods, d->params[p].type);
                pushType(&hpp, pt);
                if (d->params[p].name.len > 0) { hpp.pushCstr(" "); pushQualName(&hpp, d->params[p].name); }
            }
            if (d->variadic) hpp.pushCstr(d->nparams ? ", ..." : "...");
            hpp.pushCstr(");\n\n");
            // source: body
            pushType(&cpp, ret);
            cpp.pushCstr(" ");
            pushQualName(&cpp, d->name);
            cpp.pushCstr("(");
            for (u32 p = 0; p < d->nparams; p++) {
                if (p) cpp.pushCstr(", ");
                types.CType* pt = resolve(top, mods, d->params[p].type);
                pushType(&cpp, pt);
                if (d->params[p].name.len > 0) { cpp.pushCstr(" "); pushQualName(&cpp, d->params[p].name); }
            }
            if (d->variadic) cpp.pushCstr(d->nparams ? ", ..." : "...");
            cpp.pushCstr(")\n");
            emitFuncBody(&cpp, d, 0);
            cpp.pushCstr("\n");
            break;
        }
        default: break;
        }
    }

    // ---- write .hpp ----
    str.String opath = str.String::new();
    u32 lastDot = 0; bool hasDot = false;
    for (u32 k = 0; k < path.len; k++) if (path.ptr[k] == (u8)'.') { lastDot = k; hasDot = true; }
    if (hasDot) opath.pushView(str.strView::fromParts(path.ptr, lastDot));
    else opath.pushView(path);
    opath.pushCstr(".hpp");
    void* f = libc.fopen(opath.asCstr(), (const u8*)"wb");
    if (f != null) {
        libc.fwrite(hpp.asU8(), 1, hpp.len, f);
        libc.fclose(f);
        libc.write(1, (const u8*)"wrote ", 6);
        libc.write(1, (const u8*)opath.asCstr(), opath.len);
        libc.write(1, (const u8*)"\n", 1);
    }
    opath.free();

    // ---- write .cpp ----
    str.String cpath = str.String::new();
    u32 lastDot2 = 0; bool hasDot2 = false;
    for (u32 k = 0; k < path.len; k++) if (path.ptr[k] == (u8)'.') { lastDot2 = k; hasDot2 = true; }
    if (hasDot2) cpath.pushView(str.strView::fromParts(path.ptr, lastDot2));
    else cpath.pushView(path);
    cpath.pushCstr(".cpp");
    str.strView cppPath = str.strView::fromParts(cpath.ptr, cpath.len);
    void* fc = libc.fopen(cpath.asCstr(), (const u8*)"wb");
    if (fc != null) {
        libc.fwrite(cpp.asU8(), 1, cpp.len, fc);
        libc.fclose(fc);
        libc.write(1, (const u8*)"wrote ", 6);
        libc.write(1, (const u8*)cpath.asCstr(), cpath.len);
        libc.write(1, (const u8*)"\n", 1);
    }

    hpp.free();
    cpp.free();

    // return the .cpp path for the driver to compile
    return cppPath;
}
