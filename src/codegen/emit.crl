mod ast = import("ast/ast.crl");
mod scopes = import("typecheck/scopes.crl");
mod str = import("std/text/string.crl");
mod emitc = import("emitc");
mod emitcpp = import("emitcpp");
mod loader = import("typecheck/loader.crl");

// emit.crl: codegen dispatch. Each target lives in its own module:
//   emitc.crl   - C header (declarations only)
//   emitcpp.crl - C++ full transpilation (header + source with bodies)

pub void emitH(ast.Program* prog, scopes.Scope* top,
               scopes.ModuleTable* mods,
               str.strView path, bool debug)
{
    emitc.emitH(prog, top, mods, path, debug);
}

pub str.strView emitCpp(ast.Program* prog, scopes.Scope* top, loader.Loader* ld,
                        scopes.ModuleTable* mods, str.strView path,
                        u32 optLevel, bool debug)
{
    return emitcpp.emitCpp(prog, top, ld, mods, path, optLevel, debug);
}
