mod libc = import("std/platform/libc.crl");
mod ast = import("ast/ast.crl");
mod scopes = import("typecheck/scopes.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod emitir = import("emitir");
mod error = import("error");
mod wallvm = import("lib/wallvm/wallvm.crl");
mod loader = import("typecheck/loader.crl");
mod borrowcheck = import("lib/wallvm/passes/borrowcheck.crl");
mod ir_types = import("lib/wallvm/ir_types.crl");
mod asm_rules = import("lib/wallvm/rules/asm_rules.crl");

// ---- asm peephole: strip provably-redundant instruction pairs ----
// Operates on the generated text line by line. Safe because it only
// removes no-ops and rewrites push/pop into equivalent mov.
//
// P1: push %X / pop %Y  →  (removed; the pop already loads the value)
//     When X != Y the pair becomes mov %X,%Y via the existing reload.
// P2: movq %R, -N(%rbp) / movq -N(%rbp), %R → remove reload
// P3: mov %X, %X → removed

struct AsmLine { str.strView text; bool dead; }

bool asmViewEq(str.strView a, str.strView b)
{
    if (a.len != b.len) return false;
    for (u32 i = 0; i < a.len; i++) if (a.ptr[i] != b.ptr[i]) return false;
    return true;
}

// Parse "MNEMONIC SRC, DST" into src and dst operands (AT&T syntax).
bool parseMov(str.strView line, str.strView* src, str.strView* dst)
{
    u32 s = 0;
    while (s < line.len && line.ptr[s] == ' ') s++;
    // find space after mnemonic
    while (s < line.len && line.ptr[s] != ' ') s++;
    while (s < line.len && line.ptr[s] == ' ') s++;
    if (s >= line.len) return false;
    u32 c = s;
    while (c < line.len && line.ptr[c] != ',') c++;
    if (c >= line.len) return false;
    src.len = c - s; src.ptr = line.ptr + s;
    c++;
    while (c < line.len && line.ptr[c] == ' ') c++;
    dst.len = line.len - c; dst.ptr = line.ptr + c;
    // trim trailing newline/space from dst
    while (dst.len > 0 && (dst.ptr[dst.len-1] == '\n' || dst.ptr[dst.len-1] == ' '))
        dst.len--;
    return true;
}

pub const char* asmPeephole(const char* src)
{
    if (!src) return src;
    u64 totalLen = 0;
    while (src[totalLen]) totalLen++;
    if (totalLen == 0) return src;

    u32 cap = 4096;
    AsmLine* lines = mman.alloc<AsmLine>(cap);
    u32 nLines = 0;
    u64 pos = 0;
    while (pos < totalLen && nLines < cap)
    {
        lines[nLines].dead = false;
        lines[nLines].text.ptr = src + pos;
        u64 start2 = pos;
        while (pos < totalLen && src[pos] != '\n') pos++;
        lines[nLines].text.len = (u32)(pos - start2);
        if (pos < totalLen) pos++;
        nLines++;
    }

    bool changed = true;
    u32 rounds = 0;
    while (changed && rounds < 8)
    {
        changed = false;
        rounds++;
        for (u32 i = 0; i + 1 < nLines; i++)
        {
            if (lines[i].dead || lines[i+1].dead) continue;
            str.strView a = lines[i].text;
            str.strView b = lines[i+1].text;
            if (a.len < 3 || b.len < 3) continue;
            u32 ao = 0; while (ao < a.len && a.ptr[ao] == ' ') ao++;
            u32 bo = 0; while (bo < b.len && b.ptr[bo] == ' ') bo++;
            if (ao >= a.len || bo >= b.len) continue;
            u8 ac2 = a.ptr[ao];
            u8 bc2 = b.ptr[bo];
            if (ac2 == '#' || ac2 == '.' || ac2 == '_' || ac2 == '/') continue;
            if (bc2 == '#' || bc2 == '.' || bc2 == '_' || bc2 == '/') continue;

            // P1: push %X / pop %Y
            {
                str.strView ta = str.strView::fromParts(a.ptr + ao, a.len - ao);
                str.strView tb = str.strView::fromParts(b.ptr + bo, b.len - bo);
                bool isPush = ta.len > 6 && libc.memcmp(ta.ptr, "push %", 6) == 0;
                bool isPop = tb.len > 5 && libc.memcmp(tb.ptr, "pop %", 5) == 0;
                if (isPush && isPop)
                {
                    str.strView pushReg = str.strView::fromParts(ta.ptr + 5, ta.len - 5);
                    str.strView popReg = str.strView::fromParts(tb.ptr + 4, tb.len - 4);
                    if (asmViewEq(pushReg, popReg))
                    {
                        lines[i].dead = true;
                        lines[i+1].dead = true;
                        changed = true;
                    }
                    continue;
                }
            }

            // P2/P2b/P3: movq/mov pairs
            {
                str.strView aSrc, aDst, bSrc, bDst;
                bool aOk = parseMov(a, &aSrc, &aDst);
                bool bOk = parseMov(b, &bSrc, &bDst);
                if (!aOk || !bOk) continue;

                // P3: mov %X, %X → remove
                if (aSrc.len > 0 && aSrc.ptr[0] == '%' &&
                    aDst.len > 0 && aDst.ptr[0] == '%' &&
                    asmViewEq(aSrc, aDst))
                {
                    lines[i].dead = true;
                    changed = true;
                    continue;
                }

                // P2: movq %R, SLOT followed by movq SLOT, %R
                if (aSrc.len > 0 && aSrc.ptr[0] == '%' &&
                    aDst.len > 0 && aDst.ptr[0] == '-' &&
                    bSrc.len > 0 && bSrc.ptr[0] == '-' &&
                    bDst.len > 0 && bDst.ptr[0] == '%')
                {
                    if (asmViewEq(aDst, bSrc) && asmViewEq(aSrc, bDst))
                    {
                        lines[i+1].dead = true;
                        changed = true;
                    }
                }
                // P2b: movq SLOT, %R followed by movq %R, SLOT
                else if (aSrc.len > 0 && aSrc.ptr[0] == '-' &&
                         aDst.len > 0 && aDst.ptr[0] == '%' &&
                         bSrc.len > 0 && bSrc.ptr[0] == '%' &&
                         bDst.len > 0 && bDst.ptr[0] == '-')
                {
                    // Load slot→reg then store reg→same slot.
                    // Removing the store is always safe (slot already has it).
                    if (asmViewEq(aSrc, bDst) && asmViewEq(aDst, bSrc))
                    {
                        lines[i+1].dead = true;
                        changed = true;
                    }
                }
            }
        }
    }

    char* buf = mman.alloc<char>(totalLen + 1);
    u64 wOff = 0;
    for (u32 i = 0; i < nLines; i++)
    {
        if (lines[i].dead) continue;
        for (u32 c = 0; c < lines[i].text.len; c++) buf[wOff++] = lines[i].text.ptr[c];
        buf[wOff++] = '\n';
    }
    buf[wOff] = 0;
    return buf;
}

pub void emitAsm(ast.Program* prog, scopes.Scope* top, scopes.ModuleTable* mods, loader.Loader* ld, str.strView path, u32 optLevel, bool debug, str.strView* flagNames, str.strView* flagVals, u32 nflags, str.strView srcFile)
{
    str.String opath = str.String::new();
    u32 lastDot = 0; bool dot = false;
    for (u32 k = 0; k < path.len; k++)
        if (path.ptr[k] == (u8)'.') { lastDot = k; dot = true; }
    if (dot) opath.pushView(str.strView::fromParts(path.ptr, lastDot));
    else opath.pushView(path);
    opath.pushCstr(".s");
    ir_types.IrContext* ctx = null;
    // srcFile (the .crl being compiled) drives module naming and
    // debugLoc paths; `path` is only the output artifact name.
    str.strView realSrc = srcFile.len > 0 ? srcFile : path;
    ir_types.IrModule* irMod = emitir.buildModule(prog, top, mods, ld, realSrc, optLevel, debug, &ctx);
    // borrowcheck diagnostics when flag enabled
    for (u32 _fi2=0; _fi2<nflags; _fi2++) {
        bool isBorrow2=false; if(flagNames[_fi2].len==11) { const char* b="borrowcheck"; isBorrow2=true; for(u32 k=0;k<11;k++) if(flagNames[_fi2].ptr[k]!= (u8)b[k]) {isBorrow2=false; break;}}
        if(isBorrow2 && flagVals[_fi2].len==1 && flagVals[_fi2].ptr[0]=='1') {
            borrowcheck.BorrowCheckOptions _opts;
            _opts.collect = true;
            _opts.warn = false;
            _opts.reporter = null;
            for(u32 _f2=0; _f2<irMod.nfuncs; _f2++) {
                ir_types.IrFunc* _func = irMod.funcs[_f2];
                borrowcheck.BorrowCheckPass _pass = borrowcheck.BorrowCheckPass::new(ctx, &_opts);
                bool _bad = _pass.run(_func);
                for(u32 _v=0; _v<_pass.violLen && _bad; _v++) {
                    borrowcheck.BorrowViolation* _bv = _pass.violation(_v);
                    str.strView _code = str.strView::fromCstr("TC-BORROW");
                    str.strView _help = str.strView::fromCstr("check for aliasing pointer args or stale live loads across calls; try `coralc --explain TC-BORROW`");
                    u32 _line = 1; u32 _col = 1; const char* _file = _func.base.name ? _func.base.name : "unknown";
                    if (_bv != null) {
                        if (_bv.file != null) { _file = _bv.file; _line = _bv.line; _col = _bv.col; }
                        str.String _m = str.String::new();
                        _m.pushView(str.strView::fromCstr(_bv.message));
                        if (_bv.detail[0] != 0) { _m.pushCstr(" ["); _m.pushCstr(_bv.detail); _m.pushCstr("]"); }
                        error.reportCode(_code, strView::fromCstr(_file), strView::fromParts((const char*)"",0), _line, _col, error.LVL_WARN, _m.asView(), _help);
                        _m.free();
                    }
                }
                if (_bad) {
                    // one summary error per function so nerrors gates artifacts
                    str.strView _code = str.strView::fromCstr("TC-BORROW");
                    str.strView _msg = str.strView::fromCstr("borrow checker violation (see warnings above)");
                    str.strView _help = str.strView::fromCstr("borrow check is diagnostic-only: it reports and never modifies code; try `coralc --explain TC-BORROW`");
                    u32 _line = 1; u32 _col = 1; const char* _file = _func.base.name ? _func.base.name : "unknown";
                    if(_func.nblocks>0 && _func.blocks[0].ninsts>0 && _func.blocks[0].insts[0].debugLoc.file) { _file = _func.blocks[0].insts[0].debugLoc.file; _line = _func.blocks[0].insts[0].debugLoc.line; _col = _func.blocks[0].insts[0].debugLoc.col; }
                    error.reportCode(_code, strView::fromCstr(_file), strView::fromParts((const char*)"",0), _line, _col, error.LVL_ERROR, _msg, _help);
                }
                _pass.deinit();
            }
        }
    }
    // --fbuiltinmap: opt-in native-builtin opcode mapping
    for (u32 _fi3 = 0; _fi3 < nflags; _fi3++)
    {
        bool isBm = false;
        if (flagNames[_fi3].len == 10)
        {
            const char* b = "builtinmap";  
            isBm = true; 
            for (u32 k = 0; k < 10; k++) if (flagNames[_fi3].ptr[k] != (u8)b[k])
                { isBm = false; break; }
        }
        if (isBm && flagVals[_fi3].len == 1 && flagVals[_fi3].ptr[0] == '1') wallvm.gBuiltinMapEnabled = true;
    }
    // --funroll: opt-in loop unrolling
    for (u32 _fi4 = 0; _fi4 < nflags; _fi4++)
    {
        bool isUr = false;
        if (flagNames[_fi4].len == 7)
        {
            const char* b = "unroll";
            isUr = true;
            for (u32 k = 0; k < 7; k++) if (flagNames[_fi4].ptr[k] != (u8)b[k])
                { isUr = false; break; }
        }
        if (isUr && flagVals[_fi4].len == 1 && flagVals[_fi4].ptr[0] == '1') wallvm.gUnrollEnabled = true;
    }
    u32 cc = (u32)asm_rules.CallingConvention::SystemV;
    const char* asmText = wallvm.irCompileAsm(irMod, ctx, (asm_rules.CallingConvention)cc, optLevel);
    void* f = libc.fopen(opath.asCstr(), (const u8*)"wb");
    if (f != null)
    {
        if (asmText != null)
        {
            // // asmText = asmPeephole(asmText);
            u64 n = 0; while (asmText[n]) n++;
            libc.fwrite((u8*)asmText, 1, n, f);
        } else
        {
            const char* msg = "; wallvm irCompileAsm failed\n";
            u64 n = 0; while (msg[n]) n++;
            libc.fwrite((u8*)msg, 1, n, f);
        }
        libc.fclose(f);
        libc.write(1, (const u8*)"wrote ", 6);
        libc.write(1, (const u8*)opath.asCstr(), opath.len);
        libc.write(1, (const u8*)"\n", 1);
    }
    else
    {
        libc.write(2, (const u8*)"coralc: cannot write assembly text file", 41);
    }
    opath.free();
}
