// Expression and statement typing. Coral has NO implicit conversions, so
// every value flows through types.assignable(): identical types only, plus
// integer/float/char literals that fit the context type and the null literal
// for pointer-ish targets. Anything else is an error naming both types —
// never compiled on like C.
//
// Imports are opaque (TY_UNKNOWN) at this stage, so module-qualified names
// and their calls are transparent: strictness is per-file. Within-file
// functions, structs, methods, and consts are fully typed.
mod ast = import("ast/ast.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");
mod error = import("error");
mod types = import("typecheck/types.crl");
mod scopes = import("typecheck/scopes.crl");
mod loader = import("typecheck/loader.crl");
mod subst = import("mono/subst.crl");

pub types.CType* inferredType(ast.Expr* e)
{
    if (e == null) return null;
    return (types.CType*)e->inferredTy;
}
str.strView typerFlagValue(Typer* t, str.strView name)
{
    for (u32 i = 0; i < t->nflags; i++)
        if (scopes.sEq(t->flagNames[i], name)) return t->flagVals[i];
    return str.strView::empty();
}

pub struct Typer
{
    ast.Program* prog;
    str.strView src;
    str.strView curFile;    // file of the fn body being typed (imported modules)
    str.strView filename;
    Scope* top;
    ModuleTable* mods;
    loader.Loader* ld;
    u32* nerrors;
    u32* nwarnings;
    bool noWarnUnsafe;  // file attr @[[no_warn_unsafe]]: demote unsafe warnings
    bool forcedSkip;    // file has forced_* attrs: borrow-check skips
    bool warnUnused;    // unused-local warnings on unless no_warn_unsafe

    // per-function state
    Scope* fnScope;
    types.CType* retType;
    ast.Decl* curFn;
    str.strView* gnames;
    u32 ng;
    bool inComptime;   // inside a `comptime { }` block: if conditions that
                       // resolve to constants are pruned (dead branches erased)
    str.strView* flagNames;
    str.strView* flagVals;
    u32 nflags;

    static Typer new(ast.Program* prog, str.strView src, str.strView filename,
                     Scope* top, ModuleTable* mods, loader.Loader* ld,
                     u32* nerrors, u32* nwarnings,
                     bool noWarnUnsafe, bool forcedSkip)
    {
        Typer t;
        t.prog = prog;
        t.src = src;
        t.filename = filename;
        t.top = top;
        t.mods = mods;
        t.ld = ld;
        t.nerrors = nerrors;
        t.nwarnings = nwarnings;
        t.noWarnUnsafe = noWarnUnsafe;
        t.forcedSkip = forcedSkip;
        t.warnUnused = !noWarnUnsafe;
        t.fnScope = null;
        t.retType = null;
        t.curFn = null;
        t.gnames = null;
        t.flagNames = null;
        t.flagVals = null;
        t.nflags = 0;
        t.ng = 0;
        t.inComptime = false;
        return t;
    }
}

// Resolve the (file, src) pair for diagnostics: when typing a function
// imported from another module, report against THAT module's path and text.
void diagSrc(Typer* t, str.strView* fOut, str.strView* sOut)
{
    if (t->curFile.len > 0 && t->ld != null)
    {
        for (u32 i = 0; i < t->ld.n; i++)
        {
            u32 pl = 0;
            while (t->ld.paths[i][pl] != 0) pl++;
            if (pl == t->curFile.len
                && libc.memcmp((const void*)t->ld.paths[i], (const void*)t->curFile.ptr, pl) == 0)
            {
                *fOut = t->curFile;
                *sOut = str.strView::fromParts((const char*)t->ld.srcs[i], t->ld.srcLens[i]);
                return;
            }
        }
    }
    *fOut = t->filename;
    *sOut = t->src;
}

void errAt(Typer* t, u32 line, u32 col, str.strView code, str.strView msg, str.strView help)
{
    str.strView f; str.strView sc;
    diagSrc(t, &f, &sc);
    error.reportCode(code, f, sc, line, col, error.LVL_ERROR, msg, help);
    (*t->nerrors)++;
}

void warnAt(Typer* t, u32 line, u32 col, str.strView code, str.strView msg, str.strView help)
{
    str.strView f; str.strView sc;
    diagSrc(t, &f, &sc);
    error.reportCode(code, f, sc, line, col, error.LVL_WARN, msg, help);
    (*t->nwarnings)++;
}

bool strEq2(str.strView a, const char* b)
{
    u64 n = 0;
    while (b[n] != 0) n++;
    if (a.len != n) return false;
    return libc.memcmp((const void*)a.ptr, (const void*)b, n) == 0;
}

void pushUInt(str.String* s, u64 v)
{
    u8 buf[24];
    i32 n = libc.snprintf(buf, 24, "%llu", v);
    if (n > 0) s->pushView(str.strView::fromParts((const char*)buf, (u64)n));
}

// error with a composed message
void errComposed(Typer* t, u32 line, u32 col, str.strView code, str.strView* parts, u32 nparts, str.strView help)
{
    str.String msg = str.String::new();
    for (u32 i = 0; i < nparts; i++) msg.pushView(parts[i]);
    errAt(t, line, col, code, str.strView::fromParts(msg.ptr, msg.len), help);
    msg.free();
}

void errTwoStr(Typer* t, u32 line, u32 col, str.strView code, const char* lead, str.strView a, const char* mid, str.strView b, const char* tail, str.strView help)
{
    str.String msg = str.String::new();
    msg.pushView(str.strView::fromCstr(lead));
    msg.pushView(a);
    msg.pushView(str.strView::fromCstr(mid));
    msg.pushView(b);
    msg.pushView(str.strView::fromCstr(tail));
    errAt(t, line, col, code, str.strView::fromParts(msg.ptr, msg.len), help);
    msg.free();
}

types.CType* typeExpr(Typer* t, ast.Expr* e);

types.CType* effective(types.CType* ct)
{
    return types.effective(ct);
}

ast.Decl* namedDecl(types.CType* ct)
{
    if (ct == null) return null;
    if (ct->kind != types.TY_NAMED) return null;
    return ct->decl;
}

// Follow pointer/slice indirections to reach the base type for member lookup.
types.CType* memberBase(types.CType* ot)
{
    types.CType* b = effective(ot);
    while (b != null && (b->kind == types.TY_PTR || b->kind == types.TY_SLICE || b->kind == types.TY_ARRAY))
    {
        b = b->elem;
    }
    return b;
}

types.CType* typeIdent(Typer* t, str.strView name, u32 line, u32 col)
{
    // qualified by :: (Enum::Variant, Struct::method, mod.Name)
    for (u32 i = 0; i + 1 < name.len; i++)
    {
        if (name.ptr[i] == ':' && name.ptr[i + 1] == ':')
        {
            str.strView head = str.strView::fromParts(name.ptr, i);
            str.strView rest = str.strView::fromParts(name.ptr + i + 2, name.len - i - 2);
            Sym* s = scopes.scopeLookup(t->top, head);
            if (scopes.modsLookup(t->mods, head))
            {
                return scopes.opaqueType(name, line, col);
            }
            if (s != null && s->kind == scopes.SYM_ENUM)
            {
                // enum variant reference -> enum type
                scopes.symMarkUsed(s);
                return scopes.symTypeFromName(s, head, line, col);
            }
            if (s != null && (s->kind == scopes.SYM_STRUCT || s->kind == scopes.SYM_TRAIT)
                && s->decl != null)
            {
                // struct/trait static or trait method reference
                ast.Decl* m = scopes.findMethod(s->decl, t->prog, rest);
                if (m != null) return fnSig(t, m);
                return scopes.opaqueType(name, line, col);
            }
            return scopes.opaqueType(name, line, col);
        }
    }

    Sym* s = scopes.scopeLookup(t->fnScope != null ? t->fnScope : t->top, name);
    if (s == null) s = scopes.scopeLookup(t->top, name);
    if (s == null)
    {
        // generic type parameter of the enclosing struct, used as a value
        // (e.g. `N` in `u64 capacity() { return N; }`, or `T` in a cast)
        if (t->curFn != null && t->curFn->structName.len > 0)
        {
            ast.Decl* sd = findNamedStruct(t, t->curFn->structName);
            if (sd != null && scopes.isGenericParam(sd->generics, sd->ngenerics, name))
            {
                return scopes.opaqueType(name, line, col);
            }
        }
        {
            u64 cvq = 0;
            if (!subst.lookupConst(name, &cvq))
                errTwoStr(t, line, col, "TC-RESOLVE", "unresolved name '", name, "'", str.strView::empty(), "", str.strView::fromCstr("declare it, check spelling, or import the defining module"));
            return scopes.opaqueType(name, line, col);
        }
    }
    scopes.symMarkUsed(s);
    if (s->type != null)
    {
        if (s->kind == scopes.SYM_FUNC)
        {
            return fnSig(t, s->decl);
        }
        if (s->kind == scopes.SYM_STRUCT || s->kind == scopes.SYM_ENUM
            || s->kind == scopes.SYM_TYPEDEF || s->kind == scopes.SYM_DISTINCT
            || s->kind == scopes.SYM_TRAIT)
        {
            return scopes.symTypeFromName(s, name, line, col);
        }
        return s->type;
    }
    return scopes.opaqueType(name, line, col);
}

// Build the FUNC signature type for a function/method decl, resolving param
// and return types in the decl's own generic context.
types.CType* fnSig(Typer* t, ast.Decl* d)
{
    if (d == null) return null;
    types.CType* sig = mman.alloc<types.CType>(1);
    sig->kind = types.TY_FUNC;
    sig->nparams = d->nparams;
    sig->variadic = d->variadic;
    if (d->nparams > 0)
    {
        sig->params = mman.alloc<types.CType*>(d->nparams);
        for (u32 i = 0; i < d->nparams; i++)
        {
            ast.Param p = d->params[i];
            types.CType* pt = p.type != null
                ? scopes.resolveTypeExpr(p.type, t->top, t->mods, d->generics, d->ngenerics)
                : scopes.opaqueType(str.strView::empty(), 0, 0);
            sig->params[i] = p.type != null ? retryTypeViaLoader(t, p.type, pt) : pt;
        }
    }
    types.CType* rt = d->type != null
        ? scopes.resolveTypeExpr(d->type, t->top, t->mods, d->generics, d->ngenerics)
        : scopes.opaqueType(str.strView::empty(), 0, 0);
    sig->ret = d->type != null ? retryTypeViaLoader(t, d->type, rt) : rt;
    return sig;
}

void checkArgs(Typer* t, ast.Expr* call, types.CType* sig, bool hasGeneric)
{
    checkArgsFrom(t, call, sig, false, false, hasGeneric);
}

// checkArgsFrom: verify `call` against `sig` for member calls.
// `slotPresent`: the callee declares an explicit self slot (self*/self/unnamed
// first param) supplied by the receiver - one param is never written.
// `selfDropped`: caller wrote a redundant leading `self` (receiver is self,
// no slot to absorb it) - it is dropped from the counted args.
void checkArgsFrom(Typer* t, ast.Expr* call, types.CType* sig, bool slotPresent, bool selfDropped, bool hasGeneric)
{
    u32 np = sig != null ? sig->nparams : 0;
    bool variadic = sig != null && sig->variadic;
    u32 written = call->nargs - (selfDropped ? 1u : 0u);
    u32 expected = np - (slotPresent ? 1u : 0u);
    if (!variadic && written != expected)
    {
        str.String msg = str.String::new();
        msg.pushView(str.strView::fromCstr("expected "));
        pushUInt(&msg, expected);
        msg.pushView(str.strView::fromCstr(expected == 1 ? " argument, found " : " arguments, found "));
        pushUInt(&msg, written);
        errAt(t, call->line, call->col, "TC-ARGS", str.strView::fromParts(msg.ptr, msg.len), str.strView::fromCstr("adjust the call to match the callee's parameter list"));
        msg.free();
        return;
    }
    if (hasGeneric) return; // generic callee: arity checked above
    for (u32 i = 0; i < call->nargs; i++)
    {
        if (selfDropped && i == 0) continue;
        u32 pi = i + (slotPresent ? 1u : 0u) - (selfDropped ? 1u : 0u);
        if (pi >= np) continue; // variadic tail
        types.CType* pt = sig->params[pi];
        types.CType* at = typeExpr(t, call->args[i]);
        if (at == null || pt == null) continue;
        // [[nonull]] enforcement: null literal passed to non-null param
        if (call->args[i]->kind == ast.EX_NULL || (call->args[i]->kind == ast.EX_INT && call->args[i]->text.len==1 && call->args[i]->text.ptr[0]=='0')) {
            // lookup callee decl to check nonull
            if (call->a != null && call->a->kind == ast.EX_IDENT) {
                scopes.Sym* cs = scopes.scopeLookup(t->fnScope ? t->fnScope : t->top, call->a->text);
                if (cs == null) cs = scopes.scopeLookup(t->top, call->a->text);
                if (cs != null && cs->decl != null && pi < cs->decl->nparams && cs->decl->params[pi].nonull) {
                    errAt(t, call->args[i]->line, call->args[i]->col, "TC-NONULL", str.strView::fromCstr("null passed to [[nonull]] parameter"), str.strView::fromCstr("remove null or remove [[nonull]]; add a null check before the call"));
                    continue;
                }
            }
        }
        if (!types.assignable(pt, at, call->args[i]->kind, call->args[i]->text)
            && !types.constFitsExpr(call->args[i], pt))
        {
            str.String msg = str.String::new();
            msg.pushView(str.strView::fromCstr("argument "));
            pushUInt(&msg, i + 1);
            msg.pushView(str.strView::fromCstr(" has type '"));
            msg.pushView(types.typeName(at));
            msg.pushView(str.strView::fromCstr("', expected '"));
            msg.pushView(types.typeName(pt));
            msg.pushView(str.strView::fromCstr("' (no implicit conversion)"));
            errAt(t, call->args[i]->line, call->args[i]->col, "TC-ARGS", str.strView::fromParts(msg.ptr, msg.len), str.strView::fromCstr("adjust the call to match the callee's parameter list"));
            msg.free();
        }
    }
}

void typeArgsOnce(Typer* t, ast.Expr* call)
{
    for (u32 i = 0; i < call->nargs; i++) typeExpr(t, call->args[i]);
}

// C intrinsic functions (handled by codegen): poison params, C return types.
types.CType* cBuiltin(str.strView name)
{
    u32 np = 0xFFFFFFFFu;
    u32 rk = types.TY_UNKNOWN;
    u32 wd = 0;
    bool sg = false;
    if (strEq2(name, "memcpy") || strEq2(name, "memmove") || strEq2(name, "memset")) np = 3;
    else if (strEq2(name, "memcmp")) { np = 3; rk = types.TY_INT; wd = 32; sg = true; }
    else if (strEq2(name, "strlen")) { np = 1; rk = types.TY_INT; wd = 64; sg = false; }
    else if (strEq2(name, "bswap16") || strEq2(name, "bswapU16")) { np = 1; rk = types.TY_INT; wd = 16; sg = false; }
    else if (strEq2(name, "bswap32") || strEq2(name, "bswapU32")) { np = 1; rk = types.TY_INT; wd = 32; sg = false; }
    else if (strEq2(name, "bswap64") || strEq2(name, "bswapU64") || strEq2(name, "bswap")) { np = 1; rk = types.TY_INT; wd = 64; sg = false; }
    else if (strEq2(name, "sqrt") || strEq2(name, "sin") || strEq2(name, "cos") || strEq2(name, "tan")
             || strEq2(name, "__builtin_sqrt")) { np = 1; rk = types.TY_FLOAT; wd = 64; }
    else if (strEq2(name, "__builtin_ctzll") || strEq2(name, "__builtin_clzll")) { np = 1; rk = types.TY_INT; wd = 32; sg = true; }
    if (np == 0xFFFFFFFFu) return null;
    types.CType* sig = mman.alloc<types.CType>(1);
    sig->kind = types.TY_FUNC;
    sig->nparams = np;
    sig->variadic = false;
    sig->params = mman.alloc<types.CType*>(np > 0 ? np : 1);
    for (u32 i = 0; i < np; i++) sig->params[i] = scopes.opaqueType(str.strView::empty(), 0, 0);
    types.CType* ret = mman.alloc<types.CType>(1);
    ret->kind = rk;
    ret->width = wd;
    ret->isSigned = sg;
    sig->ret = ret;
    return sig;
}

// Resolve a member of an imported module to its Decl, or null if absent.
// `full` is the dotted path "alias.member"; the member is the final segment.
// Single str.strView argument to avoid the compiler's two-str.strView-arg bug.
ast.Decl* moduleMemberDecl(Typer* t, str.strView full)
{
    u32 lastDot = 0;
    bool hasDot = false;
    for (u32 i = 0; i < full.len; i++)
        if (full.ptr[i] == '.') { lastDot = i; hasDot = true; }
    str.strView alias = full;
    str.strView member = str.strView::empty();
    if (hasDot)
    {
        alias = str.strView::fromParts(full.ptr, lastDot);
        member = str.strView::fromParts(full.ptr + lastDot + 1, full.len - lastDot - 1);
    }
    str.strView path = scopes.modsPath(t->mods, alias);
    if (path.len == 0) return null;
    ast.Program* p = loader.loaderGet(t->ld, path.ptr, path.len);
    if (p == null) return null;
    for (u32 i = 0; i < p->ndecls; i++)
    {
        ast.Decl* d = p->decls[i];
        if (d != null && scopes.sEq(d->name, member)) return d;
    }
    return null;
}

// Flatten a module-path expression (std.wallvm.ir_types) into its dotted
// string. Returns false unless `e` is a pure chain of idents joined by dots.
bool flattenModPath(ast.Expr* e, str.String* out)
{
    if (e->kind == ast.EX_IDENT)
    {
        out->pushView(e->text);
        return true;
    }
    if (e->kind == ast.EX_DOT)
    {
        if (!flattenModPath(e->a, out)) return false;
        out->pushChar('.');
        out->pushView(e->text);
        return true;
    }
    return false;
}

// Enforce `pub` visibility on cross-module member access: a name not declared
// `pub` in the imported module must not be reachable via `mod.name`.
//
// Takes a single `full` dotted path (e.g. "wallvm.ir_types.nope"); the member
// is the final segment and the module alias is everything before the last dot.
// A single str.strView argument is used deliberately: the Coral compiler
// miscompiles calls that pass two str.strView values derived from the same
// base pointer, corrupting the arguments.
void checkModuleAccess(Typer* t, str.strView full, u32 line, u32 col)
{
    u32 lastDot = 0;
    bool hasDot = false;
    for (u32 i = 0; i < full.len; i++)
        if (full.ptr[i] == '.') { lastDot = i; hasDot = true; }
    str.strView alias = full;
    str.strView member = str.strView::empty();
    if (hasDot)
    {
        alias = str.strView::fromParts(full.ptr, lastDot);
        member = str.strView::fromParts(full.ptr + lastDot + 1, full.len - lastDot - 1);
    }
    if (!scopes.modsLookup(t->mods, alias)) return;
    ast.Decl* d = moduleMemberDecl(t, full);
    if (d == null)
    {
        errTwoStr(t, line, col, "TC-ACCESS", "module '", alias,
                  "' has no member '", member,
                  "'", str.strView::empty());
        return;
    }
    if (!d->exported)
    {
        errTwoStr(t, line, col, "TC-ACCESS", "member '", member,
                  "' of module '", alias,
                  "' is private (not declared pub)", str.strView::empty());
    }
}

// Record a concrete instantiation of generic function `g` if `callee` carries
// a full set of concrete type arguments. Used by the monomorphisation pass
// (mono/mono.crl) to discover which specializations must be emitted. Abstract
// type args (still generic parameters in the current context) are deferred.
void tryRecordGeneric(Typer* t, ast.Decl* g, ast.Expr* callee)
{
    if (g == null || g->ngenerics == 0) return;
    
    // Comptime variadic: fn<T...>(args...) — caller never passes type args.
    // Infer the pack from actual argument types at each call site.
    bool isVariadic = g->variadic && g->nparams > 0;
    if (isVariadic && callee->ntargs == 0)
    {
        // Record with a single opaque type arg representing the pack.
        // The mono pass will re-type the body which handles `for var arg : args`.
        types.CType** resolvedV = mman.alloc<types.CType*>(1);
        resolvedV[0] = mman.alloc<types.CType>(1);
        resolvedV[0].kind = types.TY_UNKNOWN;
        resolvedV[0].name = str.strView.fromCstr("...variadic");
        u64* noConsts = mman.alloc<u64>(1);
        str.String mnv = str.String.new();
        mnv.pushView(g.name);
        mnv.pushChar('<');
        mnv.pushView(str.strView.fromCstr("...variadic"));
        mnv.pushChar('>');
        char* pmnv = (char*)mman.alloc<char>(mnv.len + 1);
        libc.memcpy(pmnv, mnv.ptr, mnv.len);
        pmnv[mnv.len] = 0;
        subst.record2(g, resolvedV, 1,
                      str.strView.fromParts(pmnv, mnv.len), noConsts, 0);
        mnv.free();
        return;
    }
    
    // Generic args arrive positionally in callee->targs; entries whose
    // spelling is an integer literal are const params (arr<u64, 3>).
    if (callee->ntargs == 0 || callee->ntargs > g->ngenerics) return;
    types.CType** resolved = mman.alloc<types.CType*>(g->ngenerics);
    u64* cvals = mman.alloc<u64>(g->ngenerics);
    u32 nTypeArgs = 0;
    u32 nConstArgs = 0;
    bool ok = true;
    for (u32 ti = 0; ti < callee->ntargs; ti++)
    {
        ast.TypeExpr* te2 = callee->targs[ti];
        bool isInt = te2 != null && te2.kind == ast.TYP_IDENT && te2.name.len > 0;
        if (isInt)
        {
            for (u32 k = 0; k < te2.name.len; k++)
                if (te2.name.ptr[k] < '0' || te2.name.ptr[k] > '9') { isInt = false; break; }
        }
        if (isInt)
        {
            u64 mag = 0; bool ln2 = true; u32 fw2 = 0; bool un2 = false;
            if (!types.literalIntInfo(te2.name, &mag, &ln2, &fw2, &un2)) { ok = false; break; }
            cvals[nConstArgs++] = mag;
            continue;
        }
        types.CType* rt = scopes.resolveTypeExpr(te2, t->top, t->mods, t->gnames, t->ng);
        if (rt == null) { ok = false; break; }
        if (rt->kind == types.TY_UNKNOWN && scopes.isGenericParam(t->gnames, t->ng, rt->name))
        {
            ok = false; break;
        }
        resolved[nTypeArgs++] = rt;
    }
    if (!ok || nTypeArgs + nConstArgs != g->ngenerics) return;
    if (ok)
    {
        str.String mn = str.String::new();
        mn.pushView(g->name);
        mn.pushChar('<');
        for (u32 ti = 0; ti < nTypeArgs; ti++)
        {
            if (ti > 0) mn.pushChar(',');
            mn.pushView(types.typeName(resolved[ti]));
        }
        for (u32 ci = 0; ci < nConstArgs; ci++)
        {
            if (nTypeArgs + ci > 0) mn.pushChar(',');
            char b[24];
            i32 n2 = libc.snprintf(b, 24, "%llu", cvals[ci]);
            for (i32 k2 = 0; k2 < n2; k2++) mn.pushChar(b[k2]);
        }
        mn.pushChar('>');
        subst.record2(g, resolved, nTypeArgs,
                      str.strView::fromParts(mn.ptr, mn.len), cvals, nConstArgs);
        mn.free();
    }
    else
    {
        mman.dealloc<types.CType*>(resolved);
    }
}

types.CType* typeCall(Typer* t, ast.Expr* callee, ast.Expr* call)
{
    // module-qualified function call: mod.fn(...) -> opaque result
    if (callee->kind == ast.EX_DOT)
    {
        ast.Expr* obj = callee->a;
        while (obj != null && obj->kind == ast.EX_PAREN) obj = obj->a;
        if (obj != null && (obj->kind == ast.EX_IDENT || obj->kind == ast.EX_DOT))
        {
                str.String mp = str.String::new();
                if (flattenModPath(obj, &mp))
                {
                u32 dot = 0;
                while (dot < mp.len && mp.ptr[dot] != '.') dot++;
                str.strView first = str.strView::fromParts(mp.ptr, dot);
                Sym* so = scopes.scopeLookup(t->top, first);
                if (so != null && so->kind == scopes.SYM_MODULE
                    && scopes.modsLookup(t->mods, str.strView::fromParts(mp.ptr, mp.len)))
                {
                    str.String comb = str.String::new();
                    comb.pushView(str.strView::fromParts(mp.ptr, mp.len));
                    comb.pushChar('.');
                    comb.pushView(callee->text);
                    checkModuleAccess(t, str.strView::fromParts(comb.ptr, comb.len), call->line, call->col);
                    // comptime-variadic module function (println<T...>): the
                    // caller never writes type args, so infer/record the
                    // instantiation right here — otherwise mono never sees it.
                    ast.Decl* mdecl = moduleMemberDecl(t, str.strView::fromParts(comb.ptr, comb.len));
                    comb.free();
                    if (mdecl != null && mdecl->kind == ast.DT_FUNC
                        && mdecl->body != null && mdecl->variadic
                        && mdecl->nparams > 0)
                    {
                        scopes.Sym* mf = scopes.scopeLookup(t->top, callee->text);
                        if (mf != null) scopes.symMarkUsed(mf);
                        types.CType* msig = fnSig(t, mdecl);
                        checkArgs(t, call, msig, true);
                        tryRecordGeneric(t, mdecl, call);
                        mp.free();
                        return msig->ret;
                    }
                    typeArgsOnce(t, call);
                    mp.free();
                    return scopes.opaqueType(callee->text, call->line, call->col);
                }
                mp.free();
            }
        }
    }

    // method call: obj.method(args) or self.method(args)
    if (callee.kind == ast.EX_DOT || callee.kind == ast.EX_ARROW || callee.kind == ast.EX_GENERIC)
    {
        types.CType* ot = typeExpr(t, callee->a);
        str.strView mname = callee->text;
        types.CType* mb = memberBase(ot);
        ast.Decl* structDecl = mb != null && mb->kind == types.TY_NAMED ? mb->decl : null;
        // Opaque dotted-generic receivers (std.collections.arr.arr<u64, 3>):
        // recover the generic struct from the loader by last display segment
        // and record the instantiation so codegen can emit it.
        if (structDecl == null && ot != null && ot->kind == types.TY_UNKNOWN
            && ot->name.len > 0)
        {
            u32 lt3 = 0; bool hasLt3 = false;
            for (u32 i = 0; i < ot->name.len; i++)
                if (ot->name.ptr[i] == '<') { lt3 = i; hasLt3 = true; break; }
            if (hasLt3 && ot->name.ptr[ot->name.len - 1] == '>')
            {
                str.strView head = str.strView::fromParts(ot->name.ptr, lt3);
                str.strView inner = str.strView::fromParts(
                    ot->name.ptr + lt3 + 1, ot->name.len - lt3 - 2);
                u32 ls3 = 0;
                for (u32 i = 0; i < head.len; i++) if (head.ptr[i] == '.') ls3 = i + 1;
                str.strView lastName = str.strView::fromParts(head.ptr + ls3, head.len - ls3);
                if (t->ld != null)
                {
                    for (u32 pi4 = 0; pi4 < t->ld.n; pi4++)
                    {
                        ast.Program* pp = t->ld.progs[pi4];
                        if (pp == null) continue;
                        bool found4 = false;
                        for (u32 di4 = 0; di4 < pp.ndecls; di4++)
                        {
                            ast.Decl* cd3 = pp.decls[di4];
                            if (cd3 != null && cd3.kind == ast.DT_STRUCT
                                && scopes.sEq(cd3.name, lastName))
                            {
                                structDecl = cd3;
                                found4 = true;
                                break;
                            }
                        }
                        if (!found4) continue;
                        // split inner on ',' into type vs const parts
                        str.strView parts[16];
                        u32 nparts = 0;
                        u32 start4 = 0;
                        for (u32 k = 0; k <= inner.len; k++)
                        {
                            if (k == inner.len || inner.ptr[k] == ',')
                            {
                                parts[nparts++] = str.strView::fromParts(inner.ptr + start4, k - start4);
                                start4 = k + 1;
                            }
                        }
                        if (nparts == structDecl.ngenerics && nparts <= 16)
                        {
                            types.CType** rtys = mman.alloc<types.CType*>(nparts);
                            u64* cvs = mman.alloc<u64>(nparts);
                            u32 nty = 0; u32 ncv = 0;
                            bool ok5 = true;
                            for (u32 k = 0; k < nparts; k++)
                            {
                                str.strView pv = parts[k];
                                while (pv.len > 0 && pv.ptr[0] == ' ') { pv.ptr++; pv.len--; }
                                while (pv.len > 0 && pv.ptr[pv.len-1] == ' ') pv.len--;
                                bool digits = pv.len > 0;
                                for (u32 c2 = 0; c2 < pv.len; c2++)
                                    if (pv.ptr[c2] < '0' || pv.ptr[c2] > '9') { digits = false; break; }
                                if (digits)
                                {
                                    u64 mag6 = 0;
                                    for (u32 c2 = 0; c2 < pv.len; c2++) mag6 = mag6 * 10 + (u64)(pv.ptr[c2] - '0');
                                    cvs[ncv++] = mag6;
                                }
                                else
                                {
                                    types.CType* pr6 = mman.alloc<types.CType>(1);
                                    if (types.primType(pv, pr6)) rtys[nty++] = pr6;
                                    else { ok5 = false; break; }
                                }
                            }

                            if (ok5 && nty + ncv == structDecl.ngenerics)
                            {
                                str.String mn7 = str.String::new();
                                mn7.pushView(structDecl.name);
                                mn7.pushChar('<');
                                mn7.pushView(inner);
                                mn7.pushChar('>');
                                char* pmn = (char*)mman.alloc<char>(mn7.len + 1);
                                libc.memcpy(pmn, mn7.ptr, mn7.len);
                                pmn[mn7.len] = 0;
                                // record every method of this generic struct
                                for (u32 mi7 = 0; mi7 < structDecl.ndecls; mi7++)
                                {
                                    ast.Decl* md7 = structDecl.decls[mi7];
                                    if (md7 == null || md7.kind != ast.DT_FUNC) continue;
                                    str.String mn8 = str.String::new();
                                    mn8.pushView(md7.name);
                                    mn8.pushChar('<');
                                    mn8.pushView(inner);
                                    mn8.pushChar('>');
                                    char* pmn8 = (char*)mman.alloc<char>(mn8.len + 1);
                                    libc.memcpy(pmn8, mn8.ptr, mn8.len);
                                    pmn8[mn8.len] = 0;
                                    subst.record2(md7, rtys, nty,
                                                  str.strView::fromParts(pmn8, mn8.len),
                                                  cvs, ncv);
                                    mn8.free();
                                }
                                for (u32 bi7 = 0; bi7 < pp.ndecls; bi7++)
                                {
                                    ast.Decl* bd7 = pp.decls[bi7];
                                    if (bd7 == null || bd7.kind != ast.DT_METHODBLOCK) continue;
                                    if (!scopes.sEq(bd7.structName, lastName)) continue;
                                    for (u32 mi7 = 0; mi7 < bd7.ndecls; mi7++)
                                    {
                                        ast.Decl* md7 = bd7.decls[mi7];
                                        if (md7 == null || md7.kind != ast.DT_FUNC) continue;
                                        str.String mn8 = str.String::new();
                                        mn8.pushView(md7.name);
                                        mn8.pushChar('<');
                                        mn8.pushView(inner);
                                        mn8.pushChar('>');
                                        char* pmn8 = (char*)mman.alloc<char>(mn8.len + 1);
                                        libc.memcpy(pmn8, mn8.ptr, mn8.len);
                                        pmn8[mn8.len] = 0;
                                        subst.record2(md7, rtys, nty,
                                                      str.strView::fromParts(pmn8, mn8.len),
                                                      cvs, ncv);
                                        mn8.free();
                                    }
                                }
                            }
                        }
                        break;
                    }
                }
            }
        }
        if (structDecl != null && structDecl.kind == ast.DT_STRUCT
            && structDecl.ngenerics > 0 && mb != null && mb.name.len > 0)
        {
            u32 lt9 = 0; bool hasLt9 = false;
            for (u32 i = 0; i < mb.name.len; i++)
                if (mb.name.ptr[i] == '<') { lt9 = i; hasLt9 = true; break; }
            if (hasLt9 && mb.name.ptr[mb.name.len - 1] == '>')
                recordMethodsForGenericStruct(t, structDecl,
                    str.strView::fromParts(mb.name.ptr + lt9 + 1, mb.name.len - lt9 - 2),
                    t.prog);
        }
        ast.Decl* m = scopes.findMethod(structDecl, t->prog, mname);
        if (m == null && structDecl == null)
        {
            // enum methods or opaque receivers
        }
        if (m != null)
        {
            types.CType* sig = fnSig(t, m);
            bool slot = !m->isStatic && m->nparams > 0;
            if (slot) {
                ast.Param p0 = m->params[0];
                slot = p0.type != null
                    && (p0.name.len == 0
                        || strEq2(p0.name, "self")
                        || scopes.isSelfTypeNode(p0.type));
            }
            if (!slot)
            {
                // a redundant leading `self` is dropped when the receiver is
                // self itself (sibling mere call); no slot to absorb it
                ast.Expr* obj = callee->a;
                while (obj != null && obj->kind == ast.EX_PAREN) obj = obj->a;
                bool receiverIsSelf = obj != null && obj->kind == ast.EX_IDENT
                    && strEq2(obj->text, "self");
                bool selfDropped = receiverIsSelf && call->nargs > 0
                    && call->args[0]->kind == ast.EX_IDENT
                    && strEq2(call->args[0]->text, "self");
                checkArgsFrom(t, call, sig, false, selfDropped, m->ngenerics > 0);
            }
            else
            {
                // the slot is always supplied by the receiver: either written
                // as a leading `self` (fills it) or injected
                ast.Expr* obj = callee->a;
                while (obj != null && obj->kind == ast.EX_PAREN) obj = obj->a;
                bool receiverIsSelf = obj != null && obj->kind == ast.EX_IDENT
                    && strEq2(obj->text, "self");
                bool selfWritten = receiverIsSelf && call->nargs > 0
                    && call->args[0]->kind == ast.EX_IDENT
                    && strEq2(call->args[0]->text, "self");
                checkArgsFrom(t, call, sig, true, selfWritten, m->ngenerics > 0);
            }
            return sig->ret;
        }
        typeArgsOnce(t, call);
        return scopes.opaqueType(mname, call->line, call->col);
    }

    // generic call: fn<T>(...) (or cast<T>(x))
    if (callee->kind == ast.EX_GENERIC)
    {
        ast.Expr* base = callee->a;
        if (base != null && base->kind == ast.EX_DOT)
        {
            // module-qualified generic call: mod.fn<T>(...) — resolves against
            // this file's own top scope (the file's own module name or an
            // in-scope module whose members live in this program)
            ast.Expr* bobj = base->a;
            while (bobj != null && bobj->kind == ast.EX_PAREN) bobj = bobj->a;
            if (bobj != null && (bobj->kind == ast.EX_IDENT || bobj->kind == ast.EX_DOT))
            {
                    str.String mp = str.String::new();
                    if (flattenModPath(bobj, &mp))
                    {
                        u32 dot = 0;
                        while (dot < mp.len && mp.ptr[dot] != '.') dot++;
                        str.strView first = str.strView::fromParts(mp.ptr, dot);
                        Sym* bom = scopes.scopeLookup(t->top, first);
                        if (bom != null && (bom->kind == scopes.SYM_MODULE || bom->kind == scopes.SYM_NS)
                            && scopes.modsLookup(t->mods, str.strView::fromParts(mp.ptr, mp.len)))
                        {
                            str.String comb = str.String::new();
                            comb.pushView(str.strView::fromParts(mp.ptr, mp.len));
                            comb.pushChar('.');
                            comb.pushView(base->text);
                            checkModuleAccess(t, str.strView::fromParts(comb.ptr, comb.len), call->line, call->col);
                            comb.free();
                            Sym* mf = scopes.scopeLookup(t->top, base->text);
                            if (mf != null && mf->kind == scopes.SYM_FUNC)
                            {
                            scopes.symMarkUsed(mf);
                            types.CType* msig = fnSig(t, mf->decl);
                            checkArgs(t, call, msig, mf->decl->ngenerics > 0);
                            tryRecordGeneric(t, mf->decl, callee);
                            mp.free();
                            return msig->ret;
                        }
                    }
                    mp.free();
                }
            }
            typeArgsOnce(t, call);
            return scopes.opaqueType(str.strView::empty(), call->line, call->col);
        }
        if (base != null && base->kind == ast.EX_IDENT && strEq2(base->text, "cast"))
        {
            typeArgsOnce(t, call);
            if (callee->ntargs > 0)
            {
                types.CType* ct = scopes.resolveTypeExpr(callee->targs[0], t->top, t->mods, t->gnames, t->ng);
                return ct != null ? ct : scopes.opaqueType(str.strView::empty(), call->line, call->col);
            }
            return scopes.opaqueType(str.strView::empty(), call->line, call->col);
        }
        if (base != null && base->kind == ast.EX_IDENT)
        {
            Sym* s = scopes.scopeLookup(t->fnScope != null ? t->fnScope : t->top, base->text);
            if (s == null) s = scopes.scopeLookup(t->top, base->text);
            if (s != null && s->kind == scopes.SYM_FUNC)
            {
                scopes.symMarkUsed(s);
                types.CType* sig = fnSig(t, s->decl);
                checkArgs(t, call, sig, s->decl->ngenerics > 0);
                tryRecordGeneric(t, s->decl, callee);
                return sig->ret;
            }
            if (s != null)
            {
                scopes.symMarkUsed(s);
            }
            // generic struct instantiation or unknown -> opaque arg typing
            typeArgsOnce(t, call);
            return scopes.opaqueType(str.strView::empty(), call->line, call->col);
        }
        typeArgsOnce(t, call);
        return scopes.opaqueType(str.strView::empty(), call->line, call->col);
    }

    // plain identifier call
    if (callee->kind == ast.EX_IDENT)
    {
        // qualified static call: Struct::method(...) / Enum::variant(...)
        str.strView cname = callee->text;
        for (u32 i = 0; i + 1 < cname.len; i++)
        {
            if (cname.ptr[i] == ':' && cname.ptr[i + 1] == ':')
            {
                str.strView head = str.strView::fromParts(cname.ptr, i);
                str.strView rest = str.strView::fromParts(cname.ptr + i + 2, cname.len - i - 2);
                Sym* hs = scopes.scopeLookup(t->top, head);
                if (hs != null && hs->decl != null)
                {
                    scopes.symMarkUsed(hs);
                    if (hs->kind == scopes.SYM_STRUCT || hs->kind == scopes.SYM_TRAIT)
                    {
                        ast.Decl* m = scopes.findMethod(hs->decl, t->prog, rest);
                        if (m != null)
                        {
                            types.CType* msig = fnSig(t, m);
                            checkArgs(t, call, msig, m->ngenerics > 0);
                            tryRecordGeneric(t, m, callee);
                            return msig->ret;
                        }
                    }
                    else if (hs->kind == scopes.SYM_ENUM)
                    {
                        for (u32 k = 0; k < hs->decl->nvariants; k++)
                        {
                            if (scopes.sEq(hs->decl->variants[k].name, rest))
                            {
                                typeArgsOnce(t, call);
                                return scopes.symTypeFromName(hs, head, callee->line, callee->col);
                            }
                        }
                    }
                }
                // the head struct may live in another file of this program:
                // search the program's loaded modules, no hardcoded tables
                ast.Program* powner = t->prog;
                ast.Decl* psd = findStructInProgram(t, head, &powner);
                if (psd != null)
                {
                    ast.Decl* pm = scopes.findMethod(psd, powner, rest);
                    if (pm != null)
                    {
                        types.CType* pmsig = fnSig(t, pm);
                        checkArgs(t, call, pmsig, pm->ngenerics > 0);
                        tryRecordGeneric(t, pm, callee);
                        return pmsig->ret;
                    }
                }
                errTwoStr(t, callee->line, callee->col, "TC-MEMBER", "no such static member '", callee->text, "'", str.strView::empty(), "", str.strView::fromCstr("check the struct/enum definition for available members"));
                typeArgsOnce(t, call);
                return scopes.opaqueType(str.strView::empty(), call->line, call->col);
            }
        }
        Sym* s = scopes.scopeLookup(t->fnScope != null ? t->fnScope : t->top, callee->text);
        if (s == null) s = scopes.scopeLookup(t->top, callee->text);
        if (s != null)
        {
            scopes.symMarkUsed(s);
            if (s->kind == scopes.SYM_FUNC)
            {
                types.CType* sig = fnSig(t, s->decl);
                checkArgs(t, call, sig, s->decl->ngenerics > 0);
                return sig->ret;
            }
            if (s->type != null && s->type->kind == types.TY_FUNC)
            {
                checkArgs(t, call, s->type, false);
                return s->type->ret;
            }
        }
        else
        {
            // generic parameter used as a default constructor: `T()` yields a
            // default value of the (still-opaque) generic type.
            if (callee->kind == ast.EX_IDENT
                && scopes.isGenericParam(t->gnames, t->ng, callee->text)
                && call->nargs == 0)
            {
                typeArgsOnce(t, call);
                return scopes.opaqueType(callee->text, callee->line, callee->col);
            }
            // builtin compile-time helpers (handled in codegen, not declared)
            if (scopes.sEq(callee->text, "alignof"))
            {
                types.CType* st = mman.alloc<types.CType>(1);
                st->kind = types.TY_INT;
                st->width = 64;
                st->isSigned = false;
                // alignof's operand is a TYPE: it may reference a generic
                // parameter (e.g. `alignof(T)` inside a generic function), so
                // resolve it as a type rather than typechecking it as a value.
                if (call->nargs > 0 && call->args[0] != null
                    && call->args[0]->kind == ast.EX_IDENT)
                {
                    ast.TypeExpr te;
                    te.kind = types.TY_NAMED;
                    te.name = call->args[0]->text;
                    te.elem = null; te.count = null;
                    te.args = null; te.nargs = 0; te.cargs = null; te.ncargs = 0;
                    te.ret = null; te.isConst = false;
                    te.line = call->args[0]->line; te.col = call->args[0]->col;
                    types.CType* rt = scopes.resolveTypeExpr(&te, t->top, t->mods,
                                                             t->gnames, t->ng);
                    (void)rt;
                }
                else
                    typeArgsOnce(t, call);
                return st;
            }
            if (scopes.sEq(callee->text, "offsetof"))
            {
                types.CType* st = mman.alloc<types.CType>(1);
                st->kind = types.TY_INT;
                st->width = 64;
                st->isSigned = false;
                typeArgsOnce(t, call);
                return st;
            }
            // unqualified call to a sibling method of the current struct
            if (t->curFn != null && t->curFn->structName.len > 0)
            {
                ast.Decl* sd = findNamedStruct(t, t->curFn->structName);
                ast.Decl* sm = sd != null ? scopes.findMethod(sd, t->prog, callee->text) : null;
                if (sm != null)
                {
                    types.CType* ssig = fnSig(t, sm);
                    checkArgs(t, call, ssig, sm->ngenerics > 0);
                    tryRecordGeneric(t, sm, callee);
                    return ssig->ret;
                }
            }
            types.CType* bsig = cBuiltin(callee->text);
            if (bsig != null)
            {
                checkArgs(t, call, bsig, false);
                return bsig->ret;
            }
            errTwoStr(t, callee->line, callee->col, "TC-RESOLVE", "unresolved callee '", callee->text, "'", str.strView::empty(), "", str.strView::fromCstr("declare it, check spelling, or import the defining module"));
        }
        typeArgsOnce(t, call);
        return scopes.opaqueType(str.strView::empty(), call->line, call->col);
    }

    // indirect call through an expression of function-pointer type
    types.CType* sig = typeExpr(t, callee);
    if (sig != null && sig->kind == types.TY_FUNC)
    {
        checkArgs(t, call, sig, false);
        return sig->ret;
    }
    typeArgsOnce(t, call);
    return scopes.opaqueType(str.strView::empty(), call->line, call->col);
}

bool indexPathInBounds(Typer* t, ast.Expr* idx, types.CType* arr)
{
    if (idx == null) return true;
    if (arr == null || arr->kind != types.TY_ARRAY || !arr->countKnown) return true;
    u64 iv = 0;
    if (arr->count == 0)
    {
        errAt(t, idx->line, idx->col, "TC-INDEX", str.strView::fromCstr("index out of bounds: fixed array has no elements"), str.strView::fromCstr("index must be within the array bounds"));
        return false;
    }
    if (!scopes.countFold(idx, &iv)) return true; // runtime index
    if (iv >= arr->count)
    {
        str.String msg = str.String::new();
        msg.pushView(str.strView::fromCstr("index "));
        pushUInt(&msg, iv);
        msg.pushView(str.strView::fromCstr(" out of bounds for fixed array of length "));
        pushUInt(&msg, arr->count);
        errAt(t, idx->line, idx->col, "TC-EXPR", str.strView::fromParts(msg.ptr, msg.len), str.strView::fromCstr("fix the expression to match the expected type"));
        msg.free();
        return false;
    }
    return true;
}

types.CType* typeExprImpl(Typer* t, ast.Expr* e);
// Dotted module-qualified type names (`godot.types.StringNamePtr`) fall out
// of resolveTypeExpr as opaque when the alias branch short-circuits. Retry
// against every loaded program by the name's LAST segment; the returned
// CType keeps the full dotted display name so diagnostics stay readable.
types.CType* resolveDottedViaLoader(Typer* t, str.strView fullName)
{
    {
    }
    libc.write(2, (const u8*)"\n", 1);
    if (t->ld == null) return null;
    u32 last = 0;
    for (u32 i = 0; i < fullName.len; i++)
        if (fullName.ptr[i] == '.') last = i + 1;
    str.strView bare = str.strView::fromParts(fullName.ptr + last, fullName.len - last);
    if (bare.len == 0) return null;
    for (u32 li = 0; li < t->ld.n; li++)
    {
        ast.Program* ip = t->ld.progs[li];
        if (ip == null) continue;
        for (u32 di = 0; di < ip->ndecls; di++)
        {
            ast.Decl* d = ip->decls[di];
            if (d == null || !d->exported || d->ngenerics > 0) continue;
            bool isType = d->kind == ast.DT_STRUCT || d->kind == ast.DT_DISTINCT
                || d->kind == ast.DT_TYPEDEF || d->kind == ast.DT_ENUM
                || d->kind == ast.DT_TRAIT;
            // valueless `pub <type> <name>;` is a type alias (e.g. pub u8 GBool)
            bool isAlias = d->kind == ast.DT_VAR && d->value == null && d->type != null;
            if (!isType && !isAlias) continue;
            if (isAlias)
            {
                types.CType* ut = scopes.resolveTypeExpr(d->type, t->top, t->mods, null, 0);
                if (ut == null) continue;
                types.CType* cp = mman.alloc<types.CType>(1);
                *cp = *ut;
                cp->name = fullName;
                return cp;
            }
            u32 nl = d->name.len;
            if (nl != bare.len) continue;
            if (libc.memcmp((const void*)d->name.ptr, (const void*)bare.ptr, nl) != 0) continue;
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_NAMED;
            ct->decl = d;
            ct->name = fullName;
            if (d->kind == ast.DT_DISTINCT || d->kind == ast.DT_TYPEDEF)
                ct->elem = d->type ? scopes.resolveTypeExpr(d->type, t->top, t->mods, null, 0) : null;
            else
                ct->elem = null;
            ct->line = d->line;
            ct->col = d->col;
            return ct;
        }
    }
    return null;
}

// Const generic parameters used as values (e.g. `N` in arr<T, u64 N>):
// recorded here so codegen can fold them to literals.
ast.Expr* gConstExprs[64];
u64 gConstVals2[64];
u32 gNConstExprs = 0;

pub bool constOf(ast.Expr* e, u64* out)
{
    for (u32 i = 0; i < gNConstExprs; i++)
        if (gConstExprs[i] == e) { *out = gConstVals2[i]; return true; }
    return false;
}

pub void constReset()
{
    gNConstExprs = 0;
}

// Given a generic STRUCT decl and the "<u64, 3>"-style arg spelling from a
// concrete use, bind every method of the struct (own decls + method blocks)
// as a monomorphization instance so codegen can emit bodies.
void recordMethodsForGenericStruct(Typer* t, ast.Decl* structDecl, str.strView inner, ast.Program* ownerProg)
{
    if (structDecl == null || structDecl.kind != ast.DT_STRUCT || structDecl.ngenerics == 0) return;
    str.strView parts[16];
    u32 nparts = 0;
    u32 start4 = 0;
    for (u32 k = 0; k <= inner.len && nparts < 16; k++)
    {
        if (k == inner.len || inner.ptr[k] == ',')
        {
            str.strView piece = str.strView::fromParts(inner.ptr + start4, k - start4);
            while (piece.len > 0 && piece.ptr[0] == ' ') { piece.ptr++; piece.len--; }
            while (piece.len > 0 && piece.ptr[piece.len-1] == ' ') piece.len--;
            parts[nparts++] = piece;
            start4 = k + 1;
        }
    }
    if (nparts != structDecl.ngenerics) return;
    types.CType* rtys[16];
    u64 cvs[16];
    u32 nty = 0; u32 ncv = 0;
    bool ok5 = true;
    for (u32 k = 0; k < nparts; k++)
    {
        str.strView pv = parts[k];
        bool digits = pv.len > 0;
        for (u32 c2 = 0; c2 < pv.len; c2++)
            if (pv.ptr[c2] < '0' || pv.ptr[c2] > '9') { digits = false; break; }
        if (digits)
        {
            u64 mag6 = 0;
            for (u32 c2 = 0; c2 < pv.len; c2++) mag6 = mag6 * 10 + (u64)(pv.ptr[c2] - '0');
            cvs[ncv++] = mag6;
        }
        else
        {
            types.CType* pr6 = mman.alloc<types.CType>(1);
            if (types.primType(pv, pr6)) rtys[nty++] = pr6;
            else { ok5 = false; break; }
        }
    }
    if (!ok5 || nty + ncv != structDecl.ngenerics) return;

    for (u32 mi7 = 0; mi7 < structDecl.ndecls; mi7++)
    {
        ast.Decl* md7 = structDecl.decls[mi7];
        if (md7 == null || md7.kind != ast.DT_FUNC) continue;
        str.String mn8 = str.String::new();
        mn8.pushView(md7.name);
        mn8.pushChar('<');
        mn8.pushView(inner);
        mn8.pushChar('>');
        char* pmn8 = (char*)mman.alloc<char>(mn8.len + 1);
        libc.memcpy(pmn8, mn8.ptr, mn8.len);
        pmn8[mn8.len] = 0;
        subst.record2(md7, rtys, nty,
                      str.strView::fromParts(pmn8, mn8.len),
                      cvs, ncv);
        mn8.free();
    }
    ast.Program* pp7 = ownerProg;
    if (pp7 == null) return;
    for (u32 bi7 = 0; bi7 < pp7.ndecls; bi7++)
    {
        ast.Decl* bd7 = pp7.decls[bi7];
        if (bd7 == null || bd7.kind != ast.DT_METHODBLOCK) continue;
        if (!scopes.sEq(bd7.structName, structDecl.name)) continue;
        for (u32 mi7 = 0; mi7 < bd7.ndecls; mi7++)
        {
            ast.Decl* md7 = bd7.decls[mi7];
            if (md7 == null || md7.kind != ast.DT_FUNC) continue;
            str.String mn8 = str.String::new();
            mn8.pushView(md7.name);
            mn8.pushChar('<');
            mn8.pushView(inner);
            mn8.pushChar('>');
            char* pmn8 = (char*)mman.alloc<char>(mn8.len + 1);
            libc.memcpy(pmn8, mn8.ptr, mn8.len);
            pmn8[mn8.len] = 0;
            subst.record2(md7, rtys, nty,
                          str.strView::fromParts(pmn8, mn8.len),
                          cvs, ncv);
            mn8.free();
        }
    }
}

pub types.CType* typeExpr(Typer* t, ast.Expr* e)
{
    if (e == null) return scopes.opaqueType(str.strView::empty(), 0, 0);
    if (e->inferredTy != null && t->ng == 0 && t->gnames == null) return (types.CType*)e->inferredTy;
    types.CType* _r = typeExprImpl(t, e);
    if (t->ng == 0) e->inferredTy = (void*)_r;
    return _r;
}
ast.Decl* structDeclTmp = null;

types.CType* typeExprImpl(Typer* t, ast.Expr* e)
{
    if (e == null) return scopes.opaqueType(str.strView::empty(), 0, 0);
    switch (e->kind)
    {
    case ast.EX_INT:
        return types.literalIntDefaultType(e->text);
    case ast.EX_FLOAT:
        {
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_FLOAT;
            ct->width = 64;
            if (e->text.len > 0)
            {
                u8 last = (u8)e->text.ptr[e->text.len - 1];
                if (last == 'f' || last == 'F') ct->width = 32;
            }
            return ct;
        }
    case ast.EX_STR:
        {
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_NAMED;
            ct->decl = null;
            ct->name = str.strView::fromCstr("string literal");
            return ct;
        }
    case ast.EX_CHAR:
        {
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_CHAR;
            ct->width = 8;
            return ct;
        }
    case ast.EX_BOOL:
        {
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_BOOL;
            return ct;
        }
    case ast.EX_NULL:
        {
            types.CType* ct = mman.alloc<types.CType>(1);
            ct->kind = types.TY_NULL;
            return ct;
        }
    case ast.EX_IDENT:
        {
            types.CType* r9 = typeIdent(t, e->text, e->line, e->col);
            if (r9 != null && r9.kind == types.TY_UNKNOWN)
            {
                u64 cv9 = 0;
                if (libc.memcmp(e.text.ptr,"N",1)==0) { libc.write(2,(const u8*)"[N?] inComptime=",16); char q8=t.inComptime?'1':'0'; libc.write(2,&q8,1); { u64 probe=0; char okc=subst.lookupConst(e.text,&probe)?'1':'0'; libc.write(2,(const u8*)" bound=",7); libc.write(2,&okc,1);} libc.write(2,(const u8*)"\n",1);} 
                if (subst.lookupConst(e.text, &cv9))
                {
                    types.CType* ct9 = mman.alloc<types.CType>(1);
                    ct9.kind = types.TY_INT;
                    ct9.width = 64;
                    ct9.isSigned = false;
                    if (gNConstExprs < 64) { gConstExprs[gNConstExprs] = e; gConstVals2[gNConstExprs] = cv9; gNConstExprs++; }
                    return ct9;
                }
            }
            return r9;
        }
    case ast.EX_PAREN:
        return typeExpr(t, e->a);

    case ast.EX_UNARY:
        {
            if (strEq2(e->text, "-") || strEq2(e->text, "+"))
            {
                types.CType* x = typeExpr(t, e->a);
                if (x != null && !types.isNumeric(x) && x->kind != types.TY_UNKNOWN)
                {
                    errAt(t, e->line, e->col, "TC-ARITH", str.strView::fromCstr("unary '-/+' applied to non-numeric value"), str.strView::fromCstr("use numeric types or add an explicit cast"));
                }
                return x != null ? x : scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            if (strEq2(e->text, "!"))
            {
                types.CType* x = typeExpr(t, e->a);
                if (x != null && !types.isTruthyType(x))
                {
                    errAt(t, e->line, e->col, "TC-COND", str.strView::fromCstr("logical '!' applied to non-bool value"), str.strView::fromCstr("condition must be bool; use a comparison"));
                }
                types.CType* b = mman.alloc<types.CType>(1);
                b->kind = types.TY_BOOL;
                return b;
            }
            if (strEq2(e->text, "~"))
            {
                types.CType* x = typeExpr(t, e->a);
                if (x != null && x->kind != types.TY_INT && x->kind != types.TY_CHAR && x->kind != types.TY_UNKNOWN)
                {
                    errAt(t, e->line, e->col, "TC-ARITH", str.strView::fromCstr("bitwise '~' applied to non-integer value"), str.strView::fromCstr("use numeric types or add an explicit cast"));
                }
                return x != null && (x->kind == types.TY_INT || x->kind == types.TY_CHAR)
                    ? x : scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            if (strEq2(e->text, "++") || strEq2(e->text, "--"))
            {
                types.CType* x = typeExpr(t, e->a);
                return x != null && types.isNumeric(x) ? x : scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            return typeExpr(t, e->a);
        }

    case ast.EX_DEREF:
        {
            types.CType* x = typeExpr(t, e->a);
            while (x != null && (x->kind == types.TY_PTR || x->kind == types.TY_SLICE || x->kind == types.TY_ARRAY))
            {
                x = x->elem; // deref once
                break;
            }
            return x != null ? x : scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }

    case ast.EX_ADDR:
        {
            types.CType* x = typeExpr(t, e->a);
            types.CType* p = mman.alloc<types.CType>(1);
            p->kind = types.TY_PTR;
            p->elem = x;
            return p;
        }

    case ast.EX_BINARY:
        return typeBinary(t, e);

    case ast.EX_TERNARY:
        {
            types.CType* c = typeExpr(t, e->a);
            if (c != null && !types.isTruthyType(c))
            {
                errAt(t, e->a->line, e->a->col, "TC-COND", str.strView::fromCstr("ternary condition is not boolean"), str.strView::fromCstr("condition must be bool; use a comparison"));
            }
            types.CType* b = typeExpr(t, e->b);
            types.CType* cc = typeExpr(t, e->c);
            if (b != null && b->kind == types.TY_UNKNOWN) return scopes.opaqueType(str.strView::empty(), e->line, e->col);
            if (cc != null && cc->kind == types.TY_UNKNOWN) return scopes.opaqueType(str.strView::empty(), e->line, e->col);
            return b != null ? b : cc;
        }

    case ast.EX_CALL:
        return typeCall(t, e->a, e);

    case ast.EX_DOT:
    case ast.EX_ARROW:
        return typeMember(t, e);

    case ast.EX_INDEX:
        {
            types.CType* o = typeExpr(t, e->a);
            types.CType* ix = typeExpr(t, e->b);
            bool _ = ix != null;
            if (o == null) return scopes.opaqueType(str.strView::empty(), e->line, e->col);
            types.CType* eff = o->kind == types.TY_NAMED ? effective(o) : o;
            if (eff->kind == types.TY_PTR || eff->kind == types.TY_SLICE || eff->kind == types.TY_ARRAY)
            {
                indexPathInBounds(t, e->b, eff);
                return eff->elem != null ? eff->elem : scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            if (eff->kind == types.TY_NAMED)
            {
                // String / strView / Vec index via opaque member ops
                return scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }

    case ast.EX_CAST:
        {
            types.CType* x = typeExpr(t, e->a);
            if (e->type != null)
            {
                types.CType* ct = scopes.resolveTypeExpr(e->type, t->top, t->mods, t->gnames, t->ng);
                return ct != null ? ct : x;
            }
            return x;
        }

    case ast.EX_SIZEOF:
        {
            types.CType* st = mman.alloc<types.CType>(1);
            st->kind = types.TY_INT;
            st->width = 64;
            st->isSigned = false;
            return st;
        }

    case ast.EX_TYPELIT:
        if (e->type != null)
            return scopes.resolveTypeExpr(e->type, t->top, t->mods, t->gnames, t->ng);
        return scopes.opaqueType(str.strView::empty(), e->line, e->col);

    case ast.EX_GENERIC:
        {
            ast.Expr* base = e->a;
        if (base != null && base->kind == ast.EX_IDENT)
            {
                Sym* s = scopes.scopeLookup(t->fnScope != null ? t->fnScope : t->top, base->text);
                if (s == null) s = scopes.scopeLookup(t->top, base->text);
                if (s != null && s->kind == scopes.SYM_FUNC)
                {
                    scopes.symMarkUsed(s);
                    return fnSig(t, s->decl);
                }
                if (s != null)
                {
                    scopes.symMarkUsed(s);
                    if (s->kind == scopes.SYM_STRUCT || s->kind == scopes.SYM_ENUM
                        || s->kind == scopes.SYM_TYPEDEF || s->kind == scopes.SYM_DISTINCT)
                    {
                        return scopes.symTypeFromName(s, base->text, e->line, e->col);
                    }
                }
                // dotted module-qualified generic (`vec.vec<u64>`): build the
                // full display text including type args so downstream
                // recovery (opaque-fallback recording, codegen sizing) can
                // find the struct AND bind its parameters.
                if (base.text.len > 0)
                {
                    str.String dn9 = str.String::new();
                    dn9.pushView(base.text);
                    if (e.ntargs > 0 || e.nargs > 0)
                    {
                        dn9.pushChar('<');
                        for (u32 ti9 = 0; ti9 < e.ntargs; ti9++)
                        {
                            if (ti9 > 0) dn9.pushChar(',');
                            if (e.targs[ti9] != null && e.targs[ti9].kind == ast.TYP_IDENT)
                                dn9.pushView(e.targs[ti9].name);
                        }
                        for (u32 ci9 = 0; ci9 < e.nargs; ci9++)
                        {
                            if (e.ntargs + ci9 > 0) dn9.pushChar(',');
                            if (e.args != null && e.args[ci9] != null && e.args[ci9].kind == ast.EX_INT)
                                dn9.pushView(e.args[ci9].text);
                        }
                        dn9.pushChar('>');
                    }
                    char* p9 = (char*)mman.alloc<char>(dn9.len + 1);
                    libc.memcpy(p9, dn9.ptr, dn9.len);
                    p9[dn9.len] = 0;
                    types.CType* ot9 = scopes.opaqueType(
                        str.strView::fromParts(p9, dn9.len), e.line, e.col);
                    // also record method instances now that we know the struct
                    {
                        u32 ltA = 0;
                        for (u32 i = 0; i < ot9.name.len; i++)
                            if (ot9.name.ptr[i] == '<') { ltA = i; break; }
                        if (ltA > 0 && ot9.name.ptr[ot9.name.len - 1] == '>')
                        {
                            str.strView head = str.strView::fromParts(ot9.name.ptr, ltA);
                            str.strView inner = str.strView::fromParts(
                                ot9.name.ptr + ltA + 1, ot9.name.len - ltA - 2);
                            u32 lsA = 0;
                            for (u32 i = 0; i < head.len; i++) if (head.ptr[i] == '.') lsA = i + 1;
                            str.strView lastName = str.strView::fromParts(head.ptr + lsA, head.len - lsA);
                            libc.write(2, (const u8*)"[genrec] lastName=", 17);
                            libc.write(2, lastName.ptr, lastName.len);
                            libc.write(2, (const u8*)"\n", 1);
                            if (t.ld != null)
                            {
                                for (u32 piA = 0; piA < t.ld.n; piA++)
                                {
                                    ast.Program* ppA = t.ld.progs[piA];
                                    if (ppA == null) continue;
                                    bool fndA = false;
                                    for (u32 diA = 0; diA < ppA.ndecls; diA++)
                                    {
                                        ast.Decl* cdA = ppA.decls[diA];
                                        if (cdA != null && cdA.kind == ast.DT_STRUCT
                                            && scopes.sEq(cdA.name, lastName))
                                        {
                                            structDeclTmp = cdA;
                                            fndA = true;
                                            break;
                                        }
                                    }
                                    if (!fndA) continue;
                                    recordMethodsForGenericStruct(t, structDeclTmp, inner, ppA);
                                    break;
                                }
                            }
                        }
                    }
                    return ot9;
                }
                return scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }

    case ast.EX_INIT:
        return typeInit(t, e);
    }
    return scopes.opaqueType(str.strView::empty(), e->line, e->col);
}

// Is `e` a compile-time TYPE reference (generic param name, primitive or
// named type, module-qualified type path, or type literal)? Used for
// comptime comparisons like `if (T == i8)` / `T == string.strView`.
bool comptimeTypeRef(expr.Typer* t, ast.Expr* e)
{
    if (e == null) return false;
    switch (e->kind)
    {
    case ast.EX_PAREN:
        return comptimeTypeRef(t, e->a);
    case ast.EX_TYPELIT:
        return true;
    case ast.EX_IDENT:
        if (subst.lookup(e->text) != null) return true; // bound by mono subst
        if (scopes.isGenericParam(t->gnames, t->ng, e->text)) return true;
        {
            types.CType p;
            if (types.primType(e->text, &p)) return true;
        }
        {
            scopes.Sym* s = scopes.scopeLookup(t->top, e->text);
            if (s != null && (s->kind == scopes.SYM_STRUCT || s->kind == scopes.SYM_ENUM
                || s->kind == scopes.SYM_TYPEDEF || s->kind == scopes.SYM_DISTINCT
                || s->kind == scopes.SYM_TRAIT)) return true;
        }
        return false;
    case ast.EX_DOT:
        if (e->a != null && e->a->kind == ast.EX_IDENT
            && scopes.modsLookup(t->mods, e->a->text)) return true;
        return false;
    default:
        return false;
    }
}

types.CType* typeBinary(Typer* t, ast.Expr* e)
{
    str.strView op = e->text;
    // comptime type comparison, e.g. `if (T == i8)`: both sides are type
    // references with no runtime value, so never type them as values
    if ((strEq2(op, "==") || strEq2(op, "!=") || strEq2(op, "<") || strEq2(op, "<=")
         || strEq2(op, ">") || strEq2(op, ">=") || strEq2(op, "!<"))
        && comptimeTypeRef(t, e->a) && comptimeTypeRef(t, e->b))
    {
        types.CType* b = mman.alloc<types.CType>(1);
        b->kind = types.TY_BOOL;
        return b;
    }
    types.CType* l = typeExpr(t, e->a);
    types.CType* r = typeExpr(t, e->b);
    bool litL = e->a->kind == ast.EX_INT || e->a->kind == ast.EX_FLOAT;
    bool litR = e->b->kind == ast.EX_INT || e->b->kind == ast.EX_FLOAT;

    if (strEq2(op, "&&") || strEq2(op, "||"))
    {
        if (l != null && !types.isTruthyType(l))
            errAt(t, e->a->line, e->a->col, "TC-COND", str.strView::fromCstr("logical operand is not boolean"), str.strView::fromCstr("condition must be bool; use a comparison"));
        if (r != null && !types.isTruthyType(r))
            errAt(t, e->b->line, e->b->col, "TC-COND", str.strView::fromCstr("logical operand is not boolean"), str.strView::fromCstr("condition must be bool; use a comparison"));
        types.CType* b = mman.alloc<types.CType>(1);
        b->kind = types.TY_BOOL;
        return b;
    }

    if (strEq2(op, "==") || strEq2(op, "!=") || strEq2(op, "<") || strEq2(op, "<=")
        || strEq2(op, ">") || strEq2(op, ">=") || strEq2(op, "!<"))
    {
        types.CType* le = effective(l);
        types.CType* re = effective(r);
        if (le != null && re != null && le->kind != types.TY_UNKNOWN && re->kind != types.TY_UNKNOWN)
        {
            bool ok = false;
            if (litL) ok = types.isNumeric(re);
            else if (litR) ok = types.isNumeric(le);
            else if (le->kind == types.TY_NULL) ok = re->kind == types.TY_PTR || re->kind == types.TY_SLICE
                || re->kind == types.TY_ARRAY || re->kind == types.TY_FUNC;
            else if (re->kind == types.TY_NULL) ok = le->kind == types.TY_PTR || le->kind == types.TY_SLICE
                || le->kind == types.TY_ARRAY || le->kind == types.TY_FUNC;
            else if (types.isIntLike(le) && types.isIntLike(re)) ok = true;
            else if (types.comparable(le, re)) ok = true;
            if (!ok)
            {
                errTwoStr(t, e->line, e->col, "TC-EXPR", "cannot compare '", types.typeName(le), "' and '", types.typeName(re), "'", str.strView::fromCstr("fix the expression to match the expected type"));
            }
        }
        types.CType* b = mman.alloc<types.CType>(1);
        b->kind = types.TY_BOOL;
        return b;
    }

    if (l != null && r != null)
    {
        types.CType* le = effective(l);
        types.CType* re = effective(r);
        if (le->kind == types.TY_UNKNOWN || re->kind == types.TY_UNKNOWN)
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        le = types.decay(le);
        re = types.decay(re);
        bool isShift = strEq2(op, "<<") || strEq2(op, ">>");
        bool isBit = strEq2(op, "&") || strEq2(op, "|") || strEq2(op, "^");
        bool isArith = strEq2(op, "+") || strEq2(op, "-") || strEq2(op, "*")
            || strEq2(op, "/") || strEq2(op, "%");
        if (isShift)
        {
            if (re->kind != types.TY_INT && re->kind != types.TY_CHAR && re->kind != types.TY_UNKNOWN)
                errAt(t, e->b->line, e->b->col, "TC-ARITH", str.strView::fromCstr("shift amount is not an integer"), str.strView::fromCstr("use numeric types or add an explicit cast"));
            if (le->kind == types.TY_INT || le->kind == types.TY_CHAR) return le;
            errAt(t, e->a->line, e->a->col, "TC-ARITH", str.strView::fromCstr("shifted value is not an integer"), str.strView::fromCstr("use numeric types or add an explicit cast"));
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }
        if (isBit)
        {
            if (litL && re->kind == types.TY_INT) return re;
            if (litR && le->kind == types.TY_INT) return le;
            if ((le->kind == types.TY_INT || le->kind == types.TY_CHAR)
                && (re->kind == types.TY_INT || re->kind == types.TY_CHAR))
            {
                return le->kind == types.TY_INT ? le : re;
            }
            errAt(t, e->line, e->col, "TC-ARITH", str.strView::fromCstr("bitwise operator on non-integer operand"), str.strView::fromCstr("use numeric types or add an explicit cast"));
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }
        if (isArith)
        {
            bool lInt = le->kind == types.TY_INT || le->kind == types.TY_CHAR;
            bool rInt = re->kind == types.TY_INT || re->kind == types.TY_CHAR;
            bool lFlt = le->kind == types.TY_FLOAT;
            bool rFlt = re->kind == types.TY_FLOAT;
            bool lPtr = le->kind == types.TY_PTR;
            bool rPtr = re->kind == types.TY_PTR;
            if (litL && litR) return le->kind == types.TY_FLOAT ? lf32Or64(le, re) : re;
            if (litL) return re;
            if (litR) return le;
            if (lInt && rInt) return le->kind == types.TY_CHAR ? re : le;
            if (lFlt && rFlt) return le->width >= re->width ? le : re;
            // pointer +|- integer -> pointer; integer + pointer -> pointer;
            // pointer - pointer -> ptrdiff
            if (lPtr && rInt && (strEq2(op, "+") || strEq2(op, "-"))) return le;
            if (lInt && rPtr && strEq2(op, "+")) return re;
            if (lPtr && rPtr && strEq2(op, "-"))
            {
                types.CType* diff = mman.alloc<types.CType>(1);
                diff->kind = types.TY_INT;
                diff->width = 64;
                diff->isSigned = true;
                return diff;
            }
            errTwoStr(t, e->line, e->col, "TC-EXPR", "arithmetic on incompatible operands '", types.typeName(le), "' and '", types.typeName(re), "'", str.strView::fromCstr("fix the expression to match the expected type"));
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }
    }
    return scopes.opaqueType(str.strView::empty(), e->line, e->col);
}

types.CType* lf32Or64(types.CType* a, types.CType* b)
{
    if (a->kind == types.TY_FLOAT) return a;
    return b;
}

types.CType* typeMember(Typer* t, ast.Expr* e)
{
    ast.Expr* obj = e->a;
    str.strView mem = e->text;

    // module member access: mod.fn / mod.Value (also multi-segment: std.string.x)
    if (obj != null && (obj->kind == ast.EX_IDENT || obj->kind == ast.EX_DOT))
    {
        str.String mp = str.String::new();
        if (flattenModPath(obj, &mp))
        {
            u32 dot = 0;
            while (dot < mp.len && mp.ptr[dot] != '.') dot++;
            str.strView first = str.strView::fromParts(mp.ptr, dot);
            Sym* so = scopes.scopeLookup(t->top, first);
            if (so != null && so->kind == scopes.SYM_MODULE && scopes.modsLookup(t->mods, str.strView::fromParts(mp.ptr, mp.len)))
            {
                str.String comb = str.String::new();
                comb.pushView(str.strView::fromParts(mp.ptr, mp.len));
                comb.pushChar('.');
                comb.pushView(mem);
                checkModuleAccess(t, str.strView::fromParts(comb.ptr, comb.len), e->line, e->col);
                comb.free();
                mp.free();
                return scopes.opaqueType(str.strView::fromCstr("module"), e->line, e->col);
            }
            mp.free();
        }
    }
    // enum variant: Enum.Variant
    if (obj != null && obj->kind == ast.EX_IDENT)
    {
        Sym* so = scopes.scopeLookup(t->top, obj->text);
        if (so != null && so->kind == scopes.SYM_ENUM)
        {
            for (u32 i = 0; i < so->decl->nvariants; i++)
            {
                if (scopes.sEq(so->decl->variants[i].name, mem))
                {
                    scopes.symMarkUsed(so);
                    return scopes.symTypeFromName(so, obj->text, e->line, e->col);
                }
            }
            errTwoStr(t, e->line, e->col, "TC-ENUM", "no such variant '", mem, "' in enum", str.strView::empty(), "", str.strView::fromCstr("check the enum definition for variant names"));
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }
    }

    types.CType* ot = typeExpr(t, obj);
    types.CType* mb = memberBase(ot);
    if (mb != null && mb->kind == types.TY_NAMED && mb->decl != null)
    {
        if (mb->decl->kind == ast.DT_STRUCT)
        {
            ast.StructField* f = scopes.findField(mb->decl, mem);
            if (f != null && f->type != null)
            {
                types.CType* ft = scopes.resolveTypeExpr(f->type, t->top, t->mods, t->gnames, t->ng);
                return ft != null ? ft : scopes.opaqueType(str.strView::empty(), e->line, e->col);
            }
            errTwoStr(t, e->line, e->col, "TC-STRUCT", "struct '", mb->decl->name, "' has no member named '", mem, "'", str.strView::fromCstr("check the struct definition for field names and types"));
            return scopes.opaqueType(str.strView::empty(), e->line, e->col);
        }
        if (mb->decl->kind == ast.DT_ENUM)
        {
            for (u32 i = 0; i < mb->decl->nvariants; i++)
            {
                if (scopes.sEq(mb->decl->variants[i].name, mem))
                {
                    return scopes.symTypeFromName(scopes.scopeLookup(t->top, mb->decl->name), mb->decl->name, e->line, e->col);
                }
            }
        }
        // opaque named (String/strView/vec..) -> member unknown
        return scopes.opaqueType(str.strView::empty(), e->line, e->col);
    }
    return scopes.opaqueType(str.strView::empty(), e->line, e->col);
}

types.CType* typeInit(Typer* t, ast.Expr* e)
{
    types.CType* target = null;
    if (e->type != null)
    {
        target = scopes.resolveTypeExpr(e->type, t->top, t->mods, t->gnames, t->ng);
    }
    if (target != null && target->kind == types.TY_NAMED && target->decl != null
        && target->decl->kind == ast.DT_STRUCT)
    {
        if (e->names != null)
        {
            // named fields
            for (u32 i = 0; i < e->nargs; i++)
            {
                ast.Expr* val = e->args[i];
                str.strView fname = e->names[i];
                ast.StructField* f = scopes.findField(target->decl, fname);
                if (f == null)
                {
                    errTwoStr(t, val->line, val->col, "TC-STRUCT", "struct '", target->decl->name, "' has no field '", fname, "'", str.strView::fromCstr("check the struct definition for field names and types"));
                    typeExpr(t, val);
                    continue;
                }
                types.CType* vt = typeExpr(t, val);
                types.CType* ft = scopes.resolveTypeExpr(f->type, t->top, t->mods, t->gnames, t->ng);
                if (ft != null && !types.assignable(ft, vt, val->kind, val->text) && !types.constFitsExpr(val, ft))
                {
                    errTwoStr(t, val->line, val->col, "TC-STRUCT", "field '", fname, "' expects '", types.typeName(ft), "' but got '", str.strView::fromCstr("check the struct definition for field names and types"));
                    str.String tail = str.String::new();
                    tail.pushView(types.typeName(vt));
                    tail.pushView(str.strView::fromCstr("' (no implicit conversion)"));
                    errAt(t, val->line, val->col, "TC-EXPR", str.strView::fromParts(tail.ptr, tail.len), str.strView::fromCstr("fix the expression to match the expected type"));
                    tail.free();
                }
            }
        }
        else
        {
            // positional
            for (u32 i = 0; i < e->nargs; i++)
            {
                ast.Expr* val = e->args[i];
                if (i >= target->decl->nfields)
                {
                    errAt(t, val->line, val->col, "TC-EXPR", str.strView::fromCstr("too many fields in struct literal"), str.strView::fromCstr("fix the expression to match the expected type"));
                    typeExpr(t, val);
                    continue;
                }
                ast.StructField f = target->decl->fields[i];
                types.CType* vt = typeExpr(t, val);
                types.CType* ft = scopes.resolveTypeExpr(f.type, t->top, t->mods, t->gnames, t->ng);
                if (ft != null && !types.assignable(ft, vt, val->kind, val->text) && !types.constFitsExpr(val, ft))
                {
                    errTwoStr(t, val->line, val->col, "TC-STRUCT", "field '", f.name, "' expects '", types.typeName(ft), "' but got '", str.strView::fromCstr("check the struct definition for field names and types"));
                    str.String tail = str.String::new();
                    tail.pushView(types.typeName(vt));
                    tail.pushView(str.strView::fromCstr("' (no implicit conversion)"));
                    errAt(t, val->line, val->col, "TC-EXPR", str.strView::fromParts(tail.ptr, tail.len), str.strView::fromCstr("fix the expression to match the expected type"));
                    tail.free();
                }
            }
        }
        return target;
    }
    for (u32 i = 0; i < e->nargs; i++) typeExpr(t, e->args[i]);
    return target != null ? target : scopes.opaqueType(str.strView::empty(), e->line, e->col);
}

// statement typing

void typeBody(Typer* t, ast.Stmt* body);

void pushBlock(Typer* t, str.strView label)
{
    t->fnScope = scopes.scopeNew(t->fnScope, label, t->fnScope != null ? t->fnScope->depth + 1 : 0);
}

void popBlock(Typer* t, bool reportUnused)
{
    Scope* s = t->fnScope;
    if (s == null) return;
    if (reportUnused && t->warnUnused)
    {
        for (u32 i = 0; i < s->nsyms; i++)
        {
            Sym* sm = s->syms[i];
            if (sm->kind == scopes.SYM_LOCAL && !sm->used)
            {
                {
                    str.String um = str.String::new();
                    um.pushView(str.strView::fromCstr("unused variable '"));
                    um.pushView(sm->name);
                    um.pushView(str.strView::fromCstr("'"));
                    warnAt(t, sm->line, sm->col, "TC-UNUSED",
                        str.strView::fromParts(um.ptr, um.len),
                        str.strView::fromCstr("variable is never read; safe to remove, but not an error"));
                    um.free();
                }
            }
        }
    }
    t->fnScope = s->parent;
    scopes.scopeFree(s);
}

void declareLocal(Typer* t, str.strView name, types.CType* type, u32 line, u32 col)
{
    Sym* s = scopes.symNew(name, scopes.SYM_LOCAL, null, line, col);
    s->type = type;
    if (!scopes.scopeDeclare(t->fnScope, s))
    {
        errTwoStr(t, line, col, "TC-REDECL", "redeclaration of local variable '", name, "'", str.strView::empty(), "", str.strView::fromCstr("rename or remove the duplicate local"));
    }
}

// comptime evaluation (for `comptime { }` branch pruning)

bool comptimeTypeEq(types.CType* a, types.CType* b)
{
    if (a == null || b == null) return false;
    str.strView na = types.typeName(a);
    str.strView nb = types.typeName(b);
    if (na.len != nb.len) return false;
    for (u32 i = 0; i < na.len; i++)
        if (na.ptr[i] != nb.ptr[i]) return false;
    return true;
}

// Parse an integer literal's raw text (decimal/hex, ignoring any suffix) to i64.
bool litToInt(str.strView sv, i64* out)
{
    if (sv.len == 0) return false;
    u32 i = 0;
    bool neg = false;
    if (sv.ptr[0] == (u8)'-') { neg = true; i = 1; }
    i64 v = 0;
    bool hex = false;
    if (i + 1 < sv.len && sv.ptr[i] == (u8)'0' && (sv.ptr[i+1] == (u8)'x' || sv.ptr[i+1] == (u8)'X'))
    {
        hex = true; i += 2;
    }
    for (; i < sv.len; i++)
    {
        u8 c = sv.ptr[i];
        if (c >= (u8)'0' && c <= (u8)'9')
            v = v * (hex ? 16 : 10) + (i64)(c - (u8)'0');
        else if (hex && c >= (u8)'a' && c <= (u8)'f')
            v = v * 16 + (i64)(c - (u8)'a' + 10);
        else if (hex && c >= (u8)'A' && c <= (u8)'F')
            v = v * 16 + (i64)(c - (u8)'A' + 10);
        else break; // trailing suffix (u/i/l/...) or separator
    }
    *out = neg ? -v : v;
    return true;
}

bool cmpI64(str.strView op, i64 a, i64 b)
{
    if (strEq2(op, "==")) return a == b;
    if (strEq2(op, "!=")) return a != b;
    if (strEq2(op, "<")) return a < b;
    if (strEq2(op, "<=")) return a <= b;
    if (strEq2(op, ">")) return a > b;
    if (strEq2(op, ">=")) return a >= b;
    return false;
}

bool cmpBool(str.strView op, bool a, bool b)
{
    if (strEq2(op, "==")) return a == b;
    if (strEq2(op, "!=")) return a != b;
    return false;
}

// Resolve a compile-time TYPE reference expression to its CType.
types.CType* comptimeTypeCType(Typer* t, ast.Expr* e)
{
    if (e == null) return null;
    switch (e->kind)
    {
    case ast.EX_PAREN: return comptimeTypeCType(t, e->a);
    case ast.EX_TYPELIT: return scopes.resolveTypeExpr(e->type, t->top, t->mods, t->gnames, t->ng);
    case ast.EX_IDENT:
    {
        ast.TypeExpr te;
        te.kind = ast.TYP_IDENT;
        te.name = e->text;
        te.elem = null; te.count = null; te.args = null; te.nargs = 0;
        te.cargs = null; te.ncargs = 0; te.ret = null; te.isConst = false;
        te.line = e->line; te.col = e->col;
        return scopes.resolveTypeExpr(&te, t->top, t->mods, t->gnames, t->ng);
    }
    case ast.EX_DOT:
    {
        if (e->a != null && e->a->kind == ast.EX_IDENT)
        {
            str.String n = str.String::new();
            n.pushView(e->a->text);
            n.pushChar('.');
            n.pushView(e->text);
            ast.TypeExpr te;
            te.kind = ast.TYP_IDENT;
            te.name = str.strView::fromParts(n.ptr, n.len);
            te.elem = null; te.count = null; te.args = null; te.nargs = 0;
            te.cargs = null; te.ncargs = 0; te.ret = null; te.isConst = false;
            te.line = e->line; te.col = e->col;
            types.CType* r = scopes.resolveTypeExpr(&te, t->top, t->mods, t->gnames, t->ng);
            n.free();
            return r;
        }
        return null;
    }
    default: return null;
    }
}

// Evaluate `e` as a compile-time boolean. Returns true if it could be
// determined; *val holds the result. A condition still depending on an
// unresolved generic parameter (abstract pass) is left unknown, so pruning is
// deferred to instantiation where the parameter is bound to a concrete type.
bool comptimeEvalCond(Typer* t, ast.Expr* e, bool* val)
{
    if (e == null) return false;
    switch (e->kind)
    {
    case ast.EX_PAREN:
        return comptimeEvalCond(t, e->a, val);
    case ast.EX_BOOL:
        *val = (e->text.len == 4 && e->text.ptr[0] == (u8)'t');
        return true;
    case ast.EX_UNARY:
        if (e->text.len == 1 && e->text.ptr[0] == (u8)'!')
        {
            bool v2;
            if (comptimeEvalCond(t, e->a, &v2)) { *val = !v2; return true; }
        }
        return false;
    case ast.EX_BINARY:
    {
        str.strView op = e->text;
        // type comparison (e.g. `T == i8`)
        if ((strEq2(op, "==") || strEq2(op, "!="))
            && comptimeTypeRef(t, e->a) && comptimeTypeRef(t, e->b))
        {
            types.CType* la = comptimeTypeCType(t, e->a);
            types.CType* lb = comptimeTypeCType(t, e->b);
            if (la != null && lb != null
                && !(la->kind == types.TY_UNKNOWN && scopes.isGenericParam(t->gnames, t->ng, la->name))
                && !(lb->kind == types.TY_UNKNOWN && scopes.isGenericParam(t->gnames, t->ng, lb->name)))
            {
                bool eq = comptimeTypeEq(la, lb);
                *val = strEq2(op, "==") ? eq : !eq;
                return true;
            }
            return false;
        }
        // boolean logic
        if (strEq2(op, "&&") || strEq2(op, "||"))
        {
            bool v1, v2;
            if (comptimeEvalCond(t, e->a, &v1) && comptimeEvalCond(t, e->b, &v2))
            {
                *val = strEq2(op, "&&") ? (v1 && v2) : (v1 || v2);
                return true;
            }
            return false;
        }
        // integer literal comparison
        if (e->a->kind == ast.EX_INT && e->b->kind == ast.EX_INT)
        {
            i64 la = 0, lb = 0;
            if (litToInt(e->a->text, &la) && litToInt(e->b->text, &lb))
            {
                *val = cmpI64(op, la, lb);
                return true;
            }
            return false;
        }
        // boolean literal comparison
        if (e->a->kind == ast.EX_BOOL && e->b->kind == ast.EX_BOOL)
        {
            bool ba = e->a->text.len == 4 && e->a->text.ptr[0] == (u8)'t';
            bool bb = e->b->text.len == 4 && e->b->text.ptr[0] == (u8)'t';
            *val = cmpBool(op, ba, bb);
            return true;
        }
        return false;
    }
    default:
        return false;
    }
}

 void typeStmt(Typer* t, ast.Stmt* s)
 {
    if (s == null) return;
    switch (s->kind)
    {
        case ast.ST_BLOCK:
        {
            bool prev = t->inComptime;
            if (s->isComptime) t->inComptime = true;
            bool scoped = !s->synthetic;
            if (scoped) pushBlock(t, str.strView::fromCstr("block"));
            for (u32 i = 0; i < s->nstmts; i++) typeStmt(t, s->stmts[i]);
            if (scoped) popBlock(t, true);
            t->inComptime = prev;
        }
        break;

        case ast.ST_VAR:
        {
            types.CType* at = null;
            if (s->type != null)
                at = scopes.resolveTypeExpr(s->type, t->top, t->mods, t->gnames, t->ng);
            types.CType* it = null;
            if (s->a != null)
            {
                it = typeExpr(t, s->a);
                if (at != null && it != null && !types.assignable(at, it, s->a->kind, s->a->text) && !types.constFitsExpr(s->a, at))
                {
                    bool isDistinct = (at->kind==types.TY_NAMED && at->decl!=null && at->decl->kind==ast.DT_DISTINCT) || (it->kind==types.TY_NAMED && it->decl!=null && it->decl->kind==ast.DT_DISTINCT);
                    if (isDistinct) errTwoStr(t, s->line, s->col, "TC-ASSIGN", "cannot assign '", types.typeName(it), "' to variable of type '", types.typeName(at), "' (no implicit conversion)", str.strView::fromCstr("distinct types require an explicit cast like `(T)value`; typedef aliases are compatible"));
                    else errTwoStr(t, s->line, s->col, "TC-ASSIGN", "cannot assign '", types.typeName(it), "' to variable of type '", types.typeName(at), "' (no implicit conversion)", str.strView::fromCstr("types must match exactly; add an explicit cast like `(T)expr` or use --fcast"));
                }
            }
            types.CType* vt = at != null ? at : it;
            if (vt == null) vt = scopes.opaqueType(str.strView::empty(), s->line, s->col);
            declareLocal(t, s->text, vt, s->line, s->col);
            break;
        }

        case ast.ST_RETURN:
        {
            if (s->a != null)
            {
                types.CType* v = typeExpr(t, s->a);
                if (t->retType != null && t->retType->kind != types.TY_VOID
                    && t->retType->kind != types.TY_UNKNOWN)
                {
                    if (!types.assignable(t->retType, v, s->a->kind, s->a->text) && !types.constFitsExpr(s->a, t->retType))
                    {
                        errTwoStr(t, s->line, s->col, "TC-RETURN", "cannot return '", types.typeName(v), "' from function returning '", types.typeName(t->retType), "'", str.strView::fromCstr("typedef aliases are compatible with their underlying type; distinct types need an explicit cast like `(T)value`"));
                    }
                }
                else if (t->retType != null && t->retType->kind == types.TY_VOID)
                {
                    errAt(t, s->line, s->col, "TC-RETURN", str.strView::fromCstr("void function cannot return a value"), str.strView::fromCstr("void functions must use bare `return;` with no value — remove the value or change the signature to `T func()`"));
                }
            }
            else if (t->retType != null && t->retType->kind != types.TY_VOID
                     && t->retType->kind != types.TY_UNKNOWN)
            {
                str.String msg = str.String::new();
                msg.pushView(str.strView::fromCstr("non-void function must return a value of type '"));
                msg.pushView(types.typeName(t->retType));
                msg.pushView(str.strView::fromCstr("' but found bare `return;`"));
                errAt(t, s->line, s->col, "TC-RETURN", str.strView::fromParts(msg.ptr, msg.len), str.strView::fromCstr("add `return <expr>;` with a value of the declared type, or change the function to `void`"));
                msg.free();
            }
            break;
        }

        case ast.ST_IF:
        {
            // comptime pruning: if the condition is a compile-time constant,
            // typecheck only the taken branch and erase the dead one.
            if (s->a != null && t->inComptime)
            {
                bool known = false; bool v = false;
                if (comptimeEvalCond(t, s->a, &v))
                {
                    if (v) typeStmt(t, s->body);
                    else if (s->body2 != null) typeStmt(t, s->body2);
                    break;
                }
            }
            if (s->a != null)
            {
                types.CType* c = typeExpr(t, s->a);
                if (c != null && !types.isTruthyType(c))
                {
                    errAt(t, s->a->line, s->a->col, "TC-EXPR", str.strView::fromCstr("if condition is not boolean"), str.strView::fromCstr("fix the expression to match the expected type"));
                }
            }
            typeStmt(t, s->body);
            typeStmt(t, s->body2);
            break;
        }

        case ast.ST_WHILE:
        case ast.ST_LOOP:
        {
            if (s->kind == ast.ST_WHILE && s->a != null)
            {
                types.CType* c = typeExpr(t, s->a);
                if (c != null && !types.isTruthyType(c))
                {
                    errAt(t, s->a->line, s->a->col, "TC-EXPR", str.strView::fromCstr("while condition is not boolean"), str.strView::fromCstr("fix the expression to match the expected type"));
                }
            }
            pushBlock(t, str.strView::fromCstr("loop"));
            typeStmt(t, s->body);
            popBlock(t, true);
            break;
        }

        case ast.ST_FOR:
        {
            pushBlock(t, str.strView::fromCstr("for"));
            typeStmt(t, s->init);
            if (s->b != null)
            {
                types.CType* c = typeExpr(t, s->b);
                if (c != null && !types.isTruthyType(c))
                {
                    errAt(t, s->b->line, s->b->col, "TC-EXPR", str.strView::fromCstr("for condition is not boolean"), str.strView::fromCstr("fix the expression to match the expected type"));
                }
            }
            if (s->c != null) typeExpr(t, s->c);
            typeStmt(t, s->body);
            popBlock(t, true);
            break;
        }

        case ast.ST_FORIN:
        {
            types.CType* it = typeExpr(t, s->a);
            types.CType* elem = scopes.opaqueType(str.strView::empty(), s->line, s->col);
            if (it != null)
            {
                if (it->kind == types.TY_ARRAY || it->kind == types.TY_SLICE || it->kind == types.TY_PTR)
                    elem = it->elem != null ? it->elem : elem;
                else if (it->kind == types.TY_NAMED)
                {
                    // String / strView iterate element-wise
                    elem = mman.alloc<types.CType>(1);
                    elem->kind = types.TY_CHAR;
                }
            }
            declareLocal(t, s->text, elem, s->line, s->col);
            pushBlock(t, str.strView::fromCstr("forin"));
            typeStmt(t, s->body);
            popBlock(t, true);
            break;
        }

        case ast.ST_EXPR:
        typeExpr(t, s->a);
        break;

        case ast.ST_ASSERT:
        {
            types.CType* c = typeExpr(t, s->a);
            if (c != null && c->kind != types.TY_BOOL && c->kind != types.TY_UNKNOWN)
            {
                errAt(t, s->a->line, s->a->col, "TC-COND", str.strView::fromCstr("assert condition is not boolean"), str.strView::fromCstr("condition must be bool; use a comparison"));
            }
            break;
        }

        case ast.ST_SWITCH:
        {
            types.CType* subj = typeExpr(t, s->a);
            subj = effective(subj);
            for (u32 i = 0; i < s->ncases; i++)
            {
                ast.StmtCase* sc = s->cases[i];
                if (sc == null) continue;
                if (sc->value != null)
                {
                    types.CType* cv = typeExpr(t, sc->value);
                    if (subj != null && subj->kind != types.TY_UNKNOWN
                        && cv != null && cv->kind != types.TY_UNKNOWN
                        && !types.typesEqual(subj, cv)
                        && !types.assignable(subj, cv, sc->value->kind, sc->value->text)
                        && !types.constFitsExpr(sc->value, subj))
                    {
                        errAt(t, sc->value->line, sc->value->col, "TC-SWITCH", str.strView::fromCstr("case value type does not match switch subject"), str.strView::fromCstr("case value must have the same type as the switch subject"));
                    }
                }
                pushBlock(t, str.strView::fromCstr("case"));
                for (u32 j = 0; j < sc->nbody; j++) typeStmt(t, sc->body[j]);
                popBlock(t, true);
            }
            if (s->defaultCase != null)
            {
                pushBlock(t, str.strView::fromCstr("default"));
                for (u32 j = 0; j < s->defaultCase->nbody; j++) typeStmt(t, s->defaultCase->body[j]);
                popBlock(t, true);
            }
            break;
        }

        case ast.ST_BREAK:
        case ast.ST_CONTINUE:
        break;

        case ast.ST_ASM:
        {
            // identifiers appearing inside an inline-asm block count as uses
            // of the matching locals/params (the asm text is opaque to the
            // type checker but may reference them by name).
            if (s->text.len > 0 && t->fnScope != null)
            {
                u32 i = 0;
                while (i < s->text.len)
                {
                    u8 c = s->text.ptr[i];
                    bool idStart = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
                    if (!idStart) { i++; continue; }
                    u32 j = i + 1;
                    while (j < s->text.len)
                    {
                        u8 d = s->text.ptr[j];
                        bool idChar = (d >= 'a' && d <= 'z') || (d >= 'A' && d <= 'Z') || (d >= '0' && d <= '9') || d == '_';
                        if (!idChar) break;
                        j++;
                    }
                    str.strView word = str.strView::fromParts(s->text.ptr + i, j - i);
                    Sym* sm = scopes.scopeLookup(t->fnScope, word);
                    if (sm != null) scopes.symMarkUsed(sm);
                    i = j;
                }
            }
            break;
        }

        case ast.ST_DEFER:
            pushBlock(t, str.strView::fromCstr("defer"));
            typeStmt(t, s->body);
            popBlock(t, true);
        break;

        case ast.ST_FLAG:
        {
            str.strView sel = typerFlagValue(t, s->text);
            Stmt* chosen = null;
            u32 nchosen = 0;
            bool found = false;
            if (sel.len > 0)
            {
                for (u32 ci = 0; ci < s->ncases; ci++)
                    if (s->cases[ci] != null && s->cases[ci]->value != null && scopes.sEq(s->cases[ci]->value->text, sel))
                    { chosen = s->cases[ci]->body[0]; nchosen = s->cases[ci]->nbody; found = true; break; }
            }
            if (!found && s->defaultCase != null) { chosen = s->defaultCase->body[0]; nchosen = s->defaultCase->nbody; }
            if (chosen != null) for (u32 k = 0; k < nchosen; k++) typeStmt(t, chosen);
            break;
        }
    }
}

void typeBody(Typer* t, ast.Stmt* body)
{
    typeStmt(t, body);
}

ast.Decl* findNamedStruct(Typer* t, str.strView name)
{
    Sym* s = scopes.scopeLookup(t->top, name);
    if (s != null && s->decl != null && s->decl->kind == ast.DT_STRUCT) return s->decl;
    // imported structs (generic std types): scan loaded programs
    if (t->ld != null)
    {
        for (u32 pi = 0; pi < t->ld.n; pi++)
        {
            ast.Program* pp = t->ld.progs[pi];
            if (pp == null) continue;
            for (u32 di = 0; di < pp.ndecls; di++)
            {
                ast.Decl* cd = pp.decls[di];
                if (cd != null && cd.kind == ast.DT_STRUCT && scopes.sEq(cd.name, name)) return cd;
            }
        }
    }
    return null;
}

// Program-wide struct lookup: the struct may be declared in another file
// (e.g. String lives in std/text/string.crl, called from any file). `owner`
// receives the Program that declares it (for method-block searches).
ast.Decl* findStructInProgram(Typer* t, str.strView name, ast.Program** owner)
{
    for (u32 i = 0; i < t->prog->ndecls; i++)
    {
        ast.Decl* d = t->prog->decls[i];
        if (d != null && d->kind == ast.DT_STRUCT && scopes.sEq(d->name, name))
        {
            *owner = t->prog;
            return d;
        }
    }
    if (t->ld != null)
    {
        for (u32 i = 0; i < t->ld->n; i++)
        {
            ast.Program* p = t->ld->progs[i];
            for (u32 j = 0; p != null && j < p->ndecls; j++)
            {
                ast.Decl* d = p->decls[j];
                if (d != null && d->kind == ast.DT_STRUCT && scopes.sEq(d->name, name))
                {
                    *owner = p;
                    return d;
                }
            }
        }
    }
    return null;
}

// Entry for a function/method body.
// Build the element type of `self` for a method on struct `sd`. For a generic
// struct (e.g. `set<T>`), `self` must carry the generic args so it matches
// parameters declared as `const set<T>*` etc. rather than a bare `set*`.
types.CType* selfElemType(Typer* t, ast.Decl* sd, str.strView name, u32 line, u32 col)
{
    // Always a NAMED struct type: generic params stay abstract here and are
    // concretized during monomorphisation via subst; resolveTypeExpr would
    // otherwise return an opaque UNKNOWN that breaks member/codegen paths.
    if (sd != null) return scopes.namedType(sd, name, line, col);
    return scopes.opaqueType(name, line, col);
}

pub void typeFunction(Typer* t, ast.Decl* d)
{
    if (d == null || d->body == null) return;
    t->curFn = d;
    t->curFile = d->srcFile;    // imported-module bodies report their own file
    t->fnScope = scopes.scopeNew(null, d->name, 0);
    t->retType = d->type != null
        ? retryTypeViaLoader(t, d->type,
            scopes.resolveTypeExpr(d->type, t->top, t->mods, d->generics, d->ngenerics))
        : scopes.opaqueType(str.strView::empty(), d->line, d->col);
    if (t->retType != null && t->retType->kind == types.TY_UNKNOWN && t->retType->name.len > 0)
    {
        errTwoStr(t, d->line, d->col, "TC-TYPE", "unknown return type '", t->retType->name, "'", str.strView::empty(), "", str.strView::fromCstr("declare the type or use a primitive like i32, i64, f64, bool, void, char, usize"));
    }
    t->gnames = d->generics;
    t->ng = d->ngenerics;

    bool isMethod = d->structName.len > 0;
    // explicit self slot: an unnamed/self-named first parameter (or a self*
    // / owning-struct* typed one) on an INSTANCE method is THE self; no
    // implicit self then. Statics never have self (static bodies must not
    // reference self).
    bool selfSlot = d->nparams > 0 && !d->isStatic && d->params[0].type != null
        && (d->params[0].name.len == 0 || strEq2(d->params[0].name, "self")
            || scopes.isSelfTypeNode(d->params[0].type));
    if (isMethod && !d->isStatic && !selfSlot)
    {
        // implicit self: pointer to the owning struct
        Sym* self = scopes.symNew(str.strView::fromCstr("self"), scopes.SYM_PARAM, d, d->line, d->col);
        ast.Decl* sd = findNamedStruct(t, d->structName);
        types.CType* stp = mman.alloc<types.CType>(1);
        stp->kind = types.TY_PTR;
        stp->elem = sd != null ? selfElemType(t, sd, d->structName, d->line, d->col)
                               : scopes.opaqueType(d->structName, d->line, d->col);
        self->type = stp;
        self->used = true;
        if (!scopes.scopeDeclare(t->fnScope, self))
        {
            errAt(t, d->line, d->col, "TC-EXPR", str.strView::fromCstr("duplicate self parameter"), str.strView::fromCstr("fix the expression to match the expected type"));
        }
    }
    for (u32 i = 0; i < d->nparams; i++)
    {
        ast.Param p = d->params[i];
        // py legacy: an unnamed first param (or a param named self, or any
        // self* typed first param) is the explicit self slot; bind it under
        // the name 'self'.
        bool paramIsSelf = i == 0 && p.type != null
            && (!d->isStatic
                && (p.name.len == 0 || strEq2(p.name, "self"))
                || scopes.isSelfTypeNode(p.type));
        Sym* s = scopes.symNew(paramIsSelf ? str.strView::fromCstr("self") : p.name,
                               scopes.SYM_PARAM, d, d->line, d->col);
        types.CType* pt = p.type != null
            ? scopes.resolveTypeExpr(p.type, t->top, t->mods, d->generics, d->ngenerics)
            : scopes.opaqueType(str.strView::empty(), d->line, d->col);
        s->type = p.type != null ? retryTypeViaLoader(t, p.type, pt) : pt;
        if (paramIsSelf && s->type != null && s->type->kind == types.TY_PTR
            && s->type->elem != null && s->type->elem->kind == types.TY_UNKNOWN)
        {
            // `self*`/`self` typed slot: resolve to the owning struct
            ast.Decl* sd = findNamedStruct(t, d->structName);
            s->type->elem = sd != null
                ? selfElemType(t, sd, d->structName, d->line, d->col)
                : scopes.opaqueType(d->structName, d->line, d->col);
        }
        else if (paramIsSelf && s->type != null && s->type->kind == types.TY_NAMED
                 && s->type->decl == null && strEq2(s->type->name, "self"))
        {
            ast.Decl* sd = findNamedStruct(t, d->structName);
            s->type = sd != null ? selfElemType(t, sd, d->structName, d->line, d->col)
                                 : scopes.opaqueType(d->structName, d->line, d->col);
        }
        if (!scopes.scopeDeclare(t->fnScope, s))
        {
            errTwoStr(t, d->line, d->col, "TC-DUP", "duplicate parameter '", s->name, "'", str.strView::empty(), "", str.strView::fromCstr("rename or remove the duplicate"));
        }
    }

    typeStmt(t, d->body);
    if (t->retType != null && t->retType->kind != types.TY_VOID && t->retType->kind != types.TY_UNKNOWN)
    {
        bool hasRet = false;
        if (d->body != null)
        {
            if (d->body->kind == ast.ST_BLOCK) {
                for (u32 _ri=0; _ri<d->body->nstmts; _ri++) if (d->body->stmts[_ri]!=null && d->body->stmts[_ri]->kind==ast.ST_RETURN) {hasRet=true; break;}
                if (!hasRet) for (u32 _ri=0; _ri<d->body->nstmts; _ri++) {
                    ast.Stmt* _s=d->body->stmts[_ri];
                    if (_s!=null && _s->kind==ast.ST_IF) {
                        if (_s->body!=null && _s->body->kind==ast.ST_BLOCK) for(u32 _k=0;_k<_s->body->nstmts;_k++) if(_s->body->stmts[_k]!=null && _s->body->stmts[_k]->kind==ast.ST_RETURN) hasRet=true;
                        if (_s->body2!=null && _s->body2->kind==ast.ST_BLOCK) for(u32 _k=0;_k<_s->body2->nstmts;_k++) if(_s->body2->stmts[_k]!=null && _s->body2->stmts[_k]->kind==ast.ST_RETURN) hasRet=true;
                    }
                }
            } else if (d->body->kind==ast.ST_RETURN) hasRet=true;
        }
        if (!hasRet) {
            str.String _m = str.String::new();
            _m.pushView(str.strView::fromCstr("non-void function '"));
            _m.pushView(d->name);
            _m.pushView(str.strView::fromCstr("' must return a value of type '"));
            _m.pushView(types.typeName(t->retType));
            _m.pushView(str.strView::fromCstr("'"));
            errAt(t, d->line, d->col, "TC-RETURN", str.strView::fromParts(_m.ptr,_m.len), str.strView::fromCstr("add a return statement on every path, or change the return type to void"));
            _m.free();
        }
    }
    Scope* fs = t->fnScope;
    if (fs != null && t->warnUnused)
    {
        for (u32 i = 0; i < fs->nsyms; i++)
        {
            Sym* sm = fs->syms[i];
            if (sm->kind == scopes.SYM_LOCAL && !sm->used)
            {
                {
                    str.String um = str.String::new();
                    um.pushView(str.strView::fromCstr("unused variable '"));
                    um.pushView(sm->name);
                    um.pushView(str.strView::fromCstr("'"));
                    warnAt(t, sm->line, sm->col, "TC-UNUSED",
                        str.strView::fromParts(um.ptr, um.len),
                        str.strView::fromCstr("variable is never read; safe to remove, but not an error"));
                    um.free();
                }
            }
        }
    }
    t->fnScope = null;
    scopes.scopeFree(fs);
    t->retType = null;
    t->curFn = null;
    t->gnames = null;
    t->ng = 0;
}

// Retry a failed TypeExpr resolution through the loaded modules. Used for
// function signature positions where opaque poison would otherwise surface
// as TC-TYPE "unknown return type".
pub types.CType* retryTypeViaLoader(Typer* t, ast.TypeExpr* te, types.CType* failed)
{
    if (failed == null || failed->kind != types.TY_UNKNOWN) return failed;
    if (te == null) return failed;

    // TYP_GENERIC: bare self-referencing generic return (`vec<T>` inside
    // vec.crl). Find the struct through the loader and build a NAMED type.
    if (te->kind == ast.TYP_GENERIC && te->name.len > 0)
    {
        u32 ls = 0;
        for (u32 i = 0; i < te->name.len; i++) if (te->name.ptr[i] == '.') ls = i + 1;
        str.strView baseName = str.strView::fromParts(te->name.ptr + ls, te->name.len - ls);
        if (t.ld != null)
        {
            for (u32 pi = 0; pi < t.ld.n; pi++)
            {
                ast.Program* pp = t.ld.progs[pi];
                if (pp == null) continue;
                bool fnd = false;
                for (u32 di = 0; di < pp.ndecls; di++)
                {
                    ast.Decl* cd = pp.decls[di];
                    if (cd != null && cd.kind == ast.DT_STRUCT
                        && scopes.sEq(cd.name, baseName))
                    {
                        str.String dn = str.String::new();
                        dn.pushView(te->name);
                        dn.pushChar('<');
                        for (u32 ai = 0; ai < te.nargs; ai++)
                        {
                            if (ai > 0) dn.pushChar(',');
                            if (te.args != null && te.args[ai] != null && te.args[ai]->kind == ast.TYP_IDENT)
                                dn.pushView(te.args[ai].name);
                        }
                        dn.pushChar('>');
                        char* pdn = (char*)mman.alloc<char>(dn.len + 1);
                        libc.memcpy(pdn, dn.ptr, dn.len);
                        pdn[dn.len] = 0;
                        types.CType* ct2 = mman.alloc<types.CType>(1);
                        ct2.kind = types.TY_NAMED;
                        ct2.decl = cd;
                        ct2.name = str.strView::fromParts(pdn, dn.len);
                        ct2.elem = null;
                        ct2.line = te.line;
                        ct2.col = te.col;
                        return ct2;
                    }
                }
                if (fnd) break;
            }
        }
        return failed;
    }

    if (te->kind != ast.TYP_IDENT) return failed;
    bool dotted = false;
    for (u32 i = 0; i < te->name.len; i++) if (te->name.ptr[i] == '.') { dotted = true; break; }
    if (!dotted) return failed;
    types.CType* ct = resolveDottedViaLoader(t, te.name);
    return ct != null ? ct : failed;
}
