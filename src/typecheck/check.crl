// Typecheck entry: file attributes, top-level symbol tables, then full
// per-file typing of every function/method/const body via the expr module.
//
// Passes wired up here: attr contract (no_drop / no_warn_unsafe / forced_*),
// top-level declaration of functions/structs/enums/traits/typedefs/distincts/
// consts/externs/namespaces/module aliases, and body typing with strict
// (no-implicit-conversion) rules. Imported modules stay opaque at this stage.
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");
mod error = import("error");
mod ast = import("ast/ast.crl");
mod types = import("typecheck/types.crl");
mod scopes = import("typecheck/scopes.crl");
mod expr = import("typecheck/expr.crl");
mod loader = import("typecheck/loader.crl");
 mod mono = import("mono/mono.crl");
 mod ceval = import("mono/ceval.crl");
 mod codegen = import("codegen/emit.crl");

// ---- reachable-import support ----
const u32 RN_CAP = 512;
struct UsedNames
{
    char names[512 * 64];   // flattened rows of 64 bytes
    u32 n;
    str.strView roots[64]; // dotted-chain roots (module aliases)
    u32 nroots;
}

void unAdd(UsedNames* u, str.strView t)
{
    if (t.len == 0 || t.len >= 64) return;
    for (u32 i = 0; i < u.n; i++)
        if (libc.memcmp((const void*)(u.names + i * 64), (const void*)t.ptr, t.len) == 0
            && u.names[i * 64 + t.len] == 0) return;
    if (u.n >= RN_CAP) return;
    libc.memcpy((void*)(u.names + u.n * 64), (const void*)t.ptr, t.len);
    u.names[u.n * 64 + t.len] = 0;
    u.n++;
}

void unHas(UsedNames* u, str.strView t, bool* out)
{
    *out = false;
    if (t.len == 0 || t.len >= 64) return;
    for (u32 i = 0; i < u.n; i++)
        if (libc.memcmp((const void*)(u.names + i * 64), (const void*)t.ptr, t.len) == 0
            && u.names[i * 64 + t.len] == 0) { *out = true; return; }
}

void unExpr(UsedNames* u, ast.Expr* e)
{
    if (e == null) return;
    switch (e->kind)
    {
    case ast.EX_IDENT:
        unAdd(u, e->text);
        break;
    case ast.EX_DOT:
    case ast.EX_ARROW:
        unAdd(u, e->text);   // member segment (leaf name)
        unExpr(u, e->a);
        break;
    case ast.EX_CALL:
        unExpr(u, e->a);
        for (u32 i = 0; i < e->nargs; i++) unExpr(u, e->args[i]);
        break;
    case ast.EX_UNARY:
    case ast.EX_DEREF:
    case ast.EX_ADDR:
    case ast.EX_PAREN:
        unExpr(u, e->a);
        break;
    case ast.EX_BINARY:
        unExpr(u, e->a);
        unExpr(u, e->b);
        break;
    case ast.EX_TERNARY:
        unExpr(u, e->a);
        unExpr(u, e->b);
        unExpr(u, e->c);
        break;
    case ast.EX_INDEX:
        unExpr(u, e->a);
        unExpr(u, e->b);
        break;
    case ast.EX_CAST:
        unExpr(u, e->a);
        break;
    default:
        break;
    }
}

void unStmt(UsedNames* u, ast.Stmt* st)
{
    if (st == null) return;
    switch (st->kind)
    {
    case ast.ST_BLOCK:
        for (u32 i = 0; i < st->nstmts; i++) unStmt(u, st->stmts[i]);
        break;
    case ast.ST_VAR:
        unExpr(u, st->a);
        if (st->stmts != null && st->nstmts > 0)
            for (u32 i = 0; i < st->nstmts; i++) unStmt(u, st->stmts[i]);
        break;
    case ast.ST_EXPR:
        unExpr(u, st->a);
        break;
    case ast.ST_RETURN:
        unExpr(u, st->a);
        break;
    case ast.ST_IF:
        unExpr(u, st->a);
        unStmt(u, st->body);
        unStmt(u, st->body2);
        break;
    case ast.ST_WHILE:
    case ast.ST_LOOP:
        unExpr(u, st->a);
        unStmt(u, st->body);
        break;
    case ast.ST_FOR:
        unStmt(u, st->init);
        unExpr(u, st->b);
        unExpr(u, st->c);
        unStmt(u, st->body);
        break;
    case ast.ST_FORIN:
        unExpr(u, st->a);
        unStmt(u, st->body);
        break;
    case ast.ST_DEFER:
        unStmt(u, st->body);
        break;
    case ast.ST_ASSERT:
        unExpr(u, st->a);
        break;
    default:
        break;
    }
}

pub struct Check
{
    ast.Program* prog;
    str.strView src;
    str.strView filename;
    char* exeDir;
    bool noDrop;            // @[[no_drop]]: skip variable tracking
    bool noWarnUnsafe;      // @[[no_warn_unsafe]]: demote unsafe diagnostics
    bool forcedSkip;        // any @[[forced_*]]: borrow checker skips file
    u32 nerrors;
    u32 nwarnings;
    str.strView flagNames[16];
    str.strView flagVals[16];
    u32 nflags;

    loader.Loader* ld;       // set during run(); per-module srcs for diagnostics
    scopes.Scope* top;       // set during run(); used by codegen (emit)
    scopes.ModuleTable* mods;
    u32 emitMode;             // 0=none 1=h 2=ir 3=asm (set by driver)
    u32 optLevel;             // -O0..-O3
    bool debugBuild;
    str.strView outputPath;
    str.strView linkerFlags;

    static Check new(ast.Program* prog, str.strView src, str.strView filename, char* exeDir)
    {
        Check c;
        c.prog = prog;
        c.src = src;
        c.filename = filename;
        c.exeDir = exeDir;
        c.noDrop = false;
        c.noWarnUnsafe = false;
        c.forcedSkip = false;
        c.nerrors = 0;
        c.nwarnings = 0;
        c.nflags = 0;
        c.emitMode = 0;
        c.optLevel = 1;
        c.debugBuild = false;
        c.outputPath = strView::empty();
        c.linkerFlags = strView::empty();
        c.ld = null;
        c.top = null;
        c.mods = null;
        return c;
    }

    // Per-decl source attribution: decls parsed from an imported module
    // carry their own file in srcFile; report against THAT file (path +
    // caret line from its text) so multi-module errors are locatable.
    bool declSrc(ast.Decl* d, str.strView* fileOut, str.strView* srcOut)
    {
        if (d != null && d->srcFile.len > 0
            && !veqPrefix(self.filename, "") && d->srcFile.len == self.filename.len
            && libc.memcmp((const void*)d->srcFile.ptr, (const void*)self.filename.ptr, d->srcFile.len) == 0)
        {
            *fileOut = self.filename;
            *srcOut = self.src;
            return true;
        }
        if (d != null && d->srcFile.len > 0 && self.ld != null)
        {
            for (u32 i = 0; i < self.ld.n; i++)
            {
                u32 pl = 0;
                while (self.ld.paths[i][pl] != 0) pl++;
                if (pl == d->srcFile.len
                    && libc.memcmp((const void*)self.ld.paths[i], (const void*)d->srcFile.ptr, pl) == 0)
                {
                    *fileOut = d->srcFile;
                    *srcOut = str.strView::fromParts((const char*)self.ld.srcs[i], self.ld.srcLens[i]);
                    return true;
                }
            }
        }
        *fileOut = self.filename;
        *srcOut = self.src;
        return false;
    }

    void errDecl(ast.Decl* d, str.strView code, str.strView msg, str.strView help)
    {
        str.strView f; str.strView sc;
        self.declSrc(d, &f, &sc);
        error.reportCode(code, f, sc, d->line, d->col,
                         error.LVL_ERROR, msg, help);
        self.nerrors++;
    }

    void declareSym(scopes.Scope* top, ast.Decl* d, u32 kind, types.CType* ct)
    {
        if (libc.getenv("CORAL_DEBUG_VARIADIC") != null && kind == scopes.SYM_MODULE
            && scopes.sEq(d.name, str.strView::fromCstr("result")))
        {
            char dbd[80];
            i32 dnd = libc.snprintf(dbd, 80, "[decl-mod] result from %.*s\n",
                (int)d.srcFile.len, d.srcFile.ptr);
            if (dnd > 0) libc.write(2, dbd, (u64)dnd);
        }
        // Type-level declarations (enum/struct/typedef/distinct) may be
        // redeclared. Auto-generated binding headers (e.g. coral-godot) repeat
        // type defs across classes that C++ scopes via `::`; tolerate the
        // duplicate so the file still type-checks (keep the first definition).
        if (kind == scopes.SYM_ENUM || kind == scopes.SYM_STRUCT
            || kind == scopes.SYM_TYPEDEF || kind == scopes.SYM_DISTINCT)
        {
            scopes.Sym* existing = scopes.scopeLookup(top, d->name);
            if (existing != null && existing->kind == kind) return;
        }
        scopes.Sym* s = scopes.symNew(d->name, kind, d, d->line, d->col);
        s->type = ct;
        if (!scopes.scopeDeclare(top, s))
        {
            self.errDecl(d, str.strView::fromCstr("TC-REDECL"), str.strView::fromCstr("redeclaration of '"), str.strView::empty());
            str.String msg = str.String::new();
            msg.pushView(d->name);
            msg.pushChar('\'');
            self.errDecl(d, str.strView::fromCstr("TC-REDECL"), str.strView::fromParts(msg.ptr, msg.len), str.strView::empty());
            msg.free();
        }
    }

    bool vEqCI(str.strView a, str.strView b)
    {
        if (a.len != b.len) return false;
        for (u32 i = 0; i < a.len; i++)
        {
            char ca = a.ptr[i]; if (ca >= 'A' && ca <= 'Z') ca = (char)(ca - 'A' + 'a');
            char cb = b.ptr[i]; if (cb >= 'A' && cb <= 'Z') cb = (char)(cb - 'A' + 'a');
            if (ca != cb) return false;
        }
        return true;
    }

    bool vEqSV(str.strView a, str.strView b)
    {
        if (a.len != b.len) return false;
        for (u32 i = 0; i < a.len; i++)
            if (a.ptr[i] != b.ptr[i]) return false;
        return true;
    }

    // value supplied for a flag (terminal --flags, or the value the compiler
    // was built with and re-supplies -- e.g. arch/platform). empty if none.
    str.strView flagValue(str.strView name)
    {
        for (u32 i = 0; i < self.nflags; i++)
            if (vEqCI(self.flagNames[i], name)) return self.flagVals[i];
        return str.strView::empty();
    }

    expr.Typer typer(scopes.Scope* top, scopes.ModuleTable* mods, loader.Loader* ld)
    {
        expr.Typer t = expr.Typer::new(self.prog, self.src, self.filename, top, mods, ld,
                               &self.nerrors, &self.nwarnings,
                               self.noWarnUnsafe, self.forcedSkip);
        t.flagNames = self.flagNames;
        t.flagVals = self.flagVals;
        t.nflags = self.nflags;
        t.exeDir = self.exeDir;
        return t;
    }

    void expandStmtFlags(ast.Stmt* s)
    {
        if (s == null) return;
        if (s->kind == ast.ST_BLOCK)
        {
            u32 write = 0;
            for (u32 i = 0; i < s->nstmts; i++)
            {
                ast.Stmt* cur = s->stmts[i];
                if (cur != null && cur->kind == ast.ST_FLAG)
                {
                    str.strView sel = self.flagValue(cur->text);
                    ast.StmtCase* chosenCase = null;
                    for (u32 ci = 0; ci < cur->ncases; ci++)
                    {
                        ast.StmtCase* sc = cur->cases[ci];
                        if (sc != null && sc->value != null && vEqSV(sc->value->text, sel)) { chosenCase = sc; break; }
                    }
                    if (chosenCase == null) chosenCase = cur->defaultCase;
                    if (chosenCase != null)
                    {
                        for (u32 k = 0; k < chosenCase->nbody; k++)
                        {
                            ast.Stmt* inner = chosenCase->body[k];
                            self.expandStmtFlags(inner);
                            s->stmts[write++] = inner;
                        }
                    }
                    continue;
                }
                self.expandStmtFlags(cur);
                s->stmts[write++] = cur;
            }
            s->nstmts = write;
        } else if (s->kind == ast.ST_IF)
        {
            self.expandStmtFlags(s->body);
            self.expandStmtFlags(s->body2);
        } else if (s->kind == ast.ST_FOR) { self.expandStmtFlags(s->body); self.expandStmtFlags(s->init); }
        else if (s->kind == ast.ST_FORIN) self.expandStmtFlags(s->body);
        else if (s->kind == ast.ST_WHILE) self.expandStmtFlags(s->body);
        else if (s->kind == ast.ST_LOOP) self.expandStmtFlags(s->body);
        else if (s->kind == ast.ST_SWITCH) {
            for (u32 ci = 0; ci < s->ncases; ci++) if (s->cases[ci] != null) for (u32 k = 0; k < s->cases[ci]->nbody; k++) self.expandStmtFlags(s->cases[ci]->body[k]);
            if (s->defaultCase != null) for (u32 k = 0; k < s->defaultCase->nbody; k++) self.expandStmtFlags(s->defaultCase->body[k]);
        }
    }
    void run()
    {
        // file attribute contract
        for (u32 i = 0; i < self.prog->nfattrs; i++)
        {
            str.strView a = self.prog->fattrs[i];
            if (vEq(a, "no_drop")) self.noDrop = true;
            if (vEq(a, "no_warn_unsafe")) self.noWarnUnsafe = true;
            if (veqPrefix(a, "forced")) self.forcedSkip = true;
        }

        // load imported modules so cross-file symbols (String::new,
        // strView::fromParts, ...) resolve against real declarations
        loader.Loader* ld = loader.loaderNew(self.exeDir);
        self.ld = ld;
        scopes.g_loaderForScopes = (void*)ld;
        ceval.reset();
        expr.constReset();
        for (u32 i = 0; i < self.prog->ndecls && i < 256; i++)
        {
            ast.Decl* d = self.prog->decls[i];
            if (d != null && d->kind == ast.DT_IMPORT)
            {
                if (d->importOrigin.len > 0) loader.loaderLoadLib(ld, d->text, self.exeDir);
                else loader.loaderLoad(ld, d->text, self.filename);
            }
        }

        // top-level scope + module table
        scopes.Scope* top = scopes.scopeNew(null, str.strView::fromCstr("file"), 0);
        scopes.ModuleTable* mods = scopes.modsNew();
        self.top = top;
        self.mods = mods;

        // the file is itself a module named after its basename; register it so
        // self-qualified references (mman.copy<...>) resolve to this file's own
        // top-level declarations
        {
            u32 s = 0;
            for (u32 i = 0; i < self.filename.len; i++)
                if (self.filename.ptr[i] == '/') s = i + 1;
            u32 en = self.filename.len;
            for (u32 i = s; i < self.filename.len; i++)
                if (self.filename.ptr[i] == '.') en = i;
            str.strView modName = str.strView::fromParts(self.filename.ptr + s, en - s);
            scopes.Sym* msym = scopes.symNew(modName, scopes.SYM_MODULE, null, 0, 0);
            scopes.scopeDeclare(top, msym);
        }

// flag expansion + import inlining MUST precede declaration so every
    // visible symbol (including imported modules') is declared once.
            {
            ast.Decl** newDecls = mman.alloc<ast.Decl*>(self.prog->ndecls * 4 + 4);
            u32 newN = 0;
            for (u32 i = 0; i < self.prog->ndecls; i++)
            {
                ast.Decl* d = self.prog->decls[i];
                if (d == null) continue;
                if (d->kind == ast.DT_FLAG)
                {
                    ast.Decl** body = null;
                    u32 nbody = 0;
                    str.strView sel = self.flagValue(d->name);
                    if (sel.len > 0)
                    {
                        u32 off = 0;
                        for (u32 ci = 0; ci < d->ncases; ci++)
                        {
                            if (vEqSV(d->caseNames[ci], sel)) { body = d->cases + off; nbody = d->caseLens[ci]; break; }
                            off += d->caseLens[ci];
                        }
                    } else if (d->defaultBody != null) { body = d->defaultBody; nbody = d->ndeclDefault; }
                    if (body != null) for (u32 k = 0; k < nbody; k++) if (body[k] != null) newDecls[newN++] = body[k];
                    continue;
                }
                newDecls[newN++] = d;
            }
            bool hadFlag = false;
            for (u32 i = 0; i < self.prog->ndecls; i++) if (self.prog->decls[i] != null && self.prog->decls[i]->kind == ast.DT_FLAG) { hadFlag = true; break; }
            if (hadFlag || newN != self.prog->ndecls)
            {
                if (self.prog->decls) mman.dealloc<ast.Decl*>(self.prog->decls);
                self.prog->decls = newDecls;
                self.prog->ndecls = newN;
            } else mman.dealloc<ast.Decl*>(newDecls);
        }
        {
            // Reachability closure (all modes: externs need resolving everywhere): seed with every name referenced by the
            // main file, then pull any imported decl whose name is referenced
            // (its own body pulls its private helpers transitively).
            UsedNames used;
            used.n = 0;
            used.nroots = 0;
            for (u32 i = 0; i < self.prog->ndecls; i++)
            {
                ast.Decl* d0 = self.prog->decls[i];
                if (d0 == null) continue;
                if (d0->kind == ast.DT_FUNC && d0->body != null) unStmt(&used, d0->body);
                else if (d0->value != null) unExpr(&used, d0->value);
            }
            bool anyUsed = used.n > 0;
            char seenBase[65536];
            u32 nSeen = 0;
            ast.Decl** pulled = mman.alloc<ast.Decl*>(4096);
            u32 nPulled = 0;
            // iterate to a fixpoint: a private helper defined BEFORE its pub
            // caller in the same file is only pullable on a later sweep, once
            // the caller sits in pulled[]. The exists-guard below keeps
            // re-sweeps from adding duplicates.
            bool progressed = true;
            u32 sweep = 0;
            while (progressed)
            {
                progressed = false;
                sweep++;
            for (u32 li = 0; li < ld->n; li++)
            {
                ast.Program* ip = ld->progs[li];
                if (ip == null) continue;
                // dedupe by basename: the same file can sit in ld twice under
                // different resolved paths (different import spellings). Only
                // tracked on the first sweep; later sweeps rely on the
                // exists-guard for dedupe so earlier-defined helpers get
                // reconsidered.
                if (sweep == 1)
                {
                    str.strView fn2 = ip->filename;
                    u32 bs = 0;
                    for (u32 c = 0; c < fn2.len; c++) if (fn2.ptr[c] == '/') bs = c + 1;
                    u32 bl = fn2.len - bs;
                    if (bl == 0 || bl > 95) continue;
                    bool seenF = false;
                    for (u32 k = 0; k < nSeen; k++)
                    {
                        u32 sl2 = 0;
                        while (seenBase[k * 96 + sl2] != 0) sl2++;
                        if (sl2 == bl && libc.memcmp((const void*)(seenBase + k * 96), (const void*)(fn2.ptr + bs), bl) == 0) { seenF = true; break; }
                    }
                    if (seenF) continue;
                    if (nSeen >= 682) continue;
                    libc.memcpy((void*)(seenBase + nSeen * 96), (const void*)(fn2.ptr + bs), bl);
                    seenBase[nSeen * 96 + bl] = 0;
                    nSeen++;
                }
                for (u32 k = 0; k < ip->ndecls; k++)
                {
                    ast.Decl* id = ip->decls[k];
                    if (id == null) continue;
                    if (id->kind != ast.DT_FUNC && id->kind != ast.DT_STRUCT && id->kind != ast.DT_ENUM && id->kind != ast.DT_TYPEDEF && id->kind != ast.DT_DISTINCT && id->kind != ast.DT_EXTERN && id->kind != ast.DT_VAR && id->kind != ast.DT_METHODBLOCK) continue;
                    if (id->kind == ast.DT_IMPORT) continue;
                    // generic templates may be pulled too: a pulled decl's
                    // body can call them (_fprintOne<T> behind print<T...>),
                    // and their own bodies then seed further helper pulls.
                    // Templates cost nothing: codegen skips standalone
                    // emission and mono emits only recorded instances.
                    if (anyUsed)
                    {
                        bool need = false;
                        unHas(&used, id->name, &need);
                        // private helpers of an already-pulled decl get pulled
                        // transitively in the fixpoint below; here only pub
                        // seeds match direct usage.
                        if (need && !id->exported) need = false;
                        if (!need)
                        {
                            for (u32 pk = 0; pk < nPulled; pk++)
                            {
                                unStmt(&used, pulled[pk]->body);
                                unExpr(&used, pulled[pk]->value);
                                unHas(&used, id->name, &need);
                                if (need) break;
                            }
                        }
                        if (!need) continue;
                    }
                    else if (!id->exported) continue;
                    bool exists = false;
                    for (u32 j = 0; j < self.prog->ndecls; j++) if (self.prog->decls[j] == id) { exists = true; break; }
                    // name-based dedupe: the same file can sit in ld under
                    // several resolved paths, yielding distinct Decl objects
                    // for identical decls; pulling both would redeclare.
                    if (!exists && id->name.len > 0 && id->name.len < 64)
                    {
                        for (u32 j = 0; j < self.prog->ndecls && !exists; j++)
                        {
                            ast.Decl* pj = self.prog->decls[j];
                            if (pj == null || pj->name.len != id->name.len) continue;
                            if (pj.kind == ast.DT_IMPORT) continue;
                            if (libc.memcmp((const void*)pj->name.ptr,
                                            (const void*)id->name.ptr,
                                            id->name.len) == 0) exists = true;
                        }
                    }
                    if (exists) continue;
                    ast.Decl** nd = mman.alloc<ast.Decl*>(self.prog->ndecls + 1);
                    for (u32 j = 0; j < self.prog->ndecls; j++) nd[j] = self.prog->decls[j];
                    nd[self.prog->ndecls] = id;
                    if (self.prog->decls) mman.dealloc<ast.Decl*>(self.prog->decls);
                    self.prog->decls = nd;
                    self.prog->ndecls++;
                    if (nPulled < 4096) pulled[nPulled++] = id;
                    progressed = true;
                }
                }
            }
        }
            // pass 1: declare all top-level symbols
        for (u32 i = 0; i < self.prog->ndecls; i++)
        {
            ast.Decl* d = self.prog->decls[i];
            if (d == null) continue;
            switch (d->kind)
            {
            case ast.DT_IMPORT:
                {
                    char rpath[512];
                    u32 rn = 0;
                    if (d->importOrigin.len > 0)
                        rn = loader.resolveLibImport(d->text, self.exeDir, rpath, 512);
                    else
                        rn = loader.resolveImport(d->text, self.filename, self.exeDir, rpath, 512);
                    str.String pb = str.String::new();
                    if (rn > 0) pb.pushView(str.strView::fromParts(rpath, rn));
                    scopes.modsAdd(mods, d->name,
                        rn > 0 ? str.strView::fromParts(pb.ptr, pb.len) : d->text);
                }
                if (scopes.scopeLookup(top, d->name) == null)
                    self.declareSym(top, d, scopes.SYM_MODULE, null);
                // Re-export flattening: a `pub mod X = import(...)` declared
                // inside an imported module is exposed to importers as
                // `alias.X` (Zig-style package root re-export).
                {
                    char apath[512];
                    u32 alen = 0;
                    if (d->importOrigin.len > 0)
                        alen = loader.resolveLibImport(d->text, self.exeDir, apath, 512);
                    else
                        alen = loader.resolveImport(d->text, self.filename, self.exeDir, apath, 512);
                    if (alen > 0)
                    {
                         ast.Program* ap = loader.loaderGet(ld, apath, alen);
                         if (ap != null)
                         {
                             for (u32 k = 0; k < ap->ndecls; k++)
                             {
                                 ast.Decl* rd = ap->decls[k];
                                 if (rd == null) continue;
                                 if ((rd->kind == ast.DT_MODULE || rd->kind == ast.DT_IMPORT) && rd->exported)
                                 {
                                     char sbuf[512];
                                     u32 slen = 0;
                                     if (rd->importOrigin.len > 0)
                                         slen = loader.resolveLibImport(rd->text, self.exeDir, sbuf, 512);
                                     else
                                         slen = loader.resolveImport(rd->text, str.strView::fromCstr(apath), self.exeDir, sbuf, 512);
                                      if (slen > 0)
                                      {
                                           loader.loaderLoad(ld, str.strView::fromParts(sbuf, slen), str.strView::fromCstr(apath));
                                           str.String al = str.String::new();
                                           al.pushView(d->name);
                                           al.pushChar('.');
                                           al.pushView(rd->name);
                                           str.String pb = str.String::new();
                                           pb.pushView(str.strView::fromParts(sbuf, slen));
                                           scopes.modsAdd(mods, str.strView::fromParts(al.ptr, al.len), str.strView::fromParts(pb.ptr, pb.len));
                                      }
                                 }
                            }
                        }
                    }
                }
                break;
            case ast.DT_MODULE:
            case ast.DT_NAMESPACE:
                self.declareSym(top, d, scopes.SYM_NS, null);
                break;
            case ast.DT_CONST:
                {
                    types.CType* ct = null;
                    if (d->type != null)
                        ct = scopes.resolveTypeExpr(d->type, top, mods, d->generics, d->ngenerics);
                    self.declareSym(top, d, scopes.SYM_CONST, ct);
                    break;
                }
            case ast.DT_VAR:
                {
                    types.CType* ct = null;
                    if (d->type != null)
                        ct = scopes.resolveTypeExpr(d->type, top, mods, d->generics, d->ngenerics);
                    self.declareSym(top, d, scopes.SYM_VAR, ct);
                    break;
                }
            case ast.DT_STRUCT:
                self.declareSym(top, d, scopes.SYM_STRUCT, null);
                break;
            case ast.DT_ENUM:
                self.declareSym(top, d, scopes.SYM_ENUM, null);
                break;
            case ast.DT_TRAIT:
                self.declareSym(top, d, scopes.SYM_TRAIT, null);
                break;
            case ast.DT_TYPEDEF:
                {
                    types.CType* under = d->type != null ? scopes.resolveTypeExpr(d->type, top, mods, null, 0) : null;
                    types.CType* t = scopes.namedType(d, d->name, d->line, d->col);
                    t->elem = under;
                    self.declareSym(top, d, scopes.SYM_TYPEDEF, t);
                    break;
                }
            case ast.DT_DISTINCT:
                {
                    types.CType* t = scopes.namedType(d, d->name, d->line, d->col);
                    self.declareSym(top, d, scopes.SYM_DISTINCT, t);
                    break;
                }
            case ast.DT_FUNC:
                self.declareSym(top, d, scopes.SYM_FUNC, null);
                break;
            case ast.DT_EXTERN:
                {
                    if (!d->isVar)
                    {
                        types.CType* sig = null;
                        expr.Typer t4 = self.typer(top, mods, ld);
                        sig = expr.fnSig(&t4, d);
                        self.declareSym(top, d, scopes.SYM_FUNC, sig);
                    }
                    else
                    {
                        types.CType* ct = null;
                        if (d->type != null)
                            ct = scopes.resolveTypeExpr(d->type, top, mods, null, 0);
                        self.declareSym(top, d, scopes.SYM_VAR, ct);
                    }
                    break;
                }
            case ast.DT_METHODBLOCK:
                break;
            case ast.DT_FLAG:
                {
                    // Compile-time configuration flag. The active case is:
                    //   1. the case matching the flag's supplied value (terminal
                    //      --flags, or the value the compiler was built with,
                    //      e.g. arch/platform), else
                    //   2. the `default` case (the only allowed fallback), else
                    //   3. an error: unresolved flag (no silent first-case pick).
                    ast.Decl** body = null;
                    u32 nbody = 0;
                    str.strView sel = self.flagValue(d->name);
                    if (sel.len > 0)
                    {
                        u32 off = 0;
                        for (u32 ci = 0; ci < d->ncases; ci++)
                        {
                            if (vEqSV(d->caseNames[ci], sel))
                            {
                                body = d->cases + off;
                                nbody = d->caseLens[ci];
                                break;
                            }
                            off += d->caseLens[ci];
                        }
                        if (body == null)
                        {
                            self.errDecl(d, str.strView::fromCstr("TC-RESOLVE"),
                                str.strView::fromCstr("unresolved flag '"), str.strView::empty());
                            str.String m = str.String::new();
                            m.pushView(d->name);
                            m.pushView(str.strView::fromCstr("': no case named '"));
                            m.pushView(sel);
                            m.pushView(str.strView::fromCstr("' (set it with --flags="));
                            m.pushView(d->name);
                            m.pushView(str.strView::fromCstr("=<case>)"));
                            self.errDecl(d, str.strView::fromCstr("TC-RESOLVE"),
                                str.strView::fromParts(m.ptr, m.len), str.strView::empty());
                            m.free();
                            break;
                        }
                    }
                    else if (d->defaultBody != null)
                    {
                        body = d->defaultBody;
                        nbody = d->ndeclDefault;
                    }
                    else
                    {
                        self.errDecl(d, str.strView::fromCstr("TC-RESOLVE"),
                            str.strView::fromCstr("unresolved flag '"), str.strView::empty());
                        str.String m = str.String::new();
                        m.pushView(d->name);
                        m.pushView(str.strView::fromCstr("': no default case and no value supplied (pass --flags="));
                        m.pushView(d->name);
                        m.pushView(str.strView::fromCstr("=<case> to the compiler)"));
                        self.errDecl(d, str.strView::fromCstr("TC-RESOLVE"),
                            str.strView::fromParts(m.ptr, m.len), str.strView::empty());
                        m.free();
                        break;
                    }
                    if (body != null)
                    {
                        for (u32 k = 0; k < nbody; k++)
                        {
                            ast.Decl* inner = body[k];
                            if (inner == null) continue;
                            if (inner->kind == ast.DT_FUNC)
                                self.declareSym(top, inner, scopes.SYM_FUNC, null);
                            else if (inner->kind == ast.DT_CONST)
                            {
                                types.CType* ct = null;
                                if (inner->type != null)
                                    ct = scopes.resolveTypeExpr(inner->type, top, mods, null, 0);
                                self.declareSym(top, inner, scopes.SYM_CONST, ct);
                            }
                            else if (inner->kind == ast.DT_VAR)
                            {
                                types.CType* ct = null;
                                if (inner->type != null)
                                    ct = scopes.resolveTypeExpr(inner->type, top, mods, null, 0);
                                self.declareSym(top, inner, scopes.SYM_VAR, ct);
                            }
                        }
                    }
                    break;
                }
            }
        }

        // pass 2: type-check const/var initializers and enum variant values
        for (u32 i = 0; i < self.prog->ndecls; i++)
        {
            ast.Decl* d = self.prog->decls[i];
            if (d == null) continue;
            expr.Typer t2 = self.typer(top, mods, ld);
            if (d->value != null && (d->kind == ast.DT_CONST || d->kind == ast.DT_VAR))
            {
                types.CType* vt = expr.typeExpr(&t2, d->value);
                if (vt != null)
                {
                    types.CType* ct = null;
                    if (d->type != null)
                        ct = scopes.resolveTypeExpr(d->type, top, mods, d->generics, d->ngenerics);
                    if (ct != null && !types.assignable(ct, vt, d->value->kind, d->value->text)
                        && !types.constFitsExpr(d->value, ct))
                    {
                        self.errDecl(d, str.strView::fromCstr("TC-ASSIGN"), str.strView::fromCstr("initializer for '"), str.strView::empty());
                        str.String msg = str.String::new();
                        msg.pushView(d->name);
                        msg.pushView(str.strView::fromCstr("' has type '"));
                        msg.pushView(types.typeName(vt));
                        msg.pushView(str.strView::fromCstr("', expected '"));
                        msg.pushView(types.typeName(ct));
                        msg.pushView(str.strView::fromCstr("' (no implicit conversion)"));
                        self.errDecl(d, str.strView::fromCstr("TC-ASSIGN"), str.strView::fromParts(msg.ptr, msg.len), str.strView::empty());
                        msg.free();
                    }
                }
                // constexpr: the initializer must be a compile-time constant
                if (d->isConstExpr)
                {
                    ceval.ConstVal cv;
                    if (!ceval.eval(d->value, &cv))
                    {
                        self.errDecl(d, str.strView::fromCstr("TC-CONSTEXPR"), str.strView::fromCstr("constexpr initializer for '"), str.strView::empty());
                        str.String m = str.String::new();
                        m.pushView(d->name);
                        m.pushView(str.strView::fromCstr("' is not a compile-time constant expression"));
                        self.errDecl(d, str.strView::fromCstr("TC-CONSTEXPR"), str.strView::fromParts(m.ptr, m.len), str.strView::empty());
                        m.free();
                    }
                    else
                    {
                        ceval.define(d->name, cv);
                    }
                }
            }
            else if (d->kind == ast.DT_ENUM)
            {
                for (u32 k = 0; k < d->nvariants; k++)
                {
                    if (d->variants[k].value != null)
                    {
                        expr.typeExpr(&t2, d->variants[k].value);
                    }
                }
            }
        }

        // pass 3: type function/method bodies
        expr.Typer t3 = self.typer(top, mods, ld);
        for (u32 i = 0; i < self.prog->ndecls; i++)
        {
            ast.Decl* d = self.prog->decls[i];
            if (d == null) continue;
            if (d->kind == ast.DT_FUNC)
            {
                // generic templates are typed only under mono substitution;
                // typing them here would resolve their bodies against the
                // MAIN file's scopes/mods and produce spurious errors
                if (d->ngenerics > 0 && d->structName.len == 0) continue;
                expr.typeFunction(&t3, d);
            }
            else if (d->kind == ast.DT_STRUCT)
            {
                for (u32 k = 0; k < d->ndecls; k++)
                {
                    ast.Decl* m = d->decls[k];
                    if (m != null && m->kind == ast.DT_FUNC) expr.typeFunction(&t3, m);
                }
            }
            else if (d->kind == ast.DT_METHODBLOCK)
            {
                for (u32 k = 0; k < d->ndecls; k++)
                {
                    ast.Decl* m = d->decls[k];
                    if (m != null && m->kind == ast.DT_FUNC) expr.typeFunction(&t3, m);
                }
            }
        }

        for (u32 i = 0; i < self.prog->ndecls; i++)
        {
            ast.Decl* d = self.prog->decls[i];
            if (d == null) continue;
            if (d->kind == ast.DT_FUNC && d->body != null) self.expandStmtFlags(d->body);
            else if (d->kind == ast.DT_STRUCT)
                for (u32 k = 0; k < d->ndecls; k++) if (d->decls[k] != null && d->decls[k]->body != null) self.expandStmtFlags(d->decls[k]->body);
            else if (d->kind == ast.DT_METHODBLOCK)
                for (u32 k = 0; k < d->ndecls; k++) if (d->decls[k] != null && d->decls[k]->body != null) self.expandStmtFlags(d->decls[k]->body);
        }
        // monomorphisation pass: specialize every concrete generic instantiation
        // discovered during body typing. Each generic Decl is re-typechecked
        // with its parameters bound to the concrete types (see mono/mono.crl).
        mono.run(&t3, top, mods, ld);

        // codegen dispatch (emit targets). Runs while the scope/mods are still
        // alive: resolveTypeExpr needs them, and run() frees `top` below.
        str.strView outPath = self.outputPath.len>0 ? self.outputPath : self.filename;
        // no artifacts from broken inputs
        if (self.nerrors > 0) { scopes.scopeFree(top); return; }
        if (self.emitMode == 1) codegen.emitH(self.prog, top, mods, outPath, self.debugBuild);
        else if (self.emitMode == 2) codegen.emitIR(self.prog, top, ld, mods, outPath, self.optLevel, self.debugBuild);
        else if (self.emitMode == 3) codegen.emitAsm(self.prog, top, ld, mods, outPath, self.optLevel, self.debugBuild, self.flagNames, self.flagVals, self.nflags);
        else if (self.emitMode == 0) {
            str.String exe = str.String::new();
            if (self.outputPath.len>0) exe.pushView(self.outputPath);
            else exe.pushCstr("a.out");
            str.String tmp = str.String::new();
            tmp.pushView(exe.asView()); tmp.pushCstr(".s");
            codegen.emitAsm(self.prog, top, ld, mods, strView::fromParts(tmp.ptr, tmp.len), self.optLevel, self.debugBuild, self.flagNames, self.flagVals, self.nflags);
            str.String cmd = str.String::new();
            cmd.pushCstr("gcc -o "); cmd.pushView(exe.asView()); cmd.pushCstr(" "); cmd.pushView(strView::fromParts(tmp.ptr, tmp.len));
            if (self.linkerFlags.len>0) { cmd.pushCstr(" "); cmd.pushView(self.linkerFlags); }
            cmd.pushCstr(" 2>&1");
            i32 r = libc.system(cmd.asCstr());
            if (r==0) {
                u8 ok[64]; i32 n = libc.snprintf(ok,64,"wrote %.*s (via gcc)\n", (int)exe.len, exe.ptr);
                if(n>0) libc.write(1, ok, (u64)n);
            } else {
                const char* m="gcc failed\n"; u64 n=0; while(m[n]) n++; libc.write(2,(u8*)m,n);
            }
            cmd.free(); tmp.free(); exe.free();
        }

        scopes.scopeFree(top);
    }
}

bool vEq(str.strView a, const char* b)
{
    u64 n = 0;
    while (b[n] != 0) n++;
    if (a.len != n) return false;
    return libc.memcmp((const void*)a.ptr, (const void*)b, n) == 0;
}

bool veqPrefix(str.strView a, const char* b)
{
    u64 n = 0;
    while (b[n] != 0) n++;
    if (a.len < n) return false;
    return libc.memcmp((const void*)a.ptr, (const void*)b, n) == 0;
}