// Output shape:
//   error[C0024]: <concise summary>
//     ┌─► <file>:<line>:<col>
//     │
//     │   <lineno> │ <source line>
//     │   <lineno> │ <source line>      (error line)
//     |                       ▲
//     │                       ╰─ <help / suggestion>
//
// Every diagnostic funnels through `diag`, which owns the formatting. Call
// sites report a stable CODE (e.g. "LEX-0001", "TC-0213") plus a location and
// an optional help line; error.crl renders everything.
mod str = import("std/text/string.crl");
mod libc = import("std/platform/libc.crl");

pub const u8 LVL_ERROR = 0;
pub const u8 LVL_WARN = 1;
pub const u8 LVL_INFO = 2;
pub const u8 LVL_NOTE = 3;

// Return the 1-based source line `line` as a view (without the newline).
strView extractLine(strView src, u32 line)
{
    u64 idx = 0;
    u32 cur = 1;
    while (cur < line && idx < src.len)
    {
        if (src.ptr[idx] == '\n') cur++;
        idx++;
    }
    if (cur < line) return strView::empty();
    u64 start = idx;
    while (idx < src.len && src.ptr[idx] != '\n') idx++;
    return strView::fromParts(src.ptr + start, idx - start);
}

void pushUint(str.String* s, u32 v)
{
    u8 tmp[20];
    i32 n = libc.snprintf(tmp, 20, "%u", v);
    if (n < 0) n = 0;
    if ((u64)n > 20) n = 20;
    s->pushView(strView::fromParts((const char*)tmp, (u64)n));
}

// Number of decimal digits needed to render `v`.
u32 digits(u32 v)
{
    u32 d = 1;
    while (v >= 10) { v /= 10; d++; }
    return d;
}

// Right-align `v` in a field of width `w` using spaces.
void pushPadUint(str.String* s, u32 v, u32 w)
{
    u32 d = digits(v);
    if (w > d) for (u32 i = 0; i < w - d; i++) s->pushChar(' ');
    pushUint(s, v);
}

// The primary diagnostic sink. `code` may be empty (then no `[CODE]` is
// shown). `help` may be empty (then no suggestion line is rendered).
pub void diag(strView code, strView filename, strView src, u32 line, u32 col,
              u8 level, strView msg, strView help)
{
    str.String s = str.String::new();

    // ANSI colour helpers (ESC byte 27 followed by a suffix; avoids \x in
    // string literals so the bootstrap compiler accepts them).
    u8 ESC = 27;
    strView C_RESET = strView::fromCstr("[0m");
    strView C_LEVEL = strView::fromCstr("[1;31m"); // error: bold red
    strView C_CODE  = strView::fromCstr("[35m");   // code: magenta
    strView C_BOX   = strView::fromCstr("[90m");   // box / gutter: grey
    strView C_CARET = strView::fromCstr("[1;31m"); // caret: bold red
    strView C_HELP  = strView::fromCstr("[36m");   // help: cyan
    if (level == LVL_WARN) C_LEVEL = strView::fromCstr("[33m");
    else if (level == LVL_INFO || level == LVL_NOTE) C_LEVEL = strView::fromCstr("[36m");

    // header: error[CODE]: msg  (or error: msg)
    s.pushChar((char)ESC);
    s.pushView(C_LEVEL);
    if (level == LVL_ERROR) s.pushView(strView::fromCstr("error"));
    else if (level == LVL_WARN) s.pushView(strView::fromCstr("warning"));
    else if (level == LVL_INFO) s.pushView(strView::fromCstr("info"));
    else s.pushView(strView::fromCstr("note"));
    if (code.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_CODE);
        s.pushChar('[');
        s.pushView(code);
        s.pushChar(']');
    }
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushView(strView::fromCstr(": "));
    s.pushView(msg);
    s.pushChar('\n');

    // location line
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  ┌─► "));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushView(filename);
    s.pushChar(':');
    pushUint(&s, line);
    s.pushChar(':');
    pushUint(&s, col);
    s.pushChar('\n');

    // blank gutter
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  │\n"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);

    u32 numW = digits(line);
    if (numW < 2) numW = 2;

    for (i32 off = -1; off <= 0; off++)
    {
        i32 ln = (i32)line + off;
        if (ln < 1) continue;
        strView lt = extractLine(src, (u32)ln);
        if (lt.len == 0 && off != 0) continue;

        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │ "));
        pushPadUint(&s, (u32)ln, numW);
        s.pushView(strView::fromCstr(" │ "));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushView(lt);
        s.pushChar('\n');
    }

    u32 prefixLen = 4 + numW + 3;
    i32 caretSpaces = (i32)prefixLen + (i32)col - 4;
    if (caretSpaces < 0) caretSpaces = 0;
    s.pushChar((char)ESC);
    s.pushView(C_BOX);
    s.pushView(strView::fromCstr("  |"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
    s.pushChar((char)ESC);
    s.pushView(C_CARET);
    s.pushView(strView::fromCstr("▲"));
    s.pushChar((char)ESC);
    s.pushView(C_RESET);
    s.pushChar('\n');

    // help / suggestion line
    if (help.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("╰─ "));
        s.pushChar((char)ESC);
        s.pushView(C_HELP);
        s.pushView(help);
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushChar('\n');
    }
    if (code.len > 0)
    {
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("  │"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        for (i32 i = 0; i < caretSpaces; i++) s.pushChar(' ');
        s.pushChar((char)ESC);
        s.pushView(C_BOX);
        s.pushView(strView::fromCstr("╰─ "));
        s.pushChar((char)ESC);
        s.pushView(strView::fromCstr("[90m"));
        s.pushView(strView::fromCstr("try `coralc --explain "));
        s.pushView(code);
        s.pushView(strView::fromCstr("` for more information"));
        s.pushChar((char)ESC);
        s.pushView(C_RESET);
        s.pushChar('\n');
    }

    libc.write(2, s.asU8(), s.len);
    s.free();
}

// Backward-compatible clang-style entry point. Renders the rich format with no
// code and `ctx` used as the help/suggestion line.
pub void reportLevel(strView filename, strView src, u32 line, u32 col, u8 level,
                     strView msg, strView ctx)
{
    diag(strView::empty(), filename, src, line, col, level, msg, ctx);
}

// Coded diagnostic entry point (preferred for new call sites).
pub void reportCode(strView code, strView filename, strView src, u32 line, u32 col,
                    u8 level, strView msg, strView help)
{
    diag(code, filename, src, line, col, level, msg, help);
}

pub void report(strView filename, strView src, u32 line, u32 col,
                strView msg, strView ctx)
{
    reportLevel(filename, src, line, col, LVL_ERROR, msg, ctx);
}

bool codeEq(strView a, const char* b) {
    u64 n=0; while(b[n]) n++;
    if (a.len!=n) return false;
    for (u64 i=0;i<n;i++) if(a.ptr[i]!= (u8)b[i]) return false;
    return true;
}
pub void explain(strView code)
{
    bool found = false;
    u8 ESC = 27;
    str.String s = str.String::new();
    s.pushChar((char)ESC); s.pushView(strView::fromCstr("[1m"));
    s.pushView(code);
    s.pushChar((char)ESC); s.pushView(strView::fromCstr("[0m"));
    s.pushView(strView::fromCstr(" — "));
    if (codeEq(code,"LEX-0001")) {
        s.pushView(strView::fromCstr("The lexer found a character it doesn't recognise as valid Coral syntax.\n\n"));
        s.pushView(strView::fromCstr("This usually means:\n"));
        s.pushView(strView::fromCstr("  - A stray symbol (e.g. `@`, `$`, `#`) outside a string or comment\n"));
        s.pushView(strView::fromCstr("  - An attempt to use `@[attr]` or `@name` syntax (not valid in Coral)\n\n"));
        s.pushView(strView::fromCstr("Attributes use double brackets: [[reorder]], [[packed]], or @[[no_warn_unsafe]] at file level.\n"));
        found = true;
    }
    else if (codeEq(code,"LEX-0003")) {
        s.pushView(strView::fromCstr("A string literal was opened but never closed before the end of the line.\n\n"));
        s.pushView(strView::fromCstr("Every `\"` needs a matching closing `\"` on the same line.\n"));
        s.pushView(strView::fromCstr("For multi-line strings, use triple quotes: \"\"\" ... \"\"\"\n"));
        found = true;
    }
    else if (codeEq(code,"LEX-0004")) {
        s.pushView(strView::fromCstr("The lexer could not parse this as a number.\n\n"));
        s.pushView(strView::fromCstr("Valid forms: 42, 0xFF, 0b1010, 0o777, 3.14, 42u, 42ul\n"));
        s.pushView(strView::fromCstr("Common mistakes: two decimal points (1.2.3), invalid digit for radix (0xGG), trailing comma.\n"));
        found = true;
    }
    else if (codeEq(code,"LEX-0005")) {
        s.pushView(strView::fromCstr("A char literal is malformed.\n\n"));
        s.pushView(strView::fromCstr("Char literals are single characters in single quotes: 'a', '\\n', '\\t'\n"));
        s.pushView(strView::fromCstr("Empty ('') or multi-character ('ab') literals are not allowed. Use \"a\" for strings.\n"));
        found = true;
    }
    else if (codeEq(code,"LEX-0006")) {
        s.pushView(strView::fromCstr("A /* block comment was opened but never closed with */ before end of file.\n\n"));
        s.pushView(strView::fromCstr("Add the closing */ or delete the opening /*.\n"));
        found = true;
    }
    else if (codeEq(code,"LEX-0007")) {
        s.pushView(strView::fromCstr("Invalid attribute syntax. Coral uses double brackets, not @-prefixed names.\n\n"));
        s.pushView(strView::fromCstr("Correct forms:\n"));
        s.pushView(strView::fromCstr("  [[reorder]]          on a struct declaration\n"));
        s.pushView(strView::fromCstr("  [[packed]]           on a struct declaration\n"));
        s.pushView(strView::fromCstr("  [[reorder, packed]]  combined on one line\n"));
        s.pushView(strView::fromCstr("  @[[no_warn_unsafe]]  at file level (first line)\n\n"));
        s.pushView(strView::fromCstr("@[name] and bare @name are NOT valid Coral syntax.\n"));
        found = true;
    }
    else if (codeEq(code,"SYN-1002")) {
        s.pushView(strView::fromCstr("The parser expected a closing '>' to match an opening '<'.\n\n"));
        s.pushView(strView::fromCstr("Generic argument lists look like <T> or <T, U> and must be closed with >.\n"));
        s.pushView(strView::fromCstr("Check that every < has a matching > nearby.\n"));
        found = true;
    }
    else if (codeEq(code,"SYN-1003")) {
        s.pushView(strView::fromCstr("The parser hit a token it didn't expect in this position.\n\n"));
        s.pushView(strView::fromCstr("At file level, valid declarations start with:\n"));
        s.pushView(strView::fromCstr("  mod, pub, struct, enum, trait, const, var, extern, import, flag\n\n"));
        s.pushView(strView::fromCstr("Inside functions, statements start with:\n"));
        s.pushView(strView::fromCstr("  var, return, if, for, while, loop, switch, defer, break, continue\n"));
        found = true;
    }
    else if (codeEq(code,"SYN-1998")) {
        s.pushView(strView::fromCstr("The parser couldn't parse this as a valid declaration.\n\n"));
        s.pushView(strView::fromCstr("Common causes:\n"));
        s.pushView(strView::fromCstr("  - Missing semicolon after a field or variable\n"));
        s.pushView(strView::fromCstr("  - Missing () around parameters\n"));
        s.pushView(strView::fromCstr("  - Missing {} around a body\n"));
        found = true;
    }
    else if (codeEq(code,"SYN-1999")) {
        s.pushView(strView::fromCstr("The parser failed to produce a valid program from this input.\n\n"));
        s.pushView(strView::fromCstr("This usually means an unclosed brace, bracket, or parenthesis somewhere earlier in the file.\n"));
        s.pushView(strView::fromCstr("Try checking that every { has a matching }, and every ( has a matching ).\n"));
        found = true;
    }
    else if (codeEq(code,"TC-TYPE")) {
        s.pushView(strView::fromCstr("The compiler doesn't recognise this type name.\n\n"));
        s.pushView(strView::fromCstr("Built-in primitives:\n"));
        s.pushView(strView::fromCstr("  i8 i16 i32 i64  u8 u16 u32 u64  f32 f64\n"));
        s.pushView(strView::fromCstr("  bool char void isize usize\n\n"));
        s.pushView(strView::fromCstr("User-defined types must be declared before use:\n"));
        s.pushView(strView::fromCstr("  struct Name { ... }   enum Name { ... }\n"));
        s.pushView(strView::fromCstr("  typedef Name = ExistingType;\n"));
        s.pushView(strView::fromCstr("  distinct Name = ExistingType;\n\n"));
        s.pushView(strView::fromCstr("If the type lives in another module, import it first:\n"));
        s.pushView(strView::fromCstr("  mod m = import(lib, \"module_name\");\n"));
        found = true;
    }
    else if (codeEq(code,"TC-RETURN")) {
        s.pushView(strView::fromCstr("The return statement doesn't match the function's declared return type.\n\n"));
        s.pushView(strView::fromCstr("Three possible causes:\n\n"));
        s.pushView(strView::fromCstr("1. Void function returning a value:\n"));
        s.pushView(strView::fromCstr("   void foo() { return 42; }  ← wrong\n"));
        s.pushView(strView::fromCstr("   Fix: remove the value, or change return type\n\n"));
        s.pushView(strView::fromCstr("2. Non-void function missing a return:\n"));
        s.pushView(strView::fromCstr("   i32 foo() { }  ← no return statement\n"));
        s.pushView(strView::fromCstr("   Fix: add `return <value>;` on every path\n\n"));
        s.pushView(strView::fromCstr("3. Returned value's type ≠ declared return type:\n"));
        s.pushView(strView::fromCstr("   f64 foo() { return 42; }  ← 42 is int, not float\n"));
        s.pushView(strView::fromCstr("   Fix: cast explicitly: return 42.0;\n"));
        s.pushView(strView::fromCstr("   Note: distinct types need explicit casts both ways.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-ASSIGN")) {
        s.pushView(strView::fromCstr("The right-hand side's type doesn't match the left-hand side.\n\n"));
        s.pushView(strView::fromCstr("Coral has NO implicit conversions between different types.\n\n"));
        s.pushView(strView::fromCstr("What IS allowed:\n"));
        s.pushView(strView::fromCstr("  - Exact same type\n"));
        s.pushView(strView::fromCstr("  - Lossless integer widening (u8 → u32, i8 → i64)\n"));
        s.pushView(strView::fromCstr("  - Integer literal fitting target type\n\n"));
        s.pushView(strView::fromCstr("What is NOT allowed:\n"));
        s.pushView(strView::fromCstr("  - u32 → i32 (sign change)\n"));
        s.pushView(strView::fromCstr("  - distinct types without explicit cast\n\n"));
        s.pushView(strView::fromCstr("Fix: add an explicit cast `(T)expr` or change the value's type.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-ARGS")) {
        s.pushView(strView::fromCstr("A function call argument doesn't match its parameter.\n\n"));
        s.pushView(strView::fromCstr("Check:\n"));
        s.pushView(strView::fromCstr("  1. Number of arguments matches number of parameters\n"));
        s.pushView(strView::fromCstr("  2. Each argument's type matches its parameter's type exactly\n"));
        s.pushView(strView::fromCstr("  3. distinct-typed arguments need explicit casts\n\n"));
        s.pushView(strView::fromCstr("Example:\n"));
        s.pushView(strView::fromCstr("  fn take(u32 x) { }\n"));
        s.pushView(strView::fromCstr("  take(-1);       ← wrong: i32 literal doesn't fit u32\n"));
        s.pushView(strView::fromCstr("  take(1);         ← OK: fits u32\n"));
        found = true;
    }
    else if (codeEq(code,"TC-NONULL")) {
        s.pushView(strView::fromCstr("null was passed to a parameter marked [[nonull]].\n\n"));
        s.pushView(strView::fromCstr("The callee promises this pointer is never null.\n"));
        s.pushView(strView::fromCstr("Either add a null check before calling, or pass a real pointer.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-BORROW")) {
        s.pushView(strView::fromCstr("Two pointers may alias the same memory region while one is written to.\n\n"));
        s.pushView(strView::fromCstr("This is a conservative check. Three patterns trigger it:\n"));
        s.pushView(strView::fromCstr("  - Two pointer args to one call point to the same data\n"));
        s.pushView(strView::fromCstr("  - A load stays live across a call that writes through a pointer\n"));
        s.pushView(strView::fromCstr("  - A store happens while an earlier load is still needed\n\n"));
        s.pushView(strView::fromCstr("Fix: copy the value, use separate allocations, or reorder operations.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-ACCESS")) {
        s.pushView(strView::fromCstr("You tried to access a module member that isn't exported.\n\n"));
        s.pushView(strView::fromCstr("Only declarations marked `pub` are visible outside their module:\n"));
        s.pushView(strView::fromCstr("  pub struct Foo { }     ← visible\n"));
        s.pushView(strView::fromCstr("  struct Bar { }          ← private\n\n"));
        s.pushView(strView::fromCstr("Also check that the module alias is correct and imported.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-ARITH")) {
        s.pushView(strView::fromCstr("Arithmetic applied to incompatible or non-numeric operands.\n\n"));
        s.pushView(strView::fromCstr("+ - * / %% require numeric types (integers or floats).\n"));
        s.pushView(strView::fromCstr("& | ^ << >> require integers.\n"));
        s.pushView(strView::fromCstr("distinct types don't implicitly convert — cast first.\n\n"));
        s.pushView(strView::fromCstr("Example:\n"));
        s.pushView(strView::fromCstr("  distinct Meters = u64;\n"));
        s.pushView(strView::fromCstr("  distinct Feet = u64;\n"));
        s.pushView(strView::fromCstr("  m + f  ← error: can't mix Meters and Feet\n"));
        s.pushView(strView::fromCstr("  m + (Meters)f  ← OK after explicit cast\n"));
        found = true;
    }
    else if (codeEq(code,"TC-COND")) {
        s.pushView(strView::fromCstr("An if/while/for condition must be bool.\n\n"));
        s.pushView(strView::fromCstr("Coral does NOT allow integers as implicit conditions:\n"));
        s.pushView(strView::fromCstr("  if (x)      ← error when x is int\n"));
        s.pushView(strView::fromCstr("  if (x != 0) ← correct\n\n"));
        s.pushView(strView::fromCstr("Valid condition operators: == != < > <= >= && || !\n"));
        found = true;
    }
    else if (codeEq(code,"TC-DUP")) {
        s.pushView(strView::fromCstr("Two parameters in the same function have the same name.\n\n"));
        s.pushView(strView::fromCstr("Rename one of them.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-ENUM")) {
        s.pushView(strView::fromCstr("The named variant doesn't exist in this enum.\n\n"));
        s.pushView(strView::fromCstr("Check spelling against the enum definition:\n"));
        s.pushView(strView::fromCstr("  enum Color { Red, Green, Blue }\n"));
        s.pushView(strView::fromCstr("  Color.Red ✓   Color.redd ✗\n"));
        found = true;
    }
    else if (codeEq(code,"TC-EXPR")) {
        s.pushView(strView::fromCstr("An expression's result type doesn't fit where it's used.\n\n"));
        s.pushView(strView::fromCstr("Common causes:\n"));
        s.pushView(strView::fromCstr("  - Mixing int and float without cast\n"));
        s.pushView(strView::fromCstr("  - Using void call result in an expression\n"));
        s.pushView(strView::fromCstr("  - Type mismatch between operands of a binary operator\n\n"));
        s.pushView(strView::fromCstr("Add an explicit cast or fix the operand types.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-INDEX")) {
        s.pushView(strView::fromCstr("Array index out of bounds, or indexing something that isn't indexable.\n\n"));
        s.pushView(strView::fromCstr("For fixed arrays arr[N], index must be 0..N-1.\n"));
        s.pushView(strView::fromCstr("Only arrays, slices, and pointers can be indexed.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-MEMBER")) {
        s.pushView(strView::fromCstr("The struct/enum/module doesn't have a member by this name.\n\n"));
        s.pushView(strView::fromCstr("Check:\n"));
        s.pushView(strView::fromCstr("  1. Spelling of the field/method name\n"));
        s.pushView(strView::fromCstr("  2. The field exists in the struct definition\n"));
        s.pushView(strView::fromCstr("  3. For methods: the method is defined on this struct\n"));
        s.pushView(strView::fromCstr("  4. If accessing across modules: the member is pub\n"));
        found = true;
    }
    else if (codeEq(code,"TC-REDECL")) {
        s.pushView(strView::fromCstr("This name is already used in the current scope.\n\n"));
        s.pushView(strView::fromCstr("Each scope can only have one declaration per name:\n"));
        s.pushView(strView::fromCstr("  i32 x = 1;\n"));
        s.pushView(strView::fromCstr("  i32 x = 2;  ← error: x already declared\n\n"));
        s.pushView(strView::fromCstr("Shadowing in nested scopes is allowed:\n"));
        s.pushView(strView::fromCstr("  i32 x = 1;\n"));
        s.pushView(strView::fromCstr("  { i32 x = 2; }  ← OK: inner scope\n"));
        found = true;
    }
    else if (codeEq(code,"TC-RESOLVE")) {
        s.pushView(strView::fromCstr("The compiler can't find this name in any accessible scope.\n\n"));
        s.pushView(strView::fromCstr("Possible fixes:\n"));
        s.pushView(strView::fromCstr("  1. Check spelling — Coral is case-sensitive\n"));
        s.pushView(strView::fromCstr("  2. Import the module that defines it:\n"));
        s.pushView(strView::fromCstr("     mod m = import(lib, \"module\");\n"));
        s.pushView(strView::fromCstr("  3. Declare it before use\n"));
        s.pushView(strView::fromCstr("  4. If it's a struct method, verify the struct is in scope\n"));
        s.pushView(strView::fromCstr("  5. If it's inside a flag block, make sure the flag resolves\n"));
        found = true;
    }
    else if (codeEq(code,"TC-STRUCT")) {
        s.pushView(strView::fromCstr("A struct initializer references a field that doesn't exist, or a field's type doesn't match.\n\n"));
        s.pushView(strView::fromCstr("Struct literal syntax:\n"));
        s.pushView(strView::fromCstr("  Point p = Point { .x = 1, .y = 2 };\n\n"));
        s.pushView(strView::fromCstr("Every field name must match the struct definition exactly.\n"));
        found = true;
    }
    else if (codeEq(code,"TC-SWITCH")) {
        s.pushView(strView::fromCstr("A switch case value doesn't match the switch subject's type.\n\n"));
        s.pushView(strView::fromCstr("All case values must be the same type as the thing being switched on:\n"));
        s.pushView(strView::fromCstr("  switch(x) { case 1: ... }  ← 1 must be same type as x\n"));
        found = true;
    }
    else if (codeEq(code,"TC-UNUSED")) {
        s.pushView(strView::fromCstr("This variable is declared but never read anywhere.\n\n"));
        s.pushView(strView::fromCstr("This is a WARNING, not an error — your program still compiles.\n\n"));
        s.pushView(strView::fromCstr("To silence it:\n"));
        s.pushView(strView::fromCstr("  - Remove the variable if you don't need it\n"));
        s.pushView(strView::fromCstr("  - Prefix with _ (_count) to indicate intentional discard\n"));
        s.pushView(strView::fromCstr("  - Or just ignore the warning\n"));
        found = true;
    }
    else if (codeEq(code,"TC-CONSTEXPR")) {
        s.pushView(strView::fromCstr("A constexpr initializer must evaluate at compile time.\n\n"));
        s.pushView(strView::fromCstr("Only literals and constant expressions qualify:\n"));
        s.pushView(strView::fromCstr("  constexpr u32 N = 42;       ← OK\n"));
        s.pushView(strView::fromCstr("  constexpr u32 M = N * 2;    ← OK\n"));
        s.pushView(strView::fromCstr("  constexpr u32 X = some_fn(); ← error: runtime call\n"));
        found = true;
    }

    if (!found) {
        s.pushView(strView::fromCstr("No explanation available for this code.\n\n"));
        s.pushView(strView::fromCstr("Available codes:\n"));
        s.pushView(strView::fromCstr("  LEX-0001  LEX-0003  LEX-0004  LEX-0005  LEX-0006  LEX-0007\n"));
        s.pushView(strView::fromCstr("  SYN-1002  SYN-1003  SYN-1998  SYN-1999\n"));
        s.pushView(strView::fromCstr("  TC-TYPE TC-RETURN TC-ASSIGN TC-ARGS TC-NONULL TC-BORROW\n"));
        s.pushView(strView::fromCstr("  TC-ACCESS TC-ARITH TC-COND TC-DUP TC-ENUM TC-EXPR TC-INDEX\n"));
        s.pushView(strView::fromCstr("  TC-MEMBER TC-REDECL TC-RESOLVE TC-STRUCT TC-SWITCH\n"));
        s.pushView(strView::fromCstr("  TC-UNUSED TC-CONSTEXPR\n"));
    }
    s.pushChar('\n');
    libc.write(1, s.asU8(), s.len);
    s.free();
}
