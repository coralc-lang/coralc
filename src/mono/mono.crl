// Monomorphisation driver. Consumes the instantiation registry populated by
// `subst.record` (called from expr.typeCall) and, for each concrete
// instantiation, re-typechecks the generic declaration with its generic
// parameters bound to the concrete types (via subst.push). This both validates
// the specialized body and (later) supplies the concrete function objects that
// codegen will emit. Comptime branch pruning is layered on top afterwards.
//
// Runs unconditionally as part of the typecheck pass: generic code is always
// specialized so the compiler is ready for codegen.

mod ast = import("ast/ast.crl");
mod types = import("typecheck/types.crl");
mod scopes = import("typecheck/scopes.crl");
mod expr = import("typecheck/expr.crl");
mod subst = import("subst");
mod loader = import("typecheck/loader.crl");
mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");

// Process every recorded instantiation to a fixpoint: instantiating a generic
// may record further (transitive) instantiations through nested generic calls.
bool strEqSV2(str.strView a, str.strView b)
{
    if (a.len != b.len) return false;
    for (u32 i = 0; i < a.len; i++) if (a.ptr[i] != b.ptr[i]) return false;
    return true;
}

pub void run(expr.Typer* base, scopes.Scope* top, scopes.ModuleTable* mods, loader.Loader* ld)
{
    u32 processed = 0;
    while (processed < subst.gNInsts)
    {
        subst.MonoInst* it = null;
        for (u32 i = 0; i < subst.gNInsts; i++)
        {
            subst.MonoInst* c = subst.instAt(i);
            if (c != null && !c->done) { it = c; break; }
        }
        if (it == null) break;
        it->done = true;
        if (libc.getenv("CORAL_DEBUG_VARIADIC") != null)
        {
            char dbm[96];
            i32 dnm = libc.snprintf(dbm, 96, "[mono] g=%.*s nt=%u ng=%u\n",
                (int)it.g.name.len, it.g.name.ptr, it.nt, it.g.ngenerics);
            if (dnm > 0) libc.write(2, dbm, (u64)dnm);
        }

        // generic parameters live on the OWNING STRUCT for methods
        str.strView* gnames2 = it->g->generics;
        u32 ng2 = it->g->ngenerics;
        ast.Decl* owner2 = null;
        if (it->g->structName.len > 0)
        {
            for (u32 pi9 = 0; pi9 < base->prog->ndecls; pi9++)
            {
                ast.Decl* cd9 = base->prog->decls[pi9];
                if (cd9 != null && cd9.kind == ast.DT_STRUCT && strEqSV2(cd9.name, it->g->structName)) { owner2 = cd9; break; }
            }
            if (owner2 == null && ld != null)
            {
                for (u32 pi9 = 0; pi9 < ld->n; pi9++)
                {
                    ast.Program* pp9 = ld->progs[pi9];
                    if (pp9 == null) continue;
                    bool brk9 = false;
                    for (u32 di9 = 0; di9 < pp9->ndecls; di9++)
                    {
                        ast.Decl* cd9 = pp9->decls[di9];
                        if (cd9 != null && cd9.kind == ast.DT_STRUCT && strEqSV2(cd9.name, it->g->structName)) { owner2 = cd9; brk9 = true; break; }
                    }
                    if (brk9) break;
                }
            }
            if (owner2 != null) { gnames2 = owner2.generics; ng2 = owner2.ngenerics; }
        }
        // comptime-variadic instances: bind the single generic T to the WHOLE
        // pack (a tuple of the per-call-site argument types), not to targ[0].
        if (it->g->variadic && it->g->ngenerics >= 1 && it->nt > 0)
        {
            types.CType* pk = types.packType(it->targs, it->nt, 0, 0);
            types.CType** one = mman.alloc<types.CType*>(1);
            one[0] = pk;
            subst.push(gnames2, one, 1);
        }
        else subst.push(gnames2, it->targs, ng2 > it->nt ? it->nt : ng2);
        if (it->nc > 0 && ng2 >= it->nc)
        {
            str.strView cn[16];
            u64 cv[16];
            u32 base = ng2 - it->nc;
            for (u32 k = 0; k < it->nc && k < 16; k++)
            {
                cn[k] = gnames2[base + k];
                cv[k] = it->cvals[k];
            }
            subst.pushConsts(cn, cv, it->nc);
        }
        expr.Typer t = expr.Typer::new(base->prog, base->src, base->filename,
                                       top, mods, ld, base->nerrors, base->nwarnings,
                                       base->noWarnUnsafe, base->forcedSkip);
        t.warnUnused = false; // avoid duplicate unused-var diagnostics
        expr.typeFunction(&t, it->g);
        subst.pop();
        processed++;
    }
}