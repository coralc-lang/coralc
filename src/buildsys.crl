// Project build commands for the coral driver: -init/-new/-build/-run/-clean.
// A project is a directory containing `build.toml`:
//
//     name = "app"
//     main = "src/main.crl"   # default
//     # out = "app"           # default: name
//     # opt = 1               # 0..3
//
// Sources are discovered by walking import("relative/path.crl") edges from
// the manifest main file. import(lib, ...) references the compiler runtime
// and is not tracked. Build state lives in .coralb/.
//
// Compilation re-executes /proc/self/exe on the manifest main file so the
// driver pipeline stays defined in exactly one place.
//
// NOTE: this module is translated by the py bootstrap against the lib/
// tree, so it deliberately sticks to mman/str/libc only.

mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod libc = import("std/platform/libc.crl");
mod vec = import("std/collections/vec.crl);

pub struct FileEntry
{
    str.strView path;
    i64 mtime;
}

pub struct Manifest
{
    str.String name;
    str.String mainFile;
    str.String outName;
    u32 optLevel;
}

// x86-64 glibc stat layout (only mtime fields are consulted)
struct StatBuf
{
    u64 st_dev;
    u64 st_ino;
    u64 st_nlink;
    u32 st_mode;
    u32 st_uid;
    u32 st_gid;
    u32 pad0;
    u64 st_rdev;
    i64 st_size;
    i64 st_blksize;
    i64 st_blocks;
    i64 st_atime;
    i64 st_atimeNsec;
    i64 st_mtime;
    i64 st_mtimeNsec;
    i64 st_ctime;
    i64 st_ctimeNsec;
    i64 reserved[3];
}

static void writeOut(const char* s)
{
    u64 n = 0;
    while (s[n]) n++;
    libc.write(1, (const u8*)s, n);
}

static void writeErrStr(const char* s)
{
    u64 n = 0;
    while (s[n]) n++;
    libc.write(2, (const u8*)s, n);
}

static void writeU64Dec(u64 v)
{
    char cnt[24];
    u32 cn = 0;
    if (v == 0) { cnt[cn++] = '0'; }
    else { u8 rev[24]; u32 rr = 0; u64 t = v; while (t > 0) { rev[rr++] = (u8)('0' + (t % 10)); t /= 10; } while (rr > 0) cnt[cn++] = rev[--rr]; }
    libc.write(1, cnt, cn);
}

static void pushU64Dec(str.String* s, u64 v)
{
    if (v == 0) { s.pushChar('0'); return; }
    u8 rev[24];
    u32 rr = 0;
    u64 t = v;
    while (t > 0) { rev[rr++] = (u8)('0' + (t % 10)); t /= 10; }
    while (rr > 0) { rr--; s.pushByte(rev[rr]); }
}

static bool svEq(str.strView a, str.strView b)
{
    if (a.len != b.len) return false;
    for (u32 i = 0; i < a.len; i++)
        if (a.ptr[i] != b.ptr[i]) return false;
    return true;
}

static bool svEqC(str.strView a, const char* b)
{
    return svEq(a, str.strView::fromCstr(b));
}

static str.strView strViewOf(const str.String* s)
{
    return str.strView::fromParts(s->ptr, s->len);
}

static str.strView trimSp(str.strView v)
{
    u32 b = 0;
    u32 e = v.len;
    while (b < e && (v.ptr[b] == ' ' || v.ptr[b] == '\t' || v.ptr[b] == '\r')) b++;
    while (e > b && (v.ptr[e - 1] == ' ' || v.ptr[e - 1] == '\t' || v.ptr[e - 1] == '\r')) e--;
    return str.strView::fromParts(v.ptr + b, e - b);
}

static str.String concatViews(str.strView a, str.strView b)
{
    str.String r = str.String::withCap(a.len + b.len);
    r.appendView(a);
    r.appendView(b);
    return r;
}

static str.String dirNameOf(str.strView path)
{
    u32 last = 0;
    bool any = false;
    for (u32 i = 0; i < path.len; i++)
        if (path.ptr[i] == '/') { last = i; any = true; }
    if (!any) return str.String::fromCstr(".");
    return concatViews(str.strView::fromParts(path.ptr, last), str.strView::fromCstr(""));
}

static str.String joinPath(str.strView dir, str.strView base)
{
    if (dir.len == 0) return str.String::fromView(base);
    if (dir.ptr[dir.len - 1] == '/') return concatViews(dir, base);
    str.String r = str.String::withCap(dir.len + 1 + base.len);
    r.appendView(dir);
    r.pushChar('/');
    r.appendView(base);
    return r;
}

// path helpers: NUL-terminated copies for libc calls
static void toCbuf(char* buf, u64 cap, str.strView path)
{
    u64 n = path.len < cap - 1 ? path.len : cap - 1;
    for (u64 k = 0; k < n; k++) buf[k] = (char)path.ptr[k];
    buf[n] = 0;
}

static bool fileExistsP(str.strView path)
{
    char buf[4096];
    toCbuf(buf, 4096, path);
    return libc.access(buf, 0) == 0;
}

static i64 statMtime(str.strView path)
{
    char buf[4096];
    toCbuf(buf, 4096, path);
    StatBuf sb;
    u8* p = (u8*)&sb;
    for (u32 k = 0; k < (u32)sizeof(StatBuf); k++) p[k] = 0;
    if (libc.stat(buf, (void*)&sb) != 0) return -1;
    return sb.st_mtime * 1000000000 + sb.st_mtimeNsec;
}

static str.String readFileToStr(str.strView path)
{
    str.String r = str.String::new();
    char buf[4096];
    toCbuf(buf, 4096, path);
    void* f = libc.fopen(buf, "rb");
    if (f == null) return r;
    u8 chunk[4096];
    for (;;)
    {
        u64 got = libc.fread(chunk, 1, 4096, f);
        if (got == 0) break;
        for (u64 k = 0; k < got; k++) r.pushByte(chunk[k]);
    }
    libc.fclose(f);
    return r;
}

static bool writeFileFromStr(str.strView path, const str.String* data)
{
    char buf[4096];
    toCbuf(buf, 4096, path);
    void* f = libc.fopen(buf, "wb");
    if (f == null) return false;
    str.strView dv = strViewOf(&data);
    if (dv.len > 0) libc.fwrite(dv.ptr, 1, dv.len, f);
    libc.fclose(f);
    return true;
}

static void mkdirP(str.strView path)
{
    if (path.len == 0) return;
    StatBuf sb;
    char buf[4096];
    toCbuf(buf, 4096, path);
    if (libc.stat(buf, (void*)&sb) == 0) return;
    // create parent components first
    for (u32 i = 1; i < path.len; i++)
    {
        if (path.ptr[i] != '/') continue;
        char part[4096];
        for (u32 k = 0; k < i; k++) part[k] = (char)path.ptr[k];
        part[i] = 0;
        libc.mkdir(part, 493);
    }
    libc.mkdir(buf, 493);
}

static void deleteFileP(str.strView path)
{
    char buf[4096];
    toCbuf(buf, 4096, path);
    libc.unlink(buf);
}

// manifest

static bool loadManifest(Manifest* m)
{
    m.name = str.String::fromCstr("");
    m.mainFile = str.String::fromCstr("src/main.crl");
    m.outName = str.String::fromCstr("");
    m.optLevel = 1;
    if (!fileExistsP(str.strView::fromCstr("build.toml")))
    {
        writeErrStr("coral: no build.toml found in current directory\n");
        return false;
    }
    str.String text = readFileToStr(str.strView::fromCstr("build.toml"));
    // flat TOML subset: key = "string" | integer ; '#' comments
    str.strView v = strViewOf(&text);
    u32 lineStart = 0;
    for (u32 i = 0; i <= v.len; i++)
    {
        if (i != v.len && v.ptr[i] != '\n') continue;
        str.strView line = trimSp(str.strView::fromParts(v.ptr + lineStart, i - lineStart));
        lineStart = i + 1;
        if (line.len == 0 || line.ptr[0] == '#') continue;
        u32 eq = 0;
        bool foundEq = false;
        for (u32 k = 0; k < line.len; k++)
            if (line.ptr[k] == '=') { eq = k; foundEq = true; break; }
        if (!foundEq) continue;
        str.strView key = trimSp(str.strView::fromParts(line.ptr, eq));
        str.strView val = trimSp(str.strView::fromParts(line.ptr + eq + 1, line.len - eq - 1));
        bool quoted = val.len >= 2 && val.ptr[0] == 34 && val.ptr[val.len - 1] == 34;
        if (quoted) val = str.strView::fromParts(val.ptr + 1, val.len - 2);
        if (svEqC(key, "name") && quoted) m.name = str.String::fromView(val);
        else if (svEqC(key, "main") && quoted) m.mainFile = str.String::fromView(val);
        else if (svEqC(key, "out") && quoted) m.outName = str.String::fromView(val);
        else if (svEqC(key, "opt") && !quoted)
        {
            if (val.len == 1 && val.ptr[0] >= '0' && val.ptr[0] <= '3')
                m.optLevel = (u32)(val.ptr[0] - '0');
        }
    }
    if (m.name.len == 0) m.name = str.String::fromCstr("app");
    if (m.outName.len == 0) m.outName = str.String::fromView(strViewOf(&m.name));
    return true;
}

// source discovery

static void addUnique(vec.vec<FileEntry>* files, vec.vec<str.String>* seen, str.String path)
{
    for (u32 i = 0; i < seen.count(); i++)
        if (svEq(seen.at(i).asView(), strViewOf(&path))) return;
    seen.push(path);
    FileEntry fe;
    fe.path = strViewOf(&path);
    fe.mtime = statMtime(fe.path);
    files.push(fe);
}

// Extract the quoted target from import(...) argument text. Empty when this
// form is skipped: `lib, "..."` runtime imports, globs, extension-less
// package roots.
static str.strView extractImportTarget(str.strView argsText)
{
    u32 b = 0;
    while (b < argsText.len && argsText.ptr[b] == ' ') b++;
    if (b < argsText.len && argsText.ptr[b] != '"')
    {
        // an origin identifier precedes the path: compiler-runtime reference
        return str.strView::empty();
    }
    if (b >= argsText.len || argsText.ptr[b] != '"') return str.strView::empty();
    b++;
    u32 e = b;
    while (e < argsText.len && argsText.ptr[e] != '"') e++;
    if (e >= argsText.len) return str.strView::empty();
    str.strView t = str.strView::fromParts(argsText.ptr + b, e - b);
    bool glob = false;
    bool hasDot = false;
    for (u32 k = 0; k < t.len; k++)
    {
        if (t.ptr[k] == '*') glob = true;
        if (t.ptr[k] == '.') hasDot = true;
    }
    if (glob || !hasDot) return str.strView::empty();
    return t;
}

static void collectSources(str.strView filePath, vec.vec<FileEntry>* files, vec.vec<str.String>* visited)
{
    for (u32 i = 0; i < visited.count(); i++)
        if (svEq(visited.at(i).asView(), filePath)) return;

    addUnique(files, visited, str.String::fromView(filePath));

    str.String text = readFileToStr(filePath);
    str.strView v = strViewOf(&text);
    str.String dir = dirNameOf(filePath);

    u32 i = 0;
    while (i + 7 <= v.len)
    {
        bool isImp = v.ptr[i] == 'i' && v.ptr[i+1] == 'm' && v.ptr[i+2] == 'p'
                  && v.ptr[i+3] == 'o' && v.ptr[i+4] == 'r' && v.ptr[i+5] == 't'
                  && v.ptr[i+6] == '(' ;
        if (!isImp) { i++; continue; }
        u32 start = i + 7;
        u32 depth = 1;
        u32 end = start;
        while (end < v.len && depth > 0)
        {
            if (v.ptr[end] == '(') depth++;
            else if (v.ptr[end] == ')') depth--;
            end++;
        }
        if (end <= start) { i = end; continue; }
        str.strView argsText = str.strView::fromParts(v.ptr + start, end - 1 - start);
        str.strView target = extractImportTarget(argsText);
        if (target.len > 0)
        {
            str.String full = joinPath(strViewOf(&dir), target);
            if (!fileExistsP(strViewOf(&full)))
            {
                str.String withExt = concatViews(strViewOf(&full), str.strView::fromCstr(".crl"));
                if (fileExistsP(strViewOf(&withExt))) full = withExt;
                else full.len = 0;
            }
            if (full.len > 0)
                collectSources(strViewOf(&full), files, visited);
        }
        i = end;
    }
}

// ---------------------------------------------------------------- cache

static str.String cachePath()
{
    return str.String::fromCstr(".coralb/cache.txt");
}

static u64 parseU64Local(str.strView sv)
{
    u64 val = 0;
    for (u32 k = 0; k < sv.len; k++)
    {
        u8 c = sv.ptr[k];
        if (c < '0' || c > '9') return 0;
        val = val * 10 + (u64)(c - '0');
    }
    return val;
}

static void loadCache(vec.vec<i64>* mtimes, vec.vec<str.String>* paths, i64* binTime)
{
    *binTime = 0;
    if (!fileExistsP(cachePath().asView())) return;
    str.String text = readFileToStr(cachePath().asView());
    str.strView v = strViewOf(&text);
    u32 lineStart = 0;
    u32 lineNo = 0;
    for (u32 i = 0; i <= v.len; i++)
    {
        if (i != v.len && v.ptr[i] != '\n') continue;
        str.strView line = trimSp(str.strView::fromParts(v.ptr + lineStart, i - lineStart));
        lineStart = i + 1;
        lineNo++;
        if (line.len == 0) continue;
        if (lineNo == 1) { *binTime = (i64)parseU64Local(line); continue; }
        u32 sp = 0;
        bool gotSp = false;
        for (u32 k = 0; k < line.len; k++)
            if (line.ptr[k] == ' ') { sp = k; gotSp = true; break; }
        if (!gotSp) continue;
        mtimes.push((i64)parseU64Local(str.strView::fromParts(line.ptr, sp)));
        paths.push(str.String::fromView(trimSp(str.strView::fromParts(line.ptr + sp + 1, line.len - sp - 1))));
    }
}

static void saveCache(i64 binTime, vec.vec<FileEntry>* files)
{
    str.String out = str.String::withCap(256);
    pushU64Dec(&out, binTime < 0 ? (u64)0 : (u64)binTime);
    out.pushChar('\n');
    for (u32 i = 0; i < files.count(); i++)
    {
        FileEntry fe = files.at(i);
        pushU64Dec(&out, fe.mtime < 0 ? (u64)0 : (u64)fe.mtime);
        out.pushChar(' ');
        out.appendView(fe.path);
        out.pushChar('\n');
    }
    writeFileFromStr(cachePath().asView(), &out);
}

static bool isUpToDate(vec.vec<FileEntry>* files, str.strView binPath)
{
    i64 binTime = statMtime(binPath);
    if (binTime < 0) return false;
    vec.vec<i64> cmt = vec.vec<i64>::new();
    vec.vec<str.String> cp = vec.vec<str.String>::new();
    i64 cachedBin = 0;
    loadCache(&cmt, &cp, &cachedBin);
    if (cmt.count() != files.count()) return false;
    if (cachedBin != binTime) return false;
    for (u32 i = 0; i < files.count(); i++)
    {
        FileEntry fe = files.at(i);
        bool found = false;
        for (u32 j = 0; j < cp.count(); j++)
        {
            if (svEq(cp.at(j).asView(), fe.path) && cmt.at(j) == fe.mtime)
            { found = true; break; }
        }
        if (!found) return false;
        if (fe.mtime > binTime) return false;
    }
    return true;
}

// ---------------------------------------------------------------- commands

static str.String binPathOf(const Manifest* m)
{
    return concatViews(str.strView::fromCstr(".coralb/bin/"), strViewOf(&m.outName));
}

// fork/execvp/waitpid without pipes: child inherits stdio directly.
static i32 runProgram(str.strView exe, vec.vec<str.strView>* args)
{
    u64 n = args.count();
    const u8** av = (const u8**)mman.alloc<u8*>(n + 2);
    av[0] = exe.ptr;
    for (u64 k = 0; k < n; k++) av[k + 1] = args.at(k).ptr;
    av[n + 1] = null;

    char ebuf[4096];
    toCbuf(ebuf, 4096, exe);
    i32 pid = libc.fork();
    if (pid < 0) return -1;
    if (pid == 0)
    {
        libc.execvp(ebuf, av);
        libc._exit(127);
    }
    i32 status = 0;
    libc.waitpid(pid, &status, 0);
    if ((status & 0x7f) != 0) return -1; // signaled
    return (status >> 8) & 0xff;
}

static i32 cmdBuild(bool quiet)
{
    Manifest m;
    if (!loadManifest(&m)) return 1;
    if (!fileExistsP(strViewOf(&m.mainFile)))
    {
        writeErrStr("coral: manifest main file missing\n");
        return 1;
    }
    vec.vec<FileEntry> files = vec.vec<FileEntry>::new();
    vec.vec<str.String> visited = vec.vec<str.String>::new();
    collectSources(strViewOf(&m.mainFile), &files, &visited);

    str.String bin = binPathOf(&m);
    if (isUpToDate(&files, strViewOf(&bin)))
    {
        if (!quiet) writeOut("up to date\n");
        return 0;
    }

    // re-execute ourselves on the manifest main file
    char exeBuf[512];
    i64 exeN = libc.readlink("/proc/self/exe", exeBuf, 512);
    if (exeN <= 0 || exeN >= 512)
    {
        writeErrStr("coral: cannot resolve own executable\n");
        return 1;
    }
    exeBuf[exeN] = 0;
    str.String exe = str.String::fromCstr(exeBuf);

    str.String optFlag = concatViews(str.strView::fromCstr("-O"), str.strView::empty());
    pushU64Dec(&optFlag, m.optLevel);
    str.String oVal = concatViews(str.strView::fromCstr("-o"), strViewOf(&bin));

    vec.vec<str.strView> args = vec.vec<str.strView>::new();
    args.push(strViewOf(&m.mainFile));
    args.push(strViewOf(&optFlag));
    args.push(strViewOf(&oVal));

    writeOut("[coral] building ");
    writeOut(strViewOf(&m.name).ptr);
    writeOut(" (");
    writeU64Dec(files.count());
    writeOut(" files)\n");

    i32 code = runProgram(strViewOf(&exe), &args);
    if (code != 0) return code;

    saveCache(statMtime(strViewOf(&bin)), &files);
    writeOut("[coral] built ");
    writeOut(strViewOf(&bin).ptr);
    writeOut("\n");
    return 0;
}

static str.String scaffoldToml(str.strView projName)
{
    str.String mf = str.String::withCap(96);
    mf.appendView(str.strView::fromCstr("name = "));
    mf.pushChar(34);
    mf.appendView(projName);
    mf.pushChar(34);
    mf.appendView(str.strView::fromCstr("\nmain = "));
    mf.pushChar(34);
    mf.appendView(str.strView::fromCstr("src/main.crl"));
    mf.pushChar(34);
    mf.appendView(str.strView::fromCstr("\n# opt = 1   # 0..3\n"));
    return mf;
}

static str.String scaffoldMain()
{
    str.String src = str.String::withCap(160);
    src.appendView(str.strView::fromCstr("mod std = import(lib, "));
    src.pushChar(34);
    src.appendView(str.strView::fromCstr("std"));
    src.pushChar(34);
    src.appendView(str.strView::fromCstr(")\n\ni32 main()\n{\n    std.ios.nprint("));
    src.pushChar(34);
    src.appendView(str.strView::fromCstr("hello from coral\\n"));
    src.pushChar(34);
    src.appendView(str.strView::fromCstr(")\n    return 0\n}\n"));
    return src;
}

static i32 cmdInit(bool makeNew, str.strView nameArg)
{
    str.String projName = str.String::fromCstr("app");
    if (makeNew)
    {
        if (nameArg.len == 0)
        {
            writeErrStr("coral: -new requires a project name\n");
            return 1;
        }
        projName = str.String::fromView(nameArg);
        mkdirP(nameArg);
        mkdirP(joinPath(nameArg, str.strView::fromCstr("src")).asView());
        char pbuf[4096];
        toCbuf(pbuf, 4096, nameArg);
        if (libc.chdir(pbuf) != 0)
        {
            writeErrStr("coral: cannot enter project directory\n");
            return 1;
        }
    }
    else
    {
        mkdirP(str.strView::fromCstr("src"));
    }

    if (fileExistsP(str.strView::fromCstr("build.toml")))
    {
        writeErrStr("coral: build.toml already exists here\n");
        return 1;
    }

    str.String mf = scaffoldToml(strViewOf(&projName));
    writeFileFromStr(str.strView::fromCstr("build.toml"), &mf);

    str.String src = scaffoldMain();
    writeFileFromStr(str.strView::fromCstr("src/main.crl"), &src);

    if (makeNew) writeOut("[coral] created project\n");
    else writeOut("[coral] initialized project\n");
    return 0;
}

static i32 cmdRun(u32 argc, char** argv)
{
    i32 rc = cmdBuild(false);
    if (rc != 0) return rc;
    Manifest m;
    loadManifest(&m);
    str.String bin = binPathOf(&m);
    if (!fileExistsP(strViewOf(&bin)))
    {
        writeErrStr("coral: binary not found after build\n");
        return 1;
    }
    vec.vec<str.strView> args = vec.vec<str.strView>::new();
    bool afterDash = false;
    for (u32 i = 2; i < argc; i++)
    {
        str.strView a = str.strView::fromCstr(argv[i]);
        if (!afterDash && svEq(a, str.strView::fromCstr("--"))) { afterDash = true; continue; }
        if (afterDash) args.push(a);
    }
    return runProgram(strViewOf(&bin), &args);
}

static i32 cmdClean()
{
    Manifest m;
    if (!loadManifest(&m)) return 1;
    str.String bin = binPathOf(&m);
    deleteFileP(strViewOf(&bin));
    deleteFileP(cachePath().asView());
    writeOut("[coral] cleaned\n");
    return 0;
}

// ---------------------------------------------------------------- dispatch

pub bool isBuildCommand(char** argv)
{
    if (argv[1] == null) return false;
    str.strView a = str.strView::fromCstr(argv[1]);
    if (a.len < 2 || a.ptr[0] != '-') return false;
    if (svEq(a, str.strView::fromCstr("-init"))) return true;
    if (svEq(a, str.strView::fromCstr("-new"))) return true;
    if (svEq(a, str.strView::fromCstr("-build"))) return true;
    if (svEq(a, str.strView::fromCstr("-run"))) return true;
    if (svEq(a, str.strView::fromCstr("-clean"))) return true;
    return false;
}

pub i32 runCommand(u32 argc, char** argv)
{
    str.strView cmd = str.strView::fromCstr(argv[1]);
    if (svEq(cmd, str.strView::fromCstr("-init"))) return cmdInit(false, str.strView::empty());
    if (svEq(cmd, str.strView::fromCstr("-new")))
        return cmdInit(true, argc > 2 ? str.strView::fromCstr(argv[2]) : str.strView::empty());
    if (svEq(cmd, str.strView::fromCstr("-build"))) return cmdBuild(false);
    if (svEq(cmd, str.strView::fromCstr("-run"))) return cmdRun(argc, argv);
    if (svEq(cmd, str.strView::fromCstr("-clean"))) return cmdClean();
    writeErrStr("coral: unknown command\n");
    return 1;
}
