mod mman = import("std/memory/mman.crl");
mod str = import("std/text/string.crl");
mod libc = import("std/platform/libc.crl");
mod tok = import("token");
mod lex = import("lexer");
mod ast = import("ast/ast.crl");
mod error = import("error");
mod parse = import("parser");
mod check = import("typecheck/check.crl");
mod types = import("typecheck/types.crl");
mod ir_parse = import("lib/wallvm/ir_parse.crl");
mod wallvm = import("lib/wallvm/wallvm.crl");

flag (platform) {
    LINUX:
        const u32 BUILD_PLATFORM_ID = 1;
    MACOS:
        const u32 BUILD_PLATFORM_ID = 2;
    WINDOWS:
        const u32 BUILD_PLATFORM_ID = 3;
    FREEBSD:
        const u32 BUILD_PLATFORM_ID = 4;
    OPENBSD:
        const u32 BUILD_PLATFORM_ID = 5;
    WASM:
        const u32 BUILD_PLATFORM_ID = 6;
}

flag (ARCH) {
    x86_64:
        const u32 BUILD_ARCH_ID = 1;
    x86:
        const u32 BUILD_ARCH_ID = 2;
    arm64:
        const u32 BUILD_ARCH_ID = 3;
    arm32:
        const u32 BUILD_ARCH_ID = 4;
    riscv64:
        const u32 BUILD_ARCH_ID = 5;
    riscv32:
        const u32 BUILD_ARCH_ID = 6;
    ppc64:
        const u32 BUILD_ARCH_ID = 7;
    ppc:
        const u32 BUILD_ARCH_ID = 8;
    mips64:
        const u32 BUILD_ARCH_ID = 9;
    mips:
        const u32 BUILD_ARCH_ID = 10;
    sparc64:
        const u32 BUILD_ARCH_ID = 11;
    wasm32:
        const u32 BUILD_ARCH_ID = 12;
}

const u8* readFile(str.strView path, u32* outLen)
{
    void* f = libc.fopen(path.ptr, "rb");
    if (f == null) return null;
    u64 cap = (u64)(1u << 16);
    u8* buf = mman.alloc<u8>(cap);
    u64 used = 0;
    for (;;)
    {
        u64 got = libc.fread(buf + used, 1, cap - used, f);
        used += got;
        if (got == 0) break;
        if (used == cap)
        {
            u64 nc = cap * 2;
            buf = mman.realloc<u8>(buf, nc);
            cap = nc;
        }
    }
    libc.fclose(f);
    *outLen = (u32)used;
    return buf;
}

bool vEqCI(str.strView a, str.strView b)
{
    if (a.len != b.len) return false;
    for (u32 i = 0; i < a.len; i++)
    {
        char ca = a.ptr[i]; if (ca >= 'A' && ca <= 'Z') ca = (char)(ca - 'A' + 'a');
        char cb = b.ptr[i]; if (cb >= 'A' && cb <= 'Z') cb = (char)(cb - 'A' + 'a');
        if (ca != cb) return false;
    }
    return true;
}

void printHelp()
{
    const u8* h = str.strView::fromCstr("coral - Coral compiler driver\nusage: coral <file.crl> [options]\noptions:\n  -h, --help            show this help\n  --emit-h              emit a C header (declarations only)\n  --emit-ir             emit WallVM IR (not yet implemented)\n  --emit-asm            emit assembly (not yet implemented)\n  --emit-cpp            emit C++ header with methods\n  --debug               include debug information in output\n  -O0 -O1 -O2 -O3       optimization level (default -O1)\n  --stop-on-error       stop at the first error (default)\n  --continue            keep going after errors\n  --report-all-errors   emit every error found\n  --fcast               force all implicit casts (escape hatch)\n  --flags=k=v[,...]     set platform/arch flags (e.g. platform=LINUX,arch=x86_64)\n  --explain <code>      explain an error code in detail (e.g. --explain TC-RETURN)\n  --funroll             enable loop unrolling (wallvm)\n  --fborrowcheck        enable borrow checker diagnostics\n  --fbuiltinmap         map libc/builtin calls to native IR opcodes (wallvm)\n  -o <file>             set output file (default a.out)\n  --linker-flags <flags> pass flags to linker (gcc)\n").ptr;
    u64 n = 0; while (h[n]) n++;
    libc.write(1, h, n);
}

i32 main(u32 argc, char** argv)
{
    // --help may appear anywhere; honor it before requiring a file
    for (u32 i = 1; i < argc; i++)
    {
        str.strView a = str.strView::fromCstr(argv[i]);
        if (a.len == 6 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'h' && a.ptr[3] == (u8)'e' && a.ptr[4] == (u8)'l' && a.ptr[5] == (u8)'p')
        { printHelp(); return 0; }
        if (a.len == 2 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'h')
        { printHelp(); return 0; }
    }
    for (u32 i = 1; i < argc; i++)
    {
        str.strView a = str.strView::fromCstr(argv[i]);
        bool isExplain = a.len >= 9 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'e' && a.ptr[3] == (u8)'x' && a.ptr[4] == (u8)'p' && a.ptr[5] == (u8)'l' && a.ptr[6] == (u8)'a' && a.ptr[7] == (u8)'i' && a.ptr[8] == (u8)'n';
        if (isExplain) {
            str.strView code = str.strView::empty();
            if (a.len>10 && a.ptr[9] == (u8)'=') code = str.strView::fromParts(a.ptr+10, a.len-10);
            else if (i+1 < argc) code = str.strView::fromCstr(argv[i+1]);
            if (code.len == 0) { error.explain(str.strView::fromCstr("")); return 0; }
            error.explain(code); return 0;
        }
    }
    if (argc < 2)
    {
        libc.write(2, (const u8*)"usage: coral <file.crl> (try --help)\n", 35);
        return 1;
    }
    // compiler directory: dir of the running binary (imports resolve against
    // <compilerDir>/lib2, the reference corpus)
    char exeBuf[512];
    i64 exeN = libc.readlink("/proc/self/exe", exeBuf, 512);
    char* exeDir = null;
    if (exeN > 0)
    {
        for (i64 i = exeN - 1; i >= 0; i--)
        {
            if (exeBuf[i] == '/')
            {
                char* d = mman.alloc<char>((u32)i + 1);
                for (u32 k = 0; k < (u32)i; k++) d[k] = exeBuf[k];
                d[i] = 0;
                exeDir = d;
                break;
            }
        }
    }

    str.strView path = str.strView::fromCstr(argv[1]);
    bool isIr = false;
    if (path.len > 4) {
        u32 d = path.len;
        if (path.ptr[d-4] == '.' && path.ptr[d-3] == 'w' && path.ptr[d-2] == 'i' && path.ptr[d-1] == 'r') isIr = true;
        if (path.ptr[d-3] == '.' && path.ptr[d-2] == 'i' && path.ptr[d-1] == 'r') isIr = true;
    }
    if (isIr) {
        u32 len = 0;
        const u8* src = readFile(path, cast<u32*>(&len));
        if (src == null) { libc.write(2, (const u8*)"cannot read input file\n", 22); return 1; }
        ir_parse.ParseResult res = ir_parse.parseWIR(str.strView::fromParts((const char*)src, len), path);
        if (!res.ok) { libc.write(2, (const u8*)"coral: failed to parse IR\n", 27); return 1; }
        u32 optLevelIr = 1;
        for (u32 ai = 2; ai < argc; ai++) {
            str.strView a = str.strView::fromCstr(argv[ai]);
            if (a.len==3 && a.ptr[0]=='-' && a.ptr[1]=='O' && a.ptr[2]>='0' && a.ptr[2]<='3') optLevelIr = (u32)(a.ptr[2]-'0');
        }
        const char* asmText = wallvm.irCompileAsm(res.irMod, res.ctx, 0, optLevelIr);
        if (asmText == null) { libc.write(2, (const u8*)"coral: IR codegen failed\n", 26); return 1; }
        str.strView outIr = str.strView::empty();
        for (u32 oi=2; oi<argc; oi++) {
            str.strView a = str.strView::fromCstr(argv[oi]);
            if (a.len==2 && a.ptr[0]=='-' && a.ptr[1]=='o' && oi+1<argc) { outIr = str.strView::fromCstr(argv[oi+1]); break; }
            if (a.len>3 && a.ptr[0]=='-' && a.ptr[1]=='o') { outIr = str.strView::fromParts(a.ptr+2, a.len-2); break; }
        }
        if (outIr.len==0) {
            u32 dot = 0; bool hasDot=false; for(u32 k=0;k<path.len;k++) if(path.ptr[k]=='.'){dot=k;hasDot=true;}
            str.String op = str.String::new();
            if(hasDot) op.pushView(str.strView::fromParts(path.ptr,dot)); else op.pushView(path);
            op.pushCstr(".s"); outIr = op.asView();
        }
        void* outF = libc.fopen(outIr.ptr, "wb");
        if (outF != null) { u64 n=0; while(asmText[n]) n++; libc.fwrite((u8*)asmText,1,n,outF); libc.fclose(outF); libc.write(1,(const u8*)"wrote ",6); libc.write(1,(const u8*)outIr.ptr,outIr.len); libc.write(1,(const u8*)"\n",1); }
        return 0;
    }
    u32 len = 0;
    const u8* src = readFile(path, cast<u32*>(&len));
    if (src == null)
    {
        libc.write(2, (const u8*)"cannot read input file\n", 22);
        return 1;
    }

    lex.Lexer lx = lex.Lexer::new(src, len);
    lex.LexResult lr = lx.lex();
    bool failed = false;
    for (u32 i = 0; i < lr.nerrs; i++)
    {
        tok.LexErr* e = &lr.errs[i];
        error.reportCode(e->code, path, str.strView::fromParts((const char*)src, len),
                         e->row, e->col, error.LVL_ERROR, e->msg, e->help);
        failed = true;
    }
    if (failed) return 1;

    parse.Parser p = parse.Parser::new(lr.toks, lr.n, src, len, path);
    ast.Program* prog = p.parseProgram();
    if (prog != null)
    {
        // Flag overrides for this compilation. Seed with the platform/arch this
        // compiler was built for (embedded via the build's --flags); terminal
        // --flags below override these. This is how `flag (platform)` /
        // `flag (ARCH)` resolve in every compiled file without hardcoding.
        str.strView flagNames[16];
        str.strView flagVals[16];
        u32 nflags = 0;
        u32 emitMode = 0; // 0=none 1=h 2=ir 3=asm 4=cpp
        u32 optLevel = 1; // -O0..-O3
        bool debugBuild = false;
        str.strView outputPath = str.strView::empty();
        str.strView linkerFlags = str.strView::empty();
        bool stopOnError = true;
        bool reportAllErrors = false;
        str.strView bp = str.strView::fromCstr("UNKNOWN");
        if (BUILD_PLATFORM_ID == 1) bp = str.strView::fromCstr("LINUX");
        else if (BUILD_PLATFORM_ID == 2) bp = str.strView::fromCstr("MACOS");
        else if (BUILD_PLATFORM_ID == 3) bp = str.strView::fromCstr("WINDOWS");
        else if (BUILD_PLATFORM_ID == 4) bp = str.strView::fromCstr("FREEBSD");
        else if (BUILD_PLATFORM_ID == 5) bp = str.strView::fromCstr("OPENBSD");
        else if (BUILD_PLATFORM_ID == 6) bp = str.strView::fromCstr("WASM");
        str.strView ba = str.strView::fromCstr("UNKNOWN");
        if (BUILD_ARCH_ID == 1) ba = str.strView::fromCstr("x86_64");
        else if (BUILD_ARCH_ID == 2) ba = str.strView::fromCstr("x86");
        else if (BUILD_ARCH_ID == 3) ba = str.strView::fromCstr("arm64");
        else if (BUILD_ARCH_ID == 4) ba = str.strView::fromCstr("arm32");
        else if (BUILD_ARCH_ID == 5) ba = str.strView::fromCstr("riscv64");
        else if (BUILD_ARCH_ID == 6) ba = str.strView::fromCstr("riscv32");
        else if (BUILD_ARCH_ID == 7) ba = str.strView::fromCstr("ppc64");
        else if (BUILD_ARCH_ID == 8) ba = str.strView::fromCstr("ppc");
        else if (BUILD_ARCH_ID == 9) ba = str.strView::fromCstr("mips64");
        else if (BUILD_ARCH_ID == 10) ba = str.strView::fromCstr("mips");
        else if (BUILD_ARCH_ID == 11) ba = str.strView::fromCstr("sparc64");
        else if (BUILD_ARCH_ID == 12) ba = str.strView::fromCstr("wasm32");
        if (nflags < 16) { flagNames[nflags] = str.strView::fromCstr("platform"); flagVals[nflags] = bp; nflags++; }
        if (nflags < 16) { flagNames[nflags] = str.strView::fromCstr("arch"); flagVals[nflags] = ba; nflags++; }
        bool enableUnroll = false;
        bool enableBorrowCheck = false;
        bool enableBuiltinMap = false;
        for (u32 ai = 2; ai < argc; ai++)
        {
            str.strView a = str.strView::fromCstr(argv[ai]);
            if (a.len == 9 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'f' && a.ptr[3] == (u8)'u' && a.ptr[4] == (u8)'n' && a.ptr[5] == (u8)'r' && a.ptr[6] == (u8)'o' && a.ptr[7] == (u8)'l' && a.ptr[8] == (u8)'l') { enableUnroll = true; continue; }
            if (a.len == 13 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'f' && a.ptr[3] == (u8)'b' && a.ptr[4] == (u8)'o' && a.ptr[5] == (u8)'r' && a.ptr[6] == (u8)'r' && a.ptr[7] == (u8)'o' && a.ptr[8] == (u8)'w' && a.ptr[9] == (u8)'c' && a.ptr[10] == (u8)'h' && a.ptr[11] == (u8)'e' && a.ptr[12] == (u8)'c' && a.ptr[13] == (u8)'k') { enableBorrowCheck = true; continue; }
            if (a.len == 13 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'f' && a.ptr[3] == (u8)'b' && a.ptr[4] == (u8)'u' && a.ptr[5] == (u8)'i' && a.ptr[6] == (u8)'l' && a.ptr[7] == (u8)'t' && a.ptr[8] == (u8)'i' && a.ptr[9] == (u8)'n' && a.ptr[10] == (u8)'m' && a.ptr[11] == (u8)'a' && a.ptr[12] == (u8)'p') { enableBuiltinMap = true; continue; }
            // --fcast: force every cast (escape hatch for code that needs
            // unchecked conversion). Off by default.
            if (a.len == 7 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'f' && a.ptr[3] == (u8)'c' && a.ptr[4] == (u8)'a' && a.ptr[5] == (u8)'s' && a.ptr[6] == (u8)'t')
            {
                types.gForceCast = true;
                continue;
            }
            if (a.len > 8 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'f' && a.ptr[3] == (u8)'l' && a.ptr[4] == (u8)'a' && a.ptr[5] == (u8)'g' && a.ptr[6] == (u8)'s' && a.ptr[7] == (u8)'=')
            {
                str.strView rest = str.strView::fromParts(a.ptr + 8, a.len - 8);
                u32 start = 0;
                for (u32 j = 0; j <= rest.len; j++)
                {
                    if (j == rest.len || rest.ptr[j] == (u8)',')
                    {
                        str.strView pair = str.strView::fromParts(rest.ptr + start, j - start);
                        u32 eq = 0; bool found = false;
                        for (u32 k = 0; k < pair.len; k++) if (pair.ptr[k] == (u8)'=') { eq = k; found = true; break; }
                        if (found && eq > 0 && nflags < 16)
                        {
                            str.strView kn = str.strView::fromParts(pair.ptr, eq);
                            str.strView kv = str.strView::fromParts(pair.ptr + eq + 1, pair.len - eq - 1);
                            bool repl = false;
                            for (u32 fi = 0; fi < nflags; fi++) { if (vEqCI(flagNames[fi], kn)) { flagVals[fi] = kv; repl = true; break; } }
                            if (!repl) { flagNames[nflags] = kn; flagVals[nflags] = kv; nflags++; }
                        }
                        start = j + 1;
                    }
                }
            }
            // --emit-h / --emit-ir / --emit-asm
            if (a.len >= 7 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'e' && a.ptr[3] == (u8)'m' && a.ptr[4] == (u8)'i' && a.ptr[5] == (u8)'t' && a.ptr[6] == (u8)'-')
            {
                if (a.len == 8 && a.ptr[7] == (u8)'h') emitMode = 1;
                else if (a.len == 9 && a.ptr[7] == (u8)'i' && a.ptr[8] == (u8)'r') emitMode = 2;
                else if (a.len == 10 && a.ptr[7] == (u8)'a' && a.ptr[8] == (u8)'s' && a.ptr[9] == (u8)'m') emitMode = 3;
                else if (a.len == 11 && a.ptr[7] == (u8)'c' && a.ptr[8] == (u8)'p' && a.ptr[9] == (u8)'p' && a.ptr[10] == (u8)'p') emitMode = 4;
                continue;
            }
            if (a.len == 7 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'d' && a.ptr[3] == (u8)'e' && a.ptr[4] == (u8)'b' && a.ptr[5] == (u8)'u' && a.ptr[6] == (u8)'g') { debugBuild = true; continue; }
            if (a.len == 3 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'O' && a.ptr[2] >= (u8)'0' && a.ptr[2] <= (u8)'3')
            {
                optLevel = (u32)(a.ptr[2] - (u8)'0');
                continue;
            }
            if (a.len == 14 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'s' && a.ptr[3] == (u8)'t' && a.ptr[4] == (u8)'o' && a.ptr[5] == (u8)'p' && a.ptr[6] == (u8)'-' && a.ptr[7] == (u8)'o' && a.ptr[8] == (u8)'n' && a.ptr[9] == (u8)'-' && a.ptr[10] == (u8)'e' && a.ptr[11] == (u8)'r' && a.ptr[12] == (u8)'r' && a.ptr[13] == (u8)'r')
            { stopOnError = true; continue; }
            if (a.len == 11 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'c' && a.ptr[3] == (u8)'o' && a.ptr[4] == (u8)'n' && a.ptr[5] == (u8)'t' && a.ptr[6] == (u8)'i' && a.ptr[7] == (u8)'n' && a.ptr[8] == (u8)'u' && a.ptr[9] == (u8)'e') { stopOnError = false; continue; }
            if (a.len == 19 && a.ptr[0] == (u8)'-' && a.ptr[1] == (u8)'-' && a.ptr[2] == (u8)'r' && a.ptr[3] == (u8)'e' && a.ptr[4] == (u8)'p' && a.ptr[5] == (u8)'o' && a.ptr[6] == (u8)'r' && a.ptr[7] == (u8)'t' && a.ptr[8] == (u8)'-' && a.ptr[9] == (u8)'a' && a.ptr[10] == (u8)'l' && a.ptr[11] == (u8)'l' && a.ptr[12] == (u8)'-' && a.ptr[13] == (u8)'e' && a.ptr[14] == (u8)'r' && a.ptr[15] == (u8)'r' && a.ptr[16] == (u8)'o' && a.ptr[17] == (u8)'r' && a.ptr[18] == (u8)'s') { reportAllErrors = true; continue; }
        }
        // set pointer width for usize/isize based on arch
        {
            str.strView archVal = ba;
            for (u32 _fi=0; _fi<nflags; _fi++) if (vEqCI(flagNames[_fi], strView::fromCstr("arch"))) archVal = flagVals[_fi];
            bool is32 = vEqCI(archVal, strView::fromCstr("x86")) || vEqCI(archVal, strView::fromCstr("arm32")) || vEqCI(archVal, strView::fromCstr("riscv32")) || vEqCI(archVal, strView::fromCstr("ppc")) || vEqCI(archVal, strView::fromCstr("mips")) || vEqCI(archVal, strView::fromCstr("wasm32"));
            types.setPointerWidth(is32 ? 32 : 64);
        }
        // -o <file> / --output <file>
        for (u32 _oi=2; _oi<argc; _oi++) {
            str.strView _a = str.strView::fromCstr(argv[_oi]);
            if (_a.len == 2 && _a.ptr[0] == (u8)'-' && _a.ptr[1] == (u8)'o' && _oi+1<argc) { outputPath = str.strView::fromCstr(argv[_oi+1]); }
            else if (_a.len>3 && _a.ptr[0] == (u8)'-' && _a.ptr[1] == (u8)'o' && _a.ptr[2] != '\0') { outputPath = str.strView::fromParts(_a.ptr+2, _a.len-2); }
            else if (_a.len >= 9 && _a.ptr[0] == (u8)'-' && _a.ptr[1] == (u8)'-' && _a.ptr[2] == (u8)'o' && _a.ptr[3] == (u8)'u' && _a.ptr[4] == (u8)'t' && _a.ptr[5] == (u8)'p' && _a.ptr[6] == (u8)'u' && _a.ptr[7] == (u8)'t') {
                if (_a.len>9 && _a.ptr[9] == (u8)'=') outputPath = str.strView::fromParts(_a.ptr+10, _a.len-10);
                else if (_oi+1<argc) outputPath = str.strView::fromCstr(argv[_oi+1]);
            }
        }
        // linker flags: -l, -L, --linker-flags
        for (u32 _li=2; _li<argc; _li++) {
            str.strView _a = str.strView::fromCstr(argv[_li]);
            if (_a.len >= 2 && _a.ptr[0] == (u8)'-' && _a.ptr[1] == (u8)'l') { /* handled via outputPath loop */ }
            if (_a.len >= 14 && _a.ptr[0] == (u8)'-' && _a.ptr[1] == (u8)'-' && _a.ptr[2] == (u8)'l' && _a.ptr[3] == (u8)'i' && _a.ptr[4] == (u8)'n' && _a.ptr[5] == (u8)'k' && _a.ptr[6] == (u8)'e' && _a.ptr[7] == (u8)'r' && _a.ptr[8] == (u8)'-' && _a.ptr[9] == (u8)'f' && _a.ptr[10] == (u8)'l' && _a.ptr[11] == (u8)'a' && _a.ptr[12] == (u8)'g' && _a.ptr[13] == (u8)'s') {
                if (_a.len>15 && _a.ptr[15] == (u8)'=') linkerFlags = str.strView::fromParts(_a.ptr+16, _a.len-16);
                else if (_li+1<argc) linkerFlags = str.strView::fromCstr(argv[_li+1]);
            }
        }
        if (enableUnroll) { if (nflags < 16) { flagNames[nflags] = strView::fromCstr("unroll"); flagVals[nflags] = strView::fromCstr("1"); nflags++; } }
        if (enableBorrowCheck) { if (nflags < 16) { flagNames[nflags] = strView::fromCstr("borrowcheck"); flagVals[nflags] = strView::fromCstr("1"); nflags++; } }
        if (enableBuiltinMap) { if (nflags < 16) { flagNames[nflags] = strView::fromCstr("builtinmap"); flagVals[nflags] = strView::fromCstr("1"); nflags++; } }
        check.Check ck = check.Check::new(prog, str.strView::fromParts((const char*)src, len), path, exeDir);
        for (u32 fi = 0; fi < nflags && fi < 16; fi++)
        {
            ck.flagNames[fi] = flagNames[fi];
            ck.flagVals[fi] = flagVals[fi];
        }
        ck.nflags = nflags < 16 ? nflags : 16;
        ck.emitMode = emitMode;
        ck.optLevel = optLevel;
        ck.debugBuild = debugBuild;
        // -o handling for emit modes: override output path in check if needed
        if (outputPath.len>0) ck.outputPath = outputPath;
        if (linkerFlags.len>0) ck.linkerFlags = linkerFlags;
        ck.run();
        if (ck.nerrors > 0) return 1;
        return 0;
    }
    else if (p.errMsg.len > 0)
    {
        error.reportCode(p.errCode.asView(), path, str.strView::fromParts((const char*)src, len),
                         p.errLine, p.errCol, error.LVL_ERROR, p.errMsg.asView(), p.errHelp.asView());
        return 1;
    }
    else
    {
        error.reportCode(str.strView::fromCstr("SYN-1999"), path,
                         str.strView::fromParts((const char*)src, len),
                         1, 1, error.LVL_ERROR,
                         str.strView::fromCstr("parse failed"),
                         str.strView::fromCstr("the input could not be parsed into a program"));
        return 1;
    }
}