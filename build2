#!/usr/bin/env bash
# Build the Coral self-host compiler into an isolated output dir so it never
# clobbers ./coralc or ./build_out (another agent may be building there).
#   ./build2            -> builds into build2_out/, binary: build2_out/coralc
#   ./build2 <dir>      -> custom output dir
set -euo pipefail
cd "$(dirname "$0")"
OUT="${1:-build2_out}"
mkdir -p "$OUT"
rm -f "$OUT/main.c" "$OUT/main.h" "$OUT/coralc"
python3 py/main.py -S --flags=platform=LINUX,ARCH=x86_64 -I lib -o "$OUT" src/main.crl
gcc -O0 -g -w -o "$OUT/coralc" "$OUT/main.c" -lm
echo "built $OUT/coralc"
