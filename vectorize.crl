#[[freestanding]]


#[[vectorise]]
i64 vsum(i64 n, i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < n; i++) { s = s + a[i]; }
    return s;
}


#[[novector]]
i64 nsum(i64 n, i64* a)
{
    i64 s = 0;
    for (i64 i = 0; i < n; i++) { s = s + a[i]; }
    return s;
}

pub i32 main()
{
    i64[64] a = {0};
    i64 i = 0;
    while (i < 64) { a[i] = i; i++; }
    return (i32)(vsum(64, &a[0]) + nsum(64, &a[0]));
}
