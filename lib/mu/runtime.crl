// Mu runtime boundary — extern("C") declarations for the symbols generated
// Mu code links against. Implementations live engine-side:
//   src/script/mualloc.crl  (__mu_alloc/realloc/free/memcpy/memset/trap)
//   src/script/mustr.crl    (__mu_str_*)
//   src/script/mulog.crl    (__mu_log_*)
// registered in the BindingTable by FNV-1a-64 of these exact names.
//
// All pointers cross as usize/rawptr — MuVM targets SysV C ABI.
// Mu `str` is the 16-byte {ptr,len} pair; `MuStr`/`MuStrOut` mirror it.

use types { MuStr };

// ---- allocator bridge (game allocator, ENGINE.md §9/§10) ----

pub extern("C") usize __mu_alloc(usize size);
pub extern("C") usize __mu_realloc(usize ptr, usize size);
pub extern("C") void  __mu_free(usize ptr, usize size);
pub extern("C") void  __mu_memcpy(usize dst, usize src, usize n);
pub extern("C") void  __mu_memset(usize dst, usize v, usize n);

// trap(kind, a, b, file, line, fn) — appends a MuTrapReport to the
// engine-owned ring; the engine drains via __mu_trap_drain.
pub extern("C") void  __mu_trap(usize kind, usize a, usize b, usize file, usize line, usize fn);
pub extern("C") MuTrapDrain __mu_trap_drain();

pub struct MuTrapReport
{
    usize kind;
    usize a;
    usize b;
    usize file;
    usize line;
    usize fnName;
}

pub struct MuTrapDrain
{
    usize ptr;    // MuTrapReport*
    usize count;
}

// ---- string runtime (mustr.crl) ----
// str args/results cross as {ptr,len}; scalars as usize-width ints.
// Comparison/predicate fns return 0/1 (usize); indexOf returns index or
// usize-max; view fns return a {ptr,len} pair (MuStr layout).

pub extern("C") MuStr __mu_str_concat(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_eq(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_ne(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_lt(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_le(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_gt(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_ge(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_contains(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_starts(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_ends(usize lp, usize ll, usize rp, usize rl);
pub extern("C") usize __mu_str_indexOf(usize lp, usize ll, usize rp, usize rl);
pub extern("C") MuStr __mu_str_sub(usize lp, usize ll, usize start, usize count);
pub extern("C") MuStr __mu_str_lower(usize lp, usize ll);
pub extern("C") MuStr __mu_str_upper(usize lp, usize ll);
pub extern("C") MuStr __mu_str_trim(usize lp, usize ll);
pub extern("C") MuStr __mu_str_reverse(usize lp, usize ll);

// ---- log runtime (mulog.crl) ----
// log() appends formatted values + ' ' to an engine-owned buffer;
// __mu_log_nl ends the line. The engine drains via __mu_log_drain and
// decides what to do with the text — nothing prints implicitly.

pub extern("C") void __mu_log_i8(i8 v);
pub extern("C") void __mu_log_i16(i16 v);
pub extern("C") void __mu_log_i32(i32 v);
pub extern("C") void __mu_log_i64(i64 v);
pub extern("C") void __mu_log_isize(isize v);
pub extern("C") void __mu_log_u8(u8 v);
pub extern("C") void __mu_log_u16(u16 v);
pub extern("C") void __mu_log_u32(u32 v);
pub extern("C") void __mu_log_u64(u64 v);
pub extern("C") void __mu_log_usize(usize v);
pub extern("C") void __mu_log_f32(f32 v);
pub extern("C") void __mu_log_f64(f64 v);
pub extern("C") void __mu_log_bool(u8 v);
pub extern("C") void __mu_log_char(i32 v);
pub extern("C") void __mu_log_str(usize data, usize len);
pub extern("C") void __mu_log_ptr(usize v);
pub extern("C") void __mu_log_opt(usize p);
pub extern("C") void __mu_log_res(usize p);
pub extern("C") void __mu_log_nl();
pub extern("C") MuStr __mu_log_drain();
pub extern("C") void __mu_log_clear();

// ---- Mu module entry points ----
//
// mulang emits `#[[no_mangle]]`-style exports for engine-callable fns.
// The canonical set (per ENGINE.md §4/§5): per-entity `update`-style hooks
// are resolved through the BindingTable by hash, not by these decls — these
// are for direct C-ABI calls into a statically linked Mu object.
//
// Example (uncomment when a Mu object provides them):
//   pub extern("C") void mu_update(usize entity, f32 dt);
//   pub extern("C") u32  mu_init();

// ---- builtin containers (mucont.crl) ----
// Opaque u64 handles into the engine's container table. Elements cross as
// encoded {a,b} usize pairs: b==0 inline scalar, b==~0 aggregate ptr
// (engine copies elemSize bytes), b==len|0x4000.. str {ptr,len}.
// Option-returning methods take an out-pointer for the payload and return
// the variant tag (0 = Some).

pub extern("C") usize __mu_set_new(usize elemSize);
pub extern("C") usize __mu_set_len(usize h);
pub extern("C") usize __mu_set_has(usize h, usize a, usize b);
pub extern("C") usize __mu_set_add(usize h, usize a, usize b);
pub extern("C") usize __mu_set_remove(usize h, usize a, usize b);

pub extern("C") usize __mu_queue_new(usize elemSize);
pub extern("C") usize __mu_queue_len(usize h);
pub extern("C") usize __mu_queue_push(usize h, usize a, usize b);
pub extern("C") usize __mu_queue_pop(usize h, usize out);

pub extern("C") usize __mu_pool_new(usize cap, usize elemSize);
pub extern("C") usize __mu_pool_len(usize h);
pub extern("C") usize __mu_pool_cap(usize h);
pub extern("C") usize __mu_pool_create(usize h, usize out);
pub extern("C") usize __mu_pool_release(usize h, usize handle);
pub extern("C") usize __mu_pool_alive(usize h, usize handle);
pub extern("C") usize __mu_pool_get(usize h, usize handle, usize out);
pub extern("C") usize __mu_pool_set(usize h, usize handle, usize a, usize b);

pub extern("C") usize __mu_map_new(usize kSize, usize vSize);
pub extern("C") usize __mu_map_len(usize h);
pub extern("C") usize __mu_map_has(usize h, usize ka, usize kb);
pub extern("C") usize __mu_map_set(usize h, usize ka, usize kb, usize va, usize vb);
pub extern("C") usize __mu_map_remove(usize h, usize ka, usize kb);
pub extern("C") usize __mu_map_get(usize h, usize ka, usize kb, usize out);

pub struct MuBitsetRet
{
    usize words;
    usize nbits;
}

pub extern("C") MuBitsetRet __mu_bitset_new(usize nbits);
pub extern("C") usize __mu_bitset_test(usize bs, usize i);
pub extern("C") usize __mu_bitset_set(usize bs, usize i);
pub extern("C") usize __mu_bitset_clear(usize bs, usize i);
pub extern("C") usize __mu_bitset_toggle(usize bs, usize i);
pub extern("C") usize __mu_bitset_any(usize bs);
pub extern("C") usize __mu_bitset_all(usize bs);
pub extern("C") usize __mu_bitset_none(usize bs);
pub extern("C") usize __mu_bitset_count(usize bs);
