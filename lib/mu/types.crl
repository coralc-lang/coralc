// Coral-side views of Mu language layouts (mulang/lib + builtin slices).
//
// These exist so Coral code can pass values across the MuVM boundary with
// identical layout — the Mu compiler emits the same field order/types, so a
// `MuVec3` here IS a `Vec3` there bit-for-bit. Keep field order in sync with
// mulang/lib/math.mu and mulang's builtin slice/array layout ({ptr, len}).
//
// Engine-native types (the engine's own Vec3/Quat/Mat4 in src/math) already
// share these layouts — prefer those inside the engine; these are for
// generic Coral code that only knows the Mu ABI.

// ---- math types (mulang/lib/math.mu) ----

pub struct MuVec2 { f32 x; f32 y; }
pub struct MuVec3 { f32 x; f32 y; f32 z; }
pub struct MuVec4 { f32 x; f32 y; f32 z; f32 w; }
pub struct MuRVec3 { f64 x; f64 y; f64 z; }
pub struct MuQuat { f32 x; f32 y; f32 z; f32 w; }
pub struct MuAxisAngle { MuVec3 axis; f32 angle; }
pub struct MuPlane { MuVec3 normal; f32 dist; }

// column-major 3x3 / 4x4, matching mulang Mat3/Mat4
pub struct MuMat3 { MuVec3 col0; MuVec3 col1; MuVec3 col2; }
pub struct MuMat4
{
    MuVec4 col0; MuVec4 col1; MuVec4 col2; MuVec4 col3;
    MuVec4 col4; MuVec4 col5; MuVec4 col6; MuVec4 col7;
    MuVec4 col8; MuVec4 col9; MuVec4 col10; MuVec4 col11;
    MuVec4 col12; MuVec4 col13; MuVec4 col14; MuVec4 col15;
}

// ---- builtin aggregates ----
//
// Mu slice `T[]` lowers to { ptr T, i64 len } — 16 bytes, pointer first.
// `MuSlice` is the type-erased view; `data` is a raw pointer so any T works.

pub struct MuSlice
{
    rawptr data;
    usize len;    // element count (NOT bytes)
}

// Mu `str` uses the same {ptr, len} shape.
pub struct MuStr
{
    u8* data;
    usize len;
}

// Mu `Array<T>` (library generic) = { data: T[] slice, cap: usize }.
// Layout: slice (16 bytes) then cap — 24 bytes total.
pub struct MuArray
{
    MuSlice data;
    usize cap;
}
