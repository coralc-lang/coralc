#[[no_drop_all]]
/// Windows on ARM64 (SKETCH, as the C was).
///   features : IsProcessorFeaturePresent
///   identity : registry value "CP 4000" (the MIDR) under
///              HKLM\HARDWARE\DESCRIPTION\System\CentralProcessor\0
///   caches   : NOT WRITTEN YET. Call GetLogicalProcessorInformationEx(
///              RelationCache = 2, ...) and walk the variable-size records
///              (Level, LineSize, CacheSize, Type: 0 unified, 1 instruction,
///              2 data). Same interface as on x64 Windows.
///
/// Verify the PF_ARM_* values against winnt.h in your SDK; the list keeps
/// growing, and FP16 / I8MM / BF16 are not covered below.
import core::cpuinfo { CpuInfo, CpuArch, CpuFeature, setFeature };

pub extern("C") i32 IsProcessorFeaturePresent(u32 feature);                  // kernel32
pub extern("C") i32 RegGetValueW(u64 hkey, const u16* sub, const u16* val,
                                 u32 flags, u32* type, rawptr data, u32* size); // advapi32

// HKEY_LOCAL_MACHINE is ((HKEY)(LONG_PTR)(LONG)0x80000002): sign-extended on
// 64-bit. Building it from 32-bit pieces avoids any literal-width surprises.
const u64 HKLM_HANDLE = ((u64)0xFFFFFFFF00000000) | ((u64)0x80000002);
const u32 RRF_RT_REG_QWORD = 0x00000040;

void _wideAscii(u16* dst, str s)
{
    usize i = 0;
    while (i < s.len)
    {
        dst[i] = (u16)s.ptr[i];
        i++;
    }
    dst[i] = 0;
}

pub void detectCpu(CpuInfo* o)
{
    o->arch = CpuArch::Aarch64;
    setFeature(o, CpuFeature::ArmNeon);                       // PF 19 also reports it
    if (IsProcessorFeaturePresent(30) != 0) setFeature(o, CpuFeature::ArmAes);    // PF_ARM_V8_CRYPTO
    if (IsProcessorFeaturePresent(31) != 0) setFeature(o, CpuFeature::ArmCrc32);
    if (IsProcessorFeaturePresent(34) != 0) setFeature(o, CpuFeature::ArmLse);    // PF_ARM_V81_ATOMIC
    if (IsProcessorFeaturePresent(43) != 0) setFeature(o, CpuFeature::ArmDotprod); // PF_ARM_V82_DP
    if (IsProcessorFeaturePresent(46) != 0) setFeature(o, CpuFeature::ArmSve);
    if (IsProcessorFeaturePresent(47) != 0) setFeature(o, CpuFeature::ArmSve2);

    u64 midr = 0;
    u32 size = 8;
    u16[64] sub;
    u16[5] val;
    _wideAscii(sub, "HARDWARE\DESCRIPTION\System\CentralProcessor\0");
    _wideAscii(val, "CP 4000");
    if (RegGetValueW(HKLM_HANDLE, (const u16*)sub, (const u16*)val,
                     RRF_RT_REG_QWORD, null, (rawptr)&midr, &size) == 0 && size == 8)
    {
        o->midr      = midr;                                         // decode exactly as on Linux
        o->vendorId  = (u32)((midr >> 24) & 0xFF);
        o->family    = (u32)((midr >> 4)  & 0xFFF);
        o->model     = (u32)((midr >> 20) & 0xF);
        o->stepping  = (u32)(midr & 0xF);
    }
    // TODO: cache walker (see header comment).
}
