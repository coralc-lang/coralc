#[[no_drop_all]]
/// Apple silicon detection. Everything comes from sysctlbyname; there are no
/// register reads (Apple does not expose real MIDR values to user space).
///
/// Model-table key: hw.cpufamily, e.g. M1 = 0x1b588bb3, M2 = 0xda33d83d.
/// For other chips copy the constants from XNU's mach/machine.h, not from memory.
///
/// Hybrid cores: newer macOS has per-cluster keys such as
/// hw.perflevel0.l1dcachesize (P-cores) and hw.perflevel1.* (E-cores).
/// There is no SVE on Apple silicon, so ArmSve is never set.
import core::cchar { cchar };
import core::cpuinfo { CpuInfo, CpuArch, CpuFeature, setFeature };

pub extern("C") i32 sysctlbyname(const cchar* name, rawptr oldp, u64* oldlenp,
                                 rawptr newp, u64 newlen);

u64 sysctl_u(const cchar* name)
{
    u64 v = 0, len = 8;      // zero-init + little-endian: works for 4- or 8-byte values
    if (sysctlbyname(name, (rawptr)&v, &len, null, 0) != 0) return 0;
    return v;
}

pub void detectCpu(CpuInfo* o)
{
    o->arch = CpuArch::Aarch64;
    o->l1d.lineSize = (u32)sysctl_u(C"hw.cachelinesize");   // 128 on Apple
    o->l2.lineSize  = o->l1d.lineSize;
    o->l1d.size = (u32)sysctl_u(C"hw.l1dcachesize");
    o->l1i.size = (u32)sysctl_u(C"hw.l1icachesize");
    o->l2.size  = (u32)sysctl_u(C"hw.l2cachesize");
    o->l3.size  = (u32)sysctl_u(C"hw.l3cachesize");         // often 0 on base chips
    o->family   = (u32)sysctl_u(C"hw.cpufamily");           // model-table key
    o->logicalCores = (u32)sysctl_u(C"hw.logicalcpu");

    setFeature(o, CpuFeature::ArmNeon);                     // always present
    if (sysctl_u(C"hw.optional.arm.FEAT_AES") != 0)     setFeature(o, CpuFeature::ArmAes);
    if (sysctl_u(C"hw.optional.arm.FEAT_CRC32") != 0)   setFeature(o, CpuFeature::ArmCrc32);
    if (sysctl_u(C"hw.optional.arm.FEAT_LSE") != 0)     setFeature(o, CpuFeature::ArmLse);
    if (sysctl_u(C"hw.optional.arm.FEAT_FP16") != 0)    setFeature(o, CpuFeature::ArmFp16);
    if (sysctl_u(C"hw.optional.arm.FEAT_DotProd") != 0) setFeature(o, CpuFeature::ArmDotprod);
    if (sysctl_u(C"hw.optional.arm.FEAT_I8MM") != 0)    setFeature(o, CpuFeature::ArmI8mm);
    if (sysctl_u(C"hw.optional.arm.FEAT_BF16") != 0)    setFeature(o, CpuFeature::ArmBf16);
}
