
pub bool isDigit(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'0' && v <= (u16)'9';
}

pub bool isAlpha(u8 c)
{
    u16 v = (u16)c;
    return (v >= (u16)'a' && v <= (u16)'z') || (v >= (u16)'A' && v <= (u16)'Z');
}

pub bool isAlnum(u8 c) { return isDigit(c) || isAlpha(c); }

pub bool isLower(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'a' && v <= (u16)'z';
}

pub bool isUpper(u8 c)
{
    u16 v = (u16)c;
    return v >= (u16)'A' && v <= (u16)'Z';
}

pub u8 toLower(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'A' && v <= (u16)'Z') return (u8)(v + 0x20);
    return c;
}

pub u8 toUpper(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'a' && v <= (u16)'z') return (u8)(v - 0x20);
    return c;
}

pub bool isSpace(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)' ' || v == (u16)'\t' || v == (u16)'\n' || v == (u16)'\r' || v == (u16)'\f' || v == (u16)'\v';
}

pub bool isPrint(u8 c)
{
    u16 v = (u16)c;
    return v >= 0x20 && v <= 0x7E;
}

pub bool isControl(u8 c)
{
    u16 v = (u16)c;
    return v < 0x20 || v == 0x7F;
}

pub bool isHexDigit(u8 c)
{
    u16 v = (u16)c;
    return (v >= (u16)'0' && v <= (u16)'9') || (v >= (u16)'a' && v <= (u16)'f') || (v >= (u16)'A' && v <= (u16)'F');
}

pub u8 digitValue(u8 c)
{
    u16 v = (u16)c;
    if (v >= (u16)'0' && v <= (u16)'9') return (u8)(v - (u16)'0');
    if (v >= (u16)'a' && v <= (u16)'f') return (u8)(v - (u16)'a' + 10);
    if (v >= (u16)'A' && v <= (u16)'F') return (u8)(v - (u16)'A' + 10);
    return (u8)0;
}

pub bool isAscii(u8 c)
{
    return (u16)c <= 0x7F;
}

pub bool isWhitespace(u8 c) { return isSpace(c); }

pub bool isNewline(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)'\n' || v == (u16)'\r';
}

pub bool isPunctuation(u8 c)
{
    u16 v = (u16)c;
    return (v >= 0x21 && v <= 0x2F) || (v >= 0x3A && v <= 0x40) ||
           (v >= 0x5B && v <= 0x60) || (v >= 0x7B && v <= 0x7E);
}

pub bool isSymbol(u8 c)
{
    u16 v = (u16)c;
    return v == (u16)'+' || v == (u16)'-' || v == (u16)'*' || v == (u16)'/' ||
           v == (u16)'=' || v == (u16)'<' || v == (u16)'>' || v == (u16)'!' ||
           v == (u16)'&' || v == (u16)'|' || v == (u16)'^' || v == (u16)'~' ||
           v == (u16)'%' || v == (u16)'?' || v == (u16)'@';
}

pub u32 utf8Width(u32 c)
{
    if (c <= 0x7F) return 1;
    if (c <= 0x7FF) return 2;
    if (c <= 0xFFFF) return 3;
    return 4;
}

pub u32 encodeUtf8(u32 c, u8* buf)
{
    if (c <= 0x7F)
    {
        buf[0] = (u8)c;
        return 1;
    }
    if (c <= 0x7FF)
    {
        buf[0] = (u8)(0xC0 | (c >> 6));
        buf[1] = (u8)(0x80 | (c & 0x3F));
        return 2;
    }
    if (c <= 0xFFFF)
    {
        buf[0] = (u8)(0xE0 | (c >> 12));
        buf[1] = (u8)(0x80 | ((c >> 6) & 0x3F));
        buf[2] = (u8)(0x80 | (c & 0x3F));
        return 3;
    }
    buf[0] = (u8)(0xF0 | (c >> 18));
    buf[1] = (u8)(0x80 | ((c >> 12) & 0x3F));
    buf[2] = (u8)(0x80 | ((c >> 6) & 0x3F));
    buf[3] = (u8)(0x80 | (c & 0x3F));
    return 4;
}

pub struct(u32, u32) decodeUtf8(const u8* buf)
{
    u8 b0 = buf[0];
    if (b0 <= 0x7F)
        return ((u32)b0, 1);
    if ((b0 & 0xE0) == 0xC0)
        return (((u32)(b0 & 0x1F) << 6) | ((u32)(buf[1] & 0x3F)), 2);
    if ((b0 & 0xF0) == 0xE0)
        return (((u32)(b0 & 0x0F) << 12) | ((u32)(buf[1] & 0x3F) << 6) | ((u32)(buf[2] & 0x3F)), 3);
    return (((u32)(b0 & 0x07) << 18) | ((u32)(buf[1] & 0x3F) << 12) | ((u32)(buf[2] & 0x3F) << 6) | ((u32)(buf[3] & 0x3F)), 4);
}

pub u32 toUtf8(u32 c, u8* buf) { return encodeUtf8(c, buf); }
pub u32 fromUtf8(const u8* buf)
{
    struct(u32, u32) r = decodeUtf8(buf);
    return r.1;
}

pub u8 toAscii(u8 c) { return c & 0x7F; }
pub bool u8Eq(u8 a, u8 b) { return a == b; }
pub bool u8EqLower(u8 a, u8 b) { return toLower(a) == toLower(b); }

pub i32 u8Cmp(u8 a, u8 b)
{
    u16 av = (u16)a;
    u16 bv = (u16)b;
    if (av < bv) return -1;
    if (av > bv) return 1;
    return 0;
}

pub u32 toStr(u8 c, u8* buf){ return encodeUtf8((u32)c, buf); }

pub u8 const newline = '\n';
pub u8 const tab = '\t';
pub u8 const space = ' ';
pub u8 const nullu8 = '\0';
pub u8 const carriageReturn = '\r';

// ---- coral `char` (UTF-32 codepoint) API ----
// A coral `char` is one Unicode scalar value stored in 32 bits:
// U+0000..U+10FFFF excluding the UTF-16 surrogate range U+D800..U+DFFF.
// The classification helpers below are ASCII-only on purpose — Coral
// ships no Unicode category tables — so any non-ASCII codepoint answers
// false for them. charIsValid/charIsAscii are exact for every codepoint.
// Coral has no function overloading, hence the char-prefixed names next
// to the legacy u8 (byte) helpers above.

pub bool charIsValid(char c)
{
    u32 v = (u32)c;
    if (v > 0x10FFFFu) return false;
    if (v >= 0xD800u && v <= 0xDFFFu) return false;
    return true;
}

pub bool charIsAscii(char c) { return (u32)c <= 0x7Fu; }

pub bool charIsDigit(char c)
{
    return c >= '0' && c <= '9';
}

pub bool charIsAlpha(char c)
{
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
}

pub bool charIsAlnum(char c) { return charIsDigit(c) || charIsAlpha(c); }

pub bool charIsUpper(char c)
{
    return c >= 'A' && c <= 'Z';
}

pub bool charIsLower(char c)
{
    return c >= 'a' && c <= 'z';
}

pub bool charIsSpace(char c)
{
    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' || c == '\v';
}

pub bool charIsControl(char c)
{
    u32 v = (u32)c;
    return v < 0x20u || (v >= 0x7Fu && v <= 0x9Fu);
}

pub bool charIsPrint(char c)
{
    return c >= ' ' && c <= '~';
}

pub char charToUpper(char c)
{
    if (c >= 'a' && c <= 'z') return (char)((u32)c - 0x20u);
    return c;
}

pub char charToLower(char c)
{
    if (c >= 'A' && c <= 'Z') return (char)((u32)c + 0x20u);
    return c;
}

pub u32 charToU32(char c) { return (u32)c; }

pub char charFromU32(u32 v) { return (char)v; }

// Validity-checked conversion: returns false for out-of-range values
// (above U+10FFFF) and surrogates; *out is written only on success.
pub bool charTryFromU32(u32 v, char* out)
{
    if (v > 0x10FFFFu) return false;
    if (v >= 0xD800u && v <= 0xDFFFu) return false;
    *out = (char)v;
    return true;
}

// UTF-8-encode one char into buf (needs 4 bytes of space). Returns the
// byte count written, or 0 for an invalid codepoint (nothing written) —
// same policy as std::utf8::encodeCodepoint.
pub u32 charEncodeUtf8(char c, u8* buf)
{
    if (!charIsValid(c)) return 0;
    return encodeUtf8((u32)c, buf);
}

// Decode one UTF-8 sequence from buf (len bytes available) into a char,
// storing the byte count consumed in *consumed. Invalid, truncated,
// overlong, surrogate and out-of-range sequences yield U+FFFD and
// consume one byte; empty input yields U+FFFD and consumes zero —
// the same replacement policy as std::utf8::decodeCodepoint.
pub char charDecodeUtf8(const u8* buf, usize len, usize* consumed)
{
    if (len == 0) { *consumed = 0; return (char)0xFFFD; }
    u8 b0 = buf[0];
    if (b0 < 0x80u) { *consumed = 1; return (char)b0; }
    if (b0 < 0xC0u) { *consumed = 1; return (char)0xFFFD; }
    if (b0 < 0xE0u && len >= 2)
    {
        if ((buf[1] & 0xC0u) != 0x80u) { *consumed = 1; return (char)0xFFFD; }
        u32 cp = ((u32)(b0 & 0x1Fu) << 6) | ((u32)buf[1] & 0x3Fu);
        if (cp < 0x80u) { *consumed = 1; return (char)0xFFFD; }
        *consumed = 2;
        return (char)cp;
    }
    if (b0 < 0xF0u && len >= 3)
    {
        if ((buf[1] & 0xC0u) != 0x80u || (buf[2] & 0xC0u) != 0x80u) { *consumed = 1; return (char)0xFFFD; }
        u32 cp = ((u32)(b0 & 0x0Fu) << 12) | (((u32)buf[1] & 0x3Fu) << 6) | ((u32)buf[2] & 0x3Fu);
        if (cp < 0x800u || (cp >= 0xD800u && cp <= 0xDFFFu)) { *consumed = 1; return (char)0xFFFD; }
        *consumed = 3;
        return (char)cp;
    }
    if (b0 < 0xF8u && len >= 4)
    {
        if ((buf[1] & 0xC0u) != 0x80u || (buf[2] & 0xC0u) != 0x80u || (buf[3] & 0xC0u) != 0x80u) { *consumed = 1; return (char)0xFFFD; }
        u32 cp = ((u32)(b0 & 0x07u) << 18) | (((u32)buf[1] & 0x3Fu) << 12) | (((u32)buf[2] & 0x3Fu) << 6) | ((u32)buf[3] & 0x3Fu);
        if (cp < 0x10000u || cp > 0x10FFFFu) { *consumed = 1; return (char)0xFFFD; }
        *consumed = 4;
        return (char)cp;
    }
    *consumed = 1;
    return (char)0xFFFD;
}
