#[[no_drop_all]]
/// Raw CPU description returned by detection. Detection fills a `CpuInfo`
/// with what it can; anything unknown stays zero. A zero in any numeric
/// field means "unknown": fall back to the model's defaults, never fail.
/// Mapping a `CpuInfo` to a `CpuModel` (see `core::cpu_model`) is the
/// compiler's job, not this library's.
///
/// Platform detection primitives live in `core/<arch>/<os>/cpuinfo_backend.crl`
/// and are picked by the module loader the same way
/// `core/<arch>/<os>/error_backend.crl` is. Portable code must only import
/// `core::cpuinfo`, never an arch/os folder.
import core::cpuinfo_backend { detectCpu };

pub enum CpuArch
{
    Unknown,
    X86_64,
    Aarch64,
    Riscv64
}

pub struct CpuCache
{
    u32 size;
    u32 lineSize;
    u32 assoc;
    u32 sharedBy;   // 0 = unknown
}

pub struct CpuInfo
{
    CpuArch arch;
    u8[16] vendor;
    u8[64] brand;

    // x86:   family / model / stepping from cpuid leaf 1
    // arm64: vendor_id = MIDR implementer, family = part number,
    //        model = variant, stepping = revision (midr holds the raw value)
    // Apple: family = hw.cpufamily (the model-table key)
    u32 vendorId;
    u32 family;
    u32 model;
    u32 stepping;
    u64 midr;                      // arm64 only, 0 = unknown

    u32 logicalCores;
    u32 sveVlBytes;                // arm64 SVE vector length in bytes, 0 = no SVE
    CpuCache l1d, l1i, l2, l3;
    u64[2] features;               // bits from CpuFeature below
}

// one flat enum, arch-prefixed; ordinal positions are the feature indices
// into CpuInfo.features[]
pub enum CpuFeature
{
    X86Sse42, X86Avx, X86Avx2, X86Fma,
    X86Bmi2, X86Avx512f, X86Avx512vl,
    ArmNeon, ArmSve, ArmDotprod,
    RvV, RvZbb,
    // arm64 additions used by the Linux/macOS/Windows detectors
    ArmAes, ArmCrc32, ArmLse, ArmFp16,
    ArmI8mm, ArmBf16, ArmSve2,
    Count
}

pub bool cpuHas(const CpuInfo* c, CpuFeature f)
{
    u64 idx = (u64)f;
    return ((c->features[idx >> 6] >> (idx & 63)) & 1) != 0;
}

pub void setFeature(CpuInfo* o, CpuFeature f)
{
    u64 idx = (u64)f;
    o->features[idx >> 6] |= (u64)1 << (idx & 63);
}

pub bool isAmd(const CpuInfo* o)
{
    u8[12] amd = { 0x41, 0x75, 0x74, 0x68, 0x65, 0x6E, 0x74, 0x69, 0x63, 0x41, 0x4D, 0x44 };
    for (usize i = 0; i < 12; i++)
        if (o->vendor[i] != amd[i]) return false;
    return true;
}

void _zeroCache(CpuCache* c)
{
    c->size = 0;
    c->lineSize = 0;
    c->assoc = 0;
    c->sharedBy = 0;
}

/// Detects the CPU this binary is running on. Always returns 0 on success;
/// anything the platform cannot tell stays at "unknown" (0) in the result.
pub i32 cpuDetect(CpuInfo* out)
{
    // memset(out, 0, sizeof *out): a zero in any numeric field means
    // "unknown". Every field is written here, so a caller reusing the
    // struct cannot inherit stale bytes from a previous detection.
    out->arch = CpuArch::Unknown;
    for (usize i = 0; i < 16; i++) out->vendor[i] = 0;
    for (usize i = 0; i < 64; i++) out->brand[i] = 0;
    out->vendorId = 0;
    out->family = 0;
    out->model = 0;
    out->stepping = 0;
    out->midr = 0;
    out->logicalCores = 0;
    out->sveVlBytes = 0;
    _zeroCache(&out->l1d);
    _zeroCache(&out->l1i);
    _zeroCache(&out->l2);
    _zeroCache(&out->l3);
    out->features[0] = 0;
    out->features[1] = 0;

    detectCpu(out);   // sets out->arch and fills what it can
    return 0;
}
