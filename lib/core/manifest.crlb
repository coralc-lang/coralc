schema = 1;

# core module manifest — activated by `manifest = true` on the
# `module "core"` entry in lib/manifest.crlb.
manifest "core" {
    version = "0.1.0";

    target "x86_64/linux"   { path = "x86_64/linux"; }
    target "x86_64/windows" { path = "x86_64/windows"; }
    target "arm64/linux"    { path = "arm64/linux"; }
    target "arm64/android"  { path = "arm64/android"; }
    target "arm64/macos"    { path = "arm64/macos"; }
    target "arm64/windows"  { path = "arm64/windows"; }
}
