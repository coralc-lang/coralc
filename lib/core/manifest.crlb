schema = 1;

# core module manifest — activated by `extends "manifest.crlb"` on the
# `module "core"` entry in lib/manifest.crlb.
#
# `target "arch"` groups the OS trees that arch carries; each
# `platform "os"` child names the directory probed first for neutral
# imports.
manifest "core" {
    version = "0.1.0";

    target "x86_64" {
        platform "linux"   { path = "x86_64/linux"; }
        platform "windows" { path = "x86_64/windows"; }
    }
    target "arm64" {
        platform "linux"   { path = "arm64/linux"; }
        platform "android" { path = "arm64/android"; }
        platform "macos"   { path = "arm64/macos"; }
        platform "windows" { path = "arm64/windows"; }
    }
}
