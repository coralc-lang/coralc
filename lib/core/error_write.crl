#[[no_drop_all]]
/// Low-level unbuffered writers shared by the error reporter and the
/// platform error backends. Async-signal-safe: one `write(2, …)` per
/// piece, no buffering, no allocation.

import core::cchar { cchar };
import platform::libc { write };

/// Write a Coral str to fd (casts to the libc `const cchar*` only at the
/// boundary).
pub void _wr(i32 fd, str s) { write(fd, (const cchar*)s.ptr, s.len); }

/// Write a u64 as hex, skipping leading zeros (always at least one digit).
pub void _wrHex(i32 fd, u64 v)
{
    _wr(fd, "0x");
    bool started = false;
    for (i32 shift = 60; shift >= 0; shift -= 4)
    {
        u8 d = (u8)((v >> (u64)shift) & 0xF);
        if (!started && d == 0 && shift != 0) continue;
        started = true;
        cchar c = (d < 10) ? (cchar)(48 + d) : (cchar)(87 + d);
        write(fd, &c, 1);
    }
}

/// Write a u64 as decimal.
pub void _wrDec(i32 fd, u64 v)
{
    if (v == 0) { _wr(fd, "0"); return; }
    cchar[20] buf;
    i32 i = 0;
    while (v > 0) { buf[i] = (cchar)(48 + (v % 10)); v /= 10; i++; }
    while (i > 0) { i--; cchar d = buf[i]; write(fd, &d, 1); }
}
