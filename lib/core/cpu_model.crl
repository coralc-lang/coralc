#[[no_drop_all]]
/// Compiler-side target description. NOT the runtime detector — the detector
/// answers "what is this CPU", this answers "what does the compiler do with
/// that answer". Three layers, kept separate on purpose (LLVM does the same):
///
///   isa  : what is legal to emit          (isel, encoder)
///   tune : what is fast/slow on this CPU  (peepholes, vectorizer, emitter)
///   p    : machine params (numbers)       (scheduler, prefetch, layout)
///
/// RULE: passes never test CPU names, only flags/params. Detection only
/// PICKS a row from the table below.
///
/// Suggested MIDR -> row mapping, keyed on (implementer, part):
///   0x41 0xd03/0xd05 cortex-a55   0x41 0xd0b cortex-a76   0x41 0xd0c neoverse-n1
///   0x41 0xd40 neoverse-v1        0x41 0xd49 neoverse-n2  0x41 0xd4f neoverse-v2
/// Apple: key on hw.cpufamily instead of MIDR.
/// No match -> generic armv8.x row (add a generic-armv8.2 row) + detected features.

pub struct Inst {}

pub struct CpuParams
{
    u16 cacheLine;           // 64, or 128 on Apple
    u16 prefetchDist;
    u8  loopAlignLog2;
    u8  funcAlignLog2;
    u8  issueWidth;
    u8  mispredictPenalty;
    u16 preferredVecBits;    // 256 even if 512 is legal
}

pub struct CpuModel
{
    str name;                // "skylake", "zen4", "apple-m1"
    u64 isa;                 // ISA feature bits
    u64 tune;                // tuning flag bits
    CpuParams p;
}

// ---- peephole rules: gated data, not `if (cpu == X)` -----------------------
pub struct PeepRule
{
    u64 needIsa, needTune, forbidTune;
    bool(Inst*) match;
    void(Inst*) rewrite;
}

// ---- register classes: data, conditional on ISA features --------------------
pub struct RegClass
{
    str name;
    i32 count;               // e.g. vec: has(AVX512F) ? 32 : 16
    u64 calleeSavedMask;     // from the ABI description
    // aliasing (xmm/ymm/zmm, AL/AX/EAX/RAX) and encoding constraints
    // (r8+ needs REX, 16..31 needs EVEX) belong here too.
}
// Example:
//   RegClass vec = RegClass { .name = "vec", .count = has(AVX512F) ? 32 : 16,
//                             .calleeSavedMask = abi->vec_saved };

// ---- ISA bit sets (PLACEHOLDERS: define the real feature bits per target) --
pub const u64 ISA_X64_V3   = (u64)1 << 0;
pub const u64 ISA_X64_V4   = ((u64)1 << 0) | ((u64)1 << 1);    // superset of v3
pub const u64 ISA_A64_V8_2 = (u64)1 << 8;
pub const u64 ISA_A64_V8_5 = ((u64)1 << 8) | ((u64)1 << 9);    // superset of v8.2

// ---- x64 tuning flags (LLVM equivalents: TuningSlow3OpsLEA, TuningPrefer256Bit,
//      TuningMacroFusion, ...) -------------------------------------------------
pub const u64 X64_T_SLOW_LEA3         = (u64)1 << 0;  // 3-component LEA is slow (use add+add or lea+add)
pub const u64 X64_T_ZERO_IDIOM        = (u64)1 << 1;  // xor r,r is dependency-breaking (true on all modern)
pub const u64 X64_T_FALSE_DEP_POPCNT  = (u64)1 << 2;  // popcnt/lzcnt/tzcnt have false dest dependency
pub const u64 X64_T_FALSE_DEP_CVT     = (u64)1 << 3;  // cvtsi2sd, sqrtss etc. merge into dest
pub const u64 X64_T_PREFER_256        = (u64)1 << 4;  // cap auto-vectorizer at 256 even if AVX-512 legal
pub const u64 X64_T_JCC_ERRATUM       = (u64)1 << 5;  // pad around 32B boundaries (relaxation at emit time)
pub const u64 X64_T_MACRO_FUSION      = (u64)1 << 6;  // schedule cmp+jcc adjacent
pub const u64 X64_T_SLOW_DIV64        = (u64)1 << 7;  // 64-bit idiv is very slow, guard with 32-bit check
pub const u64 X64_T_VZEROUPPER_NEEDED = (u64)1 << 8;  // AVX<->SSE transition penalty
pub const u64 X64_T_SLOW_UNALIGNED16  = (u64)1 << 9;

// ---- arm64 tuning flags ------------------------------------------------------
// Fixed 4-byte instructions: no JCC erratum, no length padding, no lea.
pub const u64 A64_T_ZERO_CYCLE_ZERO   = (u64)1 << 0;  // movi v,#0 / mov x,#0 handled at rename
pub const u64 A64_T_ZERO_CYCLE_MOV    = (u64)1 << 1;  // reg-reg moves eliminated at rename
pub const u64 A64_T_FUSE_AES          = (u64)1 << 2;  // keep aese+aesmc adjacent
pub const u64 A64_T_FUSE_CMP_BR       = (u64)1 << 3;  // cmp/cmn/tst + b.cond
pub const u64 A64_T_FUSE_ADRP_ADD     = (u64)1 << 4;
pub const u64 A64_T_SLOW_MISALIGNED_Q = (u64)1 << 5;  // 128-bit store crossing alignment is slow
pub const u64 A64_T_BALANCE_FP_OPS    = (u64)1 << 6;  // alternate FP pipes in fmadd chains
pub const u64 A64_T_CSEL_EXPENSIVE    = (u64)1 << 7;  // predictable branches beat csel on some cores
pub const u64 A64_T_LDP_STP_ALIGN     = (u64)1 << 8;  // pairs penalized if they cross a line

// ---- sample rows --------------------------------------------------------------
// p = { cacheLine, prefetchDist, loopAlignLog2, funcAlignLog2,
//       issueWidth, mispredictPenalty, preferredVecBits }
// Numbers are APPROXIMATE starting values. Verify against uops.info, Agner Fog's
// tables, vendor optimization manuals, or by running llvm-mca on LLVM's models.
// Always keep a generic row per target as the fallback for unknown CPUs.
pub CpuModel[5] models = {
    CpuModel { .name = "x86-64-v3", .isa = ISA_X64_V3, .tune = X64_T_ZERO_IDIOM,
        .p = CpuParams { .cacheLine = 64, .prefetchDist = 0, .loopAlignLog2 = 4,
                         .funcAlignLog2 = 4, .issueWidth = 4, .mispredictPenalty = 16,
                         .preferredVecBits = 256 } },  // generic

    CpuModel { .name = "skylake", .isa = ISA_X64_V3,
        .tune = X64_T_ZERO_IDIOM | X64_T_JCC_ERRATUM | X64_T_MACRO_FUSION
              | X64_T_FALSE_DEP_POPCNT | X64_T_PREFER_256 | X64_T_SLOW_DIV64
              | X64_T_VZEROUPPER_NEEDED,
        .p = CpuParams { .cacheLine = 64, .prefetchDist = 0, .loopAlignLog2 = 4,
                         .funcAlignLog2 = 4, .issueWidth = 4, .mispredictPenalty = 16,
                         .preferredVecBits = 256 } },

    CpuModel { .name = "zen4", .isa = ISA_X64_V4,
        .tune = X64_T_ZERO_IDIOM | X64_T_MACRO_FUSION,    // no JCC erratum, AVX-512 is fine
        .p = CpuParams { .cacheLine = 64, .prefetchDist = 0, .loopAlignLog2 = 4,
                         .funcAlignLog2 = 4, .issueWidth = 6, .mispredictPenalty = 13,
                         .preferredVecBits = 512 } },

    CpuModel { .name = "apple-m1", .isa = ISA_A64_V8_5,
        .tune = A64_T_ZERO_CYCLE_ZERO | A64_T_ZERO_CYCLE_MOV | A64_T_FUSE_AES
              | A64_T_FUSE_CMP_BR,
        .p = CpuParams { .cacheLine = 128, .prefetchDist = 0, .loopAlignLog2 = 4,  // 128B lines
                         .funcAlignLog2 = 4, .issueWidth = 8, .mispredictPenalty = 14,
                         .preferredVecBits = 128 } },

    CpuModel { .name = "neoverse-n1", .isa = ISA_A64_V8_2,
        .tune = A64_T_FUSE_CMP_BR | A64_T_FUSE_ADRP_ADD,
        .p = CpuParams { .cacheLine = 64, .prefetchDist = 0, .loopAlignLog2 = 4,
                         .funcAlignLog2 = 4, .issueWidth = 4, .mispredictPenalty = 11,
                         .preferredVecBits = 128 } },
};
