import cchar;
import char_util;

import(lib) platform::libc;
import(lib) std::string { String };
// the default str inbuilt
// pub struct str {
//     const u8* ptr;
//     usize len;
// }

pub extend str
{
    static str fromCstr(const cchar::cchar* cstr)
    {
        return str {
            .ptr = (const u8*)cstr,
            .len = (usize)libc::strlen(cstr)
        };
    }

    static str fromParts(const u8* ptr, usize len)
    {
        return str {
            .ptr = ptr,
            .len = len,
        };
    }

    static str empty()
    {
        return "";
    }

    String asString() {
        return String {
            .ptr = (u8*)self.ptr,
            .len = self.len
        };
    }
    
    const u8* asU8() { return self.ptr; }

    u8 at(usize idx)
    {
        @assert(idx < self.len);
        return self.ptr[idx];
    }

    bool isEmpty() { return self.len == 0; }

    bool equals(str other)
    {
        if (self.len != other.len) return false;
        return libc::memcmp((const void*)self.ptr, (const void*)other.ptr, (u64)self.len) == 0;
    }

    i32 compare(str other)
    {
        usize minLen = self.len < other.len ? self.len : other.len;
        i32 r = libc::memcmp((const void*)self.ptr, (const void*)other.ptr, (u64)minLen);
        if (r != 0) return r;
        if (self.len < other.len) return -1;
        if (self.len > other.len) return 1;
        return 0;
    }

    bool startsWith(str prefix)
    {
        if (prefix.len > self.len) return false;
        return libc::memcmp((const void*)self.ptr, (const void*)prefix.ptr, (u64)prefix.len) == 0;
    }

    bool endsWith(str suffix)
    {
        if (suffix.len > self.len) return false;
        return libc::memcmp((const void*)(self.ptr + (self.len - suffix.len)),
                      (const void*)suffix.ptr, (u64)suffix.len) == 0;
    }

    bool containsView(str needle)
    {
        return self.findView(needle) < self.len;
    }

    bool containsByte(u8 c)
    {
        return self.findByte(c) < self.len;
    }

    usize findByte(u8 c)
    {
        for (usize i = 0; i < self.len; i++)
            if (self.ptr[i] == c) return i;
        return self.len;
    }

    usize rfindByte(u8 c)
    {
        usize i = self.len;
        while (i > 0)
        {
            i--;
            if (self.ptr[i] == c) return i;
        }
        return self.len;
    }

    usize findView(str needle)
    {
        if (needle.len == 0) return 0;
        if (needle.len > self.len) return self.len;
        for (usize i = 0; i <= self.len - needle.len; i++)
        {
            if (libc::memcmp((const void*)(self.ptr + i),
                                (const void*)needle.ptr,
                                (u64)needle.len) == 0)
                return i;
        }
        return self.len;
    }

    str slice(usize start, usize end)
    {
        @assert(start <= end);
        @assert(end <= self.len);
        return str::fromParts(self.ptr + start, end - start);
    }

    str trimStart()
    {
        usize i = 0;
        while (i < self.len && (self.ptr[i] == (u8)' ' ||
                                 self.ptr[i] == (u8)'\t' ||
                                 self.ptr[i] == (u8)'\n' ||
                                 self.ptr[i] == (u8)'\r')) i++;
        return str::fromParts(self.ptr + i, self.len - i);
    }

    str trimEnd()
    {
        usize e = self.len;
        while (e > 0 && (self.ptr[e-1] == (u8)' ' ||
                          self.ptr[e-1] == (u8)'\t' ||
                          self.ptr[e-1] == (u8)'\n' ||
                          self.ptr[e-1] == (u8)'\r')) e--;
        return str::fromParts(self.ptr, e);
    }

    str trim()
    {
        str t = self.trimStart();
        return t.trimEnd();
    }

    bool isAsciiDigit()
    {
        for (usize i = 0; i < self.len; i++)
        {
            u8 c = self.ptr[i];
            if (!char_util::isDigit(c)) return false;
        }
        return self.len > 0;
    }

    bool isAsciiAlpha()
    {
        for (usize i = 0; i < self.len; i++)
        {
            u8 c = self.ptr[i];
            if (!char_util::isAlpha(c)) return false;
        }
        return self.len > 0;
    }

    bool isAsciiAlnum()
    {
        for (usize i = 0; i < self.len; i++)
        {
            u8 c = self.ptr[i];
            if (!char_util::isAlnum(c)) return false;
        }
        return self.len > 0;
    }

    // Codepoint iteration over the utf8-backed bytes. *idx is a byte
    // offset into the view; each successful call stores one char in
    // *out and advances *idx past its sequence. Returns false when
    // *idx is at (or past) the end. Invalid bytes decode as U+FFFD
    // and advance one byte — the replacement policy of
    // char_util::charDecodeUtf8 — so the cursor always makes progress.
    bool nextCodepoint(usize* idx, char* out)
    {
        if (*idx >= self.len) return false;
        usize consumed;
        *out = char_util::charDecodeUtf8(self.ptr + *idx, self.len - *idx, &consumed);
        *idx += consumed;
        return true;
    }

    usize codepointCount()
    {
        usize idx = 0;
        usize n = 0;
        char c;
        while (self.nextCodepoint(&idx, &c)) n++;
        return n;
    }
}
