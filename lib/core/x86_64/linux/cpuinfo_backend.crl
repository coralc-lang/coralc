#[[no_drop_all]]
/// x86-64 detection via cpuid + xgetbv.
///
/// Three ways to reach the instructions. This port uses the SHIM route: the
/// coral toolchain has no cpuid/xgetbv intrinsic yet (see lang_sketches.txt
/// for the ones that would be needed) and no inline asm, so the instructions
/// live in shim_x64_sysv.asm / shim_x64_win.asm (nasm) and are linked as
/// extern("C") calls. When the backend grows the intrinsics, replace
/// cpuid_count_() and xgetbv0() below with them; the rest of the file
/// translates line for line. The detection itself is OS-independent, so
/// x86_64/linux and x86_64/windows carry the same code.
import core::cpuinfo { CpuInfo, CpuCache, CpuArch, CpuFeature, setFeature, isAmd };

pub extern("C") void cpuid_raw(u32 leaf, u32 sub, u32* out);
pub extern("C") u64 xgetbv_raw(u32 idx);

void cpuid_count_(u32 leaf, u32 sub, u32* a, u32* b, u32* c, u32* d)
{
    u32[4] r;
    cpuid_raw(leaf, sub, (u32*)r);
    *a = r[0];
    *b = r[1];
    *c = r[2];
    *d = r[3];
}

void xgetbv0(u32* lo, u32* hi)
{
    u64 v = xgetbv_raw(0);
    *lo = (u32)v;
    *hi = (u32)(v >> 32);
}

void _writeLe32(u8* dst, u32 v)
{
    dst[0] = (u8)v;
    dst[1] = (u8)(v >> 8);
    dst[2] = (u8)(v >> 16);
    dst[3] = (u8)(v >> 24);
}

void x86_detect(CpuInfo* o)
{
    u32 a;
    u32 b;
    u32 c;
    u32 d;
    u32 max;
    u32 extMax;

    cpuid_count_(0, 0, &max, &b, &c, &d);               // vendor in b, d, c
    _writeLe32(&o->vendor[0], b);
    _writeLe32(&o->vendor[4], d);
    _writeLe32(&o->vendor[8], c);

    cpuid_count_(1, 0, &a, &b, &c, &d);
    o->family   = ((a >> 8) & 0xF) + ((((a >> 8) & 0xF) == 0xF) ? ((a >> 20) & 0xFF) : 0);
    o->model    = ((a >> 4) & 0xF) | ((((a >> 8) & 0xF) >= 6) ? (((a >> 16) & 0xF) << 4) : 0);
    o->stepping = a & 0xF;

    if (((c >> 20) & 1) != 0) setFeature(o, CpuFeature::X86Sse42);

    // OS support check: the CPU may advertise AVX/AVX-512 while the OS or
    // hypervisor has not enabled the register state. Emitting those
    // instructions then gives SIGILL, so always consult XCR0.
    bool osxsave = ((c >> 27) & 1) != 0;
    bool avxOs = false;
    bool avx512Os = false;
    if (osxsave)
    {
        u32 lo;
        u32 hi;
        xgetbv0(&lo, &hi);
        avxOs    = (lo & 0x6)  == 0x6;     // XMM + YMM state enabled by OS
        avx512Os = (lo & 0xE6) == 0xE6;    // + opmask, ZMM_Hi256, Hi16_ZMM
    }
    if (avxOs && (((c >> 28) & 1) != 0)) setFeature(o, CpuFeature::X86Avx);
    if (avxOs && (((c >> 12) & 1) != 0)) setFeature(o, CpuFeature::X86Fma);

    if (max >= 7)
    {
        cpuid_count_(7, 0, &a, &b, &c, &d);
        if (avxOs && (((b >> 5) & 1) != 0))     setFeature(o, CpuFeature::X86Avx2);
        if (avx512Os && (((b >> 16) & 1) != 0)) setFeature(o, CpuFeature::X86Avx512f);
        if (avx512Os && (((b >> 31) & 1) != 0)) setFeature(o, CpuFeature::X86Avx512vl);
        if (((b >> 8) & 1) != 0)                setFeature(o, CpuFeature::X86Bmi2);
    }

    // Brand string (leaves 0x80000002..4)
    cpuid_count_(0x80000000u, 0, &extMax, &b, &c, &d);
    if (extMax >= 0x80000004u)
    {
        u32[4] r;
        for (u32 i = 0; i < 3; i++)
        {
            cpuid_count_(0x80000002u + i, 0, &r[0], &r[1], &r[2], &r[3]);
            u8* brand = &o->brand[0] + (usize)i * 16;
            _writeLe32(brand + 0, r[0]);
            _writeLe32(brand + 4, r[1]);
            _writeLe32(brand + 8, r[2]);
            _writeLe32(brand + 12, r[3]);
        }
    }

    // Caches: leaf 4 (Intel) or 0x8000001D (AMD, needs TOPOEXT)
    u32 leaf = 4;
    bool usable;
    if (isAmd(o))
    {
        leaf = 0x8000001Du;
        cpuid_count_(0x80000001u, 0, &a, &b, &c, &d);
        usable = (((c >> 22) & 1) != 0) && extMax >= leaf;        // TOPOEXT
    }
    else
    {
        usable = max >= 4;
    }
    if (!usable) return;                                    // leave caches at 0 = unknown

    for (u32 i = 0; i < 32; i++)
    {
        cpuid_count_(leaf, i, &a, &b, &c, &d);
        u32 type = a & 0x1F;
        u32 level = (a >> 5) & 7;
        if (type == 0) break;
        CpuCache k;
        k.size      = ((b >> 22) + 1) * (((b >> 12) & 0x3FF) + 1) * ((b & 0xFFF) + 1) * (c + 1);
        k.lineSize  = (b & 0xFFF) + 1;
        k.assoc     = (b >> 22) + 1;
        k.sharedBy  = ((a >> 14) & 0xFFF) + 1;
        if (level == 1 && type == 1) o->l1d = k;
        else if (level == 1 && type == 2) o->l1i = k;
        else if (level == 2) o->l2 = k;
        else if (level == 3) o->l3 = k;
    }
}

pub void detectCpu(CpuInfo* o)
{
    o->arch = CpuArch::X86_64;
    x86_detect(o);
}
