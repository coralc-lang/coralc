#[[no_drop_all]]
/// Windows (x86_64) error backend: kernel32 `CaptureStackBackTrace` and a
/// top-level SEH unhandled-exception filter. The public surface and
/// formatting live in `core/error.crl`.

import core::error_write { _wr, _wrHex, _wrDec };
import platform::libc { _exit };
import platform::win32 { CaptureStackBackTrace, SetUnhandledExceptionFilter, TerminateProcess, GetCurrentProcess };

// Windows exception codes we name explicitly (ntstatus-style).
const u32 EXC_ACCESS_VIOLATION      = 0xC0000005;
const u32 EXC_ILLEGAL_INSTRUCTION   = 0xC000001D;
const u32 EXC_ARRAY_BOUNDS          = 0xC000008C;
const u32 EXC_FLT_DIVIDE_BY_ZERO    = 0xC000008E;
const u32 EXC_FLT_INVALID_OPERATION = 0xC0000093;
const u32 EXC_INT_DIVIDE_BY_ZERO    = 0xC0000094;
const u32 EXC_INTEGER_OVERFLOW      = 0xC0000095;
const u32 EXC_PRIVILEGED_INSTRUCTION= 0xC0000026;

// EXCEPTION_CONTINUE_SEARCH: pass the exception to the OS default handler so a
// debugger / WER crash dump still fires after our report.
const i32 EXC_CONTINUE_SEARCH = 0;

// Reentrancy guard: never let a crash during reporting re-enter the filter.
static bool _handling = false;

void _wrExcName(i32 fd, u32 code)
{
    switch (code) {
        EXC_ACCESS_VIOLATION => { _wr(fd, "ACCESS_VIOLATION"); },
        EXC_ILLEGAL_INSTRUCTION => { _wr(fd, "ILLEGAL_INSTRUCTION"); },
        EXC_ARRAY_BOUNDS => { _wr(fd, "ARRAY_BOUNDS_EXCEEDED"); },
        EXC_FLT_DIVIDE_BY_ZERO => { _wr(fd, "FLT_DIVIDE_BY_ZERO"); },
        EXC_FLT_INVALID_OPERATION => { _wr(fd, "FLT_INVALID_OPERATION"); },
        EXC_INT_DIVIDE_BY_ZERO => { _wr(fd, "INT_DIVIDE_BY_ZERO"); },
        EXC_INTEGER_OVERFLOW => { _wr(fd, "INTEGER_OVERFLOW"); },
        EXC_PRIVILEGED_INSTRUCTION => { _wr(fd, "PRIVILEGED_INSTRUCTION"); },
        else => { _wr(fd, "exception "); _wrHex(fd, (u64)code); }
    }
}

/// Print a captured backtrace to fd (raw addresses; resolve with the debugger
/// or `addr2line`-style tooling). Best-effort; one line per frame.
pub void _btTo(i32 fd)
{
    rawptr[32] frames;
    u32 hash = 0;
    u32 n = CaptureStackBackTrace(0, 32, frames, &hash);
    if (n == 0) { _wr(fd, "  <no frames>\n"); return; }
    _wr(fd, "  stack:\n");
    for (u32 i = 0; i < n; i++)
    {
        _wr(fd, "  #");
        _wrDec(fd, (u64)i);
        _wr(fd, " ");
        _wrHex(fd, (u64)frames[i]);
        _wr(fd, "\n");
    }
}

/// Terminate the process with the given exit code (134 mirrors Linux abort).
pub void _abortNow()
{
    TerminateProcess((rawptr)GetCurrentProcess, 134);
    _exit(134); // fallback
}

/// Platform crash-report channel (bionic tombstones); no-op on Windows.
pub void _notify(str msg) { }

// Top-level SEH filter. `ep` is an EXCEPTION_POINTERS*; the exception code is
// EXCEPTION_POINTERS->ExceptionRecord->ExceptionCode, both at offset 0.
i32 _excFilter(rawptr ep)
{
    if (_handling) return EXC_CONTINUE_SEARCH; // recursion: let the OS proceed
    _handling = true;

    rawptr rec = *(rawptr*)ep;   // EXCEPTION_RECORD*
    u32 code = *(u32*)rec;       // ExceptionCode

    _wr(2, "\ncoral: fatal: ");
    _wrExcName(2, code);
    _wr(2, "\n");
    _btTo(2);
    _wr(2, "\n");

    // Pass the exception on so the OS default handler (debugger / WER dump)
    // still runs after our report.
    return EXC_CONTINUE_SEARCH;
}

/// Install a concise top-level crash handler (SEH unhandled-exception filter).
pub void _catchFatal()
{
    SetUnhandledExceptionFilter((rawptr)_excFilter);
}
