#[[no_drop_all]]
/// Concise fatal assertions with stack-ish unwinding.
///
/// A cleaner replacement for the `@_assert` / `@assertOut` builtins: instead of
/// dumping the raw C assertion expression, a failure prints a short message plus
/// a symbolized backtrace to stderr, then aborts with a core dump.
///
///   import core::error;
///   error._assert(x > 0);
///   error.assertOut(i < self.len, "index out of bounds");
///
/// Everything is written with `write(2, ...)` (no stdio buffering) so the report
/// survives a crash and can also be reused from a signal handler.
import(lib) platform::libc { write, strlen, signal, raise, _exit, backtrace, backtrace_symbols_fd };

// libc unwinder (glibc <execinfo.h>); not re-exported by platform::libc.
extern("C") i32 backtrace(rawptr buffer, i32 size);
extern("C") i32 backtrace_symbols_fd(rawptr buffer, i32 size, i32 fd);

// Signal numbers (linux x86_64). Kept local so this module has no std deps
// beyond platform::libc and can be used from anywhere, including core.
const i32 SIGABRT_ = 6;
const i32 SIGBUS_  = 7;
const i32 SIGFPE_  = 8;
const i32 SIGILL_  = 4;
const i32 SIGSEGV_ = 11;

// Reentrancy guard: never let a crash during reporting re-enter the handler.
static bool _handling = false;

void _wrC(i32 fd, const cchar* s) { write(fd, s, strlen(s)); }
void _wrStr(i32 fd, str s) { write(fd, (const cchar*)s.ptr, s.len); }

// Write a u64 as hex, skipping leading zeros (always at least one digit).
void _wrHex(i32 fd, u64 v)
{
    _wrC(fd, "0x");
    bool started = false;
    for (i32 shift = 60; shift >= 0; shift -= 4)
    {
        u8 d = (u8)((v >> shift) & 0xF);
        if (!started && d == 0 && shift != 0) continue;
        started = true;
        cchar c = (d < 10) ? (cchar)(48 + d) : (cchar)(87 + d);
        write(fd, &c, 1);
    }
}

void _wrSigName(i32 fd, i32 sig)
{
    if (sig == SIGSEGV_) _wrC(fd, "SIGSEGV (segmentation fault)");
    else if (sig == SIGBUS_)  _wrC(fd, "SIGBUS (bus error)");
    else if (sig == SIGILL_)  _wrC(fd, "SIGILL (illegal instruction)");
    else if (sig == SIGFPE_)  _wrC(fd, "SIGFPE (arithmetic fault)");
    else if (sig == SIGABRT_) _wrC(fd, "SIGABRT (abort)");
    else { _wrC(fd, "signal "); _wrHex(fd, (u64)sig); }
}

/// Print a symbolized backtrace to fd. Best-effort; each line is one frame.
pub void backtraceTo(i32 fd)
{
    rawptr buf[32];
    i32 n = backtrace(buf, 32);
    if (n <= 0) { _wrC(fd, "  <no frames>\n"); return; }
    _wrC(fd, "  stack:\n");
    backtrace_symbols_fd(buf, n, fd);
}

/// Print a concise fatal report (message + backtrace) to stderr. Async-signal-safe.
pub void report(str msg)
{
    _wrC(2, "\ncoral: error: ");
    _wrStr(2, msg);
    _wrC(2, "\n");
    backtraceTo(2);
    _wrC(2, "\n");
}

/// Like `report`, but appends `name = 0x<hex>` before the backtrace.
pub void reportHex(str msg, str name, u64 value)
{
    _wrC(2, "\ncoral: error: ");
    _wrStr(2, msg);
    _wrC(2, " (");
    _wrStr(2, name);
    _wrC(2, " = ");
    _wrHex(2, value);
    _wrC(2, ")\n");
    backtraceTo(2);
    _wrC(2, "\n");
}

/// Abort the process with a core dump (restores the default SIGABRT first).
pub void abortNow()
{
    signal(SIGABRT_, (rawptr)(usize)0); // SIG_DFL
    raise(SIGABRT_);
    _exit(134); // 128 + SIGABRT fallback if the raise is somehow caught
}

/// Concise _assert: on failure print "assertion failed" + backtrace, then abort.
pub void _assert(bool cond)
{
    if (!cond)
    {
        report("assertion failed");
        abortNow();
    }
}

/// Concise _assert with a message: on failure print the message + backtrace, abort.
pub void assertOut(bool cond, str msg)
{
    if (!cond)
    {
        report(msg);
        abortNow();
    }
}

void _fatalHandler(i32 sig)
{
    if (_handling) _exit(128 + sig); // recursion: bail immediately
    _handling = true;

    _wrC(2, "\ncoral: fatal: ");
    _wrSigName(2, sig);
    _wrC(2, "\n");
    backtraceTo(2);
    _wrC(2, "\n");

    // Restore the default disposition and re-raise so the exit status and core
    // dump reflect the real signal rather than a silent _exit.
    signal(sig, (rawptr)(usize)0); // SIG_DFL
    raise(sig);
    _exit(128 + sig);
}

/// Install concise handlers for the common crash signals (SEGV/BUS/ILL/FPE).
/// A crash then prints the signal name + a backtrace before dying with a core.
pub void catchFatalSignals()
{
    signal(SIGSEGV_, (rawptr)_fatalHandler);
    signal(SIGBUS_,  (rawptr)_fatalHandler);
    signal(SIGILL_,  (rawptr)_fatalHandler);
    signal(SIGFPE_,  (rawptr)_fatalHandler);
}
