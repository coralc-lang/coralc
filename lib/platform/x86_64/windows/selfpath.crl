// Running-executable path for cache fingerprints and diagnostics.
// GetModuleFileNameA(NULL, ...) returns the path of the executable
// that created the calling process. 32k covers long-path binaries.
import std::mman { alloc };
import core::cchar { cchar };
import platform::win32 { GetModuleFileNameA };

pub str selfExePath()
{
    usize cap = 32768;
    u8* buf = alloc<u8>(cap + 1);
    u32 n = GetModuleFileNameA(null, (cchar*)buf, (u32)cap);
    if (n == 0 || (usize)n >= cap)
    {
        buf[0] = 0;
        return str::fromParts(buf, 0);
    }
    return str::fromParts(buf, (usize)n);
}
