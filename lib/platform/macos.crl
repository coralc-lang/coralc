import(lib) core::cchar { cchar };

// macOS / Darwin platform bindings (beyond the shared POSIX layer in libc.crl).
// Functions that exist on macOS but not (or with a different signature) on
// linux/android. `platform::libc` still supplies the common POSIX surface.

// Randomness (BSD arc4random family — auto-seeded, no init required)
pub extern("C") u32 arc4random();
pub extern("C") void arc4random_buf(rawptr buf, u64 nbytes);
pub extern("C") u32 arc4random_uniform(u32 upperBound);

// Mach timing
pub extern("C") u64 mach_absolute_time();
pub extern("C") void mach_timebase_info(rawptr info);

// sysctl
pub extern("C") i32 sysctlbyname(const cchar* name, rawptr oldp, u64* oldlenp, rawptr newp, u64 newlen);

// libproc (process info)
pub extern("C") i32 proc_pidpath(i32 pid, rawptr buffer, u32 buffersize);
pub extern("C") i32 proc_name(i32 pid, rawptr buffer, u32 buffersize);

// Thread naming (macOS signature: applies to the calling thread, no thread arg)
pub extern("C") i32 pthread_setname_np(const cchar* name);
pub extern("C") i32 pthread_getname_np(cchar* name, u64 len);

// Program name
pub extern("C") const cchar* getprogname();
pub extern("C") void setprogname(const cchar* name);
