import(lib) core::cchar { cchar };

// Android / bionic platform bindings (beyond the shared POSIX layer in libc.crl).
// bionic provides most POSIX calls via libc.crl, but has no <execinfo.h>
// backtrace() — the android error module works around that and uses the
// abort-message / log hooks below.

// Abort message shown in the crash tombstone (bionic-specific; the android
// error module sets this so tombstones carry the real failure text).
pub extern("C") void android_set_abort_message(const cchar* msg);

// Logging to logcat
pub extern("C") i32 __android_log_write(i32 prio, const cchar* tag, const cchar* text);
pub extern("C") i32 __android_log_print(i32 prio, const cchar* tag, const cchar* fmt, ...);

// System properties
pub extern("C") i32 __system_property_get(const cchar* name, cchar* value);

// Randomness (bionic has getrandom)
pub extern("C") i32 getrandom(rawptr buf, u64 buflen, u32 flags);

// Thread naming (bionic signature: explicit thread + name)
pub extern("C") i32 pthread_setname_np(rawptr thread, const cchar* name);
