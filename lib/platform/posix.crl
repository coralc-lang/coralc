/* POSIX socket / byte-order externs. These live apart from libc.crl so a
 * windows build — which shares libc for snprintf/malloc/etc. — never sees
 * the int-fd prototypes that clash with win32.crl's rawptr SOCKET versions. */

pub extern("C") i32 socket(i32 domain, i32 type, i32 protocol);
pub extern("C") i32 connect(i32 fd, const rawptr addr, i32 addrlen);
pub extern("C") i32 bind(i32 fd, const rawptr addr, i32 addrlen);
pub extern("C") i32 listen(i32 fd, i32 backlog);
pub extern("C") i32 accept(i32 fd, rawptr addr, i32* addrlen);
pub extern("C") i32 setsockopt(i32 fd, i32 level, i32 optname, const u8* optval, i32 optlen);
pub extern("C") i64 send(i32 fd, const u8* buf, u64 len, i32 flags);
pub extern("C") i64 recv(i32 fd, u8* buf, u64 len, i32 flags);
pub extern("C") i64 sendto(i32 fd, const u8* buf, u64 len, i32 flags, const rawptr dstAddr, i32 addrLen);
pub extern("C") i64 recvfrom(i32 fd, u8* buf, u64 len, i32 flags, rawptr srcAddr, i32* addrLen);
pub extern("C") u32 htonl(u32 hostlong);
pub extern("C") u16 htons(u16 hostshort);
pub extern("C") u32 ntohl(u32 netlong);
pub extern("C") u16 ntohs(u16 netshort);
