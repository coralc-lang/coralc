schema = 1;

# platform module manifest — activated by `extends "manifest.crlb"` on the
# `module "platform"` entry in lib/manifest.crlb. Neutral imports probe the
# per-target directory first, then fall back to the flat module tree.
manifest "platform" {
    target "x86_64" {
        platform "linux"   { path = "x86_64/linux"; }
        platform "windows" { path = "x86_64/windows"; }
    }
    target "arm64" {
        platform "linux"   { path = "arm64/linux"; }
        platform "macos"   { path = "arm64/macos"; }
        platform "android" { path = "arm64/android"; }
    }
}
