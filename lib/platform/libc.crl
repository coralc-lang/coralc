pub extern("C") i32 pthread_cond_signal(rawptr cond);
pub extern("C") i32 pthread_cond_broadcast(rawptr cond);
pub extern("C") i32 pthread_cond_timedwait(rawptr cond, rawptr mutex, rawptr abstime);

pub extern("C") i32 pthread_rwlock_init(rawptr lock, const rawptr attr);
