pub extern("C") i32 sem_getvalue(rawptr sem, i32* sval);

pub extern("C") cchar** environ;

// net externs moved to posix.crl (windows shares this file for snprintf and
// friends; the int-fd socket prototypes clash with win32.crl's SOCKET ones)

// --- farmed additions (portable POSIX; shared by linux / macos / android) ---

// Memory: memcpy/memmove/memset/memchr live in std::mman intrinsics.

// String
pub extern("C") cchar* strchr(const cchar* s, i32 c);
pub extern("C") cchar* strrchr(const cchar* s, i32 c);
pub extern("C") cchar* strstr(const cchar* haystack, const cchar* needle);
pub extern("C") cchar* strdup(const cchar* s);
pub extern("C") cchar* strndup(const cchar* s, u64 n);
pub extern("C") cchar* strncpy(cchar* dst, const cchar* src, u64 n);
pub extern("C") i32 strncmp(const cchar* a, const cchar* b, u64 n);
pub extern("C") cchar* strncat(cchar* dst, const cchar* src, u64 n);
pub extern("C") cchar* strcat(cchar* dst, const cchar* src);
pub extern("C") cchar* strtok_r(cchar* s, const cchar* delim, cchar** saveptr);
pub extern("C") u64 strspn(const cchar* s, const cchar* accept);
pub extern("C") u64 strcspn(const cchar* s, const cchar* reject);
pub extern("C") cchar* strpbrk(const cchar* s, const cchar* accept);

// Conversion
pub extern("C") i32 atoi(const cchar* nptr);
pub extern("C") i64 atol(const cchar* nptr);
pub extern("C") f64 atof(const cchar* nptr);
pub extern("C") i64 strtol(const cchar* nptr, cchar** endptr, i32 base);
pub extern("C") u64 strtoul(const cchar* nptr, cchar** endptr, i32 base);
pub extern("C") i64 strtoll(const cchar* nptr, cchar** endptr, i32 base);
pub extern("C") u64 strtoull(const cchar* nptr, cchar** endptr, i32 base);

// Process / identity
pub extern("C") i32 getpid();
pub extern("C") i32 getppid();
pub extern("C") i32 getuid();
pub extern("C") i32 geteuid();
pub extern("C") i32 getgid();
pub extern("C") i32 getegid();
pub extern("C") void exit(i32 status);
pub extern("C") void abort();
pub extern("C") i32 atexit(void() func);
pub extern("C") cchar* getcwd(cchar* buf, u64 size);

// Misc
pub extern("C") i32 abs(i32 v);
pub extern("C") i64 labs(i64 v);
pub extern("C") i64 llabs(i64 v);
pub extern("C") i32 rand();
pub extern("C") void srand(u32 seed);
pub extern("C") void qsort(rawptr base, u64 nmemb, u64 size, i32(rawptr, rawptr) compar);
pub extern("C") rawptr bsearch(rawptr key, rawptr base, u64 nmemb, u64 size, i32(rawptr, rawptr) compar);
pub extern("C") cchar* strerror(i32 errnum);
pub extern("C") void perror(const cchar* s);

// Signals (POSIX)
pub extern("C") i32 sigaction(i32 signum, const rawptr act, rawptr oldact);
pub extern("C") i32 sigemptyset(rawptr set);
pub extern("C") i32 sigaddset(rawptr set, i32 signum);
pub extern("C") i32 sigprocmask(i32 how, const rawptr set, rawptr oldset);
pub extern("C") i32 sigpending(rawptr set);

// File
pub extern("C") i32 fstat(i32 fd, rawptr buf);
pub extern("C") i32 fsync(i32 fd);
pub extern("C") i32 ftruncate(i32 fd, i64 length);
pub extern("C") i32 chmod(const cchar* pathname, u32 mode);
pub extern("C") i32 fcntl(i32 fd, i32 cmd, ...);
pub extern("C") i32 dup(i32 oldfd);
pub extern("C") u32 umask(u32 mask);

// Sleep / timers
pub extern("C") u32 sleep(u32 seconds);
pub extern("C") i32 usleep(u32 usec);
pub extern("C") u32 alarm(u32 seconds);

// Net (address resolution + byte order)
pub extern("C") i32 getaddrinfo(const cchar* node, const cchar* service, const rawptr hints, rawptr* res);
pub extern("C") void freeaddrinfo(rawptr res);
pub extern("C") i32 getnameinfo(const rawptr addr, u32 addrlen, cchar* host, u32 hostlen, cchar* serv, u32 servlen, i32 flags);
pub extern("C") const cchar* inet_ntop(i32 af, const rawptr src, cchar* dst, u32 size);
pub extern("C") i32 inet_pton(i32 af, const cchar* src, rawptr dst);

// Dynamic loading
pub extern("C") rawptr dlopen(const cchar* filename, i32 flags);
pub extern("C") rawptr dlsym(rawptr handle, const cchar* symbol);
pub extern("C") i32 dlclose(rawptr handle);
pub extern("C") cchar* dlerror();

// Sys
pub extern("C") i64 sysconf(i32 name);
pub extern("C") i32 gethostname(cchar* name, u64 len);

