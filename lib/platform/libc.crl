import(lib) core::cchar { cchar };

pub extern("C") i32 backtrace(rawptr buffer, i32 size);
pub extern("C") i32 backtrace_symbols_fd(rawptr buffer, i32 size, i32 fd);

pub extern("C") i32* __errno_location();
pub extern("C") i64 read(i32 fd, cchar* buf, u64 count);
pub extern("C") i64 write(i32 fd, const cchar* buf, u64 count);
pub extern("C") i32 getcchar();
pub extern("C") i32 putcchar(i32 c);
pub extern("C") i32 fflush(rawptr stream);
// String
pub extern("C") u64 strlen(const cchar* s);
pub extern("C") i32 strcmp(const cchar* a, const cchar* b);
pub extern("C") cchar* strcpy(cchar* dst, const cchar* src);
// Memory
pub extern("C") rawptr malloc(u64 size);
pub extern("C") void free(rawptr ptr);
pub extern("C") rawptr realloc(rawptr ptr, u64 newSize);
pub extern("C") i32 memcmp(const rawptr a, const rawptr b, u64 n);
// Formatting
pub extern("C") i32 snprintf(cchar* buf, u64 size, const cchar* fmt, ...);
pub extern("C") i32 printf(const cchar* fmt, ...);
pub extern("C") i32 puts(const cchar* s);

pub extern("C") rawptr mmap(rawptr addr, u64 length, i32 prot, i32 flags, i32 fd, i64 offset);
pub extern("C") i32 open(const cchar* path, i32 flags, i32 mode);
pub extern("C") i32 close(i32 fd);
pub extern("C") i32 stat(const cchar* path, rawptr buf);
pub extern("C") i32 mkdir(const cchar* path, i32 mode);
pub extern("C") i32 chdir(const cchar* path);
pub extern("C") i32 rmdir(const cchar* path);
pub extern("C") i32 unlink(const cchar* path);
pub extern("C") i32 rename(const cchar* old, const cchar* newName);
pub extern("C") i32 access(const cchar* path, i32 mode);
pub extern("C") rawptr opendir(const cchar* path);
pub extern("C") rawptr readdir(rawptr dir);
pub extern("C") i32 closedir(rawptr dir);
pub extern("C") i32 getchar();
pub extern("C") f64 strtod(const cchar* nptr, cchar** endptr);
pub extern("C") i32 vsnprintf(cchar* buf, u64 size, const cchar* fmt, ...);

// Stdio
pub extern("C") rawptr fopen(const cchar* path, const cchar* mode);
pub extern("C") i32 fclose(rawptr stream);
pub extern("C") u64 fread(rawptr ptr, u64 size, u64 count, rawptr stream);
pub extern("C") u64 fwrite(const rawptr ptr, u64 size, u64 count, rawptr stream);
pub extern("C") i32 feof(rawptr stream);
pub extern("C") i32 ferror(rawptr stream);

// File operations
pub extern("C") i64 lseek(i32 fd, i64 offset, i32 whence);
pub extern("C") i32 mkstemp(cchar* templateStr);
pub extern("C") cchar* mkdtemp(cchar* templateStr);

// Regex
pub extern("C") i32 regcomp(rawptr preg, const cchar* pattern, i32 cflags);
pub extern("C") i32 regexec(const rawptr preg, const cchar* string, u64 nmatch, rawptr pmatch, i32 eflags);
pub extern("C") void regfree(rawptr preg);
pub extern("C") u64 regerror(i32 errcode, const rawptr preg, cchar* errbuf, u64 errbufSize);

// Process
pub extern("C") i32 fork();
pub extern("C") i32 execvp(const cchar* file, const cchar** argv);
pub extern("C") i32 waitpid(i32 pid, i32* status, i32 options);
pub extern("C") i32 poll(rawptr fds, u64 nfds, i32 timeout);
pub extern("C") void _exit(i32 code);
pub extern("C") i32 pipe(i32* fds);
pub extern("C") i32 dup2(i32 oldfd, i32 newfd);
pub extern("C") i32 execvpe(const cchar* file, const cchar** argv, const cchar** envp);
pub extern("C") i32 system(const cchar* cmd);

// Signals
pub extern("C") void(i32) signal(i32 signum, void(i32) handler);
pub extern("C") i32 kill(i32 pid, i32 sig);
pub extern("C") i32 raise(i32 sig);

// Environment
pub extern("C") cchar* getenv(const cchar* name);
pub extern("C") i32 setenv(const cchar* name, const cchar* value, i32 overwrite);
pub extern("C") i32 unsetenv(const cchar* name);
pub extern("C") i64 readlink(const cchar* path, cchar* buf, u64 bufsize);

pub extern("C") i32 sched_yield();
// Time
pub extern("C") i32 gettimeofday(rawptr tv, rawptr tz);
pub extern("C") u64 time(rawptr t);
pub extern("C") i64 clock_gettime(i32 clockId, rawptr tp);
pub extern("C") i32 nanosleep(const rawptr req, rawptr rem);

// ucontext — stackful context switching (glibc x86_64, layout validated for std::concurrent::async)
pub extern("C") i32 getcontext(rawptr uc);
pub extern("C") void makecontext(rawptr uc, void() fn, i32 argc);
pub extern("C") i32 swapcontext(rawptr ocp, rawptr ucp);

// Terminal
pub extern("C") i32 isatty(i32 fd);

