// Running-executable path for cache fingerprints and diagnostics.
// _NSGetExecutablePath copies the path (may contain symlinks) into buf;
// on -1 the buffer was too small and bufsize holds the required size.
import std::mman { alloc };

extern("C") i32 _NSGetExecutablePath(u8* buf, usize* bufsize);

pub str selfExePath()
{
    usize cap = 4096;
    u8* buf = alloc<u8>(cap + 1);
    usize sz = cap;
    i32 r = _NSGetExecutablePath(buf, &sz);
    if (r != 0)
    {
        u8* buf2 = alloc<u8>(sz + 1);
        usize sz2 = sz;
        r = _NSGetExecutablePath(buf2, &sz2);
        buf = buf2;
        sz = sz2;
    }
    if (r != 0)
    {
        buf[0] = 0;
        return str::fromParts(buf, 0);
    }
    buf[sz] = 0;
    return str::fromParts(buf, sz);
}
