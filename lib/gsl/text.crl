#[[no_drop_all]]
/* gsl/text.crl — fixed-capacity byte buffer (string builder).
 *
 * Goose-style: the buffer is inline, NUL-terminated after every
 * append, and dies with its scope. No allocation, no strlen on
 * read — view() hands out {ptr, len} directly. Overflow asserts;
 * use tryPush-style APIs when the bound is data-dependent. */

import core::error { __assert, __assertOut };
import std::intrinsics { memcpy, memset };

/// Fixed-capacity NUL-terminated byte buffer.
pub struct Text
{
    u8[512] buf;
    usize len;

    /// Empty buffer.
    Text new() { return Text { .len = 0, .buf = { 0 } }; }

    /// Bytes used (excluding the NUL).
    usize count() { return self.len; }
    usize capacity() { return 512; }
    bool isEmpty() { return self.len == 0; }
    bool isFull() { return self.len >= 512; }

    void _need(usize extra)
    {
        __assertOut(self.len + extra < 512, "gsl::Text: capacity exceeded");
    }

    /// Appends `n` raw bytes.
    void pushBytes(const u8* data, usize n)
    {
        self._need(n);
        memcpy((rawptr)(&self.buf[self.len]), (const rawptr)data, n);
        self.len += n;
        self.buf[self.len] = 0;
    }

    /// Appends a str view.
    void push(str s) { self.pushBytes((const u8*)s.ptr, s.len); }

    /// Appends a single byte.
    void pushByte(u8 c)
    {
        self._need(1);
        self.buf[self.len] = c;
        self.len++;
        self.buf[self.len] = 0;
    }

    /// Appends `c` repeated `n` times.
    void pushRepeat(u8 c, usize n)
    {
        self._need(n);
        memset((rawptr)(&self.buf[self.len]), c, n);
        self.len += n;
        self.buf[self.len] = 0;
    }

    /// Appends a decimal integer.
    void pushDec(i64 v)
    {
        u8[24] tmp;
        usize n = 0;
        u64 u;
        if (v < 0) { self.pushByte(45); u = (u64)(-(v + 1)) + 1; }
        else u = (u64)v;
        if (u == 0) { self.pushByte(48); return; }
        while (u > 0)
        {
            tmp[n] = (u8)(48 + (u % 10));
            u /= 10;
            n++;
        }
        self._need(n);
        while (n > 0) { n--; self.buf[self.len] = tmp[n]; self.len++; }
        self.buf[self.len] = 0;
    }

    /// Appends a lowercase hex integer (no prefix).
    void pushHex(u64 v)
    {
        u8[16] tmp;
        usize n = 0;
        if (v == 0) { self.pushByte(48); return; }
        while (v > 0)
        {
            u8 d = (u8)(v & 15);
            tmp[n] = d < 10 ? (u8)(48 + d) : (u8)(87 + d);
            v >>= 4;
            n++;
        }
        self._need(n);
        while (n > 0) { n--; self.buf[self.len] = tmp[n]; self.len++; }
        self.buf[self.len] = 0;
    }

    /// Contents as a str view — no copy, no strlen.
    str view() { return str::fromParts((const u8*)&self.buf[0], self.len); }

    /// Contents as a NUL-terminated C string.
    const u8* cstr() { return (const u8*)&self.buf[0]; }

    /// Drops all bytes.
    void clear()
    {
        self.len = 0;
        self.buf[0] = 0;
    }
}
