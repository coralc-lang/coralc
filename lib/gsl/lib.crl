/* gsl — fixed-capacity containers, an mmap bump arena, and core
 * utilities.
 *
 * Goose-inspired std alternative: storage is inline or arena-
 * backed, lifetime is scope-bound, pointers never move, and
 * there is no per-allocation bookkeeping. Containers assert on
 * overflow; the arena grows geometrically and frees wholesale. */

pub mod vec = use vec;
pub mod text = use text;
pub mod arena = use arena;
