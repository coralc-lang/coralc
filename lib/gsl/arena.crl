#[[no_drop_all]]
/* gsl/arena.crl — mmap-backed bump arena.
 *
 * Goose-style memory: a handful of large mmap'd blocks, bump
 * allocation inside them, and wholesale release. Blocks are
 * never moved or realloc'd — when one fills, a geometrically
 * larger block is mapped and linked, so every pointer handed
 * out stays valid for the arena's whole lifetime (the Goose
 * "growth preserves references" rule, for real this time).
 *
 * Sizing is decided once, at map time: the first block is 64
 * KiB, each subsequent block doubles (capped at 1 GiB), and an
 * allocation larger than the next block size maps a dedicated
 * block of exactly the requested size. No per-allocation
 * bookkeeping beyond a 16-byte header per block. */

import core::error { __panic };
import platform::libc { mmap };

pub extern("C") i32 munmap(rawptr addr, u64 length);

const usize PAGE = 4096;
const usize PMASK = 4095;
const usize FIRST_BLOCK = 65536;
const usize MAX_BLOCK = 1073741824; /* 1 GiB */

struct GslBlock
{
    GslBlock* next;
    u8* base;
    usize cap;
    usize used;
}

/// Bump arena over mmap'd memory. Zero-initialized; create with
/// Arena::new(), draw with alloc()/allocBytes(), release all with
/// free(). Individual allocations cannot be freed — that is the
/// point: scope-bound, bulk-reclaimed memory.
pub struct Arena
{
    GslBlock* head;
    GslBlock* cur;
    usize total;
    usize blocks;

    /// Empty arena; first allocation maps the first block.
    Arena new() { return Arena { .head = null, .cur = null, .total = 0, .blocks = 0 }; }

    /* map one block of `cap` usable bytes; returns null on failure */
    GslBlock* _map(usize cap)
    {
        usize bytes = cap + @sizeof(GslBlock);
        usize aligned = ((bytes + PMASK) / PAGE) * PAGE;
        u8* mem = (u8*)mmap(null, aligned, 3, 0x22, -1, 0);
        if (mem == (u8*)-1 || mem == null) return null;
        GslBlock* b = (GslBlock*)mem;
        b->next = null;
        b->base = mem + @sizeof(GslBlock);
        b->cap = cap;
        b->used = 0;
        return b;
    }

    /// Bytes available in the current block without mapping.
    usize _room(GslBlock* b) { return b == null ? 0 : b->cap - b->used; }

    /// Raw bump allocation of `size` bytes, 8-aligned. Never
    /// returns null for size > 0 — failure panics (there is no
    /// fallback once mmap refuses; same contract as std::mman).
    rawptr allocBytes(usize size)
    {
        if (size == 0) return null;
        usize need = ((size + 7) / 8) * 8;
        if (self.cur == null || self._room(self.cur) < need)
        {
            /* geometric growth: double the last block, at least the
             * first-block size, always enough for `need`; a request
             * bigger than the growth step gets its own exact block */
            usize cap = FIRST_BLOCK;
            if (self.cur != null)
            {
                usize grown = self.cur->cap * 2;
                if (grown > MAX_BLOCK) grown = MAX_BLOCK;
                cap = grown;
            }
            if (need > cap) cap = need;
            GslBlock* nb = self._map(cap);
            if (nb == null) __panic("gsl::Arena: mmap failed");
            nb->next = self.head;
            self.head = nb;
            self.cur = nb;
            self.total += cap;
            self.blocks++;
        }
        rawptr p = (rawptr)(self.cur->base + self.cur->used);
        self.cur->used += need;
        return p;
    }

    /* typed allocation: cast the raw pointer —
     *   i32* p = (i32*)a.allocBytes(100 * @sizeof(i32));
     * (generic methods are not supported on structs) */

    /// Bytes currently mapped across all blocks.
    usize mapped() { return self.total; }
    /// Number of live blocks.
    usize blockCount() { return self.blocks; }

    /// Unmaps every block. The arena is empty afterwards and may
    /// be reused.
    void free()
    {
        GslBlock* b = self.head;
        while (b != null)
        {
            GslBlock* nx = b->next;
            usize bytes = b->cap + @sizeof(GslBlock);
            usize aligned = ((bytes + PMASK) / PAGE) * PAGE;
            munmap((rawptr)b, aligned);
            b = nx;
        }
        self.head = null;
        self.cur = null;
        self.total = 0;
        self.blocks = 0;
    }
}

pub extend Arena : drop
{
    void drop() { self.free(); }
}
