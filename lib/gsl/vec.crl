#[[no_drop_all]]
/* gsl/vec.crl — fixed-capacity contiguous vector.
 *
 * Goose-style: the storage lives inline in the struct (or in a
 * caller-provided buffer), so a Vec is created and destroyed with
 * its scope — no heap allocation, ever, and nothing to free.
 * Capacity is fixed at compile time; push past it asserts.
 * Elements are trivially copyable; the vector never allocates,
 * never moves its storage, and references stay valid for the
 * vector's whole lifetime. */

import core::error { __assert, __assertOut };

/// Fixed-capacity contiguous array of T. Storage is inline:
/// `Vec<T>` occupies CAP * sizeof(T) bytes wherever it lives.
pub struct Vec<T>
{
    /* inline element storage; len tracks the live prefix */
    T[64] data;
    usize len;

    /// Empty vector.
    Vec<T> new() { return Vec<T> { .len = 0 }; }

    /// Element count.
    usize count() { return self.len; }

    /// Fixed capacity (compile-time).
    usize capacity() { return 64; }

    /// True when full.
    bool isFull() { return self.len >= 64; }

    /// True when empty.
    bool isEmpty() { return self.len == 0; }

    /// Appends `val`; asserts when full.
    void push(T val)
    {
        __assertOut(self.len < 64, "gsl::Vec: capacity exceeded");
        self.data[self.len] = val;
        self.len++;
    }

    /// Appends `val` if room remains; returns false when full
    /// (the Goose "try" idiom — no assert, no alloc, no throw).
    bool tryPush(T val)
    {
        if (self.len >= 64) return false;
        self.data[self.len] = val;
        self.len++;
        return true;
    }

    /// Removes and returns the last element.
    T pop()
    {
        __assert(self.len > 0);
        self.len--;
        return self.data[self.len];
    }

    /// Element at `i`; bounds-checked.
    T at(usize i)
    {
        __assertOut(i < self.len, "gsl::Vec: index out of bounds");
        return self.data[i];
    }

    /// Mutable element at `i`; bounds-checked.
    T* atMut(usize i)
    {
        __assertOut(i < self.len, "gsl::Vec: index out of bounds");
        return &self.data[i];
    }

    /// Overwrites element `i`.
    void set(usize i, T val)
    {
        __assertOut(i < self.len, "gsl::Vec: index out of bounds");
        self.data[i] = val;
    }

    /// First element.
    T front()
    {
        __assertOut(self.len > 0, "gsl::Vec: empty");
        return self.data[0];
    }

    /// Last element.
    T back()
    {
        __assertOut(self.len > 0, "gsl::Vec: empty");
        return self.data[self.len - 1];
    }

    /// Drops all elements; storage stays (it is inline anyway).
    void clear() { self.len = 0; }

    /// Raw element pointer; valid for the vector's lifetime.
    T* ptr() { return &self.data[0]; }
    const T* constPtr() { return (const T*)&self.data[0]; }
}
