schema = 1;

# std module manifest — activated by `manifest = true` on the `module
# "std"` entry in lib/manifest.crlb. Declares which target triples have
# platform trees under std/; imports for other targets resolve against
# the base tree only (no fallback root).
manifest "std" {
    version = "0.1.0";

    target "x86_64/linux"   { path = "x86_64/linux"; }
    target "x86_64/windows" { path = "x86_64/windows"; }
    target "arm64/macos"    { path = "arm64/macos"; }
    target "arm64/android"  { path = "arm64/android"; }
}

manifest "std" {
    version = "0.1.0";

    target "x86_64" {
        platform "linux"    { path = "x86_64/linux"; }
    }
    target "x86_64" {
        platform "windows"  { path = "x86_64/windows"; }
    }
    target "arm64" {
        platform "macos"    { path = "arm64/macos"; }
    }
    target "arm64/android"  { path = "arm64/android"; }
}