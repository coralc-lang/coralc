
// erased — poor-man's type erasure: a raw pointer wrapper with typed access.

/// Type-erased raw pointer wrapper with typed access.
pub struct Erased
{
    rawptr p;

    /// The wrapped raw pointer.
    rawptr ptr()
    {
        return self.p;
    }

    /// True when the wrapped pointer is null.
    bool isNull()
    {
        return self.p == null;
    }

    /// Reinterpret the wrapped pointer as `T*`.
    T* asPtr<T>()
    {
        return (T*)self.p;
    }
}

/// Wrap a raw pointer as `Erased`.
pub Erased wrap(rawptr value)
{
    return Erased { .p = value };
}
