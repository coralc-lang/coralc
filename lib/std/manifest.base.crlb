# std base manifest — platform manifests extend this file.
# Import paths inside std sources are platform-neutral
# (`memory::mman`, `collections::vec`, ...). The extending manifest
# sets `platform_root`; the builder resolves a neutral path by searching
# `<platform_root>/` first, then the base tree — so a platform may
# override any portable file.
#
# See coral-docs/builder_incomplete.md — include/extends/platform_root
# resolution is not implemented in the builder yet.

schema = 1;
strict = true;

build "std" {
    root          = "lib/std/";
    modules       = ["std"
        # "misc",

        # "testing",
    
        # "x86_64/linux",
    
        # "x86_64/linux/collections",
    
        # "x86_64/linux/concurrent",
    
        # "x86_64/linux/crypto",
    
        # "x86_64/linux/data",
    
        # "x86_64/linux/fmt",
    
        # "x86_64/linux/io",
    
        # "x86_64/linux/math",
    
        # "x86_64/linux/memory",
    
        # "x86_64/linux/memory/allocators",
    
        # "x86_64/linux/memory/intrinsics",
    
        # "x86_64/linux/parser",
    
        # "x86_64/linux/text",
    
        # "x86_64/windows",
    
        # "x86_64/windows/collections",
    
        # "x86_64/windows/concurrent",
    
        # "x86_64/windows/crypto",
    
        # "x86_64/windows/data",
    
        # "x86_64/windows/fmt",
    
        # "x86_64/windows/io",
    
        # "x86_64/windows/math",
    
        # "x86_64/windows/memory",
    
        # "x86_64/windows/memory/allocators",
    
        # "x86_64/windows/memory/intrinsics",
    
        # "x86_64/windows/parser",
    
        # "x86_64/windows/text",
    ];
    platform_root = "";
}
