
import(lib) std::ios { println, eprintln };

usize _testsRun = 0;
usize _testsPassed = 0;
usize _testsFailed = 0;
bool _currentTestFailed = false;
str _currentTestName = "";

pub struct TestResult
{
    str name;
    bool passed;
    str message;
}

pub void _testBegin(str name)
{
    _currentTestName = name;
    _currentTestFailed = false;
    _testsRun++;
}

pub void _testEnd()
{
    if (_currentTestFailed)
    {
        _testsFailed++;
        eprintln("  FAIL: {}", _currentTestName);
    }
    else
    {
        _testsPassed++;
    }
}

pub void _testFail(str msg)
{
    _currentTestFailed = true;
    eprintln("    {}", msg);
}

pub void assertEq(usize expected, usize actual, str msg)
{
    if (expected != actual)
    {
        _currentTestFailed = true;
        println("    expected {} got {} - {}", expected, actual, msg);
    }
}

pub void assertEqStr(str expected, str actual, str msg)
{
    if (!expected.equals(actual))
    {
        _currentTestFailed = true;
        println("    expected '{}' got '{}' - {}", expected, actual, msg);
    }
}

pub void assertTrue(bool cond, str msg)
{
    if (!cond)
    {
        _currentTestFailed = true;
        eprintln("    {}", msg);
    }
}

pub void assertFalse(bool cond, str msg)
{
    if (cond)
    {
        _currentTestFailed = true;
        eprintln("    {}", msg);
    }
}

pub void assertNull(rawptr ptr, str msg)
{
    if (ptr != null)
    {
        _currentTestFailed = true;
        eprintln("    expected null - {}", msg);
    }
}

pub void assertNotNull(rawptr ptr, str msg)
{
    if (ptr == null)
    {
        _currentTestFailed = true;
        eprintln("    expected non-null - {}", msg);
    }
}

pub void testSummary()
{
    println("");
    println("Test Summary");
    println("  run:    {}", _testsRun);
    println("  passed: {}", _testsPassed);
    println("  failed: {}", _testsFailed);
    if (_testsFailed == 0)
        println("  ALL TESTS PASSED");
    else
        println("  SOME TESTS FAILED");
}

pub bool testAllPassed()
{
    return _testsFailed == 0;
}
