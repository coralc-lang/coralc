#[[no_drop_all]]
import vector { Vec2, Vec3, Vec4 };
import math { cos, sin, tan };
import(lib) platform::libc { snprintf };
import(lib) std::string { String };

/// 2x2 matrix of float64 values in row-major order.
pub struct Mat2
{
    f64[4] m;

    /// Returns the identity matrix.
    static Mat2 identity()
    {
        Mat2 r;
        for (usize i = 0; i < 4; i++) r.m[i] = 0.0;
        r.m[0] = 1.0; r.m[3] = 1.0;
        return r;
    }

    /// Builds a matrix from its row vectors.
    static Mat2 fromRows(Vec2 r0, Vec2 r1)
    {
        Mat2 r;
        r.m[0] = r0.x; r.m[1] = r0.y;
        r.m[2] = r1.x; r.m[3] = r1.y;
        return r;
    }

    /// Returns the element at the given row and column.
    f64 at(usize row, usize col)
    {
        return self.m[row * 2 + col];
    }

    /// Sets the element at the given row and column.
    void set(usize row, usize col, f64 val)
    {
        self.m[row * 2 + col] = val;
    }

    /// Returns the matrix product with other.
    Mat2 mul(Mat2 other)
    {
        Mat2 r;
        for (usize i = 0; i < 4; i++) r.m[i] = 0.0;
        for (usize i = 0; i < 2; i++)
            for (usize j = 0; j < 2; j++)
                for (usize k = 0; k < 2; k++)
                    r.m[i * 2 + j] += self.m[i * 2 + k] * other.m[k * 2 + j];
        return r;
    }

    /// Transforms a vector by this matrix.
    Vec2 mulVec(Vec2 v)
    {
        return Vec2 {
            .x = self.m[0] * v.x + self.m[1] * v.y,
            .y = self.m[2] * v.x + self.m[3] * v.y
        };
    }

    /// Returns the transpose.
    Mat2 transpose()
    {
        Mat2 r;
        r.m[0] = self.m[0]; r.m[1] = self.m[2];
        r.m[2] = self.m[1]; r.m[3] = self.m[3];
        return r;
    }

    /// Returns the determinant.
    f64 det()
    {
        return self.m[0] * self.m[3] - self.m[1] * self.m[2];
    }

    /// Returns the inverse, or this matrix when the determinant is near zero.
    Mat2 inverse()
    {
        f64 d = self.det();
        if (d < 1e-15 && d > -1e-15) return *self;
        f64 invDet = 1.0 / d;
        Mat2 r;
        r.m[0] = self.m[3] * invDet;
        r.m[1] = -self.m[1] * invDet;
        r.m[2] = -self.m[2] * invDet;
        r.m[3] = self.m[0] * invDet;
        return r;
    }
}

/// 3x3 matrix of float64 values in row-major order.
pub struct Mat3
{
    f64[9] m;

    /// Returns the identity matrix.
    static Mat3 identity()
    {
        Mat3 r;
        for (usize i = 0; i < 9; i++) r.m[i] = 0.0;
        r.m[0] = 1.0; r.m[4] = 1.0; r.m[8] = 1.0;
        return r;
    }

    /// Builds a matrix from its row vectors.
    static Mat3 fromRows(Vec3 r0, Vec3 r1, Vec3 r2)
    {
        Mat3 r;
        r.m[0] = r0.x; r.m[1] = r0.y; r.m[2] = r0.z;
        r.m[3] = r1.x; r.m[4] = r1.y; r.m[5] = r1.z;
        r.m[6] = r2.x; r.m[7] = r2.y; r.m[8] = r2.z;
        return r;
    }

    /// Returns the element at the given row and column.
    f64 at(usize row, usize col)
    {
        return self.m[row * 3 + col];
    }

    /// Sets the element at the given row and column.
    void set(usize row, usize col, f64 val)
    {
        self.m[row * 3 + col] = val;
    }

    /// Returns the matrix product with other.
    Mat3 mul(Mat3 other)
    {
        Mat3 r;
        for (usize i = 0; i < 9; i++) r.m[i] = 0.0;
        for (usize i = 0; i < 3; i++)
            for (usize j = 0; j < 3; j++)
                for (usize k = 0; k < 3; k++)
                    r.m[i * 3 + j] += self.m[i * 3 + k] * other.m[k * 3 + j];
        return r;
    }

    /// Transforms a vector by this matrix.
    Vec3 mulVec(Vec3 v)
    {
        return Vec3 {
            .x = self.m[0] * v.x + self.m[1] * v.y + self.m[2] * v.z,
            .y = self.m[3] * v.x + self.m[4] * v.y + self.m[5] * v.z,
            .z = self.m[6] * v.x + self.m[7] * v.y + self.m[8] * v.z
        };
    }

    /// Returns the transpose.
    Mat3 transpose()
    {
        Mat3 r;
        for (usize i = 0; i < 3; i++)
            for (usize j = 0; j < 3; j++)
                r.m[i * 3 + j] = self.m[j * 3 + i];
        return r;
    }

    /// Returns the determinant.
    f64 det()
    {
        f64 a = self.m[0] * (self.m[4] * self.m[8] - self.m[5] * self.m[7]);
        f64 b = self.m[1] * (self.m[3] * self.m[8] - self.m[5] * self.m[6]);
        f64 c = self.m[2] * (self.m[3] * self.m[7] - self.m[4] * self.m[6]);
        return a - b + c;
    }
}

/// 4x4 matrix of float64 values in row-major order.
pub struct Mat4
{
    f64[16] m;

    /// Returns the identity matrix.
    static Mat4 identity()
    {
        Mat4 r;
        for (usize i = 0; i < 16; i++) r.m[i] = 0.0;
        r.m[0] = 1.0; r.m[5] = 1.0; r.m[10] = 1.0; r.m[15] = 1.0;
        return r;
    }

    /// Builds a matrix from its row vectors.
    static Mat4 fromRows(Vec4 r0, Vec4 r1, Vec4 r2, Vec4 r3)
    {
        Mat4 r;
        r.m[0] = r0.x; r.m[1] = r0.y; r.m[2] = r0.z; r.m[3] = r0.w;
        r.m[4] = r1.x; r.m[5] = r1.y; r.m[6] = r1.z; r.m[7] = r1.w;
        r.m[8] = r2.x; r.m[9] = r2.y; r.m[10] = r2.z; r.m[11] = r2.w;
        r.m[12] = r3.x; r.m[13] = r3.y; r.m[14] = r3.z; r.m[15] = r3.w;
        return r;
    }

    /// Returns the element at the given row and column.
    f64 at(usize row, usize col)
    {
        return self.m[row * 4 + col];
    }

    /// Sets the element at the given row and column.
    void set(usize row, usize col, f64 val)
    {
        self.m[row * 4 + col] = val;
    }

    /// Returns the matrix product with other.
    Mat4 mul(Mat4 other)
    {
        Mat4 r;
        for (usize i = 0; i < 16; i++) r.m[i] = 0.0;
        for (usize i = 0; i < 4; i++)
            for (usize j = 0; j < 4; j++)
                for (usize k = 0; k < 4; k++)
                    r.m[i * 4 + j] += self.m[i * 4 + k] * other.m[k * 4 + j];
        return r;
    }

    /// Transforms a vector by this matrix.
    Vec4 mulVec(Vec4 v)
    {
        return Vec4 {
            .x = self.m[0] * v.x + self.m[1] * v.y + self.m[2] * v.z + self.m[3] * v.w,
            .y = self.m[4] * v.x + self.m[5] * v.y + self.m[6] * v.z + self.m[7] * v.w,
            .z = self.m[8] * v.x + self.m[9] * v.y + self.m[10] * v.z + self.m[11] * v.w,
            .w = self.m[12] * v.x + self.m[13] * v.y + self.m[14] * v.z + self.m[15] * v.w
        };
    }

    /// Returns the transpose.
    Mat4 transpose()
    {
        Mat4 r;
        for (usize i = 0; i < 4; i++)
            for (usize j = 0; j < 4; j++)
                r.m[i * 4 + j] = self.m[j * 4 + i];
        return r;
    }

    /// Returns a translation matrix.
    static Mat4 translation(f64 tx, f64 ty, f64 tz)
    {
        Mat4 r = Mat4::identity();
        r.m[3] = tx; r.m[7] = ty; r.m[11] = tz;
        return r;
    }

    /// Returns a rotation matrix about the X axis by angle radians.
    static Mat4 rotationX(f64 angle)
    {
        f64 c = cos(angle); f64 s = sin(angle);
        Mat4 r = Mat4::identity();
        r.m[5] = c; r.m[6] = -s;
        r.m[9] = s; r.m[10] = c;
        return r;
    }

    /// Returns a rotation matrix about the Y axis by angle radians.
    static Mat4 rotationY(f64 angle)
    {
        f64 c = cos(angle); f64 s = sin(angle);
        Mat4 r = Mat4::identity();
        r.m[0] = c; r.m[2] = s;
        r.m[8] = -s; r.m[10] = c;
        return r;
    }

    /// Returns a rotation matrix about the Z axis by angle radians.
    static Mat4 rotationZ(f64 angle)
    {
        f64 c = cos(angle); f64 s = sin(angle);
        Mat4 r = Mat4::identity();
        r.m[0] = c; r.m[1] = -s;
        r.m[4] = s; r.m[5] = c;
        return r;
    }

    /// Returns a scaling matrix along the X, Y, and Z axes.
    static Mat4 scale(f64 sx, f64 sy, f64 sz)
    {
        Mat4 r;
        for (usize i = 0; i < 16; i++) r.m[i] = 0.0;
        r.m[0] = sx; r.m[5] = sy; r.m[10] = sz; r.m[15] = 1.0;
        return r;
    }

    /// Returns a right-handed perspective projection from fov radians, aspect ratio, and near/far planes.
    static Mat4 perspective(f64 fov, f64 aspect, f64 near, f64 far)
    {
        f64 f = 1.0 / tan(fov / 2.0);
        f64 rangeInv = 1.0 / (near - far);
        Mat4 r;
        for (usize i = 0; i < 16; i++) r.m[i] = 0.0;
        r.m[0] = f / aspect;
        r.m[5] = f;
        r.m[10] = (near + far) * rangeInv;
        r.m[11] = 2.0 * near * far * rangeInv;
        r.m[14] = -1.0;
        return r;
    }

    /// Returns a view matrix looking from eye toward center with the given up vector.
    static Mat4 lookAt(Vec3 eye, Vec3 center, Vec3 up)
    {
        Vec3 f = center.sub(eye).normalize();
        Vec3 s = f.cross(up).normalize();
        Vec3 u = s.cross(f);
        Mat4 r;
        for (usize i = 0; i < 16; i++) r.m[i] = 0.0;
        r.m[0] = s.x; r.m[1] = s.y; r.m[2] = s.z;
        r.m[4] = u.x; r.m[5] = u.y; r.m[6] = u.z;
        r.m[8] = -f.x; r.m[9] = -f.y; r.m[10] = -f.z;
        r.m[15] = 1.0;
        Mat4 t = Mat4::translation(-eye.x, -eye.y, -eye.z);
        return r.mul(t);
    }
}

pub extend Mat2 : @toStr
{
    str toStr()
    {
        u8[256] buf;
        i32 len = snprintf(buf, 256u, C"[[%.15g, %.15g], [%.15g, %.15g]]",
            self.m[0], self.m[1], self.m[2], self.m[3]);
        if (len < 0) len = 0;
        if (len > 255) len = 255;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Mat3 : @toStr
{
    str toStr()
    {
        u8[512] buf;
        i32 len = snprintf(buf, 512u,
            C"[[%.15g, %.15g, %.15g], [%.15g, %.15g, %.15g], [%.15g, %.15g, %.15g]]",
            self.m[0], self.m[1], self.m[2], self.m[3], self.m[4],
            self.m[5], self.m[6], self.m[7], self.m[8]);
        if (len < 0) len = 0;
        if (len > 511) len = 511;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Mat4 : @toStr
{
    str toStr()
    {
        u8[1024] buf;
        i32 len = snprintf(buf, 1024u,
            C"[[%.15g, %.15g, %.15g, %.15g], [%.15g, %.15g, %.15g, %.15g], ",
            self.m[0], self.m[1], self.m[2], self.m[3],
            self.m[4], self.m[5], self.m[6], self.m[7]);
        if (len < 0) len = 0;
        if (len > 1023) len = 1023;
        i32 n2 = snprintf(buf + len, (u64)(1024 - len),
            C"[%.15g, %.15g, %.15g, %.15g], [%.15g, %.15g, %.15g, %.15g]]",
            self.m[8], self.m[9], self.m[10], self.m[11],
            self.m[12], self.m[13], self.m[14], self.m[15]);
        if (n2 < 0) n2 = 0;
        if (n2 > 1023 - len) n2 = 1023 - len;
        len += n2;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}
