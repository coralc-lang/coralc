#[[no_drop_all]]
import(lib) platform::libc { snprintf };
import(lib) platform::win32 { CreateFileA, CloseHandle, CreateDirectoryA, DeleteFileA, MoveFileA, RemoveDirectoryA, GetTickCount, GetTempPathA, GetTempFileNameA, GetLastError };
import(lib) std::string { String };
import(lib) std::result { Result };
import(lib) std::fs { File, IoError };
const u32 GENERIC_READ = 0x80000000u;
const u32 GENERIC_WRITE = 0x40000000u;
const u32 FILE_SHARE_READ = 0x1u;
const u32 FILE_SHARE_WRITE = 0x2u;
const u32 FILE_SHARE_DELETE = 0x4u;
const u32 OPEN_EXISTING = 3u;
const u32 FILE_ATTRIBUTE_NORMAL = 0x80u;
// CreateFileA failure handle ((rawptr)-1) - mirrors mkstemp's -1.
const rawptr INVALID_HANDLE_VALUE = (rawptr)-1;

// MAX_PATH buffers, 260B with NUL, longer paths unsupported (FLAG).
// quite stupid, win32 hard-caps paths here and there is no way around it.
const usize _TMP_PATH_MAX = 260;

bool _hexByte(u8 c)
{
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
}

// GetTempFileNameA writes 4 hex digits after the "tmp" prefix; extracted
// so prefix+suffix rebuild around them (mkstemp's XXXXXX sat at the END
// of the template).
str _uniqHex(const u8* genPath)
{
    usize sep = 0;
    bool found = false;
    for (usize i = 0; genPath[i] != 0; i++)
        if (genPath[i] == '\\' || genPath[i] == '/') { sep = i + 1; found = true; }
    if (!found) return "";
    usize i = sep + 3; // skip the "tmp" prefix
    usize start = i;
    while (_hexByte(genPath[i])) i++;
    if (i == start) return "";
    return str::fromParts(genPath + start, i - start);
}

// 8 hex digits - mkstemp's XXXXXX slot.
void _appendHex(String* out, u32 v)
{
    u8[9] buf;
    snprintf((cchar*)buf, 9u, C"%08X", v);
    out->pushCstr((const cchar*)buf);
}

/// A temporary file that is deleted on dispose by default.
pub struct TempFile
{
    // FLAG, was i32 fd; Win32 HANDLE now, failure INVALID_HANDLE_VALUE.
    rawptr fd;
    String path;
    bool autoDelete;

    /// Create a temp file with a unique name under the system temp directory.
    static Result<TempFile, IoError> create(str prefix, str suffix)
    {
        // mkstemp -> GetTempPathA + GetTempFileNameA (creates the
        // file), then MoveFileA into "<prefix><hex>" shape.
        u8[_TMP_PATH_MAX] tmpDir;
        u32 dirLen = GetTempPathA((u32)_TMP_PATH_MAX, (cchar*)tmpDir);
        if (dirLen == 0u || dirLen >= (u32)_TMP_PATH_MAX)
            return Result<TempFile, IoError>::Err { .error = IoError::os("GetTempPathA") };

        String wanted = String::new();
        u8[_TMP_PATH_MAX] gen;
        bool havePath = false;
        // which call bailed, with its code (captured before any cleanup
        // call below could overwrite the last-error slot)
        i32 failCode = 0;
        str failOp = "GetTempFileNameA";
        for (u32 attempt = 0; attempt < 8u && !havePath; attempt++)
        {
            // uUnique 0, the API picks a free name and creates the file.
            if (GetTempFileNameA((const cchar*)tmpDir, C"tmp", 0u, (cchar*)gen) == 0u)
            {
                failCode = (i32)GetLastError();
                failOp = "GetTempFileNameA";
                break;
            }
            str hex = _uniqHex(gen);
            if (hex.len == 0)
            {
                failCode = (i32)GetLastError();
                failOp = "GetTempFileNameA";
                DeleteFileA((const cchar*)gen);
                break;
            }
            wanted.clear();
            wanted.appendView(str::fromParts(tmpDir, (usize)dirLen));
            wanted.appendView(prefix);
            wanted.appendView(suffix);
            wanted.appendView(hex);
            if (MoveFileA((const cchar*)gen, (const cchar*)wanted.asCstr()))
                havePath = true;
            else
            {
                failCode = (i32)GetLastError();
                failOp = "MoveFileA";
                DeleteFileA((const cchar*)gen); // target exists; retry with a fresh hex
            }
        }
        if (!havePath)
        {
            wanted.free();
            return Result<TempFile, IoError>::Err { .error = IoError::Os { .code = failCode, .op = failOp } };
        }

        // mkstemp's returned descriptor was O_RDWR; open the file back.
        rawptr h = CreateFileA((const cchar*)wanted.asCstr(),
                               GENERIC_READ | GENERIC_WRITE,
                               FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                               null, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, null);
        if (h == INVALID_HANDLE_VALUE)
        {
            i32 code = (i32)GetLastError();
            DeleteFileA((const cchar*)wanted.asCstr());
            wanted.free();
            return Result<TempFile, IoError>::Err { .error = IoError::Os { .code = code, .op = "CreateFileA" } };
        }
        return Result<TempFile, IoError>::Ok { .value = TempFile { .fd = h, .path = wanted, .autoDelete = true } };
    }

    /// Close the file and, when auto-delete is on, unlink it.
    void dispose()
    {
        if (self.fd != null && self.fd != INVALID_HANDLE_VALUE) CloseHandle(self.fd);
        if (self.autoDelete && !self.path.isEmpty())
            DeleteFileA((const cchar*)self.path.asCstr());
        self.path.free();
        self.fd = INVALID_HANDLE_VALUE;
    }

    /// The open file handle for this temp file.
    File fd() { return (File)self.fd; }
    /// Path of the temp file on disk.
    
    str pathStr() { return self.path.asView(); }

    /// Set whether `dispose` removes the file.
    void setAutoDelete(bool ad) { self.autoDelete = ad; }
}

/// A temporary directory that is removed on dispose by default.
pub struct TempDir
{
    String path;
    bool autoDelete;

    /// Create a temp directory with a unique name under the system temp directory.
    static Result<TempDir, IoError> create(str prefix)
    {
        // mkdtemp -> GetTempPathA + generated name + CreateDirectoryA,
        // retried while taken (mkdir EEXIST == CreateDirectoryA false).
        u8[_TMP_PATH_MAX] tmpDir;
        u32 dirLen = GetTempPathA((u32)_TMP_PATH_MAX, (cchar*)tmpDir);
        if (dirLen == 0u || dirLen >= (u32)_TMP_PATH_MAX)
            return Result<TempDir, IoError>::Err { .error = IoError::os("GetTempPathA") };

        String out = String::new();
        u32 salt = GetTickCount();
        for (u32 attempt = 0; attempt < 100u; attempt++)
        {
            out.clear();
            out.appendView(str::fromParts(tmpDir, (usize)dirLen));
            out.appendView(prefix);
            _appendHex(&out, salt + attempt);
            if (CreateDirectoryA((const cchar*)out.asCstr(), null))
                return Result<TempDir, IoError>::Ok { .value = TempDir { .path = out, .autoDelete = true } };
        }
        // capture before out.free() could overwrite the slot
        i32 code = (i32)GetLastError();
        out.free();
        return Result<TempDir, IoError>::Err { .error = IoError::Os { .code = code, .op = "CreateDirectoryA" } };
    }

    /// Remove the directory when auto-delete is on.
    void dispose()
    {
        if (self.autoDelete && !self.path.isEmpty())
            RemoveDirectoryA((const cchar*)self.path.asCstr());
        self.path.free();
    }

    /// Path of the temp directory on disk.
    
    str pathStr() { return self.path.asView(); }
    /// Set whether `dispose` removes the directory.
    void setAutoDelete(bool ad) { self.autoDelete = ad; }
    /// True when the temp directory has a path.
    
    bool isValid() { return !self.path.isEmpty(); }
}

/// Drop glue for `TempFile`: calls `dispose()`.
pub extend TempFile : @drop
{
    void drop()
    {
        self.dispose();
    }
}

/// Drop glue for `TempDir`: calls `dispose()`.
pub extend TempDir : @drop
{
    void drop()
    {
        self.dispose();
    }
}
