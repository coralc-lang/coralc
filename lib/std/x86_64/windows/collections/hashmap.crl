#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, zero };
import(lib) std::option { Option };
import(lib) std::result { Result };
import vec { Vec };

/// Error raised by collection operations such as insert.
pub variant CollectionError
{
    AllocFailed { str msg; }
}

/// A key/value pair plus its occupancy flag; used internally by HashMap.
pub struct HashMapEntry<K, V>
{
    K key;
    V value;
    bool occupied;
}

/// Open-addressing hash map with linear probing and a bounded load factor.
pub struct HashMap<K, V>
{
    HashMapEntry<K, V>* entries;
    usize cap;
    usize len;
    usize(K) hashFn;
    bool(K, K) eqFn;

/// Creates an empty map using hf to hash keys and ef to compare them.
    static HashMap<K, V> new(usize(K) hf, bool(K, K) ef)
    {
        HashMap<K, V> m = HashMap<K, V> {
            .entries = alloc<HashMapEntry<K, V>>(16),
            .cap = 16,
            .len = 0,
            .hashFn = hf,
            .eqFn = ef
        };
        zero<HashMapEntry<K, V>>(m.entries, 16);
        return m;
    }

/// Frees the entry storage and resets the map.
    void dispose()
    {
        if (self.entries != null)
        {
            dealloc<HashMapEntry<K, V>>(self.entries);
            self.entries = null;
        }
        self.cap = 0;
        self.len = 0;
    }

    
/// Returns the number of stored entries.
    usize count() {  return self.len; }

/// Inserts or updates key and returns its value; grows when the load factor is reached.
    Result<V, CollectionError> insert(K key, V value)
    {
        if (self.len * 2 >= self.cap)
        {
            usize newCap = self.cap * 2;
            HashMapEntry<K, V>* newEntries = alloc<HashMapEntry<K, V>>(newCap);
            if (newEntries == null)
                return Result<V, CollectionError>::Err { .error = CollectionError::AllocFailed { .msg = "HashMap resize allocation failed" } };
            zero<HashMapEntry<K, V>>(newEntries, newCap);
            for (usize i = 0; i < self.cap; i++)
            {
                if (self.entries[i].occupied)
                {
                    // re-home with linear probing, (h + 1) % cap. quite a
                    // stupid scheme, but it is cheap and the load factor
                    // keeps probe chains short
                    usize h = self.hashFn(self.entries[i].key) % newCap;
                    while (newEntries[h].occupied) { h = (h + 1) % newCap; }
                    newEntries[h] = self.entries[i];
                }
            }
            dealloc<HashMapEntry<K, V>>(self.entries);
            self.entries = newEntries;
            self.cap = newCap;
        }
        usize h = self.hashFn(key) % self.cap;
        while (self.entries[h].occupied)
        {
            if (self.eqFn(self.entries[h].key, key))
            {
                self.entries[h].value = value;
                return Result<V, CollectionError>::Ok { .value = value };
            }
            h = (h + 1) % self.cap;
        }
        self.entries[h].key = key;
        self.entries[h].value = value;
        self.entries[h].occupied = true;
        self.len++;
        return Result<V, CollectionError>::Ok { .value = value };
    }

/// Returns the value for key, or None when absent.
    Option<V> get(K key)
    {
        usize h = self.hashFn(key) % self.cap;
        usize start = h;
        while (self.entries[h].occupied)
        {
            if (self.eqFn(self.entries[h].key, key))
                return Option<V>::Some { .value = self.entries[h].value };
            h = (h + 1) % self.cap;
            if (h == start) break;
        }
        return Option<V>::None;
    }

/// Returns true when key is present.
    bool contains(K key)
    {
        usize h = self.hashFn(key) % self.cap;
        usize start = h;
        while (self.entries[h].occupied)
        {
            if (self.eqFn(self.entries[h].key, key))
                return true;
            h = (h + 1) % self.cap;
            if (h == start) break;
        }
        return false;
    }

/// Returns a pointer to the value for key, or None when absent.
    Option<V*> getPtr(K key)
    {
        usize h = self.hashFn(key) % self.cap;
        usize start = h;
        while (self.entries[h].occupied)
        {
            if (self.eqFn(self.entries[h].key, key))
                return Option<V*>::Some { .value = &self.entries[h].value };
            h = (h + 1) % self.cap;
            if (h == start) break;
        }
        return Option<V*>::None;
    }

/// Removes the entry for key, if any.
    void remove(K key)
    {
        self.removeEntry(key);
    }

    // Remove an entry and return it (by value) so the caller can dispose of
    // heap-owned keys/values. Uses backward-shift deletion so open-addressing
    // probe chains are never broken by a hole.
/// Removes key and returns its entry so the caller can release owned storage.
    Option<HashMapEntry<K, V>> removeEntry(K key)
    {
        usize h = self.hashFn(key) % self.cap;
        usize start = h;
        usize found = 0;
        bool hasFound = false;
        while (self.entries[h].occupied)
        {
            if (self.eqFn(self.entries[h].key, key))
            {
                found = h;
                hasFound = true;
                break;
            }
            h = (h + 1) % self.cap;
            if (h == start) break;
        }
        if (!hasFound) return Option<HashMapEntry<K, V>>::None;

        HashMapEntry<K, V> result = self.entries[found];
        usize i = found;
        loop
        {
            usize j = (i + 1) % self.cap;
            while (self.entries[j].occupied)
            {
                // entry j can be shifted into the hole at i iff its ideal slot
                // is NOT in the circular interval (i, j]
                usize ideal = self.hashFn(self.entries[j].key) % self.cap;
                bool inInterval = i < j
                    ? (ideal > i && ideal <= j)
                    : (ideal > i || ideal <= j);
                if (!inInterval) break;
                j = (j + 1) % self.cap;
            }
            if (!self.entries[j].occupied)
            {
                self.entries[i].occupied = false;
                break;
            }
            self.entries[i] = self.entries[j];
            i = j;
        }
        self.len--;
        return Option<HashMapEntry<K, V>>::Some { .value = result };
    }

/// Removes every entry without freeing the backing storage.
    void clear()
    {
        for (usize i = 0; i < self.cap; i++)
            self.entries[i].occupied = false;
        self.len = 0;
    }

/// Returns a new vector containing every key.
    Vec<K> keys()
    {
        Vec<K> out = Vec<K>::new();
        for (usize i = 0; i < self.cap; i++)
            if (self.entries[i].occupied) out.push(self.entries[i].key);
        return out;
    }

/// Returns a new vector containing every value.
    Vec<V> values()
    {
        Vec<V> out = Vec<V>::new();
        for (usize i = 0; i < self.cap; i++)
            if (self.entries[i].occupied) out.push(self.entries[i].value);
        return out;
    }

/// Calls fn for every key/value pair.
    void each(void(K, V) fn)
    {
        for (usize i = 0; i < self.cap; i++)
            if (self.entries[i].occupied) fn(self.entries[i].key, self.entries[i].value);
    }

/// Calls fn with a pointer to every entry.
    void eachEntry(void(HashMapEntry<K, V>*) fn)
    {
        for (usize i = 0; i < self.cap; i++)
            if (self.entries[i].occupied) fn(&self.entries[i]);
    }
}

/// Implements @drop by freeing the entry storage.
pub extend<K, V> HashMap<K, V> : @drop
{
    
    void drop() { self.dispose(); }
}
