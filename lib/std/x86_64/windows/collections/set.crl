#[[no_drop_all]]
import hashmap { HashMap };
import vec { Vec };

/// Hash set storing unique values, backed by a HashMap.
pub struct Set<T>
{
    HashMap<T, bool> inner;
    usize(T) hashFn;
    bool(T, T) eqFn;

/// Creates an empty set using hf to hash values and ef to compare them.
    static Set<T> new(usize(T) hf, bool(T, T) ef)
    {
        return Set<T> {
            .inner = HashMap<T, bool>::new(hf, ef),
            .hashFn = hf,
            .eqFn = ef
        };
    }

    #[[inline]]
/// Frees the underlying map and resets the set.
    void dispose() { self.inner.dispose(); }
    #[[inline]]
/// Returns the number of stored values.
    usize count() { return self.inner.count(); }
    #[[inline]]
/// Returns true when the set holds no values.
    bool isEmpty() { return self.inner.count() == 0; }
    #[[inline]]
/// Adds val to the set when not already present.
    void insert(T val) { self.inner.insert(val, true); }
    #[[inline]]
/// Returns true when val is present.
    bool contains(T val) { return self.inner.contains(val); }
    #[[inline]]
/// Removes val from the set, if present.
    void remove(T val) { self.inner.remove(val); }
    #[[inline]]
/// Removes every value.
    void clear() { self.inner.clear(); }

/// Returns a new vector containing every stored value.
    Vec<T> toVec()
    {
        Vec<T> out = Vec<T>::new();
        for (usize i = 0; i < self.inner.cap; i++)
            if (self.inner.entries[i].occupied) out.push(self.inner.entries[i].key);
        return out;
    }

/// Calls fn for every stored value.
    void each(void(T) fn)
    {
        Vec<T> keys = self.inner.keys();
        for (usize i = 0; i < keys.count(); i++)
            fn(keys.at(i));
    }

/// Returns a new set with the values of this set and other.
    Set<T> union(const Set<T>* other)
    {
        Set<T> result = Set<T>::new(self.hashFn, self.eqFn);
        Vec<T> k = self.toVec();
        for (usize i = 0; i < k.count(); i++)
            result.insert(k.at(i));
        Vec<T> ok = other->toVec();
        for (usize i = 0; i < ok.count(); i++)
            result.insert(ok.at(i));
        return result;
    }

/// Returns a new set with the values present in both this set and other.
    Set<T> intersection(const Set<T>* other)
    {
        Set<T> result = Set<T>::new(self.hashFn, self.eqFn);
        Vec<T> k = self.toVec();
        for (usize i = 0; i < k.count(); i++)
        {
            T val = k.at(i);
            if (other->contains(val)) result.insert(val);
        }
        return result;
    }

/// Returns a new set with the values of this set that are absent from other.
    Set<T> difference(const Set<T>* other)
    {
        Set<T> result = Set<T>::new(self.hashFn, self.eqFn);
        Vec<T> k = self.toVec();
        for (usize i = 0; i < k.count(); i++)
        {
            T val = k.at(i);
            if (!other->contains(val)) result.insert(val);
        }
        return result;
    }

/// Returns true when every value of this set is present in other.
    bool isSubset(const Set<T>* other)
    {
        Vec<T> k = self.toVec();
        for (usize i = 0; i < k.count(); i++)
        {
            if (!other->contains(k.at(i))) return false;
        }
        return true;
    }

/// Returns true when every value of other is present in this set.
    bool isSuperset(const Set<T>* other)
    {
        return other->isSubset(self);
    }
}

/// Implements @drop by freeing the underlying map.
pub extend<T> Set<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
