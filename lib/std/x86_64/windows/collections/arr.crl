import range { IterRange };
import(lib) std::error { __assert, __assertOut };

/// Fixed-size array of N elements stored inline.
pub struct Arr<T, N>
{
    T data[N];

/// Returns a mutable pointer to the first element.
    T* ptr() { return (T*)self.data; }
/// Returns a const pointer to the first element.
    const T* constPtr() { return (const T*)self.data; }
/// Returns true when N is zero.
    bool isEmpty() { return N == 0; }

/// Overwrites the element at index i; asserts i is in range.
    void set(usize i, T val)
    {
        __assertOut(i < N, "Index out of bounds.");
        self.data[i] = val;
    }

/// Returns a pointer to the element at index i; asserts i is in range.
    T* atPtr(usize i)
    {
        __assertOut(i < N, "Index out of bounds.");
        return &self.data[i];
    }

/// Returns the first element; asserts the array is non-empty.
    T front()
    {
        __assertOut(N > 0, "Invalid array size.");
        return self.data[0];
    }

/// Returns the last element; asserts the array is non-empty.
    T back()
    {
        __assertOut(N > 0, "Invalid array size.");
        return self.data[N - 1];
    }

/// Sets every element to val.
    void fill(T val)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = val;
    }

/// Copies all N elements into dst.
    void copyTo(T* dst)
    {
        for (usize i = 0; i < N; i++)
            dst[i] = self.data[i];
    }

/// Copies all N elements from src.
    void copyFrom(const T* src)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = src[i];
    }
}

/// Implements @iter by exposing the fixed length and indexed elements.
pub extend<T, N> Arr<T, N> : @iter
{
/// Returns the fixed element count N.
    usize count() { return N; }

/// Returns the element at index i; asserts i is in range.
    T at(usize i)
    {
        __assertOut(i < N, "Index out of bounds.");
        return self.data[i];
    }

/// Returns the clamped half-open bounds [start, end) for for-in.
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}