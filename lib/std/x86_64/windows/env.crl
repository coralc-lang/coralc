#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::string { String };
import(lib) std::mman { alloc, dealloc, copy };
import(lib) std::result { Result };
import(lib) std::option { Option };
import(lib) std::fs { IoError };
import(lib) platform::win32 { GetEnvironmentVariableA, SetEnvironmentVariableA, GetEnvironmentStringsA, FreeEnvironmentStringsA, GetLastError };

// two-pass, null buffer reports the size (incl. NUL), second call fills.
// missing and empty both report 0 - getenv() told them apart, but an
// empty String is the right get() result either way.
bool _lookup(const cchar* name, String* out)
{
    u32 need = GetEnvironmentVariableA(name, null, 0u);
    if (need == 0u) return false;
    u8* buf = alloc<u8>((usize)need + 1u);
    if (buf == null) return false;
    u32 got = GetEnvironmentVariableA(name, (cchar*)buf, need + 1u);
    buf[got] = 0; // got <= need, so this is inside the allocation
    out->free();
    *out = String::fromCstr((cchar*)buf);
    dealloc<u8>(buf);
    return true;
}

// None when the variable is not set — absence, not an error
/// Value of environment variable `name`, or None when unset.
pub Option<String> get(str name)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>((u8*)buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    String result = String::new();
    bool found = _lookup(buf, &result);
    dealloc<u8>((u8*)buf);
    if (!found)
    {
        result.free();
        return Option<String>::None;
    }
    return Option<String>::Some { .value = result };
}

// false when the variable is not set (the normal miss, no error to give)
/// Write `name`'s value into `out`; false when the variable is unset.
pub bool getInto(str name, String* out)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>((u8*)buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    bool ok = _lookup(buf, out);
    dealloc<u8>((u8*)buf);
    return ok;
}

/// Set `name` to `value`, overwriting any existing entry.
pub Result<bool, IoError> set(str name, str value)
{
    cchar* nbuf = (cchar*)alloc<u8>(name.len + 1);
    cchar* vbuf = (cchar*)alloc<u8>(value.len + 1);
    copy<u8>((u8*)nbuf, (u8*)name.ptr, name.len);
    copy<u8>((u8*)vbuf, (u8*)value.ptr, value.len);
    nbuf[name.len] = 0; vbuf[value.len] = 0;
    // setenv overwrite, SetEnvironmentVariableA creates or replaces
    // unconditionally.
    bool ok = SetEnvironmentVariableA(nbuf, vbuf);
    dealloc<u8>((u8*)nbuf);
    dealloc<u8>((u8*)vbuf);
    if (!ok) return Result<bool, IoError>::Err { .error = IoError::os("SetEnvironmentVariableA") };
    return Result<bool, IoError>::Ok { .value = true };
}

/// Remove `name` from the environment.
pub Result<bool, IoError> unset(str name)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>((u8*)buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    // A null value deletes the variable.
    bool ok = SetEnvironmentVariableA(buf, null);
    if (!ok)
    {
        // glibc unsetenv succeeds when absent; SetEnvironmentVariableA
        // doesn't (ERROR_ENVVAR_NOT_FOUND) - treat absent as success.
        // capture the error first: the probe below overwrites it.
        u32 code = GetLastError();
        if (GetEnvironmentVariableA(buf, null, 0u) == 0u)
        {
            dealloc<u8>((u8*)buf);
            return Result<bool, IoError>::Ok { .value = true };
        }
        dealloc<u8>((u8*)buf);
        return Result<bool, IoError>::Err { .error = IoError::Os { .code = (i32)code, .op = "SetEnvironmentVariableA" } };
    }
    dealloc<u8>((u8*)buf);
    return Result<bool, IoError>::Ok { .value = true };
}

/// Append every "NAME=VALUE" entry to `out` and return the count.
pub usize all(Vec<String>* out)
{
    // environ -> GetEnvironmentStringsA, back-to-back NUL-terminated
    // "NAME=VALUE" strings plus an EXTRA final NUL. A zero byte at the
    // cursor is the double-NUL end marker - step over each string's own
    // terminator and push it.
    cchar* block = GetEnvironmentStringsA();
    if (block == null) return 0;
    usize count = 0;
    usize i = 0;
    while (block[i] != 0)
    {
        usize start = i;
        while (block[i] != 0) i++;
        out->push(String::from(str::fromParts((u8*)(block + start), i - start)));
        i++; // this string's terminating NUL
        count++;
    }
    FreeEnvironmentStringsA(block);
    return count;
}
