#[[no_drop_all]]
// import std::error { __assert, __assertOut };
/* result.crl for std
 * coral has no inbuilt error handling.
 * I will not add try-catch shit either;
 */

/// Result of an operation that is either Ok with a value or Err with an error.
pub variant Result<T, E> // pub enum Result<T, E> : tagged {}
{
    Ok { T value; },
    Err { E error; }
}

/// Methods for inspecting and transforming a Result.
pub extend<T, E> Result<T, E>
{
/// Returns true when the result holds Ok.
    bool isOk()
    {
        switch (self)
        {
            Ok { value } => { return true; },
            else => { return false; }
        }
    }

    
/// Returns true when the result holds Err.
    bool isErr() { return !self.isOk(); }

/// Returns the Ok value; asserts the result is Ok.
    T unwrap()
    {
        switch (self)
        {
            Ok { value } => { return value; },
            else => { @assertOut(false, "Called unwrap() on an 'Err' value."); }
        }
    }
    
    /// Returns Ok value, or recovers from an Err using a handler.
    /// the handler runs only when this is Some. it is never called.
    /// unlike unwrapOr, the fallback is computed lazily.
    /// usage: T v = readConfig(path).finally(closeFile).catch(useDefault);
    // disabled until sema understands variant exhaustiveness: T0011 fires
    // even though the arms cover every variant (Ok + Err), because a switch
    // only counts as exhaustive with an `else` arm — docs/currentstate.md D.
    // T catch(T(E) onErr)
    // {
    //     switch (self) {
    //         Ok { value } => { return value; },
    //         Err { error } => { return onErr(error); }
    //     }
    // }

    /// Runs a clean up function, then returns this result unchanged. 
    /// The function runs for both Ok and Err. It cannot see or alter.
    /// usage: T v = readConfig(path).finally(closeFile).catch(useDefault);
    Result<T, E> finally(void() fn)
    {
        fn();
        return *self;
    }

    /// Returns the Ok value, or defaultVal when the result is Err.
    T unwrapOr(T defaultVal)
    {
        switch (self)
        {
            Ok { value } => { return value; },
            else => { return defaultVal; }
        }
    }

/// Returns the Err error; asserts the result is Err.
    E unwrapErr()
    {
        switch (self)
        {
            Err { error } => { return error; },
            else => { @assertOut(false, "Called unwrapErr() on an Ok value."); }
        }
    }

/// Returns a mutable pointer to the Ok value, or null when Err.
    T* okPtr()
    {
        switch (self)
        {
            Ok { value } => { return &value; },
            else => { return null; }
        }
    }

/// Returns a mutable pointer to the Err error, or null when Ok.
    E* errPtr()
    {
        switch (self)
        {
            Err { error } => { return &error; },
            else => { return null; }
        }
    }

/// Replaces the Ok value with fn applied to it; leaves Err unchanged.
    void mapOk(T(T) fn)
    {
        switch (self)
        {
            Ok { value } => { self = Result<T, E>::Ok { .value = fn(value) }; },
            else => { } 
        }
    }

/// Replaces the Err error with fn applied to it; leaves Ok unchanged.
    void mapErr(E(E) fn)
    {
        switch (self)
        {
            Err { error } => { self = Result<T, E>::Err { .error = fn(error) }; },
            else => { } 
        }
    }

/// Replaces the result with fn applied to the Ok value; leaves Err unchanged.
    void andThen(Result<T, E>(T) fn)
    {
        switch (self)
        {
            Ok { value } => { self = fn(value); },
            else => { } 
        }
    }

/// Replaces an Err result with fn applied to the error; leaves Ok unchanged.
    void orElse(Result<T, E>(E) fn)
    {
        switch (self)
        {
            Err { error } => { self = fn(error); },
            else => { } 
        }
    }
}