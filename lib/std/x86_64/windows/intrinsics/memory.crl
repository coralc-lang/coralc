#[[no_drop_all]]
// memmove, memcpy, memcmp, mmep, memset... provided here

import platform::win32 { VirtualAlloc, VirtualFree };

const u32 MEM_COMMIT = 0x1000;
const u32 MEM_RESERVE = 0x2000;
const u32 MEM_RELEASE = 0x8000;
const u32 PAGE_READWRITE = 4;
// memmove, memcpy, memcmp, mmep, memset... provided here

/// Copy n bytes between possibly overlapping regions.
pub void memmove(rawptr dst, const rawptr src, usize n)
{
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;
    if (n == 0 || d == s) return;

    // Disjoint regions (the common case), or small sizes: plain memcpy.
    if (n <= 16 || ((usize)d - (usize)s >= n && (usize)s - (usize)d >= n))
    {
        memcpy(dst, src, n);
        return;
    }

    if (d < s)
    {
        u64 tail = *(const u64*)(s + n - 8);   // load before the loop can overwrite it
        usize i = 0;
        while (i + 8 <= n)
        {
            *(u64*)(d + i) = *(const u64*)(s + i);
            i += 8;
        }
        *(u64*)(d + n - 8) = tail;
    }
    else
    {
        u64 head = *(const u64*)s;
        usize i = n;
        while (i >= 8)
        {
            i -= 8;
            *(u64*)(d + i) = *(const u64*)(s + i);
        }
        *(u64*)d = head;
    }
}

/// Copy n bytes between non-overlapping regions.
pub void memcpy(rawptr dst, const rawptr src, usize n)
{
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;

    if (n <= 16)
    {
        // All loads happen before all stores, so this path is also overlap-safe.
        if (n >= 8)
        {
            u64 a = *(const u64*)s;
            u64 b = *(const u64*)(s + n - 8);
            *(u64*)d = a;
            *(u64*)(d + n - 8) = b;
        }
        else if (n >= 4)
        {
            u32 a = *(const u32*)s;
            u32 b = *(const u32*)(s + n - 4);
            *(u32*)d = a;
            *(u32*)(d + n - 4) = b;
        }
        else if (n > 0)
        {
            u8 a = s[0];
            u8 b = s[n >> 1];
            u8 c = s[n - 1];
            d[0] = a;
            d[n >> 1] = b;
            d[n - 1] = c;
        }
        return;
    }

    if (n >= 256)
    {
        u8* dd = d;
        const u8* ss = s;
        usize cnt = n;
        asm volatile {
            "rep movsb"
            : "=D"(dd), "=S"(ss), "=c"(cnt)
            : "0"(dd), "1"(ss), "2"(cnt)
            : "memory"
        }
        return;
    }

    usize i = 0;
    while (i + 8 <= n)
    {
        *(u64*)(d + i) = *(const u64*)(s + i);
        i += 8;
    }
    *(u64*)(d + n - 8) = *(const u64*)(s + n - 8);   // overlapping tail word
}


// mmap -> VirtualAlloc (reserve+commit RW). The POSIX 6-arg signature is
// kept so mman/mimalloc call sites don't move - prot/flags/fd/offset
// ignored, addr a placement hint. Null on failure.
/// Map length bytes at addr with the given protection; null on failure.
pub rawptr mmap(rawptr addr, usize length,
                i32 prot, i32 flags,
                i32 fd, i64 offset)
{
    (void)prot;
    (void)flags;
    (void)fd;
    (void)offset;
    return VirtualAlloc(addr, (u64)length, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
}


// munmap -> VirtualFree(MEM_RELEASE), needs base + zero size, so the
// length is ignored.
/// Unmap length bytes previously mapped at addr.
pub void munmap(rawptr addr, usize length)
{
    (void)length;
    VirtualFree(addr, 0, MEM_RELEASE);
}

/// Fill n bytes at dst with val.
pub void memset(rawptr dst, u8 val, usize n)
{
    u8* d = (u8*)dst;
    u64 v = (u64)val * 0x0101010101010101;

    if (n < 16)
    {
        if (n >= 8)
        {
            *(u64*)d = v;
            *(u64*)(d + n - 8) = v;
        }
        else if (n >= 4)
        {
            *(u32*)d = (u32)v;
            *(u32*)(d + n - 4) = (u32)v;
        }
        else if (n > 0)
        {
            d[0] = val;
            d[n >> 1] = val;
            d[n - 1] = val;
        }
        return;
    }

    if (n >= 256)
    {
        u8* dd = d;
        usize cnt = n;
        asm volatile {
            "rep stosb"
            : "=D"(dd), "=c"(cnt)
            : "a"(val), "0"(dd), "1"(cnt)
            : "memory"
        }
        return;
    }

    usize i = 0;
    while (i + 8 <= n)
    {
        *(u64*)(d + i) = v;
        i += 8;
    }
    *(u64*)(d + n - 8) = v;
}


/// Compare n bytes; negative, zero, or positive like memcmp.
pub i32 memcmp(const rawptr a, const rawptr b, usize n)
{
    const u8* pa = (const u8*)a;
    const u8* pb = (const u8*)b;
    usize i = 0;

    while (i + 8 <= n)
    {
        if (*(const u64*)(pa + i) != *(const u64*)(pb + i)) break;
        i += 8;
    }
    while (i < n)
    {
        if (pa[i] < pb[i]) return -1;
        if (pa[i] > pb[i]) return 1;
        i++;
    }
    return 0;
}