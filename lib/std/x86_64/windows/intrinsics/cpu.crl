import platfrom::win32 { GetActiveProcessorCount, SetThreadGroupAffinity, GetActiveProcessorGroupCount };

/// Number of cores this process may actually run on.
pub u32 cpuCount()
{
    u32 n = GetActiveProcessorCount(0xFFFF);   // ALL_PROCESSOR_GROUPS
    if (n == 0) return 1;
    return n;
}

struct GroupAffinity { u64 mask; u16 group; u16[3] reserved; }

/// Restrict a `Thread t` to one core).
pub bool threadPin(Thread t, u32 core)
{
    u16 groups = GetActiveProcessorGroupCount();
    u32 base = 0;
    for (u16 g = 0; g < groups; g++)
    {
        u32 size = GetActiveProcessorCount(g);
        if (core < base + size)
        {
            GroupAffinity ga = {                  // zeroed, reserved must be 0
                .mask  = (u64)(1 << (core - base))
                .group = g
            };
            
            return SetThreadGroupAffinity((rawptr)t, (rawptr)&ga, null) != 0;
        }
        base += size;
    }
    return false;                              // core out of range
}