#[[no_drop_all]]
/// Half-open index bounds returned by the @iter range() protocol.
///  
/// start is inclusive and end is exclusive: the interval is [start, end).
/// Implementations clamp both fields to their current element count and set
/// end to start when the requested interval is reversed, so a bounded for-in
/// over `value(start, end)` is always safe. The struct is deliberately
/// non-generic so importing/seeding a collection does not implicitly
/// instantiate a Vec<T> or any other container.
pub struct IterRange
{
    usize start;
    usize end;
}
