#[[no_drop_all]]
import(lib) std::mman { copy };
import(lib) platform::win32 { BCryptGenRandom }; // bcrypt.dll must be linked

const u32 BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2;

/// Returns eight cryptographically secure random bytes from the operating system.
pub u64 nextU64()
{
    u64 val = 0;
    // non-zero NTSTATUS -> 0, like the old urandom read failure.
    if (BCryptGenRandom((rawptr)&val, 8u, BCRYPT_USE_SYSTEM_PREFERRED_RNG) != 0) return 0;
    return val;
}

/// Returns a cryptographically secure random 32-bit value.
pub u32 nextU32()
{
    return (u32)(nextU64() & 0xFFFFFFFFu);
}

/// Returns a secure random value in the half-open range [lo, hi).
pub u64 nextRange(u64 lo, u64 hi)
{
    if (lo >= hi) return lo;
    u64 range = hi - lo;
    u64 limit = 0xFFFFFFFFFFFFFFFFu - (0xFFFFFFFFFFFFFFFFu % range);
    u64 val = nextU64();
    while (val >= limit) val = nextU64();
    return lo + val % range;
}

/// Returns a secure random float64 in [0, 1).
pub f64 nextF64()
{
    u64 bits = (u64)(nextU64() >> 12u) | 0x3FF0000000000000u;
    f64 result;
    copy<f64>(&result, (f64*)&bits, 1u);
    return result - 1.0;
}

/// Fast non-cryptographic xorshift32 pseudo-random generator.
pub struct XorShift32
{
    u32 state;

    /// Creates a generator seeded with s; zero is replaced by one.
    XorShift32 seed(u32 s)
    {
        return XorShift32 { .state = s ? s : 1u };
    }

    /// Returns the next 32-bit pseudo-random value.
    u32 next()
    {
        u32 x = self.state;
        x ^= x << 13u;
        x ^= x >> 17u;
        x ^= x << 5u;
        self.state = x;
        return x;
    }

    /// Returns the next 64-bit pseudo-random value.
    u64 nextU64()
    {
        u32 lo = self.next();
        u32 hi = self.next();
        return ((u64)hi << 32u) | (u64)lo;
    }

    /// Returns a pseudo-random value in the half-open range [lo, hi).
    u64 nextRange(u64 lo, u64 hi)
    {
        if (lo >= hi) return lo;
        u64 range = hi - lo;
        u64 limit = 0xFFFFFFFFFFFFFFFFu - (0xFFFFFFFFFFFFFFFFu % range);
        u64 val = self.nextU64();
        while (val >= limit) val = self.nextU64();
        return lo + val % range;
    }
}

/// Non-cryptographic PCG32 pseudo-random generator.
pub struct Pcg32
{
    u64 state;
    u64 inc;

    /// Creates a generator from a 64-bit state and sequence selector.
    Pcg32 seed(u64 initState, u64 initSeq)
    {
        Pcg32 rng;
        rng.state = 0u;
        rng.inc = (initSeq << 1u) | 1u;
        rng.next();
        rng.state += initState;
        rng.next();
        return rng;
    }

    /// Returns the next 32-bit pseudo-random value.
    u32 next()
    {
        u64 old = self.state;
        self.state = old * 6364136223846793005u + self.inc;
        u32 xorshift = (u32)(((old >> 18u) ^ old) >> 27u);
        u32 rot = (u32)(old >> 59u);
        return (xorshift >> (u32)rot) | (xorshift << (u32)((-rot) & 31u));
    }

    /// Returns the next 64-bit pseudo-random value.
    u64 nextU64()
    {
        u32 lo = self.next();
        u32 hi = self.next();
        return ((u64)hi << 32u) | (u64)lo;
    }

    /// Returns a pseudo-random value in the half-open range [lo, hi).
    u64 nextRange(u64 lo, u64 hi)
    {
        if (lo >= hi) return lo;
        u64 range = hi - lo;
        u64 limit = 0xFFFFFFFFFFFFFFFFu - (0xFFFFFFFFFFFFFFFFu % range);
        u64 val = self.nextU64();
        while (val >= limit) val = self.nextU64();
        return lo + val % range;
    }
}
