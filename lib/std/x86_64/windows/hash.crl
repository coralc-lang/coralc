#[[no_drop_all]]
// Generic hash functions for use in hash maps and sets

/// Computes the 64-bit FNV-1a hash of len bytes.
pub u64 fnv1a(const u8* data, usize len)
{
    u64 hash = 14695981039346656037; // FNV offset basis
    for (usize i = 0; i < len; i++)
    {
        hash ^= (u64)data[i];
        hash *= 1099511628211; // FNV prime
    }
    return hash;
}

/// Computes the 64-bit FNV-1a hash of a string.
pub u64 fnv1aStr(str s)
{
    return fnv1a(s.ptr, s.len);
}

/// Computes the 32-bit MurmurHash3 hash of len bytes seeded by seed.
pub u32 murmur3(const u8* data, usize len, u32 seed)
{
    u32 h = seed;
    usize nblocks = len / 4;
    for (usize i = 0; i < nblocks; i++)
    {
        u32 k = (u32)data[i * 4] |
                ((u32)data[i * 4 + 1] << 8) |
                ((u32)data[i * 4 + 2] << 16) |
                ((u32)data[i * 4 + 3] << 24);
        k *= 0xcc9e2d51;
        k = (k << 15) | (k >> 17);
        k *= 0x1b873593;
        h ^= k;
        h = (h << 13) | (h >> 19);
        h = h * 5 + 0xe6546b64;
    }
    // Tail
    usize tail = nblocks * 4;
    u32 k = 0;
    usize remaining = len - tail;
    if (remaining >= 3) k ^= (u32)data[tail + 2] << 16;
    if (remaining >= 2) k ^= (u32)data[tail + 1] << 8;
    if (remaining >= 1)
    {
        k ^= (u32)data[tail];
        k *= 0xcc9e2d51;
        k = (k << 15) | (k >> 17);
        k *= 0x1b873593;
        h ^= k;
    }
    h ^= (u32)len;
    h ^= h >> 16;
    h *= 0x85ebca6b;
    h ^= h >> 13;
    h *= 0xc2b2ae35;
    h ^= h >> 16;
    return h;
}

/// Computes the wyhash hash of len bytes seeded by seed.
pub u64 wyhash(const u8* data, usize len, u64 seed)
{
    const u64 P1 = 0xa0761d6478bd642f;
    const u64 P2 = 0xe7037ed1a0b428db;
    const u64 P3 = 0x8ebc6af09c88c6e3;
    const u64 P4 = 0x589965cc75374cc3;

    u64 h = seed ^ P1;
    usize i = 0;
    while (i + 32 <= len)
    {
        u64 s0 = seed;
        u64 s1 = seed;
        // Read 4 u64s
        u64 v0 = (u64)data[i] | ((u64)data[i + 1] << 8) | ((u64)data[i + 2] << 16) | ((u64)data[i + 3] << 24) |
                 ((u64)data[i + 4] << 32) | ((u64)data[i + 5] << 40) | ((u64)data[i + 6] << 48) | ((u64)data[i + 7] << 56);
        u64 v1 = (u64)data[i + 8] | ((u64)data[i + 9] << 8) | ((u64)data[i + 10] << 16) | ((u64)data[i + 11] << 24) |
                 ((u64)data[i + 12] << 32) | ((u64)data[i + 13] << 40) | ((u64)data[i + 14] << 48) | ((u64)data[i + 15] << 56);
        u64 v2 = (u64)data[i + 16] | ((u64)data[i + 17] << 8) | ((u64)data[i + 18] << 16) | ((u64)data[i + 19] << 24) |
                 ((u64)data[i + 20] << 32) | ((u64)data[i + 21] << 40) | ((u64)data[i + 22] << 48) | ((u64)data[i + 23] << 56);
        u64 v3 = (u64)data[i + 24] | ((u64)data[i + 25] << 8) | ((u64)data[i + 26] << 16) | ((u64)data[i + 27] << 24) |
                 ((u64)data[i + 28] << 32) | ((u64)data[i + 29] << 40) | ((u64)data[i + 30] << 48) | ((u64)data[i + 31] << 56);
        s0 = (((v0 * P1) >> 32) * P2) & 0xFFFFFFFFFFFFFFFF;
        s1 = (((v1 * P2) >> 32) * P3) & 0xFFFFFFFFFFFFFFFF;
        h ^= (((v2 * P3) >> 32) * P4) & 0xFFFFFFFFFFFFFFFF;
        h ^= (((v3 * P4) >> 32) * P1) & 0xFFFFFFFFFFFFFFFF;
        h ^= s0 + s1;
        i += 32;
    }
    // Tail
    while (i + 8 <= len)
    {
        u64 v = (u64)data[i] | ((u64)data[i + 1] << 8) | ((u64)data[i + 2] << 16) | ((u64)data[i + 3] << 24) |
                ((u64)data[i + 4] << 32) | ((u64)data[i + 5] << 40) | ((u64)data[i + 6] << 48) | ((u64)data[i + 7] << 56);
        h ^= (((v * P3) >> 32) * P4) & 0xFFFFFFFFFFFFFFFF;
        i += 8;
    }
    // Remaining bytes
    u64 v = 0;
    usize remaining = len - i;
    for (usize j = 0; j < remaining; j++)
        v |= (u64)data[i + j] << (j * 8);
    h ^= (((v * P3) >> 32) * P4) & 0xFFFFFFFFFFFFFFFF;
    h ^= (u64)len;
    h ^= h >> 32;
    h *= P2;
    h ^= h >> 29;
    h *= P3;
    h ^= h >> 32;
    return h;
}

/// Computes the wyhash hash of a string with a zero seed.
pub u64 wyhashStr(str s)
{
    return wyhash(s.ptr, s.len, 0);
}

/// Mixes value into seed, returning a combined hash.
pub u64 hashCombine(u64 seed, u64 value)
{
    seed ^= value + 0x9e3779b9 + (seed << 6) + (seed >> 2);
    return seed;
}
