#[[no_drop_all]]
import std::string { String };
import std::vec { Vec };
import std::option { Option };
import std::result { Result };
import platform::libc { strtod };

/// Error reported by the TOML parser, carrying a message and line.
import core::cchar { cchar };
pub variant ParseError
{
    Syntax { str msg; u32 line; u32 col; },
    Semantic { str msg; }
}

/// The kind of value a TomlValue holds.
pub enum TomlValueType
{
    String,
    Integer,
    Float,
    Bool,
    Array,
    Table,
}

/// A parsed TOML value: string, integer, float, bool, array, or table.
pub struct TomlValue
{
    TomlValueType type;
    String strVal;
    i64 intVal;
    f64 floatVal;
    bool boolVal;
    Vec<TomlValue> arrVal;
    Vec<TomlPair> tableVal;

    /// Returns a string value copying s.
    TomlValue stringVal(str s)
    {
        return TomlValue {
            .type = TomlValueType::String,
            .strVal = String::from(s)
        };
    }

    /// Returns an integer value.
    TomlValue intVal(i64 n)
    {
        return TomlValue { .type = TomlValueType::Integer, .intVal = n };
    }

    /// Returns a floating-point value.
    TomlValue floatVal(f64 n)
    {
        return TomlValue { .type = TomlValueType::Float, .floatVal = n };
    }

    /// Returns a boolean value.
    TomlValue boolVal(bool b)
    {
        return TomlValue { .type = TomlValueType::Bool, .boolVal = b };
    }

    /// Returns an empty array value.
    TomlValue arrayVal()
    {
        return TomlValue {
            .type = TomlValueType::Array,
            .arrVal = Vec<TomlValue>::new()
        };
    }

    /// Returns an empty table value.
    TomlValue tableVal()
    {
        return TomlValue {
            .type = TomlValueType::Table,
            .tableVal = Vec<TomlPair>::new()
        };
    }

    /// Frees the value's string, array, or table contents.
    void dispose()
    {
        if (self.type == TomlValueType::String) self.strVal.free();
        if (self.type == TomlValueType::Array)
        {
            for (usize i = 0; i < self.arrVal.count(); i++)
                self.arrVal.atPtr(i)->dispose();
            self.arrVal.dispose();
        }
        if (self.type == TomlValueType::Table)
        {
            for (usize i = 0; i < self.tableVal.count(); i++)
            {
                self.tableVal.atPtr(i)->key.free();
                self.tableVal.atPtr(i)->value.dispose();
            }
            self.tableVal.dispose();
        }
    }
}

/// A key/value pair in the document.
pub struct TomlPair
{
    String key;
    TomlValue value;
}

/// A parsed TOML document: top-level pairs and tables.
pub struct TomlDoc
{
    Vec<TomlPair> root;

    /// Creates an empty document.
    TomlDoc new()
    {
        return TomlDoc { .root = Vec<TomlPair>::new() };
    }

    /// Frees all keys and values in the document.
    void dispose()
    {
        for (usize i = 0; i < self.root.count(); i++)
        {
            self.root.atPtr(i)->key.free();
            self.root.atPtr(i)->value.dispose();
        }
        self.root.dispose();
    }

    /// Returns the top-level value for key, or None if absent.
    Option<TomlValue*> get(str key)
    {
        for (usize i = 0; i < self.root.count(); i++)
        {
            if (self.root.at(i).key.asView().equals(key))
                return Option<TomlValue*>::Some { .value = &self.root.atPtr(i)->value };
        }
        return Option<TomlValue*>::None;
    }

    /// Returns key's value inside table, or None if absent.
    Option<TomlValue*> getIn(str table, str key)
    {
        for (usize i = 0; i < self.root.count(); i++)
        {
            if (self.root.at(i).key.asView().equals(table) &&
                self.root.at(i).value.type == TomlValueType::Table)
            {
                Vec<TomlPair>* t = &self.root.atPtr(i)->value.tableVal;
                for (usize j = 0; j < t->count(); j++)
                {
                    if (t->at(j).key.asView().equals(key))
                        return Option<TomlValue*>::Some { .value = &t->atPtr(j)->value };
                }
            }
        }
        return Option<TomlValue*>::None;
    }
}

struct _TomlParser
{
    const u8* data;
    usize len;
    usize pos;
    usize line;
    bool error;
    str errMsg;

    void fail(str msg)
    {
        if (self.error) return;
        self.error = true;
        self.errMsg = msg;
    }

    ParseError err()
    {
        return ParseError::Syntax { .msg = self.errMsg, .line = (u32)self.line, .col = 0 };
    }

    void skipRest()
    {
        while (self.pos < self.len && self.data[self.pos] != '\n')
        {
            if (self.data[self.pos] == '\r') { self.pos++; if (self.pos < self.len && self.data[self.pos] == '\n') self.pos++; self.line++; return; }
            self.pos++;
        }
        if (self.pos < self.len) { self.pos++; self.line++; }
    }

    void skipLine()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c == '\n') { self.pos++; self.line++; return; }
            if (c == '\r') { self.pos++; if (self.pos < self.len && self.data[self.pos] == '\n') self.pos++; self.line++; return; }
            self.pos++;
        }
    }

    u8 peek()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c == ' ' || c == '\t') { self.pos++; continue; }
            if (c == '#') { self.skipLine(); continue; }
            if (c == '\n' || c == '\r') { self.skipLine(); continue; }
            return c;
        }
        return 0;
    }

    u8 next()
    {
        u8 c = self.peek();
        if (c == 0) return 0;
        self.pos++;
        return c;
    }

    String parseKey()
    {
        usize start = self.pos;
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c == ' ' || c == '\t' || c == '=' || c == '\n' || c == '\r' || c == '#' || c == '.' || c == '[' || c == ']') break;
            self.pos++;
        }
        if (self.pos == start) { self.fail("expected key"); return String::new(); }
        return String::from(str::fromParts((const u8*)(self.data + start), self.pos - start));
    }

    // consume one escape sequence after '\\' and push the decoded bytes
    // (UTF-8 for \uXXXX / \UXXXXXXXX). returns false on error.
    bool escInto(String* s)
    {
        if (self.pos >= self.len) { self.fail("unterminated string"); return false; }
        u8 esc = self.data[self.pos++];
        if (esc == 'n') { s->pushChar('\n'); return true; }
        if (esc == 't') { s->pushChar('\t'); return true; }
        if (esc == 'r') { s->pushChar('\r'); return true; }
        if (esc == '"') { s->pushChar('"'); return true; }
        if (esc == '\'') { s->pushChar('\''); return true; }
        if (esc == '\\') { s->pushChar('\\'); return true; }
        if (esc == 'b') { s->pushChar('\b'); return true; }
        if (esc == 'f') { s->pushChar('\f'); return true; }
        if (esc == 'u' || esc == 'U')
        {
            usize n = esc == 'u' ? 4 : 8;
            if (self.pos + n > self.len) { self.fail("bad unicode escape"); return false; }
            u32 cp = 0;
            usize i = 0;
            while (i < n)
            {
                u8 h = self.data[self.pos++];
                u32 d;
                if (h >= '0' && h <= '9') d = (u32)(h - '0');
                else if (h >= 'a' && h <= 'f') d = (u32)(h - 'a' + 10);
                else if (h >= 'A' && h <= 'F') d = (u32)(h - 'A' + 10);
                else { self.fail("bad unicode escape"); return false; }
                cp = cp * 16 + d;
                i++;
            }
            if (cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF))
            {
                self.fail("unicode escape out of range");
                return false;
            }
            if (cp < 0x80) s->pushChar((u8)cp);
            else if (cp < 0x800)
            {
                s->pushChar((u8)(0xC0 | (cp >> 6)));
                s->pushChar((u8)(0x80 | (cp & 0x3F)));
            }
            else if (cp < 0x10000)
            {
                s->pushChar((u8)(0xE0 | (cp >> 12)));
                s->pushChar((u8)(0x80 | ((cp >> 6) & 0x3F)));
                s->pushChar((u8)(0x80 | (cp & 0x3F)));
            }
            else
            {
                s->pushChar((u8)(0xF0 | (cp >> 18)));
                s->pushChar((u8)(0x80 | ((cp >> 12) & 0x3F)));
                s->pushChar((u8)(0x80 | ((cp >> 6) & 0x3F)));
                s->pushChar((u8)(0x80 | (cp & 0x3F)));
            }
            return true;
        }
        self.fail("invalid escape sequence");
        return false;
    }

    String parseBasicString()
    {
        String s = String::new();
        if (self.next() != '"') { self.fail("expected '\"'"); return s; }
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos++];
            if (c == '"') return s;
            if (c == '\\')
            {
                if (!self.escInto(&s)) { s.free(); return String::new(); }
            }
            else s.pushChar((u8)c);
        }
        self.fail("unterminated string");
        return s;
    }

    // 'literal' — no escape processing
    String parseLiteralString()
    {
        String s = String::new();
        if (self.next() != '\'') { self.fail("expected '\\''"); return s; }
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos++];
            if (c == '\'') return s;
            s.pushChar((u8)c);
        }
        self.fail("unterminated literal string");
        return s;
    }

    // """...""" — multiline basic string; a newline right after the opening
    // delimiter is trimmed per TOML. Line-ending backslash continuation is
    // not supported (rare in manifests).
    String parseMultilineBasic()
    {
        String s = String::new();
        self.pos += 3; // opening """
        if (self.pos < self.len && self.data[self.pos] == '\n') { self.pos++; self.line++; }
        else if (self.pos + 1 < self.len && self.data[self.pos] == '\r' && self.data[self.pos + 1] == '\n') { self.pos += 2; self.line++; }
        while (self.pos + 2 < self.len)
        {
            if (self.data[self.pos] == '"' && self.data[self.pos + 1] == '"' && self.data[self.pos + 2] == '"')
            {
                self.pos += 3;
                return s;
            }
            u8 c = self.data[self.pos++];
            if (c == '\n') self.line++;
            else if (c == '\r') { if (self.pos < self.len && self.data[self.pos] == '\n') self.pos++; self.line++; }
            if (c == '\\')
            {
                if (!self.escInto(&s)) { s.free(); return String::new(); }
            }
            else s.pushChar((u8)c);
        }
        self.fail("unterminated multiline string");
        return s;
    }

    // '''...''' — multiline literal string; same newline trim, no escapes
    String parseMultilineLiteral()
    {
        String s = String::new();
        self.pos += 3; // opening '''
        if (self.pos < self.len && self.data[self.pos] == '\n') { self.pos++; self.line++; }
        else if (self.pos + 1 < self.len && self.data[self.pos] == '\r' && self.data[self.pos + 1] == '\n') { self.pos += 2; self.line++; }
        while (self.pos + 2 < self.len)
        {
            if (self.data[self.pos] == '\'' && self.data[self.pos + 1] == '\'' && self.data[self.pos + 2] == '\'')
            {
                self.pos += 3;
                return s;
            }
            u8 c = self.data[self.pos++];
            if (c == '\n') self.line++;
            else if (c == '\r') { if (self.pos < self.len && self.data[self.pos] == '\n') self.pos++; self.line++; }
            s.pushChar((u8)c);
        }
        self.fail("unterminated multiline literal string");
        return s;
    }

    // bare key with optional `.seg` continuations; whitespace around dots is
    // allowed but newlines are not crossed. Returns dotted "a.b.c" text.
    String parseDottedKey()
    {
        String dotted = String::new();
        String k = self.parseKey();
        if (self.error) { k.free(); return dotted; }
        dotted.appendView(k.asView());
        k.free();
        loop
        {
            usize save = self.pos;
            while (self.pos < self.len && (self.data[self.pos] == ' ' || self.data[self.pos] == '\t')) self.pos++;
            if (self.pos < self.len && self.data[self.pos] == '.')
            {
                self.pos++;
                String kp = self.parseKey();
                if (self.error) { kp.free(); dotted.free(); return String::new(); }
                dotted.pushChar('.');
                dotted.appendView(kp.asView());
                kp.free();
            }
            else { self.pos = save; break; }
        }
        return dotted;
    }

    // { k = v, ... } inline table (may contain dotted keys / nested tables)
    TomlValue parseInlineTable()
    {
        TomlValue t = TomlValue::tableVal();
        if (self.next() != '{') { self.fail("expected '{'"); t.dispose(); return TomlValue::boolVal(false); }
        loop
        {
            u8 c = self.peek();
            if (c == '}') { self.pos++; return t; }
            if (c == 0) { self.fail("unterminated inline table"); t.dispose(); return TomlValue::boolVal(false); }
            String dotted = self.parseDottedKey();
            if (self.error) { dotted.free(); t.dispose(); return TomlValue::boolVal(false); }
            if (self.next() != '=') { self.fail("expected '=' in inline table"); dotted.free(); t.dispose(); return TomlValue::boolVal(false); }
            TomlValue v = self.parseValue();
            if (self.error) { v.dispose(); dotted.free(); t.dispose(); return TomlValue::boolVal(false); }
            tomlInsertDotted(&t.tableVal, dotted.asView(), v);
            dotted.free();
            c = self.peek();
            if (c == ',') { self.pos++; continue; }
            if (c == '}') { self.pos++; return t; }
            self.fail("expected ',' or '}' in inline table");
            t.dispose();
            return TomlValue::boolVal(false);
        }
    }

    // at self.pos pointing at '.', match .inf / .nan; *out receives the value
    bool parseDotFloat(f64* out)
    {
        if (self.pos + 4 > self.len || self.data[self.pos] != '.') return false;
        bool isInf = self.data[self.pos + 1] == 'i' && self.data[self.pos + 2] == 'n' && self.data[self.pos + 3] == 'f';
        bool isNan = self.data[self.pos + 1] == 'n' && self.data[self.pos + 2] == 'a' && self.data[self.pos + 3] == 'n';
        if (!isInf && !isNan) return false;
        self.pos += 4;
        String lit = String::from(isInf ? ".inf" : ".nan");
        cchar* end = null;
        *out = strtod((const cchar*)lit.asView().ptr, &end);
        lit.free();
        return true;
    }

    TomlValue parseValue()
    {
        u8 c = self.peek();
        if (c == '"')
        {
            bool multi = self.pos + 2 < self.len &&
                self.data[self.pos + 1] == '"' && self.data[self.pos + 2] == '"';
            String s = multi ? self.parseMultilineBasic() : self.parseBasicString();
            if (self.error) { s.free(); return TomlValue::boolVal(false); }
            TomlValue v = TomlValue::stringVal(s.asView());
            s.free();
            return v;
        }
        if (c == '\'')
        {
            bool multi = self.pos + 2 < self.len &&
                self.data[self.pos + 1] == '\'' && self.data[self.pos + 2] == '\'';
            String s = multi ? self.parseMultilineLiteral() : self.parseLiteralString();
            if (self.error) { s.free(); return TomlValue::boolVal(false); }
            TomlValue v = TomlValue::stringVal(s.asView());
            s.free();
            return v;
        }
        if (c == '{') return self.parseInlineTable();
        if (c == '.')
        {
            f64 dfv = 0;
            if (self.parseDotFloat(&dfv)) return TomlValue::floatVal(dfv);
            self.fail("unexpected token");
            return TomlValue::boolVal(false);
        }
        if (c == 't')
        {
            if (self.pos + 4 <= self.len && self.data[self.pos] == 't' && self.data[self.pos+1] == 'r' && self.data[self.pos+2] == 'u' && self.data[self.pos+3] == 'e')
            { self.pos += 4; return TomlValue::boolVal(true); }
            self.fail("invalid literal, expected 'true'"); return TomlValue::boolVal(false);
        }
        if (c == 'f')
        {
            if (self.pos + 5 <= self.len && self.data[self.pos] == 'f' && self.data[self.pos+1] == 'a' && self.data[self.pos+2] == 'l' && self.data[self.pos+3] == 's' && self.data[self.pos+4] == 'e')
            { self.pos += 5; return TomlValue::boolVal(false); }
            self.fail("invalid literal, expected 'false'"); return TomlValue::boolVal(false);
        }
        if (c == '[') return self.parseArray();
        if (c == '-' || (c >= '0' && c <= '9'))
        {
            bool neg = false;
            usize start = self.pos;
            if (c == '-') { neg = true; self.pos++; }
            // signed .inf / .nan
            f64 dfv = 0;
            if (self.parseDotFloat(&dfv))
                return TomlValue::floatVal(neg ? -dfv : dfv);
            // base prefixes: 0x / 0o / 0b (decimal otherwise); '_' ignored
            u32 base = 10;
            if (self.pos + 1 < self.len && self.data[self.pos] == '0')
            {
                u8 p = self.data[self.pos + 1];
                if (p == 'x' || p == 'X') { base = 16; self.pos += 2; }
                else if (p == 'o' || p == 'O') { base = 8; self.pos += 2; }
                else if (p == 'b' || p == 'B') { base = 2; self.pos += 2; }
            }
            u64 intVal = 0;
            bool anyDig = false;
            while (self.pos < self.len)
            {
                u8 d = self.data[self.pos];
                if (d == '_') { self.pos++; continue; }
                u32 dv;
                if (d >= '0' && d <= '9') dv = (u32)(d - '0');
                else if (base == 16 && d >= 'a' && d <= 'f') dv = (u32)(d - 'a' + 10);
                else if (base == 16 && d >= 'A' && d <= 'F') dv = (u32)(d - 'A' + 10);
                else break;
                if (dv >= base) break;
                if (intVal > (0x7FFFFFFFFFFFFFFFu - (u64)dv) / (u64)base)
                {
                    self.fail("integer out of range");
                    return TomlValue::boolVal(false);
                }
                intVal = intVal * (u64)base + (u64)dv;
                anyDig = true;
                self.pos++;
            }
            if (!anyDig)
            {
                self.fail("expected digit");
                return TomlValue::boolVal(false);
            }
            // datetime / local-time literals keep their raw text: 1979-05-27,
            // 07:32:00, 1979-05-27T07:32:00.123Z — a '-' ':' 'T' right after
            // the integer part means this is not a plain number.
            if (self.pos < self.len)
            {
                u8 nc = self.data[self.pos];
                if (nc == '-' || nc == ':' || nc == 'T' || nc == 't')
                {
                    usize dend = self.pos;
                    while (dend < self.len)
                    {
                        u8 dc = self.data[dend];
                        bool okc = (dc >= '0' && dc <= '9') || dc == '-' || dc == ':' ||
                                   dc == '.' || dc == 'T' || dc == 't' || dc == 'Z' ||
                                   dc == 'z' || dc == '+';
                        if (!okc) break;
                        dend++;
                    }
                    self.pos = dend;
                    String ds = String::from(str::fromParts((const u8*)(self.data + start), self.pos - start));
                    TomlValue v = TomlValue::stringVal(ds.asView());
                    ds.free();
                    return v;
                }
            }
            if (self.pos < self.len && (self.data[self.pos] == '.' || self.data[self.pos] == 'e' || self.data[self.pos] == 'E'))
            {
                while (self.pos < self.len)
                {
                    u8 ch = self.data[self.pos];
                    if ((ch < '0' || ch > '9') && ch != '.' && ch != 'e' && ch != 'E' && ch != '+' && ch != '-' && ch != '_') break;
                    self.pos++;
                }
                String raw = String::from(str::fromParts((const u8*)(self.data + start), self.pos - start));
                String clean = String::new();
                usize ci = 0;
                str rv = raw.asView();
                while (ci < rv.len)
                {
                    if (rv.ptr[ci] != '_') clean.pushChar(rv.ptr[ci]);
                    ci++;
                }
                raw.free();
                cchar* end;
                f64 fv = strtod((const cchar*)clean.asView().ptr, &end);
                bool okf = end == (const cchar*)(clean.asView().ptr + clean.asView().len);
                clean.free();
                if (!okf)
                {
                    self.fail("invalid number");
                    return TomlValue::boolVal(false);
                }
                // strtod already sees the leading '-' sign; do not negate again
                return TomlValue::floatVal(fv);
            }
            if (neg) return TomlValue::intVal(-(i64)intVal);
            return TomlValue::intVal((i64)intVal);
        }
        self.fail("unexpected token");
        return TomlValue::boolVal(false);
    }

    TomlValue parseArray()
    {
        TomlValue arr = TomlValue::arrayVal();
        if (self.next() != '[') { self.fail("expected '['"); arr.dispose(); return TomlValue::boolVal(false); }
        loop
        {
            u8 c = self.peek();
            if (c == ']') { self.pos++; return arr; }
            if (c == 0) { self.fail("unterminated array"); arr.dispose(); return TomlValue::boolVal(false); }
            TomlValue elem = self.parseValue();
            if (self.error) { elem.dispose(); arr.dispose(); return TomlValue::boolVal(false); }
            arr.arrVal.push(elem);
            c = self.peek();
            if (c == ',') { self.pos++; continue; }
            if (c == ']') { self.pos++; return arr; }
            self.fail("expected ',' or ']'");
            arr.dispose();
            return TomlValue::boolVal(false);
        }
    }
}

// ---- table-tree helpers (dotted headers, dotted keys, inline tables) ----

// direct child `key` of table `scope`; null when absent
TomlPair* tomlFind(Vec<TomlPair>* scope, str key)
{
    usize i = 0;
    while (i < scope->count())
    {
        if (scope->atPtr(i)->key.asView().equals(key)) return scope->atPtr(i);
        i++;
    }
    return null;
}

// resolve `key` to the table scope it denotes inside `scope`:
// absent -> new Table; Table -> itself; Array of Tables -> its last
// element (TOML: [x.y] after [[x]] targets the latest x); anyDig other
// existing value is replaced by a fresh Table (forgiving).
Vec<TomlPair>* tomlScopeFor(Vec<TomlPair>* scope, str key)
{
    TomlPair* p = tomlFind(scope, key);
    if (p != null)
    {
        if (p->value.type == TomlValueType::Table) return &p->value.tableVal;
        if (p->value.type == TomlValueType::Array && p->value.arrVal.count() > 0)
        {
            TomlValue* last = p->value.arrVal.atPtr(p->value.arrVal.count() - 1);
            if (last->type == TomlValueType::Table) return &last->tableVal;
        }
        p->value.dispose();
        p->value = TomlValue::tableVal();
        return &p->value.tableVal;
    }
    TomlPair np;
    np.key = String::from(key);
    np.value = TomlValue::tableVal();
    scope->push(np);
    return &scope->atPtr(scope->count() - 1)->value.tableVal;
}

// insert `val` at dotted path `path` ("a.b.c") inside `scope`, creating
// intermediate tables; an existing leaf value is replaced.
void tomlInsertDotted(Vec<TomlPair>* scope, str path, TomlValue val)
{
    usize i = 0;
    Vec<TomlPair>* cur = scope;
    while (true)
    {
        usize j = i;
        while (j < path.len && path.ptr[j] != '.') j++;
        str seg = str::fromParts(path.ptr + i, j - i);
        if (j >= path.len)
        {
            TomlPair* ex = tomlFind(cur, seg);
            if (ex != null)
            {
                ex->value.dispose();
                ex->value = val;
            }
            else
            {
                TomlPair np;
                np.key = String::from(seg);
                np.value = val;
                cur->push(np);
            }
            return;
        }
        cur = tomlScopeFor(cur, seg);
        i = j + 1;
    }
}

/// Parses a TOML document, returning it or a ParseError.
pub Result<TomlDoc, ParseError> parseToml(str input)
{
    _TomlParser p = _TomlParser {
        .data = (const u8*)input.ptr,
        .len = input.len,
        .pos = 0,
        .line = 1,
        .error = false,
        .errMsg = "invalid TOML"
    };
    TomlDoc doc = TomlDoc::new();

    Vec<TomlPair>* currentTable = &doc.root;
    String currentTableName = String::new();

    while (p.pos < p.len)
    {
        u8 c = p.peek();
        if (c == 0) break;

        if (c == '[')
        {
            p.pos++;
            bool isSub = false;
            if (p.peek() == '[') { isSub = true; p.pos++; }
            String tableName = String::new();
            bool first = true;
            loop
            {
                String part = p.parseKey();
                if (p.error) { tableName.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
                if (!first) tableName.pushChar('.');
                tableName.appendView(part.asView());
                part.free();
                first = false;
                u8 nc = p.peek();
                if (nc == ']') break;
                if (nc != '.') { p.fail("expected '.' or ']' in table header"); tableName.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
                p.pos++;
            }
            if (isSub) { if (p.next() != ']') { p.fail("expected ']]'"); tableName.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; } }
            if (p.next() != ']') { p.fail("expected ']'"); tableName.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
            p.skipLine();
            currentTableName.free();
            currentTableName = tableName;

            // resolve the dotted path into nested tables; the last segment
            // is a plain table ([a.b]) or an array-of-tables element ([[a.b]])
            str tn = currentTableName.asView();
            Vec<TomlPair>* scope = &doc.root;
            usize i = 0;
            while (true)
            {
                usize j = i;
                while (j < tn.len && tn.ptr[j] != '.') j++;
                str seg = str::fromParts(tn.ptr + i, j - i);
                if (j >= tn.len)
                {
                    if (isSub)
                    {
                        TomlPair* ap = tomlFind(scope, seg);
                        if (ap == null || ap->value.type != TomlValueType::Array)
                        {
                            if (ap != null) ap->value.dispose();
                            TomlPair np;
                            np.key = String::from(seg);
                            np.value = TomlValue::arrayVal();
                            scope->push(np);
                            ap = scope->atPtr(scope->count() - 1);
                        }
                        TomlValue elem = TomlValue::tableVal();
                        ap->value.arrVal.push(elem);
                        currentTable = &ap->value.arrVal.atPtr(ap->value.arrVal.count() - 1)->tableVal;
                    }
                    else
                    {
                        currentTable = tomlScopeFor(scope, seg);
                    }
                    break;
                }
                scope = tomlScopeFor(scope, seg);
                i = j + 1;
            }
            continue;
        }

        // key may be dotted: a.b.c = v
        String dotted = p.parseDottedKey();
        if (p.error) { dotted.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
        if (p.next() != '=') { dotted.free(); currentTableName.free(); p.fail("expected '='"); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
        TomlValue val = p.parseValue();
        if (p.error) { val.dispose(); dotted.free(); currentTableName.free(); doc.dispose(); return Result<TomlDoc, ParseError>::Err { .error = p.err() }; }
        p.skipLine();

        tomlInsertDotted(currentTable, dotted.asView(), val);
        dotted.free();
    }

    currentTableName.free();
    return Result<TomlDoc, ParseError>::Ok { .value = doc };
}

// drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of TomlValue through the drop trait.
pub extend TomlValue : drop
{
    void drop()
    {
        self.dispose();
    }
}

/// Enables automatic cleanup of TomlDoc through the drop trait.
pub extend TomlDoc : drop
{
    void drop()
    {
        self.dispose();
    }
}
