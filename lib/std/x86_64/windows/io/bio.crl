#[[no_drop_all]]
import(lib) platform::win32 { ReadFile, WriteFile, SetFilePointerA };
import(lib) std::result { Result };
import(lib) std::io::fs { File, IoError };

// POSIX whence values double as Win32 FILE_BEGIN/CURRENT (same numbers).
const i32 SEEK_SET = 0;
const i32 SEEK_CUR = 1;

// FLAG, fd is a Win32 HANDLE (rawptr), what fileOpen returns now.
/// A reader over an open file; reads typed little/big-endian values.
pub struct FileReader
{
    rawptr fd;

/// Wraps an existing File descriptor as a FileReader.
    static FileReader fromFd(File fd)
    {
        return FileReader { .fd = (rawptr)fd };
    }

    // reads exactly n bytes; Err on a read error (GetLastError) or an
    // EOF before n bytes. The typed readers below ignore the outcome
    // and yield 0-filled buffers — check readBytes when it matters.
/// Reads exactly `n` bytes into `dst`; Err on read error or early EOF.
    Result<bool, IoError> readBytes(u8* dst, u64 n)
    {
        u64 total = 0;
        while (total < n)
        {
            u64 remain = n - total;
            u32 want = remain > 0xFFFFFFFFu ? 0xFFFFFFFFu : (u32)remain;
            u32 got = 0;
            if (!ReadFile(self.fd, (cchar*)(dst + total), want, &got, null))
                return Result<bool, IoError>::Err { .error = IoError::os("ReadFile") };
            if (got == 0) return Result<bool, IoError>::Err { .error = IoError::Eof { .op = "read" } };
            total += (u64)got;
        }
        return Result<bool, IoError>::Ok { .value = true };
    }

    #[[inline]]
/// Reads one unsigned byte.
    u8 readU8() { u8 v = 0; self.readBytes(&v, 1); return v; }

/// Reads a little-endian u16.
    u16 readU16Le()
    {
        u8 b[2] = { 0, 0 };
        self.readBytes(b, 2);
        return (u16)b[0] | ((u16)b[1] << 8);
    }

/// Reads a little-endian u32.
    u32 readU32Le()
    {
        u8 b[4] = { 0, 0, 0, 0 };
        self.readBytes(b, 4);
        return (u32)b[0] | ((u32)b[1] << 8) | ((u32)b[2] << 16) | ((u32)b[3] << 24);
    }

/// Reads a little-endian u64.
    u64 readU64Le()
    {
        u8 b[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
        self.readBytes(b, 8);
        u64 v = 0;
        for (u32 j = 0; j < 8; j++)
            v |= (u64)b[j] << (8u * j);
        return v;
    }

    #[[inline]]
/// Reads a signed byte.
    i8 readI8() { return (i8)self.readU8(); }
    #[[inline]]
/// Reads a little-endian i16.
    i16 readI16Le() { return (i16)self.readU16Le(); }
    #[[inline]]
/// Reads a little-endian i32.
    i32 readI32Le() { return (i32)self.readU32Le(); }
    #[[inline]]
/// Reads a little-endian i64.
    i64 readI64Le() { return (i64)self.readU64Le(); }

/// Reads a big-endian u16.
    u16 readU16Be()
    {
        u8 b[2] = { 0, 0 };
        self.readBytes(b, 2);
        return ((u16)b[0] << 8) | (u16)b[1];
    }

/// Reads a big-endian u32.
    u32 readU32Be()
    {
        u8 b[4] = { 0, 0, 0, 0 };
        self.readBytes(b, 4);
        return ((u32)b[0] << 24) | ((u32)b[1] << 16) | ((u32)b[2] << 8) | (u32)b[3];
    }

/// Reads a big-endian u64.
    u64 readU64Be()
    {
        u8 b[8] = { 0, 0, 0, 0, 0, 0, 0, 0 };
        self.readBytes(b, 8);
        u64 v = 0;
        for (u32 j = 0; j < 8; j++)
            v |= (u64)b[j] << (8u * (7u - j));
        return v;
    }

    #[[inline]]
/// Reads a big-endian i16.
    i16 readI16Be() { return (i16)self.readU16Be(); }
    #[[inline]]
/// Reads a big-endian i32.
    i32 readI32Be() { return (i32)self.readU32Be(); }
    #[[inline]]
/// Reads a big-endian i64.
    i64 readI64Be() { return (i64)self.readU64Be(); }

    #[[inline]]
/// Reads a little-endian f32.
    f32 readF32Le() { u32 v = self.readU32Le(); return *(f32*)&v; }
    #[[inline]]
/// Reads a little-endian f64.
    f64 readF64Le() { u64 v = self.readU64Le(); return *(f64*)&v; }
    #[[inline]]
/// Reads a big-endian f32.
    f32 readF32Be() { u32 v = self.readU32Be(); return *(f32*)&v; }
    #[[inline]]
/// Reads a big-endian f64.
    f64 readF64Be() { u64 v = self.readU64Be(); return *(f64*)&v; }

    #[[inline]]
/// Advances the file offset by `n` bytes.
    void skip(u64 n)
    {
        // lseek -> SetFilePointerA; the result was ignored before,
        // still is.
        if (n <= 0x7FFFFFFFFFFFFFFFu)
        {
            i32 high = (i32)(n >> 32);
            SetFilePointerA(self.fd, (i32)(n & 0xFFFFFFFFu), &high, (u32)SEEK_CUR);
        }
    }
}

/// A writer over an open file; writes typed little/big-endian values.
pub struct FileWriter
{
    rawptr fd;

/// Wraps an existing File descriptor as a FileWriter.
    static FileWriter fromFd(File fd) { return FileWriter { .fd = (rawptr)fd }; }

    #[[inline]]
/// Writes one unsigned byte.
    void writeU8(u8 v) { self.writeBytes(&v, 1); }

    // writes exactly n bytes; Err on a write error (GetLastError) or a
    // zero-byte write. The typed writers below ignore the outcome.
/// Writes exactly `n` bytes from `src`; Err on write error or zero-byte write.
    Result<bool, IoError> writeBytes(const u8* src, u64 n)
    {
        u64 total = 0;
        while (total < n)
        {
            u64 remain = n - total;
            u32 want = remain > 0xFFFFFFFFu ? 0xFFFFFFFFu : (u32)remain;
            u32 put = 0;
            if (!WriteFile(self.fd, (const cchar*)(src + total), want, &put, null))
                return Result<bool, IoError>::Err { .error = IoError::os("WriteFile") };
            if (put == 0) return Result<bool, IoError>::Err { .error = IoError::Os { .code = 0, .op = "write" } };
            total += (u64)put;
        }
        return Result<bool, IoError>::Ok { .value = true };
    }

/// Writes a little-endian u16.
    void writeU16Le(u16 v)
    {
        u8 b[2];
        b[0] = (u8)v;
        b[1] = (u8)(v >> 8);
        self.writeBytes(b, 2);
    }

/// Writes a little-endian u32.
    void writeU32Le(u32 v)
    {
        u8 b[4];
        b[0] = (u8)v;
        b[1] = (u8)(v >> 8);
        b[2] = (u8)(v >> 16);
        b[3] = (u8)(v >> 24);
        self.writeBytes(b, 4);
    }

/// Writes a little-endian u64.
    void writeU64Le(u64 v)
    {
        u8 b[8];
        for (u32 j = 0; j < 8; j++)
            b[j] = (u8)(v >> (8u * j));
        self.writeBytes(b, 8);
    }

    #[[inline]]
/// Writes a signed byte.
    void writeI8(i8 v) { self.writeU8((u8)v); }
    #[[inline]]
/// Writes a little-endian i16.
    void writeI16Le(i16 v) { self.writeU16Le((u16)v); }
    #[[inline]]
/// Writes a little-endian i32.
    void writeI32Le(i32 v) { self.writeU32Le((u32)v); }
    #[[inline]]
/// Writes a little-endian i64.
    void writeI64Le(i64 v) { self.writeU64Le((u64)v); }

/// Writes a big-endian u16.
    void writeU16Be(u16 v)
    {
        u8 b[2];
        b[0] = (u8)(v >> 8);
        b[1] = (u8)v;
        self.writeBytes(b, 2);
    }

/// Writes a big-endian u32.
    void writeU32Be(u32 v)
    {
        u8 b[4];
        b[0] = (u8)(v >> 24);
        b[1] = (u8)(v >> 16);
        b[2] = (u8)(v >> 8);
        b[3] = (u8)v;
        self.writeBytes(b, 4);
    }

/// Writes a big-endian u64.
    void writeU64Be(u64 v)
    {
        u8 b[8];
        for (u32 j = 0; j < 8; j++)
            b[j] = (u8)(v >> (8u * (7u - j)));
        self.writeBytes(b, 8);
    }

/// Writes a big-endian i16.
    #[[inline]] void writeI16Be(i16 v) { self.writeU16Be((u16)v); }
/// Writes a big-endian i32.
    #[[inline]] void writeI32Be(i32 v) { self.writeU32Be((u32)v); }
/// Writes a big-endian i64.
    #[[inline]] void writeI64Be(i64 v) { self.writeU64Be((u64)v); }
    
/// Writes a little-endian f32.
    #[[inline]] void writeF32Le(f32 v) { self.writeU32Le(*(u32*)&v); }
/// Writes a little-endian f64.
    #[[inline]] void writeF64Le(f64 v) { self.writeU64Le(*(u64*)&v); }
/// Writes a big-endian f32.
    #[[inline]] void writeF32Be(f32 v) { self.writeU32Be(*(u32*)&v); }
/// Writes a big-endian f64.
    #[[inline]] void writeF64Be(f64 v) { self.writeU64Be(*(u64*)&v); }
}

#[[inline]]
/// Returns `v` with its two bytes reversed.
pub u16 bswapU16(u16 v) { return ((v >> 8) & 0x00FF) | ((v << 8) & 0xFF00); }

/// Returns `v` with its four bytes reversed.
pub u32 bswapU32(u32 v)
{
    return ((v >> 24) & 0x000000FF) | ((v >> 8) & 0x0000FF00) |
           ((v << 8) & 0x00FF0000) | ((v << 24) & 0xFF000000);
}

/// Returns `v` with its eight bytes reversed.
pub u64 bswapU64(u64 v)
{
    return ((v >> 56) & 0x00000000000000FF) | ((v >> 40) & 0x000000000000FF00) |
           ((v >> 24) & 0x0000000000FF0000) | ((v >> 8) & 0x00000000FF000000) |
           ((v << 8) & 0x000000FF00000000) | ((v << 24) & 0x0000FF0000000000) |
           ((v << 40) & 0x00FF000000000000) | ((v << 56) & 0xFF00000000000000);
}
