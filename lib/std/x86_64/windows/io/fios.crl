#[[no_drop_all]]
import(lib) platform::libc { fopen, fclose, fwrite, fread, feof, ferror, fflush };
import(lib) std::mman { copy };
import(lib) std::text::string { String };
import(lib) std::result { Result };
import(lib) std::io::fs { IoError };

// distinct wrapper over a FILE*, a bare rawptr can't be passed in its place
// by accident — callers have to cast it explicitly.
/// An opaque stdio FILE* stream; callers must cast explicitly.
pub distinct FileHandle = rawptr;

/// Opens `path` with stdio `mode` and returns a FileHandle or IoError.
pub Result<FileHandle, IoError> fileOpen(str path, str mode)
{
    u8 pathBuf[4096];
    u8 modeBuf[16];
    usize plen = path.len < 4095u ? path.len : 4095u;
    usize mlen = mode.len < 15 ? mode.len : 15u;
    copy<u8>(pathBuf, (u8*)path.ptr, plen);
    copy<u8>(modeBuf, (u8*)mode.ptr, mlen);
    pathBuf[plen] = 0;
    modeBuf[mlen] = 0;
    rawptr h = fopen(pathBuf, modeBuf);
    if (h == null) return Result<FileHandle, IoError>::Err { .error = IoError::os("fopen") };
    return Result<FileHandle, IoError>::Ok { .value = (FileHandle)h };
}

/// Closes a FileHandle.
 pub void fileClose(FileHandle fh) { fclose((rawptr)fh); }

// short write means the stream hit an error (errno was set by fwrite)
/// Writes all of `data` to `fh`; Err on a short write.
pub Result<usize, IoError> fileWrite(FileHandle fh, str data)
{
    usize n = fwrite(data.ptr, 1u, data.len, (rawptr)fh);
    if (n < data.len) return Result<usize, IoError>::Err { .error = IoError::os("fwrite") };
    return Result<usize, IoError>::Ok { .value = n };
}

// 0 at EOF is the normal answer; only a short read with ferror set is Err
/// Reads up to `maxLen` bytes into `buf`; 0 means EOF, Err on a read error.
pub Result<usize, IoError> fileRead(FileHandle fh, u8* buf, usize maxLen)
{
    usize n = fread(buf, 1u, maxLen, (rawptr)fh);
    if (n < maxLen && ferror((rawptr)fh) != 0)
        return Result<usize, IoError>::Err { .error = IoError::os("fread") };
    return Result<usize, IoError>::Ok { .value = n };
}

/// Returns true if the end-of-file indicator is set on `fh`.
 pub bool fileEof(FileHandle fh) { return feof((rawptr)fh) != 0; }
/// Returns true if the error indicator is set on `fh`.
 pub bool fileError(FileHandle fh) { return ferror((rawptr)fh) != 0; }
/// Flushes buffered output on `fh`.
 pub void fileFlush(FileHandle fh){ fflush((rawptr)fh); }

/// Writes all of `s` to `fh`; Err on a short write.
pub Result<usize, IoError> fileWriteString(FileHandle fh, const String* s)
{
    usize n = fwrite(s->ptr, 1u, s->len, (rawptr)fh);
    if (n < s->len) return Result<usize, IoError>::Err { .error = IoError::os("fwrite") };
    return Result<usize, IoError>::Ok { .value = n };
}

/// Reads the entire file at `path` into `out`; Err on failure.
pub Result<bool, IoError> fileReadAll(str path, String* out)
{
    Result<FileHandle, IoError> fo = fileOpen(path, "rb");
    if (fo.isErr()) return Result<bool, IoError>::Err { .error = fo.unwrapErr() };
    FileHandle fh = fo.unwrap();
    u8 chunk[4096];
    while (true)
    {
        Result<usize, IoError> rr = fileRead(fh, chunk, 4096u);
        if (rr.isErr())
        {
            fileClose(fh);
            return Result<bool, IoError>::Err { .error = rr.unwrapErr() };
        }
        usize n = rr.unwrap();
        if (n == 0u) break;
        out->pushView(str::fromParts(chunk, n));
    }
    fileClose(fh);
    return Result<bool, IoError>::Ok { .value = true };
}
