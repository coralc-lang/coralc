#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::mman { alloc, dealloc, zero };
import(lib) std::result { Result };
import(lib) std::io::fs { IoError };
import(lib) platform::win32 { ReadFile, WriteFile, CloseHandle, ExitProcess, WaitForSingleObject, CreatePipe, CreateProcessA, SetHandleInformation, GetExitCodeProcess, PeekNamedPipe, GetLastError };

// POSIX process model -> Win32, pipes + CreateProcessA.

const u32 INFINITE = 0xFFFFFFFF;         // winbase.h — wait forever (was waitpid's blocking wait)
const u32 WAIT_OBJECT_0 = 0;             // winbase.h — handle became signaled
const u32 STARTF_USESTDHANDLES = 0x100;  // winbase.h — honour hStdInput/Output/Error
const u32 HANDLE_FLAG_INHERIT = 1;       // winbase.h — make a handle inheritable

// SECURITY_ATTRIBUTES, 24B on x64, FLAGGED natural (C) alignment —
// nLength@0, lpSecurityDescriptor@8, bInheritHandle@16.
struct SECURITY_ATTRIBUTES
{
    u32 nLength;
    rawptr lpSecurityDescriptor;
    bool bInheritHandle;
    u32 pad;
}

// STARTUPINFOA, 104B on x64, opaque buffer + cast. Written fields only:
// cb@0, dwFlags@60, hStdInput@80, hStdOutput@88, hStdError@96.
// FLAG, cbReserved2 sits at 66 (pad at 68 keeps lpReserved2 8-aligned).
// this took a lot of time to figure out, offsets hand-checked against the sdk headers.
struct STARTUPINFOA
{
    u32 cb;              // 0
    u32 pad0;            // 4
    rawptr lpReserved;   // 8
    rawptr lpDesktop;    // 16
    rawptr lpTitle;      // 24
    u32 dwX;             // 32
    u32 dwY;             // 36
    u32 dwXSize;         // 40
    u32 dwYSize;         // 44
    u32 dwXCountChars;   // 48
    u32 dwYCountChars;   // 52
    u32 dwFillAttribute; // 56
    u32 dwFlags;         // 60
    u16 wShowWindow;     // 64
    u16 cbReserved2;     // 66
    u32 pad1;            // 68
    rawptr lpReserved2;  // 72
    rawptr hStdInput;    // 80
    rawptr hStdOutput;   // 88
    rawptr hStdError;    // 96
}                        // 104

// PROCESS_INFORMATION, 24B — hProcess@0, hThread@8, dwProcessId@16,
// dwThreadId@20.
struct PROCESS_INFORMATION
{
    rawptr hProcess;
    rawptr hThread;
    u32 dwProcessId;
    u32 dwThreadId;
}

/// A spawned child process with connected stdin/stdout/stderr pipes.
pub struct Process
{
    i32 pid;          // FLAG: now dwProcessId (kept i32 so `pid < 0` failure checks still read the same)
    rawptr hProcess;  // FLAG: new field — the process HANDLE waitFor waits on
    rawptr stdinFd;   // FLAG: i32 POSIX fd -> Win32 HANDLE (null = closed)
    rawptr stdoutFd;
    rawptr stderrFd;
}

/// Outcome of a finished process: exit code or terminating signal.
pub struct ProcessResult
{
    i32 exitCode;
    bool signaled;
    i32 termSignal;
}

// kept for API compatibility, unused — child waiting is PeekNamedPipe +
// WaitForSingleObject (see run/waitFor).
/// Poll descriptor: a file descriptor plus the events of interest.
pub struct pollfd
{
    i32 fd;
    i16 events;
    i16 revents;
}

void _closeIoFd(rawptr* h)
{
    if (*h != null) { CloseHandle(*h); *h = null; }
}

// Quote only when the token would otherwise change, empty, or holding a
// space/tab/quote. the cmd.exe rules are quite crap, this is what actually works.
bool _needsQuote(str s)
{
    if (s.len == 0) return true;
    for (usize i = 0; i < s.len; i++)
    {
        u8 c = (u8)s.ptr[i];
        if (c == ' ' || c == '\t' || c == '"') return true;
    }
    return false;
}

// Append one arg at `off`; CommandLineToArgvW rules, so the child's CRT
// splits the line back into argv. Worst case 2 bytes per input byte.
usize _appendArg(u8* buf, usize off, str a)
{
    if (!_needsQuote(a)) {
        for (usize i = 0; i < a.len; i++) buf[off + i] = (u8)a.ptr[i];
        return off + a.len;
    }
    buf[off] = '\"';
    off++;
    usize bs = 0;
    for (usize i = 0; i < a.len; i++)
    {
        u8 c = (u8)a.ptr[i];
        if (c == '\\') { bs++; continue; }
        if (c == '"') {
            for (usize j = 0; j < bs * 2 + 1; j++) buf[off++] = '\\';
            buf[off++] = '\"';
            bs = 0;
            continue;
        }
        for (usize j = 0; j < bs; j++) buf[off++] = '\\';
        bs = 0;
        buf[off++] = c;
    }
    for (usize j = 0; j < bs * 2; j++) buf[off++] = '\\';
    buf[off] = '\"';
    off++;
    return off;
}

// One drain step (was poll), 1 = read bytes, 0 = nothing ready,
// -1 = pipe broken or read error.
i32 _drainPipe(rawptr h, u8* buf, usize cap)
{
    u32 avail = 0;
    if (!PeekNamedPipe(h, null, 0, null, &avail, null)) return -1;
    if (avail == 0) return 0;
    u32 want = avail < (u32)cap ? avail : (u32)cap;
    u32 n = 0;
    if (!ReadFile(h, (cchar*)buf, want, &n, null)) return -1;
    if (n == 0) return -1;
    return 1;
}

// fork+dup2+execvp -> one CreateProcessA, three pipes, child ends
// inheritable into STARTUPINFOA's std handles.
/// Spawn `cmd` with `args`, connected through stdin/stdout/stderr pipes.
pub Result<Process, IoError> spawn(str cmd, Vec<str>* args)
{
    rawptr stdinRead = null;
    rawptr stdinWrite = null;
    rawptr stdoutRead = null;
    rawptr stdoutWrite = null;
    rawptr stderrRead = null;
    rawptr stderrWrite = null;

    SECURITY_ATTRIBUTES sa = SECURITY_ATTRIBUTES {
        .nLength = (u32)@sizeof(SECURITY_ATTRIBUTES), // 24 (FLAG)
        .lpSecurityDescriptor = null,
        .bInheritHandle = true,
        .pad = 0
    };

    if (!CreatePipe(&stdinRead, &stdinWrite, (rawptr)&sa, 0) ||
        !CreatePipe(&stdoutRead, &stdoutWrite, (rawptr)&sa, 0) ||
        !CreatePipe(&stderrRead, &stderrWrite, (rawptr)&sa, 0))
    {
        // capture before CloseHandle overwrites the last-error slot
        u32 code = GetLastError();
        if (stdinRead != null) CloseHandle(stdinRead);
        if (stdinWrite != null) CloseHandle(stdinWrite);
        if (stdoutRead != null) CloseHandle(stdoutRead);
        if (stdoutWrite != null) CloseHandle(stdoutWrite);
        if (stderrRead != null) CloseHandle(stderrRead);
        if (stderrWrite != null) CloseHandle(stderrWrite);
        return Result<Process, IoError>::Err { .error = IoError::Os { .code = (i32)code, .op = "CreatePipe" } };
    }

    // CreatePipe marks both ends inheritable — clear HANDLE_FLAG_INHERIT
    // on the parent's, or the child gets them too and stdout never EOFs.
    if (!SetHandleInformation(stdinWrite, HANDLE_FLAG_INHERIT, 0) ||
        !SetHandleInformation(stdoutRead, HANDLE_FLAG_INHERIT, 0) ||
        !SetHandleInformation(stderrRead, HANDLE_FLAG_INHERIT, 0))
    {
        u32 code = GetLastError();
        CloseHandle(stdinRead); CloseHandle(stdinWrite);
        CloseHandle(stdoutRead); CloseHandle(stdoutWrite);
        CloseHandle(stderrRead); CloseHandle(stderrWrite);
        return Result<Process, IoError>::Err { .error = IoError::Os { .code = (i32)code, .op = "SetHandleInformation" } };
    }

    // execvp(program, argv) -> lpApplicationName + a command line built
    // here (quoted per _appendArg); argv[0] passes through. Capacity 2x
    // input + quotes + NUL; the old 4095-per-arg cap is gone (32767 max).
    usize n = args != null ? args->count() : 0;
    usize cap = 1;
    for (usize i = 0; i < n; i++) cap += args->at(i).len * 2 + 3;
    u8* line = alloc<u8>(cap);
    usize off = 0;
    for (usize i = 0; i < n; i++)
    {
        if (i > 0) { line[off] = ' '; off++; }
        off = _appendArg(line, off, args->at(i));
    }
    line[off] = 0;

    // STARTUPINFOA through an opaque 104B buffer; only the fields
    // documented above get written.
    u8 siBuf[104];
    zero<u8>(siBuf, 104);
    STARTUPINFOA* si = (STARTUPINFOA*)siBuf;
    si->cb = (u32)@sizeof(STARTUPINFOA);          // 104 (FLAG offsets)
    si->dwFlags = STARTF_USESTDHANDLES;          // 0x100 — honour hStd* below
    si->hStdInput = stdinRead;                   // child's stdin  <- pipe read end
    si->hStdOutput = stdoutWrite;                // child's stdout -> pipe write end
    si->hStdError = stderrWrite;                 // child's stderr -> pipe write end

    PROCESS_INFORMATION pi = PROCESS_INFORMATION {
        .hProcess = null,
        .hThread = null,
        .dwProcessId = 0,
        .dwThreadId = 0
    };

    // cmd.ptr must be NUL-terminated (same as old execvp(cmd.ptr, ...)).
    // No args -> null line, derived from lpApplicationName.
    bool ok = CreateProcessA((const cchar*)cmd.ptr, n > 0 ? (cchar*)line : null,
        null, null, true, 0, null, null, (rawptr)si, (rawptr)&pi);
    dealloc<u8>(line);

    if (!ok)
    {
        u32 code = GetLastError();
        CloseHandle(stdinRead); CloseHandle(stdinWrite);
        CloseHandle(stdoutRead); CloseHandle(stdoutWrite);
        CloseHandle(stderrRead); CloseHandle(stderrWrite);
        return Result<Process, IoError>::Err { .error = IoError::Os { .code = (i32)code, .op = "CreateProcessA" } };
    }

    // the child keeps its own inherited copies of the child ends; the
    // parent needs only hProcess.
    CloseHandle(stdinRead);
    CloseHandle(stdoutWrite);
    CloseHandle(stderrWrite);
    CloseHandle(pi.hThread);

    return Result<Process, IoError>::Ok {
        .value = Process {
            .pid = (i32)pi.dwProcessId,
            .hProcess = pi.hProcess,
            .stdinFd = stdinWrite,
            .stdoutFd = stdoutRead,
            .stderrFd = stderrRead
        }
    };
}

/// Wait for the child to exit, close its pipes, and return the result.
pub Result<ProcessResult, IoError> waitFor(Process* p)
{
    if (p->hProcess == null) {
        // already waited (or spawn never produced a handle) — like
        // waitpid's ECHILD on a reaped pid, but with no errno to give.
        return Result<ProcessResult, IoError>::Err { .error = IoError::BadUsage { .msg = "process already waited" } };
    }
    // waitpid -> WaitForSingleObject(INFINITE) + GetExitCodeProcess.
    u32 wr = WaitForSingleObject(p->hProcess, INFINITE);
    if (wr != WAIT_OBJECT_0) {
        return Result<ProcessResult, IoError>::Err { .error = IoError::Os { .code = (i32)GetLastError(), .op = "WaitForSingleObject" } };
    }
    u32 code = 0;
    bool got = GetExitCodeProcess(p->hProcess, &code);
    // capture before the CloseHandle calls below overwrite the slot
    u32 errCode = GetLastError();
    _closeIoFd(&p->stdinFd);
    _closeIoFd(&p->stdoutFd);
    _closeIoFd(&p->stderrFd);
    // close after waiting — a second waitFor then sees null, like a
    // reaped pid.
    CloseHandle(p->hProcess);
    p->hProcess = null;
    if (!got)
    {
        return Result<ProcessResult, IoError>::Err { .error = IoError::Os { .code = (i32)errCode, .op = "GetExitCodeProcess" } };
    }
    // FLAG, no wait-status word on Win32 — signaled/termSignal stay 0,
    // the raw exit code carries everything.
    return Result<ProcessResult, IoError>::Ok { .value = ProcessResult { .exitCode = (i32)code, .signaled = false, .termSignal = 0 } };
}

/// Write `len` bytes to the child's stdin.
pub Result<isize, IoError> writeStdin(Process* p, const cchar* data, usize len)
{
    if (p->stdinFd == null) return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "pipe closed" } };
    u32 written = 0;
    if (!WriteFile(p->stdinFd, data, (u32)len, &written, null))
        return Result<isize, IoError>::Err { .error = IoError::os("WriteFile") };
    return Result<isize, IoError>::Ok { .value = (isize)written };
}

/// Read up to `maxLen` bytes from the child's stdout.
pub Result<isize, IoError> readStdout(Process* p, u8* buf, usize maxLen)
{
    if (p->stdoutFd == null) return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "pipe closed" } };
    u32 n = 0;
    if (!ReadFile(p->stdoutFd, (cchar*)buf, (u32)maxLen, &n, null))
        return Result<isize, IoError>::Err { .error = IoError::os("ReadFile") };
    return Result<isize, IoError>::Ok { .value = (isize)n };
}

/// Read up to `maxLen` bytes from the child's stderr.
pub Result<isize, IoError> readStderr(Process* p, u8* buf, usize maxLen)
{
    if (p->stderrFd == null) return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "pipe closed" } };
    u32 n = 0;
    if (!ReadFile(p->stderrFd, (cchar*)buf, (u32)maxLen, &n, null))
        return Result<isize, IoError>::Err { .error = IoError::os("ReadFile") };
    return Result<isize, IoError>::Ok { .value = (isize)n };
}

/// Run `cmd` to completion, draining its output, and return its exit code.
pub Result<i32, IoError> run(str cmd, Vec<str>* args)
{
    Result<Process, IoError> sr = spawn(cmd, args);
    if (sr.isErr()) return Result<i32, IoError>::Err { .error = sr.unwrapErr() };
    Process p = sr.unwrap();
    _closeIoFd(&p.stdinFd);
    // the old poll() loop, ported, neither pipe waited on while the
    // other fills. PeekNamedPipe = poll, wait(0) = child exit, remainder
    // read until the pipe breaks, idle sleeps 1ms on the process handle
    // instead of spinning.
    u8 buf[4096];
    while (p.stdoutFd != null || p.stderrFd != null)
    {
        bool exited = WaitForSingleObject(p.hProcess, 0) == WAIT_OBJECT_0;
        bool gotData = false;
        if (p.stdoutFd != null)
        {
            i32 r = _drainPipe(p.stdoutFd, buf, 4096);
            // child gone, nothing buffered — don't wait on a pipe nobody
            // will write again.
            if (r < 0 || (r == 0 && exited)) _closeIoFd(&p.stdoutFd);
            else if (r > 0) gotData = true;
        }
        if (p.stderrFd != null)
        {
            i32 r = _drainPipe(p.stderrFd, buf, 4096);
            if (r < 0 || (r == 0 && exited)) _closeIoFd(&p.stderrFd);
            else if (r > 0) gotData = true;
        }
        if (!gotData && !exited) WaitForSingleObject(p.hProcess, 1);
    }
    Result<ProcessResult, IoError> wr = waitFor(&p);
    if (wr.isErr()) return Result<i32, IoError>::Err { .error = wr.unwrapErr() };
    return Result<i32, IoError>::Ok { .value = wr.unwrap().exitCode };
}

/// Terminate the current process with `code`.
pub void exit(i32 code)
{
    // _exit -> ExitProcess (the self-TerminateProcess variant would cost
    // two externs for the same effect).
    ExitProcess((u32)code);
}
