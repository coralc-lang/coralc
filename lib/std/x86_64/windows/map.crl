#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };
import(lib) std::option { Option };
import(lib) std::result { Result };

/// Error raised by map insertion when a node cannot be allocated.
pub variant CollectionError
{
    AllocFailed { str msg; }
}

/// An AVL tree node holding one key/value pair and balance metadata.
pub struct MapEntry<K, V>
{
    K key;
    V value;
    i32 height;
    MapEntry<K, V>* left;
    MapEntry<K, V>* right;
}

/// Ordered map implemented as a self-balancing AVL tree; keys are ordered by cmpFn.
pub struct Map<K, V>
{
    MapEntry<K, V>* root;
    usize len;
    i32(K, K) cmpFn;
    bool failed; // set by _insert when a node allocation fails

/// Creates an empty map that orders keys with cmp.
    static Map<K, V> new(i32(K, K) cmp)
    {
        return Map<K, V> {
            .root = null,
            .len = 0,
            .cmpFn = cmp,
            .failed = false
        };
    }

/// Frees every node and resets the map.
    void dispose()
    {
        self._disposeNode(self.root);
        self.root = null;
        self.len = 0;
    }

/// Returns the number of stored entries.
    usize count()
    {
        return self.len;
    }

/// Returns true when the map holds no entries.
    bool isEmpty()
    {
        return self.len == 0;
    }

    // On AllocFailed the tree keeps its previous contents (no node is added).
/// Inserts or updates key and returns its value; on allocation failure the tree is unchanged.
    Result<V, CollectionError> insert(K key, V value)
    {
        self.failed = false;
        self.root = self._insert(self.root, key, value);
        if (self.failed)
            return Result<V, CollectionError>::Err { .error = CollectionError::AllocFailed { .msg = "Map node allocation failed" } };
        return Result<V, CollectionError>::Ok { .value = value };
    }

/// Returns the value for key, or None when absent.
    Option<V> get(K key)
    {
        MapEntry<K, V>* n = self._find(self.root, key);
        if (n != null) return Option<V>::Some { .value = n->value };
        return Option<V>::None;
    }

/// Returns a pointer to the value for key, or None when absent.
    Option<V*> getPtr(K key)
    {
        MapEntry<K, V>* n = self._find(self.root, key);
        if (n != null) return Option<V*>::Some { .value = &n->value };
        return Option<V*>::None;
    }

/// Returns true when key is present.
    bool contains(K key)
    {
        return self._find(self.root, key) != null;
    }

/// Removes the entry for key, if any.
    void remove(K key)
    {
        self.root = self._remove(self.root, key);
    }

/// Removes every entry and frees its nodes.
    void clear()
    {
        self._disposeNode(self.root);
        self.root = null;
        self.len = 0;
    }

/// Calls fn for every key/value pair in ascending key order.
    void each(void(K, V) fn)
    {
        self._eachInOrder(self.root, fn);
    }

    i32 _max(i32 a, i32 b)
    {
        if (a > b) return a;
        return b;
    }

    i32 _height(MapEntry<K, V>* n)
    {
        if (n == null) return -1;
        return n->height;
    }

    i32 _balance(MapEntry<K, V>* n)
    {
        if (n == null) return 0;
        return self._height(n->left) - self._height(n->right);
    }

    MapEntry<K, V>* _rotateRight(MapEntry<K, V>* y)
    {
        MapEntry<K, V>* x = y->left;
        MapEntry<K, V>* t2 = x->right;
        x->right = y;
        y->left = t2;
        y->height = 1 + self._max(self._height(y->left), self._height(y->right));
        x->height = 1 + self._max(self._height(x->left), self._height(x->right));
        return x;
    }

    MapEntry<K, V>* _rotateLeft(MapEntry<K, V>* x)
    {
        MapEntry<K, V>* y = x->right;
        MapEntry<K, V>* t2 = y->left;
        y->left = x;
        x->right = t2;
        x->height = 1 + self._max(self._height(x->left), self._height(x->right));
        y->height = 1 + self._max(self._height(y->left), self._height(y->right));
        return y;
    }

    MapEntry<K, V>* _insert(MapEntry<K, V>* n, K key, V value)
    {
        if (n == null)
        {
            MapEntry<K, V>* newNode = alloc<MapEntry<K, V>>(1);
            if (newNode == null)
            {
                self.failed = true;
                return null;
            }
            newNode->key = key;
            newNode->value = value;
            newNode->height = 0;
            newNode->left = null;
            newNode->right = null;
            self.len++;
            return newNode;
        }
        i32 c = self.cmpFn(key, n->key);
        if (c < 0)
            n->left = self._insert(n->left, key, value);
        else if (c > 0)
            n->right = self._insert(n->right, key, value);
        else
        {
            n->value = value;
            return n;
        }
        n->height = 1 + self._max(self._height(n->left), self._height(n->right));
        i32 bal = self._balance(n);
        if (bal > 1 && self.cmpFn(key, n->left->key) < 0)
            return self._rotateRight(n);
        if (bal < -1 && self.cmpFn(key, n->right->key) > 0)
            return self._rotateLeft(n);
        if (bal > 1 && self.cmpFn(key, n->left->key) > 0)
        {
            n->left = self._rotateLeft(n->left);
            return self._rotateRight(n);
        }
        if (bal < -1 && self.cmpFn(key, n->right->key) < 0)
        {
            n->right = self._rotateRight(n->right);
            return self._rotateLeft(n);
        }
        return n;
    }

    MapEntry<K, V>* _findMin(MapEntry<K, V>* n)
    {
        MapEntry<K, V>* cur = n;
        while (cur->left != null) cur = cur->left;
        return cur;
    }

    MapEntry<K, V>* _remove(MapEntry<K, V>* n, K key)
    {
        if (n == null) return null;
        i32 c = self.cmpFn(key, n->key);
        if (c < 0)
            n->left = self._remove(n->left, key);
        else if (c > 0)
            n->right = self._remove(n->right, key);
        else
        {
            if (n->left == null || n->right == null) {
                self.len--;
                MapEntry<K, V>* child = n->left != null ? n->left : n->right;
                dealloc<MapEntry<K, V>>(n);
                return child;
            }
            else {
                MapEntry<K, V>* succ = self._findMin(n->right);
                n->key = succ->key;
                n->value = succ->value;
                n->right = self._remove(n->right, succ->key);
            }
        }
        n->height = 1 + self._max(self._height(n->left), self._height(n->right));
        i32 bal = self._balance(n);
        if (bal > 1 && self._balance(n->left) >= 0)
            return self._rotateRight(n);
        if (bal > 1 && self._balance(n->left) < 0)
        {
            n->left = self._rotateLeft(n->left);
            return self._rotateRight(n);
        }
        if (bal < -1 && self._balance(n->right) <= 0)
            return self._rotateLeft(n);
        if (bal < -1 && self._balance(n->right) > 0)
        {
            n->right = self._rotateRight(n->right);
            return self._rotateLeft(n);
        }
        return n;
    }

    MapEntry<K, V>* _find(MapEntry<K, V>* n, K key)
    {
        while (n != null)
        {
            i32 c = self.cmpFn(key, n->key);
            if (c == 0) return n;
            if (c < 0) n = n->left;
            else n = n->right;
        }
        return null;
    }

    void _eachInOrder(MapEntry<K, V>* n, void(K, V) fn)
    {
        if (n == null) return;
        self._eachInOrder(n->left, fn);
        fn(n->key, n->value);
        self._eachInOrder(n->right, fn);
    }

    void _disposeNode(MapEntry<K, V>* n)
    {
        if (n == null) return;
        self._disposeNode(n->left);
        self._disposeNode(n->right);
        dealloc<MapEntry<K, V>>(n);
    }
}

/// Implements @drop by freeing every node.
pub extend<K, V> Map<K, V> : @drop
{
    
    void drop() { self.dispose(); }
}
