#[[no_drop_all]]
// Win32 port, pthread_rwlock_* -> SRWLOCK.
import(lib) platform::win32 { InitializeSRWLock, AcquireSRWLockExclusive, ReleaseSRWLockExclusive, AcquireSRWLockShared, ReleaseSRWLockShared, TryAcquireSRWLockExclusive, TryAcquireSRWLockShared };

// FLAG, TryAcquireSRWLock* is Win7+ (Kernel32); it gives exact pthread
// try* semantics — do not degrade it to always-succeed.

/// Reader/writer lock; many readers or one writer.
pub struct RwLock
{
    // SRWLOCK is 8B on x64 (a single PVOID) — FLAGGED; impl[1] keeps the
    // address, like the old impl[8] buffer.
    rawptr[1] impl;
    // FLAG (added state), pthread unlock doesn't tell reader from writer,
    // but Win32 needs the matching Release — the holder records its mode.
    bool _exclusive;
    // wasn't sure this era scheme was sound at first, but it holds up

    /// Initialize the lock.
    void init()
    {
        InitializeSRWLock(self.impl);
        self._exclusive = false;
    }
    /// Destroy the lock; must be unlocked.
    void destroy()
    {
        // no-op, SRWLOCK needs no destruction (pthread_rwlock_destroy).
    }
    /// Acquire a shared read lock, blocking while a writer holds it.
    void readLock()
    {
        AcquireSRWLockShared(self.impl);
        self._exclusive = false;
    }
   
    /// Acquire an exclusive write lock, blocking for readers and writers.
    void writeLock()
    {
        AcquireSRWLockExclusive(self.impl);
        self._exclusive = true;
    }
   
    /// Try to acquire a read lock without blocking; true on success.
    bool tryReadLock()
    {
        if (!TryAcquireSRWLockShared(self.impl)) return false;
        self._exclusive = false;
        return true;
    }
   
    /// Try to acquire a write lock without blocking; true on success.
    bool tryWriteLock()
    {
        if (!TryAcquireSRWLockExclusive(self.impl)) return false;
        self._exclusive = true;
        return true;
    }
   
    /// Release the read or write lock held by the calling thread.
    void unlock()
    {
        if (self._exclusive) ReleaseSRWLockExclusive(self.impl);
        else ReleaseSRWLockShared(self.impl);
    }
}
