#[[no_drop_all]]
// std::time -- wall-clock and monotonic time.
//
// Ported from the old std/core/time module. The Windows port uses the
// Win32 intrinsics: QueryPerformanceCounter for the monotonic clock and
// GetSystemTimeAsFileTime for wall-clock, with Sleep for delays. The
// public surface matches std::time on Linux exactly, call for call.

import(lib) platform::win32 { QueryPerformanceCounter, QueryPerformanceFrequency, GetSystemTimeAsFileTime, Sleep };
import(lib) platform::libc { snprintf };
import(lib) std::string { String };

const i32 CLOCK_REALTIME = 0;
const i32 CLOCK_MONOTONIC = 1;

// FILETIME counts 100ns ticks from 1601-01-01; the Unix epoch is
// 11644473600 seconds later.
const u64 EPOCH_DIFF_100NS = 116444736000000000;
const u64 TICKS_PER_SEC = 10000000;

/// A time span in whole seconds and nanoseconds.
pub struct Timespec
{
    i64 sec;
    i64 nsec;
}

/// A time span in whole seconds and microseconds.
pub struct Timeval
{
    i64 sec;
    i64 usec;
}

i64 _qpcFrequency()
{
    i64 f = 0;
    QueryPerformanceFrequency(&f);
    if (f <= 0) f = 1;
    return f;
}

/// Reads the monotonic clock, which never moves backwards.
pub Timespec nowMonotonic()
{
    i64 counter = 0;
    QueryPerformanceCounter(&counter);
    f64 seconds = (f64)counter / (f64)_qpcFrequency();
    Timespec ts;
    ts.sec = (i64)seconds;
    ts.nsec = (i64)((seconds - (f64)ts.sec) * 1e9);
    return ts;
}

/// Reads the wall clock (Unix epoch time).
pub Timespec nowRealtime()
{
    u64 ft = 0;
    GetSystemTimeAsFileTime(&ft);
    u64 ticks = ft - EPOCH_DIFF_100NS;
    Timespec ts;
    ts.sec = (i64)(ticks / TICKS_PER_SEC);
    ts.nsec = (i64)((ticks % TICKS_PER_SEC) * 100u);
    return ts;
}

/// Reads the wall clock as seconds and microseconds.
pub Timeval nowTimeval()
{
    Timespec ts = nowRealtime();
    Timeval tv;
    tv.sec = ts.sec;
    tv.usec = ts.nsec / 1000;
    return tv;
}

/// Returns the current wall-clock time as whole seconds since the Unix epoch.
pub u64 unixSeconds()
{
    return (u64)nowRealtime().sec;
}

/// Adds two timespecs, carrying whole nanoseconds into seconds.
pub Timespec addTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec + b.sec;
    r.nsec = a.nsec + b.nsec;
    if (r.nsec >= 1000000000)
    {
        r.nsec -= 1000000000;
        r.sec += 1;
    }
    return r;
}

/// Subtracts b from a, borrowing a second when nanoseconds go negative.
pub Timespec subTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec - b.sec;
    r.nsec = a.nsec - b.nsec;
    if (r.nsec < 0)
    {
        r.nsec += 1000000000;
        r.sec -= 1;
    }
    return r;
}

/// Converts a timespec to seconds as an f64.
pub f64 timespecToF64(Timespec ts)
{
    return (f64)ts.sec + (f64)ts.nsec * 1e-9;
}

/// Converts a timeval to seconds as an f64.
pub f64 timevalToF64(Timeval tv)
{
    return (f64)tv.sec + (f64)tv.usec * 1e-6;
}

/// Suspends the calling thread for the given duration.
pub void sleepTimespec(Timespec ts)
{
    i64 totalMs = ts.sec * 1000 + ts.nsec / 1000000;
    if (totalMs <= 0)
    {
        Sleep(0);
        return;
    }
    Sleep((u32)totalMs);
}

/// Suspends the calling thread for the given number of milliseconds.
pub void sleepMs(u64 ms)
{
    Sleep((u32)ms);
}

pub extend Timespec : @toStr
{
    str toStr()
    {
        u8[64] buf;
        i32 len = snprintf(buf, 64u, C"%lld.%09llds", self.sec, self.nsec);
        if (len < 0) len = 0;
        if (len > 63) len = 63;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Timeval : @toStr
{
    str toStr()
    {
        u8[64] buf;
        i32 len = snprintf(buf, 64u, C"%lld.%06llds", self.sec, self.usec);
        if (len < 0) len = 0;
        if (len > 63) len = 63;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}