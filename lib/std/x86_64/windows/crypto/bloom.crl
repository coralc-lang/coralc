#[[no_drop_all]]
import(lib) std::vec { Vec };

/// Probabilistic set with a tunable number of bits and hash functions.
pub struct Bloom
{
    Vec<u64> bits;
    usize numBits;
    usize numHashes;

    /// Creates a filter with numBits bits and numHashes hash functions.
    static Bloom new(usize numBits, usize numHashes)
    {
        if (numBits == 0) numBits = 1;
        usize words = (numBits + 63) / 64;
        Vec<u64> bits = Vec<u64>::withCap(words > 0 ? words : 1);
        for (usize i = 0; i < words; i++) bits.push(0u);
        return Bloom { .bits = bits, .numBits = numBits, .numHashes = numHashes };
    }

    /// Releases the filter's backing storage.
    #[[inline]]
    void dispose() { self.bits.dispose(); }

    u64 _hash(str data, u64 seed)
    {
        u64 h = seed;
        for (usize i = 0; i < data.len; i++)
        {
            h ^= (u64)data.ptr[i];
            h *= 0x9E3779B97F4A7C15;
            h ^= h >> 31;
        }
        return h;
    }

    /// Inserts data into the filter.
    void insert(str data, usize len)
    {
        for (usize i = 0; i < self.numHashes; i++)
        {
            u64 h = self._hash(data, i * 0x9E3779B9);
            u64 bit = h % self.numBits;
            u64 word = bit / 64;
            u64 off = bit % 64;
            *self.bits.atPtr(word) |= (1u << off);
        }
    }

    /// Returns true when data may be in the set; false means it is definitely absent.
    bool contains(str data)
    {
        for (usize i = 0; i < self.numHashes; i++)
        {
            u64 h = self._hash(data, i * 0x9E3779B9);
            u64 bit = h % self.numBits;
            u64 word = bit / 64;
            u64 off = bit % 64;
            if ((self.bits.at(word) & (1u << off)) == 0) return false;
        }
        return true;
    }

    /// Removes every element from the filter.
    void clear()
    {
        for (usize i = 0; i < self.bits.count(); i++)
            *self.bits.atPtr(i) = 0;
    }

    /// Returns the number of bits currently set.
    usize bitsCount()
    {
        u64 total = 0;
        for (usize i = 0; i < self.bits.count(); i++)
        {
            u64 v = self.bits.at(i);
            while (v != 0) { total++; v &= v - 1; }
        }
        return total;
    }
}
