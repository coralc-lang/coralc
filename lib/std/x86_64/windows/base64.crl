#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };
import(lib) std::string { String };

const u8* _TABLE = C"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";

/// Encodes srcLen bytes from src as base64 into dst, returning the number of bytes written.
pub usize encodeB64(const u8* src, usize srcLen, u8* dst, usize dstCap)
{
    usize pos = 0;
    usize i = 0;
    while (i < srcLen && pos + 4 <= dstCap)
    {
        u32 b = (u32)src[i] << 16;
        if (i + 1 < srcLen) b |= (u32)src[i + 1] << 8;
        if (i + 2 < srcLen) b |= (u32)src[i + 2];
        usize remaining = srcLen - i;
        i += 3;
        u8 c0 = _TABLE[(b >> 18) & 0x3F];
        u8 c1 = _TABLE[(b >> 12) & 0x3F];
        u8 c2 = remaining >= 2 ? _TABLE[(b >> 6) & 0x3F] : (u8)'=';
        u8 c3 = remaining >= 3 ? _TABLE[b & 0x3F] : (u8)'=';
        dst[pos++] = c0; dst[pos++] = c1; dst[pos++] = c2; dst[pos++] = c3;
    }
    return pos;
}

/// Encodes srcLen bytes from src as base64 and returns the result as a String.
pub String encodeToString(const u8* src, usize srcLen)
{
    usize cap = ((srcLen + 2) / 3) * 4;
    u8* buf = alloc<u8>(cap);
    usize n = encodeB64(src, srcLen, buf, cap);
    String s = String::from(str::fromParts((const u8*)buf, n));
    dealloc<u8>(buf);
    return s;
}

i32 _b64Val(u8 c)
{
    if (c >= 'A' && c <= 'Z') return (i32)(c - 'A');
    if (c >= 'a' && c <= 'z') return (i32)(c - 'a' + 26);
    if (c >= '0' && c <= '9') return (i32)(c - '0' + 52);
    if (c == '+') return 62;
    if (c == '/') return 63;
    return -1;
}

/// Decodes base64 from src into dst, returning the number of bytes written, or 0 on invalid input.
pub usize decode(str src, u8* dst, usize dstCap)
{
    usize pos = 0;
    usize i = 0;
    while (i < src.len)
    {
        u32 b = 0;
        usize n = 0;
        while (n < 4 && i < src.len)
        {
            u8 c = (u8)src.ptr[i];
            if (c == '=') break;
            i32 val = _b64Val(c);
            if (val < 0) return 0;
            b = (b << 6) | (u32)val;
            i++;
            n++;
        }
        if (n == 0) break;
        if (n == 1) return 0;
        if (n == 2)
        {
            if (pos + 1 > dstCap) break;
            dst[pos++] = (u8)(b >> 4);
        }
        else if (n == 3)
        {
            if (pos + 2 > dstCap) break;
            dst[pos++] = (u8)(b >> 10);
            dst[pos++] = (u8)(b >> 2);
        }
        else
        {
            if (pos + 3 > dstCap) break;
            dst[pos++] = (u8)(b >> 16);
            dst[pos++] = (u8)(b >> 8);
            dst[pos++] = (u8)b;
        }
        if (i < src.len && src.ptr[i] == '=') break;
    }
    return pos;
}
