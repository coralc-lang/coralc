#[[no_drop_all]]
import mman { alloc, dealloc };

struct RefCount
{
    usize count;
}

/// Reference-counted shared pointer to a single T.
pub struct SharedPtr<T>
{
    T* ptr;
    RefCount* rc;

    // true — the pointee and refcount were allocated and the SharedPtr holds
    // value; false — an allocation failed and the SharedPtr is left empty
    // (isValid() false, dispose() a no-op), nothing is dereferenced.
    /// Allocate and take a shared reference to value; false on OOM.
    bool init(T value)
    {
        self.ptr = alloc<T>(1);
        self.rc = alloc<RefCount>(1);
        if (self.ptr == null || self.rc == null)
        {
            if (self.ptr != null) { dealloc<T>(self.ptr); }
            if (self.rc != null) { dealloc<RefCount>(self.rc); }
            self.ptr = null;
            self.rc = null;
            return false;
        }
        *self.ptr = value;
        self.rc.count = 1;
        return true;
    }

    /// Drop this reference, freeing the pointee when the count reaches zero.
    void dispose()
    {
        if (self.rc == null) return;
        self.rc.count--;
        if (self.rc.count == 0)
        {
            dealloc<T>(self.ptr);
            dealloc<RefCount>(self.rc);
        }
        self.ptr = null;
        self.rc = null;
    }

    /// Return a copy of the pointee; asserts the pointer is valid.
    T get()
    {
        @assert(self.ptr != null);
        return *self.ptr;
    }

    /// Raw pointer to the pointee, or null when empty.
    T* data()
    {
        return self.ptr;
    }

    /// Const raw pointer to the pointee, or null when empty.
    const T* constData()
    {
        return self.ptr;
    }

    /// Current reference count, or 0 when empty.
    usize refCount()
    {
        if (self.rc == null) return 0;
        return self.rc.count;
    }

    /// True when the pointer owns a live pointee.
    bool isValid()
    {
        return self.ptr != null;
    }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Drops this reference when the shared pointer goes out of scope.
pub extend<T> SharedPtr<T> : @drop
{
    void drop()
    {
        self.dispose();
    }
}
