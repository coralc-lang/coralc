#[[no_drop_all]]
import mman { alloc, dealloc };

/// Owning pointer to a single heap-allocated T.
pub struct SmartPtr<T>
{
    T* ptr;

    // true — the pointee was allocated and holds value; false — allocation
    // failed and the SmartPtr is left empty (isValid() false), nothing is
    // dereferenced. Callers that care about the failure check isValid().
    /// Allocate and store value; false on OOM leaves the pointer empty.
    bool init(T value)
    {
        self.ptr = alloc<T>(1);
        if (self.ptr == null) return false;
        *self.ptr = value;
        return true;
    }

    /// Free the pointee and leave the pointer empty.
    void dispose()
    {
        if (self.ptr != null)
        {
            dealloc<T>(self.ptr);
            self.ptr = null;
        }
    }

    /// Return a copy of the pointee; asserts the pointer is valid.
    T get(const self*)
    {
        @assert(self.ptr != null);
        return *self.ptr;
    }

    /// Raw pointer to the pointee, or null when empty.
    T* data()
    {
        return self.ptr;
    }

    /// Const raw pointer to the pointee, or null when empty.
    const T* constData(const self*)
    {
        return self.ptr;
    }

    /// Overwrite the pointee; asserts the pointer is valid.
    void set(T value)
    {
        @assert(self.ptr != null);
        *self.ptr = value;
    }

    /// True when the pointer owns a live pointee.
    bool isValid(const self*)
    {
        return self.ptr != null;
    }

    /// Move the pointee out, freeing the heap cell and leaving the pointer empty.
    T take()
    {
        @assert(self.ptr != null);
        T value = *self.ptr;
        dealloc<T>(self.ptr);
        self.ptr = null;
        return value;
    }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Frees the pointee when the smart pointer goes out of scope.
pub extend<T> SmartPtr<T> : @drop
{
    void drop()
    {
        self.dispose();
    }
}
