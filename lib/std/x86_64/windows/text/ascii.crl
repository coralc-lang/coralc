#[[no_drop_all]]
// ASCII and UTF-8 utility functions

/// Returns true if the byte is in the 7-bit ASCII range (0x00-0x7F).
pub bool isAscii(u8 b)
{
    return b <= 0x7F;
}

/// Returns true if the byte is an ASCII digit ('0'-'9').
pub bool isAsciiDigit(u8 b)
{
    return b >= '0' && b <= '9';
}

/// Returns true if the byte is an ASCII letter ('a'-'z' or 'A'-'Z').
pub bool isAsciiAlpha(u8 b)
{
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z');
}

/// Returns true if the byte is an ASCII letter or digit.
pub bool isAsciiAlnum(u8 b)
{
    return isAsciiDigit(b) || isAsciiAlpha(b);
}

/// Returns true if the byte is an ASCII hex digit (0-9, a-f, A-F).
pub bool isAsciiHex(u8 b)
{
    return (b >= '0' && b <= '9') || (b >= 'a' && b <= 'f') || (b >= 'A' && b <= 'F');
}

/// Returns true if the byte is an ASCII whitespace character.
pub bool isAsciiSpace(u8 b)
{
    return b == ' ' || b == '\t' || b == '\n' || b == '\r' || b == '\f' || b == '\v';
}

/// Returns true if the byte is an ASCII uppercase letter ('A'-'Z').
pub bool isAsciiUpper(u8 b)
{
    return b >= 'A' && b <= 'Z';
}

/// Returns true if the byte is an ASCII lowercase letter ('a'-'z').
pub bool isAsciiLower(u8 b)
{
    return b >= 'a' && b <= 'z';
}

/// Returns the lowercase form of an ASCII uppercase letter, else the byte unchanged.
pub u8 toAsciiLower(u8 b)
{
    if (b >= 'A' && b <= 'Z') return b + 32;
    return b;
}

/// Returns the uppercase form of an ASCII lowercase letter, else the byte unchanged.
pub u8 toAsciiUpper(u8 b)
{
    if (b >= 'a' && b <= 'z') return b - 32;
    return b;
}

/// Returns the numeric value of an ASCII digit, or 0 if the byte is not a digit.
pub u8 asciiDigitVal(u8 b)
{
    if (b >= '0' && b <= '9') return b - '0';
    return 0;
}

/// Returns the numeric value of an ASCII hex digit, or 0 if the byte is not one.
pub u8 asciiHexVal(u8 b)
{
    if (b >= '0' && b <= '9') return b - '0';
    if (b >= 'a' && b <= 'f') return b - 'a' + 10;
    if (b >= 'A' && b <= 'F') return b - 'A' + 10;
    return 0;
}

// UTF-8 encoding/decoding

/// Returns the UTF-8 sequence length implied by a leading byte, or 0 if invalid.
pub u32 utf8ByteCount(u8 b)
{
    if (b <= 0x7F) return 1;
    if ((b & 0xE0) == 0xC0) return 2;
    if ((b & 0xF0) == 0xE0) return 3;
    if ((b & 0xF8) == 0xF0) return 4;
    return 0; // invalid
}

/// Decodes the UTF-8 sequence at buf, storing the byte count in *bytesOut and returning the codepoint.
pub u32 utf8Decode(const u8* buf, u32* bytesOut)
{
    u8 b0 = buf[0];
    if (b0 <= 0x7F)
    {
        *bytesOut = 1;
        return (u32)b0;
    }
    if ((b0 & 0xE0) == 0xC0)
    {
        *bytesOut = 2;
        return (((u32)(b0 & 0x1F) << 6) | ((u32)(buf[1] & 0x3F)));
    }
    if ((b0 & 0xF0) == 0xE0)
    {
        *bytesOut = 3;
        return (((u32)(b0 & 0x0F) << 12) | ((u32)(buf[1] & 0x3F) << 6) | ((u32)(buf[2] & 0x3F)));
    }
    *bytesOut = 4;
    return (((u32)(b0 & 0x07) << 18) | ((u32)(buf[1] & 0x3F) << 12) | ((u32)(buf[2] & 0x3F) << 6) | ((u32)(buf[3] & 0x3F)));
}

/// Encodes a codepoint as UTF-8 into buf and returns the number of bytes written.
pub u32 utf8Encode(u32 cp, u8* buf)
{
    if (cp <= 0x7F) {
        buf[0] = (u8)cp;
        return 1;
    }
    if (cp <= 0x7FF) {
        buf[0] = (u8)(0xC0 | (cp >> 6));
        buf[1] = (u8)(0x80 | (cp & 0x3F));
        return 2;
    }
    if (cp <= 0xFFFF) {
        buf[0] = (u8)(0xE0 | (cp >> 12));
        buf[1] = (u8)(0x80 | ((cp >> 6) & 0x3F));
        buf[2] = (u8)(0x80 | (cp & 0x3F));
        return 3;
    }
    buf[0] = (u8)(0xF0 | (cp >> 18));
    buf[1] = (u8)(0x80 | ((cp >> 12) & 0x3F));
    buf[2] = (u8)(0x80 | ((cp >> 6) & 0x3F));
    buf[3] = (u8)(0x80 | (cp & 0x3F));
    return 4;
}

// UTF-16 to/from UTF-8 for terminal output
/// Encodes a BMP UTF-16 code unit as UTF-8 into buf and returns the bytes written.
pub u32 utf16ToUtf8(u16 cp, u8* buf)
{
    if (cp <= 0x7F)
    {
        buf[0] = (u8)cp;
        return 1;
    }
    if (cp <= 0x7FF)
    {
        buf[0] = (u8)(0xC0 | (cp >> 6));
        buf[1] = (u8)(0x80 | (cp & 0x3F));
        return 2;
    }
    // BMP
    buf[0] = (u8)(0xE0 | (cp >> 12));
    buf[1] = (u8)(0x80 | ((cp >> 6) & 0x3F));
    buf[2] = (u8)(0x80 | (cp & 0x3F));
    return 3;
}

// Count UTF-8 characters in a byte slice
/// Counts the UTF-8 characters in s, skipping bytes that start no valid sequence.
pub usize utf8CountChars(str s)
{
    usize count = 0;
    usize i = 0;
    while (i < s.len)
    {
        usize bytes = (usize)utf8ByteCount(s.ptr[i]);
        if (bytes == 0) { i++; continue; }
        i += bytes;
        count++;
    }
    return count;
}

/// Returns true if s is well-formed UTF-8.
pub bool utf8IsValid(str s)
{
    usize i = 0;
    while (i < s.len)
    {
        usize bytes = (usize)utf8ByteCount(s.ptr[i]);
        if (bytes == 0) return false;
        if (i + bytes > s.len) return false;
        for (usize j = 1; j < bytes; j++)
        {
            if ((s.ptr[i + j] & 0xC0) != 0x80) return false;
        }
        i += bytes;
    }
    return true;
}
