#[[no_drop_all]]
import string { String };
import(lib) platform::libc { snprintf };

/// A parsed URI split into scheme, authority, path, query and fragment parts.
pub struct Uri
{
    String scheme;
    String userInfo;
    String host;
    u16 port;
    String path;
    String query;
    String fragment;
    bool hasPort;

    /// Creates a Uri with all components empty and no port.
    static Uri new()
    {
        return Uri {
            .scheme = String::new(),
            .userInfo = String::new(),
            .host = String::new(),
            .port = 0,
            .path = String::new(),
            .query = String::new(),
            .fragment = String::new(),
            .hasPort = false
        };
    }

    /// Releases the storage of every component string.
    void dispose()
    {
        self.scheme.free();
        self.userInfo.free();
        self.host.free();
        self.path.free();
        self.query.free();
        self.fragment.free();
    }

    /// Parses input into the URI components. Returns false on a malformed port.
    bool parse(str input)
    {
        usize i = 0;

        usize schemeEnd = i;
        while (schemeEnd < input.len && input.ptr[schemeEnd] != ':' && input.ptr[schemeEnd] != '/' && input.ptr[schemeEnd] != '?' && input.ptr[schemeEnd] != '#')
            schemeEnd++;
        if (schemeEnd < input.len && input.ptr[schemeEnd] == ':')
        {
            self.scheme.free();
            self.scheme = String::from(str::fromParts(input.ptr, schemeEnd));
            i = schemeEnd + 1;
        }

        if (i + 1 < input.len && input.ptr[i] == '/' && input.ptr[i + 1] == '/')
        {
            i += 2;
            usize authEnd = i;
            while (authEnd < input.len && input.ptr[authEnd] != '/' && input.ptr[authEnd] != '?' && input.ptr[authEnd] != '#')
                authEnd++;

            str authority = str::fromParts(input.ptr + i, authEnd - i);
            i = authEnd;

            isize at = -1;
            for (usize j = 0; j < authority.len; j++)
                if (authority.ptr[j] == '@') { at = (i64)j; break; }

            if (at >= 0)
            {
                self.userInfo.free();
                self.userInfo = String::from(str::fromParts(authority.ptr, (usize)at));
                authority = str::fromParts(authority.ptr + (usize)at + 1, authority.len - (usize)at - 1);
            }

            isize colon = -1;
            for (usize j = 0; j < authority.len; j++)
                if (authority.ptr[j] == ':') { colon = (i64)j; break; }

            if (colon >= 0)
            {
                self.host.free();
                self.host = String::from(str::fromParts(authority.ptr, (usize)colon));
                str portStr = str::fromParts(authority.ptr + (usize)colon + 1, authority.len - (usize)colon - 1);
                if (portStr.len == 0) return false;
                usize portVal = 0;
                for (usize j = 0; j < portStr.len; j++)
                {
                    if (portStr.ptr[j] < '0' || portStr.ptr[j] > '9') return false;
                    portVal = portVal * 10 + (usize)(portStr.ptr[j] - '0');
                    if (portVal > 65535u) return false;
                }
                self.port = (u16)portVal;
                self.hasPort = true;
            }
            else
            {
                self.host.free();
                self.host = String::from(authority);
            }
        }

        usize pathEnd = i;
        while (pathEnd < input.len && input.ptr[pathEnd] != '?' && input.ptr[pathEnd] != '#')
            pathEnd++;
        if (pathEnd > i)
        {
            self.path.free();
            self.path = String::from(str::fromParts(input.ptr + i, pathEnd - i));
        }
        else if (self.host.len > 0)
        {
            self.path.free();
            self.path = String::from("/");
        }
        i = pathEnd;

        if (i < input.len && input.ptr[i] == '?')
        {
            i++;
            usize qEnd = i;
            while (qEnd < input.len && input.ptr[qEnd] != '#') qEnd++;
            self.query.free();
            self.query = String::from(str::fromParts(input.ptr + i, qEnd - i));
            i = qEnd;
        }
        else if (self.query.len > 0)
        {
            self.query.free();
            self.query = String::new();
        }

        if (i < input.len && input.ptr[i] == '#')
        {
            i++;
            self.fragment.free();
            self.fragment = String::from(str::fromParts(input.ptr + i, input.len - i));
        }
        else if (self.fragment.len > 0)
        {
            self.fragment.free();
            self.fragment = String::new();
        }

        return true;
    }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of Uri through the @drop trait.
pub extend Uri : @drop
{
    void drop()
    {
        self.dispose();
    }
}

pub extend Uri : @toStr
{
    str toStr()
    {
        String out = String::new();
        if (self.scheme.len > 0)
        {
            out.pushView(self.scheme.asView());
            out.pushChar(':');
        }
        if (self.host.len > 0 || self.hasPort || self.userInfo.len > 0)
        {
            out.pushChar('/');
            out.pushChar('/');
            if (self.userInfo.len > 0)
            {
                out.pushView(self.userInfo.asView());
                out.pushChar('@');
            }
            out.pushView(self.host.asView());
            if (self.hasPort)
            {
                u8 pbuf[8];
                i32 pn = snprintf(pbuf, 8u, C":%u", (u32)self.port);
                if (pn > 0) out.pushView(str::fromParts((const u8*)pbuf, (usize)pn));
            }
        }
        out.pushView(self.path.asView());
        if (self.query.len > 0)
        {
            out.pushChar('?');
            out.pushView(self.query.asView());
        }
        if (self.fragment.len > 0)
        {
            out.pushChar('#');
            out.pushView(self.fragment.asView());
        }
        return out.asView();
    }
}
