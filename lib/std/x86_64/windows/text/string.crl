#[[no_drop_all]]
import(lib) std::error { __assert, __assertOut };
import(lib) std::mman { alloc, dealloc, realloc };
import(lib) std::intrinsics { memcpy, memmove, memset };
import(lib) std::vec { Vec };
import(lib) core::char_util;
import(lib) core::cchar { cchar };

/// A growable, null-terminated UTF-8 byte string with owning storage.
pub struct String
{
    u8* ptr;
    usize len;
    usize cap;

    /// Creates an empty String with a small initial capacity.
    static String new()
    {
        String s = String { .ptr = alloc<u8>(16 + 1), .len = 0, .cap = 16 };
        s.ptr[0] = 0;
        return s;
    }

    /// Creates an empty String with capacity for at least cap bytes.
    static String withCap(usize cap)
    {
        usize c = cap > 7 ? cap : 7;
        String s = String { .ptr = alloc<u8>(c + 1), .len = 0, .cap = c };
        s.ptr[0] = 0;
        return s;
    }

    /// Creates a String by copying the bytes of a string view.
    static String from(str sv)
    {
        String s = String::withCap(sv.len);
        memcpy((rawptr)s.ptr, (const rawptr)sv.ptr, sv.len);
        s.ptr[sv.len] = 0;
        s.len = sv.len;
        return s;
    }

    /// Creates a String by copying a null-terminated C string.
    static String fromCstr(const cchar* cstr)
    {
        return String::from(str::fromCstr(cstr));
    }

    /// Returns an independent copy of this string.
    String clone()
    {
        return String::from(self.asView());
    }

    /// Releases the string's storage and resets it to empty.
    void free()
    {
        dealloc<u8>(self.ptr);
        self.ptr = null;
        self.len = 0;
        self.cap = 0;
    }

    void _ensure(usize extra)
    {
        if (self.len + extra <= self.cap) return;
        usize nc = self.cap * 2;
        if (nc < self.len + extra) nc = self.len + extra;
        self.ptr = realloc<u8>(self.ptr, nc + 1);
        self.cap = nc;
    }

    #[[inline]]
    /// Returns a non-owning string view of the current bytes.
    str asView() { return str::fromParts(self.ptr, self.len); }
    /// Returns a C-string pointer to the current bytes.
    cchar* asCstr() { return (cchar*)self.ptr; }
    /// Returns a mutable pointer to the current bytes.
    u8* asU8() { return self.ptr; }

    // pushChar appends one raw byte; for a coral `char` (UTF-32
    // codepoint) use pushCodepoint below.
    /// Appends one raw byte; use pushCodepoint for a coral char.
    void pushChar(u8 c)
    {
        self._ensure(1);
        self.ptr[self.len++] = c;
        self.ptr[self.len] = 0;
    }

    // Appends one coral `char` as its UTF-8 encoding (1-4 bytes).
    // Invalid codepoints (surrogates, above U+10FFFF) are appended as
    // U+FFFD — the same replacement policy as the utf8 decode path.
    /// Appends one coral char as its UTF-8 encoding.
    void pushCodepoint(char c)
    {
        u8 buf[4];
        u32 n = char_util::charEncodeUtf8(c, buf);
        if (n == 0)
        {
            buf[0] = (u8)0xEF;
            buf[1] = (u8)0xBB;
            buf[2] = (u8)0xBD;
            n = 3;
        }
        self._ensure((usize)n);
        for (u32 i = 0; i < n; i++) self.ptr[self.len++] = buf[i];
        self.ptr[self.len] = 0;
    }

    // Codepoint iteration over the utf8 bytes — see str::nextCodepoint.
    // *idx is a byte offset into the string; each successful call stores
    // one char in *out and advances *idx past its sequence.
    /// Decodes the next UTF-8 codepoint at *idx into *out and advances *idx. Returns false when exhausted.
    bool nextCodepoint(usize* idx, char* out)
    {
        return self.asView().nextCodepoint(idx, out);
    }

    /// Returns the number of UTF-8 codepoints in the string.
    usize codepointCount()
    {
        return self.asView().codepointCount();
    }

    /// Appends one raw byte.
    void pushByte(u8 b)
    {
        self._ensure(1);
        self.ptr[self.len++] = b;
        self.ptr[self.len] = 0;
    }

    /// Appends the bytes of a string view.
    void appendView(str sv)
    {
        self.pushView(sv);
    }

    /// Appends the bytes of a string view, handling self-aliasing.
    void pushView(str sv)
    {
        bool selfRef = sv.ptr >= self.ptr && (usize)(sv.ptr - self.ptr) < self.len;
        usize off = 0;
        if (selfRef) off = (usize)(sv.ptr - self.ptr);
        self._ensure(sv.len);
        if (selfRef)
        {
            memmove((rawptr)(self.ptr + self.len), (const rawptr)(self.ptr + off), sv.len);
        }
        else
            memcpy((rawptr)(self.ptr + self.len), (const rawptr)sv.ptr, sv.len);
        self.len += sv.len;
        self.ptr[self.len] = 0;
    }

    /// Appends the bytes of another String.
    void pushStr(const String* other)
    {
        self.pushView(other->asView());
    }

    /// Appends a null-terminated C string.
    void pushCstr(const u8* cstr)
    {
        self.pushView(str::fromCstr(cstr));
    }

    /// Appends c repeated n times.
    void pushRepeat(u8 c, usize n)
    {
        self._ensure(n);
        memset((rawptr)(self.ptr + self.len), (u8)c, n);
        self.len += n;
        self.ptr[self.len] = 0;
    }

    /// Removes all bytes, leaving the string empty.
    void clear()
    {
        self.len = 0;
        self.ptr[0] = 0;
    }

    /// Shrinks the allocation to fit the current length.
    void shrinkToFit()
    {
        self.ptr = realloc<u8>(self.ptr, self.len + 1);
        self.cap = self.len;
    }

    /// Shortens the string to newLen bytes; does nothing if newLen is not smaller.
    void truncate(usize newLen)
    {
        if (newLen >= self.len) return;
        self.len = newLen;
        self.ptr[self.len] = 0;
    }

    /// Inserts the bytes of a string view at byte index idx.
    void insertView(usize idx, str sv)
    {
        __assert(idx <= self.len);
        bool selfRef = sv.ptr >= self.ptr && (usize)(sv.ptr - self.ptr) < self.len;
        usize off = 0;
        if (selfRef) off = (usize)(sv.ptr - self.ptr);
        self._ensure(sv.len);
        memmove((rawptr)(self.ptr + idx + sv.len),
                        (const rawptr)(self.ptr + idx),
                        self.len - idx + 1);
        if (selfRef)
        {
            u8* src = self.ptr + off;
            if (off >= idx) src = self.ptr + off + sv.len;
            memmove((rawptr)(self.ptr + idx), (const rawptr)src, sv.len);
        }
        else
            memcpy((rawptr)(self.ptr + idx), (const rawptr)sv.ptr, sv.len);
        self.len += sv.len;
    }

    /// Removes the bytes in [start, end).
    void removeRange(usize start, usize end)
    {
        __assert(start <= end);
        __assert(end <= self.len);
        usize tail = self.len - end;
        memmove((rawptr)(self.ptr + start),
                        (const rawptr)(self.ptr + end),
                        tail + 1);
        self.len -= (end - start);
    }

    /// Replaces every occurrence of needle with replacement.
    void replaceAll(str needle, str replacement)
    {
        if (needle.len == 0) return;
        String result = String::new();
        usize i = 0;
        while (i <= self.len)
        {
            str rest = str::fromParts(self.ptr + i, self.len - i);
            usize pos = rest.findView(needle);
            if (pos == rest.len)
            {
                result.pushView(rest);
                break;
            }
            result.pushView(str::fromParts(rest.ptr, pos));
            result.pushView(replacement);
            i += pos + needle.len;
        }
        self.free();
        *self = result;
    }

    /// Uppercases ASCII letters in place.
    void toUpper()
    {
        for (usize i = 0; i < self.len; i++)
            self.ptr[i] = char_util::toUpper(self.ptr[i]);
    }

    /// Lowercases ASCII letters in place.
    void toLower()
    {
        for (usize i = 0; i < self.len; i++)
            self.ptr[i] = char_util::toLower(self.ptr[i]);
    }

    /// Reverses the bytes in place.
    void reverse()
    {
        usize lo = 0;
        usize hi = self.len;
        while (lo < hi)
        {
            hi--;
            u8 t = self.ptr[lo];
            self.ptr[lo++] = self.ptr[hi];
            self.ptr[hi] = t;
        }
    }

    /// Returns the byte at idx; asserts idx is in bounds.
    u8 at(usize idx)
    {
        __assert(idx < self.len);
        return self.ptr[idx];
    }

    /// Overwrites the byte at idx; asserts idx is in bounds.
    void atApply(usize idx, u8 c)
    {
        __assert(idx < self.len);
        self.ptr[idx] = c;
    }

    /// Returns true if the string has no bytes.
    bool isEmpty() { return self.len == 0; }

    /// Returns true if this string equals another String byte-for-byte.
    bool equals(const String* other)
    {
        str sv = self.asView();
        return sv.equals(other->asView());
    }

    /// Returns true if this string equals a string view byte-for-byte.
    bool equalsView(str sv)
    {
        return self.asView().equals(sv);
    }

    /// Compares with another String, returning <0, 0, or >0.
    i32 compare(const String* other)
    {
        str sv = self.asView();
        return sv.compare(other->asView());
    }

    /// Returns the first index at which c occurs, or the length if absent.
    usize findChar(u8 c)
    {
        return self.asView().findByte(c);
    }

    /// Returns the last index at which c occurs, or the length if absent.
    usize rfindChar(u8 c)
    {
        return self.asView().rfindByte(c);
    }

    /// Returns the first index at which needle occurs, or the length if absent.
    usize findView(str needle)
    {
        return self.asView().findView(needle);
    }

    /// Returns true if the string begins with prefix.
    bool startsWith(str prefix)
    {
        return self.asView().startsWith(prefix);
    }

    /// Returns true if the string ends with suffix.
    bool endsWith(str suffix)
    {
        return self.asView().endsWith(suffix);
    }

    /// Returns true if needle occurs anywhere in the string.
    bool containsView(str needle)
    {
        return self.asView().containsView(needle);
    }

    /// Returns a copy with leading and trailing whitespace removed.
    String trim()
    {
        str tv = self.asView();
        return String::from(tv.trim());
    }

    /// Returns a copy with leading whitespace removed.
    String trimStart()
    {
        str tv = self.asView();
        return String::from(tv.trimStart());
    }

    /// Returns a copy with trailing whitespace removed.
    String trimEnd()
    {
        str tv = self.asView();
        return String::from(tv.trimEnd());
    }

    /// Returns a copy of the bytes in [start, end).
    String substr(usize start, usize end)
    {
        __assert(start <= end);
        __assert(end <= self.len);
        return String::from(str::fromParts(self.ptr + start, end - start));
    }

    /// Splits the string on a delimiter byte and returns the parts as views.
    Vec<str> splitByte(u8 delim)
    {
        Vec<str> parts = Vec<str>::new();
        usize start = 0;
        for (usize i = 0; i <= self.len; i++)
        {
            if (i == self.len || self.ptr[i] == delim)
            {
                parts.push(str::fromParts(self.ptr + start, i - start));
                start = i + 1;
            }
        }
        return parts;
    }

    /// Returns a new String containing this string repeated n times.
    String repeat(usize n)
    {
        String r = String::withCap(self.len * n);
        for (usize i = 0; i < n; i++) r.pushStr(self);
        return r;
    }

    /// Joins string views with a separator into a new String.
    static String join(str sep, const Vec<str>* parts)
    {
        String r = String::new();
        for (usize i = 0; i < parts->len; i++)
        {
            if (i > 0) r.pushView(sep);
            r.pushView(*parts->atConst(i));
        }
        return r;
    }

    /// Returns a copy padded on the left with padChar to totalLen bytes.
    String padLeft(usize totalLen, u8 padChar)
    {
        if (self.len >= totalLen) return self.clone();
        usize pad = totalLen - self.len;
        String r = String::withCap(totalLen);
        r.pushRepeat(padChar, pad);
        r.pushStr(self);
        return r;
    }

    /// Returns a copy padded on the right with padChar to totalLen bytes.
    String padRight(usize totalLen, u8 padChar)
    {
        if (self.len >= totalLen) return self.clone();
        String r = self.clone();
        r.pushRepeat(padChar, totalLen - self.len);
        return r;
    }

    /// Returns the number of occurrences of byte c.
    usize countChar(u8 c)
    {
        usize n = 0;
        for (usize i = 0; i < self.len; i++)
            if (self.ptr[i] == c) n++;
        return n;
    }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of String through the @drop trait.
pub extend String : @drop
{
    void drop()
    {
        self.free();
    }
}
