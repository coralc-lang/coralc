#[[no_drop_all]]
import(lib) std::string { String };
import(lib) std::vec { Vec };
import(lib) std::result { Result };

/// Error reported by the CSV parser, carrying a message and position.
pub variant ParseError
{
    Syntax { str msg; u32 line; u32 col; },
    Semantic { str msg; }
}

/// Incremental reader for comma-separated values.
pub struct CsvReader
{
    const u8* data;
    usize len;
    usize pos;
    usize line;
    bool error;
    str errMsg;
    u8 delim;

    /// Records the first error message; later calls are ignored.
    void fail(str msg)
    {
        if (self.error) return;
        self.error = true;
        self.errMsg = msg;
    }

    /// Returns a ParseError for the recorded failure.
    ParseError err()
    {
        return ParseError::Syntax { .msg = self.errMsg, .line = (u32)self.line, .col = 0 };
    }

    /// Creates a reader over input using ',' as the field delimiter.
    static CsvReader new(str input)
    {
        return CsvReader {
            .data = input.ptr,
            .len = input.len,
            .pos = 0,
            .line = 1,
            .error = false,
            .errMsg = "invalid CSV",
            .delim = ','
        };
    }

    /// Returns true when the reader has consumed all input.
    bool eof() { return self.pos >= self.len; }

    bool _readField(String* out)
    {
        if (self.pos >= self.len) { self.fail("unexpected end of input"); return false; }
        out->clear();
        if (self.data[self.pos] == '\"')
        {
            self.pos++;
            bool quoted = true;
            while (self.pos < self.len && quoted)
            {
                u8 c = self.data[self.pos++];
                if (c == '\"')
                {
                    if (self.pos < self.len && self.data[self.pos] == '\"')
                    {
                        out->pushByte('\"');
                        self.pos++;
                    }
                    else quoted = false;
                }
                else out->pushByte(c);
            }
            if (quoted)
            {
                self.fail("unterminated quoted field");
                return false;
            }
            if (self.pos < self.len && self.data[self.pos] != self.delim && self.data[self.pos] != '\n' && self.data[self.pos] != '\r')
            {
                self.fail("unexpected character after closing quote");
                return false;
            }
        }
        else {
            while (self.pos < self.len)
            {
                u8 c = self.data[self.pos];
                if (c == self.delim || c == '\n' || c == '\r') break;
                out->pushByte(c);
                self.pos++;
            }
        }
        return true;
    }

    // Ok(true) — a row was read into `fields`; Ok(false) — end of input;
    // Err — malformed CSV (fields holds whatever was decoded so far).
    /// Reads one row into fields: Ok(true) on data, Ok(false) at end, Err on malformed input.
    Result<bool, ParseError> readRow(Vec<String>* fields)
    {
        for (usize i = 0; i < fields->count(); i++)
            fields->atPtr(i)->free();
        fields->clear();
        if (self.pos >= self.len) return Result<bool, ParseError>::Ok { .value = false };
        loop {
            String field = String::new();
            if (!self._readField(&field)) { fields->push(field); return Result<bool, ParseError>::Err { .error = self.err() }; }
            fields->push(field);
            if (self.pos >= self.len) break;
            if (self.data[self.pos] == self.delim) { self.pos++; continue; }
            if (self.data[self.pos] == '\r') { self.pos++; }
            if (self.pos < self.len && self.data[self.pos] == '\n') { self.pos++; self.line++; break; }
            break;
        }
        return Result<bool, ParseError>::Ok { .value = true };
    }
}
