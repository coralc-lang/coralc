#[[no_drop_all]]
// import std::error { __assert, __assertOut };
/* option.crl for std
 * coral has no inbuilt error handling.
 * I will not add try-catch shit either;
 */

/// Optional value that is either None or Some with a value.
pub variant Option<T>
{
    None,
    Some { T value; }
}
    
/// Methods for inspecting and transforming an Option.
pub extend<T> Option<T>
{
/// Returns true when the option holds a value.
    bool isSome()
    {
        switch (self)
        {
            Some { value } => { return true; },
            else => { return false; }
        }
    }

/// Returns true when the option holds no value.
    bool isNone() 
    {
        switch (self)
        {
            Some { value } => { return false; },
            else => { return true; }
        }
    }

/// Returns the contained value; asserts the option is Some.
    T unwrap()
    {
        switch(self)
        {
            Some { value } => { return value; },
            else => { @assert(false); }
        }
    }

/// Returns the contained value, or default when the option is None.
    T unwrapOr(T default)
    {
        switch (self)
        {
            Some { value } => { return value; },
            else => { return default; }
        }
    }

    /// Returns Some value or recovers from None using a handler.
    /// unlike unwrapOr, the fallback is computed lazily.
    T catch(T() onNone) {
        switch (self) {
            Some { value } => {
                return value;
            },
            else => { return onNone(); }
        }
    }

    /// Runs a cleanup functio for both Some and None.
    /// Then returns the option unChanged.cAllocator.
    Option<T> finally(void() fn) {
        fn();
        return *self;
    } 

/// Returns a mutable pointer to the contained value, or null when None.
    T* ptr()
    {
        switch (self)
        {
            Some { value } => { return &value; },
            else => { return null; }
        }
    }

/// Returns a const pointer to the contained value, or null when None.
    const T* constPtr() 
    {
        switch (self)
        {
            Some { value } => { return &value; },
            else => return null;
        }
    }

/// Replaces the contained value with fn applied to it; leaves None unchanged.
    void map(T(T) fn)
    {
        switch (self)
        {
            Some { value } => { self = Option<T>::Some { .value = fn(value) }; },
            else => { }
        }
    }

/// Replaces the option with fn applied to the contained value; leaves None unchanged.
    void andThen(Option<T>(T) fn)
    {
        switch (self)
        {
            Some { value } => { self = fn(value); },
            else => { }
        }
    }

/// Replaces a None option with the result of fn; leaves Some unchanged.
    void orElse(Option<T>() fn)
    {
        switch (self)
        {
            Some { value } => {},
            else => { self = fn(); }
        }
    }

/// Returns the contained value and leaves None behind; asserts the option is Some.
    T take()
    {
        switch (self)
        {
            Some { value } => {
                self = Option<T>::None;
                return value;
            },
            else => { @assert(false); }
        }
    }
}