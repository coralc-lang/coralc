#[[no_drop_all]]
/// Concise fatal assertions and error reporting with stack-ish unwinding.
/// Windows implementation (kernel32 `CaptureStackBackTrace` + SEH unhandled
/// exception filter). The Linux build uses `x86_64/linux/error.crl`.
///
/// A cleaner replacement for the `@assert` / `@assertOut` builtins: a failure
/// prints a short human-readable line plus a captured backtrace to stderr and
/// aborts — instead of dumping a raw C assertion expression.
/// (`assert` / `assertOut` are reserved keywords, so the functions are named
/// `check` / `__assertOut`.)
///
///   import std::error;
///   error::__assert(x > 0);                           // basic guard
///   error::__assertOut(i < n, "index oob");           // out-of-bounds / __unreachable guard
///   error::__assertRange(i, n, "index oob");          // specialized bounds check
///   error::__assertEq(got, want, "length mismatch");  // value compare, prints both
///   error::__panic("not implemented");               // unconditional
///
/// Output goes through the CRT `write(2, …)` (stderr), so a __report survives a
/// crash and can be reused from the exception filter.
import platform::libc { write, _exit };
import platform::win32 { CaptureStackBackTrace, SetUnhandledExceptionFilter, TerminateProcess, GetCurrentProcess };

// Windows exception codes we name explicitly (ntstatus-style).
const u32 EXC_ACCESS_VIOLATION      = 0xC0000005;
const u32 EXC_ILLEGAL_INSTRUCTION   = 0xC000001D;
const u32 EXC_ARRAY_BOUNDS          = 0xC000008C;
const u32 EXC_FLT_DIVIDE_BY_ZERO    = 0xC000008E;
const u32 EXC_FLT_INVALID_OPERATION = 0xC0000093;
const u32 EXC_INT_DIVIDE_BY_ZERO    = 0xC0000094;
const u32 EXC_INTEGER_OVERFLOW      = 0xC0000095;
const u32 EXC_PRIVILEGED_INSTRUCTION= 0xC0000026;

// EXCEPTION_CONTINUE_SEARCH: pass the exception to the OS default handler so a
// debugger / WER crash dump still fires after our __report.
const i32 EXC_CONTINUE_SEARCH = 0;

// Reentrancy guard: never let a crash during reporting re-enter the filter.
static bool _handling = false;

//  low-level async-signal-safe writers --

// Write a Coral str to fd (casts to the libc `const cchar*` only at the boundary).
void _wr(i32 fd, str s) { write(fd, (const cchar*)s.ptr, s.len); }

// Write a u64 as hex, skipping leading zeros (always at least one digit).
void _wrHex(i32 fd, u64 v)
{
    _wr(fd, "0x");
    bool started = false;
    for (i32 shift = 60; shift >= 0; shift -= 4)
    {
        u8 d = (u8)((v >> (u64)shift) & 0xF);
        if (!started && d == 0 && shift != 0) continue;
        started = true;
        cchar c = (d < 10) ? (cchar)(48 + d) : (cchar)(87 + d);
        write(fd, &c, 1);
    }
}

// Write a u64 as decimal.
void _wrDec(i32 fd, u64 v)
{
    if (v == 0) { _wr(fd, "0"); return; }
    cchar[20] buf;
    i32 i = 0;
    while (v > 0) { buf[i] = (cchar)(48 + (v % 10)); v /= 10; i++; }
    while (i > 0) { i--; cchar d = buf[i]; write(fd, &d, 1); }
}

void _wrExcName(i32 fd, u32 code)
{
    switch (code) {
        EXC_ACCESS_VIOLATION => { _wr(fd, "ACCESS_VIOLATION"); },
        EXC_ILLEGAL_INSTRUCTION => { _wr(fd, "ILLEGAL_INSTRUCTION"); },
        EXC_ARRAY_BOUNDS => { _wr(fd, "ARRAY_BOUNDS_EXCEEDED"); },
        EXC_FLT_DIVIDE_BY_ZERO => { _wr(fd, "FLT_DIVIDE_BY_ZERO"); },
        EXC_FLT_INVALID_OPERATION => { _wr(fd, "FLT_INVALID_OPERATION"); },
        EXC_INT_DIVIDE_BY_ZERO => { _wr(fd, "INT_DIVIDE_BY_ZERO"); },
        EXC_INTEGER_OVERFLOW => { _wr(fd, "INTEGER_OVERFLOW"); },
        EXC_PRIVILEGED_INSTRUCTION => { _wr(fd, "PRIVILEGED_INSTRUCTION"); },
        else => { _wr(fd, "exception "); _wrHex(fd, (u64)code); }
    }
}

//  backtrace / process control

/// Print a captured backtrace to fd (raw addresses; resolve with the debugger
/// or `addr2line`-style tooling). Best-effort; one line per frame.
pub void __backtraceTo(i32 fd)
{
    rawptr[32] frames;
    u32 hash = 0;
    u32 n = CaptureStackBackTrace(0, 32, frames, &hash);
    if (n == 0) { _wr(fd, "  <no frames>\n"); return; }
    _wr(fd, "  stack:\n");
    for (u32 i = 0; i < n; i++)
    {
        _wr(fd, "  #");
        _wrDec(fd, (u64)i);
        _wr(fd, " ");
        _wrHex(fd, (u64)frames[i]);
        _wr(fd, "\n");
    }
}

/// Terminate the process with the given exit code (134 mirrors Linux abort).
pub void __abortNow()
{
    TerminateProcess((rawptr)GetCurrentProcess, 134);
    _exit(134); // fallback
}

//  reporting (print, do not abort) 

/// Print a concise fatal message + backtrace to stderr. Does not abort.
pub void __report(str msg)
{
    _wr(2, "\ncoral: error: ");
    _wr(2, msg);
    _wr(2, "\n");
    __backtraceTo(2);
    _wr(2, "\n");
}

/// Like `__report`, but appends `name = 0x<hex>` before the backtrace.
pub void __reportHex(str msg, str name, u64 value)
{
    _wr(2, "\ncoral: error: ");
    _wr(2, msg);
    _wr(2, " (");
    _wr(2, name);
    _wr(2, " = ");
    _wrHex(2, value);
    _wr(2, ")\n");
    __backtraceTo(2);
    _wr(2, "\n");
}

//  unconditional fatals 

/// Unconditional concise __panic: message + backtrace, then abort.
pub void __panic(str msg)
{
    __report(msg);
    __abortNow();
}

/// Mark a path as impossible. Same as `__panic`; signals __unreachable intent.
pub void __unreachable(str msg)
{
    __report(msg);
    __abortNow();
}

//  asserts (abort on failure) 

/// Basic guard with no message. On failure: "assertion failed" + backtrace.
pub void __assert(bool cond)
{
    if (!cond) { __report("assertion failed"); __abortNow(); }
}

/// Out-of-bounds / __unreachable guard carrying a message. The required `msg`
/// describes what must hold; used for index guards and "cannot happen" checks.
pub void __assertOut(bool cond, str msg)
{
    if (!cond) { __report(msg); __abortNow(); }
}

// Shared body for the comparison asserts: prints `a <op> b (msg)` + backtrace.
void _failCmp(str op, u64 a, u64 b, str msg)
{
    _wr(2, "\ncoral: error: assert ");
    _wr(2, op);
    _wr(2, " failed: ");
    _wrDec(2, a);
    _wr(2, " ");
    _wr(2, op);
    _wr(2, " ");
    _wrDec(2, b);
    _wr(2, ": ");
    _wr(2, msg);
    _wr(2, "\n");
    __backtraceTo(2);
    _wr(2, "\n");
    __abortNow();
}

/// `expected == actual`, else prints both values.
pub void __assertEq(u64 expected, u64 actual, str msg)
{
    if (expected != actual) _failCmp("==", actual, expected, msg);
}
/// `a != b`, else prints both values.
pub void __assertNe(u64 a, u64 b, str msg)
{
    if (a == b) _failCmp("!=", a, b, msg);
}
/// `a < b`, else prints both values.
pub void __assertLt(u64 a, u64 b, str msg)
{
    if (!(a < b)) _failCmp("<", a, b, msg);
}
/// `a <= b`, else prints both values.
pub void __assertLe(u64 a, u64 b, str msg)
{
    if (!(a <= b)) _failCmp("<=", a, b, msg);
}
/// `a > b`, else prints both values.
pub void __assertGt(u64 a, u64 b, str msg)
{
    if (!(a > b)) _failCmp(">", a, b, msg);
}
/// `a >= b`, else prints both values.
pub void __assertGe(u64 a, u64 b, str msg)
{
    if (!(a >= b)) _failCmp(">=", a, b, msg);
}

/// The classic bounds guard: `idx < len`, else prints `idx vs len`.
pub void __assertRange(usize idx, usize len, str msg)
{
    if (!(idx < len))
    {
        _wr(2, "\ncoral: error: index ");
        _wrDec(2, (u64)idx);
        _wr(2, " out of bounds for length ");
        _wrDec(2, (u64)len);
        _wr(2, ": ");
        _wr(2, msg);
        _wr(2, "\n");
        __backtraceTo(2);
        _wr(2, "\n");
        __abortNow();
    }
}

/// Guard: pointer must be non-null.
pub void __assertNonNull(rawptr p, str msg)
{
    if (p == null) { __report(msg); __abortNow(); }
}

/// Guard: pointer must be aligned to `align` (a power of two).
pub void __assertAligned(rawptr p, u64 align, str msg)
{
    if (((u64)p & (align - 1)) != 0)
    {
        __reportHex(msg, "pointer", (u64)p);
        __abortNow();
    }
}

//  safety checks (wallvm instrumentation) 

/// Unbuffered stdout write — the safety-check reporter prints through
/// this so a failing check's message survives even when stderr is
/// redirected away.
pub void write_stdout(str s) { _wr(1, s); }

/// Wallvm safety check (the O0 instrumentation's `@_trap`): evaluate the
/// condition for `kind` against `a`/`b` and return when the guarded
/// operation is safe; on failure print the site to stdout, dump a
/// symbolized backtrace, and abort — it must never return then.
///   0 bounds:     a=index b=len,      ok when a < b
///   1 null:       a=pointer,          ok when a != 0
///   2 divzero:    a=divisor,          ok when a != 0
///   3 overflow:   a=overflow flag,    ok when a == 0
///   4 badvariant: a=tag b=nvariants,  ok when a < b
/// `file`/`line` name the check site (may be "?" / 0 when the IR has no
/// debug location). Reached by an ordinary call, so allocating is fine.
pub void _trap(u64 kind, u64 a, u64 b, const cchar* file, u64 line)
{
    if (kind == 0) { if (a < b) return; }
    else if (kind == 1 || kind == 2) { if (a != 0) return; }
    else if (kind == 3) { if (a == 0) return; }
    else if (kind == 4) { if (a < b) return; }

    write_stdout("\ncoral: trap ");
    
    switch (kind) {
        0 => {
            write_stdout("bounds: index ");
            _wrDec(1, a);
            write_stdout(" out of bounds for length ");
            _wrDec(1, b);
        },
        
        1 => {
            write_stdout("null dereference of ");
            _wrHex(1, a);
        },
        
        2 => {
            write_stdout("division by zero (divisor ");
            _wrDec(1, a);
            write_stdout(")");
        },
        3 => {
            write_stdout("integer overflow (a=");
            _wrDec(1, a);
            write_stdout(", b=");
            _wrDec(1, b);
            write_stdout(")");
        },
        4 => {
            write_stdout("invalid variant tag ");
            _wrDec(1, a);
            write_stdout(" for ");
            _wrDec(1, b);
            write_stdout(" variants");
        },
        else => { write_stdout("unknown check kind");}
    }
    
    write_stdout(" at ");
    if (file == null) write_stdout("?");
    else write_stdout(str::fromCstr(file));
    write_stdout(":");
    _wrDec(1, line);
    write_stdout("\n");
    __backtraceTo(1);
    __abortNow();
}

//  crash handling 

// Top-level SEH filter. `ep` is an EXCEPTION_POINTERS*; the exception code is
// EXCEPTION_POINTERS->ExceptionRecord->ExceptionCode, both at offset 0.
i32 _excFilter(rawptr ep)
{
    if (_handling) return EXC_CONTINUE_SEARCH; // recursion: let the OS proceed
    _handling = true;

    rawptr rec = *(rawptr*)ep;   // EXCEPTION_RECORD*
    u32 code = *(u32*)rec;       // ExceptionCode

    _wr(2, "\ncoral: fatal: ");
    _wrExcName(2, code);
    _wr(2, "\n");
    __backtraceTo(2);
    _wr(2, "\n");

    // Pass the exception on so the OS default handler (debugger / WER dump)
    // still runs after our __report.
    return EXC_CONTINUE_SEARCH;
}

/// Install a concise top-level crash handler (SEH unhandled-exception filter).
/// An access violation / illegal instruction etc. then prints the exception
/// name + a backtrace before the OS takes over to dump/terminate.
pub void __catchFatalSignals()
{
    SetUnhandledExceptionFilter((rawptr)_excFilter);
}
