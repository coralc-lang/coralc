#[[no_drop_all]]
// Sibling module, the transcendental helpers live in math.crl. Qualified as
// F64::x (F32:: for f32 code) because Complex has methods with the same
// names (sin, cos, exp, log, sqrt) — unqualified calls would collide.
use math { F64 };
import platform::libc { snprintf };
import std::string { String };

/// Complex number with real and imaginary float64 parts.
pub struct Complex
{
    f64 re;
    f64 im;

    /// Creates a complex number from real and imaginary parts.
    static Complex new(f64 real, f64 imag)
    {
        return Complex { .re = real, .im = imag };
    }

    /// Creates a complex number with a real part and zero imaginary part.
    static Complex fromRe(f64 real)
    {
        return Complex { .re = real, .im = 0.0 };
    }

    /// Creates a purely imaginary complex number.
    static Complex fromIm(f64 imag)
    {
        return Complex { .re = 0.0, .im = imag };
    }

    /// Returns the sum of this and other.
    Complex add(Complex other)
    {
        return Complex::new(self.re + other.re, self.im + other.im);
    }

    /// Returns the difference of this and other.
    Complex sub(Complex other)
    {
        return Complex::new(self.re - other.re, self.im - other.im);
    }

    /// Returns the product of this and other.
    Complex mul(Complex other)
    {
        return Complex::new(
            self.re * other.re - self.im * other.im,
            self.re * other.im + self.im * other.re
        );
    }

    /// Returns the quotient of this and other, or zero when the divisor is zero.
    Complex div(Complex other)
    {
        f64 denom = other.re * other.re + other.im * other.im;
        if (denom == 0.0) return Complex::new(0.0, 0.0);
        return Complex::new(
            (self.re * other.re + self.im * other.im) / denom,
            (self.im * other.re - self.re * other.im) / denom
        );
    }

    /// Returns the complex conjugate.
    Complex conj()
    {
        return Complex::new(self.re, -self.im);
    }

    /// Returns the magnitude (modulus).
    f64 abs()
    {
        return F64::hypot(self.re, self.im);
    }

    /// Returns the argument (phase) in radians.
    f64 arg()
    {
        return F64::atan2(self.im, self.re);
    }

    /// Returns the squared magnitude.
    f64 absSq()
    {
        return self.re * self.re + self.im * self.im;
    }

    /// Returns the negation.
    Complex neg()
    {
        return Complex::new(-self.re, -self.im);
    }

    /// Returns this multiplied by the real scalar s.
    Complex scale(f64 s)
    {
        return Complex::new(self.re * s, self.im * s);
    }

    /// Returns the complex exponential.
    Complex exp()
    {
        f64 e = F64::exp(self.re);
        return Complex::new(e * F64::cos(self.im), e * F64::sin(self.im));
    }

    /// Returns the principal complex natural logarithm.
    Complex log()
    {
        return Complex::new(F64::log(self.abs()), self.arg());
    }

    /// Returns this raised to the power other.
    Complex pow(Complex other)
    {
        if (self.re == 0.0 && self.im == 0.0) return Complex::new(0.0, 0.0);
        return other.mul(self.log()).exp();
    }

    /// Returns the complex sine.
    Complex sin()
    {
        return Complex::new(
            F64::sin(self.re) * F64::cosh(self.im),
            F64::cos(self.re) * F64::sinh(self.im)
        );
    }

    /// Returns the complex cosine.
    Complex cos()
    {
        return Complex::new(
            F64::cos(self.re) * F64::cosh(self.im),
            -F64::sin(self.re) * F64::sinh(self.im)
        );
    }

    /// Returns the principal complex square root.
    Complex sqrt()
    {
        f64 r = self.abs();
        f64 a = F64::sqrt((r + self.re) / 2.0);
        f64 b = F64::sqrt((r - self.re) / 2.0);
        if (self.im < 0.0) b = -b;
        return Complex::new(a, b);
    }
}

pub extend Complex : @toStr
{
    str toStr()
    {
        u8[128] buf;
        i32 len = snprintf(buf, 128u, C"(%.15g%+.15gi)", self.re, self.im);
        if (len < 0) len = 0;
        if (len > 127) len = 127;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}
