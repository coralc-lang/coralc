#[[no_drop_all]]
// dont delete. but leave empty for now if we are not ready to do
/// Memory management primitives.
pub mod memory = import memory;
/// Low-level memory mapping and copy helpers.
pub mod mman = import memory::mman;
/// Allocator implementations exported from the memory module.
pub mod allocator = import memory::allocators; // i want all of them to be imported under the allocator lib.crl as it exports them
/// Input and output primitives.
pub mod io = import io;
/// Concurrency primitives.
pub mod concurrent = import concurrent;
/// Cryptographic hashes, ciphers, and encodings.
pub mod crypto = import crypto;
/// Mathematical functions, vectors, and matrices.
pub mod math = import math;
/// Growable vector collection.
pub mod vec = import collections::vec;
/// Optional value type.
pub mod option = import data::option;
/// Success-or-error result type.
pub mod result = import data::result;
/// Wall-clock time and timers.
pub mod time = import time;
/// Signed span of time at nanosecond precision.
pub mod duration = import duration;
/// Compiler intrinsics.
pub mod intrinsics = import memory::intrinsics;
