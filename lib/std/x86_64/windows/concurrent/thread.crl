#[[no_drop_all]]
import mutex { Mutex };
import(lib) std::result { Result };
import(lib) platform::win32 { CreateThread, WaitForSingleObject, GetExitCodeThread, CloseHandle, GetProcessHeap, HeapAlloc, HeapFree, GetCurrentThreadId, ExitThread, InitializeConditionVariable, SleepConditionVariableCS, WakeConditionVariable, WakeAllConditionVariable };

const u32 INFINITE = 0xFFFFFFFF;

/// Opaque handle to a running thread.
pub distinct Thread = rawptr;

/// Condition variable used together with a Mutex.
pub struct ConditionVar
{
        // CONDITION_VARIABLE is 8B on x64 (a single PVOID) — FLAGGED;
        // impl[1] keeps the address.
    rawptr impl[1];

    #[[inline]]
    /// Initialize the condition variable.
    void init() { InitializeConditionVariable(self.impl); }
    /// Destroy the condition variable.
    void destroy()
    {
        // no-op, CONDITION_VARIABLE needs no destruction.
    }
    /// Atomically release mutex and wait for a signal or broadcast.
    void wait(Mutex* mutex)
    {
        // Releases self's critical section while blocked, like
        // pthread_cond_wait — Win32 enforces CS ownership strictly.
        SleepConditionVariableCS(self.impl, mutex->_cs, INFINITE);
    }
    #[[inline]]
    /// Wake one waiter.
    void signal() { WakeConditionVariable(self.impl); }
    #[[inline]]
    /// Wake all waiters.
    void broadcast() { WakeAllConditionVariable(self.impl); }
}

// Win32 start routines take one parameter, so (fn, arg) goes on the
// heap as a context the trampoline unpacks.
struct ThreadCtx
{
    rawptr(rawptr) fn;
    rawptr arg;
}

u32 _threadEntry(rawptr p)
{
    ThreadCtx* ctx = (ThreadCtx*)p;
    rawptr result = ctx->fn(ctx->arg);
    HeapFree(GetProcessHeap(), 0, ctx);
        // FLAG, 64-bit return value -> u32 Win32 exit code.
    return (usize)result;
}

/// Error returned when a thread cannot be created.
pub variant ThreadError
{
    CreateFailed { str msg; }
}

// Err(CreateFailed) — null fn, ThreadCtx allocation failed, or CreateThread
// failed (the message says which); Ok — the join handle for the new thread.
/// Create a thread running fn(arg); Err(CreateFailed) on failure.
pub Result<Thread, ThreadError> threadCreate(rawptr(rawptr) fn, rawptr arg)
{
    if (fn == null)
        return Result<Thread, ThreadError>::Err { .error = ThreadError::CreateFailed { .msg = "threadCreate() called with a null fn" } };
    // two rawptrs (fn + arg), 16B on x64
    ThreadCtx* ctx = (ThreadCtx*)HeapAlloc(GetProcessHeap(), 0, 16);
    if (ctx == null)
        return Result<Thread, ThreadError>::Err { .error = ThreadError::CreateFailed { .msg = "threadCreate() ThreadCtx allocation failed" } };
    ctx->fn = fn;
    ctx->arg = arg;
    u32 tid;
    rawptr h = CreateThread(null, 0, _threadEntry, ctx, 0, &tid);
    if (h == null)
    {
        HeapFree(GetProcessHeap(), 0, ctx);
        return Result<Thread, ThreadError>::Err { .error = ThreadError::CreateFailed { .msg = "threadCreate() CreateThread failed" } };
    }
    return Result<Thread, ThreadError>::Ok { .value = (Thread)h };
}

/// Wait for thread t to finish; true on success.
pub bool threadJoin(Thread t, rawptr* retval)
{
    rawptr h = (rawptr)t;
    if (WaitForSingleObject(h, INFINITE) != 0) return false;
    if (retval != null)
    {
        u32 code;
        if (!GetExitCodeThread(h, &code))
        {
            CloseHandle(h);
            return false;
        }
        // FLAG, u32 exit code -> rawptr, truncates on x64.
        *retval = (rawptr)(usize)code;
    }
    // Win32 wants the joiner to CloseHandle — after join the Thread value
    // is dead (no second join).
    CloseHandle(h);
    return true;
}

/// Terminate the calling thread, returning retval to its joiner.
pub void threadExit(rawptr retval)
{
    // FLAG, truncated to u32; called from inside a threadCreate entry it
    // also leaks the ThreadCtx (the trampoline never resumes).
    ExitThread((usize)retval);
}

/// Handle for the calling thread.
pub Thread threadCurrent()
{
    // FLAG, a reusable u32 id, NOT the HANDLE threadCreate returns —
    // never pass one of these to threadJoin.
    return (Thread)(rawptr)(usize)GetCurrentThreadId();
}

/// 64-bit atomic integer with sequentially consistent operations.
pub struct AtomicU64
{
    u64 value;

    /// Atomically load the value.
    u64 load()
    {
        u64 v;
        asm volatile { "mfence\n\tmovq %1, %0\n\tmfence" : "=r"(v) : "m"(self.value) }
        return v;
    }

    /// Atomically store val.
    void store(u64 val)
    {
        asm volatile { "xchgq %0, %1\n\tmfence" : "=m"(self.value) : "r"(val) }
        return;
    }

    /// Atomically add delta, returning the previous value.
    u64 fetchAdd(u64 delta)
    {
        u64 result;
        asm volatile { "lock xaddq %0, %1" : "=r"(result), "=m"(self.value) : "0"(delta), "m"(self.value) }
        return result;
    }

    /// Atomically subtract delta, returning the previous value.
    u64 fetchSub(u64 delta)
    {
        return self.fetchAdd(0u - delta);
    }

    /// Atomically compare with expected and store desired on match; true on match.
    bool compareExchange(u64 expected, u64 desired)
    {
        u8 ok;
        asm volatile { "lock cmpxchgq %3, %1\n\tsete %0" : "=q"(ok), "+m"(self.value), "+a"(expected) : "r"(desired) : "cc", "memory" }
        return ok != 0;
    }
}

/// 32-bit atomic integer with sequentially consistent operations.
pub struct AtomicU32
{
    u32 value;

    /// Atomically load the value.
    u32 load()
    {
        u32 v;
        asm volatile { "mfence\n\tmovl %1, %0\n\tmfence" : "=r"(v) : "m"(self.value) }
        return v;
    }

    /// Atomically store val.
    void store(u32 val)
    {
        asm volatile { "xchgl %0, %1\n\tmfence" : "=m"(self.value) : "r"(val) }
        return;
    }

    /// Atomically add delta, returning the previous value.
    u32 fetchAdd(u32 delta)
    {
        u32 result;
        asm volatile { "lock xaddl %0, %1" : "=r"(result), "=m"(self.value) : "0"(delta), "m"(self.value) }
        return result;
    }

    /// Atomically subtract delta, returning the previous value.
    u32 fetchSub(u32 delta)
    {
        return self.fetchAdd(0u - delta);
    }

    /// Atomically compare with expected and store desired on match; true on match.
    bool compareExchange(u32 expected, u32 desired)
    {
        u8 ok;
        asm volatile { "lock cmpxchgl %3, %1\n\tsete %0" : "=q"(ok), "+m"(self.value), "+a"(expected) : "r"(desired) : "cc", "memory" }
        return ok != 0;
    }
}
