#[[no_drop_all]]
// .crlb manifest parser — reads the coral build manifests themselves
// (lib/std/manifest.*.crlb), '#' line comments, top-level
// `key = value;` assignments, and
//     build "name" [extends "file"] { key = value; ... }
// blocks. Values are integers, bools, strings, or arrays of values.
// Shape and conventions follow parser/toml.crl.
//
// Usage, Result<CrbManifest, ParseError> r = parseCrlb(src);
//        if (r.isErr()) { /* r.unwrapErr() carries msg/line */ }
//        CrbManifest m = r.unwrap();
//        Option<CrbBuild*> b = m.findBuild("std");  // b->unwrap()->extends, get("root")
//        m.dispose();   // or rely on @drop
import string { String };
import(lib) std::vec { Vec };
import(lib) std::option { Option };
import(lib) std::result { Result };

/// Error reported by the .crlb parser, carrying a message and line.
pub variant ParseError
{
    Syntax { str msg; u32 line; u32 col; },
    Semantic { str msg; }
}

/// The kind of value a CrbValue holds.
pub enum CrbKind
{
    Int,
    Bool,
    Str,
    List,
}

/// A parsed .crlb value: integer, bool, string, or list.
pub struct CrbValue
{
    CrbKind kind;
    i64 intVal;
    bool boolVal;
    String strVal;
    Vec<CrbValue> listVal;

    /// Returns an integer value.
    static CrbValue intVal(i64 n)
    {
        return CrbValue { .kind = CrbKind::Int, .intVal = n };
    }

    /// Returns a boolean value.
    static CrbValue boolVal(bool b)
    {
        return CrbValue { .kind = CrbKind::Bool, .boolVal = b };
    }

    /// Returns a string value copying s.
    static CrbValue stringVal(str s)
    {
        return CrbValue { .kind = CrbKind::Str, .strVal = String::from(s) };
    }

    /// Returns an empty list value.
    static CrbValue listVal()
    {
        return CrbValue { .kind = CrbKind::List, .listVal = Vec<CrbValue>::new() };
    }

    /// Frees the value's string or list contents.
    void dispose()
    {
        if (self.kind == CrbKind::Str) self.strVal.free();
        if (self.kind == CrbKind::List)
        {
            for (usize i = 0; i < self.listVal.count(); i++)
                self.listVal.atPtr(i)->dispose();
            self.listVal.dispose();
        }
    }
}

/// A key/value pair at the top level of a manifest.
pub struct CrbEntry
{
    String key;
    CrbValue value;
}

/// A build block: its name, optional extends target, and entries.
pub struct CrbBuild
{
    String name;
    String extends;   // empty when the block carries no extends clause
    Vec<CrbEntry> entries;

    /// Returns the entry value for key, or None if absent.
    Option<CrbValue*> get(str key)
    {
        for (usize i = 0; i < self.entries.count(); i++)
        {
            if (self.entries.at(i).key.asView().equals(key))
                return Option<CrbValue*>::Some { .value = &self.entries.atPtr(i)->value };
        }
        return Option<CrbValue*>::None;
    }

    /// Frees the build's name, extends, and entries.
    void dispose()
    {
        for (usize i = 0; i < self.entries.count(); i++)
        {
            self.entries.atPtr(i)->key.free();
            self.entries.atPtr(i)->value.dispose();
        }
        self.entries.dispose();
        self.name.free();
        self.extends.free();
    }
}

/// A parsed .crlb manifest with top-level keys and build blocks.
pub struct CrbManifest
{
    Vec<CrbEntry> top;     // schema / strict / other top-level keys
    Vec<CrbBuild> builds;

    /// Creates an empty manifest.
    static CrbManifest new()
    {
        return CrbManifest {
            .top = Vec<CrbEntry>::new(),
            .builds = Vec<CrbBuild>::new()
        };
    }

    /// Returns the top-level value for key, or None if absent.
    Option<CrbValue*> get(str key)
    {
        for (usize i = 0; i < self.top.count(); i++)
        {
            if (self.top.at(i).key.asView().equals(key))
                return Option<CrbValue*>::Some { .value = &self.top.atPtr(i)->value };
        }
        return Option<CrbValue*>::None;
    }

    /// Returns the build block with the given name, or None.
    Option<CrbBuild*> findBuild(str name)
    {
        for (usize i = 0; i < self.builds.count(); i++)
        {
            if (self.builds.at(i).name.asView().equals(name))
                return Option<CrbBuild*>::Some { .value = self.builds.atPtr(i) };
        }
        return Option<CrbBuild*>::None;
    }

    /// Frees all top-level entries and build blocks.
    void dispose()
    {
        for (usize i = 0; i < self.top.count(); i++)
        {
            self.top.atPtr(i)->key.free();
            self.top.atPtr(i)->value.dispose();
        }
        self.top.dispose();
        for (usize i = 0; i < self.builds.count(); i++)
            self.builds.atPtr(i)->dispose();
        self.builds.dispose();
    }
}

struct _CrbParser
{
    const u8* data;
    usize len;
    usize pos;
    usize line;
    bool error;
    str errMsg;

    void fail(str msg)
    {
        if (self.error) return;
        self.error = true;
        self.errMsg = msg;
    }

    ParseError err()
    {
        return ParseError::Syntax { .msg = self.errMsg, .line = (u32)self.line, .col = 0 };
    }

    void skipLine()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c == '\n') { self.pos++; self.line++; return; }
            if (c == '\r') { self.pos++; if (self.pos < self.len && self.data[self.pos] == '\n') self.pos++; self.line++; return; }
            self.pos++;
        }
    }

    u8 peek()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c == ' ' || c == '\t') { self.pos++; continue; }
            if (c == '#') { self.skipLine(); continue; }
            if (c == '\n' || c == '\r') { self.skipLine(); continue; }
            return c;
        }
        return 0;
    }

    u8 next()
    {
        u8 c = self.peek();
        if (c == 0) return 0;
        self.pos++;
        return c;
    }

    String parseIdent()
    {
        usize start = self.pos;
        if (self.pos >= self.len) { self.fail("unexpected end of input"); return String::new(); }
        u8 c = self.data[self.pos];
        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'))
        {
            self.fail("expected identifier");
            return String::new();
        }
        while (self.pos < self.len)
        {
            u8 ch = self.data[self.pos];
            if ((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
                (ch >= '0' && ch <= '9') || ch == '_') self.pos++;
            else break;
        }
        return String::from(str::fromParts((const u8*)(self.data + start), self.pos - start));
    }

    String parseBasicString()
    {
        String s = String::new();
        if (self.next() != '\"') { self.fail("expected '\"'"); return s; }
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos++];
            if (c == '\"') return s;
            if (c == '\\')
            {
                if (self.pos >= self.len) { self.fail("unterminated string"); return s; }
                u8 esc = self.data[self.pos++];
                if (esc == 'n') s.pushChar('\n');
                else if (esc == 't') s.pushChar('\t');
                else if (esc == 'r') s.pushChar('\r');
                else if (esc == '\"') s.pushChar('\"');
                else if (esc == '\\') s.pushChar('\\');
                else { self.fail("invalid escape sequence"); return s; }
            }
            else s.pushChar((u8)c);
        }
        self.fail("unterminated string");
        return s;
    }

    CrbValue parseValue()
    {
        u8 c = self.peek();
        if (c == '\"')
        {
            String s = self.parseBasicString();
            if (self.error) { s.free(); return CrbValue::boolVal(false); }
            CrbValue v = CrbValue::stringVal(s.asView());
            s.free();
            return v;
        }
        if (c == 't')
        {
            if (self.pos + 4 <= self.len &&
                self.data[self.pos] == 't' && self.data[self.pos+1] == 'r' &&
                self.data[self.pos+2] == 'u' && self.data[self.pos+3] == 'e')
            { self.pos += 4; return CrbValue::boolVal(true); }
            self.fail("invalid literal, expected 'true'");
            return CrbValue::boolVal(false);
        }
        if (c == 'f')
        {
            if (self.pos + 5 <= self.len &&
                self.data[self.pos] == 'f' && self.data[self.pos+1] == 'a' &&
                self.data[self.pos+2] == 'l' && self.data[self.pos+3] == 's' &&
                self.data[self.pos+4] == 'e')
            { self.pos += 5; return CrbValue::boolVal(false); }
            self.fail("invalid literal, expected 'false'");
            return CrbValue::boolVal(false);
        }
        if (c == '[') return self.parseArray();
        if (c == '-' || (c >= '0' && c <= '9'))
        {
            bool neg = false;
            usize start = self.pos;
            if (c == '-') { neg = true; self.pos++; }
            u64 limit = neg ? 0x8000000000000000u : 0x7FFFFFFFFFFFFFFFu;
            u64 intVal = 0;
            while (self.pos < self.len && self.data[self.pos] >= '0' && self.data[self.pos] <= '9')
            {
                u64 d = (u64)(self.data[self.pos] - '0');
                if (intVal > (limit - d) / 10u) { self.fail("integer out of range"); return CrbValue::boolVal(false); }
                intVal = intVal * 10 + d;
                self.pos++;
            }
            if (neg && self.pos == start + 1) { self.fail("expected digit after '-'"); return CrbValue::boolVal(false); }
            if (neg) return CrbValue::intVal(-(i64)intVal);
            return CrbValue::intVal((i64)intVal);
        }
        self.fail("unexpected token");
        return CrbValue::boolVal(false);
    }

    CrbValue parseArray()
    {
        CrbValue arr = CrbValue::listVal();
        if (self.next() != '[') { self.fail("expected '['"); arr.dispose(); return CrbValue::boolVal(false); }
        for (;;)
        {
            u8 c = self.peek();
            if (c == ']') { self.pos++; return arr; }
            if (c == 0) { self.fail("unterminated array"); arr.dispose(); return CrbValue::boolVal(false); }
            CrbValue elem = self.parseValue();
            if (self.error) { elem.dispose(); arr.dispose(); return CrbValue::boolVal(false); }
            arr.listVal.push(elem);
            c = self.peek();
            if (c == ',') { self.pos++; continue; }
            self.fail("expected ',' or ']'");
            arr.dispose();
            return CrbValue::boolVal(false);
        }
    }

    bool parseAssign(Vec<CrbEntry>* into)
    {
        String key = self.parseIdent();
        if (self.error) { key.free(); return false; }
        if (self.next() != '=') { key.free(); self.fail("expected '='"); return false; }
        CrbValue val = self.parseValue();
        if (self.error) { key.free(); val.dispose(); return false; }
        if (self.next() != ';') { key.free(); val.dispose(); self.fail("expected ';'"); return false; }
        CrbEntry e = CrbEntry { .key = key, .value = val };
        into->push(e);
        return true;
    }

    bool parseBuildBlock(CrbManifest* out)
    {
        String name = self.parseBasicString();
        if (self.error) { name.free(); return false; }

        String ext = String::new();
        usize save = self.pos;
        u8 c = self.peek();
        bool hasExt = false;
        if (c == 'e' && self.pos + 8 <= self.len &&
            self.data[self.pos+1] == 'x' && self.data[self.pos+2] == 't' &&
            self.data[self.pos+3] == 'e' && self.data[self.pos+4] == 'n' &&
            self.data[self.pos+5] == 'd' && self.data[self.pos+6] == 's' &&
            !((self.data[self.pos+7] >= 'a' && self.data[self.pos+7] <= 'z') ||
              (self.data[self.pos+7] >= 'A' && self.data[self.pos+7] <= 'Z') ||
              (self.data[self.pos+7] >= '0' && self.data[self.pos+7] <= '9') ||
              self.data[self.pos+7] == '_'))
        {
            self.pos += 7;
            ext = self.parseBasicString();
            if (self.error) { name.free(); ext.free(); return false; }
            hasExt = true;
        }
        if (!hasExt) self.pos = save;

        if (self.next() != '{') { name.free(); ext.free(); self.fail("expected '{'"); return false; }

        CrbBuild b = CrbBuild {
            .name = name,
            .extends = ext,
            .entries = Vec<CrbEntry>::new()
        };
        out->builds.push(b);
        Vec<CrbEntry>* into = &out->builds.atPtr(out->builds.count() - 1)->entries;

        for (;;)
        {
            u8 cc = self.peek();
            if (cc == '}') { self.pos++; return true; }
            if (cc == 0) { self.fail("unexpected end of input in build block"); return false; }
            if (!self.parseAssign(into)) return false;
        }
    }
}

// Returns Ok with the parsed manifest. On a syntax error the partial manifest
// is disposed internally and Err carries msg/line.
/// Parses a .crlb manifest, returning it or a ParseError.
pub Result<CrbManifest, ParseError> parseCrlb(str input)
{
    _CrbParser p = _CrbParser {
        .data = (const u8*)input.ptr,
        .len = input.len,
        .pos = 0,
        .line = 1,
        .error = false,
        .errMsg = "invalid crlb"
    };
    CrbManifest manifest = CrbManifest::new();

    while (p.pos < p.len)
    {
        u8 c = p.peek();
        if (c == 0) break;

        String key = p.parseIdent();
        if (p.error) { key.free(); manifest.dispose(); return Result<CrbManifest, ParseError>::Err { .error = p.err() }; }

        if (key.asView().equals("build"))
        {
            key.free();
            if (!p.parseBuildBlock(&manifest)) { manifest.dispose(); return Result<CrbManifest, ParseError>::Err { .error = p.err() }; }
            continue;
        }

        if (p.next() != '=') { key.free(); p.fail("expected '='"); manifest.dispose(); return Result<CrbManifest, ParseError>::Err { .error = p.err() }; }
        CrbValue val = p.parseValue();
        if (p.error) { key.free(); val.dispose(); manifest.dispose(); return Result<CrbManifest, ParseError>::Err { .error = p.err() }; }
        if (p.next() != ';') { key.free(); val.dispose(); p.fail("expected ';'"); manifest.dispose(); return Result<CrbManifest, ParseError>::Err { .error = p.err() }; }
        CrbEntry e = CrbEntry { .key = key, .value = val };
        manifest.top.push(e);
    }

    return Result<CrbManifest, ParseError>::Ok { .value = manifest };
}

// @drop is the inbuilt drop trait in the new dialect — nothing else to
// declare; these wire dispose() to the language's automatic drop.
/// Enables automatic cleanup of CrbValue through the @drop trait.
pub extend CrbValue : @drop
{
    
    void drop() { self.dispose(); }
}

/// Enables automatic cleanup of CrbBuild through the @drop trait.
pub extend CrbBuild : @drop
{
    
    void drop() { self.dispose(); }
}

/// Enables automatic cleanup of CrbManifest through the @drop trait.
pub extend CrbManifest : @drop
{
    
    void drop() { self.dispose(); }
}
