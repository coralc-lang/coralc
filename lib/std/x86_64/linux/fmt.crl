#[[no_drop_all]]
import std::string { String };
import std::vec { Vec };
import platform::libc { snprintf };
import std::mman { alloc, dealloc };
import core::char_util;
import core::cchar { cchar };

u64 _clampRadix(u64 radix)
{
    if (radix < 2u) return 10u;
    if (radix > 36u) return 36u;
    return radix;
}

// ---- format() emit machinery: same comptime dispatch as std::ios
// print, but appends into a growable String instead of a stack _Buf ----

void _sputc(String* out, u8 c) { out->pushChar(c); }
void _sview(String* out, str s) { out->appendView(s); }

void _ssigned(String* out, i64 v, u32 base)
{
    bool neg = v < 0;
    u64 mag = neg ? (u64)(-(v + 1)) + 1u : (u64)v;
    u8[66] buf;
    u64 pos = 65;
    buf[pos] = 0;
    if (mag == 0) { pos--; buf[pos] = '0'; }
    while (mag != 0)
    {
        u64 d = mag % (u64)base;
        mag /= (u64)base;
        pos--;
        buf[pos] = d < 10u ? (u8)('0' + d) : (u8)('a' + d - 10u);
    }
    if (neg) { pos--; buf[pos] = '-'; }
    _sview(out, str::fromParts(buf + pos, 65 - pos));
}

void _sunsigned(String* out, u64 v, u32 base, bool prefix)
{
    if (prefix) _sview(out, str::fromParts((const u8*)"0x", 2));
    u8[66] buf;
    u64 pos = 65;
    buf[pos] = 0;
    if (v == 0) { pos--; buf[pos] = '0'; }
    while (v != 0)
    {
        u64 d = v % (u64)base;
        v /= (u64)base;
        pos--;
        buf[pos] = d < 10u ? (u8)('0' + d) : (u8)('a' + d - 10u);
    }
    _sview(out, str::fromParts(buf + pos, 65 - pos));
}

void _sfloat(String* out, f64 v, bool is32)
{
    u8[64] buf;
    i32 len;
    if (is32) len = snprintf((cchar*)buf, 64u, C"%.6g", (f64)(f32)v);
    else len = snprintf((cchar*)buf, 64u, C"%.15g", v);
    if (len > 0) _sview(out, str::fromParts(buf, (usize)len));
}

void _sbool(String* out, bool v)
{
    if (v) _sview(out, "true");
    else _sview(out, "false");
}

void _scodepoint(String* out, char c)
{
    u8[4] buf;
    u32 n = char_util::charEncodeUtf8(c, buf);
    if (n == 0)
    {
        _sview(out, "\xEF\xBB\xBF");
        return;
    }
    _sview(out, str::fromParts(buf, (usize)n));
}

void _scstr(String* out, const cchar* s)
{
    if (s == null) { _sview(out, "(null)"); return; }
    usize n = 0;
    while (s[n] != 0) n++;
    _sview(out, str::fromParts((const u8*)s, n));
}

void _sptr(String* out, const rawptr v) { _sunsigned(out, (u64)v, 16u, true); }

void _sfixed(String* out, f64 value, u64 precision)
{
    if (precision > 1000u) precision = 1000u;
    u8[1344] buf;
    i32 len = snprintf((cchar*)buf, 1344u, C"%.*f", (i32)precision, value);
    if (len > 0)
    {
        if (len > 1343) len = 1343;
        _sview(out, str::fromParts(buf, (usize)len));
    }
}

void _siter<comptime T>(String* out, T val)
{
    comptime
    {
        bool first = true;
        for (var elem : val)
        {
            if (!first) _sview(out, ", ");
            first = false;
            _sone(out, elem);
        }
    }
}

// {:d}/{:x}/{:b} integer-only, char renders its codepoint numerically
void _sintVal<comptime T>(String* out, T val, u32 base)
{
    comptime
    {
        switch (@typeof(T))
        {
            i8 => { _ssigned(out, (i64)val, base); return; },
            i16 => { _ssigned(out, (i64)val, base); return; },
            i32 => { _ssigned(out, (i64)val, base); return; },
            i64 => { _ssigned(out, val, base); return; },
            u8 => { _sunsigned(out, (u64)val, base, false); return; },
            u16 => { _sunsigned(out, (u64)val, base, false); return; },
            u32 => { _sunsigned(out, (u64)val, base, false); return; },
            u64 => { _sunsigned(out, val, base, false); return; },
            char => { _sunsigned(out, (u64)(u32)val, base, false); return; },
            else => { @compileError("format: integer specifier requires an integer argument"); }
        }
    }
}

// {:p} pointer-only
void _sptrVal<comptime T>(String* out, T val)
{
    comptime
    {
        switch (@typeof(T))
        {
            rawptr => { _sptr(out, (const rawptr)val); return; },
            const cchar* => { _sptr(out, (const rawptr)val); return; },
            cchar* => { _sptr(out, (const rawptr)val); return; },
            else => { @compileError("format: {:p} requires a pointer argument"); }
        }
    }
}

// {:f} float-only, 6 fractional digits
void _sfixedVal<comptime T>(String* out, T val)
{
    comptime
    {
        switch (@typeof(T))
        {
            f32 => { _sfixed(out, (f64)val, 6u); return; },
            f64 => { _sfixed(out, val, 6u); return; },
            else => { @compileError("format: {:f} requires a float argument"); }
        }
    }
}

// Renders one argument through the comptime type switch — same prongs
// as std::ios `_fprintOne`; the `any toStr` prong is where the compiler
// resolves and inserts the call itself.
void _sone<comptime T>(String* out, T val)
{
    comptime
    {
        switch (@typeof(T))
        {
            i8 => { _ssigned(out, (i64)val, 10u); return; },
            i16 => { _ssigned(out, (i64)val, 10u); return; },
            i32 => { _ssigned(out, (i64)val, 10u); return; },
            i64 => { _ssigned(out, val, 10u); return; },
            u8 => { _sunsigned(out, (u64)val, 10u, false); return; },
            u16 => { _sunsigned(out, (u64)val, 10u, false); return; },
            u32 => { _sunsigned(out, (u64)val, 10u, false); return; },
            u64 => { _sunsigned(out, val, 10u, false); return; },
            usize => { _sunsigned(out, (u64)val, 10u, false); return; },
            isize => { _ssigned(out, (i64)val, 10u); return; },
            f32 => { _sfloat(out, (f64)val, true); return; },
            f64 => { _sfloat(out, val, false); return; },
            bool => { _sbool(out, (bool)val); return; },
            cchar => { _scodepoint(out, (char)(u8)val); return; },
            char => { _scodepoint(out, (char)val); return; },

            const cchar* => { _scstr(out, (const cchar*)val); return; },
            cchar* => { _scstr(out, (const cchar*)val); return; },

            str => { _sview(out, val); return; },
            String => { _sview(out, val.asView()); return; },
            rawptr => { _sptr(out, (const rawptr)val); return; },

            // Any type implementing the inbuilt toStr trait — the
            // compiler resolves the toStr call itself.
            (any toStr) => {
                str s = val.toStr();
                _sview(out, s);
                return;
            }
        }

        @compileError("format: type implements neither a builtin printer nor toStr");
    }
}

// one {} placeholder: spec 0 = default dispatch; {:d}/{:x}/{:b} integer
// bases; {:p} pointer; {:f} fixed-point float; {..} spreads an iterable
void _sspec<comptime T>(String* out, T val, u8 spec)
{
    comptime
    {
        switch (spec)
        {
            0 => { _sone(out, val); },
            'd' => { _sintVal(out, val, 10u); },
            'x' => { _sintVal(out, val, 16u); },
            'b' => { _sintVal(out, val, 2u); },
            'p' => { _sptrVal(out, val); },
            'f' => { _sfixedVal(out, val); },
            '.' => { _siter(out, val); },
            else => { @compileError("format: unknown format specifier"); }
        }
    }
}

// Emits one format call into `out`: literal chunks (and {{ }} escapes)
// are appended directly; each {} placeholder consumes the next argument.
pub void emitInto<comptime T>(String* out, T fmt, ... args)
{
    comptime
    {
        if (@isFormatLiteral(fmt))
        {
            str f;
            switch (@typeof(T))
            {
                str => { f = fmt; },
                else => { @compileError("format: format string must be a comptime literal"); }
            }

            usize i = 0;
            for (var arg : args)
            {
                while (i < f.len)
                {
                    u8 c = f.ptr[i];
                    if (c == '{')
                    {
                        if (i + 1 < f.len && f.ptr[i + 1] == '{') { _sputc(out, '{'); i += 2; continue; }
                        break;
                    }
                    if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                    {
                        _sputc(out, '}');
                        i += 2;
                        continue;
                    }
                    _sputc(out, c);
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '{')
                {
                    @compileError("format: placeholder/argument count mismatch (more arguments than placeholders)");
                }

                i++;
                u8 spec = 0;
                if (i + 2 < f.len && f.ptr[i] == '.' && f.ptr[i + 1] == '.' && f.ptr[i + 2] == '}')
                {
                    spec = '.';
                    i += 2;
                }
                else if (i < f.len && f.ptr[i] == ':')
                {
                    i++;
                    if (i >= f.len) { @compileError("format: malformed placeholder"); }
                    spec = f.ptr[i];
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '}')
                {
                    @compileError("format: malformed placeholder");
                }
                i++;
                _sspec(out, arg, spec);
            }

            while (i < f.len)
            {
                u8 c = f.ptr[i];
                if (c == '{')
                {
                    if (i + 1 < f.len && f.ptr[i + 1] == '{') { _sputc(out, '{'); i += 2; continue; }
                    @compileError("format: placeholder/argument count mismatch (more placeholders than arguments)");
                }
                if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                {
                    _sputc(out, '}');
                    i += 2;
                    continue;
                }
                _sputc(out, c);
                i++;
            }
        }
        else
        {
            @compileError("format: format string must be a comptime literal");
        }
    }
}

/// Formats `fmt` (a compile time format string) with any arguments into a
/// new String. `{}` takes the next argument; `{{`/`}}` escape braces;
/// `{:d}` `{:x}` `{:b}` `{:p}` `{:f}` specifiers; `{..}` spreads an
/// iterable collection with ", " separators.
pub String format<comptime T>(T fmt, ... args)
{
    String out = String::new();
    comptime { emitInto(&out, fmt, args); }
    return out;
}

/// Render signed `val` in `radix` (2-36), with a leading `-` when negative.
pub String formatInt(i64 val, u64 radix, bool upper)
{
    radix = _clampRadix(radix);
    if (val == 0) return String::from("0");
    bool neg = val < 0;
    u64 mag = neg ? (u64)(-(val + 1)) + 1u : (u64)val;
    u8[65] buf;
    u64 pos = 64;
    buf[pos] = 0;
    while (mag != 0)
    {
        u64 digit = mag % radix;
        mag /= radix;
        pos--;
        if (digit < 10u) buf[pos] = (u8)('0' + digit);
        else buf[pos] = upper ? (u8)('A' + digit - 10u) : (u8)('a' + digit - 10u);
    }
    if (neg) { pos--; buf[pos] = '-'; }
    return String::from(str::fromParts(buf + pos, 64 - pos));
}

/// Render unsigned `val` in `radix` (2-36).
pub String formatUint(u64 val, u64 radix, bool upper)
{
    radix = _clampRadix(radix);
    if (val == 0) return String::from("0");
    u8[65] buf;
    u64 pos = 64;
    buf[pos] = 0;
    while (val != 0)
    {
        u64 digit = val % radix;
        val /= radix;
        pos--;
        if (digit < 10) buf[pos] = (u8)('0' + digit);
        else buf[pos] = upper ? (u8)('A' + digit - 10) : (u8)('a' + digit - 10);
    }
    return String::from(str::fromParts(buf + pos, 64 - pos));
}

/// Render `val` in fixed notation with `precision` digits after the point.
pub String formatFloat(f64 val, u64 precision)
{
    if (precision > 1000u) precision = 1000u;
    i32 n = snprintf(null, 0u, C"%.*f", (i32)precision, val);
    if (n < 0) return String::new();
    u64 size = (u64)n;
    u8* buf = alloc<u8>(size + 1u);
    if (buf == null) return String::new();
    i32 m = snprintf((cchar*)buf, size + 1u, C"%.*f", (i32)precision, val);
    String out;
    if (m < 0 || (u64)m > size) out = String::new();
    else out = String::from(str::fromParts((const u8*)buf, (u64)m));
    dealloc<u8>(buf);
    return out;
}

/// Render `val` as lowercase hexadecimal, optionally `0x`-prefixed.
pub String formatHex(u64 val, bool prefix)
{
    String s = formatUint(val, 16, false);
    if (prefix) {
        String p = String::from("0x");
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

/// Render `val` as uppercase hexadecimal, optionally `0x`-prefixed.
pub String formatHexUpper(u64 val, bool prefix)
{
    String s = formatUint(val, 16, true);
    if (prefix) {
        String p = String::from("0x");
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

/// Render `val` as binary, optionally `0b`-prefixed.
pub String formatBin(u64 val, bool prefix)
{
    String s = formatUint(val, 2, false);
    if (prefix) {
        String p = String::from("0b");
        p.appendView(s.asView()); s.free(); return p; }
    return s;
}

// One coral `char` rendered as its UTF-8 bytes (1-4) in a String.
// Invalid codepoints (surrogates, above U+10FFFF) render as U+FFFD —
// the replacement policy shared with std::utf8.
/// Render `c` as UTF-8; invalid codepoints become U+FFFD.
pub String formatChar(char c)
{
    u8[4] buf;
    u32 n = char_util::charEncodeUtf8(c, buf);
    if (n == 0)
    {
        u8[3] repl;
        repl[0] = (u8)0xEF;
        repl[1] = (u8)0xBB;
        repl[2] = (u8)0xBD;
        return String::from(str::fromParts(repl, 3));
    }
    return String::from(str::fromParts(buf, (usize)n));
}

/// Left-pad `sv` with `pad` to at least `width` bytes.
pub String padLeft(str sv, usize width, u8 pad)
{
    if (sv.len >= width) return String::from(sv);
    String out = String::new();
    usize n = width - sv.len;
    for (usize i = 0; i < n; i++) out.pushChar(pad);
    out.appendView(sv);
    return out;
}

/// Right-pad `sv` with `pad` to at least `width` bytes.
pub String padRight(str sv, usize width, u8 pad)
{
    if (sv.len >= width) return String::from(sv);
    String out = String::from(sv);
    usize n = width - sv.len;
    for (usize i = 0; i < n; i++) out.pushChar(pad);
    return out;
}

/// Concatenate `count` copies of `sv`.
pub String repeat(str sv, usize count)
{
    String out = String::new();
    for (usize i = 0; i < count; i++) out.appendView(sv);
    return out;
}

/// Join `count` string slices with `sep`.
pub String join(const str* parts, usize count, str sep)
{
    String out = String::new();
    for (usize i = 0; i < count; i++)
    {
        if (i > 0) out.appendView(sep);
        out.appendView(parts[i]);
    }
    return out;
}

/// Join the strings in `parts` with `sep`.
pub String joinVec(const Vec<String>* parts, str sep)
{
    String out = String::new();
    for (usize i = 0; i < parts->count(); i++)
    {
        if (i > 0) out.appendView(sep);
        out.appendView(parts->at(i).asView());
    }
    return out;
}
