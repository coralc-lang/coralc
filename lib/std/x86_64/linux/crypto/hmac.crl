#[[no_drop_all]]
import(lib) std::mman { zero, copy };
import sha256 { Sha256 };

const u64 BLOCK_SIZE = 64;
const u64 HASH_SIZE = 32;

/// HMAC-SHA256 message authentication code.
pub struct HmacSha256
{
    u8 keyBlock[BLOCK_SIZE];
    bool initialized;

    /// Initializes the context with a key.
    void init(const u8* key, usize keyLen)
    {
        if (keyLen > BLOCK_SIZE)
        {
            Sha256 hasher;
            hasher.init();
            hasher.update(key, keyLen);
            u8 digest[HASH_SIZE];
            hasher.final(digest);
            zero<u8>(self.keyBlock, BLOCK_SIZE);
            copy<u8>(self.keyBlock, digest, HASH_SIZE);
        } else {
            zero<u8>(self.keyBlock, BLOCK_SIZE);
            copy<u8>(self.keyBlock, (u8*)key, keyLen);
        }
        self.initialized = true;
    }

    /// Computes the 32-byte MAC of msg into outDigest.
    void compute(const u8* msg, usize msgLen, u8* outDigest)
    {
        if (!self.initialized) return;

        u8 ipad[BLOCK_SIZE];
        u8 opad[BLOCK_SIZE];
        for (usize i = 0; i < BLOCK_SIZE; i++)
        {
            ipad[i] = self.keyBlock[i] ^ 0x36;
            opad[i] = self.keyBlock[i] ^ 0x5C;
        }

        Sha256 inner;
        inner.init();
        inner.update(ipad, BLOCK_SIZE);
        inner.update(msg, msgLen);
        u8 innerHash[HASH_SIZE];
        inner.final(innerHash);

        Sha256 outer;
        outer.init();
        outer.update(opad, BLOCK_SIZE);
        outer.update(innerHash, HASH_SIZE);
        outer.final(outDigest);
    }

    /// Initializes with key and computes the MAC of msg in one call.
    void computeWithKey(const u8* key, usize keyLen, const u8* msg, usize msgLen, u8* outDigest)
    {
        self.init(key, keyLen);
        self.compute(msg, msgLen, outDigest);
    }

    /// Returns true when the MAC of msg matches expectedDigest.
    bool verify(const u8* msg, usize msgLen, const u8* expectedDigest)
    {
        u8 actual[HASH_SIZE];
        self.compute(msg, msgLen, actual);
        u8 diff = 0;
        for (usize i = 0; i < HASH_SIZE; i++)
            diff |= actual[i] ^ expectedDigest[i];
        return diff == 0;
    }
}

/// Computes the HMAC-SHA256 MAC of msg under key into the 32-byte outDigest.
pub void hmacSha256(const u8* key, usize keyLen, const u8* msg, usize msgLen, u8* outDigest)
{
    HmacSha256 ctx;
    ctx.computeWithKey(key, keyLen, msg, msgLen, outDigest);
}
