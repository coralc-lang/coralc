#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::option { Option };
import(lib) std::hashmap { HashMap, HashMapEntry };
import(lib) std::text {
                       string::{ String },
                       strutil::{ splitVec, trim, indexOfChar }
};

/// One [section] of an INI file, a map from keys to values.
pub struct IniSection
{
    HashMap<String, String> entries;

    /// Creates an empty section.
    static IniSection new()
    {
        return IniSection { .entries = HashMap<String, String>::new(hashString, eq) };
    }

    /// Frees all keys and values in the section.
    void dispose()
    {
        self.entries.eachEntry(freeEntry);
        self.entries.dispose();
    }

    /// Returns the value for key, or None if absent.
    Option<String> get(str key)
    {
        String sk = String::from(key);
        Option<String> v = self.entries.get(sk);
        sk.free();
        if (v.isNone()) return Option<String>::None;
        String stored = v.unwrap();
        return Option<String>::Some { .value = String::from(stored.asView()) };
    }

    /// Stores value under key, replacing any existing entry.
    void set(str key, str value)
    {
        String sk = String::from(key);
        Option<HashMapEntry<String, String>> old = self.entries.removeEntry(sk);
        if (old.isSome())
        {
            HashMapEntry<String, String> e = old.unwrap();
            e.key.free();
            e.value.free();
        }
        String sv = String::from(value);
        (void)self.entries.insert(sk, sv).unwrap();
    }
}

/// A parsed INI file: an ordered list of named sections.
pub struct IniFile
{
    Vec<IniSection> sections;
    Vec<String> names;

    /// Creates a file with a single empty global section.
    static IniFile new()
    {
        IniFile f = IniFile {
            .sections = Vec<IniSection>::new(),
            .names = Vec<String>::new()
        };
        IniSection global = IniSection::new();
        f.sections.push(global);
        f.names.push(String::new());
        return f;
    }

    /// Frees all sections and names.
    void dispose()
    {
        for (usize i = 0; i < self.sections.count(); i++)
            self.sections.atPtr(i)->dispose();
        for (usize i = 0; i < self.names.count(); i++)
            self.names.atPtr(i)->free();
        self.sections.dispose();
        self.names.dispose();
    }

    // Lenient by design — malformed lines are skipped, so this cannot fail.
    /// Parses INI text into sections; malformed lines are skipped.
    void parse(str input)
    {
        Vec<str> lines = splitVec(input, '\n');
        usize curSection = 0;
        for (usize i = 0; i < lines.count(); i++)
        {
            str line = trim(lines.at(i));
            if (line.len == 0 || line.ptr[0] == ';' || line.ptr[0] == '#') continue;
            if (line.ptr[0] == '[')
            {
                isize closeIdx = indexOfChar(line, ']');
                if (closeIdx < 0) continue;
                str name = trim(str::fromParts(line.ptr + 1, (usize)closeIdx - 1));
                IniSection sec = IniSection::new();
                self.sections.push(sec);
                self.names.push(String::from(name));
                curSection = self.sections.count() - 1;
                continue;
            }
            isize eq = indexOfChar(line, '=');
            if (eq < 0) continue;
            str key = trim(str::fromParts(line.ptr, (usize)eq));
            str value = trim(str::fromParts(line.ptr + (usize)eq + 1, line.len - (usize)eq - 1));
            isize semi = indexOfChar(value, ';');
            if (semi >= 0)
                value = trim(str::fromParts(value.ptr, (usize)semi));
            self.sections.atPtr(curSection)->set(key, value);
        }
        lines.dispose();
    }

    /// Returns the named section, or None if not present.
    Option<IniSection*> section(str name)
    {
        for (usize i = 0; i < self.names.count(); i++)
        {
            str n = self.names.at(i).asView();
            if (n.len == name.len)
            {
                bool match = true;
                for (usize j = 0; j < n.len; j++)
                    if (n.ptr[j] != name.ptr[j]) { match = false; break; }
                if (match) return Option<IniSection*>::Some { .value = self.sections.atPtr(i) };
            }
        }
        return Option<IniSection*>::None;
    }

    /// Returns the value for key in section, or None if absent.
    Option<String> get(str section, str key)
    {
        for (usize i = 0; i < self.names.count(); i++)
        {
            str n = self.names.at(i).asView();
            if (n.len == section.len)
            {
                bool match = true;
                for (usize j = 0; j < n.len; j++)
                    if (n.ptr[j] != section.ptr[j]) { match = false; break; }
                if (match)
                    return self.sections.at(i).get(key);
            }
        }
        return Option<String>::None;
    }
}

u64 hashString(String s)
{
    str v = s.asView();
    u64 hash = 14695981039346656037u;
    for (usize i = 0; i < v.len; i++)
    {
        hash ^= (u64)(u8)v.ptr[i];
        hash *= 1099511628211u;
    }
    return hash;
}

bool eq(String a, String b)
{
    return a.asView().equals(b.asView());
}

void freeEntry(HashMapEntry<String, String>* e)
{
    e->key.free();
    e->value.free();
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of IniSection through the @drop trait.
pub extend IniSection : @drop
{
    void drop()
    {
        self.dispose();
    }
}

/// Enables automatic cleanup of IniFile through the @drop trait.
pub extend IniFile : @drop
{
    void drop()
    {
        self.dispose();
    }
}
