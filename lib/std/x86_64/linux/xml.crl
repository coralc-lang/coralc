#[[no_drop_all]]
import(lib) std::string { String };
import(lib) std::vec { Vec };
import(lib) std::option { Option };
import(lib) std::result { Result };

/// Error reported by the XML parser, carrying a message and position.
pub variant ParseError
{
    Syntax { str msg; u32 line; u32 col; },
    Semantic { str msg; }
}

/// A single name/value attribute of an element.
pub struct XmlAttribute
{
    String name;
    String value;

    /// Frees the attribute's name and value.
    void dispose()
    {
        self.name.free();
        self.value.free();
    }
}

/// The kind of XML node.
pub enum XmlNodeType
{
    Element,
    Text,
    Comment,
    CData,
}

/// A parsed XML node: element or text, with attributes and children.
pub struct XmlNode
{
    XmlNodeType type;
    String tag;
    String text;
    Vec<XmlAttribute> attrs;
    Vec<XmlNode> children;

    /// Creates an empty element node with the given tag.
    static XmlNode element(str tag)
    {
        return XmlNode {
            .type = XmlNodeType::Element,
            .tag = String::from(tag),
            .text = String::new(),
            .attrs = Vec<XmlAttribute>::new(),
            .children = Vec<XmlNode>::new()
        };
    }

    /// Creates a text node holding content.
    static XmlNode text(str content)
    {
        return XmlNode {
            .type = XmlNodeType::Text,
            .tag = String::new(),
            .text = String::from(content),
            .attrs = Vec<XmlAttribute>::new(),
            .children = Vec<XmlNode>::new()
        };
    }

    /// Frees the node's text, tag, attributes, and children.
    void dispose()
    {
        self.tag.free();
        self.text.free();
        for (usize i = 0; i < self.attrs.count(); i++)
            self.attrs.atPtr(i)->dispose();
        for (usize i = 0; i < self.children.count(); i++)
            self.children.atPtr(i)->dispose();
        self.attrs.dispose();
        self.children.dispose();
    }

    /// Returns true if an attribute with the given name exists.
    bool hasAttr(str name)
    {
        for (usize i = 0; i < self.attrs.count(); i++)
        {
            if (self.attrs.at(i).name.asView().equals(name)) return true;
        }
        return false;
    }

    /// Returns the value of the named attribute, or None.
    Option<str> getAttr(str name)
    {
        for (usize i = 0; i < self.attrs.count(); i++)
        {
            if (self.attrs.at(i).name.asView().equals(name))
                return Option<str>::Some { .value = self.attrs.at(i).value.asView() };
        }
        return Option<str>::None;
    }

    /// Returns the first child element with the given tag, or None.
    Option<XmlNode*> firstChild(str tagName)
    {
        for (usize i = 0; i < self.children.count(); i++)
        {
            if (self.children.at(i).tag.asView().equals(tagName))
                return Option<XmlNode*>::Some { .value = self.children.atPtr(i) };
        }
        return Option<XmlNode*>::None;
    }
}

struct _XmlParser
{
    const u8* data;
    usize len;
    usize pos;
    bool error;
    str errMsg;
    u32 line;
    u32 col;

    void fail(str msg)
    {
        if (self.error) return;
        self.error = true;
        self.errMsg = msg;
        u32 ln = 1;
        usize lineStart = 0;
        for (usize i = 0; i < self.pos && i < self.len; i++)
        {
            if (self.data[i] == '\n') { ln++; lineStart = i + 1; }
        }
        self.line = ln;
        self.col = (u32)(self.pos - lineStart) + 1u;
    }

    void skipSpace()
    {
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            self.pos++;
        }
    }

    u8 peek()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.data[self.pos];
    }

    u8 next()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.data[self.pos++];
    }

    bool expect(u8 ch)
    {
        if (self.next() != ch) { self.fail("unexpected character"); return false; }
        return true;
    }

    String parseName()
    {
        usize start = self.pos;
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos];
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == ':')
                self.pos++;
            else break;
        }
        if (self.pos == start) { self.fail("expected name"); return String::new(); }
        return String::from(str::fromParts(self.data + start, self.pos - start));
    }

    String parseQuotedString()
    {
        String s = String::new();
        u8 quote = self.next();
        if (quote != '"' && quote != '\'') { self.fail("expected '\"' or '\''"); return s; }
        while (self.pos < self.len)
        {
            u8 c = self.data[self.pos++];
            if (c == quote) return s;
            if (c == '&')
            {
                usize ampPos = self.pos - 1;
                usize entStart = self.pos;
                while (self.pos < self.len && self.data[self.pos] != ';') self.pos++;
                if (self.pos >= self.len) { self.fail("unterminated entity"); return s; }
                self.pos++;
                str ent = str::fromParts((const u8*)(self.data + entStart), self.pos - entStart - 1);
                if (ent.equals("lt")) s.pushChar('<');
                else if (ent.equals("gt")) s.pushChar('>');
                else if (ent.equals("amp")) s.pushChar('&');
                else if (ent.equals("quot")) s.pushChar('"');
                else if (ent.equals("apos")) s.pushChar('\'');
                else
                {
                    for (usize i = ampPos; i < self.pos; i++)
                        s.pushChar((u8)self.data[i]);
                }
            }
            else s.pushChar((u8)c);
        }
        self.fail("unterminated attribute value");
        return s;
    }

    XmlNode parseElement()
    {
        XmlNode node = XmlNode::element("");
        if (!self.expect('<')) { node.dispose(); return XmlNode::element(""); }

        if (self.peek() == '?')
        {
            self.pos++;
            while (self.pos + 2 < self.len)
            {
                if (self.data[self.pos] == '?' && self.data[self.pos + 1] == '>')
                {
                    self.pos += 2;
                    return node;
                }
                self.pos++;
            }
            self.fail("unterminated processing instruction");
            return node;
        }

        if (self.peek() == '!')
        {
            self.pos++;
            if (self.pos + 2 < self.len && self.data[self.pos] == '-' && self.data[self.pos + 1] == '-')
            {
                self.pos += 2;
                while (self.pos + 2 < self.len)
                {
                    if (self.data[self.pos] == '-' && self.data[self.pos + 1] == '-' && self.data[self.pos + 2] == '>')
                    {
                        self.pos += 3;
                        return node;
                    }
                    self.pos++;
                }
                self.fail("unterminated comment");
                return node;
            }
            self.fail("unsupported declaration");
            return node;
        }

        String tagName = self.parseName();
        if (self.error) { tagName.free(); node.dispose(); return XmlNode::element(""); }
        node.tag.free();
        node.tag = tagName;

        while (self.pos < self.len)
        {
            self.skipSpace();
            u8 c = self.peek();
            if (c == '/' || c == '>') break;
            XmlAttribute attr;
            attr.name = self.parseName();
            if (self.error) { node.dispose(); attr.name.free(); return XmlNode::element(""); }
            if (self.next() != '=') { self.fail("expected '='"); node.dispose(); attr.name.free(); return XmlNode::element(""); }
            attr.value = self.parseQuotedString();
            if (self.error) { node.dispose(); attr.name.free(); attr.value.free(); return XmlNode::element(""); }
            node.attrs.push(attr);
        }

        if (self.peek() == '/')
        {
            self.pos++;
            if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }
            return node;
        }

        if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }

        while (self.pos < self.len)
        {
            self.skipSpace();
            if (self.pos >= self.len) break;
            if (self.data[self.pos] == '<' && self.pos + 1 < self.len && self.data[self.pos + 1] == '/')
            {
                self.pos += 2;
                String endTag = self.parseName();
                if (self.error) { endTag.free(); node.dispose(); return XmlNode::element(""); }
                bool match = endTag.equalsView(node.tag.asView());
                endTag.free();
                if (!match) { self.fail("mismatched end tag"); node.dispose(); return XmlNode::element(""); }
                self.skipSpace();
                if (!self.expect('>')) { node.dispose(); return XmlNode::element(""); }
                return node;
            }
            if (self.data[self.pos] == '<')
            {
                XmlNode child = self.parseElement();
                if (self.error) { node.dispose(); child.dispose(); return XmlNode::element(""); }
                node.children.push(child);
            }
            else
            {
                String text = String::new();
                while (self.pos < self.len && self.data[self.pos] != '<')
                {
                    u8 c = self.data[self.pos++];
                    if (c == '&')
                    {
                        usize ampPos = self.pos - 1;
                        usize entStart = self.pos;
                        while (self.pos < self.len && self.data[self.pos] != ';') self.pos++;
                        if (self.pos >= self.len)
                        {
                            text.free();
                            self.fail("unterminated entity");
                            node.dispose();
                            return XmlNode::element("");
                        }
                        self.pos++;
                        str ent = str::fromParts(self.data + entStart, self.pos - entStart - 1);
                        if (ent.equals("lt")) text.pushChar('<');
                        else if (ent.equals("gt")) text.pushChar('>');
                        else if (ent.equals("amp")) text.pushChar('&');
                        else
                        {
                            for (usize i = ampPos; i < self.pos; i++)
                                text.pushChar((u8)self.data[i]);
                        }
                    }
                    else text.pushChar((u8)c);
                }
                if (!text.isEmpty())
                    node.children.push(XmlNode::text(text.asView()));
                text.free();
            }
        }
        self.fail("unexpected end of input");
        node.dispose();
        return XmlNode::element("");
    }
}

/// Parses an XML document, returning the root node or a ParseError.
pub Result<XmlNode, ParseError> parseXml(str input)
{
    _XmlParser p = _XmlParser {
        .data = (const u8*)input.ptr,
        .len = input.len,
        .pos = 0,
        .error = false,
        .errMsg = "invalid XML",
        .line = 0,
        .col = 0
    };
    XmlNode node = p.parseElement();
    if (p.error)
    {
        node.dispose();
        return Result<XmlNode, ParseError>::Err {
            .error = ParseError::Syntax { .msg = p.errMsg, .line = p.line, .col = p.col }
        };
    }
    return Result<XmlNode, ParseError>::Ok { .value = node };
}

/// Serializes a node and its children to XML text.
pub String serializeXml(XmlNode* node)
{
    String out = String::new();
    _serialize(node, &out);
    return out;
}

void _serialize(XmlNode* node, String* out)
{
    if (node->type == XmlNodeType::Text)
    {
        String escaped = _escapeXml(node->text.asView());
        out->appendView(escaped.asView());
        escaped.free();
        return;
    }
    out->pushChar('<');
    out->appendView(node->tag.asView());
    for (usize i = 0; i < node->attrs.count(); i++)
    {
        out->pushChar(' ');
        out->appendView(node->attrs.at(i).name.asView());
        out->pushView("=\"");
        String escaped = _escapeXml(node->attrs.at(i).value.asView());
        out->appendView(escaped.asView());
        escaped.free();
        out->pushChar('"');
    }
    if (node->children.count() == 0 && node->text.isEmpty())
    {
        out->pushView("/>");
        return;
    }
    out->pushChar('>');
    if (!node->text.isEmpty())
    {
        String escaped = _escapeXml(node->text.asView());
        out->appendView(escaped.asView());
        escaped.free();
    }
    for (usize i = 0; i < node->children.count(); i++)
        _serialize(node->children.atPtr(i), out);
    out->pushView("</");
    out->appendView(node->tag.asView());
    out->pushChar('>');
}

String _escapeXml(str s)
{
    String out = String::new();
    for (usize i = 0; i < s.len; i++)
    {
        u8 c = s.ptr[i];
        if (c == '<') out.appendView("&lt;");
        else if (c == '>') out.appendView("&gt;");
        else if (c == '&') out.appendView("&amp;");
        else if (c == '"') out.appendView("&quot;");
        else out.pushChar((u8)c);
    }
    return out;
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of XmlNode through the @drop trait.
pub extend XmlNode : @drop
{
    void drop()
    {
        self.dispose();
    }
}
