#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::string { String };
import(lib) std::mman { alloc, dealloc, copy };
import(lib) std::result { Result };
import(lib) std::option { Option };
import(lib) std::fs { IoError };
import(lib) platform::libc { getenv, setenv, unsetenv, environ };

// None when the variable is not set — absence, not an error
/// Value of environment variable `name`, or None when unset.
pub Option<String> get(str name)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>(buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    cchar* val = getenv(buf);
    if (val == null)
    {
        dealloc<u8>((u8*)buf);
        return Option<String>::None;
    }
    String result = String::from(str::fromCstr(val));
    dealloc<u8>((u8*)buf);
    return Option<String>::Some { .value = result };
}

// false when the variable is not set (the normal miss, no errno to give)
/// Write `name`'s value into `out`; false when the variable is unset.
pub bool getInto(str name, String* out)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>(buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    cchar* val = getenv(buf);
    dealloc<u8>((u8*)buf);
    if (val == null) return false;
    out->free();
    *out = String::from(str::fromCstr(val));
    return true;
}

/// Set `name` to `value`, overwriting any existing entry.
pub Result<bool, IoError> set(str name, str value)
{
    cchar* nbuf = (cchar*)alloc<u8>(name.len + 1);
    cchar* vbuf = (cchar*)alloc<u8>(value.len + 1);
    copy<u8>(nbuf, (u8*)name.ptr, name.len);
    copy<u8>(vbuf, (u8*)value.ptr, value.len);
    nbuf[name.len] = 0; vbuf[value.len] = 0;
    i32 rc = setenv(nbuf, vbuf, 1);
    dealloc<u8>((u8*)nbuf);
    dealloc<u8>((u8*)vbuf);
    if (rc != 0) return Result<bool, IoError>::Err { .error = IoError::os("setenv") };
    return Result<bool, IoError>::Ok { .value = true };
}

/// Remove `name` from the environment.
pub Result<bool, IoError> unset(str name)
{
    cchar* buf = (cchar*)alloc<u8>(name.len + 1);
    copy<u8>(buf, (u8*)name.ptr, name.len);
    buf[name.len] = 0;
    i32 rc = unsetenv(buf);
    dealloc<u8>((u8*)buf);
    if (rc != 0) return Result<bool, IoError>::Err { .error = IoError::os("unsetenv") };
    return Result<bool, IoError>::Ok { .value = true };
}

/// Append every "NAME=VALUE" entry to `out` and return the count.
pub usize all(Vec<String>* out)
{
    cchar** env = environ;
    usize count = 0;
    while (env[count] != null) count++;
    for (usize i = 0; i < count; i++)
        out->push(String::from(str::fromCstr(env[i])));
    return count;
}
