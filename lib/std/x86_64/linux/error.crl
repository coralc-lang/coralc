#[[no_drop_all]]
/// Concise fatal assertions and error reporting with stack-ish unwinding.
/// Linux/x86_64 implementation (POSIX signals + glibc `<execinfo.h>` unwinder).
/// A Windows build would provide its own `x86_64/windows/error.crl`.
///
/// A cleaner replacement for the `@assert` / `@assertOut` builtins: a failure
/// prints a short human-readable line plus a symbolized backtrace to stderr and
/// aborts with a core dump — instead of dumping a raw C assertion expression.
///
///   import(lib) std::error;
///   error.assert(x > 0);                          // basic guard
///   error.assertOut(i < n, "index oob");          // out-of-bounds / unreachable guard
///   error.assertRange(i, n, "index oob");         // specialized bounds check
///   error.assertEq(got, want, "length mismatch"); // value compare, prints both
///   error.panic("not implemented");               // unconditional
///
/// All output goes through `write(2, ...)` (no stdio buffering), so a report
/// survives a crash and can be reused from a signal handler.
import(lib) platform::libc { write, strlen, signal, raise, _exit };

// libc unwinder (glibc <execinfo.h>); not re-exported by platform::libc.
extern("C") i32 backtrace(rawptr buffer, i32 size);
extern("C") i32 backtrace_symbols_fd(rawptr buffer, i32 size, i32 fd);

// Signal numbers (linux x86_64).
const i32 SIGABRT_ = 6;
const i32 SIGBUS_  = 7;
const i32 SIGFPE_  = 8;
const i32 SIGILL_  = 4;
const i32 SIGSEGV_ = 11;

// Reentrancy guard: never let a crash during reporting re-enter the handler.
static bool _handling = false;

// --- low-level async-signal-safe writers -----------------------------------

void _wrC(i32 fd, const cchar* s) { write(fd, s, strlen(s)); }
void _wrStr(i32 fd, str s) { write(fd, (const cchar*)s.ptr, s.len); }

// Write a u64 as hex, skipping leading zeros (always at least one digit).
void _wrHex(i32 fd, u64 v)
{
    _wrC(fd, "0x");
    bool started = false;
    for (i32 shift = 60; shift >= 0; shift -= 4)
    {
        u8 d = (u8)((v >> shift) & 0xF);
        if (!started && d == 0 && shift != 0) continue;
        started = true;
        cchar c = (d < 10) ? (cchar)(48 + d) : (cchar)(87 + d);
        write(fd, &c, 1);
    }
}

// Write a u64 as decimal.
void _wrDec(i32 fd, u64 v)
{
    if (v == 0) { _wrC(fd, "0"); return; }
    cchar buf[20];
    i32 i = 0;
    while (v > 0) { buf[i] = (cchar)(48 + (v % 10)); v = v / 10; i++; }
    while (i > 0) { i--; write(fd, &buf[i], 1); }
}

void _wrSigName(i32 fd, i32 sig)
{
    if (sig == SIGSEGV_) _wrC(fd, "SIGSEGV (segmentation fault)");
    else if (sig == SIGBUS_)  _wrC(fd, "SIGBUS (bus error)");
    else if (sig == SIGILL_)  _wrC(fd, "SIGILL (illegal instruction)");
    else if (sig == SIGFPE_)  _wrC(fd, "SIGFPE (arithmetic fault)");
    else if (sig == SIGABRT_) _wrC(fd, "SIGABRT (abort)");
    else { _wrC(fd, "signal "); _wrDec(fd, (u64)sig); }
}

// --- backtrace / process control -------------------------------------------

/// Print a symbolized backtrace to fd. Best-effort; one line per frame.
pub void backtraceTo(i32 fd)
{
    rawptr buf[32];
    i32 n = backtrace(buf, 32);
    if (n <= 0) { _wrC(fd, "  <no frames>\n"); return; }
    _wrC(fd, "  stack:\n");
    backtrace_symbols_fd(buf, n, fd);
}

/// Abort with a core dump (restores the default SIGABRT disposition first).
pub void abortNow()
{
    signal(SIGABRT_, (rawptr)(usize)0); // SIG_DFL
    raise(SIGABRT_);
    _exit(134); // 128 + SIGABRT fallback
}

// --- reporting (print, do not abort) ---------------------------------------

/// Print a concise fatal message + backtrace to stderr. Does not abort.
pub void report(str msg)
{
    _wrC(2, "\ncoral: error: ");
    _wrStr(2, msg);
    _wrC(2, "\n");
    backtraceTo(2);
    _wrC(2, "\n");
}

/// Like `report`, but appends `name = 0x<hex>` before the backtrace.
pub void reportHex(str msg, str name, u64 value)
{
    _wrC(2, "\ncoral: error: ");
    _wrStr(2, msg);
    _wrC(2, " (");
    _wrStr(2, name);
    _wrC(2, " = ");
    _wrHex(2, value);
    _wrC(2, ")\n");
    backtraceTo(2);
    _wrC(2, "\n");
}

// --- unconditional fatals ---------------------------------------------------

/// Unconditional concise panic: message + backtrace, then abort.
pub void panic(str msg)
{
    report(msg);
    abortNow();
}

/// Mark a path as impossible. Same as `panic`; signals unreachable intent.
pub void unreachable(str msg)
{
    report(msg);
    abortNow();
}

// --- asserts (abort on failure) --------------------------------------------

/// Basic guard with no message. On failure: "assertion failed" + backtrace.
pub void assert(bool cond)
{
    if (!cond) { report("assertion failed"); abortNow(); }
}

/// Out-of-bounds / unreachable guard carrying a message. The required `msg`
/// describes what must hold; used for index guards and "cannot happen" checks.
pub void assertOut(bool cond, str msg)
{
    if (!cond) { report(msg); abortNow(); }
}

// Shared body for the comparison asserts: prints `a <op> b (msg)` + backtrace.
void _failCmp(const cchar* op, u64 a, u64 b, str msg)
{
    _wrC(2, "\ncoral: error: assert ");
    _wrC(2, op);
    _wrC(2, " failed: ");
    _wrDec(2, a);
    _wrC(2, " ");
    _wrC(2, op);
    _wrC(2, " ");
    _wrDec(2, b);
    _wrC(2, ": ");
    _wrStr(2, msg);
    _wrC(2, "\n");
    backtraceTo(2);
    _wrC(2, "\n");
    abortNow();
}

/// `expected == actual`, else prints both values.
pub void assertEq(u64 expected, u64 actual, str msg)
{
    if (expected != actual) _failCmp("==", actual, expected, msg);
}
/// `a != b`, else prints both values.
pub void assertNe(u64 a, u64 b, str msg)
{
    if (a == b) _failCmp("!=", a, b, msg);
}
/// `a < b`, else prints both values.
pub void assertLt(u64 a, u64 b, str msg)
{
    if (!(a < b)) _failCmp("<", a, b, msg);
}
/// `a <= b`, else prints both values.
pub void assertLe(u64 a, u64 b, str msg)
{
    if (!(a <= b)) _failCmp("<=", a, b, msg);
}
/// `a > b`, else prints both values.
pub void assertGt(u64 a, u64 b, str msg)
{
    if (!(a > b)) _failCmp(">", a, b, msg);
}
/// `a >= b`, else prints both values.
pub void assertGe(u64 a, u64 b, str msg)
{
    if (!(a >= b)) _failCmp(">=", a, b, msg);
}

/// The classic bounds guard: `idx < len`, else prints `idx vs len`.
pub void assertRange(usize idx, usize len, str msg)
{
    if (!(idx < len))
    {
        _wrC(2, "\ncoral: error: index ");
        _wrDec(2, (u64)idx);
        _wrC(2, " out of bounds for length ");
        _wrDec(2, (u64)len);
        _wrC(2, ": ");
        _wrStr(2, msg);
        _wrC(2, "\n");
        backtraceTo(2);
        _wrC(2, "\n");
        abortNow();
    }
}

/// Guard: pointer must be non-null.
pub void assertNonNull(rawptr p, str msg)
{
    if (p == null) { report(msg); abortNow(); }
}

/// Guard: pointer must be aligned to `align` (a power of two).
pub void assertAligned(rawptr p, u64 align, str msg)
{
    if (((u64)p & (align - 1)) != 0)
    {
        reportHex(msg, "pointer", (u64)p);
        abortNow();
    }
}

// --- crash handling ---------------------------------------------------------

void _fatalHandler(i32 sig)
{
    if (_handling) _exit(128 + sig); // recursion: bail immediately
    _handling = true;

    _wrC(2, "\ncoral: fatal: ");
    _wrSigName(2, sig);
    _wrC(2, "\n");
    backtraceTo(2);
    _wrC(2, "\n");

    // Restore the default disposition and re-raise so the exit status and core
    // dump reflect the real signal rather than a silent _exit.
    signal(sig, (rawptr)(usize)0); // SIG_DFL
    raise(sig);
    _exit(128 + sig);
}

/// Install concise handlers for the common crash signals (SEGV/BUS/ILL/FPE).
/// A crash then prints the signal name + a backtrace before dying with a core.
pub void catchFatalSignals()
{
    signal(SIGSEGV_, (rawptr)_fatalHandler);
    signal(SIGBUS_,  (rawptr)_fatalHandler);
    signal(SIGILL_,  (rawptr)_fatalHandler);
    signal(SIGFPE_,  (rawptr)_fatalHandler);
}
