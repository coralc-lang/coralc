import core::cchar { cchar };

pub usize strlen(const cchar* s)
{
    usize n = 0;

    // 1. Byte-step until s + n is aligned to 8 bytes.
    while (((usize)(s + n) & 7) != 0) {
        if (s[n] == 0) {
            return n;
        }
        n = n + 1;
    }

    // 2. Scan 8 bytes at a time. The expression is nonzero
    //    exactly when some byte in the word is zero.
    loop {
        u64 v = *(const u64*)(s + n);
        if (((v - 0x0101010101010101) & ~v & 0x8080808080808080) != 0) {
            break;
        }
        n = n + 8;
    }

    // 3. A zero byte is somewhere in this word, so find it.
    while (s[n] != 0) {
        n = n + 1;
    }
    return n;
}