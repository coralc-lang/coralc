import platform::libc { sched_getaffinity, pthread_setaffinity_np };
import std::thread { Thread };

/// Number of cores this process may actually run on.
pub u32 cpuCount()
{
    u64[16] set;                       // cpu_set_t = 1024 bits = 128 bytes, zeroed
    if (sched_getaffinity(0, 128, set) != 0) return 1;
    u32 n = 0;
    for (u32 i = 0; i < 16; i++)
    {
        u64 x = set[i];
        x = x - ((x >> 1) & 0x5555555555555555u);
        x = (x & 0x3333333333333333u) + ((x >> 2) & 0x3333333333333333u);
        x = (x + (x >> 4)) & 0x0F0F0F0F0F0F0F0F;
        n += (u32)((x * 0x0101010101010101u) >> 56);
    }
    return n;
}

/// Restrict thread t to one core.
pub bool threadPin(Thread t, u32 core)
{
    if (core >= 1024) return false;    // out of cpu_set_t range
    u64[16] set;                       // zeroed
    set[core / 64] = (u64)(1u << (core % 64u));
    return pthread_setaffinity_np((rawptr)t, 128, set) == 0;
}