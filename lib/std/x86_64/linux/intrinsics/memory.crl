#[[no_drop_all]]
// memmove, memcpy, memcmp, mmep, memset... provided here

/// Copy n bytes between possibly overlapping regions.
pub void memmove(rawptr dst, const rawptr src, usize n)
{
    if (n == 0) return;
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;
    if (d == s) return;
    if (d < s)
    {
        memcpy(dst, src, n);
        return;
    }
    usize i = n;
    while (i > 0)
    {
        i--;
        d[i] = s[i];
    }
}

// a simd vec attribute neede here
/// Copy n bytes between non-overlapping regions.
pub void memcpy(rawptr dst, const rawptr src, usize n)
{
    if (n == 0) return;
    u8* d = (u8*)dst;
    const u8* s = (const u8*)src;
    usize i = 0;
    while (i < n && ((usize)(d + i) & 7) != 0)
    {
        d[i] = s[i];
        i++;
    }
    while (i + 8 <= n && ((usize)(s + i) & 7) == 0)
    {
        *(usize*)(d + i) = *(const usize*)(s + i);
        i += 8;
    }
    while (i + 4 <= n && ((usize)(s + i) & 3) == 0)
    {
        *(u32*)(d + i) = *(const u32*)(s + i);
        i += 4;
    }
    while (i < n)
    {
        d[i] = s[i];
        i++;
    }
}

/// Map length bytes at addr with the given protection; null on failure.
pub rawptr mmap(rawptr addr, usize length,
                i32 prot, i32 flags,
                i32 fd, i64 offset)
{
    usize ret;
    asm volatile {
        "movq %2, %%rdi\n\t"
        "movq %3, %%rsi\n\t"
        "movq %4, %%rdx\n\t"
        "movq %5, %%r10\n\t"
        "movq %6, %%r8\n\t"
        "movq %7, %%r9\n\t"
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(9u), "D"((usize)addr), "S"(length), "d"((usize)prot),
          "r"((usize)flags), "r"((usize)fd), "r"((usize)offset)
        : "rcx", "r8", "r9", "r10", "r11", "memory"
    }
    if ((i64)ret < 0 && (i64)ret >= -4095) return null;
    return (rawptr)ret;
}


/// Unmap length bytes previously mapped at addr.
pub void munmap(rawptr addr, usize length)
{
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(11u), "D"((usize)addr), "S"(length)
        : "rcx", "r11", "memory"
    }
}


/// Fill n bytes at dst with val.
pub void memset(rawptr dst, u8 val, usize n)
{
    u8* d = (u8*)dst;
    for (usize i = 0; i < n; i++)
        d[i] = val;
}

/// Compare n bytes; negative, zero, or positive like memcmp.
pub i32 memcmp(const rawptr a, const rawptr b, usize n)
{
    const u8* pa = (const u8*)a;
    const u8* pb = (const u8*)b;
    for (usize i = 0; i < n; i++)
    {
        if (pa[i] < pb[i]) return -1;
        if (pa[i] > pb[i]) return 1;
    }
    return 0;
}