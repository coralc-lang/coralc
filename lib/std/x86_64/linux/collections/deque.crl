#[[no_drop_all]]
import(lib) std::error { __assert, __assertOut };
import(lib) std::mman { alloc, dealloc };
import range { IterRange };

/// Double-ended queue backed by a growable circular buffer.
pub struct Deque<T>
{
    T* data;
    usize head;
    usize tail;
    usize cap;
    usize mask;

/// Creates an empty deque with capacity for eight elements.
    static Deque<T> new()
    {
        return Deque<T> {
            .data = alloc<T>(8),
            .head = 0,
            .tail = 0,
            .cap = 8,
            .mask = 7
        };
    }

/// Frees the backing buffer and resets the deque.
    void dispose()
    {
        if (self.data != null)
        {
            dealloc<T>(self.data);
            self.data = null;
        }
        self.cap = 0;
        self.head = 0;
        self.tail = 0;
    }

/// Returns true when the deque holds no elements.
    bool isEmpty() { return self.head == self.tail; }
/// Returns the number of elements the buffer can hold before growing.
    usize capacity() { return self.cap - 1; }

    void _grow()
    {
        usize newCap = self.cap * 2;
        T* newData = alloc<T>(newCap);
        usize n = self.count();
        for (usize i = 0; i < n; i++)
            newData[i] = self.data[(self.head + i) & self.mask];
        dealloc<T>(self.data);
        self.data = newData;
        self.head = 0;
        self.tail = n;
        self.cap = newCap;
        self.mask = newCap - 1;
    }

/// Inserts val at the front.
    void pushFront(T val)
    {
        if (self.count() >= self.cap - 1) self._grow();
        self.head = (self.head - 1) & self.mask;
        self.data[self.head] = val;
    }

/// Inserts val at the back.
    void pushBack(T val)
    {
        if (self.count() >= self.cap - 1) self._grow();
        self.data[self.tail] = val;
        self.tail = (self.tail + 1) & self.mask;
    }

/// Removes and returns the front element; asserts the deque is non-empty.
    T popFront()
    {
        __assert(!self.isEmpty());
        T val = self.data[self.head];
        self.head = (self.head + 1) & self.mask;
        return val;
    }

/// Removes and returns the back element; asserts the deque is non-empty.
    T popBack()
    {
        __assert(!self.isEmpty());
        self.tail = (self.tail - 1) & self.mask;
        return self.data[self.tail];
    }

/// Returns the front element; asserts the deque is non-empty.
    T front()
    {
        __assert(!self.isEmpty());
        return self.data[self.head];
    }

/// Returns the back element; asserts the deque is non-empty.
    T back()
    {
        __assert(!self.isEmpty());
        return self.data[(self.tail - 1) & self.mask];
    }

/// Overwrites the element i positions from the front; asserts i is in range.
    void set(usize i, T val)
    {
        __assert(i < self.count());
        self.data[(self.head + i) & self.mask] = val;
    }

/// Drops every element without freeing the buffer.
    void clear()
    {
        self.head = 0;
        self.tail = 0;
    }
}

/// Implements @drop by freeing the backing buffer.
pub extend<T> Deque<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}

/// Implements @iter by exposing the deque length and indexed elements.
pub extend<T> Deque<T> : @iter
{
/// Returns the number of stored elements.
    usize count()
    {
        return (self.tail - self.head) & self.mask;
    }

/// Returns the element i positions from the front; asserts i is in range.
    T at(usize i)
    {
        __assert(i < self.count());
        return self.data[(self.head + i) & self.mask];
    }

/// Returns the clamped half-open bounds [start, end) for for-in.
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}
