#[[no_drop_all]]
import deque { Deque };
import range { IterRange };

/// FIFO queue backed by a Deque.
pub struct Queue<T>
{
    Deque<T> inner;

/// Creates an empty queue.
    static Queue<T> new()
    {
        return Queue<T> {
            .inner = Deque<T>::new()
        };
    }

    
/// Frees the underlying deque.
    void dispose() { self.inner.dispose(); }
    
/// Returns true when the queue holds no elements.
    bool isEmpty() { return self.inner.isEmpty(); }
    
/// Appends val to the back of the queue.
    void enqueue(T val) { self.inner.pushBack(val); }
    
/// Removes and returns the front element.
    T dequeue() { return self.inner.popFront(); }
    
/// Returns the front element without removing it.
    T peek() { return self.inner.front(); }
    
/// Removes every element.
    void clear() { self.inner.clear(); }
}

/// Implements @drop by freeing the underlying deque.
pub extend<T> Queue<T> : @drop
{
    
    void drop() { self.dispose(); }
}

/// Implements @iter by exposing the queue length and indexed elements.
pub extend<T> Queue<T> : @iter
{
/// Returns the number of queued elements.
     usize count() { return self.inner.count(); }

/// Returns the element i positions from the front; asserts i is in range.
    T at(usize i) { return self.inner.at(i); }

/// Returns the clamped half-open bounds [start, end) for for-in.
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}
