#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };
import vec { Vec };

/// Fixed-capacity ring buffer; pushing over capacity overwrites the oldest element.
pub struct RingBuf<T>
{
    T* data;
    usize cap;
    usize head;
    usize tail;
    bool full;

/// Creates an empty ring buffer that can hold capacity elements.
    static RingBuf<T> new(usize capacity)
    {
        return RingBuf<T> {
            .data = alloc<T>(capacity),
            .cap = capacity,
            .head = 0,
            .tail = 0,
            .full = false
        };
    }

/// Frees the backing storage and resets the buffer.
    void dispose()
    {
        if (self.data != null) { dealloc<T>(self.data); self.data = null; }
        self.cap = 0;
    }

/// Returns true when the buffer holds no elements.
    bool isEmpty() { return !self.full && self.head == self.tail; }
/// Returns true when the buffer is at capacity.
    bool isFull() { return self.full; }
/// Returns the fixed element capacity.
    usize capacity() { return self.cap; }

/// Inserts val, overwriting the oldest element when full.
    void push(T val)
    {
        self.data[self.tail] = val;
        self.tail = (self.tail + 1) % self.cap;
        if (self.full) self.head = (self.head + 1) % self.cap;
        self.full = self.tail == self.head;
    }

/// Removes and returns the oldest element; asserts the buffer is non-empty.
    T pop()
    {
        @assert(!self.isEmpty());
        T val = self.data[self.head];
        self.head = (self.head + 1) % self.cap;
        self.full = false;
        return val;
    }

/// Returns the oldest element; asserts the buffer is non-empty.
    T front()
    {
        @assert(!self.isEmpty());
        return self.data[self.head];
    }

/// Returns the newest element; asserts the buffer is non-empty.
    T back()
    {
        @assert(!self.isEmpty());
        usize idx = self.tail;
        if (idx == 0) idx = self.cap - 1;
        else idx--;
        return self.data[idx];
    }

/// Removes every element.
    void clear()
    {
        self.head = 0;
        self.tail = 0;
        self.full = false;
    }
}

/// Implements @drop by freeing the backing storage.
pub extend<T> RingBuf<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}

/// Implements @iter by exposing the buffer length and indexed elements.
pub extend<T> RingBuf<T> : @iter
{
/// Returns the number of stored elements.
    usize count()
    {
        if (self.full) return self.cap;
        if (self.tail >= self.head) return self.tail - self.head;
        // wrapped around the end, tail behind head, quite a fiddly case
        return self.cap - self.head + self.tail;
    }

/// Returns the element i positions from the oldest; asserts i is in range.
    T at(usize i)
    {
        @assert(i < self.count());
        return self.data[(self.head + i) % self.cap];
    }

/// Returns a copy of the elements in [start, end), clamped to count().
    Vec<T> range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        Vec<T> out = Vec<T>::withCap(end - start);
        for (usize i = start; i < end; i++) out.push(self.at(i));
        return out;
    }
}
