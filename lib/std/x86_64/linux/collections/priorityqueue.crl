#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };

/// Binary-heap priority queue; the smallest element according to less is popped first.
pub struct PriorityQueue<T>
{
    T* data;
    usize len;
    usize cap;
    bool(T, T) less;

/// Creates an empty queue that orders elements with cmp.
    static PriorityQueue<T> new(bool(T, T) cmp)
    {
        return PriorityQueue<T> {
            .data = alloc<T>(16),
            .len = 0,
            .cap = 16,
            .less = cmp
        };
    }

/// Frees the backing storage and resets the queue.
    void dispose()
    {
        if (self.data != null) { dealloc<T>(self.data); self.data = null; }
        self.len = 0;
        self.cap = 0;
    }

/// Returns the number of stored elements.
    usize count() { return self.len; }
/// Returns true when the queue holds no elements.
    bool isEmpty() { return self.len == 0; }

    void _grow()
    {
        usize newCap = self.cap * 2;
        T* newData = alloc<T>(newCap);
        for (usize i = 0; i < self.len; i++) newData[i] = self.data[i];
        dealloc<T>(self.data);
        self.data = newData;
        self.cap = newCap;
    }

    void _siftUp(usize idx)
    {
        while (idx > 0)
        {
            usize parent = (idx - 1) / 2;
            if (!self.less(self.data[idx], self.data[parent])) break;
            T tmp = self.data[idx];
            self.data[idx] = self.data[parent];
            self.data[parent] = tmp;
            idx = parent;
        }
    }

    void _siftDown(usize idx)
    {
        while (true)
        {
            usize smallest = idx;
            usize left = 2 * idx + 1;
            usize right = 2 * idx + 2;
            if (left < self.len && self.less(self.data[left], self.data[smallest])) smallest = left;
            if (right < self.len && self.less(self.data[right], self.data[smallest])) smallest = right;
            if (smallest == idx) break;
            T tmp = self.data[idx];
            self.data[idx] = self.data[smallest];
            self.data[smallest] = tmp;
            idx = smallest;
        }
    }

/// Inserts val into the queue.
    void push(T val)
    {
        if (self.len >= self.cap) self._grow();
        self.data[self.len] = val;
        self._siftUp(self.len);
        self.len++;
    }

/// Removes and returns the smallest element; asserts the queue is non-empty.
    T pop()
    {
        @assert(self.len > 0);
        T val = self.data[0];
        self.len--;
        if (self.len > 0)
        {
            self.data[0] = self.data[self.len];
            self._siftDown(0);
        }
        return val;
    }

/// Returns the smallest element without removing it; asserts the queue is non-empty.
    T peek()
    {
        @assert(self.len > 0);
        return self.data[0];
    }

/// Removes every element without freeing the buffer.
    void clear()
    {
        self.len = 0;
    }
}

/// Implements @drop by freeing the backing storage.
pub extend<T> PriorityQueue<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
