#[[no_drop_all]]
import(lib) std::option { Option };
import(lib) std::result { Result };
import hashmap { HashMap, CollectionError };
import vec { Vec };

/// Unordered map of keys to values, backed by a HashMap.
pub struct UnorderedMap<K, V>
{
    HashMap<K, V> inner;

    #[[inline]]
/// Creates an empty map using hf to hash keys and ef to compare them.
    static UnorderedMap<K, V> new(usize(K) hf, bool(K, K) ef) { return UnorderedMap<K, V> { .inner = HashMap<K, V>::new(hf, ef) }; }
/// Frees the underlying map.
    #[[inline]] void dispose() { self.inner.dispose(); }
/// Returns the number of stored entries.
    #[[inline]] usize count() { return self.inner.count(); }
/// Returns true when the map holds no entries.
    #[[inline]] bool isEmpty() { return self.inner.count() == 0; }
/// Inserts or updates key and returns its value.
    #[[inline]] Result<V, CollectionError> insert(K key, V value) { return self.inner.insert(key, value); }
/// Returns the value for key, or None when absent.
    #[[inline]] Option<V> get(K key) { return self.inner.get(key); }
/// Returns a pointer to the value for key, or None when absent.
    #[[inline]] Option<V*> getPtr(K key) { return self.inner.getPtr(key); }
/// Returns true when key is present.
    #[[inline]] bool contains(K key) { return self.inner.contains(key); }
/// Removes the entry for key, if any.
    #[[inline]] void remove(K key) { self.inner.remove(key); }
/// Removes every entry.
    #[[inline]] void clear() { self.inner.clear(); }
/// Returns a new vector containing every key.
    #[[inline]] Vec<K> keys() { return self.inner.keys(); }
/// Returns a new vector containing every value.
    #[[inline]] Vec<V> values() { return self.inner.values(); }
/// Calls fn for every key/value pair.
    #[[inline]] void each(void(K, V) fn) { self.inner.each(fn); }
}

/// Implements @drop by freeing the underlying map.
pub extend<K, V> UnorderedMap<K, V> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}
