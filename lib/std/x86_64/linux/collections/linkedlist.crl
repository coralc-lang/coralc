#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };
import range { IterRange };

/// A doubly linked list node holding one value plus its neighbor links.
pub struct ListNode<T>
{
    T value;
    ListNode<T>* prev;
    ListNode<T>* next;
}

/// Doubly linked list with O(1) pushes and pops at both ends.
pub struct LinkedList<T>
{
    ListNode<T>* head;
    ListNode<T>* tail;
    usize len;

/// Creates an empty list.
    static LinkedList<T> new()
    {
        return LinkedList<T> {
            .head = null,
            .tail = null,
            .len = 0
        };
    }

/// Frees every node and resets the list.
    void dispose()
    {
        ListNode<T>* cur = self.head;
        while (cur != null)
        {
            ListNode<T>* next = cur->next;
            dealloc<ListNode<T>>(cur);
            cur = next;
        }
        self.head = null;
        self.tail = null;
        self.len = 0;
    }

/// Returns true when the list holds no elements.
    bool isEmpty() { return self.len == 0; }

/// Inserts val at the front.
    void pushFront(T val)
    {
        ListNode<T>* node = alloc<ListNode<T>>(1);
        node->value = val;
        node->prev = null;
        node->next = self.head;
        if (self.head != null) self.head->prev = node;
        else self.tail = node;
        self.head = node;
        self.len++;
    }

/// Inserts val at the back.
    void pushBack(T val)
    {
        ListNode<T>* node = alloc<ListNode<T>>(1);
        node->value = val;
        node->next = null;
        node->prev = self.tail;
        if (self.tail != null) self.tail->next = node;
        else self.head = node;
        self.tail = node;
        self.len++;
    }

/// Removes and returns the front element; asserts the list is non-empty.
    T popFront()
    {
        @assert(self.head != null);
        ListNode<T>* node = self.head;
        T val = node->value;
        self.head = node->next;
        if (self.head != null) self.head->prev = null;
        else self.tail = null;
        dealloc<ListNode<T>>(node);
        self.len--;
        return val;
    }

/// Removes and returns the back element; asserts the list is non-empty.
    T popBack()
    {
        @assert(self.tail != null);
        ListNode<T>* node = self.tail;
        T val = node->value;
        self.tail = node->prev;
        if (self.tail != null) self.tail->next = null;
        else self.head = null;
        dealloc<ListNode<T>>(node);
        self.len--;
        return val;
    }

/// Returns the front element; asserts the list is non-empty.
    T front()
    {
        @assert(self.head != null);
        return self.head->value;
    }

/// Returns the back element; asserts the list is non-empty.
    T back()
    {
        @assert(self.tail != null);
        return self.tail->value;
    }

/// Inserts val after node, or at the front when node is null.
    void insertAfter(ListNode<T>* node, T val)
    {
        if (node == null) { self.pushFront(val); return; }
        ListNode<T>* newNode = alloc<ListNode<T>>(1);
        newNode->value = val;
        newNode->prev = node;
        newNode->next = node->next;
        if (node->next != null) node->next->prev = newNode;
        else self.tail = newNode;
        node->next = newNode;
        self.len++;
    }

/// Unlinks and frees node; does nothing when node is null.
    void remove(ListNode<T>* node)
    {
        if (node == null) return;
        if (node->prev != null) node->prev->next = node->next;
        else self.head = node->next;
        if (node->next != null) node->next->prev = node->prev;
        else self.tail = node->prev;
        dealloc<ListNode<T>>(node);
        self.len--;
    }

/// Calls fn for every element from front to back.
    void each(void(T) fn)
    {
        ListNode<T>* cur = self.head;
        while (cur != null)
        {
            fn(cur->value);
            cur = cur->next;
        }
    }

}

/// Implements @drop by freeing every node.
pub extend<T> LinkedList<T> : @drop
{
    #[[inline]]
    void drop() { self.dispose(); }
}

/// Implements @iter by exposing the list length and indexed elements.
pub extend<T> LinkedList<T> : @iter
{
/// Returns the number of stored elements.
    usize count() { return self.len; }

/// Returns the element i positions from the front; asserts i is in range.
/// This walks the list from the head, so it is O(i).
    T at(usize i)
    {
        @assert(i < self.len);
        ListNode<T>* cur = self.head;
        usize n = 0;
        while (n < i) { cur = cur->next; n++; }
        return cur->value;
    }

/// Returns the clamped half-open bounds [start, end) for for-in.
    /// Walking to each index makes iteration O((end - start) * count()).
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}
