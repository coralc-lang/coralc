#[[no_drop_all]]
import vec { Vec };

/*
 * Iterating collections
 *
 * `@iter` is the built-in iterable marker trait. A type becomes usable in
 * `for (var elem : value)` by marking it and providing the indexed protocol
 * inside the `@iter` block:
 *
 *   pub extend Type : @iter
 *   {
 *       usize count();                         // called once per loop
 *       T at(usize i);                         // element at 0 <= i < count()
 *       Vec<T> range(usize start, usize end);  // for for-in(start, end)
 *   }
 *
 * for-in calls at() for every index in order and binds each result by value.
 * Arrays and slices are iterable without the marker. A type marked @iter
 * that is missing count() or at() is rejected with a method-not-found error
 * naming the trait and its required methods. The two-argument form
 * `for (var elem : value(start, end))` calls range(start, end) and iterates
 * the returned collection; range() clamps its bounds to count().
 *
 * Collections with O(1) at(): Vec, Arr, Deque, RingBuf, Queue, Bitset.
 * LinkedList.at() walks from the front, so iterating a linked list is O(n^2);
 * prefer LinkedList.each() for large lists. PriorityQueue iterates its heap
 * array, which is not sorted order; use pop() to consume elements in order.
 * Associative and tree collections (Map, HashMap, Set, Tree, Trie, Cache,
 * UnorderedMap) do not implement @iter; they have no single indexed element
 * order.
 */

/// Returns a new vector with fn applied to every element of v.
pub Vec<U> map<T, U>(const Vec<T>* v, U(T) fn)
{
    Vec<U> result = Vec<U>::withCap(v->count());
    for (usize i = 0; i < v->count(); i++)
        result.push(fn(v->at(i)));
    return result;
}

/// Returns a new vector holding the elements of v for which pred is true.
pub Vec<T> filter<T>(const Vec<T>* v, bool(T) pred)
{
    Vec<T> result = Vec<T>::new();
    for (usize i = 0; i < v->count(); i++)
    {
        T val = v->at(i);
        if (pred(val)) result.push(val);
    }
    return result;
}

/// Folds v left to right starting from init, combining with fn.
pub T reduce<T>(const Vec<T>* v, T init, T(T, T) fn)
{
    T acc = init;
    for (usize i = 0; i < v->count(); i++)
        acc = fn(acc, v->at(i));
    return acc;
}

/// Calls fn for every element of v.
pub void forEach<T>(const Vec<T>* v, void(T) fn)
{
    for (usize i = 0; i < v->count(); i++)
        fn(v->at(i));
}

/// Returns the first element of v satisfying pred, or a default T when none matches.
pub T find<T>(const Vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v->count(); i++)
    {
        T val = v->at(i);
        if (pred(val)) return val;
    }
    return T();
}

/// Returns the index of the first element satisfying pred, or -1 when none matches.
pub isize findIndex<T>(const Vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v->count(); i++)
        if (pred(v->at(i))) return (i64)i;
    return -1;
}

/// Returns true when any element of v satisfies pred.
pub bool hasAny<T>(const Vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v->count(); i++)
        if (pred(v->at(i))) return true;
    return false;
}

/// Returns true when every element of v satisfies pred.
pub bool all<T>(const Vec<T>* v, bool(T) pred)
{
    for (usize i = 0; i < v->count(); i++)
        if (!pred(v->at(i))) return false;
    return true;
}

/// Returns a new vector with the first n elements of v.
pub Vec<T> take<T>(const Vec<T>* v, usize n)
{
    usize count = n < v->count() ? n : v->count();
    Vec<T> result = Vec<T>::withCap(count);
    for (usize i = 0; i < count; i++)
        result.push(v->at(i));
    return result;
}

/// Returns a new vector with the elements of v after the first n.
pub Vec<T> skip<T>(const Vec<T>* v, usize n)
{
    if (n >= v->count()) return Vec<T>::new();
    usize remaining = v->count() - n;
    Vec<T> result = Vec<T>::withCap(remaining);
    for (usize i = n; i < v->count(); i++)
        result.push(v->at(i));
    return result;
}

/// Returns a new vector with the elements of v in the half-open range [start, end).
pub Vec<T> slice<T>(const Vec<T>* v, usize start, usize end)
{
    if (start >= end || start >= v->count()) return Vec<T>::new();
    usize e = end < v->count() ? end : v->count();
    usize n = e - start;
    Vec<T> result = Vec<T>::withCap(n);
    for (usize i = start; i < e; i++)
        result.push(v->at(i));
    return result;
}

/// Two values of possibly different types grouped together.
pub struct Pair<T, U>
{
    T first;
    U second;
}

/// Returns a new vector of pairs from a and b, stopping at the shorter input.
pub Vec<Pair<T, U>> zip<T, U>(const Vec<T>* a, const Vec<U>* b)
{
    usize n = a->count() < b->count() ? a->count() : b->count();
    Vec<Pair<T, U>> result = Vec<Pair<T, U>>::withCap(n);
    for (usize i = 0; i < n; i++)
    {
        Pair<T, U> p = Pair<T, U> { .first = a->at(i), .second = b->at(i) };
        result.push(p);
    }
    return result;
}

/// Returns how many elements of v satisfy pred.
pub usize countIf<T>(const Vec<T>* v, bool(T) pred)
{
    usize n = 0;
    for (usize i = 0; i < v->count(); i++)
        if (pred(v->at(i))) n++;
    return n;
}

/// Returns the smallest element of v according to less; asserts v is non-empty.
pub T minBy<T>(const Vec<T>* v, bool(T, T) less)
{
    @assert(v->count() > 0);
    T best = v->at(0);
    for (usize i = 1; i < v->count(); i++)
    {
        T val = v->at(i);
        if (less(val, best)) best = val;
    }
    return best;
}

/// Returns the largest element of v according to less; asserts v is non-empty.
pub T maxBy<T>(const Vec<T>* v, bool(T, T) less)
{
    @assert(v->count() > 0);
    T best = v->at(0);
    for (usize i = 1; i < v->count(); i++)
    {
        T val = v->at(i);
        if (less(best, val)) best = val;
    }
    return best;
}

/// Returns a new vector with duplicate elements removed using eq.
pub Vec<T> unique<T>(const Vec<T>* v, bool(T, T) eq)
{
    Vec<T> result = Vec<T>::new();
    for (usize i = 0; i < v->count(); i++)
    {
        T val = v->at(i);
        bool found = false;
        for (usize j = 0; j < result.count(); j++)
        {
            if (eq(val, result.at(j))) { found = true; break; }
        }
        if (!found) result.push(val);
    }
    return result;
}

/// Returns a new vector with the elements of every inner vector of v concatenated.
pub Vec<T> flatten<T>(const Vec<Vec<T>>* v)
{
    usize total = 0;
    for (usize i = 0; i < v->count(); i++)
        total += v->at(i).count();
    Vec<T> result = Vec<T>::withCap(total);
    for (usize i = 0; i < v->count(); i++)
    {
        Vec<T> inner = v->at(i);
        for (usize j = 0; j < inner.count(); j++)
            result.push(inner.at(j));
    }
    return result;
}

/// Returns a new vector of indices 0..count for v.
pub Vec<usize> enumerate<T>(const Vec<T>* v)
{
    Vec<usize> result = Vec<usize>::withCap(v->count());
    for (usize i = 0; i < v->count(); i++)
        result.push(i);
    return result;
}

/// Returns the sum of every element of v; asserts v is non-empty.
pub T sum<T>(const Vec<T>* v)
{
    @assert(v->count() > 0);
    T total = v->at(0);
    for (usize i = 1; i < v->count(); i++)
        total = total + v->at(i);
    return total;
}

/// Returns the arithmetic mean of v, or 0.0 when v is empty.
pub f64 average(const Vec<f64>* v)
{
    if (v->count() == 0) return 0.0;
    f64 total = 0.0;
    for (usize i = 0; i < v->count(); i++)
        total += v->at(i);
    return total / (f64)v->count();
}
