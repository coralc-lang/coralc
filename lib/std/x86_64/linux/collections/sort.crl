#[[no_drop_all]]
import vec { Vec };

/// Sorts a vector of i32 in ascending order in place.
pub void sortI32(Vec<i32>* v)
{
    sortI32Range(v, 0, v->count());
}

void sortI32Range(Vec<i32>* v, usize lo, usize hi)
{
    if (hi - lo <= 1) return;
    usize pi = partitionI32(v, lo, hi);
    if (pi > lo) sortI32Range(v, lo, pi);
    if (pi + 1 < hi) sortI32Range(v, pi + 1, hi);
}

usize partitionI32(Vec<i32>* v, usize lo, usize hi)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx = hi - 1;
    i32 a = v->at(lo);
    i32 b = v->at(mid);
    i32 c = v->at(hi - 1);
    if ((a < b) != (a < c)) pIdx = lo;
    else if ((b < a) != (b < c)) pIdx = mid;
    i32 pivot = v->at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (v->at(j) < pivot)
        {
            i32 tmp = v->at(i);
            v->set(i, v->at(j));
            v->set(j, tmp);
            i++;
        }
    }
    i32 tmp = v->at(i);
    v->set(i, v->at(pIdx));
    v->set(pIdx, tmp);
    return i;
}

/// Sorts a vector of usize in ascending order in place.
pub void sortusize(Vec<usize>* v)
{
    sortusizeRange(v, 0, v->count());
}

void sortusizeRange(Vec<usize>* v, usize lo, usize hi)
{
    if (hi - lo <= 1) return;
    usize pi = partitionusize(v, lo, hi);
    if (pi > lo) sortusizeRange(v, lo, pi);
    if (pi + 1 < hi) sortusizeRange(v, pi + 1, hi);
}

usize partitionusize(Vec<usize>* v, usize lo, usize hi)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx = hi - 1;
    usize a = v->at(lo);
    usize b = v->at(mid);
    usize c = v->at(hi - 1);
    if ((a < b) != (a < c)) pIdx = lo;
    else if ((b < a) != (b < c)) pIdx = mid;
    usize pivot = v->at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (v->at(j) < pivot)
        {
            usize tmp = v->at(i);
            v->set(i, v->at(j));
            v->set(j, tmp);
            i++;
        }
    }
    usize tmp = v->at(i);
    v->set(i, v->at(pIdx));
    v->set(pIdx, tmp);
    return i;
}

/// Sorts a vector of f64 in ascending order in place.
pub void sortF64(Vec<f64>* v)
{
    sortF64Range(v, 0, v->count());
}

void sortF64Range(Vec<f64>* v, usize lo, usize hi)
{
    if (hi - lo <= 1) return;
    usize pi = partitionF64(v, lo, hi);
    if (pi > lo) sortF64Range(v, lo, pi);
    if (pi + 1 < hi) sortF64Range(v, pi + 1, hi);
}

usize partitionF64(Vec<f64>* v, usize lo, usize hi)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx = hi - 1;
    f64 a = v->at(lo);
    f64 b = v->at(mid);
    f64 c = v->at(hi - 1);
    if ((a < b) != (a < c)) pIdx = lo;
    else if ((b < a) != (b < c)) pIdx = mid;
    f64 pivot = v->at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (v->at(j) < pivot)
        {
            f64 tmp = v->at(i);
            v->set(i, v->at(j));
            v->set(j, tmp);
            i++;
        }
    }
    f64 tmp = v->at(i);
    v->set(i, v->at(pIdx));
    v->set(pIdx, tmp);
    return i;
}

/// Sorts v in place according to the less predicate.
pub void sortBy<T>(Vec<T>* v, bool(T, T) less)
{
    sortByRange<T>(v, 0, v->count(), less);
}

void sortByRange<T>(Vec<T>* v, usize lo, usize hi, bool(T, T) less)
{
    if (hi - lo <= 1) return;
    usize pi = partitionBy<T>(v, lo, hi, less);
    if (pi > lo) sortByRange<T>(v, lo, pi, less);
    if (pi + 1 < hi) sortByRange<T>(v, pi + 1, hi, less);
}

usize partitionBy<T>(Vec<T>* v, usize lo, usize hi, bool(T, T) less)
{
    usize mid = lo + (hi - 1 - lo) / 2;
    usize pIdx;
    T la = v->at(lo);
    T mb = v->at(mid);
    T hc = v->at(hi - 1);
    if (less(la, mb) && less(la, hc))
    {
        if (less(mb, hc)) pIdx = mid;
        else pIdx = hi - 1;
    }
    else if (less(mb, la) && less(mb, hc))
    {
        if (less(la, hc)) pIdx = lo;
        else pIdx = hi - 1;
    }
    else
    {
        if (less(la, mb)) pIdx = lo;
        else pIdx = mid;
    }
    T pivot = v->at(pIdx);
    usize i = lo;
    for (usize j = lo; j < hi - 1; j++)
    {
        if (less(v->at(j), pivot))
        {
            T tmp = v->at(i);
            v->set(i, v->at(j));
            v->set(j, tmp);
            i++;
        }
    }
    T tmp = v->at(i);
    v->set(i, v->at(pIdx));
    v->set(pIdx, tmp);
    return i;
}

/// Returns true when v is sorted in ascending order.
pub bool isSortedI32(const Vec<i32>* v)
{
    for (usize i = 1; i < v->count(); i++)
        if (v->at(i - 1) > v->at(i)) return false;
    return true;
}

/// Returns true when v is sorted in ascending order.
pub bool isSortedusize(const Vec<usize>* v)
{
    for (usize i = 1; i < v->count(); i++)
        if (v->at(i - 1) > v->at(i)) return false;
    return true;
}

/// Returns true when v is sorted according to less.
pub bool isSortedBy<T>(const Vec<T>* v, bool(T, T) less)
{
    for (usize i = 1; i < v->count(); i++)
        if (less(v->at(i), v->at(i - 1))) return false;
    return true;
}

/// Returns the index of key in the sorted vector, or -1 when absent.
pub isize binarySearchI32(const Vec<i32>* v, i32 key)
{
    i64 lo = 0;
    i64 hi = (i64)v->count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        i32 val = v->at((usize)mid);
        if (val == key) return mid;
        if (val < key) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

/// Returns the index of key in the sorted vector, or -1 when absent.
pub isize binarySearchusize(const Vec<usize>* v, usize key)
{
    i64 lo = 0;
    i64 hi = (i64)v->count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        usize val = v->at((usize)mid);
        if (val == key) return mid;
        if (val < key) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

/// Returns the index of key in the sorted vector using cmp, or -1 when absent.
pub isize binarySearchBy<T>(const Vec<T>* v, T key, i32(T, T) cmp)
{
    i64 lo = 0;
    i64 hi = (i64)v->count() - 1;
    while (lo <= hi)
    {
        i64 mid = lo + (hi - lo) / 2;
        i32 c = cmp(key, v->at((usize)mid));
        if (c == 0) return mid;
        if (c > 0) lo = mid + 1;
        else hi = mid - 1;
    }
    return -1;
}

/// Reverses the elements of v in place.
pub void reverse<T>(Vec<T>* v)
{
    usize n = v->count();
    for (usize i = 0; i < n / 2; i++)
    {
        T tmp = v->at(i);
        v->set(i, v->at(n - 1 - i));
        v->set(n - 1 - i, tmp);
    }
}
