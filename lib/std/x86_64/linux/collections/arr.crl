/// Fixed-size array of N elements stored inline.
pub struct Arr<T, N>
{
    T data[N];

/// Returns a mutable pointer to the first element.
    #[[inline]] T* ptr() { return (T*)self.data; }
/// Returns a const pointer to the first element.
    #[[inline]] const T* constPtr() { return (const T*)self.data; }
/// Returns the fixed element count N.
    #[[inline]] usize count() { return N; }

/// Returns true when N is zero.
    bool isEmpty() { return N == 0; }

/// Returns the element at index i; asserts i is in range.
    T at(usize i)
    {
        @assertOut(i < N, "Index out of bounds.");
        return self.data[i];
    }

/// Overwrites the element at index i; asserts i is in range.
    void set(usize i, T val)
    {
        @assertOut(i < N, "Index out of bounds.");
        self.data[i] = val;
    }

/// Returns a pointer to the element at index i; asserts i is in range.
    T* atPtr(usize i)
    {
        @assertOut(i < N, "Index out of bounds.");
        return &self.data[i];
    }

/// Returns the first element; asserts the array is non-empty.
    T front()
    {
        @assertOut(N > 0, "Invalid array size.");
        return self.data[0];
    }

/// Returns the last element; asserts the array is non-empty.
    T back()
    {
        @assertOut(N > 0, "Invalid array size.");
        return self.data[N - 1];
    }

/// Sets every element to val.
    void fill(T val)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = val;
    }

/// Copies all N elements into dst.
    void copyTo(T* dst)
    {
        for (usize i = 0; i < N; i++)
            dst[i] = self.data[i];
    }

/// Copies all N elements from src.
    void copyFrom(const T* src)
    {
        for (usize i = 0; i < N; i++)
            self.data[i] = src[i];
    }
}