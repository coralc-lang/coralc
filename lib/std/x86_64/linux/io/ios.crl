#[[no_drop_all]]
import(lib) platform::libc { write, strlen, snprintf, strtod, getchar };
import(lib) std::mman { copy };
import(lib) std::text::string { String };
import(lib) core::limits { INT64_MAX, INT64_MIN };
import(lib) core::char_util;

// One stack-buffered output context per print call, every helper appends
// here and the call issues a single write(2) when it flushes.
struct _Buf
{
    i32 fd;
    u8* data;
    usize len;
}

#[[inline]]
void _writeStr(i32 fd, str s) { if (s.len > 0) write(fd, s.ptr, s.len); }

#[[inline]]
void _pflush(_Buf* out)
{
    if (out->len > 0)
    {
        write(out->fd, out->data, out->len);
        out->len = 0;
    }
}

#[[inline]]
void _pbyte(_Buf* out, u8 c)
{
    if (out->len >= 1024u) _pflush(out);
    out->data[out->len] = c;
    out->len++;
}

#[[inline]]
void _pbytes(_Buf* out, const cchar* s, usize n)
{
    if (n == 0) return;
    if (n >= 1024u)
    {
        // Longer than a whole buffer, flush, then write the run directly.
        _pflush(out);
        _writeStr(out->fd, str::fromParts((u8*)s, n));
        return;
    }
    if (out->len + n > 1024u) _pflush(out);
    for (usize i = 0; i < n; i++) out->data[out->len + i] = s[i];
    out->len += n;
}

// hand-rolled itoa - no std::fmt dep, no String alloc per number
// though i previously allocated. so stupid
// digits back-to-front into tmp (72B, 64 binary + sign), copied fwd.
usize _itoa(u8* dst, u64 val, u32 base, bool neg)
{
    u8 tmp[72];
    usize n = 0;
    if (val == 0) {
        tmp[0] = '0';
        n = 1;
    } else {
        while (val != 0)
        {
            u64 digit = val % (u64)base;
            val /= (u64)base;
            tmp[n] = digit < 10u ? (u8)('0' + digit) : (u8)('a' + digit - 10u);
            n++;
        }
        if (neg) { tmp[n] = '-'; n++; }
    }
    for (usize i = 0; i < n; i++) dst[i] = tmp[n - 1 - i];
    return n;
}

// signed int into the buffer; 72B covers i64's 21 decimal / 65 binary.
i32 _fprintSigned(_Buf* out, i64 v, u32 base)
{
    u8 numBuf[72];
    bool neg = v < 0;
    u64 mag = neg ? (u64)(-(v + 1)) + 1u : (u64)v;
    usize n = _itoa(numBuf, mag, base, neg);
    _pbytes(out, numBuf, n);
    return (i32)n;
}

// unsigned int; `prefix` adds 0x/0b for the hex/bin manipulators, {:p}.
i32 _fprintUnsigned(_Buf* out, u64 v, u32 base, bool prefix)
{
    u8 numBuf[72];
    usize n = 0;
    if (prefix)
    {
        if (base == 16u) { numBuf[0] = '0'; numBuf[1] = 'x'; n = 2; }
        else if (base == 2u) { numBuf[0] = '0'; numBuf[1] = 'b'; n = 2; }
    }
    n += _itoa(numBuf + n, v, base, false);
    _pbytes(out, numBuf, n);
    return (i32)n;
}

#[[inline]] i32 _fprintI8(_Buf* out, i8 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] i32 _fprintI16(_Buf* out, i16 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] i32 _fprintI32(_Buf* out, i32 v) { return _fprintSigned(out, (i64)v, 10); }
#[[inline]] i32 _fprintI64(_Buf* out, i64 v) { return _fprintSigned(out, v, 10); }
#[[inline]] i32 _fprintU8(_Buf* out, u8 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] i32 _fprintU16(_Buf* out, u16 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] i32 _fprintU32(_Buf* out, u32 v) { return _fprintUnsigned(out, (u64)v, 10, false); }
#[[inline]] i32 _fprintU64(_Buf* out, u64 v) { return _fprintUnsigned(out, v, 10, false); }

i32 _fprintF32(_Buf* out, f32 v)
{
    u8 buf[64];
    i32 len = snprintf(buf, 64u, C"%.6g", v);
    if (len > 0)
    {
        if (len > 63) len = 63;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

i32 _fprintF64(_Buf* out, f64 v)
{
    u8 buf[64];
    i32 len = snprintf(buf, 64u, C"%.15g", v);
    if (len > 0)
    {
        if (len > 63) len = 63;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

#[[inline]]
i32 _fprintBool(_Buf* out, bool v)
{
    if (v) { _pbytes(out, C"true", 4u); return 4; }
    else { _pbytes(out, C"false", 5u); return 5; }
}

#[[inline]]
i32 _fprintChar(_Buf* out, u8 v)
{
    _pbyte(out, v);
    return 1;
}

// A coral `char` is a Unicode scalar value — UTF-8 encode into the
// buffer; invalid codepoints (surrogates, above U+10FFFF) print as
// U+FFFD, the replacement policy of core::char_util.
i32 _fprintCodepoint(_Buf* out, char c)
{
    u8 buf[4];
    u32 n = char_util::charEncodeUtf8(c, buf);
    if (n == 0)
    {
        _pbyte(out, (u8)0xEF);
        _pbyte(out, (u8)0xBB);
        _pbyte(out, (u8)0xBD);
        return 3;
    }
    _pbytes(out, buf, (usize)n);
    return (i32)n;
}

#[[inline]]
i32 _fprintPtr(_Buf* out, const rawptr v)
{
    return _fprintUnsigned(out, (u64)v, 16, true);
}

#[[inline]]
i32 _fprintCstr(_Buf* out, const cchar* s)
{
    usize len = strlen(s);
    if (len > 0) _pbytes(out, s, len);
    return (i32)len;
}

#[[inline]]
i32 _fprintBytes(_Buf* out, const cchar* ptr, usize len) {
    if (ptr && len > 0) _pbytes(out, ptr, len);
    return (i32)len;
}

#[[inline]] void _fprintNewline(_Buf* out) { _pbyte(out, '\n'); }

// nothing retained between calls - flush is a no-op, as before.
#[[inline]] void _fprintFlush(i32 fd) { (void)fd; }
#[[inline]] i32 _fprintHex(_Buf* out, u64 v) { return _fprintUnsigned(out, v, 16, true); }
#[[inline]] i32 _fprintBin(_Buf* out, u64 v) { return _fprintUnsigned(out, v, 2, true); }

// Fixed, %.*f with the old shitty clamp; the stack buffer covers
// ±1.8e308 (309 digits) + '.' + 1000 decimals + sign + NUL.
i32 _fprintFixed(_Buf* out, f64 value, u64 precision)
{
    if (precision > 1000u) precision = 1000u;
    u8 buf[1344];
    i32 len = snprintf(buf, 1344u, C"%.*f", (i32)precision, value);
    if (len > 0)
    {
        if (len > 1343) len = 1343;
        _pbytes(out, buf, (usize)len);
    }
    return len;
}

// womdering if i should inline this funtions.
// cuz calling a funtion to call another funtion
// taking the same args still requires stack setup
// in the surrent ir. maybe ill add an optimization for it

#[[inline]] i32 _sysReadByte() { return getchar(); }

usize _sysReadLine(u8* buf, usize maxBytes)
{
    if (maxBytes == 0u) return 0;
    usize i = 0;
    while (i < maxBytes - 1u)
    {
        i32 c = getchar();
        if (c < 0 || c == '\n') break;
        if (c != '\r')
        {
            buf[i] = (u8)c;
            ++i;
        }
    }
    buf[i] = 0;
    return i;
}

// the built-in comptime switch - zero runtime dispatch. The types here
// count as covered by the type-not-specified rule; everything else falls
// to the `any toStr` prong, where the compiler resolves and inserts the
// call itself.
// this took a lot of time to figure out.
void _fprintOne<comptime T>(_Buf* out, T val)
{
    comptime {
        switch (@typeof(T))
        { // typeof just added now, you do so well to make it work. it should only work in comptime block, unline size of and assert
            i8 => { _fprintI8(out, (i8)val); return; },
            i16 => { _fprintI16(out, (i16)val); return; },
            i32 => { _fprintI32(out, (i32)val); return; },
            i64 => { _fprintI64(out, (i64)val); return; },
            u8 => { _fprintU8(out, (u8)val); return; },
            u16 => { _fprintU16(out, (u16)val); return; },
            u32 => { _fprintU32(out, (u32)val); return; },
            u64 => { _fprintU64(out, (u64)val); return; },
            f32 => { _fprintF32(out, (f32)val); return; },
            f64 => { _fprintF64(out, (f64)val); return; },
            bool => { _fprintBool(out, (bool)val); return; },
            cchar => { _fprintChar(out, (cchar)val); return; },
            char => { _fprintCodepoint(out, (char)val); return; },
            
            const cchar* => {
                _fprintCstr(out, (const cchar*)val);
                return;
            },
            
            cchar* => {
                _fprintCstr(out, (const cchar*)val);
                return;
            },
            
            str => { _fprintBytes(out, val.ptr, val.len); return; },
            String => { _fprintBytes(out, val.ptr, val.len); return; },
            rawptr => { _fprintPtr(out, (const rawptr)val); return; },
            
            Spaces => {
                Spaces v = val;
                for (usize i = 0u; i < v.count; ++i) _pbyte(out, ' ');
                return;
            },
            
            Repeat => {
                Repeat v = val;
                for (usize i = 0u; i < v.count; ++i) _pbyte(out, v.ch);
                return;
            },
            
            Hex => {
                Hex v = val;
                _fprintHex(out, v.value);
                return;
            },
            
            Bin => {
                Bin v = val;
                _fprintBin(out, v.value);
                return;
            },
            
            Fixed => {
                Fixed v = val;
                _fprintFixed(out, v.value, v.precision);
                return;
            },

            // Any type implementing the inbuilt toStr trait (same class
            // as @drop), the compiler resolves the toStr call itself —
            // no dispatch code here. A type matching no prong above and
            // no `any toStr` falls through to the error below.
            (any toStr) => {
                str s = val.toStr();
                _fprintBytes(out, s.ptr, s.len);
                return;
            }
        }

        @compileError("print: type implements neither a builtin printer nor toStr");
    }
}

// Renders one {} placeholder, spec 0 is the default dispatch (so the
// manipulators work as {} arguments); {:d} {:x} {:b} re-render an integer
// in that base; {:p} prints a pointer; {..} spreads an iterable
// collection. Anything else is a compile error.
void _fprintSpec<comptime T>(_Buf* out, T val, u8 spec)
{
    comptime
    {
        switch (spec)
        {
            0 => { _fprintOne(out, val); },
            'd' => { _fprintInt(out, val, 10); },
            'x' => { _fprintInt(out, val, 16); },
            'b' => { _fprintInt(out, val, 2); },
            'p' => { _fprintPtrVal(out, val); },
            '.' => { _fprintIter(out, val); },
            else => { @compileError("print: unknown format specifier"); }
        }
    }
}

// {..}, an iterable collection, every element through the default {}
// dispatch, elements separated by ", ". Relies on range-for over the
// collection (old `iterable` trait class) — a non-iterable argument is
// a compile error.
void _fprintIter<comptime T>(_Buf* out, T val)
{
    comptime
    {
        bool first = true;
        for (var elem : val)
        {
            if (!first) { _pbyte(out, ','); _pbyte(out, ' '); }
            first = false;
            _fprintOne(out, elem);
        }
    }
}

// {:d}/{:x}/{:b} are integer-only — a non-integer argument is a compile
// error. char is accepted and renders its codepoint numerically.
i32 _fprintInt<comptime T>(_Buf* out, T val, u32 base)
{
    comptime
    {
        switch (@typeof(T))
        {
            i8 => { return _fprintSigned(out, (i64)val, base); },
            i16 => { return _fprintSigned(out, (i64)val, base); },
            i32 => { return _fprintSigned(out, (i64)val, base); },
            i64 => { return _fprintSigned(out, (i64)val, base); },
            u8 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u16 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u32 => { return _fprintUnsigned(out, (u64)val, base, false); },
            u64 => { return _fprintUnsigned(out, (u64)val, base, false); },
            char => { return _fprintUnsigned(out, (u64)(u32)val, base, false); },
            else => { @compileError("print: integer specifier requires an integer argument"); }
        }
    }
}

// {:p} is pointer-only — a non-pointer argument is a compile error.
i32 _fprintPtrVal<comptime T>(_Buf* out, T val)
{
    comptime
    {
        switch (@typeof(T))
        {
            rawptr => { return _fprintPtr(out, (const rawptr)val); },
            const cchar* => { return _fprintPtr(out, (const rawptr)val); },
            cchar* => { return _fprintPtr(out, (const rawptr)val); },
            else => { @compileError("print: {:p} requires a pointer argument"); }
        }
    }
}

// Emits one print call. When the first argument is a comptime string
// literal it is the format string, literal chunks (and the {{ }} escapes)
// are written directly — no runtime scanning of {} — and each
// placeholder consumes the next argument. Otherwise this is the
// type-not-specified path, fmt is just the first value and every
// argument renders through the comptime switch above or its own toStr.
void _printEmit<comptime T>(_Buf* out, T fmt, ... args)
{
    comptime
    {
        if (@isFormatLiteral(fmt))
        {
            str f;
            switch (@typeof(T))
            {
                str => { f = fmt; },
                else => { @compileError("print: format string must be a comptime literal"); }
            }

            usize i = 0;
            for (var arg : args)
            {
                // Literal run up to the next placeholder.
                while (i < f.len)
                {
                    u8 c = f.ptr[i];
                    if (c == '{')
                    {
                        if (i + 1 < f.len && f.ptr[i + 1] == '{') { _pbyte(out, '{'); i += 2; continue; }
                        break;
                    }
                    if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                    {
                        _pbyte(out, '}');
                        i += 2;
                        continue;
                    }
                    _pbyte(out, c);
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '{')
                {
                    @compileError("print: placeholder/argument count mismatch (more arguments than placeholders)");
                }

                i++; // consume the opening brace of the placeholder
                u8 spec = 0;
                if (i + 2 < f.len && f.ptr[i] == '.' && f.ptr[i + 1] == '.' && f.ptr[i + 2] == '}')
                {
                    // {..} — iterable spread
                    spec = '.';
                    i += 2; // the closing '}' is consumed by the check below
                }
                else if (i < f.len && f.ptr[i] == ':')
                {
                    i++;
                    if (i >= f.len) { @compileError("print: malformed placeholder"); }
                    spec = f.ptr[i];
                    i++;
                }
                if (i >= f.len || f.ptr[i] != '}')
                {
                    @compileError("print: malformed placeholder");
                }
                i++;
                _fprintSpec(out, arg, spec);
            }

            // Remainder, an unclosed placeholder left here means too few
            // arguments (this also covers "{}" passed with no arguments at all).
            while (i < f.len)
            {
                u8 c = f.ptr[i];
                if (c == '{')
                {
                    if (i + 1 < f.len && f.ptr[i + 1] == '{') { _pbyte(out, '{'); i += 2; continue; }
                    @compileError("print: placeholder/argument count mismatch (more placeholders than arguments)");
                }
                if (c == '}' && i + 1 < f.len && f.ptr[i + 1] == '}')
                {
                    _pbyte(out, '}');
                    i += 2;
                    continue;
                }
                _pbyte(out, c);
                i++;
            }
        }
        else
        {
            @compileError("print: format string must be a comptime literal");
        }
    }
}

// toStr is an INBUILT trait (same class as @drop) — nothing is declared
// here. User types provide impls (extend ... , @toStr, spelling FLAGGED)
// and the `any toStr` prong above is where the compiler auto-wires the
// call. A type matching no prong (no builtin, no toStr) is a compile
// error. Built-in comptime-switch types don't need an impl.

// Final rules, print/println/eprint/eprintln take the format string FIRST
// as `comptime T` — the compiler parses the literal ({} one placeholder
// per following argument, {{ }} escapes, {:d} {:x} {:b} {:p} specifiers,
// {..} spreads an iterable collection with ", " separators);
// placeholder/argument mismatch, an unknown specifier, or {} with no
// argument is a compile error. Without a comptime format literal
// (print(x), print(a, b)) every argument must render through the built-in
// comptime switch or its `any toStr` case. One 1024-byte stack buffer per
// call, a single write(2) per call, hand-rolled itoa for integers,
// snprintf for floats.

/// Prints `fmt` (a comptime format string) and any arguments to stdout, no trailing newline. `{}` takes the next argument; `{{`/`}}` escape braces.
pub void print<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _pflush(&out);
}

/// Prints `fmt` (a comptime format string) and any arguments to stdout, no trailing newline. `{}` takes the next argument; `{{`/`}}` escape braces. and appends a newline.
pub void println<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _fprintNewline(&out);
    _pflush(&out);
}

/// same definition of, but writes to stderr.
pub void eprint<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 2, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _pflush(&out);
}

/// same definition of, but appends a newline.
pub void eprintln<comptime T>(T fmt, ...)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 2, .data = outBuf, .len = 0 };
    comptime { _printEmit(&out, fmt, ...); }
    _fprintNewline(&out);
    _pflush(&out);
}

// vaprint — lib_old print!'s equivalent, a compile-time variadic of
// VALUES. No format string first — the first argument is never treated
// as text — and no format specifiers at all, there is no order to
// encode, so arguments print in sequence, each inferred through the
// built-in comptime switch or the `any toStr` case. Unbounded argument
// count and output length (the 1024-byte stack buffer flushes per full
// buffer). No trailing newline (see println).
/// Prints each argument's value in order to stdout, with no format string and no trailing newline.
pub void vaprint(... args)
{
    u8 outBuf[1024];
    _Buf out = _Buf { .fd = 1, .data = outBuf, .len = 0 };
    comptime { for (var arg : args) _fprintOne(&out, arg); }
    _pflush(&out);
}

// Print manipulator types
/// Print manipulator that emits `count` spaces when passed as a `{}` argument.
pub struct Spaces { u64 count; }
/// Print manipulator that emits `ch` repeated `count` times as a `{}` argument.
pub struct Repeat { u8 ch; u64 count; }
/// Print manipulator that renders `value` as `0x`-prefixed hexadecimal.
pub struct Hex { u64 value; }
/// Print manipulator that renders `value` as `0b`-prefixed binary.
pub struct Bin { u64 value; }
/// Print manipulator that renders `value` as fixed-point with `precision` fractional digits.
pub struct Fixed { f64 value; u64 precision; }

/// Constructs a Spaces manipulator emitting `count` spaces.
pub Spaces _spaces(u64 count) { return Spaces { .count = count }; }
/// Constructs a Repeat manipulator emitting `ch` `count` times.
pub Repeat _repeat(u8 ch, u64 count) { return Repeat { .ch = ch, .count = count }; }
/// Constructs a Hex manipulator rendering `value` in hexadecimal.
pub Hex _hex(u64 value) { return Hex { .value = value }; }
/// Constructs a Bin manipulator rendering `value` in binary.
pub Bin _bin(u64 value) { return Bin { .value = value }; }
/// Constructs a Fixed manipulator rendering `value` with `precision` fractional digits.
pub Fixed _fixed(f64 value, u64 precision) { return Fixed { .value = value, .precision = precision }; }
#[[inline]]
/// Flushes buffered stdout; output is unbuffered, so this is a no-op.
pub void flush() { _fprintFlush(1); }

i64 _readI64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    i64 v = parseI64(s.asView(), &ok);
    s.free();
    return v;
}

u64 _readU64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    u64 v = parseU64(s.asView(), &ok);
    s.free();
    return v;
}

f64 _readF64()
{
    String s = String::new();
    readLine(&s);
    bool ok;
    f64 v = parseF64(s.asView(), &ok);
    s.free();
    return v;
}

bool _readBool()
{
    String s = String::new();
    readLine(&s);
    str sv = s.asView();
    sv = sv.trim();
    bool result = sv.equals("true") ||
                            sv.equals("1") ||
                            sv.equals("yes");
    s.free();
    return result;
}

/// Parses `sv` as a signed 64-bit integer; sets `*ok` false and returns 0 on malformed or overflowing input.
pub i64 parseI64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    bool neg = false;

    if (sv.ptr[0] == '-') {
        neg = true;
        ++i;
    } else if (sv.ptr[0] == '+') {
        ++i;
    }
    if (i == sv.len) return 0;

    u64 result = 0;
    u64 limit = neg ? 9223372036854775808u : INT64_MAX;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (limit - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    if (neg) {
        if (result == 9223372036854775808u) return INT64_MIN;
        return -(i64)result;
    }
    return (i64)result;
}

/// Parses `sv` as an unsigned 64-bit integer; sets `*ok` false and returns 0 on malformed or overflowing input.
pub u64 parseU64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0;
    usize i = 0;
    if (sv.ptr[0] == '+') ++i;
    if (i == sv.len) return 0;
    u64 result = 0;
    while (i < sv.len)
    {
        u8 c = sv.ptr[i++];
        if (c < '0' || c > '9') return 0;
        u64 digit = (u64)(c - '0');
        if (result > (0xFFFFFFFFFFFFFFFFu - digit) / 10u) return 0;
        result = result * 10u + digit;
    }
    *ok = true;
    return result;
}

/// Parses `sv` as a double via strtod; sets `*ok` false and returns 0.0 if non-space trailing text remains.
pub f64 parseF64(str sv, bool* ok)
{
    *ok = false;
    if (sv.len == 0u) return 0.0;

    u8 buf[256];
    usize len = sv.len < 255u ? sv.len : 255u;
    copy<u8>(buf, (u8*)sv.ptr, len);
    buf[len] = 0;

    cchar* endptr;
    f64 result = strtod(buf, &endptr);
    if (endptr == buf) return 0.0;
    while (*endptr == ' ' || *endptr == '\t' || *endptr == '\n' || *endptr == '\r') endptr++;
    if (*endptr != 0) return 0.0;
    *ok = true;
    return result;
}

/// Reads one byte from stdin and returns it, or 0 at EOF.
pub u8 readChar()
{
    i32 b = getchar();
    return (u8)(b < 0 ? 0 : b);
}

/// Reads one line from stdin into `out` (stripping CR/LF); returns false only at EOF.
pub bool readLine(String* out)
{
    out->clear();
    loop {
        i32 b = getchar();
        if (b < 0) return !out->isEmpty();
        if (b == '\n') return true;
        if (b != '\r') out->pushChar((u8)b);
    }
}

/// Reads one value of type T from stdin into `*out`, dispatching on @typeof(T).
pub void read<comptime T>(T* out)
{
    comptime
    {
        switch (@typeof(T)) {
            i8 => { *out = (i8)_readI64(); return; },
            i16 => { *out = (i16)_readI64(); return; },
            i32 => { *out = (i32)_readI64(); return; },
            i64 => { *out = _readI64(); return; },
            u8 => { *out = (u8)_readU64(); return; },
            u16 => { *out = (u16)_readU64(); return; },
            u32 => { *out = (u32)_readU64(); return; },
            u64 => { *out = _readU64(); return; },
            f32 => { *out = (f32)_readF64(); return; },
            f64 => { *out = _readF64(); return; },
            bool => { *out = _readBool(); return; },
            cchar => { *out = readChar(); return; },
            String => { readLine(out); return; }
        }
    }
}

/// Reads and returns one value of type T from stdin.
pub T readVal<T>()
{
    T result;
    read(&result);
    return result;
}
