#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::mman { alloc, copy };
import(lib) std::result { Result };
import(lib) platform::libc { snprintf };
import(lib) std::text::string { String };
import(lib) std::io::fs { IoError };
import(lib) platform::libc { pipe, fork, dup2, execvp, waitpid, poll, read, write, close, _exit };

/// A spawned child process with connected stdin/stdout/stderr pipes.
pub struct Process
{
    i32 pid;
    i32 stdinFd;
    i32 stdoutFd;
    i32 stderrFd;
}

/// Outcome of a finished process: exit code or terminating signal.
pub struct ProcessResult
{
    i32 exitCode;
    bool signaled;
    i32 termSignal;
}

/// Poll descriptor: a file descriptor plus the events of interest.
pub struct pollfd
{
    i32 fd;
    i16 events;
    i16 revents;
}

void _closeIoFd(i32* fd)
{
    if (*fd >= 0) { close(*fd); *fd = -1; }
}

/// Spawn `cmd` with `args`, connected through stdin/stdout/stderr pipes.
pub Result<Process, IoError> spawn(str cmd, Vec<str>* args)
{
    i32[2] stdinPipe;
    i32[2] stdoutPipe;
    i32[2] stderrPipe;
    pipe(stdinPipe);
    pipe(stdoutPipe);
    pipe(stderrPipe);
    if (stdinPipe[0] < 0 || stdinPipe[1] < 0 || stdoutPipe[0] < 0 || stdoutPipe[1] < 0 || stderrPipe[0] < 0 || stderrPipe[1] < 0)
    {
        _closeIoFd(&stdinPipe[0]); _closeIoFd(&stdinPipe[1]);
        _closeIoFd(&stdoutPipe[0]); _closeIoFd(&stdoutPipe[1]);
        _closeIoFd(&stderrPipe[0]); _closeIoFd(&stderrPipe[1]);
        return Result<Process, IoError>::Err { .error = IoError::os("pipe") };
    }

    i32 pid = fork();
    if (pid < 0)
    {
        close(stdinPipe[0]); close(stdinPipe[1]);
        close(stdoutPipe[0]); close(stdoutPipe[1]);
        close(stderrPipe[0]); close(stderrPipe[1]);
        return Result<Process, IoError>::Err { .error = IoError::os("fork") };
    }

    if (pid == 0)
    {
        close(stdinPipe[1]);
        close(stdoutPipe[0]);
        close(stderrPipe[0]);
        dup2(stdinPipe[0], 0);
        dup2(stdoutPipe[1], 1);
        dup2(stderrPipe[1], 2);

        usize n = args != null ? args->count() : 0;
        usize cmdLen = cmd.len < 4095u ? cmd.len : 4095u;
        usize totalLen = cmdLen + 1;
        for (usize i = 0; i < n; i++)
        {
            str a = args->at(i);
            totalLen += (a.len < 4095u ? a.len : 4095u) + 1;
        }
        cchar** argv = alloc<cchar*>(n + 2);
        cchar* buf = alloc<cchar>(totalLen);
        copy<u8>((u8*)buf, (u8*)cmd.ptr, cmdLen);
        buf[cmdLen] = 0;
        argv[0] = buf;
        usize offset = cmdLen + 1;
        for (usize i = 0; i < n; i++)
        {
            str a = args->at(i);
            usize len = a.len < 4095u ? a.len : 4095u;
            copy<u8>((u8*)buf + offset, (u8*)a.ptr, len);
            buf[offset + len] = 0;
            argv[i + 1] = buf + offset;
            offset += len + 1;
        }
        argv[n + 1] = null;
        execvp(cmd.ptr, (const cchar**)argv);
        _exit(127);
    }

    close(stdinPipe[0]);
    close(stdoutPipe[1]);
    close(stderrPipe[1]);

    return Result<Process, IoError>::Ok {
        .value = Process
        {
            .pid = pid,
            .stdinFd = stdinPipe[1],
            .stdoutFd = stdoutPipe[0],
            .stderrFd = stderrPipe[0]
        }
    };
}

/// Wait for the child to exit, close its pipes, and return the result.
pub Result<ProcessResult, IoError> waitFor(Process* p)
{
    i32 status;
    i32 rc = waitpid(p->pid, &status, 0);
    if (rc < 0)
    {
        return Result<ProcessResult, IoError>::Err { .error = IoError::os("waitpid") };
    }
    _closeIoFd(&p->stdinFd);
    _closeIoFd(&p->stdoutFd);
    _closeIoFd(&p->stderrFd);

    if (status & 0x7F)
    {
        return Result<ProcessResult, IoError>::Ok { .value = ProcessResult { .exitCode = -1, .signaled = true, .termSignal = status & 0x7F } };
    }
    return Result<ProcessResult, IoError>::Ok { .value = ProcessResult { .exitCode = (status >> 8) & 0xFF, .signaled = false, .termSignal = 0 } };
}

/// Write `len` bytes to the child's stdin.
pub Result<isize, IoError> writeStdin(Process* p, const cchar* data, usize len)
{
    isize n = write(p->stdinFd, data, len);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("write") };
    return Result<isize, IoError>::Ok { .value = n };
}

/// Read up to `maxLen` bytes from the child's stdout.
pub Result<isize, IoError> readStdout(Process* p, u8* buf, usize maxLen)
{
    isize n = read(p->stdoutFd, buf, maxLen);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("read") };
    return Result<isize, IoError>::Ok { .value = n };
}

/// Read up to `maxLen` bytes from the child's stderr.
pub Result<isize, IoError> readStderr(Process* p, u8* buf, usize maxLen)
{
    isize n = read(p->stderrFd, buf, maxLen);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("read") };
    return Result<isize, IoError>::Ok { .value = n };
}

/// Run `cmd` to completion, draining its output, and return its exit code.
pub Result<i32, IoError> run(str cmd, Vec<str>* args)
{
    Result<Process, IoError> sr = spawn(cmd, args);
    if (sr.isErr()) return Result<i32, IoError>::Err { .error = sr.unwrapErr() };
    Process p = sr.unwrap();
    _closeIoFd(&p.stdinFd);
    // poll both pipes so the child never blocks writing while the parent
    // waits for the other pipe
    u8[4096] buf;
    while (true)
    {
        pollfd[2] fds;
        usize nfds = 0;
        if (p.stdoutFd >= 0) { fds[nfds].fd = p.stdoutFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
        if (p.stderrFd >= 0) { fds[nfds].fd = p.stderrFd; fds[nfds].events = 1; fds[nfds].revents = 0; nfds++; }
        if (nfds == 0) break;
        i32 rc = poll((rawptr)fds, nfds, -1);
        if (rc <= 0) break;
        for (usize i = 0; i < nfds; i++)
        {
            if ((fds[i].revents & 17) == 0) continue;
            i64 n = read(fds[i].fd, buf, 4096);
            if (n <= 0)
            {
                if (fds[i].fd == p.stdoutFd) _closeIoFd(&p.stdoutFd);
                else _closeIoFd(&p.stderrFd);
            }
        }
    }
    Result<ProcessResult, IoError> wr = waitFor(&p);
    if (wr.isErr()) return Result<i32, IoError>::Err { .error = wr.unwrapErr() };
    return Result<i32, IoError>::Ok { .value = wr.unwrap().exitCode };
}

/// Terminate the current process with `code`.
pub void exit(i32 code)
{
    _exit(code);
}

pub extend ProcessResult : @toStr
{
    str toStr()
    {
        u8[64] buf;
        i32 len = self.signaled
            ? snprintf(buf, 64u, C"signal %d", self.termSignal)
            : snprintf(buf, 64u, C"exit %d", self.exitCode);
        if (len < 0) len = 0;
        if (len > 63) len = 63;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}
