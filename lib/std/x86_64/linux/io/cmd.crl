#[[no_drop_all]]
import(lib) std::vec { Vec };
import(lib) std::text::string { String };
import(lib) std::io::fios { FileHandle, fileOpen, fileClose, fileRead };
import(lib) std::mman { alloc };
import(lib) std::option { Option };



/// Parses positional arguments and flag/option pairs from argv.
pub struct ArgParser
{
    Vec<String> positional;
    bool error;
    String errMsg;
    usize pos;

    /// Create an empty parser with no positional arguments.
    static ArgParser new()
    {
        return ArgParser
        {
            .positional = Vec<String>::new(),
            .error = false,
            .errMsg = String::new(),
            .pos = 0
        };
    }

    /// Free the stored positional arguments and error message.
    void dispose()
    {
        for (usize i = 0; i < self.positional.count(); i++)
            self.positional.atPtr(i)->free();
        self.positional.dispose();
        self.errMsg.free();
    }

    /// Collect non-flag arguments from `argv` as positional values.
    void parse(i32 argc, cchar** argv)
    {
        for (i32 i = 1; i < argc; i++)
        {
            cchar* arg = argv[i];
            if (arg[0] == '-' && arg[1] != 0)
            {
                if (arg[1] == '-' && arg[2] == 0) break;
                continue;
            }
            self.positional.push(String::from(str::fromCstr(arg)));
        }
    }

    bool _afterDoubleDash(i32 argc, cchar** argv, i32 idx)
    {
        for (i32 i = 1; i < idx; i++)
        {
            cchar* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) return true;
        }
        return false;
    }

    /// True when `shortFlag` or `longFlag` appears in `argv`.
    bool hasFlag(i32 argc, cchar** argv, str shortFlag, str longFlag)
    {
        for (i32 i = 1; i < argc; i++)
        {
            cchar* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) break;
            if (self._afterDoubleDash(argc, argv, i)) continue;
            if (shortFlag.len == 1 && arg[0] == '-' && arg[1] == shortFlag.ptr[0] && arg[2] == 0) return true;
            if (longFlag.len > 0 && arg[0] == '-' && arg[1] == '-')
            {
                bool match = true;
                for (usize j = 0; j < longFlag.len; j++)
                    if (arg[2 + j] != longFlag.ptr[j]) { match = false; break; }
                if (match && arg[2 + longFlag.len] == 0) return true;
            }
        }
        return false;
    }

    /// Read the value following `shortFlag` or `longFlag` into `out`.
    bool getOption(i32 argc, cchar** argv, str shortFlag, str longFlag, String* out)
    {
        for (i32 i = 1; i < argc - 1; i++)
        {
            cchar* arg = argv[i];
            if (arg[0] == '-' && arg[1] == '-' && arg[2] == 0) break;
            if (self._afterDoubleDash(argc, argv, i)) continue;
            if (shortFlag.len == 1 && arg[0] == '-' && arg[1] == shortFlag.ptr[0] && arg[2] == 0)
            {
                out->free();
                *out = String::from(str::fromCstr(argv[i + 1]));
                return true;
            }
            if (longFlag.len > 0 && arg[0] == '-' && arg[1] == '-')
            {
                bool match = true;
                for (usize j = 0; j < longFlag.len; j++)
                    if (arg[2 + j] != longFlag.ptr[j]) { match = false; break; }
                if (match && arg[2 + longFlag.len] == 0)
                {
                    out->free();
                    *out = String::from(str::fromCstr(argv[i + 1]));
                    return true;
                }
            }
        }
        return false;
    }

    /// Number of positional arguments collected.
    
    pub usize count() { return self.positional.count(); }
    /// Positional argument at `idx`.
    
    str get(usize idx) { return self.positional.at(idx).asView(); }
}


static str _cmdLine;
static bool _cmdLineReady;
static bool _cmdLineOk;

// The raw process command line (linux: /proc/self/cmdline, args NUL-separated).
// None when /proc/self/cmdline cannot be read (cached once).
/// Raw process command line, or None when it cannot be read.
pub Option<str> commandLine()
{
    if (_cmdLineReady)
    {
        if (_cmdLineOk) return Option<str>::Some { .value = _cmdLine };
        return Option<str>::None;
    }
    _cmdLine = str::empty();
    _cmdLineOk = false;
    u8* buf = alloc<u8>(8192);
    if (buf != null)
    {
        FileHandle fh = fileOpen("/proc/self/cmdline", "rb").unwrapOr((FileHandle)0);
        if (fh != (FileHandle)0)
        {
            usize len = 0;
            while (len + 1 < 8192)
            {
                usize got = fileRead(fh, buf + len, (usize)8192 - (1 + len)).unwrapOr(0);
                if (got == 0) break;
                len = len + got;
            }
            fileClose(fh);
            _cmdLine = str::fromParts(buf, len);
            _cmdLineOk = true;
        }
    }
    _cmdLineReady = true;
    if (_cmdLineOk) return Option<str>::Some { .value = _cmdLine };
    return Option<str>::None;
}
