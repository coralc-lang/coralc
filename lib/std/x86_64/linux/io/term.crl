#[[no_drop_all]]
import(lib) platform::libc { write, snprintf, isatty };

// file-local CSI prefix; the cast keeps it correct whether literals are
// str or cchar* (cf. mimalloc's printf((const cchar*)"...") calls)
str CSI = "\x1B[";

bool _isTty()
{
    return isatty(1) != 0;
}

void _writeCSI(str code)
{
    write(1, CSI.ptr, CSI.len);
    write(1, code.ptr, code.len);
}

void _writeStr(str s)
{
    write(1, s.ptr, s.len);
}

/// Resets all SGR attributes (CSI 0m).
pub void reset()
{
    _writeCSI("0m");
}

/// Enables bold text (CSI 1m).
 pub void bold() { _writeCSI("1m"); }
/// Enables dim text (CSI 2m).
 pub void dim() { _writeCSI("2m"); }
/// Enables italic text (CSI 3m).
 pub void italic() { _writeCSI("3m"); }
/// Enables underlined text (CSI 4m).
 pub void underline() { _writeCSI("4m"); }
/// Enables blinking text (CSI 5m).
 pub void blink() { _writeCSI("5m"); }
/// Enables reverse-video text (CSI 7m).
 pub void reverse() { _writeCSI("7m"); }
/// Enables hidden text (CSI 8m).
 pub void hidden() { _writeCSI("8m"); }
/// Enables struck-through text (CSI 9m).
 pub void strikethrough() { _writeCSI("9m"); }

/// Sets the foreground color to black (CSI 30m).
 pub void black() { _writeCSI("30m"); }
/// Sets the foreground color to red (CSI 31m).
 pub void red() { _writeCSI("31m"); }
/// Sets the foreground color to green (CSI 32m).
 pub void green() { _writeCSI("32m"); }
/// Sets the foreground color to yellow (CSI 33m).
 pub void yellow() { _writeCSI("33m"); }
/// Sets the foreground color to blue (CSI 34m).
 pub void blue() { _writeCSI("34m"); }
/// Sets the foreground color to magenta (CSI 35m).
 pub void magenta() { _writeCSI("35m"); }
/// Sets the foreground color to cyan (CSI 36m).
 pub void cyan() { _writeCSI("36m"); }
/// Sets the foreground color to white (CSI 37m).
 pub void white() { _writeCSI("37m"); }

/// Sets the background color to black (CSI 40m).
 pub void bgBlack() { _writeCSI("40m"); }
/// Sets the background color to red (CSI 41m).
 pub void bgRed() { _writeCSI("41m"); }
/// Sets the background color to green (CSI 42m).
 pub void bgGreen() { _writeCSI("42m"); }
/// Sets the background color to yellow (CSI 43m).
 pub void bgYellow() { _writeCSI("43m"); }
/// Sets the background color to blue (CSI 44m).
 pub void bgBlue() { _writeCSI("44m"); }
/// Sets the background color to magenta (CSI 45m).
 pub void bgMagenta() { _writeCSI("45m"); }
/// Sets the background color to cyan (CSI 46m).
 pub void bgCyan() { _writeCSI("46m"); }
/// Sets the background color to white (CSI 47m).
 pub void bgWhite() { _writeCSI("47m"); }

/// Sets the foreground color to bright black (CSI 90m).
 pub void brightBlack() { _writeCSI("90m"); }
/// Sets the foreground color to bright red (CSI 91m).
 pub void brightRed() { _writeCSI("91m"); }
/// Sets the foreground color to bright green (CSI 92m).
 pub void brightGreen() { _writeCSI("92m"); }
/// Sets the foreground color to bright yellow (CSI 93m).
 pub void brightYellow() { _writeCSI("93m"); }
/// Sets the foreground color to bright blue (CSI 94m).
 pub void brightBlue() { _writeCSI("94m"); }
/// Sets the foreground color to bright magenta (CSI 95m).
 pub void brightMagenta() { _writeCSI("95m"); }
/// Sets the foreground color to bright cyan (CSI 96m).
 pub void brightCyan() { _writeCSI("96m"); }
/// Sets the foreground color to bright white (CSI 97m).
 pub void brightWhite() { _writeCSI("97m"); }

u64 _clampN(u64 n)
{
    if (n > 99999999999999u) return 99999999999999u;
    return n;
}

/// Moves the cursor up `n` rows (CSI nA).
pub void cursorUp(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluA", n); if (l > 0) { write(1, CSI.ptr, CSI.len); write(1, buf, (u64)l); } }
/// Moves the cursor down `n` rows (CSI nB).
pub void cursorDown(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluB", n); if (l > 0) { write(1, CSI.ptr, CSI.len); write(1, buf, (u64)l); } }
/// Moves the cursor right `n` columns (CSI nC).
pub void cursorRight(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluC", n); if (l > 0) { write(1, CSI.ptr, CSI.len); write(1, buf, (u64)l); } }
/// Moves the cursor left `n` columns (CSI nD).
pub void cursorLeft(u64 n) { u8 buf[24]; n = _clampN(n); i32 l = snprintf(buf, 24u, (const cchar*)C"%lluD", n); if (l > 0) { write(1, CSI.ptr, CSI.len); write(1, buf, (u64)l); } }

/// Moves the cursor to `row`, `col` (1-based, CSI row;colH).
pub void cursorPos(u64 row, u64 col)
{
    u8[40] buf;
    row = _clampN(row);
    col = _clampN(col);
    i32 l = snprintf(buf, 40u, (const cchar*)C"%llu;%lluH", row, col);
    if (l > 0) {
        write(1, CSI.ptr, CSI.len);
        write(1, buf, (u64)l);
    }
}


/// Clears the whole screen (CSI 2J).
pub void clearScreen() { _writeCSI("2J"); }

/// Clears the whole current line (CSI 2K).
pub void clearLine() { _writeCSI("2K"); }

/// Clears from the cursor to the end of the screen (CSI 0J).
pub void clearToEnd() { _writeCSI("0J"); }

/// Clears from the cursor to the end of the line (CSI 0K).
pub void clearLineEnd() { _writeCSI("0K"); }


/// Saves the cursor position (CSI s).
pub void saveCursor() { _writeCSI("s"); }

/// Restores the saved cursor position (CSI u).
pub void restoreCursor() { _writeCSI("u"); }

/// Hides the cursor (CSI ?25l).
pub void hideCursor() { _writeCSI("?25l"); }

/// Shows the cursor (CSI ?25h).
pub void showCursor() { _writeCSI("?25h"); }
