#[[no_drop_all]]
import(lib) std::error { __assert, __assertOut, __oomFatal };
import(lib) std::mman { alloc, dealloc, realloc };
import range { IterRange };

/// Growable contiguous array of elements of type T.
pub struct Vec<T>
{
    T* data;
    usize len;
    usize cap;

/// Creates an empty vector with no allocation.
    static Vec<T> new()
    {
        return Vec<T> {
            .data = null,
            .len = 0,
            .cap = 0
        };
    }

/// Creates an empty vector with room for capacity elements.
    static Vec<T> withCap(usize capacity)
    {
        T* d = alloc<T>(capacity);
        if (d == null && capacity > 0) __oomFatal();
        return Vec<T> {
            .data = d,
            .len = 0,
            .cap = capacity
        };
    }

/// Ensures the capacity is at least newCap, growing if needed.
    void reserve(usize newCap)
    {
        if (newCap <= self.cap) return;
        T* nd = realloc<T>(self.data, newCap);
        /* a failed realloc must not clobber data or claim a cap it does
         * not have: push would write through a null buffer. with no
         * memory left there is nothing to fall back on — stop cleanly */
        if (nd == null) __oomFatal();
        self.data = nd;
        self.cap = newCap;
    }

/// Appends val to the back, growing the buffer when full.
    void push(T val) 
    {
        if (self.len >= self.cap)
        {
            usize newCap = self.cap > 0 ? self.cap * 2 : 4;
            self.reserve(newCap);
        }
        self.data[self.len] = val;
        self.len++;
    }

/// Removes and returns the last element; asserts the vector is non-empty.
    T pop()
    {
        __assert(self.len > 0);
        self.len--;
        return self.data[self.len];
    }

/// Returns a pointer to the element at index i; asserts i is in range.
    T* atPtr(usize i)
    {
        __assertOut(i < self.len, "Index Out of bounds");
        return &self.data[i];
    }

/// Returns a const pointer to the element at index i; asserts i is in range.
    const T* atConst(usize i)
    {
        __assertOut(i < self.len, "Index Out of bounds");
        return (const T*)&self.data[i];
    }

/// Returns a mutable pointer to the backing storage.
    T* ptr() { return self.data; }
/// Returns true when the vector holds no elements.
    bool isEmpty() { return self.len == 0; }
/// Returns a const pointer to the backing storage.
    const T* constPtr() { return (const T*)self.data; }

/// Overwrites the element at index i; asserts i is in range.
    void set(usize i, T val)
    {
        __assertOut(i < self.len, "attempt to set in an Index Out of bounds");
        self.data[i] = val;
    }

/// Returns the first element; asserts the vector is non-empty.
    T front()
    {
        __assertOut(self.len > 0, "Invalid Vector size");
        return self.data[0];
    }

/// Returns the last element; asserts the vector is non-empty.
    T back()
    {
        __assertOut(self.len > 0, "Invalid Vector size");
        return self.data[self.len - 1];
    }

/// Inserts val at index i, shifting later elements right; asserts i is in range.
    void insert(usize i, T val)
    {
        __assertOut(i <= self.len, "Invalid Vector size");
        if (self.len >= self.cap)
        {
            usize newCap = self.cap > 0 ? self.cap * 2 : 4;
            self.reserve(newCap);
        }
        for (usize j = self.len; j > i; j--)
            self.data[j] = self.data[j - 1];
        self.data[i] = val;
        self.len++;
    }

/// Removes the element at index i, shifting later elements left; asserts i is in range.
    void removeAt(usize i)
    {
        __assertOut(i < self.len, "Invalid Vector size");
        for (usize j = i; j < self.len - 1; j++)
            self.data[j] = self.data[j + 1];
        self.len--;
    }

/// Removes the elements in the half-open range [start, end).
    void removeRange(usize start, usize end)
    {
        __assertOut(start <= end, "Invalid range");
        __assertOut(end <= self.len, "Invalid Vector size");
        usize tail = self.len - end;
        for (usize j = 0; j < tail; j++)
            self.data[start + j] = self.data[end + j];
        self.len -= (end - start);
    }

/// Returns true when val is present, compared with ==.
    bool contains(T val)
    {
        for (usize i = 0; i < self.len; i++)
            if (val == self.data[i]) return true;
        return false;
    }

/// Sets every stored element to val.
    void fill(T val)
    {
        for (usize i = 0; i < self.len; i++)
            self.data[i] = val;
    }

/// Grows the capacity to exactly newCap when it is larger than the current one.
    void reserveExact(usize newCap)
    {
        if (newCap <= self.cap) return;
        T* nd = realloc<T>(self.data, newCap);
        if (nd == null) __oomFatal();
        self.data = nd;
        self.cap = newCap;
    }

/// Shrinks the capacity down to the current element count.
    void shrinkToFit()
    {
        if (self.len == self.cap) return;
        if (self.len == 0)
        {
            if (self.data != null) dealloc<T>(self.data);
            self.data = null;
            self.cap = 0;
            return;
        }
        T* nd = realloc<T>(self.data, self.len);
        if (nd == null) __oomFatal();
        self.data = nd;
        self.cap = self.len;
    }

/// Removes every element without freeing the buffer.
    void clear() { self.len = 0; }

/// Reverses the order of the stored elements in place.
    void reverse()
    {
        for (usize i = 0; i < self.len / 2; i++)
        {
            usize j = self.len - 1 - i;
            T tmp = self.data[i];
            self.data[i] = self.data[j];
            self.data[j] = tmp;
        }
    }

/// Returns true when the elements are ordered by the less predicate.
    bool isSortedBy(bool(T, T) less)
    {
        for (usize i = 1; i < self.len; i++)
            if (less(self.data[i], self.data[i - 1])) return false;
        return true;
    }

    
/// Sorts the elements in place according to the less predicate.
    void sortBy(bool(T, T) less) { self._sortByRange(0, self.len, less); }

    void _sortByRange(usize lo, usize hi, bool(T, T) less)
    {
        if (hi - lo <= 1) return;
        usize pi = self._partitionBy(lo, hi, less);
        if (pi > lo) self._sortByRange(lo, pi, less);
        if (pi + 1 < hi) self._sortByRange(pi + 1, hi, less);
    }

    usize _partitionBy(usize lo, usize hi, bool(T, T) less)
    {
        T pivot = self.data[hi - 1];
        usize i = lo;
        for (usize j = lo; j < hi - 1; j++)
        {
            if (less(self.data[j], pivot))
            {
                T tmp = self.data[i];
                self.data[i] = self.data[j];
                self.data[j] = tmp;
                i++;
            }
        }
        T tmp = self.data[i];
        self.data[i] = self.data[hi - 1];
        self.data[hi - 1] = tmp;
        return i;
    }

/// Returns the index of key in the sorted vector using cmp, or -1 when absent.
    i64 binarySearchBy(T key, i32(T, T) cmp)
    {
        i64 lo = 0;
        i64 hi = (i64)self.len - 1;
        while (lo <= hi)
        {
            i64 mid = lo + (hi - lo) / 2;
            i32 c = cmp(key, self.data[(usize)mid]);
            if (c == 0) return mid;
            if (c > 0) lo = mid + 1;
            else hi = mid - 1;
        }
        return -1;
    }

/// Frees the backing storage and resets the vector.
    void dispose()
    {
        if (self.data != null)
        {
            dealloc<T>(self.data);
            self.data = null;
        }
        self.len = 0;
        self.cap = 0;
    }
}

/// Implements @drop by freeing the backing storage.
pub extend<T> Vec<T> : @drop
{
    
    void drop() { self.dispose(); }
}

/// Implements @iter by exposing the vector's length and indexed elements.
pub extend<T> Vec<T> : @iter
{
/// Returns the number of stored elements.
    usize count() { return self.len; }

/// Returns the element at index i; asserts i is in range.
    T at(usize i)
    {
        __assertOut(i < self.len, "Index Out of bounds");
        return self.data[i];
    }

/// Returns the clamped half-open bounds [start, end) for for-in.
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}
// 
// // trait @drop { // drop trait impl.
// //     void drop(); // it be embeded in the compiler
// // }
// 
// '@' is reserved for inbuilt traits. iter, toString, eq, partialEd, add, sub...