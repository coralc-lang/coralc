#[[no_drop_all]]
import(lib) std::string { String };
import ios { println, eprintln };

/// Severity levels for Logger, ordered Debug < Info < Warn < Error < Fatal.
pub variant LogLevel
{
    Debug,
    Info,
    Warn,
    Error,
    Fatal
}

/// A named logger that filters messages below a minimum LogLevel.
pub struct Logger
{
    LogLevel minLevel;
    String name;

     // just a hint, dont be scared. the compiler would decided where or not to
/// Creates a Logger named `name` with the given minimum level.
    static Logger new(str name, LogLevel minLevel) { return Logger { .name = String.from(name), .minLevel = minLevel }; }

/// Frees the Logger's owned name string.
     void dispose() { self.name.free(); }
/// Sets the minimum level; messages below it are dropped.
     void setLevel(LogLevel level) { self.minLevel = level; }
/// Returns true if a message at `level` passes the minimum-level filter.
     bool enabled(LogLevel level) { return level >= self.minLevel; }

    void _log(LogLevel level, str msg)
    {
        if (level < self.minLevel) return;
        str label;
        switch (level)
        {
            LogLevel::Debug => { label = "DEBUG"; },
            LogLevel::Info => { label = "INFO"; },
            LogLevel::Warn => { label = "WARN"; },
            LogLevel::Error => { label = "ERROR"; },
            else => { label = "FATAL"; }
        }
        if (level == LogLevel::Error || level == LogLevel::Fatal) {
            eprintln("[{}][{}] {}", label, self.name, msg); }
        else {
            println("[{}][{}] {}", label, self.name, msg); }
    }

    
/// Logs `msg` at Debug level to stdout.
    void debug(str msg) { self._log(LogLevel::Debug, msg); }
    
/// Logs `msg` at Info level to stdout.
    void info(str msg) { self._log(LogLevel::Info, msg); }
    
/// Logs `msg` at Warn level to stdout.
    void warn(str msg) { self._log(LogLevel::Warn, msg); }
    
/// Logs `msg` at Error level to stderr.
    void error(str msg) { self._log(LogLevel::Error, msg); }
    
/// Logs `msg` at Fatal level to stderr.
    void fatal(str msg) { self._log(LogLevel::Fatal, msg); }
}
