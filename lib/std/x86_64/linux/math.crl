#[[no_drop_all]]
import(lib) std::mman { copy };

/// Pure-Coral f64 math — our own implementations, no libm linkage.
/// sin/cos reduce through a Cody-Waite pi/2 split; arguments beyond
/// ~1e9 fall back to an fmod reduction and lose precision there.
pub struct F64
{
    /// Raw IEEE-754 bits of x.
    static u64 toBits(f64 x)
    {
        u64 b;
        copy<u64>(&b, (u64*)&x, 1u);
        return b;
    }

    /// Float with the given IEEE-754 bits.
    static f64 fromBits(u64 b)
    {
        f64 r;
        copy<f64>(&r, (f64*)&b, 1u);
        return r;
    }

    /// Quiet NaN.
    static f64 nan() { return F64::fromBits(0x7FF8000000000000u); }

    /// Positive infinity.
    static f64 inf() { return F64::fromBits(0x7FF0000000000000u); }

    /// True when x is NaN.
    static bool isNan(f64 x)
    {
        return (F64::toBits(x) & 0x7FFFFFFFFFFFFFFFu) > 0x7FF0000000000000u;
    }

    /// True when x is +/- infinity.
    static bool isInf(f64 x)
    {
        return (F64::toBits(x) & 0x7FFFFFFFFFFFFFFFu) == 0x7FF0000000000000u;
    }

    /// True when x is neither infinite nor NaN.
    static bool isFinite(f64 x)
    {
        return (F64::toBits(x) & 0x7FF0000000000000u) != 0x7FF0000000000000u;
    }

    /// 2^n for n in [-1022, 1023].
    static f64 pow2i(i32 n)
    {
        return F64::fromBits(((u64)((i64)n + 1023)) << 52u);
    }

    /// Absolute value of x.
    static f64 abs(f64 x)
    {
        return F64::fromBits(F64::toBits(x) & 0x7FFFFFFFFFFFFFFFu);
    }

    /// x truncated toward zero, as a float.
    static f64 trunc(f64 x)
    {
        if (!F64::isFinite(x) || F64::abs(x) >= 9223372036854775808.0) return x;
        f64 r = (f64)((i64)x);
        if (r == 0.0) return F64::fromBits(F64::toBits(x) & 0x8000000000000000u);
        return r;
    }

    /// Largest integer not greater than x, as a float.
    static f64 floor(f64 x)
    {
        f64 t = F64::trunc(x);
        if (t > x) return t - 1.0;
        return t;
    }

    /// Smallest integer not less than x, as a float.
    static f64 ceil(f64 x)
    {
        f64 t = F64::trunc(x);
        if (t < x) return t + 1.0;
        return t;
    }

    /// x rounded to nearest integer (halves away from zero), as a float.
    static f64 round(f64 x)
    {
        f64 t = F64::trunc(x);
        if (F64::abs(x - t) >= 0.5)
        {
            t += (x < 0.0 ? -1.0 : 1.0);
        }
        return t;
    }

    /// Exact floating-point remainder of x / y (sign of x).
    static f64 fmod(f64 x, f64 y)
    {
        u64 hx = F64::toBits(x);
        u64 sx = hx & 0x8000000000000000u;
        u64 ux = hx ^ sx;
        u64 uy = F64::toBits(y) & 0x7FFFFFFFFFFFFFFFu;

        if (uy == 0u || ux >= 0x7FF0000000000000u || uy > 0x7FF0000000000000u) return F64::nan();
        if (ux < uy) return x;
        if (ux == uy) return F64::fromBits(sx);

        i32 ex = (i32)(ux >> 52u);
        i32 ey = (i32)(uy >> 52u);
        u64 mx = ux & 0x000FFFFFFFFFFFFFu;
        u64 my = uy & 0x000FFFFFFFFFFFFFu;

        if (ex == 0) ex = 1; else mx |= 0x0010000000000000u;
        if (ey == 0) ey = 1; else my |= 0x0010000000000000u;

        while (ex > ey)
        {
            if (mx >= my) mx = mx - my;
            mx = mx << 1u;
            ex = ex - 1;
        }
        if (mx >= my) mx = mx - my;
        if (mx == 0u) return F64::fromBits(sx);

        while (mx < 0x0010000000000000u && ex > 1)
        {
            mx <<= 1u;
            ex -= 1;
        }

        if (mx < 0x0010000000000000u) return F64::fromBits(sx | mx); // subnormal
        return F64::fromBits(sx | (((u64)ex) << 52u) | (mx & 0x000FFFFFFFFFFFFFu));
    }

    /// Square root of x.
    static f64 sqrt(f64 x)
    {
        if (F64::isNan(x)) return x;
        if (x < 0.0) return F64::nan();
        if (x == 0.0 || F64::isInf(x)) return x;

        // Subnormals: scale up by 2^60, result scales down by 2^30.
        f64 scale = 1.0;
        if (F64::toBits(x) < 0x0010000000000000u)
        {
            x = x * 1152921504606846976.0; // 2^60
            scale = 9.313225746154785e-10; // 2^-30
        }

        // exponent halved: within [1/sqrt2, sqrt2] of the true root
        u64 b = F64::toBits(x);
        f64 y = F64::fromBits((b >> 1u) + 0x1FF8000000000000u);
        y = 0.5 * (y + x / y);
        y = 0.5 * (y + x / y);
        y = 0.5 * (y + x / y);
        y = 0.5 * (y + x / y);
        y = 0.5 * (y + x / y);
        y = 0.5 * (y + x / y);
        return y * scale;
    }

    /// e^r for |r| <= ln2/2; Taylor until the term drops under 1e-18.
    static f64 expKernel(f64 r)
    {
        f64 sum = 1.0;
        f64 term = 1.0;
        i32 i = 1;
        while (i < 40)
        {
            term = term * r / (f64)i;
            sum = sum + term;
            if (F64::abs(term) < 1.0e-18 * F64::abs(sum)) break;
            i = i + 1;
        }
        return sum;
    }

    /// e raised to the power x.
    static f64 exp(f64 x)
    {
        if (F64::isNan(x)) return x;
        if (x > 709.782712893384) return F64::inf();
        if (x < -745.1332191019411) return 0.0;

        // k = round(x / ln2), split so both halves stay in pow2i range
        i32 k = (i32)F64::round(x * 1.4426950408889634);
        // ln2 = 0.6931471803691238 + 1.9082149292705877e-17
        f64 r = (x - (f64)k * 0.6931471803691238) - (f64)k * 1.9082149292705877e-17;
        i32 h = k / 2;
        return F64::expKernel(r) * F64::pow2i(h) * F64::pow2i(k - h);
    }

    /// 2 raised to the power t.
    static f64 exp2(f64 t)
    {
        if (F64::isNan(t)) return t;
        if (t >= 1024.0) return F64::inf();
        if (t < -1075.0) return 0.0;

        i32 k = (i32)F64::round(t);
        f64 r = (t - (f64)k) * 0.6931471805599453;
        i32 h = k / 2;
        return F64::expKernel(r) * F64::pow2i(h) * F64::pow2i(k - h);
    }

    /// Splits positive finite x into m * 2^e (m in ~[0.707, 1.414]);
    /// writes e and returns ln(m).
    static f64 logReduce(f64 x, i32* e)
    {
        u64 b = F64::toBits(x);
        i32 ex = 0;
        if ((b >> 52u) == 0u)
        {
            x = x * 4503599627370496.0; // 2^52
            b = F64::toBits(x);
            ex = -52;
        }
        ex = ex + (i32)(b >> 52u) - 1023;
        f64 m = F64::fromBits((b & 0x000FFFFFFFFFFFFFu) | 0x3FF0000000000000u);
        if (m > 1.4142135623730951)
        {
            m *= 0.5;
            ex += 1;
        }
        *e = ex;

        // ln(m) = 2 * atanh(s); |s| <= ~0.1716, series terminates under 1e-18
        f64 s = (m - 1.0) / (m + 1.0);
        f64 z = s * s;
        f64 sum = s;
        f64 term = s;
        i32 i = 1;
        while (i < 40)
        {
            term = term * z;
            f64 add = term / (2.0 * (f64)i + 1.0);
            sum = sum + add;
            if (F64::abs(add) < 1.0e-18 * F64::abs(sum)) break;
            i = i + 1;
        }
        return 2.0 * sum;
    }

    /// Natural logarithm of x.
    static f64 log(f64 x)
    {
        if (F64::isNan(x) || x < 0.0) return F64::nan();
        if (x == 0.0) return -F64::inf();
        if (F64::isInf(x)) return x;
        i32 e;
        f64 lm = F64::logReduce(x, &e);
        f64 fe = (f64)e;
        return fe * 0.6931471803691238 + (lm + fe * 1.9082149292705877e-17);
    }

    /// Base-2 logarithm of x.
    static f64 log2(f64 x)
    {
        if (F64::isNan(x) || x < 0.0) return F64::nan();
        if (x == 0.0) return -F64::inf();
        if (F64::isInf(x)) return x;
        i32 e;
        f64 lm = F64::logReduce(x, &e);
        return (f64)e + lm * 1.4426950408889634;
    }

    /// Base-10 logarithm of x.
    static f64 log10(f64 x)
    {
        if (F64::isNan(x) || x < 0.0) return F64::nan();
        if (x == 0.0) return -F64::inf();
        if (F64::isInf(x)) return x;
        i32 e;
        f64 lm = F64::logReduce(x, &e);
        return (f64)e * 0.3010299956639812 + lm * 0.4342944819032518;
    }

    /// Raises x to the power y.
    static f64 pow(f64 x, f64 y)
    {
        if (y == 0.0 || x == 1.0) return 1.0;
        if (F64::isNan(x) || F64::isNan(y)) return F64::nan();
        if (y == F64::inf()) return F64::abs(x) == 1.0 ? y : (F64::abs(x) < 1.0 ? 0.0 : F64::inf());
        if (y == -F64::inf()) return F64::abs(x) == 1.0 ? 0.0 : (F64::abs(x) < 1.0 ? F64::inf() : 0.0);

        bool neg = false;
        if (x < 0.0)
        {
            f64 ty = F64::trunc(y);
            if (ty != y) return F64::nan();
            if (F64::abs(y) < 9007199254740992.0 && (((i64)ty) & 1) != 0) neg = true;
            x = -x;
        }

        f64 t = y * F64::log2(x);
        f64 r = F64::exp2(t);
        return neg ? -r : r;
    }

    /// Sine of x radians (full precision for |x| below ~1e9).
    static f64 sin(f64 x)
    {
        if (!F64::isFinite(x)) return F64::nan();
        f64 ax = F64::abs(x);
        bool neg = x < 0.0;
        if (ax > 1000000000.0) ax = F64::fmod(ax, 6.283185307179586);

        // reduce to n * pi/2 + r, |r| <= pi/4 (Cody-Waite hi/lo pi/2)
        i32 n = (i32)(ax * 0.6366197723675814);
        f64 nf = (f64)n;
        f64 r = (ax - nf * 1.5707963267341256) - nf * 6.077100506506192e-11;

        i32 q = n & 3;
        if (q == 2 || q == 3) neg = !neg;

        f64 z = r * r;
        f64 p;
        if (q == 1 || q == 3)
        {
            // cos kernel through z^8 (error < 1 ulp at pi/4)
            p = 1.0 + z * (-0.5 + z * (4.1666666666666664e-2 + z * (-1.388888888888889e-3
              + z * (2.48015873015873e-5 + z * (-2.7557319223985893e-7
              + z * (2.08767569878681e-9 + z * (-1.1470745597729725e-11
              + z * 4.77947733238738e-14)))))));
        }
        else {
            // sin kernel through z^7
            p = r * (1.0 + z * (-1.6666666666666666e-1 + z * (8.333333333333333e-3
              + z * (-1.9841269841269841e-4 + z * (2.7557319223985893e-6
              + z * (-2.505210838544172e-8 + z * (1.6059043836821613e-10
              + z * -7.647163731819816e-13)))))));
        }
        return neg ? -p : p;
    }

    /// Cosine of x radians (full precision for |x| below ~1e9).
    static f64 cos(f64 x)
    {
        if (!F64::isFinite(x)) return F64::nan();
        f64 ax = F64::abs(x);
        if (ax > 1000000000.0) ax = F64::fmod(ax, 6.283185307179586);

        i32 n = (i32)(ax * 0.6366197723675814);
        f64 nf = (f64)n;
        f64 r = (ax - nf * 1.5707963267341256) - nf * 6.077100506506192e-11;

        i32 q = n & 3;
        bool neg = q == 1 || q == 2;

        f64 z = r * r;
        f64 p;
        if (q == 1 || q == 3)
        {
            p = r * (1.0 + z * (-1.6666666666666666e-1 + z * (8.333333333333333e-3
              + z * (-1.9841269841269841e-4 + z * (2.7557319223985893e-6
              + z * (-2.505210838544172e-8 + z * (1.6059043836821613e-10
              + z * -7.647163731819816e-13)))))));
        }
        else {
            p = 1.0 + z * (-0.5 + z * (4.1666666666666664e-2 + z * (-1.388888888888889e-3
              + z * (2.48015873015873e-5 + z * (-2.7557319223985893e-7
              + z * (2.08767569878681e-9 + z * (-1.1470745597729725e-11
              + z * 4.77947733238738e-14)))))));
        }
        return neg ? -p : p;
    }

    /// Tangent of x radians.
    static f64 tan(f64 x)
    {
        return F64::sin(x) / F64::cos(x);
    }

    /// Arctangent of x, in radians.
    static f64 atan(f64 x)
    {
        if (F64::isNan(x)) return x;
        bool neg = x < 0.0;
        f64 a = F64::abs(x);
        f64 y;

        // map to |a| <= 0.4142 via pi/2 / pi/4 identities
        if (a > 2.414213562373095)
        {
            y = 1.5707963267341256;
            a = -1.0 / a;
        }
        else if (a > 0.41421356237309503)
        {
            y = 0.7853981633974483;
            a = (a - 1.0) / (a + 1.0);
        }
        else {
            y = 0.0;
        }

        // atan(a) = a + a*z*P(z), z = a*a (minimax through z^3)
        f64 z = a * a;
        y = y + (((8.05374449538e-2 * z - 1.38776856032e-1) * z
                + 1.99777106478e-1) * z - 3.33329491539e-1) * z * a + a;
        return neg ? -y : y;
    }

    /// Arctangent of y / x using the signs of both arguments, in radians.
    static f64 atan2(f64 y, f64 x)
    {
        if (F64::isNan(x) || F64::isNan(y)) return F64::nan();

        bool yNeg = (F64::toBits(y) & 0x8000000000000000u) != 0u;
        bool xNeg = (F64::toBits(x) & 0x8000000000000000u) != 0u;

        if (F64::isInf(x))
        {
            if (F64::isInf(y))
            {
                f64 r = xNeg ? 2.356194490192345 : 0.7853981633974483;
                return yNeg ? -r : r;
            }
            f64 r = xNeg ? 3.141592653589793 : 0.0;
            return yNeg ? -r : r;
        }
        if (F64::isInf(y)) return yNeg ? -1.5707963267341256 : 1.5707963267341256;

        if (x == 0.0)
        {
            if (y == 0.0)
            {
                f64 r = xNeg ? 3.141592653589793 : 0.0;
                return yNeg ? -r : r;
            }
            return yNeg ? -1.5707963267341256 : 1.5707963267341256;
        }

        f64 r = F64::atan(y / x);
        if (xNeg)
        {
            if (yNeg) r = r - 3.141592653589793;
            else r = r + 3.141592653589793;
        }
        return r;
    }

    /// Arcsine of x, in radians.
    static f64 asin(f64 x)
    {
        if (F64::isNan(x) || F64::abs(x) > 1.0) return F64::nan();
        return F64::atan2(x, F64::sqrt((1.0 - x) * (1.0 + x)));
    }

    /// Arccosine of x, in radians.
    static f64 acos(f64 x)
    {
        if (F64::isNan(x) || F64::abs(x) > 1.0) return F64::nan();
        return F64::atan2(F64::sqrt((1.0 - x) * (1.0 + x)), x);
    }

    /// Hyperbolic sine of x.
    static f64 sinh(f64 x)
    {
        if (F64::isNan(x)) return x;
        f64 a = F64::abs(x);
        f64 r;
        if (a < 0.5)
        {
            f64 z = a * a;
            r = a * (1.0 + z * (1.6666666666666667e-1 + z * (8.333333333333333e-3
               + z * (1.984126984126984e-4 + z * 2.755731922398589e-6))));
        }
        else if (a > 710.0) return F64::inf();
        else {
            f64 e = F64::exp(a);
            r = 0.5 * (e - 1.0 / e);
        }
        return x < 0.0 ? -r : r;
    }

    /// Hyperbolic cosine of x.
    static f64 cosh(f64 x)
    {
        if (F64::isNan(x)) return x;
        f64 a = F64::abs(x);
        if (a > 710.0) return F64::inf();
        if (a < 0.5)
        {
            f64 z = a * a;
            return 1.0 + z * (5.0e-1 + z * (4.1666666666666664e-2 + z * (1.388888888888889e-3
                   + z * 2.48015873015873e-5)));
        }
        f64 e = F64::exp(a);
        return 0.5 * (e + 1.0 / e);
    }

    /// Hyperbolic tangent of x.
    static f64 tanh(f64 x)
    {
        if (F64::isNan(x)) return x;
        f64 a = F64::abs(x);
        f64 r;
        if (a >= 20.0)
        {
            r = 1.0;
        }
        else {
            f64 e = F64::exp(2.0 * a);
            r = (e - 1.0) / (e + 1.0);
        }
        return x < 0.0 ? -r : r;
    }

    /// Cube root of x.
    static f64 cbrt(f64 x)
    {
        if (x == 0.0 || !F64::isFinite(x)) return x;
        bool neg = x < 0.0;
        f64 ax = F64::abs(x);

        f64 y = F64::exp(F64::log(ax) / 3.0);
        // Halley: three steps converge a log/exp seed to full f64 precision
        for (i32 i = 0; i < 3; i++)
        {
            f64 y2 = y * y;
            y = y - (y2 * y - ax) / (3.0 * y2);
        }
        return neg ? -y : y;
    }

    /// Length of the hypotenuse with legs x and y.
    static f64 hypot(f64 x, f64 y)
    {
        if (F64::isInf(x) || F64::isInf(y)) return F64::inf();
        if (F64::isNan(x) || F64::isNan(y)) return F64::nan();
        f64 a = F64::abs(x);
        f64 b = F64::abs(y);
        if (a < b) { f64 t = a; a = b; b = t; }
        if (b == 0.0) return a;
        f64 r = b / a;
        return a * F64::sqrt(1.0 + r * r);
    }

    /// erf via the all-positive series, for 0 <= x < 2.
    static f64 erfSeries(f64 x)
    {
        f64 sum = x;
        f64 term = x;
        f64 x2 = x * x;
        for (i32 n = 1; n < 200; n += 1)
        {
            term = term * 2.0 * x2 / (f64)(2 * n + 1);
            sum = sum + term;
            if (term < 1.0e-18 * sum) break;
        }
        return 1.1283791670955126 * F64::exp(-x2) * sum; // 2/sqrt(pi)
    }

    /// erfc via continued fraction, for x >= 1.5.
    static f64 erfcFrac(f64 x)
    {
        f64 f = x;
        for (i32 k = 400; k >= 1; k = k - 1)
        {
            f = x + 0.5 * (f64)k / f;
        }
        return F64::exp(-x * x) * 0.5641895835477563 / f; // 1/sqrt(pi)
    }

    /// Error function of x.
    static f64 erf(f64 x)
    {
        if (F64::isNan(x)) return x;
        f64 a = F64::abs(x);
        f64 r;
        if (a < 1.5) r = F64::erfSeries(a);
        else if (a >= 6.0) r = 1.0;
        else r = 1.0 - F64::erfcFrac(a);
        return x < 0.0 ? -r : r;
    }

    /// Complementary error function of x.
    static f64 erfc(f64 x)
    {
        if (F64::isNan(x)) return x;
        if (x < 0.0) return 2.0 - F64::erfc(-x);
        if (x < 1.5) return 1.0 - F64::erfSeries(x);
        return F64::erfcFrac(x); // exp(-x^2) underflows to 0 past ~38
    }

    /// Lanczos series (g = 7, n = 9) for an argument already reduced by 1.
    static f64 lanczos(f64 x)
    {
        return 0.99999999999980993
             + 676.5203681218851    / (x + 1.0)
             + -1259.1392167224028  / (x + 2.0)
             + 771.32342877765313   / (x + 3.0)
             + -176.61502916214059  / (x + 4.0)
             + 12.507343278686905   / (x + 5.0)
             + -0.13857109526572012 / (x + 6.0)
             + 9.9843695780195716e-6 / (x + 7.0)
             + 1.5056327351493116e-7 / (x + 8.0);
    }

    /// Natural logarithm of the absolute value of the gamma function of x.
    static f64 lgamma(f64 x)
    {
        if (F64::isNan(x)) return x;
        if (F64::isInf(x)) return F64::inf();
        if (x <= 0.0 && x == F64::trunc(x)) return F64::inf();
        if (x == 1.0 || x == 2.0) return 0.0;

        if (x < 0.5)
        {
            f64 s = F64::abs(F64::sin(3.141592653589793 * x));
            return F64::log(3.141592653589793 / s) - F64::lgamma(1.0 - x);
        }

        x -= 1.0;
        f64 t = x + 7.5;
        return 0.9189385332046727 + (x + 0.5) * F64::log(t) - t + F64::log(F64::lanczos(x));
    }

    /// Gamma function of x.
    static f64 tgamma(f64 x)
    {
        if (F64::isNan(x)) return x;
        if (x == F64::inf()) return x;
        if (x == -F64::inf()) return F64::nan();
        if (x == 0.0)
        {
            bool neg = (F64::toBits(x) & 0x8000000000000000u) != 0u;
            return neg ? -F64::inf() : F64::inf();
        }
        if (x < 0.0 && x == F64::trunc(x)) return F64::nan();

        // Exact factorials for small positive integers.
        if (x > 0.0 && x == F64::trunc(x) && x <= 20.0)
        {
            f64 r = 1.0;
            for (f64 i = 2.0; i < x; i += 1.0) r *= i;
            return r;
        }
        if (x > 171.61447887182298) return F64::inf();

        if (x < 0.5)
        {
            return 3.141592653589793 / (F64::sin(3.141592653589793 * x) * F64::tgamma(1.0 - x));
        }

        x -= 1.0;
        f64 t = x + 7.5;
        f64 p = F64::pow(t, (x + 0.5) * 0.5);
        return 2.5066282746310002 * p * F64::exp(-t) * p * F64::lanczos(x);
    }

    /// Clamps v to the inclusive range [lo, hi].
    static f64 clamp(f64 v, f64 lo, f64 hi)
    {
        if (v < lo) return lo;
        if (v > hi) return hi;
        return v;
    }

    /// Linearly interpolates from a to b by t.
    static f64 lerp(f64 a, f64 b, f64 t)
    {
        return a + (b - a) * t;
    }

    /// Returns the fraction of v between a and b; inverse of lerp.
    static f64 invLerp(f64 a, f64 b, f64 v)
    {
        return (v - a) / (b - a);
    }

    /// Remaps v from the range [a1, b1] to [a2, b2].
    static f64 mapRange(f64 v, f64 a1, f64 b1, f64 a2, f64 b2)
    {
        return F64::lerp(a2, b2, F64::invLerp(a1, b1, v));
    }

    /// Returns the smaller of a and b.
    static f64 min(f64 a, f64 b) { return a < b ? a : b; }
    /// Returns the larger of a and b.
    static f64 max(f64 a, f64 b) { return a > b ? a : b; }

    /// Returns -1.0, 0.0, or 1.0 for the sign of x.
    static f64 sign(f64 x) { return x < 0.0 ? -1.0 : (x > 0.0 ? 1.0 : 0.0); }

    /// Converts degrees to radians.
    static f64 degToRad(f64 deg) { return deg * 3.14159265358979323846 / 180.0; }
    /// Converts radians to degrees.
    static f64 radToDeg(f64 rad) { return rad * 180.0 / 3.14159265358979323846; }

    /// Returns x + y.
    static f64 add(f64 x, f64 y) { return x + y; }
    /// Returns x - y.
    static f64 sub(f64 x, f64 y) { return x - y; }
    /// Returns x * y.
    static f64 mul(f64 x, f64 y) { return x * y; }
    /// Returns x / y.
    static f64 div(f64 x, f64 y) { return x / y; }
}

/// Full turn in radians (2 * pi).
pub const f64 tau = 6.28318530717958647692;
/// Square root of 2.
pub const f64 srt2 = 1.41421356237309504880;
/// Ratio of a circle's circumference to its diameter.
pub const f64 pi = 3.14159265358979323846;
/// Base of the natural logarithm.
pub const f64 e = 2.71828182845904523536;

/// Integer helpers — not float-domain, so they stay free; the float
/// equivalents live on the F64 / F32 structs with matching names.

/// Clamps v to the inclusive range [lo, hi].
pub i64 clampI64(i64 v, i64 lo, i64 hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/// Clamps v to the inclusive range [lo, hi].
pub u64 clampU64(u64 v, u64 lo, u64 hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/// Returns the smaller of a and b.
pub i64 minI64(i64 a, i64 b) { return a < b ? a : b; }
/// Returns the larger of a and b.
pub i64 maxI64(i64 a, i64 b) { return a > b ? a : b; }
/// Returns the smaller of a and b.
pub u64 minU64(u64 a, u64 b) { return a < b ? a : b; }
/// Returns the larger of a and b.
pub u64 maxU64(u64 a, u64 b) { return a > b ? a : b; }

/// Absolute value of x as an unsigned integer.
pub u64 absI64(i64 x)
{
    if (x < 0) return (u64)(-(x + 1)) + 1u;
    return (u64)x;
}

/// Returns -1, 0, or 1 for the sign of x.
pub i64 signI64(i64 x) { return (i64)(x < 0 ? -1 : (x > 0 ? 1 : 0)); }


/// F32 alternatives to libm functions.
/// These are hand written to rather than wrapped over libm functions and cast to f32
pub struct F32
{
    /// Raw IEEE-754 bits of x.
    static u32 toBits(f32 x)
    {
        u32 b;
        copy<u32>(&b, (u32*)&x, 1u);
        return b;
    }

    /// Float with the given IEEE-754 bits.
    static f32 fromBits(u32 b)
    {
        f32 r;
        copy<f32>(&r, (f32*)&b, 1u);
        return r;
    }

    /// Quiet NaN.
    static f32 nan() { return F32::fromBits(0x7FC00000u); }

    /// Positive infinity.
    static f32 inf() { return F32::fromBits(0x7F800000u); }

    /// True when x is NaN.
    static bool isNan(f32 x)
    {
        return (F32::toBits(x) & 0x7FFFFFFFu) > 0x7F800000u;
    }

    /// True when x is +/- infinity.
    static bool isInf(f32 x)
    {
        return (F32::toBits(x) & 0x7FFFFFFFu) == 0x7F800000u;
    }

    /// True when x is neither infinite nor NaN.
    static bool isFinite(f32 x)
    {
        return (F32::toBits(x) & 0x7F800000u) != 0x7F800000u;
    }

    /// 2^n for n in [-126, 127].
    static f32 pow2i(i32 n)
    {
        return F32::fromBits(((u32)(n + (i32)127)) << 23u);
    }

    /// Absolute value of x.
    static f32 abs(f32 x)
    {
        return F32::fromBits(F32::toBits(x) & 0x7FFFFFFFu);
    }

    /// x truncated toward zero, as a float.
    static f32 trunc(f32 x)
    {
        if (!F32::isFinite(x) || F32::abs(x) >= 8388608.0f) return x;
        f32 r = (f32)((i32)x);
        if (r == 0.0f) return F32::fromBits(F32::toBits(x) & 0x80000000u);
        return r;
    }

    /// Largest integer not greater than x, as a float.
    static f32 floor(f32 x)
    {
        f32 t = F32::trunc(x);
        if (t > x) return t - 1.0f;
        return t;
    }

    /// Smallest integer not less than x, as a float.
    static f32 ceil(f32 x)
    {
        f32 t = F32::trunc(x);
        if (t < x) return t + 1.0f;
        return t;
    }

    /// x rounded to nearest integer (halves away from zero), as a float.
    static f32 round(f32 x)
    {
        f32 t = F32::trunc(x);
        if (F32::abs(x - t) >= 0.5f)
        {
            t += (x < 0.0f ? -1.0f : 1.0f);
        }
        return t;
    }

    /// Exact floating-point remainder of x / y (sign of x).
    static f32 fmod(f32 x, f32 y)
    {
        u32 hx = F32::toBits(x);
        u32 sx = hx & 0x80000000u;
        u32 ux = hx ^ sx;
        u32 uy = F32::toBits(y) & 0x7FFFFFFFu;

        if (uy == 0u || ux >= 0x7F800000u || uy > 0x7F800000u) return F32::nan();
        if (ux < uy) return x;
        if (ux == uy) return F32::fromBits(sx);

        i32 ex = (i32)(ux >> 23u);
        i32 ey = (i32)(uy >> 23u);
        u32 mx = ux & 0x007FFFFFu;
        u32 my = uy & 0x007FFFFFu;

        if (ex == 0) ex = 1; else mx |= 0x00800000u;
        if (ey == 0) ey = 1; else my |= 0x00800000u;

        while (ex > ey)
        {
            if (mx >= my) mx = mx - my;
            mx = mx << 1u;
            ex = ex - 1;
        }
        if (mx >= my) mx = mx - my;
        if (mx == 0u) return F32::fromBits(sx);

        while (mx < 0x00800000u && ex > 1)
        {
            mx <<= 1u;
            ex -= 1;
        }

        if (mx < 0x00800000u) return F32::fromBits(sx | mx); // subnormal
        return F32::fromBits(sx | (((u32)ex) << 23u) | (mx & 0x007FFFFFu));
    }

    /// Square root of x.
    static f32 sqrt(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x < 0.0f) return F32::nan();
        if (x == 0.0f || F32::isInf(x)) return x;

        // Subnormals: scale up by 2^64, result scales down by 2^32.
        f32 scale = 1.0f;
        if (F32::toBits(x) < 0x00800000u)
        {
            x = x * 18446744073709551616.0f;
            scale = 2.3283064365386963e-10f;
        }

        u32 b = F32::toBits(x);
        f32 y = F32::fromBits(0x1FBD1DF5u + (b >> 1u));
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        return y * scale;
    }

    /// Cube root of x.
    static f32 cbrt(f32 x)
    {
        if (x == 0.0f || !F32::isFinite(x)) return x;
        bool neg = x < 0.0f;
        f32 ax = F32::abs(x);

        f32 y = F32::fromBits(F32::toBits(ax) / 3u + 709958130u);
        for (i32 i = 0; i < 8; i = i + 1)
        {
            y = (2.0f * y + ax / (y * y)) / 3.0f;
        }
        return neg ? -y : y;
    }

    /// Length of the hypotenuse with legs x and y.
    static f32 hypot(f32 x, f32 y)
    {
        if (F32::isInf(x) || F32::isInf(y)) return F32::inf();
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();
        f32 a = F32::abs(x);
        f32 b = F32::abs(y);
        if (a < b) { f32 t = a; a = b; b = t; }
        if (b == 0.0f) return a;
        f32 r = b / a;
        return a * F32::sqrt(1.0f + r * r);
    }

    /// e^r * 2^k for small |r| (<= ~0.35).
    static f32 expImpl(f32 r, i32 k)
    {
        f32 p = 1.0f + r * (1.0f + r * (0.5f + r * (0.16666667f
              + r * (0.041666668f + r * (0.008333334f
              + r * (0.0013888889f + r * 0.0001984127f))))));
        i32 h = k / 2;
        return p * F32::pow2i(h) * F32::pow2i(k - h);
    }

    /// e raised to the power x.
    static f32 exp(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x > 88.72284f) return F32::inf();
        if (x < -103.97208f) return 0.0f;

        i32 k = (i32)F32::round(x * 1.44269504f);
        f32 fk = (f32)k;
        f32 r = (x - fk * 0.693359375f) - fk * -2.12194440e-4f;
        return F32::expImpl(r, k);
    }

    /// 2 raised to the power t.
    static f32 exp2(f32 t)
    {
        if (F32::isNan(t)) return t;
        if (t >= 128.0f) return F32::inf();
        if (t < -150.0f) return 0.0f;

        i32 k = (i32)F32::round(t);
        f32 r = (t - (f32)k) * 0.69314718f;
        return F32::expImpl(r, k);
    }

    /// Splits positive finite x into m * 2^e (m in ~[0.707, 1.414]);
    /// writes e and returns ln(m).
    static f32 logReduce(f32 x, i32* e)
    {
        u32 b = F32::toBits(x);
        i32 ex = 0;
        if ((b >> 23u) == 0u)
        {
            x = x * 33554432.0f; // 2^25
            b = F32::toBits(x);
            ex = -25;
        }
        ex = ex + (i32)(b >> 23u) - 127;
        f32 m = F32::fromBits((b & 0x007FFFFFu) | 0x3F800000u);
        if (m > 1.41421356f)
        {
            m *= 0.5f;
            ex += 1;
        }
        *e = ex;

        f32 s = (m - 1.0f) / (m + 1.0f);
        f32 z = s * s;
        return 2.0f * s * (1.0f + z * (0.33333334f + z * (0.2f
             + z * (0.14285715f + z * 0.11111111f))));
    }

    /// Natural logarithm of x.
    static f32 log(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        f32 fe = (f32)e;
        return fe * 0.693359375f + (lm + fe * -2.12194440e-4f);
    }

    /// Base-2 logarithm of x.
    static f32 log2(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        return (f32)e + lm * 1.44269504f;
    }

    /// Base-10 logarithm of x.
    static f32 log10(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        return (f32)e * 0.30103f + ((f32)e * -1.7005e-7f + lm * 0.43429448f);
    }

    /// Raises x to the power y.
    static f32 pow(f32 x, f32 y)
    {
        if (y == 0.0f || x == 1.0f) return 1.0f;
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();

        bool neg = false;
        if (x < 0.0f)
        {
            f32 ty = F32::trunc(y);
            if (ty != y) return F32::nan();
            if (F32::abs(y) < 16777216.0f && (((i32)ty) & 1) != 0) neg = true;
            x = -x;
        }

        f32 t = y * F32::log2(x);
        f32 r = F32::exp2(t);
        return neg ? -r : r;
    }

    /// Sine of x radians (accurate for |x| up to ~8192; beyond that precision degrades).
    static f32 sin(f32 x)
    {
        if (!F32::isFinite(x)) return F32::nan();
        f32 ax = F32::abs(x);
        bool neg = x < 0.0f;
        if (ax > 8192.0f) ax = F32::fmod(ax, 6.28318531f);

        i32 j = (i32)(1.27323954f * ax);
        f32 y = (f32)j;
        j &= 7;
        if (j > 3) { neg = !neg; j -= 4; }

        ax = ((ax - y * 0.78515625f) - y * 2.4187564849853515625e-4f) - y * 3.77489497744594108e-8f;
        f32 z = ax * ax;
        f32 r;
        if (j == 1 || j == 2)
        {
            r = 1.0f - 0.5f * z + z * z * (0.04166664568f + z * (-0.001388731625f + z * 0.00002443315711f));
        }
        else {
            r = ax + ax * z * (-0.16666654611f + z * (0.0083321608736f + z * -0.00019515295891f));
        }
        return neg ? -r : r;
    }

    /// Cosine of x radians (accurate for |x| up to ~8192; beyond that precision degrades).
    static f32 cos(f32 x)
    {
        if (!F32::isFinite(x)) return F32::nan();
        f32 ax = F32::abs(x);
        bool neg = false;
        if (ax > 8192.0f) ax = F32::fmod(ax, 6.28318531f);

        i32 j = (i32)(1.27323954f * ax);
        f32 y = (f32)j;
        j &= 7;
        if (j > 3) { neg = !neg; j -= 4; }
        if (j > 1) neg = !neg;

        ax = ((ax - y * 0.78515625f) - y * 2.4187564849853515625e-4f) - y * 3.77489497744594108e-8f;
        f32 z = ax * ax;
        f32 r;
        if (j == 1 || j == 2)
        {
            r = ax + ax * z * (-0.16666654611f + z * (0.0083321608736f + z * -0.00019515295891f));
        }
        else {
            r = 1.0f - 0.5f * z + z * z * (0.04166664568f + z * (-0.001388731625f + z * 0.00002443315711f));
        }
        return neg ? -r : r;
    }

    /// Tangent of x radians.
    static f32 tan(f32 x)
    {
        return F32::sin(x) / F32::cos(x);
    }

    /// Arctangent of x, in radians.
    static f32 atan(f32 x)
    {
        if (F32::isNan(x)) return x;
        bool neg = x < 0.0f;
        f32 a = F32::abs(x);
        f32 y;

        if (a > 2.41421356f)
        {
            y = 1.57079633f;
            a = -1.0f / a;
        }
        else if (a > 0.41421356f)
        {
            y = 0.78539816f;
            a = (a - 1.0f) / (a + 1.0f);
        }
        else {
            y = 0.0f;
        }

        f32 z = a * a;
        y = y + (((8.05374449538e-2f * z - 1.38776856032e-1f) * z
              + 1.99777106478e-1f) * z - 3.33329491539e-1f) * z * a + a;
        return neg ? -y : y;
    }

    /// Arctangent of y / x using the signs of both arguments, in radians.
    static f32 atan2(f32 y, f32 x)
    {
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();

        bool yNeg = (F32::toBits(y) & 0x80000000u) != 0u;
        bool xNeg = (F32::toBits(x) & 0x80000000u) != 0u;

        if (F32::isInf(x))
        {
            if (F32::isInf(y))
            {
                f32 r = xNeg ? 2.35619449f : 0.78539816f;
                return yNeg ? -r : r;
            }
            f32 r = xNeg ? 3.14159265f : 0.0f;
            return yNeg ? -r : r;
        }
        if (F32::isInf(y)) return yNeg ? -1.57079633f : 1.57079633f;

        if (x == 0.0f)
        {
            if (y == 0.0f)
            {
                f32 r = xNeg ? 3.14159265f : 0.0f;
                return yNeg ? -r : r;
            }
            return yNeg ? -1.57079633f : 1.57079633f;
        }

        f32 r = F32::atan(y / x);
        if (xNeg)
        {
            if (yNeg) r = r - 3.14159265f;
            else r = r + 3.14159265f;
        }
        return r;
    }

    /// Arcsine of x, in radians.
    static f32 asin(f32 x)
    {
        if (F32::isNan(x) || F32::abs(x) > 1.0f) return F32::nan();
        return F32::atan2(x, F32::sqrt((1.0f - x) * (1.0f + x)));
    }

    /// Arccosine of x, in radians.
    static f32 acos(f32 x)
    {
        if (F32::isNan(x) || F32::abs(x) > 1.0f) return F32::nan();
        return F32::atan2(F32::sqrt((1.0f - x) * (1.0f + x)), x);
    }

    /// Hyperbolic sine of x.
    static f32 sinh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::abs(x);
        f32 r;
        if (a < 0.5f)
        {
            f32 z = a * a;
            r = a * (1.0f + z * (0.16666667f + z * (0.008333334f
                + z * (0.00019841270f + z * 0.0000027557319f))));
        }
        else {
            f32 h = F32::exp(a - 0.69314718f); // e^a / 2
            r = h - 0.25f / h;
        }
        return x < 0.0f ? -r : r;
    }

    /// Hyperbolic cosine of x.
    static f32 cosh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::abs(x);
        f32 h = F32::exp(a - 0.69314718f); // e^a / 2
        return h + 0.25f / h;
    }

    /// Hyperbolic tangent of x.
    static f32 tanh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::abs(x);
        f32 r;
        if (a >= 9.01f)
        {
            r = 1.0f;
        }
        else if (a < 0.3f)
        {
            f32 z = a * a;
            r = a * (1.0f + z * (-0.33333334f + z * (0.13333334f
                + z * (-0.053968254f + z * 0.021869488f))));
        }
        else {
            f32 e = F32::exp(2.0f * a);
            r = 1.0f - 2.0f / (e + 1.0f);
        }
        return x < 0.0f ? -r : r;
    }

    /// erf via the all-positive series, for 0 <= x < 1.5.
    static f32 erfSeries(f32 x)
    {
        f32 sum = x;
        f32 term = x;
        f32 x2 = x * x;
        for (i32 n = 1; n < 60; n += 1)
        {
            term = term * 2.0f * x2 / (f32)(2 * n + 1);
            sum = sum + term;
            if (term < 1.0e-9f * sum) break;
        }
        return 1.12837917f * F32::exp(-x2) * sum;
    }

    /// erfc via continued fraction, for x >= 1.5.
    static f32 erfcFrac(f32 x)
    {
        f32 f = x;
        for (i32 k = 100; k >= 1; k = k - 1)
        {
            f = x + 0.5f * (f32)k / f;
        }
        return F32::exp(-x * x) * 0.56418958f / f;
    }

    /// Error function of x.
    static f32 erf(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::abs(x);
        f32 r;
        if (a < 1.5f) r = F32::erfSeries(a);
        else if (a >= 6.0f) r = 1.0f;
        else r = 1.0f - F32::erfcFrac(a);
        return x < 0.0f ? -r : r;
    }

    /// Complementary error function of x.
    static f32 erfc(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x < 0.0f) return 2.0f - F32::erfc(-x);
        if (x < 1.5f) return 1.0f - F32::erfSeries(x);
        if (x > 10.0f) return 0.0f;
        return F32::erfcFrac(x);
    }

    /// Lanczos series (g = 7, n = 9) for an argument already reduced by 1.
    static f32 lanczos(f32 x)
    {
        return 0.99999999999980993f
             + 676.5203681218851f    / (x + 1.0f)
             + -1259.1392167224028f  / (x + 2.0f)
             + 771.32342877765313f   / (x + 3.0f)
             + -176.61502916214059f  / (x + 4.0f)
             + 12.507343278686905f   / (x + 5.0f)
             + -0.13857109526572012f / (x + 6.0f)
             + 9.9843695780195716e-6f / (x + 7.0f)
             + 1.5056327351493116e-7f / (x + 8.0f);
    }

    /// Natural logarithm of the absolute value of the gamma function of x.
    static f32 lgamma(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (F32::isInf(x)) return F32::inf();
        if (x <= 0.0f && x == F32::trunc(x)) return F32::inf();
        if (x == 1.0f || x == 2.0f) return 0.0f;

        if (x < 0.5f)
        {
            f32 s = F32::abs(F32::sin(3.14159265f * x));
            return F32::log(3.14159265f / s) - F32::lgamma(1.0f - x);
        }

        x -= 1.0f;
        f32 t = x + 7.5f;
        return 0.91893853f + (x + 0.5f) * F32::log(t) - t + F32::log(F32::lanczos(x));
    }

    /// Gamma function of x.
    static f32 tgamma(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x == F32::inf()) return x;
        if (x == -F32::inf()) return F32::nan();
        if (x == 0.0f)
        {
            bool neg = (F32::toBits(x) & 0x80000000u) != 0u;
            return neg ? -F32::inf() : F32::inf();
        }
        if (x < 0.0f && x == F32::trunc(x)) return F32::nan();

        // Exact factorials for small positive integers.
        if (x > 0.0f && x == F32::trunc(x) && x <= 35.0f)
        {
            f32 r = 1.0f;
            for (f32 i = 2.0f; i < x; i += 1.0f) r *= i;
            return r;
        }
        if (x > 35.040095f) return F32::inf();

        if (x < 0.5f)
        {
            return 3.14159265f / (F32::sin(3.14159265f * x) * F32::tgamma(1.0f - x));
        }

        x -= 1.0f;
        f32 t = x + 7.5f;
        f32 p = F32::pow(t, (x + 0.5f) * 0.5f);
        return 2.50662827f * p * F32::exp(-t) * p * F32::lanczos(x);
    }

    /// Clamps v to the inclusive range [lo, hi].
    static f32 clamp(f32 v, f32 lo, f32 hi)
    {
        if (v < lo) return lo;
        if (v > hi) return hi;
        return v;
    }

    /// Linearly interpolates from a to b by t.
    static f32 lerp(f32 a, f32 b, f32 t)
    {
        return a + (b - a) * t;
    }

    /// Returns the fraction of v between a and b; inverse of lerp.
    static f32 invLerp(f32 a, f32 b, f32 v)
    {
        return (v - a) / (b - a);
    }

    /// Remaps v from the range [a1, b1] to [a2, b2].
    static f32 mapRange(f32 v, f32 a1, f32 b1, f32 a2, f32 b2)
    {
        return F32::lerp(a2, b2, F32::invLerp(a1, b1, v));
    }

    /// Returns the smaller of a and b.
    static f32 min(f32 a, f32 b) { return a < b ? a : b; }
    /// Returns the larger of a and b.
    static f32 max(f32 a, f32 b) { return a > b ? a : b; }

    /// Returns -1.0, 0.0, or 1.0 for the sign of x.
    static f32 sign(f32 x) { return x < 0.0f ? -1.0f : (x > 0.0f ? 1.0f : 0.0f); }

    /// Converts degrees to radians.
    static f32 degToRad(f32 deg) { return deg * 3.14159265f / 180.0f; }
    /// Converts radians to degrees.
    static f32 radToDeg(f32 rad) { return rad * 180.0f / 3.14159265f; }

    /// Returns x + y.
    static f32 add(f32 x, f32 y) { return x + y; }
    /// Returns x - y.
    static f32 sub(f32 x, f32 y) { return x - y; }
    /// Returns x * y.
    static f32 mul(f32 x, f32 y) { return x * y; }
    /// Returns x / y.
    static f32 div(f32 x, f32 y) { return x / y; }
}
