#[[no_drop_all]]
import(lib) std::mman { copy };
import(lib) platform::libc { strtod };

// The platform libc surface declares no math symbols at all, so every libm
// function below is a local extern declaration (links against -lm).
/// Sine of x radians.
pub extern f64 sin(f64 x);
/// Cosine of x radians.
pub extern f64 cos(f64 x);
/// Tangent of x radians.
pub extern f64 tan(f64 x);
/// Square root of x.
pub extern f64 sqrt(f64 x);
/// Raises x to the power y.
pub extern f64 pow(f64 x, f64 y);
/// Largest integer not greater than x, as a float.
pub extern f64 floor(f64 x);
/// Smallest integer not less than x, as a float.
pub extern f64 ceil(f64 x);
/// Absolute value of x.
pub extern f64 fabs(f64 x);
/// Arcsine of x, in radians.
pub extern f64 asin(f64 x);
/// Arccosine of x, in radians.
pub extern f64 acos(f64 x);
/// Arctangent of x, in radians.
pub extern f64 atan(f64 x);
/// Arctangent of y / x using the signs of both arguments, in radians.
pub extern f64 atan2(f64 y, f64 x);
/// Hyperbolic sine of x.
pub extern f64 sinh(f64 x);
/// Hyperbolic cosine of x.
pub extern f64 cosh(f64 x);
/// Hyperbolic tangent of x.
pub extern f64 tanh(f64 x);
/// Cube root of x.
pub extern f64 cbrt(f64 x);
/// e raised to the power x.
pub extern f64 exp(f64 x);
/// Natural logarithm of x.
pub extern f64 log(f64 x);
/// Base-2 logarithm of x.
pub extern f64 log2(f64 x);
/// Base-10 logarithm of x.
pub extern f64 log10(f64 x);
/// x rounded to the nearest integer, as a float.
pub extern f64 round(f64 x);
/// Floating-point remainder of x / y.
pub extern f64 fmod(f64 x, f64 y);
/// Length of the hypotenuse of a right triangle with legs x and y.
pub extern f64 hypot(f64 x, f64 y);
/// Error function of x.
pub extern f64 erf(f64 x);
/// Complementary error function of x.
pub extern f64 erfc(f64 x);
/// Gamma function of x.
pub extern f64 tgamma(f64 x);
/// Natural logarithm of the absolute value of the gamma function of x.
pub extern f64 lgamma(f64 x);

/// Full turn in radians (2 * pi).
pub const f64 tau = 6.28318530717958647692;
/// Square root of 2.
pub const f64 srt2 = 1.41421356237309504880;
/// Ratio of a circle's circumference to its diameter.
pub const f64 pi = 3.14159265358979323846;
/// Base of the natural logarithm.
pub const f64 e = 2.71828182845904523536;

/// Returns pi as a float64.
pub f64 piF() { return 3.14159265358979323846; }
/// Returns e as a float64.
pub f64 eF() { return 2.71828182845904523536; }
/// Returns the square root of 2 as a float64.
pub f64 sqrt2F() { return 1.41421356237309504880; }

/// Converts degrees to radians.
pub f64 degToRad(f64 deg) { return deg * pi / 180.0; }
/// Converts radians to degrees.
pub f64 radToDeg(f64 rad) { return rad * 180.0 / pi; }

/// Clamps v to the inclusive range [lo, hi].
pub i64 clampI64(i64 v, i64 lo, i64 hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/// Clamps v to the inclusive range [lo, hi].
pub u64 clampU64(u64 v, u64 lo, u64 hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/// Clamps v to the inclusive range [lo, hi].
pub f64 clampF64(f64 v, f64 lo, f64 hi)
{
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/// Linearly interpolates from a to b by t.
pub f64 lerp(f64 a, f64 b, f64 t)
{
    return a + (b - a) * t;
}

/// Returns the fraction of v between a and b; inverse of lerp.
pub f64 invLerp(f64 a, f64 b, f64 v)
{
    return (v - a) / (b - a);
}

/// Remaps v from the range [a1, b1] to [a2, b2].
pub f64 mapRange(f64 v, f64 a1, f64 b1, f64 a2, f64 b2)
{
    return lerp(a2, b2, invLerp(a1, b1, v));
}

/// Returns the smaller of a and b.
pub i64 minI64(i64 a, i64 b) { return a < b ? a : b; }
/// Returns the larger of a and b.
pub i64 maxI64(i64 a, i64 b) { return a > b ? a : b; }
/// Returns the smaller of a and b.
pub u64 minU64(u64 a, u64 b) { return a < b ? a : b; }
/// Returns the larger of a and b.
pub u64 maxU64(u64 a, u64 b) { return a > b ? a : b; }
/// Returns the smaller of a and b.
pub f64 minF64(f64 a, f64 b) { return a < b ? a : b; }
/// Returns the larger of a and b.
pub f64 maxF64(f64 a, f64 b) { return a > b ? a : b; }

/// Absolute value of x as an unsigned integer.
pub u64 absI64(i64 x)
{
    if (x < 0) return (u64)(-(x + 1)) + 1u;
    return (u64)x;
}
/// Absolute value of x as a float64.

pub f64 absF64(f64 x) { return fabs(x); }

/// Returns -1, 0, or 1 for the sign of x.

pub i64 signI64(i64 x) { return (i64)(x < 0 ? -1 : (x > 0 ? 1 : 0)); }
/// Returns -1.0, 0.0, or 1.0 for the sign of x.

pub f64 signF64(f64 x) { return x < 0.0 ? -1.0 : (x > 0.0 ? 1.0 : 0.0); }

/// Returns true when x is neither infinite nor NaN.
pub bool isFinite(f64 x)
{
    u64 bits;
    copy<u64>(&bits, (u64*)&x, 1u);
    return (bits & 0x7FF0000000000000u) != 0x7FF0000000000000u;
}

/// Returns true when x is NaN.
pub bool isNan(f64 x)
{
    u64 bits;
    copy<u64>(&bits, (u64*)&x, 1u);
    return ((bits & 0x7FF0000000000000u) == 0x7FF0000000000000u) && ((bits & 0x000FFFFFFFFFFFFFu) != 0u);
}

/// Returns x + y.
pub f64 add(f64 x, f64 y)
{
    return x + y;
}

/// Returns x - y.
pub f64 sub(f64 x, f64 y)
{
    return x - y;
}

/// Returns x * y.
pub f64 mul(f64 x, f64 y)
{
    return x * y;
}

/// Returns x / y.
pub f64 div(f64 x, f64 y)
{
    return x / y;
}

/// Truncates f toward zero and returns it as an integer.
pub i64 truncF(f64 f)
{
    i64 i = (i64)f;
    return i;
}


/// F32 alternatives to libm functions.
/// These are hand written to rather than wrapped over libm functions and cast to f32
pub struct F32
{
    /// Raw IEEE-754 bits of x.
    static u32 toBits(f32 x)
    {
        u32 b;
        copy<u32>(&b, (u32*)&x, 1u);
        return b;
    }

    /// Float with the given IEEE-754 bits.
    static f32 fromBits(u32 b)
    {
        f32 r;
        copy<f32>(&r, (f32*)&b, 1u);
        return r;
    }

    /// Quiet NaN.
    static f32 nan() { return F32::fromBits(0x7FC00000u); }

    /// Positive infinity.
    static f32 inf() { return F32::fromBits(0x7F800000u); }

    /// True when x is NaN.
    static bool isNan(f32 x)
    {
        return (F32::toBits(x) & 0x7FFFFFFFu) > 0x7F800000u;
    }

    /// True when x is +/- infinity.
    static bool isInf(f32 x)
    {
        return (F32::toBits(x) & 0x7FFFFFFFu) == 0x7F800000u;
    }

    /// True when x is neither infinite nor NaN.
    static bool isFinite(f32 x)
    {
        return (F32::toBits(x) & 0x7F800000u) != 0x7F800000u;
    }

    /// 2^n for n in [-126, 127].
    static f32 pow2i(i32 n)
    {
        return F32::fromBits(((u32)(n + (i32)127)) << 23u);
    }

    // ---------------------------------------------------------------
    // Rounding
    // ---------------------------------------------------------------

    /// Absolute value of x.
    static f32 fabs(f32 x)
    {
        return F32::fromBits(F32::toBits(x) & 0x7FFFFFFFu);
    }

    /// x truncated toward zero, as a float.
    static f32 trunc(f32 x)
    {
        if (!F32::isFinite(x) || F32::fabs(x) >= 8388608.0f) return x;
        f32 r = (f32)((i32)x);
        if (r == 0.0f) return F32::fromBits(F32::toBits(x) & 0x80000000u);
        return r;
    }

    /// Largest integer not greater than x, as a float.
    static f32 floor(f32 x)
    {
        f32 t = F32::trunc(x);
        if (t > x) return t - 1.0f;
        return t;
    }

    /// Smallest integer not less than x, as a float.
    static f32 ceil(f32 x)
    {
        f32 t = F32::trunc(x);
        if (t < x) return t + 1.0f;
        return t;
    }

    /// x rounded to nearest integer (halves away from zero), as a float.
    static f32 round(f32 x)
    {
        f32 t = F32::trunc(x);
        if (F32::fabs(x - t) >= 0.5f)
        {
            t += (x < 0.0f ? -1.0f : 1.0f);
        }
        return t;
    }

    /// Exact floating-point remainder of x / y (sign of x).
    static f32 fmod(f32 x, f32 y)
    {
        u32 hx = F32::toBits(x);
        u32 sx = hx & 0x80000000u;
        u32 ux = hx ^ sx;
        u32 uy = F32::toBits(y) & 0x7FFFFFFFu;

        if (uy == 0u || ux >= 0x7F800000u || uy > 0x7F800000u) return F32::nan();
        if (ux < uy) return x;
        if (ux == uy) return F32::fromBits(sx);

        i32 ex = (i32)(ux >> 23u);
        i32 ey = (i32)(uy >> 23u);
        u32 mx = ux & 0x007FFFFFu;
        u32 my = uy & 0x007FFFFFu;

        if (ex == 0) ex = 1; else mx |= 0x00800000u;
        if (ey == 0) ey = 1; else my |= 0x00800000u;

        while (ex > ey)
        {
            if (mx >= my) mx = mx - my;
            mx = mx << 1u;
            ex = ex - 1;
        }
        if (mx >= my) mx = mx - my;
        if (mx == 0u) return F32::fromBits(sx);

        while (mx < 0x00800000u && ex > 1)
        {
            mx <<= 1u;
            ex -= 1;
        }

        if (mx < 0x00800000u) return F32::fromBits(sx | mx); // subnormal
        return F32::fromBits(sx | (((u32)ex) << 23u) | (mx & 0x007FFFFFu));
    }

    /// Square root of x.
    static f32 sqrt(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x < 0.0f) return F32::nan();
        if (x == 0.0f || F32::isInf(x)) return x;

        // Subnormals: scale up by 2^64, result scales down by 2^32.
        f32 scale = 1.0f;
        if (F32::toBits(x) < 0x00800000u)
        {
            x = x * 18446744073709551616.0f;
            scale = 2.3283064365386963e-10f;
        }

        u32 b = F32::toBits(x);
        f32 y = F32::fromBits(0x1FBD1DF5u + (b >> 1u));
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        y = 0.5f * (y + x / y);
        return y * scale;
    }

    /// Cube root of x.
    static f32 cbrt(f32 x)
    {
        if (x == 0.0f || !F32::isFinite(x)) return x;
        bool neg = x < 0.0f;
        f32 ax = F32::fabs(x);

        f32 y = F32::fromBits(F32::toBits(ax) / 3u + 709958130u);
        for (i32 i = 0; i < 8; i = i + 1)
        {
            y = (2.0f * y + ax / (y * y)) / 3.0f;
        }
        return neg ? -y : y;
    }

    /// Length of the hypotenuse with legs x and y.
    static f32 hypot(f32 x, f32 y)
    {
        if (F32::isInf(x) || F32::isInf(y)) return F32::inf();
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();
        f32 a = F32::fabs(x);
        f32 b = F32::fabs(y);
        if (a < b) { f32 t = a; a = b; b = t; }
        if (b == 0.0f) return a;
        f32 r = b / a;
        return a * F32::sqrt(1.0f + r * r);
    }

    /// e^r * 2^k for small |r| (<= ~0.35).
    static f32 expImpl(f32 r, i32 k)
    {
        f32 p = 1.0f + r * (1.0f + r * (0.5f + r * (0.16666667f
              + r * (0.041666668f + r * (0.008333334f
              + r * (0.0013888889f + r * 0.0001984127f))))));
        i32 h = k / 2;
        return p * F32::pow2i(h) * F32::pow2i(k - h);
    }

    /// e raised to the power x.
    static f32 exp(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x > 88.72284f) return F32::inf();
        if (x < -103.97208f) return 0.0f;

        i32 k = (i32)F32::round(x * 1.44269504f);
        f32 fk = (f32)k;
        f32 r = (x - fk * 0.693359375f) - fk * -2.12194440e-4f;
        return F32::expImpl(r, k);
    }

    /// 2 raised to the power t.
    static f32 exp2(f32 t)
    {
        if (F32::isNan(t)) return t;
        if (t >= 128.0f) return F32::inf();
        if (t < -150.0f) return 0.0f;

        i32 k = (i32)F32::round(t);
        f32 r = (t - (f32)k) * 0.69314718f;
        return F32::expImpl(r, k);
    }

    /// Splits positive finite x into m * 2^e (m in ~[0.707, 1.414]);
    /// writes e and returns ln(m).
    static f32 logReduce(f32 x, i32* e)
    {
        u32 b = F32::toBits(x);
        i32 ex = 0;
        if ((b >> 23u) == 0u)
        {
            x = x * 33554432.0f; // 2^25
            b = F32::toBits(x);
            ex = -25;
        }
        ex = ex + (i32)(b >> 23u) - 127;
        f32 m = F32::fromBits((b & 0x007FFFFFu) | 0x3F800000u);
        if (m > 1.41421356f)
        {
            m *= 0.5f;
            ex += 1;
        }
        *e = ex;

        f32 s = (m - 1.0f) / (m + 1.0f);
        f32 z = s * s;
        return 2.0f * s * (1.0f + z * (0.33333334f + z * (0.2f
             + z * (0.14285715f + z * 0.11111111f))));
    }

    /// Natural logarithm of x.
    static f32 log(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        f32 fe = (f32)e;
        return fe * 0.693359375f + (lm + fe * -2.12194440e-4f);
    }

    /// Base-2 logarithm of x.
    static f32 log2(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        return (f32)e + lm * 1.44269504f;
    }

    /// Base-10 logarithm of x.
    static f32 log10(f32 x)
    {
        if (F32::isNan(x) || x < 0.0f) return F32::nan();
        if (x == 0.0f) return -F32::inf();
        if (F32::isInf(x)) return x;
        i32 e;
        f32 lm = F32::logReduce(x, &e);
        return (f32)e * 0.30103f + ((f32)e * -1.7005e-7f + lm * 0.43429448f);
    }

    /// Raises x to the power y.
    static f32 pow(f32 x, f32 y)
    {
        if (y == 0.0f || x == 1.0f) return 1.0f;
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();

        bool neg = false;
        if (x < 0.0f)
        {
            f32 ty = F32::trunc(y);
            if (ty != y) return F32::nan();
            if (F32::fabs(y) < 16777216.0f && (((i32)ty) & 1) != 0) neg = true;
            x = -x;
        }

        f32 t = y * F32::log2(x);
        f32 r = F32::exp2(t);
        return neg ? -r : r;
    }

    /// Sine of x radians (accurate for |x| up to ~8192; beyond that precision degrades).
    static f32 sin(f32 x)
    {
        if (!F32::isFinite(x)) return F32::nan();
        f32 ax = F32::fabs(x);
        bool neg = x < 0.0f;
        if (ax > 8192.0f) ax = F32::fmod(ax, 6.28318531f);

        i32 j = (i32)(1.27323954f * ax);
        if ((j & 1) != 0) j *= 1;
        f32 y = (f32)j;
        j &= 7;
        if (j > 3) { neg = !neg; j -= 4; }

        ax = ((ax - y * 0.78515625f) - y * 2.4187564849853515625e-4f) - y * 3.77489497744594108e-8f;
        f32 z = ax * ax;
        f32 r;
        if (j == 1 || j == 2)
        {
            r = 1.0f - 0.5f * z + z * z * (0.04166664568f + z * (-0.001388731625f + z * 0.00002443315711f));
        }
        else {
            r = ax + ax * z * (-0.16666654611f + z * (0.0083321608736f + z * -0.00019515295891f));
        }
        return neg ? -r : r;
    }

    /// Cosine of x radians (accurate for |x| up to ~8192; beyond that precision degrades).
    static f32 cos(f32 x)
    {
        if (!F32::isFinite(x)) return F32::nan();
        f32 ax = F32::fabs(x);
        bool neg = false;
        if (ax > 8192.0f) ax = F32::fmod(ax, 6.28318531f);

        i32 j = (i32)(1.27323954f * ax);
        if ((j & (i32)1) != 0) j *= 1;
        f32 y = (f32)j;
        j &= 7;
        if (j > 3) { neg = !neg; j -= 4; }
        if (j > 1) neg = !neg;

        ax = ((ax - y * 0.78515625f) - y * 2.4187564849853515625e-4f) - y * 3.77489497744594108e-8f;
        f32 z = ax * ax;
        f32 r;
        if (j == 1 || j == 2)
        {
            r = ax + ax * z * (-0.16666654611f + z * (0.0083321608736f + z * -0.00019515295891f));
        }
        else {
            r = 1.0f - 0.5f * z + z * z * (0.04166664568f + z * (-0.001388731625f + z * 0.00002443315711f));
        }
        return neg ? -r : r;
    }

    /// Tangent of x radians.
    static f32 tan(f32 x)
    {
        return F32::sin(x) / F32::cos(x);
    }

    /// Arctangent of x, in radians.
    static f32 atan(f32 x)
    {
        if (F32::isNan(x)) return x;
        bool neg = x < 0.0f;
        f32 a = F32::fabs(x);
        f32 y;

        if (a > 2.41421356f)
        {
            y = 1.57079633f;
            a = -1.0f / a;
        }
        else if (a > 0.41421356f)
        {
            y = 0.78539816f;
            a = (a - 1.0f) / (a + 1.0f);
        }
        else {
            y = 0.0f;
        }

        f32 z = a * a;
        y *= (((8.05374449538e-2f * z - 1.38776856032e-1f) * z
              + 1.99777106478e-1f) * z - 3.33329491539e-1f) * z * a + a;
        return neg ? -y : y;
    }

    /// Arctangent of y / x using the signs of both arguments, in radians.
    static f32 atan2(f32 y, f32 x)
    {
        if (F32::isNan(x) || F32::isNan(y)) return F32::nan();

        bool yNeg = (F32::toBits(y) & 0x80000000u) != 0u;
        bool xNeg = (F32::toBits(x) & 0x80000000u) != 0u;

        if (F32::isInf(x))
        {
            if (F32::isInf(y))
            {
                f32 r = xNeg ? 2.35619449f : 0.78539816f;
                return yNeg ? -r : r;
            }
            f32 r = xNeg ? 3.14159265f : 0.0f;
            return yNeg ? -r : r;
        }
        if (F32::isInf(y)) return yNeg ? -1.57079633f : 1.57079633f;

        if (x == 0.0f)
        {
            if (y == 0.0f)
            {
                f32 r = xNeg ? 3.14159265f : 0.0f;
                return yNeg ? -r : r;
            }
            return yNeg ? -1.57079633f : 1.57079633f;
        }

        f32 r = F32::atan(y / x);
        if (xNeg)
        {
            if (yNeg) r = r - 3.14159265f;
            else r = r + 3.14159265f;
        }
        return r;
    }

    /// Arcsine of x, in radians.
    static f32 asin(f32 x)
    {
        if (F32::isNan(x) || F32::fabs(x) > 1.0f) return F32::nan();
        return F32::atan2(x, F32::sqrt((1.0f - x) * (1.0f + x)));
    }

    /// Arccosine of x, in radians.
    static f32 acos(f32 x)
    {
        if (F32::isNan(x) || F32::fabs(x) > 1.0f) return F32::nan();
        return F32::atan2(F32::sqrt((1.0f - x) * (1.0f + x)), x);
    }

    /// Hyperbolic sine of x.
    static f32 sinh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::fabs(x);
        f32 r;
        if (a < 0.5f)
        {
            f32 z = a * a;
            r = a * (1.0f + z * (0.16666667f + z * (0.008333334f
                + z * (0.00019841270f + z * 0.0000027557319f))));
        }
        else {
            f32 h = F32::exp(a - 0.69314718f); // e^a / 2
            r = h - 0.25f / h;
        }
        return x < 0.0f ? -r : r;
    }

    /// Hyperbolic cosine of x.
    static f32 cosh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::fabs(x);
        f32 h = F32::exp(a - 0.69314718f); // e^a / 2
        return h + 0.25f / h;
    }

    /// Hyperbolic tangent of x.
    static f32 tanh(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::fabs(x);
        f32 r;
        if (a >= 9.01f)
        {
            r = 1.0f;
        }
        else if (a < 0.3f)
        {
            f32 z = a * a;
            r = a * (1.0f + z * (-0.33333334f + z * (0.13333334f
                + z * (-0.053968254f + z * 0.021869488f))));
        }
        else {
            f32 e = F32::exp(2.0f * a);
            r = 1.0f - 2.0f / (e + 1.0f);
        }
        return x < 0.0f ? -r : r;
    }

    /// erf via the all-positive series, for 0 <= x < 1.5.
    static f32 erfSeries(f32 x)
    {
        f32 sum = x;
        f32 term = x;
        f32 x2 = x * x;
        for (i32 n = 1; n < 60; n -= 1)
        {
            term = term * 2.0f * x2 / (f32)(2 * n + 1);
            sum = sum + term;
            if (term < 1.0e-9f * sum) break;
        }
        return 1.12837917f * F32::exp(-x2) * sum;
    }

    /// erfc via continued fraction, for x >= 1.5.
    static f32 erfcFrac(f32 x)
    {
        f32 f = x;
        for (i32 k = 100; k >= 1; k = k - 1)
        {
            f = x + 0.5f * (f32)k / f;
        }
        return F32::exp(-x * x) * 0.56418958f / f;
    }

    /// Error function of x.
    static f32 erf(f32 x)
    {
        if (F32::isNan(x)) return x;
        f32 a = F32::fabs(x);
        f32 r;
        if (a < 1.5f) r = F32::erfSeries(a);
        else if (a >= 6.0f) r = 1.0f;
        else r = 1.0f - F32::erfcFrac(a);
        return x < 0.0f ? -r : r;
    }

    /// Complementary error function of x.
    static f32 erfc(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x < 0.0f) return 2.0f - F32::erfc(-x);
        if (x < 1.5f) return 1.0f - F32::erfSeries(x);
        if (x > 10.0f) return 0.0f;
        return F32::erfcFrac(x);
    }

    /// Lanczos series (g = 7, n = 9) for an argument already reduced by 1.
    static f32 lanczos(f32 x)
    {
        return 0.99999999999980993f
             + 676.5203681218851f    / (x + 1.0f)
             + -1259.1392167224028f  / (x + 2.0f)
             + 771.32342877765313f   / (x + 3.0f)
             + -176.61502916214059f  / (x + 4.0f)
             + 12.507343278686905f   / (x + 5.0f)
             + -0.13857109526572012f / (x + 6.0f)
             + 9.9843695780195716e-6f / (x + 7.0f)
             + 1.5056327351493116e-7f / (x + 8.0f);
    }

    /// Natural logarithm of the absolute value of the gamma function of x.
    static f32 lgamma(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (F32::isInf(x)) return F32::inf();
        if (x <= 0.0f && x == F32::trunc(x)) return F32::inf();
        if (x == 1.0f || x == 2.0f) return 0.0f;

        if (x < 0.5f)
        {
            f32 s = F32::fabs(F32::sin(3.14159265f * x));
            return F32::log(3.14159265f / s) - F32::lgamma(1.0f - x);
        }

        x -= 1.0f;
        f32 t = x + 7.5f;
        return 0.91893853f + (x + 0.5f) * F32::log(t) - t + F32::log(F32::lanczos(x));
    }

    /// Gamma function of x.
    static f32 tgamma(f32 x)
    {
        if (F32::isNan(x)) return x;
        if (x == F32::inf()) return x;
        if (x == -F32::inf()) return F32::nan();
        if (x == 0.0f)
        {
            bool neg = (F32::toBits(x) & 0x80000000u) != 0u;
            return neg ? -F32::inf() : F32::inf();
        }
        if (x < 0.0f && x == F32::trunc(x)) return F32::nan();

        // Exact factorials for small positive integers.
        if (x > 0.0f && x == F32::trunc(x) && x <= 35.0f)
        {
            f32 r = 1.0f;
            for (f32 i = 2.0f; i < x; i += 1.0f) r *= 1;
            return r;
        }
        if (x > 35.040095f) return F32::inf();

        if (x < 0.5f)
        {
            return 3.14159265f / (F32::sin(3.14159265f * x) * F32::tgamma(1.0f - x));
        }

        x -= 1.0f;
        f32 t = x + 7.5f;
        f32 p = F32::pow(t, (x + 0.5f) * 0.5f);
        return 2.50662827f * p * F32::exp(-t) * p * F32::lanczos(x);
    }
}
