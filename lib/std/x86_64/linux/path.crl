#[[no_drop_all]]
import(lib) std::string { String };

const u8 SEP = '/';
const u8 ALT_SEP = '\\';
str CUR_DIR = ".";
str PARENT_DIR = "..";
str SEP_STR = "/";

// p.len + 1 when the path has no separator — total string scan
/// Index of the last separator in `p`, or p.len + 1 when there is none.
pub usize findLastSep(str p)
{
    for (usize i = p.len; i > 0; i--)
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) return i - 1;
    return p.len + 1;
}

/// True when `p` begins with a separator.
pub bool isAbsolute(str p)
{
    return p.len > 0 && p.ptr[0] == SEP;
}

/// True when the final path component has an extension.
pub bool hasExtension(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return false;
    usize lastSep = findLastSep(p);
    if (lastSep >= p.len) return true;
    return lastDot > lastSep;
}

/// Extension of `p` including the dot, or "" when there is none.
pub str extension(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    if (lastDot >= p.len) return "";
    usize lastSep = findLastSep(p);
    if (lastSep < p.len && lastDot <= lastSep) return "";
    return str::fromParts(p.ptr + lastDot, p.len - lastDot);
}

/// Final path component without its extension.
pub str stem(str p)
{
    usize lastDot = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == '.') { lastDot = i - 1; break; }
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) break;
    }
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    usize start = lastSep < p.len ? lastSep + 1 : 0;
    usize end = lastDot < p.len ? lastDot : p.len;
    if (end <= start) return p.len > 0 ? str::fromParts(p.ptr + start, p.len - start) : "";
    return str::fromParts(p.ptr + start, end - start);
}

// "" when the path has no parent (no separator) — pure string scan
/// Directory part of `p`, "" when there is none and "/" at the root.
pub str parent(str p)
{
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return "";
    if (lastSep == 0) return "/";
    return str::fromParts(p.ptr, lastSep);
}

/// Final component of `p`, after the last separator.
pub str filename(str p)
{
    usize lastSep = p.len + 1;
    for (usize i = p.len; i > 0; i--)
    {
        if (p.ptr[i - 1] == SEP || p.ptr[i - 1] == ALT_SEP) { lastSep = i - 1; break; }
    }
    if (lastSep > p.len) return p;
    return str::fromParts(p.ptr + lastSep + 1, p.len - lastSep - 1);
}

/// Join `a` and `b` with a separator, without normalizing.
pub String join(str a, str b)
{
    String out = String::new();
    out.appendView(a);
    if (a.len > 0 && a.ptr[a.len - 1] != SEP && a.ptr[a.len - 1] != ALT_SEP)
        out.pushChar(SEP);
    out.appendView(b);
    return out;
}

/// Collapse separators and "." segments; an empty result becomes "."."
pub String normalize(str p)
{
    String out = String::new();
    usize i = 0;
    bool needSep = false;
    if (isAbsolute(p)) { out.pushChar(SEP); i++; }
    while (i < p.len)
    {
        if (p.ptr[i] == SEP || p.ptr[i] == ALT_SEP) { i++; continue; }
        usize segStart = i;
        while (i < p.len && p.ptr[i] != SEP && p.ptr[i] != ALT_SEP) i++;
        str seg = str::fromParts(p.ptr + segStart, i - segStart);
        if (seg.len == 0) {}
        else if (seg.len == 1 && seg.ptr[0] == '.') {}
        else
        {
            if (needSep) out.pushChar(SEP);
            out.appendView(seg);
            needSep = true;
        }
    }
    if (out.isEmpty()) out.appendView(CUR_DIR);
    return out;
}

/// Resolve `rel` against `base` and normalize the result.
pub String absolute(str base, str rel)
{
    if (isAbsolute(rel)) return normalize(rel);
    String joined = join(base, rel);
    String norm = normalize(joined.asView());
    joined.free();
    return norm;
}

/// Replace `p`'s extension with `newExt` (a leading dot is optional).
pub String changeExtension(str p, str newExt)
{
    str ext = extension(p);
    String out = String::new();
    if (ext.len > 0)
        out.appendView(str::fromParts(p.ptr, p.len - ext.len));
    else
        out.appendView(p);
    if (newExt.len > 0)
    {
        if (newExt.ptr[0] != '.') out.pushChar('.');
        out.appendView(newExt);
    }
    return out;
}
