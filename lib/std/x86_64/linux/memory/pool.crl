#[[no_drop_all]]
import mman { alloc, dealloc, copy };

/// Pool of fixed-size, reusable T objects.
pub struct Pool<T>
{
    rawptr freeList;
    u8* blocks;
    usize blockSize;
    usize blockCount;
    usize totalBlocks;
    usize usedBlocks;

    /// Construct an empty pool.
    static Pool<T> new()
    {
        return Pool<T> {
            .freeList = null,
            .blocks = null,
            .blockSize = @sizeof(T) < @sizeof(rawptr) ? @sizeof(rawptr) : @sizeof(T),
            .blockCount = 0,
            .totalBlocks = 0,
            .usedBlocks = 0
        };
    }

    /// Free all backing blocks; the pool becomes empty.
    void dispose()
    {
        dealloc<u8>(self.blocks);
        self.blocks = null;
        self.freeList = null;
        self.blockCount = 0;
        self.totalBlocks = 0;
    }

    bool _grow()
    {
        usize newCount = self.blockCount > 0 ? self.blockCount : 64;
        usize allocSize = self.blockSize * newCount;
        u8* newBlocks = alloc<u8>(allocSize);
        if (newBlocks == null) return false;
        u8* oldBase = self.blocks;
        if (self.blocks != null)
        {
            copy<u8>(newBlocks, self.blocks, self.blockSize * self.blockCount);
            dealloc<u8>(self.blocks);
        }
        self.blocks = newBlocks;
        rawptr oldFree = self.freeList;
        self.freeList = null;
        while (oldFree != null)
        {
            rawptr next = *(rawptr*)oldFree;
            usize idx = (usize)((u8*)oldFree - oldBase) / self.blockSize;
            rawptr block = (rawptr)(self.blocks + idx * self.blockSize);
            *(rawptr*)block = self.freeList;
            self.freeList = block;
            oldFree = next;
        }
        for (usize i = self.blockCount; i < self.blockCount + newCount; i++)
        {
            rawptr block = (rawptr)(self.blocks + i * self.blockSize);
            *(rawptr*)block = self.freeList;
            self.freeList = block;
        }
        self.blockCount += newCount;
        self.totalBlocks = self.blockCount;
        return true;
    }

    // null — the backing-block grow allocation failed.
    /// Return a free object, growing the pool if needed; null on OOM.
    T* acquire()
    {
        if (self.freeList == null)
        {
            if (!self._grow()) return null;
        }
        rawptr block = self.freeList;
        self.freeList = *(rawptr*)block;
        self.usedBlocks++;
        return (T*)block;
    }

    /// Return obj to the pool for reuse.
    void release(T* obj)
    {
        if (obj == null) return;
        *(rawptr*)obj = self.freeList;
        self.freeList = (rawptr)obj;
        self.usedBlocks--;
    }

    /// Number of free objects.
    usize available() { return self.totalBlocks - self.usedBlocks; }
    /// Number of objects currently in use.
    usize used() { return self.usedBlocks; }
    /// Total number of objects the pool can hold.
    usize capacity() { return self.totalBlocks; }
}
