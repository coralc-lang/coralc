#[[no_drop_all]]
import(lib) platform::libc { pthread_rwlock_init, pthread_rwlock_destroy,
                             pthread_rwlock_rdlock, pthread_rwlock_wrlock,
                             pthread_rwlock_tryrdlock, pthread_rwlock_trywrlock, pthread_rwlock_unlock };

/// Reader/writer lock; many readers or one writer.
pub struct RwLock
{
    rawptr[8] impl;

    /// Initialize the lock.
    void init() { pthread_rwlock_init(self.impl, null); }
    /// Destroy the lock; must be unlocked.
    void destroy() { pthread_rwlock_destroy(self.impl); }
    /// Acquire a shared read lock, blocking while a writer holds it.
    void readLock() { pthread_rwlock_rdlock(self.impl); }
    /// Acquire an exclusive write lock, blocking for readers and writers.
    void writeLock() { pthread_rwlock_wrlock(self.impl); }
    /// Try to acquire a read lock without blocking; true on success.
    bool tryReadLock() { return pthread_rwlock_tryrdlock(self.impl) == 0; }
    /// Try to acquire a write lock without blocking; true on success.
    bool tryWriteLock() { return pthread_rwlock_trywrlock(self.impl) == 0; }
    /// Release the read or write lock held by the calling thread.
    void unlock() { pthread_rwlock_unlock(self.impl); }
}
