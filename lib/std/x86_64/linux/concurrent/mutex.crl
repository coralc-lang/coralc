#[[no_drop_all]]
import(lib) platform::libc { pthread_mutex_init, pthread_mutexattr_init, pthread_mutexattr_settype, pthread_mutexattr_destroy, pthread_mutex_destroy, pthread_mutex_lock, pthread_mutex_unlock, pthread_mutex_trylock };

/// Mutual-exclusion lock.
pub struct Mutex
{
    rawptr impl[6];

    #[[inline]]
    /// Initialize a non-recursive mutex.
    void init() {
        pthread_mutex_init(self.impl, null);
    }
    /// Initialize a recursive mutex (same thread may re-lock).
    void initRecursive()
    {
        u8 attr[8];
        pthread_mutexattr_init(attr);
        pthread_mutexattr_settype(attr, 1);
        pthread_mutex_init(self.impl, attr);
        pthread_mutexattr_destroy(attr);
    }

    /// Destroy the mutex; must be unlocked.
    #[[inline]] void destroy() { pthread_mutex_destroy(self.impl); }
    /// Acquire the lock, blocking until available.
    #[[inline]] void lock() { pthread_mutex_lock(self.impl); }
    /// Release the lock held by the calling thread.
    #[[inline]] void unlock() { pthread_mutex_unlock(self.impl); }
    /// Try to acquire the lock without blocking; true on success.
    #[[inline]] bool tryLock() { return pthread_mutex_trylock(self.impl) == 0; }
}
