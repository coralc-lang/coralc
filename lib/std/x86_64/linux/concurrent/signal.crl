#[[no_drop_all]]
import(lib) platform::libc { signal, kill, raise };

/// Abort signal.
pub const i32 SIGABRT = 6;
/// Alarm clock timer expired.
pub const i32 SIGALRM = 14;
/// Bus error (bad memory access).
pub const i32 SIGBUS = 7;
/// Child process stopped or exited.
pub const i32 SIGCHLD = 17;
/// Continue a stopped process.
pub const i32 SIGCONT = 18;
/// Arithmetic exception (e.g. divide by zero).
pub const i32 SIGFPE = 8;
/// Hangup on controlling terminal.
pub const i32 SIGHUP = 1;
/// Illegal instruction.
pub const i32 SIGILL = 4;
/// Interactive interrupt (Ctrl-C).
pub const i32 SIGINT = 2;
/// Forced termination; cannot be caught or ignored.
pub const i32 SIGKILL = 9;
/// Write to a pipe with no reader.
pub const i32 SIGPIPE = 13;
/// Interactive quit (Ctrl-\).
pub const i32 SIGQUIT = 3;
/// Invalid memory reference.
pub const i32 SIGSEGV = 11;
/// Stop the process; cannot be caught or ignored.
pub const i32 SIGSTOP = 19;
/// Termination request.
pub const i32 SIGTERM = 15;
/// Interactive stop (Ctrl-Z).
pub const i32 SIGTSTP = 20;
/// Background read from the terminal.
pub const i32 SIGTTIN = 21;
/// Background write to the terminal.
pub const i32 SIGTTOU = 22;
/// User-defined signal 1.
pub const i32 SIGUSR1 = 10;
/// User-defined signal 2.
pub const i32 SIGUSR2 = 12;
/// Bad system call.
pub const i32 SIGSYS = 31;
/// Trace/breakpoint trap.
pub const i32 SIGTRAP = 5;
/// Urgent condition on a socket.
pub const i32 SIGURG = 23;
/// CPU time limit exceeded.
pub const i32 SIGXCPU = 24;
/// File size limit exceeded.
pub const i32 SIGXFSZ = 25;

// SIG_DFL/SIG_IGN are special pointer values, not integers.
// On posix, SIG_DFL = (void (*)(int))0, SIG_IGN = (void (*)(int))1.
// these are passed as raw usize and cast to function pointer.

/// Default signal handler.
pub const u8 SIG_DFL = 0;
/// Ignore-signal handler.
pub const usize SIG_IGN = 1;

/// Install handler for sig and return the previous handler.
pub rawptr handle(i32 sig, rawptr handler)
{
    return signal(sig, handler);
}

/// Ignore signal sig.
pub void ignore(i32 sig)
{
    signal(sig, (rawptr)(usize)SIG_IGN);
}

/// Restore the default handler for signal sig.
pub void defaultHandler(i32 sig)
{
    signal(sig, (rawptr)(usize)SIG_DFL);
}

/// Send signal sig to process pid; 0 on success, -1 on error.
pub i32 sendSig(i32 pid, i32 sig)
{
    return kill(pid, sig);
}

/// Send signal sig to the calling process.
pub i32 raiseSig(i32 sig)
{
    return raise(sig);
}
