#[[no_drop_all]]
import(lib) platform::libc { sem_init, sem_destroy, sem_wait, sem_trywait, sem_post, sem_getvalue };

/// Counting semaphore.
pub struct Semaphore
{
    rawptr impl[8];

    /// Initialize with the given initial count; true on success.
    bool init(u32 value)
    {
        return sem_init(self.impl, 0, value) == 0;
    }

    /// Destroy the semaphore.
    void destroy()
    {
        sem_destroy(self.impl);
    }

    /// Wait until the count is positive, then decrement it.
    void wait()
    {
        sem_wait(self.impl);
    }

    /// Decrement the count without blocking; true on success.
    bool tryWait()
    {
        return sem_trywait(self.impl) == 0;
    }

    /// Increment the count and wake a waiter.
    void post()
    {
        sem_post(self.impl);
    }

    /// Current count (if the platform can report it).
    i32 value()
    {
        i32 v;
        sem_getvalue(self.impl, &v);
        return v;
    }
}
