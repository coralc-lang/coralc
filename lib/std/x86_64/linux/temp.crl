#[[no_drop_all]]
import(lib) platform::libc { mkstemp, close, unlink, mkdtemp, rmdir };
import(lib) std::mman { alloc, dealloc, copy };
import(lib) std::string { String };
import(lib) std::result { Result };
import(lib) std::fs { File, IoError };

/// A temporary file that is deleted on dispose by default.
pub struct TempFile
{
    i32 fd;
    String path;
    bool autoDelete;

    /// Create a temp file with a unique name under the system temp directory.
    static Result<TempFile, IoError> create(str prefix, str suffix)
    {
        String tmpl = String::new();
        tmpl.appendView("/tmp/");
        tmpl.appendView(prefix);
        tmpl.appendView(suffix);
        tmpl.appendView("XXXXXX");

        u8* buf = alloc<u8>(tmpl.len + 1);
        if (buf == null)
        {
            tmpl.free();
            return Result<TempFile, IoError>::Err { .error = IoError::BadUsage { .msg = "out of memory" } };
        }
        copy<u8>(buf, (u8*)tmpl.asView().ptr, tmpl.len);
        buf[tmpl.len] = 0;

        i32 fd = mkstemp(buf);
        if (fd < 0)
        {
            dealloc<u8>(buf);
            tmpl.free();
            return Result<TempFile, IoError>::Err { .error = IoError::os("mkstemp") };
        }
        String actualPath = String::from(str::fromParts(buf, tmpl.len));
        dealloc<u8>(buf);
        tmpl.free();

        return Result<TempFile, IoError>::Ok { .value = TempFile { .fd = fd, .path = actualPath, .autoDelete = true } };
    }

    /// Close the file and, when auto-delete is on, unlink it.
    void dispose()
    {
        if (self.fd >= 0) close(self.fd);
        if (self.autoDelete && !self.path.isEmpty())
            unlink((const u8*)self.path.asView().ptr);
        self.path.free();
        self.fd = -1;
    }

    /// The open file handle for this temp file.
    File fd() { return (File)self.fd; }
    /// Path of the temp file on disk.
    
    str pathStr() { return self.path.asView(); }

    /// Set whether `dispose` removes the file.
    void setAutoDelete(bool ad) { self.autoDelete = ad; }
}

/// A temporary directory that is removed on dispose by default.
pub struct TempDir
{
    String path;
    bool autoDelete;

    /// Create a temp directory with a unique name under the system temp directory.
    static Result<TempDir, IoError> create(str prefix)
    {
        String tmpl = String::new();
        tmpl.appendView("/tmp/");
        tmpl.appendView(prefix);
        tmpl.appendView("XXXXXX");

        u8* buf = alloc<u8>(tmpl.len + 1);
        if (buf == null)
        {
            tmpl.free();
            return Result<TempDir, IoError>::Err { .error = IoError::BadUsage { .msg = "out of memory" } };
        }
        copy<u8>(buf, (u8*)tmpl.asView().ptr, tmpl.len);
        buf[tmpl.len] = 0;

        u8* result = mkdtemp(buf);
        if (result == null)
        {
            dealloc<u8>(buf);
            tmpl.free();
            return Result<TempDir, IoError>::Err { .error = IoError::os("mkdtemp") };
        }
        String actualPath = String::from(str::fromParts(buf, tmpl.len));
        dealloc<u8>(buf);
        tmpl.free();

        return Result<TempDir, IoError>::Ok { .value = TempDir { .path = actualPath, .autoDelete = true } };
    }

    /// Remove the directory when auto-delete is on.
    void dispose()
    {
        if (self.autoDelete && !self.path.isEmpty())
            rmdir((const u8*)self.path.asView().ptr);
        self.path.free();
    }

    /// Path of the temp directory on disk.
    
    str pathStr() { return self.path.asView(); }
    /// Set whether `dispose` removes the directory.
    void setAutoDelete(bool ad) { self.autoDelete = ad; }
    /// True when the temp directory has a path.
    
    bool isValid() { return !self.path.isEmpty(); }
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Drop glue for `TempFile`: calls `dispose()`.
pub extend TempFile : @drop
{
    void drop()
    {
        self.dispose();
    }
}

/// Drop glue for `TempDir`: calls `dispose()`.
pub extend TempDir : @drop
{
    void drop()
    {
        self.dispose();
    }
}
