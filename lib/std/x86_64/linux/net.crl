#[[no_drop_all]]
import(lib) platform::libc { close };
import(lib) platform::posix { socket, connect, bind, listen, accept, send, recv, sendto, recvfrom, setsockopt, htonl, htons };
import(lib) std::result { Result };
import(lib) std::fs { IoError };

const i32 AF_INET = 2;
const i32 SOCK_STREAM = 1;
const i32 SOCK_DGRAM = 2;
const i32 IPPROTO_TCP = 6;
const i32 IPPROTO_UDP = 17;
const i32 SOL_SOCKET = 1;
const i32 SO_REUSEADDR = 2;

/// IPv4 socket address matching the platform's 16-byte sockaddr_in layout.
pub struct sockaddr_in
{
    u16 sinFamily;
    u16 sinPort;
    u32 sinAddr;
    u8[8] sinZero;
}

bool _parseIp(str ip, u32* out)
{
    u32 octet = 0;
    u32 addrVal = 0;
    u32 shift = 24;
    u32 octets = 0;
    bool octetHasDigit = false;
    for (usize i = 0; i <= ip.len; i++)
    {
        if (i == ip.len || ip.ptr[i] == '.')
        {
            if (!octetHasDigit || octet > 255) return false;
            addrVal |= (octet << shift);
            octet = 0;
            octetHasDigit = false;
            octets++;
            if (shift > 0) shift -= 8;
        }
        else
        {
            if (ip.ptr[i] < '0' || ip.ptr[i] > '9') return false;
            octet = octet * 10 + (u32)(ip.ptr[i] - '0');
            if (octet > 255) return false;
            octetHasDigit = true;
        }
    }
    if (octets != 4) return false;
    *out = htonl(addrVal);
    return true;
}

void _zeroSockaddr(sockaddr_in* a)
{
    for (usize i = 0; i < 8; i++) a->sinZero[i] = 0;
}

/// A connected TCP socket handle.
pub distinct TcpSocket = i32;

/// Connect to `ip`:`port` over TCP, returning a connected socket.
pub Result<TcpSocket, IoError> tcpConnect(str ip, u16 port)
{
    i32 fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return Result<TcpSocket, IoError>::Err { .error = IoError::os("socket") };

    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr))
    {
        close(fd);
        return Result<TcpSocket, IoError>::Err { .error = IoError::BadUsage { .msg = "invalid ip address" } };
    }

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;

    if (connect(fd, (const rawptr)&addr, 16) < 0)
    {
        close(fd);
        return Result<TcpSocket, IoError>::Err { .error = IoError::os("connect") };
    }
    return Result<TcpSocket, IoError>::Ok { .value = (TcpSocket)fd };
}

/// Bind and listen on `port` for incoming TCP connections.
pub Result<TcpSocket, IoError> tcpListen(u16 port)
{
    i32 fd = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if (fd < 0) return Result<TcpSocket, IoError>::Err { .error = IoError::os("socket") };

    // source bug, this was a 5-argument call to sendto (which takes 6);
    // the shape is setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, ...) — fixed.
    i32 optval = 1;
    setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, (const u8*)&optval, 4);

    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = htonl(0u);
    if (bind(fd, (const rawptr)&addr, 16) < 0)
    {
        close(fd);
        return Result<TcpSocket, IoError>::Err { .error = IoError::os("bind") };
    }
    if (listen(fd, 128) < 0)
    {
        close(fd);
        return Result<TcpSocket, IoError>::Err { .error = IoError::os("listen") };
    }
    return Result<TcpSocket, IoError>::Ok { .value = (TcpSocket)fd };
}

/// Accept one pending connection on a listening socket.
pub Result<TcpSocket, IoError> tcpAccept(TcpSocket server)
{
    sockaddr_in addr;
    i32 addrLen = 16;
    i32 fd = accept((i32)server, (rawptr)&addr, &addrLen);
    if (fd < 0) return Result<TcpSocket, IoError>::Err { .error = IoError::os("accept") };
    return Result<TcpSocket, IoError>::Ok { .value = (TcpSocket)fd };
}

// Err only on a send error; a short count (Ok) means the peer closed
/// Send exactly `len` bytes; Ok(n) with n < len means the peer closed.
pub Result<isize, IoError> tcpSend(TcpSocket sock, const u8* buf, usize len)
{
    usize sent = 0;
    while (sent < len)
    {
        i64 n = send((i32)sock, buf + sent, len - sent, 0);
        if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("send") };
        if (n == 0) break;
        sent += (usize)n;
    }
    return Result<isize, IoError>::Ok { .value = (isize)sent };
}

// Err only on a recv error; Ok(0) means the peer closed
/// Receive up to `len` bytes; Ok(0) means the peer closed.
pub Result<isize, IoError> tcpRecv(TcpSocket sock, u8* buf, usize len)
{
    usize got = 0;
    while (got < len)
    {
        i64 n = recv((i32)sock, buf + got, len - got, 0);
        if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("recv") };
        if (n == 0) break;
        got += (usize)n;
    }
    return Result<isize, IoError>::Ok { .value = (isize)got };
}

/// Close a TCP socket.
pub void tcpClose(TcpSocket sock)
{
    close((i32)sock);
}

/// A UDP socket handle.
pub struct UdpSocket
{
    i32 fd;
}

/// Create an unbound UDP socket.
pub Result<UdpSocket, IoError> udpSocket()
{
    i32 fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (fd < 0) return Result<UdpSocket, IoError>::Err { .error = IoError::os("socket") };
    return Result<UdpSocket, IoError>::Ok { .value = UdpSocket { .fd = fd } };
}

/// Bind `s` to `port` on all IPv4 interfaces.
pub Result<bool, IoError> udpBind(UdpSocket* s, u16 port)
{
    if (s->fd < 0) return Result<bool, IoError>::Err { .error = IoError::BadUsage { .msg = "socket not open" } };
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = htonl(0u);
    if (bind(s->fd, (const rawptr)&addr, 16) != 0)
        return Result<bool, IoError>::Err { .error = IoError::os("bind") };
    return Result<bool, IoError>::Ok { .value = true };
}

/// Send a datagram from `s` to `ip`:`port`.
pub Result<isize, IoError> udpSendTo(UdpSocket* s, const u8* buf, usize len, str ip, u16 port)
{
    if (s->fd < 0) return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "socket not open" } };
    u32 ipAddr;
    if (!_parseIp(ip, &ipAddr))
        return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "invalid ip address" } };
    sockaddr_in addr;
    _zeroSockaddr(&addr);
    addr.sinFamily = AF_INET;
    addr.sinPort = htons(port);
    addr.sinAddr = ipAddr;
    isize n = sendto(s->fd, buf, len, 0, (const rawptr)&addr, 16);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("sendto") };
    return Result<isize, IoError>::Ok { .value = n };
}

/// Receive one datagram into `buf`.
pub Result<isize, IoError> udpRecvFrom(UdpSocket* s, u8* buf, usize len)
{
    if (s->fd < 0) return Result<isize, IoError>::Err { .error = IoError::BadUsage { .msg = "socket not open" } };
    isize n = recvfrom(s->fd, buf, len, 0, null, null);
    if (n < 0) return Result<isize, IoError>::Err { .error = IoError::os("recvfrom") };
    return Result<isize, IoError>::Ok { .value = n };
}

/// Close a UDP socket.
pub void udpClose(UdpSocket* s)
{
    if (s->fd >= 0) close(s->fd);
    s->fd = -1;
}
