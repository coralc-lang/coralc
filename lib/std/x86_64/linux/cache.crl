#[[no_drop_all]]
import hashmap { HashMap, CollectionError };
import(lib) std::mman { alloc, dealloc };
import(lib) std::option { Option };
import(lib) std::result { Result };

/// A single cache key/value pair plus its intrusive list links; used internally by Cache.
pub struct CacheEntry<K, V>
{
    K key;
    V value;
    CacheEntry<K, V>* prev;
    CacheEntry<K, V>* next;
}

/// LRU cache mapping keys to values with a bounded entry count.
pub struct Cache<K, V>
{
    HashMap<K, CacheEntry<K, V>*> map;
    CacheEntry<K, V>* head;
    CacheEntry<K, V>* tail;
    usize maxSize;
    usize(K) hashFn;
    bool(K, K) eqFn;

/// Creates a cache holding at most max entries (defaulting to 64); hf hashes keys and ef compares them.
    static Cache<K, V> new(usize max, usize(K) hf, bool(K, K) ef)
    {
        return Cache<K, V> {
            .map = HashMap<K, CacheEntry<K, V>*>::new(hf, ef),
            .head = null,
            .tail = null,
            .maxSize = max > 0 ? max : 64,
            .hashFn = hf,
            .eqFn = ef
        };
    }

/// Frees every entry and the internal map.
    void dispose()
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            CacheEntry<K, V>* next = cur->next;
            dealloc<CacheEntry<K, V>>(cur);
            cur = next;
        }
        self.map.dispose();
        self.head = null;
        self.tail = null;
    }

    
/// Returns the number of cached entries.
    usize count() { return self.map.count(); }
/// Returns the configured maximum entry count.
    usize maxSizeValue() { return self.maxSize; }

    void _moveToFront(CacheEntry<K, V>* entry)
    {
        if (entry == self.head) return;
        if (entry->prev != null) entry->prev->next = entry->next;
        if (entry->next != null) entry->next->prev = entry->prev;
        if (entry == self.tail) self.tail = entry->prev;
        entry->prev = null;
        entry->next = self.head;
        if (self.head != null) self.head->prev = entry;
        self.head = entry;
        if (self.tail == null) self.tail = entry;
    }

    void _evict()
    {
        if (self.tail == null) return;
        CacheEntry<K, V>* old = self.tail;
        self.tail = old->prev;
        if (self.tail != null) self.tail->next = null;
        else self.head = null;
        self.map.remove(old->key);
        dealloc<CacheEntry<K, V>>(old);
    }

/// Inserts or updates key; evicts the least recently used entry when over capacity.
    Result<V, CollectionError> insert(K key, V value)
    {
        Option<CacheEntry<K, V>*> entryPtr = self.map.get(key);
        if (entryPtr.isSome())
        {
            CacheEntry<K, V>* existing = entryPtr.unwrap();
            existing->value = value;
            self._moveToFront(existing);
            return Result<V, CollectionError>::Ok { .value = value };
        }
        CacheEntry<K, V>* entry = alloc<CacheEntry<K, V>>(1);
        if (entry == null)
            return Result<V, CollectionError>::Err { .error = CollectionError::AllocFailed { .msg = "Cache entry allocation failed" } };
        entry->key = key;
        entry->value = value;
        entry->prev = null;
        entry->next = null;
        Result<CacheEntry<K, V>*, CollectionError> ins = self.map.insert(key, entry);
        if (ins.isErr())
        {
            dealloc<CacheEntry<K, V>>(entry);
            return Result<V, CollectionError>::Err { .error = ins.unwrapErr() };
        }
        entry->next = self.head;
        if (self.head != null) self.head->prev = entry;
        self.head = entry;
        if (self.tail == null) self.tail = entry;
        if (self.map.count() > self.maxSize) self._evict();
        return Result<V, CollectionError>::Ok { .value = value };
    }

/// Returns the value for key and marks it most recently used.
    Option<V> get(K key)
    {
        Option<CacheEntry<K, V>*> entryPtr = self.map.get(key);
        if (entryPtr.isNone()) return Option<V>::None;
        CacheEntry<K, V>* entry = entryPtr.unwrap();
        self._moveToFront(entry);
        return Option<V>::Some { .value = entry->value };
    }

/// Returns a pointer to the value for key and marks it most recently used.
    Option<V*> getPtr(K key)
    {
        Option<CacheEntry<K, V>*> entryPtr = self.map.get(key);
        if (entryPtr.isNone()) return Option<V*>::None;
        CacheEntry<K, V>* entry = entryPtr.unwrap();
        self._moveToFront(entry);
        return Option<V*>::Some { .value = &entry->value };
    }

/// Returns true when key is present.
    bool contains(K key)
    {
        return self.map.contains(key);
    }

/// Removes the entry for key, if any.
    void remove(K key)
    {
        Option<CacheEntry<K, V>*> entryPtr = self.map.get(key);
        if (entryPtr.isNone()) return;
        CacheEntry<K, V>* entry = entryPtr.unwrap();
        if (entry->prev != null) entry->prev->next = entry->next;
        if (entry->next != null) entry->next->prev = entry->prev;
        if (entry == self.head) self.head = entry->next;
        if (entry == self.tail) self.tail = entry->prev;
        self.map.remove(key);
        dealloc<CacheEntry<K, V>>(entry);
    }

/// Removes every entry.
    void clear()
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            CacheEntry<K, V>* next = cur->next;
            dealloc<CacheEntry<K, V>>(cur);
            cur = next;
        }
        self.map.clear();
        self.head = null;
        self.tail = null;
    }

/// Calls fn for every cached key/value pair.
    void each(void(K, V) fn)
    {
        CacheEntry<K, V>* cur = self.head;
        while (cur != null)
        {
            fn(cur->key, cur->value);
            cur = cur->next;
        }
    }

/// Changes the maximum entry count and evicts until it is satisfied.
    void resize(usize newMax)
    {
        self.maxSize = newMax > 0 ? newMax : 1;
        while (self.map.count() > self.maxSize) self._evict();
    }
}

/// Implements @drop by freeing every entry and the map.
pub extend<K, V> Cache<K, V> : @drop
{
    
    void drop() { self.dispose(); }
}
