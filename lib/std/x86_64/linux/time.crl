#[[no_drop_all]]
import(lib) platform::libc { snprintf };
import(lib) std::text::string { String };
// std::time -- wall-clock and monotonic time.
//
// Ported from the old std/core/time module. The Linux port talks to the
// kernel directly: every clock or sleep call below is a raw x86_64
// syscall, so there is no libc between you and the clock. The public
// surface matches std::time on Windows exactly, call for call.

const i32 CLOCK_REALTIME = 0;
const i32 CLOCK_MONOTONIC = 1;

// x86_64 syscall numbers we need.
const u32 SYS_gettimeofday = 96;
const u32 SYS_nanosleep = 35;
const u32 SYS_time = 201;
const u32 SYS_clock_gettime = 228;

/// A time span in whole seconds and nanoseconds.
pub struct Timespec
{
    i64 sec;
    i64 nsec;
}

/// A time span in whole seconds and microseconds.
pub struct Timeval
{
    i64 sec;
    i64 usec;
}

// clock_gettime(2), timespec written straight into rsi.
/// Reads the monotonic clock, which never moves backwards.
pub Timespec nowMonotonic()
{
    Timespec ts;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_clock_gettime), "D"((usize)CLOCK_MONOTONIC), "S"((usize)&ts)
        : "rcx", "r11", "memory"
    }
    return ts;
}

/// Reads the wall clock (Unix epoch time).
pub Timespec nowRealtime()
{
    Timespec ts;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_clock_gettime), "D"((usize)CLOCK_REALTIME), "S"((usize)&ts)
        : "rcx", "r11", "memory"
    }
    return ts;
}

// gettimeofday(2); the timezone argument stays null.
/// Reads the wall clock as seconds and microseconds.
pub Timeval nowTimeval()
{
    Timeval tv;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_gettimeofday), "D"((usize)&tv), "S"(0u)
        : "rcx", "r11", "memory"
    }
    return tv;
}

/// Returns the current wall-clock time as whole seconds since the Unix epoch.
pub u64 unixSeconds()
{
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_time), "D"(0u)
        : "rcx", "r11", "memory"
    }
    return (u64)ret;
}

/// Adds two timespecs, carrying whole nanoseconds into seconds.
pub Timespec addTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec + b.sec;
    r.nsec = a.nsec + b.nsec;
    if (r.nsec >= 1000000000)
    {
        r.nsec -= 1000000000;
        r.sec += 1;
    }
    return r;
}

/// Subtracts b from a, borrowing a second when nanoseconds go negative.
pub Timespec subTimespec(Timespec a, Timespec b)
{
    Timespec r;
    r.sec = a.sec - b.sec;
    r.nsec = a.nsec - b.nsec;
    if (r.nsec < 0)
    {
        r.nsec += 1000000000;
        r.sec -= 1;
    }
    return r;
}

/// Converts a timespec to seconds as an f64.
pub f64 timespecToF64(Timespec ts)
{
    return (f64)ts.sec + (f64)ts.nsec * 1e-9;
}

/// Converts a timeval to seconds as an f64.
pub f64 timevalToF64(Timeval tv)
{
    return (f64)tv.sec + (f64)tv.usec * 1e-6;
}

// nanosleep(2), no remainder retry -- a signal shortens the sleep.
/// Suspends the calling thread for the given duration.
pub void sleepTimespec(Timespec ts)
{
    Timespec req;
    req.sec = ts.sec;
    req.nsec = ts.nsec;
    usize ret;
    asm volatile {
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(SYS_nanosleep), "D"((usize)&req), "S"(0u)
        : "rcx", "r11", "memory"
    }
}

/// Suspends the calling thread for the given number of milliseconds.
pub void sleepMs(u64 ms)
{
    Timespec ts;
    ts.sec = (i64)(ms / 1000u);
    ts.nsec = (i64)((ms % 1000u) * 1000000u);
    sleepTimespec(ts);
}

pub extend Timespec : @toStr
{
    str toStr()
    {
        u8 buf[64];
        i32 len = snprintf(buf, 64u, C"%lld.%09llds", self.sec, self.nsec);
        if (len < 0) len = 0;
        if (len > 63) len = 63;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Timeval : @toStr
{
    str toStr()
    {
        u8 buf[64];
        i32 len = snprintf(buf, 64u, C"%lld.%06llds", self.sec, self.usec);
        if (len < 0) len = 0;
        if (len > 63) len = 63;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}