#[[no_drop_all]]
import(lib) std::text::string { String };
import(lib) std::vec { Vec };
import(lib) std::result { Result };
import(lib) platform::libc { snprintf, strtod };

/// Error reported by the JSON parser, carrying a message and position.
pub variant ParseError
{
    Syntax { str msg; u32 line; u32 col; },
    Semantic { str msg; }
}

/// The kind of value a JsonValue holds.
pub enum JsonType
{
    Null,
    Bool,
    I64,
    F64,
    String,
    Array,
    Object
}

/// A parsed JSON value: null, bool, integer, float, string, array, or object.
pub struct JsonValue
{
    JsonType type;
    bool boolVal;
    i64 i64Val;
    f64 f64Val;
    String strVal;
    Vec<JsonValue> arrVal;
    Vec<JsonPair> objVal;

    /// Returns a null value.
    static JsonValue nullVal()
    {
        return JsonValue { .type = JsonType::Null };
    }

    /// Returns a boolean value.
    static JsonValue boolVal(bool b)
    {
        return JsonValue { .type = JsonType::Bool, .boolVal = b };
    }

    /// Returns an integer value.
    static JsonValue i64Val(i64 n)
    {
        return JsonValue { .type = JsonType::I64, .i64Val = n };
    }

    /// Returns a floating-point value.
    static JsonValue f64Val(f64 n)
    {
        return JsonValue { .type = JsonType::F64, .f64Val = n };
    }

    /// Returns a string value taking ownership of s.
    static JsonValue stringVal(String s)
    {
        return JsonValue { .type = JsonType::String, .strVal = s };
    }

    /// Returns an empty array value.
    static JsonValue arrayVal()
    {
        return JsonValue { .type = JsonType::Array, .arrVal = Vec<JsonValue>::new() };
    }

    /// Returns an empty object value.
    static JsonValue objectVal()
    {
        return JsonValue { .type = JsonType::Object, .objVal = Vec<JsonPair>::new() };
    }

    /// Frees the value's string, array, or object contents.
    void dispose()
    {
        if (self.type == JsonType::String) self.strVal.free();
        if (self.type == JsonType::Array)
        {
            for (usize i = 0; i < self.arrVal.count(); i++)
                self.arrVal.atPtr(i)->dispose();
            self.arrVal.dispose();
        }
        if (self.type == JsonType::Object)
        {
            for (usize i = 0; i < self.objVal.count(); i++)
            {
                self.objVal.atPtr(i)->key.free();
                self.objVal.atPtr(i)->value.dispose();
            }
            self.objVal.dispose();
        }
    }
}

/// A key/value pair in a JSON object.
pub struct JsonPair
{
    String key;
    JsonValue value;
}

struct _ParseCtx
{
    const u8* ptr;
    usize len;
    usize pos;
    bool error;
    str errMsg;
    u32 line;
    u32 col;

    void fail(str msg)
    {
        if (self.error) return;
        self.error = true;
        self.errMsg = msg;
        u32 ln = 1;
        usize lineStart = 0;
        for (usize i = 0; i < self.pos && i < self.len; i++)
        {
            if (self.ptr[i] == '\n') { ln++; lineStart = i + 1; }
        }
        self.line = ln;
        self.col = (u32)(self.pos - lineStart) + 1u;
    }

    void skipSpace()
    {
        while (self.pos < self.len)
        {
            u8 c = self.ptr[self.pos];
            if (c != ' ' && c != '\t' && c != '\n' && c != '\r') break;
            self.pos++;
        }
    }

    u8 peek()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.ptr[self.pos];
    }

    u8 next()
    {
        self.skipSpace();
        if (self.pos >= self.len) return 0;
        return self.ptr[self.pos++];
    }

    bool expect(u8 ch)
    {
        u8 c = (u8)self.next();
        if (c != ch) { self.fail("unexpected character"); return false; }
        return true;
    }

    String parseString()
    {
        String s = String::new();
        if (self.next() != '"') { self.fail("expected '\"'"); return s; }
        while (self.pos < self.len)
        {
            u8 c = self.ptr[self.pos++];
            if (c == '"') return s;
            if (c == '\\')
            {
                if (self.pos >= self.len) break;
                u8 esc = self.ptr[self.pos++];
                if (esc == 'n') s.pushChar('\n');
                else if (esc == 't') s.pushChar('\t');
                else if (esc == 'r') s.pushChar('\r');
                else if (esc == '"') s.pushChar('"');
                else if (esc == '\\') s.pushChar('\\');
                else if (esc == '/') s.pushChar('/');
                else if (esc == 'b') s.pushChar('\b');
                else if (esc == 'f') s.pushChar('\f');
                else if (esc == 'u')
                {
                    u32 code = 0;
                    bool bad = false;
                    for (i32 i = 0; i < 4; i++)
                    {
                        if (self.pos >= self.len) { bad = true; break; }
                        u8 h = self.ptr[self.pos++];
                        u32 hv;
                        if (h >= '0' && h <= '9') hv = (u32)(h - '0');
                        else if (h >= 'a' && h <= 'f') hv = (u32)(h - 'a' + 10);
                        else if (h >= 'A' && h <= 'F') hv = (u32)(h - 'A' + 10);
                        else { bad = true; break; }
                        code = (code << 4) | hv;
                    }
                    if (bad) { self.fail("invalid \\u escape"); return s; }
                    if (code >= 0xD800 && code <= 0xDBFF)
                    {
                        bool combined = false;
                        if (self.pos + 6 <= self.len && self.ptr[self.pos] == '\\' && self.ptr[self.pos + 1] == 'u')
                        {
                            u32 lo = 0;
                            bool lobad = false;
                            for (i32 i = 0; i < 4; i++)
                            {
                                u8 h = self.ptr[self.pos + 2 + (usize)i];
                                u32 hv;
                                if (h >= '0' && h <= '9') hv = (u32)(h - '0');
                                else if (h >= 'a' && h <= 'f') hv = (u32)(h - 'a' + 10);
                                else if (h >= 'A' && h <= 'F') hv = (u32)(h - 'A' + 10);
                                else { lobad = true; break; }
                                lo = (lo << 4) | hv;
                            }
                            if (!lobad && lo >= 0xDC00 && lo <= 0xDFFF)
                            {
                                self.pos += 6;
                                code = 0x10000 + ((code - 0xD800) << 10) + (lo - 0xDC00);
                                combined = true;
                            }
                        }
                        if (!combined) code = 0xFFFD;
                    }
                    else if (code >= 0xDC00 && code <= 0xDFFF)
                    {
                        code = 0xFFFD;
                    }
                    if (code < 0x80) s.pushChar((u8)code);
                    else if (code < 0x800) { s.pushChar((u8)(0xC0 | (code >> 6))); s.pushChar((u8)(0x80 | (code & 0x3F))); }
                    else if (code < 0x10000) { s.pushChar((u8)(0xE0 | (code >> 12))); s.pushChar((u8)(0x80 | ((code >> 6) & 0x3F))); s.pushChar((u8)(0x80 | (code & 0x3F))); }
                    else { s.pushChar((u8)(0xF0 | (code >> 18)));
                        s.pushChar((u8)(0x80 | ((code >> 12) & 0x3F)));
                        s.pushChar((u8)(0x80 | ((code >> 6) & 0x3F)));
                        s.pushChar((u8)(0x80 | (code & 0x3F))); }
                }
                else s.pushChar(esc);
            }
            else s.pushChar(c);
        }
        self.fail("unterminated string");
        return s;
    }

    JsonValue parseValue()
    {
        u8 c = self.peek();
        if (c == '"')
        {
            JsonValue v = JsonValue::stringVal(self.parseString());
            return v;
        }
        if (c == 't')
        {
            if (self.pos + 4 <= self.len && self.ptr[self.pos] == 't' && self.ptr[self.pos+1] == 'r' && self.ptr[self.pos+2] == 'u' && self.ptr[self.pos+3] == 'e')
            {
                self.pos += 4;
                return JsonValue::boolVal(true);
            }
            self.fail("invalid literal, expected 'true'");
            return JsonValue::nullVal();
        }
        if (c == 'f')
        {
            if (self.pos + 4 < self.len && self.ptr[self.pos] == 'f' && self.ptr[self.pos+1] == 'a' && self.ptr[self.pos+2] == 'l' && self.ptr[self.pos+3] == 's' && self.ptr[self.pos+4] == 'e')
            {
                self.pos += 5;
                return JsonValue::boolVal(false);
            }
            self.fail("invalid literal, expected 'false'");
            return JsonValue::nullVal();
        }
        if (c == 'n')
        {
            if (self.pos + 3 < self.len && self.ptr[self.pos] == 'n' && self.ptr[self.pos+1] == 'u' && self.ptr[self.pos+2] == 'l' && self.ptr[self.pos+3] == 'l')
            {
                self.pos += 4;
                return JsonValue::nullVal();
            }
            self.fail("invalid literal, expected 'null'");
            return JsonValue::nullVal();
        }
        if (c == '[') return self.parseArray();
        if (c == '{') return self.parseObject();
        if (c == '-' || (c >= '0' && c <= '9'))
        {
            bool neg = false;
            usize start = self.pos;
            if (c == '-') { neg = true; self.next(); }
            u64 limit = neg ? 0x8000000000000000u : 0x7FFFFFFFFFFFFFFFu;
            u64 intVal = 0;
            while (self.pos < self.len && self.ptr[self.pos] >= '0' && self.ptr[self.pos] <= '9')
            {
                u64 d = (u64)(self.ptr[self.pos] - '0');
                if (intVal > (limit - d) / 10u)
                {
                    self.fail("integer out of range");
                    return JsonValue::nullVal();
                }
                intVal = intVal * 10 + d;
                self.pos++;
            }
            if (neg && self.pos == start + 1)
            {
                self.fail("expected digit after '-'");
                return JsonValue::nullVal();
            }
            if (self.pos < self.len && (self.ptr[self.pos] == '.' || self.ptr[self.pos] == 'e' || self.ptr[self.pos] == 'E'))
            {
                u8 tmp[64];
                usize tpos = 0;
                while (self.pos < self.len && tpos < 63)
                {
                    u8 ch = (u8)self.ptr[self.pos];
                    if ((ch < '0' || ch > '9') && ch != '.' && ch != 'e' && ch != 'E' && ch != '+' && ch != '-') break;
                    tmp[tpos++] = ch;
                    self.pos++;
                }
                tmp[tpos] = 0;
                f64 fv;

                cchar* end;
                fv = strtod(tmp, &end);
                if (end != tmp + tpos)
                {
                    self.fail("invalid number");
                    return JsonValue::nullVal();
                }
                return JsonValue::f64Val(neg ? -fv : fv);
            }
            if (neg) return JsonValue::i64Val(-(i64)intVal);
            return JsonValue::i64Val((i64)intVal);
        }
        self.fail("unexpected token");
        return JsonValue::nullVal();
    }

    JsonValue parseArray()
    {
        JsonValue arr = JsonValue::arrayVal();
        if (!self.expect('[')) { arr.dispose(); return JsonValue::nullVal(); }
        if (self.peek() == ']') { self.next(); return arr; }
        for (;;)
        {
            JsonValue elem = self.parseValue();
            if (self.error) { elem.dispose(); arr.dispose(); return JsonValue::nullVal(); }
            arr.arrVal.push(elem);
            u8 c = self.next();
            if (c == ']') break;
            if (c != ',') { self.fail("expected ',' or ']'"); arr.dispose(); return JsonValue::nullVal(); }
        }
        return arr;
    }

    JsonValue parseObject()
    {
        JsonValue obj = JsonValue::objectVal();
        if (!self.expect('{')) { obj.dispose(); return JsonValue::nullVal(); }
        if (self.peek() == '}') { self.next(); return obj; }
        for (;;)
        {
            JsonPair pair;
            pair.key = self.parseString();
            if (self.error) { pair.key.free(); obj.dispose(); return JsonValue::nullVal(); }
            if (!self.expect(':')) { pair.key.free(); obj.dispose(); return JsonValue::nullVal(); }
            pair.value = self.parseValue();
            if (self.error) { pair.key.free(); pair.value.dispose(); obj.dispose(); return JsonValue::nullVal(); }
            obj.objVal.push(pair);
            u8 c = self.next();
            if (c == '}') break;
            if (c != ',') { self.fail("expected ',' or '}'"); obj.dispose(); return JsonValue::nullVal(); }
        }
        return obj;
    }
}

String _escapeString(str s)
{
    String out = String::new();
    out.pushByte('"');
    for (usize i = 0; i < s.len; i++)
    {
        u8 c = s.ptr[i];
        if (c == '"') { out.pushByte('\\'); out.pushByte('"'); }
        else if (c == '\\') { out.pushByte('\\'); out.pushByte('\\'); }
        else if (c == '\n') { out.pushByte('\\'); out.pushByte('n'); }
        else if (c == '\t') { out.pushByte('\\'); out.pushByte('t'); }
        else if (c == '\r') { out.pushByte('\\'); out.pushByte('r'); }
        else if (c == '\b') { out.pushByte('\\'); out.pushByte('b'); }
        else if (c == '\f') { out.pushByte('\\'); out.pushByte('f'); }
        else if (c < 0x20)
        {
            out.pushByte('\\');
            out.pushByte('u');
            out.pushByte((u8)'0');
            out.pushByte((u8)'0');
            u8 hi = (u8)(c >> 4);
            u8 lo = (u8)(c & 0x0F);
            out.pushByte((u8)(hi < 10 ? '0' + hi : 'a' + hi - 10));
            out.pushByte((u8)(lo < 10 ? '0' + lo : 'a' + lo - 10));
        }
        else out.pushByte(c);
    }
    out.pushByte('"');
    return out;
}

void _serialize(JsonValue* v, String* out)
{
    if (v->type == JsonType::Null) { out->pushView("null"); return; }
    if (v->type == JsonType::Bool) { out->pushView(v->boolVal ? "true" : "false"); return; }
    if (v->type == JsonType::I64)
    {
        u8 buf[32];
        i32 n = snprintf(buf, 32u, C"%lld", v->i64Val);
        out->pushView(str::fromParts((const u8*)buf, (usize)n));
        return;
    }
    if (v->type == JsonType::F64)
    {
        if (v->f64Val != v->f64Val || v->f64Val > 1.7976931348623157e308 || v->f64Val < -1.7976931348623157e308)
        {
            out->pushView("null");
            return;
        }
        cchar buf[64];
        i32 n = snprintf(buf, 64u, C"%.17g", v->f64Val);
        out->pushView(str::fromParts((const cchar*)buf, (usize)n));
        return;
    }
    if (v->type == JsonType::String)
    {
        String escaped = _escapeString(v->strVal.asView());
        out->pushView(escaped.asView());
        escaped.free();
        return;
    }
    if (v->type == JsonType::Array)
    {
        out->pushByte('[');
        for (usize i = 0; i < v->arrVal.count(); i++)
        {
            if (i > 0) out->pushByte(',');
            _serialize(v->arrVal.atPtr(i), out);
        }
        out->pushByte(']');
        return;
    }
    if (v->type == JsonType::Object)
    {
        out->pushByte('{');
        for (usize i = 0; i < v->objVal.count(); i++)
        {
            if (i > 0) out->pushByte(',');
            JsonPair* p = v->objVal.atPtr(i);
            String kesc = _escapeString(p->key.asView());
            out->pushView(kesc.asView());
            kesc.free();
            out->pushByte(':');
            _serialize(&p->value, out);
        }
        out->pushByte('}');
    }
}

/// Parses a complete JSON document, returning the value or a ParseError.
pub Result<JsonValue, ParseError> parseJson(str input)
{
    _ParseCtx ctx = _ParseCtx {
        .ptr = (const u8*)input.ptr,
        .len = input.len,
        .pos = 0,
        .error = false,
        .errMsg = "invalid JSON",
        .line = 0,
        .col = 0
    };

    JsonValue v = ctx.parseValue();
    if (ctx.error)
    {
        v.dispose();
        return Result<JsonValue, ParseError>::Err {
            .error = ParseError::Syntax { .msg = ctx.errMsg, .line = ctx.line, .col = ctx.col }
        };
    }
    ctx.skipSpace();
    if (ctx.pos != ctx.len)
    {
        v.dispose();
        ctx.fail("trailing characters after JSON value");
        return Result<JsonValue, ParseError>::Err {
            .error = ParseError::Syntax { .msg = ctx.errMsg, .line = ctx.line, .col = ctx.col }
        };
    }
    return Result<JsonValue, ParseError>::Ok { .value = v };
}

/// Serializes a value to compact JSON text.
pub String serialize(JsonValue* v)
{
    String out = String::new();
    _serialize(v, &out);
    return out;
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of JsonValue through the @drop trait.
pub extend JsonValue : @drop
{
    void drop()
    {
        self.dispose();
    }
}
