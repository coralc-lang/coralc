#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, copy };
import(lib) platform::libc { regcomp, regexec, regfree };
import(lib) std::vec { Vec };

const i32 REG_EXTENDED = 1;
const i32 REG_ICASE = 2;
const i32 REG_NOSUB = 4;

/// A compiled POSIX extended regular expression.
pub struct Regex
{
    rawptr impl[8];
    bool compiled;
    usize groupCount;
    u8* findBuf;
    usize findBufCap;

    /// Compiles the pattern; matching ignores case when caseInsensitive is set. Returns true on success.
    bool compile(str pattern, bool caseInsensitive)
    {
        u8* buf = alloc<u8>(pattern.len + 1);
        if (buf == null) return false;
        copy<u8>(buf, (u8*)pattern.ptr, pattern.len);
        buf[pattern.len] = 0;
        i32 flags = REG_EXTENDED;
        if (caseInsensitive) flags |= REG_ICASE;
        i32 rc = regcomp(self.impl, buf, flags);
        dealloc<u8>(buf);
        self.compiled = rc == 0;
        if (self.compiled)
        {
            // regex_t stores the subexpression count as its first member; impl aliases it
            self.groupCount = (usize)self.impl[0] + 1;
        }
        else self.groupCount = 0;
        return self.compiled;
    }

    /// Releases the compiled pattern and any cached match buffer.
    void free()
    {
        if (self.compiled) regfree(self.impl);
        self.compiled = false;
        if (self.findBuf != null) { dealloc<u8>(self.findBuf); self.findBuf = null; }
        self.findBufCap = 0;
    }

    /// Returns true only if the entire input matches the pattern.
    bool matches(str input)
    {
        if (!self.compiled) return false;
        u8* buf = alloc<u8>(input.len + 1);
        if (buf == null) return false;
        copy<u8>(buf, (u8*)input.ptr, input.len);
        buf[input.len] = 0;
        i64 pmatch[2];
        i32 rc = regexec(self.impl, buf, 1, pmatch, 0);
        dealloc<u8>(buf);
        if (rc != 0) return false;
        // Full-string match, must start at 0 and cover the whole input
        return pmatch[0] == 0 && (u64)pmatch[1] == input.len;
    }

    /// Matches input and appends the full match plus capture groups to groups. Returns true when a match is found.
    bool find(str input, Vec<str>* groups)
    {
        if (!self.compiled) return false;
        if (self.findBuf == null || self.findBufCap < input.len + 1)
        {
            if (self.findBuf != null) dealloc<u8>(self.findBuf);
            self.findBufCap = input.len + 1;
            self.findBuf = alloc<u8>(self.findBufCap);
            if (self.findBuf == null) { self.findBufCap = 0; return false; }
        }
        copy<u8>(self.findBuf, (u8*)input.ptr, input.len);
        self.findBuf[input.len] = 0;

        usize maxGroups = self.groupCount;
        if (maxGroups < 1) maxGroups = 1;
        groups->clear();
        u8* pmatch = alloc<u8>(@sizeof(i64) * 2 * maxGroups);
        i32 rc = regexec(self.impl, self.findBuf, maxGroups, pmatch, 0);
        if (rc != 0) { dealloc<u8>(pmatch); return false; }

        i64* matches = (i64*)pmatch;
        for (usize i = 0; i < maxGroups; i++)
        {
            i64 so = matches[i * 2];
            i64 eo = matches[i * 2 + 1];
            if (so < 0 || eo < 0) { groups->push(""); continue; }
            groups->push(str::fromParts((const u8*)(self.findBuf + so), (u64)(eo - so)));
        }
        dealloc<u8>(pmatch);
        return true;
    }
}

/// Combines the REG_* option flags into a regcomp flag mask.
pub i32 regexFlags(bool extended, bool icase, bool nosub)
{
    i32 f = 0;
    if (extended) f |= REG_EXTENDED;
    if (icase) f |= REG_ICASE;
    if (nosub) f |= REG_NOSUB;
    return f;
}

// @drop is the inbuilt drop trait in the new dialect — the old file's local
// `trait drop { void drop(); }` declaration is therefore not re-declared.
/// Enables automatic cleanup of Regex through the @drop trait.
pub extend Regex : @drop
{
    void drop()
    {
        self.free();
    }
}
