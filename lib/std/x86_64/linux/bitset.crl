#[[no_drop_all]]
import(lib) std::error { __assert, __assertOut };
import(lib) std::mman { alloc, dealloc };
import range { IterRange };

/// Dynamically sized bit vector backed by an array of 64-bit words.
pub struct Bitset
{
    u64* words;
    u64 numBits;
    u64 numWords;

/// Allocates a bitset holding numBits bits, all initially clear.
    static Bitset new(u64 numBits)
    {
        u64 numWords = (numBits + 63) / 64;
        u64* words = alloc<u64>(numWords);
        for (usize i = 0; i < numWords; i++) words[i] = 0;
        return Bitset {
            .words = words,
            .numBits = numBits,
            .numWords = numWords
        };
    }

/// Frees the backing storage and resets the bitset.
    void dispose()
    {
        if (self.words != null)
        {
            dealloc<u64>(self.words);
            self.words = null;
        }
        self.numBits = 0;
        self.numWords = 0;
    }

/// Returns the number of 64-bit words allocated.
    u64 wordCount() { return self.numWords; }

/// Sets the bit at index bit.
    void set(u64 bit)
    {
        __assert(bit < self.numBits);
        u64 word = bit / 64;
        u64 off = bit % 64;
        self.words[word] |= (1u << off);
    }

/// Clears the bit at index bit.
    void clear(u64 bit)
    {
        __assert(bit < self.numBits);
        u64 word = bit / 64;
        u64 off = bit % 64;
        self.words[word] &= ~(1u << off);
    }

/// Flips the bit at index bit.
    void toggle(u64 bit)
    {
        __assert(bit < self.numBits);
        u64 word = bit / 64;
        u64 off = bit % 64;
        self.words[word] ^= (1u << off);
    }

/// Returns true when the bit at index bit is set.
    bool test(u64 bit)
    {
        __assert(bit < self.numBits);
        u64 word = bit / 64;
        u64 off = bit % 64;
        return (self.words[word] & (1u << off)) != 0;
    }

    void _maskPadding()
    {
        u64 remaining = self.numBits % 64;
        if (remaining > 0)
            self.words[self.numWords - 1] &= (1u << remaining) - 1;
    }

/// Sets every bit in the set.
    void setAll()
    {
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] = 0xFFFFFFFFFFFFFFFF;
        self._maskPadding();
    }

/// Clears every bit in the set.
    void clearAll()
    {
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] = 0;
    }

/// Returns the number of set bits.
    u64 countOnes()
    {
        u64 total = 0;
        for (usize i = 0; i < self.numWords; i++)
        {
            u64 v = self.words[i];
            u64 remaining = self.numBits % 64;
            if (i == self.numWords - 1 && remaining > 0)
                v &= (1u << remaining) - 1;
            while (v != 0) { total++; v &= v - 1; }
        }
        return total;
    }

/// Returns the number of clear bits.
    u64 countZeros()
    {
        u64 total = 0;
        for (usize i = 0; i < self.numWords; i++)
        {
            u64 v = ~self.words[i];
            u64 remaining = self.numBits % 64;
            if (i == self.numWords - 1 && remaining > 0)
                v &= (1u << remaining) - 1;
            while (v != 0) { total++; v &= v - 1; }
        }
        return total;
    }

/// Returns true when at least one bit is set.
    bool hasAny()
    {
        for (usize i = 0; i < self.numWords; i++)
            if (self.words[i] != 0) return true;
        return false;
    }

/// Returns true when no bit is set.
    bool none()
    {
        return !self.hasAny();
    }

/// Returns true when every bit is set.
    bool all()
    {
        u64 fullWords = self.numBits / 64;
        for (usize i = 0; i < fullWords; i++)
            if (self.words[i] != 0xFFFFFFFFFFFFFFFF) return false;
        u64 remaining = self.numBits % 64;
        if (remaining > 0)
        {
            u64 mask = (1ull << remaining) - 1;
            if (self.words[fullWords] != mask) return false;
        }
        return true;
    }

/// Bitwise-ANDs this set with other in place.
    void and(Bitset* other)
    {
        __assert(self.numBits == other->numBits);
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] &= other->words[i];
        self._maskPadding();
    }

/// Bitwise-ORs this set with other in place.
    void or(Bitset* other)
    {
        __assert(self.numBits == other->numBits);
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] |= other->words[i];
        self._maskPadding();
    }

/// Bitwise-XORs this set with other in place.
    void xor(Bitset* other)
    {
        __assert(self.numBits == other->numBits);
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] ^= other->words[i];
        self._maskPadding();
    }

/// Inverts every bit in the set in place.
    void not()
    {
        for (usize i = 0; i < self.numWords; i++)
            self.words[i] = ~self.words[i];
        self._maskPadding();
    }
}

/// Implements @drop by freeing the backing storage.
pub extend Bitset : @drop
{
    
    void drop() { self.dispose(); }
}

/// Marks Bitset as a for-in iterable; yields bool bits in index order.
pub extend Bitset : @iter {
/// Returns the number of bits the set can hold.
    u64 count() { return self.numBits; }

/// Returns the bit at index i; asserts i is in range.
    bool at(usize i)
    {
        __assert(i < self.numBits);
        return self.test(i);
    }

/// Returns the clamped half-open bounds [start, end) for for-in.
    IterRange range(usize start, usize end)
    {
        usize n = self.count();
        if (start > n) start = n;
        if (end > n) end = n;
        if (end < start) end = start;
        return IterRange { .start = start, .end = end };
    }
}
