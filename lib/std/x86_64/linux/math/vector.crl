#[[no_drop_all]]
import math { sqrt };
import(lib) platform::libc { snprintf };
import(lib) std::text::string { String };

/// Two-component float64 vector.
pub struct Vec2
{
    f64 x;
    f64 y;

    /// Creates a vector from its components.
    static Vec2 new(f64 x, f64 y)
    {
        return Vec2 { .x = x, .y = y };
    }

    /// Returns the component-wise sum with other.
    Vec2 add(Vec2 other)
    {
        return Vec2 { .x = self.x + other.x, .y = self.y + other.y };
    }

    /// Returns the component-wise difference with other.
    Vec2 sub(Vec2 other)
    {
        return Vec2 { .x = self.x - other.x, .y = self.y - other.y };
    }

    /// Returns the vector scaled by s.
    Vec2 scale(f64 s)
    {
        return Vec2 { .x = self.x * s, .y = self.y * s };
    }

    /// Returns the dot product with other.
    f64 dot(Vec2 other)
    {
        return self.x * other.x + self.y * other.y;
    }

    /// Returns the squared length.
    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y;
    }

    /// Returns the length.
    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec2 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec2 lerp(Vec2 other, f64 t)
    {
        return Vec2 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t
        };
    }
}

/// Three-component float64 vector.
pub struct Vec3
{
    f64 x;
    f64 y;
    f64 z;

    /// Creates a vector from its components.
    static Vec3 new(f64 x, f64 y, f64 z)
    {
        return Vec3 { .x = x, .y = y, .z = z };
    }

    /// Returns the component-wise sum with other.
    Vec3 add(Vec3 other)
    {
        return Vec3 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z
        };
    }

    /// Returns the component-wise difference with other.
    Vec3 sub(Vec3 other)
    {
        return Vec3 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z
        };
    }

    /// Returns the vector scaled by s.
    Vec3 scale(f64 s)
    {
        return Vec3 { .x = self.x * s, .y = self.y * s, .z = self.z * s };
    }

    /// Returns the dot product with other.
    f64 dot(Vec3 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z;
    }

    /// Returns the cross product with other.
    Vec3 cross(Vec3 other)
    {
        return Vec3 {
            .x = self.y * other.z - self.z * other.y,
            .y = self.z * other.x - self.x * other.z,
            .z = self.x * other.y - self.y * other.x
        };
    }

    /// Returns the squared length.
    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z;
    }

    /// Returns the length.
    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec3 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec3 lerp(Vec3 other, f64 t)
    {
        return Vec3 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t
        };
    }
}

/// Four-component float64 vector.
pub struct Vec4
{
    f64 x;
    f64 y;
    f64 z;
    f64 w;

    /// Creates a vector from its components.
    static Vec4 new(f64 x, f64 y, f64 z, f64 w)
    {
        return Vec4 { .x = x, .y = y, .z = z, .w = w };
    }

    /// Returns the component-wise sum with other.
    Vec4 add(Vec4 other)
    {
        return Vec4 {
            .x = self.x + other.x,
            .y = self.y + other.y,
            .z = self.z + other.z,
            .w = self.w + other.w
        };
    }

    /// Returns the component-wise difference with other.
    Vec4 sub(Vec4 other)
    {
        return Vec4 {
            .x = self.x - other.x,
            .y = self.y - other.y,
            .z = self.z - other.z,
            .w = self.w - other.w
        };
    }

    /// Returns the vector scaled by s.
    Vec4 scale(f64 s)
    {
        return Vec4 {
            .x = self.x * s,
            .y = self.y * s,
            .z = self.z * s,
            .w = self.w * s
        };
    }

    /// Returns the dot product with other.
    f64 dot(Vec4 other)
    {
        return self.x * other.x + self.y * other.y + self.z * other.z + self.w * other.w;
    }

    /// Returns the squared length.
    f64 lengthSq()
    {
        return self.x * self.x + self.y * self.y + self.z * self.z + self.w * self.w;
    }

    /// Returns the length.
    f64 length()
    {
        return sqrt(self.lengthSq());
    }

    /// Returns a unit-length vector, or this vector when its length is near zero.
    Vec4 normalize()
    {
        f64 len = self.length();
        if (len < 1e-15) return *self;
        return self.scale(1.0 / len);
    }

    /// Linearly interpolates from this vector to other by t.
    Vec4 lerp(Vec4 other, f64 t)
    {
        return Vec4 {
            .x = self.x + (other.x - self.x) * t,
            .y = self.y + (other.y - self.y) * t,
            .z = self.z + (other.z - self.z) * t,
            .w = self.w + (other.w - self.w) * t
        };
    }
}

pub extend Vec2 : @toStr
{
    str toStr()
    {
        u8 buf[256];
        i32 len = snprintf(buf, 256u, C"[%.15g, %.15g]", self.x, self.y);
        if (len < 0) len = 0;
        if (len > 255) len = 255;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Vec3 : @toStr
{
    str toStr()
    {
        u8 buf[256];
        i32 len = snprintf(buf, 256u, C"[%.15g, %.15g, %.15g]", self.x, self.y, self.z);
        if (len < 0) len = 0;
        if (len > 255) len = 255;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}

pub extend Vec4 : @toStr
{
    str toStr()
    {
        u8 buf[256];
        i32 len = snprintf(buf, 256u, C"[%.15g, %.15g, %.15g, %.15g]", self.x, self.y, self.z, self.w);
        if (len < 0) len = 0;
        if (len > 255) len = 255;
        return String::from(str::fromParts((const u8*)buf, (usize)len)).asView();
    }
}
