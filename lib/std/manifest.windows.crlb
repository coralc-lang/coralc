# windows platform manifest — extends the std base manifest.
# Stays empty of files until the linux port is complete: copy the linux
# tree, then surgically change the platform-dependent parts.
#
# windows porting checklist (do AFTER linux lands):
#   memory/intrinsics  - syscall layer (VirtualAlloc/madvise equivalents)
#   memory/mman        - heap bootstrap
#   concurrent/*       - Win32 threads once that category is ported
#   io/*               - Win32 file/net once that category is ported

build "std" extends "manifest.base.crlb" {
    platform_root = "x86_64/windows";
    select        = ["native-x86_64-windows"];
}
