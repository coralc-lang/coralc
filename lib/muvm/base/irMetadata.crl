#[[no_drop_all]]
use irtypes { IrValue, IrType, IrFunc, IrInst, IrGlobal, IrStringConst, IrModule, IrValueKind, IrBlock };
use irOps { IrOpcode };
import std::mman { alloc, dealloc };

str dupStr(str s)
{
    u8* b = alloc<u8>((usize)(s.len + 1));
    for (usize i = 0; i < s.len; i++) b[i] = s.ptr[i];
    b[s.len] = 0;
    return str { (const u8*)b, s.len };
}

pub enum MetadataKind
{
    DebugInfo,
    Profiling,
    Alignment,
    NoAlias,
    NoCapture,
    NoFree,
    NoUnwind,
    ReadNone,
    ReadOnly,
    WriteOnly,
    InlineHint,
    VectorWidth,
    LoopInfo,
    Range,
    BranchWeights,
    AllocFn,
    FreeFn,
    Custom
}

// which payload fields are live — without this an empty string and a zero
// int are indistinguishable, and the printer cannot round-trip either
pub enum MetadataValueKind
{
    Int,
    Float,
    Bool,
    String,
    IRValue,
    Type
}

pub struct MetadataValue
{
    MetadataKind kind;
    usize intVal;
    str strVal;
    IrValue* irVal;
    f64 floatVal;
    MetadataValueKind vkind;
    IrType* typeVal;
}

pub struct MetadataEntry
{
    str key;
    MetadataValue value;
}

pub struct MetadataSet
{
    MetadataEntry* entries;
    u32 numEntries;
    u32 capEntries;
}

pub MetadataSet newMetadataSet()
{
    return MetadataSet {
        .entries = null,
        .numEntries = 0,
        .capEntries = 0
    };
}

pub void addInt(MetadataSet* m, str key, usize val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = val;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Int;
    e->value.typeVal = null;
}

pub void addString(MetadataSet* m, str key, str val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    // val's ownership transfers to the set — callers hand over heap buffers
    e->value.strVal = val;
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::String;
    e->value.typeVal = null;
}

pub void addIRValue(MetadataSet* m, str key, IrValue* val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = val;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::IRValue;
    e->value.typeVal = null;
}

pub void addFloat(MetadataSet* m, str key, f64 val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = val;
    e->value.vkind = MetadataValueKind::Float;
    e->value.typeVal = null;
}

pub void addBool(MetadataSet* m, str key, bool val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = val ? 1 : 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Bool;
    e->value.typeVal = null;
}

pub void addType(MetadataSet* m, str key, IrType* val)
{
    if (m->numEntries >= m->capEntries)
    {
        u32 newCap = m->capEntries ? m->capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < m->numEntries; i++)
            newEntries[i] = m->entries[i];
        if (m->entries) dealloc<MetadataEntry>(m->entries);
        m->entries = newEntries;
        m->capEntries = newCap;
    }

    MetadataEntry* e = &m->entries[m->numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Type;
    e->value.typeVal = val;
}

pub MetadataEntry* find(MetadataSet* m, str key)
{
    for (u32 i = 0; i < m->numEntries; i++)
    {
        if (m->entries[i].key.equals(key))
            return &m->entries[i];
    }
    return null;
}

pub void metadataSetFree(MetadataSet* m)
{
    for (u32 i = 0; i < m->numEntries; i++)
    {
        MetadataEntry* e = &m->entries[i];
        if (e->key.ptr) dealloc<u8>((u8*)e->key.ptr);
        if (e->value.vkind == MetadataValueKind::String && e->value.strVal.ptr)
            dealloc<u8>((u8*)e->value.strVal.ptr);
    }
    if (m->entries) dealloc<MetadataEntry>(m->entries);
    m->entries = null;
    m->numEntries = 0;
    m->capEntries = 0;
}

pub struct DebugLocation
{
    str filename;
    u32 line;
    u32 column;
    str scope;
}

pub struct DebugFuncInfo
{
    str name;
    str linkageName;
    DebugLocation loc;
    IrType* type;
}

pub struct DebugVarInfo
{
    str name;
    str linkageName;
    DebugLocation loc;
    IrType* type;
    IrValue* address;
}

pub struct MetadataStore
{
    MetadataSet* funcMetadata;
    u32 numFuncs;
    u32 capFuncs;

    MetadataSet* instMetadata;
    u32 numInsts;
    u32 capInsts;

    DebugFuncInfo* funcDebugInfo;
    DebugVarInfo* varDebugInfo;
    u32 numVars;
    u32 capVars;
}

static MetadataStore gMetadataStore;

pub void metadataInit()
{
    MetadataStore* s = &gMetadataStore;
    s->funcMetadata = null;
    s->numFuncs = 0;
    s->capFuncs = 0;
    s->instMetadata = null;
    s->numInsts = 0;
    s->capInsts = 0;
    s->funcDebugInfo = null;
    s->varDebugInfo = null;
    s->numVars = 0;
    s->capVars = 0;
}

pub void metadataShutdown()
{
    MetadataStore* s = &gMetadataStore;
    for (u32 i = 0; i < s->numFuncs; i++)
        metadataSetFree(&s->funcMetadata[i]);
    if (s->funcMetadata) dealloc<MetadataSet>(s->funcMetadata);

    for (u32 i = 0; i < s->numInsts; i++)
        metadataSetFree(&s->instMetadata[i]);
    if (s->instMetadata) dealloc<MetadataSet>(s->instMetadata);

    if (s->funcDebugInfo) dealloc<DebugFuncInfo>(s->funcDebugInfo);
    if (s->varDebugInfo) dealloc<DebugVarInfo>(s->varDebugInfo);
}

// Attach metadata to a function — the set rides on the function itm so
// printers and passes can find it again (the old global side table was
// write-only: nothing could ever map a set back to its owner)
pub MetadataSet* attachFuncMetadata(IrFunc* func)
{
    if (!func) return null;
    if (!func->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        func->metadata = md;
    }
    return (MetadataSet*)func->metadata;
}

pub MetadataSet* attachInstMetadata(IrInst* inst)
{
    if (!inst) return null;
    if (!inst->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        inst->metadata = md;
    }
    return (MetadataSet*)inst->metadata;
}

pub MetadataSet* attachGlobalMetadata(IrGlobal* g)
{
    if (!g) return null;
    if (!g->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        g->metadata = md;
    }
    return (MetadataSet*)g->metadata;
}

pub MetadataSet* attachStringMetadata(IrStringConst* sc)
{
    if (!sc) return null;
    if (!sc->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        sc->metadata = md;
    }
    return (MetadataSet*)sc->metadata;
}

pub void setDebugLocation(IrInst* inst, str file, u32 line, u32 col)
{
    MetadataSet* md = attachInstMetadata(inst);
    addString(md, "debug.file", file);
    addInt(md, "debug.line", (usize)line);
    addInt(md, "debug.col", (usize)col);
}

pub void setAlignment(IrInst* inst, u32 align)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "alignment", (usize)align);
}

pub void setNoAlias(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "noalias", 1);
}

pub void setNoCapture(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "nocapture", 1);
}

pub void setReadOnly(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "readonly", 1);
}

pub void setInlineHint(IrInst* inst, u32 hint)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "inlinehint", (usize)hint);
}

pub void setBranchWeights(IrInst* inst, u32 trueWeight, u32 falseWeight)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "weight.true", (usize)trueWeight);
    addInt(md, "weight.false", (usize)falseWeight);
}

pub void setRange(IrInst* inst, isize min, isize max)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "range.min", (usize)min);
    addInt(md, "range.max", (usize)max);
}

// !tbaa (scaffold): a scalar alias tag on a load/store. LLVM's nested
// tag structure (root/struct/offset) would encode into this int later.
pub void setTbaa(IrInst* inst, u32 tag)
{
    addInt(attachInstMetadata(inst), "tbaa", (usize)tag);
}

pub u32 tbaaOf(IrInst* inst)
{
    MetadataSet* md = getInstMetadata(inst);
    if (md == null) return 0;
    MetadataEntry* e = find(md, "tbaa");
    if (e == null) return 0;
    if (e->value.vkind == MetadataValueKind::Int ||
        e->value.vkind == MetadataValueKind::Bool)
        return (u32)e->value.intVal;
    return 0;
}

pub MetadataSet* getInstMetadata(IrInst* inst)
{
    if (!inst) return null;
    return (MetadataSet*)inst->metadata;
}

pub MetadataSet* getFuncMetadata(IrFunc* func)
{
    if (!func) return null;
    return (MetadataSet*)func->metadata;
}

/* Function attributes ride the function's metadata set as int/string
 * entries. These setters are the canonical key spellings; consumers must
 * query through the helpers below so a key rename stays localized. */
pub void setFuncNoReturn(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "noreturn", 1);
}

pub void setFuncReadOnly(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "readonly", 1);
}

pub void setFuncReadNone(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "readnone", 1);
}

pub void setFuncWriteOnly(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "writeonly", 1);
}

pub void setFuncAllocFn(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "allocfn", 1);
}

pub void setFuncFreeFn(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "freefn", 1);
}

pub void setFuncNoUnwind(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "nounwind", 1);
}

pub void setFuncNoInline(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "noinline", 1);
}

pub void setFuncAlwaysInline(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "alwaysinline", 1);
}

pub void setFuncInlineHint(IrFunc* func, u32 hint)
{
    addInt(attachFuncMetadata(func), "inlinehint", (usize)hint);
}

pub void setFuncOptNone(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "optnone", 1);
}

pub void setFuncHot(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "hot", 1);
}

pub void setFuncCold(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "cold", 1);
}

// #[[naked]]: no compiler-generated prologue, epilogue or frame
pub void setFuncNaked(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "naked", 1);
}

// #[[entry]]: program entry; codegen also emits the __coral_entry alias
pub void setFuncEntry(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "entry", 1);
}

// #[[entry(address)]]: literal start address; codegen emits the
// __coral_entry_addr absolute symbol (see docs/baremetal-attributes.md)
pub void setFuncEntryAddr(IrFunc* func, u64 addr)
{
    addInt(attachFuncMetadata(func), "entry.addr", (usize)addr);
}

pub void setFuncNoMangle(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "no_mangle", 1);
}

pub void setFuncUwTable(IrFunc* func)
{
    addInt(attachFuncMetadata(func), "uwtable", 1);
}

pub void setFuncSection(IrFunc* func, str section)
{
    addString(attachFuncMetadata(func), "section", section);
}

pub void setFuncVisibility(IrFunc* func, str vis)
{
    addString(attachFuncMetadata(func), "visibility", vis);
}

pub void setFuncAlign(IrFunc* func, u32 align)
{
    addInt(attachFuncMetadata(func), "align", (usize)align);
}

pub void setFuncPersonality(IrFunc* func, IrValue* fn)
{
    addIRValue(attachFuncMetadata(func), "personality", fn);
}

// True when the attribute is present; bare !key is int 1, so an int-0
// entry reads as absent for flag semantics. Falls back to the function's
// attribute group when the per-function set has no entry.
pub bool hasFuncAttr(IrFunc* func, str key)
{
    MetadataSet* md = getFuncMetadata(func);
    if (md != null)
    {
        MetadataEntry* e = find(md, key);
        if (e != null)
        {
            if (e->value.vkind == MetadataValueKind::Int ||
                e->value.vkind == MetadataValueKind::Bool)
                return e->value.intVal != 0;
            return true;
        }
    }
    if (func != null && func->attrGroup != 0 && func->parent != null)
    {
        MetadataSet* g = irModuleAttrGroup(func->parent, func->attrGroup);
        if (g != null)
        {
            MetadataEntry* e2 = find(g, key);
            if (e2 != null)
            {
                if (e2->value.vkind == MetadataValueKind::Int ||
                    e2->value.vkind == MetadataValueKind::Bool)
                    return e2->value.intVal != 0;
                return true;
            }
        }
    }
    return false;
}

pub i64 funcAttrInt(IrFunc* func, str key, i64 def)
{
    MetadataSet* md = getFuncMetadata(func);
    if (md != null)
    {
        MetadataEntry* e = find(md, key);
        if (e != null)
        {
            if (e->value.vkind == MetadataValueKind::Int ||
                e->value.vkind == MetadataValueKind::Bool)
                return (i64)e->value.intVal;
            return def;
        }
    }
    if (func != null && func->attrGroup != 0 && func->parent != null)
    {
        MetadataSet* g = irModuleAttrGroup(func->parent, func->attrGroup);
        if (g != null)
        {
            MetadataEntry* e2 = find(g, key);
            if (e2 != null &&
                (e2->value.vkind == MetadataValueKind::Int ||
                 e2->value.vkind == MetadataValueKind::Bool))
                return (i64)e2->value.intVal;
        }
    }
    return def;
}

pub str funcAttrStr(IrFunc* func, str key)
{
    MetadataSet* md = getFuncMetadata(func);
    if (md != null)
    {
        MetadataEntry* e = find(md, key);
        if (e != null)
        {
            if (e->value.vkind == MetadataValueKind::String) return e->value.strVal;
            return str::empty();
        }
    }
    if (func != null && func->attrGroup != 0 && func->parent != null)
    {
        MetadataSet* g = irModuleAttrGroup(func->parent, func->attrGroup);
        if (g != null)
        {
            MetadataEntry* e2 = find(g, key);
            if (e2 != null && e2->value.vkind == MetadataValueKind::String)
                return e2->value.strVal;
        }
    }
    return str::empty();
}

pub bool funcIsNaked(IrFunc* func) { return hasFuncAttr(func, "naked"); }
pub bool funcIsEntry(IrFunc* func) { return hasFuncAttr(func, "entry"); }
pub bool funcIsNoReturn(IrFunc* func) { return hasFuncAttr(func, "noreturn"); }
pub bool funcIsReadOnly(IrFunc* func) { return hasFuncAttr(func, "readonly"); }
pub bool funcIsReadNone(IrFunc* func) { return hasFuncAttr(func, "readnone"); }
pub bool funcIsNoInline(IrFunc* func) { return hasFuncAttr(func, "noinline"); }
pub bool funcIsAlwaysInline(IrFunc* func) { return hasFuncAttr(func, "alwaysinline"); }
pub bool funcIsOptNone(IrFunc* func) { return hasFuncAttr(func, "optnone"); }
pub bool funcIsHot(IrFunc* func) { return hasFuncAttr(func, "hot"); }
pub bool funcIsCold(IrFunc* func) { return hasFuncAttr(func, "cold"); }
pub bool funcIsNoMangle(IrFunc* func) { return hasFuncAttr(func, "no_mangle"); }
pub bool funcIsAllocFn(IrFunc* func) { return hasFuncAttr(func, "allocfn"); }
pub bool funcIsFreeFn(IrFunc* func) { return hasFuncAttr(func, "freefn"); }

// True when the call site's callee is a known noreturn function. Calls to
// such callees never return control, which passes may use to mark paths
// dead and to treat the call as a terminator-like instruction for liveness.
pub bool instCallsNoReturn(IrInst* inst)
{
    if (inst == null || inst->opcode != IrOpcode::Call || inst->nops < 1) return false;
    IrValue* calleeVal = inst->ops[0];
    if (calleeVal == null || calleeVal->kind != IrValueKind::Func) return false;
    return funcIsNoReturn((IrFunc*)calleeVal);
}

// Leaf query that ignores noreturn callees: a call to a noreturn callee
// never returns control, so it imposes no caller-save pressure and does not
// count against leafness. (IrFunc.isLeaf() in irtypes cannot do this —
// irtypes may not import irMetadata; module cycle.)
pub bool funcIsLeaf(IrFunc* func)
{
    if (func == null) return false;
    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* call = bb->insts[ii];
            if (call->opcode != IrOpcode::Call) continue;
            if (instCallsNoReturn(call)) continue;
            return false;
        }
    }
    return true;
}
/* Linkage: metadata-level spellings only — the generic printer/parser
 * already round-trip `!linkage = N`, so no extra IrFunc/IrGlobal fields.
 * Values: 0 external (default), 1 internal, 2 private, 3 weak, 4 common. */
pub void setFuncLinkage(IrFunc* func, u32 linkage)
{
    addInt(attachFuncMetadata(func), "linkage", (usize)linkage);
}

pub u32 funcLinkage(IrFunc* func)
{
    MetadataSet* md = getFuncMetadata(func);
    if (md == null) return 0;
    MetadataEntry* e = find(md, "linkage");
    if (e == null) return 0;
    if (e->value.vkind == MetadataValueKind::Int ||
        e->value.vkind == MetadataValueKind::Bool)
        return (u32)e->value.intVal;
    return 0;
}

pub void setGlobalLinkage(IrGlobal* g, u32 linkage)
{
    addInt(attachGlobalMetadata(g), "linkage", (usize)linkage);
}

pub u32 globalLinkage(IrGlobal* g)
{
    if (g == null) return 0;
    MetadataSet* md = (MetadataSet*)g->metadata;
    if (md == null) return 0;
    MetadataEntry* e = find(md, "linkage");
    if (e == null) return 0;
    if (e->value.vkind == MetadataValueKind::Int ||
        e->value.vkind == MetadataValueKind::Bool)
        return (u32)e->value.intVal;
    return 0;
}

/* Attribute groups: LLVM's `#N = { … }` dedup, scaffold level. The module
 * owns the sets; IrFunc.attrGroup is a 1-based index into that table and
 * prints as `!attrgroup = N`. Group contents are builder-side only for
 * now — the parser does not reconstruct them-> */
pub u32 irModuleAddAttrGroup(IrModule* m)
{
    if (m == null) return 0;
    if (m->nAttrGroups >= m->capAttrGroups)
    {
        u32 newCap = m->capAttrGroups ? m->capAttrGroups * 2 : 4;
        rawptr* arr = alloc<rawptr>((usize)newCap);
        for (u32 i = 0; i < m->nAttrGroups; i++) arr[i] = m->attrGroups[i];
        if (m->attrGroups != null) dealloc<rawptr>(m->attrGroups);
        m->attrGroups = arr;
        m->capAttrGroups = newCap;
    }
    MetadataSet* md = alloc<MetadataSet>((usize)1);
    *md = newMetadataSet();
    m->attrGroups[m->nAttrGroups] = (rawptr)md;
    m->nAttrGroups += 1;
    return m->nAttrGroups;
}

pub MetadataSet* irModuleAttrGroup(IrModule* m, u32 idx)
{
    if (m == null || idx == 0 || idx > m->nAttrGroups) return null;
    return (MetadataSet*)m->attrGroups[idx - 1];
}

pub void setFuncAttrGroup(IrFunc* func, u32 idx)
{
    if (func) func->attrGroup = idx;
}

pub u32 funcAttrGroup(IrFunc* func)
{
    if (func == null) return 0;
    return func->attrGroup;
}

pub bool funcIsNoUnwind(IrFunc* func) { return hasFuncAttr(func, "nounwind"); }
