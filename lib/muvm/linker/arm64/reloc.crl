#[[no_drop_all]]
/* reloc.crl for linker
 * Applies input relocations to the emitted image. Each Reloc carries
 * fmt: 0 = ELF type numbers, 1 = COFF type numbers (native, not
 * translated). x86_64 takes GOTPCREL/GOTPCRELX as a PC32 relaxation
 * (static output has no GOT); dynamic relocation types are hard
 * errors. REL addends are read in-field, RELA addends come from the
 * entry; COFF is always in-field. When fixups is non-null, absolute
 * writes are recorded for PE base relocations or ELF-dyn RELATIVE
 * entries - 32-bit absolute writes into ELF-dyn output are rejected
 * (they cannot slide).
 */

import std::vec { Vec };
import std::string { String };
import std::mman { alloc, dealloc };
use elf {
    SHT_NOBITS, SHF_ALLOC, STB_LOCAL, SHN_ABS, SHN_UNDEF,
    OUT_NONE, EM_AARCH64, FMT_ELF_DYN, FMT_PE_EXE, FMT_PE_DLL,
    R_AARCH64_ABS64, R_AARCH64_ABS32, R_AARCH64_PREL32,
    R_AARCH64_MOVW_UABS_G0, R_AARCH64_MOVW_UABS_G0_NC,
    R_AARCH64_MOVW_UABS_G1, R_AARCH64_MOVW_UABS_G1_NC,
    R_AARCH64_MOVW_UABS_G2, R_AARCH64_MOVW_UABS_G2_NC,
    R_AARCH64_MOVW_UABS_G3,
    R_AARCH64_LD_PREL_LO19, R_AARCH64_ADR_PREL_LO21,
    R_AARCH64_ADR_PREL_PG_HI21, R_AARCH64_ADR_PREL_PG_HI21_NC,
    R_AARCH64_ADD_ABS_LO12_NC,
    R_AARCH64_LDST8_ABS_LO12_NC, R_AARCH64_LDST16_ABS_LO12_NC,
    R_AARCH64_LDST32_ABS_LO12_NC, R_AARCH64_LDST64_ABS_LO12_NC,
    R_AARCH64_LDST128_ABS_LO12_NC,
    R_AARCH64_TSTBR14, R_AARCH64_CONDBR19, R_AARCH64_JUMP26, R_AARCH64_CALL26,
    R_AARCH64_COPY, R_AARCH64_GLOB_DAT, R_AARCH64_JUMP_SLOT, R_AARCH64_RELATIVE,
    R_AARCH64_TLS_DTPMOD64, R_AARCH64_TLS_DTPREL64, R_AARCH64_TLS_TPREL64,
    R_AARCH64_TLSLE_MOVW_TPREL_G2, R_AARCH64_TLSLE_MOVW_TPREL_G1,
    R_AARCH64_TLSLE_MOVW_TPREL_G1_NC, R_AARCH64_TLSLE_MOVW_TPREL_G0,
    R_AARCH64_TLSLE_MOVW_TPREL_G0_NC, R_AARCH64_TLSLE_ADD_TPREL_HI12,
    R_AARCH64_TLSLE_ADD_TPREL_LO12, R_AARCH64_TLSLE_ADD_TPREL_LO12_NC,
    R_AARCH64_TLSLE_LDST8_TPREL_LO12, R_AARCH64_TLSLE_LDST8_TPREL_LO12_NC,
    R_AARCH64_TLSLE_LDST16_TPREL_LO12, R_AARCH64_TLSLE_LDST16_TPREL_LO12_NC,
    R_AARCH64_TLSLE_LDST32_TPREL_LO12, R_AARCH64_TLSLE_LDST32_TPREL_LO12_NC,
    R_AARCH64_TLSLE_LDST64_TPREL_LO12, R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC,
    R_AARCH64_TLSLE_LDST128_TPREL_LO12, R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC,
    R_AARCH64_TLSIE_MOVW_GOTTPREL_G1, R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC,
    R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21, R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC,
    R_AARCH64_TLSIE_LD_GOTTPREL_PREL19,
    R_AARCH64_ADR_GOT_PAGE, R_AARCH64_LD64_GOT_LO12_NC,
    R_AARCH64_LD64_GOTPAGE_LO15, R_AARCH64_GOT_LD_PREL19,
    R_AARCH64_LD64_GOTOFF_LO15,
    R_AARCH64_MOVW_GOTOFF_G0, R_AARCH64_MOVW_GOTOFF_G0_NC,
    R_AARCH64_MOVW_GOTOFF_G1, R_AARCH64_MOVW_GOTOFF_G1_NC,
    R_AARCH64_MOVW_GOTOFF_G2, R_AARCH64_MOVW_GOTOFF_G2_NC,
    R_AARCH64_MOVW_GOTOFF_G3, R_AARCH64_GOTREL32, R_AARCH64_GOTREL64,
    fits, leU16, leU32, leU64, putU16, putU32, putU64, pushDec, pushHex
};
use coff {
    IMAGE_REL_ARM64_ABSOLUTE, IMAGE_REL_ARM64_ADDR32, IMAGE_REL_ARM64_ADDR32NB,
    IMAGE_REL_ARM64_BRANCH26, IMAGE_REL_ARM64_PAGEBASE_REL21,
    IMAGE_REL_ARM64_REL21, IMAGE_REL_ARM64_PAGEOFFSET_12A,
    IMAGE_REL_ARM64_PAGEOFFSET_12L, IMAGE_REL_ARM64_SECREL,
    IMAGE_REL_ARM64_SECREL_LOW12A, IMAGE_REL_ARM64_SECREL_HIGH12A,
    IMAGE_REL_ARM64_SECREL_LOW12L, IMAGE_REL_ARM64_SECTION,
    IMAGE_REL_ARM64_ADDR64, IMAGE_REL_ARM64_BRANCH19,
    IMAGE_REL_ARM64_BRANCH14, IMAGE_REL_ARM64_REL32
};
use object { ObjFile, Section, Sym, Reloc };
use resolve { GlobalDef, findDef };
use layout { Layout, OutSec, defAddress, pieceOffset, SEC_DATA, SEC_GOT, SEC_TEXT };

void _relErrBase(String* err, str objName)
{
    err->pushView("linker: ");
    err->pushView(objName);
}

bool _rangeErr(String* err, str objName, u32 type, u64 vaddr)
{
    _relErrBase(err, objName);
    err->pushView(": relocation type ");
    pushDec(err, (u64)type);
    err->pushView(" out of range at ");
    pushHex(err, vaddr);
    err->pushView(" (S+A-P does not fit)");
    return false;
}

bool _dynErr(String* err, str objName, u32 type)
{
    _relErrBase(err, objName);
    err->pushView(": dynamic relocation type ");
    pushDec(err, (u64)type);
    err->pushView(" is not supported by this linker mode");
    return false;
}

bool _supErr(String* err, str objName, u32 type)
{
    _relErrBase(err, objName);
    err->pushView(": unsupported relocation type ");
    pushDec(err, (u64)type);
    return false;
}

/* Records an absolute write for base relocation / RELATIVE tables.
 * Returns false when the write cannot be represented in the output
 * (32-bit absolute references in ELF-dyn output).
 */
bool _recordFixup(Vec<u32>* fixups, u8 outFmt, bool is64, usize fileOff, u32 peRva, bool abs8)
{
    if (fixups == null) return true;
    bool pe = outFmt == FMT_PE_EXE || outFmt == FMT_PE_DLL;
    if (pe)
    {
        fixups->push(peRva);
        return true;
    }
    if (outFmt == FMT_ELF_DYN)
    {
        if (!abs8 && is64) return false;
        fixups->push((u32)fileOff);
        return true;
    }
    return true;
}

bool _dyn32Err(String* err, str objName, u32 type, u64 vaddr)
{
    _relErrBase(err, objName);
    err->pushView(": relocation type ");
    pushDec(err, (u64)type);
    err->pushView(" is a 32-bit absolute write at ");
    pushHex(err, vaddr);
    err->pushView(" which cannot slide in shared object output");
    return false;
}

/* Output-section base of the reloc's target symbol (for SECREL). */
u64 _targetSecBase(ObjFile* obj, Layout* L, u32 symIdx, usize objIdx)
{
    if (symIdx >= (u32)obj->syms.count()) return 0;
    Sym* ts = obj->syms.atPtr((usize)symIdx);
    if (ts->shndx == SHN_ABS || ts->shndx == SHN_UNDEF) return 0;
    if ((usize)ts->shndx >= obj->secs.count()) return 0;
    Section* tin = obj->secs.atPtr((usize)ts->shndx);
    if (tin->outIdx == OUT_NONE) return 0;
    return L->secs.atPtr((usize)tin->outIdx)->addr +
           pieceOffset(L, (usize)tin->outIdx, objIdx, (usize)ts->shndx);
}

u16 _targetSecIndex(ObjFile* obj, u32 symIdx)
{
    if (symIdx >= (u32)obj->syms.count()) return 0;
    Sym* ts = obj->syms.atPtr((usize)symIdx);
    if ((usize)ts->shndx >= obj->secs.count()) return 0;
    Section* tin = obj->secs.atPtr((usize)ts->shndx);
    if (tin->outIdx == OUT_NONE) return 0;
    return (u16)(tin->outIdx + 1); /* COFF section numbers are 1-based */
}

/* ---- AArch64 instruction field writers (lld formulas) ---- */

i64 _sext(u64 v, u32 bits)
{
    u64 m = (u64)1 << (u64)(bits - 1);
    return (i64)((v ^ m) - m);
}

u64 _a64Page(u64 v) { return v & ~(u64)0xFFF; }

bool _a64RangeErr(String* err, str objName, u32 type, u64 vaddr, u32 bits, bool uns)
{
    _relErrBase(err, objName);
    err->pushView(": relocation type ");
    pushDec(err, (u64)type);
    err->pushView(uns ? " out of range (unsigned) at " : " out of range at ");
    pushHex(err, vaddr);
    if (!uns)
    {
        err->pushView(" (needs ");
        pushDec(err, (u64)bits);
        err->pushView("-bit signed)");
    }
    else
    {
        err->pushView(" (needs ");
        pushDec(err, (u64)bits);
        err->pushView("-bit unsigned)");
    }
    return false;
}

bool _a64ChkI(String* err, str objName, u32 type, u64 vaddr, i64 v, u32 bits)
{
    i64 lo = -(i64)((u64)1 << (u64)(bits - 1));
    i64 hi = (i64)(((u64)1 << (u64)(bits - 1)) - 1);
    if (v < lo || v > hi)
        return _a64RangeErr(err, objName, type, vaddr, bits, false);
    return true;
}

bool _a64ChkU(String* err, str objName, u32 type, u64 vaddr, u64 v, u32 bits)
{
    if (bits < 64 && v >= ((u64)1 << (u64)bits))
        return _a64RangeErr(err, objName, type, vaddr, bits, true);
    return true;
}

void _a64W32Masked(u8* p, u32 val, u32 mask)
{
    u32 w = leU32(p);
    w = (w & ~mask) | (val & mask);
    putU32(p, w);
}

/* imm12 field at bits 21:10 */
void _a64WImm12(u8* p, u64 imm)
{
    _a64W32Masked(p, ((u32)imm & 0xFFFu) << 10, 0x003FFC00u);
}

/* adr/adrp immediate: immlo -> bits 30:29, immhi -> bits 23:5 */
void _a64WAddr(u8* p, u64 val)
{
    u32 immlo = (u32)(val & 3);
    u32 immhi = (u32)((val >> 2) & 0x7FFFF);
    _a64W32Masked(p, (immlo << 29) | (immhi << 5), 0x60FFFFE0u);
}

/* implicit addend extraction for COFF (in-field) ARM64 relocs */
i64 _coffA64Addend(u8* p, u32 t)
{
    u32 w = leU32(p);
    if (t == IMAGE_REL_ARM64_BRANCH26)
        return _sext((u64)(w & 0x03FFFFFFu), 26) << 2;
    if (t == IMAGE_REL_ARM64_BRANCH19)
        return _sext((u64)((w >> 5) & 0x7FFFFu), 19) << 2;
    if (t == IMAGE_REL_ARM64_BRANCH14)
        return _sext((u64)((w >> 5) & 0x3FFFu), 14) << 2;
    if (t == IMAGE_REL_ARM64_REL21)
        return _sext((((u64)(w >> 29) & 3) | (((u64)(w >> 5) & 0x7FFFFu) << 2)), 21);
    if (t == IMAGE_REL_ARM64_PAGEBASE_REL21)
        return _sext((((u64)(w >> 29) & 3) | (((u64)(w >> 5) & 0x7FFFFu) << 2)), 21) << 12;
    if (t == IMAGE_REL_ARM64_PAGEOFFSET_12A)
        return (i64)((w >> 10) & 0xFFFu);
    if (t == IMAGE_REL_ARM64_PAGEOFFSET_12L)
    {
        u32 size = (w >> 30) & 3;
        return (i64)(((w >> 10) & 0xFFFu) << size);
    }
    if (t == IMAGE_REL_ARM64_REL32)
        return (i64)(i32)w;
    if (t == IMAGE_REL_ARM64_ADDR32 || t == IMAGE_REL_ARM64_ADDR32NB)
        return (i64)(u32)w;
    if (t == IMAGE_REL_ARM64_ADDR64)
        return (i64)leU64(p);
    return 0;
}

pub bool applyRels(u16 machine, u8 outFmt, Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Layout* L, u8* img, usize imgLen, Vec<u32>* fixups, String* err)
{
    bool is64 = machine == EM_AARCH64;
    for (usize o = 0; o < objs->count(); o++)
    {
        ObjFile* obj = objs->atPtr(o);
        usize nsyms = obj->syms.count();
        u64* addrs = alloc<u64>((usize)(nsyms > 0 ? nsyms : 1));
        for (usize i = 0; i < nsyms; i++)
        {
            Sym* sym = obj->syms.atPtr(i);
            if (sym->bind != STB_LOCAL)
            {
                i64 di = findDef(defs, sym->name);
                if (di < 0)
                {
                    addrs[i] = 0;
                    continue;
                }
                if (!defAddress(objs, L, defs->atPtr((usize)di), &addrs[i], err))
                {
                    dealloc<u64>(addrs);
                    return false;
                }
                continue;
            }
            if (sym->shndx == SHN_UNDEF || sym->shndx == SHN_ABS)
            {
                addrs[i] = sym->shndx == SHN_ABS ? sym->value : 0;
                continue;
            }
            if ((usize)sym->shndx >= obj->secs.count())
            {
                addrs[i] = 0;
                continue;
            }
            Section* in = obj->secs.atPtr((usize)sym->shndx);
            if (in->outIdx == OUT_NONE)
            {
                addrs[i] = 0;
                continue;
            }
            addrs[i] = L->secs.atPtr((usize)in->outIdx)->addr +
                       pieceOffset(L, (usize)in->outIdx, o, (usize)sym->shndx) + sym->value;
        }

        /* Mach-O GOT slots: unique symbol indices referenced by
         * GOT_LOAD_PAGE21/OFF12 relocs, in first-seen order — must
         * match the counting pass in computeLayout */
        Vec<u32> gotSyms = Vec<u32>::new();
        for (usize si = 0; si < obj->secs.count(); si++)
        {
            Vec<Reloc>* bucket = obj->rels.atPtr(si);
            for (usize k = 0; k < bucket->count(); k++)
            {
                Reloc* r = bucket->atPtr(k);
                if (r->fmt != 2) continue;
                u32 mrt = (r->type - 1000) >> 4;
                if (mrt != 5 && mrt != 6) continue;
                bool seen = false;
                for (usize q = 0; q < gotSyms.count(); q++)
                    if (gotSyms.at(q) == r->sym) { seen = true; break; }
                if (!seen) gotSyms.push(r->sym);
            }
        }

        for (usize si = 0; si < obj->secs.count(); si++)
        {
            Section* sec = obj->secs.atPtr(si);
            Vec<Reloc>* bucket = obj->rels.atPtr(si);
            if (bucket->count() == 0) continue;
            if (sec->outIdx == OUT_NONE) continue;
            if (sec->type == SHT_NOBITS)
            {
                _relErrBase(err, obj->name);
                err->pushView(": relocation against NOBITS section ");
                err->pushView(sec->name);
                dealloc<u64>(addrs);
                return false;
            }
            OutSec* out = L->secs.atPtr((usize)sec->outIdx);
            u64 secOff = pieceOffset(L, (usize)sec->outIdx, o, si);
            /* non-allocated (debug/metadata) sections relocate as if
             * P were zero: the stored value is S+A, the form debug
             * consumers expect; they never get base fixups either. */
            bool allocd = (out->flags & SHF_ALLOC) != 0;
            Vec<u32>* rec = allocd ? fixups : null;
            u64 mSub = 0;
            bool mHasSub = false;
            for (usize k = 0; k < bucket->count(); k++)
            {
                Reloc* r = bucket->atPtr(k);
                u64 S = addrs[r->sym];
                u64 P = allocd ? out->addr + secOff + r->offset : 0;
                usize fileOff = (usize)(out->offset + secOff + r->offset);
                u32 t = r->type;

                /* field width, format-aware */
                u64 w = 4;
                if (r->fmt == 1)
                {
                    if (t == IMAGE_REL_ARM64_ADDR64) w = 8;
                    else if (t == IMAGE_REL_ARM64_SECTION) w = 2;
                }
                else if (r->fmt == 2)
                {
                    /* Mach-O: r.type = 1000 + ARM64_RELOC*16 + pcrel*8 + rlen;
                     * rlen is log2(access size) for UNSIGNED data relocs */
                    u32 mt = t - 1000;
                    u32 mrt = mt >> 4;
                    u32 mrlen = mt & 7;
                    if (mrt == 0)
                        w = mrlen == 3 ? 8 : mrlen == 2 ? 4 : mrlen == 1 ? 2 : 1;
                }
                else
                {
                    if (t == R_AARCH64_ABS64) w = 8;
                }
                if (r->offset + w > out->size || !fits(fileOff, (usize)w, imgLen))
                {
                    _relErrBase(err, obj->name);
                    err->pushView(": relocation target out of section bounds at ");
                    pushHex(err, P);
                    dealloc<u64>(addrs);
                    return false;
                }

                i64 A = r->addend;
                if (r->fmt == 1)
                {
                    /* COFF: in-field implicit addend per relocation type */
                    A += _coffA64Addend(img + fileOff, t);
                }
                else if (!r->rela && w == 8)
                {
                    A = (i64)leU64(img + fileOff);
                }
                u8* patch = img + fileOff;

                if (r->fmt == 2)
                {
                    /* Mach-O arm64 relocation.
                     * r.type packs: 1000 + ARM64_RELOC_*16 + pcrel*8 + rlen.
                     * Formulas follow LLVM lld MachO/Arch/ARM64.cpp. */
                    u32 mt = t - 1000;
                    u32 mrt = mt >> 4;
                    u32 mrlen = mt & 7;
                    if (mrt == 1)
                    {
                        /* SUBTRACTOR: pairs with the following UNSIGNED;
                         * remember the subtrahend symbol address */
                        mSub = S;
                        mHasSub = true;
                        continue;
                    }
                    if (mrt == 0)
                    {
                        /* UNSIGNED: absolute value S - K + A, addend is
                         * the in-field contents plus any paired ADDEND */
                        u64 fv = 0;
                        if (w == 8) fv = leU64(patch);
                        else if (w == 4) fv = (u64)leU32(patch);
                        else if (w == 2) fv = (u64)leU16(patch);
                        else fv = (u64)patch[0];
                        i64 mA = A + (i64)fv;
                        u64 Sv = S;
                        if (mHasSub) { Sv = S - mSub; mHasSub = false; mSub = 0; }
                        u64 v = Sv + (u64)mA;
                        if (w == 8) putU64(patch, v);
                        else if (w == 4)
                        {
                            if (v > 0xffffffffu)
                            {
                                dealloc<u64>(addrs);
                                return _rangeErr(err, obj->name, t, P);
                            }
                            putU32(patch, (u32)v);
                        }
                        else if (w == 2)
                        {
                            if (v > 0xffffu)
                            {
                                dealloc<u64>(addrs);
                                return _rangeErr(err, obj->name, t, P);
                            }
                            putU16(patch, (u16)v);
                        }
                        else patch[0] = (u8)(v & 0xFFu);
                        continue;
                    }
                    if (mHasSub) { mHasSub = false; mSub = 0; }
                    /* GOT_LOAD_PAGE21/OFF12 (mrt 5/6): the operand is a
                     * GOT slot in __DATA holding the symbol address */
                    u64 effS = S;
                    if (mrt == 5 || mrt == 6)
                    {
                        i64 gi = -1;
                        for (usize q = 0; q < gotSyms.count(); q++)
                            if (gotSyms.at(q) == r->sym) { gi = (i64)q; break; }
                        if (gi < 0 || L->gotSize == 0)
                        {
                            dealloc<u64>(addrs);
                            gotSyms.dispose();
                            return _supErr(err, obj->name, t);
                        }
                        effS = L->secs.atPtr((usize)SEC_DATA)->addr + L->gotOff +
                               (u64)gi * 8;
                        if (mrt == 5)
                        {
                            /* emit the GOT entry itself: vaddr-base ==
                             * file offset for Mach-O segments */
                            u64 gf = effS - L->imageBase;
                            if (gf + 8 <= (u64)imgLen) putU64(img + (usize)gf, S);
                        }
                    }
                    if (mrt == 2)
                    {
                        /* BRANCH26: b/bl, imm26 = (S+A-P)>>2 */
                        i64 v = (i64)S + A - (i64)P;
                        if (v & 3)
                        {
                            dealloc<u64>(addrs);
                            gotSyms.dispose();
                            _relErrBase(err, obj->name);
                            err->pushView(": misaligned branch26 target at ");
                            pushHex(err, P);
                            return false;
                        }
                        if (!_a64ChkI(err, obj->name, t, P, v, 28)) { dealloc<u64>(addrs); gotSyms.dispose(); return false; }
                        _a64W32Masked(patch, (u32)(((u64)v & 0x0FFFFFFCu) >> 2), 0x03FFFFFFu);
                    }
                    else if (mrt == 3 || mrt == 5)
                    {
                        /* PAGE21: adrp, imm = (page(S+A)-page(P))>>12 */
                        i64 v = (i64)(_a64Page(effS + (u64)A) - _a64Page(P));
                        if (!_a64ChkI(err, obj->name, t, P, v, 33)) { dealloc<u64>(addrs); gotSyms.dispose(); return false; }
                        _a64WAddr(patch, (u64)(v >> 12));
                    }
                    else if (mrt == 4 || mrt == 6)
                    {
                        /* PAGEOFF12: low 12 bits of S+A; unsigned-offset
                         * load/store forms scale imm12 by access size.
                         * Mask to the page offset BEFORE shifting —
                         * bits above bit 11 belong to the page number. */
                        u64 v = (effS + (u64)A) & 0xFFFu;
                        u32 iw = leU32(patch);
                        if (((iw >> 24) & 0x3Fu) == 0x39u)
                        {
                            u32 sz = (iw >> 30) & 3;
                            u64 scale = (u64)1 << (u64)sz;
                            if (v & (scale - 1))
                            {
                                dealloc<u64>(addrs);
                                gotSyms.dispose();
                                _relErrBase(err, obj->name);
                                err->pushView(": misaligned pageoff12 target at ");
                                pushHex(err, P);
                                return false;
                            }
                            _a64WImm12(patch, v >> (u64)sz);
                        }
                        else
                        {
                            _a64WImm12(patch, v);
                        }
                    }
                    else
                    {
                        dealloc<u64>(addrs);
                        gotSyms.dispose();
                        return _supErr(err, obj->name, t);
                    }
                    continue;
                }

                if (r->fmt == 1)
                {
                    /* COFF relocation (ARM64) */
                    if (t == IMAGE_REL_ARM64_ABSOLUTE)
                    {
                        continue;
                    }
                    else if (t == IMAGE_REL_ARM64_ADDR64)
                    {
                        putU64(patch, S + (u64)A);
                        if (!_recordFixup(rec, outFmt, true, fileOff, (u32)(P - L->imageBase), true))
                        {
                            dealloc<u64>(addrs);
                            return _dyn32Err(err, obj->name, t, P);
                        }
                    }
                    else if (t == IMAGE_REL_ARM64_ADDR32)
                    {
                        u64 v = S + (u64)A;
                        if (v > 0xffffffffu)
                        {
                            dealloc<u64>(addrs);
                            return _rangeErr(err, obj->name, t, P);
                        }
                        putU32(patch, (u32)v);
                        if (!_recordFixup(rec, outFmt, true, fileOff, (u32)(P - L->imageBase), false))
                        {
                            dealloc<u64>(addrs);
                            return _dyn32Err(err, obj->name, t, P);
                        }
                    }
                    else if (t == IMAGE_REL_ARM64_ADDR32NB)
                    {
                        u64 sv = S + (u64)A;
                        if (sv < L->imageBase || sv - L->imageBase > 0xffffffffu)
                        {
                            dealloc<u64>(addrs);
                            return _rangeErr(err, obj->name, t, P);
                        }
                        putU32(patch, (u32)(sv - L->imageBase));
                    }
                    else if (t == IMAGE_REL_ARM64_BRANCH26)
                    {
                        i64 v = (i64)S + A - (i64)P;
                        if (!_a64ChkI(err, obj->name, t, P, v, 28)) { dealloc<u64>(addrs); return false; }
                        _a64W32Masked(patch, (u32)(((u64)v & 0x0FFFFFFCu) >> 2), 0x03FFFFFFu);
                    }
                    else if (t == IMAGE_REL_ARM64_BRANCH19)
                    {
                        i64 v = (i64)S + A - (i64)P;
                        if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned branch19 target"); return false; }
                        if (!_a64ChkI(err, obj->name, t, P, v, 21)) { dealloc<u64>(addrs); return false; }
                        _a64W32Masked(patch, (u32)(((u64)v & 0x1FFFFCu) << 3), 0x00FFFFE0u);
                    }
                    else if (t == IMAGE_REL_ARM64_BRANCH14)
                    {
                        i64 v = (i64)S + A - (i64)P;
                        if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned branch14 target"); return false; }
                        if (!_a64ChkI(err, obj->name, t, P, v, 16)) { dealloc<u64>(addrs); return false; }
                        _a64W32Masked(patch, (u32)(((u64)v & 0xFFFCu) << 3), 0x0007FFE0u);
                    }
                    else if (t == IMAGE_REL_ARM64_REL21)
                    {
                        i64 v = (i64)S + A - (i64)P;
                        if (!_a64ChkI(err, obj->name, t, P, v, 21)) { dealloc<u64>(addrs); return false; }
                        _a64WAddr(patch, (u64)v);
                    }
                    else if (t == IMAGE_REL_ARM64_PAGEBASE_REL21)
                    {
                        i64 v = (i64)(_a64Page(S + (u64)A) - _a64Page(P));
                        if (!_a64ChkI(err, obj->name, t, P, v, 33)) { dealloc<u64>(addrs); return false; }
                        _a64WAddr(patch, (u64)(v >> 12));
                    }
                    else if (t == IMAGE_REL_ARM64_PAGEOFFSET_12A)
                    {
                        u64 v = S + (u64)A;
                        _a64WImm12(patch, v & 0xFFFu);
                    }
                    else if (t == IMAGE_REL_ARM64_PAGEOFFSET_12L)
                    {
                        u64 v = S + (u64)A;
                        u32 w = leU32(patch);
                        u32 size = (w >> 30) & 3;
                        u64 scale = (u64)1 << (u64)size;
                        if (v & (scale - 1))
                        {
                            dealloc<u64>(addrs);
                            _relErrBase(err, obj->name);
                            err->pushView(": misaligned pageoffset12l target");
                            return false;
                        }
                        _a64WImm12(patch, (v & 0xFFFu) >> (u64)size);
                    }
                    else if (t == IMAGE_REL_ARM64_REL32)
                    {
                        i64 v = (i64)S + A - (i64)P - 4;
                        if (v < -2147483647 - 1 || v > 2147483647)
                        {
                            dealloc<u64>(addrs);
                            return _rangeErr(err, obj->name, t, P);
                        }
                        putU32(patch, (u32)v);
                    }
                    else if (t == IMAGE_REL_ARM64_SECREL)
                    {
                        u64 secBase = _targetSecBase(obj, L, r->sym, o);
                        i64 v = (i64)S + A - (i64)secBase;
                        if (v < 0 || v > (i64)0xffffffffu)
                        {
                            dealloc<u64>(addrs);
                            return _rangeErr(err, obj->name, t, P);
                        }
                        putU32(patch, (u32)v);
                    }
                    else if (t == IMAGE_REL_ARM64_SECREL_LOW12A ||
                             t == IMAGE_REL_ARM64_SECREL_HIGH12A ||
                             t == IMAGE_REL_ARM64_SECREL_LOW12L)
                    {
                        u64 secBase = _targetSecBase(obj, L, r->sym, o);
                        i64 v = (i64)S + A - (i64)secBase;
                        if (v < 0 || v > (i64)0xfffffffffffu)
                        {
                            dealloc<u64>(addrs);
                            return _rangeErr(err, obj->name, t, P);
                        }
                        if (t == IMAGE_REL_ARM64_SECREL_LOW12A ||
                            t == IMAGE_REL_ARM64_SECREL_LOW12L)
                            _a64WImm12(patch, (u64)v & 0xFFFu);
                        else
                            _a64WAddr(patch, ((u64)v >> 12) & 0x1FFFFFu);
                    }
                    else if (t == IMAGE_REL_ARM64_SECTION)
                    {
                        putU16(patch, _targetSecIndex(obj, r->sym));
                    }
                    else
                    {
                        dealloc<u64>(addrs);
                        return _supErr(err, obj->name, t);
                    }
                    continue;
                }

                /* ELF relocation (AArch64) */
                if (t == R_AARCH64_ABS64)
                {
                    putU64(patch, S + (u64)A);
                    if (!_recordFixup(rec, outFmt, true, fileOff, (u32)(P - L->imageBase), true))
                    {
                        dealloc<u64>(addrs);
                        return _dyn32Err(err, obj->name, t, P);
                    }
                }
                else if (t == R_AARCH64_ABS32)
                {
                    u64 v = S + (u64)A;
                    if (v > 0xffffffffu)
                    {
                        dealloc<u64>(addrs);
                        return _rangeErr(err, obj->name, t, P);
                    }
                    putU32(patch, (u32)v);
                    if (!_recordFixup(rec, outFmt, true, fileOff, (u32)(P - L->imageBase), false))
                    {
                        dealloc<u64>(addrs);
                        return _dyn32Err(err, obj->name, t, P);
                    }
                }
                else if (t == R_AARCH64_PREL32)
                {
                    i64 v = (i64)S + A - (i64)P;
                    if (v < -2147483647 - 1 || v > 2147483647)
                    {
                        dealloc<u64>(addrs);
                        return _rangeErr(err, obj->name, t, P);
                    }
                    putU32(patch, (u32)v);
                }
                else if (t == R_AARCH64_ADD_ABS_LO12_NC)
                {
                    _a64WImm12(patch, (S + (u64)A) & 0xFFFu);
                }
                else if (t == R_AARCH64_LDST8_ABS_LO12_NC)
                {
                    _a64WImm12(patch, (S + (u64)A) & 0xFFFu);
                }
                else if (t == R_AARCH64_LDST16_ABS_LO12_NC ||
                         t == R_AARCH64_LDST32_ABS_LO12_NC ||
                         t == R_AARCH64_LDST64_ABS_LO12_NC ||
                         t == R_AARCH64_LDST128_ABS_LO12_NC)
                {
                    u32 sh = t == R_AARCH64_LDST16_ABS_LO12_NC ? 1 :
                             t == R_AARCH64_LDST32_ABS_LO12_NC ? 2 :
                             t == R_AARCH64_LDST64_ABS_LO12_NC ? 3 : 4;
                    u64 v = S + (u64)A;
                    if (v & (((u64)1 << (u64)sh) - 1))
                    {
                        dealloc<u64>(addrs);
                        _relErrBase(err, obj->name);
                        err->pushView(": misaligned lo12 load/store target at ");
                        pushHex(err, P);
                        return false;
                    }
                    _a64WImm12(patch, (v >> (u64)sh) & 0xFFFu);
                }
                else if (t == R_AARCH64_TSTBR14)
                {
                    i64 v = (i64)S + A - (i64)P;
                    if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned tstbr14 target"); return false; }
                    if (!_a64ChkI(err, obj->name, t, P, v, 16)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, (u32)(((u64)v & 0xFFFCu) << 3), 0x0007FFE0u);
                }
                else if (t == R_AARCH64_CONDBR19 || t == R_AARCH64_LD_PREL_LO19)
                {
                    i64 v = (i64)S + A - (i64)P;
                    if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned condbr19 target"); return false; }
                    if (!_a64ChkI(err, obj->name, t, P, v, 21)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, (u32)(((u64)v & 0x1FFFFCu) << 3), 0x00FFFFE0u);
                }
                else if (t == R_AARCH64_JUMP26)
                {
                    /* direct jump to an IFUNC symbol targets its IPLT
                     * stub (adrp/ldr/br *got_slot), not the resolver */
                    u64 GS = S;
                    if (L->ipltKeys.count() > 0)
                    {
                        u64 key = ((u64)o << 33) | (u64)r->sym;
                        for (usize q = 0; q < L->ipltKeys.count(); q++)
                        {
                            if (L->ipltKeys.at(q) == key)
                            {
                                GS = L->secs.at((usize)SEC_TEXT).addr +
                                     L->ipltOff + (u64)q * 12;
                                break;
                            }
                        }
                    }
                    i64 v = (i64)GS + A - (i64)P;
                    if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned jump26 target"); return false; }
                    if (!_a64ChkI(err, obj->name, t, P, v, 28)) { dealloc<u64>(addrs); return false; }
                    putU32(patch, 0x14000000u | (u32)(((u64)v >> 2) & 0x03FFFFFFu));
                }
                else if (t == R_AARCH64_CALL26)
                {
                    u64 GS = S;
                    if (L->ipltKeys.count() > 0)
                    {
                        u64 key = ((u64)o << 33) | (u64)r->sym;
                        for (usize q = 0; q < L->ipltKeys.count(); q++)
                        {
                            if (L->ipltKeys.at(q) == key)
                            {
                                GS = L->secs.at((usize)SEC_TEXT).addr +
                                     L->ipltOff + (u64)q * 12;
                                break;
                            }
                        }
                    }
                    i64 v = (i64)GS + A - (i64)P;
                    if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned call26 target"); return false; }
                    if (!_a64ChkI(err, obj->name, t, P, v, 28)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, (u32)(((u64)v & 0x0FFFFFFCu) >> 2), 0x03FFFFFFu);
                }
                else if (t == R_AARCH64_ADR_PREL_LO21)
                {
                    i64 v = (i64)S + A - (i64)P;
                    if (!_a64ChkI(err, obj->name, t, P, v, 21)) { dealloc<u64>(addrs); return false; }
                    _a64WAddr(patch, (u64)v);
                }
                else if (t == R_AARCH64_ADR_PREL_PG_HI21 || t == R_AARCH64_ADR_PREL_PG_HI21_NC)
                {
                    i64 v = (i64)(_a64Page(S + (u64)A) - _a64Page(P));
                    if (t != R_AARCH64_ADR_PREL_PG_HI21_NC &&
                        !_a64ChkI(err, obj->name, t, P, v, 33)) { dealloc<u64>(addrs); return false; }
                    _a64WAddr(patch, (u64)(v >> 12));
                }
                else if (t == R_AARCH64_MOVW_UABS_G0 || t == R_AARCH64_MOVW_UABS_G0_NC)
                {
                    u64 v = S + (u64)A;
                    if (t != R_AARCH64_MOVW_UABS_G0_NC &&
                        !_a64ChkU(err, obj->name, t, P, v & 0xFFFFu, 16)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, ((u32)(v & 0xFFFFu)) << 5, 0x001FFFE0u);
                }
                else if (t == R_AARCH64_MOVW_UABS_G1 || t == R_AARCH64_MOVW_UABS_G1_NC)
                {
                    u64 v = S + (u64)A;
                    if (t != R_AARCH64_MOVW_UABS_G1_NC &&
                        !_a64ChkU(err, obj->name, t, P, v >> 16, 16)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, ((u32)((v >> 16) & 0xFFFFu)) << 5, 0x001FFFE0u);
                }
                else if (t == R_AARCH64_MOVW_UABS_G2 || t == R_AARCH64_MOVW_UABS_G2_NC)
                {
                    u64 v = S + (u64)A;
                    if (t != R_AARCH64_MOVW_UABS_G2_NC &&
                        !_a64ChkU(err, obj->name, t, P, v >> 32, 16)) { dealloc<u64>(addrs); return false; }
                    _a64W32Masked(patch, ((u32)((v >> 32) & 0xFFFFu)) << 5, 0x001FFFE0u);
                }
                else if (t == R_AARCH64_MOVW_UABS_G3)
                {
                    u64 v = S + (u64)A;
                    _a64W32Masked(patch, ((u32)((v >> 48) & 0xFFFFu)) << 5, 0x001FFFE0u);
                }
                else if (t == R_AARCH64_TLSLE_MOVW_TPREL_G2 ||
                         t == R_AARCH64_TLSLE_MOVW_TPREL_G1 ||
                         t == R_AARCH64_TLSLE_MOVW_TPREL_G1_NC ||
                         t == R_AARCH64_TLSLE_MOVW_TPREL_G0 ||
                         t == R_AARCH64_TLSLE_MOVW_TPREL_G0_NC)
                {
                    /* local-exec TLS: tpoff = imageOff(sym) + A - tlsMemsz */
                    i64 tp = (i64)(S - L->tlsBase) + A - (i64)L->tlsMemsz;
                    u64 v = (u64)tp;
                    u32 sh = t == R_AARCH64_TLSLE_MOVW_TPREL_G0 ||
                             t == R_AARCH64_TLSLE_MOVW_TPREL_G0_NC ? 0 :
                             (t == R_AARCH64_TLSLE_MOVW_TPREL_G1 ||
                              t == R_AARCH64_TLSLE_MOVW_TPREL_G1_NC ? 16 : 32);
                    bool nc = t == R_AARCH64_TLSLE_MOVW_TPREL_G0_NC ||
                              t == R_AARCH64_TLSLE_MOVW_TPREL_G1_NC;
                    u64 piece = (v >> (u64)sh) & 0xFFFFu;
                    if (!nc && sh < 48 && piece != ((v >> (u64)(sh + 16)) & 0xFFFFu))
                    {
                        dealloc<u64>(addrs);
                        return _a64RangeErr(err, obj->name, t, P, 16, true);
                    }
                    _a64W32Masked(patch, ((u32)piece & 0xFFFFu) << 5, 0x001FFFE0u);
                }
                else if (t == R_AARCH64_TLSLE_ADD_TPREL_HI12 ||
                         t == R_AARCH64_TLSLE_ADD_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_ADD_TPREL_LO12_NC)
                {
                    i64 tp = (i64)(S - L->tlsBase) + A - (i64)L->tlsMemsz;
                    u64 v = (u64)tp;
                    u64 imm = t == R_AARCH64_TLSLE_ADD_TPREL_HI12 ?
                              (v >> 12) & 0xFFFu : v & 0xFFFu;
                    _a64WImm12(patch, imm);
                }
                else if (t == R_AARCH64_TLSLE_LDST8_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_LDST8_TPREL_LO12_NC ||
                         t == R_AARCH64_TLSLE_LDST16_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_LDST16_TPREL_LO12_NC ||
                         t == R_AARCH64_TLSLE_LDST32_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_LDST32_TPREL_LO12_NC ||
                         t == R_AARCH64_TLSLE_LDST64_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC ||
                         t == R_AARCH64_TLSLE_LDST128_TPREL_LO12 ||
                         t == R_AARCH64_TLSLE_LDST128_TPREL_LO12_NC)
                {
                    i64 tp = (i64)(S - L->tlsBase) + A - (i64)L->tlsMemsz;
                    u64 v = (u64)tp;
                    u32 sh = t == R_AARCH64_TLSLE_LDST8_TPREL_LO12 ||
                             t == R_AARCH64_TLSLE_LDST8_TPREL_LO12_NC ? 0 :
                             t == R_AARCH64_TLSLE_LDST16_TPREL_LO12 ||
                             t == R_AARCH64_TLSLE_LDST16_TPREL_LO12_NC ? 1 :
                             t == R_AARCH64_TLSLE_LDST32_TPREL_LO12 ||
                             t == R_AARCH64_TLSLE_LDST32_TPREL_LO12_NC ? 2 :
                             t == R_AARCH64_TLSLE_LDST64_TPREL_LO12 ||
                             t == R_AARCH64_TLSLE_LDST64_TPREL_LO12_NC ? 3 : 4;
                    _a64WImm12(patch, (v >> (u64)sh) & 0xFFFu);
                }
                else if (t == R_AARCH64_TLS_TPREL64)
                {
                    i64 tp = (i64)(S - L->tlsBase) + A - (i64)L->tlsMemsz;
                    putU64(patch, (u64)tp);
                }
                else if (t == R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21 ||
                         t == R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC ||
                         t == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19 ||
                         t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G1 ||
                         t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC ||
                         t == R_AARCH64_ADR_GOT_PAGE ||
                         t == R_AARCH64_LD64_GOT_LO12_NC ||
                         t == R_AARCH64_LD64_GOTPAGE_LO15 ||
                         t == R_AARCH64_GOT_LD_PREL19)
                {
                    /* GOT-slot referencing instruction: the operand is
                     * the slot address; slot content filled below */
                    u32 kind = (t == R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21 ||
                                t == R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC ||
                                t == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19 ||
                                t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G1 ||
                                t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC) ? 0 : 1;
                    u64 key = ((u64)o << 33) | ((u64)kind << 32) | (u64)r->sym;
                    usize slot = 0;
                    bool found = false;
                    for (usize q = 0; q < L->tlsGot.count(); q++)
                    {
                        if (L->tlsGot.at(q) == key) { slot = q; found = true; break; }
                    }
                    if (!found)
                    {
                        dealloc<u64>(addrs);
                        return _supErr(err, obj->name, t);
                    }
                    OutSec* gs = L->secs.atPtr((usize)SEC_GOT);
                    u64 slotAddr = gs->addr + (u64)slot * 8;
                    /* fill the slot: kind 0 = tpoff, kind 1 = S + A */
                    usize slotOff = (usize)(gs->offset + (u64)slot * 8);
                    if (fits(slotOff, 8, imgLen))
                    {
                        if (kind == 0)
                        {
                            i64 tp = (i64)(S - L->tlsBase) + A - (i64)L->tlsMemsz;
                            putU64(img + slotOff, (u64)tp);
                        }
                        else
                            putU64(img + slotOff, S + (u64)A);
                    }
                    if (t == R_AARCH64_TLSIE_ADR_GOTTPREL_PAGE21 ||
                        t == R_AARCH64_ADR_GOT_PAGE)
                    {
                        i64 v = (i64)(_a64Page(slotAddr) - _a64Page(P));
                        if (!_a64ChkI(err, obj->name, t, P, v, 33)) { dealloc<u64>(addrs); return false; }
                        _a64WAddr(patch, (u64)(v >> 12));
                    }
                    else if (t == R_AARCH64_TLSIE_LD64_GOTTPREL_LO12_NC ||
                             t == R_AARCH64_LD64_GOT_LO12_NC)
                    {
                        _a64WImm12(patch, ((slotAddr & 0xFFFu) >> 3));
                    }
                    else if (t == R_AARCH64_TLSIE_LD_GOTTPREL_PREL19 ||
                             t == R_AARCH64_GOT_LD_PREL19)
                    {
                        i64 v = (i64)slotAddr - (i64)P;
                        if (v & 3) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned got-prel19 target"); return false; }
                        if (!_a64ChkI(err, obj->name, t, P, v, 21)) { dealloc<u64>(addrs); return false; }
                        _a64W32Masked(patch, (u32)(((u64)v & 0x1FFFFCu) << 3), 0x00FFFFE0u);
                    }
                    else if (t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G1 ||
                             t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G0_NC)
                    {
                        u64 v = slotAddr;
                        u32 sh = t == R_AARCH64_TLSIE_MOVW_GOTTPREL_G1 ? 16 : 0;
                        _a64W32Masked(patch, ((u32)((v >> (u64)sh) & 0xFFFFu)) << 5, 0x001FFFE0u);
                    }
                    else if (t == R_AARCH64_LD64_GOTPAGE_LO15)
                    {
                        /* ldur-style: imm9 at bits 20:12, scaled by 8 */
                        i64 v = (i64)(slotAddr & 0xFFFu);
                        if (v & 7) { dealloc<u64>(addrs); _relErrBase(err, obj->name); err->pushView(": misaligned gotpage target"); return false; }
                        _a64W32Masked(patch, ((u32)((u64)v >> 3) & 0x1FFu) << 12, 0x000FFFE0u);
                    }
                    continue;
                }
                else if (t == R_AARCH64_MOVW_GOTOFF_G0 ||
                         t == R_AARCH64_MOVW_GOTOFF_G0_NC ||
                         t == R_AARCH64_MOVW_GOTOFF_G1 ||
                         t == R_AARCH64_MOVW_GOTOFF_G1_NC ||
                         t == R_AARCH64_MOVW_GOTOFF_G2 ||
                         t == R_AARCH64_MOVW_GOTOFF_G2_NC ||
                         t == R_AARCH64_MOVW_GOTOFF_G3 ||
                         t == R_AARCH64_GOTREL32 ||
                         t == R_AARCH64_GOTREL64)
                {
                    /* GOT-relative offset: value = slotAddr - gotBase
                     * where gotBase = _GLOBAL_OFFSET_TABLE_ = .got start */
                    u64 key = ((u64)o << 33) | (1ull << 32) | (u64)r->sym;
                    usize slot = 0;
                    bool found = false;
                    for (usize q = 0; q < L->tlsGot.count(); q++)
                    {
                        if (L->tlsGot.at(q) == key) { slot = q; found = true; break; }
                    }
                    if (!found)
                    {
                        dealloc<u64>(addrs);
                        return _supErr(err, obj->name, t);
                    }
                    OutSec* gs = L->secs.atPtr((usize)SEC_GOT);
                    u64 off = (u64)slot * 8;
                    usize slotOff = (usize)(gs->offset + (u64)slot * 8);
                    if (fits(slotOff, 8, imgLen))
                        putU64(img + slotOff, S + (u64)A);
                    if (t == R_AARCH64_GOTREL64)
                    {
                        putU64(patch, off);
                        continue;
                    }
                    if (t == R_AARCH64_GOTREL32)
                    {
                        putU32(patch, (u32)off);
                        continue;
                    }
                    u32 sh = t == R_AARCH64_MOVW_GOTOFF_G0 ||
                             t == R_AARCH64_MOVW_GOTOFF_G0_NC ? 0 :
                             t == R_AARCH64_MOVW_GOTOFF_G1 ||
                             t == R_AARCH64_MOVW_GOTOFF_G1_NC ? 16 :
                             t == R_AARCH64_MOVW_GOTOFF_G2 ||
                             t == R_AARCH64_MOVW_GOTOFF_G2_NC ? 32 : 48;
                    _a64W32Masked(patch, ((u32)((off >> (u64)sh) & 0xFFFFu)) << 5, 0x001FFFE0u);
                    continue;
                }
                else if (t == R_AARCH64_COPY || t == R_AARCH64_GLOB_DAT ||
                         t == R_AARCH64_JUMP_SLOT || t == R_AARCH64_RELATIVE ||
                         t == R_AARCH64_TLS_DTPMOD64 || t == R_AARCH64_TLS_DTPREL64)
                {
                    dealloc<u64>(addrs);
                    return _dynErr(err, obj->name, t);
                }
                else
                {
                    dealloc<u64>(addrs);
                    return _supErr(err, obj->name, t);
                }
            }
        }
        dealloc<u64>(addrs);
        gotSyms.dispose();
    }
    return true;
}
