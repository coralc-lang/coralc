#[[no_drop_all]]
/* machoemit.crl — Mach-O arm64 executable/dylib output.
 * Emits MH_EXECUTE / MH_DYLIB (64-bit, CPU_TYPE_ARM64) from the
 * format-neutral Layout: __PAGEZERO, __TEXT, __DATA (when needed),
 * __LINKEDIT and __DWARF segments built from the canonical output
 * sections, plus LC_SYMTAB, LC_DYSYMTAB, LC_MAIN, LC_UUID and
 * LC_VERSION_MIN_MACOSX. The header size must agree exactly with
 * machoHeaderSize() in layout.crl.
 */

import std::vec { Vec };
import std::string { String };
import std::mman { alloc, dealloc, copy };
use muvm::linker::arm64::macho {
    MH_MAGIC_64, MH_EXECUTE, MH_DYLIB, CPU_TYPE_ARM64, CPU_SUBTYPE_ARM64_ALL,
    LC_SEGMENT_64, LC_SYMTAB, LC_DYSYMTAB, LC_MAIN, LC_UUID, LC_ID_DYLIB,
    LC_VERSION_MIN_MACOSX, LC_DYLD_EXPORTS_TRIE,
    S_REGULAR, S_ZEROFILL, S_ATTR_PURE_INSTRUCTIONS,
    S_ATTR_SOME_INSTRUCTIONS, S_ATTR_DEBUG
};
use muvm::linker::arm64::elf {
    SHT_NOBITS, SHF_EXECINSTR, SHF_ALLOC, SHN_UNDEF, SHN_ABS, OUT_NONE,
    STB_LOCAL, STB_WEAK, EM_AARCH64, fits, putU16, putU32, putU64, alignUp
};
use muvm::linker::arm64::object { ObjFile, Section, Reloc, Sym };
use muvm::linker::arm64::resolve { GlobalDef, findDef };
use muvm::linker::arm64::layout {
    Layout, OutSec, Piece, defAddress, machoHeaderSize, pieceOffset,
    SEC_BSS, SEC_DATA, SEC_GOT, SEC_INIT, SEC_TEXT, SEC_ALLOC_COUNT
};

void _mName(u8* p, str name)
{
    /* sectname/segname: 16 bytes NUL-padded. Canonical linker names
     * start with '.', Mach-O convention is '__' + name. */
    for (usize i = 0; i < 16; i++) p[i] = 0;
    bool prefixed = name.len >= 2 && name.ptr[0] == '_' && name.ptr[1] == '_';
    usize dst = 0;
    if (!prefixed)
    {
        p[0] = '_'; p[1] = '_';
        dst = 2;
    }
    usize i0 = (name.len > 0 && name.ptr[0] == '.') ? 1 : 0;
    usize i = 0;
    while (i0 + i < name.len && dst < 16)
    {
        p[dst] = name.ptr[i0 + i];
        dst++;
        i++;
    }
}

u32 _mLog2Align(u64 a)
{
    u32 r = 0;
    while (a > 1 && r < 15) { a >>= 1; r++; }
    return r;
}

u32 _mSecFlags(OutSec* s, bool dwarf)
{
    u32 f = S_REGULAR;
    if (s->type == SHT_NOBITS) f = S_ZEROFILL;
    if (dwarf) f |= S_ATTR_DEBUG;
    else if ((s->flags & SHF_EXECINSTR) != 0)
        f |= S_ATTR_PURE_INSTRUCTIONS | S_ATTR_SOME_INSTRUCTIONS;
    return f;
}

/* OutSec indices of emitted sections, in load-command order, tagged
 * by segment: 0=__TEXT, 1=__DATA, 2=__DWARF */
void _mSections(Layout* L, Vec<usize>* ord, Vec<u8>* segs)
{
    for (usize i = 0; i < L->secs.count(); i++)
    {
        OutSec* s = L->secs.atPtr(i);
        if (s->size == 0) continue;
        u8 sg;
        if (i < SEC_INIT) sg = 0;        /* SEC_HOT..SEC_FINICODE */
        else if (i < SEC_ALLOC_COUNT) sg = 1; /* SEC_INIT..SEC_BSS */
        else sg = 2;                     /* debug passthrough */
        ord->push(i);
        segs->push(sg);
    }
}

usize _segCount(Vec<u8>* segs, u8 want)
{
    usize n = 0;
    for (usize i = 0; i < segs->count(); i++)
        if (segs->at(i) == want) n++;
    return n;
}

void _wSeg64(u8* p, str segname, u64 vmaddr, u64 vmsize, u64 fileoff,
             u64 filesize, u32 maxprot, u32 initprot, u32 nsects)
{
    putU32(p, LC_SEGMENT_64);
    putU32(p + 4, (u32)(72 + 80 * (usize)nsects));
    _mName(p + 8, segname);
    putU64(p + 24, vmaddr);
    putU64(p + 32, vmsize);
    putU64(p + 40, fileoff);
    putU64(p + 48, filesize);
    putU32(p + 56, maxprot);
    putU32(p + 60, initprot);
    putU32(p + 64, nsects);
    putU32(p + 68, 0);
}

/* writes the section_64 records belonging to segment `want`, returns
 * the position past them */
usize _wSections(u8* img, usize pos, Layout* L, Vec<usize>* ord,
                 Vec<u8>* segs, str segName, u8 want)
{
    for (usize i = 0; i < ord->count(); i++)
    {
        if (segs->at(i) != want) continue;
        OutSec* s = L->secs.atPtr(ord->at(i));
        bool dwarf = want == 2;
        u8* p = img + pos;
        _mName(p, s->name);
        _mName(p + 16, segName);
        /* non-alloc sections have addr 0 in the layout; give them the
         * vmaddr they would occupy so addr >= segment vmaddr */
        u64 saddr = s->addr != 0 ? s->addr : L->imageBase + s->offset;
        putU64(p + 32, saddr);
        putU64(p + 40, s->size);
        if (s->type == SHT_NOBITS)
            putU32(p + 48, 0);
        else
            putU32(p + 48, (u32)s->offset);
        putU32(p + 52, _mLog2Align(s->align));
        putU32(p + 56, 0);
        putU32(p + 60, 0);
        putU32(p + 64, _mSecFlags(s, dwarf));
        putU32(p + 68, 0);
        putU32(p + 72, 0);
        putU32(p + 76, 0);
        pos += 80;
    }
    return pos;
}

// ------------------------------------------------------------------
// export trie (LC_DYLD_EXPORTS_TRIE / dyld export format)
// ------------------------------------------------------------------
struct MExpNode { u64 addr; bool hasTerm; i32 head; i32 tail; }
struct MExpEdge { str label; i32 child; i32 next; }
struct MReb { u8 seg; u64 off; }

void _mUleb(Vec<u8>* v, u64 x)
{
    while (x >= 0x80) { v->push((u8)((x & 0x7F) | 0x80)); x >>= 7; }
    v->push((u8)x);
}

u32 _mUlebLen(u64 x)
{
    u32 n = 1;
    while (x >= 0x80) { n++; x >>= 7; }
    return n;
}

// build compressed trie over sorted names[lo..hi) sharing consumed
// prefix of `dep` bytes; returns node index (nodes/edges grow)
i32 _mExpBuild(Vec<MExpNode>* nodes, Vec<MExpEdge>* edges,
               Vec<str>* names, Vec<u64>* offs, usize lo, usize hi, usize dep)
{
    i32 ni = (i32)nodes->count();
    MExpNode nd;
    nd.addr = 0;
    nd.hasTerm = false;
    nd.head = -1;
    nd.tail = -1;
    nodes->push(nd);
    // terminal: the name equal to the consumed prefix sorts first
    if (lo < hi)
    {
        str nm = names->at(lo);
        if (dep == nm.len)
        {
            nodes->atPtr((usize)ni)->hasTerm = true;
            nodes->atPtr((usize)ni)->addr = offs->at(lo);
        }
    }
    usize i = lo;
    while (i < hi)
    {
        str nm = names->at(i);
        if (dep >= nm.len) { i++; continue; }
        u8 b = nm.ptr[dep];
        usize j = i + 1;
        while (j < hi)
        {
            str nm2 = names->at(j);
            if (dep < nm2.len && nm2.ptr[dep] == b) j++;
            else break;
        }
        // longest common prefix of the group's remaining suffixes
        usize lcp = nm.len - dep;
        for (usize k = i + 1; k < j; k++)
        {
            str nk = names->at(k);
            usize m = nk.len - dep < lcp ? nk.len - dep : lcp;
            usize p = 0;
            while (p < m && nm.ptr[dep + p] == nk.ptr[dep + p]) p++;
            if (p < lcp) lcp = p;
        }
        if (lcp == 0) lcp = 1;
        str lbl = str { (const u8*)(nm.ptr + dep), lcp };
        i32 child = _mExpBuild(nodes, edges, names, offs, i, j, dep + lcp);
        MExpEdge e;
        e.label = lbl;
        e.child = child;
        e.next = -1;
        edges->push(e);
        i32 ei = (i32)edges->count() - 1;
        i32 tail = nodes->atPtr((usize)ni)->tail;
        if (tail >= 0) edges->atPtr((usize)tail)->next = ei;
        else nodes->atPtr((usize)ni)->head = ei;
        nodes->atPtr((usize)ni)->tail = ei;
        i = j;
    }
    return ni;
}

// serialized size of a node's own region (header+terminal+edges);
// child offsets come from `offs` (previous fixpoint iteration)
u64 _mExpNodeSize(Vec<MExpNode>* nodes, Vec<MExpEdge>* edges, i32 ni, Vec<usize>* offs)
{
    MExpNode* nd = nodes->atPtr((usize)ni);
    u64 termSz = nd->hasTerm ? 1 + (u64)_mUlebLen(nd->addr) : 0;
    u64 sz = (u64)_mUlebLen(termSz) + termSz + 1;
    for (i32 e = nd->head; e >= 0; e = edges->atPtr((usize)e)->next)
    {
        MExpEdge* ed = edges->atPtr((usize)e);
        sz += (u64)ed->label.len + 1 + (u64)_mUlebLen((u64)offs->at((usize)ed->child));
    }
    return sz;
}

void _mExpLayout(Vec<MExpNode>* nodes, Vec<MExpEdge>* edges, i32 ni,
                 Vec<usize>* offs, usize* pos)
{
    *offs->atPtr((usize)ni) = *pos;
    *pos += (usize)_mExpNodeSize(nodes, edges, ni, offs);
    MExpNode* nd = nodes->atPtr((usize)ni);
    for (i32 e = nd->head; e >= 0; e = edges->atPtr((usize)e)->next)
        _mExpLayout(nodes, edges, edges->atPtr((usize)e)->child, offs, pos);
}

// assign node offsets; edge-offset uleb sizes depend on offsets, so
// iterate the layout until the offsets stop changing (they only grow,
// so this converges in a few passes)
void _mExpOffsets(Vec<MExpNode>* nodes, Vec<MExpEdge>* edges, Vec<usize>* offs)
{
    usize nn = nodes->count();
    Vec<usize> prev = Vec<usize>::new();
    for (usize i = 0; i < nn; i++) { offs->push(0); prev.push(0); }
    for (u32 iter = 0; iter < 12; iter++)
    {
        for (usize i = 0; i < nn; i++) *prev.atPtr(i) = *offs->atPtr(i);
        usize pos = 0;
        _mExpLayout(nodes, edges, 0, offs, &pos);
        bool same = true;
        for (usize i = 0; i < nn; i++)
            if (offs->at(i) != prev.at(i)) { same = false; break; }
        if (same) break;
    }
    prev.dispose();
}

void _mExpEmit(Vec<u8>* out, Vec<MExpNode>* nodes, Vec<MExpEdge>* edges,
               Vec<usize>* offs, i32 ni)
{
    MExpNode* nd = nodes->atPtr((usize)ni);
    u64 termSz = nd->hasTerm ? 1 + (u64)_mUlebLen(nd->addr) : 0;
    u32 nchild = 0;
    for (i32 e = nd->head; e >= 0; e = edges->atPtr((usize)e)->next) nchild++;
    _mUleb(out, termSz);
    if (nd->hasTerm)
    {
        out->push(0); /* EXPORT_SYMBOL_FLAGS */
        _mUleb(out, nd->addr);
    }
    out->push((u8)nchild);
    for (i32 e = nd->head; e >= 0; e = edges->atPtr((usize)e)->next)
    {
        MExpEdge* ed = edges->atPtr((usize)e);
        for (usize k = 0; k < ed->label.len; k++) out->push(ed->label.ptr[k]);
        out->push(0);
        _mUleb(out, (u64)offs->at((usize)ed->child));
    }
    for (i32 e = nd->head; e >= 0; e = edges->atPtr((usize)e)->next)
        _mExpEmit(out, nodes, edges, offs, edges->atPtr((usize)e)->child);
}

// build the whole trie into `out`; names must be sorted, addrs are
// offsets from the image base (mach_header vmaddr)
void _mExpTrie(Vec<u8>* out, Vec<str>* names, Vec<u64>* addrs)
{
    Vec<MExpNode> nodes = Vec<MExpNode>::new();
    Vec<MExpEdge> edges = Vec<MExpEdge>::new();
    _mExpBuild(&nodes, &edges, names, addrs, 0, names->count(), 0);
    Vec<usize> offs = Vec<usize>::new();
    for (usize i = 0; i < nodes.count(); i++) offs.push(0);
    _mExpOffsets(&nodes, &edges, &offs);
    _mExpEmit(out, &nodes, &edges, &offs, 0);
    offs.dispose();
    edges.dispose();
    nodes.dispose();
}

pub bool emitMachOImage(bool isDll, str installName, Vec<ObjFile>* objs, Vec<GlobalDef>* defs,
                        Layout* L, Vec<str>* exports, u8** outImg, usize* outLen, String* err)
{
    u64 base = L->imageBase;
    bool needRW = L->hasRW;

    Vec<usize> ord = Vec<usize>::new();
    Vec<u8> segs = Vec<u8>::new();
    _mSections(L, &ord, &segs);

    u64 dbgStart = 0;
    u64 dbgEnd = 0;
    for (usize i = 0; i < L->secs.count(); i++)
    {
        if (i >= SEC_ALLOC_COUNT && L->secs.at(i).size > 0)
        {
            if (dbgStart == 0) dbgStart = L->secs.at(i).offset;
            dbgEnd = L->secs.at(i).offset + L->secs.at(i).size;
        }
    }
    u64 contentEnd = dbgEnd > 0 ? dbgEnd : L->fileEnd;
    u64 linkOff = alignUp(contentEnd, 8);

    usize nDef = 0;
    usize nUndef = 0;
    for (usize d = 0; d < defs->count(); d++)
    {
        GlobalDef* def = defs->atPtr(d);
        if (def->isImport || def->shndx == SHN_UNDEF) nUndef++;
        else nDef++;
    }
    usize nSyms = 1 + nDef + nUndef;
    u64 strSize = 1;
    /* strtab holds names in symtab order: defined first, then undef */
    for (i32 pass = 0; pass < 2; pass++)
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            bool undef = def->isImport || def->shndx == SHN_UNDEF;
            if ((i32)(undef ? 1 : 0) == pass) strSize += (u64)def->name.len + 1;
        }

    /* export trie for dylibs: names arrive sorted; resolve each to a
     * defined global's offset from the image base */
    Vec<u8> trie = Vec<u8>::new();
    if (isDll && exports != null && exports->count() > 0)
    {
        Vec<str> names = Vec<str>::new();
        Vec<u64> offs = Vec<u64>::new();
        for (usize i = 0; i < exports->count(); i++)
        {
            str nm = exports->at(i);
            u64 val = 0;
            bool found = false;
            for (usize d = 0; d < defs->count(); d++)
            {
                GlobalDef* def = defs->atPtr(d);
                if (def->isImport || def->shndx == SHN_UNDEF) continue;
                if (!def->name.equals(nm)) continue;
                if (!defAddress(objs, L, def, &val, err))
                {
                    names.dispose();
                    offs.dispose();
                    trie.dispose();
                    return false;
                }
                found = true;
                break;
            }
            if (!found) continue;
            names.push(nm);
            offs.push(val >= base ? val - base : val);
        }
        if (names.count() > 0) _mExpTrie(&trie, &names, &offs);
        names.dispose();
        offs.dispose();
    }

    /* bind stream (LC_DYLD_INFO_ONLY): one entry per imported def —
     * SET_SYMBOL_NAME, SET_TYPE=pointer, SET_DYLIB_SPECIAL=flat-lookup,
     * SET_SEGMENT_AND_OFFSET_ULEB (__DATA), DO_BIND. Non-lazy: every
     * import lives in __got and is bound at load. */
    Vec<u8> bind = Vec<u8>::new();
    if (L->machoGot.count() > 0)
    {
        u64 dataVm = base + L->rwOff;
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            if (!def->isImport || def->impIdx >= 0) continue;
            if (d >= L->machoGot.count() || L->machoGot.at(d) < 0) continue;
            u64 slotOff = def->value > dataVm ? def->value - dataVm : 0;
            bind.push(0x40); /* SET_SYMBOL_NAME */
            for (usize i = 0; i < def->name.len; i++) bind.push(def->name.ptr[i]);
            bind.push(0);
            bind.push(0x51); /* SET_TYPE_IMM pointer */
            bind.push(0x3e); /* SET_DYLIB_SPECIAL_IMM flat-lookup (-2) */
            bind.push((u8)(0x70 | (isDll ? 1 : 2))); /* __DATA seg idx */
            _mUleb(&bind, slotOff);
            bind.push(0x90); /* DO_BIND */
        }
    }

    /* rebase locations: every absolute pointer stored in the image —
     * UNSIGNED 64-bit relocs in alloc sections plus defined-symbol
     * __got slots. Recorded as (segment index, offset in segment);
     * dyld adds the slide at load. */
    Vec<MReb> reb = Vec<MReb>::new();
    Vec<MReb> bloc = Vec<MReb>::new();
    Vec<str> blocName = Vec<str>::new();
    {
        u64 dataSegVm = base + L->rwOff;
        for (usize o = 0; o < objs->count(); o++)
        {
            ObjFile* obj = objs->atPtr(o);
            for (usize si = 0; si < obj->secs.count(); si++)
            {
                Section* in = obj->secs.atPtr(si);
                if (in->outIdx == OUT_NONE) continue;
                OutSec* out = L->secs.atPtr((usize)in->outIdx);
                if ((out->flags & SHF_ALLOC) == 0) continue;
                u8 sg;
                if ((usize)in->outIdx < SEC_INIT) sg = 0;
                else if ((usize)in->outIdx < SEC_ALLOC_COUNT) sg = 1;
                else continue;
                u64 segVm = sg == 0 ? base : dataSegVm;
                u64 secOff = pieceOffset(L, (usize)in->outIdx, o, si);
                Vec<Reloc>* bucket = obj->rels.atPtr(si);
                for (usize k = 0; k < bucket->count(); k++)
                {
                    Reloc* r = bucket->atPtr(k);
                    if (r->fmt != 2) continue;
                    u32 mt = r->type - 1000;
                    u32 mrt = mt >> 4;
                    u32 mrlen = mt & 7;
                    if (mrt != 0 || mrlen != 3) continue;
                    u64 loc = out->addr + secOff + r->offset;
                    if (loc < segVm) continue;
                    u64 locOff = loc - segVm;
                    /* imported symbol: this location is pointer-bound by
                     * dyld (BIND_OPCODE pointer at the slot itself) */
                    Sym* rs = obj->syms.atPtr((usize)r->sym);
                    if (rs->bind != STB_LOCAL)
                    {
                        i64 di = findDef(defs, rs->name);
                        if (di >= 0 && defs->atPtr((usize)di)->isImport)
                        {
                            MReb e;
                            e.seg = sg;
                            e.off = locOff;
                            bloc.push(e);
                            blocName.push(rs->name);
                            continue;
                        }
                    }
                    if (rs->shndx == SHN_ABS) continue;
                    if (rs->bind != STB_LOCAL)
                    {
                        i64 di = findDef(defs, rs->name);
                        if (di >= 0)
                        {
                            GlobalDef* df = defs->atPtr((usize)di);
                            if (df->isImport || df->shndx == SHN_ABS) continue;
                        }
                    }
                    MReb e;
                    e.seg = sg;
                    e.off = locOff;
                    reb.push(e);
                }
            }
        }
        /* defined __got slots hold symbol vmaddrs → rebase each */
        if (L->gotSize > 0 && L->secs.count() > SEC_DATA)
        {
            usize nDef = L->machoGotImpOff > 0
                ? (usize)((L->machoGotImpOff - L->gotOff) / 8)
                : (usize)(L->gotSize / 8);
            OutSec* rw = L->secs.atPtr((usize)SEC_DATA);
            for (usize gi = 0; gi < nDef; gi++)
            {
                u64 slot = rw->addr + L->gotOff + (u64)gi * 8;
                if (slot < dataSegVm) continue;
                MReb e;
                e.seg = 1;
                e.off = slot - dataSegVm;
                reb.push(e);
            }
        }
    }
    /* pointer binds for .quad-style references to imports */
    for (usize i = 0; i < bloc.count(); i++)
    {
        str nm = blocName.at(i);
        bind.push(0x40);
        for (usize k = 0; k < nm.len; k++) bind.push(nm.ptr[k]);
        bind.push(0);
        bind.push(0x51); /* pointer */
        bind.push(0x3e); /* flat-lookup */
        bind.push((u8)(0x70 | bloc.at(i).seg));
        _mUleb(&bind, bloc.at(i).off);
        bind.push(0x90); /* DO_BIND */
    }
    bind.push(0); /* DONE */
    bloc.dispose();
    blocName.dispose();

    /* sort by (seg, off) for run grouping */
    for (usize i = 1; i < reb.count(); i++)
    {
        MReb v = reb.at(i);
        usize j = i;
        while (j > 0)
        {
            MReb p = reb.at(j - 1);
            if (p.seg < v.seg || (p.seg == v.seg && p.off <= v.off)) break;
            *reb.atPtr(j) = p;
            j--;
        }
        *reb.atPtr(j) = v;
    }

    /* encode the rebase stream */
    Vec<u8> rebase = Vec<u8>::new();
    if (reb.count() > 0)
    {
        rebase.push(0x11); /* SET_TYPE_IMM pointer */
        usize i = 0;
        while (i < reb.count())
        {
            u8 seg = reb.at(i).seg;
            u64 off = reb.at(i).off;
            usize j = i + 1;
            while (j < reb.count() && reb.at(j).seg == seg &&
                   reb.at(j).off == off + (u64)(j - i) * 8) j++;
            u64 n = (u64)(j - i);
            rebase.push((u8)(0x20 | seg));
            _mUleb(&rebase, off);
            if (n <= 15) rebase.push((u8)(0x50 | (u8)n));
            else { rebase.push(0x60); _mUleb(&rebase, n); }
            i = j;
        }
        rebase.push(0); /* DONE */
    }
    reb.dispose();

    u64 symOff = linkOff;
    u64 strOff = symOff + (u64)nSyms * 16;
    u64 rebaseOff = strOff + strSize;
    u64 bindOff = rebaseOff + (u64)rebase.count();
    u64 trieOff = bindOff + (u64)bind.count();
    u64 linkSize = (u64)nSyms * 16 + strSize + (u64)rebase.count() +
                   (u64)bind.count() + (u64)trie.count();
    u64 fileSize = linkOff + linkSize;
    if (fileSize > 0xffffffffu)
    {
        err->pushView("linker: Mach-O output exceeds 4 GiB");
        return false;
    }

    u64 nameLen = isDll ? (installName.len > 0 ? installName.len : 14) : 0;
    u64 hdrSize = machoHeaderSize(L, needRW, nameLen, true);

    u8* img = alloc<u8>((usize)fileSize);
    if (img == null) { err->pushView("linker: out of memory"); return false; }
    for (usize i = 0; i < (usize)fileSize; i++) img[i] = 0;

    putU32(img, MH_MAGIC_64);
    putU32(img + 4, CPU_TYPE_ARM64);
    putU32(img + 8, CPU_SUBTYPE_ARM64_ALL);
    putU32(img + 12, isDll ? MH_DYLIB : MH_EXECUTE);
    u32 ncmds = 8 + (needRW ? 1 : 0) + (dbgEnd > 0 ? 1 : 0) +
                (isDll ? 0 : 1);
    putU32(img + 16, ncmds);
    putU32(img + 20, (u32)(hdrSize - 32));
    putU32(img + 24, isDll ? 0u : 0x200000u); /* MH_PIE */
    putU32(img + 28, 0);

    usize cmdPos = 32;
    /* dylibs conventionally omit __PAGEZERO (ld64 does); this keeps
     * bind-stream segment indices aligned with ld64 output */
    if (!isDll)
    {
        _wSeg64(img + cmdPos, "__PAGEZERO", 0, 0x100000000ULL, 0, 0, 0, 0, 0);
        cmdPos += 72;
    }
    {
        u64 vmsz = alignUp(L->rxEnd, 0x4000);
        if (vmsz < 0x4000) vmsz = 0x4000;
        _wSeg64(img + cmdPos, "__TEXT", base, vmsz, 0, L->rxEnd, 5, 5,
                (u32)_segCount(&segs, 0));
        cmdPos += 72;
        cmdPos = _wSections(img, cmdPos, L, &ord, &segs, "__TEXT", 0);
    }
    if (needRW)
    {
        _wSeg64(img + cmdPos, "__DATA", base + L->rwOff, L->rwMemsz,
                L->rwOff, L->rwFilesz, 3, 3, (u32)_segCount(&segs, 1));
        cmdPos += 72;
        cmdPos = _wSections(img, cmdPos, L, &ord, &segs, "__DATA", 1);
    }
    _wSeg64(img + cmdPos, "__LINKEDIT", base + linkOff, linkSize,
            linkOff, linkSize, 1, 1, 0);
    cmdPos += 72;
    if (dbgEnd > 0)
    {
        _wSeg64(img + cmdPos, "__DWARF", base + dbgStart, dbgEnd - dbgStart,
                dbgStart, dbgEnd - dbgStart, 1, 1, (u32)_segCount(&segs, 2));
        cmdPos += 72;
        cmdPos = _wSections(img, cmdPos, L, &ord, &segs, "__DWARF", 2);
    }

    /* LC_SYMTAB */
    putU32(img + cmdPos, LC_SYMTAB);
    putU32(img + cmdPos + 4, 24);
    putU32(img + cmdPos + 8, (u32)symOff);
    putU32(img + cmdPos + 12, (u32)nSyms);
    putU32(img + cmdPos + 16, (u32)strOff);
    putU32(img + cmdPos + 20, (u32)strSize);
    cmdPos += 24;

    /* LC_DYSYMTAB: null sym, then defined, then undefined */
    putU32(img + cmdPos, LC_DYSYMTAB);
    putU32(img + cmdPos + 4, 80);
    putU32(img + cmdPos + 8, 0);            /* ilocalsym */
    putU32(img + cmdPos + 12, 0);           /* nlocalsym */
    putU32(img + cmdPos + 16, 1);           /* iextdefsym */
    putU32(img + cmdPos + 20, (u32)nDef);   /* nextdefsym */
    putU32(img + cmdPos + 24, (u32)(1 + nDef)); /* iundefsym */
    putU32(img + cmdPos + 28, (u32)nUndef); /* nundefsym */
    cmdPos += 80;

    if (isDll)
    {
        /* LC_ID_DYLIB: dylib_command — name offset 24, then the
         * install name padded to 8 */
        putU32(img + cmdPos, LC_ID_DYLIB);
        u64 idLen = 24 + ((nameLen + 1 + 7) & ~7ULL);
        putU32(img + cmdPos + 4, (u32)idLen);
        putU32(img + cmdPos + 8, 24);
        putU32(img + cmdPos + 12, 0);
        str nm = installName.len > 0 ? installName : "libmuvm.dylib";
        for (usize i = 0; i < nm.len && i < nameLen; i++)
            img[cmdPos + 24 + i] = nm.ptr[i];
        cmdPos += idLen;
    }
    else
    {
        putU32(img + cmdPos, LC_MAIN);
        putU32(img + cmdPos + 4, 24);
        putU64(img + cmdPos + 8, L->entry >= base ? L->entry - base : 0);
        putU64(img + cmdPos + 16, 0);
        cmdPos += 24;
    }
    putU32(img + cmdPos, LC_UUID);
    putU32(img + cmdPos + 4, 24);
    {
        u8[16] uu;
        uu[0] = 0x6D; uu[1] = 0x75; uu[2] = 0x76; uu[3] = 0x6D;
        uu[4] = 0x2D; uu[5] = 0x61; uu[6] = 0x72; uu[7] = 0x6D;
        uu[8] = 0x36; uu[9] = 0x34;
        for (usize i = 10; i < 16; i++) uu[i] = 0;
        for (usize i = 0; i < 16; i++) img[cmdPos + 8 + i] = uu[i];
    }
    cmdPos += 24;
    putU32(img + cmdPos, LC_VERSION_MIN_MACOSX);
    putU32(img + cmdPos + 4, 16);
    putU32(img + cmdPos + 8, 0x000B0000u);
    putU32(img + cmdPos + 12, 0x000C0000u);
    cmdPos += 16;

    /* LC_DYLD_INFO_ONLY: rebase/bind/weak/lazy/export (off,size) pairs.
     * Only bind and export are used; rebase is empty (no dyld fixups
     * emitted for defined data yet), lazy is unused (non-lazy binds). */
    putU32(img + cmdPos, 0x80000022);
    putU32(img + cmdPos + 4, 48);
    putU32(img + cmdPos + 8, (u32)rebaseOff); /* rebase off */
    putU32(img + cmdPos + 12, (u32)rebase.count());
    putU32(img + cmdPos + 16, (u32)bindOff); /* bind off */
    putU32(img + cmdPos + 20, (u32)bind.count());
    putU32(img + cmdPos + 24, 0);            /* weak bind off */
    putU32(img + cmdPos + 28, 0);            /* weak bind size */
    putU32(img + cmdPos + 32, 0);            /* lazy bind off */
    putU32(img + cmdPos + 36, 0);            /* lazy bind size */
    putU32(img + cmdPos + 40, (u32)trieOff); /* export trie off */
    putU32(img + cmdPos + 44, (u32)trie.count());
    cmdPos += 48;

    /* copy section contents */
    for (usize i = 0; i < L->secs.count(); i++)
    {
        OutSec* out = L->secs.atPtr(i);
        if (out->type == SHT_NOBITS || out->size == 0) continue;
        for (usize j = 0; j < out->pieces.count(); j++)
        {
            Piece* p = out->pieces.atPtr(j);
            ObjFile* obj = objs->atPtr(p->objIdx);
            Section* in = obj->secs.atPtr(p->secIdx);
            copy<u8>(img + (usize)out->offset + (usize)p->offset,
                     (u8*)obj->data.ptr + (usize)in->offset, (usize)p->size);
        }
    }

    /* symtab: OutSec index -> 1-based Mach-O section ordinal */
    Vec<u32> sectNo = Vec<u32>::new();
    for (usize i = 0; i < L->secs.count(); i++) sectNo.push(0);
    {
        u32 no = 1;
        for (usize i = 0; i < ord.count(); i++)
        {
            *sectNo.atPtr(ord.at(i)) = no;
            no++;
        }
    }

    usize idx = 1;
    u64 stroff = 1;
    for (i32 pass = 0; pass < 2; pass++)
    {
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            bool undef = def->isImport || def->shndx == SHN_UNDEF;
            if ((i32)(undef ? 1 : 0) != pass) continue;
            u64 value = 0;
            u8 ntype = 0x01; /* N_UNDF | N_EXT */
            u8 nsect = 0;
            u16 ndesc = 0;
            if (!undef)
            {
                if (!defAddress(objs, L, def, &value, err))
                {
                    dealloc<u8>(img);
                    return false;
                }
                if (def->shndx == SHN_ABS)
                {
                    ntype = 0x03; /* N_ABS | N_EXT */
                }
                else
                {
                    ntype = 0x0F; /* N_SECT | N_EXT */
                    usize oi = def->common ? (usize)SEC_BSS
                        : (usize)objs->atPtr(def->objIdx)->secs.atPtr((usize)def->shndx)->outIdx;
                    if (oi < sectNo.count() && sectNo.at(oi) != 0)
                        nsect = (u8)sectNo.at(oi);
                }
                if (def->bind == STB_WEAK) ndesc = 0x80;
            }
            putU32(img + (usize)symOff + idx * 16, (u32)stroff);
            img[(usize)symOff + idx * 16 + 4] = ntype;
            img[(usize)symOff + idx * 16 + 5] = nsect;
            putU16(img + (usize)symOff + idx * 16 + 6, ndesc);
            putU64(img + (usize)symOff + idx * 16 + 8, value);
            copy<u8>(img + (usize)strOff + (usize)stroff, (u8*)def->name.ptr, def->name.len);
            stroff += (u64)def->name.len + 1;
            idx++;
        }
    }
    if (rebase.count() > 0)
        copy<u8>(img + (usize)rebaseOff, rebase.data, rebase.count());
    rebase.dispose();
    if (bind.count() > 0)
        copy<u8>(img + (usize)bindOff, bind.data, bind.count());
    bind.dispose();
    if (trie.count() > 0)
        copy<u8>(img + (usize)trieOff, trie.data, trie.count());
    trie.dispose();

    /* __text stubs for branch-referenced imports: adrp x16 / ldr x16 /
     * br x16 through the symbol's __got slot (bound by dyld) */
    if (L->machoStub.count() > 0)
    {
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            if (!def->isImport || def->impIdx >= 0 || def->iatAddr == 0) continue;
            if (d >= L->machoStub.count() || L->machoStub.at(d) < 0) continue;
            u64 stubAddr = def->iatAddr;
            u64 gotAddr = def->value;
            if (stubAddr < base || gotAddr < base) continue;
            usize sp = (usize)(stubAddr - base);
            if (sp + 12 > (usize)fileSize) continue;
            i64 pd = (i64)((gotAddr & ~0xFFFULL) - (stubAddr & ~0xFFFULL)) >> 12;
            if (pd < -(1 << 20) || pd >= (1 << 20)) continue;
            u64 dw = (u64)pd & 0x1FFFFF;
            putU32(img + sp, 0x90000010u |
                   (u32)((dw & 3u) << 29) | (u32)(((dw >> 2) & 0x7FFFFu) << 5));
            u64 lo = gotAddr & 0xFFFu;
            putU32(img + sp + 4, 0xF9400000u | (u32)((lo >> 3) << 10) | (16u << 5) | 16u);
            putU32(img + sp + 8, 0xD61F0200u);
        }
    }

    *outImg = img;
    *outLen = (usize)fileSize;
    return true;
}
