#[[no_drop_all]]
// wasm linker: merge multiple .wasm modules into one.
//   wasmLink(paths, n, outBytes*, err*) -> bool
import std::vec { Vec };
import std::mman { alloc, dealloc };
import std::string { String };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import muvm::linker::wasm::parse { WasmModule, wasmParse, wasmModuleDeinit };
import muvm::linker::wasm::merge { wasmMerge };

pub bool wasmLinkFiles(str* paths, u32 n, Vec<u8>* out, str* err)
{
    WasmModule** mods = alloc<WasmModule*>((usize)n);
    String* srcs = alloc<String>((usize)n);
    if (mods == null || srcs == null) { *err = "oom"; return false; }
    u32 nmods = 0;
    for (u32 i = 0; i < n; i++)
    {
        Result<String, IoError> rd = readFileToString(paths[i]);
        if (rd.isErr()) { *err = "cannot read input"; return false; }
        String src = rd.unwrap();
        WasmModule* m = alloc<WasmModule>(1);
        if (m == null) { *err = "oom"; src.free(); return false; }
        str perr = "";
        if (!wasmParse((u8*)src.asU8(), (u32)src.len, m, &perr))
        {
            *err = perr;
            dealloc<WasmModule>(m);
            src.free();
            return false;
        }
        mods[nmods] = m;
        srcs[nmods] = src;
        nmods++;
    }
    bool ok = wasmMerge(mods, nmods, out, err);
    for (u32 i = 0; i < nmods; i++) { wasmModuleDeinit(mods[i]); srcs[i].free(); }
    dealloc<WasmModule*>(mods);
    dealloc<String>(srcs);
    return ok;
}

pub bool wasmLinkWrite(str* paths, u32 n, str outPath, str* err)
{
    Vec<u8> out = Vec<u8>::new();
    if (!wasmLinkFiles(paths, n, &out, err)) return false;
    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr()) { *err = "cannot write output"; out.dispose(); return false; }
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, out.data, out.len);
    fileClose(f);
    out.dispose();
    return wr.isOk();
}
