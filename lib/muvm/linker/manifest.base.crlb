# linker base manifest - mirrors wallvm's. The linker has no platform
# files of its own; platform selection happens when `import(lib) std`
# inside these sources resolves through std's manifests.
#
# See coral-docs/builder_incomplete.md - include/extends/platform_root
# resolution is not implemented in the builder yet.

schema = 1;
strict = true;

build "linker" {
    root          = "lib/linker/";
    modules       = ["linker"];
    platform_root = "";
}
