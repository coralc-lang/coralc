// Calling conventions
// mivm-local for now — the rules/ABI tables land with the backends, at
// which point this enum stays the public handle callers pass around.
pub enum CallingConvention
{
    SystemV,
    Win64,
    SyscallWin64,
    SyscallX86_64,
    SyscallMacOS,
    Cdecl,
    Stdcall,
    Fastcall,
    SyscallX86,
    WinX86_32,
    Wasm32,
    Wasm64,
}

pub enum TargetArch
{
    X86_64,
    X86,
    Arm64,
    Wasm32,
    Wasm64,
}

pub enum TargetOS
{
    Linux,
    Windows,
    MacOS,
    BareMetal,
    Unknown,
}

pub enum BackendKind
{
    Fast,
    Primary,
}

pub struct MuvmTarget
{
    TargetArch arch;
    TargetOS os;
    BackendKind backend;
}

pub MuvmTarget muvmTarget(TargetArch arch, TargetOS os, BackendKind backend)
{
    return MuvmTarget {
        .arch = arch,
        .os = os,
        .backend = backend
    };
}

pub MuvmTarget muvmDefaultTarget()
{
    return muvmTarget(TargetArch::X86_64, TargetOS::Linux, BackendKind::Fast);
}

pub MuvmTarget muvmTargetFromCC(CallingConvention cc)
{
    switch (cc)
    {
        CallingConvention::Win64 |
        CallingConvention::SyscallWin64 => {
            return muvmTarget(TargetArch::X86_64, TargetOS::Windows, BackendKind::Fast);
        },
        CallingConvention::WinX86_32 => {
            return muvmTarget(TargetArch::X86, TargetOS::Windows, BackendKind::Fast);
        },
        CallingConvention::SyscallMacOS => {
            return muvmTarget(TargetArch::X86_64, TargetOS::MacOS, BackendKind::Fast);
        },
        CallingConvention::Wasm32 => {
            return muvmTarget(TargetArch::Wasm32, TargetOS::Unknown, BackendKind::Fast);
        },
        CallingConvention::Wasm64 => {
            return muvmTarget(TargetArch::Wasm64, TargetOS::Unknown, BackendKind::Fast);
        },
        CallingConvention::Cdecl |
        CallingConvention::Stdcall |
        CallingConvention::Fastcall |
        CallingConvention::SyscallX86 => {
            return muvmTarget(TargetArch::X86, TargetOS::Linux, BackendKind::Fast);
        },
        else => {
            return muvmTarget(TargetArch::X86_64, TargetOS::Linux, BackendKind::Fast);
        },
    }
}

pub CallingConvention muvmTargetCallingConvention(MuvmTarget t)
{
    switch (t.arch)
    {
        TargetArch::X86_64 => {
            if (t.os == TargetOS::Windows) return CallingConvention::Win64;
            return CallingConvention::SystemV;
        },
        TargetArch::X86 => {
            if (t.os == TargetOS::Windows) return CallingConvention::WinX86_32;
            return CallingConvention::Cdecl;
        },
        TargetArch::Wasm32 => { return CallingConvention::Wasm32; },
        TargetArch::Wasm64 => { return CallingConvention::Wasm64; },
        else => { return CallingConvention::SystemV; },
    }
}

/* numeric id stored in IrFunc.cc / the `cc N` IR attribute. The fast
 * x86_64 emitter reads it directly: 0 = SystemV (or "use target"),
 * 1 = Win64, 2 = SyscallWin64. Conventions with no x86_64 fast-path
 * encoding fold to 0 — the target default still applies. */
pub u32 muvmCCId(CallingConvention cc)
{
    switch (cc)
    {
        CallingConvention::Win64 => { return 1; },
        CallingConvention::SyscallWin64 => { return 2; },
        else => { return 0; },
    }
}

pub str muvmTargetArchName(TargetArch arch)
{
    switch (arch)
    {
        TargetArch::X86_64 => { return "x86_64"; },
        TargetArch::X86 => { return "x86"; },
        TargetArch::Arm64 => { return "arm64"; },
        TargetArch::Wasm32 => { return "wasm32"; },
        TargetArch::Wasm64 => { return "wasm64"; },
        else => { return "unknown"; },
    }
}

pub bool muvmTargetIsImplemented(MuvmTarget t)
{
    if (t.backend != BackendKind::Fast) return false;
    return t.arch == TargetArch::X86_64 || t.arch == TargetArch::Wasm32 ||
        t.arch == TargetArch::Wasm64 || t.arch == TargetArch::Arm64;
}

// Options — a value, not a global
// Levels mirror LLVM's shape: Debug (sanitizer-style, trap
// instrumentation and nothing else) and O0..O3 (growing optimization).
// Debug always instruments; O0..O3 never do — unless a host wants
// traps alongside full optimization, it can rewrite with
// muvmPassSafety itself.
pub enum OptLevel
{
    Debug,
    O0,
    O1,
    O2,
    O3,
}

pub struct MuvmOptions
{
    OptLevel level;
    str trapName;   // symbol the _trap-based safety checks call
    bool unroll;    // opt-in full unrolling (structure lane)
    bool keepPhis;  // regalloc may materialize phi copies directly
    bool verbose;   // print each graph node on every run
    bool dumps;     // print the module after every node that reports a change
    bool verify;    // run the IR verifier after every pass (-verify-each)
    u32 maxIters;   // 0 = default budget by level
}

pub MuvmOptions muvmOptions(OptLevel level)
{
    return MuvmOptions {
        .level = level,
        .trapName = "_trap",
        .unroll = false,
        .keepPhis = true,
        .verbose = false,
        .dumps = false,
        .verify = false,
        .maxIters = 0
    };
}

u32 maxItersFor(MuvmOptions o)
{
    if (o.maxIters != 0) return o.maxIters;
    switch (o.level)
    {
        OptLevel::O3 => { return 8; },
        OptLevel::O2 => { return 5; },
        OptLevel::O1 => { return 2; },
        else => { return 1; }
    }
}

str optLevelName(OptLevel l)
{
    switch (l)
    {
        OptLevel::Debug => { return "debug"; },
        OptLevel::O0    => { return "O0"; },
        OptLevel::O1    => { return "O1"; },
        OptLevel::O2    => { return "O2"; },
        OptLevel::O3    => { return "O3"; },
    }
    return "O?";
}

// Results
pub struct CompileResult
{
    bool success;
    str errorMsg;
    u32 errorLine;
}

pub CompileResult muvmSuccess()
{
    return CompileResult {
        .success = true,
        .errorMsg = "",
        .errorLine = 0
    };
}

pub CompileResult muvmError(str msg, u32 line)
{
    return CompileResult {
        .success = false,
        .errorMsg = msg,
        .errorLine = line
    };
}

pub void muvmDumpModule(IrModule* modd, str label)
{
    if (modd == null) return;
    IrPrinter pr = IrPrinter::new();
    pr.printModule(modd);
    eprintln("; ---- {} ----", label);
    eprintln("{}", pr.output());
    pr.destroy();
}

// PassGraph — nodes + dependency edges, scheduled by Kahn's algorithm
typedef GraphNodeFn = bool(IrFunc*, rawptr);

pub struct PassGraph
{
    GraphNodeFn* nodes;
    str* names;
    bool* isAnalysis;
    u32* edgeFrom;
    u32* edgeTo;
    u32* order;
    u32 count;
    u32 capacity;
    u32 edgeCount;
    u32 edgeCap;
    u32 orderLen;
    bool finalized;
    MuvmOptions opt;

    static PassGraph new()
    {
        return PassGraph {
            .nodes = null,
            .names = null,
            .isAnalysis = null,
            .edgeFrom = null,
            .edgeTo = null,
            .order = null,
            .count = 0,
            .capacity = 0,
            .edgeCount = 0,
            .edgeCap = 0,
            .orderLen = 0,
            .finalized = false,
            .opt = muvmOptions(OptLevel::O0)
        };
    }

    // Sets the options the executor consults for verbose/dump behaviour.
    // Call before run*; muvmPipeline does this for its callers.
    void setOptions(MuvmOptions o)
    {
        self.opt = o;
    }

    u32 grow()
    {
        u32 nc = self.capacity ? self.capacity * 2 : 8;
        GraphNodeFn* nn = alloc<GraphNodeFn>((usize)nc);
        str* nm = alloc<str>((usize)nc);
        bool* na = alloc<bool>((usize)nc);
        for (u32 i = 0; i < self.count; i++)
        {
            nn[i] = self.nodes[i];
            nm[i] = self.names[i];
            na[i] = self.isAnalysis[i];
        }
        if (self.nodes != null) dealloc<GraphNodeFn>(self.nodes);
        if (self.names != null) dealloc<str>(self.names);
        if (self.isAnalysis != null) dealloc<bool>(self.isAnalysis);
        self.nodes = nn;
        self.names = nm;
        self.isAnalysis = na;
        return nc;
    }

    u32 addNode(GraphNodeFn fn, str name, bool analysis)
    {
        if (self.count >= self.capacity)
            self.capacity = self.grow();
        self.nodes[self.count] = fn;
        self.names[self.count] = name;
        self.isAnalysis[self.count] = analysis;
        self.count++;
        self.finalized = false;
        return self.count - 1;
    }

    void addEdge(u32 from, u32 to)
    {
        if (self.edgeCount >= self.edgeCap)
        {
            u32 ec = self.edgeCap ? self.edgeCap * 2 : 16;
            u32* ef = alloc<u32>((usize)ec);
            u32* et = alloc<u32>((usize)ec);
            for (u32 i = 0; i < self.edgeCount; i++)
            {
                ef[i] = self.edgeFrom[i];
                et[i] = self.edgeTo[i];
            }
            if (self.edgeFrom != null) dealloc<u32>(self.edgeFrom);
            if (self.edgeTo != null) dealloc<u32>(self.edgeTo);
            self.edgeFrom = ef;
            self.edgeTo = et;
            self.edgeCap = ec;
        }
        self.edgeFrom[self.edgeCount] = from;
        self.edgeTo[self.edgeCount] = to;
        self.edgeCount++;
        self.finalized = false;
    }

    // Kahn's algorithm; insertion order of zero-indegree nodes breaks
    // ties. Cycles are a bug in the node set — reported on stderr and
    // execution continues in insertion order.
    void finalize()
    {
        if (self.finalized) return;
        if (self.order != null)
        {
            dealloc<u32>(self.order);
            self.order = null;
            self.orderLen = 0;
        }
        u32* indeg = alloc<u32>((usize)(self.count ? self.count : 1));
        for (u32 i = 0; i < self.count; i++) indeg[i] = 0;
        for (u32 e = 0; e < self.edgeCount; e++) indeg[self.edgeTo[e]]++;
        u32* order = alloc<u32>((usize)(self.count ? self.count : 1));
        bool* emitted = alloc<bool>((usize)(self.count ? self.count : 1));
        for (u32 i = 0; i < self.count; i++) emitted[i] = false;
        for (u32 n = 0; n < self.count; n++)
        {
            u32 pick = 0xFFFFFFFF;
            for (u32 i = 0; i < self.count; i++)
                if (!emitted[i] && indeg[i] == 0) { pick = i; break; }
            if (pick == 0xFFFFFFFF)
            {
                eprintln("pass graph: dependency cycle, falling back to insertion order");
                for (u32 i = 0; i < self.count; i++) order[i] = i;
                self.order = order;
                self.orderLen = self.count;
                dealloc<u32>(indeg);
                dealloc<bool>(emitted);
                self.finalized = true;
                return;
            }
            order[n] = pick;
            emitted[pick] = true;
            for (u32 e = 0; e < self.edgeCount; e++)
                if (self.edgeFrom[e] == pick) indeg[self.edgeTo[e]] = indeg[self.edgeTo[e]] - 1;
        }
        self.order = order;
        self.orderLen = self.count;
        dealloc<u32>(indeg);
        dealloc<bool>(emitted);
        self.finalized = true;
    }

    void clear()
    {
        if (self.nodes != null) dealloc<GraphNodeFn>(self.nodes);
        if (self.names != null) dealloc<str>(self.names);
        if (self.isAnalysis != null) dealloc<bool>(self.isAnalysis);
        if (self.edgeFrom != null) dealloc<u32>(self.edgeFrom);
        if (self.edgeTo != null) dealloc<u32>(self.edgeTo);
        if (self.order != null) dealloc<u32>(self.order);
        self.nodes = null;
        self.names = null;
        self.isAnalysis = null;
        self.edgeFrom = null;
        self.edgeTo = null;
        self.order = null;
        self.count = 0;
        self.capacity = 0;
        self.edgeCount = 0;
        self.edgeCap = 0;
        self.orderLen = 0;
        self.finalized = false;
    }

    bool runOnFunc(IrFunc* func, rawptr ctx)
    {
        return self.runOnFuncIterate(func, ctx, 1);
    }

    // Iterates the graph until no node reports a change, or maxIters
    // iterations elapse. Any node that reports change bumps the context
    // analysis generation so cached analyses rebuild themselves.
    bool runOnFuncIterate(IrFunc* func, rawptr ctx, u32 maxIters)
    {
        bool anyChanged = false;
        for (u32 iter = 0; iter < maxIters; iter++)
        {
            bool changed = false;
            for (u32 i = 0; i < self.orderLen; i++)
            {
                u32 ni = self.order[i];
                if (self.opt.verbose)
                    eprintln("> node {} (iter {})", self.names[ni], iter);
                bool nodeChanged = self.nodes[ni](func, ctx);
                if (self.opt.verify)
                {
                    if (!muvmPassVerify(func, null))
                    {
                        eprintln("verify: node {} left the function malformed — aborting", self.names[ni]);
                        return false;
                    }
                }
                if (nodeChanged)
                {
                    changed = true;
                    ((IrContext*)ctx)->analysisGeneration++;
                    if (self.opt.dumps)
                        muvmDumpModule(func->parent, self.names[ni]);
                }
            }
            if (!changed) break;
            anyChanged = true;
        }
        return anyChanged;
    }
}

// Pipelines — built from data, not from a control-flow tangle
// The default function-stage graph is a descriptor table, it is not code.
// Each PassDesc is one pipeline entry: node function, printable name,
// analysis flag, minimum -O level. To register a pass: append one line.
// The pipeline order IS the table order; the graph's finalize() re-derives
// dependency-respecting execution order from the chain we wire here.

pub struct PassDesc
{
    GraphNodeFn fn;
    str name;
    bool isAnalysis;
}

// Per-level pipeline construction — one explicit table per level,
// switch on the OptLevel enum, LLVM style. A pass is on the list or it
// is not; there is no maxLevel arithmetic. Order is the table order.
u32 passTable(OptLevel level, PassDesc* out, u32 cap)
{
    u32 n = 0;
    if (cap < 2) return n;
    switch (level)
    {
        // Debug — safety instrumentation (done in the driver pre-phase)
        // plus mem2reg so the IR is in a runnable shape. Nothing else.
        OptLevel::Debug => {
            out[n] = PassDesc { (GraphNodeFn)muvmPassMem2Reg, "mem2reg", false }; n++;
            return n;
        },

        // O0 — no optimization; mem2reg is the only rewrite either
        // backend expects of its inputs.
        OptLevel::O0 => {
            out[n] = PassDesc { (GraphNodeFn)muvmPassMem2Reg, "mem2reg", false }; n++;
            return n;
        },

        // O1 — instcombine + CFG cleanup (LLVM's O1 backbone). No GVN/
        // SCCP/LICM yet.
        OptLevel::O1 => {
            out[n] = PassDesc { (GraphNodeFn)muvmPassMem2Reg, "mem2reg", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassFold, "fold", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSimplifyCfg, "simplifycfg", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSimplifyCfg, "simplifycfg2", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassAdce, "adce", false }; n++;
            return n;
        },

        // O2/O3 — the full mid-end. LLVM runs nearly the same function
        // pipeline at both; O3 buys iteration, not new passes.
        OptLevel::O2 | OptLevel::O3 => {
            out[n] = PassDesc { (GraphNodeFn)muvmPassMem2Reg, "mem2reg", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassFold, "fold", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassCommCanonicalize, "comm_canon", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassInvolution, "involution", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassCastElimination, "cast_elim", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassAlgebraic, "algebraic", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassGvn, "gvn", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassDivMod, "divmod", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassIdempotent, "idempotent", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSimplifyCfg, "simplifycfg", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassJumpThread, "jump_thread", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassBranchProp, "branchprop", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassTailDup, "tail_dup", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassLoopCanon, "loop_canon", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassLoopCse, "loop_cse", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassLicm, "licm", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassUnroll, "unroll", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSimplifyCfg, "simplifycfg2", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSccp, "sccp", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSelectToBranch, "select_to_branch", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassAdce, "adce", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassSROA, "sroa", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassDse, "dse", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassTco, "tco", false }; n++;
            out[n] = PassDesc { (GraphNodeFn)muvmPassMacroFusion, "macro_fusion", false }; n++;
            return n;
        },
    }
    return n;
}

pub PassGraph muvmPipeline(MuvmOptions o)
{
    PassGraph g = PassGraph::new();
    g.setOptions(o);
    PassDesc[32] table;
    u32 n = passTable(o.level, table, 32);
    u32 prev = 0xFFFFFFFF;
    for (u32 i = 0; i < n; i++)
    {
        PassDesc d = table[i];
        prev = addChained(&g, prev, d.fn, d.name, d.isAnalysis);
    }
    g.finalize();
    return g;
}

pub u32 addChained(PassGraph* g, u32 prev, GraphNodeFn fn, str name, bool isAnalysis)
{
    u32 id = g->addNode(fn, name, isAnalysis);
    if (prev != 0xFFFFFFFF) g->addEdge(prev, id);
    return id;
}

// Public entry points
pub bool muvmOptimize(IrFunc* func, IrContext* ctx, CallingConvention cc, MuvmOptions o)
{
    if (func == null || ctx == null) return false;
    gVerbose = o.verbose;
    if (funcIsOptNone(func) && o.level != OptLevel::Debug && o.level != OptLevel::O0) o.level = OptLevel::O0;

    if (o.verbose)
        eprintln("; func={} {}", func->base.name, optLevelName(o.level));

    // The Debug level always instruments; O0-O3 never do. Safety is the
    // whole pipeline there — instrumentation plus mem2reg.
    if (o.level == OptLevel::Debug)
    {
        if (o.verbose)
            eprintln("> safety {}", func->base.name);
        muvmPassSafety(func, ctx, o.trapName);
    }

    if (o.verbose)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            if (func->blocks[bi] == null) continue;
            eprintln("block[{}] = {} succs:", bi, func->blocks[bi]->base.name);
            IrBlock* bb = func->blocks[bi];
            for (u32 sj = 0; sj < bb->nsuccs; sj++)
                eprintln("  succ {} -> {}", sj, bb->succs[sj]->base.name);
        }
    }
    if (o.verbose) eprintln("; muvmOptimize entry func={} {} (optnone={})", func->base.name, optLevelName(o.level), funcIsOptNone(func) ? 1 : 0);
    PassGraph g = muvmPipeline(o);
    bool r = g.runOnFuncIterate(func, (rawptr)ctx, maxItersFor(o));
    if (o.verbose) eprintln("; muvmOptimize exit func={} changed={}", func->base.name, r ? 1 : 0);
    g.clear();
    ctx->clearAnalysisCaches();
    return r;
}

pub bool muvmStructureLane(IrFunc* func, IrContext* ctx, MuvmOptions o)
{
    if (func == null || ctx == null) return false;
    if (o.verbose) eprintln("; muvmStructureLane entry func={}", func->base.name);

    // Full unrolling: opt-in, and the unroll pass has not landed.
    if (o.unroll && o.verbose)
        eprintln("> unroll requested but not implemented yet ({})", func->base.name);

    // Phi lowering: keep-phis is the contract (the allocator materializes
    // phi copies); there is no phi-demotion pass in muvm yet either. The
    // structure lane is where they will land, after the last IR-stage
    // node and before regalloc.
    return true;
}

// Module stage: interprocedural work runs before the per-function lane
// so cloned bodies and propagated constants are seen by the normal
// function pipeline in the same compilation. Inlining policy:
//   - O0/O1/Debug: only prewritten hints (!alwaysinline / !inlinehint)
//     may inline; the cost model never fires
//   - O2: hints plus the cost model at a conservative budget
//   - O3: hints plus the cost model at a wider budget
// IPA-CP only runs at O2/O3 — it is an optimization, not a hint.
pub bool muvmModuleStage(IrModule* modd, IrContext* ctx, MuvmOptions o)
{
    if (modd == null || ctx == null) return false;

    bool requireHint = o.level != OptLevel::O2 && o.level != OptLevel::O3;
    u32 inlineMax = o.level == OptLevel::O3 ? 48 : (requireHint ? 24 : 32);
    bool changed = false;
    if (muvmPassInlineModule(modd, ctx, inlineMax, requireHint)) changed = true;
    if (!requireHint && muvmPassIpaCpModule(modd, ctx)) changed = true;
    if (changed)
    {
        // Inlining clones callee blocks verbatim, leaving empty
        // `br next` trampolines behind. Flatten them here so every
        // level gets clean fallthrough layout, not just O1+.
        for (u32 fi = 0; fi < modd->nfuncs; fi++)
        {
            IrFunc* func = modd->funcs[fi];
            if (func == null || func->isExtern) continue;
            muvmPassSimplifyCfg(func, (rawptr)ctx);
        }
    }
    if (o.verify)
    {
        for (u32 fi = 0; fi < modd->nfuncs; fi++)
        {
            IrFunc* func = modd->funcs[fi];
            if (func == null || func->isExtern) continue;
            if (!muvmPassVerify(func, null))
            {
                eprintln("; muvmModuleStage verify failed func={}", func->base.name);
                return changed;
            }
        }
    }
    if (o.verbose)
        eprintln("; muvmModuleStage done changed={}", changed ? 1 : 0);
    return changed;
}

// Full module path: module stage + function lane to a small fixed point,
// then the structure lane once. The fixpoint matters: IPA's first round
// can expose a constant return, which the function lane folds, which lets
// the next IPA round propagate that return to callers. Without it, simply
// recompiling the printed module would produce different IR.
pub bool muvmOptimizeModule(IrModule* modd, IrContext* ctx, CallingConvention cc, MuvmOptions o)
{
    if (modd == null || ctx == null) return false;
    for (u32 round = 0; round < 8; round++)
    {
        bool moduleChanged = muvmModuleStage(modd, ctx, o);
        if (round > 0 && !moduleChanged) break;
        for (u32 fi = 0; fi < modd->nfuncs; fi++)
        {
            IrFunc* func = modd->funcs[fi];
            if (func == null || func->isExtern) continue;
            if (o.verbose) eprintln("; muvmOptimizeModule optimizing func={}", func->base.name);
            muvmOptimize(func, ctx, cc, o);
        }
        if (o.verify)
        {
            for (u32 fi = 0; fi < modd->nfuncs; fi++)
            {
                IrFunc* func = modd->funcs[fi];
                if (func == null || func->isExtern) continue;
                if (!muvmPassVerify(func, null)) return false;
            }
        }
    }
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;
        if (!muvmStructureLane(func, ctx, o)) return false;
    }
    return true;
}

pub str muvmEmitModuleAsmForTarget(IrModule* modd, IrContext* ctx, MuvmTarget t)
{
    if (modd == null || ctx == null) return "";
    switch (t.backend)
    {
        BackendKind::Fast =>
        {
            switch (t.arch)
            {
                TargetArch::X86_64 =>
                {
                    return emitModuleAsmTarget(modd, ctx, t.os == TargetOS::Windows);
                },
                TargetArch::Wasm32 | TargetArch::Wasm64 =>
                {
                    return irCodegenWasm32Asm(modd, ctx);
                },
                TargetArch::Arm64 => {
                    return emitArm64ModuleAsm(modd, ctx,
                        t.os == TargetOS::Windows);
                },
                else => { return ""; },
            }
        },
        BackendKind::Primary => { return ""; },
        else => { return ""; },
    }
    return "";
}

// Phase 1 (module + optimize + structure lane) runs before any
// regalloc/codegen touches the module — inlining clones pre-regalloc IR,
// so callees must still be in that form here.
pub CompileResult muvmCompileModuleForTarget(IrModule* modd, IrContext* ctx, MuvmTarget t, MuvmOptions o)
{
    if (modd == null) return muvmError("null module", 0);
    if (ctx == null) return muvmError("null context", 0);
    if (!muvmTargetIsImplemented(t))
        return muvmError("codegen backend not implemented for target", 0);

    CallingConvention cc = muvmTargetCallingConvention(t);
    if (!muvmOptimizeModule(modd, ctx, cc, o))
        return muvmError("module optimization failed", 0);
    if (o.verbose) eprintln("; muvmCompileModule phase1 done");
    str asmText = muvmEmitModuleAsmForTarget(modd, ctx, t);
    if (asmText.len == 0 && modd->nfuncs > 0)
        return muvmError("codegen backend failed to emit assembly", 0);
    return muvmSuccess();
}

pub CompileResult muvmCompileModule(IrModule* modd, IrContext* ctx, CallingConvention cc, MuvmOptions o)
{
    return muvmCompileModuleForTarget(modd, ctx, muvmTargetFromCC(cc), o);
}

// Test-support export. Returns the generated assembly text, or an empty
// str on failure (len == 0).
pub str muvmCompileAsmForTarget(IrModule* modd, IrContext* ctx, MuvmTarget t, MuvmOptions o)
{
    if (modd == null || ctx == null) return "";
    if (!muvmTargetIsImplemented(t)) return "";
    CallingConvention cc = muvmTargetCallingConvention(t);
    if (!muvmOptimizeModule(modd, ctx, cc, o)) return "";
    return muvmEmitModuleAsmForTarget(modd, ctx, t);
}

pub str muvmCompileAsm(IrModule* modd, IrContext* ctx, CallingConvention cc, MuvmOptions o)
{
    return muvmCompileAsmForTarget(modd, ctx, muvmTargetFromCC(cc), o);
}
