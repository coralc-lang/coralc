import muvm::passes::ipa_cp { muvmPassIpaCpModule };
import muvm::passes::algebraic { muvmPassAlgebraic };
import muvm::passes::tail_dup { muvmPassTailDup };
import muvm::passes::mem2reg { muvmPassMem2Reg };
import muvm::passes::divmod { muvmPassDivMod };
import muvm::passes::fold { muvmPassFold };
import muvm::passes::licm { muvmPassLicm };
import muvm::passes::sccp { muvmPassSccp };
