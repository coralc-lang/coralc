#[[no_drop_all]]
// x86_64 primary codegen: per-platform subfolders.
import muvm::irtypes { IrModule, IrFunc, IrContext };
import std::string { String };
import std::ios { eprintln };

pub mod linux = use linux;
pub mod windows = use windows;

pub str x86_64EmitFuncAsm(IrFunc* func, IrContext* ctx, bool isWindows)
{
    eprintln("x86_64EmitFuncAsm {} extern={} ctx={}", func->base.name, func->isExtern, (u64)ctx);
    if (isWindows) return ""; /* parked until linux is stable */
    return linux::emit::emitFuncAsm(func, ctx);
}

pub str x86_64EmitModuleAsm(IrModule* modd, IrContext* ctx, bool isWindows)
{
    if (modd == null || ctx == null) return "";
    eprintln("x86_64EmitModuleAsm nfuncs={}", modd->nfuncs);
    String out = String::new();
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;
        str s = x86_64EmitFuncAsm(func, ctx, isWindows);
        if (s.len > 0) { out.appendView(s); out.pushChar('\n'); }
    }
    return out.asView();
}
