#[[no_drop_all]]
// linux.crl: x86_64 SysV ABI constants and helpers for the primary
// backend. Integer args: rdi rsi rdx rcx r8 r9 then stack.
// SSE args: xmm0-7 in parallel. AL = upper bound of vector reg
// count for variadic calls. Returns: rax (+rdx for 9-16B).
// Aggregates >16B return via hidden sret pointer in rdi.

import muvm::irtypes { IrType, IrTypeKind, IrValue };

pub const u32 INT_ARG_REGS = 6;
pub const u32 SSE_ARG_REGS = 8;
pub const u32 RET_PAIR_MAX = 16; /* rax:rdx covers <=16B non-agg */

pub enum ArgClass
{
    INTEGER,
    SSE,
    MEMORY
}

pub u32 typeSizeBytes(IrType* t)
{
    if (t == null) return 8;
    if (t->kind == IrTypeKind::Void) return 0;
    if (t->kind == IrTypeKind::Int || t->kind == IrTypeKind::Float ||
        t->kind == IrTypeKind::Ptr || t->kind == IrTypeKind::Vector)
        return t->width / 8;
    /* aggregates carry byte size in width for our IR */
    return t->width;
}

pub bool typeIsSse(IrType* t)
{
    if (t == null) return false;
    return t->kind == IrTypeKind::Float || t->kind == IrTypeKind::Vector;
}

pub ArgClass classifyArg(IrValue* v)
{
    if (v == null || v->type == null) return ArgClass::INTEGER;
    IrType* t = v->type;
    switch (t->kind)
    {
        IrTypeKind::Float | IrTypeKind::Vector => { return ArgClass::SSE; },
        IrTypeKind::Struct | IrTypeKind::Array | IrTypeKind::Union => {
            return typeSizeBytes(t) > 16 ? ArgClass::MEMORY : ArgClass::INTEGER;
        },
        else => { return ArgClass::INTEGER; },
    }
}

pub bool retNeedsPair(IrType* t)
{
    u32 sz = typeSizeBytes(t);
    return sz > 8 && sz <= RET_PAIR_MAX;
}

pub bool retNeedsSret(IrType* t)
{
    if (t == null) return false;
    switch (t->kind)
    {
        IrTypeKind::Struct | IrTypeKind::Array | IrTypeKind::Union => {
            return typeSizeBytes(t) > 16;
        },
        else => { return false; },
    }
}
