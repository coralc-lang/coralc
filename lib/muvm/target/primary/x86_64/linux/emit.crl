#[[no_drop_all]]
// emit.crl: instruction selection + text emission for x86_64 linux.
//
// Pipeline per function:
//   collect defs -> dense vreg map -> block liveness -> live
//   intervals -> interference-graph coloring (regalloc/graph) ->
//   isel (pattern tables below) -> emit blocks -> prologue/epilogue.
//
// isel: each opcode family has an ordered rule list. A rule matches
// on the SHAPE of its operands (const / register / stack slot /
// xmm) and the TYPE CLASS of the operation (int width, float,
// vector); the first match wins, cheapest forms first. Actions are
// shared emitters — rules only decide which operand materialization
// path is legal, so e.g. `add $imm, %r` and `add -8(%rbp), %r`
// come from different rules of the same group.

import muvm::irtypes {
    IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind,
    IrType, IrTypeKind, IrContext, IrGlobal, IrStringConst,
    IrArrayConst, IrStructConst, IrStructType
};
import muvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred, irOpcodeStr };
import muvm::regalloc::graph { graphAssignNodes };
import std::string { String };
import std::mman { alloc, dealloc, copy };
import std::vec { Vec };
import platform::libc { snprintf };
import core::cchar { cchar };

use muvm::target::primary::x86_64::linux::regs;
use muvm::target::primary::x86_64::linux::linux { ArgClass, classifyArg, typeSizeBytes, typeIsSse, INT_ARG_REGS, SSE_ARG_REGS };
use muvm::target::primary::x86_64::linux::prologue;

/* ================= vreg / context ================= */

pub struct VReg
{
    i32 phys;      /* regs:: encoding or -1 */
    i32 slot;      /* spill slot index, -1 otherwise */
    u8 klass;      /* 0 = gpr, 1 = xmm, 2 = forced spill */
    bool isConst;
    u64 constVal;
    u32 nuses;
    u8 noEmit;
    IrType* type;
}

struct VRegMap
{
    usize* keys;
    u32* vals;
    u32 cap;
    u32 count;
}

u64 vmapHash(IrValue* v)
{
    return (((u64)(usize)v) >> 4) * 11400714819323198485;
}

void vmapInit(VRegMap* m, u32 cap)
{
    m->cap = cap;
    m->count = 0;
    m->keys = alloc<usize>((usize)cap);
    m->vals = alloc<u32>((usize)cap);
    for (u32 i = 0; i < cap; i++) { m->keys[i] = 0; m->vals[i] = 0; }
}

void vmapFree(VRegMap* m)
{
    if (m->keys != null) dealloc<usize>(m->keys);
    if (m->vals != null) dealloc<u32>(m->vals);
    m->keys = null;
    m->vals = null;
}

i32 vmapFind(VRegMap* m, IrValue* v)
{
    u64 h = vmapHash(v);
    u32 i = (u32)(h & (u64)(m->cap - 1));
    for (u32 probe = 0; probe < m->cap; probe++)
    {
        usize k = m->keys[i];
        if (k == 0) return -1;
        if ((IrValue*)(usize)k == v) return (i32)m->vals[i];
        i = (i + 1) & (m->cap - 1);
    }
    return -1;
}

void vmapInsertRaw(VRegMap* m, IrValue* v, u32 idx)
{
    u64 h = vmapHash(v);
    u32 i = (u32)(h & (u64)(m->cap - 1));
    while (m->keys[i] != 0) i = (i + 1) & (m->cap - 1);
    m->keys[i] = (usize)v;
    m->vals[i] = idx;
    m->count++;
}

void vmapGrow(VRegMap* m)
{
    usize* ok = m->keys;
    u32* ov = m->vals;
    u32 oc = m->cap;
    vmapInit(m, oc * 2);
    for (u32 i = 0; i < oc; i++)
        if (ok[i] != 0) vmapInsertRaw(m, (IrValue*)(usize)ok[i], ov[i]);
    dealloc<usize>(ok);
    dealloc<u32>(ov);
}

void vmapPut(VRegMap* m, IrValue* v, u32 idx)
{
    if ((m->count + 1) * 4 >= m->cap * 3) vmapGrow(m);
    u64 h = vmapHash(v);
    u32 i = (u32)(h & (u64)(m->cap - 1));
    while (m->keys[i] != 0) i = (i + 1) & (m->cap - 1);
    m->keys[i] = (usize)v;
    m->vals[i] = idx;
    m->count++;
}

pub struct EmitCtx
{
    String out;
    IrFunc* func;
    IrContext* ictx;
    VReg* vregs;
    u32 nvregs;
    u32 capVregs;
    VRegMap vmap;
    Vec<u8> usedCallee;
    i32 frameSize;      /* spill bytes */
    i32 savedBytes;     /* callee-saved push area */
    i32 allocaBytes;    /* alloca region size (precomputed) */
    i32 allocaCursor;   /* bytes of alloca area already assigned */
    u8[8] calleeList;
    u32 ncallee;
    bool forceFrame;    /* calls, stack args, or other rbp-frame needs */
    IrValue** allocaVals;
    i32* allocaOffs;
    u32 nallocas;
    u32 capAllocas;
    IrValue** cseFrom;
    IrValue** cseTo;
    u32 ncse;
    u32 capCse;
    usize[32] memAddr;
    usize[32] memVal;
    u32[32] memW;
    u32 nmem;
    str labelPrefix;
    /* div pairing: rax/rdx still hold quot/rem for (divA,divB,divSigned)
     * from the immediately preceding div-family inst — a following
     * sdiv/srem (etc) on the same operands reuses them for free. */
    IrValue* divA;
    IrValue* divB;
    u8 divSigned;
    u8 divValid;

    EmitCtx new()
    {
        EmitCtx c = {
            .out = String::new(),
            .func = null,
            .ictx = null,
            .vregs = null,
            .nvregs = 0,
            .capVregs = 0,
            .vmap = VRegMap { .keys = null, .vals = null, .cap = 0, .count = 0 },
            .usedCallee = Vec<u8>::new(),
            .frameSize = 0,
            .savedBytes = 0,
            .allocaBytes = 0,
            .allocaCursor = 0,
            .calleeList = { 0 },
            .ncallee = 0,
            .forceFrame = false,
            .allocaVals = null,
            .allocaOffs = null,
            .nallocas = 0,
            .capAllocas = 0,
            .cseFrom = null,
            .cseTo = null,
            .ncse = 0,
            .capCse = 0,
            .nmem = 0,
            .labelPrefix = str::empty(),
            .divA = null,
            .divB = null,
            .divSigned = 0,
            .divValid = 0
        };
        for (u32 i = 0; i < 8; i++) c.calleeList[i] = 0;
        vmapInit(&c.vmap, 256);
        return c;
    }

    void destroy()
    {
        if (self.vregs != null) dealloc<VReg>(self.vregs);
        if (self.allocaVals != null) dealloc<IrValue*>(self.allocaVals);
        if (self.allocaOffs != null) dealloc<i32>(self.allocaOffs);
        if (self.cseFrom != null) dealloc<IrValue*>(self.cseFrom);
        if (self.cseTo != null) dealloc<IrValue*>(self.cseTo);
        vmapFree(&self.vmap);
        self.out.free();
        self.usedCallee.dispose();
    }

    u32 vregFor(IrValue* v)
    {
        /* load CSE: a redundant load aliases to the first load's vreg */
        if (v != null && v->kind == IrValueKind::Inst &&
            ((IrInst*)v)->opcode == IrOpcode::Load)
        {
            for (u32 ci = 0; ci < self.ncse; ci++)
                if (self.cseFrom[ci] == v)
                {
                    u32 r = self.vregFor(self.cseTo[ci]);
                    vmapPut(&self.vmap, v, r);
                    return r;
                }
        }
        /* identity ops alias to source: bitcast, trunc, gep-with-no-indices.
         * dst uses read the source vreg directly — zero-cost copy. */
        if (v != null && v->kind == IrValueKind::Inst)
        {
            IrInst* ii = (IrInst*)v;
            bool ident = ii->opcode == IrOpcode::Bitcast ||
                         ii->opcode == IrOpcode::Trunc;
            if (!ident && ii->opcode == IrOpcode::Gep)
            {
                bool gok = false;
                i64 goff = gepConstOffset(self, ii, &gok);
                ident = gok && goff == 0;
            }
            /* bitcast across register classes (int<->float) is not a
             * no-op: dst lives in a different reg file and needs a
             * real movd/movq. Only alias within the same class. */
            if (ident && ii->opcode == IrOpcode::Bitcast &&
                ii->base.type != null && ii->ops[0] != null &&
                ii->ops[0]->type != null &&
                typeIsSse(ii->base.type) != typeIsSse(ii->ops[0]->type))
                ident = false;
            if (ident && ii->nops > 0 && isVRegOperand(ii->ops[0]))
            {
                i32 sid = vmapFind(&self.vmap, ii->ops[0]);
                if (sid >= 0)
                {
                    vmapPut(&self.vmap, v, (u32)sid);
                    return (u32)sid;
                }
            }
        }
        i32 f = vmapFind(&self.vmap, v);
        if (f >= 0) return (u32)f;
        u32 id = self.nvregs;
        self.nvregs = id + 1;
        if (id >= self.capVregs)
        {
            u32 nc = self.capVregs ? self.capVregs * 2 : 64;
            while (nc <= id) nc *= 2;
            VReg* nv = alloc<VReg>((usize)nc);
            if (self.vregs != null)
            {
                copy<VReg>(nv, self.vregs, (usize)self.capVregs);
                dealloc<VReg>(self.vregs);
            }
            self.vregs = nv;
            self.capVregs = nc;
        }
        VReg* r = &self.vregs[id];
        r->phys = -1;
        r->slot = -1;
        r->klass = 0;
        r->isConst = false;
        r->constVal = 0;
        r->nuses = 0;
        r->noEmit = 0;
        r->type = v->type;
        vmapPut(&self.vmap, v, id);
        return id;
    }

    void cseAdd(IrValue* from, IrValue* to)
    {
        if (self.ncse >= self.capCse)
        {
            u32 nc = self.capCse ? self.capCse * 2 : 16;
            IrValue** nf = alloc<IrValue*>((usize)nc);
            IrValue** nt = alloc<IrValue*>((usize)nc);
            if (self.cseFrom != null)
            {
                copy<IrValue*>(nf, self.cseFrom, (usize)self.ncse);
                dealloc<IrValue*>(self.cseFrom);
            }
            if (self.cseTo != null)
            {
                copy<IrValue*>(nt, self.cseTo, (usize)self.ncse);
                dealloc<IrValue*>(self.cseTo);
            }
            self.cseFrom = nf; self.cseTo = nt; self.capCse = nc;
        }
        self.cseFrom[self.ncse] = from;
        self.cseTo[self.ncse] = to;
        self.ncse++;
    }

    IrValue* cseFind(IrValue* v)
    {
        for (u32 ci = 0; ci < self.ncse; ci++)
            if (self.cseFrom[ci] == v) return self.cseTo[ci];
        return null;
    }

    void memClear() { self.nmem = 0; }

    void memRecord(IrValue* addr, IrValue* val, u32 w)
    {
        if (self.nmem >= 32) self.nmem = 0;
        self.memAddr[self.nmem] = (usize)addr;
        self.memVal[self.nmem] = (usize)val;
        self.memW[self.nmem] = w;
        self.nmem++;
    }

    IrValue* memLookup(IrValue* addr, u32 w)
    {
        for (u32 i = 0; i < self.nmem; i++)
            if (self.memAddr[i] == (usize)addr && self.memW[i] == w)
                return (IrValue*)(usize)self.memVal[i];
        return null;
    }

    void emit(str s) { self.out.appendView(s); }
    void emitLine(str s) { self.out.appendView(s); self.out.pushChar('\n'); }

    void emitI64(i64 v)
    {
        cchar[32] buf;
        i32 n = snprintf(buf, 32, C"%lld", v);
        if (n > 0) self.out.appendView(str::fromParts((const u8*)buf, (usize)n));
    }

    void emitU64(u64 v)
    {
        cchar[32] buf;
        i32 n = snprintf(buf, 32, C"%llu", v);
        if (n > 0) self.out.appendView(str::fromParts((const u8*)buf, (usize)n));
    }
}

/* ================= register naming ================= */

pub str regName(u8 r)
{
    switch (r)
    {
        0 => { return "%rax"; },
        1 => { return "%rcx"; },
        2 => { return "%rdx"; },
        3 => { return "%rbx"; },
        4 => { return "%rsp"; },
        5 => { return "%rbp"; },
        6 => { return "%rsi"; },
        7 => { return "%rdi"; },
        8 => { return "%r8"; },
        9 => { return "%r9"; },
        10 => { return "%r10"; },
        11 => { return "%r11"; },
        12 => { return "%r12"; },
        13 => { return "%r13"; },
        14 => { return "%r14"; },
        15 => { return "%r15"; },
        else => { return "%r?"; }
    }
}

pub str intSfx(u32 w)
{
    if (w <= 8) return "b";
    if (w <= 16) return "w";
    if (w <= 32) return "l";
    return "q";
}

/* operand width used for register selection: sub-32-bit values are
 * manipulated in 32-bit registers (upper bits are don't-care). */
u32 regW(u32 w) { return w <= 32 ? 32 : 64; }

pub str regForWidth(u8 r, u32 w)
{
    if (w <= 32)
    {
        switch (r)
        {
            0 => { return "%eax"; },
            1 => { return "%ecx"; },
            2 => { return "%edx"; },
            3 => { return "%ebx"; },
            6 => { return "%esi"; },
            7 => { return "%edi"; },
            8 => { return "%r8d"; },
            9 => { return "%r9d"; },
            10 => { return "%r10d"; },
            11 => { return "%r11d"; },
            12 => { return "%r12d"; },
            13 => { return "%r13d"; },
            14 => { return "%r14d"; },
            15 => { return "%r15d"; },
            else => { return regName(r); }
        }
    }
    return regName(r);
}

void emitByteReg(EmitCtx* c, u8 r)
{
    switch (r)
    {
        0 => { c->emit("%al"); },
        1 => { c->emit("%cl"); },
        2 => { c->emit("%dl"); },
        3 => { c->emit("%bl"); },
        4 => { c->emit("%spl"); },
        5 => { c->emit("%bpl"); },
        6 => { c->emit("%sil"); },
        7 => { c->emit("%dil"); },
        else => {
            c->emit("%r");
            c->emitU64((u64)r);
            c->emit("b");
        }
    }
}

void emitWordReg(EmitCtx* c, u8 r)
{
    switch (r)
    {
        0 => { c->emit("%ax"); },
        1 => { c->emit("%cx"); },
        2 => { c->emit("%dx"); },
        3 => { c->emit("%bx"); },
        4 => { c->emit("%sp"); },
        5 => { c->emit("%bp"); },
        6 => { c->emit("%si"); },
        7 => { c->emit("%di"); },
        else => {
            c->emit("%r");
            c->emitU64((u64)r);
            c->emit("w");
        }
    }
}

/* emit reg name at exact operand width (8/16/32/64) */
void emitRegExact(EmitCtx* c, u8 r, u32 w)
{
    if (w <= 8) { emitByteReg(c, r); return; }
    if (w <= 16) { emitWordReg(c, r); return; }
    c->emit(regForWidth(r, w <= 32 ? 32 : 64));
}


u8 argRegPhys(u8 i)
{
    switch (i)
    {
        0 => { return regs::RDI; },
        1 => { return regs::RSI; },
        2 => { return regs::RDX; },
        3 => { return regs::RCX; },
        4 => { return regs::R8; },
        else => { return regs::R9; }
    }
}

void emitXmmReg(EmitCtx* c, u8 r)
{
    c->emit("%xmm"); c->emitU64((u64)r);
}

/* clang-style trailing comments: pad the current line to `col`, then
 * emit `# comment`. Columns count bytes; tabs count as one byte, which
 * is close enough for our directive layout. */
usize asmCol(EmitCtx* c)
{
    usize col = 0;
    usize i = c->out.len;
    while (i > 0)
    {
        u8 ch = c->out.ptr[i - 1];
        if (ch == '\n') break;
        i--;
        col++;
    }
    return col;
}

void emitPadTo(EmitCtx* c, u32 col)
{
    while (asmCol(c) < (usize)col) c->emit(" ");
}

void emitAsmComment(EmitCtx* c, str comment, u32 col)
{
    if (asmCol(c) < (usize)col) emitPadTo(c, col);
    else c->emit(" ");
    c->emit("# "); c->emit(comment); c->emitLine("");
}

void emitFuncBeginComment(EmitCtx* c, str fname)
{
    emitPadTo(c, 40);
    c->emit("# -- Begin function "); c->emit(fname); c->emitLine("");
}

void emitFuncEndComment(EmitCtx* c)
{
    emitPadTo(c, 40);
    c->emit("# -- End function"); c->emitLine("");
}

void emitFuncLabelComment(EmitCtx* c, str fname)
{
    emitPadTo(c, 40);
    c->emit("# @"); c->emit(fname); c->emitLine("");
}

/* ================= isel: operand shapes & type classes ================= */

/* shape of an operand value at the machine level */
enum Shape
{
    SH_ANY = 0,
    SH_CONST = 1,    /* immediate / constant */
    SH_REG  = 2,    /* lives in a phys gpr */
    SH_SLOT = 4,    /* spilled -> rbp slot (memory operand) */
    SH_XREG = 8,    /* lives in a phys xmm */
    SH_XSLOT = 16,  /* spilled xmm -> rbp slot */
    SH_ADDR = 32    /* global/func/string address */
}

/* type class of the operation result/operands */
enum TyClass
{
    TC_INT = 0,     /* integer, any width <=64 */
    TC_FLOAT,       /* float/double scalar */
    TC_VECTOR,      /* vector */
    TC_PTR,         /* pointer (treated as int for arith) */
    TC_OTHER
}

TyClass tyClassOf(IrType* t)
{
    if (t == null) return TyClass::TC_INT;
    switch (t->kind)
    {
        IrTypeKind::Float => { return TyClass::TC_FLOAT; },
        IrTypeKind::Vector => { return TyClass::TC_VECTOR; },
        IrTypeKind::Ptr => { return TyClass::TC_PTR; },
        IrTypeKind::Int => { return TyClass::TC_INT; },
        else => { return TyClass::TC_OTHER; },
    }
}

/* resolve an address operand through identity ops (bitcast/trunc/
 * gep+0) so CSE sees the canonical pointer value */
IrValue* canonAddr(EmitCtx* c, IrValue* v)
{
    u32 guard = 0;
    while (v != null && v->kind == IrValueKind::Inst && guard++ < 32)
    {
        IrInst* i2 = (IrInst*)v;
        if ((i2->opcode == IrOpcode::Bitcast || i2->opcode == IrOpcode::Trunc) &&
            i2->nops > 0)
        { v = i2->ops[0]; continue; }
        if (i2->opcode == IrOpcode::Gep && i2->nops > 0)
        {
            bool ok = false;
            i64 o = gepConstOffset(c, i2, &ok);
            if (ok && o == 0) { v = i2->ops[0]; continue; }
        }
        break;
    }
    return v;
}

bool isVRegOperand(IrValue* v)
{
    if (v == null) return false;
    return v->kind == IrValueKind::Inst || v->kind == IrValueKind::Arg;
}

bool instHasDef(IrInst* inst)
{
    if (inst->base.type == null) return false;
    switch (inst->opcode)
    {
        IrOpcode::Store | IrOpcode::Br | IrOpcode::CondBr |
        IrOpcode::Switch | IrOpcode::Ret | IrOpcode::Unreachable |
        IrOpcode::Noret => { return false; },
        else => { return true; },
    }
}

i32 blockIndexOf(IrFunc* func, IrBlock* b)
{
    for (u32 i = 0; i < func->nblocks; i++)
        if (func->blocks[i] == b) return (i32)i;
    return -1;
}

u32 operandVReg(EmitCtx* ctx, IrValue* v)
{
    if (v == null) return 0;
    if (!isVRegOperand(v)) return 0;
    if (v->kind == IrValueKind::ConstInt)
    {
        u32 id = ctx->vregFor(v);
        ctx->vregs[id].isConst = true;
        ctx->vregs[id].constVal = v->valData;
        ctx->vregs[id].klass = 0;
        return id;
    }
    return ctx->vregFor(v);
}

/* classify operand shape; SH_ANY-ish fallback for exotic operands */
u32 shapeOf(EmitCtx* ctx, IrValue* v)
{
    if (v == null) return (u32)Shape::SH_ANY;
    if (v->kind == IrValueKind::ConstInt) return (u32)Shape::SH_CONST;
    if (v->kind == IrValueKind::ConstFloat) return (u32)Shape::SH_CONST;
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::Func ||
        v->kind == IrValueKind::StringConst) return (u32)Shape::SH_ADDR;
    if (!isVRegOperand(v)) return (u32)Shape::SH_ANY;
    i32 vid = vmapFind(&ctx->vmap, v);
    if (vid < 0) return (u32)Shape::SH_ANY;
    VReg* r = &ctx->vregs[(usize)vid];
    if (r->phys >= 0) return r->klass == 1 ? (u32)Shape::SH_XREG : (u32)Shape::SH_REG;
    return r->klass == 1 ? (u32)Shape::SH_XSLOT : (u32)Shape::SH_SLOT;
}

/* does shape s satisfy requirement req (SH_ANY matches all) */
bool shapeMatch(u32 req, u32 s)
{
    if (req == (u32)Shape::SH_ANY) return true;
    /* grouped requirements: a rule may list alternates via bit mask —
     * we treat req as a bitmask: operand shape must intersect it */
    return (s & req) != 0;
}

/* ================= low-level emit helpers ================= */

/* spill slot byte offset from rbp (positive magnitude) */
i32 spillOff(EmitCtx* c, i32 slot)
{
    return c->savedBytes + 8 * (slot + 1);
}

/* can `imm` be encoded as a store-immediate? mem imm is imm32
 * (sign-extended for 64-bit operands, raw for <=32). */
bool storeImmEncodable(u32 w, u64 imm)
{
    if (regW(w) <= 32)
        return (imm >> 32) == 0 || (imm >> 32) == 0xFFFFFFFFu;
    return (i64)(i32)(u32)imm == (i64)imm;
}

/* alloca slot byte offset */
i32 allocaOffOf(EmitCtx* c, IrValue* v)
{
    for (u32 i = 0; i < c->nallocas; i++)
        if (c->allocaVals[i] == v) return c->allocaOffs[i];
    return -1;
}

/* register an alloca frame slot; returns byte offset magnitude */
i32 allocaSlotFor(EmitCtx* c, IrValue* v, u32 size)
{
    i32 existing = allocaOffOf(c, v);
    if (existing >= 0) return existing;
    if (c->nallocas >= c->capAllocas)
    {
        u32 nc = c->capAllocas ? c->capAllocas * 2 : 8;
        IrValue** nv = alloc<IrValue*>((usize)nc);
        i32* no = alloc<i32>((usize)nc);
        if (c->allocaVals != null)
        {
            copy<IrValue*>(nv, c->allocaVals, (usize)c->nallocas);
            dealloc<IrValue*>(c->allocaVals);
        }
        if (c->allocaOffs != null)
        {
            copy<i32>(no, c->allocaOffs, (usize)c->nallocas);
            dealloc<i32>(c->allocaOffs);
        }
        c->allocaVals = nv;
        c->allocaOffs = no;
        c->capAllocas = nc;
    }
    u32 sz = (size + 15) / 16 * 16; /* 16-byte align for allocas */
    i32 off = c->savedBytes + c->frameSize + c->allocaCursor + (i32)sz;
    c->allocaCursor += (i32)sz;
    c->allocaVals[c->nallocas] = v;
    c->allocaOffs[c->nallocas] = off;
    c->nallocas++;
    return off;
}

/* object-file symbol for a value: extern funcs bind externSym when set */
str asmSymName(IrValue* v)
{
    if (v != null && v->kind == IrValueKind::Func)
    {
        IrFunc* f = (IrFunc*)v;
        if (f->isExtern && !f->externSym.isEmpty()) return f->externSym;
    }
    return v != null ? v->name : str::empty();
}

/* RIP-relative symbol name for global/func/string address operands */
void emitRipSymName(EmitCtx* c, IrValue* v)
{
    if (v != null && v->kind == IrValueKind::StringConst)
    {
        IrStringConst* sc = (IrStringConst*)v;
        if (!sc->base.name.isEmpty()) c->emit(sc->base.name);
        else { c->emit(".Lstr_"); c->emitU64((u64)sc->base.id); }
        return;
    }
    c->emit(asmSymName(v));
}

/* load an IR operand into phys gpr `dphys` at width w (bits).
 * Handles const / vreg-in-reg / spilled / global-lea. */
void loadToReg(EmitCtx* c, IrValue* src, u8 dphys, u32 w)
{
    u32 rw = regW(w);
    str dreg = regForWidth(dphys, rw);
    if (src == null)
    {
        c->emit("\txor"); c->emit(intSfx(rw)); c->emit(" ");
        c->emit(dreg); c->emit(", "); c->emit(dreg); c->emitLine("");
        return;
    }
    if (src->kind == IrValueKind::ConstInt)
    {
        u64 v = src->valData;
        if (v == 0)
        {
            c->emit("\txorl "); c->emit(regForWidth(dphys, 32));
            c->emit(", "); c->emit(regForWidth(dphys, 32)); c->emitLine("");
            return;
        }
        c->emit("\tmov"); c->emit(intSfx(rw)); c->emit(" $");
        c->emitU64(v); c->emit(", "); c->emit(dreg); c->emitLine("");
        return;
    }
    if (src->kind == IrValueKind::Global || src->kind == IrValueKind::Func ||
        src->kind == IrValueKind::StringConst)
    {
        c->emit("\tleaq ");
        if (src->kind == IrValueKind::StringConst)
        {
            IrStringConst* sc = (IrStringConst*)src;
            if (!sc->base.name.isEmpty()) c->emit(sc->base.name);
            else { c->emit(".Lstr_"); c->emitU64((u64)sc->base.id); }
        }
        else c->emit(asmSymName(src));
        c->emit("(%rip), "); c->emit(dreg); c->emitLine("");
        return;
    }
    if (!isVRegOperand(src))
    {
        c->emit("\t# isel: unsupported operand kind for loadToReg\n");
        return;
    }
    i32 vid = vmapFind(&c->vmap, src);
    if (vid < 0)
    {
        c->emit("\t# isel: unmapped operand\n");
        return;
    }
    /* noEmit-folded allocas have no register home: rematerialize the
     * address as leaq -off(%rbp). Normal allocas use their vreg. */
    if (src->kind == IrValueKind::Inst &&
        ((IrInst*)src)->opcode == IrOpcode::Alloca &&
        c->vregs[(usize)vid].noEmit != 0)
    {
        i32 ao = allocaOffOf(c, src);
        if (ao >= 0)
        {
            c->emit("\tleaq -"); c->emitI64((i64)ao); c->emit("(%rbp), ");
            c->emit(dreg); c->emitLine("");
            return;
        }
    }
    VReg* r = &c->vregs[(usize)vid];
    if (r->phys == (i32)dphys) return;
    c->emit("\tmov"); c->emit(intSfx(rw)); c->emit(" ");
    if (r->phys >= 0)
    {
        c->emit(regForWidth((u8)r->phys, rw)); c->emit(", ");
    }
    else
    {
        c->emit("-"); c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp), ");
    }
    c->emit(dreg); c->emitLine("");
}

/* store phys gpr `sphys` into vreg `vid` at width w */
void storeToVReg(EmitCtx* c, u32 vid, u8 sphys, u32 w)
{
    VReg* r = &c->vregs[(usize)vid];
    if (r->phys >= 0 && r->phys == (i32)sphys) return; /* already in place */
    u32 rw = regW(w);
    c->emit("\tmov"); c->emit(intSfx(rw)); c->emit(" ");
    c->emit(regForWidth(sphys, rw)); c->emit(", ");
    if (r->phys >= 0)
        c->emit(regForWidth((u8)r->phys, rw));
    else
    {
        c->emit("-"); c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)");
    }
    c->emitLine("");
}

/* emit `op src, dst` where dst is phys gpr dphys */
void emitOpReg(EmitCtx* c, str sop, u32 w, u8 srcPhys, u8 dstPhys)
{
    c->emit("\t"); c->emit(sop); c->emit(intSfx(regW(w))); c->emit(" ");
    c->emit(regForWidth(srcPhys, regW(w))); c->emit(", ");
    c->emit(regForWidth(dstPhys, regW(w))); c->emitLine("");
}

/* emit `op $imm, dst` or `op mem, dst` */
void emitOpImm(EmitCtx* c, str sop, u32 w, u64 imm, u8 dstPhys)
{
    u32 rw = regW(w);
    /* x86 imm is imm32: raw for 32-bit ops, sign-extended for 64-bit.
     * Anything wider needs a movabs into a scratch reg first. */
    bool ok = rw <= 32 ?
        ((imm >> 32) == 0 || (imm >> 32) == 0xFFFFFFFFu) :
        ((i64)(i32)(u32)imm == (i64)imm);
    if (!ok)
    {
        c->emit("\tmovabsq $"); c->emitU64(imm); c->emit(", %r11\n");
        c->emit("\t"); c->emit(sop); c->emit(intSfx(rw)); c->emit(" %r11, ");
        c->emit(regForWidth(dstPhys, rw)); c->emitLine("");
        return;
    }
    c->emit("\t"); c->emit(sop); c->emit(intSfx(rw)); c->emit(" $");
    if (rw <= 32) c->emitU64(imm & 0xFFFFFFFFu);
    else if ((i64)imm < 0) c->emitI64((i64)imm);
    else c->emitU64(imm);
    c->emit(", ");
    c->emit(regForWidth(dstPhys, regW(w))); c->emitLine("");
}

void emitOpMem(EmitCtx* c, str sop, u32 w, i32 slotOff, bool isAlloca, u8 dstPhys)
{
    c->emit("\t"); c->emit(sop); c->emit(intSfx(regW(w))); c->emit(" ");
    c->emit("-"); c->emitI64((i64)slotOff); c->emit("(%rbp), ");
    c->emit(regForWidth(dstPhys, regW(w))); c->emitLine("");
    (void)isAlloca;
}

/* ================= isel rule tables =================
 * Rule = {shape mask for operand B (and C), action id}.
 * Shape masks are bitmasks over Shape bits; SH_ANY matches all.
 * The matcher computes the actual shapes and picks the first rule
 * whose mask intersects — rules are ordered cheapest-first. */

/* actions for the binary int/logic group */
enum AluAct
{
    ACT_ALU_REG = 0,   /* op breg, dst      (b in phys reg) */
    ACT_ALU_IMM,       /* op $imm, dst      (b const)      */
    ACT_ALU_MEM,       /* op slot(%rbp),dst (b spilled)    */
    ACT_ALU_ANY        /* fallback: scratch  */
}

/* shared binary-op selector: dst = a <sop> b.
 * operand A always materializes into the dst register first;
 * operand B selects reg/imm/mem form by shape. */
void iselAlu(EmitCtx* c, IrInst* inst, str sop)
{
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    if (tyClassOf(inst->base.type) == TyClass::TC_VECTOR ||
        tyClassOf(inst->base.type) == TyClass::TC_OTHER)
    {
        c->emit("\t# isel: unsupported type class for ");
        c->emit(irOpcodeStr(inst->opcode)); c->emitLine("");
        return;
    }
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;

    /* rules for operand B, cheapest first */
    IrValue* a = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* b = inst->nops > 1 ? inst->ops[1] : null;
    u32 bshape = shapeOf(c, b);

    loadToReg(c, a, useR, w);

    if (b != null && b->kind == IrValueKind::ConstInt &&
        (bshape & (u32)Shape::SH_CONST) != 0)
    {
        /* add/sub/or/xor/shift by 0 are no-ops (imul $0/$1 handled
         * by caller rarely; keep emitting for safety) */
        bool identOp = inst->opcode == IrOpcode::Add ||
                       inst->opcode == IrOpcode::Sub ||
                       inst->opcode == IrOpcode::And ||
                       inst->opcode == IrOpcode::Or ||
                       inst->opcode == IrOpcode::Xor;
        if (!(identOp && b->valData == 0))
            emitOpImm(c, sop, w, b->valData, useR);
    }
    else
    {
        i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
        if (bvid >= 0 && c->vregs[(usize)bvid].phys >= 0 &&
            (u8)c->vregs[(usize)bvid].phys != useR)
        {
            emitOpReg(c, sop, w, (u8)c->vregs[(usize)bvid].phys, useR);
        }
        else if (bvid >= 0 && c->vregs[(usize)bvid].phys < 0 &&
                 c->vregs[(usize)bvid].klass != 1)
        {
            /* spilled gpr operand: memory form directly */
            emitOpMem(c, sop, w, spillOff(c, c->vregs[(usize)bvid].slot), false, useR);
        }
        else
        {
            /* xmm/addr/any: materialize into scratch then op */
            loadToReg(c, b, regs::SCRATCH_B, w);
            emitOpReg(c, sop, w, regs::SCRATCH_B, useR);
        }
    }
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

void iselShift(EmitCtx* c, IrInst* inst, str sop)
{
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    IrValue* a = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
    loadToReg(c, a, useR, w);

    if (cnt != null && cnt->kind == IrValueKind::ConstInt)
    {
        u64 k = cnt->valData & (w >= 64 ? 63 : 31);
        c->emit("\t"); c->emit(sop); c->emit(" $");
        c->emitU64(k); c->emit(", "); emitRegExact(c, useR, w); c->emitLine("");
    }
    else
    {
        /* count must be in %cl. If the count vreg already sits in rcx
         * the shift is free; otherwise save/restore rcx around the
         * move. If dst itself is rcx, shuttle through r10. */
        i32 cvid = isVRegOperand(cnt) ? vmapFind(&c->vmap, cnt) : -1;
        i32 cp = cvid >= 0 ? c->vregs[(usize)cvid].phys : -1;
        if (cp == (i32)regs::RCX)
        {
            c->emit("\t"); c->emit(sop); c->emit(" %cl, ");
            emitRegExact(c, useR, w); c->emitLine("");
        }
        else if (useR == regs::RCX)
        {
            /* dst in rcx: move result out, load count, shift r10, back */
            c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
            emitRegExact(c, regs::RCX, w); c->emit(", ");
            emitRegExact(c, regs::SCRATCH_A, w); c->emitLine("");
            loadToReg(c, cnt, regs::RCX, w);
            c->emit("\t"); c->emit(sop); c->emit(" %cl, ");
            emitRegExact(c, regs::SCRATCH_A, w); c->emitLine("");
            c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
            emitRegExact(c, regs::SCRATCH_A, w); c->emit(", ");
            emitRegExact(c, regs::RCX, w); c->emitLine("");
        }
        else
        {
            c->emitLine("\tpushq %rcx");
            loadToReg(c, cnt, regs::RCX, w);
            c->emit("\t"); c->emit(sop); c->emit(" %cl, ");
            emitRegExact(c, useR, w); c->emitLine("");
            c->emitLine("\tpopq %rcx");
        }
    }
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

/* reg name holding operand v at width w; materializes into `scratch`
 * only when the operand has no phys home. Avoids the mov a->scratch
 * that loadToReg would emit for operands already in a register. */
str operandRegFor(EmitCtx* c, IrValue* v, u32 w, u8 scratch)
{
    u32 rw = regW(w);
    i32 vid = isVRegOperand(v) ? vmapFind(&c->vmap, v) : -1;
    if (vid >= 0 && c->vregs[(usize)vid].phys >= 0 &&
        c->vregs[(usize)vid].klass != 1)
        return regForWidth((u8)c->vregs[(usize)vid].phys, rw);
    loadToReg(c, v, scratch, w);
    return regForWidth(scratch, rw);
}

/* emit `cmp b, a` (AT&T: computes a - b) choosing the cheapest form:
 * a in its own reg when possible, b as imm / reg / spill-slot mem. */
void emitCmpPair(EmitCtx* c, IrValue* a, IrValue* b, u32 w)
{
    u32 rw = regW(w);
    str areg = operandRegFor(c, a, w, regs::SCRATCH_A);
    if (b != null && b->kind == IrValueKind::ConstInt)
    {
        /* cmp imm is imm32 (sign-extended at 64-bit) — wider consts
         * go through a scratch reg */
        if (storeImmEncodable(w, b->valData))
        {
            c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" $");
            if (rw <= 32) c->emitU64(b->valData & 0xFFFFFFFFu);
            else if ((i64)b->valData < 0) c->emitI64((i64)b->valData);
            else c->emitU64(b->valData);
            c->emit(", "); c->emit(areg); c->emitLine("");
            return;
        }
        c->emit("\tmovabsq $"); c->emitU64(b->valData); c->emit(", %r11\n");
        c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" %r11, ");
        c->emit(areg); c->emitLine("");
        return;
    }
    i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
    if (bvid >= 0 && c->vregs[(usize)bvid].phys >= 0 &&
        c->vregs[(usize)bvid].klass != 1)
    {
        c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" ");
        c->emit(regForWidth((u8)c->vregs[(usize)bvid].phys, rw));
        c->emit(", "); c->emit(areg); c->emitLine("");
    }
    else if (bvid >= 0 && c->vregs[(usize)bvid].phys < 0 &&
             c->vregs[(usize)bvid].klass != 1)
    {
        c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" -");
        c->emitI64((i64)spillOff(c, c->vregs[(usize)bvid].slot));
        c->emit("(%rbp), "); c->emit(areg); c->emitLine("");
    }
    else
    {
        str breg = operandRegFor(c, b, w, regs::SCRATCH_B);
        c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" ");
        c->emit(breg); c->emit(", "); c->emit(areg); c->emitLine("");
    }
}

void iselICmp(EmitCtx* c, IrInst* inst)
{
    IrValue* a = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* b = inst->nops > 1 ? inst->ops[1] : null;
    u32 w = a != null && a->type != null ? a->type->width : 64;
    emitCmpPair(c, a, b, w);
    /* setcc into dst (i1 materialized as 0/1 in a 32-bit reg) */
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    str setop = "setne";
    switch (inst->icmpPred)
    {
        IrICmpPred::Eq => { setop = "sete"; },
        IrICmpPred::Ne => { setop = "setne"; },
        IrICmpPred::Slt => { setop = "setl"; },
        IrICmpPred::Sle => { setop = "setle"; },
        IrICmpPred::Sgt => { setop = "setg"; },
        IrICmpPred::Sge => { setop = "setge"; },
        IrICmpPred::Ult => { setop = "setb"; },
        IrICmpPred::Ule => { setop = "setbe"; },
        IrICmpPred::Ugt => { setop = "seta"; },
        IrICmpPred::Uge => { setop = "setae"; },
    }
    c->emit("\t"); c->emit(setop); c->emit(" ");
    emitByteReg(c, useR); c->emitLine("");
    c->emit("\tmovzbl "); emitByteReg(c, useR); c->emit(", ");
    c->emit(regForWidth(useR, 32)); c->emitLine("");
    storeToVReg(c, dvid, useR, 32);
}

void emitUnimplemented(EmitCtx* ctx, IrInst* inst, String* err)
{
    err->pushView("primary/x86_64/linux: unimplemented opcode ");
    err->pushView(irOpcodeStr(inst->opcode));
}

/* ================= concrete opcode selectors ================= */

/* frame offset of an alloca root, or -1. Lets gep chains fold straight
 * to `leaq disp(%rbp)` instead of lea+lea through the alloca vreg. */
i32 allocaRootOff(EmitCtx* c, IrValue* v)
{
    if (v == null || v->kind != IrValueKind::Inst) return -1;
    IrInst* i = (IrInst*)v;
    if (i->opcode != IrOpcode::Alloca) return -1;
    return allocaOffOf(c, v);
}

void iselAlloca(EmitCtx* c, IrInst* inst)
{
    u32 dvid = c->vregFor(&inst->base);
    if (c->vregs[(usize)dvid].noEmit != 0) return; /* folded into gep users */
    IrType* et = inst->base.type;
    if (et != null && et->kind == IrTypeKind::Ptr) et = et->elem;
    u32 sz = et != null ? c->ictx->irTypeSizeOf(et) : 8;
    if (sz == 0) sz = 8;
    i32 off = allocaSlotFor(c, &inst->base, sz);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    c->emit("\tleaq -"); c->emitI64((i64)off); c->emit("(%rbp), ");
    c->emit(regName(useR)); c->emitLine("");
    if (dp < 0) storeToVReg(c, dvid, useR, 64);
}

void iselLoad(EmitCtx* c, IrInst* inst)
{
    /* redundant load: dst vreg already holds the value — emit nothing */
    if (c->cseFind(&inst->base) != null && inst->nops > 0)
    {
        IrValue* addr = canonAddr(c, inst->ops[0]);
        u32 w = inst->base.type != null ? inst->base.type->width : 64;
        IrValue* prev = c->memLookup(addr, w);
        if (prev != null)
        {
            IrValue* canon = c->cseFind(&inst->base);
            c->memRecord(addr, canon != null ? canon : &inst->base, w);
            return;
        }
    }
    IrType* rt = inst->base.type;
    if (rt != null && (rt->kind == IrTypeKind::Vector ||
        rt->kind == IrTypeKind::Struct || rt->kind == IrTypeKind::Array ||
        rt->kind == IrTypeKind::Union))
    {
        c->emit("\t# isel: aggregate/vector load unsupported\n");
        return;
    }
    u32 w = rt != null ? rt->width : 64;
    IrValue* addr = inst->nops > 0 ? inst->ops[0] : null;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    /* global/func/string address: fold to a RIP-relative load */
    if (addr != null && (addr->kind == IrValueKind::Global ||
        addr->kind == IrValueKind::Func || addr->kind == IrValueKind::StringConst))
    {
        c->emit("\t");
        if (w <= 8) c->emit("movzbl ");
        else if (w <= 16) c->emit("movzwl ");
        else if (w <= 32) c->emit("movl ");
        else c->emit("movq ");
        emitRipSymName(c, addr); c->emit("(%rip), ");
        c->emit(regForWidth(useR, w <= 32 ? 32 : 64)); c->emitLine("");
        if (dp < 0) storeToVReg(c, dvid, useR, w);
        if (inst->nops > 0)
        {
            IrValue* canon = c->cseFind(&inst->base);
            c->memRecord(canonAddr(c, inst->ops[0]), canon != null ? canon : &inst->base, w);
        }
        return;
    }
    /* address -> scratch if spilled */
    i32 avid = isVRegOperand(addr) ? vmapFind(&c->vmap, addr) : -1;
    u8 addrR;
    if (avid >= 0 && c->vregs[(usize)avid].phys >= 0)
        addrR = (u8)c->vregs[(usize)avid].phys;
    else
    {
        loadToReg(c, addr, regs::SCRATCH_B, 64);
        addrR = regs::SCRATCH_B;
    }
    /* load width forms: 8->movzbl 16->movzwl 32->movl else movq */
    c->emit("\t");
    if (w <= 8) c->emit("movzbl ");
    else if (w <= 16) c->emit("movzwl ");
    else if (w <= 32) c->emit("movl ");
    else c->emit("movq ");
    c->emit("("); c->emit(regName(addrR)); c->emit("), ");
    c->emit(regForWidth(useR, w <= 32 ? 32 : 64)); c->emitLine("");
    if (dp < 0) storeToVReg(c, dvid, useR, w);
    if (inst->nops > 0)
    {
        IrValue* canon = c->cseFind(&inst->base);
        c->memRecord(canonAddr(c, inst->ops[0]), canon != null ? canon : &inst->base, w);
    }
}

void iselStore(EmitCtx* c, IrInst* inst)
{
    c->memClear();
    IrValue* val = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* addr = inst->nops > 1 ? inst->ops[1] : null;
    u32 w = val != null && val->type != null ? val->type->width : 64;
    if (val != null && val->type != null &&
        (val->type->kind == IrTypeKind::Vector ||
         val->type->kind == IrTypeKind::Struct ||
         val->type->kind == IrTypeKind::Array ||
         val->type->kind == IrTypeKind::Union))
    {
        c->emit("\t# isel: aggregate/vector store unsupported\n");
        return;
    }
    /* global/func/string address: fold to a RIP-relative store */
    if (addr != null && (addr->kind == IrValueKind::Global ||
        addr->kind == IrValueKind::Func || addr->kind == IrValueKind::StringConst))
    {
        if (val != null && val->kind == IrValueKind::ConstInt &&
            storeImmEncodable(w, val->valData))
        {
            c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" $");
            if (w <= 32) c->emitU64(val->valData & 0xFFFFFFFFu);
            else if ((i64)val->valData < 0) c->emitI64((i64)val->valData);
            else c->emitU64(val->valData);
            c->emit(", ");
            emitRipSymName(c, addr); c->emit("(%rip)"); c->emitLine("");
        }
        else
        {
            i32 vvid = isVRegOperand(val) ? vmapFind(&c->vmap, val) : -1;
            u8 vp;
            if (vvid >= 0 && c->vregs[(usize)vvid].phys >= 0 &&
                c->vregs[(usize)vvid].klass != 1)
                vp = (u8)c->vregs[(usize)vvid].phys;
            else
            {
                loadToReg(c, val, regs::SCRATCH_A, w);
                vp = regs::SCRATCH_A;
            }
            c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
            if (w <= 8) emitByteReg(c, vp);
            else if (w <= 16) emitWordReg(c, vp);
            else c->emit(regForWidth(vp, w <= 32 ? 32 : 64));
            c->emit(", "); emitRipSymName(c, addr); c->emit("(%rip)"); c->emitLine("");
        }
        return;
    }
    i32 avid = isVRegOperand(addr) ? vmapFind(&c->vmap, addr) : -1;
    u8 addrR;
    if (avid >= 0 && c->vregs[(usize)avid].phys >= 0)
        addrR = (u8)c->vregs[(usize)avid].phys;
    else
    {
        loadToReg(c, addr, regs::SCRATCH_B, 64);
        addrR = regs::SCRATCH_B;
    }
    if (val != null && val->kind == IrValueKind::ConstInt &&
        storeImmEncodable(w, val->valData))
    {
        c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" $");
        if (w <= 32) c->emitU64(val->valData & 0xFFFFFFFFu);
        else if ((i64)val->valData < 0) c->emitI64((i64)val->valData);
        else c->emitU64(val->valData);
        c->emit(", (");
        c->emit(regName(addrR)); c->emit(")"); c->emitLine("");
        return;
    }
    /* value -> scratch reg then store, or direct reg store */
    i32 vvid = isVRegOperand(val) ? vmapFind(&c->vmap, val) : -1;
    if (vvid >= 0 && c->vregs[(usize)vvid].phys >= 0 &&
        c->vregs[(usize)vvid].klass != 1)
    {
        u8 vp = (u8)c->vregs[(usize)vvid].phys;
        c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
        if (w <= 8) emitByteReg(c, vp);
        else if (w <= 16) emitWordReg(c, vp);
        else c->emit(regForWidth(vp, w <= 32 ? 32 : 64));
        c->emit(", ("); c->emit(regName(addrR)); c->emit(")"); c->emitLine("");
        return;
    }
    loadToReg(c, val, regs::SCRATCH_A, w);
    c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
    if (w <= 8) emitByteReg(c, regs::SCRATCH_A);
    else if (w <= 16) emitWordReg(c, regs::SCRATCH_A);
    else c->emit(regForWidth(regs::SCRATCH_A, w <= 32 ? 32 : 64));
    c->emit(", ("); c->emit(regName(addrR)); c->emit(")"); c->emitLine("");
}

/* const byte offset for a gep whose indices are all ConstInt.
 * Returns offset; sets *ok=false if the type walk fails. */
i64 gepConstOffset(EmitCtx* c, IrInst* inst, bool* ok)
{
    *ok = true;
    IrValue* base = inst->nops > 0 ? inst->ops[0] : null;
    IrType* cur = base != null ? base->type : null;
    if (cur != null && cur->kind == IrTypeKind::Ptr) cur = cur->elem;
    i64 cOff = 0;
    for (u32 gi = 1; gi < inst->nops; gi++)
    {
        IrValue* ix = inst->ops[gi];
        if (ix == null || ix->kind != IrValueKind::ConstInt) { *ok = false; return 0; }
        if (cur != null &&
            (cur->kind == IrTypeKind::Struct || cur->kind == IrTypeKind::Union))
        {
            u32 fi = (u32)(ix->valData & 0xFFFFFFFF);
            if (cur->kind == IrTypeKind::Struct && fi < cur->nparams)
            {
                u64 off = 0;
                bool packed = (cur->tflags & 1) != 0;
                for (u32 f = 0; f <= fi && f < cur->nparams; f++)
                {
                    IrType* ft = cur->params[f];
                    if (!packed && ft != null)
                    {
                        u64 al = (u64)c->ictx->irTypeAlignOf(ft);
                        if (al > 1) off = (off + al - 1) / al * al;
                    }
                    if (f == fi) break;
                    if (ft != null) off += (u64)c->ictx->irTypeSizeOf(ft);
                }
                cOff += (i64)off;
                cur = cur->params[fi];
            }
            else cur = null;
        }
        else
        {
            IrType* et = null;
            u64 esz = 1;
            if (cur != null && (cur->kind == IrTypeKind::Array ||
                                cur->kind == IrTypeKind::Vector)) et = cur->elem;
            else if (cur != null && cur->kind == IrTypeKind::Ptr) et = cur->elem;
            if (et != null) esz = (u64)c->ictx->irTypeSizeOf(et);
            else if (cur != null &&
                     (cur->kind == IrTypeKind::Int ||
                      cur->kind == IrTypeKind::Float))
                esz = (u64)c->ictx->irTypeSizeOf(cur);
            if (esz == 0) esz = 1;
            cOff += (i64)ix->valData * (i64)esz;
            cur = et;
        }
    }
    return cOff;
}

/* follow a chain of all-const-index geps upward: returns the first
 * non-foldable operand and accumulates ancestor byte offsets into *acc.
 * `gep g1, c; gep g2, d` where both const => root of g1's base + c+d. */
IrValue* gepFoldRoot(EmitCtx* c, IrValue* v, i64* acc)
{
    u32 guard = 0;
    while (v != null && v->kind == IrValueKind::Inst && guard++ < 32)
    {
        IrInst* g = (IrInst*)v;
        if (g->opcode != IrOpcode::Gep || g->nops < 2) break;
        bool allConst = true;
        for (u32 gi = 1; gi < g->nops; gi++)
            if (g->ops[gi] == null ||
                g->ops[gi]->kind != IrValueKind::ConstInt)
                allConst = false;
        if (!allConst) break;
        bool ok = false;
        i64 o = gepConstOffset(c, g, &ok);
        if (!ok) break;
        *acc += o;
        v = g->ops[0];
    }
    return v;
}

void iselGep(EmitCtx* c, IrInst* inst)
{
    /* ops[0]=base ptr, ops[1..]=indices; const offsets accumulate,
     * dynamic indices scale by elem size and add. Ancestor const geps
     * fold into a single root+offset so `gep (gep (gep a))` emits one
     * leaq instead of a chain. */
    IrValue* base = inst->nops > 0 ? inst->ops[0] : null;
    i64 chainOff = 0;
    IrValue* root = gepFoldRoot(c, base, &chainOff);
    u32 dvid = c->vregFor(&inst->base);
    /* gep+0 is a vreg alias; same-vid dst needs no code */
    if (isVRegOperand(base))
    {
        i32 bv = vmapFind(&c->vmap, base);
        if (bv >= 0 && (u32)bv == dvid) return;
    }
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;

    /* fast path: all-const indices -> single leaq off(base),dst */
    if (inst->nops > 1)
    {
        bool allConst = true;
        for (u32 gi = 1; gi < inst->nops; gi++)
            if (inst->ops[gi] == null ||
                inst->ops[gi]->kind != IrValueKind::ConstInt)
                allConst = false;
        if (allConst)
        {
            bool ok = false;
            i64 cOff = chainOff + gepConstOffset(c, inst, &ok);
            if (ok)
            {
                i32 aoff = allocaRootOff(c, root);
                if (aoff >= 0)
                {
                    /* root is an alloca: single lea straight off rbp */
                    c->emit("\tleaq "); c->emitI64(cOff - (i64)aoff);
                    c->emit("(%rbp), ");
                    c->emit(regForWidth(useR, 64)); c->emitLine("");
                }
                else
                {
                i32 avid = isVRegOperand(root) ? vmapFind(&c->vmap, root) : -1;
                u8 addrR;
                if (avid >= 0 && c->vregs[(usize)avid].phys >= 0 &&
                    c->vregs[(usize)avid].klass != 1)
                    addrR = (u8)c->vregs[(usize)avid].phys;
                else
                {
                    loadToReg(c, root, regs::SCRATCH_B, 64);
                    addrR = regs::SCRATCH_B;
                }
                if (cOff == 0)
                {
                    if (addrR != useR)
                    {
                        c->emit("\tmovq "); c->emit(regForWidth(addrR, 64));
                        c->emit(", "); c->emit(regForWidth(useR, 64)); c->emitLine("");
                    }
                }
                else
                {
                    c->emit("\tleaq "); c->emitI64(cOff); c->emit("(");
                    c->emit(regName(addrR)); c->emit("), ");
                    c->emit(regForWidth(useR, 64)); c->emitLine("");
                }
                }
                if (dp < 0) storeToVReg(c, dvid, useR, 64);
                return;
            }
        }
    }

    /* general path: root into dst reg, fold dynamic indices. Index
     * scaling still uses `base`'s pointee type — only the address
     * origin moved to the folded root. */
    loadToReg(c, root, useR, 64);
    IrType* cur = base != null ? base->type : null;
    if (cur != null && cur->kind == IrTypeKind::Ptr) cur = cur->elem;
    i64 cOff = chainOff;
    for (u32 gi = 1; gi < inst->nops; gi++)
    {
        IrValue* ix = inst->ops[gi];
        if (ix == null) continue;
        bool isConst = ix->kind == IrValueKind::ConstInt;
        if (cur != null &&
            (cur->kind == IrTypeKind::Struct || cur->kind == IrTypeKind::Union))
        {
            u32 fi = isConst ? (u32)(ix->valData & 0xFFFFFFFF) : 0;
            if (cur->kind == IrTypeKind::Struct && fi < cur->nparams)
            {
                u64 off = 0;
                bool packed = (cur->tflags & 1) != 0;
                for (u32 f = 0; f <= fi && f < cur->nparams; f++)
                {
                    IrType* ft = cur->params[f];
                    if (!packed && ft != null)
                    {
                        u64 al = (u64)c->ictx->irTypeAlignOf(ft);
                        if (al > 1) off = (off + al - 1) / al * al;
                    }
                    if (f == fi) break;
                    if (ft != null) off += (u64)c->ictx->irTypeSizeOf(ft);
                }
                cOff += (i64)off;
                cur = cur->params[fi];
            }
            else cur = null;
        }
        else
        {
            IrType* et = null;
            u64 esz = 1;
            if (cur != null && (cur->kind == IrTypeKind::Array ||
                                cur->kind == IrTypeKind::Vector)) et = cur->elem;
            else if (cur != null && cur->kind == IrTypeKind::Ptr) et = cur->elem;
            if (et != null) esz = (u64)c->ictx->irTypeSizeOf(et);
            else if (cur != null &&
                     (cur->kind == IrTypeKind::Int ||
                      cur->kind == IrTypeKind::Float))
                esz = (u64)c->ictx->irTypeSizeOf(cur);
            if (esz == 0) esz = 1;
            if (isConst)
                cOff += (i64)ix->valData * (i64)esz;
            else
            {
                loadToReg(c, ix, regs::SCRATCH_B, 64);
                if (esz != 1)
                {
                    c->emit("\timulq $"); c->emitI64((i64)esz); c->emit(", ");
                    c->emit(regForWidth(regs::SCRATCH_B, 64)); c->emitLine("");
                }
                emitOpReg(c, "add", 64, regs::SCRATCH_B, useR);
            }
            cur = et;
        }
    }
    if (cOff != 0)
    {
        c->emit("\taddq $"); c->emitI64(cOff); c->emit(", ");
        c->emit(regName(useR)); c->emitLine("");
    }
    if (dp < 0) storeToVReg(c, dvid, useR, 64);
}

void emitBBLabelName(EmitCtx* c, IrValue* bv)
{
    c->emit(".LBB"); c->emitU64((u64)c->func->base.id); c->emit("_");
    c->emitU64(bv != null ? (u64)bv->id : (u64)0);
}

void emitBBLabelFor(EmitCtx* c, IrValue* bv)
{
    emitBBLabelName(c, bv);
    c->emitLine(":");
}

void emitJmpToBB(EmitCtx* c, IrValue* target)
{
    c->emit("\tjmp "); emitBBLabelName(c, target); c->emitLine("");
}

void emitJccToBB(EmitCtx* c, str jcc, IrValue* target)
{
    c->emit("\t"); c->emit(jcc); c->emit(" ");
    emitBBLabelName(c, target); c->emitLine("");
}

void iselBr(EmitCtx* c, IrInst* inst)
{
    if (inst->nops > 0 && inst->ops[0] != null) emitJmpToBB(c, inst->ops[0]);
}

/* jcc mnemonic for an ICmp pred (used by condbr fusion) */
str jccFor(IrICmpPred p)
{
    switch (p)
    {
        IrICmpPred::Eq => { return "je"; },
        IrICmpPred::Ne => { return "jne"; },
        IrICmpPred::Slt => { return "jl"; },
        IrICmpPred::Sle => { return "jle"; },
        IrICmpPred::Sgt => { return "jg"; },
        IrICmpPred::Sge => { return "jge"; },
        IrICmpPred::Ult => { return "jb"; },
        IrICmpPred::Ule => { return "jbe"; },
        IrICmpPred::Ugt => { return "ja"; },
        IrICmpPred::Uge => { return "jae"; },
    }
    return "jne";
}

str jccInverseFor(IrICmpPred p)
{
    switch (p)
    {
        IrICmpPred::Eq => { return "jne"; },
        IrICmpPred::Ne => { return "je"; },
        IrICmpPred::Slt => { return "jge"; },
        IrICmpPred::Sle => { return "jg"; },
        IrICmpPred::Sgt => { return "jle"; },
        IrICmpPred::Sge => { return "jl"; },
        IrICmpPred::Ult => { return "jae"; },
        IrICmpPred::Ule => { return "ja"; },
        IrICmpPred::Ugt => { return "jbe"; },
        IrICmpPred::Uge => { return "jb"; },
    }
    return "je";
}

IrBlock* blockOperand(IrValue* v)
{
    if (v == null || v->kind != IrValueKind::Block) return null;
    return (IrBlock*)v;
}

void emitPhiEdgeName(EmitCtx* c, IrInst* inst, str tag)
{
    c->emit(".Lphi"); c->emitU64((u64)c->func->base.id); c->emit("_");
    c->emitU64((u64)inst->base.id); c->emit("_"); c->emit(tag);
}

/* conditional branch with edge phi copies: the false-edge jump goes first
 * (flags still live), true-edge copies run on the fallthrough, and the
 * false edge either jumps straight to its block or through a trampoline
 * that performs its phi copies. */
void emitCondBrEdges(EmitCtx* c, IrInst* inst, str falseJcc, IrValue* tb, IrValue* fb)
{
    IrBlock* pred = inst->parent;
    IrBlock* tbb = blockOperand(tb);
    IrBlock* fbb = blockOperand(fb);
    bool tphi = tbb != null && pred != null && phiCopyCountFor(c, pred, tbb) > 0;
    bool fphi = fbb != null && pred != null && phiCopyCountFor(c, pred, fbb) > 0;
    if (!tphi && !fphi)
    {
        emitJccToBB(c, falseJcc, fb);
        emitJmpToBB(c, tb);
        return;
    }
    if (fphi)
    {
        c->emit("\t"); c->emit(falseJcc); c->emit(" ");
        emitPhiEdgeName(c, inst, "f"); c->emitLine("");
        if (tphi) emitPhiCopiesFor(c, pred, tbb);
        emitJmpToBB(c, tb);
        emitPhiEdgeName(c, inst, "f"); c->emitLine(":");
        emitPhiCopiesFor(c, pred, fbb);
        emitJmpToBB(c, fb);
    }
    else
    {
        emitJccToBB(c, falseJcc, fb);
        if (tphi) emitPhiCopiesFor(c, pred, tbb);
        emitJmpToBB(c, tb);
    }
}

void iselCondBr(EmitCtx* c, IrInst* inst)
{
    IrValue* cond = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* tb = inst->nops > 1 ? inst->ops[1] : null;
    IrValue* fb = inst->nops > 2 ? inst->ops[2] : null;
    /* fused icmp: cond produced by a single-use ICmp inst -> cmp+jcc */
    if (cond != null && cond->kind == IrValueKind::Inst &&
        ((IrInst*)cond)->opcode == IrOpcode::ICmp)
    {
        IrInst* ic = (IrInst*)cond;
        IrValue* a = ic->nops > 0 ? ic->ops[0] : null;
        IrValue* b = ic->nops > 1 ? ic->ops[1] : null;
        u32 w = a != null && a->type != null ? a->type->width : 64;
        emitCmpPair(c, a, b, w);
        emitCondBrEdges(c, inst, jccInverseFor(ic->icmpPred), tb, fb);
        return;
    }
    /* generic: test cond, jcc */
    if (cond != null && cond->kind == IrValueKind::ConstInt)
    {
        IrValue* tgt = cond->valData != 0 ? tb : fb;
        IrBlock* sb = blockOperand(tgt);
        if (sb != null && inst->parent != null) emitPhiCopiesFor(c, inst->parent, sb);
        emitJmpToBB(c, tgt);
        return;
    }
    u32 w = cond != null && cond->type != null ? regW(cond->type->width) : 64;
    i32 cvid = isVRegOperand(cond) ? vmapFind(&c->vmap, cond) : -1;
    if (cvid >= 0 && c->vregs[(usize)cvid].phys >= 0 &&
        c->vregs[(usize)cvid].klass != 1)
    {
        str r = regForWidth((u8)c->vregs[(usize)cvid].phys, w);
        c->emit("\ttest"); c->emit(intSfx(w)); c->emit(" ");
        c->emit(r); c->emit(", "); c->emit(r); c->emitLine("");
    }
    else if (cvid >= 0 && c->vregs[(usize)cvid].phys < 0)
    {
        c->emit("\tcmp"); c->emit(intSfx(w)); c->emit(" $0, -");
        c->emitI64((i64)spillOff(c, c->vregs[(usize)cvid].slot));
        c->emit("(%rbp)"); c->emitLine("");
    }
    else
    {
        c->emit("\t# isel: unsupported condbr operand\n");
        return;
    }
    emitCondBrEdges(c, inst, "je", tb, fb);
}

/* ================= switch =================
 * ops: [sel, defaultBlock, (caseVal, caseBlock)*]. Each edge may carry
 * phi copies, so edges with copies jump through a per-edge trampoline
 * `.Lsw<func>_<inst>_<idx>` (idx == ncases is the default edge). */

void emitSwLabelName(EmitCtx* c, IrInst* inst, u32 idx)
{
    c->emit(".Lsw"); c->emitU64((u64)c->func->base.id); c->emit("_");
    c->emitU64((u64)inst->base.id); c->emit("_"); c->emitU64((u64)idx);
}

bool swEdgeNeedsTramp(EmitCtx* c, IrInst* inst, IrValue* blkVal, u32 idx)
{
    (void)idx;
    IrBlock* sb = blockOperand(blkVal);
    IrBlock* pred = inst->parent;
    if (sb == null || pred == null) return false;
    return phiCopyCountFor(c, pred, sb) > 0;
}

/* append the reference for edge idx: trampoline label or BB label */
void emitSwTargetRef(EmitCtx* c, IrInst* inst, IrValue* blkVal, u32 idx)
{
    if (swEdgeNeedsTramp(c, inst, blkVal, idx)) emitSwLabelName(c, inst, idx);
    else emitBBLabelName(c, blkVal);
}

void emitSwTrampoline(EmitCtx* c, IrInst* inst, IrValue* blkVal, u32 idx)
{
    if (!swEdgeNeedsTramp(c, inst, blkVal, idx)) return;
    emitSwLabelName(c, inst, idx); c->emitLine(":");
    IrBlock* sb = blockOperand(blkVal);
    emitPhiCopiesFor(c, inst->parent, sb);
    emitJmpToBB(c, blkVal);
}

void emitSwTableLabel(EmitCtx* c, IrInst* inst)
{
    c->emit(".LJTI"); c->emitU64((u64)c->func->base.id); c->emit("_");
    c->emitU64((u64)inst->base.id);
}

void iselSwitch(EmitCtx* c, IrInst* inst)
{
    IrValue* sel = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* def = inst->nops > 1 ? inst->ops[1] : null;
    u32 ncases = inst->nops >= 2 ? (inst->nops - 2) / 2 : 0;
    if (sel == null || def == null || ncases == 0)
    {
        c->emit("\t# isel: malformed switch\n");
        return;
    }
    u32 w = sel->type != null ? sel->type->width : 64;
    u32 rw = regW(w);
    u64 mask = 0xFFFFFFFFFFFFFFFFULL;
    if (w < 64) mask = ((u64)1 << (u64)w) - 1;

    u64* cvals = alloc<u64>((usize)ncases);
    IrValue** cblks = alloc<IrValue*>((usize)ncases);
    bool allConst = true;
    u64 vmin = 0xFFFFFFFFFFFFFFFFULL;
    u64 vmax = 0;
    for (u32 i = 0; i < ncases; i++)
    {
        IrValue* cv = inst->ops[2 + i * 2];
        cblks[i] = inst->ops[3 + i * 2];
        if (cv == null || cv->kind != IrValueKind::ConstInt)
        { allConst = false; cvals[i] = 0; continue; }
        u64 v = cv->valData & mask;
        cvals[i] = v;
        if (v < vmin) vmin = v;
        if (v > vmax) vmax = v;
    }
    u64 span = (vmax >= vmin) ? (vmax - vmin + 1) : 0;
    bool useTable = allConst && span > 0 && span <= 256 &&
                    span <= (u64)ncases * 8 &&
                    storeImmEncodable(w, vmin); /* sub $vmin must encode */

    if (useTable)
    {
        /* sel - vmin in r10, unsigned range check, PIC jump table */
        loadToReg(c, sel, regs::SCRATCH_A, w);
        str sreg = regForWidth(regs::SCRATCH_A, rw);
        if (vmin != 0)
        {
            c->emit("\tsub"); c->emit(intSfx(rw)); c->emit(" $");
            c->emitU64(vmin); c->emit(", "); c->emit(sreg); c->emitLine("");
        }
        c->emit("\tcmp"); c->emit(intSfx(rw)); c->emit(" $");
        c->emitU64(span - 1); c->emit(", "); c->emit(sreg); c->emitLine("");
        c->emit("\tja "); emitSwTargetRef(c, inst, def, ncases); c->emitLine("");
        c->emit("\tleaq "); emitSwTableLabel(c, inst); c->emit("(%rip), ");
        c->emit(regForWidth(regs::SCRATCH_B, 64)); c->emitLine("");
        c->emit("\tmovslq ("); c->emit(regForWidth(regs::SCRATCH_B, 64));
        c->emit(","); c->emit(regForWidth(regs::SCRATCH_A, 64));
        c->emit(",4), "); c->emit(regForWidth(regs::SCRATCH_A, 64));
        c->emitLine("");
        c->emit("\taddq "); c->emit(regForWidth(regs::SCRATCH_B, 64));
        c->emit(", "); c->emit(regForWidth(regs::SCRATCH_A, 64));
        c->emitLine("");
        c->emit("\tjmp *"); c->emit(regForWidth(regs::SCRATCH_A, 64));
        c->emitLine("");
        /* table in .rodata: 32-bit offsets from the table base —
         * position-independent and linker-resolved */
        c->emitLine("\t.section\t.rodata");
        c->emit("\t.p2align\t2\n");
        emitSwTableLabel(c, inst); c->emitLine(":");
        for (u64 e = 0; e < span; e++)
        {
            u64 want = vmin + e;
            u32 hit = ncases;
            for (u32 i = 0; i < ncases; i++)
                if (cvals[i] == want) { hit = i; break; }
            IrValue* tb = hit < ncases ? cblks[hit] : def;
            c->emit("\t.long ");
            emitSwTargetRef(c, inst, tb, hit);
            c->emit("-"); emitSwTableLabel(c, inst); c->emitLine("");
        }
        c->emitLine("\t.text");
        for (u32 i = 0; i < ncases; i++)
            emitSwTrampoline(c, inst, cblks[i], i);
        emitSwTrampoline(c, inst, def, ncases);
    }
    else
    {
        /* compare chain */
        for (u32 i = 0; i < ncases; i++)
        {
            IrValue* cv = inst->ops[2 + i * 2];
            if (cv == null) continue;
            emitCmpPair(c, sel, cv, w);
            c->emit("\tje "); emitSwTargetRef(c, inst, cblks[i], i);
            c->emitLine("");
        }
        c->emit("\tjmp "); emitSwTargetRef(c, inst, def, ncases); c->emitLine("");
        for (u32 i = 0; i < ncases; i++)
            emitSwTrampoline(c, inst, cblks[i], i);
        emitSwTrampoline(c, inst, def, ncases);
    }
    if (cvals != null) dealloc<u64>(cvals);
    if (cblks != null) dealloc<IrValue*>(cblks);
}

/* epilogue: restore callee-saved (reverse), rbp, ret */
void emitEpilogue(EmitCtx* c)
{
    bool frame = c->forceFrame || c->ncallee > 0 || c->frameSize > 0 || c->allocaBytes > 0;
    if (frame)
    {
        /* rsp -> just below callee pushes, then pop in reverse */
        if (c->savedBytes > 0)
        {
            c->emit("\tleaq -"); c->emitI64((i64)c->savedBytes);
            c->emit("(%rbp), %rsp\n");
        }
        else
            c->emitLine("\tmovq %rbp, %rsp");
        for (u32 i = c->ncallee; i > 0; i--)
        {
            c->emit("\tpopq "); c->emit(regName(c->calleeList[i-1])); c->emitLine("");
            c->emit("\t.cfi_restore "); c->emit(regName(c->calleeList[i-1])); c->emitLine("");
        }
        c->emitLine("\tpopq %rbp");
        c->emitLine("\t.cfi_restore %rbp");
    }
    c->emitLine("\t.cfi_def_cfa %rsp, 8");
    c->emitLine("\tretq");
}

void iselRet(EmitCtx* c, IrInst* inst)
{
    IrValue* rv = inst->nops > 0 ? inst->ops[0] : null;
    IrType* rt = c->func->retType;
    if (rv != null && rt != null && rt->kind != IrTypeKind::Void)
    {
        u32 sz = typeSizeBytes(rt);
        if (sz <= 8)
        {
            u32 w = rt->kind == IrTypeKind::Int ? rt->width : 64;
            loadToReg(c, rv, regs::RAX, w);
        }
        else
        {
            c->emit("\t# isel: multi-register/aggregate return unsupported\n");
        }
    }
    emitEpilogue(c);
}

/* div/rem: dst = a / b or a % b. x86 needs rax=dividend (rdx sign/zero
 * extended), divisor in a non-rax/rdx reg; result rax(quot)/rdx(rem). */
void iselDivRem(EmitCtx* c, IrInst* inst, bool isSigned, bool wantRem)
{
    IrValue* a = inst->nops > 0 ? inst->ops[0] : null;
    IrValue* b = inst->nops > 1 ? inst->ops[1] : null;
    u32 w = a != null && a->type != null ? a->type->width : 64;
    u32 rw = regW(w);
    /* paired div: previous inst already ran idiv on (a,b,signed) —
     * rax=quot rdx=rem are still live, skip straight to the result. */
    if (c->divValid != 0 && c->divA == a && c->divB == b &&
        c->divSigned == (isSigned ? 1 : 0))
    {
        u32 dvid = c->vregFor(&inst->base);
        i32 dp = (i32)c->vregs[(usize)dvid].phys;
        u8 srcR = wantRem ? regs::RDX : regs::RAX;
        if (dp >= 0)
        {
            if ((i32)srcR != dp)
            {
                c->emit("\tmov"); c->emit(intSfx(rw)); c->emit(" ");
                c->emit(regForWidth(srcR, rw)); c->emit(", ");
                c->emit(regForWidth((u8)dp, rw)); c->emitLine("");
            }
        }
        else storeToVReg(c, dvid, srcR, w);
        /* a result landing in rax/rdx clobbers the pair — drop it */
        if (dp == (i32)regs::RAX || dp == (i32)regs::RDX) c->divValid = 0;
        return;
    }
    /* dividend -> rax */
    loadToReg(c, a, regs::RAX, w);
    /* sign/zero extend into rdx */
    if (isSigned)
    {
        c->emit("\t"); c->emit(w <= 32 ? "cltd" : "cqo"); c->emitLine("");
    }
    else
    {
        c->emit("\txor"); c->emit(intSfx(rw)); c->emit(" ");
        c->emit(regForWidth(regs::RDX, rw)); c->emit(", ");
        c->emit(regForWidth(regs::RDX, rw)); c->emitLine("");
    }
    /* divisor -> scratch (never rax/rdx) */
    loadToReg(c, b, regs::SCRATCH_A, w);
    str dreg = regForWidth(regs::SCRATCH_A, rw);
    c->emit("\t"); c->emit(isSigned ? "idiv" : "div"); c->emit(intSfx(rw));
    c->emit(" "); c->emit(dreg); c->emitLine("");
    /* result: quot in rax, rem in rdx */
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 srcR = wantRem ? regs::RDX : regs::RAX;
    if (dp >= 0)
    {
        if ((i32)srcR != dp)
        {
            c->emit("\tmov"); c->emit(intSfx(rw)); c->emit(" ");
            c->emit(regForWidth(srcR, rw)); c->emit(", ");
            c->emit(regForWidth((u8)dp, rw)); c->emitLine("");
        }
    }
    else storeToVReg(c, dvid, srcR, w);
    /* remember the pair so an adjacent matching div reuses rax/rdx —
     * unless the result mov clobbered one of them */
    c->divA = a; c->divB = b; c->divSigned = isSigned ? 1 : 0;
    c->divValid = (dp == (i32)regs::RAX || dp == (i32)regs::RDX) ? 0 : 1;
}

void iselSelect(EmitCtx* c, IrInst* inst)
{
    /* ops: cond, trueVal, falseVal */
    if (inst->nops < 3) return;
    IrValue* cond = inst->ops[0];
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    /* dst = falseVal; scratch = trueVal; cmov if cond */
    loadToReg(c, inst->ops[2], useR, w);
    loadToReg(c, inst->ops[1], regs::SCRATCH_B, w);
    /* test cond */
    i32 cvid = isVRegOperand(cond) ? vmapFind(&c->vmap, cond) : -1;
    if (cvid >= 0 && c->vregs[(usize)cvid].phys >= 0)
    {
        str r = regForWidth((u8)c->vregs[(usize)cvid].phys, regW(w));
        c->emit("\ttest"); c->emit(intSfx(regW(w))); c->emit(" ");
        c->emit(r); c->emit(", "); c->emit(r); c->emitLine("");
    }
    else if (cond != null && cond->kind == IrValueKind::ConstInt)
    {
        /* const cond: just mov the right value — redo dst */
        loadToReg(c, cond->valData != 0 ? inst->ops[1] : inst->ops[2], useR, w);
        if (dp < 0) storeToVReg(c, dvid, useR, w);
        return;
    }
    else
    {
        c->emit("\t# isel: unsupported select cond\n");
        if (dp < 0) storeToVReg(c, dvid, useR, w);
        return;
    }
    c->emit("\tcmovne "); c->emit(regForWidth(regs::SCRATCH_B, regW(w)));
    c->emit(", "); c->emit(regForWidth(useR, regW(w))); c->emitLine("");
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

void iselCast(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 1) return;
    IrValue* src = inst->ops[0];
    IrType* st = src->type;
    u32 sw = st != null ? st->width : 64;
    u32 dw = inst->base.type != null ? inst->base.type->width : 64;
    if (inst->base.type != null && inst->base.type->kind == IrTypeKind::Void)
        return; /* (void)x bitcast — pure no-op */
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    /* bitcast/trunc are vreg aliases; a same-vid dst needs no code */
    if ((inst->opcode == IrOpcode::Bitcast || inst->opcode == IrOpcode::Trunc) &&
        isVRegOperand(src))
    {
        i32 sv = vmapFind(&c->vmap, src);
        if (sv >= 0 && (u32)sv == dvid) return;
    }
    /* cross-class bitcast (int<->float): real movd/movq between reg
     * files — the vreg alias path only covers same-class bitcasts. */
    if (inst->opcode == IrOpcode::Bitcast && isVRegOperand(src))
    {
        i32 sv = vmapFind(&c->vmap, src);
        u8 sk = sv >= 0 ? c->vregs[(usize)sv].klass : 0;
        u8 dk = c->vregs[(usize)dvid].klass;
        if (sk != dk)
        {
            if (sk == 1)
            {
                /* xmm -> gpr */
                i32 sp2 = sv >= 0 ? (i32)c->vregs[(usize)sv].phys : -1;
                u8 useX = sp2 >= 0 ? (u8)sp2 : regs::XMM15;
                if (sp2 < 0) loadToXmm(c, src, useX, sw);
                u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
                if (sw <= 32)
                {
                    c->emit("\tmovd "); emitXmmReg(c, useX); c->emit(", ");
                    c->emit(regForWidth(useR, 32)); c->emitLine("");
                }
                else
                {
                    c->emit("\tmovq "); emitXmmReg(c, useX); c->emit(", ");
                    c->emit(regName(useR)); c->emitLine("");
                }
                if (dp < 0) storeToVReg(c, dvid, useR, dw);
            }
            else
            {
                /* gpr -> xmm */
                u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;
                u8 useR = regs::SCRATCH_A;
                loadToReg(c, src, useR, sw);
                if (sw <= 32)
                {
                    c->emit("\tmovd "); c->emit(regForWidth(useR, 32)); c->emit(", ");
                    emitXmmReg(c, useX); c->emitLine("");
                }
                else
                {
                    c->emit("\tmovq "); c->emit(regName(useR)); c->emit(", ");
                    emitXmmReg(c, useX); c->emitLine("");
                }
                if (dp < 0) storeFromXmm(c, dvid, useX, dw);
            }
            return;
        }
    }
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    loadToReg(c, src, useR, sw);

    switch (inst->opcode)
    {
        IrOpcode::Bitcast | IrOpcode::Trunc => {
            /* same-width reinterpret or low-bits keep: the value is
             * already in useR; sub-width dst reads only low bits. */
        },
        IrOpcode::Zext => {
            if (sw <= 8) { c->emit("\tmovzbl "); emitByteReg(c, useR); c->emit(", "); c->emit(regForWidth(useR, 32)); c->emitLine(""); }
            else if (sw <= 16) { c->emit("\tmovzwl "); emitWordReg(c, useR); c->emit(", "); c->emit(regForWidth(useR, 32)); c->emitLine(""); }
            else if (sw <= 32 && dw > 32) { /* movl already zero-extended via loadToReg */ }
        },
        IrOpcode::Sext => {
            if (sw <= 8) { c->emit("\tmovsbl "); emitByteReg(c, useR); c->emit(", "); c->emit(regForWidth(useR, 32)); c->emitLine(""); }
            else if (sw <= 16) { c->emit("\tmovswl "); emitWordReg(c, useR); c->emit(", "); c->emit(regForWidth(useR, 32)); c->emitLine(""); }
            else if (sw <= 32 && dw > 32) { c->emit("\tmovslq "); c->emit(regForWidth(useR, 32)); c->emit(", "); c->emit(regName(useR)); c->emitLine(""); }
        },
        else => { }
    }
    if (dp < 0) storeToVReg(c, dvid, useR, dw);
}

/* ================= xmm (float/scalar-sse) helpers ================= */

/* load `src` into xmm phys `dphys`. w: 32=f32 movss path, else f64. */
void loadToXmm(EmitCtx* c, IrValue* src, u8 dphys, u32 w)
{
    str mv = w <= 32 ? "movss " : "movsd ";
    if (src == null)
    {
        c->emit("\txorps "); emitXmmReg(c, dphys); c->emit(", ");
        emitXmmReg(c, dphys); c->emitLine("");
        return;
    }
    if (src->kind == IrValueKind::ConstFloat || src->kind == IrValueKind::ConstInt)
    {
        /* valData holds the raw bit pattern for both kinds */
        if (w <= 32)
        {
            c->emit("\tmovl $"); c->emitU64(src->valData & 0xFFFFFFFFu); c->emit(", %r10d\n");
            c->emit("\tmovd %r10d, "); emitXmmReg(c, dphys); c->emitLine("");
        }
        else
        {
            c->emit("\tmovq $"); c->emitU64(src->valData); c->emit(", %r10\n");
            c->emit("\tmovq %r10, "); emitXmmReg(c, dphys); c->emitLine("");
        }
        return;
    }
    if (isVRegOperand(src))
    {
        i32 vid = vmapFind(&c->vmap, src);
        if (vid >= 0)
        {
            VReg* r = &c->vregs[(usize)vid];
            if (r->klass == 1)
            {
                i32 p = (i32)r->phys;
                if (p >= 0)
                {
                    if ((u8)p != dphys)
                    {
                        c->emit("\tmovaps "); emitXmmReg(c, (u8)p); c->emit(", ");
                        emitXmmReg(c, dphys); c->emitLine("");
                    }
                }
                else
                {
                    c->emit("\t"); c->emit(mv); c->emit("-");
                    c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp), ");
                    emitXmmReg(c, dphys); c->emitLine("");
                }
            }
            else if (r->klass == 0)
            {
                /* gpr-held value moving into xmm (e.g. bitcast path) */
                i32 p = (i32)r->phys;
                u8 g = p >= 0 ? (u8)p : regs::SCRATCH_A;
                if (p < 0) loadToReg(c, src, g, w);
                if (w <= 32)
                {
                    c->emit("\tmovd "); c->emit(regForWidth(g, 32)); c->emit(", ");
                    emitXmmReg(c, dphys); c->emitLine("");
                }
                else
                {
                    c->emit("\tmovq "); c->emit(regName(g)); c->emit(", ");
                    emitXmmReg(c, dphys); c->emitLine("");
                }
            }
            return;
        }
    }
    /* label / global / unknown: materialize address then load would be
     * wrong for a value — emit a comment rather than bad code */
    c->emit("\t# isel: xmm load unsupported operand\n");
}

/* store xmm phys `sphys` into vreg vid's home */
void storeFromXmm(EmitCtx* c, u32 vid, u8 sphys, u32 w)
{
    VReg* r = &c->vregs[vid];
    str mv = w <= 32 ? "movss " : "movsd ";
    if (r->phys >= 0 && r->klass == 1)
    {
        if ((u8)r->phys != sphys)
        {
            c->emit("\tmovaps "); emitXmmReg(c, sphys); c->emit(", ");
            emitXmmReg(c, (u8)r->phys); c->emitLine("");
        }
        return;
    }
    if (r->klass == 0)
    {
        u8 g = r->phys >= 0 ? (u8)r->phys : regs::SCRATCH_A;
        if (w <= 32)
        {
            c->emit("\tmovd "); emitXmmReg(c, sphys); c->emit(", ");
            c->emit(regForWidth(g, 32)); c->emitLine("");
        }
        else
        {
            c->emit("\tmovq "); emitXmmReg(c, sphys); c->emit(", ");
            c->emit(regName(g)); c->emitLine("");
        }
        if (r->phys < 0) storeToVReg(c, vid, g, w);
        return;
    }
    /* spilled xmm */
    if (r->slot >= 0)
    {
        c->emit("\t"); c->emit(mv); emitXmmReg(c, sphys); c->emit(", -");
        c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        return;
    }
    c->emit("\t# isel: xmm store nowhere to go\n");
}

/* pick dst xmm for a float-producing inst; returns phys or -1 */
i32 xmmDstPhys(EmitCtx* c, u32 vid)
{
    VReg* r = &c->vregs[vid];
    if (r->klass == 1 && r->phys >= 0) return (i32)r->phys;
    return -1;
}

/* FAdd/FSub/FMul/FDiv/FSqrt — 2-address like the int path */
void iselFArith(EmitCtx* c, IrInst* inst, str sop32, str sop64)
{
    if (inst->nops < 1) return;
    IrType* bt = inst->base.type;
    u32 w = bt != null ? bt->width : 64;
    str sop = w <= 32 ? sop32 : sop64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = xmmDstPhys(c, dvid);
    u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;

    if (inst->opcode == IrOpcode::FSqrt)
    {
        IrValue* a = inst->ops[0];
        i32 avid = isVRegOperand(a) ? vmapFind(&c->vmap, a) : -1;
        i32 ap = avid >= 0 ? (i32)c->vregs[(usize)avid].phys : -1;
        if (ap >= 0 && c->vregs[(usize)avid].klass == 1 && (u8)ap != useX)
        {
            /* sqrt directly from src reg */
            c->emit("\t"); c->emit(sop); c->emit(" ");
            emitXmmReg(c, (u8)ap); c->emit(", "); emitXmmReg(c, useX); c->emitLine("");
        }
        else
        {
            loadToXmm(c, a, useX, w);
            c->emit("\t"); c->emit(sop); c->emit(" ");
            emitXmmReg(c, useX); c->emit(", "); emitXmmReg(c, useX); c->emitLine("");
        }
        if (dp < 0) storeFromXmm(c, dvid, useX, w);
        return;
    }

    IrValue* a = inst->ops[0];
    IrValue* b = inst->ops[1];
    loadToXmm(c, a, useX, w);
    /* b: reg / spill-slot mem operand / const */
    i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
    bool done = false;
    if (bvid >= 0)
    {
        VReg* br = &c->vregs[(usize)bvid];
        if (br->klass == 1)
        {
            i32 bp = (i32)br->phys;
            if (bp >= 0)
            {
                if ((u8)bp != useX)
                {
                    c->emit("\t"); c->emit(sop); c->emit(" ");
                    emitXmmReg(c, (u8)bp); c->emit(", ");
                    emitXmmReg(c, useX); c->emitLine("");
                }
                done = true;
            }
            else if (br->slot >= 0)
            {
                c->emit("\t"); c->emit(sop); c->emit(" -");
                c->emitI64((i64)spillOff(c, br->slot)); c->emit("(%rbp), ");
                emitXmmReg(c, useX); c->emitLine("");
                done = true;
            }
        }
    }
    if (!done)
    {
        loadToXmm(c, b, regs::XMM15, w);
        c->emit("\t"); c->emit(sop); c->emit(" ");
        emitXmmReg(c, regs::XMM15); c->emit(", ");
        emitXmmReg(c, useX); c->emitLine("");
    }
    if (dp < 0) storeFromXmm(c, dvid, useX, w);
}

/* Fma = a*b+c lowered as mul+add (same as fast backend — not fused) */
void iselFma(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 3) return;
    IrType* bt = inst->base.type;
    u32 w = bt != null ? bt->width : 64;
    str ms = w <= 32 ? "mulss" : "mulsd";
    str asop = w <= 32 ? "addss" : "addsd";
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = xmmDstPhys(c, dvid);
    u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;
    IrValue*[3] ops = { inst->ops[0], inst->ops[1], inst->ops[2] };
    str[2] sops = { ms, asop };
    for (u32 i = 0; i < 3; i++)
    {
        if (i == 0) { loadToXmm(c, ops[0], useX, w); continue; }
        IrValue* v = ops[i];
        i32 bvid = isVRegOperand(v) ? vmapFind(&c->vmap, v) : -1;
        VReg* br = bvid >= 0 ? &c->vregs[(usize)bvid] : null;
        str sop = sops[i - 1];
        if (br != null && br->klass == 1)
        {
            i32 bp = (i32)br->phys;
            if (bp >= 0)
            {
                c->emit("\t"); c->emit(sop); c->emit(" ");
                emitXmmReg(c, (u8)bp); c->emit(", ");
                emitXmmReg(c, useX); c->emitLine("");
                continue;
            }
            if (br->slot >= 0)
            {
                c->emit("\t"); c->emit(sop); c->emit(" -");
                c->emitI64((i64)spillOff(c, br->slot)); c->emit("(%rbp), ");
                emitXmmReg(c, useX); c->emitLine("");
                continue;
            }
        }
        loadToXmm(c, v, regs::XMM15, w);
        c->emit("\t"); c->emit(sop); c->emit(" ");
        emitXmmReg(c, regs::XMM15); c->emit(", ");
        emitXmmReg(c, useX); c->emitLine("");
    }
    if (dp < 0) storeFromXmm(c, dvid, useX, w);
}

/* FAbs: clear the sign bit in the raw fp bits via gpr btr */
void iselFAbs(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 1) return;
    IrType* bt = inst->base.type;
    u32 w = bt != null ? bt->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = xmmDstPhys(c, dvid);
    u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;
    loadToXmm(c, inst->ops[0], useX, w);
    u8 g = regs::SCRATCH_A;
    if (w <= 32)
    {
        c->emit("\tmovd "); emitXmmReg(c, useX); c->emit(", ");
        c->emit(regForWidth(g, 32)); c->emitLine("");
        c->emit("\tbtrl $31, "); c->emit(regForWidth(g, 32)); c->emitLine("");
        c->emit("\tmovd "); c->emit(regForWidth(g, 32)); c->emit(", ");
        emitXmmReg(c, useX); c->emitLine("");
    }
    else
    {
        c->emit("\tmovq "); emitXmmReg(c, useX); c->emit(", ");
        c->emit(regName(g)); c->emitLine("");
        c->emit("\tbtrq $63, "); c->emit(regName(g)); c->emitLine("");
        c->emit("\tmovq "); c->emit(regName(g)); c->emit(", ");
        emitXmmReg(c, useX); c->emitLine("");
    }
    if (dp < 0) storeFromXmm(c, dvid, useX, w);
}

/* FCmp -> i1 in a gpr. Mirrors fast backend's ucomiss/setcc logic. */
void iselFCmp(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 2) return;
    IrValue* a = inst->ops[0];
    IrValue* b = inst->ops[1];
    u32 w = a->type != null ? a->type->width : 64;
    str uop = w <= 32 ? "ucomiss " : "ucomisd ";
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    u8 useX = regs::XMM15;
    /* a into an xmm: its own phys when available, else scratch */
    i32 avid = isVRegOperand(a) ? vmapFind(&c->vmap, a) : -1;
    i32 ap = avid >= 0 ? (i32)c->vregs[(usize)avid].phys : -1;
    if (ap >= 0 && c->vregs[(usize)avid].klass == 1)
        useX = (u8)ap;
    else
        loadToXmm(c, a, useX, w);
    /* b: spilled -> mem operand, else xmm14 scratch... need a 2nd xmm.
     * xmm14 is allocatable; use it only if no vreg owns it. */
    i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
    u8 bx = 0xFF;
    bool bmem = false;
    i32 bspill = -1;
    if (bvid >= 0)
    {
        VReg* br = &c->vregs[(usize)bvid];
        if (br->klass == 1)
        {
            i32 bp = (i32)br->phys;
            if (bp >= 0) bx = (u8)bp;
            else if (br->slot >= 0) { bmem = true; bspill = spillOff(c, br->slot); }
        }
    }
    if (!bmem && bx == 0xFF)
    {
        /* const/unknown b: find a scratch xmm != xmm15 */
        bx = xmmScratch2(c, useX);
        if (bx == 0xFF)
        {
            c->emit("\t# isel: fcmp needs second xmm scratch\n");
            return;
        }
        loadToXmm(c, b, bx, w);
    }
    c->emit("\t"); c->emit(uop);
    if (bmem)
    {
        c->emit("-"); c->emitU64((u64)bspill); c->emit("(%rbp), ");
    }
    else emitXmmReg(c, bx);
    c->emit(", "); emitXmmReg(c, useX); c->emitLine("");

    str setInst = "sete";
    u32 fmode = 0;
    switch (inst->fcmpPred)
    {
        IrFCmpPred::Oeq => { setInst = "sete"; fmode = 1; },
        IrFCmpPred::One => { setInst = "setne"; fmode = 1; },
        IrFCmpPred::Olt => { setInst = "setb"; fmode = 1; },
        IrFCmpPred::Ole => { setInst = "setbe"; fmode = 1; },
        IrFCmpPred::Ogt => { setInst = "seta"; fmode = 0; },
        IrFCmpPred::Oge => { setInst = "setae"; fmode = 1; },
        IrFCmpPred::Ueq => { setInst = "sete"; fmode = 2; },
        IrFCmpPred::Une => { setInst = "setne"; fmode = 2; },
        IrFCmpPred::Ult => { setInst = "setb"; fmode = 0; },
        IrFCmpPred::Ule => { setInst = "setbe"; fmode = 0; },
        IrFCmpPred::Ugt => { setInst = "seta"; fmode = 2; },
        IrFCmpPred::Uge => { setInst = "setae"; fmode = 2; },
        else => { setInst = "sete"; fmode = 0; }
    }
    c->emit("\t"); c->emit(setInst); c->emit(" ");
    emitByteReg(c, useR); c->emitLine("");
    if (fmode == 1)
    {
        c->emit("\tsetnp %r10b\n");
        c->emit("\tandb %r10b, "); emitByteReg(c, useR); c->emitLine("");
    }
    else if (fmode == 2)
    {
        c->emit("\tsetp %r10b\n");
        c->emit("\torb %r10b, "); emitByteReg(c, useR); c->emitLine("");
    }
    c->emit("\tmovzbl "); emitByteReg(c, useR); c->emit(", ");
    c->emit(regForWidth(useR, 32)); c->emitLine("");
    if (dp < 0) storeToVReg(c, dvid, useR, 32);
}

/* second scratch xmm: xmm15 when not `avoid`, else xmm14 if free */
u8 xmmScratch2(EmitCtx* c, u8 avoid)
{
    if (avoid != regs::XMM15) return regs::XMM15;
    for (u32 i = 0; i < c->nvregs; i++)
        if (c->vregs[i].klass == 1 && c->vregs[i].phys == 14) return 0xFF;
    return 14;
}

/* float<->int and float<->float casts */
void iselFCast(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 1) return;
    IrValue* src = inst->ops[0];
    IrType* st = src->type;
    u32 sw = st != null ? st->width : 64;
    IrType* dt = inst->base.type;
    u32 dw = dt != null ? dt->width : 64;
    u32 dvid = c->vregFor(&inst->base);

    switch (inst->opcode)
    {
        IrOpcode::FpTrunc | IrOpcode::FpExt =>
        {
            /* f64<->f32 through xmm; dst is xmm-class */
            i32 dp = xmmDstPhys(c, dvid);
            u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;
            str cvt = inst->opcode == IrOpcode::FpTrunc ? "cvtsd2ss " : "cvtss2sd ";
            /* src into xmm: prefer direct reg form when possible */
            i32 sv = isVRegOperand(src) ? vmapFind(&c->vmap, src) : -1;
            i32 sp = sv >= 0 ? (i32)c->vregs[(usize)sv].phys : -1;
            if (sp >= 0 && c->vregs[(usize)sv].klass == 1 && (u8)sp != useX)
            {
                c->emit("\t"); c->emit(cvt); emitXmmReg(c, (u8)sp);
                c->emit(", "); emitXmmReg(c, useX); c->emitLine("");
            }
            else
            {
                loadToXmm(c, src, useX, sw);
                c->emit("\t"); c->emit(cvt); emitXmmReg(c, useX);
                c->emit(", "); emitXmmReg(c, useX); c->emitLine("");
            }
            if (dp < 0) storeFromXmm(c, dvid, useX, dw);
        },
        IrOpcode::SiToFp | IrOpcode::UiToFp =>
        {
            i32 dp = xmmDstPhys(c, dvid);
            u8 useX = dp >= 0 ? (u8)dp : regs::XMM15;
            bool toF32 = dw <= 32;
            str cvt = toF32 ? "cvtsi2ss " : "cvtsi2sd ";
            str adds = toF32 ? "addss " : "addsd ";
            u8 g = regs::SCRATCH_A;
            loadToReg(c, src, g, sw);
            if (inst->opcode == IrOpcode::UiToFp && sw > 32)
            {
                /* (v>>1)*2 + (v&1): both halves fit in signed i64 */
                u8 bx = xmmScratch2(c, useX);
                if (bx == 0xFF)
                {
                    c->emit("\t# isel: uitofp64 needs 2nd xmm\n");
                    return;
                }
                c->emit("\tmovq "); c->emit(regName(g)); c->emit(", %r11\n");
                c->emit("\tmovq %r11, %r10\n");
                c->emit("\tshrq $1, %r11\n");
                c->emit("\tandq $1, %r10\n");
                c->emit("\t"); c->emit(cvt); c->emit("%r11, ");
                emitXmmReg(c, useX); c->emitLine("");
                c->emit("\t"); c->emit(adds); emitXmmReg(c, useX); c->emit(", ");
                emitXmmReg(c, useX); c->emitLine("");
                c->emit("\t"); c->emit(cvt); c->emit("%r10, ");
                emitXmmReg(c, bx); c->emitLine("");
                c->emit("\t"); c->emit(adds); emitXmmReg(c, bx); c->emit(", ");
                emitXmmReg(c, useX); c->emitLine("");
                if (dp < 0) storeFromXmm(c, dvid, useX, dw);
                return;
            }
            c->emit("\t"); c->emit(cvt); c->emit(regForWidth(g, sw <= 32 ? 32 : 64));
            c->emit(", "); emitXmmReg(c, useX); c->emitLine("");
            if (dp < 0) storeFromXmm(c, dvid, useX, dw);
        },
        IrOpcode::FpToSi | IrOpcode::FpToUi =>
        {
            /* cvtt -> gpr; unsigned >INT64_MAX is a known gap (same as fast) */
            i32 dp = (i32)c->vregs[(usize)dvid].phys;
            u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
            bool fromF32 = sw <= 32;
            u8 useX = regs::XMM15;
            loadToXmm(c, src, useX, sw);
            c->emit("\tcvtt"); c->emit(fromF32 ? "ss" : "sd"); c->emit("2si ");
            emitXmmReg(c, useX); c->emit(", ");
            c->emit(regForWidth(useR, dw <= 32 ? 32 : 64)); c->emitLine("");
            if (dp < 0) storeToVReg(c, dvid, useR, dw);
        },
        else => { c->emit("\t# isel: unhandled fcast\n"); }
    }
}

/* unary bit ops: popcnt/lzcnt/tzcnt/bswap/rot — dst = op(src) */
void iselBitop(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 1) return;
    IrValue* src = inst->ops[0];
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    loadToReg(c, src, useR, w);
    str suff = w <= 32 ? "l" : "q";
    switch (inst->opcode)
    {
        IrOpcode::CtPop | IrOpcode::CtLz | IrOpcode::CtTz =>
        {
            /* no 8/16-bit forms: zero-extend into 32 bits, run the
             * 32/64-bit op; lzcnt needs a width bias correction */
            str mn = inst->opcode == IrOpcode::CtPop ? "popcnt" :
                     inst->opcode == IrOpcode::CtLz ? "lzcnt" : "tzcnt";
            u32 bias = 0;
            if (w <= 8)
            {
                c->emit("\tmovzbl "); emitByteReg(c, useR); c->emit(", ");
                c->emit(regForWidth(useR, 32)); c->emitLine("");
                bias = 24;
            }
            else if (w <= 16)
            {
                c->emit("\tmovzwl "); emitWordReg(c, useR); c->emit(", ");
                c->emit(regForWidth(useR, 32)); c->emitLine("");
                bias = 16;
            }
            u32 ow = w >= 64 ? 64 : 32;
            str oreg = regForWidth(useR, ow);
            c->emit("\t"); c->emit(mn); c->emit(intSfx(ow)); c->emit(" ");
            c->emit(oreg); c->emit(", "); c->emit(oreg); c->emitLine("");
            if (bias > 0 && inst->opcode == IrOpcode::CtLz)
            {
                c->emit("\tsubl $"); c->emitU64((u64)bias); c->emit(", ");
                c->emit(regForWidth(useR, 32)); c->emitLine("");
            }
        },
        IrOpcode::Bswap =>
        {
            if (w <= 8) { /* single byte: identity */ }
            else if (w <= 16)
            {
                /* no bswap r16: rotate the 16-bit reg by 8 */
                c->emit("\trolw $8, "); emitWordReg(c, useR); c->emitLine("");
            }
            else
            {
                c->emit("\tbswap"); c->emit(suff); c->emit(" ");
                c->emit(regForWidth(useR, regW(w))); c->emitLine("");
            }
        },
        IrOpcode::Rotl | IrOpcode::Rotr =>
        {
            /* count in %cl for non-const (same dance as iselShift) */
            bool left = inst->opcode == IrOpcode::Rotl;
            IrValue* cnt = inst->nops > 1 ? inst->ops[1] : null;
            str sop = left ? "rol" : "ror";
            str rsfx = intSfx(w);
            if (cnt != null && cnt->kind == IrValueKind::ConstInt)
            {
                u64 k = cnt->valData & (w >= 64 ? 63 : 31);
                c->emit("\t"); c->emit(sop); c->emit(rsfx); c->emit(" $");
                c->emitU64(k); c->emit(", "); emitRegExact(c, useR, w); c->emitLine("");
            }
            else
            {
                i32 cvid = isVRegOperand(cnt) ? vmapFind(&c->vmap, cnt) : -1;
                i32 cp = cvid >= 0 ? c->vregs[(usize)cvid].phys : -1;
                if (cp == (i32)regs::RCX)
                {
                    c->emit("\t"); c->emit(sop); c->emit(rsfx); c->emit(" %cl, ");
                    emitRegExact(c, useR, w); c->emitLine("");
                }
                else if (useR == regs::RCX)
                {
                    c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
                    emitRegExact(c, regs::RCX, w); c->emit(", ");
                    emitRegExact(c, regs::SCRATCH_A, w); c->emitLine("");
                    loadToReg(c, cnt, regs::RCX, w);
                    c->emit("\t"); c->emit(sop); c->emit(rsfx); c->emit(" %cl, ");
                    emitRegExact(c, regs::SCRATCH_A, w); c->emitLine("");
                    c->emit("\tmov"); c->emit(intSfx(w)); c->emit(" ");
                    emitRegExact(c, regs::SCRATCH_A, w); c->emit(", ");
                    emitRegExact(c, regs::RCX, w); c->emitLine("");
                }
                else
                {
                    c->emitLine("\tpushq %rcx");
                    loadToReg(c, cnt, regs::RCX, w);
                    c->emit("\t"); c->emit(sop); c->emit(rsfx); c->emit(" %cl, ");
                    emitRegExact(c, useR, w); c->emitLine("");
                    c->emitLine("\tpopq %rcx");
                }
            }
        },
        else => { }
    }
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

/* MulHi/SMulHi: high half of the 2w-bit product.
 * w>=32: mul/imul leaves it in rdx. w<32: canonicalize operands to
 * 32 bits, mul32 (product fits in eax), then shift eax right by w. */
void iselMulHi(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 2) return;
    IrValue* a = inst->ops[0];
    IrValue* b = inst->ops[1];
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    bool sgn = inst->opcode == IrOpcode::SMulHi;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_B;
    u8 ra = regs::RAX;
    u8 rc = regs::SCRATCH_A;
    /* canonicalize <=16-bit operands into 32-bit regs first — a 64-bit
     * mul would read garbage upper bits */
    loadToReg(c, a, ra, w);
    if (w <= 8)
    {
        c->emit("\t"); c->emit(sgn ? "movsbl %al, %eax" : "movzbl %al, %eax"); c->emitLine("");
    }
    else if (w <= 16)
    {
        c->emit("\t"); c->emit(sgn ? "movswl %ax, %eax" : "movzwl %ax, %eax"); c->emitLine("");
    }
    loadToReg(c, b, rc, w);
    if (w <= 8)
    {
        c->emit("\t"); c->emit(sgn ? "movsbl %cl, %ecx" : "movzbl %cl, %ecx"); c->emitLine("");
    }
    else if (w <= 16)
    {
        c->emit("\t"); c->emit(sgn ? "movswl %cx, %ecx" : "movzwl %cx, %ecx"); c->emitLine("");
    }
    bool bInSlot = false;
    i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
    VReg* br = bvid >= 0 ? &c->vregs[(usize)bvid] : null;
    if (br != null && br->phys < 0 && br->slot >= 0) bInSlot = true;
    /* for narrow widths b was already materialized into rcx above;
     * the slot form only applies at w>=32 where we skipped loadToReg? —
     * loadToReg always ran, so rcx always holds b. Use reg form. */
    c->emit("\t"); c->emit(sgn ? "imul" : "mul");
    c->emit(w >= 64 ? "q" : "l"); c->emit(" ");
    c->emit(regForWidth(rc, w >= 64 ? 64 : 32)); c->emitLine("");
    (void)bInSlot;
    if (w < 32)
    {
        /* product sits in eax; high w bits = eax >>w */
        c->emit("\tmovl %eax, "); c->emit(regForWidth(useR, 32)); c->emitLine("");
        c->emit("\t"); c->emit(sgn ? "sarl" : "shrl"); c->emit(" $");
        c->emitU64((u64)w); c->emit(", "); c->emit(regForWidth(useR, 32)); c->emitLine("");
    }
    else
    {
        /* 32-bit mul zero-extends rdx, so movq %rdx works for w=32 too */
        c->emit("\tmovq %rdx, "); c->emit(regName(useR)); c->emitLine("");
        if (w == 32) { /* dst i32 reads low 32 = edx */ }
    }
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

/* SMin/SMax/UMin/UMax: dst=a; cmp b,a; cmov */
void iselMinMax(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 2) return;
    IrValue* a = inst->ops[0];
    IrValue* b = inst->ops[1];
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    /* dst starts as a; b overwrites when it wins */
    loadToReg(c, a, useR, w);
    i32 bvid = isVRegOperand(b) ? vmapFind(&c->vmap, b) : -1;
    VReg* br = bvid >= 0 ? &c->vregs[(usize)bvid] : null;
    str suff = w <= 32 ? "l" : "q";
    bool bInSlot = br != null && br->phys < 0 && br->slot >= 0;
    u8 bs = regs::SCRATCH_B;
    /* materialize b into a reg BEFORE the cmp line — loadToReg emits
     * whole lines and can't interleave inside an operand */
    if (!bInSlot) loadToReg(c, b, bs, w);
    c->emit("\tcmp"); c->emit(suff); c->emit(" ");
    if (bInSlot)
    {
        c->emit("-"); c->emitI64((i64)spillOff(c, br->slot)); c->emit("(%rbp), ");
    }
    else c->emit(regForWidth(bs, w));
    c->emit(", "); c->emit(regForWidth(useR, w)); c->emitLine("");
    /* after cmp b,a: a-b. want dst=b when:
     *  smin: a>b (SF!=OF -> use cmovg on a-b? a-b>0 => a>b) -> cmovg
     *  Actually cmp src,dst computes dst-src = a-b. */
    str cc = "";
    bool hascc = false;
    switch (inst->opcode)
    {
        IrOpcode::SMin => { cc = "cmovg "; hascc = true; },  /* a>b -> take b */
        IrOpcode::SMax => { cc = "cmovl "; hascc = true; },  /* a<b -> take b */
        IrOpcode::UMin => { cc = "cmova "; hascc = true; },  /* a>b unsigned -> take b */
        IrOpcode::UMax => { cc = "cmovb "; hascc = true; },  /* a<b unsigned -> take b */
        else => { }
    }
    if (hascc)
    {
        /* bs already holds b unless it was a slot operand */
        if (bInSlot)
        {
            c->emit("\tmov"); c->emit(suff); c->emit(" -");
            c->emitI64((i64)spillOff(c, br->slot)); c->emit("(%rbp), ");
            c->emit(regForWidth(bs, w)); c->emitLine("");
        }
        c->emit("\t"); c->emit(cc); c->emit(regForWidth(bs, w)); c->emit(", ");
        c->emit(regForWidth(useR, w)); c->emitLine("");
    }
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

/* Abs: dst = |a| via sign-mask */
void iselAbs(EmitCtx* c, IrInst* inst)
{
    if (inst->nops < 1) return;
    IrValue* src = inst->ops[0];
    u32 w = inst->base.type != null ? inst->base.type->width : 64;
    u32 dvid = c->vregFor(&inst->base);
    i32 dp = (i32)c->vregs[(usize)dvid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    u8 ms = regs::SCRATCH_B;
    loadToReg(c, src, useR, w);
    /* narrow operands: sign-extend into 32 bits so the mask idiom
     * sees a clean sign bit (upper bits may be garbage) */
    if (w <= 8)
    {
        c->emit("\tmovsbl "); emitByteReg(c, useR); c->emit(", ");
        c->emit(regForWidth(useR, 32)); c->emitLine("");
        w = 32;
    }
    else if (w <= 16)
    {
        c->emit("\tmovswl "); emitWordReg(c, useR); c->emit(", ");
        c->emit(regForWidth(useR, 32)); c->emitLine("");
        w = 32;
    }
    /* ms = a >>s (w-1) ; useR = (a ^ ms) - ms */
    c->emit("\tmov"); c->emit(w <= 32 ? "l" : "q"); c->emit(" ");
    c->emit(regForWidth(useR, w)); c->emit(", ");
    c->emit(regForWidth(ms, w)); c->emitLine("");
    c->emit("\tsar"); c->emit(w <= 32 ? "l" : "q"); c->emit(" $");
    c->emitU64((u64)(w - 1)); c->emit(", "); c->emit(regForWidth(ms, w)); c->emitLine("");
    c->emit("\txor"); c->emit(w <= 32 ? "l" : "q"); c->emit(" ");
    c->emit(regForWidth(ms, w)); c->emit(", "); c->emit(regForWidth(useR, w)); c->emitLine("");
    c->emit("\tsub"); c->emit(w <= 32 ? "l" : "q"); c->emit(" ");
    c->emit(regForWidth(ms, w)); c->emit(", "); c->emit(regForWidth(useR, w)); c->emitLine("");
    if (dp < 0) storeToVReg(c, dvid, useR, w);
}

/* phys reg currently holding `av`, or -1 for const/mem/global/unmapped */
i32 callArgSrcPhys(EmitCtx* c, IrValue* av)
{
    if (av == null || !isVRegOperand(av)) return -1;
    i32 vid = vmapFind(&c->vmap, av);
    if (vid < 0) return -1;
    return c->vregs[(usize)vid].phys;
}

/* store one integer stack arg at `off(%rsp)` (off already final) */
void emitIntStackArg(EmitCtx* c, IrValue* av, u32 off)
{
    if (av != null && av->kind == IrValueKind::ConstInt &&
        (av->valData >> 32) == 0)
    {
        c->emit("\tmovq $"); c->emitU64(av->valData); c->emit(", ");
        c->emitI64((i64)off); c->emit("(%rsp)\n");
        return;
    }
    loadToReg(c, av, regs::SCRATCH_A, 64);
    c->emit("\tmovq %r10, "); c->emitI64((i64)off); c->emit("(%rsp)\n");
}

/* move the call result (rax/xmm0) into the dst vreg */
void emitCallResult(EmitCtx* c, IrInst* inst)
{
    if (inst->base.type == null || inst->base.type->kind == IrTypeKind::Void)
        return;
    if (typeIsSse(inst->base.type))
    {
        u32 dvid = c->vregFor(&inst->base);
        i32 dp = (i32)c->vregs[(usize)dvid].phys;
        if (dp >= 0 && c->vregs[(usize)dvid].klass == 1)
        {
            c->emit("\tmovaps "); emitXmmReg(c, 0); c->emit(", ");
            emitXmmReg(c, (u8)dp); c->emitLine("");
        }
        else if (dp < 0)
        {
            c->emit("\tmovups "); emitXmmReg(c, 0); c->emit(", -");
            c->emitI64((i64)spillOff(c, c->vregs[(usize)dvid].slot));
            c->emit("(%rbp)\n");
        }
        return;
    }
    u32 dvid = c->vregFor(&inst->base);
    u32 w = inst->base.type->kind == IrTypeKind::Int ? inst->base.type->width : 64;
    storeToVReg(c, dvid, regs::RAX, w);
}

void iselCall(EmitCtx* c, IrInst* inst)
{
    c->memClear();
    IrValue* fv = inst->nops > 0 ? inst->ops[0] : null;
    if (fv == null || (fv->kind != IrValueKind::Func && fv->kind != IrValueKind::Global))
    {
        c->emit("\t# isel: indirect/unsupported call target\n");
        return;
    }
    str fname = asmSymName(fv);
    u32 nargs = inst->nops > 1 ? inst->nops - 1 : 0;
    if (nargs > 32)
    {
        c->emit("\t# isel: too many call args\n");
        return;
    }

    /* classify each arg; int->rdi..r9, sse->xmm0-7, overflow->stack */
    ArgClass* cls = alloc<ArgClass>(32);
    u8* dstK = alloc<u8>(32);    /* 0=int reg idx, 1=xmm reg idx, 2=stack slot idx */
    u8* dstI = alloc<u8>(32);
    u32 nInt = 0;
    u32 nXmm = 0;
    u32 nStack = 0;
    for (u32 i = 0; i < nargs; i++)
    {
        IrValue* av = inst->ops[i + 1];
        ArgClass cl = classifyArg(av);
        cls[i] = cl;
        if (cl == ArgClass::INTEGER)
        {
            if (nInt < 6) { dstK[i] = 0; dstI[i] = (u8)nInt; nInt++; }
            else { dstK[i] = 2; dstI[i] = (u8)nStack; nStack++; }
        }
        else if (cl == ArgClass::SSE)
        {
            if (nXmm < 8) { dstK[i] = 1; dstI[i] = (u8)nXmm; nXmm++; }
            else { dstK[i] = 2; dstI[i] = (u8)nStack; nStack++; }
        }
        else { dstK[i] = 2; dstI[i] = (u8)nStack; nStack++; }
    }

    /* fast path: no SSE args -> store stack args first, then move the
     * <=6 integer arg regs directly in a parallel-copy-safe order.
     * Falls back to the temp-stack path if the order has a cycle. */
    bool direct = (nXmm == 0);
    u8[6] dOrder;
    u32 dN = 0;
    u8[6] emDst;
    IrValue*[6] emSrc;
    if (direct)
    {
        u8[6] dmDst;
        i32[6] dmPhys;
        u8[6] dmDone;
        u32 dn = 0;
        u32 en = 0;
        for (u32 i = 0; i < nargs; i++)
        {
            if (dstK[i] != 0) continue;
            u8 dp2 = argRegPhys(dstI[i]);
            IrValue* av = inst->ops[i + 1];
            emDst[en] = dp2;
            emSrc[en] = av;
            en++;
            if (dn < 6)
            {
                dmDst[dn] = dp2;
                dmPhys[dn] = callArgSrcPhys(c, av);
                dmDone[dn] = 0;
                dn++;
            }
        }
        u32 dRem = dn;
        bool ok = true;
        while (dRem > 0 && ok)
        {
            bool prog = false;
            for (u32 t = 0; t < dn; t++)
            {
                if (dmDone[t]) continue;
                if ((i32)dmDst[t] == dmPhys[t]) { dmDone[t] = 1; dRem--; prog = true; continue; }
                bool blocked = false;
                for (u32 u = 0; u < dn; u++)
                    if (!dmDone[u] && dmPhys[u] == (i32)dmDst[t]) { blocked = true; break; }
                if (!blocked) { dOrder[dN++] = (u8)t; dmDone[t] = 1; dRem--; prog = true; }
            }
            if (!prog) ok = false;
        }
        if (!ok || en != dn) direct = false;
        else
        {
            u32 dSub = nStack * 8;
            if (dSub > 0 && (dSub % 16) == 8) dSub += 8;
            if (dSub > 0)
            {
                c->emit("\tsubq $"); c->emitI64((i64)dSub); c->emit(", %rsp\n");
            }
            for (u32 i = 0; i < nargs; i++)
                if (dstK[i] == 2) emitIntStackArg(c, inst->ops[i + 1], (u32)dstI[i] * 8);
            for (u32 oi = 0; oi < dN; oi++)
                loadToReg(c, emSrc[dOrder[oi]], emDst[dOrder[oi]], 64);
            IrType* fty2 = fv->kind == IrValueKind::Func ? ((IrFunc*)fv)->base.type : null;
            if (fty2 != null && fty2->isVararg)
            {
                c->emit("\tmovb $0, %al\n");
            }
            c->emit("\tcall "); c->emit(fname); c->emitLine("");
            if (dSub > 0)
            {
                c->emit("\taddq $"); c->emitI64((i64)dSub); c->emit(", %rsp\n");
            }
            emitCallResult(c, inst);
            dealloc<ArgClass>(cls);
            dealloc<u8>(dstK);
            dealloc<u8>(dstI);
            return;
        }
    }

    /* temp slots for reg-class args live above the stack args:
     * stack args occupy rsp+0..nStack*8 (final), temps at
     * (nStack + t)*8. Total area padded to 16B. */
    u32 nTemp = nInt + nXmm;
    u32 totalSlots = nStack + nTemp;
    u32 subBytes = totalSlots * 8;
    if (subBytes > 0 && (subBytes % 16) == 8) subBytes += 8;
    if (subBytes > 0)
    {
        c->emit("\tsubq $"); c->emitI64((i64)subBytes); c->emit(", %rsp\n");
    }

    /* phase 1: evaluate every arg into its temp/final slot */
    u32 ti = 0;
    for (u32 i = 0; i < nargs; i++)
    {
        IrValue* av = inst->ops[i + 1];
        u32 off;
        if (dstK[i] == 2) off = (u32)dstI[i] * 8;
        else { off = (nStack + ti) * 8; ti++; }
        if (cls[i] == ArgClass::SSE)
        {
            /* xmm value -> 16B temp; use xmm15 scratch for spilled */
            i32 vid = isVRegOperand(av) ? vmapFind(&c->vmap, av) : -1;
            u32 sz = av != null && av->type != null ? typeSizeBytes(av->type) : 8;
            c->emit("\tmovups ");
            if (vid >= 0 && c->vregs[(usize)vid].phys >= 0)
            {
                emitXmmReg(c, (u8)c->vregs[(usize)vid].phys);
            }
            else if (vid >= 0)
            {
                c->emit("-"); c->emitI64((i64)spillOff(c, c->vregs[(usize)vid].slot));
                c->emit("(%rbp)");
            }
            else
            {
                /* const/other: zero the temp (approximation) */
                c->emit("# isel: sse const arg unsupported\n");
                continue;
            }
            c->emit(", "); c->emitI64((i64)off); c->emit("(%rsp)\n");
            (void)sz;
        }
        else
        {
            if (av != null && av->kind == IrValueKind::ConstInt &&
                (av->valData >> 32) == 0)
            {
                c->emit("\tmovq $"); c->emitU64(av->valData); c->emit(", ");
                c->emitI64((i64)off); c->emit("(%rsp)\n");
            }
            else
            {
                loadToReg(c, av, regs::SCRATCH_A, 64);
                c->emit("\tmovq %r10, "); c->emitI64((i64)off); c->emit("(%rsp)\n");
            }
        }
    }

    /* phase 2: temps -> ABI registers */
    ti = 0;
    for (u32 i = 0; i < nargs; i++)
    {
        if (dstK[i] == 2) continue;
        u32 off = (nStack + ti) * 8;
        ti++;
        if (dstK[i] == 0)
        {
            c->emit("\tmovq "); c->emitI64((i64)off); c->emit("(%rsp), ");
            c->emit(regName(argRegPhys(dstI[i]))); c->emitLine("");
        }
        else
        {
            c->emit("\tmovups "); c->emitI64((i64)off); c->emit("(%rsp), ");
            emitXmmReg(c, dstI[i]); c->emitLine("");
        }
    }

    /* varargs: AL = number of vector regs used */
    IrType* fty = fv->kind == IrValueKind::Func ? ((IrFunc*)fv)->base.type : null;
    if (fty != null && fty->isVararg)
    {
        c->emit("\tmovb $"); c->emitU64((u64)nXmm); c->emitLine(", %al");
    }

    c->emit("\tcall "); c->emit(fname); c->emitLine("");
    if (subBytes > 0)
    {
        c->emit("\taddq $"); c->emitI64((i64)subBytes); c->emit(", %rsp\n");
    }
    emitCallResult(c, inst);
    dealloc<ArgClass>(cls);
    dealloc<u8>(dstK);
    dealloc<u8>(dstI);
}

/* ================= phi copies ================= */

void emitCopyToVReg(EmitCtx* c, IrValue* src, u32 dstVid, u32 w)
{
    i32 dp = (i32)c->vregs[(usize)dstVid].phys;
    u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
    loadToReg(c, src, useR, w);
    storeToVReg(c, dstVid, useR, w);
}

/* true when copying src into dstVid needs no instruction: same vreg,
 * or both already sit in the same phys reg. */
bool phiSrcIsIdentity(EmitCtx* c, u32 dvid, IrValue* src)
{
    i32 svid = isVRegOperand(src) ? vmapFind(&c->vmap, src) : -1;
    if (svid < 0) return false;
    if ((u32)svid == dvid) return true;
    VReg* dr = &c->vregs[(usize)dvid];
    VReg* sr = &c->vregs[(usize)svid];
    return dr->phys >= 0 && sr->phys == dr->phys;
}

u32 phiCopyCountFor(EmitCtx* c, IrBlock* pred, IrBlock* sb)
{
    if (pred == null || sb == null) return 0;
    u32 n = 0;
    for (u32 pi = 0; pi < sb->ninsts; pi++)
    {
        IrInst* phi = sb->insts[pi];
        if (phi == null || phi->opcode != IrOpcode::Phi) break;
        u32 dvid = c->vregFor(&phi->base);
        for (u32 k = 0; k + 1 < phi->nops; k += 2)
            if (phi->ops[k + 1] == &pred->base && phi->ops[k] != null &&
                !phiSrcIsIdentity(c, dvid, phi->ops[k])) n++;
    }
    return n;
}

void emitPhiCopiesFor(EmitCtx* c, IrBlock* pred, IrBlock* sb)
{
    if (pred == null || sb == null) return;
    /* gather (dstVid, src) pairs for phis in this successor */
    u32[256] ddst;
    IrValue*[256] ssrc;
    i32[256] scoef; /* -1 = normal src, >=0 = scratch reg index */
    u32 n = 0;
    for (u32 pi = 0; pi < sb->ninsts && n < 256; pi++)
    {
        IrInst* phi = sb->insts[pi];
        if (phi == null || phi->opcode != IrOpcode::Phi) break;
        u32 dvid = c->vregFor(&phi->base);
        for (u32 k = 0; k + 1 < phi->nops && n < 256; k += 2)
        {
            if (phi->ops[k + 1] == &pred->base && phi->ops[k] != null &&
                !phiSrcIsIdentity(c, dvid, phi->ops[k]))
            {
                ddst[n] = dvid;
                ssrc[n] = phi->ops[k];
                scoef[n] = -1;
                n++;
            }
        }
    }
    if (n == 0) return;
    u8[256] done;
    for (u32 i = 0; i < n; i++) done[i] = 0;
    u8[2] scrBusy = { 0, 0 };
    u32 remaining = n;
    while (remaining > 0)
    {
        bool progress = false;
        for (u32 i = 0; i < n; i++)
        {
            if (done[i]) continue;
            /* conflict: src vreg is itself a pending dst */
            i32 svid = scoef[i] < 0 && isVRegOperand(ssrc[i])
                       ? vmapFind(&c->vmap, ssrc[i]) : -1;
            bool conflict = false;
            if (svid >= 0)
            {
                for (u32 j = 0; j < n; j++)
                    if (!done[j] && ddst[j] == (u32)svid) { conflict = true; break; }
            }
            if (conflict) continue;
            /* emit */
            u32 w = c->vregs[(usize)ddst[i]].type != null
                    ? c->vregs[(usize)ddst[i]].type->width : 64;
            if (scoef[i] >= 0)
            {
                /* src is scratch reg r10/r11 */
                i32 dp = (i32)c->vregs[(usize)ddst[i]].phys;
                u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
                if (scoef[i] == 0) storeToVReg(c, ddst[i], regs::SCRATCH_A, w);
                else storeToVReg(c, ddst[i], regs::SCRATCH_B, w);
                (void)useR;
            }
            else emitCopyToVReg(c, ssrc[i], ddst[i], w);
            done[i] = 1;
            remaining--;
            progress = true;
        }
        if (!progress && remaining > 0)
        {
            /* cycle: break via scratch r10 (idx0) or r11 (idx1) */
            u32 i = 0;
            while (i < n && (done[i] || scoef[i] >= 0)) i++;
            if (i >= n) break;
            u32 w = c->vregs[(usize)ddst[i]].type != null
                    ? c->vregs[(usize)ddst[i]].type->width : 64;
            u32 scrIdx = scrBusy[0] ? 1 : 0;
            if (scrBusy[0] && scrBusy[1])
            {
                c->emit("\t# phi cycle overflow\n");
                for (u32 j = 0; j < n; j++) done[j] = 1;
                break;
            }
            scrBusy[scrIdx] = 1;
            u8 scr = scrIdx == 0 ? regs::SCRATCH_A : regs::SCRATCH_B;
            /* save src_i into scratch */
            loadToReg(c, ssrc[i], scr, w);
            /* all pending copies whose src == ssrc_i vreg now read scratch */
            i32 svid = isVRegOperand(ssrc[i]) ? vmapFind(&c->vmap, ssrc[i]) : -1;
            for (u32 j = 0; j < n; j++)
            {
                if (done[j] || j == i) continue;
                if (scoef[j] < 0 && svid >= 0 && isVRegOperand(ssrc[j]) &&
                    vmapFind(&c->vmap, ssrc[j]) == svid)
                    scoef[j] = (i32)scrIdx;
            }
            scoef[i] = (i32)scrIdx;
            /* dst_i now reads scratch — will resolve next pass since
             * scratch isn't a vreg dst */
        }
    }
}

void emitPhiCopies(EmitCtx* c, IrBlock* pred)
{
    if (pred == null) return;
    for (u32 si = 0; si < pred->nsuccs; si++)
        emitPhiCopiesFor(c, pred, pred->succs[si]);
}

/* ================= top-level per-inst dispatch ================= */

bool emitInst(EmitCtx* ctx, IrInst* inst, String* err)
{
    /* rax/rdx div results only survive an adjacent div-family inst */
    switch (inst->opcode)
    {
        IrOpcode::UDiv | IrOpcode::SDiv | IrOpcode::URem | IrOpcode::SRem => {},
        else => { ctx->divValid = 0; },
    }
    switch (inst->opcode)
    {
        IrOpcode::Add => { iselAlu(ctx, inst, "add"); return true; },
        IrOpcode::Sub => { iselAlu(ctx, inst, "sub"); return true; },
        IrOpcode::And => { iselAlu(ctx, inst, "and"); return true; },
        IrOpcode::Or => { iselAlu(ctx, inst, "or"); return true; },
        IrOpcode::Xor => { iselAlu(ctx, inst, "xor"); return true; },
        IrOpcode::Mul => { iselAlu(ctx, inst, "imul"); return true; },
        IrOpcode::Shl => { iselShift(ctx, inst, "shl"); return true; },
        IrOpcode::Ashr => { iselShift(ctx, inst, "sar"); return true; },
        IrOpcode::Lshr => { iselShift(ctx, inst, "shr"); return true; },
        IrOpcode::Neg => {
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            u32 dvid = ctx->vregFor(&inst->base);
            i32 dp = (i32)ctx->vregs[(usize)dvid].phys;
            u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
            loadToReg(ctx, inst->ops[0], useR, w);
            ctx->emit("\tneg"); ctx->emit(intSfx(regW(w))); ctx->emit(" ");
            ctx->emit(regForWidth(useR, regW(w))); ctx->emitLine("");
            if (dp < 0) storeToVReg(ctx, dvid, useR, w);
            return true;
        },
        IrOpcode::Not => {
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            u32 dvid = ctx->vregFor(&inst->base);
            i32 dp = (i32)ctx->vregs[(usize)dvid].phys;
            u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
            loadToReg(ctx, inst->ops[0], useR, w);
            ctx->emit("\tnot"); ctx->emit(intSfx(regW(w))); ctx->emit(" ");
            ctx->emit(regForWidth(useR, regW(w))); ctx->emitLine("");
            if (dp < 0) storeToVReg(ctx, dvid, useR, w);
            return true;
        },
        IrOpcode::ICmp => {
            u32 dv = ctx->vregFor(&inst->base);
            if (ctx->vregs[dv].noEmit != 0) return true;
            iselICmp(ctx, inst); return true;
        },
        IrOpcode::UDiv => { iselDivRem(ctx, inst, false, false); return true; },
        IrOpcode::SDiv => { iselDivRem(ctx, inst, true, false); return true; },
        IrOpcode::URem => { iselDivRem(ctx, inst, false, true); return true; },
        IrOpcode::SRem => { iselDivRem(ctx, inst, true, true); return true; },
        IrOpcode::Alloca => { iselAlloca(ctx, inst); return true; },
        IrOpcode::Load => { iselLoad(ctx, inst); return true; },
        IrOpcode::Store => { iselStore(ctx, inst); return true; },
        IrOpcode::Gep => {
            u32 gv = ctx->vregFor(&inst->base);
            if (ctx->vregs[gv].noEmit != 0) return true;
            iselGep(ctx, inst); return true;
        },
        IrOpcode::Br => { iselBr(ctx, inst); return true; },
        IrOpcode::CondBr => { iselCondBr(ctx, inst); return true; },
        IrOpcode::Switch => { iselSwitch(ctx, inst); return true; },
        IrOpcode::Ret => { iselRet(ctx, inst); return true; },
        IrOpcode::Select => { iselSelect(ctx, inst); return true; },
        IrOpcode::Trunc | IrOpcode::Bitcast | IrOpcode::Zext | IrOpcode::Sext => {
            iselCast(ctx, inst); return true;
        },
        IrOpcode::Unreachable | IrOpcode::Noret => {
            ctx->emitLine("\tud2"); return true;
        },
        IrOpcode::Call => { iselCall(ctx, inst); return true; },
        IrOpcode::Phi => { return true; }, /* copies emitted on edges */
        IrOpcode::FAdd => { iselFArith(ctx, inst, "addss", "addsd"); return true; },
        IrOpcode::FSub => { iselFArith(ctx, inst, "subss", "subsd"); return true; },
        IrOpcode::FMul => { iselFArith(ctx, inst, "mulss", "mulsd"); return true; },
        IrOpcode::FDiv => { iselFArith(ctx, inst, "divss", "divsd"); return true; },
        IrOpcode::FSqrt => { iselFArith(ctx, inst, "sqrtss", "sqrtsd"); return true; },
        IrOpcode::Fma => { iselFma(ctx, inst); return true; },
        IrOpcode::FAbs => { iselFAbs(ctx, inst); return true; },
        IrOpcode::FCmp => { iselFCmp(ctx, inst); return true; },
        IrOpcode::FpTrunc | IrOpcode::FpExt |
        IrOpcode::SiToFp | IrOpcode::UiToFp |
        IrOpcode::FpToSi | IrOpcode::FpToUi => {
            iselFCast(ctx, inst); return true;
        },
        IrOpcode::CtPop | IrOpcode::CtLz | IrOpcode::CtTz |
        IrOpcode::Bswap | IrOpcode::Rotl | IrOpcode::Rotr => {
            iselBitop(ctx, inst); return true;
        },
        IrOpcode::MulHi | IrOpcode::SMulHi => {
            iselMulHi(ctx, inst); return true;
        },
        IrOpcode::SMin | IrOpcode::SMax |
        IrOpcode::UMin | IrOpcode::UMax => {
            iselMinMax(ctx, inst); return true;
        },
        IrOpcode::Abs => { iselAbs(ctx, inst); return true; },
        else => {
            emitUnimplemented(ctx, inst, err);
            return false;
        },
    }
    return false;
}

/* ================= liveness + regalloc ================= */

/* opcodes where ops[0] is materialized into dst first and may share
 * its color when it dies at the def (2-address coalescing) */
bool coalesceOps0(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Add | IrOpcode::Sub | IrOpcode::And | IrOpcode::Or |
        IrOpcode::Xor | IrOpcode::Mul | IrOpcode::Shl | IrOpcode::Ashr |
        IrOpcode::Lshr | IrOpcode::Neg | IrOpcode::Not |
        IrOpcode::Trunc | IrOpcode::Bitcast | IrOpcode::Zext |
        IrOpcode::Sext | IrOpcode::ICmp | IrOpcode::Gep |
        IrOpcode::FAdd | IrOpcode::FSub | IrOpcode::FMul |
        IrOpcode::FDiv | IrOpcode::FSqrt | IrOpcode::FAbs |
        IrOpcode::Load | IrOpcode::Call => { return true; },
        else => { return false; },
    }
}


void runRegAlloc(EmitCtx* ctx)
{
    IrFunc* func = ctx->func;
    u32 n = ctx->nvregs;
    u32 nb = func->nblocks;
    if (n == 0 || nb == 0) return;
    u32 words = (n + 63) >> 6;
    usize nbits = (usize)nb * (usize)words;

    u32* bstart = alloc<u32>((usize)nb);
    u32* bend = alloc<u32>((usize)nb);
    u32* succOff = alloc<u32>((usize)nb + 1);
    u32 totalSucc = 0;
    for (u32 b = 0; b < nb; b++)
    {
        succOff[b] = totalSucc;
        IrBlock* bb = func->blocks[b];
        totalSucc += bb != null ? bb->nsuccs : 0;
    }
    succOff[nb] = totalSucc;
    u32* succIdx = alloc<u32>((usize)(totalSucc > 0 ? totalSucc : 1));
    {
        u32 sp = 0;
        for (u32 b = 0; b < nb; b++)
        {
            IrBlock* bb = func->blocks[b];
            if (bb == null) continue;
            for (u32 s = 0; s < bb->nsuccs; s++)
            {
                i32 si = blockIndexOf(func, bb->succs[s]);
                succIdx[sp++] = si >= 0 ? (u32)si : b;
            }
        }
    }

    u64* useB = alloc<u64>(nbits);
    u64* defB = alloc<u64>(nbits);
    u64* liveIn = alloc<u64>(nbits);
    u64* liveOut = alloc<u64>(nbits);
    for (usize i = 0; i < nbits; i++)
    { useB[i] = 0; defB[i] = 0; liveIn[i] = 0; liveOut[i] = 0; }

    u32* defPos = alloc<u32>((usize)n);
    u32* lastUse = alloc<u32>((usize)n);
    i32* preferSet = alloc<i32>((usize)n);
    /* positions of call instructions — values live across them must
     * not sit in caller-saved regs */
    u32* callPos = alloc<u32>((usize)nb * 8 + 16);
    u32 ncall = 0;
    for (u32 i = 0; i < n; i++) { defPos[i] = 0xFFFFFFFFu; lastUse[i] = 0xFFFFFFFFu; preferSet[i] = -1; }

    u32 pos = 0;
    for (u32 b = 0; b < nb; b++)
    {
        IrBlock* bb = func->blocks[b];
        bstart[b] = pos;
        if (bb == null) { bend[b] = pos; continue; }
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (inst == null) { pos++; continue; }
            if (inst->opcode == IrOpcode::Call && ncall < nb * 8 + 16)
                callPos[ncall++] = pos;
            for (u32 k = 0; k < inst->nops; k++)
            {
                IrValue* ov = inst->ops[k];
                if (!isVRegOperand(ov)) continue;
                i32 vid = vmapFind(&ctx->vmap, ov);
                if (vid < 0 || (u32)vid >= n) continue;
                u32 v = (u32)vid;
                u64 m = (u64)1 << (u64)(v & 63);
                usize w = (usize)v >> 6;
                usize rb = (usize)b * (usize)words;
                if ((defB[rb + w] & m) == 0)
                    useB[rb + w] |= m;
                if (lastUse[v] == 0xFFFFFFFFu || pos > lastUse[v])
                    lastUse[v] = pos;
            }
            if (instHasDef(inst))
            {
                i32 did = vmapFind(&ctx->vmap, &inst->base);
                if (did >= 0 && (u32)did < n)
                {
                    u32 v = (u32)did;
                    defB[(usize)b * (usize)words + ((usize)v >> 6)] |= (u64)1 << (u64)(v & 63);
                    if (defPos[v] == 0xFFFFFFFFu) defPos[v] = pos;
                    /* coalescing hint: prefer ops[0]'s color */
                    if (inst->nops > 0 && isVRegOperand(inst->ops[0]))
                    {
                        i32 pv = vmapFind(&ctx->vmap, inst->ops[0]);
                        if (pv >= 0) preferSet[v] = pv;
                    }
                }
            }
            pos++;
        }
        bend[b] = pos;
    }

    bool changed = true;
    while (changed)
    {
        changed = false;
        for (u32 bi = nb; bi > 0; bi--)
        {
            u32 b = bi - 1;
            bool outDiff = false;
            for (u32 s = succOff[b]; s < succOff[b + 1]; s++)
            {
                u32 si = succIdx[s];
                usize siw = (usize)si * (usize)words;
                usize bw = (usize)b * (usize)words;
                for (usize w = 0; w < (usize)words; w++)
                {
                    u64 add = liveIn[siw + w] & ~liveOut[bw + w];
                    if (add != 0) { liveOut[bw + w] |= add; outDiff = true; }
                }
            }
            usize bw2 = (usize)b * (usize)words;
            for (usize w = 0; w < (usize)words; w++)
            {
                u64 nw = useB[bw2 + w] |
                         (liveOut[bw2 + w] & ~defB[bw2 + w]);
                if (nw != liveIn[bw2 + w])
                { liveIn[bw2 + w] = nw; changed = true; }
            }
            if (outDiff) changed = true;
        }
    }

    /* ---- interference from live sets (precise, no interval holes)
     * adj[v*words+w] bit u = vregs v,u interfere. For each inst:
     * def interferes with every value live-after; plus def vs each
     * operand that dies at this inst (except ops[0] for ops that
     * materialize ops[0] into the dst first — coalescible). */
    u64* adj = alloc<u64>((usize)n * (usize)words);
    for (usize i = 0; i < (usize)n * (usize)words; i++) adj[i] = 0;

    /* values live at a block's entry are simultaneously live — they
     * pairwise interfere. This is the ONLY edge source for values
     * with no defining inst (function args): def-point edges never
     * fire for them, so two live args could otherwise share a phys. */
    for (u32 b = 0; b < nb; b++)
    {
        usize bw = (usize)b * (usize)words;
        for (u32 w = 0; w < (u32)words; w++)
        {
            u64 bits = liveIn[bw + (usize)w];
            while (bits != 0)
            {
                u32 bit = 0; u64 t = bits;
                while ((t & 1) == 0) { t >>= 1; bit++; }
                bits &= bits - 1;
                u32 x = (w << 6) + bit;
                if (x >= n) continue;
                for (u32 w2 = 0; w2 < (u32)words; w2++)
                {
                    u64 bits2 = liveIn[bw + (usize)w2];
                    while (bits2 != 0)
                    {
                        u32 bit2 = 0; u64 t2 = bits2;
                        while ((t2 & 1) == 0) { t2 >>= 1; bit2++; }
                        bits2 &= bits2 - 1;
                        u32 y = (w2 << 6) + bit2;
                        if (y <= x || y >= n) continue;
                        adj[(usize)x * (usize)words + ((usize)y >> 6)] |= (u64)1 << (u64)(y & 63);
                        adj[(usize)y * (usize)words + ((usize)x >> 6)] |= (u64)1 << (u64)(x & 63);
                    }
                }
            }
        }
    }

    for (u32 b = 0; b < nb; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        /* cur = live-after set, seeded with liveOut[b] */
        u64* cur = alloc<u64>((usize)words);
        for (u32 w = 0; w < words; w++)
            cur[w] = liveOut[(usize)b * (usize)words + (usize)w];
        for (u32 ii = bb->ninsts; ii > 0; ii--)
        {
            IrInst* inst = bb->insts[ii - 1];
            if (inst == null) continue;
            u32 pos = bstart[b] + (ii - 1);
            /* def interferes with live-after */
            i32 did = -1;
            if (instHasDef(inst))
                did = vmapFind(&ctx->vmap, &inst->base);
            if (did >= 0 && (u32)did < n)
            {
                u32 dv = (u32)did;
                for (u32 w = 0; w < words; w++)
                {
                    u64 bits = cur[w];
                    while (bits != 0)
                    {
                        u32 bit = 0; u64 t = bits;
                        while ((t & 1) == 0) { t >>= 1; bit++; }
                        bits &= bits - 1;
                        u32 ov = (w << 6) + bit;
                        if (ov < n && ov != dv)
                        {
                            adj[(usize)dv * (usize)words + ((usize)ov >> 6)] |= (u64)1 << (u64)(ov & 63);
                            adj[(usize)ov * (usize)words + ((usize)dv >> 6)] |= (u64)1 << (u64)(dv & 63);
                        }
                    }
                }
            }
            /* def vs dying operands (ops[0] exempt for 2-addr ops) */
            if (did >= 0 && (u32)did < n)
            {
                u32 dv = (u32)did;
                bool c0 = coalesceOps0(inst->opcode);
                for (u32 k = 0; k < inst->nops; k++)
                {
                    if (k == 0 && c0) continue;
                    IrValue* ov = inst->ops[k];
                    if (!isVRegOperand(ov)) continue;
                    i32 ovv = vmapFind(&ctx->vmap, ov);
                    if (ovv < 0 || (u32)ovv >= n) continue;
                    if (lastUse[(u32)ovv] == pos)
                    {
                        u32 uv = (u32)ovv;
                        adj[(usize)dv * (usize)words + ((usize)uv >> 6)] |= (u64)1 << (u64)(uv & 63);
                        adj[(usize)uv * (usize)words + ((usize)dv >> 6)] |= (u64)1 << (u64)(dv & 63);
                    }
                }
            }
            /* operands used by the same inst are simultaneously live at
             * its input; distinct SSA values must not share a phys reg
             * (store val/addr, add a/b, call args, ...). Phi operands are
             * per-edge and handled by edge copies, so skip them. */
            if (inst->opcode != IrOpcode::Phi)
            {
                for (u32 k = 0; k < inst->nops; k++)
                {
                    IrValue* ov = inst->ops[k];
                    if (!isVRegOperand(ov)) continue;
                    i32 av = vmapFind(&ctx->vmap, ov);
                    if (av < 0 || (u32)av >= n) continue;
                    for (u32 l = k + 1; l < inst->nops; l++)
                    {
                        IrValue* ow = inst->ops[l];
                        if (!isVRegOperand(ow)) continue;
                        i32 bv2 = vmapFind(&ctx->vmap, ow);
                        if (bv2 < 0 || (u32)bv2 >= n || bv2 == av) continue;
                        u32 x = (u32)av;
                        u32 y = (u32)bv2;
                        adj[(usize)x * (usize)words + ((usize)y >> 6)] |= (u64)1 << (u64)(y & 63);
                        adj[(usize)y * (usize)words + ((usize)x >> 6)] |= (u64)1 << (u64)(x & 63);
                    }
                }
            }
            /* update live set: remove def, add uses */
            if (did >= 0 && (u32)did < n)
            {
                u32 dv = (u32)did;
                cur[(usize)dv >> 6] &= ~((u64)1 << (u64)(dv & 63));
            }
            for (u32 k = 0; k < inst->nops; k++)
            {
                IrValue* ov = inst->ops[k];
                if (!isVRegOperand(ov)) continue;
                i32 ovv = vmapFind(&ctx->vmap, ov);
                if (ovv >= 0 && (u32)ovv < n)
                {
                    u32 uv = (u32)ovv;
                    cur[(usize)uv >> 6] |= (u64)1 << (u64)(uv & 63);
                }
            }
        }
        dealloc<u64>(cur);
    }

    /* klass/size/prefer arrays */
    u8* klass = alloc<u8>((usize)n);
    u32* szs = alloc<u32>((usize)n);
    i32* prefer = alloc<i32>((usize)n);
    for (u32 v = 0; v < n; v++)
    {
        klass[v] = (u8)ctx->vregs[v].klass;
        szs[v] = 8;
        if (ctx->vregs[v].type != null)
        {
            if (typeIsSse(ctx->vregs[v].type)) klass[v] = klass[v] == 2 ? 2 : 1;
            u32 tsz = typeSizeBytes(ctx->vregs[v].type);
            if (tsz > 8) szs[v] = tsz;
        }
        /* values live across calls: gpr -> callee-saved class (3),
         * xmm -> spill (caller-saved on SysV) */
        if (klass[v] != 2)
        {
            for (u32 ci = 0; ci < ncall; ci++)
            {
                if (lastUse[v] != 0xFFFFFFFFu &&
                    (defPos[v] == 0xFFFFFFFFu || callPos[ci] > defPos[v]) &&
                    callPos[ci] < lastUse[v])
                {
                    klass[v] = (klass[v] == 1) ? (u8)2 : (u8)3;
                    break;
                }
            }
        }
        prefer[v] = -1;
    }
    /* prefer hints from the earlier walk (ops[0] coalesce candidates) */
    for (u32 v = 0; v < n; v++)
        if (preferSet[v] >= 0) prefer[v] = preferSet[v];

    i32* physOut = alloc<i32>((usize)n);
    i32* slotOut = alloc<i32>((usize)n);
    graphAssignNodes(n, words, adj, klass, szs, prefer,
                     &regs::ALLOC_ORDER[0], regs::ALLOC_ORDER_LEN,
                     &regs::XMM_ALLOC_ORDER[0], regs::XMM_ALLOC_LEN,
                     &regs::CS_ALLOC_ORDER[0], regs::CS_ALLOC_LEN,
                     null,
                     physOut, slotOut);

    for (u32 v = 0; v < n; v++)
    {
        ctx->vregs[v].phys = physOut[v];
        ctx->vregs[v].slot = slotOut[v];
        /* register file: xmm for sse-typed values, gpr otherwise.
         * (the allocator's local klass[] also encodes spill-only /
         * callee-saved hints — those live in phys/slot, not here) */
        ctx->vregs[v].klass = typeIsSse(ctx->vregs[v].type) ? 1 : 0;
        /* xmm phys indices share the 0-15 space with gprs — only gpr
         * klass values can mark callee-saved regs used */
        if (ctx->vregs[v].klass == 0 && physOut[v] >= 0 &&
            regs::regIsCalleeSaved((u8)physOut[v]))
        {
            while (ctx->usedCallee.count() < 16) ctx->usedCallee.push((u8)0);
            ctx->usedCallee.atPtr((usize)physOut[v])[0] = 1;
        }
    }
    ctx->frameSize = 0;
    for (u32 v = 0; v < n; v++)
        if (slotOut[v] >= 0)
        {
            u32 need = (szs[v] + 7) / 8;
            if ((i32)(slotOut[v] + (i32)need) * 8 > ctx->frameSize)
                ctx->frameSize = (i32)(slotOut[v] + (i32)need) * 8;
        }
    /* round frameSize up to 8 */
    ctx->frameSize = (ctx->frameSize + 7) & ~7;

    dealloc<u64>(adj);
    dealloc<u8>(klass); dealloc<u32>(szs); dealloc<i32>(prefer);
    dealloc<i32>(physOut); dealloc<i32>(slotOut);
    dealloc<i32>(preferSet);

    /* callee-saved list in push order: rbx, r12, r13, r14, r15 */
    u8[5] csOrder = { regs::RBX, regs::R12, regs::R13, regs::R14, regs::R15 };
    for (u32 i = 0; i < 5; i++)
    {
        u8 r = csOrder[i];
        if (ctx->usedCallee.count() > (usize)r &&
            ctx->usedCallee.atPtr((usize)r)[0] != 0 && ctx->ncallee < 8)
            ctx->calleeList[ctx->ncallee++] = r;
    }
    ctx->savedBytes = (i32)ctx->ncallee * 8;

    dealloc<u32>(bstart); dealloc<u32>(bend);
    dealloc<u32>(succOff); dealloc<u32>(succIdx);
    dealloc<u64>(useB); dealloc<u64>(defB);
    dealloc<u64>(liveIn); dealloc<u64>(liveOut);
    dealloc<u32>(defPos); dealloc<u32>(lastUse); dealloc<u32>(callPos);
}

/* ================= prologue & arg moves ================= */

/* rbp frame is required for calls (stack alignment), incoming stack
 * args, and the usual spill/alloca/callee-save cases. */
bool funcNeedsFrame(IrFunc* f)
{
    if (f == null) return false;
    u32 ii = 0;
    u32 xi = 0;
    for (u32 a = 0; a < f->nargs; a++)
    {
        IrValue* av = f->args != null ? f->args[a] : null;
        if (av == null) continue;
        ArgClass cl = classifyArg(av);
        if (cl == ArgClass::INTEGER) { if (ii < 6) ii++; else return true; }
        else if (cl == ArgClass::SSE) { if (xi < 8) xi++; else return true; }
        else return true;
    }
    for (u32 b = 0; b < f->nblocks; b++)
    {
        IrBlock* bb = f->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (inst->opcode == IrOpcode::Call || inst->opcode == IrOpcode::InlineAsm)
                return true;
        }
    }
    return false;
}

void emitPrologue(EmitCtx* c)
{
    bool frame = c->forceFrame || c->ncallee > 0 || c->frameSize > 0 || c->allocaBytes > 0;
    if (!frame) return;
    c->emitLine("\tpushq %rbp");
    c->emitLine("\t.cfi_def_cfa_offset 16");
    c->emitLine("\t.cfi_offset %rbp, -16");
    c->emitLine("\tmovq %rsp, %rbp");
    c->emitLine("\t.cfi_def_cfa_register %rbp");
    for (u32 i = 0; i < c->ncallee; i++)
    {
        c->emit("\tpushq "); c->emit(regName(c->calleeList[i])); c->emitLine("");
        c->emit("\t.cfi_offset "); c->emit(regName(c->calleeList[i])); c->emit(", -");
        c->emitI64((i64)(24 + 8 * (i32)i)); c->emitLine("");
    }
    /* frameTotal = spill + alloca, padded so rsp stays 16-aligned.
     * entry rsp%16==8; after push rbp + ncallee pushes rsp%16 ==
     * (8 - 8*(1+ncallee)) mod 16; sub must make it 0. */
    i64 total = (i64)c->frameSize + (i64)c->allocaBytes;
    i64 mis = (8 - 8 * (i64)(1 + c->ncallee) - total) % 16;
    if (mis < 0) mis += 16;
    i64 sub = total + mis;
    if (sub > 0)
    {
        c->emit("\tsubq $"); c->emitI64(sub); c->emit(", %rsp\n");
    }
}

/* move incoming arg `av` (already classified) from its ABI location
 * into its vreg home. srcK: 0=gpr reg(srcP), 1=xmm(srcP), 2=stack(off) */
void emitArgIn(EmitCtx* c, IrValue* av, u8 srcK, u8 srcP, i32 srcOff)
{
    u32 vid = c->vregFor(av);
    VReg* r = &c->vregs[(usize)vid];
    u32 w = av->type != null ? av->type->width : 64;
    if (srcK == 0)
    {
        /* gpr arg reg -> vreg loc */
        if (r->phys >= 0 && r->klass != 1)
        {
            if ((i32)srcP != r->phys)
            {
                c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
                c->emit(regForWidth(srcP, regW(w))); c->emit(", ");
                c->emit(regForWidth((u8)r->phys, regW(w))); c->emitLine("");
            }
        }
        else if (r->phys < 0)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emit(regForWidth(srcP, regW(w))); c->emit(", -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
        else
        {
            c->emit("\t# isel: gpr->xmm arg move unsupported\n");
        }
    }
    else if (srcK == 1)
    {
        /* xmm arg reg -> vreg loc */
        if (r->phys >= 0 && r->klass == 1)
        {
            if ((i32)srcP != r->phys)
            {
                c->emit("\tmovaps "); emitXmmReg(c, srcP); c->emit(", ");
                emitXmmReg(c, (u8)r->phys); c->emitLine("");
            }
        }
        else if (r->phys < 0)
        {
            u32 sz = typeSizeBytes(av->type);
            c->emit(sz <= 8 ? "\tmovsd " : "\tmovups ");
            emitXmmReg(c, srcP); c->emit(", -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
    }
    else
    {
        /* incoming stack arg at [rbp+16+srcOff] */
        if (r->phys >= 0 && r->klass != 1)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emitI64((i64)srcOff); c->emit("(%rbp), ");
            c->emit(regForWidth((u8)r->phys, regW(w))); c->emitLine("");
        }
        else if (r->phys < 0)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emitI64((i64)srcOff); c->emit("(%rbp), -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
    }
}

void emitArgMoves(EmitCtx* c)
{
    IrFunc* f = c->func;
    u32 ii = 0;
    u32 xi = 0;
    u32 si = 0;
    for (u32 a = 0; a < f->nargs; a++)
    {
        IrValue* av = f->args[a];
        if (av == null) continue;
        ArgClass cl = classifyArg(av);
        if (cl == ArgClass::INTEGER)
        {
            if (ii < 6)
            {
                emitArgIn(c, av, 0, argRegPhys((u8)ii), 0);
                ii++;
            }
            else
            {
                i32 off = 16 + 8 * (i32)si;
                emitArgIn(c, av, 2, 0, off);
                si++;
            }
        }
        else if (cl == ArgClass::SSE)
        {
            if (xi < 8)
            {
                emitArgIn(c, av, 1, (u8)xi, 0);
                xi++;
            }
            else
            {
                i32 off = 16 + 8 * (i32)si;
                emitArgIn(c, av, 2, 0, off);
                si++;
            }
        }
        else
        {
            i32 off = 16 + 8 * (i32)si;
            emitArgIn(c, av, 2, 0, off);
            si++;
        }
    }
}

/* ================= clang-style spacing =================
 * LLVM emits instruction lines as `\t<mnemonic>\t<operands>` while
 * directives (.cfi_*, .p2align) keep a single space. Our emitters write
 * `\t<mnemonic> <operands>` everywhere, so normalize in one pass. */

void clangifyLine(String* out, str line)
{
    if (line.len >= 2 && line.ptr[0] == '\t' && line.ptr[1] != '.' &&
        line.ptr[1] != '#' && line.ptr[1] != ' ')
    {
        for (usize i = 1; i < line.len; i++)
        {
            if (line.ptr[i] == ' ')
            {
                out->appendView(str::fromParts(line.ptr, i));
                out->pushChar('\t');
                out->appendView(str::fromParts(line.ptr + i + 1, line.len - i - 1));
                return;
            }
        }
    }
    out->appendView(line);
}

str clangifyAsm(str src)
{
    String out = String::new();
    usize start = 0;
    for (usize i = 0; i <= src.len; i++)
    {
        if (i == src.len || src.ptr[i] == 10)
        {
            clangifyLine(&out, str::fromParts(src.ptr + start, i - start));
            out.pushChar('\n');
            start = i + 1;
        }
    }
    return out.asView();
}

/* ================= function driver ================= */

pub str emitFuncAsm(IrFunc* func, IrContext* ctx)
{
    if (func == null || ctx == null) return "";
    EmitCtx ec = EmitCtx::new();
    ec.func = func;
    ec.ictx = ctx;

    /* load-CSE pre-pass: pair redundant loads before vreg sizing so
     * aliases are consistent through liveness and emission */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        usize[32] caddr; usize[32] cval; u32[32] cw; u32 cn = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (inst->opcode == IrOpcode::Store || inst->opcode == IrOpcode::Call ||
                inst->opcode == IrOpcode::InlineAsm)
            { cn = 0; continue; }
            if (inst->opcode != IrOpcode::Load || inst->nops < 1) continue;
            IrValue* addr = canonAddr(&ec, inst->ops[0]);
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            IrValue* hit = null;
            for (u32 k = 0; k < cn; k++)
                if (caddr[k] == (usize)addr && cw[k] == w) { hit = (IrValue*)(usize)cval[k]; break; }
            if (hit != null)
            {
                /* canonical: follow existing alias chain */
                IrValue* canon = ec.cseFind(hit);
                ec.cseAdd(&inst->base, canon != null ? canon : hit);
            }
            else if (cn < 32)
            {
                caddr[cn] = (usize)addr; cval[cn] = (usize)&inst->base; cw[cn] = w; cn++;
            }
        }
    }

    /* args first: identity-op aliasing in vregFor needs them mapped */
    for (u32 a = 0; a < func->nargs; a++)
        if (func->args != null && func->args[a] != null) ec.vregFor(func->args[a]);

    /* vreg sizing walk */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (instHasDef(inst)) ec.vregFor(&inst->base);
            for (u32 k = 0; k < inst->nops; k++)
            {
                IrValue* ov = inst->ops[k];
                if (ov == null || !isVRegOperand(ov)) continue;
                u32 ovv = ec.vregFor(ov);
                ec.vregs[ovv].nuses++;
            }
        }
    }
    runRegAlloc(&ec);

    /* mark compares whose only use is a fused condbr: iselCondBr re-uses
     * the icmp operands directly, so the setcc result would be dead. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::CondBr || inst->nops < 1)
                continue;
            IrValue* cond = inst->ops[0];
            if (cond == null || cond->kind != IrValueKind::Inst) continue;
            IrInst* ic = (IrInst*)cond;
            if (ic->opcode != IrOpcode::ICmp) continue;
            u32 cv = ec.vregFor(&ic->base);
            if (ec.vregs[cv].nuses == 1) ec.vregs[cv].noEmit = 1;
        }
    }

    /* const-gep folding: a gep with all-constant indices whose every
     * user is another gep (as its base operand) never needs a register
     * — users fold through it via gepFoldRoot. Dead geps (no users)
     * qualify too. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Gep || inst->nops < 2)
                continue;
            bool allConst = true;
            for (u32 gi = 1; gi < inst->nops; gi++)
                if (inst->ops[gi] == null ||
                    inst->ops[gi]->kind != IrValueKind::ConstInt)
                    allConst = false;
            if (!allConst) continue;
            bool foldable = true;
            for (u32 ui = 0; ui < inst->base.nusers; ui++)
            {
                IrInst* u = inst->base.users[ui];
                if (u == null || u->opcode != IrOpcode::Gep || u->nops < 1 ||
                    u->ops[0] != &inst->base)
                { foldable = false; break; }
            }
            if (foldable)
            {
                u32 gv = ec.vregFor(&inst->base);
                ec.vregs[gv].noEmit = 1;
            }
        }
    }

    /* pre-scan allocas so the prologue reserves their frame space */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Alloca) continue;
            IrType* et = inst->base.type;
            if (et != null && et->kind == IrTypeKind::Ptr) et = et->elem;
            u32 sz = et != null ? ctx->irTypeSizeOf(et) : 8;
            if (sz == 0) sz = 8;
            ec.allocaBytes += (i32)((sz + 15) / 16 * 16);
        }
    }

    /* alloca folding: an alloca used only as the base operand of
     * all-const geps never needs a register — every use folds to
     * rbp-off(+const) inside iselGep. Mark noEmit and pre-assign the
     * frame slot so allocaOffOf resolves during emission. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Alloca) continue;
            bool foldable = true;
            for (u32 ui = 0; ui < inst->base.nusers; ui++)
            {
                IrInst* u = inst->base.users[ui];
                if (u == null || u->opcode != IrOpcode::Gep || u->nops < 1 ||
                    u->ops[0] != &inst->base)
                { foldable = false; break; }
                bool uc = true;
                for (u32 gi = 1; gi < u->nops; gi++)
                    if (u->ops[gi] == null ||
                        u->ops[gi]->kind != IrValueKind::ConstInt)
                        uc = false;
                if (!uc) { foldable = false; break; }
            }
            if (!foldable) continue;
            IrType* et = inst->base.type;
            if (et != null && et->kind == IrTypeKind::Ptr) et = et->elem;
            u32 sz = et != null ? ctx->irTypeSizeOf(et) : 8;
            if (sz == 0) sz = 8;
            allocaSlotFor(&ec, &inst->base, sz);
            u32 av = ec.vregFor(&inst->base);
            ec.vregs[av].noEmit = 1;
        }
    }

    ec.forceFrame = funcNeedsFrame(func);

    /* header + prologue, clang-style layout */
    u64 fid = (u64)func->base.id;
    ec.emitLine("\t.text");
    ec.emit("\t.globl\t"); ec.emit(func->base.name);
    emitFuncBeginComment(&ec, func->base.name);
    /* GNU as rejects a symbol in .p2align's max-skip operand (clang's
     * `.p2align 4, .Lfunc_endN, nop` is llvm-mc syntax), so keep the
     * bare form. */
    ec.emit("\t.p2align\t4\n");
    ec.emit("\t.type\t"); ec.emit(func->base.name); ec.emit(",@function\n");
    ec.emit(func->base.name); ec.emit(":");
    emitFuncLabelComment(&ec, func->base.name);
    ec.emitLine("\t.cfi_startproc");
    emitPrologue(&ec);
    emitArgMoves(&ec);

    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        ec.emit("# %bb."); ec.emitU64((u64)b); ec.emitLine(":");
        ec.divValid = 0;
        emitBBLabelFor(&ec, &bb->base);
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            /* phi copies go on the edge: emit right before terminator.
             * CondBr/Switch handle their own per-edge copies inside
             * their isel (each edge is distinct). */
            if (inst->opcode == IrOpcode::Br)
                emitPhiCopies(&ec, bb);
            String err = String::new();
            if (!emitInst(&ec, inst, &err))
            {
                ec.emit("\t# ");
                ec.emit(err.asView());
                ec.emitLine("");
                err.free();
            }
        }
    }
    ec.emit(".Lfunc_end"); ec.emitU64(fid); ec.emitLine(":");
    ec.emit("\t.size\t"); ec.emit(func->base.name); ec.emit(", .Lfunc_end");
    ec.emitU64(fid); ec.emit("-"); ec.emit(func->base.name); ec.emitLine("");
    ec.emitLine("\t.cfi_endproc");
    emitFuncEndComment(&ec);

    str result = clangifyAsm(ec.out.asView());
    if (ec.vregs != null) dealloc<VReg>(ec.vregs);
    if (ec.allocaVals != null) dealloc<IrValue*>(ec.allocaVals);
    if (ec.allocaOffs != null) dealloc<i32>(ec.allocaOffs);
    vmapFree(&ec.vmap);
    ec.usedCallee.dispose();
    return result;
}

/* ================= data emission ================= */

void dataEmit(String* out, str s) { out->appendView(s); }

void dataEmitLine(String* out, str s)
{
    out->appendView(s);
    out->pushChar('\n');
}

void dataEmitI64(String* out, i64 v)
{
    cchar[32] buf;
    i32 n = snprintf(buf, 32, C"%lld", v);
    if (n > 0) out->appendView(str::fromParts((const u8*)buf, (usize)n));
}

void dataEmitU64(String* out, u64 v)
{
    cchar[32] buf;
    i32 n = snprintf(buf, 32, C"%llu", v);
    if (n > 0) out->appendView(str::fromParts((const u8*)buf, (usize)n));
}

void emitEscapedAscizData(String* out, const u8* data, u32 len)
{
    out->appendView("\t.asciz \"");
    for (u32 i = 0; i < len; i++)
    {
        u8 ch = data[i];
        if (ch == 10) out->appendView("\\n");
        else if (ch == 9) out->appendView("\\t");
        else if (ch == 13) out->appendView("\\r");
        else if (ch == 34) out->appendView("\\\"");
        else if (ch == 92) out->appendView("\\\\");
        else if (ch >= 32 && ch <= 126)
        {
            u8[1] one;
            one[0] = ch;
            out->appendView(str::fromParts((const u8*)one, 1));
        }
        else
        {
            cchar[8] oct;
            snprintf(oct, 8, C"\\%03o", (u32)ch);
            out->appendView(str::fromCstr((cchar*)oct));
        }
    }
    out->appendView("\"\n");
}

void emitDataValue(String* out, IrModule* modd, IrContext* ctx, IrValue* v)
{
    if (v == null)
    {
        dataEmitLine(out, "\t.quad 0");
        return;
    }
    switch (v->kind)
    {
        IrValueKind::ConstInt => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w <= 8)
            {
                dataEmit(out, "\t.byte "); dataEmitI64(out, (i64)(u8)v->valData); dataEmitLine(out, "");
            }
            else if (w <= 16)
            {
                dataEmit(out, "\t.short "); dataEmitI64(out, (i64)(u16)v->valData); dataEmitLine(out, "");
            }
            else if (w <= 32)
            {
                dataEmit(out, "\t.long "); dataEmitI64(out, (i64)(i32)v->valData); dataEmitLine(out, "");
            }
            else
            {
                dataEmit(out, "\t.quad "); dataEmitI64(out, (i64)v->valData); dataEmitLine(out, "");
            }
        },
        IrValueKind::ConstFloat => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w <= 32)
            {
                dataEmit(out, "\t.long "); dataEmitU64(out, (u64)(u32)v->valData); dataEmitLine(out, "");
            }
            else
            {
                dataEmit(out, "\t.quad "); dataEmitU64(out, v->valData); dataEmitLine(out, "");
            }
        },
        IrValueKind::StringConst => {
            IrStringConst* sc = (IrStringConst*)v;
            emitEscapedAscizData(out, sc->data, sc->length);
        },
        IrValueKind::ConstArray => {
            IrArrayConst* ac = (IrArrayConst*)v;
            for (u32 i = 0; i < ac->nelems; i++)
                emitDataValue(out, modd, ctx, ac->elems[i]);
        },
        IrValueKind::StructConst => {
            IrStructConst* st = (IrStructConst*)v;
            IrStructType* sst = null;
            if (modd != null)
            {
                for (u32 si = 0; si < modd->nstructs; si++)
                {
                    IrStructType* cand = modd->structs[si];
                    if (cand != null && cand->irType == v->type) { sst = cand; break; }
                }
            }
            u32 run = 0;
            for (u32 i = 0; i < st->nelems; i++)
            {
                IrValue* fv = st->elems[i];
                u32 fo = sst != null && sst->offsets != null && i < sst->nfields
                    ? sst->offsets[i] : run;
                if (fo > run)
                {
                    dataEmit(out, "\t.zero "); dataEmitU64(out, (u64)(fo - run)); dataEmitLine(out, "");
                    run = fo;
                }
                emitDataValue(out, modd, ctx, fv);
                u32 fsz = fv != null && fv->type != null && ctx != null
                    ? ctx->irTypeSizeOf(fv->type) : 0;
                run = fo + fsz;
            }
            if (sst != null && sst->size > run)
            {
                dataEmit(out, "\t.zero "); dataEmitU64(out, (u64)(sst->size - run)); dataEmitLine(out, "");
            }
        },
        IrValueKind::Global | IrValueKind::Func => {
            dataEmit(out, "\t.quad "); dataEmitLine(out, asmSymName(v));
        },
        else => {
            dataEmitLine(out, "\t.quad 0");
        }
    }
}

u32 dataAlignExp(u32 align)
{
    if (align <= 1) return 0;
    u32 e = 0;
    while (((u32)1 << e) < align && e < 16) e++;
    return ((u32)1 << e) == align ? e : 0;
}

void emitDataAlign(String* out, u32 align)
{
    u32 e = dataAlignExp(align);
    if (align > 1 && e != 0)
    {
        out->appendView("\t.p2align\t");
        dataEmitU64(out, (u64)e);
        out->appendView(", 0x0\n");
    }
    else if (align > 1)
    {
        out->appendView("\t.balign\t");
        dataEmitU64(out, (u64)align);
        out->pushChar('\n');
    }
}

void emitDataAsm(String* out, IrModule* modd, IrContext* ctx)
{
    if (modd == null) return;
    if (modd->nconstStrings > 0)
    {
        out->appendView("\t.section\t.rodata\n");
        for (u32 i = 0; i < modd->nconstStrings; i++)
        {
            IrStringConst* sc = modd->constStrings[i];
            if (sc == null) continue;
            emitDataAlign(out, 1);
            if (!sc->base.name.isEmpty())
            {
                out->appendView(sc->base.name); out->pushChar(':'); out->pushChar('\n');
            }
            else
            {
                out->appendView(".Lstr_"); dataEmitU64(out, (u64)sc->base.id); out->appendView(":\n");
            }
            emitEscapedAscizData(out, sc->data, sc->length);
        }
        out->pushChar('\n');
    }
    for (u32 gi = 0; gi < modd->nglobals; gi++)
    {
        IrGlobal* g = modd->globals[gi];
        if (g == null || g->isExtern) continue;
        out->appendView(g->isConst ? "\t.section\t.rodata\n" : "\t.section\t.data\n");
        u32 align = g->alignment != 0 ? g->alignment : 8;
        emitDataAlign(out, align);
        out->appendView("\t.type\t"); out->appendView(g->base.name); out->appendView(",@object\n");
        out->appendView("\t.globl\t"); out->appendView(g->base.name); out->pushChar('\n');
        out->appendView(g->base.name); out->appendView(":\n");
        if (g->initVal != null)
            emitDataValue(out, modd, ctx, g->initVal);
        else
        {
            u32 sz = 8;
            if (ctx != null && g->base.type != null)
                sz = ctx->irTypeSizeOf(g->base.type);
            if (sz == 0) sz = 8;
            out->appendView("\t.zero "); dataEmitU64(out, (u64)sz); out->pushChar('\n');
        }
        out->appendView("\t.size\t"); out->appendView(g->base.name);
        out->appendView(", .-"); out->appendView(g->base.name); out->pushChar('\n');
        out->pushChar('\n');
    }
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return "";
    String out = String::new();
    out.appendView("\t.att_syntax\n\t.file \"muvm\"\n\n");
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;
        str s = emitFuncAsm(func, ctx);
        if (s.len > 0) { out.appendView(s); out.pushChar('\n'); }
    }
    emitDataAsm(&out, modd, ctx);
    out.appendView("\n\t.ident\t\"muvm\"\n");
    out.appendView("\t.section\t\".note.GNU-stack\",\"\",@progbits\n");
    return out.asView();
}

pub bool compileModule(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx);
    return asmText.len > 0 || modd->nfuncs == 0;
}
