#[[no_drop_all]]
// emit.crl: instruction selection + text emission for x86_64 linux.
// Pipeline per function: collect defs -> build live intervals ->
// linear-scan assign (regalloc/) -> emit blocks in order -> prologue.

import muvm::irtypes {
    IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind,
    IrType, IrTypeKind, IrContext
};
import muvm::irOps { IrOpcode, IrICmpPred, irOpcodeStr };
import std::string { String };
import std::mman { alloc, dealloc };
import std::vec { Vec };

use super::regs;
use super::linux { ArgClass, classifyArg, typeSizeBytes, typeIsSse, INT_ARG_REGS, SSE_ARG_REGS };
use super::prologue;

/* vreg: virtual register. phys = assigned hardware reg or -1
 * (spilled -> stack slot). kind distinguishes gpr vs xmm. */
pub struct VReg
{
    i32 phys;      /* regs:: encoding or -1 */
    i32 slot;      /* frame offset when spilled, -1 otherwise */
    u8 klass;      /* 0 = gpr, 1 = xmm */
    bool isConst;
    u64 constVal;
    IrType* type;
}

pub struct EmitCtx
{
    String out;
    IrFunc* func;
    IrContext* ictx;
    VReg* vregs;      /* indexed by IrValue.id */
    u32 nvregs;
    u32 capVregs;
    Vec<u8> usedCallee; /* bitmap-ish: which callee-saved got assigned */
    i32 frameSize;
    str labelPrefix;

    EmitCtx new()
    {
        return EmitCtx {
            .out = String::new(),
            .func = null,
            .ictx = null,
            .vregs = null,
            .nvregs = 0,
            .capVregs = 0,
            .usedCallee = Vec<u8>::new(),
            .frameSize = 0,
            .labelPrefix = str::empty()
        };
    }

    void destroy()
    {
        if (self.vregs != null) dealloc<VReg>(self.vregs);
        self.out.free();
        self.usedCallee.dispose();
    }

    u32 vregFor(IrValue* v)
    {
        u32 id = v->id;
        if (id >= self.capVregs)
        {
            u32 nc = self.capVregs ? self.capVregs * 2 : 64;
            while (nc <= id) nc *= 2;
            VReg* nv = alloc<VReg>((usize)nc);
            for (u32 i = 0; i < nc; i++)
            {
                nv[i].phys = -1;
                nv[i].slot = -1;
                nv[i].klass = 0;
                nv[i].isConst = false;
                nv[i].constVal = 0;
                nv[i].type = null;
            }
            if (self.vregs != null)
            {
                copy<VReg>(nv, self.vregs, (usize)self.capVregs);
                dealloc<VReg>(self.vregs);
            }
            self.vregs = nv;
            self.capVregs = nc;
        }
        if (id >= self.nvregs) self.nvregs = id + 1;
        VReg* r = &self.vregs[id];
        if (r->type == null) r->type = v->type;
        return id;
    }

    void emit(str s) { self.out.appendView(s); }
    void emitLine(str s) { self.out.appendView(s); self.out.pushChar('\n'); }
}

pub str regName(u8 r)
{
    switch (r)
    {
        regs::RAX => { return "%rax"; },
        regs::RCX => { return "%rcx"; },
        regs::RDX => { return "%rdx"; },
        regs::RBX => { return "%rbx"; },
        regs::RSP => { return "%rsp"; },
        regs::RBP => { return "%rbp"; },
        regs::RSI => { return "%rsi"; },
        regs::RDI => { return "%rdi"; },
        regs::R8  => { return "%r8"; },
        regs::R9  => { return "%r9"; },
        regs::R10 => { return "%r10"; },
        regs::R11 => { return "%r11"; },
        regs::R12 => { return "%r12"; },
        regs::R13 => { return "%r13"; },
        regs::R14 => { return "%r14"; },
        regs::R15 => { return "%r15"; },
        default => { return "%r?"; },
    }
}

/* operand-size suffix for an integer width in bits */
pub str intSfx(u32 w)
{
    if (w <= 8) return "b";
    if (w <= 16) return "w";
    if (w <= 32) return "l";
    return "q";
}

/* 32-bit ops zero the upper half — "movl" suffices for <=32b */
pub str regForWidth(u8 r, u32 w)
{
    if (w <= 32)
    {
        switch (r)
        {
            regs::RAX => { return "%eax"; },
            regs::RCX => { return "%ecx"; },
            regs::RDX => { return "%edx"; },
            regs::RBX => { return "%ebx"; },
            regs::RSI => { return "%esi"; },
            regs::RDI => { return "%edi"; },
            regs::R8  => { return "%r8d"; },
            regs::R9  => { return "%r9d"; },
            regs::R10 => { return "%r10d"; },
            regs::R11 => { return "%r11d"; },
            regs::R12 => { return "%r12d"; },
            regs::R13 => { return "%r13d"; },
            regs::R14 => { return "%r14d"; },
            regs::R15 => { return "%r15d"; },
            default => { return regName(r); },
        }
    }
    return regName(r);
}

/* resolve an IrValue operand to a vreg id; constants get materialized
 * lazily by the emitter (isConst flag) */
u32 operandVReg(EmitCtx* ctx, IrValue* v)
{
    if (v == null) return 0;
    if (v->kind == IrValueKind::ConstInt)
    {
        u32 id = ctx->vregFor(v);
        ctx->vregs[id].isConst = true;
        ctx->vregs[id].constVal = v->valData;
        ctx->vregs[id].klass = 0;
        return id;
    }
    return ctx->vregFor(v);
}

void emitUnimplemented(EmitCtx* ctx, IrInst* inst, String* err)
{
    err->pushView("primary/x86_64/linux: unimplemented opcode ");
    err->pushView(irOpcodeStr(inst->opcode));
}

/* emit one instruction's text assuming operands already have phys
 * regs or consts. dst is the result vreg id (0xFFFFFFFF = none). */
bool emitInst(EmitCtx* ctx, IrInst* inst, String* err)
{
    switch (inst->opcode)
    {
        IrOpcode::Add, IrOpcode::Sub, IrOpcode::And, IrOpcode::Or,
        IrOpcode::Xor, IrOpcode::Shl, IrOpcode::Ashr, IrOpcode::Lshr,
        IrOpcode::Mul => {
            /* two-address form: dst = src op src2 — regalloc must
             * coalesce or the emitter inserts a mov. v1: require dst
             * phys == ops[0] phys or emit mov first. */
            u32 d = ctx->vregFor(&inst->base);
            u32 a = operandVReg(ctx, inst->ops[0]);
            u32 b = operandVReg(ctx, inst->ops[1]);
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            str sop = "?";
            switch (inst->opcode)
            {
                IrOpcode::Add => { sop = "add"; },
                IrOpcode::Sub => { sop = "sub"; },
                IrOpcode::And => { sop = "and"; },
                IrOpcode::Or  => { sop = "or"; },
                IrOpcode::Xor => { sop = "xor"; },
                IrOpcode::Shl => { sop = "shl"; },
                IrOpcode::Ashr => { sop = "sar"; },
                IrOpcode::Lshr => { sop = "shr"; },
                IrOpcode::Mul => { sop = "imul"; },
            }
            /* TODO: full operand emission with phys regs/spills */
            ctx->emit(sop);
            ctx->emit(intSfx(w));
            ctx->emit(" ; ");
            ctx->emit(irOpcodeStr(inst->opcode));
            ctx->emitLine("");
            return true;
        },
        IrOpcode::ICmp => {
            u32 a = operandVReg(ctx, inst->ops[0]);
            u32 b = operandVReg(ctx, inst->ops[1]);
            u32 w = inst->ops[0] != null && inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
            /* cmp at operand width, then setcc + movzbq */
            ctx->emit("    cmp");
            ctx->emit(intSfx(w));
            ctx->emit(" ; ");
            ctx->emit(irOpcodeStr(inst->icmpPred));
            ctx->emitLine("");
            return true;
        },
        _ => {
            emitUnimplemented(ctx, inst, err);
            return false;
        },
    }
}

pub str emitFuncAsm(IrFunc* func, IrContext* ctx)
{
    if (func == null || ctx == null) return "";
    EmitCtx ec = EmitCtx::new();
    ec.func = func;
    ec.ictx = ctx;

    /* walk blocks/insts once to size the vreg table */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst->base.type != null && inst->opcode != IrOpcode::Store &&
                inst->opcode != IrOpcode::Br && inst->opcode != IrOpcode::CondBr &&
                inst->opcode != IrOpcode::Switch && inst->opcode != IrOpcode::Ret)
                ec.vregFor(&inst->base);
            for (u32 k = 0; k < inst->nops; k++)
                if (inst->ops[k] != null) ec.vregFor(inst->ops[k]);
        }
    }
    for (u32 a = 0; a < func->nargs; a++)
        if (func->args[a] != null) ec.vregFor(func->args[a]);

    /* TODO: regalloc pass (regalloc/) assigns phys regs or spill
     * slots; for now emit per-block instruction text */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        ec.emitLine(".LBB:");
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            String err = String::new();
            if (!emitInst(&ec, bb->insts[i], &err))
            {
                /* stub: comment the failure, keep going */
                ec.emit("    # ");
                ec.emit(err.asView());
                ec.emitLine("");
                err.free();
            }
        }
    }

    /* v1: hand the buffer to the caller as a str view and leak the
     * per-function bookkeeping — module emit is one-shot per compile */
    return str::fromParts(ec.out.ptr, ec.out.len);
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return "";
    String out = String::new();
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;
        str s = emitFuncAsm(func, ctx);
        if (s.len > 0)
        {
            out.appendView(s);
            out.pushChar('\n');
        }
    }
    return out.asView();
}

pub bool compileModule(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx);
    return asmText.len > 0 || modd->nfuncs == 0;
}
