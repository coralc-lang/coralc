#[[no_drop_all]]
import muvm::irtypes {
    IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind,
    IrType, IrTypeKind, IrContext, IrGlobal, IrStringConst,
    IrArrayConst, IrStructConst, IrStructType
};
import muvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred, irOpcodeStr };
import muvm::regalloc::graph { graphAssignNodes };
import std::string { String };
import std::mman { alloc, dealloc, copy };
import std::vec { Vec };
import platform::libc { snprintf };
import core::cchar { cchar };

use muvm::target::primary::x86_64::linux::regs;
use muvm::target::primary::x86_64::linux::linux { ArgClass, classifyArg, typeSizeBytes, typeIsSse, INT_ARG_REGS, SSE_ARG_REGS };
use muvm::target::primary::x86_64::linux::prologue;

use muvm::target::primary::x86_64::linux::core { EmitCtx, VReg, allocaOffOf, allocaSlotFor, argRegPhys, asmSymName, canonAddr, clangifyAsm, emitFuncBeginComment, emitFuncEndComment, emitFuncLabelComment, emitUnimplemented, emitXmmReg, gepFoldRoot, instHasDef, intSfx, isVRegOperand, loadToReg, regForWidth, regName, regW, spillOff, storeToVReg, vmapFree };
use muvm::target::primary::x86_64::linux::isel_int { iselAbs, iselAlu, iselBitop, iselCast, iselDivRem, iselICmp, iselMinMax, iselMulHi, iselSelect, iselShift };
use muvm::target::primary::x86_64::linux::isel_mem { iselAlloca, iselGep, iselLoad, iselStore };
use muvm::target::primary::x86_64::linux::isel_float { iselFAbs, iselFArith, iselFCast, iselFCmp, iselFma };
use muvm::target::primary::x86_64::linux::isel_term { emitBBLabelFor, emitPhiCopies, iselBr, iselCondBr, iselRet, iselSwitch };
use muvm::target::primary::x86_64::linux::calls { iselCall };
use muvm::target::primary::x86_64::linux::regalloc { runRegAlloc };
use muvm::target::primary::x86_64::linux::simd { simdNeedsScratch, simdVecOp, SIMD_SCRATCH };

/* ================= top-level per-inst dispatch ================= */

pub bool emitInst(EmitCtx* ctx, IrInst* inst, String* err)
{
    /* rax/rdx div results only survive an adjacent div-family inst */
    switch (inst->opcode)
    {
        IrOpcode::UDiv | IrOpcode::SDiv | IrOpcode::URem | IrOpcode::SRem => {},
        else => { ctx->divValid = 0; },
    }
    switch (inst->opcode)
    {
        IrOpcode::Add => { iselAlu(ctx, inst, "add"); return true; },
        IrOpcode::Sub => { iselAlu(ctx, inst, "sub"); return true; },
        IrOpcode::And => { iselAlu(ctx, inst, "and"); return true; },
        IrOpcode::Or => { iselAlu(ctx, inst, "or"); return true; },
        IrOpcode::Xor => { iselAlu(ctx, inst, "xor"); return true; },
        IrOpcode::Mul => { iselAlu(ctx, inst, "imul"); return true; },
        IrOpcode::Shl => { iselShift(ctx, inst, "shl"); return true; },
        IrOpcode::Ashr => { iselShift(ctx, inst, "sar"); return true; },
        IrOpcode::Lshr => { iselShift(ctx, inst, "shr"); return true; },
        IrOpcode::Neg => {
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            u32 dvid = ctx->vregFor(&inst->base);
            i32 dp = (i32)ctx->vregs[(usize)dvid].phys;
            u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
            loadToReg(ctx, inst->ops[0], useR, w);
            ctx->emit("\tneg"); ctx->emit(intSfx(regW(w))); ctx->emit(" ");
            ctx->emit(regForWidth(useR, regW(w))); ctx->emitLine("");
            if (dp < 0) storeToVReg(ctx, dvid, useR, w);
            return true;
        },
        IrOpcode::Not => {
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            u32 dvid = ctx->vregFor(&inst->base);
            i32 dp = (i32)ctx->vregs[(usize)dvid].phys;
            u8 useR = dp >= 0 ? (u8)dp : regs::SCRATCH_A;
            loadToReg(ctx, inst->ops[0], useR, w);
            ctx->emit("\tnot"); ctx->emit(intSfx(regW(w))); ctx->emit(" ");
            ctx->emit(regForWidth(useR, regW(w))); ctx->emitLine("");
            if (dp < 0) storeToVReg(ctx, dvid, useR, w);
            return true;
        },
        IrOpcode::ICmp => {
            u32 dv = ctx->vregFor(&inst->base);
            if (ctx->vregs[dv].noEmit != 0) return true;
            iselICmp(ctx, inst); return true;
        },
        IrOpcode::UDiv => { iselDivRem(ctx, inst, false, false); return true; },
        IrOpcode::SDiv => { iselDivRem(ctx, inst, true, false); return true; },
        IrOpcode::URem => { iselDivRem(ctx, inst, false, true); return true; },
        IrOpcode::SRem => { iselDivRem(ctx, inst, true, true); return true; },
        IrOpcode::Alloca => { iselAlloca(ctx, inst); return true; },
        IrOpcode::Load => { iselLoad(ctx, inst); return true; },
        IrOpcode::Store => { iselStore(ctx, inst); return true; },
        IrOpcode::Gep => {
            u32 gv = ctx->vregFor(&inst->base);
            if (ctx->vregs[gv].noEmit != 0) return true;
            iselGep(ctx, inst); return true;
        },
        IrOpcode::Br => { iselBr(ctx, inst); return true; },
        IrOpcode::CondBr => { iselCondBr(ctx, inst); return true; },
        IrOpcode::Switch => { iselSwitch(ctx, inst); return true; },
        IrOpcode::Ret => { iselRet(ctx, inst); return true; },
        IrOpcode::Select => { iselSelect(ctx, inst); return true; },
        IrOpcode::Trunc | IrOpcode::Bitcast | IrOpcode::Zext | IrOpcode::Sext => {
            iselCast(ctx, inst); return true;
        },
        IrOpcode::Unreachable | IrOpcode::Noret => {
            ctx->emitLine("\tud2"); return true;
        },
        IrOpcode::Call => { iselCall(ctx, inst); return true; },
        IrOpcode::Phi => { return true; }, /* copies emitted on edges */
        IrOpcode::FAdd => { iselFArith(ctx, inst, "addss", "addsd"); return true; },
        IrOpcode::FSub => { iselFArith(ctx, inst, "subss", "subsd"); return true; },
        IrOpcode::FMul => { iselFArith(ctx, inst, "mulss", "mulsd"); return true; },
        IrOpcode::FDiv => { iselFArith(ctx, inst, "divss", "divsd"); return true; },
        IrOpcode::FSqrt => { iselFArith(ctx, inst, "sqrtss", "sqrtsd"); return true; },
        IrOpcode::Fma => { iselFma(ctx, inst); return true; },
        IrOpcode::FAbs => { iselFAbs(ctx, inst); return true; },
        IrOpcode::FCmp => { iselFCmp(ctx, inst); return true; },
        IrOpcode::FpTrunc | IrOpcode::FpExt |
        IrOpcode::SiToFp | IrOpcode::UiToFp |
        IrOpcode::FpToSi | IrOpcode::FpToUi => {
            iselFCast(ctx, inst); return true;
        },
        IrOpcode::CtPop | IrOpcode::CtLz | IrOpcode::CtTz |
        IrOpcode::Bswap | IrOpcode::Rotl | IrOpcode::Rotr => {
            iselBitop(ctx, inst); return true;
        },
        IrOpcode::MulHi | IrOpcode::SMulHi => {
            iselMulHi(ctx, inst); return true;
        },
        IrOpcode::SMin | IrOpcode::SMax |
        IrOpcode::UMin | IrOpcode::UMax => {
            iselMinMax(ctx, inst); return true;
        },
        IrOpcode::Abs => { iselAbs(ctx, inst); return true; },
        IrOpcode::VecAdd | IrOpcode::VecSub | IrOpcode::VecMul |
        IrOpcode::VecDiv | IrOpcode::VecFAdd | IrOpcode::VecFSub |
        IrOpcode::VecFMul | IrOpcode::VecFDiv | IrOpcode::VecMin |
        IrOpcode::VecMax | IrOpcode::VecBroadcast | IrOpcode::ShuffleVector |
        IrOpcode::ExtractElement | IrOpcode::InsertElement => {
            simdVecOp(ctx, inst); return true; },
        else => {
            emitUnimplemented(ctx, inst, err);
            return false;
        },
    }
    return false;
}


/* ================= prologue & arg moves ================= */

/* rbp frame is required for calls (stack alignment), incoming stack
 * args, and the usual spill/alloca/callee-save cases. */
pub bool funcNeedsFrame(IrFunc* f)
{
    if (f == null) return false;
    u32 ii = 0;
    u32 xi = 0;
    for (u32 a = 0; a < f->nargs; a++)
    {
        IrValue* av = f->args != null ? f->args[a] : null;
        if (av == null) continue;
        ArgClass cl = classifyArg(av);
        if (cl == ArgClass::INTEGER) { if (ii < 6) ii++; else return true; }
        else if (cl == ArgClass::SSE) { if (xi < 8) xi++; else return true; }
        else return true;
    }
    for (u32 b = 0; b < f->nblocks; b++)
    {
        IrBlock* bb = f->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (inst->opcode == IrOpcode::Call || inst->opcode == IrOpcode::InlineAsm)
                return true;
        }
    }
    return false;
}

pub void emitPrologue(EmitCtx* c)
{
    bool frame = c->forceFrame || c->ncallee > 0 || c->frameSize > 0 || c->allocaBytes > 0;
    if (!frame) return;
    c->emitLine("\tpushq %rbp");
    c->emitLine("\t.cfi_def_cfa_offset 16");
    c->emitLine("\t.cfi_offset %rbp, -16");
    c->emitLine("\tmovq %rsp, %rbp");
    c->emitLine("\t.cfi_def_cfa_register %rbp");
    for (u32 i = 0; i < c->ncallee; i++)
    {
        c->emit("\tpushq "); c->emit(regName(c->calleeList[i])); c->emitLine("");
        c->emit("\t.cfi_offset "); c->emit(regName(c->calleeList[i])); c->emit(", -");
        c->emitI64((i64)(24 + 8 * (i32)i)); c->emitLine("");
    }
    /* frameTotal = spill + alloca, padded so rsp stays 16-aligned.
     * entry rsp%16==8; after push rbp + ncallee pushes rsp%16 ==
     * (8 - 8*(1+ncallee)) mod 16; sub must make it 0. */
    i64 total = (i64)c->frameSize + (i64)c->allocaBytes;
    i64 mis = (8 - 8 * (i64)(1 + c->ncallee) - total) % 16;
    if (mis < 0) mis += 16;
    i64 sub = total + mis;
    if (sub > 0)
    {
        c->emit("\tsubq $"); c->emitI64(sub); c->emit(", %rsp\n");
    }
}

/* move incoming arg `av` (already classified) from its ABI location
 * into its vreg home. srcK: 0=gpr reg(srcP), 1=xmm(srcP), 2=stack(off) */
pub void emitArgIn(EmitCtx* c, IrValue* av, u8 srcK, u8 srcP, i32 srcOff)
{
    u32 vid = c->vregFor(av);
    VReg* r = &c->vregs[(usize)vid];
    u32 w = av->type != null ? av->type->width : 64;
    if (srcK == 0)
    {
        /* gpr arg reg -> vreg loc */
        if (r->phys >= 0 && r->klass != 1)
        {
            if ((i32)srcP != r->phys)
            {
                c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
                c->emit(regForWidth(srcP, regW(w))); c->emit(", ");
                c->emit(regForWidth((u8)r->phys, regW(w))); c->emitLine("");
            }
        }
        else if (r->phys < 0)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emit(regForWidth(srcP, regW(w))); c->emit(", -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
        else
        {
            c->emit("\t# isel: gpr->xmm arg move unsupported\n");
        }
    }
    else if (srcK == 1)
    {
        /* xmm arg reg -> vreg loc */
        if (r->phys >= 0 && r->klass == 1)
        {
            if ((i32)srcP != r->phys)
            {
                c->emit("\tmovaps "); emitXmmReg(c, srcP); c->emit(", ");
                emitXmmReg(c, (u8)r->phys); c->emitLine("");
            }
        }
        else if (r->phys < 0)
        {
            u32 sz = typeSizeBytes(av->type);
            c->emit(sz <= 8 ? "\tmovsd " : "\tmovups ");
            emitXmmReg(c, srcP); c->emit(", -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
    }
    else
    {
        /* incoming stack arg at [rbp+16+srcOff] */
        if (r->phys >= 0 && r->klass != 1)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emitI64((i64)srcOff); c->emit("(%rbp), ");
            c->emit(regForWidth((u8)r->phys, regW(w))); c->emitLine("");
        }
        else if (r->phys < 0)
        {
            c->emit("\tmov"); c->emit(intSfx(regW(w))); c->emit(" ");
            c->emitI64((i64)srcOff); c->emit("(%rbp), -");
            c->emitI64((i64)spillOff(c, r->slot)); c->emit("(%rbp)\n");
        }
    }
}

pub void emitArgMoves(EmitCtx* c)
{
    IrFunc* f = c->func;
    u32 ii = 0;
    u32 xi = 0;
    u32 si = 0;
    for (u32 a = 0; a < f->nargs; a++)
    {
        IrValue* av = f->args[a];
        if (av == null) continue;
        ArgClass cl = classifyArg(av);
        if (cl == ArgClass::INTEGER)
        {
            if (ii < 6)
            {
                emitArgIn(c, av, 0, argRegPhys((u8)ii), 0);
                ii++;
            }
            else
            {
                i32 off = 16 + 8 * (i32)si;
                emitArgIn(c, av, 2, 0, off);
                si++;
            }
        }
        else if (cl == ArgClass::SSE)
        {
            if (xi < 8)
            {
                emitArgIn(c, av, 1, (u8)xi, 0);
                xi++;
            }
            else
            {
                i32 off = 16 + 8 * (i32)si;
                emitArgIn(c, av, 2, 0, off);
                si++;
            }
        }
        else
        {
            i32 off = 16 + 8 * (i32)si;
            emitArgIn(c, av, 2, 0, off);
            si++;
        }
    }
}


/* ================= function driver ================= */

pub str emitFuncAsm(IrFunc* func, IrContext* ctx)
{
    if (func == null || ctx == null) return "";
    EmitCtx ec = EmitCtx::new();
    ec.func = func;
    ec.ictx = ctx;

    /* load-CSE pre-pass: pair redundant loads before vreg sizing so
     * aliases are consistent through liveness and emission */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        usize[32] caddr; usize[32] cval; u32[32] cw; u32 cn = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (inst->opcode == IrOpcode::Store || inst->opcode == IrOpcode::Call ||
                inst->opcode == IrOpcode::InlineAsm)
            { cn = 0; continue; }
            if (inst->opcode != IrOpcode::Load || inst->nops < 1) continue;
            /* aggregate loads yield the pointer itself, not loaded
             * data — never CSE them against scalar/vector loads */
            IrType* lt = inst->base.type;
            if (lt != null && (lt->kind == IrTypeKind::Struct ||
                lt->kind == IrTypeKind::Array || lt->kind == IrTypeKind::Union))
                continue;
            IrValue* addr = canonAddr(&ec, inst->ops[0]);
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            IrValue* hit = null;
            for (u32 k = 0; k < cn; k++)
                if (caddr[k] == (usize)addr && cw[k] == w) { hit = (IrValue*)(usize)cval[k]; break; }
            if (hit != null)
            {
                /* canonical: follow existing alias chain */
                IrValue* canon = ec.cseFind(hit);
                ec.cseAdd(&inst->base, canon != null ? canon : hit);
            }
            else if (cn < 32)
            {
                caddr[cn] = (usize)addr; cval[cn] = (usize)&inst->base; cw[cn] = w; cn++;
            }
        }
    }

    /* args first: identity-op aliasing in vregFor needs them mapped */
    for (u32 a = 0; a < func->nargs; a++)
        if (func->args != null && func->args[a] != null) ec.vregFor(func->args[a]);

    /* vreg sizing walk */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (instHasDef(inst)) ec.vregFor(&inst->base);
            for (u32 k = 0; k < inst->nops; k++)
            {
                IrValue* ov = inst->ops[k];
                if (ov == null || !isVRegOperand(ov)) continue;
                u32 ovv = ec.vregFor(ov);
                ec.vregs[ovv].nuses++;
            }
        }
    }
    runRegAlloc(&ec);

    /* mark compares whose only use is a fused condbr: iselCondBr re-uses
     * the icmp operands directly, so the setcc result would be dead. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::CondBr || inst->nops < 1)
                continue;
            IrValue* cond = inst->ops[0];
            if (cond == null || cond->kind != IrValueKind::Inst) continue;
            IrInst* ic = (IrInst*)cond;
            if (ic->opcode != IrOpcode::ICmp) continue;
            u32 cv = ec.vregFor(&ic->base);
            if (ec.vregs[cv].nuses == 1) ec.vregs[cv].noEmit = 1;
        }
    }

    /* const-gep folding: a gep with all-constant indices whose every
     * user is another gep (as its base operand) never needs a register
     * — users fold through it via gepFoldRoot. Dead geps (no users)
     * qualify too. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Gep || inst->nops < 2)
                continue;
            bool allConst = true;
            for (u32 gi = 1; gi < inst->nops; gi++)
                if (inst->ops[gi] == null ||
                    inst->ops[gi]->kind != IrValueKind::ConstInt)
                    allConst = false;
            if (!allConst) continue;
            bool foldable = true;
            for (u32 ui = 0; ui < inst->base.nusers; ui++)
            {
                IrInst* u = inst->base.users[ui];
                if (u == null || u->opcode != IrOpcode::Gep || u->nops < 1 ||
                    u->ops[0] != &inst->base)
                { foldable = false; break; }
            }
            if (foldable)
            {
                u32 gv = ec.vregFor(&inst->base);
                ec.vregs[gv].noEmit = 1;
            }
        }
    }

    /* pre-scan allocas so the prologue reserves their frame space */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Alloca) continue;
            IrType* et = inst->base.type;
            if (et != null && et->kind == IrTypeKind::Ptr) et = et->elem;
            u32 sz = et != null ? ctx->irTypeSizeOf(et) : 8;
            if (sz == 0) sz = 8;
            ec.allocaBytes += (i32)((sz + 15) / 16 * 16);
        }
    }

    /* alloca folding: an alloca used only as the base operand of
     * all-const geps never needs a register — every use folds to
     * rbp-off(+const) inside iselGep. Mark noEmit and pre-assign the
     * frame slot so allocaOffOf resolves during emission. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null || inst->opcode != IrOpcode::Alloca) continue;
            bool foldable = true;
            for (u32 ui = 0; ui < inst->base.nusers; ui++)
            {
                IrInst* u = inst->base.users[ui];
                if (u == null || u->opcode != IrOpcode::Gep || u->nops < 1 ||
                    u->ops[0] != &inst->base)
                { foldable = false; break; }
                bool uc = true;
                for (u32 gi = 1; gi < u->nops; gi++)
                    if (u->ops[gi] == null ||
                        u->ops[gi]->kind != IrValueKind::ConstInt)
                        uc = false;
                if (!uc) { foldable = false; break; }
            }
            if (!foldable) continue;
            IrType* et = inst->base.type;
            if (et != null && et->kind == IrTypeKind::Ptr) et = et->elem;
            u32 sz = et != null ? ctx->irTypeSizeOf(et) : 8;
            if (sz == 0) sz = 8;
            allocaSlotFor(&ec, &inst->base, sz);
            u32 av = ec.vregFor(&inst->base);
            ec.vregs[av].noEmit = 1;
        }
    }

    /* SIMD scratch reservation: packed-path misses and lane-wise
     * fallbacks stage through the alloca frame region. Must run after
     * regalloc (operand phys homes affect the predicate) and before
     * the prologue sizes the frame. */
    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            if (simdNeedsScratch(&ec, inst))
                ec.allocaBytes = ec.allocaBytes + (i32)SIMD_SCRATCH;
        }
    }

    ec.forceFrame = funcNeedsFrame(func);

    /* header + prologue, clang-style layout */
    u64 fid = (u64)func->base.id;
    ec.emitLine("\t.text");
    ec.emit("\t.globl\t"); ec.emit(func->base.name);
    emitFuncBeginComment(&ec, func->base.name);
    /* GNU as rejects a symbol in .p2align's max-skip operand (clang's
     * `.p2align 4, .Lfunc_endN, nop` is llvm-mc syntax), so keep the
     * bare form. */
    ec.emit("\t.p2align\t4\n");
    ec.emit("\t.type\t"); ec.emit(func->base.name); ec.emit(",@function\n");
    ec.emit(func->base.name); ec.emit(":");
    emitFuncLabelComment(&ec, func->base.name);
    ec.emitLine("\t.cfi_startproc");
    emitPrologue(&ec);
    emitArgMoves(&ec);

    for (u32 b = 0; b < func->nblocks; b++)
    {
        IrBlock* bb = func->blocks[b];
        if (bb == null) continue;
        ec.emit("# %bb."); ec.emitU64((u64)b); ec.emitLine(":");
        ec.divValid = 0;
        emitBBLabelFor(&ec, &bb->base);
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst == null) continue;
            /* phi copies go on the edge: emit right before terminator.
             * CondBr/Switch handle their own per-edge copies inside
             * their isel (each edge is distinct). */
            if (inst->opcode == IrOpcode::Br)
                emitPhiCopies(&ec, bb);
            String err = String::new();
            if (!emitInst(&ec, inst, &err))
            {
                ec.emit("\t# ");
                ec.emit(err.asView());
                ec.emitLine("");
                err.free();
            }
        }
    }
    ec.emit(".Lfunc_end"); ec.emitU64(fid); ec.emitLine(":");
    ec.emit("\t.size\t"); ec.emit(func->base.name); ec.emit(", .Lfunc_end");
    ec.emitU64(fid); ec.emit("-"); ec.emit(func->base.name); ec.emitLine("");
    ec.emitLine("\t.cfi_endproc");
    emitFuncEndComment(&ec);

    str result = clangifyAsm(ec.out.asView());
    if (ec.vregs != null) dealloc<VReg>(ec.vregs);
    if (ec.allocaVals != null) dealloc<IrValue*>(ec.allocaVals);
    if (ec.allocaOffs != null) dealloc<i32>(ec.allocaOffs);
    vmapFree(&ec.vmap);
    ec.usedCallee.dispose();
    return result;
}

/* ================= data emission ================= */

pub void dataEmit(String* out, str s) { out->appendView(s); }

pub void dataEmitLine(String* out, str s)
{
    out->appendView(s);
    out->pushChar('\n');
}

pub void dataEmitI64(String* out, i64 v)
{
    cchar[32] buf;
    i32 n = snprintf(buf, 32, C"%lld", v);
    if (n > 0) out->appendView(str::fromParts((const u8*)buf, (usize)n));
}

pub void dataEmitU64(String* out, u64 v)
{
    cchar[32] buf;
    i32 n = snprintf(buf, 32, C"%llu", v);
    if (n > 0) out->appendView(str::fromParts((const u8*)buf, (usize)n));
}

pub void emitEscapedAscizData(String* out, const u8* data, u32 len)
{
    out->appendView("\t.asciz \"");
    for (u32 i = 0; i < len; i++)
    {
        u8 ch = data[i];
        if (ch == 10) out->appendView("\\n");
        else if (ch == 9) out->appendView("\\t");
        else if (ch == 13) out->appendView("\\r");
        else if (ch == 34) out->appendView("\\\"");
        else if (ch == 92) out->appendView("\\\\");
        else if (ch >= 32 && ch <= 126)
        {
            u8[1] one;
            one[0] = ch;
            out->appendView(str::fromParts((const u8*)one, 1));
        }
        else
        {
            cchar[8] oct;
            snprintf(oct, 8, C"\\%03o", (u32)ch);
            out->appendView(str::fromCstr((cchar*)oct));
        }
    }
    out->appendView("\"\n");
}

pub void emitDataValue(String* out, IrModule* modd, IrContext* ctx, IrValue* v)
{
    if (v == null)
    {
        dataEmitLine(out, "\t.quad 0");
        return;
    }
    switch (v->kind)
    {
        IrValueKind::ConstInt => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w <= 8)
            {
                dataEmit(out, "\t.byte "); dataEmitI64(out, (i64)(u8)v->valData); dataEmitLine(out, "");
            }
            else if (w <= 16)
            {
                dataEmit(out, "\t.short "); dataEmitI64(out, (i64)(u16)v->valData); dataEmitLine(out, "");
            }
            else if (w <= 32)
            {
                dataEmit(out, "\t.long "); dataEmitI64(out, (i64)(i32)v->valData); dataEmitLine(out, "");
            }
            else
            {
                dataEmit(out, "\t.quad "); dataEmitI64(out, (i64)v->valData); dataEmitLine(out, "");
            }
        },
        IrValueKind::ConstFloat => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w <= 32)
            {
                dataEmit(out, "\t.long "); dataEmitU64(out, (u64)(u32)v->valData); dataEmitLine(out, "");
            }
            else
            {
                dataEmit(out, "\t.quad "); dataEmitU64(out, v->valData); dataEmitLine(out, "");
            }
        },
        IrValueKind::StringConst => {
            IrStringConst* sc = (IrStringConst*)v;
            emitEscapedAscizData(out, sc->data, sc->length);
        },
        IrValueKind::ConstArray => {
            IrArrayConst* ac = (IrArrayConst*)v;
            for (u32 i = 0; i < ac->nelems; i++)
                emitDataValue(out, modd, ctx, ac->elems[i]);
        },
        IrValueKind::StructConst => {
            IrStructConst* st = (IrStructConst*)v;
            IrStructType* sst = null;
            if (modd != null)
            {
                for (u32 si = 0; si < modd->nstructs; si++)
                {
                    IrStructType* cand = modd->structs[si];
                    if (cand != null && cand->irType == v->type) { sst = cand; break; }
                }
            }
            u32 run = 0;
            for (u32 i = 0; i < st->nelems; i++)
            {
                IrValue* fv = st->elems[i];
                u32 fo = sst != null && sst->offsets != null && i < sst->nfields
                    ? sst->offsets[i] : run;
                if (fo > run)
                {
                    dataEmit(out, "\t.zero "); dataEmitU64(out, (u64)(fo - run)); dataEmitLine(out, "");
                    run = fo;
                }
                emitDataValue(out, modd, ctx, fv);
                u32 fsz = fv != null && fv->type != null && ctx != null
                    ? ctx->irTypeSizeOf(fv->type) : 0;
                run = fo + fsz;
            }
            if (sst != null && sst->size > run)
            {
                dataEmit(out, "\t.zero "); dataEmitU64(out, (u64)(sst->size - run)); dataEmitLine(out, "");
            }
        },
        IrValueKind::Global | IrValueKind::Func => {
            dataEmit(out, "\t.quad "); dataEmitLine(out, asmSymName(v));
        },
        else => {
            dataEmitLine(out, "\t.quad 0");
        }
    }
}

pub u32 dataAlignExp(u32 align)
{
    if (align <= 1) return 0;
    u32 e = 0;
    while (((u32)1 << e) < align && e < 16) e++;
    return ((u32)1 << e) == align ? e : 0;
}

pub void emitDataAlign(String* out, u32 align)
{
    u32 e = dataAlignExp(align);
    if (align > 1 && e != 0)
    {
        out->appendView("\t.p2align\t");
        dataEmitU64(out, (u64)e);
        out->appendView(", 0x0\n");
    }
    else if (align > 1)
    {
        out->appendView("\t.balign\t");
        dataEmitU64(out, (u64)align);
        out->pushChar('\n');
    }
}

pub void emitDataAsm(String* out, IrModule* modd, IrContext* ctx)
{
    if (modd == null) return;
    if (modd->nconstStrings > 0)
    {
        out->appendView("\t.section\t.rodata\n");
        for (u32 i = 0; i < modd->nconstStrings; i++)
        {
            IrStringConst* sc = modd->constStrings[i];
            if (sc == null) continue;
            emitDataAlign(out, 1);
            if (!sc->base.name.isEmpty())
            {
                out->appendView(sc->base.name); out->pushChar(':'); out->pushChar('\n');
            }
            else
            {
                out->appendView(".Lstr_"); dataEmitU64(out, (u64)sc->base.id); out->appendView(":\n");
            }
            emitEscapedAscizData(out, sc->data, sc->length);
        }
        out->pushChar('\n');
    }
    for (u32 gi = 0; gi < modd->nglobals; gi++)
    {
        IrGlobal* g = modd->globals[gi];
        if (g == null || g->isExtern) continue;
        out->appendView(g->isConst ? "\t.section\t.rodata\n" : "\t.section\t.data\n");
        u32 align = g->alignment != 0 ? g->alignment : 8;
        emitDataAlign(out, align);
        out->appendView("\t.type\t"); out->appendView(g->base.name); out->appendView(",@object\n");
        out->appendView("\t.globl\t"); out->appendView(g->base.name); out->pushChar('\n');
        out->appendView(g->base.name); out->appendView(":\n");
        if (g->initVal != null)
            emitDataValue(out, modd, ctx, g->initVal);
        else
        {
            u32 sz = 8;
            if (ctx != null && g->base.type != null)
                sz = ctx->irTypeSizeOf(g->base.type);
            if (sz == 0) sz = 8;
            out->appendView("\t.zero "); dataEmitU64(out, (u64)sz); out->pushChar('\n');
        }
        out->appendView("\t.size\t"); out->appendView(g->base.name);
        out->appendView(", .-"); out->appendView(g->base.name); out->pushChar('\n');
        out->pushChar('\n');
    }
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return "";
    String out = String::new();
    out.appendView("\t.att_syntax\n\t.file \"muvm\"\n\n");
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;
        str s = emitFuncAsm(func, ctx);
        if (s.len > 0) { out.appendView(s); out.pushChar('\n'); }
    }
    emitDataAsm(&out, modd, ctx);
    out.appendView("\n\t.ident\t\"muvm\"\n");
    out.appendView("\t.section\t\".note.GNU-stack\",\"\",@progbits\n");
    return out.asView();
}

pub bool compileModule(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx);
    return asmText.len > 0 || modd->nfuncs == 0;
}
