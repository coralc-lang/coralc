#[[no_drop_all]]
// Primary codegen: optimized code generation with graph register allocation
// and minimal prologue/epilogue overhead.
import muvm::irtypes { IrModule, IrFunc, IrContext };
import muvm::base::irtypes { TargetArch };
import std::string { String };
pub mod x86_64 = use x86_64;

pub str emitFuncAsm(IrFunc* func, IrContext* ctx, u32 arch)
{
    if (func == null || ctx == null) return "";
    if (arch == (u32)TargetArch::X86_64) return x86_64::emitFuncAsm(func, ctx, false);
    return "";
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx, u32 arch)
{
    if (modd == null || ctx == null) return "";
    if (arch == (u32)TargetArch::X86_64) return x86_64::emitModuleAsm(modd, ctx, false);
    return "";
}

pub bool compileModule(IrModule* modd, IrContext* ctx, u32 arch)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx, arch);
    return asmText.len > 0 || modd->nfuncs == 0;
}
