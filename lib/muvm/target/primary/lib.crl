#[[no_drop_all]]
// Primary codegen: optimized code generation with graph register allocation
// and minimal prologue/epilogue overhead.
import muvm::irtypes { IrModule, IrFunc, IrContext };
import std::string { String };
pub mod x86_64 = use x86_64;

pub str primaryEmitFuncAsm(IrFunc* func, IrContext* ctx, u32 arch)
{
    if (func == null || ctx == null) return "";
    if (arch == 0 /* TargetArch::X86_64 ordinal */) return x86_64::x86_64EmitFuncAsm(func, ctx, false);
    return "";
}

pub str primaryEmitModuleAsm(IrModule* modd, IrContext* ctx, u32 arch)
{
    if (modd == null || ctx == null) return "";
    if (arch == 0 /* TargetArch::X86_64 ordinal */) return x86_64::x86_64EmitModuleAsm(modd, ctx, false);
    return "";
}

pub bool primaryCompileModule(IrModule* modd, IrContext* ctx, u32 arch)
{
    if (modd == null || ctx == null) return false;
    str asmText = primaryEmitModuleAsm(modd, ctx, arch);
    return asmText.len > 0 || modd->nfuncs == 0;
}
