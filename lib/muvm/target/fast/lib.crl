#[[no_drop_all]]
// Fast codegen for muvm.
// Uses a slot-based register allocation with standard prologue and epilogue.

pub mod x86_64 = use x86_64;

import muvm::target::fast::x86_64 { emitFastX86Func };
import muvm::irtypes { IrModule, IrFunc, IrContext, IrGlobal, IrStringConst };
import std::string { String };

pub str emitFuncAsm(IrFunc* func, IrContext* ctx)
{
    if (func == null || ctx == null) return "";
    return emitFastX86Func(func, ctx);
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return "";

    String out = String::new();
    out.appendView("    .text\n");

    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;

        str fAsm = emitFastX86Func(func, ctx);
        if (fAsm.len > 0)
        {
            out.appendView(fAsm);
            out.pushChar('\n');
        }
    }

    // Globals and data section if present
    if (modd->nglobals > 0 || modd->nconstStrings > 0)
    {
        out.appendView("    .data\n");
        for (u32 gi = 0; gi < modd->nglobals; gi++)
        {
            IrGlobal* g = modd->globals[gi];
            if (g == null || g->isExtern) continue;
            out.appendView(".globl ");
            out.appendView(g->base.name);
            out.pushChar('\n');
            out.appendView(g->base.name);
            out.appendView(":\n");
            out.appendView("    .quad 0\n");
        }
    }

    return out.asView();
}

pub bool compileModule(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx);
    return asmText.len > 0 || modd->nfuncs == 0;
}
