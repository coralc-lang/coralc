#[[no_drop_all]]
// Fast x86_64 text codegen for muvm.
// Supports both Linux (SystemV ABI) and Windows (Win64 ABI).
// Emits rich assembly metadata, section placement (hot/cold),
// and full data emission (strings, arrays, integers, structs).

import muvm::irtypes {
    IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind,
    IrType, IrTypeKind, IrContext, IrGlobal, IrStringConst,
    IrArrayConst, IrStructConst
};
import muvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred, IrAtomicRmwOp, IrAtomicOrdering, irOpcodeStr };
import muvm::irMetadata { funcIsHot, funcIsCold, funcIsLeaf, funcIsOptNone, funcIsNoReturn };
import muvm::assembly::common { parseConstraints, AsmConstraint, AsmConClass, AsmParseError };
import std::string { String };
import std::mman { alloc, dealloc };
import platform::libc { snprintf };
import core::cchar { cchar };

struct ValueSlot
{
    IrValue* val;
    i32 offset; // negative offset from %rbp
}

pub struct FastX86Context
{
    String out;
    ValueSlot* slots;
    u32 nslots;
    u32 capSlots;
    i32 frameSize;
    str funcName;
    bool isWindows;

    static FastX86Context new(bool isWindows)
    {
        return FastX86Context {
            .out = String::new(),
            .slots = null,
            .nslots = 0,
            .capSlots = 0,
            .frameSize = 0,
            .funcName = str::empty(),
            .isWindows = isWindows
        };
    }

    void destroy()
    {
        if (self.slots != null) dealloc<ValueSlot>(self.slots);
        self.out.free();
    }

    void emit(str s)
    {
        self.out.appendView(s);
    }

    void emitLine(str s)
    {
        self.out.appendView(s);
        self.out.pushChar('\n');
    }

    void emitI64(i64 v)
    {
        cchar[32] buf;
        i32 n = snprintf(buf, 32, C"%lld", v);
        if (n > 0) self.out.appendView(str::fromParts((const u8*)buf, (usize)n));
    }

    void emitU64(u64 v)
    {
        cchar[32] buf;
        i32 n = snprintf(buf, 32, C"%llu", v);
        if (n > 0) self.out.appendView(str::fromParts((const u8*)buf, (usize)n));
    }

    void addSlot(IrValue* v, i32 off)
    {
        if (self.nslots >= self.capSlots)
        {
            u32 newCap = self.capSlots != 0 ? self.capSlots * 2 : 16;
            ValueSlot* ns = alloc<ValueSlot>((usize)newCap);
            for (u32 i = 0; i < self.nslots; i++) ns[i] = self.slots[i];
            if (self.slots != null) dealloc<ValueSlot>(self.slots);
            self.slots = ns;
            self.capSlots = newCap;
        }
        self.slots[self.nslots].val = v;
        self.slots[self.nslots].offset = off;
        self.nslots++;
    }

    i32 getSlot(IrValue* v)
    {
        for (u32 i = 0; i < self.nslots; i++)
        {
            if (self.slots[i].val == v) return self.slots[i].offset;
        }
        return 0;
    }
}

// SystemV ABI (Linux / macOS / BSD)
static str[] SYSV_ARG_REGS_64 = { "rdi", "rsi", "rdx", "rcx", "r8", "r9" };

// Win64 ABI (Windows)
static str[] WIN64_ARG_REGS_64 = { "rcx", "rdx", "r8", "r9" };

bool funcUsesWin64(IrFunc* func, bool targetIsWindows)
{
    // Calling conventions: SystemV = 0, Win64 = 1, SyscallWin64 = 2
    if (func->cc == 1 || func->cc == 2) return true;
    if (func->cc == 0 && targetIsWindows) return true;
    return targetIsWindows;
}

void emitValueToReg(FastX86Context* ctx, IrValue* v, str reg64)
{
    if (v == null)
    {
        ctx->emit("    xorq %");
        ctx->emit(reg64);
        ctx->emit(", %");
        ctx->emitLine(reg64);
        return;
    }

    if (v->kind == IrValueKind::ConstInt)
    {
        ctx->emit("    movabsq $");
        ctx->emitI64((i64)v->valData);
        ctx->emit(", %");
        ctx->emitLine(reg64);
        return;
    }

    if (v->kind == IrValueKind::ConstFloat)
    {
        ctx->emit("    movabsq $");
        ctx->emitU64(v->valData);
        ctx->emit(", %");
        ctx->emitLine(reg64);
        return;
    }

    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::Func || v->kind == IrValueKind::StringConst)
    {
        ctx->emit("    leaq ");
        ctx->emit(v->name);
        ctx->emit("(%rip), %");
        ctx->emitLine(reg64);
        return;
    }

    i32 off = ctx->getSlot(v);
    ctx->emit("    movq ");
    ctx->emitI64((i64)off);
    ctx->emit("(%rbp), %");
    ctx->emitLine(reg64);
}

void emitRegToSlot(FastX86Context* ctx, IrValue* v, str reg64)
{
    i32 off = ctx->getSlot(v);
    ctx->emit("    movq %");
    ctx->emit(reg64);
    ctx->emit(", ");
    ctx->emitI64((i64)off);
    ctx->emitLine("(%rbp)");
}

/* per-block label `.L<func>_BB<id>`: block names are NOT unique —
 * lowering reuses "if.then"/"sw.body" in every function — so the label
 * keys off the block's unique value id, gcc `.LBB<number>` style. */
void emitBBLabel(FastX86Context* ctx, IrFunc* func, IrValue* bv)
{
    ctx->emit(".L");
    ctx->emit(func->base.name);
    ctx->emit("_BB");
    ctx->emitU64(bv != null ? (u64)bv->id : (u64)0);
}

/* emit the incoming-value copies for phis in each successor block.
 * phi operands are interleaved (val, block)*; the copy for predecessor
 * `pred` must run on the edge pred->succ, i.e. at the end of `pred`
 * before its terminator. Values live in stack slots, so a slot-to-slot
 * move is sufficient. */
void emitPhiCopies(FastX86Context* ctx, IrContext* ictx, IrBlock* pred, IrInst* term)
{
    u32 nsucc = 0;
    IrValue*[64] succs;
    if (term->opcode == IrOpcode::Br && term->nops > 0)
    {
        succs[nsucc++] = term->ops[0];
    }
    else if (term->opcode == IrOpcode::CondBr && term->nops > 2)
    {
        /* ops: cond, thenBlock, elseBlock */
        succs[nsucc++] = term->ops[1];
        succs[nsucc++] = term->ops[2];
    }
    else if (term->opcode == IrOpcode::Switch && term->nops > 1)
    {
        /* ops: sel, default, (val, blk)* — block operands at odd idx */
        for (u32 k = 1; k < term->nops; k += 2)
            if (nsucc < 64) succs[nsucc++] = term->ops[k];
    }
    for (u32 s = 0; s < nsucc; s++)
    {
        IrValue* sv = succs[s];
        if (sv == null || sv->kind != IrValueKind::Block) continue;
        IrBlock* sb = (IrBlock*)sv;
        for (u32 pi = 0; pi < sb->ninsts; pi++)
        {
            IrInst* phi = sb->insts[pi];
            if (phi == null || phi->opcode != IrOpcode::Phi) continue;
            for (u32 k = 0; k + 1 < phi->nops; k += 2)
            {
                if (phi->ops[k + 1] == &pred->base && phi->ops[k] != null)
                {
                    IrValue* src = phi->ops[k];
                    IrValue* dst = &phi->base;
                    // vector phis occupy count*elemSize bytes — copy
                    // lane-by-lane or only lane 0 would land
                    if (dst->type != null &&
                        dst->type->kind == IrTypeKind::Vector &&
                        vecLaneOk(src))
                    {
                        IrType* vt = dst->type;
                        u32 lb = vecLaneBytes(ictx, vt);
                        u32 ew = vt->elem != null
                            ? ictx->irTypeSizeOf(vt->elem) * 8 : 64;
                        i32 laneOff = 0;
                        for (u32 lane = 0; lane < vt->count; lane++)
                        {
                            emitVecLaneLoad(ctx, src, laneOff, ew, "rax", false);
                            emitVecLaneStore(ctx, dst, laneOff, ew, "rax");
                            laneOff += (i32)lb;
                        }
                    }
                    else
                    {
                        emitValueToReg(ctx, src, "rax");
                        emitRegToSlot(ctx, dst, "rax");
                    }
                    break;
                }
            }
        }
    }
}

/* byte offset of field `fi` in a struct IrType, recomputed with the
 * same alignment rules createStructTypeFlags uses (packed = tflags bit0) */
u64 emitStructFieldOff(IrContext* ictx, IrType* sty, u32 fi)
{
    if (sty == null || fi >= sty->nparams) return 0;
    bool packed = (sty->tflags & 1) != 0;
    u64 off = 0;
    for (u32 i = 0; i <= fi; i++)
    {
        IrType* ft = sty->params[i];
        if (!packed && ft != null)
        {
            u64 al = (u64)ictx->irTypeAlignOf(ft);
            if (al > 1) off = (off + al - 1) / al * al;
        }
        if (i == fi) return off;
        if (ft != null) off += (u64)ictx->irTypeSizeOf(ft);
    }
    return 0;
}

// ── shared lowering helpers (vector lanes, inline asm, atomics) ─────

str x86Reg32(str r)
{
    if (r.equals("rax")) return "eax";
    if (r.equals("rcx")) return "ecx";
    if (r.equals("rdx")) return "edx";
    if (r.equals("rsi")) return "esi";
    if (r.equals("rdi")) return "edi";
    if (r.equals("r8")) return "r8d";
    if (r.equals("r9")) return "r9d";
    if (r.equals("r10")) return "r10d";
    if (r.equals("r11")) return "r11d";
    if (r.equals("rbx")) return "ebx";
    if (r.equals("r12")) return "r12d";
    if (r.equals("r13")) return "r13d";
    if (r.equals("r14")) return "r14d";
    if (r.equals("r15")) return "r15d";
    return r;
}

str x86Reg16(str r)
{
    if (r.equals("rax")) return "ax";
    if (r.equals("rcx")) return "cx";
    if (r.equals("rdx")) return "dx";
    if (r.equals("rsi")) return "si";
    if (r.equals("rdi")) return "di";
    if (r.equals("r8")) return "r8w";
    if (r.equals("r9")) return "r9w";
    if (r.equals("r10")) return "r10w";
    if (r.equals("r11")) return "r11w";
    if (r.equals("rbx")) return "bx";
    if (r.equals("r12")) return "r12w";
    if (r.equals("r13")) return "r13w";
    if (r.equals("r14")) return "r14w";
    if (r.equals("r15")) return "r15w";
    return r;
}

str x86Reg8(str r)
{
    if (r.equals("rax")) return "al";
    if (r.equals("rcx")) return "cl";
    if (r.equals("rdx")) return "dl";
    if (r.equals("rsi")) return "sil";
    if (r.equals("rdi")) return "dil";
    if (r.equals("r8")) return "r8b";
    if (r.equals("r9")) return "r9b";
    if (r.equals("r10")) return "r10b";
    if (r.equals("r11")) return "r11b";
    if (r.equals("rbx")) return "bl";
    if (r.equals("r12")) return "r12b";
    if (r.equals("r13")) return "r13b";
    if (r.equals("r14")) return "r14b";
    if (r.equals("r15")) return "r15b";
    return r;
}

// reg-name for a width: emit the right sub-register of `reg64`
str x86RegForWidth(str reg64, u32 width)
{
    if (width <= 8) return x86Reg8(reg64);
    if (width <= 16) return x86Reg16(reg64);
    if (width <= 32) return x86Reg32(reg64);
    return reg64;
}

// Load `width` bits from `disp(%rbp)` into `reg` (zero-extended unless
// signExt, which uses the movs* forms for sub-64 lanes).
void emitSlotLoad(FastX86Context* ctx, i32 disp, u32 width, str reg, bool signExt)
{
    if (width <= 8)
    {
        ctx->emit(signExt ? "    movsbl " : "    movzbl ");
        ctx->emitI64((i64)disp);
        ctx->emit("(%rbp), %");
        ctx->emitLine(x86Reg32(reg));
    }
    else if (width <= 16)
    {
        ctx->emit(signExt ? "    movswl " : "    movzwl ");
        ctx->emitI64((i64)disp);
        ctx->emit("(%rbp), %");
        ctx->emitLine(x86Reg32(reg));
    }
    else if (width <= 32)
    {
        if (signExt)
        {
            ctx->emit("    movslq ");
            ctx->emitI64((i64)disp);
            ctx->emit("(%rbp), %");
            ctx->emitLine(reg);
        }
        else
        {
            ctx->emit("    movl ");
            ctx->emitI64((i64)disp);
            ctx->emit("(%rbp), %");
            ctx->emitLine(x86Reg32(reg));
        }
    }
    else
    {
        ctx->emit("    movq ");
        ctx->emitI64((i64)disp);
        ctx->emit("(%rbp), %");
        ctx->emitLine(reg);
    }
}

void emitSlotStore(FastX86Context* ctx, i32 disp, u32 width, str reg)
{
    ctx->emit("    ");
    if (width <= 8)
    {
        ctx->emit("movb %");
        ctx->emit(x86Reg8(reg));
    }
    else if (width <= 16)
    {
        ctx->emit("movw %");
        ctx->emit(x86Reg16(reg));
    }
    else if (width <= 32)
    {
        ctx->emit("movl %");
        ctx->emit(x86Reg32(reg));
    }
    else
    {
        ctx->emit("movq %");
        ctx->emit(reg);
    }
    ctx->emit(", ");
    ctx->emitI64((i64)disp);
    ctx->emitLine("(%rbp)");
}

// load/store through a pointer held in `baseReg` (e.g. (%rbx))
void emitIndLoad(FastX86Context* ctx, str baseReg, u32 width, str reg, bool signExt)
{
    str mn = "movq";
    str rn = reg;
    if (width <= 8) { mn = signExt ? "movsbl" : "movzbl"; rn = x86Reg32(reg); }
    else if (width <= 16) { mn = signExt ? "movswl" : "movzwl"; rn = x86Reg32(reg); }
    else if (width <= 32)
    {
        if (signExt) { mn = "movslq"; }
        else { mn = "movl"; rn = x86Reg32(reg); }
    }
    ctx->emit("    ");
    ctx->emit(mn);
    ctx->emit(" (%");
    ctx->emit(baseReg);
    ctx->emit("), %");
    ctx->emitLine(rn);
}

void emitIndStore(FastX86Context* ctx, str baseReg, u32 width, str reg)
{
    str mn = "movq";
    str rn = reg;
    if (width <= 8) { mn = "movb"; rn = x86Reg8(reg); }
    else if (width <= 16) { mn = "movw"; rn = x86Reg16(reg); }
    else if (width <= 32) { mn = "movl"; rn = x86Reg32(reg); }
    ctx->emit("    ");
    ctx->emit(mn);
    ctx->emit(" %");
    ctx->emit(rn);
    ctx->emit(", (%");
    ctx->emit(baseReg);
    ctx->emitLine(")");
}

// ── vector support ──────────────────────────────────────────────────
// Vector values occupy a byte region inside their stack slot (the slot
// pass reserves irTypeSizeOf bytes for Vector/Array-typed results), so
// every lane is addressed as slotOff + lane*elemSize. This is the
// "simplified" lowering: per-lane scalar ops, no packed instructions.

IrType* vecValueTy(IrInst* inst)
{
    if (inst->base.type != null && inst->base.type->kind == IrTypeKind::Vector)
        return inst->base.type;
    if (inst->nops > 0 && inst->ops[0] != null && inst->ops[0]->type != null &&
        inst->ops[0]->type->kind == IrTypeKind::Vector)
        return inst->ops[0]->type;
    return null;
}

u32 vecLaneBytes(IrContext* ictx, IrType* vt)
{
    if (vt == null || vt->elem == null) return 8;
    u32 s = ictx->irTypeSizeOf(vt->elem);
    return s != 0 ? s : 1;
}

void vecBadOp(FastX86Context* ctx, IrInst* inst)
{
    ctx->emit("    # unsupported vector operand shape for ");
    ctx->emitLine(inst->opcode == IrOpcode::VecAdd ? "vadd" : "vec op");
    ctx->emitLine("    ud2");
}

// can `v` be lane-addressed? slot-backed values and globals yes;
// constants have no memory image — reject.
bool vecLaneOk(IrValue* v)
{
    if (v == null) return false;
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::StringConst) return true;
    if (v->kind == IrValueKind::ConstInt || v->kind == IrValueKind::ConstFloat ||
        v->kind == IrValueKind::ConstArray || v->kind == IrValueKind::StructConst)
        return false;
    return true;
}

// load lane `lane` of vector `v` into `reg`; width = element width in
// bits. Globals use name+disp(%rip), slots use disp(%rbp).
void emitVecLaneLoad(FastX86Context* ctx, IrValue* v, i32 laneOff, u32 width, str reg, bool signExt)
{
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::StringConst)
    {
        str mn = "movq";
        str rn = reg;
        if (width <= 8) { mn = signExt ? "movsbl" : "movzbl"; rn = x86Reg32(reg); }
        else if (width <= 16) { mn = signExt ? "movswl" : "movzwl"; rn = x86Reg32(reg); }
        else if (width <= 32)
        {
            if (signExt) mn = "movslq";
            else { mn = "movl"; rn = x86Reg32(reg); }
        }
        ctx->emit("    ");
        ctx->emit(mn);
        ctx->emit(" ");
        ctx->emit(v->name);
        ctx->emit("+");
        ctx->emitI64((i64)laneOff);
        ctx->emit("(%rip), %");
        ctx->emitLine(rn);
        return;
    }
    emitSlotLoad(ctx, ctx->getSlot(v) + laneOff, width, reg, signExt);
}

void emitVecLaneStore(FastX86Context* ctx, IrValue* v, i32 laneOff, u32 width, str reg)
{
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::StringConst)
    {
        str mn = "movq";
        str rn = reg;
        if (width <= 8) { mn = "movb"; rn = x86Reg8(reg); }
        else if (width <= 16) { mn = "movw"; rn = x86Reg16(reg); }
        else if (width <= 32) { mn = "movl"; rn = x86Reg32(reg); }
        ctx->emit("    ");
        ctx->emit(mn);
        ctx->emit(" %");
        ctx->emit(rn);
        ctx->emit(", ");
        ctx->emit(v->name);
        ctx->emit("+");
        ctx->emitI64((i64)laneOff);
        ctx->emitLine("(%rip)");
        return;
    }
    emitSlotStore(ctx, ctx->getSlot(v) + laneOff, width, reg);
}

// vector load/store: the scalarized model keeps lanes inside the
// result/value stack slot, so a vector memory access is a per-lane
// copy between (%ptr + lane*elemSize) and slot + lane*elemSize.
void emitVecLoad(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = inst->base.type;
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    emitValueToReg(ctx, inst->ops[0], "rax");
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        if (laneOff == 0) ctx->emitLine("    movq %rax, %rdx");
        else
        {
            ctx->emit("    leaq ");
            ctx->emitI64((i64)laneOff);
            ctx->emitLine("(%rax), %rdx");
        }
        emitIndLoad(ctx, "rdx", ew, "rcx", false);
        emitSlotStore(ctx, ctx->getSlot(&inst->base) + laneOff, ew, "rcx");
        laneOff += (i32)lb;
    }
}

void emitVecStore(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = inst->ops[0]->type;
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    emitValueToReg(ctx, inst->ops[1], "rcx");
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitSlotLoad(ctx, ctx->getSlot(inst->ops[0]) + laneOff, ew, "rax", false);
        if (laneOff == 0) ctx->emitLine("    movq %rcx, %rdx");
        else
        {
            ctx->emit("    leaq ");
            ctx->emitI64((i64)laneOff);
            ctx->emitLine("(%rcx), %rdx");
        }
        emitIndStore(ctx, "rdx", ew, "rax");
        laneOff += (i32)lb;
    }
}

// integer binary vector op: vadd/vsub/vmul lane-wise. signExt=false —
// add/sub/mul low bits are extension-agnostic.
void emitVecIntBin(FastX86Context* ctx, IrContext* ictx, IrInst* inst, str alu)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneLoad(ctx, inst->ops[0], laneOff, ew, "rax", false);
        emitVecLaneLoad(ctx, inst->ops[1], laneOff, ew, "rcx", false);
        ctx->emit("    ");
        ctx->emit(alu);
        if (alu.equals("imul")) ctx->emit("q %rcx, %rax");
        else { ctx->emit("q %rcx, %rax"); }
        ctx->emitLine("");
        emitVecLaneStore(ctx, &inst->base, laneOff, ew, "rax");
        laneOff += (i32)lb;
    }
}

// signed lane-wise divide — no packed int divide exists; widen each
// lane to 64 bits, idiv, truncate back. INT_MIN/-1 wraps instead of
// trapping (documented simplification vs. per-width idiv).
void emitVecIntDiv(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneLoad(ctx, inst->ops[0], laneOff, ew, "rax", true);
        emitVecLaneLoad(ctx, inst->ops[1], laneOff, ew, "rcx", true);
        ctx->emitLine("    cqto");
        ctx->emitLine("    idivq %rcx");
        emitVecLaneStore(ctx, &inst->base, laneOff, ew, "rax");
        laneOff += (i32)lb;
    }
}

// unsigned integer min/max lane-wise (the VecMin/VecMax contract for
// integer lanes is unsigned — see wallvm wasm backend comment).
void emitVecIntMinMax(FastX86Context* ctx, IrContext* ictx, IrInst* inst, bool isMin)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneLoad(ctx, inst->ops[0], laneOff, ew, "rax", false);
        emitVecLaneLoad(ctx, inst->ops[1], laneOff, ew, "rcx", false);
        ctx->emitLine("    cmpq %rcx, %rax");
        ctx->emit(isMin ? "    cmova " : "    cmovb ");
        ctx->emitLine("%rcx, %rax");
        emitVecLaneStore(ctx, &inst->base, laneOff, ew, "rax");
        laneOff += (i32)lb;
    }
}

void emitVecLaneLoadF(FastX86Context* ctx, IrValue* v, i32 laneOff, u32 width)
{
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::StringConst)
    {
        ctx->emit("    ");
        ctx->emit(width <= 32 ? "movd " : "movq ");
        ctx->emit(v->name);
        ctx->emit("+");
        ctx->emitI64((i64)laneOff);
        ctx->emitLine("(%rip), %xmm0");
        return;
    }
    i32 disp = ctx->getSlot(v) + laneOff;
    ctx->emit(width <= 32 ? "    movd " : "    movq ");
    ctx->emitI64((i64)disp);
    ctx->emitLine("(%rbp), %xmm0");
}

void emitVecLaneStoreF(FastX86Context* ctx, IrValue* v, i32 laneOff, u32 width)
{
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::StringConst)
    {
        ctx->emit("    ");
        ctx->emit(width <= 32 ? "movd %xmm0, " : "movq %xmm0, ");
        ctx->emit(v->name);
        ctx->emit("+");
        ctx->emitI64((i64)laneOff);
        ctx->emitLine("(%rip)");
        return;
    }
    i32 disp = ctx->getSlot(v) + laneOff;
    ctx->emit(width <= 32 ? "    movd %xmm0, " : "    movq %xmm0, ");
    ctx->emitI64((i64)disp);
    ctx->emitLine("(%rbp)");
}

// float binary vector op lane-wise through xmm0
void emitVecFloatBin(FastX86Context* ctx, IrContext* ictx, IrInst* inst, str sop32, str sop64)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    bool isF32v = ew <= 32;
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneLoadF(ctx, inst->ops[0], laneOff, ew);
        /* second operand through xmm1 */
        IrValue* b = inst->ops[1];
        if (b->kind == IrValueKind::Global || b->kind == IrValueKind::StringConst)
        {
            ctx->emit("    ");
            ctx->emit(isF32v ? "movd " : "movq ");
            ctx->emit(b->name);
            ctx->emit("+");
            ctx->emitI64((i64)laneOff);
            ctx->emitLine("(%rip), %xmm1");
        }
        else
        {
            i32 d2 = ctx->getSlot(b) + laneOff;
            ctx->emit(isF32v ? "    movd " : "    movq ");
            ctx->emitI64((i64)d2);
            ctx->emitLine("(%rbp), %xmm1");
        }
        ctx->emit("    ");
        ctx->emit(isF32v ? sop32 : sop64);
        ctx->emitLine(" %xmm1, %xmm0");
        emitVecLaneStoreF(ctx, &inst->base, laneOff, ew);
        laneOff += (i32)lb;
    }
}

void emitVecFloatMinMax(FastX86Context* ctx, IrContext* ictx, IrInst* inst, bool isMin)
{
    /* x86 minss/minsd return the SECOND source on NaN — operands are
     * loaded a→xmm0, b→xmm1 so min(a,b) matches the scalar contract
     * closely enough for the simplified backend. */
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    bool isF32v = ew <= 32;
    str sop = isF32v ? (isMin ? "minss" : "maxss") : (isMin ? "minsd" : "maxsd");
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneLoadF(ctx, inst->ops[0], laneOff, ew);
        IrValue* b = inst->ops[1];
        if (b->kind == IrValueKind::Global || b->kind == IrValueKind::StringConst)
        {
            ctx->emit("    ");
            ctx->emit(isF32v ? "movd " : "movq ");
            ctx->emit(b->name);
            ctx->emit("+");
            ctx->emitI64((i64)laneOff);
            ctx->emitLine("(%rip), %xmm1");
        }
        else
        {
            i32 d2 = ctx->getSlot(b) + laneOff;
            ctx->emit(isF32v ? "    movd " : "    movq ");
            ctx->emitI64((i64)d2);
            ctx->emitLine("(%rbp), %xmm1");
        }
        ctx->emit("    ");
        ctx->emit(sop);
        ctx->emitLine(" %xmm1, %xmm0");
        emitVecLaneStoreF(ctx, &inst->base, laneOff, ew);
        laneOff += (i32)lb;
    }
}

// broadcast scalar ops[0] into every lane of the result vector
void emitVecBroadcast(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 1 || inst->ops[0] == null)
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    emitValueToReg(ctx, inst->ops[0], "rax");
    i32 laneOff = 0;
    for (u32 lane = 0; lane < vt->count; lane++)
    {
        emitVecLaneStore(ctx, &inst->base, laneOff, ew, "rax");
        laneOff += (i32)lb;
    }
}

void emitVecExtract(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 2 || inst->ops[0] == null || !vecLaneOk(inst->ops[0]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    IrValue* idx = inst->ops[1];
    if (idx != null && idx->kind == IrValueKind::ConstInt)
    {
        i32 laneOff = (i32)(idx->valData & 0xFFFFFFFF) * (i32)lb;
        emitVecLaneLoad(ctx, inst->ops[0], laneOff, ew, "rax", false);
        emitRegToSlot(ctx, &inst->base, "rax");
        return;
    }
    /* dynamic index: addr = rbp + slotOff + idx*elemSize — compute via
     * lea with index register, then a plain memory load */
    if (idx == null) { vecBadOp(ctx, inst); return; }
    emitValueToReg(ctx, idx, "rcx");
    if (lb != 1)
    {
        ctx->emit("    imulq $");
        ctx->emitI64((i64)lb);
        ctx->emitLine(", %rcx, %rcx");
    }
    i32 base = ctx->getSlot(inst->ops[0]);
    ctx->emit("    leaq ");
    ctx->emitI64((i64)base);
    ctx->emit("(%rbp,%rcx,1), %rax");
    ctx->emitLine("");
    /* load through %rax — width-aware, unsigned (consistent with Load) */
    if (ew <= 8) ctx->emitLine("    movzbl (%rax), %ecx");
    else if (ew <= 16) ctx->emitLine("    movzwl (%rax), %ecx");
    else if (ew <= 32) ctx->emitLine("    movl (%rax), %ecx");
    else ctx->emitLine("    movq (%rax), %rcx");
    emitRegToSlot(ctx, &inst->base, "rcx");
}

// copy `size` bytes of vector region src→dst, qword chunks (regions are
// 8-byte aligned and sized, padding bytes copy harmlessly)
void emitVecCopy(FastX86Context* ctx, IrValue* src, IrValue* dst, u32 size)
{
    u32 nq = (size + 7) / 8;
    i32 sOff = ctx->getSlot(src);
    i32 dOff = ctx->getSlot(dst);
    for (u32 q = 0; q < nq; q++)
    {
        i32 o = (i32)(q * 8);
        emitSlotLoad(ctx, sOff + o, 64, "rax", false);
        emitSlotStore(ctx, dOff + o, 64, "rax");
    }
}

void emitVecInsert(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 3 || inst->ops[0] == null || inst->ops[1] == null ||
        !vecLaneOk(inst->ops[0]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    u32 vsize = (u32)ictx->irTypeSizeOf(vt);
    /* result = copy of input vector, then lane overwrite */
    emitVecCopy(ctx, inst->ops[0], &inst->base, vsize);
    IrValue* idx = inst->ops[2];
    emitValueToReg(ctx, inst->ops[1], "rdx");
    if (idx != null && idx->kind == IrValueKind::ConstInt)
    {
        i32 laneOff = (i32)(idx->valData & 0xFFFFFFFF) * (i32)lb;
        /* store from rdx, not rax — reuse lane store with reg swap */
        emitSlotStore(ctx, ctx->getSlot(&inst->base) + laneOff, ew, "rdx");
        return;
    }
    if (idx == null) { vecBadOp(ctx, inst); return; }
    emitValueToReg(ctx, idx, "rcx");
    if (lb != 1)
    {
        ctx->emit("    imulq $");
        ctx->emitI64((i64)lb);
        ctx->emitLine(", %rcx, %rcx");
    }
    i32 base = ctx->getSlot(&inst->base);
    ctx->emit("    leaq ");
    ctx->emitI64((i64)base);
    ctx->emit("(%rbp,%rcx,1), %rax");
    ctx->emitLine("");
    emitIndStore(ctx, "rax", ew, "rdx");
}

void emitVecShuffle(FastX86Context* ctx, IrContext* ictx, IrInst* inst)
{
    IrType* vt = vecValueTy(inst);
    if (vt == null || inst->nops < 3 || !vecLaneOk(inst->ops[0]) || !vecLaneOk(inst->ops[1]))
    { vecBadOp(ctx, inst); return; }
    IrType* et = vt->elem;
    u32 ew = et != null ? et->width : 64;
    u32 lb = vecLaneBytes(ictx, vt);
    u32 n1 = inst->ops[0]->type != null ? inst->ops[0]->type->count : vt->count;
    u32 nmask = inst->nops - 2;
    for (u32 j = 0; j < nmask; j++)
    {
        IrValue* m = inst->ops[2 + j];
        if (m == null || m->kind != IrValueKind::ConstInt)
        { vecBadOp(ctx, inst); return; }
        u64 mi = m->valData;
        IrValue* src = inst->ops[0];
        u64 lane = mi;
        if (mi >= (u64)n1)
        {
            src = inst->ops[1];
            lane = mi - (u64)n1;
        }
        emitVecLaneLoad(ctx, src, (i32)((u64)lane * (u64)lb), ew, "rax", false);
        emitVecLaneStore(ctx, &inst->base, (i32)((u64)j * (u64)lb), ew, "rax");
    }
}

// ── inline asm ──────────────────────────────────────────────────────
// gcc-style extended asm lowered into the template text with %0..%9
// operand substitution. Constraint classes: m → memory operand, r/f/reg
// letter → register, i → immediate, digit → tied to another operand.
// Pointer-typed operands with output/inout constraints are AddrOf
// lvalues: the value register is written back through the pointer after
// the template (the pointer itself is pinned in a callee-saved reg so a
// clobbering template cannot lose it).

struct AsmSubText
{
    u8[80] buf;
    u32 len;
}

void asmSubFill(AsmSubText* s, str text)
{
    usize n = text.len;
    if (n > 79) n = 79;
    for (usize i = 0; i < n; i++) s->buf[i] = text.ptr[i];
    s->len = (u32)n;
}

void asmSubReg(AsmSubText* s, str reg)
{
    s->buf[0] = '%';
    usize n = reg.len;
    if (n > 77) n = 77;
    for (usize i = 0; i < n; i++) s->buf[i + 1] = reg.ptr[i];
    s->len = (u32)(n + 1);
}

void asmSubI64(AsmSubText* s, i64 v)
{
    /* AT&T immediates need a '$' — bare digits parse as an absolute
     * memory address, not an immediate */
    cchar[24] nb;
    i32 n = snprintf(nb, 24, C"$%lld", v);
    if (n < 0) n = 0;
    if (n > 79) n = 79;
    for (i32 i = 0; i < n; i++) s->buf[i] = (u8)nb[i];
    s->len = (u32)n;
}

void asmSubMemOff(AsmSubText* s, i32 off)
{
    cchar[40] nb;
    i32 n = snprintf(nb, 40, C"%d(%%rbp)", off);
    if (n < 0) n = 0;
    if (n > 79) n = 79;
    for (i32 i = 0; i < n; i++) s->buf[i] = (u8)nb[i];
    s->len = (u32)n;
}

void asmSubMemReg(AsmSubText* s, str reg)
{
    /* "(%reg)" — a memory operand through a pointer register */
    s->buf[0] = (u8)'(';
    s->buf[1] = (u8)'%';
    usize n = reg.len;
    if (n > 75) n = 75;
    for (usize i = 0; i < n; i++) s->buf[i + 2] = reg.ptr[i];
    s->buf[n + 2] = (u8)')';
    s->len = (u32)(n + 3);
}

bool asmRegTaken(str* taken, u32 ntaken, str r)
{
    for (u32 i = 0; i < ntaken; i++)
        if (taken[i].equals(r)) return true;
    return false;
}

void asmRegTake(str* taken, u32* ntaken, str r)
{
    if (*ntaken < 32 && !asmRegTaken(taken, *ntaken, r))
    {
        taken[*ntaken] = r;
        (*ntaken)++;
    }
}

str asmPickInt(str* taken, u32* ntaken, bool win64)
{
    /* caller-saved scratch; r11 reserved for xmm staging, rsi/rdi are
     * callee-saved under Win64 so they leave the pool there */
    if (!win64)
    {
        str[8] c = { "rax", "rcx", "rdx", "rsi", "rdi", "r8", "r9", "r10" };
        for (u32 i = 0; i < 8; i++)
        {
            if (!asmRegTaken(taken, *ntaken, c[i]))
            {
                asmRegTake(taken, ntaken, c[i]);
                return c[i];
            }
        }
    }
    else
    {
        str[6] c = { "rax", "rcx", "rdx", "r8", "r9", "r10" };
        for (u32 i = 0; i < 6; i++)
        {
            if (!asmRegTaken(taken, *ntaken, c[i]))
            {
                asmRegTake(taken, ntaken, c[i]);
                return c[i];
            }
        }
    }
    return str::empty();
}

str asmPickXmm(str* taken, u32* ntaken)
{
    str[8] c = { "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7" };
    for (u32 i = 0; i < 8; i++)
    {
        if (!asmRegTaken(taken, *ntaken, c[i]))
        {
            asmRegTake(taken, ntaken, c[i]);
            return c[i];
        }
    }
    return str::empty();
}

str asmFixedReg(str letter, bool win64)
{
    if (letter.equals("a")) return "rax";
    if (letter.equals("b")) return "rbx";
    if (letter.equals("c")) return "rcx";
    if (letter.equals("d")) return "rdx";
    if (letter.equals("S")) return "rsi";
    if (letter.equals("D")) return "rdi";
    return str::empty();
}

bool asmRegIsCalleeSaved(str r, bool win64)
{
    if (r.equals("rbx") || r.equals("r12") || r.equals("r13") ||
        r.equals("r14") || r.equals("r15") || r.equals("rbp"))
        return true;
    if (win64 && (r.equals("rsi") || r.equals("rdi"))) return true;
    return false;
}

// value → xmm register (for 'f' constraints)
void emitValueToXmm(FastX86Context* ctx, IrValue* v, str xmm, bool isF32)
{
    if (v == null)
    {
        ctx->emit("    pxor ");
        ctx->emit(xmm);
        ctx->emit(", ");
        ctx->emitLine(xmm);
        return;
    }
    if (v->kind == IrValueKind::ConstFloat)
    {
        ctx->emit("    movabsq $");
        ctx->emitU64(v->valData);
        ctx->emitLine(", %r11");
        ctx->emit(isF32 ? "    movd %r11d, %" : "    movq %r11, %");
        ctx->emitLine(xmm);
        return;
    }
    if (v->kind == IrValueKind::Global || v->kind == IrValueKind::Func ||
        v->kind == IrValueKind::StringConst)
    {
        ctx->emit("    leaq ");
        ctx->emit(v->name);
        ctx->emitLine("(%rip), %r11");
        ctx->emit(isF32 ? "    movd %r11d, %" : "    movq %r11, %");
        ctx->emitLine(xmm);
        return;
    }
    i32 off = ctx->getSlot(v);
    ctx->emit(isF32 ? "    movd " : "    movq ");
    ctx->emitI64((i64)off);
    ctx->emit(isF32 ? "(%rbp), %" : "(%rbp), %");
    ctx->emitLine(xmm);
}

void emitXmmToSlot(FastX86Context* ctx, IrValue* v, str xmm, bool isF32)
{
    /* route through rax so the full slot qword stays clean */
    ctx->emit(isF32 ? "    movd %" : "    movq %");
    ctx->emit(xmm);
    ctx->emitLine(isF32 ? ", %eax" : ", %rax");
    emitRegToSlot(ctx, v, "rax");
}

// per-operand state for inline asm
struct AsmOp
{
    u8 mode;        // 0 unset, 1 reg-in, 2 reg-out, 3 reg-inout, 4 mem, 5 imm
    bool isXmm;
    str reg;        // assigned register name ("" for mem/imm)
    AsmSubText sub; // substitution text for %N
    // writeback record
    u8 wbKind;      // 0 none, 1 store reg→slot, 2 store reg→(ptrreg), 9 tied-input load
    IrValue* wbVal; // slot-store target value / tied input value
    str wbReg;      // value register for write-back
    str wbPtr;      // pointer register for ptr-store
    u32 wbWidth;    // pointee width in bits (ptr-store)
    bool wbXmm;
}

void emitInlineAsm(FastX86Context* ctx, IrInst* inst, bool win64)
{
    u32 nops = inst->nops;
    if (nops > 24)
    {
        ctx->emitLine("    # inline asm: too many operands");
        ctx->emitLine("    ud2");
        return;
    }

    AsmConstraint[24] cc;
    AsmParseError perr = AsmParseError { .msg = str::empty(), .lineNo = 0 };
    u32 nc = parseConstraints(inst->asmConstraints, cc, 24, &perr);
    if (nc == 0xFFFF || nc != nops)
    {
        ctx->emit("    # inline asm: ");
        if (nc == 0xFFFF && !perr.msg.isEmpty()) ctx->emit(perr.msg);
        else ctx->emit("constraint/operand count mismatch");
        ctx->emitLine("");
        ctx->emitLine("    ud2");
        return;
    }

    // clobber check: regs the template may freely trash are the ones we
    // never keep live across it; callee-saved regs we cannot save for
    // the user, so reject them loudly
    {
        str cb = inst->asmClobbers;
        usize ci = 0;
        bool bad = false;
        str badName = str::empty();
        while (ci < cb.len && !bad)
        {
            usize st = ci;
            while (ci < cb.len && cb.ptr[ci] != (u8)',') ci++;
            usize en = ci;
            usize a = st;
            while (a < en && (cb.ptr[a] == (u8)' ' || cb.ptr[a] == (u8)'\t')) a++;
            while (en > a && (cb.ptr[en - 1] == (u8)' ' || cb.ptr[en - 1] == (u8)'\t')) en--;
            if (en > a)
            {
                str nm = str::fromParts((const u8*)(cb.ptr + a), en - a);
                if (!nm.equals("memory") && !nm.equals("cc") &&
                    asmRegIsCalleeSaved(nm, win64))
                {
                    bad = true;
                    badName = nm;
                }
            }
            if (ci < cb.len) ci++;
        }
        if (bad)
        {
            ctx->emit("    # inline asm: clobber of callee-saved register ");
            ctx->emitLine(badName);
            ctx->emitLine("    ud2");
            return;
        }
    }

    // ---- pass 1: assign registers and substitution texts ------------
    AsmOp[24] ops2;
    str[32] taken;
    for (u32 ti = 0; ti < 32; ti++) taken[ti] = str::empty();
    u32 ntaken = 0;
    str[5] pinPool = { "rbx", "r12", "r13", "r14", "r15" };
    str[8] pins;
    for (u32 pi = 0; pi < 8; pi++) pins[pi] = str::empty();
    u32 npins = 0;
    str resReg = str::empty();
    bool resXmm = false;
    bool failed = false;

    for (u32 k = 0; k < nops && !failed; k++)
    {
        AsmOp* o = &ops2[k];
        o->mode = 0;
        o->isXmm = false;
        o->reg = str::empty();
        o->wbKind = 0;
        o->wbVal = null;
        o->wbPtr = str::empty();
        o->wbWidth = 64;
        o->wbXmm = false;
        o->sub.len = 0;

        AsmConstraint c = cc[k];
        if (c.cls == AsmConClass::ConTied) continue; // pass 2

        IrValue* v = inst->ops[k];
        bool isPtr = v != null && v->type != null && v->type->kind == IrTypeKind::Ptr;
        bool dirOut = c.isOut && !c.isInOut;
        bool dirInOut = c.isInOut;
        bool isOutAny = c.isOut || c.isInOut;

        if (c.cls == AsmConClass::ConMem)
        {
            if (isPtr)
            {
                str preg = asmPickInt(taken, &ntaken, win64);
                if (preg.len == 0) { failed = true; break; }
                o->mode = 4;
                o->reg = preg;
                asmSubMemReg(&o->sub, preg);
                /* pointer load emitted in pass 2 via reg */
            }
            else if (v != null)
            {
                o->mode = 4;
                asmSubMemOff(&o->sub, ctx->getSlot(v));
            }
            else { failed = true; break; }
            continue;
        }

        if (c.cls == AsmConClass::ConImm)
        {
            if (v != null && v->kind == IrValueKind::ConstInt)
            {
                o->mode = 5;
                asmSubI64(&o->sub, (i64)v->valData);
            }
            else if (v != null)
            {
                /* non-constant "immediate": fall back to a register —
                 * the template still gets a usable operand */
                str r = asmPickInt(taken, &ntaken, win64);
                if (r.len == 0) { failed = true; break; }
                o->mode = 1;
                o->reg = r;
                asmSubReg(&o->sub, r);
            }
            else { o->mode = 5; asmSubI64(&o->sub, 0); }
            continue;
        }

        if (c.cls != AsmConClass::ConGeneral && c.cls != AsmConClass::ConRegName &&
            c.cls != AsmConClass::ConFloat)
        {
            failed = true;
            break;
        }

        bool isXmm = c.cls == AsmConClass::ConFloat;
        str r = str::empty();
        if (c.cls == AsmConClass::ConRegName && c.regName.len > 0)
        {
            if (c.regName.equals("q"))
            {
                r = isXmm ? asmPickXmm(taken, &ntaken) : asmPickInt(taken, &ntaken, win64);
            }
            else
            {
                r = asmFixedReg(c.regName, win64);
                if (r.len == 0)
                    r = isXmm ? asmPickXmm(taken, &ntaken) : asmPickInt(taken, &ntaken, win64);
            }
        }
        else
        {
            r = isXmm ? asmPickXmm(taken, &ntaken) : asmPickInt(taken, &ntaken, win64);
        }
        if (r.len == 0) { failed = true; break; }
        asmRegTake(taken, &ntaken, r);

        o->isXmm = isXmm;
        o->reg = r;
        asmSubReg(&o->sub, r);

        if (v == null)
        {
            if (!isOutAny) { failed = true; break; }
            o->mode = 2;
        }
        else if (isPtr && isOutAny)
        {
            /* pointer-model operand: pin the address in a callee-saved
             * register, the asm result lands in `r` and is written back
             * through the pointer afterwards */
            str cs = str::empty();
            for (u32 pi = 0; pi < 5; pi++)
            {
                if (!asmRegTaken(taken, ntaken, pinPool[pi])) { cs = pinPool[pi]; break; }
            }
            if (cs.len == 0 || npins >= 8) { failed = true; break; }
            asmRegTake(taken, &ntaken, cs);
            pins[npins] = cs;
            npins++;
            o->mode = dirInOut ? 3 : 2;
            o->wbKind = 2;
            o->wbPtr = cs;
            o->wbReg = r;
            o->wbXmm = isXmm;
            u32 pw = 64;
            if (v->type->elem != null && v->type->elem->width > 0)
                pw = v->type->elem->width;
            o->wbWidth = pw;
            if (dirInOut)
            {
                /* inout through a pointer: preload the pointee */
                /* handled in pass 2 — needs the pinned pointer */
            }
        }
        else
        {
            if (dirInOut)
            {
                o->mode = 3;
                o->wbKind = 1;
                o->wbVal = v;
                o->wbReg = r;
                o->wbXmm = isXmm;
                o->wbWidth = 0;
            }
            else if (dirOut)
            {
                o->mode = 2;
            }
            else
            {
                o->mode = 1;
            }
        }

        /* result candidate: register output that is not a pointer
         * write-back (those produce memory, not the inst value) */
        if (isOutAny && !isPtr && o->mode != 0)
        {
            if (resReg.len == 0) { resReg = r; resXmm = isXmm; }
        }
    }

    // ---- pass 2: tied operands borrow their target's location --------
    for (u32 k = 0; k < nops && !failed; k++)
    {
        AsmConstraint c = cc[k];
        if (c.cls != AsmConClass::ConTied) continue;
        u32 t = c.tieIdx;
        u32 guard = 0;
        while (t < nops && cc[t].cls == AsmConClass::ConTied && guard < 24)
        {
            t = cc[t].tieIdx;
            guard++;
        }
        if (t >= nops || guard >= 24) { failed = true; break; }
        AsmOp* o = &ops2[k];
        AsmOp* tgt = &ops2[t];
        IrValue* v = inst->ops[k];
        if (v != null && tgt->mode >= 1 && tgt->mode <= 3)
        {
            /* tied input into a register target: share the location and
             * load this operand's value into it (marker 9 → pass 3) */
            o->mode = tgt->mode;
            o->isXmm = tgt->isXmm;
            o->reg = tgt->reg;
            o->wbKind = 9;
            o->wbVal = v;
        }
        else
        {
            /* memory/immediate target: the location is already set up,
             * the tied operand contributes no code of its own */
            o->mode = 0;
        }
        asmSubFill(&o->sub, str::fromParts((const u8*)&tgt->sub.buf[0], (usize)tgt->sub.len));
    }

    if (failed)
    {
        ctx->emitLine("    # inline asm: operand setup failed");
        ctx->emitLine("    ud2");
        return;
    }

    // ---- pass 3: emit loads ------------------------------------------
    // tied inputs load LAST so they cannot be overwritten by their
    // target operand's own setup
    for (u32 k = 0; k < nops; k++)
    {
        AsmOp* o = &ops2[k];
        if (o->wbKind != 9) continue;
        IrValue* v = o->wbVal;
        if (o->isXmm) emitValueToXmm(ctx, v, o->reg, v->type != null && v->type->width <= 32);
        else emitValueToReg(ctx, v, o->reg);
    }
    for (u32 k = 0; k < nops; k++)
    {
        AsmOp* o = &ops2[k];
        IrValue* v = inst->ops[k];
        AsmConstraint c = cc[k];

        if (o->wbKind == 9) continue; // already loaded above
        if (o->mode == 4 && o->reg.len > 0)
        {
            /* memory operand through a register */
            emitValueToReg(ctx, v, o->reg);
        }
        else if (o->wbKind == 2)
        {
            /* pinned pointer for write-back */
            ctx->emit("    pushq %");
            ctx->emitLine(o->wbPtr);
            emitValueToReg(ctx, v, o->wbPtr);
            if (c.isInOut)
            {
                /* preload pointee into the value register */
                u32 pw = o->wbWidth;
                if (o->wbXmm)
                {
                    emitIndLoad(ctx, o->wbPtr, pw, "rax", false);
                    ctx->emit(pw <= 32 ? "    movd %eax, %" : "    movq %rax, %");
                    ctx->emitLine(o->reg);
                }
                else
                {
                    emitIndLoad(ctx, o->wbPtr, pw, o->reg, false);
                }
            }
        }
        else if (o->mode == 1 || o->mode == 3)
        {
            if (o->isXmm) emitValueToXmm(ctx, v, o->reg, v->type != null && v->type->width <= 32);
            else emitValueToReg(ctx, v, o->reg);
        }
    }

    // ---- pass 4: template ---------------------------------------------
    {
        str ts = inst->asmString;
        ctx->emit("    ");
        usize i = 0;
        while (i < ts.len)
        {
            u8 ch = ts.ptr[i];
            if (ch == (u8)'%' && i + 1 < ts.len)
            {
                u8 nx = ts.ptr[i + 1];
                if (nx == (u8)'%')
                {
                    ctx->out.pushChar((u8)'%');
                    i += 2;
                    continue;
                }
                if (nx >= (u8)'0' && nx <= (u8)'9')
                {
                    u32 d = (u32)(nx - (u8)'0');
                    if (d < 24 && ops2[d].sub.len > 0)
                        ctx->out.appendView(str::fromParts((const u8*)&ops2[d].sub.buf[0], (usize)ops2[d].sub.len));
                    i += 2;
                    continue;
                }
                ctx->out.pushChar((u8)'%');
                i++;
                continue;
            }
            if (ch == (u8)'\n')
            {
                ctx->out.pushChar((u8)'\n');
                ctx->emit("    ");
                i++;
                continue;
            }
            ctx->out.pushChar(ch);
            i++;
        }
        ctx->out.pushChar((u8)'\n');
    }

    // ---- pass 5: write-backs, result, pin restores --------------------
    for (u32 k = 0; k < nops; k++)
    {
        AsmOp* o = &ops2[k];
        if (o->wbKind == 1 && o->wbVal != null)
        {
            if (o->wbXmm) emitXmmToSlot(ctx, o->wbVal, o->reg, true);
            else emitRegToSlot(ctx, o->wbVal, o->reg);
        }
        else if (o->wbKind == 2)
        {
            if (o->wbXmm)
            {
                ctx->emit(o->wbWidth <= 32 ? "    movd %" : "    movq %");
                ctx->emit(o->reg);
                ctx->emit(o->wbWidth <= 32 ? ", (%" : ", (%");
                ctx->emit(o->wbPtr);
                ctx->emitLine(")");
            }
            else
            {
                emitIndStore(ctx, o->wbPtr, o->wbWidth, o->reg);
            }
        }
    }
    if (inst->base.type != null && inst->base.type->kind != IrTypeKind::Void)
    {
        if (resReg.len > 0)
        {
            bool rf32 = inst->base.type != null && inst->base.type->width <= 32;
            if (resXmm) emitXmmToSlot(ctx, &inst->base, resReg, rf32);
            else emitRegToSlot(ctx, &inst->base, resReg);
        }
        else
        {
            emitRegToSlot(ctx, &inst->base, "rax");
        }
    }
    for (u32 pi = npins; pi > 0; pi--)
    {
        ctx->emit("    popq %");
        ctx->emitLine(pins[pi - 1]);
    }
}

// byte size of a value's type (0 when unknown) — used to pick the
// scalar (≤8B, one qword) vs. wide aggregate (rax:rdx pair, ≤16B)
// return/call convention
u64 valByteSize(IrContext* ictx, IrValue* v)
{
    if (v == null || v->type == null) return 8;
    u64 s = (u64)ictx->irTypeSizeOf(v->type);
    return s != 0 ? s : 8;
}

void emitWideRetOrStore(FastX86Context* ctx, IrValue* v, IrValue* dstSlot)
{
    /* 9..16 byte aggregate: low qword in rax, high in rdx (SysV
     * rax:rdx pair convention, mirrored on the store side) */
    emitVecLaneLoad(ctx, v, 0, 64, "rax", false);
    emitVecLaneLoad(ctx, v, 8, 64, "rdx", false);
    if (dstSlot != null)
    {
        i32 dOff = ctx->getSlot(dstSlot);
        emitSlotStore(ctx, dOff, 64, "rax");
        emitSlotStore(ctx, dOff + 8, 64, "rdx");
    }
}

// Emits textual assembly for a single function
pub str emitFastX86Func(IrFunc* func, IrContext* ictx, bool isWindows)
{
    if (func == null || func->isExtern) return "";

    bool win64 = funcUsesWin64(func, isWindows);
    FastX86Context ctx = FastX86Context::new(win64);
    ctx.funcName = func->base.name;

    bool isHot = funcIsHot(func);
    bool isCold = funcIsCold(func);
    bool isOptNone = funcIsOptNone(func);
    bool isLeaf = funcIsLeaf(func);
    bool isNoRet = funcIsNoReturn(func);

    // 1. Assign stack slots to args and value-producing instructions
    i32 curOffset = 0;
    for (u32 ai = 0; ai < func->nargs; ai++)
    {
        curOffset -= 8;
        ctx.addSlot(func->args[ai], curOffset);
    }

    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        if (bb == null) continue;
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (inst == null) continue;
            if (inst->opcode == IrOpcode::Alloca)
            {
                /* two regions: `sz` bytes for the POINTEE plus 8 for the
                 * pointer value itself. The object sits immediately above
                 * the pointer slot (slotOff+8); sharing one region made
                 * field-0 stores overwrite the pointer and crash. */
                u32 sz = 8;
                if (inst->base.type != null)
                {
                    IrType* pt = inst->base.type->kind == IrTypeKind::Ptr
                        ? inst->base.type->elem : inst->base.type;
                    if (pt != null)
                    {
                        sz = (u32)ictx->irTypeSizeOf(pt);
                        if (sz < 8) sz = 8;
                        sz = (sz + 7) & ~7u;
                    }
                }
                curOffset -= (i32)sz;
                curOffset -= 8;
                ctx.addSlot(&inst->base, curOffset);
            }
            else if (inst->base.type != null && inst->base.type->kind != IrTypeKind::Void)
            {
                /* struct/array results are address-valued like allocas:
                 * an 8-byte header holding &object with the bytes above
                 * it. Vectors keep the inline lane region (they are
                 * never addressed as a whole). */
                IrTypeKind rk = inst->base.type->kind;
                if (rk == IrTypeKind::Struct || rk == IrTypeKind::Array || rk == IrTypeKind::Union)
                {
                    u64 avsz = (u64)ictx->irTypeSizeOf(inst->base.type);
                    if (avsz < 8) avsz = 8;
                    curOffset -= (i32)(((avsz + 7) / 8) * 8);
                    curOffset -= 8;
                    ctx.addSlot(&inst->base, curOffset);
                }
                else
                {
                /* aggregate/vector values occupy a byte region, not a
                 * single qword — vector ops address lanes at
                 * slotOff + lane*elemSize. Scalars keep the 8-byte slot. */
                u64 vsz = (u64)ictx->irTypeSizeOf(inst->base.type);
                if (vsz > 8)
                {
                    curOffset -= (i32)(((vsz + 7) / 8) * 8);
                    ctx.addSlot(&inst->base, curOffset);
                }
                else
                {
                    curOffset -= 8;
                    ctx.addSlot(&inst->base, curOffset);
                }
                }
            }
        }
    }

    // Win64 ABI requires 32 bytes shadow store on stack for outbound calls
    if (win64 && !isLeaf)
    {
        curOffset -= 32;
    }

    // Align stack frame to 16 bytes
    i32 rawFrame = -curOffset;
    ctx.frameSize = (rawFrame + 15) & ~15;

    // 2. Emit rich metadata header
    ctx.emitLine("# ========================================================");
    ctx.emit("# Function: @");
    ctx.emitLine(func->base.name);
    ctx.emit("# ABI: ");
    ctx.emitLine(win64 ? "Win64 (Windows)" : "SystemV (Linux/Unix)");
    ctx.emit("# Attributes: [");
    if (isHot) ctx.emit(" hot");
    if (isCold) ctx.emit(" cold");
    if (isOptNone) ctx.emit(" optnone");
    if (isLeaf) ctx.emit(" leaf");
    if (isNoRet) ctx.emit(" noreturn");
    ctx.emitLine(" ]");
    ctx.emit("# Stack Frame: ");
    ctx.emitI64((i64)ctx.frameSize);
    ctx.emitLine(" bytes");
    for (u32 ai = 0; ai < func->nargs; ai++)
    {
        ctx.emit("#   arg[");
        ctx.emitI64((i64)ai);
        ctx.emit("] -> ");
        ctx.emitI64((i64)ctx.getSlot(func->args[ai]));
        ctx.emitLine("(%rbp)");
    }
    ctx.emitLine("# ========================================================");

    // 3. Section placement based on hot/cold
    if (isHot)
    {
        if (win64)
            ctx.emitLine("    .section .text$hot, \"xr\"");
        else
        {
            ctx.emit("    .section .text.hot.");
            ctx.emit(func->base.name);
            ctx.emitLine(", \"ax\", @progbits");
        }
    }
    else if (isCold)
    {
        if (win64)
            ctx.emitLine("    .section .text$cold, \"xr\"");
        else
        {
            ctx.emit("    .section .text.unlikely.");
            ctx.emit(func->base.name);
            ctx.emitLine(", \"ax\", @progbits");
        }
    }
    else
    {
        ctx.emitLine("    .text");
    }

    // Function symbol directives
    ctx.emit(".globl ");
    ctx.emitLine(func->base.name);
    if (win64)
    {
        ctx.emit(".def ");
        ctx.emit(func->base.name);
        ctx.emitLine("; .scl 2; .type 32; .endef");
    }
    else
    {
        ctx.emit(".type ");
        ctx.emit(func->base.name);
        ctx.emitLine(", @function");
    }

    ctx.emit(func->base.name);
    ctx.emitLine(":");
    ctx.emitLine("    pushq %rbp");
    ctx.emitLine("    movq %rsp, %rbp");
    if (ctx.frameSize > 0)
    {
        ctx.emit("    subq $");
        ctx.emitI64((i64)ctx.frameSize);
        ctx.emitLine(", %rsp");
    }

    // Spill incoming arguments into their assigned slots
    if (win64)
    {
        u32 maxWinArgs = 4;
        for (u32 ai = 0; ai < func->nargs && ai < maxWinArgs; ai++)
        {
            emitRegToSlot(&ctx, func->args[ai], WIN64_ARG_REGS_64[ai]);
        }
    }
    else
    {
        u32 maxSysVArgs = 6;
        for (u32 ai = 0; ai < func->nargs && ai < maxSysVArgs; ai++)
        {
            emitRegToSlot(&ctx, func->args[ai], SYSV_ARG_REGS_64[ai]);
        }
    }

    // 4. Emit basic blocks and instructions
    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        if (bb == null) continue;

        emitBBLabel(&ctx, func, &bb->base);
        ctx.emitLine(":");

        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (inst == null) continue;

            // Optional debug location comment
            if (inst->debugLoc.line > 0)
            {
                ctx.emit("    # loc line=");
                ctx.emitU64((u64)inst->debugLoc.line);
                ctx.emit(" col=");
                ctx.emitU64((u64)inst->debugLoc.col);
                ctx.emitLine("");
            }

            if (inst->opcode == IrOpcode::Br ||
                inst->opcode == IrOpcode::CondBr ||
                inst->opcode == IrOpcode::Switch)
                emitPhiCopies(&ctx, ictx, bb, inst);

            switch (inst->opcode)
            {
                IrOpcode::Unreachable | IrOpcode::Noret => {
                    /* no legitimate successor — trap loudly rather than
                     * falling through into whatever code follows */
                    ctx.emitLine("    ud2");
                },
                IrOpcode::Ret => {
                    if (inst->nops > 0 && inst->ops[0] != null)
                    {
                        IrValue* rv = inst->ops[0];
                        u64 rsz = valByteSize(ictx, rv);
                        IrTypeKind rk = rv->type != null ? rv->type->kind : IrTypeKind::Int;
                        if (rk == IrTypeKind::Struct || rk == IrTypeKind::Array || rk == IrTypeKind::Union)
                        {
                            /* aggregate return: the value's header is
                             * the object address — ship the bytes in
                             * rax[:rdx] (internal ≤16B convention) */
                            if (rsz > 16)
                            {
                                ctx.emit("    # aggregate return of ");
                                ctx.emitI64((i64)rsz);
                                ctx.emitLine(" bytes unsupported");
                                ctx.emitLine("    ud2");
                            }
                            else
                            {
                                emitValueToReg(&ctx, rv, "rax");
                                ctx.emitLine("    movq (%rax), %rcx");
                                if (rsz > 8) ctx.emitLine("    movq 8(%rax), %rdx");
                                ctx.emitLine("    movq %rcx, %rax");
                            }
                        }
                        else if (rsz <= 8)
                        {
                            emitValueToReg(&ctx, rv, "rax");
                        }
                        else if (rsz <= 16 && vecLaneOk(rv))
                        {
                            emitVecLaneLoad(&ctx, rv, 0, 64, "rax", false);
                            emitVecLaneLoad(&ctx, rv, 8, 64, "rdx", false);
                        }
                        else
                        {
                            ctx.emit("    # aggregate return of ");
                            ctx.emitI64((i64)rsz);
                            ctx.emitLine(" bytes unsupported");
                            ctx.emitLine("    ud2");
                        }
                    }
                    ctx.emit("    jmp .L");
                    ctx.emit(func->base.name);
                    ctx.emitLine("_epilogue");
                },
                IrOpcode::Add => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    addq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Sub => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    subq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Mul => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    imulq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::SDiv => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    cqto");
                    ctx.emitLine("    idivq %rcx");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::UDiv => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    xorq %rdx, %rdx");
                    ctx.emitLine("    divq %rcx");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::SRem => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    cqto");
                    ctx.emitLine("    idivq %rcx");
                    emitRegToSlot(&ctx, &inst->base, "rdx");
                },
                IrOpcode::URem => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    xorq %rdx, %rdx");
                    ctx.emitLine("    divq %rcx");
                    emitRegToSlot(&ctx, &inst->base, "rdx");
                },
                IrOpcode::And => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    andq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Or => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    orq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Xor => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    xorq %rcx, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Shl => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    shlq %cl, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Lshr => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    shrq %cl, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Ashr => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    sarq %cl, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Neg => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    ctx.emitLine("    negq %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Not => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    ctx.emitLine("    notq %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Alloca => {
                    /* object lives at slotOff+8 (see the slot pass) */
                    i32 off = ctx.getSlot(&inst->base);
                    ctx.emit("    leaq ");
                    ctx.emitI64((i64)off + 8);
                    ctx.emitLine("(%rbp), %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Load => {
                    if (inst->base.type != null && inst->base.type->kind == IrTypeKind::Vector)
                        emitVecLoad(&ctx, ictx, inst);
                    else if (inst->base.type != null &&
                             (inst->base.type->kind == IrTypeKind::Struct ||
                              inst->base.type->kind == IrTypeKind::Array ||
                              inst->base.type->kind == IrTypeKind::Union))
                    {
                        /* aggregate load: the result is address-valued —
                         * its header IS the pointer the ptr operand
                         * already holds, so no dereference */
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                    else
                    {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    u32 w = 64;
                    if (inst->base.type != null) w = inst->base.type->width;
                    if (w == 8)
                        ctx.emitLine("    movzbl (%rax), %ecx");
                    else if (w == 16)
                        ctx.emitLine("    movzwl (%rax), %ecx");
                    else if (w == 32)
                        ctx.emitLine("    movl (%rax), %ecx");
                    else
                        ctx.emitLine("    movq (%rax), %rcx");
                    emitRegToSlot(&ctx, &inst->base, "rcx");
                    }
                },
                IrOpcode::Store => {
                    if (inst->ops[0] != null && inst->ops[0]->type != null &&
                        inst->ops[0]->type->kind == IrTypeKind::Vector)
                    {
                        emitVecStore(&ctx, ictx, inst);
                    }
                    else if (inst->ops[0] != null && inst->ops[0]->type != null &&
                             (inst->ops[0]->type->kind == IrTypeKind::Struct ||
                              inst->ops[0]->type->kind == IrTypeKind::Array ||
                              inst->ops[0]->type->kind == IrTypeKind::Union))
                    {
                        /* aggregate store: both operands are
                         * address-valued — copy the pointee bytes
                         * (header-to-header movq would store the
                         * pointer itself) */
                        emitValueToReg(&ctx, inst->ops[0], "rax"); // src addr
                        emitValueToReg(&ctx, inst->ops[1], "rcx"); // dst addr
                        u64 n = (u64)ictx->irTypeSizeOf(inst->ops[0]->type);
                        u64 nq = (n + 7) / 8;
                        for (u64 q = 0; q < nq; q++)
                        {
                            i64 o = (i64)(q * 8);
                            ctx.emit("    movq ");
                            ctx.emitI64(o);
                            ctx.emit("(%rax), %rdx\n    movq %rdx, ");
                            ctx.emitI64(o);
                            ctx.emitLine("(%rcx)");
                        }
                    }
                    else
                    {
                    emitValueToReg(&ctx, inst->ops[0], "rax"); // val
                    emitValueToReg(&ctx, inst->ops[1], "rcx"); // ptr
                    u32 w = 64;
                    if (inst->ops[0] != null && inst->ops[0]->type != null) w = inst->ops[0]->type->width;
                    if (w == 8)
                        ctx.emitLine("    movb %al, (%rcx)");
                    else if (w == 16)
                        ctx.emitLine("    movw %ax, (%rcx)");
                    else if (w == 32)
                        ctx.emitLine("    movl %eax, (%rcx)");
                    else
                        ctx.emitLine("    movq %rax, (%rcx)");
                    }
                },
                IrOpcode::ICmp => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    emitValueToReg(&ctx, inst->ops[1], "rcx");
                    ctx.emitLine("    cmpq %rcx, %rax");
                    str setInst = "sete";
                    switch (inst->icmpPred)
                    {
                        IrICmpPred::Eq => { setInst = "sete"; },
                        IrICmpPred::Ne => { setInst = "setne"; },
                        IrICmpPred::Slt => { setInst = "setl"; },
                        IrICmpPred::Sle => { setInst = "setle"; },
                        IrICmpPred::Sgt => { setInst = "setg"; },
                        IrICmpPred::Sge => { setInst = "setge"; },
                        IrICmpPred::Ult => { setInst = "setb"; },
                        IrICmpPred::Ule => { setInst = "setbe"; },
                        IrICmpPred::Ugt => { setInst = "seta"; },
                        IrICmpPred::Uge => { setInst = "setae"; },
                    }
                    ctx.emit("    ");
                    ctx.emit(setInst);
                    ctx.emitLine(" %al");
                    ctx.emitLine("    movzbq %al, %rax");
                    emitRegToSlot(&ctx, &inst->base, "rax");
                },
                IrOpcode::Br => {
                    if (inst->nops > 0 && inst->ops[0] != null)
                    {
                        ctx.emit("    jmp ");
                        emitBBLabel(&ctx, func, inst->ops[0]);
                        ctx.emitLine("");
                    }
                },
                IrOpcode::CondBr => {
                    emitValueToReg(&ctx, inst->ops[0], "rax");
                    ctx.emitLine("    testq %rax, %rax");
                    ctx.emit("    jne ");
                    emitBBLabel(&ctx, func, inst->ops[1]);
                    ctx.emitLine("");
                    ctx.emit("    jmp ");
                    emitBBLabel(&ctx, func, inst->ops[2]);
                    ctx.emitLine("");
                },
                IrOpcode::Call => {
                    u32 nArgs = inst->nops > 1 ? inst->nops - 1 : 0;
                    if (win64)
                    {
                        for (u32 ai = 0; ai < nArgs && ai < 4; ai++)
                        {
                            emitValueToReg(&ctx, inst->ops[ai + 1], WIN64_ARG_REGS_64[ai]);
                        }
                    }
                    else
                    {
                        for (u32 ai = 0; ai < nArgs && ai < 6; ai++)
                        {
                            emitValueToReg(&ctx, inst->ops[ai + 1], SYSV_ARG_REGS_64[ai]);
                        }
                    }

                    if (inst->ops[0] != null)
                    {
                        if (inst->ops[0]->kind == IrValueKind::Func ||
                            inst->ops[0]->kind == IrValueKind::Global)
                        {
                            ctx.emit("    call ");
                            ctx.emitLine(inst->ops[0]->name);
                        }
                        else
                        {
                            /* indirect call: the callee is a computed
                             * pointer value, not a named symbol */
                            emitValueToReg(&ctx, inst->ops[0], "r10");
                            ctx.emitLine("    call *%r10");
                        }
                    }
                    if (inst->base.type != null && inst->base.type->kind != IrTypeKind::Void)
                    {
                        u64 rsz = valByteSize(ictx, &inst->base);
                        IrTypeKind rk = inst->base.type->kind;
                        if (rk == IrTypeKind::Struct || rk == IrTypeKind::Array || rk == IrTypeKind::Union)
                        {
                            /* aggregate result: rax[:rdx] carry the
                             * bytes; store them into the object region
                             * and point the header at it */
                            if (rsz > 16)
                            {
                                ctx.emit("    # aggregate return of ");
                                ctx.emitI64((i64)rsz);
                                ctx.emitLine(" bytes unsupported");
                                ctx.emitLine("    ud2");
                            }
                            else
                            {
                                i32 d = ctx.getSlot(&inst->base);
                                ctx.emit("    leaq ");
                                ctx.emitI64((i64)d + 8);
                                ctx.emitLine("(%rbp), %rcx");
                                emitRegToSlot(&ctx, &inst->base, "rcx");
                                ctx.emit("    movq %rax, ");
                                ctx.emitI64((i64)d + 8);
                                ctx.emitLine("(%rbp)");
                                if (rsz > 8)
                                {
                                    ctx.emit("    movq %rdx, ");
                                    ctx.emitI64((i64)d + 16);
                                    ctx.emitLine("(%rbp)");
                                }
                            }
                        }
                        else if (rsz <= 8)
                        {
                            emitRegToSlot(&ctx, &inst->base, "rax");
                        }
                        else if (rsz <= 16)
                        {
                            /* callee returned the pair in rax:rdx —
                             * spill both qwords into the result region */
                            emitSlotStore(&ctx, ctx.getSlot(&inst->base), 64, "rax");
                            emitSlotStore(&ctx, ctx.getSlot(&inst->base) + 8, 64, "rdx");
                        }
                        else
                        {
                            ctx.emit("    # call result of ");
                            ctx.emitI64((i64)rsz);
                            ctx.emitLine(" bytes unsupported");
                            ctx.emitLine("    ud2");
                        }
                    }
                },
                IrOpcode::Gep => {
                    /* ops[0] = base ptr, ops[1..] = indices. Constant
                     * offsets accumulate; dynamic indices emit
                     * idx*elemSize adds. Struct indices are field
                     * numbers (no leading struct-element index). */
                    if (inst->nops >= 1 && inst->ops[0] != null)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        IrType* cur = inst->ops[0]->type;
                        if (cur != null && cur->kind == IrTypeKind::Ptr) cur = cur->elem;
                        i64 cOff = 0;
                        for (u32 gi = 1; gi < inst->nops; gi++)
                        {
                            IrValue* ix = inst->ops[gi];
                            if (ix == null) continue;
                            bool isConst = ix->kind == IrValueKind::ConstInt;
                            if (cur != null && cur->kind == IrTypeKind::Struct)
                            {
                                u32 fi = isConst ? (u32)(ix->valData & 0xFFFFFFFF) : 0;
                                cOff += (i64)emitStructFieldOff(ictx, cur, fi);
                                cur = fi < cur->nparams ? cur->params[fi] : null;
                            }
                            else
                            {
                                IrType* et = null;
                                u64 esz = 1;
                                if (cur != null &&
                                    (cur->kind == IrTypeKind::Array ||
                                     cur->kind == IrTypeKind::Vector))
                                {
                                    et = cur->elem;
                                }
                                else if (cur != null && cur->kind == IrTypeKind::Ptr)
                                {
                                    et = cur->elem;
                                }
                                if (et != null) esz = (u64)ictx->irTypeSizeOf(et);
                                if (isConst)
                                    cOff += (i64)ix->valData * (i64)esz;
                                else
                                {
                                    emitValueToReg(&ctx, ix, "rcx");
                                    if (esz != 1)
                                    {
                                        ctx.emit("    imulq $");
                                        ctx.emitI64((i64)esz);
                                        ctx.emitLine(", %rcx, %rcx");
                                    }
                                    ctx.emitLine("    addq %rcx, %rax");
                                }
                                cur = et;
                            }
                        }
                        if (cOff != 0)
                        {
                            ctx.emit("    addq $");
                            ctx.emitI64(cOff);
                            ctx.emitLine(", %rax");
                        }
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Select => {
                    /* ops: cond, trueVal, falseVal */
                    if (inst->nops >= 3)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        emitValueToReg(&ctx, inst->ops[2], "rdx");
                        ctx.emitLine("    testq %rax, %rax");
                        ctx.emitLine("    cmove %rdx, %rcx");
                        emitRegToSlot(&ctx, &inst->base, "rcx");
                    }
                },
                IrOpcode::Trunc | IrOpcode::Bitcast => {
                    /* sub-width trunc keeps the low bits — the slot is
                     * already 64-bit and consumers mask by type width */
                    if (inst->nops >= 1)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Zext => {
                    if (inst->nops >= 1)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        u32 sw = inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
                        if (sw <= 8) ctx.emitLine("    movzbl %al, %eax");
                        else if (sw <= 16) ctx.emitLine("    movzwl %ax, %eax");
                        else if (sw <= 32) ctx.emitLine("    movl %eax, %eax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Sext => {
                    if (inst->nops >= 1)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        u32 sw = inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
                        if (sw <= 8) ctx.emitLine("    movsbl %al, %eax");
                        else if (sw <= 16) ctx.emitLine("    movswl %ax, %eax");
                        else if (sw <= 32) ctx.emitLine("    movslq %eax, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::FAdd | IrOpcode::FSub | IrOpcode::FMul | IrOpcode::FDiv => {
                    if (inst->nops >= 2)
                    {
                        bool isF32 = inst->base.type != null && inst->base.type->width == 32;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        ctx.emitLine("    movq %rax, %xmm0");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        ctx.emitLine("    movq %rcx, %xmm1");
                        str sop = "addsd";
                        if (inst->opcode == IrOpcode::FSub) sop = "subsd";
                        else if (inst->opcode == IrOpcode::FMul) sop = "mulsd";
                        else if (inst->opcode == IrOpcode::FDiv) sop = "divsd";
                        if (isF32)
                        {
                            if (inst->opcode == IrOpcode::FAdd) sop = "addss";
                            else if (inst->opcode == IrOpcode::FSub) sop = "subss";
                            else if (inst->opcode == IrOpcode::FMul) sop = "mulss";
                            else sop = "divss";
                        }
                        ctx.emit("    ");
                        ctx.emit(sop);
                        ctx.emitLine(" %xmm1, %xmm0");
                        ctx.emitLine("    movq %xmm0, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::FCmp => {
                    if (inst->nops >= 2)
                    {
                        bool isF32 = inst->ops[0]->type != null && inst->ops[0]->type->width == 32;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        ctx.emitLine("    movq %rax, %xmm0");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        ctx.emitLine("    movq %rcx, %xmm1");
                        ctx.emitLine(isF32 ? "    ucomiss %xmm1, %xmm0" : "    ucomisd %xmm1, %xmm0");
                        // ucomiss raises PF on unordered, so ordered preds
                        // mask it out and unordered preds fold it in —
                        // ported from wallvm's emitFCmp. The predicate
                        // lives in fcmpPred, NOT icmpPred (which stays at
                        // its Eq default on FCmp insts).
                        str setInst = "sete";
                        u32 fmode = 0; // 0 = cc alone, 1 = and with setnp, 2 = or with setp
                        switch (inst->fcmpPred)
                        {
                            IrFCmpPred::Oeq => { setInst = "sete"; fmode = 1; },
                            IrFCmpPred::One => { setInst = "setne"; fmode = 1; },
                            IrFCmpPred::Olt => { setInst = "setb"; fmode = 1; },
                            IrFCmpPred::Ole => { setInst = "setbe"; fmode = 1; },
                            IrFCmpPred::Ogt => { setInst = "seta"; fmode = 0; },
                            IrFCmpPred::Oge => { setInst = "setae"; fmode = 1; },
                            IrFCmpPred::Ueq => { setInst = "sete"; fmode = 2; },
                            IrFCmpPred::Une => { setInst = "setne"; fmode = 2; },
                            IrFCmpPred::Ult => { setInst = "setb"; fmode = 0; },
                            IrFCmpPred::Ule => { setInst = "setbe"; fmode = 0; },
                            IrFCmpPred::Ugt => { setInst = "seta"; fmode = 2; },
                            IrFCmpPred::Uge => { setInst = "setae"; fmode = 2; },
                            else => { setInst = "sete"; fmode = 0; }
                        }
                        ctx.emit("    ");
                        ctx.emit(setInst);
                        ctx.emitLine(" %al");
                        if (fmode == 1)
                        {
                            ctx.emitLine("    setnp %cl");
                            ctx.emitLine("    and %cl, %al");
                        }
                        else if (fmode == 2)
                        {
                            ctx.emitLine("    setp %cl");
                            ctx.emitLine("    or %cl, %al");
                        }
                        ctx.emitLine("    movzbq %al, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::SiToFp | IrOpcode::UiToFp => {
                    /* int slot → xmm → float/double slot. UiToFp on a
                     * 64-bit source uses the (v>>1)*2+(v&1) split so the
                     * signed cvtsi2sd never sees the sign bit. */
                    if (inst->nops >= 1)
                    {
                        bool toF32 = inst->base.type != null && inst->base.type->width == 32;
                        u32 sw = inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        if (inst->opcode == IrOpcode::UiToFp && sw > 32)
                        {
                            ctx.emitLine("    movq %rax, %rcx");
                            ctx.emitLine("    shrq $1, %rcx");
                            ctx.emitLine("    andq $1, %rax");
                            ctx.emit(toF32 ? "    cvtsi2ss %rcx, %xmm0\n" : "    cvtsi2sd %rcx, %xmm0\n");
                            ctx.emit(toF32 ? "    addss %xmm0, %xmm0\n" : "    addsd %xmm0, %xmm0\n");
                            ctx.emitLine("    movq %rax, %rcx");
                            ctx.emit(toF32 ? "    cvtsi2ss %rcx, %xmm1\n" : "    cvtsi2sd %rcx, %xmm1\n");
                            ctx.emit(toF32 ? "    addss %xmm1, %xmm0\n" : "    addsd %xmm1, %xmm0\n");
                        }
                        else
                        {
                            if (sw <= 32) ctx.emitLine("    movl %eax, %eax");
                            ctx.emit(toF32 ? "    cvtsi2ss %rax, %xmm0\n" : "    cvtsi2sd %rax, %xmm0\n");
                        }
                        if (toF32)
                        {
                            ctx.emitLine("    movd %xmm0, %eax");
                            ctx.emitLine("    movl %eax, %eax");
                            emitRegToSlot(&ctx, &inst->base, "rax");
                        }
                        else
                        {
                            ctx.emitLine("    movq %xmm0, %rax");
                            emitRegToSlot(&ctx, &inst->base, "rax");
                        }
                    }
                },
                IrOpcode::FpToSi | IrOpcode::FpToUi => {
                    /* float slot → cvtt → int slot. Signed convert —
                     * unsigned destinations above INT64_MAX are a known
                     * gap (needs the magic-number adjust sequence). */
                    if (inst->nops >= 1)
                    {
                        bool fromF32 = inst->ops[0]->type != null && inst->ops[0]->type->width == 32;
                        u32 dw = inst->base.type != null ? inst->base.type->width : 64;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        if (fromF32)
                        {
                            ctx.emitLine("    movd %eax, %xmm0");
                            if (dw <= 32) ctx.emitLine("    cvttss2si %xmm0, %eax");
                            else ctx.emitLine("    cvttss2si %xmm0, %rax");
                        }
                        else
                        {
                            ctx.emitLine("    movq %rax, %xmm0");
                            if (dw <= 32) ctx.emitLine("    cvttsd2si %xmm0, %eax");
                            else ctx.emitLine("    cvttsd2si %xmm0, %rax");
                        }
                        if (dw <= 32) ctx.emitLine("    movl %eax, %eax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::FpTrunc | IrOpcode::FpExt => {
                    /* f64↔f32 narrowing/widening through xmm */
                    if (inst->nops >= 1)
                    {
                        bool toF32 = inst->opcode == IrOpcode::FpTrunc;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        if (toF32)
                        {
                            ctx.emitLine("    movq %rax, %xmm0");
                            ctx.emitLine("    cvtsd2ss %xmm0, %xmm0");
                            ctx.emitLine("    movd %xmm0, %eax");
                            ctx.emitLine("    movl %eax, %eax");
                        }
                        else
                        {
                            ctx.emitLine("    movd %eax, %xmm0");
                            ctx.emitLine("    cvtss2sd %xmm0, %xmm0");
                            ctx.emitLine("    movq %xmm0, %rax");
                        }
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Switch => {
                    /* ops: [scrutinee, defaultBlock, caseVal, caseBlock]* —
                     * compare-chain form; a jump table is a future opt */
                    if (inst->nops >= 2 && inst->ops[0] != null)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        u32 nCases = inst->nops >= 2 ? (inst->nops - 2) / 2 : 0;
                        u32 ci = 0;
                        while (ci < nCases)
                        {
                            IrValue* cv = inst->ops[2 + ci * 2];
                            IrValue* cb = inst->ops[3 + ci * 2];
                            if (cv != null && cb != null)
                            {
                                emitValueToReg(&ctx, cv, "rcx");
                                ctx.emitLine("    cmpq %rcx, %rax");
                                ctx.emit("    je ");
                                emitBBLabel(&ctx, func, cb);
                                ctx.emitLine("");
                            }
                            ci++;
                        }
                        IrValue* db = inst->ops[1];
                        if (db != null)
                        {
                            ctx.emit("    jmp ");
                            emitBBLabel(&ctx, func, db);
                            ctx.emitLine("");
                        }
                    }
                },
                IrOpcode::MulHi | IrOpcode::SMulHi => {
                    /* high half of the 2n-bit product: mul/imul leave
                     * it in rdx */
                    if (inst->nops >= 2)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        ctx.emitLine(inst->opcode == IrOpcode::MulHi ? "    mulq %rcx" : "    imulq %rcx");
                        ctx.emitLine("    movq %rdx, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Abs | IrOpcode::CtPop | IrOpcode::CtLz | IrOpcode::CtTz | IrOpcode::Bswap => {
                    if (inst->nops >= 1)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        if (inst->opcode == IrOpcode::Abs)
                        {
                            ctx.emitLine("    movq %rax, %rcx");
                            ctx.emitLine("    sarq $63, %rcx");
                            ctx.emitLine("    xorq %rcx, %rax");
                            ctx.emitLine("    subq %rcx, %rax");
                        }
                        else if (inst->opcode == IrOpcode::CtPop)
                            ctx.emitLine("    popcntq %rax, %rax");
                        else if (inst->opcode == IrOpcode::CtLz)
                            ctx.emitLine("    lzcntq %rax, %rax");
                        else if (inst->opcode == IrOpcode::CtTz)
                            ctx.emitLine("    tzcntq %rax, %rax");
                        else
                        {
                            u32 w = inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
                            ctx.emitLine(w <= 32 ? "    bswapl %eax" : "    bswapq %rax");
                        }
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::SMin | IrOpcode::SMax | IrOpcode::UMin | IrOpcode::UMax | IrOpcode::Rotl | IrOpcode::Rotr => {
                    if (inst->nops >= 2)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        if (inst->opcode == IrOpcode::Rotl || inst->opcode == IrOpcode::Rotr)
                        {
                            // Rotate wraps bits, so the operand width
                            // matters — a 64-bit rol on an i32 value pulls
                            // high garbage into the low word. Pick the
                            // suffix/reg pair from the result width.
                            u32 rw = inst->base.type != null ? inst->base.type->width : 64;
                            str rreg = rw <= 16 ? "%ax" : (rw <= 32 ? "%eax" : "%rax");
                            str suf = rw <= 16 ? "w" : (rw <= 32 ? "l" : "q");
                            ctx.emit("    ro");
                            ctx.emit(inst->opcode == IrOpcode::Rotl ? "l" : "r");
                            ctx.emit(suf);
                            ctx.emit(" %cl, ");
                            ctx.emitLine(rreg);
                        }
                        else
                        {
                            ctx.emitLine("    cmpq %rcx, %rax");
                            str cc = "cmovg";
                            if (inst->opcode == IrOpcode::SMax) cc = "cmovl";
                            else if (inst->opcode == IrOpcode::UMin) cc = "cmova";
                            else if (inst->opcode == IrOpcode::UMax) cc = "cmovb";
                            ctx.emit("    ");
                            ctx.emit(cc);
                            ctx.emitLine(" %rcx, %rax");
                        }
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Phi => {
                    /* copies were already emitted on the incoming edges
                     * by emitPhiCopies — the phi itself is a no-op */
                },
                IrOpcode::InlineAsm => {
                    emitInlineAsm(&ctx, inst, win64);
                },
                IrOpcode::Fma => {
                    /* a*b+c through xmm — not a fused op, but correct */
                    if (inst->nops >= 3)
                    {
                        bool isF32 = inst->base.type != null && inst->base.type->width == 32;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        ctx.emitLine("    movq %rax, %xmm0");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        ctx.emitLine("    movq %rcx, %xmm1");
                        ctx.emitLine(isF32 ? "    mulss %xmm1, %xmm0" : "    mulsd %xmm1, %xmm0");
                        emitValueToReg(&ctx, inst->ops[2], "rdx");
                        ctx.emitLine("    movq %rdx, %xmm1");
                        ctx.emitLine(isF32 ? "    addss %xmm1, %xmm0" : "    addsd %xmm1, %xmm0");
                        ctx.emitLine("    movq %xmm0, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::FAbs => {
                    if (inst->nops >= 1)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        u32 w = inst->base.type != null ? inst->base.type->width : 64;
                        ctx.emitLine(w <= 32 ? "    btrl $31, %eax" : "    btrq $63, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::FSqrt => {
                    if (inst->nops >= 1)
                    {
                        bool isF32 = inst->ops[0]->type != null && inst->ops[0]->type->width == 32;
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        ctx.emitLine("    movq %rax, %xmm0");
                        ctx.emitLine(isF32 ? "    sqrtss %xmm0, %xmm0" : "    sqrtsd %xmm0, %xmm0");
                        ctx.emitLine("    movq %xmm0, %rax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::VecAdd => { emitVecIntBin(&ctx, ictx, inst, "add"); },
                IrOpcode::VecSub => { emitVecIntBin(&ctx, ictx, inst, "sub"); },
                IrOpcode::VecMul => { emitVecIntBin(&ctx, ictx, inst, "imul"); },
                IrOpcode::VecDiv => { emitVecIntDiv(&ctx, ictx, inst); },
                IrOpcode::VecFAdd => { emitVecFloatBin(&ctx, ictx, inst, "addss", "addsd"); },
                IrOpcode::VecFSub => { emitVecFloatBin(&ctx, ictx, inst, "subss", "subsd"); },
                IrOpcode::VecFMul => { emitVecFloatBin(&ctx, ictx, inst, "mulss", "mulsd"); },
                IrOpcode::VecFDiv => { emitVecFloatBin(&ctx, ictx, inst, "divss", "divsd"); },
                IrOpcode::VecMin => {
                    IrType* et = vecValueTy(inst) != null ? vecValueTy(inst)->elem : null;
                    if (et != null && et->kind == IrTypeKind::Float)
                        emitVecFloatMinMax(&ctx, ictx, inst, true);
                    else
                        emitVecIntMinMax(&ctx, ictx, inst, true);
                },
                IrOpcode::VecMax => {
                    IrType* et = vecValueTy(inst) != null ? vecValueTy(inst)->elem : null;
                    if (et != null && et->kind == IrTypeKind::Float)
                        emitVecFloatMinMax(&ctx, ictx, inst, false);
                    else
                        emitVecIntMinMax(&ctx, ictx, inst, false);
                },
                IrOpcode::VecBroadcast => { emitVecBroadcast(&ctx, ictx, inst); },
                IrOpcode::ExtractElement => { emitVecExtract(&ctx, ictx, inst); },
                IrOpcode::InsertElement => { emitVecInsert(&ctx, ictx, inst); },
                IrOpcode::ShuffleVector => { emitVecShuffle(&ctx, ictx, inst); },
                IrOpcode::AtomicLoad => {
                    /* aligned scalar loads/stores are already atomic on
                     * x86 — a plain mov is the correct lowering */
                    if (inst->nops >= 1 && inst->ops[0] != null)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        u32 w = inst->base.type != null ? inst->base.type->width : 64;
                        if (w == 8) ctx.emitLine("    movzbl (%rax), %ecx");
                        else if (w == 16) ctx.emitLine("    movzwl (%rax), %ecx");
                        else if (w == 32) ctx.emitLine("    movl (%rax), %ecx");
                        else ctx.emitLine("    movq (%rax), %rcx");
                        emitRegToSlot(&ctx, &inst->base, "rcx");
                    }
                },
                IrOpcode::AtomicStore => {
                    if (inst->nops >= 2 && inst->ops[0] != null && inst->ops[1] != null)
                    {
                        emitValueToReg(&ctx, inst->ops[0], "rax");
                        emitValueToReg(&ctx, inst->ops[1], "rcx");
                        u32 w = inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
                        if (w == 8) ctx.emitLine("    movb %al, (%rcx)");
                        else if (w == 16) ctx.emitLine("    movw %ax, (%rcx)");
                        else if (w == 32) ctx.emitLine("    movl %eax, (%rcx)");
                        else ctx.emitLine("    movq %rax, (%rcx)");
                    }
                },
                IrOpcode::AtomicRmw => {
                    IrAtomicRmwOp rw = (IrAtomicRmwOp)inst->icmpPred;
                    if (rw == IrAtomicRmwOp::Nand || rw == IrAtomicRmwOp::Max ||
                        rw == IrAtomicRmwOp::Min || rw == IrAtomicRmwOp::UMax ||
                        rw == IrAtomicRmwOp::UMin)
                    {
                        ctx.emit("    # atomicrmw op not supported: ");
                        ctx.emitLine(irOpcodeStr(inst->opcode));
                        ctx.emitLine("    ud2");
                    }
                    else if (inst->nops >= 2 && inst->ops[0] != null && inst->ops[1] != null)
                    {
                        u32 w = inst->base.type != null ? inst->base.type->width : 64;
                        emitValueToReg(&ctx, inst->ops[0], "rcx"); // ptr
                        emitValueToReg(&ctx, inst->ops[1], "rdx"); // val
                        str mn = "add";
                        if (rw == IrAtomicRmwOp::Sub) mn = "sub";
                        else if (rw == IrAtomicRmwOp::And) mn = "and";
                        else if (rw == IrAtomicRmwOp::Or) mn = "or";
                        else if (rw == IrAtomicRmwOp::Xor) mn = "xor";
                        if (rw == IrAtomicRmwOp::Xchg)
                        {
                            ctx.emit(w <= 8 ? "    lock xchgb %dl, (%rcx)\n" :
                                      w <= 16 ? "    lock xchgw %dx, (%rcx)\n" :
                                      w <= 32 ? "    lock xchgl %edx, (%rcx)\n" :
                                      "    lock xchgq %rdx, (%rcx)\n");
                            ctx.emit(w <= 8 ? "    movzbl %dl, %eax\n" :
                                      w <= 16 ? "    movzwl %dx, %eax\n" :
                                      w <= 32 ? "    movl %edx, %eax\n" :
                                      "    movq %rdx, %rax\n");
                            emitRegToSlot(&ctx, &inst->base, "rax");
                        }
                        else
                        {
                            /* atomicrmw returns the OLD value; a plain
                             * lock op + reload returns the new one, so
                             * use a lock cmpxchg retry loop:
                             *   rax = expected (old), r8 = new value,
                             *   on mismatch rax <- *ptr and retry */
                            str suf = w <= 8 ? "b" : w <= 16 ? "w" : w <= 32 ? "l" : "q";
                            str vn = w <= 8 ? "dl" : w <= 16 ? "dx" : w <= 32 ? "edx" : "rdx";
                            str nn = w <= 8 ? "r8b" : w <= 16 ? "r8w" : w <= 32 ? "r8d" : "r8";
                            str en = w <= 8 ? "al" : w <= 16 ? "ax" : w <= 32 ? "eax" : "rax";
                            /* expected = *ptr (zero-extended) */
                            ctx.emit(w <= 8 ? "    movzbl (%rcx), %eax\n" :
                                      w <= 16 ? "    movzwl (%rcx), %eax\n" :
                                      w <= 32 ? "    movl (%rcx), %eax\n" :
                                      "    movq (%rcx), %rax\n");
                            ctx.emit(".L");
                            ctx.emit(func->base.name);
                            ctx.emit("_rmw");
                            ctx.emitU64((u64)inst->base.id);
                            ctx.emitLine(":");
                            ctx.emit("    mov %");
                            ctx.emit(en);
                            ctx.emit(", %");
                            ctx.emit(nn);
                            ctx.emitLine("");
                            ctx.emit("    ");
                            ctx.emit(mn);
                            ctx.emit(suf);
                            ctx.emit(" %");
                            ctx.emit(vn);
                            ctx.emit(", %");
                            ctx.emit(nn);
                            ctx.emitLine("");
                            ctx.emit("    lock cmpxchg");
                            ctx.emit(suf);
                            ctx.emit(" %");
                            ctx.emit(nn);
                            ctx.emitLine(", (%rcx)");
                            ctx.emit("    jne .L");
                            ctx.emit(func->base.name);
                            ctx.emit("_rmw");
                            ctx.emitU64((u64)inst->base.id);
                            ctx.emitLine("");
                            /* rax holds the old value on success */
                            if (w <= 8) ctx.emitLine("    movzbl %al, %eax");
                            else if (w <= 16) ctx.emitLine("    movzwl %ax, %eax");
                            else if (w <= 32) ctx.emitLine("    movl %eax, %eax");
                            emitRegToSlot(&ctx, &inst->base, "rax");
                        }
                    }
                },
                IrOpcode::AtomicCmpXchg => {
                    /* ops: ptr, cmp, val — rax=cmp, src=val, lock cmpxchg */
                    if (inst->nops >= 3 && inst->ops[0] != null && inst->ops[1] != null &&
                        inst->ops[2] != null)
                    {
                        u32 w = inst->base.type != null ? inst->base.type->width : 64;
                        emitValueToReg(&ctx, inst->ops[1], "rax"); // cmp
                        emitValueToReg(&ctx, inst->ops[0], "rcx"); // ptr
                        emitValueToReg(&ctx, inst->ops[2], "rdx"); // val
                        ctx.emit(w <= 8 ? "    lock cmpxchgb %dl, (%rcx)\n" :
                                  w <= 16 ? "    lock cmpxchgw %dx, (%rcx)\n" :
                                  w <= 32 ? "    lock cmpxchgl %edx, (%rcx)\n" :
                                  "    lock cmpxchgq %rdx, (%rcx)\n");
                        if (w <= 8) ctx.emitLine("    movzbl %al, %eax");
                        else if (w <= 16) ctx.emitLine("    movzwl %ax, %eax");
                        else if (w <= 32) ctx.emitLine("    movl %eax, %eax");
                        emitRegToSlot(&ctx, &inst->base, "rax");
                    }
                },
                IrOpcode::Fence => {
                    /* x86 TSO gives acquire/release for plain movs; only
                     * seq_cst needs an actual fence */
                    IrAtomicOrdering ord = (IrAtomicOrdering)inst->icmpPred;
                    if (ord == IrAtomicOrdering::SeqCst) ctx.emitLine("    mfence");
                },
                IrOpcode::LandingPad | IrOpcode::ExtractValue | IrOpcode::InsertValue |
                IrOpcode::GcRoot | IrOpcode::GcWriteBarrier | IrOpcode::GcSafepoint => {
                    ctx.emit("    # unsupported opcode: ");
                    ctx.emitLine(irOpcodeStr(inst->opcode));
                    ctx.emitLine("    ud2");
                },
                else => {
                    /* never silently drop an instruction — an
                     * unimplemented op that survives to codegen is a
                     * backend bug and must trap loudly, not corrupt */
                    ctx.emit("    # unimplemented opcode: ");
                    ctx.emitLine(irOpcodeStr(inst->opcode));
                    ctx.emitLine("    ud2");
                }
            }
        }
    }

    // 5. Function Epilogue
    ctx.emit(".L");
    ctx.emit(func->base.name);
    ctx.emitLine("_epilogue:");
    ctx.emitLine("    movq %rbp, %rsp");
    ctx.emitLine("    popq %rbp");
    ctx.emitLine("    retq");

    str res = ctx.out.asView();
    return res;
}

void emitEscapedAsciz(FastX86Context* ctx, const u8* data, u32 len)
{
    ctx->emit("    .asciz \"");
    for (u32 i = 0; i < len; i++)
    {
        u8 c = data[i];
        if (c == 10) ctx->emit("\\n");
        else if (c == 9) ctx->emit("\\t");
        else if (c == 13) ctx->emit("\\r");
        else if (c == 34) ctx->emit("\\\"");
        else if (c == 92) ctx->emit("\\\\");
        else if (c >= 32 && c <= 126)
        {
            u8[1] ch;
            ch[0] = c;
            ctx->emit(str::fromParts((const u8*)ch, 1));
        }
        else
        {
            cchar[8] oct;
            snprintf(oct, 8, C"\\%03o", (u32)c);
            ctx->emit(str::fromCstr((cchar*)oct));
        }
    }
    ctx->emitLine("\"");
}

// Emits constant value directives (.byte, .short, .long, .quad, .asciz, etc.)
void emitConstantData(FastX86Context* ctx, IrValue* v)
{
    if (v == null)
    {
        ctx->emitLine("    .quad 0");
        return;
    }

    switch (v->kind)
    {
        IrValueKind::ConstInt => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w == 8)
            {
                ctx->emit("    .byte ");
                ctx->emitI64((i64)(u8)v->valData);
                ctx->emitLine("");
            }
            else if (w == 16)
            {
                ctx->emit("    .short ");
                ctx->emitI64((i64)(u16)v->valData);
                ctx->emitLine("");
            }
            else if (w == 32)
            {
                ctx->emit("    .long ");
                ctx->emitI64((i64)(i32)v->valData);
                ctx->emitLine("");
            }
            else
            {
                ctx->emit("    .quad ");
                ctx->emitI64((i64)v->valData);
                ctx->emitLine("");
            }
        },
        IrValueKind::ConstFloat => {
            u32 w = v->type != null ? v->type->width : 64;
            if (w == 32)
            {
                ctx->emit("    .long ");
                ctx->emitU64((u64)(u32)v->valData);
                ctx->emitLine("");
            }
            else
            {
                ctx->emit("    .quad ");
                ctx->emitU64(v->valData);
                ctx->emitLine("");
            }
        },
        IrValueKind::StringConst => {
            IrStringConst* sc = (IrStringConst*)v;
            emitEscapedAsciz(ctx, sc->data, sc->length);
        },
        IrValueKind::ConstArray => {
            IrArrayConst* ac = (IrArrayConst*)v;
            for (u32 i = 0; i < ac->nelems; i++)
            {
                emitConstantData(ctx, ac->elems[i]);
            }
        },
        IrValueKind::StructConst => {
            IrStructConst* st = (IrStructConst*)v;
            for (u32 i = 0; i < st->nelems; i++)
            {
                emitConstantData(ctx, st->elems[i]);
            }
        },
        IrValueKind::Global | IrValueKind::Func => {
            ctx->emit("    .quad ");
            ctx->emitLine(v->name);
        },
        else => {
            ctx->emitLine("    .quad 0");
        }
    }
}

// Emits strings, global variables, and arrays for the module
pub str emitFastX86Data(IrModule* modd, bool isWindows)
{
    if (modd == null) return "";

    FastX86Context ctx = FastX86Context::new(isWindows);

    // 1. String Constants (.rodata on Linux, .rdata on Windows)
    if (modd->nconstStrings > 0)
    {
        ctx.emitLine("# ---- String Constants ----");
        if (isWindows)
            ctx.emitLine("    .section .rdata, \"dr\"");
        else
            ctx.emitLine("    .section .rodata");

        for (u32 i = 0; i < modd->nconstStrings; i++)
        {
            IrStringConst* sc = modd->constStrings[i];
            if (sc == null) continue;

            ctx.emitLine("    .align 1");
            if (!sc->base.name.isEmpty())
            {
                ctx.emit(sc->base.name);
                ctx.emitLine(":");
            }
            else
            {
                ctx.emit(".Lstr_");
                ctx.emitU64((u64)sc->base.id);
                ctx.emitLine(":");
            }

            emitEscapedAsciz(&ctx, sc->data, sc->length);
        }
        ctx.emitLine("");
    }

    // 2. Global Variables (.data or .rodata/.rdata)
    if (modd->nglobals > 0)
    {
        ctx.emitLine("# ---- Global Variables ----");
        for (u32 gi = 0; gi < modd->nglobals; gi++)
        {
            IrGlobal* g = modd->globals[gi];
            if (g == null || g->isExtern) continue;

            if (g->isConst)
            {
                if (isWindows)
                    ctx.emitLine("    .section .rdata, \"dr\"");
                else
                    ctx.emitLine("    .section .rodata");
            }
            else
            {
                ctx.emitLine("    .data");
            }

            u32 align = g->alignment != 0 ? g->alignment : 8;
            ctx.emit("    .align ");
            ctx.emitU64((u64)align);
            ctx.emitLine("");

            ctx.emit(".globl ");
            ctx.emitLine(g->base.name);
            ctx.emit(g->base.name);
            ctx.emitLine(":");

            if (g->initVal != null)
            {
                emitConstantData(&ctx, g->initVal);
            }
            else
            {
                u32 sz = 8;
                if (g->base.type != null && g->base.type->elem != null)
                {
                    sz = (g->base.type->elem->width + 7) / 8;
                    if (sz == 0) sz = 8;
                }
                ctx.emit("    .zero ");
                ctx.emitU64((u64)sz);
                ctx.emitLine("");
            }
        }
        ctx.emitLine("");
    }

    str res = ctx.out.asView();
    return res;
}

pub str emitFuncAsm(IrFunc* func, IrContext* ctx)
{
    if (func == null || ctx == null) return "";
    return emitFastX86Func(func, ctx, false);
}

pub str emitFuncAsmTarget(IrFunc* func, IrContext* ctx, bool isWindows)
{
    if (func == null || ctx == null) return "";
    return emitFastX86Func(func, ctx, isWindows);
}

pub str emitModuleAsmTarget(IrModule* modd, IrContext* ctx, bool isWindows)
{
    if (modd == null || ctx == null) return "";

    String out = String::new();

    // 1. Module-level metadata header
    out.appendView("# ========================================================\n");
    out.appendView("# Module: ");
    out.appendView(modd->name);
    out.appendView("\n# Target OS: ");
    out.appendView(isWindows ? "Windows (Win64 ABI)\n" : "Linux / Unix (SystemV ABI)\n");
    out.appendView("# ========================================================\n\n");

    // 2. Data Section (Strings, Arrays, Global Variables, Structs)
    str dataAsm = emitFastX86Data(modd, isWindows);
    if (dataAsm.len > 0)
    {
        out.appendView(dataAsm);
    }

    // 3. Functions (with section placement and metadata)
    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null || func->isExtern) continue;

        str fAsm = emitFastX86Func(func, ctx, isWindows);
        if (fAsm.len > 0)
        {
            out.appendView(fAsm);
            out.pushChar('\n');
        }
    }

    return out.asView();
}

pub str emitModuleAsm(IrModule* modd, IrContext* ctx)
{
    return emitModuleAsmTarget(modd, ctx, false);
}

pub bool compileModule(IrModule* modd, IrContext* ctx)
{
    if (modd == null || ctx == null) return false;
    str asmText = emitModuleAsm(modd, ctx);
    return asmText.len > 0 || modd->nfuncs == 0;
}
