#[[no_drop_all]]
// asmtool: exercise the muvm assemblers (x86-64 AT&T, AArch64 GNU,
// WAT→wasm) from the command line. Used for stress/ASan testing.
//
//   asmtool x86   <in.s>   <out.o>  [elf|coff]
//   asmtool arm64 <in.s>   <out.o>  [elf|coff|macho|raw]
//   asmtool wasm  <in.wat> <out.wasm>
import muvm::assembly::common { AsmParseError };
import muvm::assembly::x86::common { AsmBytes };
import muvm::assembly::x86::obj { AsmObject, asmObjectNew, asmObjectDeinit, emitElf, emitCoff };
import muvm::assembly::x86::x86_64 { assembleText };
import muvm::assembly::arm64::encode { a64AssembleText, a64EmitObject };
import muvm::assembly::wasm::encode { wasmAssemble };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import std::ios { println, eprintln };
import std::string { String };

import core::cchar { cchar };

bool writeFile(str path, u8* data, usize len)
{
    Result<File, IoError> fo = fileOpen(path, "wb");
    if (fo.isErr()) return false;
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, data, len);
    fileClose(f);
    return wr.isOk();
}

i32 doX86(str inPath, str outPath, bool coff)
{
    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr()) { eprintln("asmtool: cannot read {}", inPath); return 1; }
    String src = rd.unwrap();
    AsmObject obj = asmObjectNew();
    AsmParseError err = AsmParseError { .msg = str::empty(), .lineNo = 0 };
    if (!assembleText(src.asView(), &obj, &err))
    {
        eprintln("{}:{}: {}", inPath, err.lineNo, err.msg);
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }
    AsmBytes out = AsmBytes::new();
    bool ok = coff ? emitCoff(&obj, &out, &err) : emitElf(&obj, &out, &err);
    if (!ok)
    {
        eprintln("{}:{}: {}", inPath, err.lineNo, err.msg);
        out.deinit();
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }
    if (!writeFile(outPath, out.data, (usize)out.len))
    {
        eprintln("asmtool: cannot write {}", outPath);
        out.deinit();
        asmObjectDeinit(&obj);
        src.free();
        return 1;
    }
    println("{}: {} bytes; {} symbols, {} relocs", outPath, out.len, obj.nsyms, obj.nrelocs);
    out.deinit();
    asmObjectDeinit(&obj);
    src.free();
    return 0;
}

i32 doArm64(str inPath, str outPath, i32 fmt)
{
    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr()) { eprintln("asmtool: cannot read {}", inPath); return 1; }
    String src = rd.unwrap();
    AsmObject obj = {};
    i32 es = 0;
    u32 eo = 0;
    u32 el = 0;
    str em = "";
    if (!a64AssembleText(src.asView(), &obj, &es, &eo, &el, &em))
    {
        eprintln("{}:{}: {}", inPath, el, em);
        src.free();
        return 1;
    }
    if (!a64EmitObject(&obj, outPath, fmt))
    {
        eprintln("asmtool: emit failed for {}", outPath);
        src.free();
        return 1;
    }
    println("{}: assembled", outPath);
    src.free();
    return 0;
}

i32 doWasm(str inPath, str outPath)
{
    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr()) { eprintln("asmtool: cannot read {}", inPath); return 1; }
    String src = rd.unwrap();
    String bin = String::new();
    String err = String::new();
    u32 errLine = 0;
    if (!wasmAssemble(src.asView(), &bin, &err, &errLine))
    {
        eprintln("{}:{}: {}", inPath, errLine, err.asView());
        src.free();
        return 1;
    }
    if (!writeFile(outPath, bin.asU8(), bin.len))
    {
        eprintln("asmtool: cannot write {}", outPath);
        src.free();
        return 1;
    }
    println("{}: {} bytes", outPath, bin.len);
    src.free();
    return 0;
}

i32 main(i32 argc, cchar** argv)
{
    if (argc < 4)
    {
        eprintln("usage: asmtool <x86|arm64|wasm> <in> <out> [elf|coff|macho|raw]");
        return 2;
    }
    str mode = str::fromCstr(argv[1]);
    str inPath = str::fromCstr(argv[2]);
    str outPath = str::fromCstr(argv[3]);
    str fmt = argc > 4 ? str::fromCstr(argv[4]) : str::empty();

    if (mode.equals("x86"))
        return doX86(inPath, outPath, fmt.equals("coff"));
    if (mode.equals("arm64"))
    {
        i32 f = 0;
        if (fmt.equals("coff")) f = 1;
        else if (fmt.equals("macho")) f = 2;
        else if (fmt.equals("raw")) f = 3;
        return doArm64(inPath, outPath, f);
    }
    if (mode.equals("wasm"))
        return doWasm(inPath, outPath);
    eprintln("asmtool: unknown mode {}", mode);
    return 2;
}
