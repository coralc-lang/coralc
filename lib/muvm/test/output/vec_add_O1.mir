// ---- module ----

module "vec_add"

// ---- funcs ----

func @f(%n: i64) i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i64 16
    %c = alloca array i64 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    %g0 = gep %c, 0
    %r = load i64 %g0
    ret i64 %r

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %gb = gep %b, %i
    %lb = load i64 %gb
    %s = add i64 %la, %lb
    %gc = gep %c, %i
    store i64 %s, %gc
    %in = add i64 %i, 1
    br loop
}
