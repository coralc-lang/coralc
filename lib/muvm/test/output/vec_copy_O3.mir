// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 !argmemonly {

entry:
    %0  = alloca array i64 8
    %1  = alloca array i64 8
    %2  = load vector i64 2 %0
    store vector i64 2 %2, %1
    %3  = gep %0, 2
    %4  = load vector i64 2 %3
    %5  = gep %1, 2
    store vector i64 2 %4, %5
    %6  = gep %0, 4
    %7  = load vector i64 2 %6
    %8  = gep %1, 4
    store vector i64 2 %7, %8
    %9  = gep %0, 6
    %10 = load vector i64 2 %9
    %11 = gep %1, 6
    store vector i64 2 %10, %11
    ret i64 0

}
