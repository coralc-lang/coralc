// ---- module ----

module "dynextern"

// ---- funcs ----

func @host_fn(%0: i64, %1: ptr) i64 extern "dyn" "real_host_sym";

func @engine_cb() extern "dyn" "engine_callback";

func @libc_fn(%0: i32) i32 extern "libc.so.6" "printf";

func @main() i32 {

entry:
    %0 = alloca i64
    %1 = call i64 @host_fn(i64 1, ptr i64 %0)
    call void @engine_cb()
    ret i32 0

}
