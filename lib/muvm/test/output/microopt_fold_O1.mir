func @not_rotate(%x: i32) i32 {
entry:
    %l = shl i32 %x, 5
    %r = lshr i32 %x, 26
    %o = or i32 %l, %r
    ret i32 %o
}

func @load_le32(%p: ptr) i32 {
entry:
    %p0 = gep %p, 0
    %215 = load i32 %p0
    ret i32 %215
}

func @load_be16(%p: ptr) i16 {
entry:
    %p0 = gep %p, 0
    %218 = load i16 %p0
    %219 = bswap i16 %218
    ret i16 %219
}

func @load_gap(%p: ptr) i32 {
entry:
    %p0 = gep %p, 0
    %p1 = gep %p, 1
    %p2 = gep %p, 2
    %p3 = gep %p, 3
    %b0 = load i8 %p0
    store i8 0, %p1
    %b1 = load i8 %p1
    %b2 = load i8 %p2
    %b3 = load i8 %p3
    %e0 = zext i8 %b0 to i32
    %e1 = zext i8 %b1 to i32
    %e2 = zext i8 %b2 to i32
    %e3 = zext i8 %b3 to i32
    %s1 = shl i32 %e1, 8
    %s2 = shl i32 %e2, 16
    %s3 = shl i32 %e3, 24
    %o0 = or i32 %e0, %s1
    %o1 = or i32 %o0, %s2
    %o2 = or i32 %o1, %s3
    ret i32 %o2
}
