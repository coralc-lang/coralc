// ---- module ----

module "microopt_fold"

// ---- funcs ----

func @udiv3(%x: i32) i32 {
entry:
    %146 = mulhi i32 %x, -1431655765
    %148 = lshr i32 %146, 1
    ret i32 %148
}

func @urem7(%x: i32) i32 {
entry:
    %152 = mulhi i32 %x, 613566757
    %153 = sub i32 %x, %152
    %154 = lshr i32 %153, 1
    %155 = add i32 %152, %154
    %157 = lshr i32 %155, 2
    %158 = mul i32 %157, 7
    %159 = sub i32 %x, %158
    ret i32 %159
}

func @sdiv3(%x: i32) i32 {
entry:
    %162 = smulhi i32 %x, -1431655765
    %163 = ashr i32 %162, 1
    %165 = ashr i32 %x, 31
    %166 = sub i32 %163, %165
    ret i32 %166
}

func @srem_neg7(%x: i32) i32 {
entry:
    %170 = smulhi i32 %x, -1840700269
    %171 = ashr i32 %170, 2
    %172 = ashr i32 %x, 31
    %173 = sub i32 %171, %172
    %174 = neg i32 %173
    %175 = mul i32 %174, -7
    %176 = sub i32 %x, %175
    ret i32 %176
}

