// ---- module ----

module "vec_reject_smin"

// ---- funcs ----

func @f() i64 {

entry:
    %0 = alloca array i64 16
    br loop

loop:
    %1 = phi i64 [0, entry], [%8, latch]
    %2 = phi i64 [100, entry], [%7, latch]
    %3 = icmp slt i64 %1, 16
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = gep %0, %1
    %5 = load i64 %4
    %6 = icmp slt i64 %5, %2
    %7 = select i1 %6, i64 %5, i64 %2
    br latch

latch:
    %8 = add i64 %1, 1
    br loop

}
