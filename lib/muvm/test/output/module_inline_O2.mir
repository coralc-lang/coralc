// ---- module ----

module "module_inline"

// ---- funcs ----

func @main() i32 {
entry:
    %a = call i64 @tiny(i64 5)
    %ah = call i64 @tiny_hint(i64 5)
    %aa = call i64 @always3(i64 0)
    %an = call i64 @neg_hint(i64 5)
    %b = call i64 @const42()
    %c = call i64 @param_const(i64 7)
    %d = call i64 @multi_ret(i64 0)
    %e = call i64 @switch_ret(i64 2)
    %f = call i64 @rec(i64 3)
    %s1 = add i64 %a, %ah
    %s2 = add i64 %s1, %aa
    %s3 = add i64 %s2, %an
    %s4 = add i64 %s3, %b
    %s5 = add i64 %s4, %c
    %s6 = add i64 %s5, %d
    %s7 = add i64 %s6, %e
    %s8 = add i64 %s7, %f
    %t = trunc i64 %s8 to i32
    ret i32 %t
}

func @tiny(%x: i64) i64 !linkage {
entry:
    %r = add i64 %x, 10
    ret i64 %r
}

func @tiny_hint(%x: i64) i64 !linkage !inlinehint {
entry:
    %r = add i64 %x, 20
    ret i64 %r
}

func @always3(%x: i64) i64 !linkage !inlinehint = 3 {
entry:
    br b13

b13:
    ret i64 99
}

func @neg_hint(%x: i64) i64 !linkage !inlinehint = -1 {
entry:
    %r = add i64 %x, 30
    ret i64 %r
}

func @const42() i64 !linkage !noinline {
entry:
    ret i64 42
}

func @param_const(%x: i64) i64 !linkage !noinline {
entry:
    %r = add i64 %x, 1
    ret i64 %r
}

func @multi_ret(%x: i64) i64 !linkage {
entry:
    %c = icmp eq i64 %x, 0
    cond_br %c, zero, nonzero

nonzero:
    ret i64 4

zero:
    ret i64 3
}

func @switch_ret(%x: i64) i64 !linkage {
entry:
    switch i64 %x, default other [ i64 1, one, i64 2, two]

two:
    ret i64 22

one:
    ret i64 11

other:
    ret i64 33
}

func @rec(%n: i64) i64 !linkage {
entry:
    %c = icmp sle i64 %n, 0
    cond_br %c, done, step

step:
    %n1 = sub i64 %n, 1
    %r = call i64 @rec(i64 %n1)
    ret i64 %r

done:
    ret i64 0
}
