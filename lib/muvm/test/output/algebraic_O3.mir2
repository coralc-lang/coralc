// ---- module ----

module "algebraic_demo"

// ---- funcs ----

func @mul_pow2(%v: i64, %w: i64) i64 {
entry:
    %52 = shl i64 %v, 4
    %51 = shl i64 %v, 1
    %50 = shl i64 %w, 3
    %a = add i64 %52, %51
    %b = add i64 %50, %a
    ret i64 %b
}

func @udiv_1(%v: i64) i64 {
entry:
    %56 = lshr i64 %v, 2
    ret i64 %56
}

func @urem_1(%v: i64) i64 {
entry:
    ret i64 0
}

func @smin_same(%v: i64) i64 {
entry:
    %c = add i64 %v, %v
    ret i64 %c
}

func @lex_chain(%a: i64, %b: i64, %c: i64) i64 {
entry:
    %x = add i64 %b, 4
    %y = add i64 %a, %x
    %z = add i64 %c, %y
    ret i64 %z
}

func @ext_chain(%x: i32) i64 {
entry:
    %a = sext i32 %x to i64
    ret i64 %a
}
