; ---- module ----

module "mergefunc"

; ---- funcs ----

define func @sq1(%0: i64) i64 {

entry:
    %1 = mul i64 %0, %0
    ret i64 %1

}

define func @sq2(%0: i64) i64 {

entry:
    %1 = mul i64 %0, %0
    ret i64 %1

}

define func @cube1(%0: i64) i64 {

entry:
    %1 = mul i64 %0, %0
    %2 = mul i64 %1, %0
    ret i64 %2

}

define func @cube2(%0: i64) i64 {

entry:
    %1 = mul i64 %0, %0
    %2 = mul i64 %1, %0
    ret i64 %2

}

define func @use() i64 {

entry:
    %0 = call i64 @sq1(i64 3)
    %1 = call i64 @sq2(i64 3)
    %2 = call i64 @cube1(i64 3)
    %3 = call i64 @cube2(i64 3)
    %4 = add i64 %0, %1
    %5 = add i64 %2, %3
    %6 = add i64 %4, %5
    ret i64 %6

}
