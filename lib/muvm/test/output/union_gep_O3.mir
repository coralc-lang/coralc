; ---- module ----

module "uniongep"

; ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @S = struct { f0: i32, f1: union @U };

; ---- funcs ----

define func @main() i32 !argmemonly {

entry:
    %0 = alloca union @U
    %1 = gep %0, 2
    store i64 42, %1
    %2 = load i32 %0
    %3 = alloca struct @S
    %4 = gep %3, 1
    %5 = gep %4, 1
    %6 = load f64 %5
    %7 = fcmp olt f64 %6, 1.0
    %8 = zext i1 %7 to i32
    %9 = add i32 %2, %8
    ret i32 %9

}
