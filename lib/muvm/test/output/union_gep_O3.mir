// ---- module ----

module "uniongep"

// ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @S = struct { f0: i32, f1: union @U };

// ---- funcs ----

func @main() i32 {
entry:
    %u = alloca union @U
    %g2 = gep %u, 2
    store i64 42, %g2
    %v = load i32 %u
    %s = alloca struct @S
    %sg = gep %s, 1
    %ug = gep %sg, 1
    %d = load f64 %ug
    %c = fcmp olt f64 %d, 1.0
    %i = zext i1 %c to i32
    %r2 = add i32 %v, %i
    ret i32 %r2
}
