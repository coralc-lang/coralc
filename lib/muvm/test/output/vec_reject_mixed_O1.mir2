// ---- module ----

module "vec_reject_mixed"

// ---- funcs ----

func @f() i64 !argmemonly {

entry:
    %0 = alloca array i64 16
    %1 = alloca array i32 16
    %2 = alloca array i64 16
    %3 = alloca array i32 16
    br loop

loop:
    %4 = phi i64 [0, entry], [%12, body]
    %5 = icmp slt i64 %4, 16
    cond_br %5, body, done

done:
    ret i64 0

body:
    %6  = gep %0, %4
    %7  = load i64 %6
    %8  = gep %2, %4
    store i64 %7, %8
    %9  = gep %1, %4
    %10 = load i32 %9
    %11 = gep %3, %4
    store i32 %10, %11
    %12 = add i64 %4, 1
    br loop

}
