// ---- module ----

module "vec_reject_nonconst"

// ---- funcs ----

func @f(%0: i64) i64 {
entry:
    %1 = alloca array i64 16
    %2 = alloca array i64 16
    %3 = gep %1, 0
    %4 = gep %2, 0
    br loop

loop:
    %5 = phi i64 [0, entry], [%10, body]
    %6 = phi ptr i64 [%3, entry], [%11, body]
    %7 = phi ptr i64 [%4, entry], [%12, body]
    %8 = icmp slt i64 %5, %0
    cond_br %8, body, done

done:
    ret i64 0

body:
    %9 = load i64 %6
    store i64 %9, %7
    %10 = add i64 %5, 1
    %11 = gep %6, 8
    %12 = gep %7, 8
    br loop
}
