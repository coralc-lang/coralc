// ---- module ----

module "vec_broadcast"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 16
    %1 = alloca array i64 16
    br loop

loop:
    %2 = phi i64 [0, entry], [%8, body]
    %3 = icmp slt i64 %2, 16
    cond_br %3, body, done

done:
    ret i64 0

body:
    %4 = gep %0, %2
    %5 = load i64 %4
    %6 = mul i64 %5, 3
    %7 = gep %1, %2
    store i64 %6, %7
    %8 = add i64 %2, 1
    br loop
}
