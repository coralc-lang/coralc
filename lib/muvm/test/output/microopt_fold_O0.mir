// ---- module ----

module "microopt_fold"

// ---- funcs ----

func @udiv3(%x: i32) i32 {
entry:
    %q = udiv i32 %x, 3
    ret i32 %q
}

func @urem7(%x: i32) i32 {
entry:
    %r = urem i32 %x, 7
    ret i32 %r
}

func @sdiv3(%x: i32) i32 {
entry:
    %q = sdiv i32 %x, 3
    ret i32 %q
}

func @srem_neg7(%x: i32) i32 {
entry:
    %r = srem i32 %x, -7
    ret i32 %r
}

func @udiv10_i64(%x: i64) i64 {
entry:
    %q = udiv i64 %x, 10
    ret i64 %q
}

func @sdiv7_i64(%x: i64) i64 {
entry:
    %q = sdiv i64 %x, 7
    ret i64 %q
}

func @urem3_i16(%x: i16) i16 {
entry:
    %r = urem i16 %x, 3
    ret i16 %r
}

func @sdiv3_i16(%x: i16) i16 {
entry:
    %q = sdiv i16 %x, 3
    ret i16 %q
}

func @udiv4_pow2(%x: i32) i32 {
entry:
    %q = udiv i32 %x, 4
    ret i32 %q
}

func @rotl32(%x: i32) i32 {
entry:
    %l = shl i32 %x, 5
    %r = lshr i32 %x, 27
    %o = or i32 %l, %r
    ret i32 %o
}

func @rotr64(%x: i64) i64 {
entry:
    %l = lshr i64 %x, 13
    %r = shl i64 %x, 51
    %o = or i64 %l, %r
    ret i64 %o
}

func @not_rotate(%x: i32) i32 {
entry:
    %l = shl i32 %x, 5
    %r = lshr i32 %x, 26
    %o = or i32 %l, %r
    ret i32 %o
}

func @load_le32(%p: ptr) i32 {
entry:
    %p0 = gep %p, 0
    %p1 = gep %p, 1
    %p2 = gep %p, 2
    %p3 = gep %p, 3
    %b0 = load i8 %p0
    %b1 = load i8 %p1
    %b2 = load i8 %p2
    %b3 = load i8 %p3
    %e0 = zext i8 %b0 to i32
    %e1 = zext i8 %b1 to i32
    %e2 = zext i8 %b2 to i32
    %e3 = zext i8 %b3 to i32
    %s1 = shl i32 %e1, 8
    %s2 = shl i32 %e2, 16
    %s3 = shl i32 %e3, 24
    %o0 = or i32 %e0, %s1
    %o1 = or i32 %o0, %s2
    %o2 = or i32 %o1, %s3
    ret i32 %o2
}

func @load_be16(%p: ptr) i16 {
entry:
    %p0 = gep %p, 0
    %p1 = gep %p, 1
    %b0 = load i8 %p0
    %b1 = load i8 %p1
    %e0 = zext i8 %b0 to i16
    %e1 = zext i8 %b1 to i16
    %s0 = shl i16 %e0, 8
    %o = or i16 %s0, %e1
    ret i16 %o
}

func @load_gap(%p: ptr) i32 {
entry:
    %p0 = gep %p, 0
    %p1 = gep %p, 1
    %p2 = gep %p, 2
    %p3 = gep %p, 3
    %b0 = load i8 %p0
    store i8 0, %p1
    %b1 = load i8 %p1
    %b2 = load i8 %p2
    %b3 = load i8 %p3
    %e0 = zext i8 %b0 to i32
    %e1 = zext i8 %b1 to i32
    %e2 = zext i8 %b2 to i32
    %e3 = zext i8 %b3 to i32
    %s1 = shl i32 %e1, 8
    %s2 = shl i32 %e2, 16
    %s3 = shl i32 %e3, 24
    %o0 = or i32 %e0, %s1
    %o1 = or i32 %o0, %s2
    %o2 = or i32 %o1, %s3
    ret i32 %o2
}
