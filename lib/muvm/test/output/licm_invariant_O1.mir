// ---- module ----

module "licmparam"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = call i64 @invariant_square(i64 6)
    %1 = trunc i64 %0 to i32
    ret i32 %1
}

func @invariant_square(%0: i64) i64 {
entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%5, body]
    %2 = phi i64 [0, entry], [%6, body]
    %3 = icmp slt i64 %1, 7
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = mul i64 %0, %0
    %5 = add i64 %1, 1
    %6 = add i64 %2, %4
    br loop
}
