// ---- module ----

module "branchprop_demo"

// ---- funcs ----

func @use_in_taken(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, taken, else

else:
    ret i64 0

taken:
    ret i64 7
}

func @use_in_else(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, then, else

else:
    ret i64 99

then:
    ret i64 1
}

func @use_both_after(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, then, else

else:
    br else

then:
    br then
}
