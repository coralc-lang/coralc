; ---- module ----

module "dist_swap"

; ---- funcs ----

define func @main() i32 !argmemonly !writeonly {

entry:
    %0 = alloca array i64 3
    %1 = alloca array i64 3
    %2 = alloca array i64 3
    %3 = alloca array i64 3
    %4 = gep %0, 1
    %5 = gep %1, 1
    store i64 10, %1
    store i64 1, %0
    store i64 20, %5
    store i64 2, %4
    store i64 11, %2
    %6 = gep %2, 1
    store i64 12, %6
    store i64 30, %3
    %7 = gep %3, 1
    store i64 40, %7
    ret i32 54

}
