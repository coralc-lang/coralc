// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 3
    %1 = alloca array i64 3
    %2 = alloca array i64 3
    %3 = alloca array i64 3
    store i64 10, %0
    %4 = gep %0, 1
    store i64 20, %4
    store i64 1, %1
    %5 = gep %1, 1
    store i64 2, %5
    %6 = gep %0, 0
    %7 = gep %1, 0
    %8 = load vector i64 2 %6
    %9 = extractelement vector i64 2 %8, 0
    %10 = load i64 %7
    store i64 %9, %7
    store i64 %10, %6
    %11 = gep %6, 8
    %12 = gep %7, 8
    %13 = load i64 %11
    %14 = load i64 %12
    store i64 %13, %12
    store i64 %14, %11
    %15 = gep %2, 0
    %16 = load i64 %6
    %17 = add i64 %16, 10
    store i64 %17, %15
    %18 = gep %15, 8
    %19 = add i64 %14, 10
    store i64 %19, %18
    %20 = gep %1, 0
    %21 = gep %3, 0
    %22 = load i64 %20
    %23 = add i64 %22, 20
    store i64 %23, %21
    %24 = gep %20, 8
    %25 = gep %21, 8
    %26 = load i64 %24
    %27 = add i64 %26, 20
    store i64 %27, %25
    %28 = extractelement vector i64 2 %8, 1
    %29 = gep %2, 1
    %30 = load i64 %29
    %31 = gep %3, 1
    %32 = load i64 %31
    %33 = add i64 %28, %30
    %34 = add i64 %32, %33
    %35 = trunc i64 %34 to i32
    ret i32 %35
}
