; ---- module ----

module "sized_clobber"

; ---- funcs ----

define func @fwd(%0: i64) i64 {

entry:
    %1 = alloca array i32 2
    %2 = gep %1, 0
    store i32 10, %2
    %3 = gep %1, 1
    store i32 20, %3
    %4 = load i32 %2
    %5 = zext i32 %4 to i64
    ret i64 %5

}

define func @dead(%0: i64) i64 {

entry:
    %1 = alloca array i32 2
    %2 = gep %1, 0
    store i32 10, %2
    %3 = gep %1, 1
    %4 = load i32 %3
    %5 = gep %1, 0
    store i32 99, %5
    %6 = zext i32 %4 to i64
    ret i64 %6

}

define func @overlap(%0: i64) i64 {

entry:
    %1 = alloca array i64 1
    %2 = gep %1, 0
    store i64 1234605616436508552, %2
    %3 = gep %1, 0
    %4 = load i32 %3
    %5 = zext i32 %4 to i64
    ret i64 %5

}
