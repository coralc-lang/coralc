    store vector i64 2 %3, %66
    %67 = vbroadcast vector i64 2 3
    br loop

loop:
    %68 = phi i64 [0, entry], [%78, body]
    %69 = icmp slt i64 %68, 128
    cond_br %69, body, done

done:
    %70 = load i64 %2
    %71 = gep %2, 127
    %72 = load i64 %71
    %73 = add i64 %70, %72
    ret i64 %73

body:
    %74 = gep %1, %68
    %75 = load vector i64 2 %74
    %76 = vmul vector i64 2 %75, %67
    %77 = gep %2, %68
    store vector i64 2 %76, %77
    %78 = add i64 %68, 2
    br loop
