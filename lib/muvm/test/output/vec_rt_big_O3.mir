// ---- module ----

module "vec_rt_big"

// ---- funcs ----

func @f(%0: i64) i64 {
entry:
    %1 = alloca array i64 128
    %2 = alloca array i64 128
    %3 = vbroadcast vector i64 2 %0
    store vector i64 2 %3, %1
    %4 = gep %1, 2
    store vector i64 2 %3, %4
