; ---- module ----

module "select_sidefx"

; ---- funcs ----

define func @fa() i64 {

entry:
    ret i64 11

}

define func @fb() i64 {

entry:
    ret i64 22

}

define func @pick(%0: i1) i64 {

entry:
    %1 = call i64 @fa()
    %2 = call i64 @fb()
    %3 = select i1 %0, i64 %1, i64 %2
    ret i64 %3

}
