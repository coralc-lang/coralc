// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {

entry:
    %0  = alloca array i64 3
    %1  = alloca array i64 3
    %2  = alloca array i64 3
    %3  = alloca array i64 3
    store i64 10, %0
    %4  = gep %0, 1
    store i64 20, %4
    store i64 1, %1
    %5  = gep %1, 1
    store i64 2, %5
    %6  = load vector i64 2 %0
    %7  = load vector i64 2 %1
    store vector i64 2 %6, %1
    store vector i64 2 %7, %0
    %8  = extractelement vector i64 2 %7, 1
    %9  = extractelement vector i64 2 %7, 0
    %10 = add i64 %9, 10
    store i64 %10, %2
    %11 = add i64 %8, 10
    %12 = gep %2, 1
    store i64 %11, %12
    %13 = vbroadcast vector i64 2 20
    %14 = vadd vector i64 2 %6, %13
    store vector i64 2 %14, %3
    %15 = extractelement vector i64 2 %14, 1
    %16 = extractelement vector i64 2 %7, 1
    %17 = add i64 %11, %16
    %18 = add i64 %17, %15
    %19 = trunc i64 %18 to i32
    ret i32 %19

}
