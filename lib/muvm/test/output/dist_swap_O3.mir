// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 3
    %brr = alloca array i64 3
    %crr = alloca array i64 3
    %drr = alloca array i64 3
    store i64 10, %arr
    %s1 = gep %arr, 1
    store i64 20, %s1
    store i64 1, %brr
    %t1 = gep %brr, 1
    store i64 2, %t1
    %181 = load vector i64 2 %arr
    %182 = load vector i64 2 %brr
    store vector i64 2 %181, %brr
    store vector i64 2 %182, %arr
    %195 = extractelement vector i64 2 %182, 1
    %194 = extractelement vector i64 2 %182, 0
    %130 = add i64 %194, 10
    store i64 %130, %crr
    %140 = add i64 %195, 10
    %141 = gep %crr, 1
    store i64 %140, %141
    %185 = vbroadcast vector i64 2 20
    %186 = vadd vector i64 2 %181, %185
    store vector i64 2 %186, %drr
    %191 = extractelement vector i64 2 %186, 1
    %192 = extractelement vector i64 2 %182, 1
    %x1 = add i64 %140, %192
    %res = add i64 %x1, %191
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
