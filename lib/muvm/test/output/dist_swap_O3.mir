// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 3
    %brr = alloca array i64 3
    %crr = alloca array i64 3
    %drr = alloca array i64 3
    store i64 10, %arr
    %s1 = gep %arr, 1
    store i64 20, %s1
    store i64 1, %brr
    %t1 = gep %brr, 1
    store i64 2, %t1
    %138 = load vector i64 2 %arr
    %139 = load vector i64 2 %brr
    store vector i64 2 %138, %brr
    store vector i64 2 %139, %arr
    %152 = extractelement vector i64 2 %139, 1
    %151 = extractelement vector i64 2 %139, 0
    %106 = add i64 %151, 10
    store i64 %106, %crr
    %142 = vbroadcast vector i64 2 20
    %143 = vadd vector i64 2 %138, %142
    store vector i64 2 %143, %drr
    %121 = add i64 %152, 10
    %122 = gep %crr, 1
    store i64 %121, %122
    %148 = extractelement vector i64 2 %143, 1
    %149 = extractelement vector i64 2 %139, 1
    %x1 = add i64 %121, %149
    %res = add i64 %x1, %148
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
