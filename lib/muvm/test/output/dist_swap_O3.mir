// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 3
    %brr = alloca array i64 3
    %crr = alloca array i64 3
    %drr = alloca array i64 3
    store i64 10, %arr
    %s1 = gep %arr, 1
    store i64 20, %s1
    store i64 1, %brr
    %t1 = gep %brr, 1
    store i64 2, %t1
    %160 = load vector i64 2 %arr
    %161 = load vector i64 2 %brr
    store vector i64 2 %160, %brr
    store vector i64 2 %161, %arr
    %174 = extractelement vector i64 2 %161, 1
    %173 = extractelement vector i64 2 %161, 0
    %125 = add i64 %173, 10
    store i64 %125, %crr
    %164 = vbroadcast vector i64 2 20
    %165 = vadd vector i64 2 %160, %164
    store vector i64 2 %165, %drr
    %142 = add i64 %174, 10
    %143 = gep %crr, 1
    store i64 %142, %143
    %170 = extractelement vector i64 2 %165, 1
    %171 = extractelement vector i64 2 %161, 1
    %x1 = add i64 %142, %171
    %res = add i64 %x1, %170
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
