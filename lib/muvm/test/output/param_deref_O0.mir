; ---- module ----

module "param_deref"

; ---- funcs ----

define func @sum(%0: ptr !dereferenceable(8), %1: i64) i64 {

entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, body]
    %3 = phi i64 [0, entry], [%6, body]
    %4 = icmp slt i64 %2, %1
    cond_br %4, body, done

done:
    ret i64 %3

body:
    %5 = load i64 %0
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    br loop

}

define func @sumnd(%0: ptr, %1: i64) i64 {

entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, body]
    %3 = phi i64 [0, entry], [%6, body]
    %4 = icmp slt i64 %2, %1
    cond_br %4, body, done

done:
    ret i64 %3

body:
    %5 = load i64 %0
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    br loop

}
