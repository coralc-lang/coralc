; ---- module ----

module "atomic_ops"

; ---- funcs ----

define func @main() i32 !argmemonly {

entry:
    %0 = alloca i64
    store i64 5, %0
    %1 = atomic_rmw add i64 %0, 6, seq_cst
    %2 = load i64 %0
    %3 = trunc i64 %2 to i32
    %4 = trunc i64 %1 to i32
    %5 = add i32 %3, %4
    %6 = sub i32 %5, 6
    ret i32 %6

}
