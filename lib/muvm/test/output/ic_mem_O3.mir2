// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    %1 = gep %0, 0
    %2 = gep %0, 4
    %3 = gep %0, 8
    br unroll

unroll:
    %4 = phi i64 [0, entry], [%6, unroll]
    %5 = phi ptr i64 [%1, entry], [%7, unroll]
    store i64 %4, %5
    %6 = add i64 %4, 1
    %7 = gep %5, 8
    %8 = icmp slt i64 %6, 4
    cond_br %8, unroll, unroll.1

unroll.1:
    %9 = phi i64 [0, unroll], [%12, unroll.1]
    %10 = phi i64 [4, unroll], [%13, unroll.1]
    %11 = phi ptr i64 [%2, unroll], [%14, unroll.1]
    store i64 %10, %11
    %12 = add i64 %9, 1
    %13 = add i64 %10, 1
    %14 = gep %11, 8
    %15 = icmp slt i64 %12, 4
    cond_br %15, unroll.1, unroll.2

unroll.2:
    %16 = phi i64 [0, unroll.1], [%19, unroll.2]
    %17 = phi i64 [8, unroll.1], [%20, unroll.2]
    %18 = phi ptr i64 [%3, unroll.1], [%21, unroll.2]
    store i64 %17, %18
    %19 = add i64 %16, 1
    %20 = add i64 %17, 1
    %21 = gep %18, 8
    %22 = icmp slt i64 %19, 4
    cond_br %22, unroll.2, unroll.3

unroll.3:
    %23 = load vector i64 2 %0
    %24 = extractelement vector i64 2 %23, 0
    %25 = extractelement vector i64 2 %23, 1
    %26 = gep %0, 2
    %27 = load vector i64 2 %26
    %28 = extractelement vector i64 2 %27, 0
    %29 = extractelement vector i64 2 %27, 1
    %30 = gep %0, 4
    %31 = load vector i64 2 %30
    %32 = extractelement vector i64 2 %31, 0
    %33 = extractelement vector i64 2 %31, 1
    %34 = gep %0, 6
    %35 = load vector i64 2 %34
    %36 = extractelement vector i64 2 %35, 0
    %37 = extractelement vector i64 2 %35, 1
    %38 = gep %0, 8
    %39 = load vector i64 2 %38
    %40 = extractelement vector i64 2 %39, 0
    %41 = extractelement vector i64 2 %39, 1
    %42 = gep %0, 10
    %43 = load vector i64 2 %42
    %44 = extractelement vector i64 2 %43, 0
    %45 = extractelement vector i64 2 %43, 1
    %46 = add i64 %24, %25
    %47 = add i64 %28, %29
    %48 = add i64 %32, %33
    %49 = add i64 %36, %37
    %50 = add i64 %40, %41
    %51 = add i64 %44, %45
    %52 = add i64 %46, %47
    %53 = add i64 %48, %49
    %54 = add i64 %50, %51
    %55 = add i64 %52, %53
    %56 = add i64 %54, %55
    %57 = trunc i64 %56 to i32
    ret i32 %57
}
