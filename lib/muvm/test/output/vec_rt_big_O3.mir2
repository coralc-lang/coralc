// ---- module ----

module "vec_rt_big"

// ---- funcs ----

func @f(%arg: i64) i64 {
entry:
    %a = alloca array i64 128
    %c = alloca array i64 128
    %420 = vbroadcast vector i64 2 %arg
    store vector i64 2 %420, %a
    %g2 = gep %a, 2
    store vector i64 2 %420, %g2
    %g4 = gep %a, 4
    store vector i64 2 %420, %g4
    %g6 = gep %a, 6
    store vector i64 2 %420, %g6
    %g8 = gep %a, 8
    store vector i64 2 %420, %g8
    %g10 = gep %a, 10
    store vector i64 2 %420, %g10
    %g12 = gep %a, 12
    store vector i64 2 %420, %g12
    %g14 = gep %a, 14
    store vector i64 2 %420, %g14
    %g16 = gep %a, 16
    store vector i64 2 %420, %g16
    %g18 = gep %a, 18
    store vector i64 2 %420, %g18
    %g20 = gep %a, 20
    store vector i64 2 %420, %g20
    %g22 = gep %a, 22
    store vector i64 2 %420, %g22
    %g24 = gep %a, 24
    store vector i64 2 %420, %g24
    %g26 = gep %a, 26
    store vector i64 2 %420, %g26
    %g28 = gep %a, 28
    store vector i64 2 %420, %g28
    %g30 = gep %a, 30
    store vector i64 2 %420, %g30
    %g32 = gep %a, 32
    store vector i64 2 %420, %g32
    %g34 = gep %a, 34
    store vector i64 2 %420, %g34
    %g36 = gep %a, 36
    store vector i64 2 %420, %g36
    %g38 = gep %a, 38
    store vector i64 2 %420, %g38
    %g40 = gep %a, 40
    store vector i64 2 %420, %g40
    %g42 = gep %a, 42
    store vector i64 2 %420, %g42
    %g44 = gep %a, 44
    store vector i64 2 %420, %g44
    %g46 = gep %a, 46
    store vector i64 2 %420, %g46
    %g48 = gep %a, 48
    store vector i64 2 %420, %g48
    %g50 = gep %a, 50
    store vector i64 2 %420, %g50
    %g52 = gep %a, 52
    store vector i64 2 %420, %g52
    %g54 = gep %a, 54
    store vector i64 2 %420, %g54
    %g56 = gep %a, 56
    store vector i64 2 %420, %g56
    %g58 = gep %a, 58
    store vector i64 2 %420, %g58
    %g60 = gep %a, 60
    store vector i64 2 %420, %g60
    %g62 = gep %a, 62
    store vector i64 2 %420, %g62
    %g64 = gep %a, 64
    store vector i64 2 %420, %g64
    %g66 = gep %a, 66
    store vector i64 2 %420, %g66
    %g68 = gep %a, 68
    store vector i64 2 %420, %g68
    %g70 = gep %a, 70
    store vector i64 2 %420, %g70
    %g72 = gep %a, 72
    store vector i64 2 %420, %g72
    %g74 = gep %a, 74
    store vector i64 2 %420, %g74
    %g76 = gep %a, 76
    store vector i64 2 %420, %g76
    %g78 = gep %a, 78
    store vector i64 2 %420, %g78
    %g80 = gep %a, 80
    store vector i64 2 %420, %g80
    %g82 = gep %a, 82
    store vector i64 2 %420, %g82
    %g84 = gep %a, 84
    store vector i64 2 %420, %g84
    %g86 = gep %a, 86
    store vector i64 2 %420, %g86
    %g88 = gep %a, 88
    store vector i64 2 %420, %g88
    %g90 = gep %a, 90
    store vector i64 2 %420, %g90
    %g92 = gep %a, 92
    store vector i64 2 %420, %g92
    %g94 = gep %a, 94
    store vector i64 2 %420, %g94
    %g96 = gep %a, 96
    store vector i64 2 %420, %g96
    %g98 = gep %a, 98
    store vector i64 2 %420, %g98
    %g100 = gep %a, 100
    store vector i64 2 %420, %g100
    %g102 = gep %a, 102
    store vector i64 2 %420, %g102
    %g104 = gep %a, 104
    store vector i64 2 %420, %g104
    %g106 = gep %a, 106
    store vector i64 2 %420, %g106
    %g108 = gep %a, 108
    store vector i64 2 %420, %g108
    %g110 = gep %a, 110
    store vector i64 2 %420, %g110
    %g112 = gep %a, 112
    store vector i64 2 %420, %g112
    %g114 = gep %a, 114
    store vector i64 2 %420, %g114
    %g116 = gep %a, 116
    store vector i64 2 %420, %g116
    %g118 = gep %a, 118
    store vector i64 2 %420, %g118
    %g120 = gep %a, 120
    store vector i64 2 %420, %g120
    %g122 = gep %a, 122
    store vector i64 2 %420, %g122
    %g124 = gep %a, 124
    store vector i64 2 %420, %g124
    %g126 = gep %a, 126
    store vector i64 2 %420, %g126
    %418 = vbroadcast vector i64 2 3
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 128
    cond_br %iv, body, done

done:
    %r0 = load i64 %c
    %hL = gep %c, 127
    %rL = load i64 %hL
    %sum = add i64 %r0, %rL
    ret i64 %sum

body:
    %ga = gep %a, %i
    %416 = load vector i64 2 %ga
    %417 = vmul vector i64 2 %416, %418
    %gc = gep %c, %i
    store vector i64 2 %417, %gc
    %in = add i64 %i, 2
    br loop
}
