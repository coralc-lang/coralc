// ---- module ----

module "unswitch"

// ---- funcs ----

func @pos(%0: i32, %1: i64) i64 !readnone {

entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, work]
    %3 = icmp slt i64 %2, %1
    cond_br %3, body, done

body:
    %4 = icmp ne i32 %0, 0
    cond_br %4, work, bail

bail:
    %5 = mul i64 %2, 3
    br done

done:
    %6 = phi i64 [%2, loop], [%5, bail]
    ret i64 %6

work:
    %7 = add i64 %2, 1
    br loop

}

func @posarg(%0: i32, %1: i64) i64 !readnone {

entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%6, work]
    %3 = icmp slt i64 %2, %1
    cond_br %3, body, done

body:
    cond_br %0, work, bail

bail:
    %4 = mul i64 %2, 5
    br done

done:
    %5 = phi i64 [%2, loop], [%4, bail]
    ret i64 %5

work:
    %6 = add i64 %2, 1
    br loop

}

func @neg(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%6, work]
    %2 = icmp slt i64 %1, %0
    cond_br %2, body, done

body:
    %3 = icmp slt i64 %1, 10
    cond_br %3, work, bail

bail:
    %4 = mul i64 %1, 3
    br done

done:
    %5 = phi i64 [%1, loop], [%4, bail]
    ret i64 %5

work:
    %6 = add i64 %1, 1
    br loop

}
