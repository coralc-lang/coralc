// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 3
    %1 = alloca array i64 3
    %2 = alloca array i64 3
    %3 = alloca array i64 3
    store i64 10, %0
    %4 = gep %0, 1
    store i64 20, %4
    store i64 1, %1
    %5 = gep %1, 1
    store i64 2, %5
    %6 = gep %0, 0
    %7 = gep %1, 0
    %8 = load vector i64 2 %6
    %9 = extractelement vector i64 2 %8, 0
    %10 = load i64 %7
    store i64 %9, %7
    store i64 %10, %6
    %11 = gep %6, 8
    %12 = gep %7, 8
    %13 = load i64 %11
    %14 = load i64 %12
    store i64 %13, %12
    store i64 %14, %11
    %15 = gep %2, 0
    %16 = gep %3, 0
    %17 = load i64 %6
    %18 = add i64 %17, 10
    store i64 %18, %15
    %19 = load i64 %7
    %20 = add i64 %19, 20
    store i64 %20, %16
    %21 = gep %6, 8
    %22 = gep %15, 8
    %23 = gep %7, 8
    %24 = gep %16, 8
    %25 = load i64 %21
    %26 = add i64 %25, 10
    store i64 %26, %22
    %27 = load i64 %23
    %28 = add i64 %27, 20
    store i64 %28, %24
    %29 = extractelement vector i64 2 %8, 1
    %30 = gep %2, 1
    %31 = load i64 %30
    %32 = gep %3, 1
    %33 = load i64 %32
    %34 = add i64 %29, %31
    %35 = add i64 %33, %34
    %36 = trunc i64 %35 to i32
    ret i32 %36
}
