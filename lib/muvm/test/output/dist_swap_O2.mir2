// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 3
    %brr = alloca array i64 3
    %crr = alloca array i64 3
    %drr = alloca array i64 3
    store i64 10, %arr
    %s1 = gep %arr, 1
    store i64 20, %s1
    store i64 1, %brr
    %t1 = gep %brr, 1
    store i64 2, %t1
    %78 = load i64 %arr
    %79 = load i64 %brr
    store i64 %78, %brr
    store i64 %79, %arr
    %89 = load i64 %s1
    %90 = load i64 %t1
    store i64 %89, %t1
    store i64 %90, %s1
    %105 = load i64 %arr
    %106 = add i64 %105, 10
    store i64 %106, %crr
    %110 = load i64 %brr
    %111 = add i64 %110, 20
    store i64 %111, %drr
    %120 = load i64 %s1
    %121 = add i64 %120, 10
    %122 = gep %crr, 1
    store i64 %121, %122
    %125 = load i64 %t1
    %126 = add i64 %125, 20
    %127 = gep %drr, 1
    store i64 %126, %127
    %rav = load i64 %s1
    %rcv = load i64 %122
    %x1 = add i64 %rav, %rcv
    %res = add i64 %126, %x1
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
