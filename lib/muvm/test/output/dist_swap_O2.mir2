// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 3
    %1 = alloca array i64 3
    %2 = alloca array i64 3
    %3 = alloca array i64 3
    store i64 10, %0
    %4 = gep %0, 1
    store i64 20, %4
    store i64 1, %1
    %5 = gep %1, 1
    store i64 2, %5
    %6 = load vector i64 2 %0
    %7 = load vector i64 2 %1
    store vector i64 2 %6, %1
    store vector i64 2 %7, %0
    %8 = extractelement vector i64 2 %7, 1
    %9 = extractelement vector i64 2 %7, 0
    %10 = add i64 %9, 10
    store i64 %10, %2
    %11 = vbroadcast vector i64 2 20
    %12 = vadd vector i64 2 %6, %11
    store vector i64 2 %12, %3
    %13 = add i64 %8, 10
    %14 = gep %2, 1
    store i64 %13, %14
    %15 = extractelement vector i64 2 %12, 1
    %16 = extractelement vector i64 2 %7, 1
    %17 = add i64 %13, %16
    %18 = add i64 %15, %17
    %19 = trunc i64 %18 to i32
    ret i32 %19
}
