// ---- module ----

module "traildup"

// ---- funcs ----

func @dup_test(%x: i64, %y: i64) i64 {
entry:
    %cmp = icmp sgt i64 %x, 5
    cond_br %cmp, px, py

py:
    %s = sub i64 0, %y
    ret i64 %s

px:
    %24 = shl i64 %x, 1
    ret i64 %24
}

func @main() i32 {
entry:
    %r = call i64 @dup_test(i64 7, i64 3)
    %t = trunc i64 %r to i32
    ret i32 %t
}
