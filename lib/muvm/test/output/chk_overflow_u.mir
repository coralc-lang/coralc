// ---- module ----

module "overflow_u"

// ---- strings ----

string @.Lcs11: "main";

string @.Lcs12: "?";

string @.Lcs20: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %0 = add i32 -1, 0
    %1 = xor i32 -1, %0 !loc = "?", 0, 0
    %2 = xor i32 0, %0 !loc = "?", 0, 0
    %3 = and i32 %1, %2 !loc = "?", 0, 0
    %4 = ashr i32 %3, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %4, i64 0, array i8 2 @.Lcs12, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    %5 = add.u i32 %0, 1
    %6 = icmp ult i32 %5, %0 !loc = "?", 0, 0
    %7 = select i1 %6, i32 1, i32 0 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %7, i64 0, array i8 2 @.Lcs20, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    ret i32 %5
}

func @_trap() extern;
