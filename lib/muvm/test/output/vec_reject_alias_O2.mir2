// ---- module ----

module "vec_reject_alias"

// ---- funcs ----

func @f(%p: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %gp = gep %a, %p
    %257 = load vector i64 2 %a
    store vector i64 2 %257, %c
    store i64 0, %gp
    %87 = gep %a, 2
    %258 = load vector i64 2 %87
    %89 = gep %c, 2
    store vector i64 2 %258, %89
    store i64 0, %gp
    %107 = gep %a, 4
    %259 = load vector i64 2 %107
    %109 = gep %c, 4
    store vector i64 2 %259, %109
    store i64 0, %gp
    %127 = gep %a, 6
    %260 = load vector i64 2 %127
    %129 = gep %c, 6
    store vector i64 2 %260, %129
    store i64 0, %gp
    %147 = gep %a, 8
    %261 = load vector i64 2 %147
    %149 = gep %c, 8
    store vector i64 2 %261, %149
    store i64 0, %gp
    %167 = gep %a, 10
    %262 = load vector i64 2 %167
    %169 = gep %c, 10
    store vector i64 2 %262, %169
    store i64 0, %gp
    %187 = gep %a, 12
    %263 = load vector i64 2 %187
    %189 = gep %c, 12
    store vector i64 2 %263, %189
    store i64 0, %gp
    %207 = gep %a, 14
    %264 = load vector i64 2 %207
    %209 = gep %c, 14
    store vector i64 2 %264, %209
    store i64 0, %gp
    ret i64 0
}
