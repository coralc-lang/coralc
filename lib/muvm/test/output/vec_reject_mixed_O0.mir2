// ---- module ----

module "vec_reject_mixed"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i32 16
    %c = alloca array i64 16
    %d = alloca array i32 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, latch ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %gc = gep %c, %i
    store i64 %la, %gc
    %gb = gep %b, %i
    %lb = load i32 %gb
    %gd = gep %d, %i
    store i32 %lb, %gd
    br latch

latch:
    %in = add i64 %i, 1
    br loop
}
