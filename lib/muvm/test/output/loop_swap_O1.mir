// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%0: i64) i64 {
entry:
    br outer

outer:
    %1 = phi i64 [0, entry], [%16, olatch]
    %2 = phi i64 [0, entry], [%8, olatch]
    %3 = phi i64 [0, entry], [%9, olatch]
    %4 = icmp slt i64 %1, 3
    cond_br %4, inner, done

done:
    %5 = mul i64 %2, 10
    %6 = add i64 %5, %1
    %7 = add i64 %6, %3
    ret i64 %7

inner:
    %8 = phi i64 [0, outer], [%14, imerge]
    %9 = phi i64 [0, outer], [%13, imerge]
    %10 = icmp eq i64 %0, 7
    cond_br %10, ithen, ielse

ielse:
    %11 = add i64 %9, 2
    br imerge

ithen:
    %12 = add i64 %9, 1
    br imerge

imerge:
    %13 = phi i64 [%12, ithen], [%11, ielse]
    %14 = add i64 %8, 1
    %15 = icmp slt i64 %14, 4
    cond_br %15, inner, olatch

olatch:
    %16 = add i64 %1, 1
    br outer
}

func @main() i32 {
entry:
    %0 = call i64 @nest(i64 7)
    %1 = trunc i64 %0 to i32
    ret i32 %1
}
