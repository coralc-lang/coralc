// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    br outer

outer:
    %i = phi i64 [ 0, entry ], [ %in, entry ]
    %jo = phi i64 [ 0, entry ], [ %j, entry ]
    %ao = phi i64 [ 0, entry ], [ %acc, entry ]
    %oc = icmp slt i64 %i, 3
    %fc = icmp eq i64 %flag, 7
    %in = add i64 %i, 1
    cond_br %oc, inner, done

done:
    %ten = mul i64 %jo, 10
    %53 = add i64 %i, %ao
    %83 = add i64 %53, %ten
    ret i64 %83

inner:
    %j = phi i64 [ 0, outer ], [ %jn, ilatch ]
    %acc = phi i64 [ 0, outer ], [ %sel, ilatch ]
    br ibody

ibody:
    %ta = add i64 %acc, 1
    %tb = add i64 %acc, 2
    cond_br %fc, imerge, imerge

imerge:
    %sel = phi i64 [ %ta, ibody ], [ %tb, ibody ]
    br ilatch

ilatch:
    %jn = add i64 %j, 1
    br inner
}

func @main() i32 {
entry:
    %r = call i64 @nest(i64 7)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
