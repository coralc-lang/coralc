// ---- module ----

module "vec_add"

// ---- funcs ----

func @f(%n: i64) i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i64 16
    %c = alloca array i64 16
    %291 = load vector i64 2 %a
    %292 = load vector i64 2 %b
    %307 = vadd vector i64 2 %291, %292
    store vector i64 2 %307, %c
    %93 = gep %a, 2
    %293 = load vector i64 2 %93
    %95 = gep %b, 2
    %294 = load vector i64 2 %95
    %308 = vadd vector i64 2 %293, %294
    %98 = gep %c, 2
    store vector i64 2 %308, %98
    %117 = gep %a, 4
    %295 = load vector i64 2 %117
    %119 = gep %b, 4
    %296 = load vector i64 2 %119
    %309 = vadd vector i64 2 %295, %296
    %122 = gep %c, 4
    store vector i64 2 %309, %122
    %141 = gep %a, 6
    %297 = load vector i64 2 %141
    %143 = gep %b, 6
    %298 = load vector i64 2 %143
    %310 = vadd vector i64 2 %297, %298
    %146 = gep %c, 6
    store vector i64 2 %310, %146
    %165 = gep %a, 8
    %299 = load vector i64 2 %165
    %167 = gep %b, 8
    %300 = load vector i64 2 %167
    %311 = vadd vector i64 2 %299, %300
    %170 = gep %c, 8
    store vector i64 2 %311, %170
    %189 = gep %a, 10
    %301 = load vector i64 2 %189
    %191 = gep %b, 10
    %302 = load vector i64 2 %191
    %312 = vadd vector i64 2 %301, %302
    %194 = gep %c, 10
    store vector i64 2 %312, %194
    %213 = gep %a, 12
    %303 = load vector i64 2 %213
    %215 = gep %b, 12
    %304 = load vector i64 2 %215
    %313 = vadd vector i64 2 %303, %304
    %218 = gep %c, 12
    store vector i64 2 %313, %218
    %237 = gep %a, 14
    %305 = load vector i64 2 %237
    %239 = gep %b, 14
    %306 = load vector i64 2 %239
    %314 = vadd vector i64 2 %305, %306
    %242 = gep %c, 14
    store vector i64 2 %314, %242
    %r = load i64 %c
    ret i64 %r
}
