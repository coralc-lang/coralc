// ---- module ----

module "loop_invariant"

// ---- funcs ----

func @main() i32 {

entry:
    br loop

loop:
    %0 = phi i64 [0, entry], [%5, body]
    %1 = phi i64 [0, entry], [%6, body]
    %2 = icmp slt i64 %1, 10
    cond_br %2, body, done

done:
    %3 = trunc i64 %0 to i32
    ret i32 %3

body:
    %4 = mul i64 3, 7
    %5 = add i64 %0, %4
    %6 = add i64 %1, 1
    br loop

}
