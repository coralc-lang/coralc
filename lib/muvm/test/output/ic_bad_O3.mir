// ---- module ----

module "ic_bad"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 12
    %82 = gep %arr, 1
    %97 = gep %arr, 2
    br unroll

unroll:
    %61 = phi i64 [ 0, entry ], [ %65, unroll ]
    %62 = load i64 %arr
    %63 = add i64 %62, 1
    store i64 %63, %arr
    %65 = add i64 %61, 1
    %66 = icmp slt i64 %65, 4
    cond_br %66, unroll, unroll.1

unroll.1:
    %76 = phi i64 [ 0, unroll ], [ %80, unroll.1 ]
    %77 = load i64 %82
    %78 = add i64 %77, 1
    store i64 %78, %82
    %80 = add i64 %76, 1
    %81 = icmp slt i64 %80, 4
    cond_br %81, unroll.1, unroll.2

unroll.2:
    %91 = phi i64 [ 0, unroll.1 ], [ %95, unroll.2 ]
    %92 = load i64 %97
    %93 = add i64 %92, 1
    store i64 %93, %97
    %95 = add i64 %91, 1
    %96 = icmp slt i64 %95, 4
    cond_br %96, unroll.2, done

done:
    ret i32 0
}
