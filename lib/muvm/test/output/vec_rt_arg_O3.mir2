// ---- module ----

module "vec_rt_arg"

// ---- funcs ----

func @f(%arg: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %290 = vbroadcast vector i64 2 %arg
    store vector i64 2 %290, %a
    %g2 = gep %a, 2
    store vector i64 2 %290, %g2
    %g4 = gep %a, 4
    store vector i64 2 %290, %g4
    %g6 = gep %a, 6
    store vector i64 2 %290, %g6
    %g8 = gep %a, 8
    store vector i64 2 %290, %g8
    %g10 = gep %a, 10
    store vector i64 2 %290, %g10
    %g12 = gep %a, 12
    store vector i64 2 %290, %g12
    %g14 = gep %a, 14
    store vector i64 2 %290, %g14
    %301 = load vector i64 2 %a
    %309 = vbroadcast vector i64 2 3
    %310 = vmul vector i64 2 %301, %309
    store vector i64 2 %310, %c
    %302 = load vector i64 2 %g2
    %311 = vmul vector i64 2 %302, %309
    %138 = gep %c, 2
    store vector i64 2 %311, %138
    %303 = load vector i64 2 %g4
    %312 = vmul vector i64 2 %303, %309
    %158 = gep %c, 4
    store vector i64 2 %312, %158
    %175 = gep %a, 6
    %304 = load vector i64 2 %175
    %313 = vmul vector i64 2 %304, %309
    %178 = gep %c, 6
    store vector i64 2 %313, %178
    %195 = gep %a, 8
    %305 = load vector i64 2 %195
    %314 = vmul vector i64 2 %305, %309
    %198 = gep %c, 8
    store vector i64 2 %314, %198
    %215 = gep %a, 10
    %306 = load vector i64 2 %215
    %315 = vmul vector i64 2 %306, %309
    %218 = gep %c, 10
    store vector i64 2 %315, %218
    %235 = gep %a, 12
    %307 = load vector i64 2 %235
    %316 = vmul vector i64 2 %307, %309
    %238 = gep %c, 12
    store vector i64 2 %316, %238
    %255 = gep %a, 14
    %308 = load vector i64 2 %255
    %317 = vmul vector i64 2 %308, %309
    %258 = gep %c, 14
    store vector i64 2 %317, %258
    %327 = extractelement vector i64 2 %317, 1
    %r0 = load i64 %c
    %sum = add i64 %327, %r0
    ret i64 %sum
}
