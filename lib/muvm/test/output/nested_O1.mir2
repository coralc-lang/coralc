// ---- module ----

module "nested"

// ---- funcs ----

func @main() i32 {

entry:
    br outer

outer:
    %0 = phi i64 [0, entry], [%5, inner_done]
    %1 = phi i64 [0, entry], [%7, inner_done]
    %2 = icmp slt i64 %1, 4
    cond_br %2, inner, done

done:
    %3 = trunc i64 %0 to i32
    ret i32 %3

inner:
    %4 = phi i64 [0, outer], [%10, inner_body]
    %5 = phi i64 [%0, outer], [%9, inner_body]
    %6 = icmp slt i64 %4, 3
    cond_br %6, inner_body, inner_done

inner_done:
    %7 = add i64 %1, 1
    br outer

inner_body:
    %8  = mul i64 %1, %4
    %9  = add i64 %5, %8
    %10 = add i64 %4, 1
    br inner

}
