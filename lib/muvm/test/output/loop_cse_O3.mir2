// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @lc_invariant(%n: i64) i64 {
entry:
    %arr = alloca array i64 4
    store i64 30, %arr
    %p1 = gep %arr, 1
    store i64 40, %p1
    %p2 = gep %arr, 2
    store i64 50, %p2
    %p3 = gep %arr, 3
    store i64 60, %p3
    %v = load i64 %arr
    %use = add i64 %v, 7
    %use2 = mul i64 %use, 3
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, loop ]
    %ac = phi i64 [ 0, entry ], [ %nac, loop ]
    %nac = add i64 %use2, %ac
    %in = add i64 %i, 1
    %cmp = icmp slt i64 %in, %n
    cond_br %cmp, loop, done

done:
    ret i64 %nac
}
