; ---- module ----

module "uniongep"

; ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @S = struct { f0: i32, f1: union @U };

; ---- funcs ----

define func @main() i32 !argmemonly {

entry:
    %0  = alloca union @U
    %1  = gep %0, 0
    %2  = gep %0, 2
    %3  = bitcast ptr i32 %1 to ptr i32
    %4  = bitcast ptr i64 %2 to ptr i64
    store i64 42, %4
    %5  = load i32 %3
    %6  = alloca struct @S
    %7  = gep %6, 1
    %8  = gep %7, 1
    %9  = bitcast ptr f64 %8 to ptr f64
    %10 = load f64 %9
    %11 = fcmp olt f64 %10, 1.0
    %12 = zext i1 %11 to i32
    %13 = add i32 %5, %12
    ret i32 %13

}
