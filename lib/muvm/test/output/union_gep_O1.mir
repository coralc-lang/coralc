// ---- module ----

module "uniongep"

// ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @S = struct { f0: i32, f1: union @U };

// ---- funcs ----

func @main() i32 {
entry:
    %u = alloca union @U
    %g0 = gep %u, 0
    %g2 = gep %u, 2
    %p0 = bitcast ptr i32 %g0 to ptr i32
    %p2 = bitcast ptr i64 %g2 to ptr i64
    store i64 42, %p2
    %v = load i32 %p0
    %s = alloca struct @S
    %sg = gep %s, 1
    %ug = gep %sg, 1
    %r = bitcast ptr f64 %ug to ptr f64
    %d = load f64 %r
    %c = fcmp olt f64 %d, 1.0
    %i = zext i1 %c to i32
    %r2 = add i32 %v, %i
    ret i32 %r2
}
