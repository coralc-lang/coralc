// ---- module ----

module "lc_invariant2"

// ---- funcs ----

func @run(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, loop ]
    %ac = phi i64 [ 0, entry ], [ %nac, loop ]
    %nac = add i64 %ac, 212
    %in = add i64 %i, 1
    %cmp = icmp slt i64 %in, %n
    cond_br %cmp, loop, done

done:
    ret i64 %nac
}
