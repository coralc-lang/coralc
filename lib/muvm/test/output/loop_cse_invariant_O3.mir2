// ---- module ----

module "lc_invariant2"

// ---- funcs ----

func @run(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%4, loop]
    %2 = phi i64 [0, entry], [%3, loop]
    %3 = add i64 %2, 212
    %4 = add i64 %1, 1
    %5 = icmp slt i64 %4, %0
    cond_br %5, loop, done

done:
    ret i64 %3

}
