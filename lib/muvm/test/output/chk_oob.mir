// ---- module ----

module "oob"

// ---- strings ----

string @.Lcs27: "main";

string @.Lcs28: "?";

string @.Lcs30: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 5
    br loop

loop:
    %1 = phi i64 [0, entry], [%4, body]
    %2 = icmp slt i64 %1, 7
    cond_br %2, body, done

done:
    ret i32 0

body:
    call void @_trap(i64 0, i64 %1, i64 5, array i8 2 @.Lcs28, i64 0, array i8 5 @.Lcs27) !loc = "?", 0, 0
    %3 = gep %0, %1
    store i64 1, %3
    %4 = add i64 %1, 1
    %5 = xor i64 %1, %4 !loc = "?", 0, 0
    %6 = xor i64 1, %4 !loc = "?", 0, 0
    %7 = and i64 %5, %6 !loc = "?", 0, 0
    %8 = ashr i64 %7, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %8, i64 0, array i8 2 @.Lcs30, i64 0, array i8 5 @.Lcs27) !loc = "?", 0, 0
    br loop
}

func @_trap() extern;
