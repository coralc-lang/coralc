// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 12
    br unroll

unroll:
    %105 = phi i64 [ 0, entry ], [ %109, unroll ]
    %107 = gep %arr, %105
    store i64 %105, %107
    %109 = add i64 %105, 1
    %110 = icmp slt i64 %109, 4
    cond_br %110, unroll, unroll.1

unroll.1:
    %120 = phi i64 [ 0, unroll ], [ %124, unroll.1 ]
    %121 = add i64 %120, 4
    %122 = gep %arr, %121
    store i64 %121, %122
    %124 = add i64 %120, 1
    %125 = icmp slt i64 %124, 4
    cond_br %125, unroll.1, unroll.2

unroll.2:
    %135 = phi i64 [ 0, unroll.1 ], [ %139, unroll.2 ]
    %136 = add i64 %135, 8
    %137 = gep %arr, %136
    store i64 %136, %137
    %139 = add i64 %135, 1
    %140 = icmp slt i64 %139, 4
    cond_br %140, unroll.2, done

done:
    %152 = load vector i64 2 %arr
    %171 = extractelement vector i64 2 %152, 0
    %170 = extractelement vector i64 2 %152, 1
    %k2 = gep %arr, 2
    %153 = load vector i64 2 %k2
    %169 = extractelement vector i64 2 %153, 0
    %168 = extractelement vector i64 2 %153, 1
    %k4 = gep %arr, 4
    %154 = load vector i64 2 %k4
    %167 = extractelement vector i64 2 %154, 0
    %166 = extractelement vector i64 2 %154, 1
    %k6 = gep %arr, 6
    %155 = load vector i64 2 %k6
    %165 = extractelement vector i64 2 %155, 0
    %164 = extractelement vector i64 2 %155, 1
    %k8 = gep %arr, 8
    %156 = load vector i64 2 %k8
    %163 = extractelement vector i64 2 %156, 0
    %162 = extractelement vector i64 2 %156, 1
    %k10 = gep %arr, 10
    %157 = load vector i64 2 %k10
    %161 = extractelement vector i64 2 %157, 0
    %159 = extractelement vector i64 2 %157, 1
    %s01 = add i64 %170, %171
    %s23 = add i64 %168, %169
    %s45 = add i64 %166, %167
    %s67 = add i64 %164, %165
    %s89 = add i64 %162, %163
    %s1011 = add i64 %159, %161
    %s0123 = add i64 %s01, %s23
    %s4567 = add i64 %s45, %s67
    %s89a = add i64 %s89, %s1011
    %s1 = add i64 %s0123, %s4567
    %res = add i64 %s89a, %s1
    %r32 = trunc i64 %res to i32
    ret i32 %r32
}
