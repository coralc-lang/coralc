// ---- module ----

module "asm_mem"

// ---- funcs ----

func @main() i32 !argmemonly {

entry:
    %0 = alloca i64
    %1 = alloca i64
    store i64 7, %0
    inlineasm void "movq %1, %0\naddq $1, %0" : "=r,m" : "cc" (ptr i64 %1, ptr i64 %0)
    %2 = load i64 %1
    %3 = trunc i64 %2 to i32
    ret i32 %3

}
