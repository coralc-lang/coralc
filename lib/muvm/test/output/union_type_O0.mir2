// ---- module ----

module "uniontype"

// ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @V = struct { f0: i32, f1: union @U };

// ---- funcs ----

func @main() i32 {
entry:
    %u = alloca union @U
    %p = bitcast ptr union @U %u to ptr i32
    store i32 42, %p
    %q = bitcast ptr union @U %u to ptr i64
    %v = load i64 %q
    %w = lshr i64 %v, 32
    ret i32 0
}
