// ---- module ----

module "ivsr2"

// ---- funcs ----

func @affine(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%6, body]
    %2 = phi i64 [0, entry], [%5, body]
    %3 = phi i64 [7, entry], [%7, body]
    %4 = icmp slt i64 %1, %0
    cond_br %4, body, done

done:
    ret i64 %2

body:
    %5 = add i64 %2, %3
    %6 = add i64 %1, 1
    %7 = add i64 %3, 4
    br loop

}

func @ivoff(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [10, entry], [%6, body]
    %2 = phi i64 [0, entry], [%5, body]
    %3 = phi i64 [13, entry], [%7, body]
    %4 = icmp slt i64 %1, %0
    cond_br %4, body, done

done:
    ret i64 %2

body:
    %5 = add i64 %2, %3
    %6 = add i64 %1, 2
    %7 = add i64 %3, 2
    br loop

}

func @ptriv(%0: i64) i64 !readonly {

entry:
    %1 = alloca array i64 8
    %2 = gep %1, 0
    br loop

loop:
    %3 = phi i64 [0, entry], [%9, body]
    %4 = phi i64 [0, entry], [%8, body]
    %5 = phi ptr i64 [%2, entry], [%10, body]
    %6 = icmp slt i64 %3, %0
    cond_br %6, body, done

done:
    ret i64 %4

body:
    %7  = load i64 %5
    %8  = add i64 %4, %7
    %9  = add i64 %3, 1
    %10 = gep %5, 8
    br loop

}

func @ptrneg(%0: ptr, %1: i64, %2: i64) i64 !readonly {

entry:
    %3 = gep %0, %1
    br loop

loop:
    %4 = phi i64 [0, entry], [%9, body]
    %5 = phi i64 [0, entry], [%8, body]
    %6 = icmp slt i64 %4, %2
    cond_br %6, body, done

done:
    ret i64 %5

body:
    %7 = load i64 %3
    %8 = add i64 %5, %7
    %9 = add i64 %4, 1
    br loop

}
