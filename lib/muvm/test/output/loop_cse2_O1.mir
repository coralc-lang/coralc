// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca i64
    %1 = call i64 @sum_of_n(ptr i64 %0, i64 10)
    %2 = trunc i64 %1 to i32
    ret i32 %2
}

func @sum_of_n(%0: ptr, %1: i64) i64 {
entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, loop]
    %3 = phi i64 [0, entry], [%6, loop]
    %4 = gep %0, %2
    %5 = load i64 %4
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    %8 = icmp slt i64 %7, %1
    cond_br %8, loop, done

done:
    ret i64 %6
}

func @sum_no_invariant(%0: ptr, %1: i64) i64 {
entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, loop]
    %3 = phi i64 [0, entry], [%6, loop]
    %4 = gep %0, %2
    %5 = load i64 %4
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    %8 = icmp slt i64 %7, %1
    cond_br %8, loop, done

done:
    ret i64 %6
}
