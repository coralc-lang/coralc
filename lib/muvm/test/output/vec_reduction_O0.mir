// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 {

entry:
    %0 = alloca array i64 16
    br loop

loop:
    %1 = phi i64 [0, entry], [%7, latch]
    %2 = phi i64 [0, entry], [%6, latch]
    %3 = icmp slt i64 %1, 16
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = gep %0, %1
    %5 = load i64 %4
    %6 = add i64 %2, %5
    br latch

latch:
    %7 = add i64 %1, 1
    br loop

}
