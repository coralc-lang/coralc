// ---- module ----

module "divmod_pow2"

// ---- funcs ----

func @t(%0: i32) i32 !readnone {

entry:
    %1  = ashr i32 %0, 31
    %2  = and i32 %1, 7
    %3  = add i32 %0, %2
    %4  = ashr i32 %3, 3
    %5  = and i32 %3, 7
    %6  = sub i32 %5, %2
    %7  = lshr i32 %0, 4
    %8  = and i32 %0, 15
    %9  = add i32 %4, %6
    %10 = add i32 %7, %8
    %11 = add i32 %9, %10
    ret i32 %11

}

func @negdiv(%0: i32) i32 !readnone {

entry:
    %1 = sdiv i32 %0, -8
    ret i32 %1

}

func @wide(%0: i64) i64 !readnone {

entry:
    %1 = ashr i64 %0, 63
    %2 = and i64 %1, 1023
    %3 = add i64 %0, %2
    %4 = ashr i64 %3, 10
    %5 = and i64 %3, 1023
    %6 = sub i64 %5, %2
    %7 = add i64 %4, %6
    ret i64 %7

}
