// ---- module ----

module "loop_invariant"

// ---- funcs ----

func @main() i32 !readnone {

entry:
    br loop

loop:
    %0 = phi i64 [0, entry], [%4, body]
    %1 = phi i64 [0, entry], [%5, body]
    %2 = icmp slt i64 %1, 10
    cond_br %2, body, done

done:
    %3 = trunc i64 %0 to i32
    ret i32 %3

body:
    %4 = add i64 %0, 21
    %5 = add i64 %1, 1
    br loop

}
