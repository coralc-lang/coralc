; ---- module ----

module "hoist"

; ---- funcs ----

define func @hoist(%0: i64, %1: i64, %2: ptr) i64 !writeonly !argmemonly {

entry:
    %3 = icmp ne i64 %0, 0
    cond_br %3, left, right

right:
    %4 = add i64 %1, 7
    %5 = mul i64 %4, 3
    %6 = sub i64 %5, %1
    store i64 %6, %2
    br join

left:
    %7 = add i64 %1, 7
    %8 = mul i64 %7, 3
    %9 = add i64 %8, %1
    store i64 %9, %2
    br join

join:
    ret i64 0

}

define func @diff(%0: i64, %1: i64, %2: ptr) i64 !writeonly !argmemonly {

entry:
    %3 = icmp ne i64 %0, 0
    cond_br %3, left, right

right:
    %4 = add i64 %1, 8
    %5 = mul i64 %4, 3
    store i64 %5, %2
    br join

left:
    %6 = add i64 %1, 7
    %7 = mul i64 %6, 3
    store i64 %7, %2
    br join

join:
    ret i64 0

}

define func @loadp(%0: i64, %1: i64, %2: ptr) i64 !argmemonly {

entry:
    %3 = icmp ne i64 %0, 0
    cond_br %3, left, right

right:
    %4 = load i64 %2
    %5 = add i64 %4, %1
    store i64 %5, %2
    br join

left:
    %6 = load i64 %2
    %7 = add i64 %6, %1
    store i64 %7, %2
    br join

join:
    ret i64 0

}

define func @multipred(%0: i64, %1: i64, %2: i64, %3: ptr) i64 !writeonly !argmemonly {

entry:
    %4 = icmp ne i64 %0, 0
    %5 = icmp ne i64 %1, 0
    cond_br %4, left, mid

mid:
    cond_br %5, right, join

right:
    %6 = add i64 %2, 7
    store i64 %6, %3
    br join

left:
    %7 = add i64 %2, 7
    store i64 %7, %3
    br join

join:
    ret i64 0

}
