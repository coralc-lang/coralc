// ---- module ----

module "algebraic_demo"

// ---- funcs ----

func @mul_pow2(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = mul i64 %0, 16
    %3 = mul i64 %0, 2
    %4 = mul i64 %1, 8
    %5 = add i64 %2, %3
    %6 = add i64 %5, %4
    ret i64 %6

}

func @udiv_1(%0: i64) i64 !readnone {

entry:
    %1 = udiv i64 %0, 1
    %2 = udiv i64 %1, 4
    ret i64 %2

}

func @urem_1(%0: i64) i64 !readnone {

entry:
    %1 = urem i64 %0, 1
    ret i64 %1

}

func @smin_same(%0: i64) i64 !readnone {

entry:
    %1 = smin i64 %0, %0
    %2 = smin i64 %0, %0
    %3 = add i64 %1, %2
    ret i64 %3

}

func @lex_chain(%0: i64, %1: i64, %2: i64) i64 !readnone {

entry:
    %3 = add i64 %1, 4
    %4 = add i64 %0, %3
    %5 = add i64 %2, %4
    ret i64 %5

}

func @ext_chain(%0: i32) i64 !readnone {

entry:
    %1 = sext i32 %0 to i64
    %2 = sext i64 %1 to i64
    ret i64 %2

}
