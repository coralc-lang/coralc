// ---- module ----

module "bigmodule"

// ---- globals ----

global @g: i64 = 3 !alignment = 8;

// ---- funcs ----

func @square(%0: i64) i64 !readnone {

entry:
    %1 = mul i64 %0, %0
    ret i64 %1

}

func @cube(%0: i64) i64 !readnone {

entry:
    %1 = mul i64 %0, %0
    %2 = mul i64 %1, %0
    ret i64 %2

}

func @sum_to(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%5, body]
    %2 = phi i64 [0, entry], [%4, body]
    %3 = icmp slt i64 %1, %0
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = add i64 %1, %2
    %5 = add i64 %1, 1
    br loop

}

func @collatz(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [%0, entry], [%9, body]
    %2 = phi i64 [0, entry], [%10, body]
    %3 = icmp eq i64 %1, 1
    cond_br %3, done, body

body:
    %4  = and i64 %1, 1
    %5  = lshr i64 %1, 1
    %6  = mul i64 %1, 3
    %7  = add i64 %6, 1
    %8  = icmp eq i64 %4, 1
    %9  = select i1 %8, i64 %7, i64 %5
    %10 = add i64 %2, 1
    br loop

done:
    ret i64 %2

}

func @fib(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%6, body]
    %2 = phi i64 [0, entry], [%3, body]
    %3 = phi i64 [1, entry], [%5, body]
    %4 = icmp slt i64 %1, %0
    cond_br %4, body, done

done:
    ret i64 %2

body:
    %5 = add i64 %2, %3
    %6 = add i64 %1, 1
    br loop

}

func @sum_squares_range(%0: i64, %1: i64) i64 !readnone {

entry:
    br loop

loop:
    %2 = phi i64 [%0, entry], [%7, body]
    %3 = phi i64 [0, entry], [%6, body]
    %4 = icmp slt i64 %2, %1
    cond_br %4, body, done

done:
    ret i64 %3

body:
    %5 = mul i64 %2, %2
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    br loop

}

func @fact(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [1, entry], [%5, body]
    %2 = phi i64 [1, entry], [%4, body]
    %3 = icmp sle i64 %1, %0
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = mul i64 %1, %2
    %5 = add i64 %1, 1
    br loop

}

func @gcd(%0: i64, %1: i64) i64 !readnone {

entry:
    br loop

loop:
    %2 = phi i64 [%0, entry], [%3, body]
    %3 = phi i64 [%1, entry], [%5, body]
    %4 = icmp eq i64 %3, 0
    cond_br %4, done, body

body:
    %5 = srem i64 %2, %3
    br loop

done:
    ret i64 %2

}

func @count_bits(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [%0, entry], [%6, body]
    %2 = phi i64 [0, entry], [%5, body]
    %3 = icmp eq i64 %1, 0
    cond_br %3, done, body

body:
    %4 = and i64 %1, 1
    %5 = add i64 %2, %4
    %6 = lshr i64 %1, 1
    br loop

done:
    ret i64 %2

}

func @poly(%0: i64) i64 !readnone {

entry:
    %1 = mul i64 %0, %0
    %2 = shl i64 %0, 1
    %3 = add i64 %1, %2
    %4 = add i64 %3, 1
    %5 = shl i64 %4, 1
    ret i64 %5

}

func @invar_loop(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = mul i64 %1, 7
    br loop

loop:
    %3 = phi i64 [0, entry], [%7, body]
    %4 = phi i64 [0, entry], [%6, body]
    %5 = icmp slt i64 %3, %0
    cond_br %5, body, done

done:
    ret i64 %4

body:
    %6 = add i64 %2, %4
    %7 = add i64 %3, 1
    br loop

}

func @big_switch(%0: i64) i64 !readnone {

entry:
    %1 = icmp eq i64 %0, 0
    cond_br %1, case0, n1

n1:
    %2 = icmp eq i64 %0, 1
    cond_br %2, case1, n2

n2:
    %3 = icmp eq i64 %0, 2
    cond_br %3, case2, n3

n3:
    %4 = icmp eq i64 %0, 3
    cond_br %4, case3, n4

n4:
    %5 = icmp eq i64 %0, 4
    cond_br %5, case4, n5

n5:
    %6 = icmp eq i64 %0, 5
    cond_br %6, case5, n6

n6:
    %7 = icmp eq i64 %0, 6
    cond_br %7, case6, n7

n7:
    %8 = icmp eq i64 %0, 7
    cond_br %8, case7, n8

n8:
    %9 = icmp eq i64 %0, 8
    cond_br %9, case8, n9

n9:
    %10 = icmp eq i64 %0, 9
    cond_br %10, case9, case10

case10:
    ret i64 1024

case9:
    ret i64 512

case8:
    ret i64 256

case7:
    ret i64 128

case6:
    ret i64 64

case5:
    ret i64 32

case4:
    ret i64 16

case3:
    ret i64 8

case2:
    ret i64 4

case1:
    ret i64 2

case0:
    ret i64 1

}

func @const_chain() i64 !readnone {

entry:
    ret i64 245

}

func @redundant(%0: i64) i64 !readnone {

entry:
    ret i64 42

}

func @xor_self(%0: i64) i64 !readnone {

entry:
    ret i64 0

}

func @select_real(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = smax i64 %0, %1
    ret i64 %2

}

func @phi_const_combo(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = icmp sgt i64 %0, %1
    cond_br %2, merge, big

big:
    br merge

merge:
    %3 = phi i64 [100, entry], [200, big]
    %4 = add i64 %3, 1
    ret i64 %4

}

func @same_pick(%0: i1, %1: i64, %2: i64) i64 !readnone {

entry:
    %3 = select i1 %0, i64 %1, i64 %2
    ret i64 %3

}

func @select_same(%0: i1, %1: i64) i64 !readnone {

entry:
    ret i64 %1

}

func @main() i32 !readonly {

entry:
    %0  = load i64 @g
    %1  = call i64 @square(i64 %0)
    %2  = call i64 @cube(i64 %0)
    %3  = call i64 @sum_to(i64 8)
    %4  = call i64 @fib(i64 10)
    %5  = call i64 @sum_squares_range(i64 1, i64 8)
    %6  = call i64 @fact(i64 5)
    %7  = call i64 @gcd(i64 1071, i64 462)
    %8  = call i64 @count_bits(i64 12345)
    %9  = call i64 @poly(i64 3)
    %10 = call i64 @invar_loop(i64 4, i64 5)
    %11 = call i64 @big_switch(i64 7)
    %12 = call i64 @const_chain()
    %13 = call i64 @redundant(i64 9)
    %14 = call i64 @xor_self(i64 123)
    %15 = call i64 @select_real(i64 10, i64 20)
    %16 = call i64 @same_pick(i1 true, i64 7, i64 9)
    %17 = call i64 @select_same(i1 false, i64 99)
    %18 = call i64 @phi_const_combo(i64 3, i64 5)
    %19 = add i64 %1, %2
    %20 = add i64 %3, %19
    %21 = add i64 %4, %20
    %22 = add i64 %5, %21
    %23 = add i64 %6, %22
    %24 = add i64 %7, %23
    %25 = add i64 %8, %24
    %26 = add i64 %9, %25
    %27 = add i64 %10, %26
    %28 = add i64 %11, %27
    %29 = add i64 %12, %28
    %30 = add i64 %13, %29
    %31 = add i64 %14, %30
    %32 = add i64 %15, %31
    %33 = add i64 %16, %32
    %34 = add i64 %17, %33
    %35 = add i64 %18, %34
    %36 = and i64 %35, 255
    %37 = trunc i64 %36 to i32
    ret i32 %37

}
