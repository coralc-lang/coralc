; ---- module ----

module "nestflag"

; ---- funcs ----

define func @nest(%0: i64) i64 !readnone {

entry:
    %1 = icmp eq i64 %0, 7
    br unroll

unroll:
    %2 = phi i64 [0, entry], [%3, unroll]
    %3 = add i64 %2, 1
    %4 = icmp slt i64 %3, 4
    cond_br %4, unroll, unroll.1

unroll.1:
    %5 = phi i64 [0, unroll], [%6, unroll.1]
    %6 = add i64 %5, 1
    %7 = icmp slt i64 %6, 4
    cond_br %7, unroll.1, unroll.2

unroll.2:
    %8  = phi i64 [0, unroll.1], [%13, unroll.2]
    %9  = phi i64 [0, unroll.1], [%12, unroll.2]
    %10 = add i64 %9, 1
    %11 = add i64 %9, 2
    %12 = select i1 %1, i64 %10, i64 %11
    %13 = add i64 %8, 1
    %14 = icmp slt i64 %13, 4
    cond_br %14, unroll.2, done

done:
    %15 = mul i64 %8, 10
    %16 = add i64 %15, 3
    %17 = add i64 %9, %16
    ret i64 %17

}

define func @main() i32 !readnone {

entry:
    %0 = call i64 @nest(i64 7)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}
