// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    %fc = icmp eq i64 %flag, 7
    br outer

outer:
    %i = phi i64 [ 0, entry ], [ %in, olatch ]
    %jo = phi i64 [ 0, entry ], [ %j, olatch ]
    %ao = phi i64 [ 0, entry ], [ %acc, olatch ]
    %oc = icmp slt i64 %i, 3
    cond_br %oc, inner, done

done:
    %ten = mul i64 %jo, 10
    %s1 = add i64 %i, %ten
    %res = add i64 %ao, %s1
    ret i64 %res

inner:
    %j = phi i64 [ 0, outer ], [ %jn, imerge ]
    %acc = phi i64 [ 0, outer ], [ %sel, imerge ]
    cond_br %fc, ithen, ielse

ielse:
    %tb = add i64 %acc, 2
    br imerge

ithen:
    %ta = add i64 %acc, 1
    br imerge

imerge:
    %sel = phi i64 [ %ta, ithen ], [ %tb, ielse ]
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, olatch

olatch:
    %in = add i64 %i, 1
    br outer
}

func @main() i32 {
entry:
    %r = call i64 @nest(i64 7)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
