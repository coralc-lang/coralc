// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    br unroll

unroll:
    %1 = phi i64 [0, entry], [%3, unroll]
    %2 = gep %0, %1
    store i64 %1, %2
    %3 = add i64 %1, 1
    %4 = icmp slt i64 %3, 4
    cond_br %4, unroll, unroll.1

unroll.1:
    %5 = phi i64 [0, unroll], [%8, unroll.1]
    %6 = add i64 %5, 4
    %7 = gep %0, %6
    store i64 %6, %7
    %8 = add i64 %5, 1
    %9 = icmp slt i64 %8, 4
    cond_br %9, unroll.1, unroll.2

unroll.2:
    %10 = phi i64 [0, unroll.1], [%13, unroll.2]
    %11 = add i64 %10, 8
    %12 = gep %0, %11
    store i64 %11, %12
    %13 = add i64 %10, 1
    %14 = icmp slt i64 %13, 4
    cond_br %14, unroll.2, done

done:
    %15 = load vector i64 2 %0
    %16 = extractelement vector i64 2 %15, 0
    %17 = extractelement vector i64 2 %15, 1
    %18 = gep %0, 2
    %19 = load vector i64 2 %18
    %20 = extractelement vector i64 2 %19, 0
    %21 = extractelement vector i64 2 %19, 1
    %22 = gep %0, 4
    %23 = load vector i64 2 %22
    %24 = extractelement vector i64 2 %23, 0
    %25 = extractelement vector i64 2 %23, 1
    %26 = gep %0, 6
    %27 = load vector i64 2 %26
    %28 = extractelement vector i64 2 %27, 0
    %29 = extractelement vector i64 2 %27, 1
    %30 = gep %0, 8
    %31 = load vector i64 2 %30
    %32 = extractelement vector i64 2 %31, 0
    %33 = extractelement vector i64 2 %31, 1
    %34 = gep %0, 10
    %35 = load vector i64 2 %34
    %36 = extractelement vector i64 2 %35, 0
    %37 = extractelement vector i64 2 %35, 1
    %38 = add i64 %16, %17
    %39 = add i64 %20, %21
    %40 = add i64 %24, %25
    %41 = add i64 %28, %29
    %42 = add i64 %32, %33
    %43 = add i64 %36, %37
    %44 = add i64 %38, %39
    %45 = add i64 %40, %41
    %46 = add i64 %42, %43
    %47 = add i64 %44, %45
    %48 = add i64 %46, %47
    %49 = trunc i64 %48 to i32
    ret i32 %49
}
