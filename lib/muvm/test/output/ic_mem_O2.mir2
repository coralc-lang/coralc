// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    %1 = gep %0, 0
    %2 = gep %0, 4
    %3 = gep %0, 8
    br unroll

unroll:
    %4 = phi i64 [0, entry], [%7, unroll]
    %5 = phi i64 [0, entry], [%8, unroll]
    %6 = phi ptr i64 [%1, entry], [%9, unroll]
    store i64 %5, %6
    %7 = add i64 %4, 1
    %8 = add i64 %5, 1
    %9 = gep %6, 8
    %10 = icmp slt i64 %7, 4
    cond_br %10, unroll, unroll.1

unroll.1:
    %11 = phi i64 [0, unroll], [%14, unroll.1]
    %12 = phi i64 [4, unroll], [%15, unroll.1]
    %13 = phi ptr i64 [%2, unroll], [%16, unroll.1]
    store i64 %12, %13
    %14 = add i64 %11, 1
    %15 = add i64 %12, 1
    %16 = gep %13, 8
    %17 = icmp slt i64 %14, 4
    cond_br %17, unroll.1, unroll.2

unroll.2:
    %18 = phi i64 [0, unroll.1], [%21, unroll.2]
    %19 = phi i64 [8, unroll.1], [%22, unroll.2]
    %20 = phi ptr i64 [%3, unroll.1], [%23, unroll.2]
    store i64 %19, %20
    %21 = add i64 %18, 1
    %22 = add i64 %19, 1
    %23 = gep %20, 8
    %24 = icmp slt i64 %21, 4
    cond_br %24, unroll.2, unroll.3

unroll.3:
    %25 = load vector i64 2 %0
    %26 = extractelement vector i64 2 %25, 0
    %27 = extractelement vector i64 2 %25, 1
    %28 = gep %0, 2
    %29 = load vector i64 2 %28
    %30 = extractelement vector i64 2 %29, 0
    %31 = extractelement vector i64 2 %29, 1
    %32 = gep %0, 4
    %33 = load vector i64 2 %32
    %34 = extractelement vector i64 2 %33, 0
    %35 = extractelement vector i64 2 %33, 1
    %36 = gep %0, 6
    %37 = load vector i64 2 %36
    %38 = extractelement vector i64 2 %37, 0
    %39 = extractelement vector i64 2 %37, 1
    %40 = gep %0, 8
    %41 = load vector i64 2 %40
    %42 = extractelement vector i64 2 %41, 0
    %43 = extractelement vector i64 2 %41, 1
    %44 = gep %0, 10
    %45 = load vector i64 2 %44
    %46 = extractelement vector i64 2 %45, 0
    %47 = extractelement vector i64 2 %45, 1
    %48 = add i64 %26, %27
    %49 = add i64 %30, %31
    %50 = add i64 %34, %35
    %51 = add i64 %38, %39
    %52 = add i64 %42, %43
    %53 = add i64 %46, %47
    %54 = add i64 %48, %49
    %55 = add i64 %50, %51
    %56 = add i64 %52, %53
    %57 = add i64 %54, %55
    %58 = add i64 %56, %57
    %59 = trunc i64 %58 to i32
    ret i32 %59
}
