// ---- module ----

module "tco_acc"

// ---- funcs ----

func @sumto(%0: i64) i64 {

entry:
    %1 = icmp sle i64 %0, 0
    cond_br %1, base, step

step:
    %2 = sub i64 %0, 1
    %3 = call i64 @sumto(i64 %2)
    %4 = add i64 %3, %0
    ret i64 %4

base:
    ret i64 0

}

func @main() i32 {

entry:
    %0 = call i64 @sumto(i64 5)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}
