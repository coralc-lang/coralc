// ---- module ----

module "algebraic_demo"

// ---- funcs ----

func @mul_pow2(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = shl i64 %0, 4
    %3 = shl i64 %0, 1
    %4 = shl i64 %1, 3
    %5 = add i64 %3, %2
    %6 = add i64 %5, %4
    ret i64 %6

}

func @udiv_1(%0: i64) i64 !readnone {

entry:
    %1 = lshr i64 %0, 2
    ret i64 %1

}

func @urem_1(%0: i64) i64 !readnone {

entry:
    ret i64 0

}

func @smin_same(%0: i64) i64 !readnone {

entry:
    %1 = shl i64 %0, 1
    ret i64 %1

}

func @lex_chain(%0: i64, %1: i64, %2: i64) i64 !readnone {

entry:
    %3 = add i64 %1, 4
    %4 = add i64 %0, %3
    %5 = add i64 %2, %4
    ret i64 %5

}

func @ext_chain(%0: i32) i64 !readnone {

entry:
    %1 = sext i32 %0 to i64
    ret i64 %1

}
