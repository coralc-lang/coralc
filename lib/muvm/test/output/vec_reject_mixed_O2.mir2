// ---- module ----

module "vec_reject_mixed"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i32 16
    %c = alloca array i64 16
    %d = alloca array i32 16
    %306 = load vector i64 2 %a
    store vector i64 2 %306, %c
    %307 = load vector i32 4 %b
    store vector i32 4 %307, %d
    %94 = gep %a, 2
    %308 = load vector i64 2 %94
    %96 = gep %c, 2
    store vector i64 2 %308, %96
    %120 = gep %a, 4
    %309 = load vector i64 2 %120
    %122 = gep %c, 4
    store vector i64 2 %309, %122
    %124 = gep %b, 4
    %310 = load vector i32 4 %124
    %126 = gep %d, 4
    store vector i32 4 %310, %126
    %146 = gep %a, 6
    %311 = load vector i64 2 %146
    %148 = gep %c, 6
    store vector i64 2 %311, %148
    %172 = gep %a, 8
    %312 = load vector i64 2 %172
    %174 = gep %c, 8
    store vector i64 2 %312, %174
    %176 = gep %b, 8
    %313 = load vector i32 4 %176
    %178 = gep %d, 8
    store vector i32 4 %313, %178
    %198 = gep %a, 10
    %314 = load vector i64 2 %198
    %200 = gep %c, 10
    store vector i64 2 %314, %200
    %224 = gep %a, 12
    %315 = load vector i64 2 %224
    %226 = gep %c, 12
    store vector i64 2 %315, %226
    %228 = gep %b, 12
    %316 = load vector i32 4 %228
    %230 = gep %d, 12
    store vector i32 4 %316, %230
    %250 = gep %a, 14
    %317 = load vector i64 2 %250
    %252 = gep %c, 14
    store vector i64 2 %317, %252
    ret i64 0
}
