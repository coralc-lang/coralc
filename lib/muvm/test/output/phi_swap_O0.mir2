// ---- module ----

module "phi_swap"

// ---- funcs ----

func @rot(%n: i32) i32 {
entry:
    br loop

loop:
    %i = phi i32 [ 0, entry ], [ %in, body ]
    %p = phi i32 [ 10, entry ], [ %q, body ]
    %q = phi i32 [ 20, entry ], [ %p, body ]
    %c = icmp slt i32 %i, %n
    cond_br %c, body, done

done:
    %r = mul i32 %p, 100
    %s = add i32 %r, %q
    ret i32 %s

body:
    %in = add i32 %i, 1
    br loop
}

func @main() i32 {
entry:
    %a = call i32 @rot(i32 0)
    %c0 = icmp eq i32 %a, 1020
    %ok0 = zext i1 %c0 to i32
    %b = call i32 @rot(i32 1)
    %c1 = icmp eq i32 %b, 2010
    %ok1 = zext i1 %c1 to i32
    %cc = call i32 @rot(i32 2)
    %c2 = icmp eq i32 %cc, 1020
    %ok2 = zext i1 %c2 to i32
    %s = add i32 %ok0, %ok1
    %t = add i32 %s, %ok2
    %r = icmp eq i32 %t, 3
    %z = zext i1 %r to i32
    %neg = sub i32 0, %z
    ret i32 %neg
}
