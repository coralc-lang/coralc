// ---- module ----

module "vec_broadcast"

// ---- funcs ----

func @f() i64 !argmemonly {

entry:
    %0  = alloca array i64 16
    %1  = alloca array i64 16
    %2  = load vector i64 2 %0
    %3  = vbroadcast vector i64 2 3
    %4  = vmul vector i64 2 %2, %3
    store vector i64 2 %4, %1
    %5  = gep %0, 2
    %6  = load vector i64 2 %5
    %7  = vmul vector i64 2 %6, %3
    %8  = gep %1, 2
    store vector i64 2 %7, %8
    %9  = gep %0, 4
    %10 = load vector i64 2 %9
    %11 = vmul vector i64 2 %10, %3
    %12 = gep %1, 4
    store vector i64 2 %11, %12
    %13 = gep %0, 6
    %14 = load vector i64 2 %13
    %15 = vmul vector i64 2 %14, %3
    %16 = gep %1, 6
    store vector i64 2 %15, %16
    %17 = gep %0, 8
    %18 = load vector i64 2 %17
    %19 = vmul vector i64 2 %18, %3
    %20 = gep %1, 8
    store vector i64 2 %19, %20
    %21 = gep %0, 10
    %22 = load vector i64 2 %21
    %23 = vmul vector i64 2 %22, %3
    %24 = gep %1, 10
    store vector i64 2 %23, %24
    %25 = gep %0, 12
    %26 = load vector i64 2 %25
    %27 = vmul vector i64 2 %26, %3
    %28 = gep %1, 12
    store vector i64 2 %27, %28
    %29 = gep %0, 14
    %30 = load vector i64 2 %29
    %31 = vmul vector i64 2 %30, %3
    %32 = gep %1, 14
    store vector i64 2 %31, %32
    ret i64 0

}
