// ---- module ----

module "vec_ops"

// ---- funcs ----

func @main() i32 !readnone {

entry:
    %0 = vbroadcast vector i32 4 3
    %1 = vbroadcast vector i32 4 7
    %2 = vadd vector i32 4 %0, %1
    %3 = vmin vector i32 4 %2, %1
    %4 = insertelement vector i32 4 %3, i32 30, 2
    %5 = extractelement vector i32 4 %4, 2
    %6 = shufflevector vector i32 4 %4, %1, 2, 1, 0, 3
    %7 = extractelement vector i32 4 %6, 1
    %8 = add i32 %5, %7
    ret i32 %8

}
