// ---- module ----

module "vec_broadcast"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %32 = vbroadcast vector i64 2 3
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %30 = load vector i64 2 %ga
    %31 = vmul vector i64 2 %30, %32
    %gc = gep %c, %i
    store vector i64 2 %31, %gc
    %in = add i64 %i, 2
    br loop
}
