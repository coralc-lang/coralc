// ---- module ----

module "vec_reject_fred"

// ---- funcs ----

func @f() f64 {
entry:
    %a = alloca array f64 8
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, latch ]
    %s = phi f64 [ 0.0, entry ], [ %ns, latch ]
    %iv = icmp slt i64 %i, 8
    cond_br %iv, body, done

done:
    ret f64 %s

body:
    %ga = gep %a, %i
    %la = load f64 %ga
    %ns = fadd f64 %s, %la
    br latch

latch:
    %in = add i64 %i, 1
    br loop
}
