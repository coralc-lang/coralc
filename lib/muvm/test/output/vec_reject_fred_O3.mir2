// ---- module ----

module "vec_reject_fred"

// ---- funcs ----

func @f() f64 {

entry:
    %0  = alloca array f64 8
    %1  = load vector f64 2 %0
    %2  = extractelement vector f64 2 %1, 0
    %3  = fadd f64 0.0, %2
    %4  = extractelement vector f64 2 %1, 1
    %5  = fadd f64 %3, %4
    %6  = gep %0, 2
    %7  = load vector f64 2 %6
    %8  = extractelement vector f64 2 %7, 0
    %9  = fadd f64 %5, %8
    %10 = extractelement vector f64 2 %7, 1
    %11 = fadd f64 %9, %10
    %12 = gep %0, 4
    %13 = load vector f64 2 %12
    %14 = extractelement vector f64 2 %13, 0
    %15 = fadd f64 %11, %14
    %16 = extractelement vector f64 2 %13, 1
    %17 = fadd f64 %15, %16
    %18 = gep %0, 6
    %19 = load vector f64 2 %18
    %20 = extractelement vector f64 2 %19, 0
    %21 = fadd f64 %17, %20
    %22 = extractelement vector f64 2 %19, 1
    %23 = fadd f64 %21, %22
    ret f64 %23

}
