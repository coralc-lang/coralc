// ---- module ----

module "vec_reject_fred"

// ---- funcs ----

func @f() f64 {
entry:
    %a = alloca array f64 8
    %48 = load f64 %a
    %49 = fadd f64 0.0, %48
    %56 = gep %a, 1
    %57 = load f64 %56
    %58 = fadd f64 %49, %57
    %65 = gep %a, 2
    %66 = load f64 %65
    %67 = fadd f64 %58, %66
    %74 = gep %a, 3
    %75 = load f64 %74
    %76 = fadd f64 %67, %75
    %83 = gep %a, 4
    %84 = load f64 %83
    %85 = fadd f64 %76, %84
    %92 = gep %a, 5
    %93 = load f64 %92
    %94 = fadd f64 %85, %93
    %101 = gep %a, 6
    %102 = load f64 %101
    %103 = fadd f64 %94, %102
    %110 = gep %a, 7
    %111 = load f64 %110
    %112 = fadd f64 %103, %111
    ret f64 %112
}
