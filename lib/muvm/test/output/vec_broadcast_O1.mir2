// ---- module ----

module "vec_broadcast"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %m = mul i64 %la, 3
    %gc = gep %c, %i
    store i64 %m, %gc
    %in = add i64 %i, 1
    br loop
}
