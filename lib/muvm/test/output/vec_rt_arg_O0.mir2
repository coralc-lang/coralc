; ---- module ----

module "vec_rt_arg"

; ---- funcs ----

define func @f(%0: i64) i64 {

entry:
    %1  = alloca array i64 16
    %2  = alloca array i64 16
    %3  = gep %1, 0
    store i64 %0, %3
    %4  = gep %1, 1
    store i64 %0, %4
    %5  = gep %1, 2
    store i64 %0, %5
    %6  = gep %1, 3
    store i64 %0, %6
    %7  = gep %1, 4
    store i64 %0, %7
    %8  = gep %1, 5
    store i64 %0, %8
    %9  = gep %1, 6
    store i64 %0, %9
    %10 = gep %1, 7
    store i64 %0, %10
    %11 = gep %1, 8
    store i64 %0, %11
    %12 = gep %1, 9
    store i64 %0, %12
    %13 = gep %1, 10
    store i64 %0, %13
    %14 = gep %1, 11
    store i64 %0, %14
    %15 = gep %1, 12
    store i64 %0, %15
    %16 = gep %1, 13
    store i64 %0, %16
    %17 = gep %1, 14
    store i64 %0, %17
    %18 = gep %1, 15
    store i64 %0, %18
    br loop

loop:
    %19 = phi i64 [0, entry], [%30, latch]
    %20 = icmp slt i64 %19, 16
    cond_br %20, body, done

done:
    %21 = gep %2, 0
    %22 = load i64 %21
    %23 = gep %2, 15
    %24 = load i64 %23
    %25 = add i64 %22, %24
    ret i64 %25

body:
    %26 = gep %1, %19
    %27 = load i64 %26
    %28 = mul i64 %27, 3
    %29 = gep %2, %19
    store i64 %28, %29
    br latch

latch:
    %30 = add i64 %19, 1
    br loop

}
