// ---- module ----

module "intr_test"

// ---- funcs ----

func @__muvm_intrinsic_memcpy(%0: ptr i8, %1: ptr i8, %2: i64) extern;

func @__muvm_intrinsic_memset(%0: ptr i8, %1: i32, %2: i64) extern;

func @__muvm_intrinsic_memcmp(%0: ptr i8, %1: ptr i8, %2: i64) i32 extern;

func @__muvm_intrinsic_strcmp(%0: ptr i8, %1: ptr i8) i32 extern;

func @main() i32 {

entry:
    %0 = alloca array i8 16
    %1 = alloca array i8 16
    call void @__muvm_intrinsic_memset(array i8 16 %0, i32 65, i64 8)
    call void @__muvm_intrinsic_memcpy(array i8 16 %1, array i8 16 %0, i64 8)
    %2 = call i32 @__muvm_intrinsic_memcmp(array i8 16 %0, array i8 16 %1, i64 8)
    %3 = icmp eq i32 %2, 0
    %4 = zext i1 %3 to i32
    %5 = gep %0, 4
    store i8 66, %5
    %6 = call i32 @__muvm_intrinsic_memcmp(array i8 16 %0, array i8 16 %1, i64 8)
    %7 = icmp ne i32 %6, 0
    %8 = zext i1 %7 to i32
    %9 = add i32 %4, %8
    ret i32 %9

}
