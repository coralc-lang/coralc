// ---- module ----

module "ic_bad"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    br outer

outer:
    %1 = phi i64 [0, entry], [%9, olatch]
    %2 = icmp slt i64 %1, 3
    cond_br %2, inner, done

done:
    ret i32 0

inner:
    %3 = phi i64 [0, outer], [%7, inner]
    %4 = gep %0, %1
    %5 = load i64 %4
    %6 = add i64 %5, 1
    store i64 %6, %4
    %7 = add i64 %3, 1
    %8 = icmp slt i64 %7, 4
    cond_br %8, inner, olatch

olatch:
    %9 = add i64 %1, 1
    br outer
}
