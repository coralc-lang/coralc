// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 !readonly !argmemonly {

entry:
    %0  = alloca array i64 16
    %1  = load vector i64 2 %0
    %2  = extractelement vector i64 2 %1, 0
    %3  = extractelement vector i64 2 %1, 1
    %4  = add i64 %3, %2
    %5  = gep %0, 2
    %6  = load vector i64 2 %5
    %7  = extractelement vector i64 2 %6, 0
    %8  = add i64 %4, %7
    %9  = extractelement vector i64 2 %6, 1
    %10 = add i64 %8, %9
    %11 = gep %0, 4
    %12 = load vector i64 2 %11
    %13 = extractelement vector i64 2 %12, 0
    %14 = add i64 %10, %13
    %15 = extractelement vector i64 2 %12, 1
    %16 = add i64 %14, %15
    %17 = gep %0, 6
    %18 = load vector i64 2 %17
    %19 = extractelement vector i64 2 %18, 0
    %20 = add i64 %16, %19
    %21 = extractelement vector i64 2 %18, 1
    %22 = add i64 %20, %21
    %23 = gep %0, 8
    %24 = load vector i64 2 %23
    %25 = extractelement vector i64 2 %24, 0
    %26 = add i64 %22, %25
    %27 = extractelement vector i64 2 %24, 1
    %28 = add i64 %26, %27
    %29 = gep %0, 10
    %30 = load vector i64 2 %29
    %31 = extractelement vector i64 2 %30, 0
    %32 = add i64 %28, %31
    %33 = extractelement vector i64 2 %30, 1
    %34 = add i64 %32, %33
    %35 = gep %0, 12
    %36 = load vector i64 2 %35
    %37 = extractelement vector i64 2 %36, 0
    %38 = add i64 %34, %37
    %39 = extractelement vector i64 2 %36, 1
    %40 = add i64 %38, %39
    %41 = gep %0, 14
    %42 = load vector i64 2 %41
    %43 = extractelement vector i64 2 %42, 0
    %44 = add i64 %40, %43
    %45 = extractelement vector i64 2 %42, 1
    %46 = add i64 %44, %45
    ret i64 %46

}
