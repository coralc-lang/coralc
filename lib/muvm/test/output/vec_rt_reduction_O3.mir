// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    store i64 1, %a
    %i1 = gep %a, 1
    store i64 2, %i1
    %i2 = gep %a, 2
    store i64 3, %i2
    %i3 = gep %a, 3
    store i64 4, %i3
    %i4 = gep %a, 4
    store i64 5, %i4
    %i5 = gep %a, 5
    store i64 6, %i5
    %i6 = gep %a, 6
    store i64 7, %i6
    %i7 = gep %a, 7
    store i64 8, %i7
    %i8 = gep %a, 8
    store i64 9, %i8
    %i9 = gep %a, 9
    store i64 10, %i9
    %i10 = gep %a, 10
    store i64 11, %i10
    %i11 = gep %a, 11
    store i64 12, %i11
    %i12 = gep %a, 12
    store i64 13, %i12
    %i13 = gep %a, 13
    store i64 14, %i13
    %i14 = gep %a, 14
    store i64 15, %i14
    %i15 = gep %a, 15
    store i64 16, %i15
    %268 = load vector i64 2 %a
    %293 = extractelement vector i64 2 %268, 0
    %292 = extractelement vector i64 2 %268, 1
    %119 = add i64 %292, %293
    %126 = gep %a, 2
    %269 = load vector i64 2 %126
    %291 = extractelement vector i64 2 %269, 0
    %128 = add i64 %119, %291
    %290 = extractelement vector i64 2 %269, 1
    %137 = add i64 %128, %290
    %144 = gep %a, 4
    %270 = load vector i64 2 %144
    %289 = extractelement vector i64 2 %270, 0
    %146 = add i64 %137, %289
    %288 = extractelement vector i64 2 %270, 1
    %155 = add i64 %146, %288
    %162 = gep %a, 6
    %271 = load vector i64 2 %162
    %287 = extractelement vector i64 2 %271, 0
    %164 = add i64 %155, %287
    %286 = extractelement vector i64 2 %271, 1
    %173 = add i64 %164, %286
    %180 = gep %a, 8
    %272 = load vector i64 2 %180
    %285 = extractelement vector i64 2 %272, 0
    %182 = add i64 %173, %285
    %284 = extractelement vector i64 2 %272, 1
    %191 = add i64 %182, %284
    %198 = gep %a, 10
    %273 = load vector i64 2 %198
    %283 = extractelement vector i64 2 %273, 0
    %200 = add i64 %191, %283
    %282 = extractelement vector i64 2 %273, 1
    %209 = add i64 %200, %282
    %216 = gep %a, 12
    %274 = load vector i64 2 %216
    %281 = extractelement vector i64 2 %274, 0
    %218 = add i64 %209, %281
    %280 = extractelement vector i64 2 %274, 1
    %227 = add i64 %218, %280
    %234 = gep %a, 14
    %275 = load vector i64 2 %234
    %279 = extractelement vector i64 2 %275, 0
    %236 = add i64 %227, %279
    %277 = extractelement vector i64 2 %275, 1
    %245 = add i64 %236, %277
    ret i64 %245
}
