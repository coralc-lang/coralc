// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 16
    store i64 1, %0
    %1 = gep %0, 1
    store i64 2, %1
    %2 = gep %0, 2
    store i64 3, %2
    %3 = gep %0, 3
    store i64 4, %3
    %4 = gep %0, 4
    store i64 5, %4
    %5 = gep %0, 5
    store i64 6, %5
    %6 = gep %0, 6
    store i64 7, %6
    %7 = gep %0, 7
    store i64 8, %7
    %8 = gep %0, 8
    store i64 9, %8
    %9 = gep %0, 9
    store i64 10, %9
    %10 = gep %0, 10
    store i64 11, %10
    %11 = gep %0, 11
    store i64 12, %11
    %12 = gep %0, 12
    store i64 13, %12
    %13 = gep %0, 13
    store i64 14, %13
    %14 = gep %0, 14
    store i64 15, %14
    %15 = gep %0, 15
    store i64 16, %15
    %16 = gep %0, 0
    %17 = load i64 %16
    %18 = gep %16, 8
    %19 = load i64 %18
    %20 = add i64 %17, %19
    %21 = gep %18, 8
    %22 = load i64 %21
    %23 = add i64 %20, %22
    %24 = gep %21, 8
    %25 = load i64 %24
    %26 = add i64 %23, %25
    %27 = gep %24, 8
    %28 = load i64 %27
    %29 = add i64 %26, %28
    %30 = gep %27, 8
    %31 = load i64 %30
    %32 = add i64 %29, %31
    %33 = gep %30, 8
    %34 = load i64 %33
    %35 = add i64 %32, %34
    %36 = gep %33, 8
    %37 = load i64 %36
    %38 = add i64 %35, %37
    %39 = gep %36, 8
    %40 = load i64 %39
    %41 = add i64 %38, %40
    %42 = gep %39, 8
    %43 = load i64 %42
    %44 = add i64 %41, %43
    %45 = gep %42, 8
    %46 = load i64 %45
    %47 = add i64 %44, %46
    %48 = gep %45, 8
    %49 = load i64 %48
    %50 = add i64 %47, %49
    %51 = gep %48, 8
    %52 = load i64 %51
    %53 = add i64 %50, %52
    %54 = gep %51, 8
    %55 = load i64 %54
    %56 = add i64 %53, %55
    %57 = gep %54, 8
    %58 = load i64 %57
    %59 = add i64 %56, %58
    %60 = gep %57, 8
    %61 = load i64 %60
    %62 = add i64 %59, %61
    ret i64 %62
}
