// ---- module ----

module "ivsr"

// ---- funcs ----

func @strred(%0: ptr, %1: i32) i32 !argmemonly {

entry:
    %2 = gep %0, 0
    br loop

loop:
    %3 = phi i32 [0, entry], [%8, body]
    %4 = phi ptr [%2, entry], [%9, body]
    %5 = icmp slt i32 %3, %1
    cond_br %5, body, done

done:
    ret i32 0

body:
    %6 = load i32 %4
    %7 = add i32 %6, 1
    store i32 %7, %4
    %8 = add i32 %3, 1
    %9 = gep %4, 8
    br loop

}

func @shlcase(%0: ptr, %1: i64) i64 !readonly !argmemonly {

entry:
    %2 = gep %0, 0
    br loop

loop:
    %3 = phi i64 [0, entry], [%9, body]
    %4 = phi i64 [0, entry], [%8, body]
    %5 = phi ptr [%2, entry], [%10, body]
    %6 = icmp slt i64 %3, %1
    cond_br %6, body, done

done:
    ret i64 %4

body:
    %7  = load i64 %5
    %8  = add i64 %4, %7
    %9  = add i64 %3, 2
    %10 = gep %5, 32
    br loop

}
