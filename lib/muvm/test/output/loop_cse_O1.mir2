// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @lc_invariant(%0: i64) i64 {

entry:
    %1 = alloca array i64 4
    %2 = gep %1, 0
    store i64 30, %2
    %3 = gep %1, 1
    store i64 40, %3
    %4 = gep %1, 2
    store i64 50, %4
    %5 = gep %1, 3
    store i64 60, %5
    br loop

loop:
    %6  = phi i64 [0, entry], [%13, loop]
    %7  = phi i64 [0, entry], [%12, loop]
    %8  = gep %1, 0
    %9  = load i64 %8
    %10 = add i64 %9, 7
    %11 = mul i64 %10, 3
    %12 = add i64 %7, %11
    %13 = add i64 %6, 1
    %14 = icmp slt i64 %13, %0
    cond_br %14, loop, done

done:
    ret i64 %12

}
