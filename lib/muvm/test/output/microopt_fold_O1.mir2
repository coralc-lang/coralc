entry:
    %q = udiv i64 %x, 10
    ret i64 %q
}

func @sdiv7_i64(%x: i64) i64 {
entry:
    %q = sdiv i64 %x, 7
    ret i64 %q
}

func @urem3_i16(%x: i16) i16 {
entry:
    %195 = zext i16 %x to i64
    %197 = mul i64 %195, 43691
    %199 = lshr i64 %197, 17
    %200 = trunc i64 %199 to i16
    %201 = mul i16 %200, 3
    %202 = sub i16 %x, %201
    ret i16 %202
}

func @sdiv3_i16(%x: i16) i16 {
entry:
    %205 = sext i16 %x to i64
    %206 = mul i64 %205, 43691
    %207 = ashr i64 %206, 17
    %208 = trunc i64 %207 to i16
    %210 = ashr i16 %x, 15
    %212 = and i16 %210, 1
    %213 = add i16 %208, %212
    ret i16 %213
}

func @udiv4_pow2(%x: i32) i32 {
entry:
    %q = udiv i32 %x, 4
    ret i32 %q
}

func @rotl32(%x: i32) i32 {
entry:
    %217 = rotl i32 %x, 5
    ret i32 %217
}

