// ---- module ----

module "microopt_fold"

// ---- funcs ----

func @udiv3(%x: i32) i32 {
entry:
    %145 = zext i32 %x to i64
    %147 = mul i64 %145, 2863311531
    %149 = lshr i64 %147, 33
    %150 = trunc i64 %149 to i32
    ret i32 %150
}

func @urem7(%x: i32) i32 {
entry:
    %153 = zext i32 %x to i64
    %155 = mul i64 %153, 613566757
    %157 = lshr i64 %155, 32
    %158 = trunc i64 %157 to i32
    %159 = sub i32 %x, %158
    %161 = lshr i32 %159, 1
    %162 = add i32 %158, %161
    %164 = lshr i32 %162, 2
    %165 = mul i32 %164, 7
    %166 = sub i32 %x, %165
    ret i32 %166
}

func @sdiv3(%x: i32) i32 {
entry:
    %169 = sext i32 %x to i64
    %170 = mul i64 %169, 2863311531
    %171 = ashr i64 %170, 33
    %172 = trunc i64 %171 to i32
    %174 = ashr i32 %x, 31
    %175 = and i32 %174, 1
    %176 = add i32 %172, %175
    ret i32 %176
}

func @srem_neg7(%x: i32) i32 {
entry:
    %179 = sext i32 %x to i64
    %181 = mul i64 %179, 2454267027
    %183 = ashr i64 %181, 34
    %184 = trunc i64 %183 to i32
    %185 = ashr i32 %x, 31
    %186 = and i32 %185, 1
    %187 = add i32 %184, %186
    %188 = neg i32 %187
    %189 = mul i32 %188, -7
    %190 = sub i32 %x, %189
    ret i32 %190
}

