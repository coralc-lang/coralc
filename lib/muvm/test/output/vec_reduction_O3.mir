// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %63 = load i64 %a
    %71 = gep %a, 1
    %72 = load i64 %71
    %73 = add i64 %63, %72
    %80 = gep %a, 2
    %81 = load i64 %80
    %82 = add i64 %73, %81
    %89 = gep %a, 3
    %90 = load i64 %89
    %91 = add i64 %82, %90
    %98 = gep %a, 4
    %99 = load i64 %98
    %100 = add i64 %91, %99
    %107 = gep %a, 5
    %108 = load i64 %107
    %109 = add i64 %100, %108
    %116 = gep %a, 6
    %117 = load i64 %116
    %118 = add i64 %109, %117
    %125 = gep %a, 7
    %126 = load i64 %125
    %127 = add i64 %118, %126
    %134 = gep %a, 8
    %135 = load i64 %134
    %136 = add i64 %127, %135
    %143 = gep %a, 9
    %144 = load i64 %143
    %145 = add i64 %136, %144
    %152 = gep %a, 10
    %153 = load i64 %152
    %154 = add i64 %145, %153
    %161 = gep %a, 11
    %162 = load i64 %161
    %163 = add i64 %154, %162
    %170 = gep %a, 12
    %171 = load i64 %170
    %172 = add i64 %163, %171
    %179 = gep %a, 13
    %180 = load i64 %179
    %181 = add i64 %172, %180
    %188 = gep %a, 14
    %189 = load i64 %188
    %190 = add i64 %181, %189
    %197 = gep %a, 15
    %198 = load i64 %197
    %199 = add i64 %190, %198
    ret i64 %199
}
