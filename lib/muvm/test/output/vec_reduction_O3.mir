// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 16
    %1 = gep %0, 0
    %2 = load i64 %1
    %3 = gep %1, 8
    %4 = load i64 %3
    %5 = add i64 %2, %4
    %6 = gep %3, 8
    %7 = load i64 %6
    %8 = add i64 %5, %7
    %9 = gep %6, 8
    %10 = load i64 %9
    %11 = add i64 %8, %10
    %12 = gep %9, 8
    %13 = load i64 %12
    %14 = add i64 %11, %13
    %15 = gep %12, 8
    %16 = load i64 %15
    %17 = add i64 %14, %16
    %18 = gep %15, 8
    %19 = load i64 %18
    %20 = add i64 %17, %19
    %21 = gep %18, 8
    %22 = load i64 %21
    %23 = add i64 %20, %22
    %24 = gep %21, 8
    %25 = load i64 %24
    %26 = add i64 %23, %25
    %27 = gep %24, 8
    %28 = load i64 %27
    %29 = add i64 %26, %28
    %30 = gep %27, 8
    %31 = load i64 %30
    %32 = add i64 %29, %31
    %33 = gep %30, 8
    %34 = load i64 %33
    %35 = add i64 %32, %34
    %36 = gep %33, 8
    %37 = load i64 %36
    %38 = add i64 %35, %37
    %39 = gep %36, 8
    %40 = load i64 %39
    %41 = add i64 %38, %40
    %42 = gep %39, 8
    %43 = load i64 %42
    %44 = add i64 %41, %43
    %45 = gep %42, 8
    %46 = load i64 %45
    %47 = add i64 %44, %46
    ret i64 %47
}
