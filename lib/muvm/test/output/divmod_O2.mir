; ---- module ----

module "divmod_demo"

; ---- funcs ----

define func @divrem3(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = sdiv i64 %0, %1
    %3 = mul i64 %2, 10
    %4 = add i64 %2, %3
    %5 = mul i64 %2, %1
    %6 = sub i64 %0, %5
    %7 = add i64 %4, %6
    ret i64 %7

}

define func @urem_fused3(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = udiv i64 %0, %1
    %3 = mul i64 %2, 10
    %4 = add i64 %2, %3
    %5 = mul i64 %2, %1
    %6 = sub i64 %0, %5
    %7 = add i64 %4, %6
    ret i64 %7

}

define func @no_fusion_single_use(%0: i64, %1: i64) i64 !readnone {

entry:
    %2 = sdiv i64 %0, %1
    %3 = srem i64 %0, %1
    %4 = add i64 %2, %3
    ret i64 %4

}
