// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @main() i32 !readonly {

entry:
    %0 = alloca i64
    %1 = call i64 @sum_of_n(ptr i64 %0, i64 10)
    %2 = trunc i64 %1 to i32
    ret i32 %2

}

func @sum_of_n(%0: ptr, %1: i64) i64 !readonly {

entry:
    %2 = gep %0, 0
    br loop

loop:
    %3  = phi i64 [0, entry], [%8, loop]
    %4  = phi i64 [0, entry], [%7, loop]
    %5  = phi ptr [%2, entry], [%9, loop]
    %6  = load i64 %5
    %7  = add i64 %4, %6
    %8  = add i64 %3, 1
    %9  = gep %5, 1
    %10 = icmp slt i64 %8, %1
    cond_br %10, loop, done

done:
    ret i64 %7

}

func @sum_no_invariant(%0: ptr, %1: i64) i64 !readonly {

entry:
    %2 = gep %0, 0
    br loop

loop:
    %3  = phi i64 [0, entry], [%8, loop]
    %4  = phi i64 [0, entry], [%7, loop]
    %5  = phi ptr [%2, entry], [%9, loop]
    %6  = load i64 %5
    %7  = add i64 %4, %6
    %8  = add i64 %3, 1
    %9  = gep %5, 1
    %10 = icmp slt i64 %8, %1
    cond_br %10, loop, done

done:
    ret i64 %7

}
