; ---- module ----

module "storemerge"

; ---- globals ----

global @arr: array i32 4 !alignment = 4;

; ---- funcs ----

define func @merge(%0: i64) i64 !writeonly {

entry:
    %1 = gep @arr, 0
    store i32 286331153, %1
    %2 = gep @arr, 1
    store i32 572662306, %2
    ret i64 %0

}

define func @split(%0: i64) i64 {

entry:
    %1 = gep @arr, 2
    store i32 858993459, %1
    %2 = gep @arr, 3
    %3 = load i32 %2
    store i32 1145324612, %2
    %4 = zext i32 %3 to i64
    ret i64 %4

}

define func @gap(%0: i64) i64 !writeonly {

entry:
    %1 = gep @arr, 0
    store i32 1, %1
    %2 = gep @arr, 2
    store i32 2, %2
    ret i64 %0

}

define func @dyn(%0: i64, %1: i64) i64 !writeonly {

entry:
    %2 = gep @arr, 0
    %3 = trunc i64 %1 to i32
    store i32 %3, %2
    %4 = gep @arr, 1
    %5 = trunc i64 %0 to i32
    store i32 %5, %4
    ret i64 %0

}

define func @rev(%0: i64) i64 !writeonly {

entry:
    %1 = gep @arr, 1
    store i32 -1431655766, %1
    %2 = gep @arr, 0
    store i32 -1145324613, %2
    ret i64 %0

}
