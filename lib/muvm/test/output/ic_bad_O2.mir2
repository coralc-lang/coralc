// ---- module ----

module "ic_bad"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    %1 = gep %0, 0
    %2 = gep %1, 8
    %3 = gep %2, 8
    br unroll

unroll:
    %4 = phi i64 [0, entry], [%7, unroll]
    %5 = load i64 %1
    %6 = add i64 %5, 1
    store i64 %6, %1
    %7 = add i64 %4, 1
    %8 = icmp slt i64 %7, 4
    cond_br %8, unroll, unroll.1

unroll.1:
    %9 = phi i64 [0, unroll], [%12, unroll.1]
    %10 = load i64 %2
    %11 = add i64 %10, 1
    store i64 %11, %2
    %12 = add i64 %9, 1
    %13 = icmp slt i64 %12, 4
    cond_br %13, unroll.1, unroll.2

unroll.2:
    %14 = phi i64 [0, unroll.1], [%17, unroll.2]
    %15 = load i64 %3
    %16 = add i64 %15, 1
    store i64 %16, %3
    %17 = add i64 %14, 1
    %18 = icmp slt i64 %17, 4
    cond_br %18, unroll.2, done

done:
    ret i32 0
}
