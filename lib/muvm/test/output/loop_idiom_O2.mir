; ---- module ----

module "loop_idiom"

; ---- funcs ----

define func @countup() i64 !argmemonly !readnone {

entry:
    ret i64 378

}

define func @negstep(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [10, entry], [%4, loop]
    %2 = phi i64 [0, entry], [%3, loop]
    %3 = add i64 %2, 7
    %4 = add i64 %1, -1
    %5 = icmp sgt i64 %1, 0
    cond_br %5, loop, done

done:
    ret i64 %2

}
