// ---- module ----

module "clean"

// ---- strings ----

string @.Lcs48: "main";

string @.Lcs49: "?";

string @.Lcs51: "?";

string @.Lcs59: "?";

string @.Lcs65: "?";

string @.Lcs67: "?";

string @.Lcs73: "?";

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 5
    br fill

fill:
    %1 = phi i64 [0, entry], [%25, fill_body]
    %2 = icmp slt i64 %1, 5
    cond_br %2, fill_body, sum_pre

sum_pre:
    br sum

sum:
    %3 = phi i64 [0, sum_pre], [%9, sum_body]
    %4 = phi i64 [0, sum_pre], [%14, sum_body]
    %5 = icmp slt i64 %4, 5
    cond_br %5, sum_body, done

done:
    %6 = trunc i64 %3 to i32
    ret i32 %6

sum_body:
    call void @_trap(i64 0, i64 %4, i64 5, array i8 2 @.Lcs65, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %7  = gep %0, %4
    %8  = load i64 %7
    %9  = add i64 %3, %8
    %10 = xor i64 %3, %9 !loc = "?", 0, 0
    %11 = xor i64 %8, %9 !loc = "?", 0, 0
    %12 = and i64 %10, %11 !loc = "?", 0, 0
    %13 = ashr i64 %12, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %13, i64 0, array i8 2 @.Lcs67, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %14 = add i64 %4, 1
    %15 = xor i64 %4, %14 !loc = "?", 0, 0
    %16 = xor i64 1, %14 !loc = "?", 0, 0
    %17 = and i64 %15, %16 !loc = "?", 0, 0
    %18 = ashr i64 %17, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %18, i64 0, array i8 2 @.Lcs73, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    br sum

fill_body:
    call void @_trap(i64 0, i64 %1, i64 5, array i8 2 @.Lcs49, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    %19 = gep %0, %1
    %20 = add i64 %1, 1
    %21 = xor i64 %1, %20 !loc = "?", 0, 0
    %22 = xor i64 1, %20 !loc = "?", 0, 0
    %23 = and i64 %21, %22 !loc = "?", 0, 0
    %24 = ashr i64 %23, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %24, i64 0, array i8 2 @.Lcs51, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    store i64 %20, %19
    %25 = add i64 %1, 1
    %26 = xor i64 %1, %25 !loc = "?", 0, 0
    %27 = xor i64 1, %25 !loc = "?", 0, 0
    %28 = and i64 %26, %27 !loc = "?", 0, 0
    %29 = ashr i64 %28, 63 !loc = "?", 0, 0
    call void @_trap(i64 3, i64 %29, i64 0, array i8 2 @.Lcs59, i64 0, array i8 5 @.Lcs48) !loc = "?", 0, 0
    br fill

}

func @_trap() extern;
