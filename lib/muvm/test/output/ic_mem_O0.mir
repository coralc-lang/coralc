// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 12
    br outer

outer:
    %i = phi i64 [ 0, entry ], [ %in, olatch ]
    %oc = icmp slt i64 %i, 3
    cond_br %oc, inner_pre, done

done:
    %k0 = gep %arr, 0
    %v0 = load i64 %k0
    %k1 = gep %arr, 1
    %v1 = load i64 %k1
    %k2 = gep %arr, 2
    %v2 = load i64 %k2
    %k3 = gep %arr, 3
    %v3 = load i64 %k3
    %k4 = gep %arr, 4
    %v4 = load i64 %k4
    %k5 = gep %arr, 5
    %v5 = load i64 %k5
    %k6 = gep %arr, 6
    %v6 = load i64 %k6
    %k7 = gep %arr, 7
    %v7 = load i64 %k7
    %k8 = gep %arr, 8
    %v8 = load i64 %k8
    %k9 = gep %arr, 9
    %v9 = load i64 %k9
    %k10 = gep %arr, 10
    %v10 = load i64 %k10
    %k11 = gep %arr, 11
    %v11 = load i64 %k11
    %s01 = add i64 %v0, %v1
    %s23 = add i64 %v2, %v3
    %s45 = add i64 %v4, %v5
    %s67 = add i64 %v6, %v7
    %s89 = add i64 %v8, %v9
    %s1011 = add i64 %v10, %v11
    %s0123 = add i64 %s01, %s23
    %s4567 = add i64 %s45, %s67
    %s89a = add i64 %s89, %s1011
    %s1 = add i64 %s0123, %s4567
    %res = add i64 %s1, %s89a
    %r32 = trunc i64 %res to i32
    ret i32 %r32

inner_pre:
    br inner

inner:
    %j = phi i64 [ 0, inner_pre ], [ %jn, ilatch ]
    br ibody

ibody:
    %row = mul i64 %i, 4
    %idx = add i64 %row, %j
    %pa = gep %arr, %idx
    store i64 %idx, %pa
    br ilatch

ilatch:
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, olatch

olatch:
    %in = add i64 %i, 1
    br outer
}
