// ---- module ----

module "ic_mem"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 12
    br outer

outer:
    %1 = phi i64 [0, entry], [%45, olatch]
    %2 = icmp slt i64 %1, 3
    cond_br %2, inner_pre, done

done:
    %3  = gep %0, 0
    %4  = load i64 %3
    %5  = gep %0, 1
    %6  = load i64 %5
    %7  = gep %0, 2
    %8  = load i64 %7
    %9  = gep %0, 3
    %10 = load i64 %9
    %11 = gep %0, 4
    %12 = load i64 %11
    %13 = gep %0, 5
    %14 = load i64 %13
    %15 = gep %0, 6
    %16 = load i64 %15
    %17 = gep %0, 7
    %18 = load i64 %17
    %19 = gep %0, 8
    %20 = load i64 %19
    %21 = gep %0, 9
    %22 = load i64 %21
    %23 = gep %0, 10
    %24 = load i64 %23
    %25 = gep %0, 11
    %26 = load i64 %25
    %27 = add i64 %4, %6
    %28 = add i64 %8, %10
    %29 = add i64 %12, %14
    %30 = add i64 %16, %18
    %31 = add i64 %20, %22
    %32 = add i64 %24, %26
    %33 = add i64 %27, %28
    %34 = add i64 %29, %30
    %35 = add i64 %31, %32
    %36 = add i64 %33, %34
    %37 = add i64 %36, %35
    %38 = trunc i64 %37 to i32
    ret i32 %38

inner_pre:
    br inner

inner:
    %39 = phi i64 [0, inner_pre], [%43, ilatch]
    br ibody

ibody:
    %40 = mul i64 %1, 4
    %41 = add i64 %40, %39
    %42 = gep %0, %41
    store i64 %41, %42
    br ilatch

ilatch:
    %43 = add i64 %39, 1
    %44 = icmp slt i64 %43, 4
    cond_br %44, inner, olatch

olatch:
    %45 = add i64 %1, 1
    br outer

}
