// ---- module ----

module "vec_add"

// ---- funcs ----

func @f(%n: i64) i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i64 16
    %c = alloca array i64 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    %r = load i64 %c
    ret i64 %r

body:
    %ga = gep %a, %i
    %35 = load vector i64 2 %ga
    %gb = gep %b, %i
    %37 = load vector i64 2 %gb
    %36 = vadd vector i64 2 %35, %37
    %gc = gep %c, %i
    store vector i64 2 %36, %gc
    %in = add i64 %i, 2
    br loop
}
