// ---- module ----

module "vec_add"

// ---- funcs ----

func @f(%0: i64) i64 {
entry:
    %1 = alloca array i64 16
    %2 = alloca array i64 16
    %3 = alloca array i64 16
    %4 = load vector i64 2 %1
    %5 = load vector i64 2 %2
    %6 = vadd vector i64 2 %4, %5
    store vector i64 2 %6, %3
    %7 = gep %1, 2
    %8 = load vector i64 2 %7
    %9 = gep %2, 2
    %10 = load vector i64 2 %9
    %11 = vadd vector i64 2 %8, %10
    %12 = gep %3, 2
    store vector i64 2 %11, %12
    %13 = gep %1, 4
    %14 = load vector i64 2 %13
    %15 = gep %2, 4
    %16 = load vector i64 2 %15
    %17 = vadd vector i64 2 %14, %16
    %18 = gep %3, 4
    store vector i64 2 %17, %18
    %19 = gep %1, 6
    %20 = load vector i64 2 %19
    %21 = gep %2, 6
    %22 = load vector i64 2 %21
    %23 = vadd vector i64 2 %20, %22
    %24 = gep %3, 6
    store vector i64 2 %23, %24
    %25 = gep %1, 8
    %26 = load vector i64 2 %25
    %27 = gep %2, 8
    %28 = load vector i64 2 %27
    %29 = vadd vector i64 2 %26, %28
    %30 = gep %3, 8
    store vector i64 2 %29, %30
    %31 = gep %1, 10
    %32 = load vector i64 2 %31
    %33 = gep %2, 10
    %34 = load vector i64 2 %33
    %35 = vadd vector i64 2 %32, %34
    %36 = gep %3, 10
    store vector i64 2 %35, %36
    %37 = gep %1, 12
    %38 = load vector i64 2 %37
    %39 = gep %2, 12
    %40 = load vector i64 2 %39
    %41 = vadd vector i64 2 %38, %40
    %42 = gep %3, 12
    store vector i64 2 %41, %42
    %43 = gep %1, 14
    %44 = load vector i64 2 %43
    %45 = gep %2, 14
    %46 = load vector i64 2 %45
    %47 = vadd vector i64 2 %44, %46
    %48 = gep %3, 14
    store vector i64 2 %47, %48
    %49 = load i64 %3
    ret i64 %49
}
