// ---- module ----

module "nestflag"

// ---- funcs ----

func @nest(%flag: i64) i64 {
entry:
    %95 = icmp eq i64 %flag, 7
    br unroll

unroll:
    %88 = phi i64 [ 0, entry ], [ %93, unroll.2 ]
    cond_br %95, unroll.2, unroll.1

unroll.1:
    br unroll.2

unroll.2:
    %93 = add i64 %88, 1
    %94 = icmp slt i64 %93, 4
    cond_br %94, unroll, unroll.3

unroll.3:
    %108 = phi i64 [ 0, unroll.2 ], [ %113, unroll.3 ]
    %113 = add i64 %108, 1
    %114 = icmp slt i64 %113, 4
    cond_br %114, unroll.3, unroll.4

unroll.4:
    %128 = phi i64 [ 0, unroll.3 ], [ %133, unroll.4 ]
    %129 = phi i64 [ 0, unroll.3 ], [ %130, unroll.4 ]
    %130 = add i64 %129, 1
    %133 = add i64 %128, 1
    %134 = icmp slt i64 %133, 4
    cond_br %134, unroll.4, done

done:
    %ten = mul i64 %128, 10
    %s1 = add i64 %ten, 3
    %res = add i64 %s1, %129
    ret i64 %res
}

func @main() i32 {
entry:
    %r = call i64 @nest(i64 7)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}
