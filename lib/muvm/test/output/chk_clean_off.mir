// ---- module ----

module "clean"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 5
    br fill

fill:
    %1 = phi i64 [0, entry], [%13, fill_body]
    %2 = icmp slt i64 %1, 5
    cond_br %2, fill_body, sum_pre

sum_pre:
    br sum

sum:
    %3 = phi i64 [0, sum_pre], [%9, sum_body]
    %4 = phi i64 [0, sum_pre], [%10, sum_body]
    %5 = icmp slt i64 %4, 5
    cond_br %5, sum_body, done

done:
    %6 = trunc i64 %3 to i32
    ret i32 %6

sum_body:
    %7  = gep %0, %4
    %8  = load i64 %7
    %9  = add i64 %3, %8
    %10 = add i64 %4, 1
    br sum

fill_body:
    %11 = gep %0, %1
    %12 = add i64 %1, 1
    store i64 %12, %11
    %13 = add i64 %1, 1
    br fill

}
