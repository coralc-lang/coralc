; ---- module ----

module "divmod_pow2"

; ---- funcs ----

define func @t(%0: i32) i32 !readnone {

entry:
    %1 = sdiv i32 %0, 8
    %2 = srem i32 %0, 8
    %3 = udiv i32 %0, 16
    %4 = urem i32 %0, 16
    %5 = add i32 %1, %2
    %6 = add i32 %3, %4
    %7 = add i32 %5, %6
    ret i32 %7

}

define func @negdiv(%0: i32) i32 !readnone {

entry:
    %1 = sdiv i32 %0, -8
    ret i32 %1

}

define func @wide(%0: i64) i64 !readnone {

entry:
    %1 = sdiv i64 %0, 1024
    %2 = srem i64 %0, 1024
    %3 = add i64 %1, %2
    ret i64 %3

}
