// ---- module ----

module "licmparam"

// ---- funcs ----

func @main() i32 {
entry:
    %r = call i64 @invariant_square(i64 6)
    %t = trunc i64 %r to i32
    ret i32 %t
}

func @invariant_square(%n: i64) i64 {
entry:
    %inv = mul i64 %n, %n
    %58 = add i64 %inv, %inv
    %65 = add i64 %inv, %58
    %72 = add i64 %inv, %65
    %79 = add i64 %inv, %72
    %86 = add i64 %inv, %79
    %93 = add i64 %inv, %86
    ret i64 %93
}
