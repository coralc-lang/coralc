// ---- module ----

module "select_sidefx"

// ---- funcs ----

func @fa() i64 {
entry:
    ret i64 11
}

func @fb() i64 {
entry:
    ret i64 22
}

func @pick(%c: i1) i64 {
entry:
    %a = call i64 @fa()
    %b = call i64 @fb()
    cond_br %c, sel2br2, sel2br1

sel2br1:
    br sel2br2

sel2br2:
    %r = phi i64 [ %a, entry ], [ %b, sel2br1 ]
    ret i64 %r
}
