// ---- module ----

module "dedup"

// ---- strings ----

string @.Lcs21: "main";

string @.Lcs22: "?";

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 5
    call void @_trap(i64 0, i64 0, i64 5, array i8 2 @.Lcs22, i64 0, array i8 5 @.Lcs21) !loc = "?", 0, 0
    %1 = gep %0, 0
    store i64 1, %1
    br body

body:
    %2 = gep %0, 0
    store i64 1, %2
    %3 = gep %0, 0
    store i64 1, %3
    ret i32 0

}

func @_trap() extern;
