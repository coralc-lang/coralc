// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %ns, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 %s

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %ns = add i64 %s, %la
    %in = add i64 %i, 1
    br loop
}
