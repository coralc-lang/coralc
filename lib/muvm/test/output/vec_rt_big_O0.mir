    %131 = phi i64 [0, entry], [%142, latch]
    %132 = icmp slt i64 %131, 128
    cond_br %132, body, done

done:
    %133 = gep %2, 0
    %134 = load i64 %133
    %135 = gep %2, 127
    %136 = load i64 %135
    %137 = add i64 %134, %136
    ret i64 %137

