    %g127 = gep %a, 127
    store i64 %arg, %g127
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, latch ]
    %iv = icmp slt i64 %i, 128
    cond_br %iv, body, done

done:
    %h0 = gep %c, 0
    %r0 = load i64 %h0
    %hL = gep %c, 127
    %rL = load i64 %hL
    %sum = add i64 %r0, %rL
    ret i64 %sum

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %m = mul i64 %la, 3
    %gc = gep %c, %i
    store i64 %m, %gc
    br latch

latch:
    %in = add i64 %i, 1
    br loop
}
