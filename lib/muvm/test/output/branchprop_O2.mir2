// ---- module ----

module "branchprop_demo"

// ---- funcs ----

func @use_in_taken(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, taken, else

else:
    ret i64 0

taken:
    ret i64 7

}

func @use_in_else(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

else:
    ret i64 99

then:
    ret i64 1

}

func @use_both_after(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

else:
    br else

then:
    br then

}
