; ---- module ----

module "vec_rt_add"

; ---- funcs ----

define func @f() i64 {

entry:
    %0  = alloca array i64 16
    %1  = alloca array i64 16
    %2  = alloca array i64 16
    %3  = gep %0, 0
    store i64 1, %3
    %4  = gep %0, 1
    store i64 2, %4
    %5  = gep %0, 2
    store i64 3, %5
    %6  = gep %0, 3
    store i64 4, %6
    %7  = gep %0, 4
    store i64 5, %7
    %8  = gep %0, 5
    store i64 6, %8
    %9  = gep %0, 6
    store i64 7, %9
    %10 = gep %0, 7
    store i64 8, %10
    %11 = gep %0, 8
    store i64 9, %11
    %12 = gep %0, 9
    store i64 10, %12
    %13 = gep %0, 10
    store i64 11, %13
    %14 = gep %0, 11
    store i64 12, %14
    %15 = gep %0, 12
    store i64 13, %15
    %16 = gep %0, 13
    store i64 14, %16
    %17 = gep %0, 14
    store i64 15, %17
    %18 = gep %0, 15
    store i64 16, %18
    %19 = gep %1, 0
    store i64 10, %19
    %20 = gep %1, 1
    store i64 20, %20
    %21 = gep %1, 2
    store i64 30, %21
    %22 = gep %1, 3
    store i64 40, %22
    %23 = gep %1, 4
    store i64 50, %23
    %24 = gep %1, 5
    store i64 60, %24
    %25 = gep %1, 6
    store i64 70, %25
    %26 = gep %1, 7
    store i64 80, %26
    %27 = gep %1, 8
    store i64 90, %27
    %28 = gep %1, 9
    store i64 100, %28
    %29 = gep %1, 10
    store i64 110, %29
    %30 = gep %1, 11
    store i64 120, %30
    %31 = gep %1, 12
    store i64 130, %31
    %32 = gep %1, 13
    store i64 140, %32
    %33 = gep %1, 14
    store i64 150, %33
    %34 = gep %1, 15
    store i64 160, %34
    br loop

loop:
    %35 = phi i64 [0, entry], [%48, latch]
    %36 = icmp slt i64 %35, 16
    cond_br %36, body, done

done:
    %37 = gep %2, 0
    %38 = load i64 %37
    %39 = gep %2, 15
    %40 = load i64 %39
    %41 = add i64 %38, %40
    ret i64 %41

body:
    %42 = gep %0, %35
    %43 = load i64 %42
    %44 = gep %1, %35
    %45 = load i64 %44
    %46 = add i64 %43, %45
    %47 = gep %2, %35
    store i64 %46, %47
    br latch

latch:
    %48 = add i64 %35, 1
    br loop

}
