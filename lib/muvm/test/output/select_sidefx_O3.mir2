// ---- module ----

module "select_sidefx"

// ---- funcs ----

func @fa() i64 {

entry:
    ret i64 11

}

func @fb() i64 {

entry:
    ret i64 22

}

func @pick(%0: i1) i64 {

entry:
    %1 = call i64 @fa()
    %2 = call i64 @fb()
    cond_br %0, sel2br2, sel2br1

sel2br1:
    br sel2br2

sel2br2:
    %3 = phi i64 [%1, entry], [%2, sel2br1]
    ret i64 %3

}
