// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 8
    %c = alloca array i64 8
    %47 = load i64 %a
    store i64 %47, %c
    %55 = gep %a, 1
    %56 = load i64 %55
    %57 = gep %c, 1
    store i64 %56, %57
    %64 = gep %a, 2
    %65 = load i64 %64
    %66 = gep %c, 2
    store i64 %65, %66
    %73 = gep %a, 3
    %74 = load i64 %73
    %75 = gep %c, 3
    store i64 %74, %75
    %82 = gep %a, 4
    %83 = load i64 %82
    %84 = gep %c, 4
    store i64 %83, %84
    %91 = gep %a, 5
    %92 = load i64 %91
    %93 = gep %c, 5
    store i64 %92, %93
    %100 = gep %a, 6
    %101 = load i64 %100
    %102 = gep %c, 6
    store i64 %101, %102
    %109 = gep %a, 7
    %110 = load i64 %109
    %111 = gep %c, 7
    store i64 %110, %111
    ret i64 0
}
