// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 8
    %c = alloca array i64 8
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 8
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %28 = load vector i64 2 %ga
    %gc = gep %c, %i
    store vector i64 2 %28, %gc
    %in = add i64 %i, 2
    br loop
}
