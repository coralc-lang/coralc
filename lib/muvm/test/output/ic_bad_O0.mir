// ---- module ----

module "ic_bad"

// ---- funcs ----

func @main() i32 {
entry:
    %arr = alloca array i64 12
    br outer

outer:
    %i = phi i64 [ 0, entry ], [ %in, olatch ]
    %oc = icmp slt i64 %i, 3
    cond_br %oc, inner_pre, done

done:
    ret i32 0

inner_pre:
    br inner

inner:
    %j = phi i64 [ 0, inner_pre ], [ %jn, ilatch ]
    br ibody

ibody:
    %pa = gep %arr, %i
    %old = load i64 %pa
    %nw = add i64 %old, 1
    store i64 %nw, %pa
    br ilatch

ilatch:
    %jn = add i64 %j, 1
    %ic = icmp slt i64 %jn, 4
    cond_br %ic, inner, olatch

olatch:
    %in = add i64 %i, 1
    br outer
}
