; ---- module ----

module "ic_bad"

; ---- funcs ----

define func @main() i32 {

entry:
    %0 = alloca array i64 12
    br outer

outer:
    %1 = phi i64 [0, entry], [%9, olatch]
    %2 = icmp slt i64 %1, 3
    cond_br %2, inner_pre, done

done:
    ret i32 0

inner_pre:
    br inner

inner:
    %3 = phi i64 [0, inner_pre], [%7, ilatch]
    br ibody

ibody:
    %4 = gep %0, %1
    %5 = load i64 %4
    %6 = add i64 %5, 1
    store i64 %6, %4
    br ilatch

ilatch:
    %7 = add i64 %3, 1
    %8 = icmp slt i64 %7, 4
    cond_br %8, inner, olatch

olatch:
    %9 = add i64 %1, 1
    br outer

}
