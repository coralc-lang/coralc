; ---- module ----

module "parsed"

; ---- funcs ----

define func @main() i32 !argmemonly {

entry:
    %0 = alloca i64
    br loop

loop:
    %1 = phi ptr [%0, entry], [%1, body]
    %2 = load i64 %1
    %3 = icmp slt i64 %2, 7
    cond_br %3, body, done

done:
    %4 = trunc i64 %2 to i32
    ret i32 %4

body:
    store i64 7, %1
    br loop

}
