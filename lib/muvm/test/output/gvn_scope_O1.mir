// ---- module ----

module "gvn_scope"

// ---- funcs ----

func @same_text(%x: i64, %c: i1) i64 {
entry:
    cond_br %c, taken, other

other:
    %t2 = add i64 %x, 1
    ret i64 %t2

taken:
    %t1 = add i64 %x, 1
    ret i64 %t1
}

func @sibling_blocks(%x: i64, %c: i1) i64 {
entry:
    cond_br %c, taken, other

other:
    %t1 = add i64 %x, 7
    %t2 = add i64 %x, 8
    %r = add i64 %t1, %t2
    ret i64 %r

taken:
    %s1 = add i64 %x, 7
    ret i64 %s1
}

func @block_local(%x: i64) i64 {
entry:
    %_a3 = add i64 %x, 3
    ret i64 %_a3
}
