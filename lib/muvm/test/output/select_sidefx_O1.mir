// ---- module ----

module "select_sidefx"

// ---- funcs ----

func @fa() i64 !readnone {

entry:
    ret i64 11

}

func @fb() i64 !readnone {

entry:
    ret i64 22

}

func @pick(%0: i1) i64 !readnone {

entry:
    %1 = call i64 @fa()
    %2 = call i64 @fb()
    %3 = select i1 %0, i64 %1, i64 %2
    ret i64 %3

}
