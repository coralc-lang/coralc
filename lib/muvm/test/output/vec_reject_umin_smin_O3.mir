// ---- module ----

module "vec_reject_smin"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %255 = load vector i64 2 %a
    %280 = extractelement vector i64 2 %255, 0
    %68 = smin i64 %280, 100
    %279 = extractelement vector i64 2 %255, 1
    %78 = smin i64 %68, %279
    %85 = gep %a, 2
    %256 = load vector i64 2 %85
    %278 = extractelement vector i64 2 %256, 0
    %88 = smin i64 %78, %278
    %277 = extractelement vector i64 2 %256, 1
    %98 = smin i64 %88, %277
    %105 = gep %a, 4
    %257 = load vector i64 2 %105
    %276 = extractelement vector i64 2 %257, 0
    %108 = smin i64 %98, %276
    %275 = extractelement vector i64 2 %257, 1
    %118 = smin i64 %108, %275
    %125 = gep %a, 6
    %258 = load vector i64 2 %125
    %274 = extractelement vector i64 2 %258, 0
    %128 = smin i64 %118, %274
    %273 = extractelement vector i64 2 %258, 1
    %138 = smin i64 %128, %273
    %145 = gep %a, 8
    %259 = load vector i64 2 %145
    %272 = extractelement vector i64 2 %259, 0
    %148 = smin i64 %138, %272
    %271 = extractelement vector i64 2 %259, 1
    %158 = smin i64 %148, %271
    %165 = gep %a, 10
    %260 = load vector i64 2 %165
    %270 = extractelement vector i64 2 %260, 0
    %168 = smin i64 %158, %270
    %269 = extractelement vector i64 2 %260, 1
    %178 = smin i64 %168, %269
    %185 = gep %a, 12
    %261 = load vector i64 2 %185
    %268 = extractelement vector i64 2 %261, 0
    %188 = smin i64 %178, %268
    %267 = extractelement vector i64 2 %261, 1
    %198 = smin i64 %188, %267
    %205 = gep %a, 14
    %262 = load vector i64 2 %205
    %266 = extractelement vector i64 2 %262, 0
    %208 = smin i64 %198, %266
    %264 = extractelement vector i64 2 %262, 1
    %218 = smin i64 %208, %264
    ret i64 %218
}
