// ---- module ----

module "vec_broadcast"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %253 = load vector i64 2 %a
    %261 = vbroadcast vector i64 2 3
    %262 = vmul vector i64 2 %253, %261
    store vector i64 2 %262, %c
    %84 = gep %a, 2
    %254 = load vector i64 2 %84
    %263 = vmul vector i64 2 %254, %261
    %87 = gep %c, 2
    store vector i64 2 %263, %87
    %104 = gep %a, 4
    %255 = load vector i64 2 %104
    %264 = vmul vector i64 2 %255, %261
    %107 = gep %c, 4
    store vector i64 2 %264, %107
    %124 = gep %a, 6
    %256 = load vector i64 2 %124
    %265 = vmul vector i64 2 %256, %261
    %127 = gep %c, 6
    store vector i64 2 %265, %127
    %144 = gep %a, 8
    %257 = load vector i64 2 %144
    %266 = vmul vector i64 2 %257, %261
    %147 = gep %c, 8
    store vector i64 2 %266, %147
    %164 = gep %a, 10
    %258 = load vector i64 2 %164
    %267 = vmul vector i64 2 %258, %261
    %167 = gep %c, 10
    store vector i64 2 %267, %167
    %184 = gep %a, 12
    %259 = load vector i64 2 %184
    %268 = vmul vector i64 2 %259, %261
    %187 = gep %c, 12
    store vector i64 2 %268, %187
    %204 = gep %a, 14
    %260 = load vector i64 2 %204
    %269 = vmul vector i64 2 %260, %261
    %207 = gep %c, 14
    store vector i64 2 %269, %207
    ret i64 0
}
