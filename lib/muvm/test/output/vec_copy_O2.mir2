// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 8
    %1 = alloca array i64 8
    %2 = gep %0, 0
    %3 = gep %1, 0
    %4 = load i64 %2
    store i64 %4, %3
    %5 = gep %2, 8
    %6 = gep %3, 8
    %7 = load i64 %5
    store i64 %7, %6
    %8 = gep %5, 8
    %9 = gep %6, 8
    %10 = load i64 %8
    store i64 %10, %9
    %11 = gep %8, 8
    %12 = gep %9, 8
    %13 = load i64 %11
    store i64 %13, %12
    %14 = gep %11, 8
    %15 = gep %12, 8
    %16 = load i64 %14
    store i64 %16, %15
    %17 = gep %14, 8
    %18 = gep %15, 8
    %19 = load i64 %17
    store i64 %19, %18
    %20 = gep %17, 8
    %21 = gep %18, 8
    %22 = load i64 %20
    store i64 %22, %21
    %23 = gep %20, 8
    %24 = gep %21, 8
    %25 = load i64 %23
    store i64 %25, %24
    ret i64 0
}
