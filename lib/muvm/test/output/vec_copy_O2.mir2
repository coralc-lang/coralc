// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 8
    %c = alloca array i64 8
    %132 = load vector i64 2 %a
    store vector i64 2 %132, %c
    %64 = gep %a, 2
    %133 = load vector i64 2 %64
    %66 = gep %c, 2
    store vector i64 2 %133, %66
    %82 = gep %a, 4
    %134 = load vector i64 2 %82
    %84 = gep %c, 4
    store vector i64 2 %134, %84
    %100 = gep %a, 6
    %135 = load vector i64 2 %100
    %102 = gep %c, 6
    store vector i64 2 %135, %102
    ret i64 0
}
