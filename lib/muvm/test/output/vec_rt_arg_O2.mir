    store i64 %0, %16
    %17 = gep %1, 15
    store i64 %0, %17
    %18 = load vector i64 2 %1
    %19 = vbroadcast vector i64 2 3
    %20 = vmul vector i64 2 %18, %19
    store vector i64 2 %20, %2
    %21 = gep %1, 2
    %22 = load vector i64 2 %21
    %23 = vmul vector i64 2 %22, %19
    %24 = gep %2, 2
    store vector i64 2 %23, %24
    %25 = gep %1, 4
    %26 = load vector i64 2 %25
    %27 = vmul vector i64 2 %26, %19
    %28 = gep %2, 4
    store vector i64 2 %27, %28
    %29 = gep %1, 6
    %30 = load vector i64 2 %29
    %31 = vmul vector i64 2 %30, %19
    %32 = gep %2, 6
    store vector i64 2 %31, %32
    %33 = gep %1, 8
    %34 = load vector i64 2 %33
    %35 = vmul vector i64 2 %34, %19
    %36 = gep %2, 8
    store vector i64 2 %35, %36
    %37 = gep %1, 10
    %38 = load vector i64 2 %37
    %39 = vmul vector i64 2 %38, %19
    %40 = gep %2, 10
