// ---- module ----

module "vec_rt_arg"

// ---- funcs ----

func @f(%arg: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    store i64 %arg, %a
    %g1 = gep %a, 1
    store i64 %arg, %g1
    %g2 = gep %a, 2
    store i64 %arg, %g2
    %g3 = gep %a, 3
    store i64 %arg, %g3
    %g4 = gep %a, 4
    store i64 %arg, %g4
    %g5 = gep %a, 5
    store i64 %arg, %g5
    %g6 = gep %a, 6
    store i64 %arg, %g6
    %g7 = gep %a, 7
    store i64 %arg, %g7
    %g8 = gep %a, 8
    store i64 %arg, %g8
    %g9 = gep %a, 9
    store i64 %arg, %g9
    %g10 = gep %a, 10
    store i64 %arg, %g10
    %g11 = gep %a, 11
    store i64 %arg, %g11
    %g12 = gep %a, 12
    store i64 %arg, %g12
    %g13 = gep %a, 13
    store i64 %arg, %g13
    %g14 = gep %a, 14
    store i64 %arg, %g14
    %g15 = gep %a, 15
    store i64 %arg, %g15
    %291 = load vector i64 2 %a
    %299 = vbroadcast vector i64 2 3
    %300 = vmul vector i64 2 %291, %299
    store vector i64 2 %300, %c
    %135 = gep %a, 2
    %292 = load vector i64 2 %135
    %301 = vmul vector i64 2 %292, %299
    %138 = gep %c, 2
    store vector i64 2 %301, %138
    %155 = gep %a, 4
    %293 = load vector i64 2 %155
    %302 = vmul vector i64 2 %293, %299
    %158 = gep %c, 4
    store vector i64 2 %302, %158
    %175 = gep %a, 6
    %294 = load vector i64 2 %175
    %303 = vmul vector i64 2 %294, %299
    %178 = gep %c, 6
    store vector i64 2 %303, %178
    %195 = gep %a, 8
    %295 = load vector i64 2 %195
    %304 = vmul vector i64 2 %295, %299
    %198 = gep %c, 8
    store vector i64 2 %304, %198
    %215 = gep %a, 10
    %296 = load vector i64 2 %215
    %305 = vmul vector i64 2 %296, %299
    %218 = gep %c, 10
    store vector i64 2 %305, %218
    %235 = gep %a, 12
    %297 = load vector i64 2 %235
    %306 = vmul vector i64 2 %297, %299
    %238 = gep %c, 12
    store vector i64 2 %306, %238
    %255 = gep %a, 14
    %298 = load vector i64 2 %255
    %307 = vmul vector i64 2 %298, %299
    %258 = gep %c, 14
    store vector i64 2 %307, %258
    %317 = extractelement vector i64 2 %307, 1
    %r0 = load i64 %c
    %sum = add i64 %r0, %317
    ret i64 %sum
}
