// ---- module ----

module "vec_rt_arg"

// ---- funcs ----

func @f(%arg: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    store i64 %arg, %a
    %g1 = gep %a, 1
    store i64 %arg, %g1
    %g2 = gep %a, 2
    store i64 %arg, %g2
    %g3 = gep %a, 3
    store i64 %arg, %g3
    %g4 = gep %a, 4
    store i64 %arg, %g4
    %g5 = gep %a, 5
    store i64 %arg, %g5
    %g6 = gep %a, 6
    store i64 %arg, %g6
    %g7 = gep %a, 7
    store i64 %arg, %g7
    %g8 = gep %a, 8
    store i64 %arg, %g8
    %g9 = gep %a, 9
    store i64 %arg, %g9
    %g10 = gep %a, 10
    store i64 %arg, %g10
    %g11 = gep %a, 11
    store i64 %arg, %g11
    %g12 = gep %a, 12
    store i64 %arg, %g12
    %g13 = gep %a, 13
    store i64 %arg, %g13
    %g14 = gep %a, 14
    store i64 %arg, %g14
    %g15 = gep %a, 15
    store i64 %arg, %g15
    %82 = vbroadcast vector i64 2 3
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    %r0 = load i64 %c
    %h15 = gep %c, 15
    %r15 = load i64 %h15
    %sum = add i64 %r0, %r15
    ret i64 %sum

body:
    %ga = gep %a, %i
    %80 = load vector i64 2 %ga
    %81 = vmul vector i64 2 %80, %82
    %gc = gep %c, %i
    store vector i64 2 %81, %gc
    %in = add i64 %i, 2
    br loop
}
