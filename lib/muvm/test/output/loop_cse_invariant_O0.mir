; ---- module ----

module "lc_invariant2"

; ---- funcs ----

define func @run(%0: i64) i64 {

entry:
    %1 = alloca array i64 4
    %2 = gep %1, 0
    store i64 99, %2
    br loop

loop:
    %3 = phi i64 [0, entry], [%10, latch]
    %4 = phi i64 [0, entry], [%9, latch]
    %5 = gep %1, 0
    %6 = load i64 %5
    %7 = add i64 %6, 7
    %8 = mul i64 %7, 2
    %9 = add i64 %4, %8
    br latch

latch:
    %10 = add i64 %3, 1
    %11 = icmp slt i64 %10, %0
    cond_br %11, loop, done

done:
    ret i64 %9

}
