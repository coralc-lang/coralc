// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 {

entry:
    %0  = alloca array i64 16
    %1  = gep %0, 0
    store i64 1, %1
    %2  = gep %0, 1
    store i64 2, %2
    %3  = gep %0, 2
    store i64 3, %3
    %4  = gep %0, 3
    store i64 4, %4
    %5  = gep %0, 4
    store i64 5, %5
    %6  = gep %0, 5
    store i64 6, %6
    %7  = gep %0, 6
    store i64 7, %7
    %8  = gep %0, 7
    store i64 8, %8
    %9  = gep %0, 8
    store i64 9, %9
    %10 = gep %0, 9
    store i64 10, %10
    %11 = gep %0, 10
    store i64 11, %11
    %12 = gep %0, 11
    store i64 12, %12
    %13 = gep %0, 12
    store i64 13, %13
    %14 = gep %0, 13
    store i64 14, %14
    %15 = gep %0, 14
    store i64 15, %15
    %16 = gep %0, 15
    store i64 16, %16
    br loop

loop:
    %17 = phi i64 [0, entry], [%23, latch]
    %18 = phi i64 [0, entry], [%22, latch]
    %19 = icmp slt i64 %17, 16
    cond_br %19, body, done

done:
    ret i64 %18

body:
    %20 = gep %0, %17
    %21 = load i64 %20
    %22 = add i64 %18, %21
    br latch

latch:
    %23 = add i64 %17, 1
    br loop

}
