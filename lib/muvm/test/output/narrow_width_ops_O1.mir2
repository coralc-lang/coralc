func @t_sw_i32(%0: i32) i32 !readnone {

entry:
    switch i32 %0, default d [ i32 1, a, i32 2, b, i32 3, c]

c:
    ret i32 30

b:
    ret i32 20

a:
    ret i32 10

d:
    ret i32 0

}
