// ---- module ----

module "narrow"

// ---- funcs ----

func @t_abs_i8(%0: i8) i8 !readnone {

entry:
    %1 = abs i8 %0
    ret i8 %1

}

func @t_abs_i16(%0: i16) i16 !readnone {

entry:
    %1 = abs i16 %0
    ret i16 %1

}

func @t_abs_i32(%0: i32) i32 !readnone {

entry:
    %1 = abs i32 %0
    ret i32 %1

}

