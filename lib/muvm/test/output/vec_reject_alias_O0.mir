// ---- module ----

module "vec_reject_alias"

// ---- funcs ----

func @f(%0: i64) i64 {

entry:
    %1 = alloca array i64 16
    %2 = alloca array i64 16
    br loop

loop:
    %3 = phi i64 [0, entry], [%9, latch]
    %4 = icmp slt i64 %3, 16
    cond_br %4, body, done

done:
    ret i64 0

body:
    %5 = gep %1, %3
    %6 = load i64 %5
    %7 = gep %2, %3
    store i64 %6, %7
    %8 = gep %1, %0
    store i64 0, %8
    br latch

latch:
    %9 = add i64 %3, 1
    br loop

}
