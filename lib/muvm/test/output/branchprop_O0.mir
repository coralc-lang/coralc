; ---- module ----

module "branchprop_demo"

; ---- funcs ----

define func @use_in_taken(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, taken, else

else:
    ret i64 0

taken:
    %2 = add i64 %0, 1
    %3 = icmp slt i64 %0, 42
    %4 = select i1 %3, i64 7, i64 99
    ret i64 %4

}

define func @use_in_else(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

else:
    %2 = add i64 %0, 1
    %3 = icmp slt i64 %0, 42
    %4 = select i1 %3, i64 7, i64 99
    ret i64 %4

then:
    ret i64 1

}

define func @use_both_after(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

then:
    %2 = add i64 %0, 1
    cond_br %1, then, else

else:
    %3 = add i64 %0, 2
    cond_br %1, then, else

}
