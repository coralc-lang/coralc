// ---- module ----

module "licmparam"

// ---- funcs ----

func @main() i32 !readnone {

entry:
    %0 = call i64 @invariant_square(i64 6)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}

func @invariant_square(%0: i64) i64 !readnone {

entry:
    %1 = mul i64 %0, %0
    %2 = shl i64 %1, 1
    %3 = add i64 %1, %2
    %4 = add i64 %1, %3
    %5 = add i64 %1, %4
    %6 = add i64 %1, %5
    %7 = add i64 %1, %6
    ret i64 %7

}
