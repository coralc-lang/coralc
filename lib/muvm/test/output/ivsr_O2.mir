// ---- module ----

module "ivsr"

// ---- funcs ----

func @strred(%0: ptr, %1: i32) i32 {
entry:
    br loop

loop:
    %2 = phi i32 [0, entry], [%8, body]
    %3 = phi i32 [0, entry], [%9, body]
    %4 = icmp slt i32 %2, %1
    cond_br %4, body, done

done:
    ret i32 0

body:
    %5 = gep %0, %3
    %6 = load i32 %5
    %7 = add i32 %6, 1
    store i32 %7, %5
    %8 = add i32 %2, 1
    %9 = add i32 %3, 8
    br loop
}

func @shlcase(%0: ptr, %1: i64) i64 {
entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%9, body]
    %3 = phi i64 [0, entry], [%8, body]
    %4 = phi i64 [0, entry], [%10, body]
    %5 = icmp slt i64 %2, %1
    cond_br %5, body, done

done:
    ret i64 %3

body:
    %6 = gep %0, %4
    %7 = load i64 %6
    %8 = add i64 %3, %7
    %9 = add i64 %2, 2
    %10 = add i64 %4, 32
    br loop
}
