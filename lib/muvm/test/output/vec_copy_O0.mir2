// ---- module ----

module "vec_copy"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 8
    %1 = alloca array i64 8
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, latch]
    %3 = icmp slt i64 %2, 8
    cond_br %3, body, done

done:
    ret i64 0

body:
    %4 = gep %0, %2
    %5 = load i64 %4
    %6 = gep %1, %2
    store i64 %5, %6
    br latch

latch:
    %7 = add i64 %2, 1
    br loop
}
