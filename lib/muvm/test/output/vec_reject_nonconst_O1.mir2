; ---- module ----

module "vec_reject_nonconst"

; ---- funcs ----

define func @f(%0: i64) i64 !argmemonly {

entry:
    %1 = alloca array i64 16
    %2 = alloca array i64 16
    br loop

loop:
    %3 = phi i64 [0, entry], [%8, body]
    %4 = icmp slt i64 %3, %0
    cond_br %4, body, done

done:
    ret i64 0

body:
    %5 = gep %1, %3
    %6 = load i64 %5
    %7 = gep %2, %3
    store i64 %6, %7
    %8 = add i64 %3, 1
    br loop

}
