// ---- module ----

module "vec_reject_call"

// ---- funcs ----

func @side() i64 {
entry:
    ret i64 1
}

func @f() i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, latch ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %t = call i64 @side()
    %s = add i64 %la, %t
    %gc = gep %c, %i
    store i64 %s, %gc
    br latch

latch:
    %in = add i64 %i, 1
    br loop
}
