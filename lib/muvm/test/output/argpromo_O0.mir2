; ---- module ----

module "argpromo"

; ---- funcs ----

define func @deref(%0: ptr) i64 {

entry:
    %1 = load i64 %0
    %2 = load i64 %0
    %3 = add i64 %1, %2
    ret i64 %3

}

define func @sum2(%0: ptr, %1: i64) i64 {

entry:
    %2 = load i64 %0
    %3 = add i64 %2, %1
    ret i64 %3

}

define func @kept(%0: ptr) i64 {

entry:
    %1 = load i64 %0
    store i64 9, %0
    ret i64 %1

}

define func @use() i64 {

entry:
    %0 = alloca i64
    store i64 21, %0
    %1 = call i64 @deref(ptr i64 %0)
    %2 = call i64 @sum2(ptr i64 %0, i64 1)
    %3 = call i64 @kept(ptr i64 %0)
    %4 = add i64 %1, %2
    %5 = add i64 %4, %3
    ret i64 %5

}
