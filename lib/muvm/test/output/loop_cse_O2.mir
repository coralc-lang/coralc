// ---- module ----

module "loopcse_demo"

// ---- funcs ----

func @lc_invariant(%0: i64) i64 {
entry:
    %1 = alloca array i64 4
    store i64 30, %1
    %2 = gep %1, 1
    store i64 40, %2
    %3 = gep %1, 2
    store i64 50, %3
    %4 = gep %1, 3
    store i64 60, %4
    %5 = load i64 %1
    %6 = add i64 %5, 7
    %7 = mul i64 %6, 3
    br loop

loop:
    %8 = phi i64 [0, entry], [%11, loop]
    %9 = phi i64 [0, entry], [%10, loop]
    %10 = add i64 %9, %7
    %11 = add i64 %8, 1
    %12 = icmp slt i64 %11, %0
    cond_br %12, loop, done

done:
    ret i64 %10
}
