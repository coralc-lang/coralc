; ---- module ----

module "loopcse_demo"

; ---- funcs ----

define func @lc_invariant(%0: i64) i64 !argmemonly !writeonly {

entry:
    %1 = alloca array i64 4
    store i64 30, %1
    %2 = gep %1, 1
    store i64 40, %2
    %3 = gep %1, 2
    store i64 50, %3
    %4 = gep %1, 3
    store i64 60, %4
    br loop

loop:
    %5 = phi i64 [0, entry], [%8, loop]
    %6 = phi i64 [0, entry], [%7, loop]
    %7 = add i64 %6, 111
    %8 = add i64 %5, 1
    %9 = icmp slt i64 %8, %0
    cond_br %9, loop, done

done:
    ret i64 %7

}
