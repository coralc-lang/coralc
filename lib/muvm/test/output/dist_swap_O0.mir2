// ---- module ----

module "dist_swap"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 3
    %1 = alloca array i64 3
    %2 = alloca array i64 3
    %3 = alloca array i64 3
    %4 = gep %0, 0
    store i64 10, %4
    %5 = gep %0, 1
    store i64 20, %5
    %6 = gep %1, 0
    store i64 1, %6
    %7 = gep %1, 1
    store i64 2, %7
    br loop1

loop1:
    %8  = phi i64 [0, entry], [%34, body1]
    %9  = icmp slt i64 %8, 2
    %10 = gep %0, %8
    %11 = gep %1, %8
    %12 = load i64 %10
    %13 = load i64 %11
    store i64 %12, %11
    store i64 %13, %10
    cond_br %9, body1, loop2_pre

loop2_pre:
    br loop2

loop2:
    %14 = phi i64 [0, loop2_pre], [%33, body2]
    %15 = icmp slt i64 %14, 2
    %16 = gep %0, %14
    %17 = load i64 %16
    %18 = add i64 %17, 10
    %19 = gep %2, %14
    store i64 %18, %19
    %20 = gep %1, %14
    %21 = load i64 %20
    %22 = add i64 %21, 20
    %23 = gep %3, %14
    store i64 %22, %23
    cond_br %15, body2, done

done:
    %24 = gep %0, 1
    %25 = load i64 %24
    %26 = gep %2, 1
    %27 = load i64 %26
    %28 = gep %3, 1
    %29 = load i64 %28
    %30 = add i64 %25, %27
    %31 = add i64 %30, %29
    %32 = trunc i64 %31 to i32
    ret i32 %32

body2:
    %33 = add i64 %14, 1
    br loop2

body1:
    %34 = add i64 %8, 1
    br loop1

}
