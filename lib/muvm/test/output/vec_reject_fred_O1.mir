; ---- module ----

module "vec_reject_fred"

; ---- funcs ----

define func @f() f64 !readonly !argmemonly {

entry:
    %0 = alloca array f64 8
    br loop

loop:
    %1 = phi i64 [0, entry], [%7, body]
    %2 = phi f64 [0.0, entry], [%6, body]
    %3 = icmp slt i64 %1, 8
    cond_br %3, body, done

done:
    ret f64 %2

body:
    %4 = gep %0, %1
    %5 = load f64 %4
    %6 = fadd f64 %2, %5
    %7 = add i64 %1, 1
    br loop

}
