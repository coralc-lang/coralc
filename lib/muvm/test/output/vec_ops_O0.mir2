; ---- module ----

module "vec_ops"

; ---- funcs ----

define func @main() i32 {

entry:
    %0 = vbroadcast vector i32 4 3
    %1 = vbroadcast vector i32 4 7
    %2 = vadd vector i32 4 %0, %1
    %3 = vmin vector i32 4 %2, %1
    %4 = extractelement vector i32 4 %3, 2
    %5 = insertelement vector i32 4 %3, i32 30, 2
    %6 = extractelement vector i32 4 %5, 2
    %7 = shufflevector vector i32 4 %5, %1, 2, 1, 0, 3
    %8 = extractelement vector i32 4 %7, 1
    %9 = add i32 %6, %8
    ret i32 %9

}
