// ---- module ----

module "vec_reject_smin"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 16
    %1 = load vector i64 2 %0
    %2 = extractelement vector i64 2 %1, 0
    %3 = smin i64 %2, 100
    %4 = extractelement vector i64 2 %1, 1
    %5 = smin i64 %3, %4
    %6 = gep %0, 2
    %7 = load vector i64 2 %6
    %8 = extractelement vector i64 2 %7, 0
    %9 = smin i64 %5, %8
    %10 = extractelement vector i64 2 %7, 1
    %11 = smin i64 %9, %10
    %12 = gep %0, 4
    %13 = load vector i64 2 %12
    %14 = extractelement vector i64 2 %13, 0
    %15 = smin i64 %11, %14
    %16 = extractelement vector i64 2 %13, 1
    %17 = smin i64 %15, %16
    %18 = gep %0, 6
    %19 = load vector i64 2 %18
    %20 = extractelement vector i64 2 %19, 0
    %21 = smin i64 %17, %20
    %22 = extractelement vector i64 2 %19, 1
    %23 = smin i64 %21, %22
    %24 = gep %0, 8
    %25 = load vector i64 2 %24
    %26 = extractelement vector i64 2 %25, 0
    %27 = smin i64 %23, %26
    %28 = extractelement vector i64 2 %25, 1
    %29 = smin i64 %27, %28
    %30 = gep %0, 10
    %31 = load vector i64 2 %30
    %32 = extractelement vector i64 2 %31, 0
    %33 = smin i64 %29, %32
    %34 = extractelement vector i64 2 %31, 1
    %35 = smin i64 %33, %34
    %36 = gep %0, 12
    %37 = load vector i64 2 %36
    %38 = extractelement vector i64 2 %37, 0
    %39 = smin i64 %35, %38
    %40 = extractelement vector i64 2 %37, 1
    %41 = smin i64 %39, %40
    %42 = gep %0, 14
    %43 = load vector i64 2 %42
    %44 = extractelement vector i64 2 %43, 0
    %45 = smin i64 %41, %44
    %46 = extractelement vector i64 2 %43, 1
    %47 = smin i64 %45, %46
    ret i64 %47
}
