// ---- module ----

module "oob"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = alloca array i64 5
    br loop

loop:
    %1 = phi i64 [0, entry], [%4, body]
    %2 = icmp slt i64 %1, 7
    cond_br %2, body, done

done:
    ret i32 0

body:
    %3 = gep %0, %1
    store i64 1, %3
    %4 = add i64 %1, 1
    br loop

}
