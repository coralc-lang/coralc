// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    store i64 1, %a
    %i1 = gep %a, 1
    store i64 2, %i1
    %i2 = gep %a, 2
    store i64 3, %i2
    %i3 = gep %a, 3
    store i64 4, %i3
    %i4 = gep %a, 4
    store i64 5, %i4
    %i5 = gep %a, 5
    store i64 6, %i5
    %i6 = gep %a, 6
    store i64 7, %i6
    %i7 = gep %a, 7
    store i64 8, %i7
    %i8 = gep %a, 8
    store i64 9, %i8
    %i9 = gep %a, 9
    store i64 10, %i9
    %i10 = gep %a, 10
    store i64 11, %i10
    %i11 = gep %a, 11
    store i64 12, %i11
    %i12 = gep %a, 12
    store i64 13, %i12
    %i13 = gep %a, 13
    store i64 14, %i13
    %i14 = gep %a, 14
    store i64 15, %i14
    %i15 = gep %a, 15
    store i64 16, %i15
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %s = phi i64 [ 0, entry ], [ %ns, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 %s

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %ns = add i64 %s, %la
    %in = add i64 %i, 1
    br loop
}
