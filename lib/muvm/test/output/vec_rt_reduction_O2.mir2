// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    store i64 1, %a
    %i1 = gep %a, 1
    store i64 2, %i1
    %i2 = gep %a, 2
    store i64 3, %i2
    %i3 = gep %a, 3
    store i64 4, %i3
    %i4 = gep %a, 4
    store i64 5, %i4
    %i5 = gep %a, 5
    store i64 6, %i5
    %i6 = gep %a, 6
    store i64 7, %i6
    %i7 = gep %a, 7
    store i64 8, %i7
    %i8 = gep %a, 8
    store i64 9, %i8
    %i9 = gep %a, 9
    store i64 10, %i9
    %i10 = gep %a, 10
    store i64 11, %i10
    %i11 = gep %a, 11
    store i64 12, %i11
    %i12 = gep %a, 12
    store i64 13, %i12
    %i13 = gep %a, 13
    store i64 14, %i13
    %i14 = gep %a, 14
    store i64 15, %i14
    %i15 = gep %a, 15
    store i64 16, %i15
    %109 = load i64 %a
    %117 = gep %a, 1
    %118 = load i64 %117
    %119 = add i64 %109, %118
    %126 = gep %a, 2
    %127 = load i64 %126
    %128 = add i64 %119, %127
    %135 = gep %a, 3
    %136 = load i64 %135
    %137 = add i64 %128, %136
    %144 = gep %a, 4
    %145 = load i64 %144
    %146 = add i64 %137, %145
    %153 = gep %a, 5
    %154 = load i64 %153
    %155 = add i64 %146, %154
    %162 = gep %a, 6
    %163 = load i64 %162
    %164 = add i64 %155, %163
    %171 = gep %a, 7
    %172 = load i64 %171
    %173 = add i64 %164, %172
    %180 = gep %a, 8
    %181 = load i64 %180
    %182 = add i64 %173, %181
    %189 = gep %a, 9
    %190 = load i64 %189
    %191 = add i64 %182, %190
    %198 = gep %a, 10
    %199 = load i64 %198
    %200 = add i64 %191, %199
    %207 = gep %a, 11
    %208 = load i64 %207
    %209 = add i64 %200, %208
    %216 = gep %a, 12
    %217 = load i64 %216
    %218 = add i64 %209, %217
    %225 = gep %a, 13
    %226 = load i64 %225
    %227 = add i64 %218, %226
    %234 = gep %a, 14
    %235 = load i64 %234
    %236 = add i64 %227, %235
    %243 = gep %a, 15
    %244 = load i64 %243
    %245 = add i64 %236, %244
    ret i64 %245
}
