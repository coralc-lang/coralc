// ---- module ----

module "vec_rt_reduction"

// ---- funcs ----

func @f() i64 !argmemonly {

entry:
    %0  = alloca array i64 16
    store i64 1, %0
    %1  = gep %0, 1
    store i64 2, %1
    %2  = gep %0, 2
    store i64 3, %2
    %3  = gep %0, 3
    store i64 4, %3
    %4  = gep %0, 4
    store i64 5, %4
    %5  = gep %0, 5
    store i64 6, %5
    %6  = gep %0, 6
    store i64 7, %6
    %7  = gep %0, 7
    store i64 8, %7
    %8  = gep %0, 8
    store i64 9, %8
    %9  = gep %0, 9
    store i64 10, %9
    %10 = gep %0, 10
    store i64 11, %10
    %11 = gep %0, 11
    store i64 12, %11
    %12 = gep %0, 12
    store i64 13, %12
    %13 = gep %0, 13
    store i64 14, %13
    %14 = gep %0, 14
    store i64 15, %14
    %15 = gep %0, 15
    store i64 16, %15
    %16 = load vector i64 2 %0
    %17 = extractelement vector i64 2 %16, 0
    %18 = extractelement vector i64 2 %16, 1
    %19 = add i64 %17, %18
    %20 = gep %0, 2
    %21 = load vector i64 2 %20
    %22 = extractelement vector i64 2 %21, 0
    %23 = add i64 %19, %22
    %24 = extractelement vector i64 2 %21, 1
    %25 = add i64 %23, %24
    %26 = gep %0, 4
    %27 = load vector i64 2 %26
    %28 = extractelement vector i64 2 %27, 0
    %29 = add i64 %25, %28
    %30 = extractelement vector i64 2 %27, 1
    %31 = add i64 %29, %30
    %32 = gep %0, 6
    %33 = load vector i64 2 %32
    %34 = extractelement vector i64 2 %33, 0
    %35 = add i64 %31, %34
    %36 = extractelement vector i64 2 %33, 1
    %37 = add i64 %35, %36
    %38 = gep %0, 8
    %39 = load vector i64 2 %38
    %40 = extractelement vector i64 2 %39, 0
    %41 = add i64 %37, %40
    %42 = extractelement vector i64 2 %39, 1
    %43 = add i64 %41, %42
    %44 = gep %0, 10
    %45 = load vector i64 2 %44
    %46 = extractelement vector i64 2 %45, 0
    %47 = add i64 %43, %46
    %48 = extractelement vector i64 2 %45, 1
    %49 = add i64 %47, %48
    %50 = gep %0, 12
    %51 = load vector i64 2 %50
    %52 = extractelement vector i64 2 %51, 0
    %53 = add i64 %49, %52
    %54 = extractelement vector i64 2 %51, 1
    %55 = add i64 %53, %54
    %56 = gep %0, 14
    %57 = load vector i64 2 %56
    %58 = extractelement vector i64 2 %57, 0
    %59 = add i64 %55, %58
    %60 = extractelement vector i64 2 %57, 1
    %61 = add i64 %59, %60
    ret i64 %61

}
