// ---- module ----

module "multibreak"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = call i64 @ticket(i64 10)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}

func @ticket(%0: i64) i64 {

entry:
    %1 = icmp slt i64 %0, 1000
    cond_br %1, loop, exit

loop:
    %2 = phi i64 [0, entry], [%6, body]
    %3 = phi i64 [0, entry], [%5, body]
    %4 = icmp slt i64 %2, %0
    cond_br %4, body, loop.exit

body:
    %5 = add i64 %3, 2
    %6 = add i64 %2, 1
    %7 = icmp eq i64 %2, 3
    cond_br %7, loop.exit, loop

loop.exit:
    %8 = phi i64 [%3, loop], [%3, body]
    br exit

exit:
    %9  = phi i64 [0, entry], [%8, loop.exit], [%8, loop.exit]
    %10 = add i64 %9, 42
    ret i64 %10

}
