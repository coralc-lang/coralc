// ---- module ----

module "multibreak"

// ---- funcs ----

func @main() i32 {
entry:
    %r = call i64 @ticket(i64 10)
    %r32 = trunc i64 %r to i32
    ret i32 %r32
}

func @ticket(%n: i64) i64 {
entry:
    %useLoop = icmp slt i64 %n, 1000
    cond_br %useLoop, loop, exit

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %acc = phi i64 [ 0, entry ], [ %acc2, body ]
    %cmp2 = icmp slt i64 %i, %n
    cond_br %cmp2, body, loop.exit

body:
    %acc2 = add i64 %acc, 2
    %in = add i64 %i, 1
    %isBrk = icmp eq i64 %i, 3
    cond_br %isBrk, loop.exit, loop

loop.exit:
    %45 = phi i64 [ %acc, loop ], [ %acc, body ]
    br exit

exit:
    %ax = phi i64 [ 0, entry ], [ %45, loop.exit ], [ %45, loop.exit ]
    %r = add i64 %ax, 42
    ret i64 %r
}
