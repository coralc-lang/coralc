// ---- module ----

module "tco_acc"

// ---- funcs ----

func @sumto(%n: i64) i64 {
entry:
    br acc_loop

acc_loop:
    %25 = phi i64 [ 0, entry ], [ %36, step ]
    %26 = phi i64 [ %n, entry ], [ %33, step ]
    %30 = icmp sle i64 %26, 0
    cond_br %30, base, step

step:
    %33 = sub i64 %26, 1
    %36 = add i64 %25, %26
    br acc_loop

base:
    ret i64 %25
}

func @main() i32 {
entry:
    %v = call i64 @sumto(i64 5)
    %r = trunc i64 %v to i32
    ret i32 %r
}
