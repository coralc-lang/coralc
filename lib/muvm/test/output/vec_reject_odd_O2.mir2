// ---- module ----

module "vec_reject_odd"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %223 = load vector i64 2 %a
    store vector i64 2 %223, %c
    %78 = gep %a, 2
    %224 = load vector i64 2 %78
    %80 = gep %c, 2
    store vector i64 2 %224, %80
    %96 = gep %a, 4
    %225 = load vector i64 2 %96
    %98 = gep %c, 4
    store vector i64 2 %225, %98
    %114 = gep %a, 6
    %226 = load vector i64 2 %114
    %116 = gep %c, 6
    store vector i64 2 %226, %116
    %132 = gep %a, 8
    %227 = load vector i64 2 %132
    %134 = gep %c, 8
    store vector i64 2 %227, %134
    %150 = gep %a, 10
    %228 = load vector i64 2 %150
    %152 = gep %c, 10
    store vector i64 2 %228, %152
    %168 = gep %a, 12
    %229 = load vector i64 2 %168
    %170 = gep %c, 12
    store vector i64 2 %229, %170
    %186 = gep %a, 14
    %187 = load i64 %186
    %188 = gep %c, 14
    store i64 %187, %188
    ret i64 0
}
