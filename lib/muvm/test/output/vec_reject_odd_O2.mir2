// ---- module ----

module "vec_reject_odd"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 16
    %1 = alloca array i64 16
    %2 = load vector i64 2 %0
    store vector i64 2 %2, %1
    %3 = gep %0, 2
    %4 = load vector i64 2 %3
    %5 = gep %1, 2
    store vector i64 2 %4, %5
    %6 = gep %0, 4
    %7 = load vector i64 2 %6
    %8 = gep %1, 4
    store vector i64 2 %7, %8
    %9 = gep %0, 6
    %10 = load vector i64 2 %9
    %11 = gep %1, 6
    store vector i64 2 %10, %11
    %12 = gep %0, 8
    %13 = load vector i64 2 %12
    %14 = gep %1, 8
    store vector i64 2 %13, %14
    %15 = gep %0, 10
    %16 = load vector i64 2 %15
    %17 = gep %1, 10
    store vector i64 2 %16, %17
    %18 = gep %0, 12
    %19 = load vector i64 2 %18
    %20 = gep %1, 12
    store vector i64 2 %19, %20
    %21 = gep %0, 14
    %22 = load i64 %21
    %23 = gep %1, 14
    store i64 %22, %23
    ret i64 0
}
