// ---- module ----

module "vec_reduction"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %236 = load vector i64 2 %a
    %261 = extractelement vector i64 2 %236, 0
    %260 = extractelement vector i64 2 %236, 1
    %73 = add i64 %261, %260
    %80 = gep %a, 2
    %237 = load vector i64 2 %80
    %259 = extractelement vector i64 2 %237, 0
    %82 = add i64 %73, %259
    %258 = extractelement vector i64 2 %237, 1
    %91 = add i64 %82, %258
    %98 = gep %a, 4
    %238 = load vector i64 2 %98
    %257 = extractelement vector i64 2 %238, 0
    %100 = add i64 %91, %257
    %256 = extractelement vector i64 2 %238, 1
    %109 = add i64 %100, %256
    %116 = gep %a, 6
    %239 = load vector i64 2 %116
    %255 = extractelement vector i64 2 %239, 0
    %118 = add i64 %109, %255
    %254 = extractelement vector i64 2 %239, 1
    %127 = add i64 %118, %254
    %134 = gep %a, 8
    %240 = load vector i64 2 %134
    %253 = extractelement vector i64 2 %240, 0
    %136 = add i64 %127, %253
    %252 = extractelement vector i64 2 %240, 1
    %145 = add i64 %136, %252
    %152 = gep %a, 10
    %241 = load vector i64 2 %152
    %251 = extractelement vector i64 2 %241, 0
    %154 = add i64 %145, %251
    %250 = extractelement vector i64 2 %241, 1
    %163 = add i64 %154, %250
    %170 = gep %a, 12
    %242 = load vector i64 2 %170
    %249 = extractelement vector i64 2 %242, 0
    %172 = add i64 %163, %249
    %248 = extractelement vector i64 2 %242, 1
    %181 = add i64 %172, %248
    %188 = gep %a, 14
    %243 = load vector i64 2 %188
    %247 = extractelement vector i64 2 %243, 0
    %190 = add i64 %181, %247
    %245 = extractelement vector i64 2 %243, 1
    %199 = add i64 %190, %245
    ret i64 %199
}
