// ---- module ----

module "nonnull"

// ---- globals ----

global @z: i64 = 0 !alignment = 8;

// ---- strings ----

string @.Lcs10: "main";

string @.Lcs11: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %0 = load ptr @z
    call void @_trap(i64 1, ptr %0, i64 0, array i8 2 @.Lcs11, i64 0, array i8 5 @.Lcs10) !loc = "?", 0, 0
    %1 = load i64 %0
    %2 = trunc i64 %1 to i32
    ret i32 %2
}

func @_trap() extern;
