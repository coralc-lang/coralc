; ---- module ----

module "vec_add"

; ---- funcs ----

define func @f(%0: i64) i64 {

entry:
    %1 = alloca array i64 16
    %2 = alloca array i64 16
    %3 = alloca array i64 16
    br loop

loop:
    %4 = phi i64 [0, entry], [%14, latch]
    %5 = icmp slt i64 %4, 16
    cond_br %5, body, done

done:
    %6 = gep %3, 0
    %7 = load i64 %6
    ret i64 %7

body:
    %8  = gep %1, %4
    %9  = load i64 %8
    %10 = gep %2, %4
    %11 = load i64 %10
    %12 = add i64 %9, %11
    %13 = gep %3, %4
    store i64 %12, %13
    br latch

latch:
    %14 = add i64 %4, 1
    br loop

}
