// ---- module ----

module "unswitch"

// ---- funcs ----

func @pos(%0: i32, %1: i64) i64 !readnone {

entry:
    %2 = icmp ne i32 %0, 0
    cond_br %2, loop, done

loop:
    %3 = phi i64 [0, entry], [%6, body]
    %4 = icmp slt i64 %3, %1
    cond_br %4, body, done

done:
    %5 = phi i64 [%3, loop], [0, entry]
    ret i64 %5

body:
    %6 = add i64 %3, 1
    br loop

}

func @posarg(%0: i32, %1: i64) i64 !readnone {

entry:
    cond_br %0, loop, done

loop:
    %2 = phi i64 [0, entry], [%5, body]
    %3 = icmp slt i64 %2, %1
    cond_br %3, body, done

done:
    %4 = phi i64 [%2, loop], [0, entry]
    ret i64 %4

body:
    %5 = add i64 %2, 1
    br loop

}

func @neg(%0: i64) i64 !readnone {

entry:
    %1 = icmp slt i64 0, %0
    cond_br %1, unroll, done

unroll:
    %2 = icmp slt i64 1, %0
    cond_br %2, unroll.1, done

unroll.1:
    %3 = icmp slt i64 2, %0
    cond_br %3, unroll.2, done

unroll.2:
    %4 = icmp slt i64 3, %0
    cond_br %4, unroll.3, done

unroll.3:
    %5 = icmp slt i64 4, %0
    cond_br %5, unroll.4, done

unroll.4:
    %6 = icmp slt i64 5, %0
    cond_br %6, unroll.5, done

unroll.5:
    %7 = icmp slt i64 6, %0
    cond_br %7, unroll.6, done

unroll.6:
    %8 = icmp slt i64 7, %0
    cond_br %8, unroll.7, done

unroll.7:
    %9 = icmp slt i64 8, %0
    cond_br %9, unroll.8, done

unroll.8:
    %10 = icmp slt i64 9, %0
    cond_br %10, unroll.9, done

unroll.9:
    br done

done:
    %11 = phi i64 [0, entry], [1, unroll], [2, unroll.1], [3, unroll.2], [4, unroll.3], [5, unroll.4], [6, unroll.5], [7, unroll.6], [8, unroll.7], [9, unroll.8], [27, unroll.9], [30, unroll.9]
    ret i64 %11

}
