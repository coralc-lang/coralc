; ---- module ----

module "vec_reject_call"

; ---- funcs ----

define func @side() i64 {

entry:
    ret i64 1

}

define func @f() i64 {

entry:
    %0 = alloca array i64 16
    %1 = alloca array i64 16
    br loop

loop:
    %2 = phi i64 [0, entry], [%9, latch]
    %3 = icmp slt i64 %2, 16
    cond_br %3, body, done

done:
    ret i64 0

body:
    %4 = gep %0, %2
    %5 = load i64 %4
    %6 = call i64 @side()
    %7 = add i64 %5, %6
    %8 = gep %1, %2
    store i64 %7, %8
    br latch

latch:
    %9 = add i64 %2, 1
    br loop

}
