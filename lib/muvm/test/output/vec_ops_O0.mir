// ---- module ----

module "vec_ops"

// ---- funcs ----

func @main() i32 {
entry:
    %a = vbroadcast vector i32 4 3
    %b = vbroadcast vector i32 4 7
    %s = vadd vector i32 4 %a, %b
    %m = vmin vector i32 4 %s, %b
    %x = extractelement vector i32 4 %m, 2
    %y = insertelement vector i32 4 %m, i32 30, 2
    %z = extractelement vector i32 4 %y, 2
    %w = shufflevector vector i32 4 %y, %b, 2, 1, 0, 3
    %q = extractelement vector i32 4 %w, 1
    %r = add i32 %z, %q
    ret i32 %r
}
