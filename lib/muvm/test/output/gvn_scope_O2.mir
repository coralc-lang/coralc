// ---- module ----

module "gvn_scope"

// ---- funcs ----

func @same_text(%0: i64, %1: i1) i64 !readnone {

entry:
    %2 = add i64 %0, 1
    cond_br %1, taken, other

other:
    ret i64 %2

taken:
    ret i64 %2

}

func @sibling_blocks(%0: i64, %1: i1) i64 !readnone {

entry:
    cond_br %1, taken, other

other:
    %2 = add i64 %0, 7
    %3 = add i64 %0, 8
    %4 = add i64 %2, %3
    ret i64 %4

taken:
    %5 = add i64 %0, 7
    ret i64 %5

}

func @block_local(%0: i64) i64 !readnone {

entry:
    %1 = add i64 %0, 3
    ret i64 %1

}
