// ---- module ----

module "tco_acc"

// ---- funcs ----

func @sumto(%0: i64) i64 !readnone {

entry:
    br acc_loop

acc_loop:
    %1 = phi i64 [0, entry], [%5, step]
    %2 = phi i64 [%0, entry], [%4, step]
    %3 = icmp sle i64 %2, 0
    cond_br %3, base, step

step:
    %4 = sub i64 %2, 1
    %5 = add i64 %1, %2
    br acc_loop

base:
    ret i64 %1

}

func @main() i32 !readnone {

entry:
    %0 = call i64 @sumto(i64 5)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}
