// ---- module ----

module "overflow_add"

// ---- strings ----

string @.Lcs11: "main";

string @.Lcs12: "?";

string @.Lcs20: "?";

// ---- funcs ----

func @main() i32 {
entry:
    %0 = add i32 1073741823, 1073741824
    %1 = xor i32 1073741823, %0 !loc = "?", 0, 0
    %2 = xor i32 1073741824, %0 !loc = "?", 0, 0
    %3 = and i32 %1, %2 !loc = "?", 0, 0
    %4 = ashr i32 %3, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %4, i64 0, array i8 2 @.Lcs12, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    %5 = add i32 %0, 1
    %6 = xor i32 %0, %5 !loc = "?", 0, 0
    %7 = xor i32 1, %5 !loc = "?", 0, 0
    %8 = and i32 %6, %7 !loc = "?", 0, 0
    %9 = ashr i32 %8, 31 !loc = "?", 0, 0
    call void @_trap(i64 3, i32 %9, i64 0, array i8 2 @.Lcs20, i64 0, array i8 5 @.Lcs11) !loc = "?", 0, 0
    ret i32 %5
}

func @_trap() extern;
