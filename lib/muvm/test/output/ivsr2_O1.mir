// ---- module ----

module "ivsr2"

// ---- funcs ----

func @affine(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [0, entry], [%7, body]
    %2 = phi i64 [0, entry], [%6, body]
    %3 = icmp slt i64 %1, %0
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = mul i64 %1, 4
    %5 = add i64 %4, 7
    %6 = add i64 %2, %5
    %7 = add i64 %1, 1
    br loop

}

func @ivoff(%0: i64) i64 !readnone {

entry:
    br loop

loop:
    %1 = phi i64 [10, entry], [%6, body]
    %2 = phi i64 [0, entry], [%5, body]
    %3 = icmp slt i64 %1, %0
    cond_br %3, body, done

done:
    ret i64 %2

body:
    %4 = add i64 %1, 3
    %5 = add i64 %2, %4
    %6 = add i64 %1, 2
    br loop

}

func @ptriv(%0: i64) i64 !readonly !argmemonly {

entry:
    %1 = alloca array i64 8
    br loop

loop:
    %2 = phi i64 [0, entry], [%8, body]
    %3 = phi i64 [0, entry], [%7, body]
    %4 = icmp slt i64 %2, %0
    cond_br %4, body, done

done:
    ret i64 %3

body:
    %5 = gep %1, %2
    %6 = load i64 %5
    %7 = add i64 %3, %6
    %8 = add i64 %2, 1
    br loop

}

func @ptrneg(%0: ptr, %1: i64, %2: i64) i64 !readonly !argmemonly {

entry:
    br loop

loop:
    %3 = phi i64 [0, entry], [%9, body]
    %4 = phi i64 [0, entry], [%8, body]
    %5 = icmp slt i64 %3, %2
    cond_br %5, body, done

done:
    ret i64 %4

body:
    %6 = gep %0, %1
    %7 = load i64 %6
    %8 = add i64 %4, %7
    %9 = add i64 %3, 1
    br loop

}
