; ---- module ----

module "vec_reject_mixed"

; ---- funcs ----

define func @f() i64 !argmemonly {

entry:
    %0  = alloca array i64 16
    %1  = alloca array i32 16
    %2  = alloca array i64 16
    %3  = alloca array i32 16
    %4  = load vector i64 2 %0
    store vector i64 2 %4, %2
    %5  = load vector i32 4 %1
    store vector i32 4 %5, %3
    %6  = gep %0, 2
    %7  = load vector i64 2 %6
    %8  = gep %2, 2
    store vector i64 2 %7, %8
    %9  = gep %0, 4
    %10 = load vector i64 2 %9
    %11 = gep %2, 4
    store vector i64 2 %10, %11
    %12 = gep %1, 4
    %13 = load vector i32 4 %12
    %14 = gep %3, 4
    store vector i32 4 %13, %14
    %15 = gep %0, 6
    %16 = load vector i64 2 %15
    %17 = gep %2, 6
    store vector i64 2 %16, %17
    %18 = gep %0, 8
    %19 = load vector i64 2 %18
    %20 = gep %2, 8
    store vector i64 2 %19, %20
    %21 = gep %1, 8
    %22 = load vector i32 4 %21
    %23 = gep %3, 8
    store vector i32 4 %22, %23
    %24 = gep %0, 10
    %25 = load vector i64 2 %24
    %26 = gep %2, 10
    store vector i64 2 %25, %26
    %27 = gep %0, 12
    %28 = load vector i64 2 %27
    %29 = gep %2, 12
    store vector i64 2 %28, %29
    %30 = gep %1, 12
    %31 = load vector i32 4 %30
    %32 = gep %3, 12
    store vector i32 4 %31, %32
    %33 = gep %0, 14
    %34 = load vector i64 2 %33
    %35 = gep %2, 14
    store vector i64 2 %34, %35
    ret i64 0

}
