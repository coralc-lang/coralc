// ---- module ----

module "param_deref"

// ---- funcs ----

func @sum(%0: ptr !dereferenceable(8), %1: i64) i64 !readonly !argmemonly {

entry:
    %2 = load i64 %0
    br loop

loop:
    %3 = phi i64 [0, entry], [%7, body]
    %4 = phi i64 [0, entry], [%6, body]
    %5 = icmp slt i64 %3, %1
    cond_br %5, body, done

done:
    ret i64 %4

body:
    %6 = add i64 %4, %2
    %7 = add i64 %3, 1
    br loop

}

func @sumnd(%0: ptr, %1: i64) i64 !readonly !argmemonly {

entry:
    br loop

loop:
    %2 = phi i64 [0, entry], [%7, body]
    %3 = phi i64 [0, entry], [%6, body]
    %4 = icmp slt i64 %2, %1
    cond_br %4, body, done

done:
    ret i64 %3

body:
    %5 = load i64 %0
    %6 = add i64 %3, %5
    %7 = add i64 %2, 1
    br loop

}
