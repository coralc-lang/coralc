// ---- module ----

module "ic_bad"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca array i64 12
    %1 = gep %0, 1
    %2 = gep %0, 2
    br unroll

unroll:
    %3 = phi i64 [0, entry], [%6, unroll]
    %4 = load i64 %0
    %5 = add i64 %4, 1
    store i64 %5, %0
    %6 = add i64 %3, 1
    %7 = icmp slt i64 %6, 4
    cond_br %7, unroll, unroll.1

unroll.1:
    %8 = phi i64 [0, unroll], [%11, unroll.1]
    %9 = load i64 %1
    %10 = add i64 %9, 1
    store i64 %10, %1
    %11 = add i64 %8, 1
    %12 = icmp slt i64 %11, 4
    cond_br %12, unroll.1, unroll.2

unroll.2:
    %13 = phi i64 [0, unroll.1], [%16, unroll.2]
    %14 = load i64 %2
    %15 = add i64 %14, 1
    store i64 %15, %2
    %16 = add i64 %13, 1
    %17 = icmp slt i64 %16, 4
    cond_br %17, unroll.2, done

done:
    ret i32 0
}
