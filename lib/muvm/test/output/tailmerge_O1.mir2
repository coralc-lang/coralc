; ---- module ----

module "tailmerge"

; ---- funcs ----

define func @merge(%0: i64, %1: ptr) i64 !argmemonly {

entry:
    %2 = icmp ne i64 %0, 0
    cond_br %2, left, right

right:
    %3 = load i64 %1
    %4 = add i64 %3, 1
    store i64 %4, %1
    br join

left:
    %5 = load i64 %1
    %6 = add i64 %5, 1
    store i64 %6, %1
    br join

join:
    ret i64 0

}

define func @nomerge(%0: i64, %1: ptr) i64 !argmemonly {

entry:
    %2 = icmp ne i64 %0, 0
    cond_br %2, left, right

right:
    %3 = load i64 %1
    %4 = add i64 %3, 2
    store i64 %4, %1
    br join

left:
    %5 = load i64 %1
    %6 = add i64 %5, 1
    store i64 %6, %1
    br join

join:
    ret i64 0

}

define func @phidest(%0: i64, %1: ptr) i64 !readonly !argmemonly {

entry:
    %2 = icmp ne i64 %0, 0
    cond_br %2, lp, rp

rp:
    %3 = load i64 %1
    br j

lp:
    %4 = load i64 %1
    br j

j:
    %5 = phi i64 [%4, lp], [%3, rp]
    ret i64 %5

}

define func @twomerge(%0: i64, %1: i64, %2: ptr, %3: ptr) i64 !argmemonly {

entry:
    %4 = icmp ne i64 %0, 0
    cond_br %4, l1, r1

r1:
    %5 = load i64 %2
    %6 = add i64 %5, 1
    store i64 %6, %2
    br j1

l1:
    %7 = load i64 %2
    %8 = add i64 %7, 1
    store i64 %8, %2
    br j1

j1:
    %9 = icmp ne i64 %1, 0
    cond_br %9, l2, r2

r2:
    %10 = load i64 %3
    %11 = add i64 %10, 2
    store i64 %11, %3
    br j2

l2:
    %12 = load i64 %3
    %13 = add i64 %12, 2
    store i64 %13, %3
    br j2

j2:
    ret i64 0

}
