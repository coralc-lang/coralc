// ---- module ----

module "vec_reject_fred"

// ---- funcs ----

func @f() f64 {
entry:
    %a = alloca array f64 8
    %133 = load vector f64 2 %a
    %146 = extractelement vector f64 2 %133, 0
    %49 = fadd f64 0.0, %146
    %145 = extractelement vector f64 2 %133, 1
    %58 = fadd f64 %49, %145
    %65 = gep %a, 2
    %134 = load vector f64 2 %65
    %144 = extractelement vector f64 2 %134, 0
    %67 = fadd f64 %58, %144
    %143 = extractelement vector f64 2 %134, 1
    %76 = fadd f64 %67, %143
    %83 = gep %a, 4
    %135 = load vector f64 2 %83
    %142 = extractelement vector f64 2 %135, 0
    %85 = fadd f64 %76, %142
    %141 = extractelement vector f64 2 %135, 1
    %94 = fadd f64 %85, %141
    %101 = gep %a, 6
    %136 = load vector f64 2 %101
    %140 = extractelement vector f64 2 %136, 0
    %103 = fadd f64 %94, %140
    %138 = extractelement vector f64 2 %136, 1
    %112 = fadd f64 %103, %138
    ret f64 %112
}
