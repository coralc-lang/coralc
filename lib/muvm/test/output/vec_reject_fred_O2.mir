// ---- module ----

module "vec_reject_fred"

// ---- funcs ----

func @f() f64 {
entry:
    %0 = alloca array f64 8
    %1 = gep %0, 0
    %2 = load f64 %1
    %3 = fadd f64 0.0, %2
    %4 = gep %1, 8
    %5 = load f64 %4
    %6 = fadd f64 %3, %5
    %7 = gep %4, 8
    %8 = load f64 %7
    %9 = fadd f64 %6, %8
    %10 = gep %7, 8
    %11 = load f64 %10
    %12 = fadd f64 %9, %11
    %13 = gep %10, 8
    %14 = load f64 %13
    %15 = fadd f64 %12, %14
    %16 = gep %13, 8
    %17 = load f64 %16
    %18 = fadd f64 %15, %17
    %19 = gep %16, 8
    %20 = load f64 %19
    %21 = fadd f64 %18, %20
    %22 = gep %19, 8
    %23 = load f64 %22
    %24 = fadd f64 %21, %23
    ret f64 %24
}
