// ---- module ----

module "phi_swap"

// ---- funcs ----

func @rot(%0: i32) i32 !readnone {

entry:
    br loop

loop:
    %1 = phi i32 [0, entry], [%7, body]
    %2 = phi i32 [10, entry], [%3, body]
    %3 = phi i32 [20, entry], [%2, body]
    %4 = icmp slt i32 %1, %0
    cond_br %4, body, done

done:
    %5 = mul i32 %2, 100
    %6 = add i32 %5, %3
    ret i32 %6

body:
    %7 = add i32 %1, 1
    br loop

}

func @main() i32 !readnone {

entry:
    %0  = call i32 @rot(i32 0)
    %1  = icmp eq i32 %0, 1020
    %2  = zext i1 %1 to i32
    %3  = call i32 @rot(i32 1)
    %4  = icmp eq i32 %3, 2010
    %5  = zext i1 %4 to i32
    %6  = call i32 @rot(i32 2)
    %7  = icmp eq i32 %6, 1020
    %8  = zext i1 %7 to i32
    %9  = add i32 %2, %5
    %10 = add i32 %9, %8
    %11 = icmp eq i32 %10, 3
    %12 = zext i1 %11 to i32
    %13 = sub i32 0, %12
    ret i32 %13

}
