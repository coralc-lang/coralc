// ---- module ----

module "nested"

// ---- funcs ----

func @main() i32 {

entry:
    br outer

outer:
    %0 = phi i64 [0, entry], [%5, inner_done]
    %1 = phi i64 [0, entry], [%6, inner_done]
    %2 = phi i64 [0, entry], [%8, inner_done]
    %3 = icmp slt i64 %2, 4
    cond_br %3, inner_pre, done

done:
    %4 = trunc i64 %1 to i32
    ret i32 %4

inner_pre:
    br inner

inner:
    %5 = phi i64 [0, inner_pre], [%11, inner_body]
    %6 = phi i64 [%1, inner_pre], [%10, inner_body]
    %7 = icmp slt i64 %5, 3
    cond_br %7, inner_body, inner_done

inner_done:
    %8 = add i64 %2, 1
    br outer

inner_body:
    %9  = mul i64 %2, %5
    %10 = add i64 %6, %9
    %11 = add i64 %5, 1
    br inner

}
