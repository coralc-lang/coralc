// ---- module ----

module "vec_reject_alias"

// ---- funcs ----

func @f(%p: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    %gp = gep %a, %p
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    ret i64 0

body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %gc = gep %c, %i
    store i64 %la, %gc
    store i64 0, %gp
    %in = add i64 %i, 1
    br loop
}
