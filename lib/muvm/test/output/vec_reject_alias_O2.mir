// ---- module ----

module "vec_reject_alias"

// ---- funcs ----

func @f(%0: i64) i64 {

entry:
    %1  = alloca array i64 16
    %2  = alloca array i64 16
    %3  = gep %1, %0
    %4  = load vector i64 2 %1
    store vector i64 2 %4, %2
    store i64 0, %3
    %5  = gep %1, 2
    %6  = load vector i64 2 %5
    %7  = gep %2, 2
    store vector i64 2 %6, %7
    store i64 0, %3
    %8  = gep %1, 4
    %9  = load vector i64 2 %8
    %10 = gep %2, 4
    store vector i64 2 %9, %10
    store i64 0, %3
    %11 = gep %1, 6
    %12 = load vector i64 2 %11
    %13 = gep %2, 6
    store vector i64 2 %12, %13
    store i64 0, %3
    %14 = gep %1, 8
    %15 = load vector i64 2 %14
    %16 = gep %2, 8
    store vector i64 2 %15, %16
    store i64 0, %3
    %17 = gep %1, 10
    %18 = load vector i64 2 %17
    %19 = gep %2, 10
    store vector i64 2 %18, %19
    store i64 0, %3
    %20 = gep %1, 12
    %21 = load vector i64 2 %20
    %22 = gep %2, 12
    store vector i64 2 %21, %22
    store i64 0, %3
    %23 = gep %1, 14
    %24 = load vector i64 2 %23
    %25 = gep %2, 14
    store vector i64 2 %24, %25
    store i64 0, %3
    ret i64 0

}
