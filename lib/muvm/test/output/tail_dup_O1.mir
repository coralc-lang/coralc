// ---- module ----

module "traildup"

// ---- funcs ----

func @dup_test(%0: i64, %1: i64) i64 {

entry:
    %2 = icmp sgt i64 %0, 5
    cond_br %2, px, py

py:
    %3 = sub i64 0, %1
    ret i64 %3

px:
    %4 = mul i64 %0, 2
    ret i64 %4

}

func @main() i32 {

entry:
    %0 = call i64 @dup_test(i64 7, i64 3)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}
