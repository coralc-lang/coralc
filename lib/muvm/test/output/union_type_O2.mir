// ---- module ----

module "uniontype"

// ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @V = struct { f0: i32, f1: union @U };

// ---- funcs ----

func @main() i32 !writeonly {

entry:
    %0 = alloca union @U
    %1 = bitcast ptr union @U %0 to ptr i32
    store i32 42, %1
    ret i32 0

}
