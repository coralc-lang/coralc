// ---- module ----

module "vec_rt_add"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 16
    %b = alloca array i64 16
    %c = alloca array i64 16
    store i64 1, %a
    %i1 = gep %a, 1
    store i64 2, %i1
    %i2 = gep %a, 2
    store i64 3, %i2
    %i3 = gep %a, 3
    store i64 4, %i3
    %i4 = gep %a, 4
    store i64 5, %i4
    %i5 = gep %a, 5
    store i64 6, %i5
    %i6 = gep %a, 6
    store i64 7, %i6
    %i7 = gep %a, 7
    store i64 8, %i7
    %i8 = gep %a, 8
    store i64 9, %i8
    %i9 = gep %a, 9
    store i64 10, %i9
    %i10 = gep %a, 10
    store i64 11, %i10
    %i11 = gep %a, 11
    store i64 12, %i11
    %i12 = gep %a, 12
    store i64 13, %i12
    %i13 = gep %a, 13
    store i64 14, %i13
    %i14 = gep %a, 14
    store i64 15, %i14
    %i15 = gep %a, 15
    store i64 16, %i15
    store i64 10, %b
    %j1 = gep %b, 1
    store i64 20, %j1
    %j2 = gep %b, 2
    store i64 30, %j2
    %j3 = gep %b, 3
    store i64 40, %j3
    %j4 = gep %b, 4
    store i64 50, %j4
    %j5 = gep %b, 5
    store i64 60, %j5
    %j6 = gep %b, 6
    store i64 70, %j6
    %j7 = gep %b, 7
    store i64 80, %j7
    %j8 = gep %b, 8
    store i64 90, %j8
    %j9 = gep %b, 9
    store i64 100, %j9
    %j10 = gep %b, 10
    store i64 110, %j10
    %j11 = gep %b, 11
    store i64 120, %j11
    %j12 = gep %b, 12
    store i64 130, %j12
    %j13 = gep %b, 13
    store i64 140, %j13
    %j14 = gep %b, 14
    store i64 150, %j14
    %j15 = gep %b, 15
    store i64 160, %j15
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %in, body ]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done

done:
    %r0 = load i64 %c
    %g15 = gep %c, 15
    %r15 = load i64 %g15
    %sum = add i64 %r0, %r15
    ret i64 %sum

body:
    %ga = gep %a, %i
    %129 = load vector i64 2 %ga
    %gb = gep %b, %i
    %131 = load vector i64 2 %gb
    %130 = vadd vector i64 2 %129, %131
    %gc = gep %c, %i
    store vector i64 2 %130, %gc
    %in = add i64 %i, 2
    br loop
}
