// a call between the stores is a barrier
module "dse_call_barrier"

func @touch(%p: ptr) void {
entry:
    %v = load i64 %p
    ret
}

func @main(%c: i64) i32 {
entry:
    %p = alloca i64
    store i64 1, %p
    call void @touch(ptr %p)
    store i64 2, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
