#[[no_drop_all]]
// wasmlink <out.wasm> <in1.wasm|in1.wat> [in2 ...]
// .wat inputs are assembled first, then all modules merged.
import muvm::linker::wasm::link { wasmLinkWrite };
import muvm::assembly::wasm::encode { wasmAssemble };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import std::ios { println, eprintln };
import std::string { String };
import core::cchar { cchar };
import std::mman { alloc };

bool writeFile(str path, u8* data, usize len)
{
    Result<File, IoError> fo = fileOpen(path, "wb");
    if (fo.isErr()) return false;
    File f = fo.unwrap();
    Result<isize, IoError> wr = fileWrite(f, data, len);
    fileClose(f);
    return wr.isOk();
}

i32 main(i32 argc, cchar** argv)
{
    if (argc < 3)
    {
        eprintln("usage: wasmlink <out.wasm> <in...>  (.wat assembled on the fly)");
        return 1;
    }
    // collect inputs; assemble .wat to temp .wasm in memory is complex —
    // require .wasm inputs OR assemble wat to /tmp files
    str* paths = alloc<str>((usize)(argc - 2));
    u32 np = 0;
    for (i32 i = 2; i < argc; i++)
    {
        str p = str::fromCstr(argv[i]);
        // check extension .wat
        bool isWat = p.len >= 4;
        if (isWat)
        {
            str tail = str::fromParts(p.ptr + p.len - 4, 4);
            if (!tail.equals(".wat")) isWat = false;
        }
        if (isWat)
        {
            Result<String, IoError> rd = readFileToString(p);
            if (rd.isErr()) { eprintln("cannot read {}", p); return 1; }
            String src = rd.unwrap();
            String bin = String::new();
            String werr = String::new();
            u32 wl = 0;
            if (!wasmAssemble(src.asView(), &bin, &werr, &wl))
            {
                eprintln("{}:{}: {}", p, wl, werr.asView());
                return 1;
            }
            // unique temp name per wat input: /tmp/wll_XXXX.wasm
            char[64] tn;
            u8* q = (u8*)tn;
            str pre = "/tmp/wll_";
            for (u32 z = 0; z < 10; z++) q[z] = pre.ptr[z];
            q += 10;
            u32 v = np;
            for (u32 z = 0; z < 8; z++) { u32 d = (v >> 28) & 15; q[z] = (u8)(d < 10 ? '0' + d : 'a' + d - 10); v <<= 4; }
            q += 8;
            str suf = ".wasm";
            for (u32 z = 0; z < 5; z++) q[z] = suf.ptr[z];
            str tmp = str::fromParts((const u8*)tn, 23);
            if (!writeFile(tmp, bin.asU8(), bin.len)) { eprintln("cannot write tmp"); return 1; }
            paths[np++] = tmp;
            src.free();
        }
        else paths[np++] = p;
    }
    str outPath = str::fromCstr(argv[1]);
    str err = "";
    if (!wasmLinkWrite(paths, np, outPath, &err))
    {
        eprintln("link failed: {}", err);
        return 1;
    }
    println("{}: linked", outPath);
    return 0;
}
