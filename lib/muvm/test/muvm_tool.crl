#[[no_drop_all]]
// muvm driver test tool: parse a .ir module, run the muvm driver's
// function-stage pipeline (O0-O3), print the result.
// No backend exists yet, so this is the check-point for the driver:
// exit code 0 means the module round-triped the driver path cleanly.
// run.sh feeds every case through this binary and compares fixpoints.
import muvm::muvm { MuvmOptions, muvmOptions, muvmOptimize, muvmOptimizeModule, muvmStructureLane, muvmCompileModule, muvmCompileModuleForTarget, muvmCompileAsm, muvmCompileAsmForTarget, muvmEmitModuleAsmForTarget, muvmTarget, muvmDefaultTarget, muvmTargetCallingConvention, MuvmTarget, TargetArch, TargetOS, BackendKind, CallingConvention, OptLevel };
import muvm::passes::diagnostics::verify { muvmPassVerify };
import muvm::irtypes { IrContext, IrModule, IrFunc, irCtxCreate, irCtxDestroy };
import muvm::irParser { IrParser, new, destroy, parseModule, getError, getErrorLine };
import muvm::irPrinter { IrPrinter };
import std::fs { readFileToString, fileOpen, fileWrite, fileClose, File, IoError };
import std::ios { println, eprintln };

import core::cchar { cchar };
bool parseArch(str s, TargetArch* out)
{
    if (s.equals("x86_64") || s.equals("x86-64") || s.equals("amd64")) { *out = TargetArch::X86_64; return true; }
    if (s.equals("x86") || s.equals("i386") || s.equals("i686")) { *out = TargetArch::X86; return true; }
    if (s.equals("arm64") || s.equals("aarch64")) { *out = TargetArch::Arm64; return true; }
    if (s.equals("wasm32")) { *out = TargetArch::Wasm32; return true; }
    if (s.equals("wasm64")) { *out = TargetArch::Wasm64; return true; }
    return false;
}

bool parseOS(str s, TargetOS* out)
{
    if (s.equals("linux")) { *out = TargetOS::Linux; return true; }
    if (s.equals("windows") || s.equals("win")) { *out = TargetOS::Windows; return true; }
    if (s.equals("macos") || s.equals("darwin")) { *out = TargetOS::MacOS; return true; }
    if (s.equals("baremetal") || s.equals("bare-metal")) { *out = TargetOS::BareMetal; return true; }
    if (s.equals("unknown")) { *out = TargetOS::Unknown; return true; }
    return false;
}

bool parseBackend(str s, BackendKind* out)
{
    if (s.equals("fast") || s.equals("ffast")) { *out = BackendKind::Fast; return true; }
    if (s.equals("primary")) { *out = BackendKind::Primary; return true; }
    return false;
}

i32 main(i32 argc, cchar** argv)
{
    if (argc < 2)
    {
        eprintln("usage: muvm_tool <in.ir> [out.mir] [Debug|O0|O1|O2|O3] [--module] [--emit-asm] [--arch <arch>] [--os <os>] [--backend <backend>] [--safety] [--dumps] [--verbose] [--verify] [--verify-each] [--verify-before]");
        eprintln("       muvm_tool --emit-ir <in.ir> [Debug|O0|O1|O2|O3] [--module] [--safety] [--dumps] [--verbose] [--verify] [--verify-each] [--verify-before]");
        return 2;
    }
    str inPath = str::empty();
    str outPath = str::empty();
    bool emitIr = false;
    bool emitAsm = false;
    bool moduleMode = false;
    TargetArch targetArch = TargetArch::X86_64;
    TargetOS targetOS = TargetOS::Linux;
    BackendKind targetBackend = BackendKind::Fast;
    OptLevel levelOverride = (OptLevel)0xFFFFFFFFu;   // sentinel: no override
    bool dumps = false;
    bool verbose = false;
    bool verifyEach = false;
    bool verifyAfter = false;
    bool verifyBefore = false;
    u32 opt = (u32)OptLevel::O2;
    u32 nPos = 0;
    for (u32 ai = 1; ai < (u32)argc; ai++)
    {
        str a = str::fromCstr(argv[ai]);
        if (a.equals("--emit-ir")) { emitIr = true; continue; }
        if (a.equals("--emit-asm")) { emitAsm = true; continue; }
        if (a.equals("--win64") || a.equals("--windows")) { targetOS = TargetOS::Windows; continue; }
        if (a.equals("--arch"))
        {
            ai++;
            if (ai >= (u32)argc || !parseArch(str::fromCstr(argv[ai]), &targetArch))
            {
                eprintln("muvm_tool: invalid --arch");
                return 2;
            }
            continue;
        }
        if (a.equals("--os"))
        {
            ai++;
            if (ai >= (u32)argc || !parseOS(str::fromCstr(argv[ai]), &targetOS))
            {
                eprintln("muvm_tool: invalid --os");
                return 2;
            }
            continue;
        }
        if (a.equals("--backend"))
        {
            ai++;
            if (ai >= (u32)argc || !parseBackend(str::fromCstr(argv[ai]), &targetBackend))
            {
                eprintln("muvm_tool: invalid --backend");
                return 2;
            }
            continue;
        }
        if (a.equals("--module")) { moduleMode = true; continue; }
        if (a.equals("--safety")) { levelOverride = OptLevel::Debug; continue; }
        if (a.equals("--dumps")) { dumps = true; continue; }
        if (a.equals("--verbose")) { verbose = true; continue; }
        if (a.equals("--verify")) { verifyAfter = true; continue; }
        if (a.equals("--verify-each")) { verifyEach = true; continue; }
        if (a.equals("--verify-before")) { verifyBefore = true; continue; }
        if (a.equals("O0")) { opt = (u32)OptLevel::O0; continue; }
        if (a.equals("O1")) { opt = (u32)OptLevel::O1; continue; }
        if (a.equals("O2")) { opt = (u32)OptLevel::O2; continue; }
        if (a.equals("O3")) { opt = (u32)OptLevel::O3; continue; }
        if (a.equals("Debug") || a.equals("debug")) { opt = (u32)OptLevel::Debug; continue; }
        if (a.equals("--dumps")) { dumps = true; continue; }
        if (nPos == 0) { inPath = a; nPos = 1; continue; }
        if (nPos == 1) { outPath = a; nPos = 2; continue; }
    }
    if (inPath.len == 0)
    {
        eprintln("usage: muvm_tool <in.ir> [out.mir] [O0|O1|O2|O3] [--safety]");
        return 2;
    }

    Result<String, IoError> rd = readFileToString(inPath);
    if (rd.isErr())
    {
        eprintln("muvm_tool: cannot read {}", inPath);
        return 1;
    }
    String src = rd.unwrap();
    IrContext* ctx = irCtxCreate();
    IrParser p = new(ctx);
    IrModule* modd = parseModule(&p, src.asView());
    if (modd == null)
    {
        eprintln("{}:{}: {}", inPath, getErrorLine(&p), getError(&p));
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }

    OptLevel chosen = (levelOverride == (OptLevel)0xFFFFFFFFu) ? (OptLevel)opt : levelOverride;
    MuvmOptions o = muvmOptions(chosen);
    if (dumps) o.dumps = true;
    if (verbose) o.verbose = true;
    if (verifyEach) o.verify = true;
    MuvmTarget target = muvmTarget(targetArch, targetOS, targetBackend);
    CallingConvention targetCC = muvmTargetCallingConvention(target);
    bool verifyFail = false;
    if (moduleMode)
    {
        if (verifyBefore)
        {
            for (u32 i = 0; i < modd->nfuncs; i++)
            {
                IrFunc* f = modd->funcs[i];
                if (f == null || f->isExtern) continue;
                if (!muvmPassVerify(f, null)) { verifyFail = true; }
            }
        }
        if (!muvmOptimizeModule(modd, ctx, targetCC, o))
        {
            eprintln("muvm_tool: module optimization FAILED");
            return 3;
        }
        if (verifyAfter)
        {
            for (u32 i = 0; i < modd->nfuncs; i++)
            {
                IrFunc* f = modd->funcs[i];
                if (f == null || f->isExtern) continue;
                if (!muvmPassVerify(f, null)) { verifyFail = true; }
            }
        }
    }
    else
    {
        for (u32 i = 0; i < modd->nfuncs; i++)
        {
            IrFunc* f = modd->funcs[i];
            if (f == null || f->isExtern) continue;
            if (verifyBefore)
                if (!muvmPassVerify(f, null)) { verifyFail = true; }
            muvmOptimize(f, ctx, targetCC, o);
            muvmStructureLane(f, ctx, o);
            if (verifyAfter)
                if (!muvmPassVerify(f, null)) { verifyFail = true; }
        }
    }

    if (verifyFail) { eprintln("muvm_tool: IR verification FAILED"); return 3; }

    if (emitAsm)
    {
        str asmOut = moduleMode
            ? muvmEmitModuleAsmForTarget(modd, ctx, target)
            : muvmCompileAsmForTarget(modd, ctx, target, o);
        if (asmOut.len == 0 && modd->nfuncs > 0)
        {
            eprintln("muvm_tool: codegen backend not implemented for target");
            destroy(&p);
            src.free();
            irCtxDestroy(ctx);
            return 3;
        }
        println("{}", asmOut);
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }

    IrPrinter pr = IrPrinter::new();
    pr.printModule(modd);

    if (emitIr)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }

    if (outPath.len == 0)
    {
        println("{}", pr.output());
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 0;
    }
    Result<File, IoError> fo = fileOpen(outPath, "wb");
    if (fo.isErr())
    {
        eprintln("muvm_tool: cannot create {}", outPath);
        pr.destroy();
        destroy(&p);
        src.free();
        irCtxDestroy(ctx);
        return 1;
    }
    File f = fo.unwrap();
    fileWrite(f, pr.output().ptr, (usize)pr.output().len);
    fileClose(f);
    pr.destroy();
    destroy(&p);
    src.free();
    irCtxDestroy(ctx);
    return 0;
}
