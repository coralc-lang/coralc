// two compares feeding different branches in different blocks
module "mf_two_cmps"

func @main(%c: i64) i32 {
entry:
    %cmp1 = icmp slt i64 %c, 10
    %x = add i64 %c, 3
    %cmp2 = icmp sgt i64 %x, 100
    %y = mul i64 %x, 2
    cond_br %cmp1, first, second

first:
    ret i32 1

second:
    %z = add i64 %y, 9
    cond_br %cmp2, third, fourth

third:
    ret i32 2

fourth:
    ret i32 3
}
