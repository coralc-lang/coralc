// icmp may cross a store — compares are pure, reordering is safe
module "mf_cross_store"

func @main(%c: i64) i32 {
entry:
    %p = alloca i64
    %cmp = icmp ne i64 %c, 0
    store i64 %c, %p
    %v = load i64 %p
    %w = add i64 %v, 1
    cond_br %cmp, yes, no

yes:
    ret i32 1

no:
    ret i32 0
}
