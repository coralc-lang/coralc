// select(icmp slt a,b, a, b) -> smin; select(icmp sgt, a, b) -> smax
module "idiom_minmax"

func @mn(%a: i64, %b: i64) i64 {
entry:
    %c = icmp slt i64 %a, %b
    %r = select i1 %c, i64 %a, i64 %b
    ret i64 %r
}

func @mx(%a: i64, %b: i64) i64 {
entry:
    %c = icmp sgt i64 %a, %b
    %r = select i1 %c, i64 %a, i64 %b
    ret i64 %r
}

func @main(%c: i64) i32 {
entry:
    %m = call i64 @mn(i64 %c, i64 7)
    %x = call i64 @mx(i64 %c, i64 7)
    %s = add i64 %m, %x
    %t = trunc i64 %s to i32
    ret i32 %t
}
