// near-miss patterns that must NOT fold
module "idiom_neg"

func @main(%c: i64) i32 {
entry:
    %x = trunc i64 %c to i32
    // or of two unrelated shifts — not a rotate
    %a = shl i32 %x, 8
    %b = lshr i32 %x, 16    // 16 != 32-8
    %r = or i32 %a, %b
    // select whose arms are not the cmp operands — not minmax
    %one = add i64 %c, 0
    %two = add i64 %c, 1
    %cc = icmp slt i64 %c, 5
    %s = select i1 %cc, i64 %one, i64 %two
    %t = add i32 %r, %s
    ret i32 %t
}
