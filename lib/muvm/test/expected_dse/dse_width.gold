// ---- module ----

module "dse_width"

// ---- funcs ----

func @f(%0: i64) i32 {
entry:
    %1 = alloca i64
    store i64 111, %1
    store i32 7, %1
    %2 = load i64 %1
    %3 = trunc i64 %2 to i32
    ret i32 %3
}

func @g(%0: i64) i32 {
entry:
    %1 = alloca i64
    store i64 222, %1
    %2 = load i64 %1
    %3 = trunc i64 %2 to i32
    ret i32 %3
}
