// ---- module ----

module "dse_width"

// ---- funcs ----

func @f(%c: i64) i32 {
entry:
    %p = alloca i64
    store i64 111, %p
    store i32 7, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}

func @g(%c: i64) i32 {
entry:
    %p = alloca i64
    store i64 222, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
