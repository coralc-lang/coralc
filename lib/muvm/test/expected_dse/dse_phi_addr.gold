// ---- module ----

module "dse_phi_addr"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = alloca i64
    %2 = alloca i64
    %3 = gep %1, 0
    %4 = gep %2, 0
    %5 = icmp eq i64 %0, 0
    cond_br %5, pa, pb

pb:
    br merge

pa:
    br merge

merge:
    %6 = phi ptr [%3, pa], [%4, pb]
    store i64 2, %6
    %7 = load i64 %6
    %8 = trunc i64 %7 to i32
    ret i32 %8
}
