// ---- module ----

module "dse_phi_addr"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %a = alloca i64
    %b = alloca i64
    %ga = gep %a, 0
    %gb = gep %b, 0
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, pa, pb

pb:
    br merge

pa:
    br merge

merge:
    %p = phi ptr [ %ga, pa ], [ %gb, pb ]
    store i64 2, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
