// ---- module ----

module "dse_cross_block"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = alloca i64
    %2 = icmp eq i64 %0, 0
    cond_br %2, aa, bb

bb:
    store i64 2, %1
    br join

aa:
    store i64 1, %1
    br join

join:
    %3 = load i64 %1
    %4 = trunc i64 %3 to i32
    ret i32 %4
}
