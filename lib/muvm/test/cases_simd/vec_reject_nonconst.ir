// rejected: non-constant trip bound
module "vec_reject_nonconst"
func @f(%n: i64) i64 {
entry:
    %a = alloca array i64 16
    %c = alloca array i64 16
    br loop
loop:
    %i = phi i64 [0, entry], [%in, latch]
    %iv = icmp slt i64 %i, %n
    cond_br %iv, body, done
body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %gc = gep %c, %i
    store i64 %la, %gc
    br latch
latch:
    %in = add i64 %i, 1
    br loop
done:
    ret i64 0
}
