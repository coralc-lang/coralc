module "uniongep"

type @U = union { f0: i32, f1: f64, f2: i64 };
type @S = struct { f0: i32, f1: union @U };

func @main() i32 {
entry:
    %u = alloca union @U
    ; union field indices all overlap at offset 0: geps 0/1/2 on the
    ; same alloca must produce the same address
    %g0 = gep %u, 0
    %g2 = gep %u, 2
    %p0 = bitcast ptr i32 %g0 to ptr i32
    %p2 = bitcast ptr i64 %g2 to ptr i64
    store i64 42, %p2
    %v = load i32 %p0
    ; nested: struct field 1 is the union, then union field 1 — both
    ; hops must keep the right static types (i64 through f1)
    %s = alloca struct @S
    %sg = gep %s, 1
    %ug = gep %sg, 1
    %r = bitcast ptr f64 %ug to ptr f64
    %d = load f64 %r
    %c = fcmp olt f64 %d, 1.0
    %i = zext i1 %c to i32
    %r2 = add i32 %v, %i
    ret i32 %r2
}
