// vector<i32 x4>: broadcast, vadd, vmin, extract, insert, shuffle
// expect: 37
module "vec_ops"

func @main() i32 {
entry:
    %a = vbroadcast vector i32 4 3
    %b = vbroadcast vector i32 4 7
    %s = vadd vector i32 4 %a, %b        // [10,10,10,10]
    %m = vmin vector i32 4 %s, %b        // [7,7,7,7]
    %x = extractelement vector i32 4 %m, 2  // 7
    %y = insertelement vector i32 4 %m, i32 30, 2
    %z = extractelement vector i32 4 %y, 2  // 30
    %w = shufflevector vector i32 4 %y, %b, 2, 1, 0, 3
    %q = extractelement vector i32 4 %w, 1  // 7
    %r = add i32 %z, %q                  // 30+7 = 37
    ret i32 %r
}
