// fcmp ult: 1.5 <rel> 2.5 -> ordered preds true for lt/le, false for gt/ge/one;
// ueq/une/ult/... cover unordered semantics. arg bits passed per-arch.
module "fcmp_ult"

func @main(%a: f64, %b: f64) i32 {
entry:
    %r = fcmp ult f64 %a, %b
    %z = zext i1 %r to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
