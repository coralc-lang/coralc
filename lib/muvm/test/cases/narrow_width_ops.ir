module "narrow"

func @t_abs_i8(%v: i8) i8 {
entry:
    %a = abs i8 %v
    ret i8 %a
}

func @t_abs_i16(%v: i16) i16 {
entry:
    %a = abs i16 %v
    ret i16 %a
}

func @t_abs_i32(%v: i32) i32 {
entry:
    %a = abs i32 %v
    ret i32 %a
}

func @t_smin_i32(%a: i32, %b: i32) i32 {
entry:
    %r = smin i32 %a, %b
    ret i32 %r
}

func @t_umin_i16(%a: i16, %b: i16) i16 {
entry:
    %r = umin i16 %a, %b
    ret i16 %r
}

func @t_ctpop_i8(%v: i8) i32 {
entry:
    %r = ctpop i8 %v
    ret i32 %r
}

func @t_ctlz_i16(%v: i16) i32 {
entry:
    %r = ctlz i16 %v
    ret i32 %r
}

func @t_cttz_i32(%v: i32) i32 {
entry:
    %r = cttz i32 %v
    ret i32 %r
}

func @t_mulhi_i32(%a: i32, %b: i32) i32 {
entry:
    %r = mulhi i32 %a, %b
    ret i32 %r
}

func @t_smulhi_i16(%a: i16, %b: i16) i16 {
entry:
    %r = smulhi i16 %a, %b
    ret i16 %r
}

func @t_bswap_i16(%v: i16) i16 {
entry:
    %r = bswap i16 %v
    ret i16 %r
}

func @t_rotl_i8(%v: i8, %c: i8) i8 {
entry:
    %r = rotl i8 %v, %c
    ret i8 %r
}

func @t_sw_i32(%v: i32) i32 {
entry:
    switch i32 %v, default d [ i32 1, a, i32 2, b, i32 3, c ]
a:
    ret i32 10
b:
    ret i32 20
c:
    ret i32 30
d:
    ret i32 0
}
