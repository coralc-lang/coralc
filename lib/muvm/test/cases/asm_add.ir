// expect: 42
// "+r" inout output on the alloca pointer, "r" register input.
module "asm_add"

func @main() i32 {
entry:
    %res = alloca i64
    store i64 40, %res
    inlineasm void "addq %1, %0" : "+r,r" : "cc" (ptr %res, i64 2)
    %v = load i64 %res
    %v32 = trunc i64 %v to i32
    ret i32 %v32
}
