module "module_inline"

func @main() i32 {
entry:
    %a = call i64 @tiny(i64 5)
    %ah = call i64 @tiny_hint(i64 5)
    %aa = call i64 @always3(i64 0)
    %an = call i64 @neg_hint(i64 5)
    %b = call i64 @const42()
    %c = call i64 @param_const(i64 7)
    %d = call i64 @multi_ret(i64 0)
    %e = call i64 @switch_ret(i64 2)
    %f = call i64 @rec(i64 3)
    %g = call i64 @big_body(i64 1)
    %s1 = add i64 %a, %ah
    %s2 = add i64 %s1, %aa
    %s3 = add i64 %s2, %an
    %s4 = add i64 %s3, %b
    %s5 = add i64 %s4, %c
    %s6 = add i64 %s5, %d
    %s7 = add i64 %s6, %e
    %s8 = add i64 %s7, %f
    %s9 = add i64 %s8, %g
    %t = trunc i64 %s9 to i32
    ret i32 %t
}

func @tiny(%x: i64) i64 !linkage = 1 {
entry:
    %r = add i64 %x, 10
    ret i64 %r
}

func @tiny_hint(%x: i64) i64 !linkage = 1 !inlinehint = 1 {
entry:
    %r = add i64 %x, 20
    ret i64 %r
}

func @always3(%x: i64) i64 !linkage = 1 !inlinehint = 3 {
entry:
    br b1
b1:
    br b2
b2:
    br b3
b3:
    br b4
b4:
    br b5
b5:
    br b6
b6:
    br b7
b7:
    br b8
b8:
    br b9
b9:
    br b10
b10:
    br b11
b11:
    br b12
b12:
    br b13
b13:
    ret i64 99
}

func @neg_hint(%x: i64) i64 !linkage = 1 !inlinehint = -1 {
entry:
    %r = add i64 %x, 30
    ret i64 %r
}

func @const42() i64 !linkage = 1 !noinline = 1 {
entry:
    ret i64 42
}

func @param_const(%x: i64) i64 !linkage = 1 !noinline = 1 {
entry:
    %r = add i64 %x, 1
    ret i64 %r
}

func @multi_ret(%x: i64) i64 !linkage = 1 {
entry:
    %c = icmp eq i64 %x, 0
    cond_br %c, zero, nonzero
zero:
    ret i64 3
nonzero:
    ret i64 4
}

func @switch_ret(%x: i64) i64 !linkage = 1 {
entry:
    switch i64 %x, default other [ i64 1, one, i64 2, two ]
one:
    ret i64 11
two:
    ret i64 22
other:
    ret i64 33
}

func @rec(%n: i64) i64 !linkage = 1 {
entry:
    %c = icmp sle i64 %n, 0
    cond_br %c, done, step
step:
    %n1 = sub i64 %n, 1
    %r = call i64 @rec(i64 %n1)
    ret i64 %r
done:
    ret i64 0
}

func @big_body(%x: i64) i64 !linkage = 1 {
entry:
    %t1 = add i64 %x, 1
    %t2 = add i64 %t1, 1
    %t3 = add i64 %t2, 1
    %t4 = add i64 %t3, 1
    %t5 = add i64 %t4, 1
    %t6 = add i64 %t5, 1
    %t7 = add i64 %t6, 1
    %t8 = add i64 %t7, 1
    %t9 = add i64 %t8, 1
    %t10 = add i64 %t9, 1
    %t11 = add i64 %t10, 1
    %t12 = add i64 %t11, 1
    %t13 = add i64 %t12, 1
    %t14 = add i64 %t13, 1
    %t15 = add i64 %t14, 1
    %t16 = add i64 %t15, 1
    %t17 = add i64 %t16, 1
    %t18 = add i64 %t17, 1
    %t19 = add i64 %t18, 1
    %t20 = add i64 %t19, 1
    %t21 = add i64 %t20, 1
    %t22 = add i64 %t21, 1
    %t23 = add i64 %t22, 1
    %t24 = add i64 %t23, 1
    %t25 = add i64 %t24, 1
    %t26 = add i64 %t25, 1
    %t27 = add i64 %t26, 1
    %t28 = add i64 %t27, 1
    %t29 = add i64 %t28, 1
    %t30 = add i64 %t29, 1
    %t31 = add i64 %t30, 1
    %t32 = add i64 %t31, 1
    %t33 = add i64 %t32, 1
    %t34 = add i64 %t33, 1
    %t35 = add i64 %t34, 1
    %t36 = add i64 %t35, 1
    %t37 = add i64 %t36, 1
    %t38 = add i64 %t37, 1
    %t39 = add i64 %t38, 1
    %t40 = add i64 %t39, 1
    %t41 = add i64 %t40, 1
    %t42 = add i64 %t41, 1
    %t43 = add i64 %t42, 1
    %t44 = add i64 %t43, 1
    %t45 = add i64 %t44, 1
    %t46 = add i64 %t45, 1
    %t47 = add i64 %t46, 1
    %t48 = add i64 %t47, 1
    %t49 = add i64 %t48, 1
    %t50 = add i64 %t49, 1
    %t51 = add i64 %t50, 1
    %t52 = add i64 %t51, 1
    %t53 = add i64 %t52, 1
    %t54 = add i64 %t53, 1
    %t55 = add i64 %t54, 1
    ret i64 %t55
}
