module "storemerge"

global @arr: array i32 4;

; adjacent const stores to a global merge into one wide store
func @merge(%c: i64) i64 {
entry:
    %p0 = gep @arr, 0
    store i32 0x11111111, %p0
    %p1 = gep @arr, 1
    store i32 0x22222222, %p1
    ret i64 %c
}

; a load between the stores blocks the merge
func @split(%c: i64) i64 {
entry:
    %p0 = gep @arr, 2
    store i32 0x33333333, %p0
    %p1 = gep @arr, 3
    %v = load i32 %p1
    store i32 0x44444444, %p1
    %e = zext i32 %v to i64
    ret i64 %e
}

; non-adjacent offsets do not merge
func @gap(%c: i64) i64 {
entry:
    %p0 = gep @arr, 0
    store i32 1, %p0
    %p2 = gep @arr, 2
    store i32 2, %p2
    ret i64 %c
}

; non-constant values are left alone
func @dyn(%c: i64, %x: i64) i64 {
entry:
    %p0 = gep @arr, 0
    %t = trunc i64 %x to i32
    store i32 %t, %p0
    %p1 = gep @arr, 1
    %t2 = trunc i64 %c to i32
    store i32 %t2, %p1
    ret i64 %c
}

; descending store order still merges (lower addr supplies low bits)
func @rev(%c: i64) i64 {
entry:
    %p1 = gep @arr, 1
    store i32 0xAAAAAAAA, %p1
    %p0 = gep @arr, 0
    store i32 0xBBBBBBBB, %p0
    ret i64 %c
}
