// width rules: i32 after i64 does NOT kill; i64 after i32 DOES
module "dse_width"

func @f(%c: i64) i32 {
entry:
    %p = alloca i64
    store i64 111, %p
    store i32 7, %p          // narrower: keeps the i64 store
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}

func @g(%c: i64) i32 {
entry:
    %p = alloca i64
    store i32 7, %p          // narrower first
    store i64 222, %p        // wider second kills it
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
