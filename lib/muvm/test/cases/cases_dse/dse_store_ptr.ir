// pointer-typed stores: same slot overwritten — first store of ptr dies
module "dse_store_ptr"

func @main(%c: i64) i32 {
entry:
    %slot = alloca ptr
    %a = alloca i64
    %ga = gep %a, 0
    store ptr %ga, %slot
    store ptr %ga, %slot
    %lp = load ptr %slot
    %v = load i64 %lp
    %t = trunc i64 %v to i32
    ret i32 %t
}
