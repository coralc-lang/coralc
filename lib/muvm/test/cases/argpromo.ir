module "argpromo"

define func @deref(%p: ptr) i64 {
entry:
    %a = load i64 %p
    %b = load i64 %p
    %s = add i64 %a, %b
    ret i64 %s
}

define func @sum2(%p: ptr, %n: i64) i64 {
entry:
    %v = load i64 %p
    %w = add i64 %v, %n
    ret i64 %w
}

define func @kept(%p: ptr) i64 {
entry:
    %a = load i64 %p
    store i64 9, %p
    ret i64 %a
}

define func @use() i64 {
entry:
    %p = alloca i64
    store i64 21, %p
    %r1 = call i64 @deref(ptr %p)
    %r2 = call i64 @sum2(ptr %p, i64 1)
    %r3 = call i64 @kept(ptr %p)
    %s = add i64 %r1, %r2
    %t = add i64 %s, %r3
    ret i64 %t
}
