module "ivsr2"

; affine a*iv+b: (iv*4 + 7) should collapse to one recurrence phi,
; then +iv stays a plain add (two rec phis, no const)
func @affine(%n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [0, entry], [%in, body]
    %acc = phi i64 [0, entry], [%accn, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done
body:
    %m = mul i64 %i, 4
    %a = add i64 %m, 7
    %accn = add i64 %acc, %a
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %acc
}

; iv + const directly (a=1 affine), result carried by acc phi
func @ivoff(%n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [10, entry], [%in, body]
    %acc = phi i64 [0, entry], [%accn, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done
body:
    %a = add i64 %i, 3
    %accn = add i64 %acc, %a
    %in = add i64 %i, 2
    br loop
done:
    ret i64 %acc
}

; pointer IV over typed array elements: gep arr, i -> ptr phi
; stepping elemSize bytes per iteration
func @ptriv(%n: i64) i64 {
entry:
    %arr = alloca array i64 8
    br loop
loop:
    %i = phi i64 [0, entry], [%in, body]
    %acc = phi i64 [0, entry], [%accn, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done
body:
    %q = gep %arr, %i
    %v = load i64 %q
    %accn = add i64 %acc, %v
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %acc
}

; negative: gep index is not a recurrence phi (plain arg) — no transform
func @ptrneg(%arr: ptr, %k: i64, %n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [0, entry], [%in, body]
    %acc = phi i64 [0, entry], [%accn, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done
body:
    %q = gep %arr, %k
    %v = load i64 %q
    %accn = add i64 %acc, %v
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %acc
}
