// GVN: dominator-scoped expression table must match entries dominating
// the current block, and must not match sibling-block entries.
module "gvn_scope"

func @same_text(%x: i64, %c: i1) i64 {
entry:
    %t = add i64 %x, 1
    cond_br %c, taken, other

taken:
    %t1 = add i64 %x, 1
    ret i64 %t1

other:
    %t2 = add i64 %x, 1
    ret i64 %t2
}

func @sibling_blocks(%x: i64, %c: i1) i64 {
entry:
    cond_br %c, taken, other

taken:
    %s1 = add i64 %x, 7
    %s2 = add i64 %x, 8
    ret i64 %s1

other:
    %t1 = add i64 %x, 7
    %t2 = add i64 %x, 8
    %r = add i64 %t1, %t2
    ret i64 %r
}

func @block_local(%x: i64) i64 {
entry:
    %_a = add i64 %x, 3
    %_a2 = add i64 %x, 3
    %_a3 = add i64 %x, 3
    ret i64 %_a3
}
