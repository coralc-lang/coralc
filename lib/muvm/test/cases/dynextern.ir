module "dynextern"

func @host_fn(i64, ptr) i64 extern "dyn" "real_host_sym";
func @engine_cb() void extern "dyn" "engine_callback";
func @libc_fn(i32) i32 extern "libc.so.6" "printf";

func @main() i32 {
entry:
    %a = alloca i64
    %r = call i64 @host_fn(i64 1, ptr %a)
    call void @engine_cb()
    ret i32 0
}
