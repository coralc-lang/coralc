module "loop_idiom"

func @countup() i64 {
entry:
    %p = alloca i64
    store i64 42, %p
    %v = load i64 %p
    br loop

loop:
    %i = phi i64 [0, entry], [%i2, loop]
    %s = phi i64 [0, entry], [%s2, loop]
    %s2 = add i64 %s, %v
    %i2 = add i64 %i, 1
    %c = icmp slt i64 %i, 10
    cond_br %c, loop, done

done:
    ret i64 %s
}

func @negstep(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [10, entry], [%i2, loop]
    %s = phi i64 [0, entry], [%s2, loop]
    %s2 = add i64 %s, 7
    %i2 = add i64 %i, -1
    %c = icmp sgt i64 %i, 0
    cond_br %c, loop, done

done:
    ret i64 %s
}
