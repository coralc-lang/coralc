module "aa_basic"

func @main() i32 {
entry:
    %a = alloca i64
    %b = alloca i64
    %ag = gep %a, 0
    %ag2 = gep %a, 1
    %bg = gep %b, 0
    store i64 1, %ag
    store i64 2, %ag2
    store i64 3, %bg
    %x = load i64 %ag
    %y = load i64 %bg
    %bc = bitcast ptr %a to ptr
    %z = load i64 %bc
    %s = add i64 %x, %y
    %s2 = add i64 %s, %z
    %t = trunc i64 %s2 to i32
    ret i32 %t
}
