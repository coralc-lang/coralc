module "aa_phi_unknown"

func @mkptr() ptr {
entry:
    %a = alloca i64
    ret ptr %a
}

func @main(%c: i64) i32 {
entry:
    %a = alloca i64
    %ga = gep %a, 0
    %ext = call ptr @mkptr()
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, pa, pb

pa:
    br merge

pb:
    br merge

merge:
    %p = phi ptr [ %ga, pa ], [ %ext, pb ]
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
