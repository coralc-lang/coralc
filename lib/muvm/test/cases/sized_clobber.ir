module "sized_clobber"

; a store to a provably disjoint byte range inside the same object
; must not block store-to-load forwarding of the earlier store
func @fwd(%c: i64) i64 {
entry:
    %arr = alloca array i32 2
    %s0 = gep %arr, 0
    store i32 10, %s0
    %s1 = gep %arr, 1
    store i32 20, %s1
    %v = load i32 %s0
    %e = zext i32 %v to i64
    ret i64 %e
}

; a disjoint read must not keep an overwritten store alive:
; store10 is killed by store99 at the same offset; the load from
; lane 1 can't observe it
func @dead(%c: i64) i64 {
entry:
    %arr = alloca array i32 2
    %s0 = gep %arr, 0
    store i32 10, %s0
    %s1 = gep %arr, 1
    %v = load i32 %s1
    %s2 = gep %arr, 0
    store i32 99, %s2
    %e = zext i32 %v to i64
    ret i64 %e
}

; overlapping ranges must stay conservative: lane 0 i64 store
; covers both i32 halves, so the i32 load at offset 0 aliases
func @overlap(%c: i64) i64 {
entry:
    %arr = alloca array i64 1
    %w = gep %arr, 0
    store i64 0x1122334455667788, %w
    %h = gep %arr, 0
    %v = load i32 %h
    %e = zext i32 %v to i64
    ret i64 %e
}
