module "hoist"

; identical pure prefix in both arms -> hoisted into entry before cond_br
func @hoist(%c: i64, %x: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, left, right

left:
    %a1 = add i64 %x, 7
    %a2 = mul i64 %a1, 3
    %a3 = add i64 %a2, %x
    store i64 %a3, %p
    br join

right:
    %b1 = add i64 %x, 7
    %b2 = mul i64 %b1, 3
    %b3 = sub i64 %b2, %x
    store i64 %b3, %p
    br join

join:
    ret i64 0
}

; prefix differs (add 7 vs add 8) -> no hoist
func @diff(%c: i64, %x: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, left, right

left:
    %a1 = add i64 %x, 7
    %a2 = mul i64 %a1, 3
    store i64 %a2, %p
    br join

right:
    %b1 = add i64 %x, 8
    %b2 = mul i64 %b1, 3
    store i64 %b2, %p
    br join

join:
    ret i64 0
}

; prefix contains a load (not speculatable) -> no hoist
func @loadp(%c: i64, %x: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, left, right

left:
    %a1 = load i64 %p
    %a2 = add i64 %a1, %x
    store i64 %a2, %p
    br join

right:
    %b1 = load i64 %p
    %b2 = add i64 %b1, %x
    store i64 %b2, %p
    br join

join:
    ret i64 0
}

; right has a second predecessor -> hoisted value wouldn't dominate it
func @multipred(%c: i64, %d: i64, %x: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    %u = icmp ne i64 %d, 0
    cond_br %t, left, mid

mid:
    cond_br %u, right, join

left:
    %a1 = add i64 %x, 7
    store i64 %a1, %p
    br join

right:
    %b1 = add i64 %x, 7
    store i64 %b1, %p
    br join

join:
    ret i64 0
}
