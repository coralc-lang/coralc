// expect: 10
// seq_cst atomic add on a stack slot: 5 + 6 = 11
module "atomic_ops"

func @main() i32 {
entry:
    %p = alloca i64
    store i64 5, %p
    %old = atomic_rmw add i64 %p, 6, seq_cst
    %v = load i64 %p
    %v32 = trunc i64 %v to i32
    %o32 = trunc i64 %old to i32
    %r = add i32 %v32, %o32
    %r2 = sub i32 %r, 6                   // v=11, old=5 -> 11+5-6 = 10
    ret i32 %r2
}
