module "mergefunc"

define func @sq1(%x: i64) i64 {
entry:
    %a = mul i64 %x, %x
    ret i64 %a
}

define func @sq2(%x: i64) i64 {
entry:
    %b = mul i64 %x, %x
    ret i64 %b
}

define func @cube1(%x: i64) i64 {
entry:
    %a = mul i64 %x, %x
    %b = mul i64 %a, %x
    ret i64 %b
}

define func @cube2(%x: i64) i64 {
entry:
    %p = mul i64 %x, %x
    %q = mul i64 %p, %x
    ret i64 %q
}

define func @use() i64 {
entry:
    %p = alloca i64
    store i64 3, %p
    %v = load i64 %p
    %r1 = call i64 @sq1(i64 %v)
    %r2 = call i64 @sq2(i64 %v)
    %c1 = call i64 @cube1(i64 %v)
    %c2 = call i64 @cube2(i64 %v)
    %s = add i64 %r1, %r2
    %t = add i64 %c1, %c2
    %u = add i64 %s, %t
    ret i64 %u
}
