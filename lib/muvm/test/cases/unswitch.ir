// loop unswitching: an in-loop cond_br on a loop-invariant condition
// splits the loop into two specialized copies behind a preheader
// dispatch. @pos uses an argument-derived test (licm lifts the icmp
// out, then the cond is defined outside the loop); @neg's test depends
// on the induction variable and must stay put.
module "unswitch"

func @pos(%flag: i32, %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %inext, latch ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

body:
    %c = icmp ne i32 %flag, 0
    cond_br %c, work, bail

work:
    %acc = add i64 %i, 1
    br latch

bail:
    %ev = mul i64 %i, 3
    br done

latch:
    %inext = add i64 %i, 1
    br loop

done:
    %r = phi i64 [ %i, loop ], [ %ev, bail ]
    ret i64 %r
}

func @posarg(%flag: i32, %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %inext, latch ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

body:
    cond_br %flag, work, bail

work:
    %acc = add i64 %i, 2
    br latch

bail:
    %ev = mul i64 %i, 5
    br done

latch:
    %inext = add i64 %i, 1
    br loop

done:
    %r = phi i64 [ %i, loop ], [ %ev, bail ]
    ret i64 %r
}

func @neg(%n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [ 0, entry ], [ %inext, latch ]
    %cmp = icmp slt i64 %i, %n
    cond_br %cmp, body, done

body:
    %c = icmp slt i64 %i, 10
    cond_br %c, work, bail

work:
    %acc = add i64 %i, 1
    br latch

bail:
    %ev = mul i64 %i, 3
    br done

latch:
    %inext = add i64 %i, 1
    br loop

done:
    %r = phi i64 [ %i, loop ], [ %ev, bail ]
    ret i64 %r
}
