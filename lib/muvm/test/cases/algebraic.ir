// algebraic: instcombine-style local rewrites — strength reduction,
// const div/etc, extension chain collapse, min/max idempotent,
// ashr/shl recapture, lex-chain reorder.
module "algebraic_demo"

func @mul_pow2(%v: i64, %w: i64) i64 {
entry:
    %r1 = mul i64 %v, 16
    %r2 = mul i64 %v, 2
    %r3 = mul i64 %w, 8
    %a  = add i64 %r1, %r2
    %b  = add i64 %a, %r3
    ret i64 %b
}

func @udiv_1(%v: i64) i64 {
entry:
    %a = udiv i64 %v, 1
    %b = udiv i64 %a, 4
    ret i64 %b
}

func @urem_1(%v: i64) i64 {
entry:
    %a = urem i64 %v, 1
    ret i64 %a
}

func @smin_same(%v: i64) i64 {
entry:
    %a = smin i64 %v, %v
    %b = smin i64 %v, %v
    %c = add i64 %a, %b
    ret i64 %c
}

func @lex_chain(%a: i64, %b: i64, %c: i64) i64 {
entry:
    %x = add i64 %b, 4
    %y = add i64 %a, %x
    %z = add i64 %c, %y
    ret i64 %z
}

func @ext_chain(%x: i32) i64 {
entry:
    %a = sext i32 %x to i64
    %b = sext i64 %a to i64
    ret i64 %b
}
