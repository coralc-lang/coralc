// icmp separated from cond_br by harmless ALU ops — should move adjacent
module "mf_basic"

func @main(%c: i64) i32 {
entry:
    %a = add i64 %c, 1
    %b = mul i64 %a, 3
    %cmp = icmp slt i64 %b, 100
    %d = add i64 %b, 7
    %e = xor i64 %d, 5
    cond_br %cmp, yes, no

yes:
    ret i32 1

no:
    ret i32 0
}
