// icmp result used by an add before the branch — must not move past the user
module "mf_nonterm_use"

func @main(%c: i64) i32 {
entry:
    %cmp = icmp slt i64 %c, 10
    %ci = zext i1 %cmp to i64
    %s = add i64 %ci, 40
    %cmp2 = icmp sgt i64 %s, 50
    cond_br %cmp2, yes, no

yes:
    ret i32 1

no:
    ret i32 0
}
