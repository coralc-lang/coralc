// cmp feeding another cmp's operand region — second cmp must not be
// crossed by the first; also neither should move past a user
module "mf_cmp_chain"

func @main(%c: i64) i32 {
entry:
    %cmp1 = icmp slt i64 %c, 10
    %cmp2 = icmp sgt i64 %c, 5
    %both = and i1 %cmp1, %cmp2
    cond_br %both, yes, no

yes:
    ret i32 1

no:
    ret i32 0
}
