module "divmod_pow2"

func @t(%x: i32) i32 {
entry:
    %q1 = sdiv i32 %x, 8
    %r1 = srem i32 %x, 8
    %q2 = udiv i32 %x, 16
    %r2 = urem i32 %x, 16
    %a = add i32 %q1, %r1
    %b = add i32 %q2, %r2
    %c = add i32 %a, %b
    ret i32 %c
}

func @negdiv(%x: i32) i32 {
entry:
    %q = sdiv i32 %x, -8
    ret i32 %q
}

func @wide(%x: i64) i64 {
entry:
    %q = sdiv i64 %x, 1024
    %r = srem i64 %x, 1024
    %s = add i64 %q, %r
    ret i64 %s
}
