// (x<5)||(x>=5)&&(x<3)||(x>=3) style adjacency -> (x<5)||(x>=5) covers all -> true
// simpler: (x<=5)||(x>5)&&(x<9)||(x>=9) nested; use flat: (x<5)||(x>=5) is all -> but needs 3 clauses for instCount
// (x<5)||(x==5)||(x>5)&&(x<9) -> clauses [.,5],{5},(5,9) -> union [.,9) minus? gap check: {5} adjacent to both -> merges all -> x<9||x==5 -> hmm
// keep it simple: (x<10)||(x>=10)&&(x<20)||(x>=20) -> all integers -> true
module "range_or_adjacent"

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp slt i64 %x, 10
    %c2 = icmp sge i64 %x, 10
    %c3 = icmp slt i64 %x, 20
    %c4 = icmp sge i64 %x, 20
    %l = or i1 %c1, %c2
    %h = or i1 %c3, %c4
    %r = or i1 %l, %h
    %z = zext i1 %r to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
