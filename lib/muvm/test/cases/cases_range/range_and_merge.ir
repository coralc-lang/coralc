// (x>3)&&(x>5)&&(x>7)&&(x<10) -> And(x>7, x<10); weaker bounds become dead
module "range_and_merge"

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp sgt i64 %x, 3
    %c2 = icmp sgt i64 %x, 5
    %c3 = icmp sgt i64 %x, 7
    %c4 = icmp slt i64 %x, 10
    %l = and i1 %c1, %c2
    %h = and i1 %c3, %c4
    %r = and i1 %l, %h
    %z = zext i1 %r to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
