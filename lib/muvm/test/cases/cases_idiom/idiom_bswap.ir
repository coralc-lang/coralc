// classic bswap32 or-chain -> bswap
module "idiom_bswap"

func @main(%c: i64) i32 {
entry:
    %x = trunc i64 %c to i32
    %s0 = shl i32 %x, 24
    %t0 = and i32 %s0, 4278190080   // 0xFF000000
    %s1 = shl i32 %x, 8
    %t1 = and i32 %s1, 16711680     // 0x00FF0000
    %s2 = lshr i32 %x, 8
    %t2 = and i32 %s2, 65280        // 0x0000FF00
    %s3 = lshr i32 %x, 24
    %t3 = and i32 %s3, 255          // 0x000000FF
    %o1 = or i32 %t0, %t1
    %o2 = or i32 %o1, %t2
    %r = or i32 %o2, %t3
    %t = trunc i64 %r to i32
    ret i32 %t
}
