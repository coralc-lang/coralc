// fadd(fmul(a,b),c) -> fma; result 2*3+4=10 -> fcmp ogt 9.5 -> 1
module "idiom_fma"

func @main(%c: i64) i32 {
entry:
    %a = sitofp i64 %c to f64
    %m = fmul f64 %a, 2.0
    %r = fadd f64 %m, 4.0
    %half = fadd f64 %a, 0.5
    %chk = fcmp ogt f64 %r, %half
    %z = zext i1 %chk to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
