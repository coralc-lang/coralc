module "tailmerge"

; identical load/add/store tails in both diamond arms -> shared tm block
define func @merge(%c: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, left, right

left:
    %a = load i64 %p
    %b = add i64 %a, 1
    store i64 %b, %p
    br join

right:
    %d = load i64 %p
    %e = add i64 %d, 1
    store i64 %e, %p
    br join

join:
    ret i64 0
}

; tails differ (add 1 vs add 2) -> no merge
define func @nomerge(%c: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, left, right

left:
    %a = load i64 %p
    %b = add i64 %a, 1
    store i64 %b, %p
    br join

right:
    %d = load i64 %p
    %e = add i64 %d, 2
    store i64 %e, %p
    br join

join:
    ret i64 0
}

; join has a phi -> tailmerge must reject (phi translation unsupported)
define func @phidest(%c: i64, %p: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, lp, rp

lp:
    %a = load i64 %p
    br j

rp:
    %d = load i64 %p
    br j

j:
    %j = phi i64 [%a, lp], [%d, rp]
    ret i64 %j
}

; two independent diamonds in one func -> tm0 and tm1 must be distinct
define func @twomerge(%c: i64, %d: i64, %p: ptr, %q: ptr) i64 {
entry:
    %t = icmp ne i64 %c, 0
    cond_br %t, l1, r1

l1:
    %a = load i64 %p
    %b = add i64 %a, 1
    store i64 %b, %p
    br j1

r1:
    %e = load i64 %p
    %f = add i64 %e, 1
    store i64 %f, %p
    br j1

j1:
    %u = icmp ne i64 %d, 0
    cond_br %u, l2, r2

l2:
    %g = load i64 %q
    %h = add i64 %g, 2
    store i64 %h, %q
    br j2

r2:
    %i = load i64 %q
    %j = add i64 %i, 2
    store i64 %j, %q
    br j2

j2:
    ret i64 0
}
