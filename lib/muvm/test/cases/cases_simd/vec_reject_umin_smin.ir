// rejected: signed min reduction (backend VecMin contract is unsigned)
module "vec_reject_smin"
func @f() i64 {
entry:
    %a = alloca array i64 16
    br loop
loop:
    %i = phi i64 [0, entry], [%in, latch]
    %s = phi i64 [100, entry], [%ns, latch]
    %iv = icmp slt i64 %i, 16
    cond_br %iv, body, done
body:
    %ga = gep %a, %i
    %la = load i64 %ga
    %c = icmp slt i64 %la, %s
    %ns = select i1 %c, i64 %la, i64 %s
    br latch
latch:
    %in = add i64 %i, 1
    br loop
done:
    ret i64 %s
}
