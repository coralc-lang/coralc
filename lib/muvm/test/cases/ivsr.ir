module "ivsr"

func @strred(%p: ptr, %n: i32) i32 {
entry:
    %i = alloca i32
    store i32 0, %i
    br loop
loop:
    %iv = load i32 %i
    %c = icmp slt i32 %iv, %n
    cond_br %c, body, done
body:
    %off = mul i32 %iv, 8
    %q = gep %p, %off
    %v = load i32 %q
    %r = add i32 %v, 1
    store i32 %r, %q
    %ni = add i32 %iv, 1
    store i32 %ni, %i
    br loop
done:
    ret i32 0
}

func @shlcase(%p: ptr, %n: i64) i64 {
entry:
    br loop
loop:
    %i = phi i64 [0, entry], [%in, body]
    %acc = phi i64 [0, entry], [%accn, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done
body:
    %off = shl i64 %i, 4
    %q = gep %p, %off
    %v = load i64 %q
    %accn = add i64 %acc, %v
    %in = add i64 %i, 2
    br loop
done:
    ret i64 %acc
}
