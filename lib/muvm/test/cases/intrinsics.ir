module "intr_test"

func @__muvm_intrinsic_memcpy(ptr i8, ptr i8, i64) extern;
func @__muvm_intrinsic_memset(ptr i8, i32, i64) extern;
func @__muvm_intrinsic_memcmp(ptr i8, ptr i8, i64) i32 extern;
func @__muvm_intrinsic_strcmp(ptr i8, ptr i8) i32 extern;

func @main() i32 {
entry:
    %a = alloca array i8 16
    %b = alloca array i8 16
    call void @__muvm_intrinsic_memset(ptr i8 %a, i32 65, i64 8)
    call void @__muvm_intrinsic_memcpy(ptr i8 %b, ptr i8 %a, i64 8)
    %r = call i32 @__muvm_intrinsic_memcmp(ptr i8 %a, ptr i8 %b, i64 8)
    %c1 = icmp eq i32 %r, 0
    %ok1 = zext i1 %c1 to i32
    %s1 = gep %a, 4
    store i8 66, %s1
    %r2 = call i32 @__muvm_intrinsic_memcmp(ptr i8 %a, ptr i8 %b, i64 8)
    %c2 = icmp ne i32 %r2, 0
    %ok2 = zext i1 %c2 to i32
    %sum = add i32 %ok1, %ok2
    ret i32 %sum
}
