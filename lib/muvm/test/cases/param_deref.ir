module "param_deref"

func @sum(%p: ptr !dereferenceable(8), %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [0, entry], [%i2, body]
    %s = phi i64 [0, entry], [%s2, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done

body:
    %v = load i64 %p
    %s2 = add i64 %s, %v
    %i2 = add i64 %i, 1
    br loop

done:
    ret i64 %s
}

func @sumnd(%p: ptr, %n: i64) i64 {
entry:
    br loop

loop:
    %i = phi i64 [0, entry], [%i2, body]
    %s = phi i64 [0, entry], [%s2, body]
    %c = icmp slt i64 %i, %n
    cond_br %c, body, done

body:
    %v = load i64 %p
    %s2 = add i64 %s, %v
    %i2 = add i64 %i, 1
    br loop

done:
    ret i64 %s
}
