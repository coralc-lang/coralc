func @main() i32 !argmemonly {

entry:
    %0  = call i64 @tiny(i64 5)
    %1  = call i64 @neg_hint(i64 5)
    %2  = call i64 @const42()
    %3  = call i64 @param_const(i64 7)
    %4  = call i64 @multi_ret(i64 0)
    %5  = call i64 @switch_ret(i64 2)
    %6  = call i64 @rec(i64 3)
    %7  = call i64 @big_body(i64 1)
    %8  = add i64 %0, 25
    %9  = add i64 %8, 99
    %10 = add i64 %9, %1
    %11 = add i64 %10, %2
    %12 = add i64 %11, %3
    %13 = add i64 %12, %4
    %14 = add i64 %13, %5
    %15 = add i64 %14, %6
    %16 = add i64 %15, %7
    %17 = trunc i64 %16 to i32
    ret i32 %17

}

func @tiny(%0: i64) i64 !linkage !readnone {

entry:
    %1 = add i64 %0, 10
    ret i64 %1

}

func @tiny_hint(%0: i64) i64 !linkage !inlinehint !readnone {

entry:
    %1 = add i64 %0, 20
    ret i64 %1

}

func @always3(%0: i64) i64 !linkage !inlinehint = 3 !readnone {

entry:
    ret i64 99

}

func @neg_hint(%0: i64) i64 !linkage !inlinehint = -1 !readnone {

entry:
    %1 = add i64 %0, 30
    ret i64 %1

}

func @const42() i64 !linkage !noinline !readnone {

entry:
    ret i64 42

}

func @param_const(%0: i64) i64 !linkage !noinline !readnone {

entry:
    %1 = add i64 %0, 1
    ret i64 %1

}

func @multi_ret(%0: i64) i64 !linkage !readnone {

entry:
    %1 = icmp eq i64 %0, 0
    cond_br %1, zero, nonzero

nonzero:
    ret i64 4

zero:
    ret i64 3

}

func @switch_ret(%0: i64) i64 !linkage !readnone {

entry:
    switch i64 %0, default other [ i64 1, one, i64 2, two]

two:
    ret i64 22

one:
    ret i64 11

other:
    ret i64 33

}

func @rec(%0: i64) i64 !linkage !argmemonly {

entry:
    %1 = icmp sle i64 %0, 0
    cond_br %1, done, step

step:
    %2 = sub i64 %0, 1
    %3 = call i64 @rec(i64 %2)
    ret i64 %3

done:
    ret i64 0

}

