// ---- module ----

module "module_inline"

// ---- funcs ----

func @main() i32 !argmemonly {

entry:
    %0 = call i64 @neg_hint(i64 5)
    %1 = call i64 @const42()
    %2 = call i64 @param_const(i64 7)
    %3 = call i64 @rec(i64 3)
    %4 = add i64 %3, 249
    %5 = add i64 %4, 56
    %6 = trunc i64 %5 to i32
    ret i32 %6

}

func @tiny(%0: i64) i64 !linkage !readnone {

entry:
    %1 = add i64 %0, 10
    ret i64 %1

}

func @tiny_hint(%0: i64) i64 !linkage !inlinehint !readnone {

entry:
    %1 = add i64 %0, 20
    ret i64 %1

}

func @always3(%0: i64) i64 !linkage !inlinehint = 3 !readnone {

entry:
    ret i64 99

}

func @neg_hint(%0: i64) i64 !linkage !inlinehint = -1 !readnone {

entry:
    ret i64 35

}

func @const42() i64 !linkage !noinline !readnone {

entry:
    ret i64 42

}

func @param_const(%0: i64) i64 !linkage !noinline !readnone {

entry:
    ret i64 8

}

func @multi_ret(%0: i64) i64 !linkage !readnone {

entry:
    %1 = icmp eq i64 %0, 0
    cond_br %1, zero, nonzero

nonzero:
    ret i64 4

zero:
    ret i64 3

}

func @switch_ret(%0: i64) i64 !linkage !readnone {

entry:
    switch i64 %0, default other [ i64 1, one, i64 2, two]

two:
    ret i64 22

one:
    ret i64 11

other:
    ret i64 33

}

func @rec(%0: i64) i64 !linkage !argmemonly {

entry:
    %1 = icmp sle i64 %0, 0
    cond_br %1, done, step

step:
    %2 = sub i64 %0, 1
    %3 = call i64 @rec(i64 %2)
    ret i64 %3

done:
    ret i64 0

}

func @big_body(%0: i64) i64 !linkage !readnone {

entry:
    ret i64 56

}
