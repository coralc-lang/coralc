// ---- module ----

module "module_inline"

// ---- funcs ----

func @main() i32 {
entry:
    br __inl.cont.4

__inl.cont.4:
    %an = call i64 @neg_hint(i64 5)
    %b = call i64 @const42()
    %c = call i64 @param_const(i64 7)
    br __inl.cont.24

__inl.cont.24:
    %f = call i64 @rec(i64 3)
    br __inl.cont.0

__inl.cont.0:
    %s8 = add i64 %f, 249
    %s9 = add i64 %s8, 56
    %t = trunc i64 %s9 to i32
    ret i32 %t
}

func @tiny(%x: i64) i64 !linkage {
entry:
    %r = add i64 %x, 10
    ret i64 %r
}

func @tiny_hint(%x: i64) i64 !linkage !inlinehint {
entry:
    %r = add i64 %x, 20
    ret i64 %r
}

func @always3(%x: i64) i64 !linkage !inlinehint = 3 {
entry:
    br b13

b13:
    ret i64 99
}

func @neg_hint(%x: i64) i64 !linkage !inlinehint = -1 {
entry:
    ret i64 35
}

func @const42() i64 !linkage !noinline {
entry:
    ret i64 42
}

func @param_const(%x: i64) i64 !linkage !noinline {
entry:
    ret i64 8
}

func @multi_ret(%x: i64) i64 !linkage {
entry:
    %c = icmp eq i64 %x, 0
    cond_br %c, zero, nonzero

nonzero:
    ret i64 4

zero:
    ret i64 3
}

func @switch_ret(%x: i64) i64 !linkage {
entry:
    switch i64 %x, default other [ i64 1, one, i64 2, two]

two:
    ret i64 22

one:
    ret i64 11

other:
    ret i64 33
}

func @rec(%n: i64) i64 !linkage {
entry:
    %c = icmp sle i64 %n, 0
    cond_br %c, done, step

step:
    %n1 = sub i64 %n, 1
    %r = call i64 @rec(i64 %n1)
    ret i64 %r

done:
    ret i64 0
}

func @big_body(%x: i64) i64 !linkage {
entry:
    ret i64 56
}
