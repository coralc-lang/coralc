// ---- module ----

module "dse_asm_barrier"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %p = alloca i64
    %q = alloca i64
    store i64 1, %p
    inlineasm void "movq %1, %0" : "=r,m" : "cc" (ptr i64 %q, ptr i64 %p)
    store i64 2, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
