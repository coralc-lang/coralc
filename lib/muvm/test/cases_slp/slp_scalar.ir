// SLP negative: a single iteration and non-consecutive stores must
// not pack — output stays scalar.
module "slp_scalar"
func @f() i64 {
entry:
    %a = alloca array i64 8
    %b = alloca array i64 8
    %c = alloca array i64 8
    %ga0 = gep %a, 0
    %la0 = load i64 %ga0
    %gb0 = gep %b, 0
    %lb0 = load i64 %gb0
    %s0 = add i64 %la0, %lb0
    %gc0 = gep %c, 0
    store i64 %s0, %gc0
    %ga2 = gep %a, 2
    %la2 = load i64 %ga2
    %gb2 = gep %b, 2
    %lb2 = load i64 %gb2
    %s2 = add i64 %la2, %lb2
    %gc2 = gep %c, 2
    store i64 %s2, %gc2
    %g0 = gep %c, 0
    %r = load i64 %g0
    ret i64 %r
}
