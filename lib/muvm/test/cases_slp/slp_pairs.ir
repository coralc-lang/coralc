// SLP: six unrolled c[i] = a[i] + b[i] iterations — isomorphic
// gep/load/add/store chains at consecutive constant offsets pack
// into vector i64 2 groups (3 groups, no tail).
module "slp_pairs"
func @f() i64 {
entry:
    %a = alloca array i64 8
    %b = alloca array i64 8
    %c = alloca array i64 8
    %ga0 = gep %a, 0
    %la0 = load i64 %ga0
    %gb0 = gep %b, 0
    %lb0 = load i64 %gb0
    %s0 = add i64 %la0, %lb0
    %gc0 = gep %c, 0
    store i64 %s0, %gc0
    %ga1 = gep %a, 1
    %la1 = load i64 %ga1
    %gb1 = gep %b, 1
    %lb1 = load i64 %gb1
    %s1 = add i64 %la1, %lb1
    %gc1 = gep %c, 1
    store i64 %s1, %gc1
    %ga2 = gep %a, 2
    %la2 = load i64 %ga2
    %gb2 = gep %b, 2
    %lb2 = load i64 %gb2
    %s2 = add i64 %la2, %lb2
    %gc2 = gep %c, 2
    store i64 %s2, %gc2
    %ga3 = gep %a, 3
    %la3 = load i64 %ga3
    %gb3 = gep %b, 3
    %lb3 = load i64 %gb3
    %s3 = add i64 %la3, %lb3
    %gc3 = gep %c, 3
    store i64 %s3, %gc3
    %ga4 = gep %a, 4
    %la4 = load i64 %ga4
    %gb4 = gep %b, 4
    %lb4 = load i64 %gb4
    %s4 = add i64 %la4, %lb4
    %gc4 = gep %c, 4
    store i64 %s4, %gc4
    %ga5 = gep %a, 5
    %la5 = load i64 %ga5
    %gb5 = gep %b, 5
    %lb5 = load i64 %gb5
    %s5 = add i64 %la5, %lb5
    %gc5 = gep %c, 5
    store i64 %s5, %gc5
    %g0 = gep %c, 0
    %r = load i64 %g0
    ret i64 %r
}
