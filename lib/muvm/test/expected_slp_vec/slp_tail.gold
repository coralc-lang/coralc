// ---- module ----

module "slp_tail"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 8
    %1 = alloca array i64 8
    %2 = alloca array i64 8
    %3 = gep %0, 0
    %4 = load vector i64 2 %3
    %5 = gep %1, 0
    %6 = load vector i64 2 %5
    %7 = vadd vector i64 2 %4, %6
    %8 = gep %2, 0
    store vector i64 2 %7, %8
    %9 = gep %0, 2
    %10 = load vector i64 2 %9
    %11 = gep %1, 2
    %12 = load vector i64 2 %11
    %13 = vadd vector i64 2 %10, %12
    %14 = gep %2, 2
    store vector i64 2 %13, %14
    %15 = gep %0, 4
    %16 = load i64 %15
    %17 = gep %1, 4
    %18 = load i64 %17
    %19 = add i64 %16, %18
    %20 = gep %2, 4
    store i64 %19, %20
    %21 = gep %2, 0
    %22 = load i64 %21
    ret i64 %22
}
