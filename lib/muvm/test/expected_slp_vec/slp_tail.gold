// ---- module ----

module "slp_tail"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 8
    %b = alloca array i64 8
    %c = alloca array i64 8
    %ga0 = gep %a, 0
    %49 = load vector i64 2 %ga0
    %gb0 = gep %b, 0
    %50 = load vector i64 2 %gb0
    %53 = vadd vector i64 2 %49, %50
    %gc0 = gep %c, 0
    store vector i64 2 %53, %gc0
    %ga2 = gep %a, 2
    %51 = load vector i64 2 %ga2
    %gb2 = gep %b, 2
    %52 = load vector i64 2 %gb2
    %54 = vadd vector i64 2 %51, %52
    %gc2 = gep %c, 2
    store vector i64 2 %54, %gc2
    %ga4 = gep %a, 4
    %la4 = load i64 %ga4
    %gb4 = gep %b, 4
    %lb4 = load i64 %gb4
    %s4 = add i64 %la4, %lb4
    %gc4 = gep %c, 4
    store i64 %s4, %gc4
    %g0 = gep %c, 0
    %r = load i64 %g0
    ret i64 %r
}
