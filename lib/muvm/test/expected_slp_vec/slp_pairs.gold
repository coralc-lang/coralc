// ---- module ----

module "slp_pairs"

// ---- funcs ----

func @f() i64 {
entry:
    %a = alloca array i64 8
    %b = alloca array i64 8
    %c = alloca array i64 8
    %ga0 = gep %a, 0
    %57 = load vector i64 2 %ga0
    %gb0 = gep %b, 0
    %58 = load vector i64 2 %gb0
    %63 = vadd vector i64 2 %57, %58
    %gc0 = gep %c, 0
    store vector i64 2 %63, %gc0
    %ga2 = gep %a, 2
    %59 = load vector i64 2 %ga2
    %gb2 = gep %b, 2
    %60 = load vector i64 2 %gb2
    %64 = vadd vector i64 2 %59, %60
    %gc2 = gep %c, 2
    store vector i64 2 %64, %gc2
    %ga4 = gep %a, 4
    %61 = load vector i64 2 %ga4
    %gb4 = gep %b, 4
    %62 = load vector i64 2 %gb4
    %65 = vadd vector i64 2 %61, %62
    %gc4 = gep %c, 4
    store vector i64 2 %65, %gc4
    %g0 = gep %c, 0
    %r = load i64 %g0
    ret i64 %r
}
