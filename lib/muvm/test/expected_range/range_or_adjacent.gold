// ---- module ----

module "range_or_adjacent"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = add i64 %0, 0
    %2 = icmp slt i64 %1, 10
    %3 = icmp sge i64 %1, 10
    %4 = icmp slt i64 %1, 20
    %5 = icmp sge i64 %1, 20
    %6 = or i1 %2, %3
    %7 = or i1 %4, %5
    %8 = zext i1 true to i64
    %9 = trunc i64 %8 to i32
    ret i32 %9
}
