// ---- module ----

module "range_or_overlap"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp slt i64 %x, 5
    %c2 = icmp slt i64 %x, 10
    %c3 = icmp slt i64 %x, 20
    %l = or i1 %c1, %c2
    %z = zext i1 %c3 to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
