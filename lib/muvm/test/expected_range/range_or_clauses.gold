// ---- module ----

module "range_or_clauses"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %a1 = icmp sgt i64 %x, 3
    %a2 = icmp slt i64 %x, 10
    %b1 = icmp sgt i64 %x, 3
    %b2 = icmp slt i64 %x, 20
    %l = and i1 %a1, %a2
    %h = and i1 %b1, %b2
    %19 = and i1 %a1, %b2
    %z = zext i1 %19 to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
