// ---- module ----

module "range_and_merge"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp sgt i64 %x, 3
    %c2 = icmp sgt i64 %x, 5
    %c3 = icmp sgt i64 %x, 7
    %c4 = icmp slt i64 %x, 10
    %l = and i1 %c1, %c2
    %h = and i1 %c3, %c4
    %20 = and i1 %c3, %c4
    %z = zext i1 %20 to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
