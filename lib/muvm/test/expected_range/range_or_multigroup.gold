// ---- module ----

module "range_or_multigroup"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp slt i64 %x, 5
    %c2 = icmp eq i64 %x, 7
    %c3 = icmp sgt i64 %x, 10
    %c4 = icmp sgt i64 %x, 20
    %c5 = icmp sgt i64 %x, 30
    %l1 = or i1 %c1, %c2
    %l2 = or i1 %l1, %c3
    %l3 = or i1 %l2, %c4
    %23 = or i1 %c1, %c2
    %24 = or i1 %23, %c3
    %z = zext i1 %24 to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
