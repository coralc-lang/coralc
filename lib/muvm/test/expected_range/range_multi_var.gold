// ---- module ----

module "range_multi_var"

// ---- funcs ----

func @main(%0: i64, %1: i64) i32 {
entry:
    %2 = add i64 %0, 0
    %3 = icmp slt i64 %2, 5
    %4 = icmp slt i64 %2, 7
    %5 = icmp slt i64 %1, 10
    %6 = and i1 %3, %4
    %7 = and i1 %6, %5
    %8 = zext i1 %7 to i64
    %9 = trunc i64 %8 to i32
    ret i32 %9
}
