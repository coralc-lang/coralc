// ---- module ----

module "range_and_empty"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = add i64 %0, 0
    %2 = icmp slt i64 %1, 5
    %3 = icmp sgt i64 %1, 10
    %4 = icmp slt i64 %1, 20
    %5 = and i1 %2, %3
    %6 = zext i1 false to i64
    %7 = trunc i64 %6 to i32
    ret i32 %7
}
