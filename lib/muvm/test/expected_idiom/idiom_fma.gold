// ---- module ----

module "idiom_fma"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %a = sitofp i64 %c to f64
    %m = fmul f64 %a, 2.0
    %15 = fma f64 %a, 2.0, 4.0
    %half = fadd f64 %a, 0.5
    %chk = fcmp ogt f64 %15, %half
    %z = zext i1 %chk to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
