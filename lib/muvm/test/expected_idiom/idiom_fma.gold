// ---- module ----

module "idiom_fma"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = sitofp i64 %0 to f64
    %2 = fmul f64 %1, 2.0
    %3 = fma f64 %1, 2.0, 4.0
    %4 = fadd f64 %1, 0.5
    %5 = fcmp ogt f64 %3, %4
    %6 = zext i1 %5 to i64
    %7 = trunc i64 %6 to i32
    ret i32 %7
}
