// ---- module ----

module "idiom_minmax"

// ---- funcs ----

func @mn(%a: i64, %b: i64) i64 {
entry:
    %c = icmp slt i64 %a, %b
    %24 = smin i64 %a, %b
    ret i64 %24
}

func @mx(%a: i64, %b: i64) i64 {
entry:
    %c = icmp sgt i64 %a, %b
    %25 = smax i64 %a, %b
    ret i64 %25
}

func @main(%c: i64) i32 {
entry:
    %m = call i64 @mn(i64 %c, i64 7)
    %x = call i64 @mx(i64 %c, i64 7)
    %s = add i64 %m, %x
    %t = trunc i64 %s to i32
    ret i32 %t
}
