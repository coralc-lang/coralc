// ---- module ----

module "idiom_bswap"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %x = trunc i64 %c to i32
    %s0 = shl i32 %x, 24
    %t0 = and i32 %s0, -16777216
    %s1 = shl i32 %x, 8
    %t1 = and i32 %s1, 16711680
    %s2 = lshr i32 %x, 8
    %t2 = and i32 %s2, 65280
    %s3 = lshr i32 %x, 24
    %t3 = and i32 %s3, 255
    %o1 = or i32 %t0, %t1
    %o2 = or i32 %o1, %t2
    %24 = bswap i32 %x
    %t = trunc i32 %24 to i32
    ret i32 %t
}
