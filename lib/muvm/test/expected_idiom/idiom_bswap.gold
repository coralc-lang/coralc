// ---- module ----

module "idiom_bswap"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = trunc i64 %0 to i32
    %2 = shl i32 %1, 24
    %3 = and i32 %2, -16777216
    %4 = shl i32 %1, 8
    %5 = and i32 %4, 16711680
    %6 = lshr i32 %1, 8
    %7 = and i32 %6, 65280
    %8 = lshr i32 %1, 24
    %9 = and i32 %8, 255
    %10 = or i32 %3, %5
    %11 = or i32 %10, %7
    %12 = bswap i32 %1
    %13 = trunc i32 %12 to i32
    ret i32 %13
}
