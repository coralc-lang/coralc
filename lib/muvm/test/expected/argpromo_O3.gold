; ---- module ----

module "argpromo"

; ---- funcs ----

define func @deref(%0: i64) i64 !readonly !argmemonly {

entry:
    %1 = shl i64 %0, 1
    ret i64 %1

}

define func @sum2(%0: i64, %1: i64) i64 !readonly !argmemonly {

entry:
    %2 = add i64 %0, %1
    ret i64 %2

}

define func @kept(%0: ptr !dereferenceable(8)) i64 !argmemonly {

entry:
    %1 = load i64 %0
    store i64 9, %0
    ret i64 %1

}

define func @use() i64 !argmemonly {

entry:
    %0 = alloca i64
    store i64 21, %0
    %1 = call i64 @deref(i64 21)
    %2 = call i64 @sum2(i64 21, i64 1)
    %3 = call i64 @kept(ptr i64 %0)
    %4 = add i64 %1, %2
    %5 = add i64 %3, %4
    ret i64 %5

}
