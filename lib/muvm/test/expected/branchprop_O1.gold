// ---- module ----

module "branchprop_demo"

// ---- funcs ----

func @use_in_taken(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, taken, else

else:
    ret i64 0

taken:
    %isTakenArm = icmp slt i64 %x, 42
    %result = select i1 %isTakenArm, i64 7, i64 99
    ret i64 %result
}

func @use_in_else(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, then, else

else:
    %isElseArm = icmp slt i64 %x, 42
    %result2 = select i1 %isElseArm, i64 7, i64 99
    ret i64 %result2

then:
    ret i64 1
}

func @use_both_after(%x: i64) i64 {
entry:
    %c = icmp slt i64 %x, 42
    cond_br %c, then, else

then:
    cond_br %c, then, else

else:
    cond_br %c, then, else
}
