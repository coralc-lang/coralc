; ---- module ----

module "branchprop_demo"

; ---- funcs ----

define func @use_in_taken(%0: i64) i64 !readnone {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, taken, else

else:
    ret i64 0

taken:
    %2 = icmp slt i64 %0, 42
    %3 = select i1 %2, i64 7, i64 99
    ret i64 %3

}

define func @use_in_else(%0: i64) i64 !readnone {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

else:
    %2 = icmp slt i64 %0, 42
    %3 = select i1 %2, i64 7, i64 99
    ret i64 %3

then:
    ret i64 1

}

define func @use_both_after(%0: i64) i64 !readnone {

entry:
    %1 = icmp slt i64 %0, 42
    cond_br %1, then, else

then:
    cond_br %1, then, else

else:
    cond_br %1, then, else

}
