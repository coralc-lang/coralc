; ---- module ----

module "sized_clobber"

; ---- funcs ----

define func @fwd(%0: i64) i64 !argmemonly !writeonly {

entry:
    %1 = alloca array i32 2
    store i32 10, %1
    %2 = gep %1, 1
    store i32 20, %2
    ret i64 10

}

define func @dead(%0: i64) i64 !argmemonly {

entry:
    %1 = alloca array i32 2
    %2 = gep %1, 1
    %3 = load i32 %2
    store i32 99, %1
    %4 = zext i32 %3 to i64
    ret i64 %4

}

define func @overlap(%0: i64) i64 !argmemonly {

entry:
    %1 = alloca array i64 1
    store i64 1234605616436508552, %1
    %2 = load i32 %1
    %3 = zext i32 %2 to i64
    ret i64 %3

}
