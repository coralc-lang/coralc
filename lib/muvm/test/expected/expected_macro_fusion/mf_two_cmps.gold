// ---- module ----

module "mf_two_cmps"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = icmp slt i64 %0, 10
    %2 = add i64 %0, 3
    %3 = icmp sgt i64 %2, 100
    %4 = mul i64 %2, 2
    cond_br %1, first, second

second:
    %5 = add i64 %4, 9
    cond_br %3, third, fourth

fourth:
    ret i32 3

third:
    ret i32 2

first:
    ret i32 1
}
