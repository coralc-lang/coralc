; ---- module ----

module "tailmerge"

; ---- funcs ----

define func @merge(%0: i64, %1: ptr) i64 !argmemonly {

entry:
    %2 = load i64 %1
    %3 = add i64 %2, 1
    store i64 %3, %1
    ret i64 0

}

define func @nomerge(%0: i64, %1: ptr) i64 !argmemonly {

entry:
    %2 = icmp ne i64 %0, 0
    cond_br %2, left, right

right:
    %3 = load i64 %1
    %4 = add i64 %3, 2
    store i64 %4, %1
    br join

left:
    %5 = load i64 %1
    %6 = add i64 %5, 1
    store i64 %6, %1
    br join

join:
    ret i64 0

}

define func @phidest(%0: i64, %1: ptr) i64 !readonly !argmemonly {

entry:
    %2 = load i64 %1
    %3 = icmp ne i64 %0, 0
    cond_br %3, j, rp

rp:
    %4 = load i64 %1
    br j

j:
    %5 = phi i64 [%2, entry], [%4, rp]
    ret i64 %5

}

define func @twomerge(%0: i64, %1: i64, %2: ptr, %3: ptr) i64 !argmemonly {

entry:
    %4 = load i64 %2
    %5 = add i64 %4, 1
    store i64 %5, %2
    %6 = load i64 %3
    %7 = add i64 %6, 2
    store i64 %7, %3
    ret i64 0

}
