// ---- module ----

module "range_mixed_sign"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = add i64 %0, 0
    %2 = icmp slt i64 %1, 5
    %3 = icmp ult i64 %1, 10
    %4 = icmp sgt i64 %1, 0
    %5 = and i1 %2, %3
    %6 = and i1 %5, %4
    %7 = zext i1 %6 to i64
    %8 = trunc i64 %7 to i32
    ret i32 %8
}
