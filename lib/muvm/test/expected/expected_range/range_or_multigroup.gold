// ---- module ----

module "range_or_multigroup"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = add i64 %0, 0
    %2 = icmp slt i64 %1, 5
    %3 = icmp eq i64 %1, 7
    %4 = icmp sgt i64 %1, 10
    %5 = icmp sgt i64 %1, 20
    %6 = icmp sgt i64 %1, 30
    %7 = or i1 %2, %3
    %8 = or i1 %7, %4
    %9 = or i1 %8, %5
    %10 = or i1 %2, %3
    %11 = or i1 %10, %4
    %12 = zext i1 %11 to i64
    %13 = trunc i64 %12 to i32
    ret i32 %13
}
