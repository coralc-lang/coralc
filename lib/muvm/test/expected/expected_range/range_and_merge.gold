// ---- module ----

module "range_and_merge"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = add i64 %0, 0
    %2 = icmp sgt i64 %1, 3
    %3 = icmp sgt i64 %1, 5
    %4 = icmp sgt i64 %1, 7
    %5 = icmp slt i64 %1, 10
    %6 = and i1 %2, %3
    %7 = and i1 %4, %5
    %8 = and i1 %4, %5
    %9 = zext i1 %8 to i64
    %10 = trunc i64 %9 to i32
    ret i32 %10
}
