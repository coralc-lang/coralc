// ---- module ----

module "slp_scalar"

// ---- funcs ----

func @f() i64 {
entry:
    %0 = alloca array i64 8
    %1 = alloca array i64 8
    %2 = alloca array i64 8
    %3 = gep %0, 0
    %4 = load i64 %3
    %5 = gep %1, 0
    %6 = load i64 %5
    %7 = add i64 %4, %6
    %8 = gep %2, 0
    store i64 %7, %8
    %9 = gep %0, 2
    %10 = load i64 %9
    %11 = gep %1, 2
    %12 = load i64 %11
    %13 = add i64 %10, %12
    %14 = gep %2, 2
    store i64 %13, %14
    %15 = gep %2, 0
    %16 = load i64 %15
    ret i64 %16
}
