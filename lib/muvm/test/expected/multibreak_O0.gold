// ---- module ----

module "multibreak"

// ---- funcs ----

func @main() i32 {

entry:
    %0 = call i64 @ticket(i64 10)
    %1 = trunc i64 %0 to i32
    ret i32 %1

}

func @ticket(%0: i64) i64 {

entry:
    br select

select:
    %1 = icmp slt i64 %0, 1000
    cond_br %1, loopentry, exit

loopentry:
    br loop

loop:
    %2 = phi i64 [0, loopentry], [%7, next]
    %3 = phi i64 [0, loopentry], [%5, next]
    %4 = icmp slt i64 %2, %0
    cond_br %4, body, exit

body:
    %5 = add i64 %3, 2
    %6 = icmp eq i64 %2, 3
    cond_br %6, exit, next

next:
    %7 = add i64 %2, 1
    br loop

exit:
    %8 = phi i64 [0, select], [%3, loop], [%3, body]
    %9 = add i64 %8, 42
    ret i64 %9

}
