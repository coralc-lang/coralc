; ---- module ----

module "storemerge"

; ---- globals ----

global @arr: array i32 4 !alignment = 4;

; ---- funcs ----

define func @merge(%0: i64) i64 !writeonly {

entry:
    store i64 2459565876208275729, @arr
    ret i64 %0

}

define func @split(%0: i64) i64 {

entry:
    %1 = gep @arr, 2
    store i32 858993459, %1
    %2 = gep @arr, 3
    %3 = load i32 %2
    store i32 1145324612, %2
    %4 = zext i32 %3 to i64
    ret i64 %4

}

define func @gap(%0: i64) i64 !writeonly {

entry:
    store i32 1, @arr
    %1 = gep @arr, 2
    store i32 2, %1
    ret i64 %0

}

define func @dyn(%0: i64, %1: i64) i64 !writeonly {

entry:
    %2 = trunc i64 %1 to i32
    store i32 %2, @arr
    %3 = gep @arr, 1
    %4 = trunc i64 %0 to i32
    store i32 %4, %3
    ret i64 %0

}

define func @rev(%0: i64) i64 !writeonly {

entry:
    store i64 -6148914690950186053, @arr
    ret i64 %0

}
