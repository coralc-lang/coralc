// ---- module ----

module "idiom_neg"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = trunc i64 %0 to i32
    %2 = shl i32 %1, 8
    %3 = lshr i32 %1, 16
    %4 = or i32 %2, %3
    %5 = add i64 %0, 0
    %6 = add i64 %0, 1
    %7 = icmp slt i64 %0, 5
    %8 = select i1 %7, i64 %5, i64 %6
    %9 = add i32 %4, %8
    ret i32 %9
}
