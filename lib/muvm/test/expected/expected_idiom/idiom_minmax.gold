// ---- module ----

module "idiom_minmax"

// ---- funcs ----

func @mn(%0: i64, %1: i64) i64 {
entry:
    %2 = icmp slt i64 %0, %1
    %3 = smin i64 %0, %1
    ret i64 %3
}

func @mx(%0: i64, %1: i64) i64 {
entry:
    %2 = icmp sgt i64 %0, %1
    %3 = smax i64 %0, %1
    ret i64 %3
}

func @main(%0: i64) i32 {
entry:
    %1 = call i64 @mn(i64 %0, i64 7)
    %2 = call i64 @mx(i64 %0, i64 7)
    %3 = add i64 %1, %2
    %4 = trunc i64 %3 to i32
    ret i32 %4
}
