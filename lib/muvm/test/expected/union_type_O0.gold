// ---- module ----

module "uniontype"

// ---- types ----

type @U = union { f0: i32, f1: f64, f2: i64 };

type @V = struct { f0: i32, f1: union @U };

// ---- funcs ----

func @main() i32 {
entry:
    %0 = alloca union @U
    %1 = bitcast ptr union @U %0 to ptr i32
    store i32 42, %1
    %2 = bitcast ptr union @U %0 to ptr i64
    %3 = load i64 %2
    %4 = lshr i64 %3, 32
    ret i32 0
}
