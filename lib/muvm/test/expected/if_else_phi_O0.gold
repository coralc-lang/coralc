// ---- module ----

module "if_else_phi"

// ---- funcs ----

func @main() i32 {
entry:
    %0 = icmp sgt i64 7, 5
    cond_br %0, then, els

els:
    %1 = sub i64 0, 7
    br merge

then:
    %2 = mul i64 7, 2
    br merge

merge:
    %3 = phi i64 [%2, then], [%1, els]
    %4 = trunc i64 %3 to i32
    ret i32 %4
}
