// ---- module ----

module "dse_call_barrier"

// ---- funcs ----

func @touch(%0: ptr) {
entry:
    %1 = load i64 %0
    ret
}

func @main(%0: i64) i32 {
entry:
    %1 = alloca i64
    store i64 1, %1
    call void @touch(ptr i64 %1)
    store i64 2, %1
    %2 = load i64 %1
    %3 = trunc i64 %2 to i32
    ret i32 %3
}
