// ---- module ----

module "dse_asm_barrier"

// ---- funcs ----

func @main(%0: i64) i32 {
entry:
    %1 = alloca i64
    %2 = alloca i64
    store i64 1, %1
    inlineasm void "movq %1, %0" : "=r,m" : "cc" (ptr i64 %2, ptr i64 %1)
    store i64 2, %1
    %3 = load i64 %1
    %4 = trunc i64 %3 to i32
    ret i32 %4
}
