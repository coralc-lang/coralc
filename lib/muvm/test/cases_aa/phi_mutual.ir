module "aa_phi_mutual"

func @main(%c: i64) i32 {
entry:
    %a = alloca i64
    %ga = gep %a, 0
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, l1, l2

l1:
    br loop

l2:
    br loop

loop:
    %p = phi ptr [ %q, l1 ], [ %ga, l2 ]
    %q = phi ptr [ %p, l1 ], [ %ga, l2 ]
    %c1 = icmp slt i64 %c, 10
    %nx = add i64 %c, 1
    cond_br %c1, loop, exit

exit:
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
