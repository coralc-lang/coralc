module "aa_gep_of_phi"

func @main(%c: i64) i32 {
entry:
    %a = alloca array i64 4
    %b = alloca array i64 4
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, pa, pb

pa:
    br merge

pb:
    br merge

merge:
    %arr = phi ptr [ %a, pa ], [ %b, pb ]
    %p = gep %arr, 2
    store i64 9, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
