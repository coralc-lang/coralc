module "aa_phi_same"

func @main(%c: i64) i32 {
entry:
    %a = alloca i64
    %g1 = gep %a, 0
    %g2 = gep %a, 1
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, pa, pb

pa:
    br merge

pb:
    br merge

merge:
    %p = phi ptr [ %g1, pa ], [ %g2, pb ]
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
