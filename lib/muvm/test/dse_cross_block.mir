// ---- module ----

module "dse_cross_block"

// ---- funcs ----

func @main(%c: i64) i32 {
entry:
    %p = alloca i64
    %c0 = icmp eq i64 %c, 0
    cond_br %c0, aa, bb

bb:
    store i64 2, %p
    br join

aa:
    store i64 1, %p
    br join

join:
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
