#[[no_drop_all]]
// linktool_x86: link x86-64 objects into an ELF executable or shared object
//   linktool_x86 <out> [--shared] [--dyn-undef] <in.o>...
import muvm::linker::x86::link { Config, Arch, configFor, Linker };
import muvm::linker::x86::elf { FMT_ELF_EXE, FMT_ELF_DYN };
import std::vec { Vec };
import std::string { String };
import std::ios { println, eprintln };
import std::fs { fileOpen, fileWrite, fileClose, File, IoError };
import core::cchar { cchar };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 3)
    {
        eprintln("usage: linktool_x86 <out> [--shared] [--dyn-undef] <in.o>...");
        return 2;
    }
    Config cfg = configFor(Arch::X86_64);
    cfg.outFmt = FMT_ELF_EXE;
    i32 first = 2;
    while (first < argc)
    {
        str a = str::fromCstr(argv[first]);
        if (a.equals("--shared")) { cfg.outFmt = FMT_ELF_DYN; first++; }
        else if (a.equals("--dyn-undef")) { cfg.allowDynUndef = true; first++; }
        else break;
    }
    if (first >= argc)
    {
        eprintln("usage: linktool_x86 <out> [--shared] [--dyn-undef] <in.o>...");
        return 2;
    }
    Linker lk = Linker::new(cfg);
    String err = String::new();
    for (i32 i = first; i < argc; i++)
    {
        str p = str::fromCstr(argv[i]);
        if (!lk.addObjectFile(p, &err))
        {
            eprintln("add {}: {}", p, err.asView());
            err.free();
            lk.dispose();
            return 1;
        }
    }
    Result<Vec<u8>, String> r = lk.produce();
    lk.dispose();
    if (r.isErr()) { eprintln("link failed: {}", r.unwrapErr()); return 1; }
    Vec<u8> img = r.unwrap();
    Result<File, IoError> fo = fileOpen(str::fromCstr(argv[1]), "wb");
    if (fo.isErr()) { eprintln("cannot write output"); return 1; }
    File f = fo.unwrap();
    fileWrite(f, img.data, img.len);
    fileClose(f);
    println("wrote {}", str::fromCstr(argv[1]));
    return 0;
}
