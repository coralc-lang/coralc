// ---- module ----

module "dse_call_barrier"

// ---- funcs ----

func @touch(%p: ptr) {
entry:
    %v = load i64 %p
    ret
}

func @main(%c: i64) i32 {
entry:
    %p = alloca i64
    store i64 1, %p
    call void @touch(ptr i64 %p)
    store i64 2, %p
    %v = load i64 %p
    %t = trunc i64 %v to i32
    ret i32 %t
}
