// (x==5)&&(x>3)&&(x<10) -> x==5
module "range_and_eq"

func @main(%c: i64) i32 {
entry:
    %x = add i64 %c, 0
    %c1 = icmp eq i64 %x, 5
    %c2 = icmp sgt i64 %x, 3
    %c3 = icmp slt i64 %x, 10
    %l = and i1 %c1, %c2
    %r = and i1 %l, %c3
    %z = zext i1 %r to i64
    %t = trunc i64 %z to i32
    ret i32 %t
}
