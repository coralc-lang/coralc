#[[no_drop_all]]
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType, FunctionAnalysisCache, irTypeEqual };
import muvm::irOps { IrOpcode };
import muvm::passes::alias_analysis { AliasAnalysis };
import muvm::passes::memory_ssa { MemorySSA };
import muvm::base::domtree { IrDomTree, irDomtreeNew, irDomtreeFree, irDomtreeDominates, irDomtreeChildCount, irDomtreeChild };
import std::mman { alloc, dealloc };

// Machine-level CSE/DSE pass using MemorySSA.
//
// Uses alias analysis and MemorySSA for precise memory optimization:
// 1. Store-to-load forwarding — a load may take a prior store's value only
//    when the store must-aliases it (same address SSA value, equal width),
//    dominates the load, and no aliasing write or barrier sits between
//    them (canForward). Same-block and cross-block share this check.
// 2. Dead store elimination — a store overwritten (killed) by a later
//    must-alias store before any load reads it in the same block is dead
//    and can be removed.
//
// MemorySSA provides candidate defs; the actual legality of every rewrite
// is re-established by AA + dominance + region scans, so the pass stays
// sound even though the version web is a linear approximation.
// avail-chain entry for cross-block redundant load elimination
struct LoadCand
{
    IrInst* inst;
    IrValue* addr;   // canonicalized
    IrType* ty;
    i32 next;        // next candidate with same addr, -1 = end
}

pub struct MachineOptPass
{
    IrContext* ctx;
    u64 forwardingDone;
    u64 loadsEliminated;
    u64 storesEliminated;

    MachineOptPass new(IrContext* ctx)
    {
        return MachineOptPass {
            .ctx = ctx,
            .forwardingDone = 0,
            .loadsEliminated = 0,
            .storesEliminated = 0,
            .loadCands = null,
            .loadCandCap = 0,
            .nLoadCands = 0,
            .lcKeys = null,
            .lcVals = null,
            .lcMask = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.forwardingDone = 0;
        self.loadsEliminated = 0;
        self.storesEliminated = 0;

        FunctionAnalysisCache* cache = self.ctx->getOrCreateAnalysisCache(func);
        AliasAnalysis* aaPtr = (AliasAnalysis*)cache->aliasAnalysis;

        AliasAnalysis aa;
        MemorySSA mssa;
        bool ownAA = false;

        if (aaPtr != null && cache->generation == self.ctx->analysisGeneration)
        {
            aa = *aaPtr;
        }
        else
        {
            aa = AliasAnalysis::new(self.ctx);
            aa.analyze(func);
            ownAA = true;
        }

        // Rebuilt per run rather than read from cache->memorySSA: an MSSA
        // points at its AliasAnalysis, so a cached one would dangle once
        // the local AA dies.
        mssa = MemorySSA::new(&aa);
        mssa.build(func);

        bool changed = false;

        IrDomTree* dt = irDomtreeNew(func);

        // Pass 1 — store-to-load forwarding, same-block and cross-block
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (self.processBlockWithMemorySSA(bb, &mssa, dt)) changed = true;
        }

        // Pass 1.5 — cross-block redundant load elimination
        if (self.eliminateRedundantLoads(func, &mssa, dt)) changed = true;

        // Pass 2 — dead store elimination using MemorySSA
        if (self.eliminateDeadStores(func, &mssa)) changed = true;

        irDomtreeFree(dt);
        mssa.deinit();
        if (ownAA) aa.deinit();
        return changed;
    }

    // Process a single block — forward stores to loads, eliminate dead stores
    bool processBlockWithMemorySSA(IrBlock* bb, MemorySSA* mssa, IrDomTree* dt)
    {
        bool changed = false;
        u32 i = 0;
        while (i < bb->ninsts)
        {
            IrInst* inst = bb->insts[i];

            // Try to forward store value to load. Only plain Load is a
            // candidate: atomic loads must perform the atomic read, and
            // calls/cmpxchg have their own result semantics — replacing
            // any of those with a stored value would drop a side effect.
            if (inst->opcode == IrOpcode::Load && inst->nops > 0 && inst->ops[0] != null)
            {
                IrValue* loadAddr = inst->ops[0];

                u64 loadSize = 0;
                if (inst->base.type != null)
                    loadSize = (u64)self.ctx->irTypeSizeOf(inst->base.type);
                u32 storeVer = mssa->findNearestDefForLoadSized(loadAddr, mssa->getVersionAtInst(inst), loadSize);
                if (storeVer > 0 && storeVer < mssa->numMemVersions)
                {
                    IrInst* killerDef = mssa->memDefInst[storeVer];
                    /* type equality, not width: struct/union `width` is a
                     * byte size while int `width` is bits — a 32-byte
                     * aggregate coincidentally "matches" an i32 load and
                     * forwarding it produces ill-typed IR */
                    if (killerDef != null && self.isStoreToAddr(killerDef, loadAddr) &&
                        killerDef->ops[0] != null && killerDef->ops[0]->type != null &&
                        inst->base.type != null &&
                        irTypeEqual(killerDef->ops[0]->type, inst->base.type))
                    {
                        if (self.canForward(killerDef, inst, bb->parent, dt, mssa))
                        {
                            inst->base.replaceAllUses(killerDef->ops[0]);
                            inst->erase();
                            self.forwardingDone++;
                            self.loadsEliminated++;
                            changed = true;
                            continue;
                        }
                    }
                }
            }

            // Try to eliminate dead store (store overwritten before read)
            if (inst->opcode == IrOpcode::Store && inst->nops >= 2 && inst->ops[1] != null)
            {
                IrValue* storeAddr = inst->ops[1];
                u32 storeWidth = self.storeValueWidth(inst);

                if (self.isStoreDead(inst, storeAddr, storeWidth, mssa))
                {
                    self.invalidateMemDef(inst, mssa);
                    inst->erase();
                    self.storesEliminated++;
                    changed = true;
                    continue;
                }
            }

            i++;
        }

        return changed;
    }

    // Store base.type is void (width 0) — the value operand carries the
    // real access width. 0 means unknown, never "equal".
    u32 storeValueWidth(IrInst* store)
    {
        if (store->nops < 1 || store->ops[0] == null || store->ops[0]->type == null) return 0;
        return store->ops[0]->type->width;
    }

    // Check if a store is killed by a later store before any load reads it
    bool isStoreDead(IrInst* storeInst, IrValue* addr, u32 width, MemorySSA* mssa)
    {
        if (width == 0) return false;
        IrBlock* bb = storeInst->parent;
        if (bb == null) return false;

        u32 storeIdx = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            if (bb->insts[i] == storeInst) { storeIdx = i; break; }
        }

        // Scan forward from the store
        for (u32 j = storeIdx + 1; j < bb->ninsts; j++)
        {
            IrInst* later = bb->insts[j];

            // If a memory read may alias with the store address, the store is not dead
            if (self.isMemoryRead(later->opcode))
            {
                // Only loads expose an address operand — calls and
                // rmw/cmpxchg can observe anything reachable.
                if (later->opcode != IrOpcode::Load &&
                    later->opcode != IrOpcode::AtomicLoad)
                    return false;
                if (later->nops == 0 || later->ops[0] == null) return false;
                if (!mssa->aliasAnalysis->isNoAlias(later->ops[0], addr))
                {
                    // Object-level alias is inconclusive — a same-object
                    // read at a provably disjoint byte range can't
                    // observe this store.
                    u64 rs = 0;
                    u64 ss = 0;
                    if (later->base.type != null)
                        rs = (u64)self.ctx->irTypeSizeOf(later->base.type);
                    if (storeInst->ops[0] != null && storeInst->ops[0]->type != null)
                        ss = (u64)self.ctx->irTypeSizeOf(storeInst->ops[0]->type);
                    if (mssa->aliasAnalysis->mayClobberSized(
                            later->ops[0], rs, addr, ss))
                        return false;
                }
            }

            // If a store definitely kills this store (same address, no intervening load), it's dead
            if ((later->opcode == IrOpcode::Store || later->opcode == IrOpcode::AtomicStore) &&
                later->nops >= 2 && later->ops[1] != null)
            {
                if (mssa->aliasAnalysis->isMustAlias(later->ops[1], addr) &&
                    later->ops[0] != null && later->ops[0]->type != null &&
                    storeInst->ops[0] != null && storeInst->ops[0]->type != null &&
                    irTypeEqual(later->ops[0]->type, storeInst->ops[0]->type) &&
                    self.storeValueWidth(later) >= width)
                    return true;
            }

            // Barriers prevent us from determining death
            if (self.isBarrier(later->opcode))
                return false;
        }

        return false;
    }

    // An erased store leaves a dangling pointer in mssa->memDefInst —
    // later findNearestDef* calls would dereference freed ops. Null the
    // slot so the def reads as "unknown, may alias" (conservative).
    void invalidateMemDef(IrInst* inst, MemorySSA* mssa)
    {
        if (inst == null || mssa == null) return;
        if (inst->opcode != IrOpcode::Store &&
            inst->opcode != IrOpcode::AtomicStore) return;
        u32 ver = mssa->getVersionAtInst(inst);
        if (ver > 0 && ver < mssa->numMemVersions &&
            mssa->memDefInst[ver] == inst)
            mssa->memDefInst[ver] = null;
    }

    // Position of an instruction inside its block, or bb->ninsts if absent.
    u32 instIndex(IrBlock* bb, IrInst* inst)
    {
        for (u32 i = 0; i < bb->ninsts; i++)
            if (bb->insts[i] == inst) return i;
        return bb->ninsts;
    }

    // May `killer`'s stored value be forwarded to `load`? All conditions
    // are required:
    //   C0 — caller-established must-alias: isStoreToAddr (same address
    //        SSA value) plus equal access widths.
    //   C1 — the killer dominates the load: same block with the killer
    //        earlier (straight-line), or the killer's block dominates the
    //        load's block.
    //   C2 — region scan: no aliasing store or barrier between them. Every
    //        block dominated by the killer's block is scanned — the
    //        killer's block from after the killer, the load's block up to
    //        the load, all others in full. If the killer dominates the
    //        load, any writer on a killer→load path lies in this region.
    bool canForward(IrInst* killer, IrInst* load, IrFunc* func, IrDomTree* dt, MemorySSA* mssa)
    {
        if (killer == null || load == null || func == null) return false;
        IrBlock* kb = killer->parent;
        IrBlock* lb = load->parent;
        if (kb == null || lb == null) return false;

        u32 kIdx = self.instIndex(kb, killer);
        u32 lIdx = self.instIndex(lb, load);
        if (kIdx >= kb->ninsts || lIdx >= lb->ninsts) return false;

        if (kb == lb)
        {
            if (kIdx >= lIdx) return false;
        }
        else
        {
            if (dt == null || !irDomtreeDominates(dt, kb, lb)) return false;
        }

        for (u32 pi = 0; pi < func->nblocks; pi++)
        {
            IrBlock* pb = func->blocks[pi];
            if (pb == null) continue;
            if (pb != kb && !irDomtreeDominates(dt, kb, pb)) continue;

            u32 from = 0;
            u32 to = pb->ninsts;
            if (pb == kb)
            {
                from = kIdx + 1;
                if (pb == lb) to = lIdx;
            }
            else if (pb == lb)
            {
                to = lIdx;
            }

            for (u32 ii = from; ii < to; ii++)
            {
                IrInst* s = pb->insts[ii];
                if (self.isBarrier(s->opcode)) return false;
                if (s->opcode == IrOpcode::Store && s->nops >= 2 && s->ops[1] != null)
                {
                    if (mssa->aliasAnalysis == null) return false;
                    if (!mssa->aliasAnalysis->isNoAlias(s->ops[1], load->ops[0]))
                    {
                        // Same-object disjoint ranges don't block the
                        // forward — the load's bytes still come from
                        // the killer store.
                        u64 ls = 0;
                        u64 ss = 0;
                        if (load->base.type != null)
                            ls = (u64)self.ctx->irTypeSizeOf(load->base.type);
                        if (s->ops[0] != null && s->ops[0]->type != null)
                            ss = (u64)self.ctx->irTypeSizeOf(s->ops[0]->type);
                        if (mssa->aliasAnalysis->mayClobberSized(
                                load->ops[0], ls, s->ops[1], ss))
                            return false;
                    }
                }
            }
        }
        return true;
    }

    // Eliminate dead stores across the function
    bool eliminateDeadStores(IrFunc* func, MemorySSA* mssa)
    {
        bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Store && inst->nops >= 2 && inst->ops[1] != null)
                {
                    IrValue* storeAddr = inst->ops[1];
                    u32 storeWidth = self.storeValueWidth(inst);

                    if (self.isStoreDead(inst, storeAddr, storeWidth, mssa))
                    {
                        self.invalidateMemDef(inst, mssa);
                        inst->erase();
                        self.storesEliminated++;
                        changed = true;
                        continue;
                    }
                }
                ii++;
            }
        }

        return changed;
    }

    bool isBarrier(IrOpcode op)
    {
        switch (op)
        {
            IrOpcode::Call |
            IrOpcode::AtomicLoad |
            IrOpcode::AtomicStore |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg |
            IrOpcode::Fence |
            IrOpcode::InlineAsm |
            IrOpcode::GcRoot |
            IrOpcode::GcWriteBarrier |
            IrOpcode::GcSafepoint |
            IrOpcode::LandingPad => { return true; },

            else => { return false; },
        }
    }

    // Memory reads that must keep a prior store alive. Includes atomics
    // and calls — they genuinely observe memory. (Forwarding candidates
    // are narrower: plain Load only, see processBlockWithMemorySSA.)
    bool isMemoryRead(IrOpcode op)
    {
        switch (op)
        {
            IrOpcode::Load |
            IrOpcode::AtomicLoad |
            IrOpcode::Call |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg => { return true; },

            else => { return false; },
        }
    }

    bool isStoreToAddr(IrInst* inst, IrValue* addr)
    {
        if (inst->opcode != IrOpcode::Store && inst->opcode != IrOpcode::AtomicStore)
            return false;
        if (inst->nops < 2 || inst->ops[1] == null) return false;
        return inst->ops[1]->id == addr->id;
    }

    // ------------------------------------------------------------------
    // Cross-block redundant load elimination.
    //
    // A load is redundant when an earlier load of the same canonical
    // address and type dominates it with no may-alias write on any
    // path between — exactly the canForward contract with the earlier
    // load as "killer". Loads are visited in domtree preorder so every
    // dominator is seen before its dominated blocks; per-address
    // candidate chains are capped to bound the region scans.
    // ------------------------------------------------------------------
    IrValue* canonAddr(IrValue* v)
    {
        while (v != null && v->kind == IrValueKind::Inst)
        {
            IrInst* i = (IrInst*)v;
            if (i->opcode == IrOpcode::Bitcast && i->nops >= 1)
            {
                v = i->ops[0];
                continue;
            }
            if (i->opcode == IrOpcode::Gep && i->nops >= 2)
            {
                bool allZero = true;
                for (u32 k = 1; k < i->nops; k++)
                {
                    if (i->ops[k] == null ||
                        i->ops[k]->kind != IrValueKind::ConstInt ||
                        i->ops[k]->valData != 0)
                    {
                        allZero = false;
                        break;
                    }
                }
                if (allZero) { v = i->ops[0]; continue; }
            }
            break;
        }
        return v;
    }

    u32 loadCandCap;
    LoadCand* loadCands;
    u32 nLoadCands;

    usize* lcKeys;
    i32* lcVals;
    u32 lcMask;

    void ensureLoadCands(u32 need)
    {
        if (need <= self.loadCandCap) return;
        u32 nc = self.loadCandCap ? self.loadCandCap * 2 : 64;
        while (nc < need) nc *= 2;
        LoadCand* nn = alloc<LoadCand>((usize)nc);
        for (u32 i = 0; i < self.nLoadCands; i++) nn[i] = self.loadCands[i];
        if (self.loadCands != null) dealloc<LoadCand>(self.loadCands);
        self.loadCands = nn;
        self.loadCandCap = nc;
    }

    void ensureLcMap(u32 need)
    {
        u32 want = 16;
        while (want < need * 2) want *= 2;
        if (self.lcMask + 1 >= want) return;
        if (self.lcKeys != null) { dealloc<usize>(self.lcKeys); dealloc<i32>(self.lcVals); }
        self.lcKeys = alloc<usize>((usize)want);
        self.lcVals = alloc<i32>((usize)want);
        for (u32 i = 0; i < want; i++) { self.lcKeys[i] = 0; self.lcVals[i] = -1; }
        self.lcMask = want - 1;
        // rehash existing candidates
        for (u32 i = 0; i < self.nLoadCands; i++)
        {
            usize k = (usize)self.loadCands[i].addr;
            u32 h = (u32)(((u64)k * 0x9E3779B1UL) >> 16) & self.lcMask;
            while (self.lcKeys[h] != 0 && self.lcKeys[h] != k)
                h = (h + 1) & self.lcMask;
            if (self.lcKeys[h] == 0) self.lcKeys[h] = k;
            self.loadCands[i].next = self.lcVals[h];
            self.lcVals[h] = (i32)i;
        }
    }

    i32 lcHead(usize key)
    {
        if (self.lcKeys == null) return -1;
        u32 h = (u32)(((u64)key * 0x9E3779B1UL) >> 16) & self.lcMask;
        while (self.lcKeys[h] != 0)
        {
            if (self.lcKeys[h] == key) return self.lcVals[h];
            h = (h + 1) & self.lcMask;
        }
        return -1;
    }

    void lcPush(usize key, i32 idx)
    {
        u32 h = (u32)(((u64)key * 0x9E3779B1UL) >> 16) & self.lcMask;
        while (self.lcKeys[h] != 0 && self.lcKeys[h] != key)
            h = (h + 1) & self.lcMask;
        if (self.lcKeys[h] == 0) self.lcKeys[h] = key;
        self.loadCands[idx].next = self.lcVals[h];
        self.lcVals[h] = idx;
    }

    void lcReset()
    {
        self.nLoadCands = 0;
        if (self.lcKeys != null)
            for (u32 i = 0; i <= self.lcMask; i++) { self.lcKeys[i] = 0; self.lcVals[i] = -1; }
    }

    void loadCandDeinit()
    {
        if (self.loadCands != null) dealloc<LoadCand>(self.loadCands);
        if (self.lcKeys != null) dealloc<usize>(self.lcKeys);
        if (self.lcVals != null) dealloc<i32>(self.lcVals);
        self.loadCands = null;
        self.lcKeys = null;
        self.lcVals = null;
        self.loadCandCap = 0;
        self.nLoadCands = 0;
        self.lcMask = 0;
    }

    bool lcScanBlock(IrInst* inst, IrFunc* func, IrDomTree* dt, MemorySSA* mssa)
    {
        // caller guarantees opcode == Load with ops[0] and type
        IrValue* caddr = self.canonAddr(inst->ops[0]);
        if (caddr == null || inst->base.type == null) return false;
        usize key = (usize)caddr;
        self.ensureLcMap(self.nLoadCands + 8);
        i32 ci = self.lcHead(key);
        u32 tried = 0;
        while (ci >= 0 && tried < 8)
        {
            LoadCand* cd = &self.loadCands[ci];
            tried++;
            if (cd->ty != null && inst->base.type != null &&
                irTypeEqual(cd->ty, inst->base.type) &&
                cd->inst != null && cd->inst->parent != null &&
                self.canForward(cd->inst, inst, func, dt, mssa))
            {
                inst->base.replaceAllUses(&cd->inst->base);
                inst->erase();
                self.loadsEliminated++;
                return true;
            }
            ci = cd->next;
        }
        // survives — becomes a candidate for later loads
        self.ensureLoadCands(self.nLoadCands + 1);
        u32 ni = self.nLoadCands++;
        self.loadCands[ni].inst = inst;
        self.loadCands[ni].addr = caddr;
        self.loadCands[ni].ty = inst->base.type;
        self.loadCands[ni].next = -1;
        self.lcPush(key, (i32)ni);
        return false;
    }

    void lcWalk(IrFunc* func, IrDomTree* dt, IrBlock* bb, MemorySSA* mssa, bool* changed)
    {
        if (bb == null) return;
        u32 i = 0;
        while (i < bb->ninsts)
        {
            IrInst* inst = bb->insts[i];
            if (inst != null && inst->opcode == IrOpcode::Load &&
                inst->nops > 0 && inst->ops[0] != null &&
                self.lcScanBlock(inst, func, dt, mssa))
            {
                *changed = true;
                continue;   // erased: insts shifted, same index is next
            }
            i++;
        }
        u32 nc = irDomtreeChildCount(dt, bb);
        for (u32 i = 0; i < nc; i++)
            self.lcWalk(func, dt, irDomtreeChild(dt, bb, i), mssa, changed);
    }

    bool eliminateRedundantLoads(IrFunc* func, MemorySSA* mssa, IrDomTree* dt)
    {
        if (func == null || dt == null) return false;
        self.lcReset();
        bool changed = false;
        self.lcWalk(func, dt, func->blocks[0], mssa, &changed);
        self.loadCandDeinit();
        return changed;
    }
}

pub bool muvmPassMachineOpt(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    MachineOptPass pass = MachineOptPass::new(ctx);
    return pass.run(func);
}
