#[[no_drop_all]]
// MergeFunctions — LLVM mergefunc / GCC ipa-icf equivalent.
//
// Finds function pairs with identical bodies (alpha-equivalent SSA:
// same opcode sequence, same constants, same arg indices, same block
// structure, operands referring to corresponding values) and merges
// them: all uses of the duplicate's func value are replaced by the
// canonical's, then the duplicate is dropped from the module.
//
// Conservative v1:
//   - externs and funcs carrying metadata are skipped (param attrs
//     like !dereferenceable/!noalias are per-function contracts)
//   - blocks are compared in order — reordering defeats the match but
//     never causes a wrong merge
//   - funcs over 800 instructions are skipped (keeps the positional
//     operand lookup bounded)
//
// Correctness: the equivalence check is total — every operand of
// every instruction must match under the positional mapping, including
// terminator targets, phi incoming (value, pred-block) pairs, call
// callees, and self-recursive func references (f1↔f2).
//
// Runs once per module — guarded on func == module->funcs[0] since the
// pass driver invokes every pipeline entry once per function.

import muvm::irtypes { IrContext, IrFunc, IrModule, IrBlock, IrInst, IrValue, IrValueKind, IrType, IrTypeKind };
import muvm::irOps { IrOpcode };
import muvm::irMetadata { funcParamDerefBytes, funcParamNoAlias };
import muvm::passes::common { gVerbose };
import std::mman { alloc, dealloc };
import std::ios { eprintln };

u64 mfMix(u64 h, u64 v)
{
    return (h ^ v) * 1099511628211ULL;
}

struct MergeFunc
{
    IrContext* ctx;
    IrModule* mod;
    u32 changes;

    MergeFunc new(IrContext* c, IrModule* m, u32 ch)
    {
        return MergeFunc { .ctx = c, .mod = m, .changes = ch };
    }

    // structural hash: opcode/type/const/arg-index features only —
    // no value ids or names, so twins hash identically
    u64 hashFunc(IrFunc* f)
    {
        u64 h = 1469598103934665603ULL;
        h = mfMix(h, (u64)f->nargs);
        h = mfMix(h, (u64)(f->retType != null ? (u64)f->retType->kind : 0));
        h = mfMix(h, (u64)f->nblocks);
        for (u32 bi = 0; bi < f->nblocks; bi++)
        {
            IrBlock* bb = f->blocks[bi];
            if (bb == null) continue;
            h = mfMix(h, (u64)bb->ninsts);
            h = mfMix(h, (u64)bb->nsuccs);
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* in = bb->insts[ii];
                if (in == null) continue;
                h = mfMix(h, (u64)in->opcode);
                h = mfMix(h, (u64)in->nops);
                if (in->base.type != null) h = mfMix(h, (u64)in->base.type->kind);
                for (u32 oi = 0; oi < in->nops; oi++)
                {
                    IrValue* ov = in->ops[oi];
                    if (ov == null) { h = mfMix(h, 0); continue; }
                    h = mfMix(h, (u64)ov->kind + 1);
                    if (ov->kind == IrValueKind::ConstInt) h = mfMix(h, ov->valData);
                    else if (ov->kind == IrValueKind::ConstFloat) h = mfMix(h, ov->valData);
                    else if (ov->kind == IrValueKind::Arg)
                    {
                        i64 ai = -1;
                        for (u32 a = 0; a < f->nargs; a++)
                            if (f->args[a] == ov) { ai = (i64)a; break; }
                        h = mfMix(h, (u64)(ai + 1));
                    }
                    else if (ov->kind == IrValueKind::Inst)
                        h = mfMix(h, (u64)((IrInst*)ov)->opcode);
                    else if (ov->kind == IrValueKind::Global)
                        h = mfMix(h, ov->valData);
                }
            }
        }
        return h;
    }

    // position of inst within its func: (blockIdx<<20)|instIdx or ~0
    u64 instPos(IrFunc* f, IrInst* target)
    {
        for (u32 bi = 0; bi < f->nblocks; bi++)
        {
            IrBlock* bb = f->blocks[bi];
            if (bb == null) continue;
            for (u32 ii = 0; ii < bb->ninsts; ii++)
                if (bb->insts[ii] == target) return ((u64)bi << 20) | (u64)ii;
        }
        return 0xFFFFFFFFFFFFFFFFULL;
    }

    // does v2 (operand in f2) correspond to v1 (operand in f1)?
    bool operandEq(IrFunc* f1, IrFunc* f2, IrValue* v1, IrValue* v2)
    {
        if (v1 == null || v2 == null) return v1 == v2;
        if (v1->kind != v2->kind) return false;
        switch (v1->kind)
        {
            IrValueKind::ConstInt | IrValueKind::ConstFloat =>
                return v1->valData == v2->valData;
            IrValueKind::Arg =>
            {
                for (u32 a = 0; a < f1->nargs; a++)
                    if (f1->args[a] == v1)
                        return a < f2->nargs && f2->args[a] == v2;
                return false;
            }
            IrValueKind::Global =>
                return v1 == v2;
            IrValueKind::Func =>
            {
                if ((IrFunc*)v2 == f2) return (IrFunc*)v1 == f1;
                return v1 == v2;
            }
            IrValueKind::Inst =>
            {
                u64 p1 = self.instPos(f1, (IrInst*)v1);
                u64 p2 = self.instPos(f2, (IrInst*)v2);
                return p1 != 0xFFFFFFFFFFFFFFFFULL && p1 == p2;
            }
            IrValueKind::Block =>
            {
                u64 p1 = 0xFFFFFFFFFFFFFFFFULL;
                u64 p2 = 0xFFFFFFFFFFFFFFFFULL;
                for (u32 b = 0; b < f1->nblocks; b++)
                    if ((IrValue*)&f1->blocks[b]->base == v1) { p1 = (u64)b; break; }
                for (u32 b = 0; b < f2->nblocks; b++)
                    if ((IrValue*)&f2->blocks[b]->base == v2) { p2 = (u64)b; break; }
                return p1 != 0xFFFFFFFFFFFFFFFFULL && p1 == p2;
            }
            else =>
                return v1 == v2;
        }
    }

    bool funcEq(IrFunc* f1, IrFunc* f2)
    {
        if (f1 == f2) return true;
        if (f1 == null || f2 == null) return false;
        if (f1->isExtern || f2->isExtern) return false;
        if (f1->nargs != f2->nargs || f1->nblocks != f2->nblocks) return false;
        // Param attrs are per-function contracts callers may already
        // have exploited (!dereferenceable justifies speculation,
        // !noalias proves disjointness) — they must match exactly.
        // Func-level memattrs needn't: identical bodies have identical
        // true effects, so the canonical's attrs remain correct.
        for (u32 pi = 0; pi < f1->nargs; pi++)
        {
            if (funcParamDerefBytes(f1, pi) != funcParamDerefBytes(f2, pi))
                return false;
            if (funcParamNoAlias(f1, pi) != funcParamNoAlias(f2, pi))
                return false;
        }
        if (f1->retType == null || f2->retType == null ||
            f1->retType != f2->retType) return false;
        u64 total = 0;
        for (u32 b = 0; b < f1->nblocks; b++)
            total += f1->blocks[b] != null ? (u64)f1->blocks[b]->ninsts : 0ULL;
        if (total > 800) return false;

        for (u32 bi = 0; bi < f1->nblocks; bi++)
        {
            IrBlock* b1 = f1->blocks[bi];
            IrBlock* b2 = f2->blocks[bi];
            if (b1 == null || b2 == null) return b1 == b2;
            if (b1->ninsts != b2->ninsts) return false;
            for (u32 ii = 0; ii < b1->ninsts; ii++)
            {
                IrInst* i1 = b1->insts[ii];
                IrInst* i2 = b2->insts[ii];
                if (i1 == null || i2 == null) return i1 == i2;
                if (i1->opcode != i2->opcode || i1->nops != i2->nops) return false;
                for (u32 oi = 0; oi < i1->nops; oi++)
                    if (!self.operandEq(f1, f2, i1->ops[oi], i2->ops[oi]))
                        return false;
            }
        }
        return true;
    }

    bool run()
    {
        IrModule* m = self.mod;
        if (m == null) return false;
        u32 n = m->nfuncs;
        if (n < 2) return false;

        u64* hashes = alloc<u64>((usize)n);
        for (u32 i = 0; i < n; i++)
            hashes[i] = m->funcs[i] != null ? self.hashFunc(m->funcs[i]) : 0;

        // pairwise over hash-equal candidates; n is module func count
        for (u32 i = 0; i < n; i++)
        {
            IrFunc* f1 = m->funcs[i];
            if (f1 == null || f1->isExtern) continue;
            for (u32 j = i + 1; j < n; j++)
            {
                IrFunc* f2 = m->funcs[j];
                if (f2 == null || f2->isExtern) continue;
                if (hashes[i] != hashes[j]) continue;
                if (!self.funcEq(f1, f2)) continue;
                f2->base.replaceAllUses(&f1->base);
                for (u32 k = j; k + 1 < n; k++) m->funcs[k] = m->funcs[k + 1];
                m->nfuncs--;
                n--;
                j--;
                self.changes++;
                if (gVerbose) eprintln("mergefunc: merged {} into {}", f2->base.name, f1->base.name);
            }
        }
        dealloc<u64>(hashes);
        return self.changes > 0;
    }
}

pub bool muvmPassMergeFunc(IrFunc* func, rawptr userdata)
{
    IrModule* m = func != null ? func->parent : null;
    if (m == null || m->nfuncs == 0 || m->funcs[0] != func) return false;
    MergeFunc st = MergeFunc::new(m->ctx, m, 0);
    return st.run();
}
