#[[no_drop_all]]
// Safety-check instrumentation for muvm — opt-in, never on by default.
// Mirrors the wallvm pass in algorithm (it is a clean design): find every
// site that can fail — fixed-array GEP bounds, null deref, division by
// zero, signed/unsigned add/sub overflow — splice a conditional
// `call trap(...)` before it, and rely on the dominance proof to
// eliminate duplicate checks on the same SSA values.
//
// Trap ABI (shared with the wallvm runtime and any embedding):
//
//     void trap(u64 kind, u64 a, u64 b, const cchar* file, u64 line,
//               const cchar* fn)
//
// kind 0 bounds      a=index, b=len      ok when a < b   (gep on fixed array)
// kind 1 null        a=ptr               ok when a != 0  (load/store)
// kind 2 divzero     a=divisor           ok when a != 0  (sdiv/udiv/srem/urem)
// kind 3 overflow    a=overflow oflag     ok when a == 0  (signed/unsigned add/sub)
// kind 4 badvariant  a=tag, b=nvariants  ok when a < b   (not instrumented)
//
// The callee name is whatever the embedding supplies — MuvmOptions.trapName.
// muvm never links a runtime of its own; the embedding decides which
// symbol the checks call (coral's `core/error.crl` under its mangled
// name, an application's own `my_trap` for a non-Coral host, a test
// stub under plain `_trap`). If a module already declares an extern with
// the requested name, the pass reuses it; otherwise one is synthesized.
// Overflow checks: add/sub only, signed and unsigned (the `.u` suffix
// from add.u/sub.u, IR_AUX_UNSIGNED). Mul needs a guarded-div CFG split
// and is intentionally absent — see docs/overflow-checks.md.

import muvm::passes::common { gVerbose };
import muvm::irOps { IrOpcode, IrICmpPred, irOpcodeIsTerminator };
import muvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType, IrTypeKind, IrStringConst };
import muvm::domtree { IrDomTree, irDomtreeNew, irDomtreeDominates, irDomtreeFree };
import std::mman { alloc, dealloc, copy };

pub const u64 TRAP_BOUNDS = 0;
pub const u64 TRAP_NULL = 1;
pub const u64 TRAP_DIVZERO = 2;
pub const u64 TRAP_OVERFLOW = 3;
pub const u64 TRAP_BADVARIANT = 4;

struct SafetySite
{
    IrBlock* bb;
    IrInst* anchor;
    u64 kind;
    IrValue* a;
    IrValue* b;
    str file;
    u32 line;
    // overflow sites insert AFTER the arithmetic; the oflag chain and the
    // trap call go immediately before this instruction (captured during
    // scan, before any insertion). null = insert before anchor.
    IrInst* after;
    u32 pos;
}

struct SafetyPass
{
    IrContext* ctx;
    IrModule* module;
    str trapName;
    SafetySite* sites;
    u32 nsites;
    u32 capSites;
    bool* skip;

    static SafetyPass new(IrContext* ctx, IrModule* module, str trapName)
    {
        return SafetyPass {
            .ctx = ctx,
            .module = module,
            .trapName = trapName,
            .sites = null,
            .nsites = 0,
            .capSites = 0,
            .skip = null
        };
    }

    void deinit()
    {
        if (self.sites != null) dealloc<SafetySite>(self.sites);
        self.sites = null;
        self.nsites = 0;
        self.capSites = 0;
        if (self.skip != null) dealloc<bool>(self.skip);
        self.skip = null;
    }

    bool provenNonNull(IrValue* v)
    {
        if (v == null) return true;
        if (v->kind == IrValueKind::Global ||
            v->kind == IrValueKind::Func ||
            v->kind == IrValueKind::StringConst) return true;
        if (v->kind == IrValueKind::ConstInt) return v->valData != 0;
        if (v->kind != IrValueKind::Inst) return false;
        IrInst* i = (IrInst*)v;
        if (i->opcode == IrOpcode::Alloca) return true;
        if (i->opcode == IrOpcode::Gep || i->opcode == IrOpcode::Bitcast)
            return i->nops > 0 && self.provenNonNull(i->ops[0]);
        return false;
    }

    void addSite(IrBlock* bb, IrInst* anchor, u64 kind, IrValue* a, IrValue* b, IrInst* after)
    {
        if (self.nsites >= self.capSites)
        {
            u32 nc = self.capSites ? self.capSites * 2 : 16;
            SafetySite* ns = alloc<SafetySite>((usize)nc);
            if (self.sites != null)
            {
                copy<SafetySite>(ns, self.sites, (usize)self.nsites);
                dealloc<SafetySite>(self.sites);
            }
            self.sites = ns;
            self.capSites = nc;
        }
        str file = anchor->debugLoc.file;
        if (file.isEmpty()) file = "?";
        u32 pos = 0;
        for (u32 k = 0; k < bb->ninsts; k++)
            if (bb->insts[k] == anchor) { pos = k; break; }
        if (kind == TRAP_OVERFLOW) pos++;
        self.sites[self.nsites].bb = bb;
        self.sites[self.nsites].anchor = anchor;
        self.sites[self.nsites].kind = kind;
        self.sites[self.nsites].a = a;
        self.sites[self.nsites].b = b;
        self.sites[self.nsites].file = file;
        self.sites[self.nsites].line = anchor->debugLoc.line;
        self.sites[self.nsites].after = after;
        self.sites[self.nsites].pos = pos;
        self.nsites++;
    }

    void scanFunc(IrFunc* func)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (bb == null) continue;
            for (u32 i = 0; i < bb->ninsts; i++)
            {
                IrInst* inst = bb->insts[i];
                if (inst == null) continue;
                switch (inst->opcode)
                {
                    IrOpcode::Load => {
                        if (inst->nops > 0 && !self.provenNonNull(inst->ops[0]))
                            self.addSite(bb, inst, TRAP_NULL, inst->ops[0], null, null);
                    },
                    IrOpcode::Store => {
                        if (inst->nops > 1 && !self.provenNonNull(inst->ops[1]))
                            self.addSite(bb, inst, TRAP_NULL, inst->ops[1], null, null);
                    },
                    IrOpcode::SDiv | IrOpcode::UDiv |
                    IrOpcode::SRem | IrOpcode::URem => {
                        if (inst->nops > 1)
                        {
                            IrValue* d = inst->ops[1];
                            bool lit = d != null && d->kind == IrValueKind::ConstInt;
                            if (!lit || d->valData == 0)
                                self.addSite(bb, inst, TRAP_DIVZERO, d, null, null);
                        }
                    },
                    // add/sub checked; mul deliberately absent (needs a
                    // guarded-div split). Signed from the op, unsigned
                    // from the IR_AUX_UNSIGNED aux tag (add.u/sub.u).
                    IrOpcode::Add | IrOpcode::Sub => {
                        if (inst->nops > 1 && inst->base.type != null &&
                            inst->base.type->kind == IrTypeKind::Int)
                        {
                            IrInst* after = (i + 1 < bb->ninsts) ? bb->insts[i + 1] : null;
                            self.addSite(bb, inst, TRAP_OVERFLOW, inst->ops[0], inst->ops[1], after);
                        }
                    },
                    IrOpcode::Gep => {
                        if (inst->nops == 2)
                        {
                            IrValue* base = inst->ops[0];
                            IrType* arrTy = null;
                            if (base != null && base->type != null &&
                                base->type->kind == IrTypeKind::Array)
                                arrTy = base->type;
                            else if (base != null && base->type != null &&
                                     base->type->kind == IrTypeKind::Ptr &&
                                     base->type->elem != null &&
                                     base->type->elem->kind == IrTypeKind::Array)
                                arrTy = base->type->elem;
                            if (arrTy != null)
                            {
                                IrValue* idx = inst->ops[1];
                                u32 len = arrTy->count;
                                if (len == 0) { }
                                else
                                {
                                    bool lit = idx != null && idx->kind == IrValueKind::ConstInt;
                                    if (!lit || idx->valData >= (u64)len)
                                    {
                                        IrValue* lb = self.ctx->constInt(self.ctx->tyInt(64), (u64)len);
                                        self.addSite(bb, inst, TRAP_BOUNDS, idx, lb, null);
                                    }
                                }
                            }
                        }
                    },
                    else => { },
                }
            }
        }
    }

    bool valEq(IrValue* x, IrValue* y)
    {
        if (x == y) return true;
        if (x == null || y == null) return false;
        if (x->kind == IrValueKind::ConstInt && y->kind == IrValueKind::ConstInt)
            return x->valData == y->valData &&
                   x->type != null && y->type != null &&
                   x->type->width == y->type->width;
        return false;
    }

    bool sameCheck(SafetySite* p, SafetySite* q)
    {
        if (p->kind != q->kind) return false;
        if (!self.valEq(p->a, q->a)) return false;
        if (!self.valEq(p->b, q->b)) return false;
        if (p->kind == TRAP_OVERFLOW)
        {
            if (p->anchor->opcode != q->anchor->opcode) return false;
            if (p->anchor->isUnsignedArith() != q->anchor->isUnsignedArith()) return false;
        }
        return true;
    }

    bool covers(IrDomTree* dt, SafetySite* p, SafetySite* q)
    {
        if (!self.sameCheck(p, q)) return false;
        if (p->bb == q->bb) return p->pos < q->pos;
        return irDomtreeDominates(dt, p->bb, q->bb);
    }

    void dedup(IrFunc* func)
    {
        IrDomTree* dt = irDomtreeNew(func);
        if (dt == null) return;
        u32 n = self.nsites;
        bool* skip = alloc<bool>((usize)n);
        for (u32 j = 0; j < n; j++)
        {
            bool s = false;
            for (u32 i = 0; i < n && !s; i++)
                if (i != j && self.covers(dt, &self.sites[i], &self.sites[j]))
                    s = true;
            skip[j] = s;
        }
        self.skip = skip;
        irDomtreeFree(dt);
    }

    // The extern callee: reuse a matching one if the module already has
    // it (an embedding that wants a custom declaration keeps control),
    // else synthesize one named trapName. Always isExtern — the call is
    // emitted as a symbol reference.
    IrFunc* ensureTrap()
    {
        for (u32 i = 0; i < self.module->nfuncs; i++)
        {
            IrFunc* f = self.module->funcs[i];
            if (f->isExtern && f->base.name.equals(self.trapName))
                return f;
        }
        IrType** ps = alloc<IrType*>((usize)6);
        ps[0] = self.ctx->tyInt(64);
        ps[1] = self.ctx->tyInt(64);
        ps[2] = self.ctx->tyInt(64);
        ps[3] = self.ctx->tyPtr(self.ctx->tyInt(8));
        ps[4] = self.ctx->tyInt(64);
        ps[5] = self.ctx->tyPtr(self.ctx->tyInt(8));
        IrFunc* f = self.ctx->createFunc(self.trapName, self.ctx->tyVoid(), ps, 6);
        f->isExtern = true;
        self.module->addFunc(f);
        return f;
    }

    IrInst* splice(SafetySite* s, IrInst* inst, IrValue** ops, u32 nops, IrInst* before)
    {
        for (u32 k = 0; k < nops; k++)
            if (ops[k] != null) ops[k]->addUser(inst);
        inst->setDebugLoc(s->file, s->line, 0);
        if (before != null) s->bb->insertBefore(inst, before);
        else s->bb->addInst(inst);
        return inst;
    }

    IrInst* makeBin(IrOpcode op, IrValue* l, IrValue* r, IrType* ty, SafetySite* s, IrInst* before)
    {
        IrValue*[2] ops;
        ops[0] = l;
        ops[1] = r;
        IrInst* inst = self.ctx->createInst(op, ty, ops, 2, 0, 0);
        return self.splice(s, inst, ops, 2, before);
    }

    IrInst* makeICmp(IrICmpPred p, IrValue* l, IrValue* r, SafetySite* s, IrInst* before)
    {
        IrValue*[2] ops;
        ops[0] = l;
        ops[1] = r;
        IrInst* inst = self.ctx->createInst(IrOpcode::ICmp, self.ctx->tyInt(1), ops, 2, (u64)p, 0);
        return self.splice(s, inst, ops, 2, before);
    }

    IrInst* makeSelect(IrValue* c, IrValue* t, IrValue* f, IrType* ty, SafetySite* s, IrInst* before)
    {
        IrValue*[3] ops;
        ops[0] = c;
        ops[1] = t;
        ops[2] = f;
        IrInst* inst = self.ctx->createInst(IrOpcode::Select, ty, ops, 3, 0, 0);
        return self.splice(s, inst, ops, 3, before);
    }

    void apply(IrFunc* func)
    {
        IrFunc* trap = self.ensureTrap();
        IrValue* trapVal = &trap->base;
        IrType* foo = self.ctx->tyInt(64);
        IrType* voidTy = self.ctx->tyVoid();
        IrValue* zero = self.ctx->constInt(foo, 0);
        IrStringConst* fsc = self.ctx->createStringConst(func->base.name, (u32)func->base.name.len);
        self.module->addConstString(fsc);
        for (u32 i = 0; i < self.nsites; i++)
        {
            if (self.skip != null && self.skip[i]) continue;
            SafetySite* s = &self.sites[i];
            IrStringConst* sc = self.ctx->createStringConst(s->file, (u32)s->file.len);
            self.module->addConstString(sc);
            IrValue* aVal = s->a != null ? s->a : zero;
            IrValue* bVal = s->b != null ? s->b : zero;
            IrInst* insertAt = s->anchor;
            if (s->kind == TRAP_OVERFLOW)
            {
                IrInst* arith = s->anchor;
                IrInst* after = s->after;
                IrType* wty = arith->base.type;
                if (wty == null || wty->kind != IrTypeKind::Int) wty = foo;
                u32 w = wty->width > 0 ? wty->width : 64;
                IrValue* r = (IrValue*)arith;
                IrValue* oflag;
                if (!arith->isUnsignedArith())
                {
                    // sign-bit mask: nonzero exactly when the result's
                    // sign differs from the operands' common sign
                    IrInst* t1;
                    IrInst* t2;
                    if (arith->opcode == IrOpcode::Add)
                    {
                        t1 = self.makeBin(IrOpcode::Xor, aVal, r, wty, s, after);
                        t2 = self.makeBin(IrOpcode::Xor, bVal, r, wty, s, after);
                    }
                    else
                    {
                        t1 = self.makeBin(IrOpcode::Xor, aVal, bVal, wty, s, after);
                        t2 = self.makeBin(IrOpcode::Xor, aVal, r, wty, s, after);
                    }
                    IrInst* m = self.makeBin(IrOpcode::And, (IrValue*)t1, (IrValue*)t2, wty, s, after);
                    IrValue* sh = self.ctx->constInt(wty, (u64)(w - 1));
                    oflag = (IrValue*)self.makeBin(IrOpcode::Ashr, (IrValue*)m, sh, wty, s, after);
                }
                else
                {
                    // carry (add: r <u a) / borrow (sub: a <u b)
                    IrValue* l;
                    IrValue* rr;
                    if (arith->opcode == IrOpcode::Add) { l = r; rr = aVal; }
                    else { l = aVal; rr = bVal; }
                    IrInst* c = self.makeICmp(IrICmpPred::Ult, l, rr, s, after);
                    IrValue* one = self.ctx->constInt(wty, 1);
                    IrValue* zer = self.ctx->constInt(wty, 0);
                    oflag = (IrValue*)self.makeSelect((IrValue*)c, one, zer, wty, s, after);
                }
                aVal = oflag;
                bVal = zero;
                insertAt = after;
            }
            IrValue*[7] args;
            args[0] = trapVal;
            args[1] = self.ctx->constInt(foo, s->kind);
            args[2] = aVal;
            args[3] = bVal;
            args[4] = &sc->base;
            args[5] = self.ctx->constInt(foo, (u64)s->line);
            args[6] = &fsc->base;
            IrInst* call = self.ctx->createInst(IrOpcode::Call, voidTy, args, 7, 0, 0);
            for (u32 k = 0; k < 7; k++)
                if (args[k] != null) args[k]->addUser(call);
            if (insertAt != null) s->bb->insertBefore(call, insertAt);
            else s->bb->addInst(call);
            call->setDebugLoc(s->file, s->line, 0);
        }
    }

    bool run(IrFunc* func)
    {
        if (func == null || self.module == null) return false;
        if (func->isExtern || func->nblocks == 0) return false;
        self.scanFunc(func);
        if (self.nsites == 0) return false;
        if (self.nsites > 1) self.dedup(func);
        self.apply(func);
        return true;
    }
}

// trapName is the symbol the embedding's trap handler resolves to. Pass
// "_trap" (default) for the plain C ABI; pass whatever a non-Coral host
// binds. The signature is fixed (the ABI above) — a differing signature
// is an FFI contract the embedding owns end to end.
pub bool muvmPassSafety(IrFunc* func, IrContext* ctx, str trapName)
{
    if (func == null || ctx == null) return false;
    IrModule* module = func->parent;
    if (module == null) return false;
    if (trapName.isEmpty()) trapName = "_trap";
    SafetyPass pass = SafetyPass::new(ctx, module, trapName);
    bool r = pass.run(func);
    pass.deinit();
    return r;
}
