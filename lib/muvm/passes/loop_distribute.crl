#[[no_drop_all]]
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, FunctionAnalysisCache };
import muvm::irOps { IrOpcode };
import muvm::passes::loop_detect { IrLoop, irLoopDetectNatural };
import muvm::passes::alias_analysis { AliasAnalysis };
import std::mman { alloc, dealloc };
import platform::libc { snprintf };
import core::cchar { cchar };

// Loop Distribution Pass
//
// Splits a loop body into multiple independent loops to enable vectorization
// or improve data locality. For example:
//
//   for i = 0..n            for i = 0..n
//     a[i] = b[i] + c[i]  →   a[i] = b[i] + c[i]
//     d[i] = a[i] * 2          for i = 0..n
//                               d[i] = a[i] * 2
//
// This is useful when:
// 1. One part of the loop body is vectorizable but another isn't
// 2. Different parts access different arrays (reducing cache pressure)
// 3. One part has loop-carried dependencies but another doesn't
//
// Safety criteria:
// 1. The loop must be a counted loop (has induction variable)
// 2. The loop body can be partitioned into independent chains
// 3. No loop-carried dependencies between the partitions
// 4. The loop must have a single latch block

const u32 MAX_PARTITIONS = 16;

pub struct LoopPartition
{
    IrInst** insts;  // Instructions in this partition
    u32 ninsts;
    bool hasStore;                   // Partition contains a store
    bool hasLoad;                    // Partition contains a load
}

pub struct LoopDistributePass
{
    IrContext* ctx;
    u64 distributions;
    u32 blockCounter;

    LoopDistributePass new(IrContext* ctx)
    {
        return LoopDistributePass {
            .ctx = ctx,
            .distributions = 0,
            .blockCounter = 0
        };
    }

    IrBlock* createNamedBlock(IrFunc* func)
    {
        char[32] buf;
        u32 n = (u32)snprintf((cchar*)buf, 32, C"loopdist%u", self.blockCounter++); // is this debug output?
        if (n < 0) n = 0;
        if (n > 31) n = 31;
        IrBlock* bb = self.ctx->createBlock(str::fromParts((const u8*)buf, (usize)n));
        func->addBlock(bb);
        return bb;
    }

    bool run(IrFunc* func)
    {
        self.distributions = 0;

        // Detect all natural loops
        IrLoop** loops = irLoopDetectNatural(func);
        if (loops == null) return false;

        // Check for cached AA
        FunctionAnalysisCache* cache = self.ctx->getOrCreateAnalysisCache(func);
        AliasAnalysis* aaPtr = (AliasAnalysis*)cache->aliasAnalysis;
        AliasAnalysis aa;
        bool ownAA = false;
        if (aaPtr != null && cache->generation == self.ctx->analysisGeneration)
        {
            aa = *aaPtr;
        }
        else
        {
            aa = AliasAnalysis::new(self.ctx);
            aa.analyze(func);
            ownAA = true;
        }

        bool changed = false;

        for (u32 li = 0; loops[li] != null; li++)
        {
            IrLoop* lp = loops[li];
            if (self.canDistribute(lp, &aa))
            {
                if (self.distributeLoop(lp, func, &aa))
                {
                    changed = true;
                    self.distributions++;
                }
            }
        }

        if (ownAA) aa.deinit();
        dealloc<IrLoop*>(loops);
        return changed;
    }

    // Check if a loop can be distributed
    bool canDistribute(IrLoop* lp, AliasAnalysis* aa)
    {
        // Must be a natural loop with a header
        if (lp->header == null || lp->latch == null) return false;

        // Must have an induction variable
        IrInst* phi = self.findInductionVar(lp);
        if (phi == null) return false;

        // Must have at least 2 blocks (header + latch)
        if (lp->nblocks < 2) return false;

        // Check that the loop body has multiple independent chains
        // by looking for instructions that don't depend on each other
        u32 nLoads = 0;
        u32 nStores = 0;

        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            IrBlock* bb = lp->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Load) nLoads++;
                if (inst->opcode == IrOpcode::Store) nStores++;
            }
        }

        // Need at least 2 loads or 2 stores to benefit from distribution
        if (nLoads < 2 && nStores < 2) return false;

        // Check that there are no calls or inline assembly (may alias with anything)
        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            IrBlock* bb = lp->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Call ||
                    inst->opcode == IrOpcode::InlineAsm ||
                    inst->opcode == IrOpcode::AtomicStore ||
                    inst->opcode == IrOpcode::AtomicLoad ||
                    inst->opcode == IrOpcode::AtomicRmw ||
                    inst->opcode == IrOpcode::Fence)
                    return false;
            }
        }

        return true;
    }

    // Distribute a loop into multiple independent loops
    bool distributeLoop(IrLoop* lp, IrFunc* func, AliasAnalysis* aa)
    {
        IrBlock* header = lp->header;
        if (header == null) return false;

        // Real distribution: canonical 2-block counted loop -> one
        // sequential loop per partition. Falls through to the legacy
        // header-fission path when the shape doesn't qualify.
        if (self.distributeCanonical(lp, func, aa)) return true;

        // Partition the loop body into independent chains
        LoopPartition[MAX_PARTITIONS] partitions;
        u32 nPartitions = 0;

        // Simple partitioning, separate loads and stores that don't alias
        self.partitionLoopBody(header, partitions, &nPartitions, MAX_PARTITIONS, aa);

        // Need at least 2 partitions to distribute
        if (nPartitions < 2) return false;

        // The chain has exactly one place to end: the header's single
        // in-loop successor. Two in-loop arms would need the condition
        // re-tested after the chain, and an out-of-loop-only header leaves
        // the body unreachable — both shapes bail (B1b/B1e).
        IrInst* hTerm = header->terminator();
        IrBlock* inTgt = null;
        u32 nIn = 0;
        if (hTerm != null && hTerm->opcode == IrOpcode::Br && hTerm->nops >= 1)
        {
            IrBlock* t = (IrBlock*)hTerm->ops[0];
            for (u32 bi = 0; bi < lp->nblocks; bi++)
                if (lp->blocks[bi] == t) { inTgt = t; nIn = 1; break; }
        }
        else if (hTerm != null && hTerm->opcode == IrOpcode::CondBr && hTerm->nops >= 3)
        {
            for (u32 j = 1; j <= 2; j++)
            {
                IrBlock* t = (IrBlock*)hTerm->ops[j];
                bool inLoop = false;
                for (u32 bi = 0; bi < lp->nblocks && !inLoop; bi++)
                    if (lp->blocks[bi] == t) inLoop = true;
                if (inLoop) { if (inTgt == null) inTgt = t; nIn++; }
            }
        }
        if (nIn != 1) return false;

        // Safety: a partition's stores must not alias memory touched
        // anywhere else in the header. Those accesses keep their position
        // relative to the stores only when the objects are provably
        // distinct (B1d — partitionLoopBody ignores aliasing entirely).
        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            for (u32 ii = 0; ii < partitions[pi].ninsts; ii++)
            {
                IrInst* st = partitions[pi].insts[ii];
                if (st->opcode != IrOpcode::Store) continue;
                IrValue* sAddr = st->nops > 1 ? st->ops[1] : null;
                for (u32 hi = 0; hi < header->ninsts; hi++)
                {
                    IrInst* m = header->insts[hi];
                    if (m->opcode != IrOpcode::Load && m->opcode != IrOpcode::Store) continue;
                    bool inPi = false;
                    for (u32 jj = 0; jj < partitions[pi].ninsts && !inPi; jj++)
                        if (partitions[pi].insts[jj] == m) inPi = true;
                    if (inPi) continue;
                    IrValue* mAddr = m->opcode == IrOpcode::Load
                        ? m->ops[0]
                        : (m->nops > 1 ? m->ops[1] : null);
                    if (!aa->isNoAlias(sAddr, mAddr)) return false;
                }
            }
        }

        // Create new loop bodies for each partition
        IrBlock*[MAX_PARTITIONS] newBlocks;
        for (u32 pi = 0; pi < nPartitions; pi++)
            newBlocks[pi] = self.createNamedBlock(func);

        // Each partition must be self-contained, every header instruction
        // its clones reference is either partitioned (cloned once and
        // shared), a Phi (kept alive in the header), or cloned into the
        // same new block so the erase below cannot dangle the clones
        IrInst**[MAX_PARTITIONS] closure;
        u32[MAX_PARTITIONS] nClosure;
        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            closure[pi] = alloc<IrInst*>((usize)header->ninsts);
            nClosure[pi] = 0;
        }

        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            bool* inClosure = alloc<bool>((usize)header->ninsts);
            for (u32 ii = 0; ii < header->ninsts; ii++) inClosure[ii] = false;

            // Seed with this partition's own instructions
            for (u32 ii = 0; ii < partitions[pi].ninsts; ii++)
            {
                IrInst* inst = partitions[pi].insts[ii];
                for (u32 hi = 0; hi < header->ninsts; hi++)
                {
                    if (header->insts[hi] == inst) { inClosure[hi] = true; break; }
                }
            }

            // Close under non-partitioned, non-Phi operands
            bool grew = true;
            while (grew)
            {
                grew = false;
                for (u32 ii = 0; ii < header->ninsts; ii++)
                {
                    if (!inClosure[ii]) continue;
                    for (u32 oi = 0; oi < header->insts[ii]->nops; oi++)
                    {
                        IrValue* op = header->insts[ii]->ops[oi];
                        if (op == null || op->kind != IrValueKind::Inst) continue;
                        IrInst* opInst = (IrInst*)op;
                        if (opInst->parent != header) continue;
                        if (opInst->opcode == IrOpcode::Phi) continue;

                        // Already-partitioned instructions are remapped to
                        // their own clone and need no extra copy here
                        bool partitioned = false;
                        for (u32 pj = 0; pj < nPartitions; pj++)
                        {
                            for (u32 jj = 0; jj < partitions[pj].ninsts; jj++)
                            {
                                if (partitions[pj].insts[jj] == opInst) { partitioned = true; break; }
                            }
                            if (partitioned) break;
                        }
                        if (partitioned) continue;

                        for (u32 hi = 0; hi < header->ninsts; hi++)
                        {
                            if (header->insts[hi] == opInst && !inClosure[hi])
                            {
                                inClosure[hi] = true;
                                grew = true;
                            }
                        }
                    }
                }
            }

            // In header program order, which is topological within a block
            for (u32 hi = 0; hi < header->ninsts; hi++)
                if (inClosure[hi]) closure[pi][nClosure[pi]++] = header->insts[hi];
            dealloc<bool>(inClosure);
        }

        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            IrBlock* newBlock = newBlocks[pi];

            // Copy this partition's instructions with their needed
            // non-partitioned dependencies, in topological order
            for (u32 ii = 0; ii < nClosure[pi]; ii++)
            {
                IrInst* inst = closure[pi][ii];
                // Clone the instruction
                IrInst* clone = self.ctx->createInst(inst->opcode, inst->base.type, null, inst->nops, 0, 0);
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    clone->ops[oi] = inst->ops[oi];
                    // every operand kind — consts and blocks carry users too
                    if (inst->ops[oi] != null) inst->ops[oi]->addUser(clone);
                }
                clone->parent = newBlock;
                newBlock->addInst(clone);
            }

            // Chain link: the next partition, or — for the last one —
            // where the header's arm used to go (the old header->inTgt
            // edge is removed during retargeting below)
            IrBlock* btarget = (pi + 1 < nPartitions) ? newBlocks[pi + 1] : inTgt;
            IrInst* br = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), null, 1, 0, 0);
            br->ops[0] = &btarget->base;
            btarget->base.addUser(br);
            br->parent = newBlock;
            newBlock->addInst(br);
            newBlock->addSucc(btarget);
        }

        // Remap clone operands so they point at the clones, not the originals
        // we're about to erase
        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            for (u32 ii = 0; ii < nClosure[pi]; ii++)
            {
                IrInst* clone = newBlocks[pi]->insts[ii];
                for (u32 oi = 0; oi < clone->nops; oi++)
                {
                    IrValue* op = clone->ops[oi];
                    if (op != null && op->kind == IrValueKind::Inst)
                    {
                        IrInst* opInst = (IrInst*)op;
                        if (opInst->parent == header)
                        {
                            // Prefer the clone living in the same new block
                            // (covers non-partitioned header instructions
                            // cloned for this partition), then fall back to
                            // the partition that owned the chain
                            bool found = false;
                            for (u32 k = 0; k < nClosure[pi]; k++)
                            {
                                if (closure[pi][k] == opInst)
                                {
                                    IrInst* opClone = newBlocks[pi]->insts[k];
                                    opInst->base.removeUser(clone);
                                    clone->ops[oi] = &opClone->base;
                                    opClone->base.addUser(clone);
                                    found = true;
                                    break;
                                }
                            }
                            if (found) continue;
                            for (u32 pj = 0; pj < nPartitions; pj++)
                            {
                                for (u32 jj = 0; jj < nClosure[pj]; jj++)
                                {
                                    if (closure[pj][jj] == opInst)
                                    {
                                        IrInst* opClone = newBlocks[pj]->insts[jj];
                                        opInst->base.removeUser(clone);
                                        clone->ops[oi] = &opClone->base;
                                        opClone->base.addUser(clone);
                                        found = true;
                                        break;
                                    }
                                }
                                if (found) break;
                            }
                        }
                    }
                }
            }
        }

        // Remove original instructions from header (they've been copied to
        // partitions). Anything still referenced — the terminator's ICmp
        // condition, values the body reads — has to stay, or the header
        // dangles (B1a: the old guard only protected the terminator).
        // Iterating backwards removes users before their producers.
        for (u32 ii = header->ninsts; ii > 0; ii--)
        {
            IrInst* inst = header->insts[ii - 1];
            if (inst != hTerm && inst->opcode != IrOpcode::Phi &&
                inst->base.nusers == 0)
            {
                inst->erase();
            }
        }

        // The header's single in-loop arm now enters the partition chain.
        // Entry edges and the latch backedge are left alone, so the header
        // keeps its phi pairs (B1c). succs[] is patched in place because
        // validate requires succs[k] == cond_br ops[k+1] positionally;
        // removeSucc/addSucc would shuffle the order (B1e).
        if (hTerm->opcode == IrOpcode::Br)
        {
            hTerm->ops[0]->removeUser(hTerm);
            inTgt->removePred(header);
            hTerm->ops[0] = &newBlocks[0]->base;
            newBlocks[0]->base.addUser(hTerm);
            header->succs[0] = newBlocks[0];
            newBlocks[0]->addPred(header);
        }
        else
        {
            for (u32 j = 1; j <= 2; j++)
            {
                if ((IrBlock*)hTerm->ops[j] == inTgt)
                {
                    hTerm->ops[j]->removeUser(hTerm);
                    inTgt->removePred(header);
                    hTerm->ops[j] = &newBlocks[0]->base;
                    newBlocks[0]->base.addUser(hTerm);
                    header->succs[j - 1] = newBlocks[0];
                    newBlocks[0]->addPred(header);
                }
            }
        }

        // The chain ends where the header used to go: rewrite the old
        // target's phi pairs from (v, header) to (v, last partition),
        // since the edge now comes from there.
        {
            IrBlock* last = newBlocks[nPartitions - 1];
            for (u32 k = 0; k < inTgt->ninsts; k++)
            {
                IrInst* phi = inTgt->insts[k];
                if (phi->opcode != IrOpcode::Phi) break;
                for (u32 pk = 1; pk < phi->nops; pk += 2)
                {
                    if (phi->ops[pk] == &header->base)
                    {
                        phi->ops[pk] = &last->base;
                        header->base.removeUser(phi);
                        last->base.addUser(phi);
                    }
                }
            }
        }

        // Free partition allocations
        for (u32 pi = 0; pi < nPartitions; pi++)
        {
            if (partitions[pi].insts != null)
                dealloc<IrInst*>(partitions[pi].insts);
            if (closure[pi] != null)
                dealloc<IrInst*>(closure[pi]);
        }

        return true;
    }

    // ---- canonical loop distribution ----
    // 2-block counted loop (header with all work + pure latch) whose
    // header instructions partition into >=2 independent memory chains
    // becomes N sequential loops, one per partition, each with its own
    // induction variable covering the same trip count.

    bool blockInLoopD(IrBlock* bb, IrLoop* lp)
    {
        for (u32 i = 0; i < lp->nblocks; i++)
            if (lp->blocks[i] == bb) return true;
        return false;
    }

    bool isUncondBrD(IrInst* t)
    {
        return t != null && t->opcode == IrOpcode::Br && t->nops >= 1;
    }

    bool isCondBrD(IrInst* t)
    {
        return t != null && t->opcode == IrOpcode::CondBr && t->nops >= 3;
    }

    IrBlock* termBlockAtD(IrInst* term, u32 idx)
    {
        u32 seen = 0;
        for (u32 j = 0; j < term->nops; j++)
        {
            IrValue* op = term->ops[j];
            if (op == null || op->kind != IrValueKind::Block) continue;
            if (seen == idx) return (IrBlock*)op;
            seen++;
        }
        return null;
    }

    // inst's def is inside the loop (any of its blocks)
    bool defInLoop(IrInst* inst, IrLoop* lp)
    {
        if (inst == null || inst->parent == null) return false;
        return self.blockInLoopD(inst->parent, lp);
    }

    // every user of every loop inst stays inside the loop
    bool noOutsideUses(IrLoop* lp)
    {
        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            IrBlock* bb = lp->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                for (u32 ui = 0; ui < inst->base.nusers; ui++)
                {
                    IrInst* u = inst->base.users[ui];
                    if (u == null || u->parent == null) continue;
                    if (!self.blockInLoopD(u->parent, lp)) return false;
                }
            }
        }
        return true;
    }

    bool distributeCanonical(IrLoop* lp, IrFunc* func, AliasAnalysis* aa)
    {
        // exactly 2 blocks: header + latch
        if (lp->nblocks != 2) return false;
        IrBlock* H = lp->header;
        IrBlock* L = null;
        for (u32 bi = 0; bi < lp->nblocks; bi++)
            if (lp->blocks[bi] != H) L = lp->blocks[bi];
        if (H == null || L == null) return false;

        IrInst* hTerm = H->terminator();
        IrInst* lTerm = L->terminator();
        if (!self.isCondBrD(hTerm) || !self.isUncondBrD(lTerm)) return false;

        // one arm to latch, other to exit
        IrBlock* armT = self.termBlockAtD(hTerm, 0);
        IrBlock* armF = self.termBlockAtD(hTerm, 1);
        IrBlock* EXIT = null;
        if (armT == L && !self.blockInLoopD(armF, lp)) EXIT = armF;
        else if (armF == L && !self.blockInLoopD(armT, lp)) EXIT = armT;
        else return false;
        if (EXIT == null) return false;

        // latch branches back to header
        if (lTerm->nops < 1 || lTerm->ops[0] != &H->base) return false;

        // exit block: no phis
        for (u32 ii = 0; ii < EXIT->ninsts; ii++)
            if (EXIT->insts[ii]->opcode == IrOpcode::Phi) return false;

        // header: exactly one phi (the IV); latch: none
        IrInst* ivPhi = null;
        u32 nPhiH = 0;
        for (u32 ii = 0; ii < H->ninsts; ii++)
        {
            if (H->insts[ii]->opcode == IrOpcode::Phi)
            { nPhiH++; ivPhi = H->insts[ii]; }
        }
        if (nPhiH != 1 || ivPhi == null) return false;
        for (u32 ii = 0; ii < L->ninsts; ii++)
            if (L->insts[ii]->opcode == IrOpcode::Phi) return false;

        // compare feeding the cond_br must be an ICmp in the header
        IrValue* condV = hTerm->ops[0];
        if (condV == null || condV->kind != IrValueKind::Inst) return false;
        IrInst* cmp = (IrInst*)condV;
        if (cmp->opcode != IrOpcode::ICmp || cmp->parent != H) return false;

        // iv phi: init outside loop; backedge value defined in latch
        if (ivPhi->nops < 4) return false;
        IrValue* initV = ivPhi->ops[0];
        if (initV != null && initV->kind == IrValueKind::Inst &&
            self.defInLoop((IrInst*)initV, lp)) return false;
        IrValue* backV = null;
        for (u32 pk = 0; pk + 1 < ivPhi->nops; pk += 2)
        {
            if (ivPhi->ops[pk + 1] == &L->base) backV = ivPhi->ops[pk];
        }
        if (backV == null || backV->kind != IrValueKind::Inst) return false;
        IrInst* incr = (IrInst*)backV;
        if (incr->parent != L) return false;

        // single outside predecessor of H (preheader)
        IrBlock* pre = null;
        u32 nOut = 0;
        for (u32 pi = 0; pi < H->npreds; pi++)
        {
            IrBlock* p = H->preds[pi];
            if (!self.blockInLoopD(p, lp)) { pre = p; nOut++; }
        }
        if (nOut != 1 || pre == null) return false;

        // latch non-terminator insts: pure only, operands not defined in H
        for (u32 ii = 0; ii < L->ninsts; ii++)
        {
            IrInst* inst = L->insts[ii];
            if (inst == lTerm) continue;
            switch (inst->opcode)
            {
                IrOpcode::Load | IrOpcode::Store | IrOpcode::Call |
                IrOpcode::InlineAsm | IrOpcode::AtomicStore |
                IrOpcode::AtomicLoad | IrOpcode::AtomicRmw |
                IrOpcode::AtomicCmpXchg | IrOpcode::Fence |
                IrOpcode::Phi | IrOpcode::Br | IrOpcode::CondBr |
                IrOpcode::Ret | IrOpcode::Switch | IrOpcode::Unreachable |
                IrOpcode::Noret => { return false; },
                else => { },
            }
            for (u32 oi = 0; oi < inst->nops; oi++)
            {
                IrValue* op = inst->ops[oi];
                if (op == null || op->kind != IrValueKind::Inst) continue;
                IrInst* opI = (IrInst*)op;
                if (opI->parent == H && opI != ivPhi) return false;
            }
        }

        // no uses of loop values outside the loop
        if (!self.noOutsideUses(lp)) return false;

        // partition header insts; every load/store must land in one
        LoopPartition[MAX_PARTITIONS] parts;
        u32 nParts = 0;
        self.partitionLoopBody(H, parts, &nParts, MAX_PARTITIONS, aa);
        if (nParts < 2) return false;

        // map header inst -> partition id (-1 = not partitioned)
        i32[128] partOf;
        // header->ninsts can exceed the fixed map; bail if huge
        if (H->ninsts > 128) return false;
        for (u32 ii = 0; ii < H->ninsts; ii++) partOf[ii] = -1;
        u32 nMem = 0;
        for (u32 pi = 0; pi < nParts; pi++)
        {
            for (u32 ii = 0; ii < parts[pi].ninsts; ii++)
            {
                IrInst* inst = parts[pi].insts[ii];
                for (u32 hi = 0; hi < H->ninsts; hi++)
                    if (H->insts[hi] == inst) partOf[hi] = (i32)pi;
            }
        }
        // every store must be partitioned; loads may stay unpartitioned
        // (the closure clones them into whichever loop needs them, and
        // the alias gate below proves no store can invalidate the reads)
        for (u32 ii = 0; ii < H->ninsts; ii++)
        {
            if (H->insts[ii]->opcode == IrOpcode::Store && partOf[ii] < 0)
                return false;
        }

        // partitioned insts: users inside header must stay in-partition;
        // non-partitioned insts: header operands must be non-partitioned
        for (u32 hi = 0; hi < H->ninsts; hi++)
        {
            IrInst* inst = H->insts[hi];
            if (inst->opcode == IrOpcode::Phi || inst == hTerm) continue;
            i32 pi = partOf[hi];
            if (pi >= 0)
            {
                for (u32 ui = 0; ui < inst->base.nusers; ui++)
                {
                    IrInst* u = inst->base.users[ui];
                    if (u == null || u->parent != H) continue;
                    // find u's partition
                    i32 up = -2;
                    for (u32 hj = 0; hj < H->ninsts; hj++)
                        if (H->insts[hj] == u) { up = partOf[hj]; break; }
                    if (up != pi) return false;
                }
            }
            else
            {
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* op = inst->ops[oi];
                    if (op == null || op->kind != IrValueKind::Inst) continue;
                    IrInst* opI = (IrInst*)op;
                    if (opI->parent != H || opI == ivPhi || opI == hTerm) continue;
                    for (u32 hj = 0; hj < H->ninsts; hj++)
                        if (H->insts[hj] == opI && partOf[hj] >= 0) return false;
                }
            }
        }

        // alias safety: a partition's stores must not alias any memop
        // outside that partition (same check as the fission path)
        for (u32 pi = 0; pi < nParts; pi++)
        {
            for (u32 ii = 0; ii < parts[pi].ninsts; ii++)
            {
                IrInst* st = parts[pi].insts[ii];
                if (st->opcode != IrOpcode::Store) continue;
                IrValue* sAddr = st->nops > 1 ? st->ops[1] : null;
                for (u32 hi = 0; hi < H->ninsts; hi++)
                {
                    IrInst* m = H->insts[hi];
                    if (m->opcode != IrOpcode::Load && m->opcode != IrOpcode::Store) continue;
                    if (partOf[hi] == (i32)pi) continue;
                    IrValue* mAddr = m->opcode == IrOpcode::Load
                        ? m->ops[0]
                        : (m->nops > 1 ? m->ops[1] : null);
                    if (!aa->isNoAlias(sAddr, mAddr))
                    {
                        return false;
                    }
                }
            }
        }

        // ---- build N sequential loops ----
        IrBlock*[MAX_PARTITIONS] Hs;
        IrBlock*[MAX_PARTITIONS] Ls;
        IrInst*[MAX_PARTITIONS] phiPs;
        IrInst*[MAX_PARTITIONS] cmpPs;
        IrInst*[MAX_PARTITIONS] termPs;

        // all blocks up front: loop p's exit edge targets Hs[p+1]
        for (u32 p = 0; p < nParts; p++)
        {
            Hs[p] = self.createNamedBlock(func);
            Ls[p] = self.createNamedBlock(func);
        }

        for (u32 p = 0; p < nParts; p++)
        {
            IrBlock* Hp = Hs[p];
            IrBlock* Lp = Ls[p];

            // phi_p: [init, pred_p], [incr_p, L_p]  (incr slot fixed below)
            IrValue** pops = alloc<IrValue*>((usize)4);
            IrBlock* predP = (p == 0) ? pre : Hs[p - 1];
            pops[0] = initV;
            pops[1] = &predP->base;
            pops[2] = backV;              // placeholder, replaced after latch clone
            pops[3] = &Lp->base;
            IrInst* phiP = self.ctx->createInst(IrOpcode::Phi, ivPhi->base.type, pops, 4, 0, 0);
            dealloc<IrValue*>(pops);
            if (initV != null) initV->addUser(phiP);
            predP->base.addUser(phiP);
            backV->addUser(phiP);
            Lp->base.addUser(phiP);
            Hp->addInst(phiP);
            phiPs[p] = phiP;

            // latch clones: all non-terminator insts, operands remapped
            // iv phi -> phiP, other latch insts -> their clones
            IrInst** lmap = alloc<IrInst*>((usize)L->ninsts);
            for (u32 ii = 0; ii < L->ninsts; ii++) lmap[ii] = null;
            for (u32 ii = 0; ii < L->ninsts; ii++)
            {
                IrInst* inst = L->insts[ii];
                if (inst == lTerm) continue;
                IrInst* cl = self.ctx->createInst(inst->opcode, inst->base.type, null, inst->nops, 0, 0);
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    cl->ops[oi] = inst->ops[oi];
                    if (inst->ops[oi] != null) inst->ops[oi]->addUser(cl);
                }
                cl->parent = Lp;
                Lp->addInst(cl);
                lmap[ii] = cl;
            }
            // fix latch clone operands
            for (u32 ii = 0; ii < L->ninsts; ii++)
            {
                IrInst* cl = lmap[ii];
                if (cl == null) continue;
                IrInst* orig = L->insts[ii];
                for (u32 oi = 0; oi < cl->nops; oi++)
                {
                    IrValue* op = cl->ops[oi];
                    if (op == null) continue;
                    if (op == &ivPhi->base)
                    {
                        op->removeUser(cl);
                        cl->ops[oi] = &phiP->base; phiP->base.addUser(cl);
                    }
                    else if (op->kind == IrValueKind::Inst)
                    {
                        IrInst* opI = (IrInst*)op;
                        if (opI->parent == L)
                        {
                            for (u32 lj = 0; lj < L->ninsts; lj++)
                                if (L->insts[lj] == opI && lmap[lj] != null)
                                {
                                    op->removeUser(cl);
                                    cl->ops[oi] = &lmap[lj]->base; lmap[lj]->base.addUser(cl);
                                    break;
                                }
                        }
                    }
                }
            }
            // phi_p backedge = clone of incr
            IrValue* newBack = backV;
            if (backV->kind == IrValueKind::Inst)
            {
                IrInst* bi2 = (IrInst*)backV;
                for (u32 lj = 0; lj < L->ninsts; lj++)
                    if (L->insts[lj] == bi2 && lmap[lj] != null)
                    { newBack = &lmap[lj]->base; break; }
            }
            backV->removeUser(phiP);
            phiP->ops[2] = newBack;
            newBack->addUser(phiP);

            // latch terminator: br Hp
            IrInst* lbr = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), null, 1, 0, 0);
            lbr->ops[0] = &Hp->base;
            Hp->base.addUser(lbr);
            lbr->parent = Lp;
            Lp->addInst(lbr);
            Lp->addSucc(Hp);
            dealloc<IrInst*>(lmap);

            // header body: compare clone + partition closure clones
            // closure: partition insts + non-partitioned deps + cmp
            bool* inCl = alloc<bool>((usize)H->ninsts);
            for (u32 ii = 0; ii < H->ninsts; ii++) inCl[ii] = false;
            for (u32 ii = 0; ii < parts[p].ninsts; ii++)
            {
                IrInst* inst = parts[p].insts[ii];
                for (u32 hi = 0; hi < H->ninsts; hi++)
                    if (H->insts[hi] == inst) { inCl[hi] = true; break; }
            }
            // seed the compare too (needed by the exit test)
            for (u32 hi = 0; hi < H->ninsts; hi++)
                if (H->insts[hi] == cmp) inCl[hi] = true;
            // close under non-partitioned header operands
            bool grew = true;
            while (grew)
            {
                grew = false;
                for (u32 ii = 0; ii < H->ninsts; ii++)
                {
                    if (!inCl[ii]) continue;
                    IrInst* inst = H->insts[ii];
                    for (u32 oi = 0; oi < inst->nops; oi++)
                    {
                        IrValue* op = inst->ops[oi];
                        if (op == null || op->kind != IrValueKind::Inst) continue;
                        IrInst* opI = (IrInst*)op;
                        if (opI->parent != H || opI->opcode == IrOpcode::Phi) continue;
                        bool partd = false;
                        for (u32 hj = 0; hj < H->ninsts; hj++)
                            if (H->insts[hj] == opI && partOf[hj] >= 0) { partd = true; break; }
                        if (partd) continue;   // same-partition refs remap below
                        for (u32 hj = 0; hj < H->ninsts; hj++)
                            if (H->insts[hj] == opI && !inCl[hj])
                            { inCl[hj] = true; grew = true; }
                    }
                }
            }
            // clone in header order, remap operands
            IrInst** hmap = alloc<IrInst*>((usize)H->ninsts);
            for (u32 ii = 0; ii < H->ninsts; ii++) hmap[ii] = null;
            for (u32 hi = 0; hi < H->ninsts; hi++)
            {
                if (!inCl[hi]) continue;
                IrInst* inst = H->insts[hi];
                if (inst == hTerm || inst->opcode == IrOpcode::Phi) continue;
                IrInst* cl = self.ctx->createInst(inst->opcode, inst->base.type, null, inst->nops, (u64)inst->icmpPred, (u64)inst->fcmpPred);
                for (u32 oi = 0; oi < inst->nops; oi++) cl->ops[oi] = inst->ops[oi];
                cl->parent = Hp;
                Hp->addInst(cl);
                hmap[hi] = cl;
            }
            cmpPs[p] = null;
            for (u32 hi = 0; hi < H->ninsts; hi++)
                if (H->insts[hi] == cmp) cmpPs[p] = hmap[hi];
            // remap clone operands: iv->phiP, header insts->hmap clones
            for (u32 hi = 0; hi < H->ninsts; hi++)
            {
                IrInst* cl = hmap[hi];
                if (cl == null) continue;
                IrInst* orig = H->insts[hi];
                for (u32 oi = 0; oi < cl->nops; oi++)
                {
                    IrValue* op = cl->ops[oi];
                    if (op == null) continue;
                    if (op == &ivPhi->base)
                    {
                        op->removeUser(cl);
                        cl->ops[oi] = &phiP->base; phiP->base.addUser(cl);
                        continue;
                    }
                    if (op->kind != IrValueKind::Inst) continue;
                    IrInst* opI = (IrInst*)op;
                    if (opI->parent != H) continue;
                    for (u32 hj = 0; hj < H->ninsts; hj++)
                    {
                        if (H->insts[hj] == opI && hmap[hj] != null)
                        {
                            op->removeUser(cl);
                            cl->ops[oi] = &hmap[hj]->base; hmap[hj]->base.addUser(cl);
                            break;
                        }
                    }
                }
            }
            dealloc<bool>(inCl);
            dealloc<IrInst*>(hmap);

            // header terminator clone: cond -> cmpP, arms {Lp, next}
            IrBlock* next = (p + 1 < nParts) ? Hs[p + 1] : EXIT;
            IrInst* tp = self.ctx->createInst(IrOpcode::CondBr, self.ctx->tyVoid(), null, 3, 0, 0);
            // cond operand = clone of original cond value (cmpP)
            tp->ops[0] = cmpPs[p] != null ? &cmpPs[p]->base : condV;
            if (tp->ops[0] != null) tp->ops[0]->addUser(tp);
            // preserve arm order: whichever arm was L -> Lp, other -> next
            if (armT == L) { tp->ops[1] = &Lp->base; tp->ops[2] = &next->base; }
            else           { tp->ops[1] = &next->base; tp->ops[2] = &Lp->base; }
            Lp->base.addUser(tp); next->base.addUser(tp);
            tp->parent = Hp;
            Hp->addInst(tp);
            Hp->addSucc(Lp); Hp->addSucc(next);
            termPs[p] = tp;
        }

        // rewire preheader's edge H -> Hs[0]
        for (u32 ii = 0; ii < pre->ninsts; ii++)
        {
            IrInst* t = pre->insts[ii];
            if (t->opcode != IrOpcode::Br && t->opcode != IrOpcode::CondBr) continue;
            for (u32 oi = 0; oi < t->nops; oi++)
            {
                if (t->ops[oi] == &H->base)
                {
                    t->ops[oi] = &Hs[0]->base;
                    H->base.removeUser(t);
                    Hs[0]->base.addUser(t);
                    // fix succs entry positionally
                    for (u32 sj = 0; sj < pre->nsuccs; sj++)
                        if (pre->succs[sj] == H) pre->succs[sj] = Hs[0];
                    Hs[0]->addPred(pre);
                    H->removePred(pre);
                }
            }
        }

        // erase the original loop blocks
        for (u32 bi = 0; bi < lp->nblocks; bi++)
        {
            IrBlock* bb = lp->blocks[bi];
            // remove from all successor/pred lists of outsiders handled above;
            // removeBlock handles list excision
            func->removeBlock(bb);
        }

        return true;
    }

    // Partition loop body into independent chains
    void partitionLoopBody(IrBlock* header, LoopPartition* partitions, u32* nPartitions, u32 maxPartitions, AliasAnalysis* aa)
    {
        *nPartitions = 0;

        // Simple partitioning, each store gets its own partition,
        // loads are grouped with the stores they feed
        for (u32 ii = 0; ii < header->ninsts && *nPartitions < maxPartitions; ii++)
        {
            IrInst* inst = header->insts[ii];

            if (inst->opcode == IrOpcode::Store)
            {
                // Start a new partition for this store
                LoopPartition* p = &partitions[*nPartitions];
                p->insts = alloc<IrInst*>((usize)header->ninsts);
                p->ninsts = 0;
                p->hasStore = true;
                p->hasLoad = false;

                // Add this store
                p->insts[p->ninsts++] = inst;

                // Add any loads that this store depends on (that aren't in other partitions)
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    if (inst->ops[oi] != null && inst->ops[oi]->kind == IrValueKind::Inst)
                    {
                        IrInst* opInst = (IrInst*)inst->ops[oi];
                        if (opInst->opcode == IrOpcode::Load && opInst->parent == header)
                        {
                            // Check if this load is already in another partition
                            bool alreadyUsed = false;
                            for (u32 pi = 0; pi < *nPartitions; pi++)
                            {
                                for (u32 jj = 0; jj < partitions[pi].ninsts; jj++)
                                {
                                    if (partitions[pi].insts[jj] == opInst)
                                    {
                                        alreadyUsed = true;
                                        break;
                                    }
                                }
                                if (alreadyUsed) break;
                            }

                            if (!alreadyUsed)
                            {
                                p->insts[p->ninsts++] = opInst;
                                p->hasLoad = true;
                            }
                        }
                    }
                }

                (*nPartitions)++;
            }
        }
    }

    // Find the induction variable (phi) of a loop
    IrInst* findInductionVar(IrLoop* lp)
    {
        IrBlock* header = lp->header;
        if (header == null) return null;

        for (u32 i = 0; i < header->ninsts; i++)
        {
            IrInst* inst = header->insts[i];
            if (inst->opcode == IrOpcode::Phi)
                return inst;
        }
        return null;
    }
}

pub bool muvmPassLoopDistribute(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    LoopDistributePass pass = LoopDistributePass::new(ctx);
    return pass.run(func);
}
