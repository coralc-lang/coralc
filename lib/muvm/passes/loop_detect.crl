#[[no_drop_all]]
// Loop detection for muvm — natural loop detection over the dominator
// tree. A natural loop is identified by a backedge C -> H where H
// dominates C: take H as the header and compute the set of blocks that
// reach C without passing through H. Nested loops come out naturally.
//
// Natural loops detected here are suitable for the loop family (LICM,
// unroll, interchange, distribute, vectorization). A loop with multiple
// latches is reported as multiple independent loops; single-latch
// consumers can enforce that constraint themselves.

import muvm::irtypes { IrFunc, IrBlock };
import muvm::domtree { IrDomTree, irDomtreeNew, irDomtreeDominates, irDomtreeFree };
import std::mman { alloc, dealloc };

pub bool gVerboseLoop = false;

pub struct IrLoop
{
    IrBlock* header;
    IrBlock** blocks;
    u32 nblocks;
    IrBlock* preheader;
    IrBlock* latch;
}

pub IrLoop** irLoopDetectNatural(IrFunc* func)
{
    if (gVerboseLoop) eprintln("loop_detect: building domtree");
    IrDomTree* dt = irDomtreeNew(func);
    if (dt == null) { if (gVerboseLoop) eprintln("loop_detect: domtree failed"); return null; }
    if (gVerboseLoop) eprintln("loop_detect: domtree built");

    u32 n = func->nblocks;
    IrLoop** loops = alloc<IrLoop*>((usize)n + 1);
    u32 nloops = 0;

    // Backedge detection: every block whose successor is dominated by
    // it (and differs) is a backedge; its target is a loop header.
    for (u32 latchIdx = 1; latchIdx < n; latchIdx++)
    {
        IrBlock* latch = func->blocks[latchIdx];
        for (u32 sj = 0; sj < latch->nsuccs; sj++)
        {
            if (gVerboseLoop) eprintln("loop_detect: latch={} succ={}", latch->base.name, latch->succs[sj]->base.name);
            IrBlock* header = latch->succs[sj];
            if (header == latch) continue;
            if (gVerboseLoop) eprintln("loop_detect: dominates? {} -> {}", header->base.name, latch->base.name);
            bool domRes = irDomtreeDominates(dt, header, latch);
            if (gVerboseLoop) eprintln("loop_detect: dominance result={}", domRes);
            if (!domRes) continue;

            // dedup — the same (header, latch) will not repeat
            bool dup = false;
            for (u32 li = 0; li < nloops; li++)
            {
                if (loops[li]->header == header && loops[li]->latch == latch)
                { dup = true; break; }
            }
            if (dup) continue;

            u32 bIdx = n;
            u32 hIdx = n;
            for (u32 k = 0; k < n; k++)
            {
                if (func->blocks[k] == header) hIdx = k;
                if (func->blocks[k] == latch) bIdx = k;
            }

            bool* inLoop = alloc<bool>((usize)n);
            for (u32 k = 0; k < n; k++) inLoop[k] = false;
            inLoop[hIdx] = true;
            u32 count = 1;
            if (bIdx != hIdx)
            {
                inLoop[bIdx] = true;
                count = 2;
            }

            u32* stack = alloc<u32>((usize)n);
            u32 sp = 0;
            if (bIdx != hIdx) { stack[sp++] = bIdx; }

            // walk predecessors of any block in the loop until they all
            // enter header — that is the natural loop
            while (sp > 0)
            {
                u32 cur = stack[--sp];
                IrBlock* bb = func->blocks[cur];
                for (u32 pj = 0; pj < bb->npreds; pj++)
                {
                    IrBlock* pred = bb->preds[pj];
                    u32 pi = n;
                    for (u32 k = 0; k < n; k++)
                        if (func->blocks[k] == pred) { pi = k; break; }
                    if (pi >= n || pi == hIdx || inLoop[pi]) continue;
                    inLoop[pi] = true;
                    count++;
                    stack[sp++] = pi;
                }
            }

            IrBlock** blocks = alloc<IrBlock*>((usize)count);
            #[[maybe_unused]] u32 bi = 0;
            for (u32 k = 0; k < n; k++)
                if (inLoop[k])
                    blocks[bi++] = func->blocks[k];

            IrLoop* lp = alloc<IrLoop>((usize)1);
            lp->header = header;
            lp->blocks = blocks;
            lp->nblocks = count;
            lp->preheader = null;
            lp->latch = latch;
            loops[nloops++] = lp;

            dealloc<bool>(inLoop);
            dealloc<u32>(stack);
        }
    }

    loops[nloops] = null;
    irDomtreeFree(dt);
    return loops;
}

pub void irLoopDestroy(IrLoop** loops)
{
    if (loops == null) return;
    for (u32 i = 0; loops[i] != null; i++)
    {
        if (loops[i]->blocks != null) dealloc<IrBlock*>(loops[i]->blocks);
        dealloc<IrLoop>(loops[i]);
    }
    dealloc<IrLoop*>(loops);
}
