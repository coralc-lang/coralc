#[[no_drop_all]]
// Infer per-function memory-effect attributes (readnone / readonly /
// writeonly) so call sites stop treating every call as a full memory
// barrier. gvn's load cache, memory_ssa's clobber query, dse's store
// tracking and loop_cse's writer check all consult callMayWriteMemory /
// callMayReadMemory, which read these attributes.
//
// Algorithm — pessimistic top-down fixpoint over the module call graph:
//   effRead[f]  = localReads[f]  OR any callee's effRead
//   effWrite[f] = localWrites[f] OR any callee's effWrite
// Both start TRUE (unknown = may do everything) and only shrink, so the
// iteration converges to the greatest fixpoint. Recursive cycles keep
// whatever their bodies can't disprove — conservative and safe.
//
// Functions that already carry a memory attribute are authoritative:
// their declared effects are used for callers but the function itself
// is never re-inferred or overwritten (an attr is a contract).
//
// Runs once per module — guarded on func == module->funcs[0] since the
// pass driver invokes every pipeline entry once per function.

import muvm::irtypes { IrContext, IrFunc, IrModule, IrBlock, IrInst, IrValue, IrValueKind };
import muvm::irOps { IrOpcode };
import muvm::irMetadata {
    hasFuncAttr, funcIsReadOnly, funcIsReadNone, funcIsWriteOnly,
    setFuncReadOnly, setFuncReadNone, setFuncWriteOnly };
import muvm::passes::common { gVerbose };
import std::mman { alloc, dealloc };
import std::ios { eprintln };

// Classify a Call's memory effects. Returns a bitmask:
//   bit0 = may read, bit1 = may write, bit2 = fixpoint edge to *calleeOut
// (an unannotated, non-extern, in-module callee whose effects the
// fixpoint must propagate). Declared attrs fold to local bits; foreign
// or indirect callees stay fully conservative.
u32 classifyCall(IrInst* inst, IrModule* m, IrFunc** calleeOut)
{
    *calleeOut = null;
    IrValue* cv = inst->nops > 0 ? inst->ops[0] : null;
    if (cv == null || cv->kind != IrValueKind::Func)
        return 3; // indirect — unknown callee does everything
    IrFunc* callee = (IrFunc*)cv;
    bool rn = funcIsReadNone(callee);
    bool ro = funcIsReadOnly(callee);
    bool wo = funcIsWriteOnly(callee);
    if (rn || ro || wo)
    {
        // declared attr is the contract — fold its effects locally
        u32 mask = 0;
        if (!wo) mask |= 1;
        if (!rn && !ro) mask |= 2;
        return mask;
    }
    if (callee->parent == m && !callee->isExtern)
    {
        *calleeOut = callee;
        return 4;
    }
    return 3; // foreign/extern without attr — unknown
}

pub bool muvmPassInferMemAttrs(IrFunc* func, rawptr userdata)
{
    IrModule* m = func->parent;
    if (m == null || m->nfuncs == 0) return false;
    // once per module: only the first function triggers the whole scan
    if (func != m->funcs[0]) return false;

    u32 n = m->nfuncs;
    bool* localRead = alloc<bool>((usize)n);
    bool* localWrite = alloc<bool>((usize)n);
    bool* fixed = alloc<bool>((usize)n);   // declared attr → effects frozen
    bool* effRead = alloc<bool>((usize)n);
    bool* effWrite = alloc<bool>((usize)n);
    // callee edges as a flat (start,count) range per func — sized exactly
    // so no call is ever dropped (a capped table made inference
    // order-dependent: run 2 sees run 1's printed attrs and diverges)
    u32* edgeStart = alloc<u32>((usize)n + 1);
    u32* nCallees = alloc<u32>((usize)n);
    for (u32 i = 0; i < n; i++)
    {
        localRead[i] = false;
        localWrite[i] = false;
        nCallees[i] = 0;
        edgeStart[i] = 0;
        IrFunc* f = m->funcs[i];
        bool hasMemAttr = f != null &&
            (funcIsReadNone(f) || funcIsReadOnly(f) || funcIsWriteOnly(f));
        fixed[i] = hasMemAttr;
        // pessimistic top: unknown does everything until proven less
        effRead[i] = true;
        effWrite[i] = true;
        if (hasMemAttr)
        {
            // declared effects are the contract — freeze them
            effRead[i] = !funcIsWriteOnly(f);
            effWrite[i] = !funcIsReadNone(f) && !funcIsReadOnly(f);
        }
    }
    edgeStart[n] = 0;

    // Scan A — local effects + edge counts. classifyCall is pure, so a
    // second scan below can refill the same edges into exact storage.
    for (u32 fi = 0; fi < n; fi++)
    {
        IrFunc* f = m->funcs[fi];
        if (f == null || f->isExtern) continue;
        for (u32 bi = 0; bi < f->nblocks; bi++)
        {
            IrBlock* bb = f->blocks[bi];
            if (bb == null) continue;
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst == null) continue;
                switch (inst->opcode)
                {
                    IrOpcode::Load | IrOpcode::AtomicLoad =>
                    { localRead[fi] = true; },
                    IrOpcode::Store | IrOpcode::AtomicStore =>
                    { localWrite[fi] = true; },
                    IrOpcode::AtomicRmw | IrOpcode::AtomicCmpXchg =>
                    { localRead[fi] = true; localWrite[fi] = true; },
                    IrOpcode::Call =>
                    {
                        IrFunc* callee = null;
                        u32 cm = classifyCall(inst, m, &callee);
                        if ((cm & 1) != 0) localRead[fi] = true;
                        if ((cm & 2) != 0) localWrite[fi] = true;
                        if ((cm & 4) != 0) nCallees[fi]++;
                    },
                    IrOpcode::Fence | IrOpcode::InlineAsm |
                    IrOpcode::GcWriteBarrier | IrOpcode::GcSafepoint |
                    IrOpcode::LandingPad =>
                    { localRead[fi] = true; localWrite[fi] = true; },
                    else => {}
                }
            }
        }
    }

    // Prefix-sum edge ranges, then scan B fills callee indices.
    u32 totalEdges = 0;
    for (u32 fi = 0; fi < n; fi++)
    {
        edgeStart[fi] = totalEdges;
        totalEdges += nCallees[fi];
    }
    edgeStart[n] = totalEdges;
    u32* callees = alloc<u32>((usize)(totalEdges == 0 ? 1 : totalEdges));
    u32* fill = alloc<u32>((usize)n);
    for (u32 fi = 0; fi < n; fi++) fill[fi] = 0;
    for (u32 fi = 0; fi < n; fi++)
    {
        IrFunc* f = m->funcs[fi];
        if (f == null || f->isExtern || nCallees[fi] == 0) continue;
        for (u32 bi = 0; bi < f->nblocks; bi++)
        {
            IrBlock* bb = f->blocks[bi];
            if (bb == null) continue;
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst == null || inst->opcode != IrOpcode::Call) continue;
                IrFunc* callee = null;
                u32 cm = classifyCall(inst, m, &callee);
                if ((cm & 4) == 0 || callee == null) continue;
                // resolve callee to its module index
                for (u32 ci = 0; ci < n; ci++)
                {
                    if (m->funcs[ci] == callee)
                    {
                        callees[edgeStart[fi] + fill[fi]] = ci;
                        fill[fi]++;
                        break;
                    }
                }
            }
        }
    }
    dealloc<u32>(fill);

    // Pass 2 — fixpoint. Effects only shrink from the pessimistic top.
    bool changed = true;
    u32 rounds = 0;
    while (changed && rounds <= n + 1)
    {
        changed = false;
        rounds++;
        for (u32 fi = 0; fi < n; fi++)
        {
            if (fixed[fi]) continue;
            bool r = localRead[fi];
            bool w = localWrite[fi];
            for (u32 ei = edgeStart[fi]; ei < edgeStart[fi + 1]; ei++)
            {
                u32 ci = callees[ei];
                if (effRead[ci]) r = true;
                if (effWrite[ci]) w = true;
            }
            if (r != effRead[fi] || w != effWrite[fi])
            {
                effRead[fi] = r;
                effWrite[fi] = w;
                changed = true;
            }
        }
    }

    // Pass 3 — attach the strongest proven attribute to functions that
    // declared none. Externs have no body to prove anything about.
    for (u32 fi = 0; fi < n; fi++)
    {
        IrFunc* f = m->funcs[fi];
        if (f == null || f->isExtern || fixed[fi]) continue;
        if (!effRead[fi] && !effWrite[fi]) setFuncReadNone(f);
        else if (!effWrite[fi]) setFuncReadOnly(f);
        else if (!effRead[fi]) setFuncWriteOnly(f);
    }

    if (gVerbose)
        eprintln("infer_memattrs: {} funcs, {} rounds", (u64)n, (u64)rounds);

    dealloc<bool>(localRead);
    dealloc<bool>(localWrite);
    dealloc<bool>(fixed);
    dealloc<bool>(effRead);
    dealloc<bool>(effWrite);
    dealloc<u32>(callees);
    dealloc<u32>(nCallees);
    dealloc<u32>(edgeStart);
    return false;
}
