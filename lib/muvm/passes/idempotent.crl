#[[no_drop_all]]
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import muvm::irOps { IrOpcode };

// Idempotent op removal / redundant write suppression.
// Detects consecutive identical stores to the same memory location with no
// intervening read or side effect, and strips the redundant write. Also
// handles redundant loads (load from same address when value hasn't
// changed), redundant GEP chains, redundant bitcasts.
//
// Port note: the wallvm original listed Store in the backward scan's
// side-effect break set *before* checking it, which made the store
// patterns unreachable. Here Store is handled explicitly first: a store
// to a different (possibly aliasing) address still stops the scan.
pub struct IdempotentPass
{
    IrContext* ctx;
    u64 removals;

    static IdempotentPass new(IrContext* ctx)
    {
        return IdempotentPass {
            .ctx = ctx,
            .removals = 0
        };
    }

    bool isBarrier(IrOpcode op)
    {
        return op == IrOpcode::Call ||
               op == IrOpcode::AtomicStore ||
               op == IrOpcode::AtomicLoad ||
               op == IrOpcode::AtomicRmw ||
               op == IrOpcode::Fence ||
               op == IrOpcode::InlineAsm;
    }

    bool run(IrFunc* func)
    {
        self.removals = 0;
        bool anyChanged = false;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                if (self.processInst(bb, ii)) {
                    anyChanged = true;
                    // Instruction removed or rewritten; restart this block
                    // from 0 (indices shifted) but don't restart from
                    // block 0
                    ii = 0;
                }
                else {
                    ii++;
                }
            }
        }
        return anyChanged;
    }

    bool processInst(IrBlock* bb, u32 idx)
    {
        IrInst* inst = bb->insts[idx];

        // Pattern 1 — consecutive identical stores to same address:
        // store [addr], val; ... store [addr], val  → drop the earlier one
        if (inst->opcode == IrOpcode::Store && inst->nops >= 2)
        {
            IrValue* addr = inst->ops[1];
            IrValue* val = inst->ops[0];

            for (u32 pi = idx; pi > 0; pi--)
            {
                IrInst* prev = bb->insts[pi - 1];
                if (prev == inst) continue;

                if (prev->opcode == IrOpcode::Store && prev->nops >= 2)
                {
                    if (prev->ops[1] == addr)
                    {
                        if (prev->ops[0] == val)
                        {
                            // Same address, same value, no side effects
                            // between — the earlier store is dead.
                            prev->erase();
                            self.removals++;
                            return true;
                        }
                        break;  // same slot, different value — keep both
                    }
                    break;      // possibly-aliasing store — stop scanning
                }

                if (self.isBarrier(prev->opcode)) break;

                if (prev->opcode == IrOpcode::Load && prev->nops >= 1)
                {
                    // A load reading our slot between the stores keeps
                    // the earlier write observable.
                    if (prev->ops[0] == addr) break;
                }
            }
        }

        // Pattern 2 — redundant load: store [addr], val; load [addr] → val
        if (inst->opcode == IrOpcode::Load && inst->nops >= 1)
        {
            IrValue* addr = inst->ops[0];

            for (u32 pi = idx; pi > 0; pi--)
            {
                IrInst* prev = bb->insts[pi - 1];
                if (prev == inst) continue;

                if (prev->opcode == IrOpcode::Store && prev->nops >= 2)
                {
                    if (prev->ops[1] == addr)
                    {
                        // Load from address that was just stored to —
                        // bypass the load with the stored value.
                        inst->base.replaceAllUses(prev->ops[0]);
                        inst->erase();
                        self.removals++;
                        return true;
                    }
                    break;  // possibly-aliasing store — stop scanning
                }

                if (self.isBarrier(prev->opcode)) break;
            }
        }

        // Pattern 3 — redundant bitcast of bitcast
        if (inst->opcode == IrOpcode::Bitcast && inst->nops == 1 &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Bitcast && inner->nops == 1)
            {
                inst->base.replaceAllUses(inner->ops[0]);
                inst->erase();
                self.removals++;
                return true;
            }
        }

        // Pattern 4 — redundant GEP with zero index: gep base, 0 → base
        if (inst->opcode == IrOpcode::Gep && inst->nops >= 2)
        {
            bool allZero = true;
            for (u32 oi = 1; oi < inst->nops; oi++)
            {
                if (inst->ops[oi] == null || inst->ops[oi]->kind != IrValueKind::ConstInt ||
                    inst->ops[oi]->valData != 0)
                {
                    allZero = false;
                    break;
                }
            }
            if (allZero)
            {
                inst->base.replaceAllUses(inst->ops[0]);
                inst->erase();
                self.removals++;
                return true;
            }
        }

        // Pattern 5 — dead alloca (never used)
        if (inst->opcode == IrOpcode::Alloca && inst->base.nusers == 0)
        {
            inst->erase();
            self.removals++;
            return true;
        }

        return false;
    }
}

pub bool muvmPassIdempotent(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    IdempotentPass pass = IdempotentPass::new(ctx);
    return pass.run(func);
}
