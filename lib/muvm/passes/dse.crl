#[[no_drop_all]]
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue };
import muvm::irOps { IrOpcode };
import std::mman { alloc, dealloc };

// Dead store elimination.
//
// Within a single basic block, a store to an address that is overwritten by a
// later store to a must-aliasing address — before any load, call, fence or
// atomic touches it — never contributes to the program state and is removed.
//
// Ported from wallvm's dse with alias analysis disabled: must-alias is
// currently decided by pointer equality only. A must-alias oracle can be
// layered back in once muvm grows an alias_analysis pass.
//
// Conservative by design — any instruction that can read or write memory
// (call, atomic, fence, inline asm, landing pad) flushes the tracked stores.
pub struct DsePass
{
    IrContext* ctx;
    u64 removed;

    DsePass new(IrContext* ctx)
    {
        return DsePass {
            .ctx = ctx,
            .removed = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.removed = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (self.sweepBlock(bb)) changed = true;
        }
        return changed;
    }

    // Store base.type is void (width 0) — the value operand carries the
    // real access width. 0 means unknown (aggregates), never "equal".
    u32 storeValueWidth(IrInst* store)
    {
        if (store->nops < 1 || store->ops[0] == null || store->ops[0]->type == null) return 0;
        return store->ops[0]->type->width;
    }

    bool isBarrier(IrOpcode op)
    {
        switch (op)
        {
            IrOpcode::Load |
            IrOpcode::AtomicLoad |
            IrOpcode::AtomicStore |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg |
            IrOpcode::Fence |
            IrOpcode::Call |
            IrOpcode::InlineAsm |
            IrOpcode::GcRoot |
            IrOpcode::GcWriteBarrier |
            IrOpcode::GcSafepoint |
            IrOpcode::LandingPad => { return true; },

            else => { return false; },
        }
    }

    bool sweepBlock(IrBlock* bb)
    {
        const u32 MAX_TRACKED = 128;
        IrValue** addrs = alloc<IrValue*>((usize)MAX_TRACKED);
        IrInst** stores = alloc<IrInst*>((usize)MAX_TRACKED);
        u32 tracked = 0;
        bool changed = false;

        u32 ii = 0;
        while (ii < bb->ninsts)
        {
            IrInst* inst = bb->insts[ii];

            if (inst->opcode == IrOpcode::Store && inst->nops >= 2)
            {
                IrValue* addr = inst->ops[1];
                // Must-alias: identical address SSA value. Anything
                // weaker (GEP offsets, bitcasts) is left alone until an
                // alias analysis pass exists.
                i32 hit = -1;
                for (u32 k = 0; k < tracked; k++)
                {
                    if (addrs[k] == addr) {
                        hit = (i32)k;
                        break;
                    }
                }

                if (hit >= 0)
                {
                    // Only a same-address store of at least the earlier
                    // store's width covers it fully — a later `store i32`
                    // does not kill a `store i64` (base.type is void on
                    // stores, so compare value widths; unknown width never
                    // kills).
                    u32 wNew = self.storeValueWidth(inst);
                    u32 wOld = self.storeValueWidth(stores[hit]);
                    if (wOld > 0 && wNew >= wOld)
                    {
                        stores[hit]->erase();
                        stores[hit] = inst;
                        self.removed++;
                        changed = true;
                        continue;
                    }
                    // narrower or unknown: keep the earlier store and track
                    // this one alongside it
                }

                if (tracked < MAX_TRACKED)
                {
                    addrs[tracked] = addr;
                    stores[tracked] = inst;
                    tracked++;
                }
            }
            else if (self.isBarrier(inst->opcode)) {
                tracked = 0;
            }

            ii++;
        }

        dealloc<IrValue*>(addrs);
        dealloc<IrInst*>(stores);
        return changed;
    }

    u64 removedCount() { return self.removed; }
}

pub bool muvmPassDse(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    DsePass pass = DsePass::new(ctx);
    return pass.run(func);
}
