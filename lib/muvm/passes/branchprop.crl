#[[no_drop_all]]
// Branchprop — forward propagation of cond_br outcomes.
//
// In SSA, a cond_br condition is a bool value defined in the pred block;
// the true arm knows that value is 1, the false arm knows it is 0. For
// each use of the condition inside the dominated subtree of either arm,
// substitute the corresponding ConstInt. The condition is never rewritten
// inside the dominating block itself (the cond_br's own block).
//
// Scope deliberately: the SSA-carried-prop case only. No copy-prop inside
// the condition's own defining block, no range analysis, no predicate
// inversion — every rewrite here is a local subst with an i1 ConstInt.

import muvm::passes::common { gVerbose };
import muvm::irOps { IrOpcode };
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import muvm::domtree { IrDomTree, irDomtreeNew, irDomtreeFree, irDomtreeDominates, irDomtreeBlockIndex };
import std::mman { alloc, dealloc };
import std::ios { eprintln };

pub struct BranchPropPass
{
    IrContext* ctx;
    u64 replaced;

    static BranchPropPass new(IrContext* ctx)
    {
        return BranchPropPass { .ctx = ctx, .replaced = 0 };
    }

    bool run(IrFunc* func)
    {
        if (func == null) return false;
        if (gVerbose) eprintln("branchprop: begin func={}", func->base.name);

        IrDomTree* dt = irDomtreeNew(func);
        if (dt == null) return false;

        bool changed = false;
        u32 bi = 0;
        for (; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (bb == null || bb->ninsts == 0) continue;
            IrInst* term = bb->insts[bb->ninsts - 1];
            if (term == null) continue;
            if (term->opcode != IrOpcode::CondBr) continue;

            IrValue* cond = term->ops[0];
            if (cond == null || cond->kind != IrValueKind::Inst) continue;
            IrInst* cmpInst = (IrInst*)cond;
            if (cmpInst->opcode != IrOpcode::ICmp) continue;

            IrBlock* tBlock = (IrBlock*)term->ops[1];
            IrBlock* fBlock = (IrBlock*)term->ops[2];
            if (tBlock == null || fBlock == null) continue;

            IrValue* one  = self.ctx->constInt(cmpInst->base.type, 1);
            IrValue* zero = self.ctx->constInt(cmpInst->base.type, 0);

            // look at every user of cmpInst (track carefully; RAU mutates nusers)
            u32 nu = cmpInst->base.nusers;
            u32* userIndices = alloc<u32>((usize)nu);
            for (u32 k = 0; k < nu; k++) userIndices[k] = k;

            for (u32 k = 0; k < nu; k++)
            {
                u32 idx = userIndices[k];
                if (idx >= cmpInst->base.nusers) continue;
                IrInst* user = cmpInst->base.users[idx];
                if (user == null || user->parent == null) continue;

                bool inTrue  = irDomtreeDominates(dt, tBlock, user->parent);
                bool inFalse = irDomtreeDominates(dt, fBlock, user->parent);
                if (!inTrue && !inFalse) continue;

                IrValue* want = inTrue ? one : zero;
                cmpInst->base.removeUser(user);
                for (u32 oj = 0; oj < user->nops; oj++)
                    if (user->ops[oj] == &cmpInst->base) user->ops[oj] = want;
                want->addUser(user);
                self.replaced++;
                changed = true;
            }
            dealloc<u32>(userIndices);
        }

        irDomtreeFree(dt);
        if (gVerbose) eprintln("branchprop: replaced={}", self.replaced);
        return changed;
    }
}

pub bool muvmPassBranchProp(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (func == null || ctx == null) return false;
    BranchPropPass pass = BranchPropPass::new(ctx);
    return pass.run(func);
}
