#[[no_drop_all]]
// Algebraic simplify for muvm — one node, instcombine-style local rewrites
// that `fold` does not subsume (fold handles constants and direct identities;
// NOT strength reduction, NOT cast chains, NOT reassociation).
//
//   1. commutative canonicalization — lone constant operand moves to the
//      right; constant-int and inst/inst operand pairs are value-sorted
//      (deterministic GVN hashing shape). Both inst operand pairs are
//      id-sorted — that's safe under byte-compare fixpoint only because
//      args and constants get stable ids after parse, and inst operand
//      ids are compared for pairwise swap only, not global renumbering.
//   2. cast chains — zext(zext) / sext(sext) collapse, sext(zext) -> zext,
//      trunc(ext same-width) drops the extension
//   3. idempotent collapse — x & x, x | x, min/max(x, x)
//   4. strength reduction — mul by power-of-two -> shl; udiv by power-of-two
//      -> lshr; sdiv/srem/urem by 1 folds
//   5. lex canon — commutative-op operands sorted by id; removed the
//      flatten/rebuild iteration because rebuilding costs a new inst id
//      and never reaches a stable tree.
//
// All rewrites keep the outermost result in place: inst users are re-pushed
// onto the worklist so they refold against the new shape.

import muvm::passes::common { gVerbose };
import muvm::irOps { IrOpcode, irOpcodeStr, irOpcodeIsCommutative };
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType };
import std::ios { eprintln };
import std::mman { alloc, dealloc };

pub struct AlgebraicPass
{
    IrContext* ctx;
    IrInst** work;
    u64 nWork;
    u64 capWork;
    IrInst** dead;
    u64 nDead;
    u64 capDead;
    u64 nRewrites;

    AlgebraicPass new(IrContext* ctx)
    {
        return AlgebraicPass {
            .ctx = ctx,
            .work = alloc<IrInst*>((usize)64),
            .nWork = 0,
            .capWork = 64,
            .dead = alloc<IrInst*>((usize)64),
            .nDead = 0,
            .capDead = 64,
            .nRewrites = 0
        };
    }

    void deinit()
    {
        if (self.work != null) dealloc<IrInst*>(self.work);
        if (self.dead != null) dealloc<IrInst*>(self.dead);
    }

    void push(IrInst* inst)
    {
        if (inst == null) return;
        if (self.nWork >= self.capWork)
        {
            IrInst** nw = alloc<IrInst*>((usize)(self.capWork * 2));
            for (u64 i = 0; i < self.nWork; i++) nw[i] = self.work[i];
            dealloc<IrInst*>(self.work);
            self.work = nw;
            self.capWork *= 2;
        }
        self.work[self.nWork++] = inst;
    }

    void markDead(IrInst* inst)
    {
        if (self.nDead >= self.capDead)
        {
            IrInst** nd = alloc<IrInst*>((usize)(self.capDead * 2));
            for (u64 i = 0; i < self.nDead; i++) nd[i] = self.dead[i];
            dealloc<IrInst*>(self.dead);
            self.dead = nd;
            self.capDead *= 2;
        }
        self.dead[self.nDead++] = inst;
    }

    bool isConstInt(IrValue* v)
    {
        return v != null && v->kind == IrValueKind::ConstInt;
    }

    u32 widthOf(IrValue* v)
    {
        IrType* t = v->type;
        if (t == null) return 64;
        return t->width > 0 ? t->width : 64;
    }

    IrValue* iconst(IrType* ty, u64 v)
    {
        return self.ctx->constInt(ty, v);
    }

    // --- commutative canon — lone const to the right ----------------------
    bool commSwap(IrInst* inst)
    {
        if (inst->nops < 2) return false;
        if (!irOpcodeIsCommutative(inst->opcode)) return false;
        IrValue* l = inst->ops[0];
        IrValue* r = inst->ops[1];
        if (l == null || r == null) return false;
        if ((self.isConstInt(l) && !self.isConstInt(r) && r->kind != IrValueKind::ConstFloat))
        {
            IrValue* t = inst->ops[0]; inst->ops[0] = inst->ops[1]; inst->ops[1] = t;
            return true;
        }
        bool bothInt = self.isConstInt(l) && self.isConstInt(r);
        bool bothFloat = l->kind == IrValueKind::ConstFloat && r->kind == IrValueKind::ConstFloat;
        if ((bothInt || bothFloat) && l->valData > r->valData)
        {
            IrValue* t = inst->ops[0]; inst->ops[0] = inst->ops[1]; inst->ops[1] = t;
            return true;
        }
        return false;
    }

    // --- extension collapse ---------------------------------------------
    IrValue* tryExt(IrInst* inst)
    {
        if (inst->nops != 1) return null;
        IrValue* x = inst->ops[0];
        if (x == null || x->kind != IrValueKind::Inst) return null;
        IrInst* src = (IrInst*)x;
        if (src->nops != 1) return null;
        IrValue* inner = src->ops[0];
        if (inner == null) return null;
        u32 outW = self.widthOf(&inst->base);
        u32 innerW = self.widthOf(inner);

        if (inst->opcode == src->opcode &&
            (inst->opcode == IrOpcode::Zext || inst->opcode == IrOpcode::Sext))
        {
            IrValue** ops = alloc<IrValue*>((usize)1);
            ops[0] = inner;
            IrInst* ni = self.ctx->createInst(inst->opcode, inst->base.type, ops, 1, 0, 0);
            dealloc<IrValue*>(ops);
            inner->addUser(ni);
            inst->parent->insertBefore(ni, inst);
            return &ni->base;
        }
        if (inst->opcode == IrOpcode::Sext && src->opcode == IrOpcode::Zext)
        {
            IrValue** ops = alloc<IrValue*>((usize)1);
            ops[0] = inner;
            IrInst* ni = self.ctx->createInst(IrOpcode::Zext, inst->base.type, ops, 1, 0, 0);
            dealloc<IrValue*>(ops);
            inner->addUser(ni);
            inst->parent->insertBefore(ni, inst);
            return &ni->base;
        }
        if (inst->opcode == IrOpcode::Trunc &&
            (src->opcode == IrOpcode::Zext || src->opcode == IrOpcode::Sext))
        {
            if (outW == innerW) return inner;
            IrOpcode op = (outW < innerW) ? IrOpcode::Trunc : src->opcode;
            IrValue** ops = alloc<IrValue*>((usize)1);
            ops[0] = inner;
            IrInst* ni = self.ctx->createInst(op, inst->base.type, ops, 1, 0, 0);
            dealloc<IrValue*>(ops);
            inner->addUser(ni);
            inst->parent->insertBefore(ni, inst);
            return &ni->base;
        }
        return null;
    }

    // --- idempotent collapse --------------------------------------------
    IrValue* tryIdem(IrInst* inst)
    {
        if (inst->nops != 2) return null;
        IrValue* a = inst->ops[0];
        IrValue* b = inst->ops[1];
        if (a == null || b == null || a != b) return null;
        switch (inst->opcode)
        {
            IrOpcode::And | IrOpcode::Or |
            IrOpcode::SMin | IrOpcode::SMax |
            IrOpcode::UMin | IrOpcode::UMax => { return a; },
            else => { return null; }
        }
    }

    // --- strength reduction ------------------------------------------------
    IrValue* tryStrength(IrInst* inst)
    {
        if (inst->nops != 2) return null;
        IrValue* a = inst->ops[0];
        IrValue* b = inst->ops[1];
        if (a == null || b == null) return null;

        if (inst->opcode == IrOpcode::Mul && self.isConstInt(b) && b->valData > 1 &&
            (b->valData & (b->valData - 1)) == 0)
        {
            u32 amt = 0;
            u64 v = b->valData;
            while (v > 1) { v >>= 1; amt++; }
            IrValue* amtV = self.ctx->constInt(b->type, (u64)amt);
            IrValue** ops = alloc<IrValue*>((usize)2);
            ops[0] = a; ops[1] = amtV;
            IrInst* shl = self.ctx->createInst(IrOpcode::Shl, inst->base.type, ops, 2, 0, 0);
            dealloc<IrValue*>(ops);
            a->addUser(shl); amtV->addUser(shl);
            inst->parent->insertBefore(shl, inst);
            return &shl->base;
        }
        if (inst->opcode == IrOpcode::UDiv && self.isConstInt(b) && b->valData > 1 &&
            (b->valData & (b->valData - 1)) == 0)
        {
            u32 amt = 0;
            u64 v = b->valData;
            while (v > 1) { v >>= 1; amt++; }
            IrValue* amtV = self.ctx->constInt(b->type, (u64)amt);
            IrValue** ops = alloc<IrValue*>((usize)2);
            ops[0] = a; ops[1] = amtV;
            IrInst* lshr = self.ctx->createInst(IrOpcode::Lshr, inst->base.type, ops, 2, 0, 0);
            dealloc<IrValue*>(ops);
            a->addUser(lshr); amtV->addUser(lshr);
            inst->parent->insertBefore(lshr, inst);
            return &lshr->base;
        }
        if ((inst->opcode == IrOpcode::SDiv || inst->opcode == IrOpcode::UDiv) &&
            self.isConstInt(b) && b->valData == 1) return a;
        if ((inst->opcode == IrOpcode::SRem || inst->opcode == IrOpcode::URem) &&
            self.isConstInt(b) && b->valData == 1)
            return self.ctx->constInt(inst->base.type, 0);
        // x + x -> x << 1
        if (inst->opcode == IrOpcode::Add && a == b)
        {
            IrValue* one = self.ctx->constInt(inst->base.type, (u64)1);
            IrValue** ops = alloc<IrValue*>((usize)2);
            ops[0] = a; ops[1] = one;
            IrInst* shl = self.ctx->createInst(IrOpcode::Shl, inst->base.type, ops, 2, 0, 0);
            dealloc<IrValue*>(ops);
            a->addUser(shl); one->addUser(shl);
            inst->parent->insertBefore(shl, inst);
            return &shl->base;
        }
        // x * -1 -> neg(x)
        if (inst->opcode == IrOpcode::Mul)
        {
            u32 w = inst->base.type != null ? inst->base.type->width : 64;
            u64 allOnes = (w >= 64u) ? (u64)~0 : (((u64)1 << (u64)w) - (u64)1);
            IrValue* x = null;
            if (self.isConstInt(b) && (b->valData & allOnes) == allOnes) x = a;
            else if (self.isConstInt(a) && (a->valData & allOnes) == allOnes) x = b;
            if (x != null)
            {
                IrValue** ops = alloc<IrValue*>((usize)1);
                ops[0] = x;
                IrInst* neg = self.ctx->createInst(IrOpcode::Neg, inst->base.type, ops, 1, 0, 0);
                dealloc<IrValue*>(ops);
                x->addUser(neg);
                inst->parent->insertBefore(neg, inst);
                return &neg->base;
            }
        }
        return null;
    }

    bool run(IrFunc* func)
    {
        u64 changedAny = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++) self.push(bb->insts[ii]);
        }
        while (self.nWork > 0)
        {
            IrInst* inst = self.work[--self.nWork];
            if (inst == null || inst->parent == null) continue;

            // operand canonicalization (in-place, no RAU)
            self.commSwap(inst);

            IrValue* replacement = self.tryExt(inst);
            if (replacement == null) replacement = self.tryIdem(inst);
            if (replacement == null) replacement = self.tryStrength(inst);
            if (replacement == null) continue;

            if (gVerbose) eprintln("algebraic: rewrite id={} op={}", inst->base.id, irOpcodeStr(inst->opcode));
            self.nRewrites++;
            changedAny++;
            u32 nu = inst->base.nusers;
            IrInst** users = alloc<IrInst*>((usize)(nu > 0 ? nu : 1));
            for (u32 i = 0; i < nu; i++) users[i] = inst->base.users[i];
            inst->base.replaceAllUses(replacement);
            for (u32 i = 0; i < nu; i++) self.push(users[i]);
            dealloc<IrInst*>(users);
            inst->detach();
            self.markDead(inst);
        }
        for (u64 i = 0; i < self.nDead; i++) self.dead[i]->erase();
        if (gVerbose) eprintln("algebraic: {} rewrite(s)", changedAny);
        return changedAny > 0;
    }
}

pub bool muvmPassAlgebraic(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (func == null || ctx == null) return false;
    AlgebraicPass pass = AlgebraicPass::new(ctx);
    bool r = pass.run(func);
    pass.deinit();
    return r;
}
