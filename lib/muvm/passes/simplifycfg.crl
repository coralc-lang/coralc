#[[no_drop_all]]
// SimplifyCFG for muvm — empty-block elision + single-pred bypass +
// sole-pred successor merge.
//
// For an empty block bb that is only a Br to target, with exactly one
// predecessor P, rewrite P's terminator to jump to target directly, then
// delete bb and patch every phi input in every block that bb used to
// pred to name P instead. Chains of empties collapse transitively under
// fixpoint iteration.
//
// Pass C merges bb into target when bb ends in an unconditional Br and
// target's only predecessor is bb — the post-inline `__inl.cont` chains
// flatten into one block this way.

import muvm::passes::common { gVerbose };
import muvm::irOps { IrOpcode, irOpcodeIsTerminator };
import muvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import std::mman { alloc, dealloc, copy };

pub struct SimplifyCfgPass
{
    IrContext* ctx;

    static SimplifyCfgPass new(IrContext* ctx)
    {
        return SimplifyCfgPass {
            .ctx = ctx
        };
    }

    // Rename phi inputs in `block` that name `oldPred` to name `newPred`.
    void renamePhiPred(IrBlock* block, IrBlock* oldPred, IrBlock* newPred)
    {
        if (block == null) return;
        for (u32 i = 0; i < block->ninsts; i++)
        {
            IrInst* phi = block->insts[i];
            if (phi == null || phi->opcode != IrOpcode::Phi) continue;
            for (u32 j = 1; j < phi->nops; j += 2)
            {
                if (phi->ops[j] == &oldPred->base)
                {
                    phi->ops[j]->removeUser(phi);
                    phi->ops[j] = &newPred->base;
                    (&newPred->base)->addUser(phi);
                }
            }
        }
    }

    // Would bypassing bb (pred's empty br-block) into target leave every
    // phi in target unambiguous? With a parallel pred->target edge, pairs
    // naming bb get renamed to pred, so a phi is safe only when all its
    // pred-bound values — existing pred pairs plus the renamed bb pairs —
    // are identical. Pass A then collapses the resulting same-arm
    // cond_br and trims the duplicate pairs.
    bool parallelEdgeSafe(IrBlock* target, IrBlock* bb, IrBlock* pred)
    {
        for (u32 i = 0; i < target->ninsts; i++)
        {
            IrInst* phi = target->insts[i];
            if (phi == null || phi->opcode != IrOpcode::Phi) continue;
            IrValue* firstVal = null;
            for (u32 j = 0; j + 1 < phi->nops; j += 2)
            {
                IrValue* p = phi->ops[j + 1];
                if (p != &pred->base && p != &bb->base) continue;
                IrValue* v = phi->ops[j];
                if (firstVal == null) firstVal = v;
                else if (v != firstVal) return false;
            }
        }
        return true;
    }

    // after collapsing bb's cond_br(arm, arm) to br arm, each phi in
    // `arm` may carry one duplicate incoming pair naming bb — leave
    // exactly one to match the single surviving edge
    void trimDuplicatePhiPairs(IrBlock* block, IrBlock* pred)
    {
        if (block == null || pred == null) return;
        for (u32 i = 0; i < block->ninsts; i++)
        {
            IrInst* phi = block->insts[i];
            if (phi == null || phi->opcode != IrOpcode::Phi) continue;
            u32 count = 0;
            for (u32 j = 1; j < phi->nops; j += 2)
                if (phi->ops[j] == &pred->base) count++;
            if (count <= 1) continue;
            u32 drop = count - 1;
            u32 j = 1;
            while (drop > 0 && j < phi->nops)
            {
                if (phi->ops[j] == &pred->base)
                {
                    phi->ops[j]->removeUser(phi);
                    if (phi->ops[j - 1] != null) phi->ops[j - 1]->removeUser(phi);
                    u32 k = j + 1;
                    while (k + 1 < phi->nops)
                    {
                        phi->ops[k - 2] = phi->ops[k];
                        phi->ops[k - 1] = phi->ops[k + 1];
                        k += 2;
                    }
                    phi->ops[phi->nops - 2] = null;
                    phi->ops[phi->nops - 1] = null;
                    phi->nops -= 2;
                    drop--;
                    j = 1;
                    continue;
                }
                j += 2;
            }
        }
    }

    // would pass A collapsing this cond_br to an unconditional br still
    // have a well-defined phi? If both arms point at the same block and
    // some phi there has two pairs naming bb with DIFFERENT values, the
    // merge is ambiguous — refuse the collapse outright. Only bit-identical
    // pairs may fold.
    bool sameArmCollapseSafe(IrBlock* arm, IrBlock* pred)
    {
        for (u32 i = 0; i < arm->ninsts; i++)
        {
            IrInst* phi = arm->insts[i];
            if (phi == null || phi->opcode != IrOpcode::Phi) continue;
            IrValue* firstVal = null;
            u32 count = 0;
            for (u32 j = 0; j + 1 < phi->nops; j += 2)
            {
                if (phi->ops[j + 1] == &pred->base)
                {
                    if (firstVal == null) firstVal = phi->ops[j];
                    else if (phi->ops[j] != firstVal) return false;
                    count++;
                }
            }
            if (count >= 2 && firstVal == null) return false;
        }
        return true;
    }

    bool run(IrFunc* func)
    {
        if (func == null) return false;
        u32 nblocks = func->nblocks;
        if (nblocks == 0) return false;
        bool forall = false;
        u64 iters = 0;

        loop {
            iters++;
            if (iters > 1000) break;
            bool changed = false;
            // pass A — cond_br with identical arms collapses to a br arm
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                if (bb == null || bb->ninsts == 0) continue;
                IrInst* term = bb->insts[bb->ninsts - 1];
                if (term == null || term->opcode != IrOpcode::CondBr) continue;
                if (term->ops[1] == null || term->ops[2] == null) continue;
                if (term->ops[1] != term->ops[2]) continue;
                IrValue* condV = term->ops[0];
                if (condV != null && condV->kind == IrValueKind::ConstInt) continue;   // sccp owns this
                IrBlock* arm0 = (IrBlock*)term->ops[1];
                if (!self.sameArmCollapseSafe(arm0, bb)) continue;
                IrBlock* arm = (IrBlock*)term->ops[1];
                IrValue** ops = alloc<IrValue*>((usize)1);
                ops[0] = &arm->base;
                IrInst* br = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
                dealloc<IrValue*>(ops);
                term->detach();
                bb->addInst(br);
                // succ list collapses to the single surviving arm edge
                bb->succs[0] = arm;
                bb->nsuccs = 1;
                // pred list had bb twice — drop one occurrence
                arm->removePred(bb);
                // phis in arm lose the now-impossible duplicate incoming pair
                self.trimDuplicatePhiPairs(arm, bb);
                changed = true;
                forall = true;
                break;
            }
            // pass B — chain of single-pred empty blocks elides transitively
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                if (bb == null) continue;
                // only a single-Br block qualifies
                if (bb->ninsts != 1 || bb->npreds != 1) continue;
                IrInst* term = bb->insts[0];
                if (term == null || term->opcode != IrOpcode::Br) continue;
                IrBlock* pred = bb->preds[0];
                if (pred == null || pred == bb) continue;       // self loop
                if (pred->ninsts == 0) continue;
                IrInst* pterm = pred->insts[pred->ninsts - 1];
                if (pterm == null) continue;
                IrBlock* target = (IrBlock*)term->ops[0];
                if (target == null || target == bb) continue;
                if (target == pred) continue;                    // self loop on pred

                // If pred already has an edge to target — a parallel
                // edge, or a second arm that reaches target directly or
                // through another empty block — bypassing bb creates two
                // pred->target edges whose phi pairs both name pred.
                // Safe when every affected phi carries identical values
                // (pass A collapses the same-arm cond_br next round and
                // trims the duplicate); genuinely ambiguous pairs stay
                // put rather than produce malformed IR.
                bool predReachesTarget = false;
                for (u32 sj = 0; sj < pred->nsuccs; sj++)
                    if (pred->succs[sj] == target)
                    { predReachesTarget = true; break; }
                if (predReachesTarget &&
                    !self.parallelEdgeSafe(target, bb, pred)) continue;

                // Rewrite pred's terminator to jump at target.
                if (pterm->opcode == IrOpcode::Br)
                {
                    pterm->ops[0]->removeUser(pterm);
                    pterm->ops[0] = &target->base;
                    (&target->base)->addUser(pterm);
                }
                else if (pterm->opcode == IrOpcode::CondBr)
                {
                    // const-conditioned cond_brs must not be bypassed here —
                    // the const fold lives in sccp (which rewrites the branch
                    // and trims the unsupported arm's phi pairs atomically).
                    // Bypassing through a const condition splits the merge
                    // phi between ambiguously-named preds with conflicting
                    // incoming constants.
                    IrValue* condV = pterm->ops[0];
                    if (condV != null && condV->kind == IrValueKind::ConstInt) return false;
                    if (pterm->ops[1] == &bb->base)
                    {
                        pterm->ops[1]->removeUser(pterm);
                        pterm->ops[1] = &target->base;
                        (&target->base)->addUser(pterm);
                    }
                    else if (pterm->ops[2] == &bb->base)
                    {
                        pterm->ops[2]->removeUser(pterm);
                        pterm->ops[2] = &target->base;
                        (&target->base)->addUser(pterm);
                    }
                    else
                    {
                        continue;
                    }
                }
                else if (pterm->opcode == IrOpcode::Switch)
                {
                    bool matched = false;
                    // operand 1 is the default edge; cases follow as (val, block) pairs
                    if (pterm->ops[1] == &bb->base)
                    {
                        pterm->ops[1]->removeUser(pterm);
                        pterm->ops[1] = &target->base;
                        (&target->base)->addUser(pterm);
                        matched = true;
                    }
                    else
                    {
                        for (u32 j = 2; j + 1 < pterm->nops; j += 2)
                        {
                            if (pterm->ops[j + 1] == &bb->base)
                            {
                                pterm->ops[j + 1]->removeUser(pterm);
                                pterm->ops[j + 1] = &target->base;
                                (&target->base)->addUser(pterm);
                                matched = true;
                                break;
                            }
                        }
                    }
                    if (!matched) continue;
                }
                else
                {
                    continue;
                }

                // Splice the edge in place so the successor order matches
                // the order of the pred terminator's ops (ops[1]=succ0,
                // ops[2]=succ1 for CondBr) — reordering breaks terminator
                // operand-to-succ mapping. Replace bb with target directly.
                for (u32 sj = 0; sj < pred->nsuccs; sj++)
                    if (pred->succs[sj] == bb)
                        pred->succs[sj] = target;
                for (u32 sj = 0; sj < target->npreds; sj++)
                    if (target->preds[sj] == bb)
                        target->preds[sj] = pred;
                // Inform the watchers (succ list -> pred list is manu
                // linked). We did not push targent to pred's succ list end
                // because the order must stay matched to the terminator's
                // ops[] indices.
                // Rename phi inputs in target to name pred instead of bb.
                self.renamePhiPred(target, bb, pred);

                // Detach bb's instructions and remove it from the CFG.
                for (u32 j = 0; j < bb->ninsts; j++)
                    if (bb->insts[j] != null) bb->insts[j]->detach();
                #[[maybe_unused]] IrBlock* targetRef = target;
                func->removeBlock(bb);
                changed = true;
                forall = true;
                // restart scanning — block array shifted, indices desync
                break;
            }
            // pass C — bb ends in `br target` and target's only pred is
            // bb: absorb target wholesale. This flattens the unconditional
            // jump chains inliners leave behind (`__inl.cont.N`).
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                if (bb == null || bb->ninsts == 0) continue;
                IrInst* term = bb->insts[bb->ninsts - 1];
                if (term == null || term->opcode != IrOpcode::Br) continue;
                if (term->nops < 1 || term->ops[0] == null ||
                    term->ops[0]->kind != IrValueKind::Block) continue;
                IrBlock* target = (IrBlock*)term->ops[0];
                if (target == null || target == bb) continue;
                if (target->npreds != 1 || target->preds[0] != bb) continue;

                // A phi in a single-pred block is degenerate — one
                // incoming pair. Replace it with that value up front.
                u32 ti = 0;
                while (ti < target->ninsts)
                {
                    IrInst* phi = target->insts[ti];
                    if (phi != null && phi->opcode == IrOpcode::Phi)
                    {
                        if (phi->nops >= 1 && phi->ops[0] != null)
                            phi->base.replaceAllUses(phi->ops[0]);
                        phi->erase();
                        continue;
                    }
                    ti++;
                }

                // Drop bb's br-to-target; move every target inst
                // (terminator included) into bb in order.
                term->detach();
                term->erase();
                while (target->ninsts > 0)
                {
                    IrInst* mv = target->insts[0];
                    mv->detach();
                    bb->addInst(mv);
                }

                // bb inherits target's successor list verbatim — order
                // must match the moved terminator's operand order.
                bb->nsuccs = 0;
                for (u32 sj = 0; sj < target->nsuccs; sj++)
                {
                    if (bb->nsuccs >= bb->capSuccs)
                    {
                        u32 newCap = bb->capSuccs ? bb->capSuccs * 2 : 4;
                        IrBlock** ns = alloc<IrBlock*>((usize)newCap);
                        if (bb->succs != null)
                        {
                            copy<IrBlock*>(ns, bb->succs, (usize)bb->nsuccs);
                            dealloc<IrBlock*>(bb->succs);
                        }
                        bb->succs = ns;
                        bb->capSuccs = newCap;
                    }
                    bb->succs[bb->nsuccs++] = target->succs[sj];
                }
                for (u32 sj = 0; sj < target->nsuccs; sj++)
                {
                    IrBlock* s = target->succs[sj];
                    if (s == null) continue;
                    for (u32 pj = 0; pj < s->npreds; pj++)
                        if (s->preds[pj] == target) s->preds[pj] = bb;
                    self.renamePhiPred(s, target, bb);
                }
                target->nsuccs = 0;
                target->npreds = 0;
                func->removeBlock(target);
                changed = true;
                forall = true;
                break;
            }
            if (!changed) break;
        }
        return forall;
    }
}

pub bool muvmPassSimplifyCfg(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (func == null || ctx == null) return false;
    SimplifyCfgPass pass = SimplifyCfgPass::new(ctx);
    return pass.run(func);
}
