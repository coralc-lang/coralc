#[[no_drop_all]]
import muvm::irtypes { IrFunc, IrBlock };
import std::mman { alloc, dealloc };

// Cross-pass debug switch — set true to print a line for every
// decision a pass makes. Default false; the driver toggles it via
// muvmOptions verbose for --verbose runs.

pub bool gVerbose = false;

// PtrIndex — O(1) pointer -> dense index lookup.
//
// Several passes need a pointer's position in an ordered table
// (func->blocks[] for dominance order, module->funcs[] for callee
// resolution) and used to linear-scan per query — O(n) each,
// quadratic on large inputs. This is an open-addressing hash built
// once and queried in O(1); keys are raw pointers as usize so it
// serves IrBlock*, IrFunc*, or any pointer table.
//
// Not cached on the IR objects themselves: passes mutate the tables
// through several paths (addBlock/removeBlock, a raw mid-array insert
// in inline.crl, func merges), so a persistent index would need
// invalidation plumbing at every mutation site. Passes hold a
// PtrIndex and rebuild when the owner changes or the table mutates.
pub struct PtrIndex
{
    usize* keys;
    u32* vals;
    u32 mask;
    usize owner;   // identity tag of the table the index was built for

    PtrIndex new()
    {
        return PtrIndex {
            .keys = null,
            .vals = null,
            .mask = 0,
            .owner = 0
        };
    }

    void deinit()
    {
        if (self.keys != null) dealloc<usize>(self.keys);
        if (self.vals != null) dealloc<u32>(self.vals);
        self.keys = null;
        self.vals = null;
        self.mask = 0;
        self.owner = 0;
    }

    u32 hashPtr(usize p)
    {
        u64 h = (u64)p * 0x9E3779B1UL;
        h ^= h >> 16;
        h *= 0x85EBCA6BUL;
        h ^= h >> 13;
        return (u32)h;
    }

    void buildTag(usize tag, usize* ptrs, u32 n)
    {
        self.deinit();
        u32 cap = 16;
        while (cap < n * 2) cap *= 2;
        self.keys = alloc<usize>((usize)cap);
        self.vals = alloc<u32>((usize)cap);
        for (u32 i = 0; i < cap; i++) { self.keys[i] = 0; self.vals[i] = 0; }
        self.mask = cap - 1;
        self.owner = tag;
        for (u32 i = 0; i < n; i++)
        {
            usize p = ptrs[i];
            if (p == 0) continue;
            u32 h = self.hashPtr(p) & self.mask;
            while (self.keys[h] != 0)
            {
                if (self.keys[h] == p) break;
                h = (h + 1) & self.mask;
            }
            if (self.keys[h] == 0)
            {
                self.keys[h] = p;
                self.vals[h] = i;
            }
        }
    }

    // Index the func's block array; `tag` identifies the func.
    void buildBlocks(IrFunc* f)
    {
        if (f == null) { self.deinit(); return; }
        // func->blocks is IrBlock** — view as usize* for the generic fill
        usize* ptrs = (usize*)f->blocks;
        self.buildTag((usize)f, ptrs, f->nblocks);
    }

    // Index an arbitrary pointer table; `tag` is the caller's identity
    // key for invalidation (e.g. the module pointer).
    void buildPtrs(usize tag, usize* ptrs, u32 n)
    {
        self.buildTag(tag, ptrs, n);
    }

    // Index of pointer `p`, or 0xFFFFFFFF.
    u32 get(usize p)
    {
        if (p == 0 || self.keys == null) return 0xFFFFFFFF;
        u32 h = self.hashPtr(p) & self.mask;
        while (self.keys[h] != 0)
        {
            if (self.keys[h] == p) return self.vals[h];
            h = (h + 1) & self.mask;
        }
        return 0xFFFFFFFF;
    }
}
