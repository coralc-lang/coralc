#[[no_drop_all]]
import std::ios { eprintln };
import muvm::passes::common { gVerbose };
import muvm::irMetadata { callMayWriteMemory, funcIsArgMemOnly, funcIsAllocFn, funcIsNoAlias };
import muvm::irtypes { IrContext, IrValue, IrInst, IrBlock, IrFunc, IrValueKind, IrType, IrTypeKind, FunctionAnalysisCache };
import muvm::irOps { IrOpcode };
import std::mman { alloc, dealloc };

// Points-to analysis.
//
// Computes for each pointer SSA value the memory object it may refer to:
// - Alloca instructions (local variables)
// - Global variables
// - Unknown (returned by functions, loaded from pointers)
//
// Handles GEP offsets and bitcasts (base object propagated), phi nodes
// (conservative: only a single agreed object resolves, disagreement or
// any unknown arm yields UNKNOWN), and marks phi cycles via an
// in-progress sentinel instead of recursing forever.
//
// Other passes query isNoAlias / isMustAlias / mayClobber. The result is
// published into FunctionAnalysisCache.aliasAnalysis stamped with the
// context's analysisGeneration; consumers rebuild on demand when stale.
//
// Ported from wallvm's alias_analysis with the MemorySSA scaffolding
// dropped — wallvm's own memory_ssa pass builds the real dependency web
// on top of this analysis and never consumed those arrays.

pub const u32 OBJECT_UNKNOWN = 0;
// decomposeAddr sentinel: object id resolved but byte offset not provable
pub const i64 OFFSET_UNKNOWN = 0x7FFFFFFFFFFFFFFF;
const u32 OBJECT_MAX = 256;
// Walk marker: a value whose object is being computed right now. Re-entering
// it means the def graph has a cycle (phi -> phi), which cuts to UNKNOWN
// instead of recursing forever.
const u32 OBJECT_INPROGRESS = 0xFFFFFFFE;

pub enum AliasResult
{
    NoAlias,    // Definitely don't alias
    MayAlias,   // May alias (conservative)
    MustAlias   // Definitely alias (same base, no offset difference)
}

pub struct MemoryObject
{
    u32 id;
    IrValue* baseValue;  // The defining SSA value (alloca, global, etc.)
    IrValue* baseAddr;   // The address (alloca result, global addr)
    bool isGlobal;
    bool isEscaped;   // Address taken or passed to callee
    u32 sizeBytes;    // Known size (0 = unknown)
}

pub struct AliasAnalysis
{
    IrContext* ctx;
    MemoryObject* objects;
    u32 numObjects;
    u32 capObjects;
    IrFunc* curFunc;   // set by analyze() — arg-pair noalias queries need it

    // Mapping — SSA value id -> object id (or OBJECT_UNKNOWN)
    u32* valToObject;
    u32 valToObjectCap;

    AliasAnalysis new(IrContext* ctx)
    {
        return AliasAnalysis {
            .ctx = ctx,
            .objects = null,
            .numObjects = 0,
            .capObjects = 0,
            .curFunc = null,
            .valToObject = null,
            .valToObjectCap = 0,
            .valSetBits = null,
            .valSetState = null,
            .valSetCap = 0
        };
    }

    void deinit()
    {
        if (self.objects != null) dealloc<MemoryObject>(self.objects);
        if (self.valToObject != null) dealloc<u32>(self.valToObject);
        if (self.valSetBits != null) dealloc<u64>(self.valSetBits);
        if (self.valSetState != null) dealloc<u8>(self.valSetState);
    }

    void ensureObjects(u32 needed)
    {
        if (needed <= self.capObjects) return;
        u32 newCap = self.capObjects ? self.capObjects * 2 : 64;
        while (newCap < needed) newCap *= 2;
        MemoryObject* newArr = alloc<MemoryObject>((usize)newCap);
        if (self.objects != null)
        {
            for (u32 i = 0; i < self.numObjects; i++)
                newArr[i] = self.objects[i];
            dealloc<MemoryObject>(self.objects);
        }
        self.objects = newArr;
        self.capObjects = newCap;
    }

    void ensureValToObject(u32 needed)
    {
        if (needed < self.valToObjectCap) return;
        u32 newCap = self.valToObjectCap ? self.valToObjectCap * 2 : 256;
        while (newCap <= needed) newCap *= 2;
        u32* newArr = alloc<u32>((usize)newCap);
        for (u32 i = 0; i < self.valToObjectCap; i++)
            newArr[i] = self.valToObject[i];
        for (u32 i = self.valToObjectCap; i < newCap; i++)
            newArr[i] = OBJECT_UNKNOWN;
        if (self.valToObject != null) dealloc<u32>(self.valToObject);
        self.valToObject = newArr;
        self.valToObjectCap = newCap;
    }

    u32 getObjectForValue(IrValue* val)
    {
        if (val == null) return OBJECT_UNKNOWN;
        u32 id = val->id;
        if (id >= self.valToObjectCap) return OBJECT_UNKNOWN;
        return self.valToObject[id];
    }

    void setObjectForValue(IrValue* val, u32 objId)
    {
        if (val == null) return;
        self.ensureValToObject(val->id + 1);
        self.valToObject[val->id] = objId;
    }

    u32 createObject(IrValue* baseValue, IrValue* baseAddr, bool isGlobal, u32 sizeBytes)
    {
        self.ensureObjects(self.numObjects + 1);
        // Object ids are 1-based: 0 is OBJECT_UNKNOWN, and a 0 id would
        // read back as "no object" through getObjectForValue (wallvm's
        // port had this collision — the first object was always
        // duplicated and its slot orphaned).
        u32 id = self.numObjects + 1;
        MemoryObject* obj = &self.objects[self.numObjects];
        obj->id = id;
        obj->baseValue = baseValue;
        obj->baseAddr = baseAddr;
        obj->isGlobal = isGlobal;
        obj->isEscaped = false;
        obj->sizeBytes = sizeBytes;
        self.numObjects++;
        return id;
    }

    // Walk the address operand to find the base object.
    // Handles: alloca, global, GEP(base, ...), bitcast(x), phi(...)
    u32 walkAddr(IrValue* addr)
    {
        if (addr == null) return OBJECT_UNKNOWN;

        if (addr->kind == IrValueKind::Global)
        {
            u32 cached = self.getObjectForValue(addr);
            if (cached != OBJECT_UNKNOWN) return cached;
            u32 objId = self.createObject(addr, addr, true, 0);
            self.setObjectForValue(addr, objId);
            return objId;
        }

        if (addr->kind != IrValueKind::Inst) return OBJECT_UNKNOWN;

        IrInst* inst = (IrInst*)addr;
        u32 cached = self.getObjectForValue(addr);
        if (cached == OBJECT_INPROGRESS) return OBJECT_UNKNOWN; // cycle cut
        if (cached != OBJECT_UNKNOWN) return cached;

        switch (inst->opcode)
        {
            IrOpcode::Alloca => {
                u32 sz = 0;
                if (inst->nops > 0 && inst->ops[0] != null && inst->ops[0]->kind == IrValueKind::ConstInt)
                    sz = (u32)inst->ops[0]->valData;
                u32 objId = self.createObject(&inst->base, &inst->base, false, sz);
                self.setObjectForValue(&inst->base, objId);
                return objId;
            },

            IrOpcode::Gep => {
                if (inst->nops > 0)
                    return self.walkAddr(inst->ops[0]);
                return OBJECT_UNKNOWN;
            },

            IrOpcode::Bitcast => {
                if (inst->nops > 0)
                    return self.walkAddr(inst->ops[0]);
                return OBJECT_UNKNOWN;
            },

            IrOpcode::Phi => {
                // Mark in-progress first: a phi cycle (self- or mutually
                // referencing phis) cuts to UNKNOWN instead of recursing
                // forever.
                self.setObjectForValue(addr, OBJECT_INPROGRESS);
                u32 result = OBJECT_UNKNOWN;
                // Phi operands are interleaved value/block pairs, so step by 2
                // and read only the value slot of each pair.
                for (u32 j = 0; j + 1 < inst->nops; j += 2)
                {
                    IrValue* incoming = inst->ops[j];
                    if (incoming == null)
                        continue;
                    // self-edge: same object by definition, no new information
                    if (incoming == &inst->base)
                        continue;
                    u32 incomingObj = self.walkAddr(incoming);
                    if (incomingObj == OBJECT_UNKNOWN) {
                        result = OBJECT_UNKNOWN;
                        break;
                    }
                    if (result == OBJECT_UNKNOWN)
                        result = incomingObj;
                    else if (result != incomingObj) {
                        result = OBJECT_UNKNOWN;
                        break;
                    }
                }
                // always clear the in-progress marker (0 == UNKNOWN == not
                // cached, so storing it is equivalent to removing it)
                self.setObjectForValue(addr, result);
                return result;
            },

            IrOpcode::Call => {
                // allocfn-attributed callees (malloc & friends) return a
                // fresh object per call — it can't alias any other
                // object, so give each call site its own MemoryObject
                IrValue* cv = inst->nops > 0 ? inst->ops[0] : null;
                if (cv != null && cv->kind == IrValueKind::Func &&
                    funcIsAllocFn((IrFunc*)cv))
                {
                    u32 objId = self.createObject(&inst->base, &inst->base, false, 0);
                    self.setObjectForValue(&inst->base, objId);
                    return objId;
                }
                return OBJECT_UNKNOWN;
            },

            IrOpcode::Load => { return OBJECT_UNKNOWN; },

            else => { return OBJECT_UNKNOWN; }
        }
    }

    // Main analysis entry point.
    // 1. Scan all allocas to create objects
    // 2. Walk all store/load/gep/bitcast/phi addresses to build the
    //    value -> object map
    void analyze(IrFunc* func)
    {
        self.curFunc = func;
        self.numObjects = 0;
        // Reset the value->object map: entries from a previous analyze
        // would otherwise leak into this run.
        for (u32 i = 0; i < self.valToObjectCap; i++)
            self.valToObject[i] = OBJECT_UNKNOWN;
        // Points-to sets are per-analyze too: stale entries would answer
        // queries about values that no longer exist or moved objects.
        for (u32 i = 0; i < self.valSetCap; i++)
            self.valSetState[i] = 0;

        // Pass 1 — Create objects for all allocas
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Alloca)
                {
                    u32 sz = 0;
                    if (inst->nops > 0 && inst->ops[0] != null && inst->ops[0]->kind == IrValueKind::ConstInt)
                        sz = (u32)inst->ops[0]->valData;
                    u32 objId = self.createObject(&inst->base, &inst->base, false, sz);
                    self.setObjectForValue(&inst->base, objId);
                }
            }
        }

        // Pass 2 — Walk all memory-address operands to discover objects.
        // GEP/bitcast propagate their base's object; a phi caches only
        // when every arm resolves to the SAME object — caching the first
        // arm made queries through the phi answer NoAlias against the
        // other arm's real object. Any disagreement/unknown arm caches
        // nothing and walkAddr's own phi rule answers UNKNOWN
        // (conservative may-alias) at query time.
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];

                // Store — walk the address operand (ops[1])
                if (inst->opcode == IrOpcode::Store && inst->nops >= 2)
                {
                    u32 objId = self.walkAddr(inst->ops[1]);
                    (void)objId;
                }

                // Load — walk the address operand (ops[0])
                if (inst->opcode == IrOpcode::Load && inst->nops >= 1)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    (void)objId;
                }

                // AtomicStore — walk the address operand (ops[1])
                if (inst->opcode == IrOpcode::AtomicStore && inst->nops >= 2)
                {
                    u32 objId = self.walkAddr(inst->ops[1]);
                    (void)objId;
                }
                if (inst->opcode == IrOpcode::AtomicLoad && inst->nops >= 1)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    (void)objId;
                }
                if (inst->opcode == IrOpcode::AtomicRmw && inst->nops >= 2)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    (void)objId;
                }
                if (inst->opcode == IrOpcode::AtomicCmpXchg && inst->nops >= 1)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    (void)objId;
                }

                // Gep — propagate the base object's id onto the result
                if (inst->opcode == IrOpcode::Gep && inst->nops > 0)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    if (objId != OBJECT_UNKNOWN)
                        self.setObjectForValue(&inst->base, objId);
                }

                // Bitcast — propagate
                if (inst->opcode == IrOpcode::Bitcast && inst->nops > 0)
                {
                    u32 objId = self.walkAddr(inst->ops[0]);
                    if (objId != OBJECT_UNKNOWN)
                        self.setObjectForValue(&inst->base, objId);
                }

                // Phi — merge incoming objects: cache only when every arm
                // resolves to the SAME object.
                if (inst->opcode == IrOpcode::Phi)
                {
                    u32 merged = OBJECT_UNKNOWN;
                    bool bad = false;
                    // Phi operands are interleaved value/block pairs, so step by 2
                    // and read only the value slot of each pair.
                    for (u32 j = 0; j + 1 < inst->nops; j += 2)
                    {
                        IrValue* incoming = inst->ops[j];
                        if (incoming == null || incoming == &inst->base)
                            continue;
                        u32 objId = self.walkAddr(incoming);
                        if (objId == OBJECT_UNKNOWN) { bad = true; break; }
                        if (merged == OBJECT_UNKNOWN)
                            merged = objId;
                        else if (merged != objId) { bad = true; break; }
                    }
                    if (!bad && merged != OBJECT_UNKNOWN)
                        self.setObjectForValue(&inst->base, merged);
                }
            }
        }

        // Pass 3 — escape marking: a pointer that flows into a call,
        // store value, return, or inline asm may be retained or observed
        // by code we cannot see. Conservative and one-directional: once
        // escaped, always escaped.
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u32 first = 0xFFFFFFFF;
                u32 last = 0;
                switch (inst->opcode)
                {
                    // call args: every operand is a potential escape
                    IrOpcode::Call | IrOpcode::InlineAsm => { first = 0; last = inst->nops; },
                    // store value operand (ops[0]); the address is ops[1]
                    IrOpcode::Store => { first = 0; last = inst->nops > 0 ? 1 : 0; },
                    // ret value
                    IrOpcode::Ret => { first = 0; last = inst->nops; },
                    else => { continue; }
                }
                for (u32 oi = first; oi < last; oi++)
                {
                    IrValue* v = inst->ops[oi];
                    if (v == null || v->kind != IrValueKind::Inst) continue;
                    u32 objId = self.walkAddr(v);
                    if (objId != OBJECT_UNKNOWN && objId <= self.numObjects)
                        self.objects[objId - 1].isEscaped = true;
                }
            }
        }
    }

    // Byte offset of "address = base + constant" decomposition.
    // OFFSET_UNKNOWN marks "offset not provable" — the object id is
    // still valid, only the offset is unknown. Struct/union field
    // geps and any dynamic index poison the offset (conservative).

    u32 decomposeAddr(IrValue* addr, i64* outOff)
    {
        *outOff = 0;
        if (addr == null) { *outOff = OFFSET_UNKNOWN; return OBJECT_UNKNOWN; }
        if (addr->kind == IrValueKind::Global)
        {
            u32 o = self.walkAddr(addr);
            if (o == OBJECT_UNKNOWN) *outOff = OFFSET_UNKNOWN;
            return o;
        }
        if (addr->kind != IrValueKind::Inst)
        { *outOff = OFFSET_UNKNOWN; return OBJECT_UNKNOWN; }
        IrInst* inst = (IrInst*)addr;
        if (inst->opcode == IrOpcode::Bitcast && inst->nops > 0)
            return self.decomposeAddr(inst->ops[0], outOff);
        if (inst->opcode == IrOpcode::Gep && inst->nops >= 2)
        {
            i64 baseOff = 0;
            u32 obj = self.decomposeAddr(inst->ops[0], &baseOff);
            // accumulate each index's byte contribution; any dynamic
            // index poisons the whole offset
            i64 total = baseOff;
            bool ok = baseOff != OFFSET_UNKNOWN;
            // walk the type descent once, pricing every index
            IrType* cur = null;
            if (inst->ops[0] != null && inst->ops[0]->type != null)
            {
                cur = inst->ops[0]->type;
                if (cur->kind == IrTypeKind::Ptr) cur = cur->elem;
            }
            for (u32 gi = 1; gi < inst->nops && ok; gi++)
            {
                IrValue* ix = inst->ops[gi];
                if (ix == null || ix->kind != IrValueKind::ConstInt)
                { ok = false; break; }
                if (cur != null &&
                    (cur->kind == IrTypeKind::Struct ||
                     cur->kind == IrTypeKind::Union))
                {
                    // field offsets aren't tracked on IrType — poison
                    // the offset rather than guess
                    ok = false;
                    break;
                }
                else
                {
                    IrType* et = null;
                    u64 esz = 1;
                    if (cur != null &&
                        (cur->kind == IrTypeKind::Array ||
                         cur->kind == IrTypeKind::Vector))
                        et = cur->elem;
                    else if (cur != null && cur->kind == IrTypeKind::Ptr)
                        et = cur->elem;
                    if (et != null) esz = (u64)self.ctx->irTypeSizeOf(et);
                    total += (i64)ix->valData * (i64)esz;
                    cur = et;
                }
            }
            *outOff = ok ? total : OFFSET_UNKNOWN;
            return obj;
        }
        // phi / call / load / anything else: object may still resolve
        // through walkAddr, but per-arm offsets differ — unknown offset
        u32 obj = self.walkAddr(addr);
        *outOff = OFFSET_UNKNOWN;
        return obj;
    }

    // --- points-to sets -------------------------------------------------
    // walkAddr answers a single object id and gives up (UNKNOWN) when a
    // phi's arms disagree. Sets keep every candidate: a phi unions its
    // arms' sets, unknown producers fill all bits (may-alias anything).
    // 256 objects = 4 u64 words per value, allocated lazily per value id.

    u64* valSetBits;    // valId*4 words — object bitsets
    u8* valSetState;    // 0 = uncomputed, 1 = in-progress, 2 = done
    u32 valSetCap;

    void ensureValSets(u32 needed)
    {
        if (needed <= self.valSetCap) return;
        u32 newCap = self.valSetCap ? self.valSetCap * 2 : 256;
        while (newCap <= needed) newCap *= 2;
        u64* nb = alloc<u64>((usize)newCap * 4);
        u8* ns = alloc<u8>((usize)newCap);
        if (self.valSetBits != null)
        {
            for (usize i = 0; i < (usize)self.valSetCap * 4; i++)
                nb[i] = self.valSetBits[i];
            dealloc<u64>(self.valSetBits);
        }
        if (self.valSetState != null)
        {
            for (u32 i = 0; i < self.valSetCap; i++)
                ns[i] = self.valSetState[i];
            dealloc<u8>(self.valSetState);
        }
        for (u64 i = (u64)self.valSetCap * 4; i < (u64)newCap * 4; i++)
            nb[i] = 0;
        for (u32 i = self.valSetCap; i < newCap; i++)
            ns[i] = 0;
        self.valSetBits = nb;
        self.valSetState = ns;
        self.valSetCap = newCap;
    }

    void setAllBits(u64* bits)
    {
        for (u32 i = 0; i < 4; i++) bits[i] = ~((u64)0);
    }

    void setBit(u64* bits, u32 objId)
    {
        if (objId == 0 || objId > OBJECT_MAX) { self.setAllBits(bits); return; }
        bits[(usize)((objId - 1) >> 6)] |= ((u64)1 << (u64)((objId - 1) & 63));
    }

    bool setsDisjoint(const u64* a, const u64* b)
    {
        for (u32 i = 0; i < 4; i++)
            if ((a[i] & b[i]) != 0) return false;
        return true;
    }

    // Fill `bits` with v's points-to set. Recursive over gep/bitcast/
    // phi; OBJECT_INPROGRESS-style cut on cycles (state==1 → empty,
    // the cycle contributes nothing new beyond its other arms).
    void collectSet(IrValue* v, u64* bits)
    {
        if (v == null) { self.setAllBits(bits); return; }
        if (v->kind == IrValueKind::Inst)
        {
            IrInst* inst = (IrInst*)v;
            if (inst->opcode == IrOpcode::Phi)
            {
                self.ensureValSets(v->id + 1);
                if (self.valSetState[v->id] == 1)
                {
                    // phi cycle: this arm adds nothing
                    for (u32 i = 0; i < 4; i++) bits[i] = 0;
                    return;
                }
                if (self.valSetState[v->id] == 2)
                {
                    for (u32 i = 0; i < 4; i++) bits[i] = self.valSetBits[v->id * 4 + i];
                    return;
                }
                self.valSetState[v->id] = 1;
                for (u32 i = 0; i < 4; i++) bits[i] = 0;
                for (u32 j = 0; j + 1 < inst->nops; j += 2)
                {
                    u64[4] tmp;
                    self.collectSet(inst->ops[j], tmp);
                    for (u32 i = 0; i < 4; i++) bits[i] |= tmp[i];
                }
                for (u32 i = 0; i < 4; i++)
                    self.valSetBits[v->id * 4 + i] = bits[i];
                self.valSetState[v->id] = 2;
                return;
            }
            if ((inst->opcode == IrOpcode::Gep ||
                 inst->opcode == IrOpcode::Bitcast) && inst->nops > 0)
            {
                self.collectSet(inst->ops[0], bits);
                return;
            }
            // other insts (call results, loads): unknown producer
            u32 o = self.walkAddr(v);
            if (o == OBJECT_UNKNOWN) self.setAllBits(bits);
            else { for (u32 i = 0; i < 4; i++) bits[i] = 0; self.setBit(bits, o); }
            return;
        }
        // globals, args, consts: single object or unknown
        u32 o = self.walkAddr(v);
        if (o == OBJECT_UNKNOWN) self.setAllBits(bits);
        else { for (u32 i = 0; i < 4; i++) bits[i] = 0; self.setBit(bits, o); }
    }

    // Query — do two values definitely not alias?
    bool isNoAlias(IrValue* a, IrValue* b)
    {
        if (a == null || b == null) return true;
        if (a->id == b->id) return false;

        // func-level noalias: two distinct pointer params of a
        // noalias-attributed function can't alias each other. Scoped
        // deliberately narrow — arg vs alloca/global can still alias
        // through the caller, so only the arg-arg pair is proven here.
        if (self.curFunc != null && funcIsNoAlias(self.curFunc) &&
            a->kind == IrValueKind::Arg && b->kind == IrValueKind::Arg &&
            a->type != null && a->type->kind == IrTypeKind::Ptr &&
            b->type != null && b->type->kind == IrTypeKind::Ptr)
            return true;

        u32 objA = self.walkAddr(a);
        u32 objB = self.walkAddr(b);

        if (objA != OBJECT_UNKNOWN && objB != OBJECT_UNKNOWN && objA != objB)
            return true;

        // points-to sets: disjoint candidate objects prove no-alias even
        // when either side is a phi over several objects
        u64[4] sa;
        u64[4] sb;
        self.collectSet(a, sa);
        self.collectSet(b, sb);
        return self.setsDisjoint(sa, sb);
    }

    // Query — do two values definitely alias?
    // Same object + identical constant byte offset is a must-alias:
    // two distinct SSA geps computing the same address are the same
    // memory location. Dynamic/unknown offsets stay conservative.
    bool isMustAlias(IrValue* a, IrValue* b)
    {
        if (a == null || b == null) return false;
        if (a->id == b->id) return true;
        i64 oa = 0;
        i64 ob = 0;
        u32 ia = self.decomposeAddr(a, &oa);
        u32 ib = self.decomposeAddr(b, &ob);
        if (ia == OBJECT_UNKNOWN || ia != ib) return false;
        if (oa == OFFSET_UNKNOWN || ob == OFFSET_UNKNOWN) return false;
        return oa == ob;
    }

    // Sized clobber query: proves a store can't reach the load when
    // both decompose to the same object with known, disjoint byte
    // ranges. Sizes of 0 mean "unknown extent" → conservative overlap.
    bool mayClobberSized(IrValue* loadAddr, u64 loadSize,
                         IrValue* storeAddr, u64 storeSize)
    {
        if (loadAddr == null || storeAddr == null) return true;
        i64 lo = 0;
        i64 so = 0;
        u32 li = self.decomposeAddr(loadAddr, &lo);
        u32 si = self.decomposeAddr(storeAddr, &so);
        if (li == OBJECT_UNKNOWN || si == OBJECT_UNKNOWN) return true;
        if (li != si)
        {
            // different resolved objects can't clobber — but a phi may
            // still carry the other side's object in its set
            u64[4] sl;
            u64[4] ss;
            self.collectSet(loadAddr, sl);
            self.collectSet(storeAddr, ss);
            return !self.setsDisjoint(sl, ss);
        }
        if (lo == OFFSET_UNKNOWN || so == OFFSET_UNKNOWN) return true;
        if (loadSize == 0 || storeSize == 0) return true;
        // [off, off+size) overlap test
        return lo < so + (i64)storeSize && so < lo + (i64)loadSize;
    }

    // Call-site clobber query: can this call write the memory `addr`
    // names? Non-writing callees can't; argmemonly callees can only
    // reach memory through their pointer args, so the address's points-
    // to set must intersect the union of the call's pointer-arg sets.
    bool mayCallClobber(IrInst* call, IrValue* addr)
    {
        if (call == null || addr == null) return true;
        if (!callMayWriteMemory(call)) return false;
        if (call->nops < 1 || call->ops[0] == null ||
            call->ops[0]->kind != IrValueKind::Func)
            return true; // indirect — unknown
        IrFunc* callee = (IrFunc*)call->ops[0];
        if (!funcIsArgMemOnly(callee)) return true;
        // union the points-to sets of pointer-typed call args
        u64[4] argBits;
        for (u32 i = 0; i < 4; i++) argBits[i] = 0;
        bool anyPtr = false;
        for (u32 ai = 1; ai < call->nops; ai++)
        {
            IrValue* av = call->ops[ai];
            if (av == null || av->type == null ||
                av->type->kind != IrTypeKind::Ptr) continue;
            anyPtr = true;
            u64[4] ab;
            self.collectSet(av, ab);
            for (u32 i = 0; i < 4; i++) argBits[i] |= ab[i];
        }
        if (!anyPtr) return false; // argmemonly + no pointer args → writes nothing reachable
        u64[4] sa;
        self.collectSet(addr, sa);
        return !self.setsDisjoint(sa, argBits);
    }

    // Query — can a load at address 'loadAddr' be clobbered by a store at address 'storeAddr'?
    // Returns true if the store may overwrite the memory read by the load.
    bool mayClobber(IrValue* loadAddr, IrValue* storeAddr)
    {
        if (loadAddr == null || storeAddr == null) return true;
        u32 loadObj = self.walkAddr(loadAddr);
        u32 storeObj = self.walkAddr(storeAddr);

        if (loadObj == OBJECT_UNKNOWN || storeObj == OBJECT_UNKNOWN)
        {
            // unknown single-object answers may still be provable via
            // points-to sets (phi over a fixed object set)
            u64[4] sl;
            u64[4] ss;
            self.collectSet(loadAddr, sl);
            self.collectSet(storeAddr, ss);
            return !self.setsDisjoint(sl, ss);
        }
        if (loadObj == storeObj) return true;
        // different objects: phi sets could still overlap
        u64[4] sl;
        u64[4] ss;
        self.collectSet(loadAddr, sl);
        self.collectSet(storeAddr, ss);
        return !self.setsDisjoint(sl, ss);
    }

    // Query — does a store to 'storeAddr' kill a prior load from 'loadAddr'?
    // (i.e., do they definitely alias)
    bool doesStoreKillLoad(IrValue* storeAddr, IrValue* loadAddr)
    {
        return self.isMustAlias(storeAddr, loadAddr);
    }

    // Debug dump: every memory object and every resolved value -> object
    // edge. Values print as <kind>:<id> plus the defining opcode for
    // insts so the mapping can be checked against the IR text.
    void dump(IrFunc* func)
    {
        eprintln("aa: func={} objects={}", func->base.name, (u64)self.numObjects);
        for (u32 i = 0; i < self.numObjects; i++)
        {
            MemoryObject* o = &self.objects[i];
            eprintln("  obj {}: {}val={} size={} escaped={}",
                     (u64)o->id,
                     o->isGlobal ? "global " : "alloca ",
                     o->baseValue != null ? (u64)o->baseValue->id : 0,
                     (u64)o->sizeBytes, o->isEscaped ? 1 : 0);
        }
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u32 obj = self.getObjectForValue(&inst->base);
                if (obj == OBJECT_UNKNOWN) continue;
                eprintln("  {}:{} -> obj {}", bb->base.name, (u64)inst->base.id, (u64)obj);
            }
        }
        // Query exercise: for every load, report mayClobber against each
        // earlier store in the same block — the verdict a DSE/load-
        // forwarding pass would act on.
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* li = bb->insts[ii];
                if (li->opcode != IrOpcode::Load || li->nops < 1) continue;
                for (u32 sj = 0; sj < ii; sj++)
                {
                    IrInst* si = bb->insts[sj];
                    if (si->opcode != IrOpcode::Store || si->nops < 2) continue;
                    bool mc = self.mayClobber(li->ops[0], si->ops[1]);
                    eprintln("  query {}:{} load mayClobber store {}:{} = {}",
                             bb->base.name, (u64)li->base.id,
                             bb->base.name, (u64)si->base.id, mc ? 1 : 0);
                }
            }
        }
    }
}

// Registered as FunctionAnalysisCache.destroyAliasAnalysis: the cache owns
// the published heap copy, so both the internal buffers (deinit) and the
// copy itself (dealloc) are released here.
void destroyCachedAliasAnalysis(rawptr p)
{
    AliasAnalysis* aa = (AliasAnalysis*)p;
    aa->deinit();
    dealloc<AliasAnalysis>(aa);
}

pub bool muvmPassAliasAnalysis(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;

    // Check if we already have cached results for this function
    FunctionAnalysisCache* cache = ctx->getOrCreateAnalysisCache(func);
    if (cache->aliasAnalysis != null)
    {
        if (cache->generation == ctx->analysisGeneration) return false;
        // Stale — the IR mutated since this AA was built. Free it via the
        // registered destroyer and rebuild below.
        if (cache->destroyAliasAnalysis != null)
            cache->destroyAliasAnalysis(cache->aliasAnalysis);
        cache->aliasAnalysis = null;
    }

    AliasAnalysis aa = AliasAnalysis::new(ctx);
    aa.analyze(func);
    if (gVerbose) aa.dump(func);

    // Store in cache (heap-allocated copy)
    AliasAnalysis* cached = alloc<AliasAnalysis>((usize)1);
    *cached = aa;
    cache->aliasAnalysis = cached;
    cache->generation = ctx->analysisGeneration;
    cache->destroyAliasAnalysis = destroyCachedAliasAnalysis;
    return false;
}
