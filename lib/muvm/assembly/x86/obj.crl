#[[no_drop_all]]
// Object model + structured writers: the assembler produces an AsmObject
// (sections + symbol table + relocation records), and three sinks turn it
// into bytes — ELF64 relocatable, PE/COFF x86-64, and flat raw. Symbols
// that are only referenced stay undefined with relocation records so an
// external linker resolves them; raw applies every relocation against a
// caller-supplied base and requires everything defined.
import muvm::assembly::common { AsmParseError };
import muvm::assembly::x86::common { AsmBytes };

import std::mman { alloc, dealloc, realloc };
import std::vec { Vec };

// relocation kinds — mapped to ELF/COFF codes by the writers
pub enum AsmRelocKind
{
    RelAbs64,   // absolute 64-bit (R_X86_64_64 / IMAGE_REL_AMD64_ADDR64)
    RelAbs32,   // absolute 32-bit (R_X86_64_32 / IMAGE_REL_AMD64_ADDR32)
    RelPc32,    // PC-relative 32-bit (R_X86_64_PC32 / IMAGE_REL_AMD64_REL32)
    RelPlt32,   // PLT-style PC-relative (R_X86_64_PLT32 / REL32)
    RelAbs16    // absolute 16-bit (R_X86_64_16; .value/.short sym)
}

pub struct AsmSymbol
{
    str name;
    u64 value;      // offset within its section when defined
    u64 size;       // st_size from `.size name, expr`
    i32 section;    // 0 = undefined, 1 = text, 2 = data
    bool defined;
    bool global;    // external linkage: .globl / .extern
    bool weak;      // STB_WEAK binding (ELF); COFF treats as external
    bool isFunc;    // STT_FUNC / COFF function descriptor
    bool isObject;  // STT_OBJECT from `.type name, @object`
    bool isView;    // `.loc ... view NAME` marker: data refs evaluate to 0
    u8 vis;         // ELF st_other visibility: 0 default, 1 internal,
                    // 2 hidden, 3 protected
}

pub struct AsmReloc
{
    u64 offset;     // byte offset within the section
    str symbol;     // target symbol name
    u8 kind;        // AsmRelocKind
    i64 addend;
    i32 section;    //1 text, 2 data
}

pub struct AsmSection
{
    str name;
    AsmBytes data;
    u64 align;      // max alignment requested inside the section
}

// assembler-named sections beyond the four fixed slots (.rodata.*,
// .data.rel.*, .bss, .debug_*, .eh_frame, .comment, ...). Section indices
// 5+ address xsecs[sec - 5]; 1..4 stay the fixed fields on AsmObject.
pub struct AsmXSection
{
    str name;
    AsmBytes data;
    u64 align;
    u32 shf;        // SHF_WRITE(1) | SHF_ALLOC(2) | SHF_EXECINSTR(4)
    bool nobits;    // SHT_NOBITS: occupies `size` bytes, no file data
    u64 size;       // nobits size (progbits sections use data.len)
}

pub struct AsmLebKey
{
    u64 key;
    str a;
    str b;
    i64 addend;
    i64 value;
    u8 kind;    // 0 = uleb128, 1 = sleb128
}

pub struct AsmLebPend
{
    u64 key;
    i32 sec;
    u64 off;
    u8 kind;
    i32 a;
    i32 b;      // -1 = single symbol (value = a.value + addend)
    i64 addend;
}

pub struct AsmLebCtx
{
    AsmLebKey* keys;
    u32 nkeys;
    u32 kcap;
    AsmLebPend* pend;
    u32 npend;
    u32 pcap;
}

pub struct AsmPendingDiff
{
    i32 sec;
    u64 off;
    u8 width;
    i32 a;
    i32 b;
}

// DWARF5 .debug_line bookkeeping: .loc entries are recorded while
// assembling code sections and flushed as a line-number program when the
// assembler leaves .debug_line (or at end of input). `sec == -1` marks a
// sequence break: the following entry starts a new sequence whose first
// address is (secB, offB).
pub struct AsmLineEnt
{
    i32 sec;
    u64 off;
    i32 file;
    i64 line;
    i64 col;
    i64 isStmt;     // -1 = operand absent
    u8 flags;       // bit0 prologue_end, bit1 epilogue_begin, bit2 basic_block
    i64 discrim;    // -1 = absent
    i64 isa;        // -1 = absent
    i32 secB;
    u64 offB;
}

pub struct AsmLineFile
{
    str name;       // file name (last .file string)
    i32 dir;        // index into dirs[], -1 = none (emits 0)
}

// .cfi_* event recorded at a code offset; emitted as DWARF CFI
// instructions inside .eh_frame FDEs (or CIE initial instructions for
// ops at the function-entry offset).
pub struct AsmCfiEnt
{
    i32 sec;
    u64 off;
    u8 op;      // 1=def_cfa_offset 2=def_cfa_register 3=def_cfa
                // 4=offset 5=restore 6=remember_state 7=restore_state
                // 8=undefined 9=same_value 10=register 11=val_offset
    i64 a;
    i64 b;
}

pub struct AsmLineState
{
    AsmLineEnt* ents;
    u32 nents;
    u32 ecap;
    AsmLineFile* files; // index = .file number
    u32 nfiles;
    u32 fcap;
    str* dirs;
    u32 ndirs;
    u32 dcap;
    bool brkPending;  // .cfi_endproc seen; close sequence at (brkSec,brkOff)
    i32 brkSec;
    u64 brkOff;
    // .cfi_* -> .eh_frame bookkeeping
    AsmCfiEnt* cfents;
    u32 ncf;
    u32 cficap;
    i32 cfisec;     // section containing .cfi_startproc
    u64 cfistart;   // offset of .cfi_startproc
    bool cfiopen;
}

pub struct AsmObject
{
    AsmSection text;
    AsmSection data;
    AsmSection hot;     // .text.hot / COFF .text$hot
    AsmSection cold;    // .text.cold / COFF .text$cold
    Vec<AsmXSection> xsecs;
    AsmSymbol* syms;
    u32 nsyms;
    u32 symCap;
    i32* symTab;       // name->index hash, sym index + 1 (0 = empty)
    u32 symTabMask;
    AsmReloc* relocs;
    u32 nrelocs;
    u32 relocCap;
    AsmPendingDiff* pdiffs;
    u32 npdiffs;
    u32 pdiffCap;
    AsmLebCtx* lebctx;  // borrowed across assembly passes; not owned
    AsmLineState* lstate; // lazily allocated DWARF line bookkeeping
}

pub AsmObject asmObjectNew()
{
    return AsmObject {
        .text = AsmSection { .name = ".text", .data = AsmBytes::new(), .align = 16 },
        .data = AsmSection { .name = ".data", .data = AsmBytes::new(), .align = 8 },
        .hot = AsmSection { .name = ".text.hot", .data = AsmBytes::new(), .align = 16 },
        .cold = AsmSection { .name = ".text.cold", .data = AsmBytes::new(), .align = 16 },
        .xsecs = Vec<AsmXSection>::new(),
        .syms = null,
        .nsyms = 0,
        .symCap = 0,
        .symTab = null,
        .symTabMask = 0,
        .relocs = null,
        .nrelocs = 0,
        .relocCap = 0,
        .pdiffs = null,
        .npdiffs = 0,
        .pdiffCap = 0,
        .lebctx = null,
        .lstate = null
    };
}

pub void asmObjectDeinit(AsmObject* o)
{
    o->text.data.deinit();
    o->data.data.deinit();
    o->hot.data.deinit();
    o->cold.data.deinit();
    for (usize i = 0; i < o->xsecs.count(); i++)
    {
        o->xsecs.atPtr(i)->data.deinit();
    }
    o->xsecs.dispose();
    if (o->syms != null) dealloc<AsmSymbol>(o->syms);
    if (o->symTab != null) dealloc<i32>(o->symTab);
    if (o->relocs != null) dealloc<AsmReloc>(o->relocs);
    if (o->pdiffs != null) dealloc<AsmPendingDiff>(o->pdiffs);
    if (o->lstate != null)
    {
        if (o->lstate->ents != null) dealloc<AsmLineEnt>(o->lstate->ents);
        if (o->lstate->files != null) dealloc<AsmLineFile>(o->lstate->files);
        if (o->lstate->dirs != null) dealloc<str>(o->lstate->dirs);
        if (o->lstate->cfents != null) dealloc<AsmCfiEnt>(o->lstate->cfents);
        dealloc<AsmLineState>(o->lstate);
    }
    o->syms = null;
    o->relocs = null;
    o->pdiffs = null;
    o->nsyms = 0;
    o->symCap = 0;
    o->symTab = null;
    o->symTabMask = 0;
    o->nrelocs = 0;
    o->relocCap = 0;
    o->npdiffs = 0;
    o->pdiffCap = 0;
    o->lebctx = null;
}

pub bool asmAddPendingDiff(AsmObject* o, i32 sec, u64 off, u8 width, i32 a, i32 b)
{
    if (o->npdiffs == o->pdiffCap)
    {
        u32 nc = o->pdiffCap == 0 ? 64 : o->pdiffCap * 2;
        AsmPendingDiff* nd = alloc<AsmPendingDiff>((usize)nc);
        if (nd == null) return false;
        for (u32 i = 0; i < o->npdiffs; i++) nd[i] = o->pdiffs[i];
        if (o->pdiffs != null) dealloc<AsmPendingDiff>(o->pdiffs);
        o->pdiffs = nd;
        o->pdiffCap = nc;
    }
    AsmPendingDiff* d = &o->pdiffs[o->npdiffs];
    d->sec = sec;
    d->off = off;
    d->width = width;
    d->a = a;
    d->b = b;
    o->npdiffs++;
    return true;
}

// ------------------------------------------------------------------
// section table helpers. Indices 1..4 are the fixed AsmSection fields;
// 5+ index o->xsecs[sec - 5].
// ------------------------------------------------------------------

pub i32 asmFindXSection(AsmObject* o, str name)
{
    for (usize i = 0; i < o->xsecs.count(); i++)
    {
        if (o->xsecs.atPtr(i)->name.equals(name)) return (i32)(5 + i);
    }
    return -1;
}

pub i32 asmAddXSection(AsmObject* o, str name, u32 shf, bool nobits)
{
    i32 f = asmFindXSection(o, name);
    if (f >= 0) return f;
    AsmXSection s;
    s.name = name;
    s.data = AsmBytes::new();
    s.align = 1;
    s.shf = shf;
    s.nobits = nobits;
    s.size = 0;
    o->xsecs.push(s);
    return (i32)(5 + o->xsecs.count() - 1);
}

pub AsmBytes* asmSecData(AsmObject* o, i32 sec)
{
    if (sec == 2) return &o->data.data;
    if (sec == 3) return &o->hot.data;
    if (sec == 4) return &o->cold.data;
    if (sec >= 5) return &o->xsecs.atPtr((usize)(sec - 5))->data;
    return &o->text.data;
}

pub str asmSecName(AsmObject* o, i32 sec)
{
    if (sec == 1) return o->text.name;
    if (sec == 2) return o->data.name;
    if (sec == 3) return o->hot.name;
    if (sec == 4) return o->cold.name;
    if (sec >= 5) return o->xsecs.atPtr((usize)(sec - 5))->name;
    return "";
}

pub u64* asmSecAlignPtr(AsmObject* o, i32 sec)
{
    if (sec == 2) return &o->data.align;
    if (sec == 3) return &o->hot.align;
    if (sec == 4) return &o->cold.align;
    if (sec >= 5) return &o->xsecs.atPtr((usize)(sec - 5))->align;
    return &o->text.align;
}

// SHF_WRITE|SHF_ALLOC|SHF_EXECINSTR for a section index
pub u32 asmSecShf(AsmObject* o, i32 sec)
{
    if (sec >= 5) return o->xsecs.atPtr((usize)(sec - 5))->shf;
    if (sec == 2) return 3; // ALLOC|WRITE
    if (sec >= 1) return 6; // ALLOC|EXECINSTR
    return 0;
}

pub bool asmSecNobits(AsmObject* o, i32 sec)
{
    if (sec >= 5) return o->xsecs.atPtr((usize)(sec - 5))->nobits;
    return false;
}

// occupied size: data bytes for progbits, virtual size for nobits
pub u64 asmSecSize(AsmObject* o, i32 sec)
{
    if (sec >= 5)
    {
        AsmXSection* s = o->xsecs.atPtr((usize)(sec - 5));
        return s->nobits ? s->size : (u64)s->data.len;
    }
    return (u64)asmSecData(o, sec)->len;
}

// append n zero bytes (progbits) or grow the virtual size (nobits)
pub bool asmSecZero(AsmObject* o, i32 sec, u64 n)
{
    if (sec >= 5 && asmSecNobits(o, sec))
    {
        o->xsecs.atPtr((usize)(sec - 5))->size += n;
        return true;
    }
    AsmBytes* d = asmSecData(o, sec);
    for (u64 i = 0; i < n; i++)
    {
        if (!d->u8b(0)) return false;
    }
    return true;
}

pub void asmSecBumpAlign(AsmObject* o, i32 sec, u64 align)
{
    u64* a = asmSecAlignPtr(o, sec);
    if (align > *a) *a = align;
}

pub bool asmSecExec(AsmObject* o, i32 sec)
{
    return (asmSecShf(o, sec) & 4) != 0;
}

u64 asmNameHash(str s)
{
    u64 h = 1469598103934665603UL;
    for (usize i = 0; i < s.len; i++)
    {
        h ^= (u64)s.ptr[i];
        h *= 1099511628211UL;
    }
    return h;
}

// grow/rehash the name→index table so lookups stay O(1)
bool asmSymTabGrow(AsmObject* o)
{
    u32 cap = o->symTabMask == 0 ? 1024 : (o->symTabMask + 1) * 2;
    i32* tab = alloc<i32>((usize)cap);
    if (tab == null) return false;
    for (u32 i = 0; i < cap; i++) tab[i] = 0;
    u32 mask = cap - 1;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        u64 h = asmNameHash(o->syms[i].name) & (u64)mask;
        while (tab[h] != 0) h = (h + 1) & (u64)mask;
        tab[h] = (i32)(i + 1);
    }
    if (o->symTab != null) dealloc<i32>(o->symTab);
    o->symTab = tab;
    o->symTabMask = mask;
    return true;
}

// find a symbol by name, or -1
pub i32 asmFindSym(AsmObject* o, str name)
{
    if (o->symTab == null) return -1;
    u64 mask = (u64)o->symTabMask;
    u64 h = asmNameHash(name) & mask;
    while (o->symTab[h] != 0)
    {
        i32 si = o->symTab[h] - 1;
        if (o->syms[si].name.equals(name)) return si;
        h = (h + 1) & mask;
    }
    return -1;
}

// find or create (undefined, local) and return its index
pub i32 asmFindOrAddSym(AsmObject* o, str name)
{
    if (o->symTab == null || o->nsyms * 2 > o->symTabMask)
    {
        if (!asmSymTabGrow(o)) return -1;
    }
    i32 ex = asmFindSym(o, name);
    if (ex >= 0) return ex;
    if (o->nsyms >= o->symCap)
    {
        u32 ncap = o->symCap == 0 ? 256 : o->symCap * 2;
        AsmSymbol* ns = realloc<AsmSymbol>(o->syms, (usize)ncap);
        if (ns == null) return -1;
        o->syms = ns;
        o->symCap = ncap;
    }
    u32 i = o->nsyms;
    o->syms[i] = AsmSymbol {
        .name = name, .value = 0, .size = 0, .section = 0,
        .defined = false, .global = false, .weak = false,
        .isFunc = false, .isObject = false, .isView = false, .vis = 0
    };
    o->nsyms++;
    // insert into the name hash
    u64 mask = (u64)o->symTabMask;
    u64 h = asmNameHash(name) & mask;
    while (o->symTab[h] != 0) h = (h + 1) & mask;
    o->symTab[h] = (i32)(i + 1);
    return (i32)i;
}

pub bool asmAddReloc(AsmObject* o, u64 offset, str symbol, u8 kind, i64 addend, i32 section)
{
    // reference guarantees the name exists in the symbol table: without
    // this, a reloc to a not-yet-defined (or external) name dies at write
    // time as "relocation to unknown symbol"
    if (asmFindOrAddSym(o, symbol) < 0) return false;
    if (o->nrelocs >= o->relocCap)
    {
        u32 ncap = o->relocCap == 0 ? 256 : o->relocCap * 2;
        AsmReloc* nr = realloc<AsmReloc>(o->relocs, (usize)ncap);
        if (nr == null) return false;
        o->relocs = nr;
        o->relocCap = ncap;
    }
    u32 i = o->nrelocs;
    o->relocs[i] = AsmReloc {
        .offset = offset, .symbol = symbol, .kind = kind,
        .addend = addend, .section = section
    };
    o->nrelocs++;
    return true;
}

// ------------------------------------------------------------------
// ELF64 relocatable (ET_REL, x86-64). Layout:
//   ehdr | shdrs(8) | .text | .data | .rela.text | .rela.data |
//   .symtab | .strtab | .shstrtab
// ------------------------------------------------------------------

const u64 ELF_R_64 = 1;
const u64 ELF_R_PC32 = 2;
const u64 ELF_R_PLT32 = 4;
const u64 ELF_R_32 = 10;

u64 elfRelocType(AsmRelocKind kind)
{
    switch (kind)
    {
        AsmRelocKind::RelAbs64 => { return ELF_R_64; },
        AsmRelocKind::RelAbs32 => { return ELF_R_32; },
        AsmRelocKind::RelAbs16 => { return 12; },
        AsmRelocKind::RelPc32 => { return ELF_R_PC32; },
        AsmRelocKind::RelPlt32 => { return ELF_R_PLT32; },
        else => { return ELF_R_64; },
    }
}

bool shstrStr(AsmBytes* b, str s)
{
    for (usize i = 0; i < s.len; i++) { if (!b->u8b(s.ptr[i])) return false; }
    return b->u8b(0);
}

bool writePad(AsmBytes* out, u64 n)
{
    for (u64 i = 0; i < n; i++) { if (!out->u8b(0)) return false; }
    return true;
}

bool elfShdr(AsmBytes* out, u32 name, u32 type, u64 flags, u64 off,
                    u64 size, u32 link, u32 info, u64 align, u64 entsize)
{
    if (!out->u32b(name)) return false;
    if (!out->u32b(type)) return false;
    if (!out->u64b(flags)) return false;
    if (!out->u64b(0)) return false; // addr
    if (!out->u64b(off)) return false;
    if (!out->u64b(size)) return false;
    if (!out->u32b(link)) return false;
    if (!out->u32b(info)) return false;
    if (!out->u64b(align)) return false;
    if (!out->u64b(entsize)) return false;
    return true;
}

// open-addressing name→symbol-index map; tab[i] = sym index + 1, 0 = empty.
// Relocation emission does one lookup per reloc — a linear scan over the
// symbol table is quadratic on compiler-sized inputs.
struct AsmSymMap
{
    i32* tab;
    u32 mask;
}

AsmSymMap asmSymMapNew(AsmObject* o)
{
    u32 cap = 16;
    while (cap < o->nsyms * 2 + 2) cap <<= 1;
    i32* tab = alloc<i32>((usize)cap);
    AsmSymMap m;
    m.tab = tab;
    m.mask = cap - 1;
    if (tab == null) { m.mask = 0; return m; }
    for (u32 i = 0; i < cap; i++) tab[i] = 0;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        u64 h = asmNameHash(o->syms[i].name) & (u64)m.mask;
        while (tab[h] != 0)
        {
            h = (h + 1) & (u64)m.mask;
        }
        tab[h] = (i32)(i + 1);
    }
    return m;
}

i32 asmSymMapFind(AsmSymMap* m, AsmObject* o, str name)
{
    if (m->tab == null) return -1;
    u64 h = asmNameHash(name) & (u64)m->mask;
    while (m->tab[h] != 0)
    {
        i32 si = m->tab[h] - 1;
        if (o->syms[si].name.equals(name)) return si;
        h = (h + 1) & (u64)m->mask;
    }
    return -1;
}

// zero the in-place field each relocation points at (ELF .rela carries the
// addend in the rela entry, so the section bytes stay zero at those spots)
bool elfZeroRelocs(AsmBytes* buf, AsmObject* o, i32 sec)
{
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        if (r->section != sec) continue;
        AsmRelocKind ek = (AsmRelocKind)r->kind;
        u64 n = ek == AsmRelocKind::RelAbs64 ? 8 : (ek == AsmRelocKind::RelAbs16 ? 2 : 4);
        for (u64 k = 0; k < n; k++)
        {
            u64 at = r->offset + k;
            if (at >= (u64)buf->len) return false;
            buf->data[at] = 0;
        }
    }
    return true;
}

pub bool emitElf(AsmObject* o, AsmBytes* out, AsmParseError* err)
{
    // section-driven layout: shdr 0 null, 1..nsec assembler sections in
    // index order, then one .rela.<name> per section that has relocations,
    // then .symtab .strtab .shstrtab.
    u32 nx = (u32)o->xsecs.count();
    u32 nsec = 4 + nx;

    // per-section tables, indexed by assembler section number (1..nsec)
    str* secNm = alloc<str>((usize)nsec + 1);
    u32* secShf = alloc<u32>((usize)nsec + 1);
    u64* secAlign = alloc<u64>((usize)nsec + 1);
    u8* secType = alloc<u8>((usize)nsec + 1);
    u32* secRelaN = alloc<u32>((usize)nsec + 1);
    u32* shnName = alloc<u32>((usize)nsec + 1);
    u32* shnRela = alloc<u32>((usize)nsec + 1);
    u64* secOff = alloc<u64>((usize)nsec + 1);
    u64* relaOff = alloc<u64>((usize)nsec + 1);
    AsmBytes* bodies = alloc<AsmBytes>((usize)nsec + 1);
    AsmBytes* relas = alloc<AsmBytes>((usize)nsec + 1);
    if (secNm == null || secShf == null || secAlign == null || secType == null ||
        secRelaN == null || shnName == null || shnRela == null || secOff == null ||
        relaOff == null || bodies == null || relas == null) return false;
    for (u32 i = 0; i <= nsec; i++)
    {
        bodies[i] = AsmBytes::new();
        relas[i] = AsmBytes::new();
        secRelaN[i] = 0;
        shnName[i] = 0;
        shnRela[i] = 0;
        secOff[i] = 0;
        relaOff[i] = 0;
    }
    for (u32 i = 1; i <= nsec; i++)
    {
        secNm[i] = asmSecName(o, (i32)i);
        secShf[i] = asmSecShf(o, (i32)i);
        secAlign[i] = 0;
        u64* ap = asmSecAlignPtr(o, (i32)i);
        if (ap != null) secAlign[i] = *ap;
        if (asmSecNobits(o, (i32)i)) secType[i] = 8;
        else if (secNm[i].startsWith(".note")) secType[i] = 7;
        else secType[i] = 1;
    }

    // reloc counts per section
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        i32 s = o->relocs[i].section;
        if (s >= 1 && s <= (i32)nsec) secRelaN[s]++;
        else { err->msg = "relocation in unknown section"; return false; }
    }
    u32 nrela = 0;
    for (u32 i = 1; i <= nsec; i++) if (secRelaN[i] > 0) nrela++;

    // symtab order: null, locals, then globals + weak + undefined.
    // map: symbol index -> symtab index (for rela entries).
    u32 symN = o->nsyms > 0 ? o->nsyms : 1;
    i32* map = alloc<i32>((usize)symN);
    u32* nameOff = alloc<u32>((usize)symN);
    u32* order = alloc<u32>((usize)symN + 1);
    if (map == null || nameOff == null || order == null) return false;
    for (u32 i = 0; i < o->nsyms; i++) map[i] = -1;
    u32 emitted = 0;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (!o->syms[i].global && !o->syms[i].weak && o->syms[i].defined &&
            !o->syms[i].isView) { map[i] = (i32)(++emitted); }
    }
    u32 firstGlobal = emitted + 1;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || s->weak || !s->defined) { map[i] = (i32)(++emitted); }
    }
    u32 nsymsTotal = emitted + 1;

    // name -> symbol lookup for reloc targets (hash, not linear)
    AsmSymMap smap = asmSymMapNew(o);

    // strtab name offsets in emission order
    AsmBytes strtab = AsmBytes::new();
    AsmBytes shstr = AsmBytes::new();
    if (!strtab.u8b(0) || !shstr.u8b(0)) return false;
    order[0] = 0xFFFFFFFF;
    u32 oi = 1;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (!o->syms[i].global && !o->syms[i].weak && o->syms[i].defined &&
            !o->syms[i].isView) { order[oi++] = i; }
    }
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || s->weak || !s->defined) { order[oi++] = i; }
    }
    for (u32 si = 1; si < nsymsTotal; si++)
    {
        AsmSymbol* s = &o->syms[order[si]];
        nameOff[order[si]] = strtab.len;
        for (usize k = 0; k < s->name.len; k++) { if (!strtab.u8b(s->name.ptr[k])) return false; }
        if (!strtab.u8b(0)) return false;
    }

    // shstrtab: section names, then .rela.<name> for sections with relocs,
    // then the three fixed tail names
    for (u32 i = 1; i <= nsec; i++)
    {
        shnName[i] = shstr.len;
        for (usize k = 0; k < secNm[i].len; k++) { if (!shstr.u8b(secNm[i].ptr[k])) return false; }
        if (!shstr.u8b(0)) return false;
        if (secRelaN[i] > 0)
        {
            shnRela[i] = shstr.len;
            // ".rela" + name — the section name already carries its dot
            if (!shstr.u8b((u8)'.') || !shstr.u8b((u8)'r') || !shstr.u8b((u8)'e') ||
                !shstr.u8b((u8)'l') || !shstr.u8b((u8)'a')) return false;
            for (usize k = 0; k < secNm[i].len; k++) { if (!shstr.u8b(secNm[i].ptr[k])) return false; }
            if (!shstr.u8b(0)) return false;
        }
    }
    u32 shnSym = shstr.len; if (!shstrStr(&shstr, ".symtab")) return false;
    u32 shnStr = shstr.len; if (!shstrStr(&shstr, ".strtab")) return false;
    u32 shnShstr = shstr.len; if (!shstrStr(&shstr, ".shstrtab")) return false;

    u32 shSym = 1 + nsec + nrela;
    u32 shStr = shSym + 1;
    u32 shShstr = shStr + 1;
    u32 SHNUM = shShstr + 1;

    // section bodies: copy bytes, zero relocation fields
    for (u32 i = 1; i <= nsec; i++)
    {
        if (secType[i] == 8) continue; // nobits: no file data
        AsmBytes* dst = &bodies[i];
        AsmBytes* src = asmSecData(o, (i32)i);
        for (u32 k = 0; k < src->len; k++) { if (!dst->u8b(src->data[k])) return false; }
        if (!elfZeroRelocs(dst, o, (i32)i))
        {
            err->msg = "reloc offset past end of section";
            return false;
        }
    }
    // nobits sections must not carry relocations (no bytes to patch)
    for (u32 i = 1; i <= nsec; i++)
    {
        if (secType[i] != 8 || secRelaN[i] == 0) continue;
        err->msg = "relocation in nobits section";
        return false;
    }

    // rela bodies, grouped by section in original reloc order
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        i32 s = r->section;
        if (s < 1 || s > (i32)nsec) { err->msg = "relocation in unknown section"; return false; }
        i32 si = asmSymMapFind(&smap, o, r->symbol);
        i32 symIdx = si >= 0 ? map[si] : -1;
        if (symIdx < 0) { err->msg = "relocation to unknown symbol"; return false; }
        AsmBytes* dst = &relas[s];
        if (!dst->u64b(r->offset)) return false;
        if (!dst->u64b(((u64)symIdx << 32) | elfRelocType((AsmRelocKind)r->kind))) return false;
        if (!dst->u64b((u64)r->addend)) return false;
    }

    // layout: ehdr + shdrs, then section bodies, rela bodies, symtab,
    // strtab, shstrtab — each aligned to its sh_addralign
    u64 off = 64 + (u64)SHNUM * 64;
    for (u32 i = 1; i <= nsec; i++)
    {
        u64 a = secAlign[i];
        if (a == 0) a = 1;
        off = (off + a - 1) & ~(a - 1);
        secOff[i] = off;
        if (secType[i] != 8) off += (u64)bodies[i].len;
    }
    {
        u32 ri = 0;
        for (u32 i = 1; i <= nsec; i++)
        {
            if (secRelaN[i] == 0) continue;
            ri++;
            off = (off + 7) & ~(u64)7;
            relaOff[i] = off;
            off += (u64)relas[i].len;
        }
    }
    off = (off + 7) & ~(u64)7;
    u64 offSym = off; off += (u64)nsymsTotal * 24;
    u64 offStr = off; off += (u64)strtab.len;
    u64 offShstr = off; off += (u64)shstr.len;

    // e_ident + header
    if (!out->u8b(0x7F) || !out->u8b((u8)'E') || !out->u8b((u8)'L') || !out->u8b((u8)'F')) return false;
    if (!out->u8b(2) || !out->u8b(1) || !out->u8b(1) || !out->u8b(0)) return false;
    for (u32 i = 0; i < 8; i++) { if (!out->u8b(0)) return false; }
    if (!out->u16b(1)) return false;
    if (!out->u16b(62)) return false;
    if (!out->u32b(1)) return false;
    if (!out->u64b(0)) return false;
    if (!out->u64b(0)) return false;
    if (!out->u64b(64)) return false;
    if (!out->u32b(0)) return false;
    if (!out->u16b(64)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(64)) return false;
    if (!out->u16b((u16)SHNUM)) return false;
    if (!out->u16b((u16)shShstr)) return false;

    // section headers
    for (u32 i = 0; i < 64; i++) { if (!out->u8b(0)) return false; }
    for (u32 i = 1; i <= nsec; i++)
    {
        u64 sz = secType[i] == 8 ? asmSecSize(o, (i32)i) : (u64)bodies[i].len;
        if (!elfShdr(out, shnName[i], (u32)secType[i], (u64)secShf[i], secOff[i], sz, 0, 0,
                     secAlign[i] == 0 ? 1 : secAlign[i], 0)) return false;
    }
    {
        u32 ri = 0;
        for (u32 i = 1; i <= nsec; i++)
        {
            if (secRelaN[i] == 0) continue;
            ri++;
            if (!elfShdr(out, shnRela[i], 4, 0, relaOff[i], (u64)relas[i].len,
                         shSym, i, 8, 24)) return false;
        }
    }
    if (!elfShdr(out, shnSym, 2, 0, offSym, (u64)nsymsTotal * 24, shStr, firstGlobal, 8, 24)) return false;
    if (!elfShdr(out, shnStr, 3, 0, offStr, (u64)strtab.len, 0, 0, 1, 0)) return false;
    if (!elfShdr(out, shnShstr, 3, 0, offShstr, (u64)shstr.len, 0, 0, 1, 0)) return false;

    // bodies
    for (u32 i = 1; i <= nsec; i++)
    {
        if (secType[i] == 8) continue;
        if (!writePad(out, secOff[i] - (u64)out->len)) return false;
        for (u32 k = 0; k < bodies[i].len; k++) { if (!out->u8b(bodies[i].data[k])) return false; }
    }
    {
        u32 ri = 0;
        for (u32 i = 1; i <= nsec; i++)
        {
            if (secRelaN[i] == 0) continue;
            ri++;
            if (!writePad(out, relaOff[i] - (u64)out->len)) return false;
            for (u32 k = 0; k < relas[i].len; k++) { if (!out->u8b(relas[i].data[k])) return false; }
        }
    }
    if (!writePad(out, offSym - (u64)out->len)) return false;

    // symtab entries in emission order
    if (!out->u32b(0) || !out->u8b(0) || !out->u8b(0) || !out->u16b(0) ||
        !out->u64b(0) || !out->u64b(0)) return false;
    for (u32 si = 1; si < nsymsTotal; si++)
    {
        AsmSymbol* s = &o->syms[order[si]];
        u8 bind = s->weak ? 2 : ((s->global || !s->defined) ? 1 : 0);
        u8 typ = s->isFunc ? 2 : (s->isObject ? 1 : 0);
        u16 shndx = 0;
        if (s->defined) shndx = (u16)s->section;
        if (!out->u32b(nameOff[order[si]])) return false;
        if (!out->u8b((u8)((bind << 4) | typ))) return false;
        if (!out->u8b(s->vis)) return false;
        if (!out->u16b(shndx)) return false;
        if (!out->u64b(s->defined ? s->value : 0)) return false;
        if (!out->u64b(s->size)) return false;
    }
    for (u32 i = 0; i < strtab.len; i++) { if (!out->u8b(strtab.data[i])) return false; }
    for (u32 i = 0; i < shstr.len; i++) { if (!out->u8b(shstr.data[i])) return false; }

    for (u32 i = 0; i <= nsec; i++)
    {
        bodies[i].deinit();
        relas[i].deinit();
    }
    dealloc<AsmBytes>(bodies);
    dealloc<AsmBytes>(relas);
    dealloc<str>(secNm);
    dealloc<u32>(secShf);
    dealloc<u64>(secAlign);
    dealloc<u8>(secType);
    dealloc<u32>(secRelaN);
    dealloc<u32>(shnName);
    dealloc<u32>(shnRela);
    dealloc<u64>(secOff);
    dealloc<u64>(relaOff);
    dealloc<i32>(map);
    dealloc<u32>(nameOff);
    dealloc<u32>(order);
    dealloc<i32>(smap.tab);
    strtab.deinit();
    shstr.deinit();
    return true;

}

pub bool emitCoff(AsmObject* o, AsmBytes* out, AsmParseError* err)
{
    // Section-driven COFF. Emit order keeps the historical layout for the
    // fixed slots — .text, .text$hot, .text$cold, .data — then every extra
    // assembler section in index order. coff scnum of assembler section s:
    //   1→1, 3→2, 4→3, 2→4, s≥5→s
    u32 nx = (u32)o->xsecs.count();
    u32 nsec = 4 + nx;          // assembler section count
    u32 ncoff = nsec;           // one COFF section header per assembler section

    // emit order: assembler indices 1,3,4,2 then 5..nsec
    u32* ord = alloc<u32>((usize)ncoff);
    u32* scnumOf = alloc<u32>((usize)nsec + 1);  // assembler sec -> coff scnum
    u32* nrel = alloc<u32>((usize)nsec + 1);
    u32* rawOff = alloc<u32>((usize)nsec + 1);
    u32* reloOff = alloc<u32>((usize)nsec + 1);
    u32* nameOffS = alloc<u32>((usize)nsec + 1);
    if (ord == null || scnumOf == null || nrel == null || rawOff == null ||
        reloOff == null || nameOffS == null) return false;
    u32 oi = 0;
    ord[oi++] = 1; ord[oi++] = 3; ord[oi++] = 4; ord[oi++] = 2;
    for (u32 s = 5; s <= nsec; s++) ord[oi++] = s;
    scnumOf[1] = 1; scnumOf[3] = 2; scnumOf[4] = 3; scnumOf[2] = 4;
    for (u32 s = 5; s <= nsec; s++) scnumOf[s] = s;
    for (u32 i = 0; i <= nsec; i++) { nrel[i] = 0; rawOff[i] = 0; reloOff[i] = 0; nameOffS[i] = 0; }
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        i32 s = o->relocs[i].section;
        if (s >= 1 && s <= (i32)nsec) nrel[s]++;
        else { err->msg = "relocation in unknown section"; return false; }
    }

    // symbol table order: locals first, then externals; name → index map
    u32 symN = o->nsyms > 0 ? o->nsyms : 1;
    i32* map = alloc<i32>((usize)symN);
    u32* order = alloc<u32>((usize)symN);
    u32* nameOff = alloc<u32>((usize)symN);
    if (map == null || order == null || nameOff == null) return false;
    u32 nOrder = 0;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (o->syms[i].defined && !o->syms[i].global) { map[i] = (i32)nOrder; order[nOrder++] = i; }
    }
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || !s->defined) { map[i] = (i32)nOrder; order[nOrder++] = i; }
    }
    AsmSymMap smap = asmSymMapNew(o);

    // string table: 4-byte size, symbol names >8, then section names >8
    AsmBytes strtab = AsmBytes::new();
    if (!strtab.u32b(0)) return false;
    for (u32 i = 0; i < nOrder; i++)
    {
        AsmSymbol* s = &o->syms[order[i]];
        if (s->name.len > 8)
        {
            nameOff[order[i]] = strtab.len;
            for (usize k = 0; k < s->name.len; k++) { if (!strtab.u8b(s->name.ptr[k])) return false; }
            if (!strtab.u8b(0)) return false;
        }
    }
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        str nm = coffSecName(o, (i32)s);
        if (nm.len > 8)
        {
            nameOffS[s] = strtab.len;
            for (usize k = 0; k < nm.len; k++) { if (!strtab.u8b(nm.ptr[k])) return false; }
            if (!strtab.u8b(0)) return false;
        }
    }
    for (u32 i = 0; i < 4; i++) strtab.data[i] = (u8)((strtab.len >> (8 * i)) & 0xFF);

    // layout: header + section headers, raw data (progbits only), then
    // per-section reloc blocks in emit order, then the symbol table
    u32 secHdrOff = 20;
    u32 rawPtr = secHdrOff + ncoff * 40;
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        if (asmSecNobits(o, (i32)s)) continue;
        rawOff[s] = rawPtr;
        rawPtr += (u32)asmSecSize(o, (i32)s);
    }
    u32 reloPtr = rawPtr;
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        if (nrel[s] == 0) continue;
        reloOff[s] = reloPtr;
        reloPtr += nrel[s] * 10;
    }
    u32 symOff = reloPtr;

    // file header
    if (!out->u16b(0x8664)) return false;
    if (!out->u16b((u16)ncoff)) return false;
    if (!out->u32b(0)) return false;
    if (!out->u32b(symOff)) return false;
    if (!out->u32b(nOrder)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(0)) return false;

    // section headers in emit order
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        str nm = coffSecName(o, (i32)s);
        u32 shf = asmSecShf(o, (i32)s);
        u32 cflags;
        if (shf == 0)
        {
            // non-alloc metadata (.debug_*, .comment): initialized data,
            // readable, discardable
            cflags = 0xE2000040;
        }
        else if ((shf & 4) != 0)
        {
            cflags = 0x60000020; // CODE | EXECUTE | READ
        }
        else if (asmSecNobits(o, (i32)s))
        {
            cflags = 0xC0000080; // UNINIT_DATA | READ | WRITE
        }
        else
        {
            cflags = 0xC0000040; // INIT_DATA | READ | WRITE
        }
        u64 al = 0;
        u64* ap = asmSecAlignPtr(o, (i32)s);
        if (ap != null) al = *ap;
        cflags |= coffAlignBits(al) << 20;
        u32 vsize = 0;
        u32 rawSize = 0;
        u32 rawPtrS = 0;
        if (asmSecNobits(o, (i32)s))
        {
            vsize = (u32)asmSecSize(o, (i32)s);
        }
        else
        {
            rawSize = (u32)asmSecSize(o, (i32)s);
            rawPtrS = rawOff[s];
        }
        if (!coffSecHdr2(out, nm, nameOffS[s], vsize, rawSize, rawPtrS,
                         reloOff[s], nrel[s], cflags)) return false;
    }

    // raw section data in emit order; REL32 addends get +4 back (the
    // encoder stored ELF-style displacement, COFF wants the field value)
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        if (asmSecNobits(o, (i32)s)) continue;
        AsmBytes* src = asmSecData(o, (i32)s);
        u64 n = (u64)src->len;
        u8* copy = alloc<u8>((usize)(n > 0 ? n : 1));
        if (copy == null) return false;
        for (u64 k = 0; k < n; k++) copy[k] = src->data[k];
        for (u32 i = 0; i < o->nrelocs; i++)
        {
            AsmReloc* r = &o->relocs[i];
            if ((u32)r->section != s) continue;
            AsmRelocKind k = (AsmRelocKind)r->kind;
            if (k != AsmRelocKind::RelPc32 && k != AsmRelocKind::RelPlt32) continue;
            if (r->offset + 4 > n) continue;
            usize q = (usize)r->offset;
            u32 v = (u32)copy[q] | ((u32)copy[q + 1] << 8) |
                    ((u32)copy[q + 2] << 16) | ((u32)copy[q + 3] << 24);
            v += 4;
            copy[q] = (u8)(v & 0xff);
            copy[q + 1] = (u8)((v >> 8) & 0xff);
            copy[q + 2] = (u8)((v >> 16) & 0xff);
            copy[q + 3] = (u8)((v >> 24) & 0xff);
        }
        for (u64 k = 0; k < n; k++) { if (!out->u8b(copy[k])) { dealloc<u8>(copy); return false; } }
        dealloc<u8>(copy);
    }

    // relocations grouped per section in emit order
    for (u32 j = 0; j < ncoff; j++)
    {
        u32 s = ord[j];
        for (u32 i = 0; i < o->nrelocs; i++)
        {
            AsmReloc* r = &o->relocs[i];
            if ((u32)r->section == s) { if (!coffReloc2(out, r, map, &smap, o)) return false; }
        }
    }

    // symbols
    for (u32 i = 0; i < nOrder; i++)
    {
        AsmSymbol* s = &o->syms[order[i]];
        if (s->name.len > 8)
        {
            if (!out->u32b(0) || !out->u32b(nameOff[order[i]])) return false;
        }
        else
        {
            if (!coffName8(out, s->name)) return false;
        }
        u32 value = s->defined ? (u32)s->value : 0;
        i16 secnum = 0;
        if (s->defined && s->section >= 1 && s->section <= (i32)nsec)
            secnum = (i16)scnumOf[s->section];
        u16 typ = s->isFunc ? 0x20 : 0;
        u8 cls = (s->global || s->weak || !s->defined) ? 2 : 3;
        if (!out->u32b(value)) return false;
        if (!out->u16b((u16)secnum)) return false;
        if (!out->u16b(typ)) return false;
        if (!out->u8b(cls)) return false;
        if (!out->u8b(0)) return false;
    }
    for (u32 i = 0; i < strtab.len; i++) { if (!out->u8b(strtab.data[i])) return false; }
    strtab.deinit();
    dealloc<u32>(ord);
    dealloc<u32>(scnumOf);
    dealloc<u32>(nrel);
    dealloc<u32>(rawOff);
    dealloc<u32>(reloOff);
    dealloc<u32>(nameOffS);
    dealloc<i32>(map);
    dealloc<u32>(order);
    dealloc<u32>(nameOff);
    dealloc<i32>(smap.tab);
    return true;
}

// ------------------------------------------------------------------
// COFF helpers
// ------------------------------------------------------------------

const u16 COFF_REL_ADDR64 = 1;
const u16 COFF_REL_ADDR32 = 2;
const u16 COFF_REL_REL32 = 4;

u16 coffRelocType(AsmRelocKind kind)
{
    switch (kind)
    {
        AsmRelocKind::RelAbs64 => { return COFF_REL_ADDR64; },
        AsmRelocKind::RelAbs32 => { return COFF_REL_ADDR32; },
        AsmRelocKind::RelAbs16 => { return COFF_REL_ADDR32; },
        AsmRelocKind::RelPc32 => { return COFF_REL_REL32; },
        AsmRelocKind::RelPlt32 => { return COFF_REL_REL32; },
        else => { return COFF_REL_REL32; },
    }
}

bool coffName8(AsmBytes* out, str name)
{
    u32 n = name.len > 8 ? 8 : (u32)name.len;
    for (u32 i = 0; i < n; i++) { if (!out->u8b(name.ptr[i])) return false; }
    for (u32 i = n; i < 8; i++) { if (!out->u8b(0)) return false; }
    return true;
}

bool coffStr(AsmBytes* strtab, str s)
{
    for (usize i = 0; i < s.len; i++) { if (!strtab->u8b(s.ptr[i])) return false; }
    return strtab->u8b(0);
}

// COFF section alignment is encoded as log2(align)+1 in bits 20-23
u32 coffAlignBits(u64 align)
{
    u32 n = 1;
    u64 a = 1;
    while (a < align && n < 14)
    {
        a <<= 1;
        n++;
    }
    return n;
}

// COFF display name for an assembler section: the fixed hot/cold slots use
// the $-suffix convention, everything else keeps its assembler name.
str coffSecName(AsmObject* o, i32 sec)
{
    if (sec == 3) return ".text$hot";
    if (sec == 4) return ".text$cold";
    return asmSecName(o, sec);
}

bool coffSecHdr2(AsmBytes* out, str name, u32 nameOff, u32 vsize, u32 size,
                 u32 rawData, u32 relOff, u32 nrel, u32 flags)
{
    if (name.len > 8)
    {
        u8[8] buf;
        for (u32 i = 0; i < 8; i++) buf[i] = 0;
        buf[0] = (u8)'/';
        u32 v = nameOff;
        u32 n = 0;
        u8[8] digits;
        if (v == 0) { digits[n++] = (u8)'0'; }
        else { while (v != 0) { digits[n++] = (u8)('0' + (v % 10)); v /= 10; } }
        u32 k = 1;
        while (n > 0 && k < 8) { n--; buf[k++] = digits[n]; }
        for (u32 i = 0; i < 8; i++) { if (!out->u8b(buf[i])) return false; }
    }
    else if (!coffName8(out, name)) return false;
    if (!out->u32b(vsize)) return false;
    if (!out->u32b(0)) return false; // virtual address
    if (!out->u32b(size)) return false;
    if (!out->u32b(rawData)) return false;
    if (!out->u32b(nrel > 0 ? relOff : 0)) return false;
    if (!out->u32b(0)) return false; // line numbers
    if (!out->u16b((u16)nrel)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u32b(flags)) return false;
    return true;
}

bool coffReloc2(AsmBytes* out, AsmReloc* r, i32* map, AsmSymMap* smap, AsmObject* o)
{
    i32 si = asmSymMapFind(smap, o, r->symbol);
    i32 symIdx = si >= 0 ? map[si] : -1;
    if (symIdx < 0) return false;
    if (!out->u32b((u32)r->offset)) return false;
    if (!out->u32b((u32)symIdx)) return false;
    if (!out->u16b(coffRelocType((AsmRelocKind)r->kind))) return false;
    return true;
}

// ------------------------------------------------------------------
// Flat raw: text bytes only, every relocation applied against `base`.
// Anything still undefined is an error — raw leaves nothing for a linker->
// ------------------------------------------------------------------

pub bool emitRaw(AsmObject* o, u64 base, AsmBytes* out, AsmParseError* err)
{
    for (u32 i = 0; i < o->text.data.len; i++) { if (!out->u8b(o->text.data.data[i])) return false; }
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        if (r->section != 1) continue;
        i32 si = asmFindSym(o, r->symbol);
        if (si < 0 || !o->syms[si].defined)
        {
            err->msg = "raw output needs every symbol defined";
            return false;
        }
        u64 sval = o->syms[si].value + base;
        u64 place = base + r->offset;
        if ((AsmRelocKind)r->kind == AsmRelocKind::RelAbs64)
        {
            u64 v = sval + (u64)r->addend;
            if (r->offset + 8 > (u64)out->len) return false;
            for (u32 k = 0; k < 8; k++) out->data[(u32)r->offset + k] = (u8)((v >> (u64)(8 * k)) & 0xFF);
        }
        else if ((AsmRelocKind)r->kind == AsmRelocKind::RelAbs16)
        {
            i64 v = (i64)sval + r->addend;
            if (v < 0 || v > 65535)
            {
                err->msg = "raw reloc does not fit abs16";
                return false;
            }
            if (r->offset + 2 > (u64)out->len) return false;
            u32 u = (u32)v;
            for (u32 k = 0; k < 2; k++) out->data[(u32)r->offset + k] = (u8)((u >> (8 * k)) & 0xFF);
        }
        else if ((AsmRelocKind)r->kind == AsmRelocKind::RelAbs32)
        {
            i64 v = (i64)sval + r->addend;
            if (v < -2147483648 || v > 2147483647)
            {
                err->msg = "raw reloc does not fit abs32";
                return false;
            }
            if (r->offset + 4 > (u64)out->len) return false;
            u32 u = (u32)v;
            for (u32 k = 0; k < 4; k++) out->data[(u32)r->offset + k] = (u8)((u >> (8 * k)) & 0xFF);
        }
        else
        {
            i64 v = (i64)sval + r->addend - (i64)place;
            if (v < -2147483648 || v > 2147483647)
            {
                err->msg = "raw reloc does not fit rel32";
                return false;
            }
            if (r->offset + 4 > (u64)out->len) return false;
            u32 u = (u32)v;
            for (u32 k = 0; k < 4; k++) out->data[(u32)r->offset + k] = (u8)((u >> (8 * k)) & 0xFF);
        }
    }
    return true;
}

pub AsmLebCtx* asmLebCtxNew()
{
    AsmLebCtx* c = alloc<AsmLebCtx>(1);
    if (c == null) return null;
    c->keys = null;
    c->nkeys = 0;
    c->kcap = 0;
    c->pend = null;
    c->npend = 0;
    c->pcap = 0;
    return c;
}

pub void asmLebCtxDeinit(AsmLebCtx* c)
{
    if (c == null) return;
    if (c->keys != null) dealloc<AsmLebKey>(c->keys);
    if (c->pend != null) dealloc<AsmLebPend>(c->pend);
    dealloc<AsmLebCtx>(c);
}

pub void asmLebCtxReset(AsmLebCtx* c)
{
    c->npend = 0;
}

pub bool asmLebAddPend(AsmLebCtx* c, u64 key, i32 sec, u64 off, u8 kind, i32 a, i32 b, i64 addend)
{
    if (c->npend == c->pcap)
    {
        u32 nc = c->pcap == 0 ? 256 : c->pcap * 2;
        AsmLebPend* nd = alloc<AsmLebPend>((usize)nc);
        if (nd == null) return false;
        for (u32 i = 0; i < c->npend; i++) nd[i] = c->pend[i];
        if (c->pend != null) dealloc<AsmLebPend>(c->pend);
        c->pend = nd;
        c->pcap = nc;
    }
    AsmLebPend* p = &c->pend[c->npend];
    p->key = key;
    p->sec = sec;
    p->off = off;
    p->kind = kind;
    p->a = a;
    p->b = b;
    p->addend = addend;
    c->npend++;
    return true;
}

// binary search over keys sorted by key; returns index or -1
pub i32 asmLebFindKey(AsmLebCtx* c, u64 key)
{
    u32 lo = 0;
    u32 hi = c->nkeys;
    while (lo < hi)
    {
        u32 mid = (lo + hi) / 2;
        if (c->keys[mid].key < key) lo = mid + 1;
        else hi = mid;
    }
    if (lo < c->nkeys && c->keys[lo].key == key) return (i32)lo;
    return -1;
}

pub bool asmLebSetKey(AsmLebCtx* c, u64 key, str a, str b, i64 addend, i64 value, u8 kind)
{
    // keys are inserted in ascending order (pend list is ordered); find slot
    i32 pos = asmLebFindKey(c, key);
    if (pos >= 0)
    {
        c->keys[pos].value = value;
        return true;
    }
    if (c->nkeys == c->kcap)
    {
        u32 nc = c->kcap == 0 ? 256 : c->kcap * 2;
        AsmLebKey* nd = alloc<AsmLebKey>((usize)nc);
        if (nd == null) return false;
        for (u32 i = 0; i < c->nkeys; i++) nd[i] = c->keys[i];
        if (c->keys != null) dealloc<AsmLebKey>(c->keys);
        c->keys = nd;
        c->kcap = nc;
    }
    // binary search insertion point
    u32 lo = 0;
    u32 hi = c->nkeys;
    while (lo < hi)
    {
        u32 mid = (lo + hi) / 2;
        if (c->keys[mid].key < key) lo = mid + 1;
        else hi = mid;
    }
    for (u32 i = c->nkeys; i > lo; i--) c->keys[i] = c->keys[i - 1];
    AsmLebKey* k = &c->keys[lo];
    k->key = key;
    k->a = a;
    k->b = b;
    k->addend = addend;
    k->value = value;
    k->kind = kind;
    c->nkeys++;
    return true;
}
