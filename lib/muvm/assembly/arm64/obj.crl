#[[no_drop_all]]
// AArch64 object model + writers. The section/symbol/reloc model is the
// shared AsmObject from assembly::x86::obj — only the relocation kind
// numbering and the three output sinks (ELF64 EM_AARCH64, PE/COFF
// IMAGE_FILE_MACHINE_ARM64, Mach-O arm64) are arch-specific here.
import muvm::assembly::x86::obj {
    AsmObject, AsmSymbol, AsmReloc, AsmSection, AsmBytes,
    asmFindSym, asmFindOrAddSym, asmAddReloc, asmObjectNew, asmObjectDeinit,
    ASM_MAX_SYMS, ASM_MAX_ORDER, ASM_MAX_RELOCS
};
import muvm::assembly::common { AsmParseError };
import std::mman { alloc, dealloc };

// relocation kinds — u8 tags stored in AsmReloc.kind, mapped to
// ELF/COFF/Mach-O codes by the writers below
pub enum Arm64RelocKind
{
    A64_None = 0,
    A64_Abs64,      // .quad sym          → R_AARCH64_ABS64 (257)
    A64_Abs32,      // .long/.word sym   → R_AARCH64_ABS32 (258)
    A64_Prel32,     // .long sym-.       → R_AARCH64_PREL32 (261)
    A64_LdPrel19,   // ldr literal       → R_AARCH64_LD_PREL_LO19 (273)
    A64_AdrLo21,    // adr               → R_AARCH64_ADR_PREL_LO21 (274)
    A64_AdrHi21,    // adrp              → R_AARCH64_ADR_PREL_PG_HI21 (275)
    A64_AddLo12,    // add/sub #:lo12:   → R_AARCH64_ADD_ABS_LO12_NC (277)
    A64_Ldst8Lo12,  // ldrb/strb #:lo12: → 278
    A64_TstBr14,    // tbz/tbnz          → R_AARCH64_TSTBR14 (279)
    A64_CondBr19,   // b.cond/cbz/cbnz   → R_AARCH64_CONDBR19 (280)
    A64_Jump26,     // b                 → R_AARCH64_JUMP26 (282)
    A64_Call26,     // bl                → R_AARCH64_CALL26 (283)
    A64_Ldst16Lo12, // ldrh/strh         → 284
    A64_Ldst32Lo12, // ldr/str w         → 285
    A64_Ldst64Lo12, // ldr/str x         → 286
    A64_Ldst128Lo12,// ldr/str q         → 299
    A64_MovwG0,     // movz/movn/movk    → R_AARCH64_MOVW_UABS_G0 (263)
    A64_MovwG1,     //                    → 265
    A64_MovwG2,     //                    → 267
    A64_MovwG3      //                    → 269
}

// ELF64 relocatable (ET_REL, EM_AARCH64 = 183). Same section layout as
// the x86 writer: ehdr | shdrs(8) | .text | .data | .rela.* | .symtab |
// .strtab | .shstrtab — but hot/cold stay inside .text for arm64 since
// AArch64 has no COFF-style $hot split; the model still carries the
// sections so a later pass could split them.

const u64 A64_ELF_ABS64 = 257;
const u64 A64_ELF_ABS32 = 258;
const u64 A64_ELF_PREL32 = 261;
const u64 A64_ELF_LD_PREL19 = 273;
const u64 A64_ELF_ADR_LO21 = 274;
const u64 A64_ELF_ADR_HI21 = 275;
const u64 A64_ELF_ADD_LO12 = 277;
const u64 A64_ELF_LDST8 = 278;
const u64 A64_ELF_TSTBR14 = 279;
const u64 A64_ELF_CONDBR19 = 280;
const u64 A64_ELF_JUMP26 = 282;
const u64 A64_ELF_CALL26 = 283;
const u64 A64_ELF_LDST16 = 284;
const u64 A64_ELF_LDST32 = 285;
const u64 A64_ELF_LDST64 = 286;
const u64 A64_ELF_LDST128 = 299;
const u64 A64_ELF_MOVW_G0 = 263;
const u64 A64_ELF_MOVW_G1 = 265;
const u64 A64_ELF_MOVW_G2 = 267;
const u64 A64_ELF_MOVW_G3 = 269;

u64 a64ElfRelocType(u8 kind)
{
    switch ((Arm64RelocKind)kind)
    {
        Arm64RelocKind::A64_Abs64 => { return A64_ELF_ABS64; },
        Arm64RelocKind::A64_Abs32 => { return A64_ELF_ABS32; },
        Arm64RelocKind::A64_Prel32 => { return A64_ELF_PREL32; },
        Arm64RelocKind::A64_LdPrel19 => { return A64_ELF_LD_PREL19; },
        Arm64RelocKind::A64_AdrLo21 => { return A64_ELF_ADR_LO21; },
        Arm64RelocKind::A64_AdrHi21 => { return A64_ELF_ADR_HI21; },
        Arm64RelocKind::A64_AddLo12 => { return A64_ELF_ADD_LO12; },
        Arm64RelocKind::A64_Ldst8Lo12 => { return A64_ELF_LDST8; },
        Arm64RelocKind::A64_TstBr14 => { return A64_ELF_TSTBR14; },
        Arm64RelocKind::A64_CondBr19 => { return A64_ELF_CONDBR19; },
        Arm64RelocKind::A64_Jump26 => { return A64_ELF_JUMP26; },
        Arm64RelocKind::A64_Call26 => { return A64_ELF_CALL26; },
        Arm64RelocKind::A64_Ldst16Lo12 => { return A64_ELF_LDST16; },
        Arm64RelocKind::A64_Ldst32Lo12 => { return A64_ELF_LDST32; },
        Arm64RelocKind::A64_Ldst64Lo12 => { return A64_ELF_LDST64; },
        Arm64RelocKind::A64_Ldst128Lo12 => { return A64_ELF_LDST128; },
        Arm64RelocKind::A64_MovwG0 => { return A64_ELF_MOVW_G0; },
        Arm64RelocKind::A64_MovwG1 => { return A64_ELF_MOVW_G1; },
        Arm64RelocKind::A64_MovwG2 => { return A64_ELF_MOVW_G2; },
        Arm64RelocKind::A64_MovwG3 => { return A64_ELF_MOVW_G3; },
        else => { return A64_ELF_ABS64; },
    }
}

// ------------------------------------------------------------------
// shared little helpers (mirror of the x86 obj writer's)
// ------------------------------------------------------------------

bool a64ShstrStr(AsmBytes* b, str s)
{
    for (usize i = 0; i < s.len; i++) { if (!b->u8b(s.ptr[i])) return false; }
    return b->u8b(0);
}

bool a64WritePad(AsmBytes* out, u64 n)
{
    for (u64 i = 0; i < n; i++) { if (!out->u8b(0)) return false; }
    return true;
}

bool a64ElfShdr(AsmBytes* out, u32 name, u32 type, u64 flags, u64 off,
                u64 size, u32 link, u32 info, u64 align, u64 entsize)
{
    if (!out->u32b(name)) return false;
    if (!out->u32b(type)) return false;
    if (!out->u64b(flags)) return false;
    if (!out->u64b(0)) return false;
    if (!out->u64b(off)) return false;
    if (!out->u64b(size)) return false;
    if (!out->u32b(link)) return false;
    if (!out->u32b(info)) return false;
    if (!out->u64b(align)) return false;
    if (!out->u64b(entsize)) return false;
    return true;
}

// zero relocated fields: every AArch64 reloc patches a 32-bit insn word
// except ABS64 (8 bytes) and ABS32/PREL32 data relocs (4 bytes).
bool a64ElfZeroRelocs(AsmBytes* buf, AsmObject* o, i32 sec)
{
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        if (r->section != sec) continue;
        u64 n = ((Arm64RelocKind)r->kind == Arm64RelocKind::A64_Abs64) ? 8 : 4;
        for (u64 k = 0; k < n; k++)
        {
            u64 at = r->offset + k;
            if (at >= (u64)buf->len) return false;
            buf->data[at] = 0;
        }
    }
    return true;
}

// hot/cold sections fold into .text for the arm64 ELF writer: AArch64
// has no $hot naming convention, and both carry SHF_EXECINSTR anyway.
// Section slots: 0 null, 1 .text, 2 .data, 3 .rela.text, 4 .rela.data,
// 5 .symtab, 6 .strtab, 7 .shstrtab
pub bool emitElfA64(AsmObject* o, AsmBytes* out, AsmParseError* err)
{
    const u32 SHNUM = 8;

    AsmBytes text = AsmBytes::new();
    AsmBytes data = AsmBytes::new();
    AsmBytes hot = AsmBytes::new();
    AsmBytes cold = AsmBytes::new();
    for (u32 i = 0; i < o->text.data.len; i++) { if (!text.u8b(o->text.data.data[i])) return false; }
    for (u32 i = 0; i < o->data.data.len; i++) { if (!data.u8b(o->data.data.data[i])) return false; }
    for (u32 i = 0; i < o->hot.data.len; i++) { if (!hot.u8b(o->hot.data.data[i])) return false; }
    for (u32 i = 0; i < o->cold.data.len; i++) { if (!cold.u8b(o->cold.data.data[i])) return false; }
    // fold hot/cold into text: reloc offsets in those sections shift by
    // the running text size — handled by emitting them as one blob with
    // a reloc remap below
    u64 hotBase = (u64)text.len;
    u64 coldBase = hotBase + (u64)hot.len;
    for (u32 i = 0; i < hot.len; i++) { if (!text.u8b(hot.data[i])) return false; }
    for (u32 i = 0; i < cold.len; i++) { if (!text.u8b(cold.data[i])) return false; }
    hot.deinit(); cold.deinit();
    // remap relocs: sec 3→1 (+hotBase), 4→1 (+coldBase), 1→1, 2→2
    // (do it on the fly during rela emission via a helper)

    // data-section relocs stay on section 2; text-family relocs all land
    // in .rela.text now
    i32[ASM_MAX_SYMS] map;
    for (u32 i = 0; i < ASM_MAX_SYMS; i++) map[i] = -1;
    u32 emitted = 0;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (!o->syms[i].global && !o->syms[i].weak && o->syms[i].defined)
            map[i] = (i32)(++emitted);
    }
    u32 firstGlobal = emitted + 1;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || s->weak || !s->defined) map[i] = (i32)(++emitted);
    }
    u32 nsymsTotal = emitted + 1;

    AsmBytes strtab = AsmBytes::new();
    AsmBytes shstr = AsmBytes::new();
    if (!strtab.u8b(0)) return false;
    if (!shstr.u8b(0)) return false;
    u32[ASM_MAX_SYMS] nameOff;
    u32[ASM_MAX_ORDER] order;
    order[0] = 0xFFFFFFFF;
    u32 oi = 1;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (!o->syms[i].global && !o->syms[i].weak && o->syms[i].defined) order[oi++] = i;
    }
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || s->weak || !s->defined) order[oi++] = i;
    }
    for (u32 si = 1; si < nsymsTotal; si++)
    {
        AsmSymbol* s = &o->syms[order[si]];
        nameOff[order[si]] = strtab.len;
        for (usize k = 0; k < s->name.len; k++) { if (!strtab.u8b(s->name.ptr[k])) return false; }
        if (!strtab.u8b(0)) return false;
    }

    u32 shnText = shstr->len; if (!a64ShstrStr(&shstr, ".text")) return false;
    u32 shnData = shstr->len; if (!a64ShstrStr(&shstr, ".data")) return false;
    u32 shnRelaT = shstr->len; if (!a64ShstrStr(&shstr, ".rela.text")) return false;
    u32 shnRelaD = shstr->len; if (!a64ShstrStr(&shstr, ".rela.data")) return false;
    u32 shnSym = shstr->len; if (!a64ShstrStr(&shstr, ".symtab")) return false;
    u32 shnStr = shstr->len; if (!a64ShstrStr(&shstr, ".strtab")) return false;
    u32 shnShstr = shstr->len; if (!a64ShstrStr(&shstr, ".shstrtab")) return false;

    AsmBytes relaT = AsmBytes::new();
    AsmBytes relaD = AsmBytes::new();
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        // fold hot(3)/cold(4) relocs into .rela.text with adjusted offset
        i32 rsec = r->section;
        i64 roff = (i64)r->offset;
        if (rsec == 3) { rsec = 1; roff += (i64)hotBase; }
        else if (rsec == 4) { rsec = 1; roff += (i64)coldBase; }
        AsmBytes* dst = rsec == 1 ? &relaT : (rsec == 2 ? &relaD : null);
        if (dst == null) { err->msg = "relocation in unknown section"; text.deinit(); data.deinit(); strtab.deinit(); shstr.deinit(); relaT.deinit(); relaD.deinit(); return false; }
        i32 symIdx = -1;
        for (u32 s = 0; s < o->nsyms; s++)
        {
            if (o->syms[s].name.equals(r->symbol)) { symIdx = map[s]; break; }
        }
        if (symIdx < 0) { err->msg = "relocation to unknown symbol"; text.deinit(); data.deinit(); strtab.deinit(); shstr.deinit(); relaT.deinit(); relaD.deinit(); return false; }
        if (!dst->u64b((u64)roff)) return false;
        if (!dst->u64b(((u64)symIdx << 32) | a64ElfRelocType(r->kind))) return false;
        if (!dst->u64b((u64)r->addend)) return false;
    }

    // zero relocated fields: text-family (sec 1/3/4) on merged text,
    // data on data. The generic zeroer keys off r->section; run it per
    // original section against the merged text buffer with offset math —
    // simpler: zero every 4-byte field at mapped offsets directly.
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        AsmReloc* r = &o->relocs[i];
        u64 n = ((Arm64RelocKind)r->kind == Arm64RelocKind::A64_Abs64) ? 8 : 4;
        i64 base = 0;
        bool inText = true;
        if (r->section == 1) base = 0;
        else if (r->section == 3) base = (i64)hotBase;
        else if (r->section == 4) base = (i64)coldBase;
        else if (r->section == 2) inText = false;
        else continue;
        AsmBytes* buf = inText ? &text : &data;
        i64 at0 = inText ? base + (i64)r->offset : (i64)r->offset;
        for (u64 k = 0; k < n; k++)
        {
            u64 at = (u64)(at0 + (i64)k);
            if (at >= (u64)buf->len) { err->msg = "reloc offset past section end"; return false; }
            buf->data[at] = 0;
        }
    }

    u64 off = 64 + (u64)SHNUM * 64;
    u64 offText = off; off += (u64)text.len;
    off = (off + 15) & ~(u64)15;
    u64 offData = off; off += (u64)data.len;
    off = (off + 7) & ~(u64)7;
    u64 offRelaT = off; off += (u64)relaT.len;
    off = (off + 7) & ~(u64)7;
    u64 offRelaD = off; off += (u64)relaD.len;
    off = (off + 7) & ~(u64)7;
    u64 offSym = off; off += (u64)nsymsTotal * 24;
    u64 offStr = off; off += (u64)strtab.len;
    u64 offShstr = off; off += (u64)shstr->len;

    if (!out->u8b(0x7F) || !out->u8b((u8)'E') || !out->u8b((u8)'L') || !out->u8b((u8)'F')) return false;
    if (!out->u8b(2) || !out->u8b(1) || !out->u8b(1) || !out->u8b(0)) return false;
    for (u32 i = 0; i < 8; i++) { if (!out->u8b(0)) return false; }
    if (!out->u16b(1)) return false;    // ET_REL
    if (!out->u16b(183)) return false;  // EM_AARCH64
    if (!out->u32b(1)) return false;
    if (!out->u64b(0)) return false;
    if (!out->u64b(0)) return false;
    if (!out->u64b(64)) return false;
    if (!out->u32b(0)) return false;
    if (!out->u16b(64)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(64)) return false;
    if (!out->u16b((u16)SHNUM)) return false;
    if (!out->u16b(7)) return false;

    for (u32 i = 0; i < 64; i++) { if (!out->u8b(0)) return false; }
    if (!a64ElfShdr(out, shnText, 1, 6, offText, (u64)text.len, 0, 0, 4, 0)) return false;
    if (!a64ElfShdr(out, shnData, 1, 3, offData, (u64)data.len, 0, 0, 8, 0)) return false;
    if (!a64ElfShdr(out, shnRelaT, 4, 0, offRelaT, (u64)relaT.len, 5, 1, 8, 24)) return false;
    if (!a64ElfShdr(out, shnRelaD, 4, 0, offRelaD, (u64)relaD.len, 5, 2, 8, 24)) return false;
    if (!a64ElfShdr(out, shnSym, 2, 0, offSym, (u64)nsymsTotal * 24, 6, firstGlobal, 8, 24)) return false;
    if (!a64ElfShdr(out, shnStr, 3, 0, offStr, (u64)strtab.len, 0, 0, 1, 0)) return false;
    if (!a64ElfShdr(out, shnShstr, 3, 0, offShstr, (u64)shstr->len, 0, 0, 1, 0)) return false;

    if (!a64WritePad(out, offText - (u64)out->len)) return false;
    for (u32 i = 0; i < text.len; i++) { if (!out->u8b(text.data[i])) return false; }
    if (!a64WritePad(out, offData - (u64)out->len)) return false;
    for (u32 i = 0; i < data.len; i++) { if (!out->u8b(data.data[i])) return false; }
    if (!a64WritePad(out, offRelaT - (u64)out->len)) return false;
    for (u32 i = 0; i < relaT.len; i++) { if (!out->u8b(relaT.data[i])) return false; }
    if (!a64WritePad(out, offRelaD - (u64)out->len)) return false;
    for (u32 i = 0; i < relaD.len; i++) { if (!out->u8b(relaD.data[i])) return false; }
    if (!a64WritePad(out, offSym - (u64)out->len)) return false;

    if (!out->u32b(0) || !out->u8b(0) || !out->u8b(0) || !out->u16b(0) ||
        !out->u64b(0) || !out->u64b(0)) return false;
    for (u32 si = 1; si < nsymsTotal; si++)
    {
        AsmSymbol* s = &o->syms[order[si]];
        u8 bind = s->weak ? 2 : ((s->global || !s->defined) ? 1 : 0);
        u8 typ = s->isFunc ? 2 : (s->isObject ? 1 : 0);
        u16 shndx = 0;
        if (s->defined)
        {
            // hot/cold symbols keep their own section index? folded into
            // .text(1) here — remap 3/4 → 1
            shndx = s->section == 3 || s->section == 4 ? 1 : (u16)s->section;
        }
        if (!out->u32b(nameOff[order[si]])) return false;
        if (!out->u8b((u8)((bind << 4) | typ))) return false;
        if (!out->u8b(s->vis)) return false;
        if (!out->u16b(shndx)) return false;
        if (!out->u64b(s->defined ? s->value : 0)) return false;
        if (!out->u64b(s->size)) return false;
    }
    for (u32 i = 0; i < strtab.len; i++) { if (!out->u8b(strtab.data[i])) return false; }
    for (u32 i = 0; i < shstr->len; i++) { if (!out->u8b(shstr.data[i])) return false; }

    text.deinit(); data.deinit();
    strtab.deinit(); shstr.deinit();
    relaT.deinit(); relaD.deinit();
    return true;
}

// ------------------------------------------------------------------
// PE/COFF ARM64 (.obj). IMAGE_FILE_MACHINE_ARM64 = 0xaa64.
// COFF ARM64 reloc types (from winnt.h / LLVM):
//   0  ABSOLUTE (32/64 decided by field? no — ARM64 COFF uses)
//   1  ADDR64, 2 ADDR32, 3 ADDR32NB, 4 REL32, 5 SECTION, 6 SECREL,
//   7  SECIDX? — actually ARM64: IMAGE_REL_ARM64_ADDR32=2,
//   ADDR32NB=3, ADDR64=1, REL32=4, SECTION=6, SECREL=7, SECREL_LOW12A=8,
//   SECREL_HIGH12A=9, SECREL_LOW12L=10, TOKEN=11, SECTIONREL=12,
//   PAGEBASE_REL21=13? — modern: PAGEBASE_REL21=14? Values per LLVM:
//   ARM64_RELOC_ADDR32=0x0002, ADDR32NB=0x0003, ADDR64=0x0001,
//   REL32=0x0004, SECTION=0x0006, SECREL=0x0007, SECREL_LOW12A=0x0008,
//   SECREL_HIGH12A=0x0009, SECREL_LOW12L=0x000A, TOKEN=0x000B,
//   SECTIONREL=0x000C, PAGEBASE_REL21=0x000D, PAGEOFFSET_12A=0x000E,
//   PAGEOFFSET_SECREL=0x000F, BRANCH26=0x0010? — verify below.
// ------------------------------------------------------------------

const u16 COFF_ARM64_ADDR64 = 0x0001;
const u16 COFF_ARM64_ADDR32 = 0x0002;
const u16 COFF_ARM64_ADDR32NB = 0x0003;
const u16 COFF_ARM64_REL32 = 0x0004;
const u16 COFF_ARM64_SECTION = 0x0006;
const u16 COFF_ARM64_SECREL = 0x0007;
const u16 COFF_ARM64_SECREL_LOW12A = 0x0008;
const u16 COFF_ARM64_SECREL_HIGH12A = 0x0009;
const u16 COFF_ARM64_SECREL_LOW12L = 0x000A;
const u16 COFF_ARM64_TOKEN = 0x000B;
const u16 COFF_ARM64_SECTIONREL = 0x000C;
const u16 COFF_ARM64_PAGEBASE_REL21 = 0x000D;
const u16 COFF_ARM64_PAGEOFFSET_12A = 0x000E;
const u16 COFF_ARM64_PAGEOFFSET_SECREL = 0x000F;
const u16 COFF_ARM64_BRANCH26 = 0x0010;
const u16 COFF_ARM64_PCREL21 = 0x0011;
const u16 COFF_ARM64_PCREL19 = 0x0012;
const u16 COFF_ARM64_PCREL14 = 0x0013;

u16 coffA64RelocType(u8 kind)
{
    switch ((Arm64RelocKind)kind)
    {
        Arm64RelocKind::A64_Abs64 => { return COFF_ARM64_ADDR64; },
        Arm64RelocKind::A64_Abs32 => { return COFF_ARM64_ADDR32; },
        Arm64RelocKind::A64_Prel32 => { return COFF_ARM64_REL32; },
        Arm64RelocKind::A64_AdrHi21 => { return COFF_ARM64_PAGEBASE_REL21; },
        Arm64RelocKind::A64_AddLo12 => { return COFF_ARM64_PAGEOFFSET_12A; },
        Arm64RelocKind::A64_Ldst8Lo12 => { return COFF_ARM64_PAGEOFFSET_SECREL; },
        Arm64RelocKind::A64_Ldst16Lo12 => { return COFF_ARM64_PAGEOFFSET_SECREL; },
        Arm64RelocKind::A64_Ldst32Lo12 => { return COFF_ARM64_PAGEOFFSET_SECREL; },
        Arm64RelocKind::A64_Ldst64Lo12 => { return COFF_ARM64_PAGEOFFSET_SECREL; },
        Arm64RelocKind::A64_Ldst128Lo12 => { return COFF_ARM64_PAGEOFFSET_SECREL; },
        Arm64RelocKind::A64_Jump26 => { return COFF_ARM64_BRANCH26; },
        Arm64RelocKind::A64_Call26 => { return COFF_ARM64_BRANCH26; },
        Arm64RelocKind::A64_CondBr19 => { return COFF_ARM64_PCREL19; },
        Arm64RelocKind::A64_TstBr14 => { return COFF_ARM64_PCREL14; },
        Arm64RelocKind::A64_AdrLo21 => { return COFF_ARM64_PCREL21; },
        Arm64RelocKind::A64_LdPrel19 => { return COFF_ARM64_PCREL19; },
        Arm64RelocKind::A64_MovwG0 => { return COFF_ARM64_ADDR64; },
        Arm64RelocKind::A64_MovwG1 => { return COFF_ARM64_ADDR64; },
        Arm64RelocKind::A64_MovwG2 => { return COFF_ARM64_ADDR64; },
        Arm64RelocKind::A64_MovwG3 => { return COFF_ARM64_ADDR64; },
        else => { return COFF_ARM64_REL32; },
    }
}

bool a64CoffStr(AsmBytes* out, str s)
{
    for (usize i = 0; i < s.len; i++) { if (!out->u8b(s.ptr[i])) return false; }
    return out->u8b(0);
}

bool a64CoffName8(AsmBytes* out, str name)
{
    u32 n = name.len > 8 ? 8 : (u32)name.len;
    for (u32 i = 0; i < n; i++) { if (!out->u8b(name.ptr[i])) return false; }
    for (u32 i = n; i < 8; i++) { if (!out->u8b(0)) return false; }
    return true;
}

// ARM64 COFF .obj: machine 0xaa64. Sections: 1 .text, 2 .text$hot,
// 3 .text$cold, 4 .data — same numbering as the x86 writer.
pub bool emitCoffA64(AsmObject* o, AsmBytes* out, AsmParseError* err)
{
    const u32 nsec = 4;

    i32[ASM_MAX_SYMS] map;
    u32[ASM_MAX_SYMS] order;
    u32 nOrder = 0;
    for (u32 i = 0; i < o->nsyms; i++)
    {
        if (o->syms[i].defined && !o->syms[i].global) { map[i] = (i32)nOrder; order[nOrder++] = i; }
    }
    for (u32 i = 0; i < o->nsyms; i++)
    {
        AsmSymbol* s = &o->syms[i];
        if (s->global || !s->defined) { map[i] = (i32)nOrder; order[nOrder++] = i; }
    }

    AsmBytes strtab = AsmBytes::new();
    if (!strtab.u32b(0)) return false;
    u32[ASM_MAX_SYMS] nameOff;
    for (u32 i = 0; i < nOrder; i++)
    {
        AsmSymbol* s = &o->syms[order[i]];
        if (s->name.len > 8)
        {
            nameOff[order[i]] = strtab.len;
            for (usize k = 0; k < s->name.len; k++) { if (!strtab.u8b(s->name.ptr[k])) return false; }
            if (!strtab.u8b(0)) return false;
        }
    }
    u32 hotNameOff = strtab.len;
    if (!a64CoffStr(&strtab, ".text$hot")) return false;
    u32 coldNameOff = strtab.len;
    if (!a64CoffStr(&strtab, ".text$cold")) return false;
    u32 strSize = strtab.len;
    if (strSize > 0) { for (u32 i = 0; i < 4; i++) strtab.data[i] = (u8)((strSize >> (8 * i)) & 0xFF); }

    // section bodies: .text, .text$hot, .text$cold, .data
    AsmBytes* secBodies[4] = { &o->text.data, &o->hot.data, &o->cold.data, &o->data.data };
    str secNames[4] = { ".text", ".text$hot", ".text$cold", ".data" };

    // reloc counts per section
    u32 nrel[4] = { 0, 0, 0, 0 };
    for (u32 i = 0; i < o->nrelocs; i++)
    {
        i32 s = o->relocs[i].section;
        if (s >= 1 && s <= 4) nrel[s - 1]++;
    }

    // layout: file header 20 + 4*40 shdrs + bodies + relocs + symtab + strtab
    u64 off = 20 + (u64)nsec * 40;
    u64 bodyOff[4];
    for (u32 s = 0; s < 4; s++)
    {
        bodyOff[s] = off;
        off += (u64)secBodies[s]->len;
        off = (off + 3) & ~(u64)3;
    }
    u64 relOff[4];
    for (u32 s = 0; s < 4; s++)
    {
        relOff[s] = nrel[s] > 0 ? off : 0;
        off += (u64)nrel[s] * 10;
        off = (off + 3) & ~(u64)3;
    }
    u64 symOff = off;
    off += (u64)nOrder * 18;
    u64 strOff = off;
    off += (u64)strtab.len;

    // file header: machine 0xaa64, nsec, timedate 0, symtab ptr, nsyms,
    // opt hdr 0, characteristics 0
    if (!out->u16b(0xaa64)) return false;
    if (!out->u16b((u16)nsec)) return false;
    if (!out->u32b(0)) return false;
    if (!out->u32b((u32)symOff)) return false;
    if (!out->u32b((u32)nOrder)) return false;
    if (!out->u16b(0)) return false;
    if (!out->u16b(0)) return false;

    // section headers
    for (u32 s = 0; s < 4; s++)
    {
        str nm = secNames[s];
        u32 flags = s == 3 ? 0xC0000040 : 0x60000020; // .data WA | text RX
        if (s == 3) flags = 0xC0000040;
        bool longName = nm.len > 8;
        u32 nameVal = 0;
        if (longName)
        {
            // "/<offset>" into strtab
            cchar[16] nb;
            i32 nn = snprintf(nb, 16, C"/%u", s == 1 ? hotNameOff : coldNameOff);
            for (i32 i = 0; i < 8; i++)
            {
                u8 ch = i == 0 ? (u8)'/' : (i - 1 < nn - 1 ? (u8)nb[i] : (u8)0);
                if (!out->u8b(ch)) return false;
            }
            nameVal = 0;
        }
        else
        {
            if (!a64CoffName8(out, nm)) return false;
        }
        AsmBytes* body = secBodies[s];
        u32 vsize = 0;
        u32 rawSize = (u32)body->len;
        u32 rawPtr = rawSize > 0 ? (u32)bodyOff[s] : 0;
        u32 relPtr = nrel[s] > 0 ? (u32)relOff[s] : 0;
        if (!out->u32b(vsize)) return false;
        if (!out->u32b(0)) return false;
        if (!out->u32b(rawSize)) return false;
        if (!out->u32b(rawPtr)) return false;
        if (!out->u32b(relPtr)) return false;
        if (!out->u32b(0)) return false;
        if (!out->u16b((u16)nrel[s])) return false;
        if (!out->u16b(0)) return false;
        if (!out->u32b(flags)) return false;
        (void)nameVal;
    }

    // pad to first body
    while ((u64)out->len < bodyOff[0]) { if (!out->u8b(0)) return false; }
    for (u32 s = 0; s < 4; s++)
    {
        while ((u64)out->len < bodyOff[s]) { if (!out->u8b(0)) return false; }
        AsmBytes* body = secBodies[s];
        for (u32 i = 0; i < body->len; i++) { if (!out->u8b(body->data[i])) return false; }
        while ((u64)out->len < ((bodyOff[s] + (u64)body->len + 3) & ~(u64)3)) { if (!out->u8b(0)) return false; }
    }
    // reloc records
    for (u32 s = 0; s < 4; s++)
    {
        while ((u64)out->len < relOff[s]) { if (!out->u8b(0)) return false; }
        if (nrel[s] == 0) continue;
        // count emitted so far to know index
        u32 seen = 0;
        for (u32 i = 0; i < o->nrelocs; i++)
        {
            AsmReloc* r = &o->relocs[i];
            if (r->section != (i32)(s + 1)) continue;
            // find symbol index in order[]
            i32 symIdx = -1;
            for (u32 t = 0; t < nOrder; t++)
            {
                if (o->syms[order[t]].name.equals(r->symbol)) { symIdx = (i32)order[t]; break; }
            }
            if (symIdx < 0) { err->msg = "relocation to unknown symbol"; return false; }
            if (!out->u32b((u32)r->offset)) return false;
            if (!out->u32b((u32)map[symIdx])) return false;
            if (!out->u16b(coffA64RelocType(r->kind))) return false;
            if (!out->u16b(0)) return false;
            seen++;
        }
        while ((u64)out->len < ((relOff[s] + (u64)nrel[s] * 10 + 3) & ~(u64)3)) { if (!out->u8b(0)) return false; }
    }

    while ((u64)out->len < symOff) { if (!out->u8b(0)) return false; }
    // COFF symbol table: 18 bytes each
    for (u32 i = 0; i < nOrder; i++)
    {
        AsmSymbol* s = &o->syms[order[i]];
        // name: 8 inline or "/offset"
        if (s->name.len > 8)
        {
            cchar[16] nb;
            i32 nn = snprintf(nb, 16, C"/%u", nameOff[order[i]]);
            for (i32 k = 0; k < 8; k++)
            {
                u8 ch = k == 0 ? (u8)'/' : (k - 1 < nn - 1 ? (u8)nb[k] : (u8)0);
                if (!out->u8b(ch)) return false;
            }
        }
        else
        {
            if (!a64CoffName8(out, s->name)) return false;
        }
        u32 val = s->defined ? (u32)s->value : 0;
        u16 secNum = s->defined ? (u16)s->section : 0;
        u16 type = s->isFunc ? 0x20 : 0;
        u8 storage = (s->global || !s->defined) ? 2 : 3; // EXTERNAL : STATIC
        if (!out->u32b(val)) return false;
        if (!out->u16b(secNum)) return false;
        if (!out->u16b(type)) return false;
        if (!out->u8b(storage)) return false;
        if (!out->u8b(0)) return false;
        if (!out->u8b(0)) return false;
        if (!out->u8b(0)) return false;
        if (!out->u8b(0)) return false;
        if (!out->u16b(0)) return false;
    }
    while ((u64)out->len < strOff) { if (!out->u8b(0)) return false; }
    for (u32 i = 0; i < strtab.len; i++) { if (!out->u8b(strtab.data[i])) return false; }
    strtab.deinit();
    return true;
}

// ------------------------------------------------------------------
// Mach-O arm64 relocatable (.o). MH_MAGIC_64, CPU_TYPE_ARM64.
// Layout: mach_header(32) | load commands | section contents |
//         reloc entries | symtab | strtab | dysymtab? (skipped)
// LC_SEGMENT_64 carries sections; LC_SYMTAB carries symbols.
// Relocations are scattered-format entries in each section.
// ------------------------------------------------------------------

const u32 MH_MAGIC_64 = 0xFEEDFACF;
const u32 MH_OBJECT = 0x1;
const u32 CPU_TYPE_ARM64 = 0x0100000C;
const u32 CPU_SUBTYPE_ARM64_ALL = 0;
const u32 LC_SEGMENT_64 = 0x19;
const u32 LC_SYMTAB = 0x2;
const u32 S_ATTR_PURE_INSTRUCTIONS = 0x80000000;
const u32 S_ATTR_SOME_INSTRUCTIONS = 0x00000400;

// Mach-O relocation type numbers (arm64, scattered=0x80000000 bit)
const u8 MRELOC_UNSIGNED = 0;      // 64-bit absolute
const u8 MRELOC_BRANCH26 = 2;      // b/bl
const u8 MRELOC_PAGE21 = 3;        // adrp
const u8 MRELOC_PAGEOFF12 = 4;     // add/ldr lo12
const u8 MRELOC_GOT_LOAD_PAGE21 = 5;
const u8 MRELOC_GOT_LOAD_PAGEOFF12 = 6;
const u8 MRELOC_POINTER_TO_GOT = 7;
const u8 MRELOC_TLV_PAGE21 = 8;
const u8 MRELOC_TLV_PAGEOFF12 = 9;
const u8 MRELOC_ADDEND = 10;
// arm64e extras skipped

u8 machoA64RelocType(u8 kind, bool* scattered)
{
    *scattered = false;
    switch ((Arm64RelocKind)kind)
    {
        Arm64RelocKind::A64_Abs64 => { return MRELOC_UNSIGNED; },
        Arm64RelocKind::A64_AdrHi21 => { return MRELOC_PAGE21; },
        Arm64RelocKind::A64_AddLo12 => { return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Ldst8Lo12 => { *scattered = true; return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Ldst16Lo12 => { *scattered = true; return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Ldst32Lo12 => { *scattered = true; return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Ldst64Lo12 => { *scattered = true; return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Ldst128Lo12 => { *scattered = true; return MRELOC_PAGEOFF12; },
        Arm64RelocKind::A64_Jump26 => { return MRELOC_BRANCH26; },
        Arm64RelocKind::A64_Call26 => { return MRELOC_BRANCH26; },
        Arm64RelocKind::A64_CondBr19 => { *scattered = true; return 11; }, // ARM64_RELOC_BRANCH19? use scattered cond19
        Arm64RelocKind::A64_TstBr14 => { *scattered = true; return 12; },  // ARM64_RELOC_BRANCH14?
        Arm64RelocKind::A64_LdPrel19 => { *scattered = true; return 13; },
        Arm64RelocKind::A64_AdrLo21 => { *scattered = true; return 14; },
        Arm64RelocKind::A64_MovwG0 => { *scattered = true; return 15; },
        Arm64RelocKind::A64_MovwG1 => { *scattered = true; return 16; },
        Arm64RelocKind::A64_MovwG2 => { *scattered = true; return 17; },
        Arm64RelocKind::A64_MovwG3 => { *scattered = true; return 18; },
        else => { return MRELOC_UNSIGNED; },
    }
}
