#[[no_drop_all]]
/* layout.crl for linker
 * Input sections merge into eight canonical output sections
 * (.text .rodata .eh_frame .note .init_array .fini_array .data .bss),
 * classes ordered TEXT, RO, DATA, BSS. File-backed sections keep the
 * invariant vma = imageBase + fileOff for ELF and PE canonical
 * sections; PE/ELF-DYN tail regions (imports, exports, base relocs,
 * dynamic metadata) get their own raw/virtual placements past the
 * canonical end. Output format is parameterized: ELF exec, ELF dyn,
 * PE exe/dll, raw flat image.
 */

import(lib) std::vec { Vec };
import(lib) std::string { String };
import elf { SHT_NULL, SHT_SYMTAB, SHT_STRTAB, SHT_RELA, SHT_REL, SHT_NOBITS, SHT_PROGBITS, SHF_WRITE, SHF_ALLOC, SHF_EXECINSTR, SHN_ABS, OUT_NONE, EM_X86_64, EM_386, FMT_ELF_EXE, FMT_ELF_DYN, FMT_PE_EXE, FMT_PE_DLL, FMT_RAW, R_X86_64_64, R_X86_64_32, R_X86_64_32S, R_386_32, alignUp, pushHex, elfInterp };
import coff { IMAGE_REL_AMD64_ADDR64, IMAGE_REL_AMD64_ADDR32, IMAGE_REL_I386_DIR32 };
import imports { Imports, ImportRec, sizeIdata };
import object { ObjFile, Section, Sym, Reloc };
import resolve { GlobalDef, findDef };

/* canonical output section indices (allocation order): hot text first
 * for page locality, cold text after .text, then rodata, eh_frame,
 * note, init/fini arrays, data, bss. Debug/metadata passthrough
 * sections are appended after SEC_ALLOC_COUNT. */
pub const usize SEC_HOT = 0;
pub const usize SEC_TEXT = 1;
pub const usize SEC_COLD = 2;
pub const usize SEC_RODATA = 3;
pub const usize SEC_EH = 4;
pub const usize SEC_NOTE = 5;
pub const usize SEC_INIT = 6;
pub const usize SEC_FINI = 7;
pub const usize SEC_DATA = 8;
pub const usize SEC_BSS = 9;
pub const usize SEC_ALLOC_COUNT = 10;

pub struct Piece
{
    usize objIdx;
    usize secIdx;
    u64 offset;
    u64 size;
}

pub struct OutSec
{
    str name;
    u32 type;
    u64 flags;
    u64 addr;
    u64 offset;
    u64 size;
    u64 align;
    Vec<Piece> pieces;
}

pub struct Layout
{
    Vec<OutSec> secs;
    u64 imageBase;
    u64 entry;
    u64 phdrEnd;
    u64 rxEnd;
    bool hasRW;
    u64 rwOff;
    u64 rwFilesz;
    u64 rwMemsz;
    u64 fileEnd;
    u64 dbgEnd;
    i32 bssIdx;
    u64 thunkOff;
    u64 idataAddr;
    u64 idataOff;
    u64 idataSize;
    u64 edataAddr;
    u64 edataOff;
    u64 edataSize;
    u64 relocAddr;
    u64 relocOff;
    u64 relocSize;
    u64 imageEnd;
    u64 rawEnd;
    u64 dynMetaOff;
    u64 dynstrSz;
    u64 dynsymSz;
    u64 hashSz;
    u64 relOff;
    u64 relSize;
    u64 dynOff;
    u64 dynSize;
    bool elfDynExe;
    u64 interpOff;
    u64 interpLen;
    u64 pltOff;
    u64 pltSize;
    u64 gotOff;
    u64 gotSize;

    static Layout empty()
    {
        return Layout {
            .secs = Vec<OutSec>::new(),
            .imageBase = 0,
            .entry = 0,
            .phdrEnd = 0,
            .rxEnd = 0,
            .hasRW = false,
            .rwOff = 0,
            .rwFilesz = 0,
            .rwMemsz = 0,
            .fileEnd = 0,
            .dbgEnd = 0,
            .bssIdx = -1,
            .thunkOff = 0,
            .idataAddr = 0,
            .idataOff = 0,
            .idataSize = 0,
            .edataAddr = 0,
            .edataOff = 0,
            .edataSize = 0,
            .relocAddr = 0,
            .relocOff = 0,
            .relocSize = 0,
            .imageEnd = 0,
            .rawEnd = 0,
            .dynMetaOff = 0,
            .dynstrSz = 0,
            .dynsymSz = 0,
            .hashSz = 0,
            .relOff = 0,
            .relSize = 0,
            .dynOff = 0,
            .dynSize = 0,
            .elfDynExe = false,
            .interpOff = 0,
            .interpLen = 0,
            .pltOff = 0,
            .pltSize = 0,
            .gotOff = 0,
            .gotSize = 0
        };
    }

    void dispose()
    {
        for (usize i = 0; i < self.secs.count(); i++)
            self.secs.atPtr(i)->pieces.dispose();
        self.secs.dispose();
    }
}

void _addOut(Layout* L, str name, u32 type, u64 flags)
{
    OutSec o;
    o.name = name;
    o.type = type;
    o.flags = flags;
    o.addr = 0;
    o.offset = 0;
    o.size = 0;
    o.align = 1;
    o.pieces = Vec<Piece>::new();
    L->secs.push(o);
}

i32 _bucketFor(u8 outFmt, str name, u32 type, u64 flags)
{
    if ((flags & SHF_ALLOC) == 0)
    {
        if (type != SHT_PROGBITS && type != SHT_NOTE) return -1;
        if (name.equals(".note.GNU-stack")) return -1;
        if ((flags & 0x800) != 0) return -4; /* SHF_COMPRESSED */
        if (outFmt == FMT_ELF_EXE || outFmt == FMT_ELF_DYN) return -3;
        return -1;
    }
    if (name.startsWith(".tdata") || name.startsWith(".tbss")) return -2;
    if (type == SHT_NULL || type == SHT_SYMTAB || type == SHT_STRTAB ||
        type == SHT_RELA || type == SHT_REL) return -1;
    if (type == SHT_NOBITS) return (i32)SEC_BSS;
    if ((flags & SHF_EXECINSTR) != 0)
    {
        if (name.startsWith(".text.hot") || name.startsWith(".text.startup") ||
            name.startsWith(".text$hot")) return (i32)SEC_HOT;
        if (name.startsWith(".text.cold") || name.startsWith(".text.unlikely") ||
            name.startsWith(".text$cold")) return (i32)SEC_COLD;
        return (i32)SEC_TEXT;
    }
    if ((flags & SHF_WRITE) != 0)
    {
        if (name.startsWith(".init_array")) return (i32)SEC_INIT;
        if (name.startsWith(".fini_array")) return (i32)SEC_FINI;
        return (i32)SEC_DATA;
    }
    if (name.startsWith(".note")) return (i32)SEC_NOTE;
    if (name.startsWith(".eh_frame")) return (i32)SEC_EH;
    return (i32)SEC_RODATA;
}

pub u64 pieceOffset(Layout* L, usize outIdx, usize objIdx, usize secIdx)
{
    if (outIdx >= L->secs.count()) return 0;
    OutSec* out = L->secs.atPtr(outIdx);
    for (usize i = 0; i < out->pieces.count(); i++)
    {
        Piece* p = out->pieces.atPtr(i);
        if (p->objIdx == objIdx && p->secIdx == secIdx) return p->offset;
    }
    return 0;
}

pub bool defAddress(Vec<ObjFile>* objs, Layout* L, GlobalDef* def, u64* out, String* err)
{
    if (def->common)
    {
        if (L->bssIdx < 0)
        {
            err->pushView("linker: COMMON symbol without .bss section: ");
            err->pushView(def->name);
            return false;
        }
        *out = L->secs.atPtr((usize)L->bssIdx)->addr + def->commonOff;
        return true;
    }
    if (def->isImport)
    {
        *out = def->viaImp ? def->iatAddr : def->value;
        return true;
    }
    if (def->shndx == SHN_ABS)
    {
        *out = def->value;
        return true;
    }
    ObjFile* obj = objs->atPtr(def->objIdx);
    if ((usize)def->shndx >= obj->secs.count())
    {
        err->pushView("linker: symbol has bad section index: ");
        err->pushView(def->name);
        return false;
    }
    Section* in = obj->secs.atPtr((usize)def->shndx);
    if (in->outIdx == OUT_NONE)
    {
        err->pushView("linker: symbol defined in discarded section: ");
        err->pushView(def->name);
        return false;
    }
    *out = L->secs.atPtr((usize)in->outIdx)->addr +
           pieceOffset(L, (usize)in->outIdx, def->objIdx, (usize)def->shndx) + def->value;
    return true;
}

pub bool localAddress(Vec<ObjFile>* objs, Layout* L, usize objIdx, usize symIdx, u64* out, String* err)
{
    ObjFile* obj = objs->atPtr(objIdx);
    Sym* sym = obj->syms.atPtr(symIdx);
    if (sym->shndx == SHN_ABS)
    {
        *out = sym->value;
        return true;
    }
    if (sym->shndx == SHN_UNDEF || (usize)sym->shndx >= obj->secs.count())
    {
        err->pushView("linker: undefined local symbol: ");
        err->pushView(sym->name);
        return false;
    }
    Section* in = obj->secs.atPtr((usize)sym->shndx);
    if (in->outIdx == OUT_NONE)
    {
        *out = 0;
        return true;
    }
    *out = L->secs.atPtr((usize)in->outIdx)->addr +
           pieceOffset(L, (usize)in->outIdx, objIdx, (usize)sym->shndx) + sym->value;
    return true;
}

/* Counts absolute relocations that need base fixups (PE) or RELATIVE
 * entries (ELF dyn). Only counts relocations in sections that survive
 * layout, so the ELF-dyn rela size is exact. x86 PE thunks are added
 * by the caller (their fixups are created at emit time).
 */
usize _countAbs(u16 machine, u8 outFmt, Vec<ObjFile>* objs)
{
    bool is64 = machine == EM_X86_64;
    bool pe = outFmt == FMT_PE_EXE || outFmt == FMT_PE_DLL;
    bool dyn = outFmt == FMT_ELF_DYN;
    if (!pe && !dyn) return 0;
    usize n = 0;
    for (usize o = 0; o < objs->count(); o++)
    {
        ObjFile* obj = objs->atPtr(o);
        for (usize si = 0; si < obj->secs.count(); si++)
        {
            Section* sec = obj->secs.atPtr(si);
            if (sec->outIdx == OUT_NONE) continue;
            if (sec->type == SHT_NOBITS) continue;
            if ((sec->flags & SHF_ALLOC) == 0) continue; /* debug: static S+A */
            Vec<Reloc>* bucket = obj->rels.atPtr(si);
            for (usize k = 0; k < bucket->count(); k++)
            {
                Reloc* r = bucket->atPtr(k);
                bool abs8 = false;
                bool abs4 = false;
                if (r->fmt == 1)
                {
                    if (is64)
                    {
                        if (r->type == IMAGE_REL_AMD64_ADDR64) abs8 = true;
                        if (r->type == IMAGE_REL_AMD64_ADDR32) abs4 = true;
                    }
                    else
                    {
                        if (r->type == IMAGE_REL_I386_DIR32) abs4 = true;
                    }
                }
                else
                {
                    if (is64)
                    {
                        if (r->type == R_X86_64_64) abs8 = true;
                        if (r->type == R_X86_64_32 || r->type == R_X86_64_32S) abs4 = true;
                    }
                    else
                    {
                        if (r->type == R_386_32) abs4 = true;
                    }
                }
                if (pe && (abs8 || abs4)) n++;
                if (dyn && is64 && abs8) n++;
                if (dyn && !is64 && abs4) n++;
            }
        }
    }
    return n;
}

pub bool computeLayout(u16 machine, u8 outFmt, u64 imageBase, str entry, u64 entryAddr, bool entryAddrSet, usize edataSz, Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Imports* imps, Layout* L, String* err)
{
    bool is64 = machine == EM_X86_64;
    bool isPE = outFmt == FMT_PE_EXE || outFmt == FMT_PE_DLL;
    u64 base = imageBase;
    if (base == 0)
    {
        if (outFmt == FMT_RAW) base = 0;
        else if (isPE) base = is64 ? 0x140000000 : 0x400000;
        else if (outFmt == FMT_ELF_DYN) base = 0;
        else base = is64 ? 0x400000 : 0x08048000;
    }
    /* shared objects are position independent: always linked at 0 */
    if (outFmt == FMT_ELF_DYN) base = 0;
    L->imageBase = base;

    _addOut(L, ".text.hot", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR);
    _addOut(L, ".text", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR);
    _addOut(L, ".text.cold", SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR);
    _addOut(L, ".rodata", SHT_PROGBITS, SHF_ALLOC);
    _addOut(L, ".eh_frame", SHT_PROGBITS, SHF_ALLOC);
    _addOut(L, ".note", SHT_PROGBITS, SHF_ALLOC);
    _addOut(L, ".init_array", SHT_PROGBITS, SHF_ALLOC | SHF_WRITE);
    _addOut(L, ".fini_array", SHT_PROGBITS, SHF_ALLOC | SHF_WRITE);
    _addOut(L, ".data", SHT_PROGBITS, SHF_ALLOC | SHF_WRITE);
    _addOut(L, ".bss", SHT_NOBITS, SHF_ALLOC | SHF_WRITE);

    bool needRW = false;
    for (usize o = 0; o < objs->count(); o++)
    {
        ObjFile* obj = objs->atPtr(o);
        for (usize i = 0; i < obj->secs.count(); i++)
        {
            Section* s = obj->secs.atPtr(i);
            i32 b = _bucketFor(outFmt, s->name, s->type, s->flags);
            if (b == -2)
            {
                err->pushView("linker: TLS section not supported: ");
                err->pushView(s->name);
                return false;
            }
            if (b == -4)
            {
                err->pushView("linker: compressed debug section not supported: ");
                err->pushView(s->name);
                return false;
            }
            if (b == -1)
            {
                s->outIdx = OUT_NONE;
                continue;
            }
            if (s->type != SHT_NOBITS && s->addralign > 0x1000)
            {
                err->pushView("linker: section ");
                err->pushView(s->name);
                err->pushView(" alignment ");
                pushHex(err, s->addralign);
                err->pushView(" exceeds 0x1000 (M1 page limit)");
                return false;
            }
            if (b == -3)
            {
                /* debug/metadata passthrough: one output section per
                 * name, non-allocated, appended after the canonical ten */
                i32 idx = -1;
                for (usize k = SEC_ALLOC_COUNT; k < L->secs.count(); k++)
                {
                    if (L->secs.at(k).name.equals(s->name)) { idx = (i32)k; break; }
                }
                if (idx < 0)
                {
                    _addOut(L, s->name, s->type, 0);
                    idx = (i32)(L->secs.count() - 1);
                }
                OutSec* dsec = L->secs.atPtr((usize)idx);
                if (s->addralign > dsec->align) dsec->align = s->addralign;
                Piece p;
                p.objIdx = o;
                p.secIdx = i;
                p.offset = 0;
                p.size = s->size;
                dsec->pieces.push(p);
                s->outIdx = (u32)idx;
                continue;
            }
            OutSec* out = L->secs.atPtr((usize)b);
            out->type = s->type;
            if (s->addralign > out->align) out->align = s->addralign;
            Piece p;
            p.objIdx = o;
            p.secIdx = i;
            p.offset = 0;
            p.size = s->size;
            out->pieces.push(p);
            s->outIdx = (u32)b;
            if ((out->flags & SHF_WRITE) != 0) needRW = true;
        }
    }

    bool hasCommons = false;
    for (usize d = 0; d < defs->count(); d++)
    {
        GlobalDef* def = defs->atPtr(d);
        if (!def->common) continue;
        hasCommons = true;
        OutSec* bss = L->secs.atPtr((usize)SEC_BSS);
        if (def->align > bss->align) bss->align = def->align;
    }
    if (hasCommons) needRW = true;

    for (usize i = 0; i < L->secs.count(); i++)
    {
        OutSec* out = L->secs.atPtr(i);
        u64 off = 0;
        for (usize j = 0; j < out->pieces.count(); j++)
        {
            Piece* p = out->pieces.atPtr(j);
            Section* in = objs->atPtr(p->objIdx)->secs.atPtr(p->secIdx);
            u64 a = in->addralign > 0 ? in->addralign : 1;
            off = alignUp(off, a);
            p->offset = off;
            off += p->size;
        }
        out->size = off;
    }

    usize nImp = imps == null ? 0 : imps->count();

    /* PE: jump thunks appended to .text for every import record */
    if (isPE && nImp > 0)
    {
        OutSec* text = L->secs.atPtr((usize)SEC_TEXT);
        u64 t = alignUp(text->size, 8);
        L->thunkOff = t;
        text->size = t + (u64)nImp * 8;
    }

    /* ELF dyn: reserve dynamic metadata inside .rodata and .dynamic
     * inside .data so both end up covered by the LOAD segments.
     */
    if (outFmt == FMT_ELF_DYN)
    {
        needRW = true; /* .dynamic lives in .data */
        OutSec* ro = L->secs.atPtr((usize)SEC_RODATA);
        OutSec* rw = L->secs.atPtr((usize)SEC_DATA);
        usize nDyn = defs->count() + 1;
        u64 dynstrSz = 1;
        for (usize d = 0; d < defs->count(); d++)
            dynstrSz += (u64)defs->at(d).name.len + 1;
        u64 dynsymEnt = is64 ? 24 : 16;
        u64 dynsymSz = (u64)nDyn * dynsymEnt;
        u64 nbucket = (u64)nDyn;
        u64 hashSz = (nbucket + 2 + (u64)nDyn) * 4;
        u64 relEnt = is64 ? 24 : 8;
        u64 relSz = (u64)_countAbs(machine, outFmt, objs) * relEnt;

        u64 m = alignUp(ro->size, 8);
        L->dynMetaOff = m;
        u64 dynsymRel = alignUp(m + dynstrSz, 8);
        u64 hashRel = alignUp(dynsymRel + dynsymSz, 8);
        u64 relRel = alignUp(hashRel + hashSz, 8);
        ro->size = relRel + relSz;
        L->dynstrSz = dynstrSz;
        L->dynsymSz = dynsymSz;
        L->hashSz = hashSz;
        L->relOff = relRel;
        L->relSize = relSz;

        u64 dynEnt = is64 ? 16 : 8;
        u64 nDt = 9;
        u64 d = alignUp(rw->size, 8);
        L->dynOff = d;
        rw->size = d + nDt * dynEnt;
        L->dynSize = nDt * dynEnt;
    }

    /* ELF dynamic executable: PLT/GOT, interpreter, and the dynamic
     * symbol/string/hash/relocation tables for ELF shared-object
     * imports. The tables live in the canonical LOAD segments.
     */
    if (outFmt == FMT_ELF_EXE && imps != null && imps->hasElf())
    {
        needRW = true;
        L->elfDynExe = true;
        OutSec* text = L->secs.atPtr((usize)SEC_TEXT);
        OutSec* ro = L->secs.atPtr((usize)SEC_RODATA);
        OutSec* rw = L->secs.atPtr((usize)SEC_DATA);
        Vec<str> libs = Vec<str>::new();
        imps->elfLibs(&libs);

        u64 plt = alignUp(text->size, 16);
        L->pltOff = plt;
        L->pltSize = (u64)nImp * 16;
        text->size = plt + L->pltSize;

        u64 interpLen = (u64)elfInterp(is64).len + 1;
        L->interpOff = ro->size;
        L->interpLen = interpLen;

        u64 dynstrSz = 1;
        for (usize i = 0; i < imps->count(); i++)
            dynstrSz += (u64)imps->recs.at(i).name.len + 1;
        for (usize i = 0; i < libs.count(); i++)
            dynstrSz += (u64)libs.at(i).len + 1;

        usize nDyn = imps->count() + 1;
        u64 dynsymEnt = is64 ? 24 : 16;
        u64 dynsymSz = (u64)nDyn * dynsymEnt;
        u64 nbucket = (u64)nDyn;
        u64 hashSz = (nbucket + 2 + (u64)nDyn) * 4;
        u64 relEnt = is64 ? 24 : 8;
        u64 relSz = (u64)nImp * relEnt;

        u64 m = alignUp(ro->size + interpLen, 8);
        L->dynMetaOff = m;
        u64 dynsymRel = alignUp(m + dynstrSz, 8);
        u64 hashRel = alignUp(dynsymRel + dynsymSz, 8);
        u64 relRel = alignUp(hashRel + hashSz, 8);
        ro->size = relRel + relSz;
        L->dynstrSz = dynstrSz;
        L->dynsymSz = dynsymSz;
        L->hashSz = hashSz;
        L->relOff = relRel;
        L->relSize = relSz;

        u64 dynEnt = is64 ? 16 : 8;
        u64 nDt = 11 + (u64)libs.count();
        u64 got = alignUp(rw->size, 8);
        L->gotOff = got;
        L->gotSize = (u64)nImp * 8;
        rw->size = got + L->gotSize;
        u64 d = alignUp(rw->size, 8);
        L->dynOff = d;
        rw->size = d + nDt * dynEnt;
        L->dynSize = nDt * dynEnt;
        libs.dispose();
    }

    u32 phnum = needRW ? 3 : 2;
    u64 phdrEnd;
    if (outFmt == FMT_RAW)
    {
        phnum = 0;
        phdrEnd = 0;
    }
    else if (isPE)
    {
        phnum = 0;
        phdrEnd = 0x1000;
    }
    else
    {
        if (outFmt == FMT_ELF_DYN) phnum = needRW ? 4 : 3;
        if (L->elfDynExe) phnum = 5;
        phdrEnd = is64 ? (64 + (u64)phnum * 56) : (52 + (u64)phnum * 32);
    }
    L->phdrEnd = phdrEnd;

    u64 cur = phdrEnd;
    for (usize i = 0; i < SEC_INIT; i++)
    {
        OutSec* out = L->secs.atPtr(i);
        cur = alignUp(cur, out->align);
        if (isPE) cur = alignUp(cur, 0x1000);
        out->offset = cur;
        out->addr = base + cur;
        cur += out->size;
    }
    L->rxEnd = cur;

    if (needRW)
    {
        L->hasRW = true;
        L->bssIdx = (i32)SEC_BSS;
        L->rwOff = alignUp(cur, 0x1000);
        cur = L->rwOff;
        for (usize i = SEC_INIT; i < SEC_BSS; i++)
        {
            OutSec* out = L->secs.atPtr(i);
            cur = alignUp(cur, out->align);
            if (isPE) cur = alignUp(cur, 0x1000);
            out->offset = cur;
            out->addr = base + cur;
            cur += out->size;
        }
        u64 dataEnd = cur;
        OutSec* bss = L->secs.atPtr((usize)SEC_BSS);
        cur = alignUp(cur, bss->align);
        if (isPE) cur = alignUp(cur, 0x1000);
        bss->offset = cur;
        bss->addr = base + cur;
        cur += bss->size;
        L->fileEnd = dataEnd;
        L->rwFilesz = dataEnd - L->rwOff;
        L->rwMemsz = cur - L->rwOff;

        if (hasCommons)
        {
            u64 bssCur = bss->offset + bss->size;
            for (usize d = 0; d < defs->count(); d++)
            {
                GlobalDef* def = defs->atPtr(d);
                if (!def->common) continue;
                bssCur = alignUp(bssCur, def->align > 0 ? def->align : 1);
                def->commonOff = bssCur - bss->offset;
                bssCur += def->size;
            }
            bss->size = bssCur - bss->offset;
            L->rwMemsz = bssCur - L->rwOff;
        }
    }
    else
    {
        L->fileEnd = L->rxEnd;
    }
    /* debug/metadata sections: file-backed past the alloc image,
     * never loaded, addresses stay zero */
    L->dbgEnd = 0;
    if (L->secs.count() > SEC_ALLOC_COUNT)
    {
        u64 dcur = alignUp(L->fileEnd, 16);
        for (usize i = SEC_ALLOC_COUNT; i < L->secs.count(); i++)
        {
            OutSec* dbg = L->secs.atPtr(i);
            dbg->addr = 0;
            dbg->offset = dcur;
            dcur += dbg->size;
        }
        L->dbgEnd = dcur;
    }
    L->rawEnd = L->fileEnd;

    if (isPE)
    {
        u32 idataSz = sizeIdata(is64, imps);
        L->idataSize = (u64)idataSz;
        L->edataSize = (u64)edataSz;
        usize nabs = _countAbs(machine, outFmt, objs);
        if (!is64) nabs = nabs + nImp;
        u64 relocUpper = (u64)nabs * 12 + 32;
        L->relocSize = relocUpper;

        /* raw placement past the canonical file end (bss has no bytes) */
        L->idataOff = alignUp(L->fileEnd, 0x1000);
        L->edataOff = alignUp(L->idataOff + L->idataSize, 0x1000);
        L->relocOff = alignUp(L->edataOff + L->edataSize, 0x1000);
        L->rawEnd = alignUp(L->relocOff + relocUpper, 0x1000);

        /* virtual placement past the bss memory end */
        u64 memEnd = L->hasRW ? (L->secs.at((usize)SEC_BSS).addr + L->secs.at((usize)SEC_BSS).size) : L->rxEnd;
        L->idataAddr = alignUp(memEnd, 0x1000);
        L->edataAddr = alignUp(L->idataAddr + L->idataSize, 0x1000);
        L->relocAddr = alignUp(L->edataAddr + L->edataSize, 0x1000);
        L->imageEnd = alignUp(L->relocAddr + relocUpper, 0x1000);

        /* resolve import record addresses now that both regions exist */
        if (imps != null)
        {
            for (usize i = 0; i < imps->recs.count(); i++)
            {
                ImportRec* r = imps->recs.atPtr(i);
                r->iatAddr = L->idataAddr + r->iatAddr;
                r->thunkAddr = L->secs.at((usize)SEC_TEXT).addr + L->thunkOff + (u64)i * 8;
            }
            for (usize d = 0; d < defs->count(); d++)
            {
                GlobalDef* def = defs->atPtr(d);
                if (!def->isImport) continue;
                ImportRec* r = imps->recs.atPtr((usize)def->impIdx);
                def->value = r->thunkAddr;
                def->iatAddr = r->iatAddr;
                def->size = 0;
            }
        }
    }

    if (L->elfDynExe && imps != null)
    {
        u64 pltBase = L->secs.at((usize)SEC_TEXT).addr + L->pltOff;
        u64 gotBase = L->secs.at((usize)SEC_DATA).addr + L->gotOff;
        for (usize i = 0; i < imps->recs.count(); i++)
        {
            ImportRec* r = imps->recs.atPtr(i);
            r->thunkAddr = pltBase + (u64)i * 16;
            r->iatAddr = gotBase + (u64)i * 8;
        }
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            if (def->name.equals("_GLOBAL_OFFSET_TABLE_"))
            {
                def->value = gotBase;
                continue;
            }
            if (!def->isImport || def->impIdx < 0) continue;
            ImportRec* r = imps->recs.atPtr((usize)def->impIdx);
            def->value = r->thunkAddr;
            def->iatAddr = r->iatAddr;
            def->size = 0;
        }
    }

    if (entryAddrSet && outFmt != FMT_RAW)
    {
        bool mapped = false;
        for (usize i = 0; i < SEC_ALLOC_COUNT; i++)
        {
            OutSec* out = L->secs.atPtr(i);
            if ((out->flags & SHF_EXECINSTR) == 0 || out->size == 0) continue;
            if (entryAddr >= out->addr && entryAddr < out->addr + out->size)
            {
                mapped = true;
                break;
            }
        }
        if (!mapped)
        {
            err->pushView("linker: entry address is not in an executable section: ");
            pushHex(err, entryAddr);
            return false;
        }
        L->entry = entryAddr;
    }
    else if (entry.len > 0 && outFmt != FMT_RAW)
    {
        i64 idx = findDef(defs, entry);
        if (idx < 0)
        {
            /* shared objects and DLLs may legitimately have no entry */
            if (outFmt == FMT_ELF_DYN || outFmt == FMT_PE_DLL) return true;
            err->pushView("linker: entry symbol not defined: ");
            err->pushView(entry);
            return false;
        }
        u64 addr = 0;
        if (!defAddress(objs, L, defs->atPtr((usize)idx), &addr, err)) return false;
        L->entry = addr;
    }
    return true;
}
