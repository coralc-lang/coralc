#[[no_drop_all]]
/* resolve.crl for linker
 * Global symbol resolution across all input objects. Precedence:
 * strong definition > COMMON > weak definition. Duplicate strong
 * definitions and undefined strong references are collected into one
 * newline-joined diagnostic. Undefined weak references resolve to 0.
 */

import(lib) std::vec { Vec };
import(lib) std::string { String };
import elf { SHN_UNDEF, SHN_COMMON, STB_LOCAL, STB_GLOBAL, STB_WEAK, STT_SECTION, STT_FILE, STT_FUNC };
import imports { Imports };
import object { ObjFile, Sym };

pub struct GlobalDef
{
    str name;
    usize objIdx;
    usize symIdx;
    u64 value;
    u64 size;
    u64 align;
    u8 bind;
    u8 type;
    u16 shndx;
    bool common;
    u64 commonOff;
    bool isImport;
    i64 impIdx;
    bool viaImp;
    u64 iatAddr;
}

pub i64 findDef(Vec<GlobalDef>* defs, str name)
{
    for (usize i = 0; i < defs->count(); i++)
    {
        if (defs->at(i).name.equals(name)) return (i64)i;
    }
    return -1;
}

void _pushUndef(String* err, Vec<str>* seen, str name)
{
    for (usize i = 0; i < seen->count(); i++)
    {
        if (seen->at(i).equals(name)) return;
    }
    seen->push(name);
}

bool _recordDef(Vec<GlobalDef>* defs, GlobalDef cand, String* err, str objName)
{
    i64 idx = findDef(defs, cand.name);
    if (idx < 0)
    {
        defs->push(cand);
        return true;
    }
    GlobalDef* cur = defs->atPtr((usize)idx);
    if (!cand.common && cand.bind != STB_WEAK)
    {
        if (!cur->common && cur->bind != STB_WEAK)
        {
            err->pushView("linker: multiple definition of ");
            err->pushView(cand.name);
            err->pushView(" (in ");
            err->pushView(objName);
            err->pushView(" and another object)");
            return false;
        }
        cur->objIdx = cand.objIdx;
        cur->symIdx = cand.symIdx;
        cur->value = cand.value;
        cur->size = cand.size;
        cur->bind = cand.bind;
        cur->type = cand.type;
        cur->shndx = cand.shndx;
        cur->common = false;
        return true;
    }
    if (cand.common && !cur->common && cur->bind != STB_WEAK)
        return true;
    if (cand.common && cur->common)
    {
        if (cand.size > cur->size) cur->size = cand.size;
        if (cand.align > cur->align) cur->align = cand.align;
        return true;
    }
    if (cand.common && (!cur->common && cur->bind == STB_WEAK))
    {
        cur->objIdx = cand.objIdx;
        cur->symIdx = cand.symIdx;
        cur->value = 0;
        cur->size = cand.size;
        cur->align = cand.align;
        cur->bind = STB_GLOBAL;
        cur->type = cand.type;
        cur->shndx = SHN_COMMON;
        cur->common = true;
        return true;
    }
    return true;
}

pub bool resolveSyms(Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Imports* imps, String* err)
{
    Vec<str> undefs = Vec<str>::new();
    for (usize o = 0; o < objs->count(); o++)
    {
        ObjFile* obj = objs->atPtr(o);
        for (usize i = 0; i < obj->syms.count(); i++)
        {
            Sym* sym = obj->syms.atPtr(i);
            if (sym->bind == STB_LOCAL) continue;
            if (sym->name.len == 0) continue;
            if (sym->type == STT_SECTION || sym->type == STT_FILE) continue;
            if (sym->shndx == SHN_UNDEF)
            {
                if (sym->bind != STB_WEAK)
                    _pushUndef(err, &undefs, sym->name);
                else if (imps != null && imps->find(sym->name) >= 0)
                    _pushUndef(err, &undefs, sym->name);
                continue;
            }
            GlobalDef cand;
            cand.name = sym->name;
            cand.objIdx = o;
            cand.symIdx = i;
            cand.value = sym->value;
            cand.size = sym->size;
            cand.bind = sym->bind;
            cand.type = sym->type;
            cand.shndx = sym->shndx;
            cand.common = false;
            cand.commonOff = 0;
            cand.align = 1;
            cand.isImport = false;
            cand.impIdx = -1;
            cand.viaImp = false;
            cand.iatAddr = 0;
            if (sym->shndx == SHN_COMMON)
            {
                // for COMMON symbols st_value carries the required alignment
                cand.common = true;
                cand.value = 0;
                if (sym->value != 0) cand.align = sym->value;
            }
            if (!_recordDef(defs, cand, err, obj->name))
            {
                undefs.dispose();
                return false;
            }
        }
    }
    /* leftover undefineds: satisfy from imports when available */
    for (usize i = 0; i < undefs.count(); i++)
    {
        str name = undefs.at(i);
        if (findDef(defs, name) >= 0) continue;
        if (name.equals("_GLOBAL_OFFSET_TABLE_"))
        {
            GlobalDef g;
            g.name = name;
            g.objIdx = 0;
            g.symIdx = 0;
            g.value = 0;
            g.size = 0;
            g.align = 1;
            g.bind = STB_GLOBAL;
            g.type = 0;
            g.shndx = SHN_ABS;
            g.common = false;
            g.commonOff = 0;
            g.isImport = false;
            g.impIdx = -1;
            g.viaImp = false;
            g.iatAddr = 0;
            defs->push(g);
            continue;
        }
        if (imps == null) continue;
        i64 rec = imps->find(name);
        if (rec < 0) continue;
        GlobalDef d;
        d.name = name;
        d.objIdx = 0;
        d.symIdx = 0;
        d.value = 0;
        d.size = 0;
        d.align = 1;
        d.bind = STB_GLOBAL;
        d.type = STT_FUNC;
        d.shndx = SHN_UNDEF;
        d.common = false;
        d.commonOff = 0;
        d.isImport = true;
        d.impIdx = rec;
        d.viaImp = name.startsWith("__imp_");
        d.iatAddr = 0;
        defs->push(d);
    }
    usize missing = 0;
    for (usize i = 0; i < undefs.count(); i++)
        if (findDef(defs, undefs.at(i)) < 0) missing++;
    bool ok = true;
    for (usize i = 0; i < undefs.count(); i++)
    {
        str name = undefs.at(i);
        if (findDef(defs, name) >= 0) continue;
        if (ok)
        {
            err->pushView("linker: undefined symbol");
            if (missing > 1) err->pushView("s");
            err->pushView(": ");
        }
        else
        {
            err->pushView("\n  ");
        }
        err->pushView(name);
        ok = false;
    }
    undefs.dispose();
    return ok;
}
