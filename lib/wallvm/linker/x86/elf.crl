#[[no_drop_all]]
/* elf.crl for linker
 * ELF constants, explicit little-endian byte accessors, and the
 * header/entry writers shared by the 64-bit and 32-bit output paths.
 * Everything here works byte-by-byte - no struct-layout assumptions.
 */

import(lib) std::text::string { String };
import(lib) std::mman { alloc, dealloc };

pub const u8 ELFCLASS32 = 1;
pub const u8 ELFCLASS64 = 2;
pub const u8 ELFDATA2LSB = 1;

pub const u16 ET_REL = 1;
pub const u16 ET_EXEC = 2;
pub const u16 ET_DYN = 3;

pub const u16 EM_386 = 3;
pub const u16 EM_X86_64 = 62;

/* internal output format ids (public OutFmt enum lives in link.crl) */
pub const u8 FMT_ELF_EXE = 0;
pub const u8 FMT_ELF_DYN = 1;
pub const u8 FMT_PE_EXE = 2;
pub const u8 FMT_PE_DLL = 3;
pub const u8 FMT_RAW = 4;

/* dynamic section tags (same numbering for ELF32 and ELF64) */
pub const u32 DT_NULL = 0;
pub const u32 DT_HASH = 4;
pub const u32 DT_STRTAB = 5;
pub const u32 DT_SYMTAB = 6;
pub const u32 DT_RELA = 7;
pub const u32 DT_RELASZ = 8;
pub const u32 DT_RELAENT = 9;
pub const u32 DT_STRSZ = 10;
pub const u32 DT_SYMENT = 11;
pub const u32 DT_REL = 17;
pub const u32 DT_RELSZ = 18;
pub const u32 DT_RELENT = 19;

pub const u32 SHT_NULL = 0;
pub const u32 SHT_PROGBITS = 1;
pub const u32 SHT_SYMTAB = 2;
pub const u32 SHT_STRTAB = 3;
pub const u32 SHT_RELA = 4;
pub const u32 SHT_HASH = 5;
pub const u32 SHT_DYNAMIC = 6;
pub const u32 SHT_NOTE = 7;
pub const u32 SHT_NOBITS = 8;
pub const u32 SHT_REL = 9;
pub const u32 SHT_DYNSYM = 11;

pub const u64 SHF_WRITE = 1;
pub const u64 SHF_ALLOC = 2;
pub const u64 SHF_EXECINSTR = 4;

pub const u16 SHN_UNDEF = 0;
pub const u16 SHN_ABS = 0xfff1;
pub const u16 SHN_COMMON = 0xfff2;

pub const u8 STB_LOCAL = 0;
pub const u8 STB_GLOBAL = 1;
pub const u8 STB_WEAK = 2;

pub const u8 STT_NOTYPE = 0;
pub const u8 STT_OBJECT = 1;
pub const u8 STT_FUNC = 2;
pub const u8 STT_SECTION = 3;
pub const u8 STT_FILE = 4;
pub const u8 STT_COMMON = 5;

pub const u32 PT_LOAD = 1;
pub const u32 PT_DYNAMIC = 2;
pub const u32 PT_GNU_STACK = 0x6474e551;

pub const u32 PF_X = 1;
pub const u32 PF_W = 2;
pub const u32 PF_R = 4;

pub const u32 R_X86_64_64 = 1;
pub const u32 R_X86_64_PC32 = 2;
pub const u32 R_X86_64_PLT32 = 4;
pub const u32 R_X86_64_COPY = 5;
pub const u32 R_X86_64_GLOB_DAT = 6;
pub const u32 R_X86_64_JUMP_SLOT = 7;
pub const u32 R_X86_64_RELATIVE = 8;
pub const u32 R_X86_64_GOTPCREL = 9;
pub const u32 R_X86_64_32 = 10;
pub const u32 R_X86_64_32S = 11;
pub const u32 R_X86_64_PC64 = 24;
pub const u32 R_X86_64_GOTPCRELX = 41;
pub const u32 R_X86_64_REX_GOTPCRELX = 42;

pub const u32 R_386_32 = 1;
pub const u32 R_386_PC32 = 2;
pub const u32 R_386_GOT32 = 3;
pub const u32 R_386_PLT32 = 4;
pub const u32 R_386_COPY = 5;
pub const u32 R_386_GLOB_DAT = 6;
pub const u32 R_386_JUMP_SLOT = 7;
pub const u32 R_386_RELATIVE = 8;

pub const usize EHDR64_SIZE = 64;
pub const usize PHDR64_SIZE = 56;
pub const usize SHDR64_SIZE = 64;
pub const usize SYM64_SIZE = 24;
pub const usize RELA64_SIZE = 24;
pub const usize REL64_SIZE = 16;

pub const usize EHDR32_SIZE = 52;
pub const usize PHDR32_SIZE = 32;
pub const usize SHDR32_SIZE = 40;
pub const usize SYM32_SIZE = 16;
pub const usize RELA32_SIZE = 12;
pub const usize REL32_SIZE = 8;

pub const u32 OUT_NONE = 0xffffffff;

pub bool fits(usize off, usize size, usize total)
{
    if (off > total) return false;
    return size <= total - off;
}

pub u8 leU8(const u8* p) { return p[0]; }

pub u16 leU16(const u8* p)
{
    return (u16)(p[0] | ((u16)p[1] << 8));
}

pub u32 leU32(const u8* p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
}

pub u64 leU64(const u8* p)
{
    return (u64)leU32(p) | ((u64)leU32(p + 4) << 32);
}

pub i64 leI64(const u8* p)
{
    return (i64)leU64(p);
}

pub i32 leI32(const u8* p)
{
    return (i32)leU32(p);
}

pub void putU8(u8* p, u8 v) { p[0] = v; }

pub void putU16(u8* p, u16 v)
{
    p[0] = (u8)(v & 0xff);
    p[1] = (u8)((v >> 8) & 0xff);
}

pub void putU32(u8* p, u32 v)
{
    p[0] = (u8)(v & 0xff);
    p[1] = (u8)((v >> 8) & 0xff);
    p[2] = (u8)((v >> 16) & 0xff);
    p[3] = (u8)((v >> 24) & 0xff);
}

pub void putU64(u8* p, u64 v)
{
    putU32(p, (u32)(v & 0xffffffffu));
    putU32(p + 4, (u32)(v >> 32));
}

pub u64 alignUp(u64 v, u64 a)
{
    if (a <= 1) return v;
    u64 rem = v % a;
    if (rem == 0) return v;
    return v + (a - rem);
}

pub bool strFromTable(const u8* base, usize secOff, usize secSize, usize nameOff, str* out)
{
    if (nameOff >= secSize) return false;
    usize start = secOff + nameOff;
    usize end = secOff + secSize;
    usize i = start;
    while (i < end && base[i] != 0) i++;
    if (i == end) return false;
    *out = str::fromParts(base + start, i - start);
    return true;
}

pub void pushDec(String* s, u64 v)
{
    if (v == 0)
    {
        s->pushChar('0');
        return;
    }
    u8* tmp = alloc<u8>((usize)24);
    usize i = 24;
    while (v > 0)
    {
        i--;
        tmp[i] = (u8)('0' + (v % 10));
        v /= 10;
    }
    s->pushView(str::fromParts(tmp + i, 24 - i));
    dealloc<u8>(tmp);
}

pub void pushHex(String* s, u64 v)
{
    s->pushView("0x");
    if (v == 0)
    {
        s->pushChar('0');
        return;
    }
    u8* tmp = alloc<u8>((usize)17);
    usize i = 17;
    while (v > 0)
    {
        u8 d = (u8)(v & 0xf);
        i--;
        tmp[i] = d < 10 ? (u8)('0' + d) : (u8)('a' + d - 10);
        v >>= 4;
    }
    s->pushView(str::fromParts(tmp + i, 17 - i));
    dealloc<u8>(tmp);
}

pub void writeEhdr64(u8* img, u16 machine, u64 entry, u64 shoff, u16 phnum, u16 shnum, u16 shstrndx)
{
    img[0] = 0x7f;
    img[1] = 'E';
    img[2] = 'L';
    img[3] = 'F';
    img[4] = ELFCLASS64;
    img[5] = ELFDATA2LSB;
    img[6] = 1;
    putU16(img + 16, ET_EXEC);
    putU16(img + 18, machine);
    putU32(img + 20, 1);
    putU64(img + 24, entry);
    putU64(img + 32, (u64)EHDR64_SIZE);
    putU64(img + 40, shoff);
    putU32(img + 48, 0);
    putU16(img + 52, (u16)EHDR64_SIZE);
    putU16(img + 54, (u16)PHDR64_SIZE);
    putU16(img + 56, phnum);
    putU16(img + 58, (u16)SHDR64_SIZE);
    putU16(img + 60, shnum);
    putU16(img + 62, shstrndx);
}

pub void writeEhdr32(u8* img, u16 machine, u64 entry, u64 shoff, u16 phnum, u16 shnum, u16 shstrndx)
{
    img[0] = 0x7f;
    img[1] = 'E';
    img[2] = 'L';
    img[3] = 'F';
    img[4] = ELFCLASS32;
    img[5] = ELFDATA2LSB;
    img[6] = 1;
    putU16(img + 16, ET_EXEC);
    putU16(img + 18, machine);
    putU32(img + 20, 1);
    putU32(img + 24, (u32)entry);
    putU32(img + 28, (u32)EHDR32_SIZE);
    putU32(img + 32, (u32)shoff);
    putU32(img + 36, 0);
    putU16(img + 40, (u16)EHDR32_SIZE);
    putU16(img + 42, (u16)PHDR32_SIZE);
    putU16(img + 44, phnum);
    putU16(img + 46, (u16)SHDR32_SIZE);
    putU16(img + 48, shnum);
    putU16(img + 50, shstrndx);
}

pub void writePhdr64(u8* img, usize idx, u32 type, u32 flags, u64 off, u64 vaddr, u64 filesz, u64 memsz, u64 align)
{
    u8* p = img + EHDR64_SIZE + idx * PHDR64_SIZE;
    putU32(p, type);
    putU32(p + 4, flags);
    putU64(p + 8, off);
    putU64(p + 16, vaddr);
    putU64(p + 24, vaddr);
    putU64(p + 32, filesz);
    putU64(p + 40, memsz);
    putU64(p + 48, align);
}

pub void writePhdr32(u8* img, usize idx, u32 type, u32 flags, u64 off, u64 vaddr, u64 filesz, u64 memsz, u64 align)
{
    u8* p = img + EHDR32_SIZE + idx * PHDR32_SIZE;
    putU32(p, type);
    putU32(p + 4, (u32)off);
    putU32(p + 8, (u32)vaddr);
    putU32(p + 12, (u32)vaddr);
    putU32(p + 16, (u32)filesz);
    putU32(p + 20, (u32)memsz);
    putU32(p + 24, flags);
    putU32(p + 28, (u32)align);
}

pub void writeShdr64(u8* img, usize idx, u32 name, u32 type, u64 flags, u64 addr, u64 off, u64 size, u32 link, u32 info, u64 addralign, u64 entsize)
{
    u8* p = img + idx * SHDR64_SIZE;
    putU32(p, name);
    putU32(p + 4, type);
    putU64(p + 8, flags);
    putU64(p + 16, addr);
    putU64(p + 24, off);
    putU64(p + 32, size);
    putU32(p + 40, link);
    putU32(p + 44, info);
    putU64(p + 48, addralign);
    putU64(p + 56, entsize);
}

pub void writeShdr32(u8* img, usize idx, u32 name, u32 type, u64 flags, u64 addr, u64 off, u64 size, u32 link, u32 info, u64 addralign, u64 entsize)
{
    u8* p = img + idx * SHDR32_SIZE;
    putU32(p, name);
    putU32(p + 4, type);
    putU32(p + 8, (u32)flags);
    putU32(p + 12, (u32)addr);
    putU32(p + 16, (u32)off);
    putU32(p + 20, (u32)size);
    putU32(p + 24, link);
    putU32(p + 28, info);
    putU32(p + 32, (u32)addralign);
    putU32(p + 36, (u32)entsize);
}

pub void writeSym64(u8* img, usize off, u32 name, u8 info, u8 other, u16 shndx, u64 value, u64 size)
{
    u8* p = img + off;
    putU32(p, name);
    p[4] = info;
    p[5] = other;
    putU16(p + 6, shndx);
    putU64(p + 8, value);
    putU64(p + 16, size);
}

pub void writeSym32(u8* img, usize off, u32 name, u8 info, u8 other, u16 shndx, u64 value, u64 size)
{
    u8* p = img + off;
    putU32(p, name);
    putU32(p + 4, (u32)value);
    putU32(p + 8, (u32)size);
    p[12] = info;
    p[13] = other;
    putU16(p + 14, shndx);
}
