#[[no_drop_all]]
/* shared.crl for linker
 * Reads the exported symbol table of an ELF ET_DYN input (.so) so a
 * dynamic executable can bind undefined references through a PLT/GOT.
 * Section headers are used; all names are slices into the caller's
 * buffer, which must outlive the SharedLib.
 */

import(lib) std::vec { Vec };
import(lib) std::string { String };
import(lib) std::result { Result };
import elf { ELFCLASS64, ELFDATA2LSB, ET_DYN, SHT_DYNAMIC, SHT_DYNSYM, SHT_NOBITS, SHN_UNDEF, STB_GLOBAL, STB_WEAK, STT_SECTION, STT_FILE, STT_TLS, DT_SONAME, SHDR32_SIZE, SHDR64_SIZE, SYM32_SIZE, SYM64_SIZE, fits, leU16, leU32, leU64, strFromTable };

pub struct SharedExport
{
    str name;
    u64 value;
    u64 size;
    u8 bind;
    u8 type;
    u16 shndx;
}

pub struct SharedLib
{
    str name;
    str soname;
    u8 cls;
    u16 machine;
    Vec<SharedExport> exports;

    static SharedLib empty(str name)
    {
        return SharedLib {
            .name = name,
            .soname = name,
            .cls = 0,
            .machine = 0,
            .exports = Vec<SharedExport>::new()
        };
    }

    void dispose() { self.exports.dispose(); }
}

struct DynSec
{
    u32 type;
    u64 off;
    u64 size;
    u32 link;
    u64 entsize;
}

String _libErr(str name, str what)
{
    String s = String::new();
    s.pushView("linker: ");
    s.pushView(name);
    s.pushView(": ");
    s.pushView(what);
    return s;
}

Result<SharedLib, String> _libFail(SharedLib* f, String msg)
{
    f->dispose();
    return Result<SharedLib, String>::Err { .error = msg };
}

str _libBase(str p)
{
    usize i = p.len;
    while (i > 0 && p.ptr[i - 1] != '/') i--;
    return p.slice(i, p.len);
}

pub bool isElfShared(str data)
{
    if (data.len < 18) return false;
    if (data.ptr[0] != 0x7f || data.ptr[1] != 'E' ||
        data.ptr[2] != 'L' || data.ptr[3] != 'F') return false;
    if (data.ptr[4] != 1 && data.ptr[4] != 2) return false;
    return leU16(data.ptr + 16) == ET_DYN;
}

pub i64 sharedFind(SharedLib* lib, str name)
{
    for (usize i = 0; i < lib->exports.count(); i++)
    {
        if (lib->exports.at(i).name.equals(name)) return (i64)i;
    }
    return -1;
}

pub Result<SharedLib, String> parseShared(str name, str data)
{
    SharedLib f = SharedLib::empty(name);
    if (data.len < 16) return _libFail(&f, _libErr(name, "truncated ELF header"));
    if (data.ptr[0] != 0x7f || data.ptr[1] != 'E' ||
        data.ptr[2] != 'L' || data.ptr[3] != 'F')
        return _libFail(&f, _libErr(name, "bad ELF magic"));
    u8 cls = data.ptr[4];
    if (cls != 1 && cls != 2)
        return _libFail(&f, _libErr(name, "bad ELF class"));
    if (data.ptr[5] != ELFDATA2LSB)
        return _libFail(&f, _libErr(name, "not little-endian"));
    bool is64 = cls == ELFCLASS64;
    if (data.len < (is64 ? 64 : 52))
        return _libFail(&f, _libErr(name, "truncated ELF header"));
    if (leU16(data.ptr + 16) != ET_DYN)
        return _libFail(&f, _libErr(name, "not a shared object (ET_DYN expected)"));
    f.cls = cls;
    f.machine = leU16(data.ptr + 18);
    f.soname = _libBase(name);

    u64 shoff;
    u16 shentsize;
    u16 shnum;
    if (is64)
    {
        shoff = leU64(data.ptr + 40);
        shentsize = leU16(data.ptr + 58);
        shnum = leU16(data.ptr + 60);
    }
    else
    {
        shoff = (u64)leU32(data.ptr + 32);
        shentsize = leU16(data.ptr + 46);
        shnum = leU16(data.ptr + 48);
    }
    if (shnum == 0)
        return _libFail(&f, _libErr(name, "extended section counts not supported"));
    u32 want = is64 ? (u32)SHDR64_SIZE : (u32)SHDR32_SIZE;
    if ((u32)shentsize != want)
        return _libFail(&f, _libErr(name, "bad section header entry size"));
    if (!fits((usize)shoff, (usize)shnum * (usize)shentsize, data.len))
        return _libFail(&f, _libErr(name, "section header table out of bounds"));

    Vec<DynSec> secs = Vec<DynSec>::new();
    for (u16 i = 0; i < shnum; i++)
    {
        usize pOff = (usize)shoff + (usize)i * (usize)shentsize;
        str p = data.slice(pOff, pOff + (usize)shentsize);
        DynSec s;
        s.type = leU32(p.ptr + 4);
        if (is64)
        {
            s.off = leU64(p.ptr + 24);
            s.size = leU64(p.ptr + 32);
            s.link = leU32(p.ptr + 40);
            s.entsize = leU64(p.ptr + 56);
        }
        else
        {
            s.off = (u64)leU32(p.ptr + 16);
            s.size = (u64)leU32(p.ptr + 20);
            s.link = leU32(p.ptr + 24);
            s.entsize = (u64)leU32(p.ptr + 36);
        }
        if (s.type != SHT_NOBITS && !fits((usize)s.off, (usize)s.size, data.len))
        {
            secs.dispose();
            String e = _libErr(name, "section out of bounds");
            return _libFail(&f, e);
        }
        secs.push(s);
    }

    i64 dynsymIdx = -1;
    i64 dynIdx = -1;
    for (usize i = 0; i < secs.count(); i++)
    {
        u32 t = secs.at(i).type;
        if (t == SHT_DYNSYM && dynsymIdx < 0) dynsymIdx = (i64)i;
        if (t == SHT_DYNAMIC && dynIdx < 0) dynIdx = (i64)i;
    }
    if (dynsymIdx < 0)
    {
        secs.dispose();
        return _libFail(&f, _libErr(name, "no dynamic symbol table"));
    }
    DynSec* ds = secs.atPtr((usize)dynsymIdx);
    u32 wantSym = is64 ? (u32)SYM64_SIZE : (u32)SYM32_SIZE;
    if (ds->entsize != (u64)wantSym)
    {
        secs.dispose();
        return _libFail(&f, _libErr(name, "bad dynamic symbol entry size"));
    }
    if ((usize)ds->link >= secs.count())
    {
        secs.dispose();
        return _libFail(&f, _libErr(name, "bad dynamic string table link"));
    }
    DynSec* strSec = secs.atPtr((usize)ds->link);
    if (strSec->type != 3)
    {
        secs.dispose();
        return _libFail(&f, _libErr(name, "dynamic symbol link is not a string table"));
    }

    usize n = (usize)(ds->size / ds->entsize);
    for (usize i = 1; i < n; i++)
    {
        usize pOff = (usize)ds->off + i * (usize)ds->entsize;
        str p = data.slice(pOff, pOff + (usize)ds->entsize);
        SharedExport e;
        e.name = str::empty();
        e.value = 0;
        e.size = 0;
        e.bind = 0;
        e.type = 0;
        e.shndx = 0;
        u32 nameOff = leU32(p.ptr);
        if (is64)
        {
            e.bind = (u8)(p.ptr[4] >> 4);
            e.type = (u8)(p.ptr[4] & 0xf);
            e.shndx = leU16(p.ptr + 6);
            e.value = leU64(p.ptr + 8);
            e.size = leU64(p.ptr + 16);
        }
        else
        {
            e.value = (u64)leU32(p.ptr + 4);
            e.size = (u64)leU32(p.ptr + 8);
            e.bind = (u8)(p.ptr[12] >> 4);
            e.type = (u8)(p.ptr[12] & 0xf);
            e.shndx = leU16(p.ptr + 14);
        }
        if (e.shndx == SHN_UNDEF) continue;
        if (e.bind != STB_GLOBAL && e.bind != STB_WEAK) continue;
        if (e.type == STT_SECTION || e.type == STT_FILE || e.type == STT_TLS) continue;
        if (!strFromTable(data, (usize)strSec->off, (usize)strSec->size, (usize)nameOff, &e.name))
        {
            secs.dispose();
            return _libFail(&f, _libErr(name, "bad dynamic symbol name"));
        }
        if (e.name.len == 0) continue;
        f.exports.push(e);
    }

    if (dynIdx >= 0)
    {
        DynSec* dy = secs.atPtr((usize)dynIdx);
        if ((usize)dy->link < secs.count())
        {
            DynSec* dstr = secs.atPtr((usize)dy->link);
            u64 ent = is64 ? 16 : 8;
            if (dy->entsize != 0) ent = dy->entsize;
            usize nd = (usize)(dy->size / ent);
            for (usize i = 0; i < nd; i++)
            {
                usize pOff = (usize)dy->off + i * (usize)ent;
                str p = data.slice(pOff, pOff + (usize)ent);
                u64 tag = is64 ? leU64(p.ptr) : (u64)leU32(p.ptr);
                u64 val = is64 ? leU64(p.ptr + 8) : (u64)leU32(p.ptr + 4);
                if (tag != (u64)DT_SONAME) continue;
                str s = str::empty();
                if (strFromTable(data, (usize)dstr->off, (usize)dstr->size, (usize)val, &s) &&
                    s.len > 0)
                    f.soname = s;
                break;
            }
        }
    }

    secs.dispose();
    return Result<SharedLib, String>::Ok { .value = f };
}
