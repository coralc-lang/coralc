#[[no_drop_all]]
/* emit.crl for linker
 * Builds the output image in one pass: headers, segment contents,
 * output symbol table, string tables, section headers. Relocations
 * are applied afterwards by reloc.crl against this buffer.
 */

import(lib) std::vec { Vec };
import(lib) std::string { String };
import(lib) std::mman { alloc, dealloc, copy };
import elf { SHT_SYMTAB, SHT_STRTAB, SHT_NOBITS, SHT_HASH, SHT_DYNAMIC, SHT_DYNSYM, SHT_RELA, SHT_REL, SHT_PROGBITS, SHF_ALLOC, SHF_WRITE, SHF_EXECINSTR, SHN_UNDEF, SHN_ABS, SHN_COMMON, STB_GLOBAL, STT_SECTION, STT_FILE, STT_FUNC, OUT_NONE, EM_X86_64, ET_EXEC, ET_DYN, FMT_ELF_DYN, PT_LOAD, PT_INTERP, PT_DYNAMIC, PT_GNU_STACK, PF_R, PF_W, PF_X, DT_NEEDED, DT_PLTRELSZ, DT_PLTGOT, DT_HASH, DT_STRTAB, DT_SYMTAB, DT_RELA, DT_RELASZ, DT_RELAENT, DT_REL, DT_RELSZ, DT_RELENT, DT_STRSZ, DT_SYMENT, DT_PLTREL, DT_JMPREL, DT_BIND_NOW, DT_NULL, R_X86_64_JUMP_SLOT, R_386_JUMP_SLOT, R_X86_64_RELATIVE, R_386_RELATIVE, SHDR32_SIZE, SHDR64_SIZE, SYM32_SIZE, SYM64_SIZE, alignUp, fits, leU32, leU64, putU32, putU64, writeEhdr64, writeEhdr32, writePhdr64, writePhdr32, writeShdr64, writeShdr32, writeSym64, writeSym32, elfInterp };
import object { ObjFile, Section, Sym };
import resolve { GlobalDef };
import layout { Layout, OutSec, Piece, defAddress, localAddress, SEC_RODATA, SEC_DATA, SEC_BSS };
import imports { Imports, ImportRec, sizeIdata, writeIdata };
import pe { writePeHeaders };

bool _wantLocal(ObjFile* obj, Sym* sym)
{
    if (sym->name.len == 0) return false;
    if (sym->type == STT_SECTION || sym->type == STT_FILE) return false;
    if (sym->shndx == SHN_UNDEF || sym->shndx == SHN_COMMON) return false;
    if ((usize)sym->shndx >= obj->secs.count()) return false;
    if (obj->secs.at((usize)sym->shndx).outIdx == OUT_NONE) return false;
    return true;
}

void _zero(u8* p, usize n)
{
    usize i = 0;
    while (i + 8 <= n)
    {
        putU64(p + i, 0);
        i += 8;
    }
    while (i < n)
    {
        p[i] = 0;
        i++;
    }
}

void _wEhdr(u8* img, bool is64, u16 machine, u16 etype, u64 entry, u64 shoff, u16 phnum, u16 shnum, u16 shstrndx)
{
    if (is64) writeEhdr64(img, machine, etype, entry, shoff, phnum, shnum, shstrndx);
    else writeEhdr32(img, machine, etype, entry, shoff, phnum, shnum, shstrndx);
}

void _wPhdr(u8* img, bool is64, usize idx, u32 type, u32 flags, u64 off, u64 vaddr, u64 filesz, u64 memsz, u64 align)
{
    if (is64) writePhdr64(img, idx, type, flags, off, vaddr, filesz, memsz, align);
    else writePhdr32(img, idx, type, flags, off, vaddr, filesz, memsz, align);
}

void _wShdr(u8* img, bool is64, u64 shoff, usize idx, u32 name, u32 type, u64 flags, u64 addr, u64 off, u64 size, u32 link, u32 info, u64 addralign, u64 entsize)
{
    if (is64) writeShdr64(img + (usize)shoff, idx, name, type, flags, addr, off, size, link, info, addralign, entsize);
    else writeShdr32(img + (usize)shoff, idx, name, type, flags, addr, off, size, link, info, addralign, entsize);
}

void _wSym(u8* img, bool is64, usize off, u32 name, u8 info, u16 shndx, u64 value, u64 size)
{
    if (is64) writeSym64(img, off, name, info, 0, shndx, value, size);
    else writeSym32(img, off, name, info, 0, shndx, value, size);
}

u32 _pushName(String* tbl, str name)
{
    u32 off = (u32)tbl->len;
    tbl->pushView(name);
    tbl->pushChar(0);
    return off;
}

u32 _dynHash(str name)
{
    u32 h = 0;
    for (usize i = 0; i < name.len; i++)
    {
        h = (h << 4) + (u32)name.ptr[i];
        u32 g = h & 0xf0000000u;
        if (g != 0) h = h ^ (g >> 24);
        h = h & ~g;
    }
    return h;
}

void _dynEntry(u8* p, bool is64, u32 tag, u64 value)
{
    if (is64)
    {
        putU64(p, (u64)tag);
        putU64(p + 8, value);
    }
    else
    {
        putU32(p, tag);
        putU32(p + 4, (u32)value);
    }
}

bool _writeDynTables(u8* img, bool is64, Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Layout* L, String* err)
{
    OutSec* ro = L->secs.atPtr(SEC_RODATA);
    OutSec* dat = L->secs.atPtr(SEC_DATA);
    usize dynstrOff = (usize)(ro->offset + L->dynMetaOff);
    u64 symRel = alignUp(L->dynMetaOff + L->dynstrSz, 8);
    u64 hashRel = alignUp(symRel + L->dynsymSz, 8);
    usize dynsymOff = (usize)(ro->offset + symRel);
    usize hashOff = (usize)(ro->offset + hashRel);
    u64 roAddr = ro->addr;
    u64 dynstrAddr = roAddr + L->dynMetaOff;
    u64 dynsymAddr = roAddr + symRel;
    u64 hashAddr = roAddr + hashRel;
    u64 relAddr = roAddr + L->relOff;

    usize nd = defs->count();
    u32* nameOffs = alloc<u32>((usize)(nd > 0 ? nd : 1));
    img[dynstrOff] = 0;
    u32 cur = 1;
    for (usize i = 0; i < nd; i++)
    {
        str n = defs->at(i).name;
        nameOffs[i] = cur;
        copy<u8>(img + dynstrOff + (usize)cur, (u8*)n.ptr, n.len);
        cur += (u32)n.len + 1;
    }

    usize symEnt = is64 ? 24 : 16;
    for (usize i = 0; i < nd; i++)
    {
        GlobalDef* def = defs->atPtr(i);
        u64 value = 0;
        if (!defAddress(objs, L, def, &value, err))
        {
            dealloc<u32>(nameOffs);
            return false;
        }
        u16 shndx = 0;
        if (def->shndx == SHN_ABS) shndx = SHN_ABS;
        else if (def->common) shndx = (u16)(SEC_BSS + 1);
        else if (def->isImport) shndx = 0;
        else
        {
            Section* in = objs->atPtr(def->objIdx)->secs.atPtr((usize)def->shndx);
            shndx = (u16)(in->outIdx + 1);
        }
        _wSym(img, is64, dynsymOff + (i + 1) * symEnt, nameOffs[i],
              (u8)((def->bind << 4) | def->type), shndx, value, def->size);
    }

    u32 nb = (u32)(nd + 1);
    u32* buckets = alloc<u32>((usize)nb);
    u32* chains = alloc<u32>((usize)nb);
    for (usize i = 0; i < (usize)nb; i++) { buckets[i] = 0; chains[i] = 0; }
    for (usize i = 1; i < (usize)nb; i++)
    {
        u32 h = _dynHash(defs->at(i - 1).name) % nb;
        chains[i] = buckets[h];
        buckets[h] = (u32)i;
    }
    putU32(img + hashOff, nb);
    putU32(img + hashOff + 4, nb);
    for (usize i = 0; i < (usize)nb; i++) putU32(img + hashOff + 8 + i * 4, buckets[i]);
    for (usize i = 0; i < (usize)nb; i++)
        putU32(img + hashOff + 8 + (usize)nb * 4 + i * 4, chains[i]);
    dealloc<u32>(buckets);
    dealloc<u32>(chains);

    usize dynOff = (usize)(dat->offset + L->dynOff);
    usize ent = is64 ? 16 : 8;
    usize k = 0;
    _dynEntry(img + dynOff + k * ent, is64, DT_HASH, hashAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_STRTAB, dynstrAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_SYMTAB, dynsymAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_STRSZ, L->dynstrSz); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_SYMENT, (u64)symEnt); k++;
    _dynEntry(img + dynOff + k * ent, is64, is64 ? DT_RELA : DT_REL, relAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, is64 ? DT_RELASZ : DT_RELSZ, L->relSize); k++;
    _dynEntry(img + dynOff + k * ent, is64, is64 ? DT_RELAENT : DT_RELENT, is64 ? 24 : 8); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_NULL, 0); k++;

    dealloc<u32>(nameOffs);
    if ((u64)k * (u64)ent > L->dynSize)
    {
        err->pushView("linker: dynamic table overflow");
        return false;
    }
    return true;
}

pub bool finalizeElfDyn(u8* img, bool is64, Layout* L, Vec<u32>* fixups, usize imgLen, String* err)
{
    usize n = fixups->count();
    if (n == 0) return true;
    OutSec* ro = L->secs.atPtr(SEC_RODATA);
    u64 off = ro->offset + L->relOff;
    usize ent = is64 ? 24 : 8;
    if ((u64)n * (u64)ent > L->relSize || off + (u64)n * (u64)ent > (u64)imgLen)
    {
        err->pushView("linker: RELATIVE relocation table overflow");
        return false;
    }
    for (usize i = 0; i < n; i++)
    {
        u32 f = fixups->at(i);
        u8* p = img + (usize)off + i * ent;
        if (is64)
        {
            u64 a = leU64(img + (usize)f);
            putU64(p, (u64)f);
            putU64(p + 8, (u64)R_X86_64_RELATIVE);
            putU64(p + 16, a);
        }
        else
        {
            putU32(p, f);
            putU32(p + 4, (u32)R_386_RELATIVE);
        }
    }
    return true;
}

bool _writeDynExeTables(u8* img, bool is64, Imports* imps, Layout* L, String* err)
{
    OutSec* ro = L->secs.atPtr(SEC_RODATA);
    OutSec* dat = L->secs.atPtr(SEC_DATA);
    usize dynstrOff = (usize)(ro->offset + L->dynMetaOff);
    u64 symRel = alignUp(L->dynMetaOff + L->dynstrSz, 8);
    u64 hashRel = alignUp(symRel + L->dynsymSz, 8);
    usize dynsymOff = (usize)(ro->offset + symRel);
    usize hashOff = (usize)(ro->offset + hashRel);
    usize relaOff = (usize)(ro->offset + L->relOff);
    u64 dynstrAddr = ro->addr + L->dynMetaOff;
    u64 dynsymAddr = ro->addr + symRel;
    u64 hashAddr = ro->addr + hashRel;
    u64 relAddr = ro->addr + L->relOff;
    u64 gotAddr = dat->addr + L->gotOff;

    Vec<str> libs = Vec<str>::new();
    imps->elfLibs(&libs);
    usize n = imps->count();
    Vec<u32> nameOff = Vec<u32>::new();
    img[dynstrOff] = 0;
    u32 cur = 1;
    for (usize i = 0; i < n; i++)
    {
        str nm = imps->recs.at(i).name;
        nameOff.push(cur);
        copy<u8>(img + dynstrOff + (usize)cur, (u8*)nm.ptr, nm.len);
        cur += (u32)nm.len + 1;
    }
    Vec<u32> libOff = Vec<u32>::new();
    for (usize i = 0; i < libs.count(); i++)
    {
        str nm = libs.at(i);
        libOff.push(cur);
        copy<u8>(img + dynstrOff + (usize)cur, (u8*)nm.ptr, nm.len);
        cur += (u32)nm.len + 1;
    }
    if ((u64)cur != L->dynstrSz)
    {
        libs.dispose(); nameOff.dispose(); libOff.dispose();
        err->pushView("linker: dynamic string table size mismatch");
        return false;
    }

    usize symEnt = is64 ? 24 : 16;
    for (usize i = 0; i < n; i++)
    {
        _wSym(img, is64, dynsymOff + (i + 1) * symEnt, nameOff.at(i),
              (u8)((STB_GLOBAL << 4) | STT_FUNC), 0, 0, 0);
    }

    u32 nb = (u32)(n + 1);
    u32* buckets = alloc<u32>((usize)nb);
    u32* chains = alloc<u32>((usize)nb);
    for (usize i = 0; i < (usize)nb; i++) { buckets[i] = 0; chains[i] = 0; }
    for (usize i = 1; i < (usize)nb; i++)
    {
        u32 h = _dynHash(imps->recs.at(i - 1).name) % nb;
        chains[i] = buckets[h];
        buckets[h] = (u32)i;
    }
    putU32(img + hashOff, nb);
    putU32(img + hashOff + 4, nb);
    for (usize i = 0; i < (usize)nb; i++) putU32(img + hashOff + 8 + i * 4, buckets[i]);
    for (usize i = 0; i < (usize)nb; i++)
        putU32(img + hashOff + 8 + (usize)nb * 4 + i * 4, chains[i]);
    dealloc<u32>(buckets);
    dealloc<u32>(chains);

    usize relEnt = is64 ? 24 : 8;
    for (usize i = 0; i < n; i++)
    {
        ImportRec* r = imps->recs.atPtr(i);
        u8* p = img + relaOff + i * relEnt;
        if (is64)
        {
            putU64(p, r->iatAddr);
            putU64(p + 8, ((u64)(i + 1) << 32) | (u64)R_X86_64_JUMP_SLOT);
            putU64(p + 16, 0);
        }
        else
        {
            putU32(p, (u32)r->iatAddr);
            putU32(p + 4, ((u32)(i + 1) << 8) | R_386_JUMP_SLOT);
        }
    }

    usize dynOff = (usize)(dat->offset + L->dynOff);
    usize ent = is64 ? 16 : 8;
    usize k = 0;
    for (usize i = 0; i < libs.count(); i++)
    {
        _dynEntry(img + dynOff + k * ent, is64, DT_NEEDED, (u64)libOff.at(i)); k++;
    }
    _dynEntry(img + dynOff + k * ent, is64, DT_HASH, hashAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_STRTAB, dynstrAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_SYMTAB, dynsymAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_STRSZ, L->dynstrSz); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_SYMENT, (u64)symEnt); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_PLTGOT, gotAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_JMPREL, relAddr); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_PLTRELSZ, L->relSize); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_PLTREL, is64 ? DT_RELA : DT_REL); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_BIND_NOW, 0); k++;
    _dynEntry(img + dynOff + k * ent, is64, DT_NULL, 0); k++;

    nameOff.dispose();
    libOff.dispose();
    libs.dispose();
    if ((u64)k * (u64)ent > L->dynSize)
    {
        err->pushView("linker: dynamic table overflow");
        return false;
    }
    return true;
}

void _writeDynExeStubs(u8* img, bool is64, Imports* imps, Layout* L)
{
    OutSec* text = L->secs.atPtr(1);
    for (usize i = 0; i < imps->count(); i++)
    {
        ImportRec* r = imps->recs.atPtr(i);
        u64 plt = text->addr + L->pltOff + (u64)i * 16;
        usize off = (usize)(text->offset + L->pltOff + (u64)i * 16);
        img[off] = 0xff;
        img[off + 1] = 0x25;
        if (is64)
        {
            i64 delta = (i64)r->iatAddr - (i64)(plt + 6);
            putU32(img + off + 2, (u32)delta);
        }
        else putU32(img + off + 2, (u32)r->iatAddr);
    }
}

pub bool emitImage(u16 machine, u8 outFmt, bool emitSymtab, Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Layout* L, Imports* imps, u8** outImg, usize* outLen, String* err)
{
    bool is64 = machine == EM_X86_64;
    bool isDyn = outFmt == FMT_ELF_DYN;
    bool isDynExe = L->elfDynExe;
    usize nsec = L->secs.count();
    usize es = is64 ? SYM64_SIZE : SYM32_SIZE;
    usize shdrSize = is64 ? SHDR64_SIZE : SHDR32_SIZE;
    u32 phnum = isDynExe ? 5 : (isDyn ? (L->hasRW ? 4 : 3) : (L->hasRW ? 3 : 2));

    usize nLocal = 0;
    usize strtabLen = 1;
    if (emitSymtab)
    {
        for (usize o = 0; o < objs->count(); o++)
        {
            ObjFile* obj = objs->atPtr(o);
            for (usize i = 0; i < obj->firstGlobal; i++)
            {
                Sym* sym = obj->syms.atPtr(i);
                if (!_wantLocal(obj, sym)) continue;
                nLocal++;
                strtabLen += sym->name.len + 1;
            }
        }
        for (usize d = 0; d < defs->count(); d++)
        {
            strtabLen += defs->at(d).name.len + 1;
        }
    }
    usize nGlobal = emitSymtab ? defs->count() : 0;
    usize nSyms = nLocal + nGlobal;

    String shstr = String::new();
    shstr.pushChar(0);
    Vec<u32> shstrOffs = Vec<u32>::new();
    for (usize i = 0; i < nsec; i++)
        shstrOffs.push(_pushName(&shstr, L->secs.at(i).name));
    u32 offSymtabName = 0;
    u32 offStrtabName = 0;
    if (emitSymtab)
    {
        offSymtabName = _pushName(&shstr, ".symtab");
        offStrtabName = _pushName(&shstr, ".strtab");
    }
    u32 offDynstrName = 0;
    u32 offDynsymName = 0;
    u32 offHashName = 0;
    u32 offRelaName = 0;
    u32 offDynName = 0;
    u32 offInterpName = 0;
    u32 offPltName = 0;
    u32 offGotName = 0;
    if (isDyn)
    {
        offDynstrName = _pushName(&shstr, ".dynstr");
        offDynsymName = _pushName(&shstr, ".dynsym");
        offHashName = _pushName(&shstr, ".hash");
        offRelaName = _pushName(&shstr, is64 ? ".rela.dyn" : ".rel.dyn");
        offDynName = _pushName(&shstr, ".dynamic");
    }
    if (isDynExe)
    {
        offInterpName = _pushName(&shstr, ".interp");
        offPltName = _pushName(&shstr, ".plt");
        offGotName = _pushName(&shstr, ".got.plt");
        offDynstrName = _pushName(&shstr, ".dynstr");
        offDynsymName = _pushName(&shstr, ".dynsym");
        offHashName = _pushName(&shstr, ".hash");
        offRelaName = _pushName(&shstr, is64 ? ".rela.plt" : ".rel.plt");
        offDynName = _pushName(&shstr, ".dynamic");
    }
    u32 offShstrName = _pushName(&shstr, ".shstrtab");

    u64 tailBase = alignUp(L->fileEnd, 8);
    u64 symtabOff = 0;
    u64 strtabOff = 0;
    if (emitSymtab)
    {
        symtabOff = tailBase;
        strtabOff = symtabOff + (u64)nSyms * (u64)es;
    }
    u64 shstrtabOff = emitSymtab ? strtabOff + (u64)strtabLen : tailBase;
    u64 shdrOff = alignUp(shstrtabOff + (u64)shstr.len, 8);
    u64 shnum = 1 + (u64)nsec + (emitSymtab ? 2 : 0) + (isDyn ? 5 : 0) + (isDynExe ? 8 : 0) + 1;
    u64 shstrndx = shnum - 1;
    u64 fileSize = shdrOff + shnum * (u64)shdrSize;
    if (fileSize > 0xffffffffu)
    {
        shstr.free();
        shstrOffs.dispose();
        err->pushView("linker: output image exceeds 4 GiB (M1 limit)");
        return false;
    }

    u8* img = alloc<u8>((usize)fileSize);
    _zero(img, (usize)fileSize);

    _wEhdr(img, is64, machine, isDyn ? ET_DYN : ET_EXEC, L->entry, shdrOff, (u16)phnum, (u16)shnum, (u16)shstrndx);
    u64 base = L->imageBase;
    usize phi = 0;
    if (isDynExe)
    {
        OutSec* ro = L->secs.atPtr(SEC_RODATA);
        u64 ioff = ro->offset + L->interpOff;
        _wPhdr(img, is64, phi, PT_INTERP, PF_R, ioff, base + ioff, L->interpLen, L->interpLen, 1);
        phi++;
    }
    _wPhdr(img, is64, phi, PT_LOAD, PF_R | PF_X, 0, base, L->rxEnd, L->rxEnd, 0x1000);
    phi++;
    if (L->hasRW)
    {
        _wPhdr(img, is64, phi, PT_LOAD, PF_R | PF_W, L->rwOff, base + L->rwOff, L->rwFilesz, L->rwMemsz, 0x1000);
        phi++;
    }
    if (isDyn || isDynExe)
    {
        OutSec* dat = L->secs.atPtr(SEC_DATA);
        u64 dynOff = dat->offset + L->dynOff;
        _wPhdr(img, is64, phi, PT_DYNAMIC, PF_R | PF_W, dynOff, base + dynOff, L->dynSize, L->dynSize, 8);
        phi++;
    }
    _wPhdr(img, is64, phi, PT_GNU_STACK, PF_R | PF_W, 0, 0, 0, 0, 0x10);

    for (usize i = 0; i < nsec; i++)
    {
        OutSec* out = L->secs.atPtr(i);
        if (out->type == SHT_NOBITS || out->size == 0) continue;
        for (usize j = 0; j < out->pieces.count(); j++)
        {
            Piece* p = out->pieces.atPtr(j);
            ObjFile* obj = objs->atPtr(p->objIdx);
            Section* in = obj->secs.atPtr(p->secIdx);
            copy<u8>(img + (usize)out->offset + (usize)p->offset, (u8*)obj->data.ptr + (usize)in->offset, (usize)p->size);
        }
    }

    if (isDyn && !_writeDynTables(img, is64, objs, defs, L, err))
    {
        dealloc<u8>(img);
        shstr.free();
        shstrOffs.dispose();
        return false;
    }
    if (isDynExe)
    {
        OutSec* ro = L->secs.atPtr(SEC_RODATA);
        str ip = elfInterp(is64);
        copy<u8>(img + (usize)(ro->offset + L->interpOff), (u8*)ip.ptr, ip.len);
        img[(usize)(ro->offset + L->interpOff + L->interpLen - 1)] = 0;
        _writeDynExeStubs(img, is64, imps, L);
        if (!_writeDynExeTables(img, is64, imps, L, err))
        {
            dealloc<u8>(img);
            shstr.free();
            shstrOffs.dispose();
            return false;
        }
    }

    if (emitSymtab)
    {
        usize idx = 0;
        usize st = 1;
        for (usize o = 0; o < objs->count(); o++)
        {
            ObjFile* obj = objs->atPtr(o);
            for (usize i = 0; i < obj->firstGlobal; i++)
            {
                Sym* sym = obj->syms.atPtr(i);
                if (!_wantLocal(obj, sym)) continue;
                u32 nameOff = (u32)st;
                copy<u8>(img + (usize)strtabOff + st, (u8*)sym->name.ptr, sym->name.len);
                st += sym->name.len + 1;
                u64 value = 0;
                if (!localAddress(objs, L, o, i, &value, err))
                {
                    dealloc<u8>(img);
                    shstr.free();
                    shstrOffs.dispose();
                    return false;
                }
                Section* in = obj->secs.atPtr((usize)sym->shndx);
                u16 shndx = sym->shndx == SHN_ABS ? SHN_ABS : (u16)(in->outIdx + 1);
                _wSym(img, is64, (usize)symtabOff + idx * es, nameOff, (u8)((sym->bind << 4) | sym->type), shndx, value, sym->size);
                idx++;
            }
        }
        for (usize d = 0; d < defs->count(); d++)
        {
            GlobalDef* def = defs->atPtr(d);
            u64 value = 0;
            if (!defAddress(objs, L, def, &value, err))
            {
                dealloc<u8>(img);
                shstr.free();
                shstrOffs.dispose();
                return false;
            }
            u32 nameOff = (u32)st;
            copy<u8>(img + (usize)strtabOff + st, (u8*)def->name.ptr, def->name.len);
            st += def->name.len + 1;
            u16 shndx;
            if (def->shndx == SHN_ABS) shndx = SHN_ABS;
            else if (def->common) shndx = (u16)(L->bssIdx + 1);
            else
            {
                Section* in = objs->atPtr(def->objIdx)->secs.atPtr((usize)def->shndx);
                shndx = (u16)(in->outIdx + 1);
            }
            _wSym(img, is64, (usize)symtabOff + idx * es, nameOff, (u8)((def->bind << 4) | def->type), shndx, value, def->size);
            idx++;
        }
    }

    copy<u8>(img + (usize)shstrtabOff, (u8*)shstr.ptr, shstr.len);

    usize si = 1;
    for (usize i = 0; i < nsec; i++)
    {
        OutSec* out = L->secs.atPtr(i);
        _wShdr(img, is64, shdrOff, si, shstrOffs.at(i), out->type, out->flags, out->addr, out->offset, out->size, 0, 0, out->align, 0);
        si++;
    }
    if (isDynExe)
    {
        OutSec* ro = L->secs.atPtr(SEC_RODATA);
        OutSec* dat = L->secs.atPtr(SEC_DATA);
        OutSec* text = L->secs.atPtr(1);
        u64 symRel = alignUp(L->dynMetaOff + L->dynstrSz, 8);
        u64 hashRel = alignUp(symRel + L->dynsymSz, 8);
        u64 dynstrOff = ro->offset + L->dynMetaOff;
        u64 dynsymOff = ro->offset + symRel;
        u64 hashOff = ro->offset + hashRel;
        u64 relaOff = ro->offset + L->relOff;
        u64 dynOff = dat->offset + L->dynOff;
        u32 dynstrIdx = (u32)(si + 3);
        u32 dynsymIdx = (u32)(si + 4);
        _wShdr(img, is64, shdrOff, si, offInterpName, SHT_PROGBITS, SHF_ALLOC,
               ro->addr + L->interpOff, ro->offset + L->interpOff, L->interpLen, 0, 0, 1, 0);
        si++;
        _wShdr(img, is64, shdrOff, si, offPltName, SHT_PROGBITS, SHF_ALLOC | SHF_EXECINSTR,
               text->addr + L->pltOff, text->offset + L->pltOff, L->pltSize, 0, 0, 16, 16);
        si++;
        _wShdr(img, is64, shdrOff, si, offGotName, SHT_PROGBITS, SHF_ALLOC | SHF_WRITE,
               dat->addr + L->gotOff, dat->offset + L->gotOff, L->gotSize, 0, 0, 8, 8);
        si++;
        _wShdr(img, is64, shdrOff, si, offDynstrName, SHT_STRTAB, SHF_ALLOC,
               ro->addr + L->dynMetaOff, dynstrOff, L->dynstrSz, 0, 0, 1, 0);
        si++;
        _wShdr(img, is64, shdrOff, si, offDynsymName, SHT_DYNSYM, SHF_ALLOC,
               ro->addr + symRel, dynsymOff, L->dynsymSz, dynstrIdx, 1, 8, is64 ? 24 : 16);
        si++;
        _wShdr(img, is64, shdrOff, si, offHashName, SHT_HASH, SHF_ALLOC,
               ro->addr + hashRel, hashOff, L->hashSz, dynsymIdx, 0, 4, 4);
        si++;
        _wShdr(img, is64, shdrOff, si, offRelaName, is64 ? SHT_RELA : SHT_REL, SHF_ALLOC,
               ro->addr + L->relOff, relaOff, L->relSize, dynsymIdx, 0, 8, is64 ? 24 : 8);
        si++;
        _wShdr(img, is64, shdrOff, si, offDynName, SHT_DYNAMIC, SHF_ALLOC | SHF_WRITE,
               dat->addr + L->dynOff, dynOff, L->dynSize, dynstrIdx, 0, 8, is64 ? 16 : 8);
        si++;
    }
    if (isDyn)
    {
        OutSec* ro = L->secs.atPtr(SEC_RODATA);
        OutSec* dat = L->secs.atPtr(SEC_DATA);
        u64 symRel = alignUp(L->dynMetaOff + L->dynstrSz, 8);
        u64 hashRel = alignUp(symRel + L->dynsymSz, 8);
        u64 dynstrOff = ro->offset + L->dynMetaOff;
        u64 dynsymOff = ro->offset + symRel;
        u64 hashOff = ro->offset + hashRel;
        u64 relaOff = ro->offset + L->relOff;
        u64 dynOff = dat->offset + L->dynOff;
        u32 dynstrIdx = (u32)(si + 0);
        u32 dynsymIdx = (u32)(si + 1);
        _wShdr(img, is64, shdrOff, si, offDynstrName, SHT_STRTAB, SHF_ALLOC,
               ro->addr + L->dynMetaOff, dynstrOff, L->dynstrSz, 0, 0, 1, 0);
        si++;
        _wShdr(img, is64, shdrOff, si, offDynsymName, SHT_DYNSYM, SHF_ALLOC,
               ro->addr + symRel, dynsymOff, L->dynsymSz, dynstrIdx, 1, 8, is64 ? 24 : 16);
        si++;
        _wShdr(img, is64, shdrOff, si, offHashName, SHT_HASH, SHF_ALLOC,
               ro->addr + hashRel, hashOff, L->hashSz, dynsymIdx, 0, 4, 4);
        si++;
        _wShdr(img, is64, shdrOff, si, offRelaName, is64 ? SHT_RELA : SHT_REL, SHF_ALLOC,
               ro->addr + L->relOff, relaOff, L->relSize, dynsymIdx, 0, 8, is64 ? 24 : 8);
        si++;
        _wShdr(img, is64, shdrOff, si, offDynName, SHT_DYNAMIC, SHF_ALLOC | SHF_WRITE,
               dat->addr + L->dynOff, dynOff, L->dynSize, dynstrIdx, 0, 8, is64 ? 16 : 8);
        si++;
    }
    if (emitSymtab)
    {
        _wShdr(img, is64, shdrOff, si, offSymtabName, SHT_SYMTAB, 0, 0, symtabOff, (u64)nSyms * (u64)es, (u32)(si + 1), (u32)nLocal, 8, (u64)es);
        si++;
        _wShdr(img, is64, shdrOff, si, offStrtabName, SHT_STRTAB, 0, 0, strtabOff, (u64)strtabLen, 0, 0, 1, 0);
        si++;
    }
    _wShdr(img, is64, shdrOff, si, offShstrName, SHT_STRTAB, 0, 0, shstrtabOff, (u64)shstr.len, 0, 0, 1, 0);

    shstr.free();
    shstrOffs.dispose();
    *outImg = img;
    *outLen = (usize)fileSize;
    return true;
}


pub bool emitPeImage(u16 machine, bool isDll, u16 subsystem, Vec<ObjFile>* objs, Vec<GlobalDef>* defs, Layout* L, Imports* imps, u8** outImg, usize* outLen, String* err)
{
    bool is64 = machine == EM_X86_64;
    u64 hdrEnd = 0x80 + 4 + 20 + (is64 ? 240 : 224) + 11 * 40;
    u64 fileSize = L->rawEnd;
    if (fileSize < hdrEnd) fileSize = hdrEnd;
    u8* img = alloc<u8>((usize)fileSize);
    _zero(img, (usize)fileSize);
    writePeHeaders(img, is64, isDll, subsystem, L, imps);

    for (usize i = 0; i < L->secs.count(); i++)
    {
        OutSec* out = L->secs.atPtr(i);
        if (out->type == SHT_NOBITS || out->size == 0) continue;
        for (usize j = 0; j < out->pieces.count(); j++)
        {
            Piece* p = out->pieces.atPtr(j);
            ObjFile* obj = objs->atPtr(p->objIdx);
            Section* in = obj->secs.atPtr(p->secIdx);
            copy<u8>(img + (usize)out->offset + (usize)p->offset, (u8*)obj->data.ptr + (usize)in->offset, (usize)p->size);
        }
    }

    if (imps->count() > 0)
    {
        OutSec* text = L->secs.atPtr(1);
        for (usize i = 0; i < imps->count(); i++)
        {
            ImportRec* r = imps->recs.atPtr(i);
            u64 thunk = text->addr + L->thunkOff + (u64)i * 8;
            usize off = (usize)(text->offset + L->thunkOff + (u64)i * 8);
            img[off] = 0xff;
            img[off + 1] = 0x25;
            if (is64)
            {
                i64 delta = (i64)r->iatAddr - (i64)(thunk + 6);
                putU32(img + off + 2, (u32)delta);
            }
            else putU32(img + off + 2, (u32)r->iatAddr);
        }
    }
    if (L->idataSize > 0)
    {
        if (!writeIdata(img, (usize)L->idataOff, L->idataAddr - L->imageBase, is64, imps, err))
        {
            dealloc<u8>(img);
            return false;
        }
    }
    *outImg = img;
    *outLen = (usize)fileSize;
    return true;
}
