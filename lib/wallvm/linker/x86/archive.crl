#[[no_drop_all]]
/* archive.crl for linker
 * Reads Unix ar archives (.a, .lib): member iteration with GNU and
 * BSD name encodings, GNU long-name ("//") tables, and detection of
 * COFF short import members. All names are slices into the caller's
 * buffer; the buffer must outlive the ArFile.
 */

import(lib) std::vec { Vec };
import(lib) std::string { String };
import(lib) std::result { Result };
import elf { fits };

pub struct ArMember
{
    str name;
    usize dataOff;
    usize dataLen;
}

pub struct ArFile
{
    str data;
    Vec<ArMember> members;

    static ArFile empty(str d)
    {
        return ArFile {
            .data = d,
            .members = Vec<ArMember>::new()
        };
    }

    void dispose() { self.members.dispose(); }
}

pub bool isArchive(str data)
{
    if (data.len < 8) return false;
    return data.ptr[0] == '!' && data.ptr[1] == '<' && data.ptr[2] == 'a' &&
           data.ptr[3] == 'r' && data.ptr[4] == 'c' && data.ptr[5] == 'h' &&
           data.ptr[6] == '>' && data.ptr[7] == '\n';
}

String _arErr(str name, str what)
{
    String s = String::new();
    s.pushView("linker: ");
    s.pushView(name);
    s.pushView(": ");
    s.pushView(what);
    return s;
}

/* Space-padded decimal in a fixed field; -1 when invalid. */
i64 _arDec(str p, usize n)
{
    i64 v = 0;
    bool hasAny = false;
    for (usize i = 0; i < n; i++)
    {
        u8 c = p.ptr[i];
        if (c == ' ') { if (hasAny) break; continue; }
        if (c < '0' || c > '9') return -1;
        hasAny = true;
        v = v * 10 + (i64)(c - '0');
    }
    return hasAny ? v : -1;
}

/* True for members that are archive indexes, not linkable content. */
pub bool isIndexMember(str name)
{
    if (name.len == 0) return true;
    if (name.equals("/") || name.equals("//")) return true;
    if (name.equals("/SYM64/")) return true;
    if (name.equals("__SYMDEF") || name.equals("__.SYMDEF")) return true;
    if (name.equals("__.SYMDEF SORTED")) return true;
    return false;
}

pub Result<ArFile, String> parseArchive(str name, str data)
{
    ArFile a = ArFile::empty(data);
    if (!isArchive(data))
    {
        a.dispose();
        return Result<ArFile, String>::Err { .error = _arErr(name, "not an archive (bad magic)") };
    }
    str longTab = str::empty();
    usize pos = 8;
    while (pos + 60 <= data.len)
    {
        str h = data.slice(pos, pos + 60);
        if (h.ptr[58] != '`' || h.ptr[59] != '\n')
        {
            a.dispose();
            return Result<ArFile, String>::Err { .error = _arErr(name, "bad archive member header") };
        }
        i64 msize = _arDec(h.slice(48, 58), 10);
        if (msize < 0 || !fits(pos + 60, (usize)msize, data.len))
        {
            a.dispose();
            return Result<ArFile, String>::Err { .error = _arErr(name, "archive member out of bounds") };
        }
        usize body = pos + 60;
        usize bodyLen = (usize)msize;

        /* name field: cut at NUL, trim trailing spaces */
        usize nfEnd = 0;
        while (nfEnd < 16 && h.ptr[nfEnd] != 0) nfEnd++;
        str hdrName = str::fromParts(h.ptr, nfEnd).trimEnd();

        usize dataOff = body;
        usize dataLen = bodyLen;
        str memberName = hdrName;

        if (hdrName.startsWith("#1/"))
        {
            /* BSD: real name occupies the first N body bytes */
            i64 nameLen = _arDec(h.slice(3, 16), 13);
            if (nameLen < 0 || (usize)nameLen > bodyLen)
            {
                a.dispose();
                return Result<ArFile, String>::Err { .error = _arErr(name, "bad BSD member name") };
            }
            usize rawLen = (usize)nameLen;
            usize cut = 0;
            while (cut < rawLen && data.ptr[body + cut] != 0) cut++;
            memberName = data.slice(body, body + cut);
            dataOff = body + rawLen;
            dataLen = bodyLen - rawLen;
        }
        else if (hdrName.equals("/"))
        {
            /* symbol index member: recorded, skipped by isIndexMember */
        }
        else if (hdrName.equals("//") || hdrName.equals("/SYM64/"))
        {
            if (hdrName.equals("//"))
            {
                longTab = data.slice(body, body + bodyLen);
            }
        }
        else if (hdrName.startsWith("/") && hdrName.len > 1)
        {
            /* GNU long name reference: "/123" into the "//" table */
            i64 off = _arDec(h.slice(1, 16), 15);
            if (off < 0 || longTab.isEmpty() || (usize)off >= longTab.len)
            {
                a.dispose();
                return Result<ArFile, String>::Err { .error = _arErr(name, "bad GNU long name index") };
            }
            usize s = (usize)off;
            usize e = s;
            while (e < longTab.len && longTab.ptr[e] != 0 && longTab.ptr[e] != '\n') e++;
            memberName = longTab.slice(s, e);
        }
        else if (hdrName.endsWith("/"))
        {
            /* GNU simple name with a trailing '/' */
            memberName = hdrName.slice(0, hdrName.len - 1);
        }

        ArMember m;
        m.name = memberName;
        m.dataOff = dataOff;
        m.dataLen = dataLen;
        a.members.push(m);

        pos = body + bodyLen;
        if ((bodyLen & 1) != 0) pos++;
    }
    return Result<ArFile, String>::Ok { .value = a };
}
