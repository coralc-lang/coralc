#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrModule, IrType, IrValue, IrGlobal, IrInst, IrBlock };
import(lib) wallvm::irOps { IrOpcode, IrICmpPred };
import(lib) std::mman { alloc, dealloc };

// String handling in IR
// Provides string constants and string operations.

// String constant - stored in IR as a global with embedded data
pub struct IrString
{
    const u8* data;
    u32 length;
    IrValue* globalValue;
}

// Create a string constant in IR
pub IrString createStringConstant(IrContext* ctx, IrModule* m, str data)
{
    IrString s;
    s.data = (const u8*)data.ptr;
    s.length = (u32)data.len;

    // Create global variable for string
    IrType* i8Ty = ctx->tyInt(8);
    IrType* arrayTy = ctx->tyArray(i8Ty, s.length + 1);
    IrType* globalTy = ctx->tyPtr(arrayTy);

    // Create global
    IrGlobal* glob = ctx->createGlobal(".str", globalTy, true, false, null, 1);

    // Initialize with string data
    IrValue** initVals = alloc<IrValue*>((usize)(s.length + 1));
    for (u32 i = 0; i < s.length; i++)
    {
        initVals[i] = ctx->constInt(i8Ty, data.ptr[i]);
    }
    initVals[s.length] = ctx->constInt(i8Ty, 0);

    IrValue* arrayVal = ctx->constArray(arrayTy, initVals, s.length + 1);
    glob->initVal = arrayVal;
    dealloc<IrValue*>(initVals);

    // Add to module
    m->addGlobal(glob);

    s.globalValue = &glob->base;
    return s;
}

// Create a string pointer (GEP into string constant)
pub IrValue* getStringPointer(IrContext* ctx, IrString* sv, IrBlock* bb)
{
    if (!sv || !sv->globalValue) return null;

    // Create GEP to get pointer to first element
    IrValue** idxOps = alloc<IrValue*>((usize)2);
    idxOps[0] = ctx->constInt(ctx->tyInt(32), 0);
    idxOps[1] = ctx->constInt(ctx->tyInt(32), 0);

    IrInst* gep = ctx->createInst(
        IrOpcode::Gep,
        ctx->tyPtr(ctx->tyInt(8)),
        idxOps,
        2,
        0,
        0
    );
    dealloc<IrValue*>(idxOps);

    bb->addInst(gep);
    return &gep->base;
}

// String comparison operations
pub IrValue* createStringCompare(
    IrContext* ctx,
    IrBlock* bb,
    IrValue* a,
    IrValue* b,
    u32 len
)
{
    IrValue* result = null;

    for (u32 i = 0; i < len; i++)
    {
        IrValue** aIdx = alloc<IrValue*>((usize)1);
        aIdx[0] = ctx->constInt(ctx->tyInt(32), i);
        IrInst* aGep = ctx->createInst(
            IrOpcode::Gep,
            ctx->tyPtr(ctx->tyInt(8)),
            aIdx,
            1,
            0,
            0
        );
        dealloc<IrValue*>(aIdx);
        bb->addInst(aGep);

        IrValue** aLoad = alloc<IrValue*>((usize)1);
        aLoad[0] = &aGep->base;
        IrInst* aVal = ctx->createInst(
            IrOpcode::Load,
            ctx->tyInt(8),
            aLoad,
            1,
            0,
            0
        );
        dealloc<IrValue*>(aLoad);
        bb->addInst(aVal);

        IrValue** bIdx = alloc<IrValue*>((usize)1);
        bIdx[0] = ctx->constInt(ctx->tyInt(32), i);
        IrInst* bGep = ctx->createInst(
            IrOpcode::Gep,
            ctx->tyPtr(ctx->tyInt(8)),
            bIdx,
            1,
            0,
            0
        );
        dealloc<IrValue*>(bIdx);
        bb->addInst(bGep);

        IrValue** bLoad = alloc<IrValue*>((usize)1);
        bLoad[0] = &bGep->base;
        IrInst* bVal = ctx->createInst(
            IrOpcode::Load,
            ctx->tyInt(8),
            bLoad,
            1,
            0,
            0
        );
        dealloc<IrValue*>(bLoad);
        bb->addInst(bVal);

        IrValue** cmpOps = alloc<IrValue*>((usize)2);
        cmpOps[0] = &aVal->base;
        cmpOps[1] = &bVal->base;
        IrInst* cmp = ctx->createInst(
            IrOpcode::ICmp,
            ctx->tyInt(1),
            cmpOps,
            2,
            0,
            0
        );
        cmp->icmpPred = IrICmpPred::Ne;
        dealloc<IrValue*>(cmpOps);
        bb->addInst(cmp);

        if (result == null) {
            result = &cmp->base;
        } else
        {
            IrValue** orOps = alloc<IrValue*>((usize)2);
            orOps[0] = result;
            orOps[1] = &cmp->base;
            IrInst* orInst = ctx->createInst(
                IrOpcode::Or,
                ctx->tyInt(1),
                orOps,
                2,
                0,
                0
            );
            dealloc<IrValue*>(orOps);
            bb->addInst(orInst);
            result = &orInst->base;
        }
    }

    return result;
}

// String copy - returns newly allocated str
pub str stringCopy(str src)
{
    if (src.isEmpty()) return "";
    u8* copy = alloc<u8>((usize)(src.len + 1));
    for (u32 i = 0; i < src.len; i++)
        copy[i] = (u8)src.ptr[i];
    copy[src.len] = 0;
    return str::fromParts(copy, src.len);
}

// String concatenation - returns newly allocated str
pub str stringConcat(str a, str b)
{
    if (a.isEmpty()) return stringCopy(b);
    if (b.isEmpty()) return stringCopy(a);

    u32 totalLen = (u32)(a.len + b.len);
    u8* result = alloc<u8>((usize)(totalLen + 1));
    for (u32 i = 0; i < a.len; i++)
        result[i] = (u8)a.ptr[i];
    for (u32 i = 0; i < b.len; i++)
        result[a.len + i] = (u8)b.ptr[i];
    result[totalLen] = 0;
    return str::fromParts(result, totalLen);
}

// String contains
pub bool stringContains(str haystack, str needle)
{
    if (needle.isEmpty()) return true;
    if (needle.len > haystack.len) return false;

    for (u32 i = 0; i <= haystack.len - needle.len; i++)
    {
        bool found = true;
        for (u32 j = 0; j < needle.len; j++)
        {
            if (haystack.ptr[i + j] != needle.ptr[j]) {
                found = false;
                break;
            }
        }
        if (found) return true;
    }
    return false;
}

// String substring - returns newly allocated str
pub str stringSubstring(str src, u32 start, u32 length)
{
    if (src.isEmpty() || start >= src.len) return "";
    if (start + length > src.len) length = (u32)(src.len - start);

    u8* sub = alloc<u8>((usize)(length + 1));
    for (u32 i = 0; i < length; i++)
        sub[i] = (u8)src.ptr[start + i];
    sub[length] = 0;
    return str::fromParts(sub, length);
}

// String to integer
pub i64 stringToInt(str src)
{
    if (src.isEmpty()) return 0;
    i64 result = 0;
    bool negative = false;
    u32 i = 0;

    if (src.ptr[0] == '-')
    {
        negative = true;
        i = 1;
    }

    while (i < src.len && src.ptr[i] >= '0' && src.ptr[i] <= '9')
    {
        result = result * 10 + (src.ptr[i] - '0');
        i++;
    }

    return negative ? -result : result;
}

// Integer to string - returns newly allocated str
pub str intToString(i64 val)
{
    u8 buf[32];
    u32 i = 30;
    buf[31] = 0;
    bool negative = val < 0;
    if (negative) val = -val;

    if (val == 0) {
        buf[i--] = (u8)'0';
    }
    else {
        while (val > 0 && i > 0)
        {
            buf[i--] = (u8)('0' + (val % 10));
            val /= 10;
        }
    }

    if (negative) buf[i--] = (u8)'-';

    u32 len = 30 - i;
    u8* result = alloc<u8>((usize)(len + 1));
    for (u32 j = 0; j <= len; j++)
        result[j] = buf[i + 1 + j];

    return str::fromParts(result, len);
}
