    { "adc", SZ1,    5,   0x14, 0, NOREG, 1, false, false, false, 0 },
    { "adc", SZ248,  5,   0x15, 0, NOREG, 9, false, false, false, 0 },
    { "adc", SZ1,    3, 0x80, 0, 2,    1, false, false, false, 0 },
    { "adc", SZ248,  3, 0x83, 0, 2,    1, true,  false, false, 0 },
    { "adc", SZ248,  3, 0x81, 0, 2,    9, false, false, false, 0 },
    { "sbb", SZ1248, 1, 0x18, 0, NOREG, 0, false, false, false, 0 },
