    { "clflushopt", SZ1248, 6, 0x0F, 0xAE, 7, 0, false, false, true, 0x66 },
    { "prefetchnta", SZ1248, 6, 0x0F, 0x18, 0, 0, false, false, true, 0 },
    { "prefetcht0",  SZ1248, 6, 0x0F, 0x18, 1, 0, false, false, true, 0 },
    { "prefetcht1",  SZ1248, 6, 0x0F, 0x18, 2, 0, false, false, true, 0 },
    { "prefetcht2",  SZ1248, 6, 0x0F, 0x18, 3, 0, false, false, true, 0 },
    { "invlpg",      SZ1248, 6, 0x0F, 0x01, 7, 0, false, false, true, 0 },
    { "sgdt",        SZ1248, 6, 0x0F, 0x01, 0, 0, false, false, true, 0 },
    { "sidt",        SZ1248, 6, 0x0F, 0x01, 1, 0, false, false, true, 0 },
    { "lgdt",        SZ1248, 6, 0x0F, 0x01, 2, 0, false, false, true, 0 },
    { "lidt",        SZ1248, 6, 0x0F, 0x01, 3, 0, false, false, true, 0 },
    { "smsw",        SZ1248, 6, 0x0F, 0x01, 4, 0, false, false, false, 0 },
    { "sldt",        SZ248,  6, 0x0F, 0x00, 0, 0, false, false, true, 0 },
    { "str",         SZ248,  6, 0x0F, 0x00, 1, 0, false, false, true, 0 },
};

// string instructions: full mnemonic match (movsq must not split into
// mov+s+q), implicit operands. { op, forceW, p66 } — the p66 column is
// the operand-size prefix for the 16-bit form.
struct StrOpRow { str name; u8 op; bool forceW; bool p66; }

static StrOpRow _strOps[] = {
    { "movsb", 0xA4, false, false }, { "movsw", 0xA5, false, true },
    { "movsl", 0xA5, false, false }, { "movsq", 0xA5, true, false },
    { "cmpsb", 0xA6, false, false }, { "cmpsw", 0xA7, false, true },
    { "cmpsl", 0xA7, false, false }, { "cmpsq", 0xA7, true, false },
    { "stosb", 0xAA, false, false }, { "stosw", 0xAB, false, true },
    { "stosl", 0xAB, false, false }, { "stosq", 0xAB, true, false },
    { "lodsb", 0xAC, false, false }, { "lodsw", 0xAD, false, true },
    { "lodsl", 0xAD, false, false }, { "lodsq", 0xAD, true, false },
    { "scasb", 0xAE, false, false }, { "scasw", 0xAF, false, true },
    { "scasl", 0xAF, false, false }, { "scasq", 0xAF, true, false }
};

// MMX: 0F-escaped packed ops on mm0-mm7. AT&T order src, dst — the reg
// field is the destination, rm the source (same shape as FS_R_RM).
struct MmxRow { str name; u8 op; }

static MmxRow _mmxOps[] = {
    { "paddb", 0xFC }, { "paddw", 0xFD }, { "paddd", 0xFE }, { "paddq", 0xD4 },
    { "psubb", 0xF8 }, { "psubw", 0xF9 }, { "psubd", 0xFA }, { "psubq", 0xFB },
    { "paddsb", 0xEC }, { "paddsw", 0xED },
    { "psubsb", 0xE8 }, { "psubsw", 0xE9 },
    { "pmullw", 0xD5 }, { "pmulhw", 0xE5 }, { "pmuludq", 0xF4 },
    { "pand", 0xDB }, { "pandn", 0xDF }, { "por", 0xEB }, { "pxor", 0xEF },
    { "pcmpeqb", 0x74 }, { "pcmpeqw", 0x75 }, { "pcmpeqd", 0x76 },
    { "pcmpgtb", 0x64 }, { "pcmpgtw", 0x65 }, { "pcmpgtd", 0x66 },
    { "pavgw", 0x0E }, { "pavgb", 0x0F },
    { "psllw", 0xF1 }, { "pslld", 0xF2 }, { "psllq", 0xF3 },
    { "psrlw", 0xD1 }, { "psrld", 0xD2 }, { "psrlq", 0xD3 },
    { "psraw", 0xE1 }, { "psrad", 0xE2 },
    { "punpcklbw", 0x60 }, { "punpcklwd", 0x61 }, { "punpckldq", 0x62 },
    { "punpckhbw", 0x68 }, { "punpckhwd", 0x69 }, { "punpckhdq", 0x6A },
    { "packsswb", 0x63 }, { "packssdw", 0x6B }
};

// is the full mnemonic already a complete instruction name? call/sub/mul/
// shl/sal/rol/rcl/sbb/imul/syscall/cbw/cwtl/iretq/cmpxchg8b all END in a
// size-suffix letter but must not be split; likewise the cc families
// jb/jl/jnb/jnl, setb/setl/..., cmovb/cmovl/... carry a condition suffix
// that looks like one.
bool isFullMnem(str mnem)
{
    u32 n = 178;
    for (u32 i = 0; i < n; i++)
    {
        if (_forms[i].base.equals(mnem)) return true;
    }
    if (mnem.len > 1 && mnem.ptr[0] == (u8)'j')
    {
        if (ccOfName(str::fromParts(&mnem.ptr[1], mnem.len - 1)) >= 0) return true;
    }
    if (mnem.len > 3 && mnem.ptr[0] == (u8)'s' && mnem.ptr[1] == (u8)'e' &&
        mnem.ptr[2] == (u8)'t')
    {
        if (ccOfName(str::fromParts(&mnem.ptr[3], mnem.len - 3)) >= 0) return true;
    }
    if (mnem.len > 4 && mnem.ptr[0] == (u8)'c' && mnem.ptr[1] == (u8)'m' &&
        mnem.ptr[2] == (u8)'o' && mnem.ptr[3] == (u8)'v')
    {
        if (ccOfName(str::fromParts(&mnem.ptr[4], mnem.len - 4)) >= 0) return true;
    }
    return false;
}

// split "movl" → base "mov", size 4. "sete"/"jne"/"cmovl" handled by the
// caller's cc table. movzbl-style double-suffix forms are rewritten to
// movzx/movsx bases here.
bool splitMnemonic(str mnem, str* base, u8* size, AsmParseError* err)
{
    // movzXX / movsXX with two size letters (bl/bq/wl/wq)
    if (mnem.len == 6 && (mnem.ptr[0] == (u8)'m') && (mnem.ptr[1] == (u8)'o') &&
        (mnem.ptr[2] == (u8)'v') && (mnem.ptr[3] == (u8)'z' || mnem.ptr[3] == (u8)'s') &&
        (mnem.ptr[4] == (u8)'b' || mnem.ptr[4] == (u8)'w') &&
        (mnem.ptr[5] == (u8)'l' || mnem.ptr[5] == (u8)'q' || mnem.ptr[5] == (u8)'w'))
    {
        u8 srcS = sizeOfSuffix(str::fromParts(&mnem.ptr[4], 1));
        u8 dstS = sizeOfSuffix(str::fromParts(&mnem.ptr[5], 1));
        if (srcS == 0 || dstS == 0 || dstS <= srcS)
        {
            err.msg = "bad movz/movs suffix";
            return false;
        }
        // the table row's size column is the DESTINATION size; the source
        // size rides in the register itself, the matcher checks agreement
        *base = mnem.ptr[3] == (u8)'z' ? "movzx" : "movsx";
        *size = dstS;
        return true;
    }
    if (mnem.equals("movslq"))
    {
        *base = "movsxd";
        *size = 8;
        return true;
    }
    // call/sub/mul/shl/sal/rol/rcl/sbb/imul/syscall/cbw/cwtl/iretq/
    // cmpxchg8b and the cc families jb/setb/cmovl all END in a suffix
    // letter but are complete names — never split those
    if (isFullMnem(mnem))
    {
        *base = mnem;
        *size = 0;
        return true;
    }
    if (mnem.len > 1)
    {
        u8 sz = sizeOfSuffix(str::fromParts(&mnem.ptr[mnem.len - 1], 1));
        if (sz != 0)
        {
            *base = str::fromParts(mnem.ptr, mnem.len - 1);
            *size = sz;
            // gas accepts retq/callq/jmpq/leaveq — the suffix is an
            // explicit-64 alias for the unsuffixed control form; the
            // control rows carry sizeMask 0, so drop back to 0 here
            if (base.equals("ret") || base.equals("call") || base.equals("jmp") ||
                base.equals("leave") || base.equals("hlt") || base.equals("int3") ||
                base.equals("nop") || base.equals("ud2") || base.equals("pause") ||
                base.equals("cqto") || base.equals("cltd") || base.equals("cwtl") ||
                base.equals("cwtd") || base.equals("cbw") || base.equals("cwde") ||
                base.equals("cdqe") || base.equals("iretq") || base.equals("syscall") ||
                base.equals("sysret") || base.equals("cpuid") || base.equals("rdtsc") ||
                base.equals("clc") || base.equals("stc") || base.equals("cmc") ||
                base.equals("cld") || base.equals("std") || base.equals("sahf") ||
                base.equals("lahf") || base.equals("loop") || base.equals("loope") ||
                base.equals("loopne") || base.equals("lfence") || base.equals("mfence") ||
                base.equals("sfence") || base.equals("emms") || base.equals("retq"))
            {
                *size = 0;
            }
            return true;
        }
    }
    *base = mnem;
    *size = 0;
    return true;
}

bool sizeAllowed(u8 mask, u8 size)
{
    // sizeMask 0 = control/no-suffix rows (nop, ret, syscall, ...): they
    // accept only the unsuffixed form, never a sized one
    if (mask == 0) return size == 0;
    if (size == 0) return (mask & 0x01) != 0; // no suffix: accept the unsuffixed forms
    if (size == 1) return (mask & SZ1) != 0;
    if (size == 2) return (mask & SZ2) != 0;
    if (size == 4) return (mask & SZ4) != 0;
    if (size == 8) return (mask & SZ8) != 0;
    return false;
}

bool emitPrefixes(EncodeCtx* ctx, FormRow* row, u8 size)
{
    AsmBytes* out = ctx.out;
    if (row.pfx != 0)
    {
        if (!out.u8b(row.pfx)) return false;
    }
    else if (size == 2)
    {
        if (!out.u8b(0x66)) return false;
    }
    if (ctx.rex.hasAny())
    {
        if (!out.u8b(ctx.rex.byte())) return false;
    }
    return true;
}

// user-written prefixes (lock, rep, repne, data16, data32/addr32) come
// before the instruction's own prefixes and REX
bool emitUserPrefixes(EncodeCtx* ctx, AsmLine* line)
{
    AsmBytes* out = ctx.out;
    if (line.pfxLock) { if (!out.u8b(0xF0)) return false; }
    if (line.pfxRep) { if (!out.u8b(0xF3)) return false; }
    if (line.pfxRepne) { if (!out.u8b(0xF2)) return false; }
    if (line.pfxData16) { if (!out.u8b(0x66)) return false; }
    if (line.pfxData32 || line.pfxAddr32) { if (!out.u8b(0x67)) return false; }
    return true;
}

// segment override bytes ride on operands (%fs:0x10 → 0x64 first). Legacy
// prefixes interleave freely with lock/rep/66/67 but must precede REX;
// one call at the top of matchAndEncode covers every path (AVX/SSE
// return before emitUserPrefixes ever runs, so seg must not live there).
bool emitSegPrefixes(EncodeCtx* ctx, AsmLine* line)
{
    AsmBytes* out = ctx.out;
    for (u32 i = 0; i < line.nops; i++)
    {
        if (line.ops[i].seg != 0)
        {
            if (!out.u8b(line.ops[i].seg)) return false;
        }
    }
    return true;
}

bool emitOpcode(EncodeCtx* ctx, FormRow* row, u8 size)
{
    AsmBytes* out = ctx.out;
    // byte-group rows (88/8A mov, 00-3A ALU, 84 test, F6/F7 unary+imm,
    // FE/FF inc/dec, 86/87 xchg — even single-byte opcodes) encode the
    // non-byte width as op+1. 0F-prefixed rows are excluded: B6/B7
    // (movzx) and friends are distinct ops, not width variants of one
    // row. FS_I/FS_R/FS_REL/FS_NONE never reach this helper.
    // 0F escape rows always emit the second byte, including the 0x00
    // group (sldt/str); zero is a real opcode there, not "absent".
    if (row.op == 0x0F)
    {
        if (!out.u8b(0x0F)) return false;
        return out.u8b(row.op2);
    }
    u8 adj = 0;
    if (size != 1 && row.op2 == 0 && (row.op & 1) == 0 &&
        (row.sig == (u8)FormSig::FS_RM_R || row.sig == (u8)FormSig::FS_R_RM ||
         row.sig == (u8)FormSig::FS_RM || row.sig == (u8)FormSig::FS_RM_I))
    {
        adj = 1;
    }
    if (row.op2 != 0)
    {
        if (!out.u8b(row.op)) return false;
        return out.u8b(row.op2);
    }
    return out.u8b((u8)(row.op + adj));
}

// set REX.B/X/force from the rm operand before prefixes are written —
// ModRM comes after REX, so the high bits must be known in advance
void scanRmRex(EncodeCtx* ctx, AsmOperand* rm, X86Reg* rmReg)
{
    if (rm == null) return;
    if (rm.kind == AsmOpKind::Mem)
    {
        if (!rm.rip)
        {
            if (!rm.base.isEmpty())
            {
                X86Reg* b = lookupReg(rm.base);
                if (b != null && (b.num & 8) != 0) ctx.rex.b = true;
            }
            if (!rm.index.isEmpty())
            {
                X86Reg* x = lookupReg(rm.index);
                if (x != null && (x.num & 8) != 0) ctx.rex.x = true;
            }
        }
    }
    else if (rmReg != null)
    {
        if ((rmReg.num & 8) != 0) ctx.rex.b = true;
        if ((X86RegClass)rmReg.cls == X86RegClass::RcGpr && rmReg.size == 1 && rmReg.needsRex) ctx.rex.force = true;
    }
}

// strip an @PLT/@GOTPCREL tail from a symbol name for reloc purposes —
// defined before every reloc-writing site that feeds it
str stripAt(str s)
{
    for (usize i = 0; i < s.len; i++)
    {
        if (s.ptr[i] == (u8)'@') return str::fromParts(s.ptr, i);
    }
    return s;
}

// a branch to an already-defined label in this section can use the short
// form when it fits — GAS picks EB/7x for backward jumps, and byte-level
// parity with it matters for golden fixtures.
bool sameSectionTarget(EncodeCtx* ctx, str name, i64 addend, i64* target)
{
    if (ctx.obj == null) return false;
    i32 si = asmFindSym(ctx.obj, stripAt(name));
    if (si < 0) return false;
    AsmSymbol* s = &ctx.obj.syms[si];
    if (!s.defined || s.section != ctx.sec) return false;
    *target = (i64)s.value + addend;
    return true;
}

// write ModRM(+SIB+disp) for an rm operand with the given reg field.
// Prefixes/REX are the caller's job and must already be flushed. Symbol
// displacements require %rip and record a PC32 reloc on the object.
// immTail is the number of immediate bytes that follow the displacement
// (0 for most forms); the PC32 addend subtracts them so the reloc lands
// on the next instruction, not after the disp32 field alone.
bool emitRm(EncodeCtx* ctx, AsmOperand* rm, X86Reg* rmReg, u8 regField, u32 immTail, AsmParseError* err)
{
    AsmBytes* out = ctx.out;
    if (rm.kind == AsmOpKind::Mem)
    {
        if (rm.hasSym && !rm.rip)
        {
            err.msg = "symbolic displacement needs %rip";
            return false;
        }
        X86Reg* base = null;
        X86Reg* index = null;
        if (!rm.rip)
        {
            if (!rm.base.isEmpty())
            {
                base = lookupReg(rm.base);
                if (base == null) { err.msg = "bad base register"; return false; }
            }
            if (!rm.index.isEmpty())
            {
                index = lookupReg(rm.index);
                if (index == null) { err.msg = "bad index register"; return false; }
            }
        }
        // rip+sym: the in-place disp holds the addend (disp-4-immTail);
        // the ELF writer zeroes the field, COFF keeps it
        i64 wdisp = rm.disp;
        if (rm.hasSym && rm.rip) wdisp = rm.disp - 4 - (i64)immTail;
        if (!encodeMem(out, base, index, rm.scale, rm.hasDisp || rm.hasSym,
                       wdisp, rm.rip, regField, null, null))
        {
            return false;
        }
        if (rm.hasSym && ctx.obj != null)
        {
            u64 at = out.len >= 4 ? ctx.base + (u64)(out.len - 4) : ctx.base;
            if (!asmAddReloc(ctx.obj, at, stripAt(rm.sym), (u8)AsmRelocKind::RelPc32,
                             rm.disp - 4 - (i64)immTail, ctx.sec))
            {
                err.msg = "too many relocations";
                return false;
            }
        }
        return true;
    }
    if (rmReg == null) { err.msg = "missing rm register"; return false; }
    if ((rmReg.num & 8) != 0) ctx.rex.b = true;
    if ((X86RegClass)rmReg.cls == X86RegClass::RcGpr && rmReg.size == 1 && rmReg.needsRex) ctx.rex.force = true;
    return out.u8b(encodeRegReg(regField, rmReg.num));
}

// write an immediate or a symbol reloc at the current output position.
// $sym immediates become Abs32/Abs64 with the operand's addend.
bool emitImmOrSym(EncodeCtx* ctx, AsmOperand* src, u32 bytes, AsmParseError* err)
{
    AsmBytes* out = ctx.out;
    i64 imm = src != null ? src.imm : 0;
    if (src != null && src.hasSym && ctx.obj != null)
    {
        u64 at = ctx.base + (u64)out.len;
        if (!out.immv(imm, bytes)) return false;
        u8 rk = bytes == 8 ? (u8)AsmRelocKind::RelAbs64 : (u8)AsmRelocKind::RelAbs32;
        if (!asmAddReloc(ctx.obj, at, stripAt(src.sym), rk, imm, ctx.sec))
        {
            err.msg = "too many relocations";
            return false;
        }
        return true;
    }
    return out.immv(imm, bytes);
}

// main encode: line already parsed; base/size resolved; row chosen
bool encodeWithRow(AsmLine* line, FormRow* row, u8 size, EncodeCtx* ctx, AsmParseError* err)
{
    AsmBytes* out = ctx.out;

    // resolve operands
    AsmOperand* src = line.nops > 0 ? &line.ops[0] : null;
    AsmOperand* dst = line.nops > 1 ? &line.ops[1] : null;
    X86Reg* srcReg = null;
    X86Reg* dstReg = null;
    if (src != null && src.kind == AsmOpKind::Reg) srcReg = lookupReg(src.text);
    if (dst != null && dst.kind == AsmOpKind::Reg) dstReg = lookupReg(dst.text);

    // REX.W and operand-class checks. Unsuffixed rm-bearing rows take
    // their width from a GPR operand (gas: `add %rax,%rbx` is 64-bit)
    // and only default to 32-bit when no register decides it.
    if (size == 0 && row.sizeMask != 0 && !row.noW &&
        row.sig != (u8)FormSig::FS_REL && row.sig != (u8)FormSig::FS_NONE &&
        row.sig != (u8)FormSig::FS_I && row.sig != (u8)FormSig::FS_R)
    {
        if (srcReg != null && (X86RegClass)srcReg.cls == X86RegClass::RcGpr)
            size = srcReg.size;
        else if (dstReg != null && (X86RegClass)dstReg.cls == X86RegClass::RcGpr)
            size = dstReg.size;
        else size = 4;
    }
    if (row.forceW || (size == 8 && !row.noW)) ctx.rex.w = true;

    // reg field and rm selection per signature (AT&T order)
    u8 regField = 0;
    AsmOperand* rm = null;
    X86Reg* rmReg = null;

    switch ((FormSig)row.sig)
    {
        FormSig::FS_RM_R => {
            // reg, rm — reg field is the src register, rm is dst
            if (srcReg == null) { err.msg = "expected register operand"; return false; }
            regField = srcReg.num;
            if ((srcReg.num & 8) != 0) ctx.rex.r = true;
            if (srcReg.size == 1 && srcReg.needsRex) ctx.rex.force = true;
            rm = dst;
            rmReg = dstReg;
            if (row.ext != NOREG) regField = row.ext;
        },
        FormSig::FS_R_RM => {
            // rm, reg — reg field is the dst register, rm is src
            if (dstReg == null) { err.msg = "expected register operand"; return false; }
            regField = dstReg.num;
            if ((dstReg.num & 8) != 0) ctx.rex.r = true;
            if (dstReg.size == 1 && dstReg.needsRex) ctx.rex.force = true;
            rm = src;
            rmReg = srcReg;
            if (row.ext != NOREG) regField = row.ext;
        },
        FormSig::FS_IMR => {
            // imm, reg, rm — shld/shrd: reg field is the src, rm the dst
            if (line.nops < 3) { err.msg = "missing operands"; return false; }
            X86Reg* sr = line.ops[1].kind == AsmOpKind::Reg ? lookupReg(line.ops[1].text) : null;
            if (sr == null) { err.msg = "expected register operand"; return false; }
            regField = sr.num;
            if ((sr.num & 8) != 0) ctx.rex.r = true;
            rm = &line.ops[2];
            rmReg = rm.kind == AsmOpKind::Reg ? lookupReg(rm.text) : null;
        },
        FormSig::FS_RRM => {
            // imm, rm, reg — three-operand imul: reg field is the dst,
            // rm the src
            if (line.nops < 3) { err.msg = "missing operands"; return false; }
            X86Reg* dr = line.ops[2].kind == AsmOpKind::Reg ? lookupReg(line.ops[2].text) : null;
            if (dr == null) { err.msg = "expected register operand"; return false; }
            regField = dr.num;
            if ((dr.num & 8) != 0) ctx.rex.r = true;
            rm = &line.ops[1];
            rmReg = rm.kind == AsmOpKind::Reg ? lookupReg(rm.text) : null;
        },
        FormSig::FS_RM_I => {
            rm = dst;
            rmReg = dstReg;
            // NOREG means "reg field mirrors the rm register" (imul
            // 6B/69); a digit 0-7 pins the field (ALU 80/81/83 groups)
            regField = row.ext == NOREG ? (rmReg != null ? rmReg.num : 0) : row.ext;
        },
        FormSig::FS_AI => {
            // must be al/ax/eax/rax — enforced by the matcher. No ModRM:
            // opcode + immediate only.
            if (!emitPrefixes(ctx, row, size)) return false;
            if (!out.u8b(row.op)) return false;
            u32 bytes = (u32)(row.immW == 9 ? (size > 4 ? 4 : size) : row.immW);
            return emitImmOrSym(ctx, src, bytes, err);
        },
        FormSig::FS_RM => {
            rm = src;
            rmReg = srcReg;
            regField = row.ext == NOREG ? 0 : row.ext;
        },
        FormSig::FS_R_I | FormSig::FS_R => {
            // B8+r / 50+r: the register goes in the low opcode bits, REX.B
            X86Reg* r = dstReg != null ? dstReg : srcReg;
            if (r == null) { err.msg = "expected register operand"; return false; }
            if ((r.num & 8) != 0) ctx.rex.b = true;
            if (r.size == 1 && r.needsRex) ctx.rex.force = true;

            if (!emitPrefixes(ctx, row, size == 0 ? r.size : size)) return false;
            if (row.sig == (u8)FormSig::FS_R_I)
            {
                i64 imm = src != null ? src.imm : 0;
                bool fitsI32 = imm <= 2147483647 && imm >= -2147483648;
                // byte immediates use B0+r (the B8 group would mean
                // imm32); movq with an imm32-fitting value uses C7 /0
                // (REX.W B8+r is movabs imm64 — a stream desync); only
                // large values promote to B8+r + imm64 like gas does
                if (size == 1)
                {
                    if (!out.u8b((u8)(0xB0 + (r.num & 7)))) return false;
                    return emitImmOrSym(ctx, src, 1, err);
                }
                if (size == 8 && row.immW == 9 && fitsI32)
                {
                    if (!out.u8b(0xC7)) return false;
                    if (!out.u8b((u8)(0xC0 | (r.num & 7)))) return false;
                    return emitImmOrSym(ctx, src, 4, err);
                }
                u8 op = row.op2 != 0 ? row.op2 : row.op;
                if (!out.u8b((u8)(op + (r.num & 7)))) return false;
                u32 bytes = (u32)(row.immW == 9 ? (size == 8 ? 8 : (size == 0 ? 4 : size)) : row.immW);
                return emitImmOrSym(ctx, src, bytes, err);
            }
            if (row.op == 0x0F)
            {
                // bswap-style 0F C8+r
                if (!out.u8b(0x0F)) return false;
                if (!out.u8b((u8)(row.op2 + (r.num & 7)))) return false;
            }
            else
            {
                u8 op = row.op2 != 0 ? row.op2 : row.op;
                if (!out.u8b((u8)(op + (r.num & 7)))) return false;
            }
            return true;
        },
        FormSig::FS_I => {
            if (!emitPrefixes(ctx, row, size == 0 ? 4 : size)) return false;
            if (!out.u8b(row.op)) return false;
            u32 bytes = (u32)(row.immW == 9 ? (size == 0 ? 4 : size) : row.immW);
            return emitImmOrSym(ctx, src, bytes, err);
        },
        FormSig::FS_REL => {
            // relative displacement already validated by the matcher; write
            // opcode + the displacement of the right width. Numeric targets
            // are instruction-start-relative and adjusted by the caller's
            // intercept arms; this row remains for completeness.
            if (!out.u8b(row.op)) return false;
            return out.immv(src != null ? src.imm : 0, (u32)(row.immW == 9 ? 4 : row.immW));
        },
        FormSig::FS_NONE => {
            // mandatory prefix first (pause = F3 90), then the bytes.
            // special multi-byte rows (cqto = REX.W + 0x99) carry op2 as
            // a full second byte, not a 0F escape: detect by op2 != 0 and
            // op not being the 0F escape
            if (row.pfx != 0)
            {
                if (!out.u8b(row.pfx)) return false;
            }
            if (row.op == 0x0F)
            {
                if (!out.u8b(0x0F)) return false;
                return out.u8b(row.op2);
            }
            if (row.op2 != 0)
            {
                // e.g. cqto: emit both bytes verbatim, no extra REX
                if (!out.u8b(row.op)) return false;
                return out.u8b(row.op2);
            }
            return out.u8b(row.op);
        },
        else => { err.msg = "unhandled form signature"; return false; },
    }

    // common tail for the rm-bearing signatures: prefixes, opcode, ModRM,
    // immediate. REX bits for the rm operand are scanned first so the
    // prefix lands before ModRM.
    scanRmRex(ctx, rm, rmReg);
    if (!emitPrefixes(ctx, row, size)) return false;
    if (!emitOpcode(ctx, row, size)) return false;

    if (rm == null) { err.msg = "missing rm operand"; return false; }
    // imm bytes that follow the displacement feed the PC32 addend
    u32 immTail = 0;
    if (row.immW != 0 && row.sig == (u8)FormSig::FS_RM_I)
    {
        if (row.immW == 1) immTail = 1;
        else if (row.immW == 9) immTail = (u32)(size == 0 ? 4 : (size > 4 ? 4 : size));
        else immTail = (u32)row.immW;
    }
    if (!emitRm(ctx, rm, rmReg, regField, immTail, err)) return false;

    // immediate tail
    if (row.immW != 0 && row.sig == (u8)FormSig::FS_RM_I)
    {
        u32 bytes;
        if (row.immW == 1) bytes = 1;
        else if (row.immW == 9) bytes = (u32)(size == 0 ? 4 : (size > 4 ? 4 : size));
        else bytes = (u32)row.immW;
        return emitImmOrSym(ctx, src, bytes, err);
    }
    if (row.immW != 0 && row.sig == (u8)FormSig::FS_IMR)
    {
        return emitImmOrSym(ctx, src, 1, err);
    }
    if (row.immW != 0 && row.sig == (u8)FormSig::FS_RRM)
    {
        u32 bytes = row.immW == 1 ? 1 : ((u32)(row.immW == 9 ? 4 : row.immW));
        return emitImmOrSym(ctx, src, bytes, err);
    }
    return true;
}

// record a PC-relative reloc for a symbolic branch target at the current
// output position, or resolve a backward local reference directly. The
// in-place field holds the addend-4 (reloc is from the disp field, the
// CPU reads from the end of the instruction); `addend` carries a parsed
// sym+N/sym-N expression (`jmp foo+8`).
bool emitSymRel(EncodeCtx* ctx, str symName, i64 addend, u8 kind, AsmParseError* err)
{
    AsmBytes* out = ctx.out;
    if (ctx.obj == null)
    {
        err.msg = "symbolic branch needs an object";
        return false;
    }
    i64 field = addend - 4;
    i32 si = asmFindSym(ctx.obj, symName);
    if (si >= 0)
    {
        AsmSymbol* s = &ctx.obj.syms[si];
        if (s.defined && s.section == ctx.sec)
        {
            i64 disp = (i64)s.value + addend - (i64)(ctx.base + (u64)out.len + 4);
            return out.immv(disp, 4);
        }
    }
    u64 at = ctx.base + (u64)out.len;
    if (!asmAddReloc(ctx.obj, at, symName, kind, field, ctx.sec))
    {
        err.msg = "too many relocations";
        return false;
    }
    return out.immv(field, 4);
}

// '*' marker on a symbolic/numeric branch target: the target names an
// address in MEMORY, not a relative displacement — lower it to a Mem
// operand (rip+symbol per this file's symbolic-mem convention, absolute
// addressing for a plain number) and let the FF /digit row encode it.
// GAS: `call *foo` → FF 15 rel32 (PIE) / FF 14 25 abs32, `call *0x10`
// → FF 14 25 imm32, `jmp *foo` → FF /4 with the same operand shapes.
bool encodeIndirectRel(str base, AsmLine* line, u8 ext, EncodeCtx* ctx, AsmParseError* err)
{
    AsmOperand* t = &line.ops[0];
    AsmOperand m = asmOperandEmpty();
    m.kind = AsmOpKind::Mem;
    if (!t.text.isEmpty())
    {
        m.rip = true;
        m.hasSym = true;
        m.sym = t.text;
    }
    else
    {
        m.hasDisp = true;
        m.disp = t.imm;
    }
    AsmLine tmp = *line;
    tmp.ops[0] = m;
    tmp.nops = 1;
    FormRow row = FormRow { .base = base, .sizeMask = 0, .sig = (u8)FormSig::FS_RM,
                            .op = 0xFF, .op2 = 0, .ext = ext,
                            .immW = 0, .signExtIb = false, .forceW = false,
                            .noW = true, .pfx = 0 };
    return encodeWithRow(&tmp, &row, 0, ctx, err);
}

// match a parsed line against the tables; returns false with err set
pub bool matchAndEncode(AsmLine* line, EncodeCtx* ctx, AsmParseError* err)
{
    AsmBytes* out = ctx.out;
    u64 insnStart = ctx.base + (u64)out.len;

    // %fs:/… overrides first, ahead of every other prefix byte
    if (!emitSegPrefixes(ctx, line)) return false;

    // vector encodings match full mnemonics (vaddpd must not split into
    // vaddp + d) — try the AVX table before any suffix handling
    i32 vr = tryVecTable(line, line.mnem, ctx, err);
    if (vr == 1) return true;
    if (vr == -1) return false;

    // legacy SSE/SSE2/SSE3/SSSE3/SSE4: also full mnemonics (paddb must
    // not split into padd + b), non-VEX forms only
    i32 ssr = trySseTable(line, line.mnem, ctx, err);
    if (ssr == 1) return true;
    if (ssr == -1) return false;

    // string instructions on the full mnemonic: movsq must not split
    // into mov + s + q. Implicit operands; rep/repne ride the prefix
    // flags the parser captured.
    u32 nstr = 20;
    for (u32 i = 0; i < nstr; i++)
    {
        if (_strOps[i].name.equals(line.mnem))
        {
            if (line.nops != 0)
            {
                err.msg = "string instruction takes no operands";
                return false;
            }
            if (!emitUserPrefixes(ctx, line)) return false;
            if (_strOps[i].p66) { if (!out.u8b(0x66)) return false; }
            if (_strOps[i].forceW)
            {
                X86Rex rex = X86Rex::new();
                rex.w = true;
                if (!out.u8b(rex.byte())) return false;
            }
            return out.u8b(_strOps[i].op);
        }
    }

    // MMX packed ops on mm0-mm7: full-name match before suffix splitting
    // (movq must not split into mov + q and hit the GPR table). AT&T
    // order src, dst — the reg field is the destination.
    if (line.mnem.equals("movq") && line.nops == 2)
    {
        AsmOperand* s0 = &line.ops[0];
        AsmOperand* d0 = &line.ops[1];
        if (d0.kind == AsmOpKind::Reg && s0.kind == AsmOpKind::Reg)
        {
            X86Reg* sr = lookupReg(s0.text);
            X86Reg* dr = lookupReg(d0.text);
            bool sMmx = sr != null && (X86RegClass)sr.cls == X86RegClass::RcMmx;
            bool dMmx = dr != null && (X86RegClass)dr.cls == X86RegClass::RcMmx;
            if (sMmx && dMmx)
            {
                if (!emitUserPrefixes(ctx, line)) return false;
                if (!out.u8b(0x0F) || !out.u8b(0x6F)) return false;
                return out.u8b(encodeRegReg(dr.num & 7, sr.num & 7));
            }
        }
        else if (d0.kind == AsmOpKind::Reg)
        {
            X86Reg* dr = lookupReg(d0.text);
            if (dr != null && (X86RegClass)dr.cls == X86RegClass::RcMmx && s0.kind == AsmOpKind::Mem)
            {
                X86Reg* b2 = s0.base.isEmpty() ? null : lookupReg(s0.base);
                X86Reg* i2 = s0.index.isEmpty() ? null : lookupReg(s0.index);
                if (!emitUserPrefixes(ctx, line)) return false;
                if (!out.u8b(0x0F) || !out.u8b(0x6F)) return false;
                return encodeMem(out, b2, i2, s0.scale, s0.hasDisp, s0.disp,
                                 s0.rip, dr.num & 7, null, null);
            }
        }
        else if (s0.kind == AsmOpKind::Reg)
        {
            X86Reg* sr = lookupReg(s0.text);
            if (sr != null && (X86RegClass)sr.cls == X86RegClass::RcMmx && d0.kind == AsmOpKind::Mem)
            {
                X86Reg* b2 = d0.base.isEmpty() ? null : lookupReg(d0.base);
                X86Reg* i2 = d0.index.isEmpty() ? null : lookupReg(d0.index);
                if (!emitUserPrefixes(ctx, line)) return false;
                if (!out.u8b(0x0F) || !out.u8b(0x7F)) return false;
                return encodeMem(out, b2, i2, d0.scale, d0.hasDisp, d0.disp,
                                 d0.rip, sr.num & 7, null, null);
            }
        }
    }
    u32 nmmx = 43;
    for (u32 i = 0; i < nmmx; i++)
    {
        if (!_mmxOps[i].name.equals(line.mnem)) continue;
        if (line.nops != 2)
        {
            err.msg = "MMX instruction needs two operands";
            return false;
        }
        AsmOperand* src = &line.ops[0];
        AsmOperand* dst = &line.ops[1];
        if (dst.kind != AsmOpKind::Reg)
        {
            err.msg = "MMX destination must be a register";
            return false;
        }
        X86Reg* dr = lookupReg(dst.text);
        if (dr == null || (X86RegClass)dr.cls != X86RegClass::RcMmx)
        {
            err.msg = "MMX destination must be an mm register";
            return false;
        }
        X86Reg* b2 = null;
        X86Reg* i2 = null;
        u8 regField = dr.num & 7;
        if (src.kind == AsmOpKind::Reg)
        {
            X86Reg* sr = lookupReg(src.text);
            if (sr == null || (X86RegClass)sr.cls != X86RegClass::RcMmx)
            {
                err.msg = "MMX source must be an mm register or memory";
                return false;
            }
            if (!emitUserPrefixes(ctx, line)) return false;
            if (!out.u8b(0x0F) || !out.u8b(_mmxOps[i].op)) return false;
            return out.u8b(encodeRegReg(regField, sr.num & 7));
        }
        if (src.kind != AsmOpKind::Mem)
        {
            err.msg = "MMX source must be an mm register or memory";
            return false;
        }
        if (!src.base.isEmpty()) b2 = lookupReg(src.base);
        if (!src.index.isEmpty()) i2 = lookupReg(src.index);
        if (!emitUserPrefixes(ctx, line)) return false;
        if (!out.u8b(0x0F) || !out.u8b(_mmxOps[i].op)) return false;
        return encodeMem(out, b2, i2, src.scale, src.hasDisp, src.disp,
                         src.rip, regField, null, null);
    }
    // emms: 0F 77, no operands
    if (line.mnem.equals("emms") && line.nops == 0)
    {
        if (!emitUserPrefixes(ctx, line)) return false;
        if (!out.u8b(0x0F)) return false;
        return out.u8b(0x77);
    }

    // fences: 0F AE with a fixed reg/rm byte (E8 lfence, F0 mfence, F8 sfence)
    if (line.mnem.equals("lfence") || line.mnem.equals("mfence") || line.mnem.equals("sfence"))
    {
        if (line.nops != 0)
        {
            err.msg = "fence takes no operands";
            return false;
        }
        if (!emitUserPrefixes(ctx, line)) return false;
        if (!out.u8b(0x0F) || !out.u8b(0xAE)) return false;
        if (line.mnem.equals("lfence")) return out.u8b(0xE8);
        if (line.mnem.equals("mfence")) return out.u8b(0xF0);
        return out.u8b(0xF8);
    }

    if (line.mnem.equals("wbnoinvd") && line.nops == 0)
    {
        if (!emitUserPrefixes(ctx, line)) return false;
        if (!out.u8b(0xF3) || !out.u8b(0x0F)) return false;
        return out.u8b(0x09);
    }

    // fixed-opcode system instructions. 0F 01 /digit forms need a third
    // byte the table cannot express; the two-byte ones are listed too so
    // the whole family lives together here.
    if (line.nops == 0)
    {
        u8 sys1 = 0;
        u8 sys2 = 0;
        bool isSys = true;
        if (line.mnem.equals("swapgs")) { sys1 = 0x01; sys2 = 0xF8; }
        else if (line.mnem.equals("monitor")) { sys1 = 0x01; sys2 = 0xC8; }
        else if (line.mnem.equals("mwait")) { sys1 = 0x01; sys2 = 0xC9; }
        else if (line.mnem.equals("rdtscp")) { sys1 = 0x01; sys2 = 0xF9; }
        else if (line.mnem.equals("xgetbv")) { sys1 = 0x01; sys2 = 0xD0; }
        else if (line.mnem.equals("clts")) { sys1 = 0x06; sys2 = 0xFF; }
        else if (line.mnem.equals("invd")) { sys1 = 0x08; sys2 = 0xFF; }
        else if (line.mnem.equals("wbinvd")) { sys1 = 0x09; sys2 = 0xFF; }
        else if (line.mnem.equals("wrmsr")) { sys1 = 0x30; sys2 = 0xFF; }
        else if (line.mnem.equals("rdmsr")) { sys1 = 0x32; sys2 = 0xFF; }
        else if (line.mnem.equals("rdpmc")) { sys1 = 0x33; sys2 = 0xFF; }
        else if (line.mnem.equals("sysenter")) { sys1 = 0x34; sys2 = 0xFF; }
        else if (line.mnem.equals("sysexit")) { sys1 = 0x35; sys2 = 0xFF; }
        else if (line.mnem.equals("rsm")) { sys1 = 0xAA; sys2 = 0xFF; }
        else if (line.mnem.equals("xend")) { sys1 = 0x01; sys2 = 0xD5; }
        else if (line.mnem.equals("xtest")) { sys1 = 0x01; sys2 = 0xD6; }
        else if (line.mnem.equals("xsetbv")) { sys1 = 0x01; sys2 = 0xD1; }
        else if (line.mnem.equals("clac")) { sys1 = 0x01; sys2 = 0xCA; }
        else if (line.mnem.equals("stac")) { sys1 = 0x01; sys2 = 0xCB; }
        else if (line.mnem.equals("vmcall")) { sys1 = 0x01; sys2 = 0xC1; }
        else if (line.mnem.equals("vmlaunch")) { sys1 = 0x01; sys2 = 0xC2; }
        else if (line.mnem.equals("vmresume")) { sys1 = 0x01; sys2 = 0xC3; }
        else if (line.mnem.equals("vmxoff")) { sys1 = 0x01; sys2 = 0xC4; }
        else if (line.mnem.equals("serialize")) { sys1 = 0x01; sys2 = 0xE8; }
        else if (line.mnem.equals("pconfig")) { sys1 = 0x01; sys2 = 0xC5; }
        else if (line.mnem.equals("rdpkru")) { sys1 = 0x01; sys2 = 0xEE; }
        else if (line.mnem.equals("wrpkru")) { sys1 = 0x01; sys2 = 0xEF; }
        else if (line.mnem.equals("encls")) { sys1 = 0x01; sys2 = 0xCF; }
        else if (line.mnem.equals("enclu")) { sys1 = 0x01; sys2 = 0xD7; }
        else if (line.mnem.equals("enclv")) { sys1 = 0x01; sys2 = 0xC0; }
        else isSys = false;
        if (isSys)
        {
            if (!emitUserPrefixes(ctx, line)) return false;
            if (!out.u8b(0x0F)) return false;
            if (sys2 == 0xFF) return out.u8b(sys1);
            if (!out.u8b(sys1)) return false;
            return out.u8b(sys2);
        }
    }

    // loop/loope/loopne: E0-E2, rel8 only
    if ((line.mnem.equals("loop") || line.mnem.equals("loope") || line.mnem.equals("loopne")) &&
        line.nops == 1 && line.ops[0].kind == AsmOpKind::Rel && line.ops[0].text.isEmpty())
    {
        u8 op = line.mnem.equals("loop") ? 0xE2 : (line.mnem.equals("loope") ? 0xE1 : 0xE0);
        AsmOperand* lt = &line.ops[0];
        i64 ltarget = lt.dotRel ? (i64)insnStart + lt.imm : lt.imm;
        i64 shortRel = ltarget - (i64)(ctx.base + (u64)out.len) - 2;
        if (shortRel < -128 || shortRel > 127)
        {
            err.msg = "loop target out of range";
            return false;
        }
        if (!emitUserPrefixes(ctx, line)) return false;
        if (!out.u8b(op)) return false;
        return out.u8b((u8)(i8)shortRel);
    }

    // user prefixes land before REX/mandatory prefixes on every legacy path
    if (!emitUserPrefixes(ctx, line)) return false;

    // descriptor-table / task-register group: gas accepts the 16-bit form
    // but encodes it without 66 (the operand is fixed at 16 bits), so
    // canonicalise ax to eax before the generic rm path.
    if (line.nops == 1 &&
        (line.mnem.equals("lldt") || line.mnem.equals("ltr") ||
         line.mnem.equals("verr") || line.mnem.equals("verw") ||
         line.mnem.equals("lmsw")))
    {
        AsmLine tmp = *line;
        if (tmp.ops[0].kind == AsmOpKind::Reg && tmp.ops[0].text.equals("ax"))
            tmp.ops[0].text = str::fromParts((u8*)"eax", 3);
        u8 gext = line.mnem.equals("lldt") ? 2 : (line.mnem.equals("ltr") ? 3 :
                  (line.mnem.equals("verr") ? 4 : (line.mnem.equals("verw") ? 5 : 6)));
        u8 gop2 = line.mnem.equals("lmsw") ? 0x01 : 0x00;
        FormRow grow = FormRow { .base = line.mnem, .sizeMask = SZ48, .sig = (u8)FormSig::FS_RM,
                                 .op = 0x0F, .op2 = gop2, .ext = gext,
                                 .immW = 0, .signExtIb = false, .forceW = false,
                                 .noW = true, .pfx = 0 };
        return encodeWithRow(&tmp, &grow, 0, ctx, err);
    }

    // rdrand/rdseed/rdpid/fsgsbase: one GPR, fixed 0F C7 or 0F AE group
    if (line.nops == 1 && line.ops[0].kind == AsmOpKind::Reg &&
        (line.mnem.equals("rdrand") || line.mnem.equals("rdseed") ||
         line.mnem.equals("rdpid") || line.mnem.equals("rdfsbase") ||
         line.mnem.equals("rdgsbase") || line.mnem.equals("wrfsbase") ||
         line.mnem.equals("wrgsbase")))
    {
        X86Reg* r = lookupReg(line.ops[0].text);
        if (r == null || (X86RegClass)r.cls != X86RegClass::RcGpr)
        {
            err.msg = "expected a general-purpose register";
            return false;
        }
        bool fsgs = line.mnem.equals("rdfsbase") || line.mnem.equals("rdgsbase") ||
                    line.mnem.equals("wrfsbase") || line.mnem.equals("wrgsbase");
        bool f3 = fsgs || line.mnem.equals("rdpid");
        u8 op2 = fsgs ? 0xAE : 0xC7;
        u8 ext = line.mnem.equals("rdrand") ? 6 : (line.mnem.equals("rdseed") ? 7 :
                  (line.mnem.equals("rdpid") ? 7 : (line.mnem.equals("rdfsbase") ? 0 :
                  (line.mnem.equals("rdgsbase") ? 1 : (line.mnem.equals("wrfsbase") ? 2 : 3)))));
        X86Rex rex = X86Rex::new();
        if ((r.num & 8) != 0) rex.b = true;
        if (fsgs && r.size == 8) rex.w = true;
        if (!fsgs && r.size == 8 && !line.mnem.equals("rdpid")) rex.w = true;
        if (f3) { if (!out.u8b(0xF3)) return false; }
        if (rex.w || rex.b) { if (!out.u8b(rex.byte())) return false; }
        if (!out.u8b(0x0F) || !out.u8b(op2)) return false;
        return out.u8b((u8)(0xC0 | (ext << 3) | (r.num & 7)));
    }

    // kmov[bwdq]: VEX 0F 90-93, GPR/memory <-> k register
    if ((line.mnem.equals("kmovb") || line.mnem.equals("kmovw") ||
         line.mnem.equals("kmovd") || line.mnem.equals("kmovq")) && line.nops == 2)
    {
        i32 ki = -1;
        X86Reg* kr = null;
        for (u32 i = 0; i < 2; i++)
        {
            if (line.ops[i].kind != AsmOpKind::Reg) continue;
            X86Reg* r = lookupReg(line.ops[i].text);
            if (r != null && (X86RegClass)r.cls == X86RegClass::RcK) { ki = (i32)i; kr = r; }
        }
        if (ki < 0)
        {
            err.msg = "kmov needs a k register operand";
            return false;
        }
        bool toMask = ki == 1;
        AsmOperand* other = &line.ops[ki == 0 ? 1 : 0];
        bool isMem = other->kind == AsmOpKind::Mem;
        bool isQ = line.mnem.equals("kmovq");
        bool isD = line.mnem.equals("kmovd");
        bool isB = line.mnem.equals("kmovb");
        u8 opc = isMem ? (toMask ? 0x90 : 0x91) : (toMask ? 0x92 : 0x93);
        u8 pp = isB ? 1 : (isD ? 3 : (isQ && !isMem ? 3 : 0));
        bool wbit = isQ;

        AsmBytes tail = AsmBytes::new();
        u8 rexB = 0;
        u8 rexX = 0;
        X86Reg* otherReg = null;
        if (isMem)
        {
            X86Reg* bse = null;
            X86Reg* idx = null;
            if (!other->rip)
            {
                if (other->hasSym) { tail.deinit(); err.msg = "symbolic displacement needs %rip"; return false; }
                if (!other->base.isEmpty())
                {
                    bse = lookupReg(other->base);
                    if (bse == null) { tail.deinit(); err.msg = "bad base register"; return false; }
                }
                if (!other->index.isEmpty())
                {
                    idx = lookupReg(other->index);
                    if (idx == null) { tail.deinit(); err.msg = "bad index register"; return false; }
                }
            }
            i64 wdisp = other->disp;
            if (other->hasSym && other->rip) wdisp = other->disp - 4;
            if (!encodeMem(&tail, bse, idx, other->scale, other->hasDisp || other->hasSym,
                           wdisp, other->rip, kr->num, &rexB, &rexX))
            {
                tail.deinit();
                err.msg = "bad memory operand";
                return false;
            }
        }
        else
        {
            if (other->kind != AsmOpKind::Reg) { tail.deinit(); err.msg = "bad kmov operand"; return false; }
            otherReg = lookupReg(other->text);
            if (otherReg == null || (X86RegClass)otherReg->cls != X86RegClass::RcGpr)
            {
                tail.deinit();
                err.msg = "kmov needs a general-purpose register";
                return false;
            }
            u8 regField = toMask ? kr->num : otherReg->num;
            if (!tail.u8b((u8)(0xC0 | ((regField & 7) << 3) | ((toMask ? otherReg->num : kr->num) & 7))))
            {
                tail.deinit();
                return false;
            }
        }

        X86Vex vx = X86Vex::new();
        vx.mmmmm = 1;
        vx.pp = pp;
        vx.ll = 0;
        vx.w = wbit;
        if (!isMem && toMask) vx.b = (otherReg->num & 8) != 0;
        if (!isMem && !toMask) vx.r = (otherReg->num & 8) != 0;
        if (isMem) { vx.b = rexB != 0; vx.x = rexX != 0; }
        if (!vx.emit(out)) { tail.deinit(); return false; }
        if (!out.u8b(opc)) { tail.deinit(); return false; }
        for (u32 i = 0; i < tail.len; i++)
        {
            if (!out.u8b(tail.data[i])) { tail.deinit(); return false; }
        }
        tail.deinit();
        if (isMem && other->hasSym && other->rip && ctx.obj != null)
        {
            u64 at = ctx.base + (u64)out.len - 4;
            if (!asmAddReloc(ctx.obj, at, stripAt(other->sym), (u8)AsmRelocKind::RelPc32,
                             other->disp - 4, ctx.sec)) return false;
        }
        return true;
    }

    str base;
    u8 size = 0;
    if (!splitMnemonic(line.mnem, &base, &size, err)) return false;

    // jcc / setcc / cmovcc via the condition table
    i32 cc = -1;
    bool isJcc = false;
    bool isSetcc = false;
    bool isCmovcc = false;
    str ccBase = base;
    
    if (base.len > 1 && base.ptr[0] == (u8)'j')
    {
        cc = ccOfName(str::fromParts(base.ptr + 1, base.len - 1));
        if (cc >= 0) isJcc = true;
    }
    if (!isJcc && base.len > 3 && base.ptr[0] == (u8)'s' && base.ptr[1] == (u8)'e' && base.ptr[2] == (u8)'t')
    {
        cc = ccOfName(str::fromParts(base.ptr + 3, base.len - 3));
        if (cc >= 0) isSetcc = true;
    }
    if (!isJcc && !isSetcc && base.len > 4 && base.ptr[0] == (u8)'c' && base.ptr[1] == (u8)'m' &&
        base.ptr[2] == (u8)'o' && base.ptr[3] == (u8)'v')
    {
        cc = ccOfName(str::fromParts(base.ptr + 4, base.len - 4));
        if (cc >= 0) isCmovcc = true;
    }

    if (isJcc)
    {
        if (line.nops != 1 || line.ops[0].kind != AsmOpKind::Rel)
        {
            err.msg = "jcc needs a relative target";
            return false;
        }
        AsmOperand* t = &line.ops[0];
        if (!t.text.isEmpty())
        {
            str nm = stripAt(t.text);
            i64 st = 0;
            if (sameSectionTarget(ctx, nm, t.imm, &st))
            {
                i64 sr = st - (i64)(ctx.base + (u64)out.len) - 2;
                if (sr >= -128 && sr <= 127)
                {
                    if (!out.u8b((u8)(0x70 + cc))) return false;
                    return out.u8b((u8)(i8)sr);
                }
            }
            // near form + PC32 reloc (forward or external)
            if (!out.u8b(0x0F)) return false;
            if (!out.u8b((u8)(0x80 + cc))) return false;
            return emitSymRel(ctx, nm, t.imm, (u8)AsmRelocKind::RelPc32, err);
        }
        i64 target = t.dotRel ? (i64)insnStart + t.imm : t.imm;
        // short form is 2 bytes, near form 6
        i64 shortRel = target - (i64)(ctx.base + (u64)out.len) - 2;
        if (shortRel >= -128 && shortRel <= 127)
        {
            if (!out.u8b((u8)(0x70 + cc))) return false;
            return out.u8b((u8)(i8)shortRel);
        }
        if (!out.u8b(0x0F)) return false;
        if (!out.u8b((u8)(0x80 + cc))) return false;
        return out.immv(target - (i64)(ctx.base + (u64)out.len) - 6, 4);
    }

    if (isSetcc)
    {
        if (line.nops != 1)
        {
            err.msg = "setcc needs one operand";
            return false;
        }
        AsmOperand* op = &line.ops[0];
        AsmBytes tmp = AsmBytes::new();
        EncodeCtx tctx = ctxNew(&tmp, ctx.obj, ctx.sec);
        tctx.base = ctx.base + (u64)ctx.out.len;
        if (op.kind == AsmOpKind::Mem)
        {
            X86Reg* base2 = null;
            X86Reg* index2 = null;
            if (!op.rip)
            {
                if (op.hasSym) { tmp.deinit(); err.msg = "symbolic displacement needs %rip"; return false; }
                if (!op.base.isEmpty())
                {
                    base2 = lookupReg(op.base);
                    if (base2 != null && (base2.num & 8) != 0) tctx.rex.b = true;
                }
                if (!op.index.isEmpty())
                {
                    index2 = lookupReg(op.index);
                    if (index2 != null && (index2.num & 8) != 0) tctx.rex.x = true;
                }
            }
            if (tctx.rex.hasAny())
            {
                if (!tmp.u8b(tctx.rex.byte())) { tmp.deinit(); return false; }
            }
            if (!tmp.u8b(0x0F) || !tmp.u8b((u8)(0x90 + cc)))
            {
                tmp.deinit();
                return false;
            }
            i64 wdisp = op.disp;
            if (op.hasSym && op.rip) wdisp = op.disp - 4;
            if (!encodeMem(&tmp, base2, index2, op.scale, op.hasDisp || op.hasSym,
                           wdisp, op.rip, 0, null, null))
            {
                tmp.deinit();
                return false;
            }
            if (op.hasSym && tctx.obj != null)
            {
                u64 at = tmp.len >= 4 ? tctx.base + (u64)(tmp.len - 4) : tctx.base;
                if (!asmAddReloc(tctx.obj, at, stripAt(op.sym), (u8)AsmRelocKind::RelPc32, op.disp - 4, tctx.sec))
                {
                    tmp.deinit();
                    err.msg = "too many relocations";
                    return false;
                }
            }
        }
        else
        {
            X86Reg* r = lookupReg(op.text);
            if (r == null || (X86RegClass)r.cls != X86RegClass::RcGpr || r.size != 1)
            {
                err.msg = "setcc wants a byte register or memory";
                tmp.deinit();
                return false;
            }
            if ((r.num & 8) != 0) tctx.rex.b = true;
            if (r.needsRex) tctx.rex.force = true;
            if (tctx.rex.hasAny())
            {
                if (!tmp.u8b(tctx.rex.byte())) { tmp.deinit(); return false; }
            }
            if (!tmp.u8b(0x0F) || !tmp.u8b((u8)(0x90 + cc)) || !tmp.u8b(encodeRegReg(0, r.num)))
            {
                tmp.deinit();
                return false;
            }
        }
        for (u32 i = 0; i < tmp.len; i++)
        {
            if (!out.u8b(tmp.data[i])) { tmp.deinit(); return false; }
        }
        tmp.deinit();
        return true;
    }

    if (isCmovcc)
    {
        // 0F 40+cc /r — always 16/32/64, never byte
        if (size == 1 || size == 0) size = 4;
        FormRow row = FormRow { .base = ccBase, .sizeMask = SZ248, .sig = (u8)FormSig::FS_R_RM,
                                .op = 0x0F, .op2 = (u8)(0x40 + cc), .ext = NOREG,
                                .immW = 0, .signExtIb = false, .forceW = false, .noW = false, .pfx = 0 };
        if (size == 8) row.forceW = true;
        return encodeWithRow(line, &row, size, ctx, err);
    }

    // call to a label or a relative target; with the '*' marker the
    // target is loaded from memory instead (FF /2)
    if (base.equals("call") && line.nops == 1 && line.ops[0].kind == AsmOpKind::Rel)
    {
        AsmOperand* t = &line.ops[0];
        if (t.indirect) return encodeIndirectRel(base, line, 2, ctx, err);
        if (!out.u8b(0xE8)) return false;
        if (!t.text.isEmpty())
        {
            return emitSymRel(ctx, stripAt(t.text), t.imm, (u8)AsmRelocKind::RelPlt32, err);
        }
        // numeric target: bare numbers are section offsets, `.±n` is
        // relative to the instruction start; the disp is from the end
        i64 target = t.dotRel ? (i64)insnStart + t.imm : t.imm;
        return out.immv(target - (i64)(ctx.base + (u64)out.len) - 5, 4);
    }

    // jmp: symbol → near + PC32; numeric → short EB when it fits;
    // '*' marker → memory-indirect FF /4
    if (base.equals("jmp") && line.nops == 1 && line.ops[0].kind == AsmOpKind::Rel)
    {
        AsmOperand* t = &line.ops[0];
        if (t.indirect) return encodeIndirectRel(base, line, 4, ctx, err);
        if (!t.text.isEmpty())
        {
            str nm = stripAt(t.text);
            i64 st = 0;
            if (sameSectionTarget(ctx, nm, t.imm, &st))
            {
                i64 sr = st - (i64)(ctx.base + (u64)out.len) - 2;
                if (sr >= -128 && sr <= 127)
                {
                    if (!out.u8b(0xEB)) return false;
                    return out.u8b((u8)(i8)sr);
                }
            }
            if (!out.u8b(0xE9)) return false;
            return emitSymRel(ctx, nm, t.imm, (u8)AsmRelocKind::RelPc32, err);
        }
        i64 target = t.dotRel ? (i64)insnStart + t.imm : t.imm;
        i64 shortRel = target - (i64)(ctx.base + (u64)out.len) - 2;
        if (shortRel >= -128 && shortRel <= 127)
        {
            if (!out.u8b(0xEB)) return false;
            return out.u8b((u8)(i8)shortRel);
        }
        if (!out.u8b(0xE9)) return false;
        return out.immv(target - (i64)(ctx.base + (u64)out.len) - 5, 4);
    }

    // jmp with a plain rm operand (indirect)
    if (base.equals("jmp") && line.nops == 1 && line.ops[0].kind != AsmOpKind::Rel)
    {
        FormRow row = FormRow { .base = base, .sizeMask = SZ1248, .sig = (u8)FormSig::FS_RM,
                                .op = 0xFF, .op2 = 0, .ext = 4,
                                .immW = 0, .signExtIb = false, .forceW = false, .noW = true, .pfx = 0 };
        return encodeWithRow(line, &row, 8, ctx, err);
    }

    // jrcxz/jecxz/jcxz: E3, rel8 only, no near form. Only jrcxz is
    // native in 64-bit mode — jecxz/jcxz need the 0x67 address-size
    // prefix to run the ECX/CX check
    if ((base.equals("jrcxz") || base.equals("jecxz") || base.equals("jcxz")) &&
        line.nops == 1 && line.ops[0].kind == AsmOpKind::Rel && line.ops[0].text.isEmpty())
    {
        bool p67 = !base.equals("jrcxz");
        // 0x67 makes jecxz/jcxz a 3-byte instruction
        AsmOperand* jt = &line.ops[0];
        i64 jtarget = jt.dotRel ? (i64)insnStart + jt.imm : jt.imm;
        i64 shortRel = jtarget - (i64)(ctx.base + (u64)out.len) - (p67 ? 3 : 2);
        if (shortRel < -128 || shortRel > 127)
        {
            err.msg = "jrcxz target out of range";
            return false;
        }
        if (p67)
        {
            if (!out.u8b(0x67)) return false;
        }
        if (!out.u8b(0xE3)) return false;
        return out.u8b((u8)(i8)shortRel);
    }

    // shld/shrd by cl: 0F A5 / 0F AD — reg field is the src, rm the dst
    if ((base.equals("shld") || base.equals("shrd")) && line.nops == 3 &&
        line.ops[0].kind == AsmOpKind::Reg && line.ops[0].text.equals("cl"))
    {
        FormRow row = FormRow { .base = base, .sizeMask = SZ248, .sig = (u8)FormSig::FS_RM_R,
                                .op = 0x0F, .op2 = base.equals("shld") ? (u8)0xA5 : (u8)0xAD,
                                .ext = NOREG, .immW = 0, .signExtIb = false,
                                .forceW = false, .noW = false, .pfx = 0 };
        AsmLine tmp = *line;
        tmp.ops[0] = line.ops[1];
        tmp.ops[1] = line.ops[2];
        tmp.nops = 2;
        return encodeWithRow(&tmp, &row, size, ctx, err);
    }

    // shift by cl / by one: FS_RM rows of shl etc. split on operand.
    // D3 is the by-cl group (D2 is byte-only); D1 by-one, D0 byte by-one
    if (isShiftMnem(base) && line.nops == 2 && line.ops[0].kind == AsmOpKind::Reg &&
        line.ops[0].text.equals("cl"))
    {
        u8 ext = shiftExtOf(base);
        u8 opC = size == 1 ? 0xD2 : 0xD3;
        FormRow row = FormRow { .base = base, .sizeMask = SZ1248, .sig = (u8)FormSig::FS_RM,
                                .op = opC, .op2 = 0, .ext = ext,
                                .immW = 0, .signExtIb = false, .forceW = false, .noW = false, .pfx = 0 };
        AsmLine tmp = *line;
        tmp.ops[0] = line.ops[1];
        tmp.nops = 1;
        return encodeWithRow(&tmp, &row, size, ctx, err);
    }
    if (isShiftMnem(base) && line.nops == 2 && line.ops[0].kind == AsmOpKind::Imm && line.ops[0].imm == 1)
    {
        u8 ext = shiftExtOf(base);
        u8 op1 = size == 1 ? 0xD0 : 0xD1;
        FormRow row = FormRow { .base = base, .sizeMask = SZ1248, .sig = (u8)FormSig::FS_RM,
                                .op = op1, .op2 = 0, .ext = ext,
                                .immW = 0, .signExtIb = false, .forceW = false, .noW = false, .pfx = 0 };
        AsmLine tmp = *line;
        tmp.ops[0] = line.ops[1];
        tmp.nops = 1;
        return encodeWithRow(&tmp, &row, size, ctx, err);
    }

    // xchg with rax/ax/al as one operand: the 90+r short form. Bare
    // xchg takes its width from the other operand (gas: 48 93 for
    // xchg %rax,%rbx); 16-bit needs the 66 prefix.
    if (base.equals("xchg") && line.nops == 2)
    {
        AsmOperand* a = &line.ops[0];
        AsmOperand* b = &line.ops[1];
        bool aIsAx = a.kind == AsmOpKind::Reg && (a.text.equals("rax") ||
                     a.text.equals("eax") || a.text.equals("ax"));
        bool bIsAx = b.kind == AsmOpKind::Reg && (b.text.equals("rax") ||
                     b.text.equals("eax") || b.text.equals("ax"));
        if (aIsAx || bIsAx)
        {
            AsmOperand* other = aIsAx ? b : a;
            X86Reg* r = lookupReg(other.text);
            if (r != null && (X86RegClass)r.cls == X86RegClass::RcGpr)
            {
                u8 xs = size;
                if (xs == 0) xs = aIsAx && bIsAx ? r.size : (aIsAx ? r.size : r.size);
                if (xs != 1)
                {
                    X86Rex rex = X86Rex::new();
                    if (xs == 8) rex.w = true;
                    if ((r.num & 8) != 0) rex.b = true;
                    if (xs == 2) { if (!out.u8b(0x66)) return false; }
                    if (rex.hasAny()) { if (!out.u8b(rex.byte())) return false; }
                    if (!out.u8b((u8)(0x90 + (r.num & 7)))) return false;
                    return true;
                }
            }
        }
    }

    // plain table walk
    u32 nforms = 178;
    for (u32 i = 0; i < nforms; i++)
    {
        FormRow* row = &_forms[i];
        if (!row.base.equals(base)) continue;
        u8 useSize = size;
        if (!sizeAllowed(row.sizeMask, useSize))
        {
            // unsuffixed rows take the operand-implied size
            if (size == 0)
            {
                // infer from a register operand or default 4/8 by sig
                useSize = 0;
                if (line.nops > 0 && line.ops[0].kind == AsmOpKind::Reg)
                {
                    X86Reg* r = lookupReg(line.ops[0].text);
                    if (r != null) useSize = r.size;
                }
                if (useSize == 0 && line.nops > 1 && line.ops[1].kind == AsmOpKind::Reg)
                {
                    X86Reg* r = lookupReg(line.ops[1].text);
                    if (r != null) useSize = r.size;
                }
                if (!sizeAllowed(row.sizeMask, useSize == 0 ? 4 : useSize) &&
                    !sizeAllowed(row.sizeMask, 8))
                {
                    continue;
                }
                if (useSize == 0) useSize = sizeAllowed(row.sizeMask, 8) ? 8 : 4;
            }
            else continue;
        }

        // signature match
        bool sigOk = false;
        switch ((FormSig)row.sig)
        {
            FormSig::FS_NONE => { sigOk = line.nops == 0; },
            FormSig::FS_REL => {
                sigOk = line.nops == 1 && line.ops[0].kind == AsmOpKind::Rel;
            },
            FormSig::FS_AI => {
                if (line.nops != 2 || line.ops[0].kind != AsmOpKind::Imm) sigOk = false;
                else
                {
                    X86Reg* r = lookupReg(line.ops[1].text);
                    u8 want = useSize == 0 ? 4 : useSize;
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr && r.size == want &&
                            (r.num & 7) == 0 && !r.needsRex;
                }
            },
            FormSig::FS_R_I => {
                sigOk = line.nops == 2 && line.ops[0].kind == AsmOpKind::Imm &&
                        line.ops[1].kind == AsmOpKind::Reg;
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[1].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr;
                }
                // sign-ext-imm8 row (6B) only matches fitting immediates
                if (sigOk && row.signExtIb)
                {
                    i64 imm = line.ops[0].imm;
                    sigOk = imm >= -128 && imm <= 127;
                }
            },
            FormSig::FS_R => {
                sigOk = line.nops == 1 && line.ops[0].kind == AsmOpKind::Reg;
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[0].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr;
                }
            },
            FormSig::FS_I => {
                sigOk = line.nops == 1 && line.ops[0].kind == AsmOpKind::Imm;
                if (sigOk && row.signExtIb)
                {
                    i64 imm = line.ops[0].imm;
                    sigOk = imm >= -128 && imm <= 127;
                }
            },
            FormSig::FS_RM => {
                sigOk = line.nops == 1 &&
                        (line.ops[0].kind == AsmOpKind::Reg || line.ops[0].kind == AsmOpKind::Mem);
                if (sigOk && line.ops[0].kind == AsmOpKind::Reg)
                {
                    X86Reg* r = lookupReg(line.ops[0].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr;
                }
            },
            FormSig::FS_RM_R => {
                sigOk = line.nops == 2 && line.ops[0].kind == AsmOpKind::Reg &&
                        (line.ops[1].kind == AsmOpKind::Reg || line.ops[1].kind == AsmOpKind::Mem);
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[0].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr &&
                            (useSize == 0 || r.size == useSize);
                }
            },
            FormSig::FS_R_RM => {
                sigOk = line.nops == 2 &&
                        (line.ops[0].kind == AsmOpKind::Reg || line.ops[0].kind == AsmOpKind::Mem) &&
                        line.ops[1].kind == AsmOpKind::Reg;
                // lea's source must be an address, never a register
                if (sigOk && base.equals("lea") && line.ops[0].kind != AsmOpKind::Mem)
                {
                    sigOk = false;
                }
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[1].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr &&
                            (useSize == 0 || r.size == useSize);
                    // movzx/movsx: source register must be narrower
                    if (sigOk && (base.equals("movzx") || base.equals("movsx")) &&
                        line.ops[0].kind == AsmOpKind::Reg)
                    {
                        X86Reg* s = lookupReg(line.ops[0].text);
                        sigOk = s != null && s.size < r.size;
                    }
                }
            },
            FormSig::FS_RM_I => {
                sigOk = line.nops == 2 && line.ops[0].kind == AsmOpKind::Imm &&
                        (line.ops[1].kind == AsmOpKind::Reg || line.ops[1].kind == AsmOpKind::Mem);
                if (sigOk && row.signExtIb)
                {
                    i64 imm = line.ops[0].imm;
                    sigOk = imm >= -128 && imm <= 127;
                }
                if (sigOk && !row.signExtIb && row.immW == 9 && line.ops[0].kind == AsmOpKind::Imm)
                {
                    // the 81-style row must not steal the ib-sized immediates
                    i64 imm = line.ops[0].imm;
                    if (imm >= -128 && imm <= 127 && (row.op == 0x81 || row.op == 0xC7))
                    {
                        sigOk = false;
                    }
                }
            },
            FormSig::FS_IMR => {
                sigOk = line.nops == 3 && line.ops[0].kind == AsmOpKind::Imm &&
                        line.ops[1].kind == AsmOpKind::Reg &&
                        (line.ops[2].kind == AsmOpKind::Reg || line.ops[2].kind == AsmOpKind::Mem);
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[1].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr &&
                            (useSize == 0 || r.size == useSize);
                }
            },
            FormSig::FS_RRM => {
                sigOk = line.nops == 3 && line.ops[0].kind == AsmOpKind::Imm &&
                        (line.ops[1].kind == AsmOpKind::Reg || line.ops[1].kind == AsmOpKind::Mem) &&
                        line.ops[2].kind == AsmOpKind::Reg;
                if (sigOk)
                {
                    X86Reg* r = lookupReg(line.ops[2].text);
                    sigOk = r != null && (X86RegClass)r.cls == X86RegClass::RcGpr &&
                            (useSize == 0 || r.size == useSize);
                }
                if (sigOk && row.signExtIb)
                {
                    i64 imm = line.ops[0].imm;
                    sigOk = imm >= -128 && imm <= 127;
                }
            },
            else => { sigOk = false; },
        }

        if (!sigOk) continue;
        return encodeWithRow(line, row, useSize, ctx, err);
    }

    err.msg = "no matching instruction form";
    return false;
}

// Public entry: one AT&T source line → bytes, no object context.
// Symbolic operands that need relocs are assembleText's job.
pub bool encodeLine(str src, u32 lineNo, AsmBytes* out, AsmParseError* err)
{
    AsmLine line = AsmLine {};
    if (!parseAttLine(src, lineNo, &line, err)) return false;
    if (line.isEmpty || line.isDirective) return true;
    EncodeCtx ctx = ctxNew(out, null, 1);
    err.lineNo = lineNo;
    return matchAndEncode(&line, &ctx, err);
}

// ------------------------------------------------------------------
// unit assembly: labels, directives, sections. Text goes to obj.text,
// data to obj.data; symbols bind at the current section offset.
// ------------------------------------------------------------------

// section names in compiler output carry suffixes: .rodata.str1.1,
// .text.startup, .data.rel.local — match the family by prefix.
bool secNameStarts(str name, str pre)
{
    if (name.len < pre.len) return false;
    for (usize i = 0; i < pre.len; i++)
    {
        if (name.ptr[i] != pre.ptr[i]) return false;
    }
    return true;
}

// append src onto dst
bool asmAppend(AsmBytes* dst, AsmBytes* src)
{
    for (u32 i = 0; i < src.len; i++)
    {
        if (!dst.u8b(src.data[i])) return false;
    }
    return true;
}

// Output section for an assembler section index: 1 .text, 2 .data,
// 3 .text.hot, 4 .text.cold.
AsmBytes* asmSectionData(AsmObject* obj, i32 sec)
{
    if (sec == 2) return &obj.data.data;
    if (sec == 3) return &obj.hot.data;
    if (sec == 4) return &obj.cold.data;
    return &obj.text.data;
}

void asmSectionBumpAlign(AsmObject* obj, i32 sec, u64 align)
{
    AsmSection* s = &obj.text;
    if (sec == 2) s = &obj.data;
    else if (sec == 3) s = &obj.hot;
    else if (sec == 4) s = &obj.cold;
    if (align > s.align) s.align = align;
}

// executable sections get NOP padding; data gets zeros
bool asmSectionIsText(i32 sec)
{
    return sec != 2;
}

// .byte/.word/.long/.quad payload: comma-separated numbers, symbols, or
// symbol±constant and same-section symbol differences (jump tables).
bool emitDataLitValue(AsmBytes* out, u32 width, u64 v)
{
    if (width == 1) return out.u8b((u8)v);
    if (width == 2) return out.u16b((u16)v);
    if (width == 4) return out.u32b((u32)v);
    return out.u64b(v);
}

bool emitDataLits(AsmLine* line, AsmObject* obj, i32 sec, u32 width, AsmParseError* err)
{
    AsmBytes* out = asmSectionData(obj, sec);
    AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
    while (true)
    {
        lx.skipSpace();
        if (lx.done()) break;
        if (isAlpha(lx.peek()) || lx.peek() == (u8)'_' || lx.peek() == (u8)'.')
        {
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = "bad symbol in data literal"; err.lineNo = line.lineNo; return false; }
            i64 addend = 0;
            bool diff = false;
            lx.skipSpace();
            if (!lx.done() && (lx.peek() == (u8)'+' || lx.peek() == (u8)'-'))
            {
                u8 op = lx.peek();
                lx.pos++;
                lx.skipSpace();
                if (isAlpha(lx.peek()) || lx.peek() == (u8)'_' || lx.peek() == (u8)'.')
                {
                    if (op != (u8)'-')
                    {
                        err.msg = "unsupported symbol sum";
                        err.lineNo = line.lineNo;
                        return false;
                    }
                    str base = lx.lexIdent();
                    if (width != 4)
                    {
                        err.msg = "symbol difference needs .long";
                        err.lineNo = line.lineNo;
                        return false;
                    }
                    i32 bi = asmFindSym(obj, base);
                    if (bi < 0 || !obj.syms[bi].defined || obj.syms[bi].section != sec)
                    {
                        err.msg = "symbol difference needs a defined base in this section";
                        err.lineNo = line.lineNo;
                        return false;
                    }
                    // PC32 relocation against `name`: the field's own offset
                    // minus the base label's offset makes the linker compute
                    // name - base from P (= current section + field offset).
                    u64 field = (u64)out.len;
                    if (!out.u32b(0)) return false;
                    if (!asmAddReloc(obj, field, name, (u8)AsmRelocKind::RelPc32,
                                     (i64)field - (i64)obj.syms[bi].value, sec))
                    {
                        err.msg = "too many relocations";
                        return false;
                    }
                    diff = true;
                }
                else
                {
                    i64 n = 0;
                    if (!lx.lexNumber(&n)) { err.msg = "bad data literal"; err.lineNo = line.lineNo; return false; }
                    addend = op == (u8)'+' ? n : -n;
                }
            }
            if (!diff)
            {
                if (width != 4 && width != 8)
                {
                    err.msg = "symbol needs .long or .quad";
                    err.lineNo = line.lineNo;
                    return false;
                }
                u64 at = (u64)out.len;
                if (!emitDataLitValue(out, width, 0)) return false;
                u8 rk = width == 8 ? (u8)AsmRelocKind::RelAbs64 : (u8)AsmRelocKind::RelAbs32;
                if (!asmAddReloc(obj, at, name, rk, addend, sec))
                {
                    err.msg = "too many relocations";
                    return false;
                }
            }
        }
        else
        {
            i64 v = 0;
            if (!lx.lexNumber(&v)) { err.msg = "bad data literal"; err.lineNo = line.lineNo; return false; }
            if (!emitDataLitValue(out, width, (u64)v)) return false;
        }
        lx.skipSpace();
        if (lx.done()) break;
        if (!lx.eat((u8)','))
        {
            err.msg = "expected ',' in data literal";
            err.lineNo = line.lineNo;
            return false;
        }
    }
    return true;
}

// pad the section up to an a-byte boundary; text pads with nop bytes
bool alignSec(AsmBytes* out, i64 a, bool text, AsmParseError* err, u32 lineNo)
{
    if (a <= 0) return true;
    if (a > 256) { err.msg = "alignment too large"; err.lineNo = lineNo; return false; }
    u32 au = (u32)a;
    while ((out.len % au) != 0)
    {
        if (!out.u8b(text ? (u8)0x90 : (u8)0)) { err.msg = "out of memory"; err.lineNo = lineNo; return false; }
    }
    return true;
}

// directive kinds resolved from the table below
// 1 .text, 2 .data, 3 .globl name, 4-7 data literals of width 1/2/4/8,
// 8 .zero N, 9 byte align N, 10 p2align N, 11 .type, 12 .size (ignore),
// 13 .section name, 14 .ascii/.asciz/.string strings, 15 .extern,
// 16 .weak, 17 .hidden/.internal/.protected (arg = visibility code),
// 90 metadata we ignore
struct DirEnt { str name; u8 kind; u8 arg; }

static DirEnt _dirs[] = {
    { ".text", 1, 0 }, { ".data", 2, 0 }, { ".bss", 20, 0 }, { ".sbss", 20, 0 },
    { ".hot", 18, 0 }, { ".cold", 19, 0 },
    { ".globl", 3, 0 }, { ".global", 3, 0 },
    { ".byte", 4, 0 }, { ".word", 5, 0 }, { ".long", 6, 0 }, { ".quad", 7, 0 },
    { ".zero", 8, 0 }, { ".space", 8, 0 },
    { ".align", 9, 0 }, { ".balign", 9, 0 }, { ".p2align", 10, 0 },
    { ".type", 11, 0 }, { ".size", 12, 0 },
    { ".section", 13, 0 },
    { ".ascii", 14, 0 }, { ".asciz", 14, 1 }, { ".string", 14, 1 },
    { ".extern", 15, 0 }, { ".local", 21, 0 },
    { ".comm", 22, 0 }, { ".lcomm", 22, 0 },
    { ".weak", 16, 0 },
    { ".hidden", 17, 2 }, { ".internal", 17, 1 },
    { ".protected", 17, 3 },
    { ".cfi_startproc", 90, 0 }, { ".cfi_endproc", 90, 0 },
    { ".cfi_def_cfa_offset", 90, 0 }, { ".cfi_def_cfa_register", 90, 0 },
    { ".cfi_offset", 90, 0 }, { ".cfi_def_cfa", 90, 0 },
    { ".ident", 90, 0 }, { ".file", 90, 0 }, { ".loc", 90, 0 }
};

// .ascii/.asciz payload: comma-separated string literals, decoded by the
// lexer; the NUL-terminated form appends a 0 after each literal
bool emitStringLits(AsmLine* line, AsmObject* obj, i32 sec, bool nulTerm, AsmParseError* err)
{
    AsmBytes* out = asmSectionData(obj, sec);
    AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
    while (true)
    {
        lx.skipSpace();
        if (lx.done()) break;
        str s = str::empty();
        if (!lx.lexQuoted(&s, err)) return false;
        for (usize k = 0; k < s.len; k++)
        {
            if (!out.u8b(s.ptr[k]))
            {
                err.msg = "out of memory";
                free(s.ptr);
                return false;
            }
        }
        if (nulTerm)
        {
            if (!out.u8b(0))
            {
                err.msg = "out of memory";
                free(s.ptr);
                return false;
            }
        }
        free(s.ptr);
        lx.skipSpace();
        if (lx.done()) break;
        if (!lx.eat((u8)','))
        {
            err.msg = "expected ',' between string literals";
            return false;
        }
    }
    return true;
}

bool handleDirective(AsmLine* line, AsmObject* obj, i32* sec, AsmParseError* err)
{
    err.lineNo = line.lineNo;
    u8 kind = 0;
    u8 darg = 0;
    u32 nd = 35;
    for (u32 i = 0; i < nd; i++)
    {
        if (_dirs[i].name.equals(line.mnem)) { kind = _dirs[i].kind; darg = _dirs[i].arg; break; }
    }
    if (kind == 0)
    {
        // unknown directives are assembler metadata we do not need
        return true;
    }
    switch (kind)
    {
        1 => { *sec = 1; return true; },
        2 => { *sec = 2; return true; },
        3 => {
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = ".globl needs a name"; return false; }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].global = true;
            return true;
        },
        4 => { return emitDataLits(line, obj, *sec, 1, err); },
        5 => { return emitDataLits(line, obj, *sec, 2, err); },
        6 => { return emitDataLits(line, obj, *sec, 4, err); },
        7 => { return emitDataLits(line, obj, *sec, 8, err); },
        8 => {
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            i64 n = 0;
            if (!lx.lexNumber(&n) || n < 0) { err.msg = "bad .zero count"; return false; }
            AsmBytes* out = asmSectionData(obj, *sec);
            for (i64 k = 0; k < n; k++)
            {
                if (!out.u8b(0)) { err.msg = "out of memory"; return false; }
            }
            return true;
        },
        9 => {
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            i64 a = 0;
            if (!lx.lexNumber(&a)) { err.msg = "bad alignment"; return false; }
            AsmBytes* out = asmSectionData(obj, *sec);
            if (a > 0) asmSectionBumpAlign(obj, *sec, (u64)a);
            return alignSec(out, a, asmSectionIsText(*sec), err, line.lineNo);
        },
        10 => {
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            i64 a = 0;
            if (!lx.lexNumber(&a) || a < 0 || a > 8) { err.msg = "bad p2align"; return false; }
            i64 bytes = (i64)1 << a;
            AsmBytes* out = asmSectionData(obj, *sec);
            if (bytes > 0) asmSectionBumpAlign(obj, *sec, (u64)bytes);
            return alignSec(out, bytes, asmSectionIsText(*sec), err, line.lineNo);
        },
        11 => {
            // .type name, @function / @object — mark the symbol for the writers
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) return true;
            lx.eat((u8)',');
            lx.skipSpace();
            if (!lx.done() && lx.peek() == (u8)'@')
            {
                lx.pos++;
                str what = lx.lexIdent();
                i32 si = asmFindOrAddSym(obj, name);
                if (si < 0) return true;
                if (what.equals("function"))
                {
                    obj.syms[si].isFunc = true;
                    obj.syms[si].isObject = false;
                }
                else if (what.equals("object"))
                {
                    obj.syms[si].isFunc = false;
                    obj.syms[si].isObject = true;
                }
            }
            return true;
        },
        12 => {
            // .size name, expr — record st_size; `.-name` is the common form
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) return true;
            lx.skipSpace();
            if (!lx.eat((u8)',')) return true;
            lx.skipSpace();
            i64 size = 0;
            if (!lx.done() && lx.peek() == (u8)'.')
            {
                lx.pos++;
                lx.skipSpace();
                if (!lx.eat((u8)'-')) { err.msg = "bad .size expression"; err.lineNo = line.lineNo; return false; }
                lx.skipSpace();
                str based = lx.lexIdent();
                i32 bi = asmFindSym(obj, based);
                if (bi < 0 || !obj.syms[bi].defined || obj.syms[bi].section != *sec)
                {
                    err.msg = ".size base must be defined in this section";
                    err.lineNo = line.lineNo;
                    return false;
                }
                size = (i64)asmSectionData(obj, *sec).len - (i64)obj.syms[bi].value;
            }
            else if (!lx.lexNumber(&size))
            {
                err.msg = "bad .size value";
                err.lineNo = line.lineNo;
                return false;
            }
            if (size < 0) size = 0;
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].size = (u64)size;
            return true;
        },
        13 => {
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.equals(".text.hot") || name.equals(".hot") ||
                name.equals(".text$hot")) { *sec = 3; return true; }
            if (name.equals(".text.cold") || name.equals(".cold") ||
                name.equals(".text$cold") || name.equals(".text.unlikely")) { *sec = 4; return true; }
            if (name.equals(".text")) { *sec = 1; return true; }
            if (name.equals(".data") || name.equals(".rodata") ||
                name.equals(".bss") || name.equals(".sbss")) { *sec = 2; return true; }
            if (secNameStarts(name, ".text.") || secNameStarts(name, ".text$")) { *sec = 1; return true; }
            if (secNameStarts(name, ".rodata.") || secNameStarts(name, ".data.") ||
                secNameStarts(name, ".bss.")) { *sec = 2; return true; }
            // linker metadata with no assembler-visible bytes in our output
            if (secNameStarts(name, ".note") || name.equals(".comment")) return true;
            err.msg = "unsupported section";
            return false;
        },
        14 => { return emitStringLits(line, obj, *sec, darg != 0, err); },
        15 => {
            // .extern name — external linkage; valid with or without a
            // later definition (undefined + global = resolved by the linker)
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = ".extern needs a name"; return false; }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].global = true;
            return true;
        },
        16 => {
            // .weak name — weak binding: undefined stays weak, defined
            // overrides only if no strong definition exists at link time
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = ".weak needs a name"; return false; }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].weak = true;
            return true;
        },
        18 => { *sec = 3; return true; },
        19 => { *sec = 4; return true; },
        17 => {
            // .hidden/.internal/.protected name — ELF visibility
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = "visibility directive needs a name"; return false; }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].vis = darg;
            return true;
        },
        20 => { *sec = 2; return true; },
        21 => {
            // .local name — keep the symbol local even if .comm defines it
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = ".local needs a name"; return false; }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].global = false;
            obj.syms[si].weak = false;
            return true;
        },
        22 => {
            // .comm/.lcomm name, size[, align] — zero-filled common block
            AsmLexer lx = AsmLexer::new(line.dargs, line.lineNo);
            str name = lx.lexIdent();
            if (name.isEmpty()) { err.msg = ".comm needs a name"; return false; }
            lx.skipSpace();
            if (!lx.eat((u8)',')) { err.msg = ".comm needs a size"; return false; }
            lx.skipSpace();
            i64 size = 0;
            if (!lx.lexNumber(&size) || size < 0)
            {
                err.msg = "bad .comm size";
                err.lineNo = line.lineNo;
                return false;
            }
            lx.skipSpace();
            i64 al = 1;
            if (!lx.done() && lx.eat((u8)','))
            {
                lx.skipSpace();
                if (!lx.lexNumber(&al) || al < 0) { err.msg = "bad .comm alignment"; return false; }
            }
            AsmBytes* out = asmSectionData(obj, 2);
            if (al > 1)
            {
                asmSectionBumpAlign(obj, 2, (u64)al);
                if (!alignSec(out, al, false, err, line.lineNo)) return false;
            }
            i32 si = asmFindOrAddSym(obj, name);
            if (si < 0) { err.msg = "too many symbols"; return false; }
            obj.syms[si].defined = true;
            obj.syms[si].section = 2;
            obj.syms[si].value = (u64)out.len;
            for (i64 k = 0; k < size; k++)
            {
                if (!out.u8b(0)) return false;
            }
            return true;
        },
        90 => { return true; },
        else => { return true; },
    }
}

// assemble a whole source unit: labels bind at the current section
// offset, directives steer sections and emit data, everything else goes
// through the encoder into the current section.
pub bool assembleText(str text, AsmObject* obj, AsmParseError* err)
{
    u32 lineNo = 0;
    usize i = 0;
    i32 sec = 1;
    while (i < text.len)
    {
        usize start = i;
        while (i < text.len && text.ptr[i] != (u8)'\n') i++;
        str ln = str::fromParts(text.ptr + start, i - start);
        if (i < text.len) i++;
        lineNo++;

        AsmLine line = AsmLine {};
        if (!parseAttLine(ln, lineNo, &line, err)) return false;
        err.lineNo = lineNo;
        if (line.hasLabel)
        {
            i32 si = asmFindOrAddSym(obj, line.label);
            if (si < 0) { err.msg = "too many symbols"; err.lineNo = lineNo; return false; }
            obj.syms[si].defined = true;
            obj.syms[si].value = (u64)asmSectionData(obj, sec).len;
            obj.syms[si].section = sec;
        }
        if (line.isEmpty) continue;
        if (line.isDirective)
        {
            if (!handleDirective(&line, obj, &sec, err)) return false;
            continue;
        }
        AsmBytes tmp = AsmBytes::new();
        AsmBytes* dst = asmSectionData(obj, sec);
        EncodeCtx ctx = ctxNew(&tmp, obj, sec);
        ctx.base = (u64)dst.len;
        if (!matchAndEncode(&line, &ctx, err))
        {
            tmp.deinit();
            return false;
        }
        if (!asmAppend(dst, &tmp))
        {
            tmp.deinit();
            err.msg = "out of memory";
            return false;
        }
        tmp.deinit();
    }
    return true;
}

