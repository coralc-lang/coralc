    { "sbb", SZ248,  3, 0x81, 0, 3,    9, false, false, false, 0 },
    { "and", SZ1248, 1, 0x20, 0, NOREG, 0, false, false, false, 0 },
    { "and", SZ1248, 2, 0x22, 0, NOREG, 0, false, false, false, 0 },
    { "and", SZ1,    5,   0x24, 0, NOREG, 1, false, false, false, 0 },
