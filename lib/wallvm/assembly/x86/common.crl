#[[no_drop_all]]
// x86 register table and the byte-level encoding substrate every x86
// assembler carries: REX, ModRM, SIB, displacement, plus the VEX and EVEX
// prefix composers AVX/AVX2/AVX-512 need. Shared by the 64- and 32-bit
// encoders. Follows the same split as LLVM's X86BaseInfo: registers are
// (class, size, number), memory operands lower to ModRM+SIB+disp with the
// four classic special cases (rsp/r12 force SIB, rbp/r13 force disp,
// rip-relative is mod=00 rm=101).
import(lib) core::char_util { isDigit, isAlpha, isHexDigit, digitValue };
import(lib) platform::libc { memcmp };
import(lib) std::mman { alloc, dealloc };

pub enum X86RegClass
{
    RcNone,
    RcGpr,    // rax..r15 family, size decides width
    RcXmm,
    RcSeg,
    RcYmm,
    RcZmm,
    RcK,      // opmask k0-k7
    RcMmx     // mm0-mm7, 64-bit MMX state
}

pub struct X86Reg
{
    str name;
    u8 num;       // 0-31 encoding number (zmm); low bits feed ModRM
    u8 cls;       // X86RegClass
    u8 size;      // 1,2,4,8 gpr; 16 xmm; 32 ymm; 64 zmm
    bool needsRex; // sil/dil/bpl/spl force a REX prefix in byte form
}

// Register table, x86_64. Byte registers that live in the r8-r15 space
// (r8b-r15b) share numbers with the 64-bit regs; ah/ch/dh/bh are the
// high-byte registers (num 4-7, no REX allowed — we reject them under
// REX rather than silently mis-encode).
static X86Reg _regTable[] = {
    { "rax", 0, 1, 8, false }, { "rcx", 1, 1, 8, false },
