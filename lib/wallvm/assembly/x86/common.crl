pub X86Reg* lookupReg(str name)
{
    u32 n = 154;
    for (u32 i = 0; i < n; i++)
    {
        if (_regTable[i].name.equals(name)) return &_regTable[i];
    }
    return null;
}

// true when the register is a vector of any width
pub bool isVectorReg(X86Reg* r)
{
    if (r == null) return false;
    return r.cls == (u8)X86RegClass::RcXmm || r.cls == (u8)X86RegClass::RcYmm || r.cls == (u8)X86RegClass::RcZmm;
}

// Growable byte sink every encoder writes into.
pub struct AsmBytes
{
    u8* data;
    u32 len;
    u32 cap;

    static AsmBytes new()
    {
        return AsmBytes { .data = null, .len = 0, .cap = 0 };
    }

    bool reserve(u32 extra)
    {
        if (self.len + extra <= self.cap) return true;
        u32 ncap = self.cap == 0 ? 32 : self.cap * 2;
        while (ncap < self.len + extra) ncap = ncap * 2;
        u8* nd = alloc<u8>((usize)ncap);
        if (nd == null) return false;
        for (u32 i = 0; i < self.len; i++) nd[i] = self.data[i];
        if (self.data != null) dealloc<u8>(self.data);
        self.data = nd;
        self.cap = ncap;
        return true;
    }

    bool u8b(u8 v)
    {
        if (!self.reserve(1)) return false;
        self.data[self.len] = v;
        self.len++;
        return true;
    }

    bool u16b(u16 v)
    {
        return self.u8b((u8)(v & 0xFF)) && self.u8b((u8)((v >> 8) & 0xFF));
    }

    bool u32b(u32 v)
    {
        return self.u8b((u8)(v & 0xFF)) && self.u8b((u8)((v >> 8) & 0xFF)) &&
               self.u8b((u8)((v >> 16) & 0xFF)) && self.u8b((u8)((v >> 24) & 0xFF));
    }

    bool u64b(u64 v)
    {
        return self.u32b((u32)(v & 0xFFFFFFFF)) && self.u32b((u32)((v >> 32) & 0xFFFFFFFF));
    }

    // little-endian immediate of `bytes` width
    bool immv(i64 v, u32 bytes)
    {
        u64 u = (u64)v;
        for (u32 i = 0; i < bytes; i++)
        {
            if (!self.u8b((u8)((u >> (u64)(8 * i)) & 0xFF))) return false;
        }
        return true;
    }

    void reset() { self.len = 0; }

    void deinit()
    {
        if (self.data != null) dealloc<u8>(self.data);
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }
}

// REX prefix composition. rex.w from operand size, rex.r/x/b from the
// register-number high bits. A byte register needing REX (spl etc.)
// forces a bare 0x40.
pub struct X86Rex
{
    bool w;
    bool r;
    bool x;
    bool b;
    bool force;

    static X86Rex new()
    {
        return X86Rex { .w = false, .r = false, .x = false, .b = false, .force = false };
    }

    bool hasAny() { return self.w || self.r || self.x || self.b || self.force; }

    u8 byte()
    {
        u8 v = 0x40;
        if (self.w) v = v | 0x08;
        if (self.r) v = v | 0x04;
        if (self.x) v = v | 0x02;
        if (self.b) v = v | 0x01;
        return v;
    }
}

// ModRM+SIB+displacement for one memory operand plus a reg field.
// base/index are X86Reg* (index may be null); rip bypasses the reg fields.
// rexB/rexX receive the high-bit reports the VEX/EVEX composers need.
pub bool encodeMem(AsmBytes* out, X86Reg* base, X86Reg* index, u32 scale,
               bool hasDisp, i64 disp, bool rip, u8 regField, u8* rexB, u8* rexX)
{
    u8 reg = (u8)((regField & 7) << 3);

    if (rip)
    {
        // mod=00, rm=101, disp32
        if (!out.u8b(reg | 0x05)) return false;
        if (!out.u32b((u32)disp)) return false;
        return true;
    }

    if (base == null && index == null)
    {
        // absolute: mod=00 rm=100, SIB with no base/index (base=101,
        // mod=00), disp32
        if (!out.u8b(reg | 0x04)) return false;
        if (!out.u8b(0x25)) return false;
        if (!out.u32b((u32)disp)) return false;
        return true;
    }

    u8 baseNum = 0;
    bool baseHigh = false;
    if (base != null)
    {
        baseNum = base->num & 7;
        baseHigh = (base->num & 8) != 0;
        if (baseHigh && rexB != null) *rexB = 1;
    }

    u8 indexNum = 0;
    bool indexHigh = false;
    bool hasIndex = index != null;
    if (hasIndex)
    {
        indexNum = index->num & 7;
        indexHigh = (index->num & 8) != 0;
        if (indexHigh && rexX != null) *rexX = 1;
    }

    // scale encoding for SIB: 1→0, 2→1, 4→2, 8→3
    u8 sc = 0;
    if (scale == 2) sc = 1;
    else if (scale == 4) sc = 2;
    else if (scale == 8) sc = 3;

    // rsp as base (rm=100) always needs the SIB byte; r12 shares the low
    // 3 bits (100) so it too must go through SIB
    bool needSib = hasIndex || baseNum == 4;
    // rbp/r13 (low 3 bits 101) with mod=00 means rip/abs, so a zero
    // displacement still needs mod=01
    bool forceDisp8 = base != null && baseNum == 5;

    u8 rmMod;
    bool disp8 = false;
    bool disp32 = false;
    if (!hasDisp)
    {
        if (forceDisp8) { rmMod = 0x01; disp8 = true; }
        else { rmMod = 0x00; }
    }
    else
    {
        if (disp == 0 && !forceDisp8) { rmMod = 0x00; }
        else if (disp >= -128 && disp <= 127) { rmMod = 0x01; disp8 = true; }
        else { rmMod = 0x02; disp32 = true; }
    }

    if (!needSib)
    {
        if (!out.u8b((u8)(rmMod << 6 | reg | baseNum))) return false;
    }
    else
    {
        if (!out.u8b((u8)(rmMod << 6 | reg | 0x04))) return false;
        u8 sibBase = base != null ? baseNum : 0x05;
        u8 sibIndex = hasIndex ? indexNum : 0x04; // 100 = none
        if (!out.u8b((u8)(sc << 6 | sibIndex << 3 | sibBase))) return false;
        if (base == null && hasIndex)
        {
            // index-only needs disp32 after the SIB (mod=00 base=101)
            if (!out.u32b((u32)disp)) return false;
            return true;
        }
    }

    if (disp8)
    {
        if (!out.u8b((u8)(i8)disp)) return false;
    }
    else if (disp32)
    {
        if (!out.u32b((u32)disp)) return false;
    }
    return true;
}

// ModRM byte for reg/reg forms: mod=11.
pub u8 encodeRegReg(u8 regField, u8 rmReg)
{
    return (u8)(0xC0 | ((regField & 7) << 3) | (rmReg & 7));
}

// ------------------------------------------------------------------
// VEX prefix: 2-byte C5 form when m=0F, W=0, X=B=0; else 3-byte C4.
// r/x/b/vvvv are raw register-number bits — inverted on emit, per spec.
// ------------------------------------------------------------------
pub struct X86Vex
{
    bool r;
    bool x;
    bool b;   // high-bit extensions (inverted on emit)
    u8 mmmmm;       // 1 = 0F, 2 = 0F38, 3 = 0F3A
    u8 pp;          // 0 none, 1 = 66, 2 = F3, 3 = F2
    u8 ll;          // 0 = 128, 1 = 256
    bool w;
    u8 vvvv;        // raw number 0-15 (inverted on emit)

    static X86Vex new()
    {
        return X86Vex { .r = false, .x = false, .b = false, .mmmmm = 1,
                        .pp = 0, .ll = 0, .w = false, .vvvv = 0 };
    }

    bool emit(AsmBytes* out)
    {
        bool two = self.mmmmm == 1 && !self.w && !self.x && !self.b;
        if (two)
        {
            if (!out.u8b(0xC5)) return false;
            u8 b0 = (u8)(((~(u32)self.r & 1) << 7) | ((~(u32)self.vvvv & 15) << 3) |
                         (((u32)self.ll & 1) << 2) | ((u32)self.pp & 3));
            return out.u8b(b0);
        }
        if (!out.u8b(0xC4)) return false;
        u8 b0 = (u8)(((~(u32)self.r & 1) << 7) | ((~(u32)self.x & 1) << 6) |
                     ((~(u32)self.b & 1) << 5) | ((u32)self.mmmmm & 7));
        u8 b1 = (u8)((((u32)self.w & 1) << 7) | ((~(u32)self.vvvv & 15) << 3) |
                     (((u32)self.ll & 1) << 2) | ((u32)self.pp & 3));
        if (!out.u8b(b0)) return false;
        return out.u8b(b1);
    }
}

// ------------------------------------------------------------------
// EVEX prefix (62 P0 P1 P2): extends VEX with 32 vector registers,
// opmask registers k0-k7, zeroing/merging, and 512-bit vectors.
// rp/v2 are the bit-4 extensions of reg and vvvv; ll: 0=128, 1=256,
// 2=512. aaa = mask register, z = zeroing, b = rounding/SAE (reserved
// here — broadcast/rounding controls come with the instructions that
// need them).
// ------------------------------------------------------------------
pub struct X86Evex
{
    bool r;
    bool x;
    bool b;   // reg/rm extensions, inverted on emit
    bool rp;        // reg[4], inverted on emit
    bool v2;        // vvvv[4], inverted on emit
    bool w;
    u8 vvvv;        // vvvv raw 0-15, inverted on emit
    u8 mmmmm;       // 1 = 0F, 2 = 0F38, 3 = 0F3A
    u8 pp;          // 0/1/2/3 as VEX
    u8 ll;          // 0 = 128, 1 = 256, 2 = 512 (L'L)
    bool z;         // zeroing mask
    u8 aaa;         // mask register 0-7

    static X86Evex new()
    {
        return X86Evex { .r = false, .x = false, .b = false, .rp = false,
                         .v2 = false, .w = false, .vvvv = 0, .mmmmm = 1,
                         .pp = 0, .ll = 0, .z = false, .aaa = 0 };
    }

    bool emit(AsmBytes* out)
    {
        if (!out.u8b(0x62)) return false;
        // P0: R X B R' 0 0 m m
        u8 p0 = (u8)(((~(u32)self.r & 1) << 7) | ((~(u32)self.x & 1) << 6) |
                     ((~(u32)self.b & 1) << 5) | ((~(u32)self.rp & 1) << 4) |
                     ((u32)self.mmmmm & 3));
        // P1: W vvvv 1 pp
        u8 p1 = (u8)((((u32)self.w & 1) << 7) | ((~(u32)self.vvvv & 15) << 3) |
                     (1 << 2) | ((u32)self.pp & 3));
        // P2: z L'L b V' aaa
        u8 p2 = (u8)((((u32)self.z & 1) << 7) | (((u32)self.ll & 3) << 5) |
                     ((~(u32)self.v2 & 1) << 3) | ((u32)self.aaa & 7));
        if (!out.u8b(p0)) return false;
        if (!out.u8b(p1)) return false;
        return out.u8b(p2);
    }
}
