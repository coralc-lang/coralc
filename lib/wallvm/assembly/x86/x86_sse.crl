#[[no_drop_all]]
// legacy SSE/SSE2/SSE3/SSSE3/SSE4 encoder: the non-VEX packed table and
// its emitter. Rows carry the full mnemonic (paddb must not split into
// padd+b the way the GPR walker would), the mandatory prefix, the 0F38/
// 0F3A escape when the opcode needs one, a /digit for group opcodes, and
// a register-class policy for the rm and reg positions. Emission mirrors
// the legacy branch of encodeVector: [user prefixes] [mandatory prefix]
// [REX] 0F [escape] opcode, then a ModRM tail parked in a scratch buffer
// so the R/X/B extension bits are known before the prefix is written.
import(lib) wallvm::assembly::common { AsmLine, AsmOperand, AsmOpKind, AsmParseError };
import(lib) wallvm::assembly::x86::common { X86Reg, X86RegClass, lookupReg, AsmBytes, X86Rex, encodeMem, encodeRegReg };
import(lib) wallvm::assembly::x86::obj { AsmRelocKind, asmAddReloc };
import(lib) wallvm::assembly::x86::x86_avx { EncodeCtx };

// form signatures, AT&T operand order (src, dst)
enum SseSig
{
    SS_R_RM,    // rm, reg — load/arith-to-reg forms
    SS_RM_R,    // reg, rm — store forms
    SS_XRM_I,   // imm, rm, reg — shuf/blend/pinsrw/round imm8 forms
    SS_XR_RM,   // imm, reg, rm — pextrb/pextrd/extractps: reg field is
                // the xmm source, rm the gpr/mem destination
    SS_XRM      // imm, rm — shift-imm group: ModRM.reg carries row.ext
}

// rm register classes (the rm operand may always be memory)
const u8 RC_XM = 0;   // xmm
const u8 RC_GP = 1;   // any gpr
const u8 RC_G32 = 2;  // 32-bit gpr
const u8 RC_G64 = 3;  // 64-bit gpr
// reg-position classes for SS_R_RM destinations
const u8 DC_XM = 0;
const u8 DC_G32 = 2;
const u8 DC_G64 = 3;

const u8 SSE_NOREG = 0xFF;

// SSE row: full mnemonic + prefix/escape/opcode + class policy
// ext: /digit in ModRM.reg, SSE_NOREG = reg field from the reg operand
// immW: 1 = trailing imm8, 0 = none
// rmCls/dstCls: RC_/DC_ codes above
// forceW: REX.W always; wFromGpr: REX.W when the gpr reg operand is 64-bit
// regIsGpr: SS_RM_R rows whose reg operand is a gpr (movnti), which also
// forces the rm operand to be memory
struct SseRow
{
    str base;
    u8 sig;
    u8 op;
    u8 esc;
    u8 pfx;
    u8 ext;
    u8 immW;
    u8 rmCls;
    u8 dstCls;
    bool forceW;
    bool wFromGpr;
    bool regIsGpr;
}

static SseRow[] _sseForms = {
