    { "movaps", SS_R_RM, 0x28, 0, 0, SSE_NOREG, 0, RC_XM, DC_XM, false, false, false },
    { "movaps", SS_RM_R, 0x29, 0, 0, SSE_NOREG, 0, RC_XM, DC_XM, false, false, false },
    { "movups", SS_R_RM, 0x10, 0, 0, SSE_NOREG, 0, RC_XM, DC_XM, false, false, false },
    { "movups", SS_RM_R, 0x11, 0, 0, SSE_NOREG, 0, RC_XM, DC_XM, false, false, false },
