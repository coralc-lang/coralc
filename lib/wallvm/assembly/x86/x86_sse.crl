// class check for one register operand against an RC_/DC_ code
bool sseRegClsOk(X86Reg* r, u8 cls)
{
    if (r == null) return false;
    if (cls == RC_XM) return (X86RegClass)r.cls == X86RegClass::RcXmm;
    if (cls == RC_GP) return (X86RegClass)r.cls == X86RegClass::RcGpr;
    if (cls == RC_G32) return (X86RegClass)r.cls == X86RegClass::RcGpr && r.size == 4;
    return (X86RegClass)r.cls == X86RegClass::RcGpr && r.size == 8;
}

// signature match: operand count, kinds, register classes. Memory is
// accepted wherever an RC_ code allows a register, except SS_XR_RM
// destinations which may also be plain memory for the pextr/extractps
// store forms.
bool sseSigOk(AsmLine* line, SseRow* row)
{
    switch ((SseSig)row.sig)
    {
        SseSig::SS_R_RM => {
            if (line.nops != 2 || line.ops[1].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[1].text);
            if (!sseRegClsOk(d, row.dstCls)) return false;
            if (line.ops[0].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[0].text);
                return sseRegClsOk(s, row.rmCls);
            }
            return line.ops[0].kind == AsmOpKind::Mem;
        },
        SseSig::SS_RM_R => {
            if (line.nops != 2 || line.ops[0].kind != AsmOpKind::Reg) return false;
            if (line.ops[1].kind != AsmOpKind::Reg && line.ops[1].kind != AsmOpKind::Mem) return false;
            X86Reg* s = lookupReg(line.ops[0].text);
            if (row.regIsGpr)
            {
                if (s == null || (X86RegClass)s.cls != X86RegClass::RcGpr) return false;
                // movnti stores to memory only
                return line.ops[1].kind == AsmOpKind::Mem;
            }
            if (!sseRegClsOk(s, RC_XM)) return false;
            if (line.ops[1].kind == AsmOpKind::Reg)
            {
                X86Reg* d = lookupReg(line.ops[1].text);
                return sseRegClsOk(d, row.rmCls);
            }
            return true;
        },
        SseSig::SS_XRM_I => {
            if (line.nops != 3 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[0].imm < -128 || line.ops[0].imm > 255) return false;
            if (line.ops[2].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[2].text);
            if (!sseRegClsOk(d, row.dstCls)) return false;
            if (line.ops[1].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[1].text);
                return sseRegClsOk(s, row.rmCls);
            }
            return line.ops[1].kind == AsmOpKind::Mem;
        },
        SseSig::SS_XR_RM => {
            // imm, xmm source (reg field), gpr/mem destination (rm)
            if (line.nops != 3 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[0].imm < -128 || line.ops[0].imm > 255) return false;
            if (line.ops[1].kind != AsmOpKind::Reg) return false;
            X86Reg* s = lookupReg(line.ops[1].text);
            if (!sseRegClsOk(s, RC_XM)) return false;
            if (line.ops[2].kind == AsmOpKind::Reg)
            {
                X86Reg* d = lookupReg(line.ops[2].text);
                return sseRegClsOk(d, row.rmCls);
            }
            return line.ops[2].kind == AsmOpKind::Mem;
        },
        SseSig::SS_XRM => {
            if (line.nops != 2 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[0].imm < -128 || line.ops[0].imm > 255) return false;
            if (line.ops[1].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[1].text);
                return sseRegClsOk(s, row.rmCls);
            }
            return line.ops[1].kind == AsmOpKind::Mem;
        },
        else => { return false; },
    }
}

// legacy SSE encode: user prefixes, mandatory prefix, REX, 0F escape,
// opcode, then the parked ModRM tail and optional imm8. The ModRM tail
// is built in a scratch buffer first so R/X/B are known before the
// prefix bytes are written.
bool encodeSse(AsmLine* line, SseRow* row, EncodeCtx* ctx, AsmParseError* err)
{
    AsmBytes* out = ctx.out;

    AsmOperand* rmOp = null;
    AsmOperand* regOp = null;
    AsmOperand* immOp = null;
    switch ((SseSig)row.sig)
    {
        SseSig::SS_R_RM => { rmOp = &line.ops[0]; regOp = &line.ops[1]; },
        SseSig::SS_RM_R => { regOp = &line.ops[0]; rmOp = &line.ops[1]; },
        SseSig::SS_XRM_I => { immOp = &line.ops[0]; rmOp = &line.ops[1]; regOp = &line.ops[2]; },
        SseSig::SS_XR_RM => { immOp = &line.ops[0]; regOp = &line.ops[1]; rmOp = &line.ops[2]; },
        SseSig::SS_XRM => { immOp = &line.ops[0]; rmOp = &line.ops[1]; },
        else => { err.msg = "bad SSE signature"; return false; },
    }

    X86Reg* regR = regOp != null && regOp.kind == AsmOpKind::Reg ? lookupReg(regOp.text) : null;
    X86Reg* rmR = rmOp != null && rmOp.kind == AsmOpKind::Reg ? lookupReg(rmOp.text) : null;

    AsmBytes tail = AsmBytes::new();
    u8 highB = 0;
    u8 highX = 0;
    // group forms pin ModRM.reg to the /digit; everything else takes it
    // from the register operand
    u8 regField = row.ext == SSE_NOREG ? (regR != null ? (regR.num & 7) : 0) : row.ext;
    bool regExt = row.ext == SSE_NOREG && regR != null && (regR.num & 8) != 0;

    if (rmOp != null)
    {
        if (rmOp.kind == AsmOpKind::Mem)
        {
            X86Reg* base = null;
            X86Reg* index = null;
            if (!rmOp.rip)
            {
                if (rmOp.hasSym) { tail.deinit(); err.msg = "symbolic displacement needs %rip"; return false; }
                if (!rmOp.base.isEmpty())
                {
                    base = lookupReg(rmOp.base);
                    if (base == null) { tail.deinit(); err.msg = "bad base register"; return false; }
                }
                if (!rmOp.index.isEmpty())
                {
                    index = lookupReg(rmOp.index);
                    if (index == null) { tail.deinit(); err.msg = "bad index register"; return false; }
                }
            }
            u8 xb = 0;
            u8 xx = 0;
            // imm8 bytes that follow the displacement feed the PC32 addend
            u32 immTail = row.immW != 0 ? 1 : 0;
            i64 wdisp = rmOp.disp;
            if (rmOp.hasSym && rmOp.rip) wdisp = rmOp.disp - 4 - (i64)immTail;
            if (!encodeMem(&tail, base, index, rmOp.scale, rmOp.hasDisp || rmOp.hasSym,
                           wdisp, rmOp.rip, regField, &xb, &xx))
            {
                tail.deinit();
                return false;
            }
            highB = xb;
            highX = xx;
        }
        else
        {
            if (rmR == null) { tail.deinit(); err.msg = "missing rm operand"; return false; }
            if (!tail.u8b(encodeRegReg(regField, rmR.num))) { tail.deinit(); return false; }
            highB = (rmR.num & 8) != 0 ? 1 : 0;
        }
    }

    // user prefixes, then the instruction's own prefix/REX/opcode bytes
    if (line.pfxLock) { if (!out.u8b(0xF0)) { tail.deinit(); return false; } }
    if (line.pfxRep) { if (!out.u8b(0xF3)) { tail.deinit(); return false; } }
    if (line.pfxRepne) { if (!out.u8b(0xF2)) { tail.deinit(); return false; } }
    if (line.pfxData16) { if (!out.u8b(0x66)) { tail.deinit(); return false; } }
    if (line.pfxData32 || line.pfxAddr32) { if (!out.u8b(0x67)) { tail.deinit(); return false; } }
    if (row.pfx != 0) { if (!out.u8b(row.pfx)) { tail.deinit(); return false; } }
    bool w = row.forceW || (row.wFromGpr && regR != null && regR.size == 8);
    if (regExt || highB != 0 || highX != 0 || w)
    {
        X86Rex rex = X86Rex::new();
        rex.r = regExt;
        rex.b = highB != 0;
        rex.x = highX != 0;
        rex.w = w;
        if (!out.u8b(rex.byte())) { tail.deinit(); return false; }
    }
    if (!out.u8b(0x0F)) { tail.deinit(); return false; }
    if (row.esc != 0) { if (!out.u8b(row.esc)) { tail.deinit(); return false; } }
    if (!out.u8b(row.op)) { tail.deinit(); return false; }
    for (u32 i = 0; i < tail.len; i++)
    {
        if (!out.u8b(tail.data[i])) { tail.deinit(); return false; }
    }
    tail.deinit();

    // rip-relative symbol displacement: the disp is the last 4 bytes
    if (rmOp != null && rmOp.kind == AsmOpKind::Mem && rmOp.hasSym && rmOp.rip && ctx.obj != null)
    {
        u64 at = out.len >= 4 ? ctx.base + (u64)(out.len - 4) : ctx.base;
        i64 addend = rmOp.disp - 4;
        if (immOp != null && row.immW != 0) addend -= 1;
        if (!asmAddReloc(ctx.obj, at, rmOp.sym, (u8)AsmRelocKind::RelPc32, addend, ctx.sec)) return false;
    }

    if (immOp != null && row.immW != 0)
    {
        return out.immv(immOp.imm, 1);
    }
    return true;
}

// walk the SSE table; 1 encoded, 0 no match, -1 hard error
pub i32 trySseTable(AsmLine* line, str base, EncodeCtx* ctx, AsmParseError* err)
{
    u32 n = 257;
    for (u32 i = 0; i < n; i++)
    {
        SseRow* row = &_sseForms[i];
        if (!row.base.equals(base)) continue;
        if (!sseSigOk(line, row)) continue;
        if (!encodeSse(line, row, ctx, err)) return -1;
        return 1;
    }
    return 0;
}
