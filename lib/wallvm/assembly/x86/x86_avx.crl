    {"vfnmsub213pd", 112, 3, 0xAE, 0x38, 0, 2, 1, 1, 0, true, 0, 0, 255 },
    {"vfnmsub231pd", 112, 3, 0xBE, 0x38, 0, 2, 1, 1, 0, true, 0, 0, 255 },
    {"vfnmsub132ss", 16, 3, 0x9F, 0x38, 0, 2, 1, 0, 0, true, 0, 0, 255 },
    {"vfnmsub213ss", 16, 3, 0xAF, 0x38, 0, 2, 1, 0, 0, true, 0, 0, 255 },
    {"vfnmsub231ss", 16, 3, 0xBF, 0x38, 0, 2, 1, 0, 0, true, 0, 0, 255 },
    {"vfnmsub132sd", 16, 3, 0x9F, 0x38, 0, 2, 1, 1, 0, true, 0, 0, 255 },
    {"vfnmsub213sd", 16, 3, 0xAF, 0x38, 0, 2, 1, 1, 0, true, 0, 0, 255 },
    {"vfnmsub231sd", 16, 3, 0xBF, 0x38, 0, 2, 1, 1, 0, true, 0, 0, 255 }
};

// W-bit helper for wMode=2 rows: true when a GPR operand is 64-bit
bool gprIs64(AsmLine* line)
{
    for (u32 i = 0; i < line.nops; i++)
    {
        if (line.ops[i].kind == AsmOpKind::Reg)
        {
            X86Reg* r = lookupReg(line.ops[i].text);
            if (r != null && (X86RegClass)r.cls == X86RegClass::RcGpr) return r.size == 8;
        }
    }
    return false;
}

bool vecSizeOk(u8 mask, u8 vsize)
{
    if (mask == 0) return true;
    if (vsize == 16) return (mask & VSZ16) != 0;
    if (vsize == 32) return (mask & VSZ32) != 0;
    if (vsize == 64) return (mask & VSZ64) != 0;
    return false;
}

// signature match: operand count, kinds, register classes
bool vecSigOk(AsmLine* line, VecRow* row)
{
    switch (row.sig)
    {
        VecFormSig::VFS_NONE => { return line.nops == 0; },
        VecFormSig::VFS_R_RM => {
            if (line.nops != 2 || line.ops[1].kind != AsmOpKind::Reg) return false;
            if (line.ops[0].kind != AsmOpKind::Reg && line.ops[0].kind != AsmOpKind::Mem) return false;
            X86Reg* d = lookupReg(line.ops[1].text);
            if (d == null) return false;
            if (row.dstCls == 1) { if ((X86RegClass)d.cls != X86RegClass::RcGpr) return false; }
            else { if (!isVectorReg(d)) return false; }
            if (line.ops[0].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[0].text);
                if (s == null) return false;
                if (row.rmCls == 0) { if (!isVectorReg(s)) return false; }
                else { if ((X86RegClass)s.cls != X86RegClass::RcGpr) return false; }
            }
            return true;
        },
        VecFormSig::VFS_RM_R => {
            if (line.nops != 2 || line.ops[0].kind != AsmOpKind::Reg) return false;
            if (line.ops[1].kind != AsmOpKind::Reg && line.ops[1].kind != AsmOpKind::Mem) return false;
            X86Reg* d = lookupReg(line.ops[0].text);
            return d != null && isVectorReg(d);
        },
        VecFormSig::VFS_RRM => {
            if (line.nops != 3 || line.ops[2].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[2].text);
            if (d == null) return false;
            if (row.dstCls == 1) { if ((X86RegClass)d.cls != X86RegClass::RcGpr) return false; }
            else { if (!isVectorReg(d)) return false; }
            if (row.vvvvUse)
            {
                if (line.ops[1].kind != AsmOpKind::Reg) return false;
                X86Reg* v = lookupReg(line.ops[1].text);
                if (v == null || !isVectorReg(v)) return false;
            }
            if (line.ops[0].kind != AsmOpKind::Reg && line.ops[0].kind != AsmOpKind::Mem) return false;
            if (line.ops[0].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[0].text);
                if (s == null) return false;
                if (row.rmCls == 0) { if (!isVectorReg(s)) return false; }
                else { if ((X86RegClass)s.cls != X86RegClass::RcGpr) return false; }
            }
            return true;
        },
        VecFormSig::VFS_RRM_I => {
            if (line.nops != 4 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[3].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[3].text);
            if (d == null || !isVectorReg(d)) return false;
            if (row.vvvvUse)
            {
                if (line.ops[2].kind != AsmOpKind::Reg) return false;
                X86Reg* v = lookupReg(line.ops[2].text);
                if (v == null || !isVectorReg(v)) return false;
            }
            if (line.ops[1].kind != AsmOpKind::Reg && line.ops[1].kind != AsmOpKind::Mem) return false;
            return true;
        },
        VecFormSig::VFS_XRM_I => {
            if (line.nops != 3 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[2].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[2].text);
            if (d == null) return false;
            if (row.dstCls == 1) { if ((X86RegClass)d.cls != X86RegClass::RcGpr) return false; }
            else { if (!isVectorReg(d)) return false; }
            if (line.ops[1].kind != AsmOpKind::Reg && line.ops[1].kind != AsmOpKind::Mem) return false;
            if (line.ops[1].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[1].text);
                if (s == null) return false;
                if (row.rmCls == 0) { if (!isVectorReg(s)) return false; }
                else { if ((X86RegClass)s.cls != X86RegClass::RcGpr) return false; }
            }
            return true;
        },
        VecFormSig::VFS_XRM_V => {
            // imm8, rm, dst — dst feeds vvvv, ModRM.reg = ext /digit
            if (line.nops != 3 || line.ops[0].kind != AsmOpKind::Imm) return false;
            if (line.ops[2].kind != AsmOpKind::Reg) return false;
            X86Reg* d = lookupReg(line.ops[2].text);
            if (d == null || !isVectorReg(d)) return false;
            if (line.ops[1].kind != AsmOpKind::Reg && line.ops[1].kind != AsmOpKind::Mem) return false;
            if (line.ops[1].kind == AsmOpKind::Reg)
            {
                X86Reg* s = lookupReg(line.ops[1].text);
                if (s == null || !isVectorReg(s)) return false;
            }
            return true;
        },
        else => { return false; },
    }
}

// vector encode: build VEX or EVEX, emit prefix, opcode, ModRM tail,
// imm. The ModRM tail goes through a scratch buffer first so the R/X/B
// extension bits are known before the prefix is written.
bool encodeVector(AsmLine* line, VecRow* row, EncodeCtx* ctx, AsmParseError* err)
{
    AsmBytes* out = ctx.out;

    AsmOperand* rmOp = null;
    AsmOperand* vvvvOp = null;
    AsmOperand* dstOp = null;
    AsmOperand* immOp = null;
    switch (row.sig)
    {
        VecFormSig::VFS_RRM => {
            rmOp = &line.ops[0];
            if (row.vvvvUse) vvvvOp = &line.ops[1];
            dstOp = &line.ops[2];
        },
        VecFormSig::VFS_RRM_I => {
            immOp = &line.ops[0];
            rmOp = &line.ops[1];
            if (row.vvvvUse) vvvvOp = &line.ops[2];
            dstOp = &line.ops[3];
        },
        VecFormSig::VFS_XRM_I => {
            immOp = &line.ops[0];
            rmOp = &line.ops[1];
            dstOp = &line.ops[2];
        },
        VecFormSig::VFS_XRM_V => {
            // imm8, rm, dst — dst feeds vvvv, ModRM.reg = ext /digit
            immOp = &line.ops[0];
            rmOp = &line.ops[1];
            vvvvOp = &line.ops[2];
            dstOp = null;
        },
        VecFormSig::VFS_R_RM => {
            rmOp = &line.ops[0];
            dstOp = &line.ops[1];
        },
        VecFormSig::VFS_RM_R => {
            rmOp = &line.ops[1];
            dstOp = &line.ops[0];
        },
        VecFormSig::VFS_NONE => { /* no operands */ },
        else => { err.msg = "bad vector signature"; return false; },
    }

    X86Reg* dstReg = null;
    X86Reg* rmReg = null;
    X86Reg* vvvvReg = null;
    if (dstOp != null && dstOp.kind == AsmOpKind::Reg) dstReg = lookupReg(dstOp.text);
    if (rmOp != null && rmOp.kind == AsmOpKind::Reg) rmReg = lookupReg(rmOp.text);
    if (vvvvOp != null && vvvvOp.kind == AsmOpKind::Reg) vvvvReg = lookupReg(vvvvOp.text);

    if (dstReg != null)
    {
        bool ok = row.dstCls == 1 ? (X86RegClass)dstReg.cls == X86RegClass::RcGpr : isVectorReg(dstReg);
        if (!ok) { err.msg = "wrong destination register class"; return false; }
    }
    if (rmReg != null)
    {
        bool ok = row.rmCls == 0 ? isVectorReg(rmReg) : (X86RegClass)rmReg.cls == X86RegClass::RcGpr;
        if (!ok) { err.msg = "wrong source register class"; return false; }
    }
    if (vvvvReg != null && !isVectorReg(vvvvReg))
    {
        err.msg = "vvvv operand must be a vector register";
        return false;
    }

    // vector length rides the destination register (gpr destinations in
    // cvt-to-gpr forms use the source xmm's width for W only; extract
    // forms take it from the wider source, since the dst is the other
    // half of the pair)
    u8 vsize = dstReg != null && isVectorReg(dstReg) ? dstReg->size : 0;
    if (rmReg != null && isVectorReg(rmReg) && rmReg->size > vsize) vsize = rmReg->size;
    if (vvvvReg != null && isVectorReg(vvvvReg) && vvvvReg->size > vsize) vsize = vvvvReg->size;
    if (!vecSizeOk(row.sizeMask, vsize))
    {
        err.msg = "operand width not valid for this form";
        return false;
    }

    // EVEX when the row allows it and the operands demand it. Legacy rows
    // stay legacy unless a mask asks for the AVX-512VL EVEX form.
    bool evex = (VecEnc)row.enc == VecEnc::VEncEvex;
    if ((VecEnc)row.enc == VecEnc::VEncAuto)
    {
        if (vsize == 64) evex = true;
        if (dstOp != null && !dstOp.mask.isEmpty()) evex = true;
    }
    if ((VecEnc)row.enc == VecEnc::VEncLegacy && dstOp != null && !dstOp.mask.isEmpty()) evex = true;
    if ((VecEnc)row.enc == VecEnc::VEncVex && (vsize == 64 || (dstOp != null && !dstOp.mask.isEmpty())))
    {
        err.msg = "form is VEX-only; zmm/mask needs an EVEX form";
        return false;
    }

    AsmBytes tail = AsmBytes::new();
    u8 highB = 0;
    u8 highX = 0;
    // group forms put the /digit in ModRM.reg instead of a register
    u8 regField = row.ext != 255 ? row.ext : (dstReg != null ? (dstReg.num & 7) : 0);
    bool regExt = dstReg != null && (dstReg.num & 8) != 0;
    bool regExt2 = dstReg != null && (dstReg.num & 16) != 0;

    if (rmOp != null && row.sig != VecFormSig::VFS_NONE)
    {
        if (rmOp.kind == AsmOpKind::Mem)
        {
            X86Reg* base = null;
            X86Reg* index = null;
            if (!rmOp.rip)
            {
                if (rmOp.hasSym) { tail.deinit(); err.msg = "symbolic displacement needs %rip"; return false; }
                if (!rmOp.base.isEmpty())
                {
                    base = lookupReg(rmOp.base);
                    if (base == null) { tail.deinit(); err.msg = "bad base register"; return false; }
                }
                if (!rmOp.index.isEmpty())
                {
                    index = lookupReg(rmOp.index);
                    if (index == null) { tail.deinit(); err.msg = "bad index register"; return false; }
                }
            }
            u8 xb = 0;
            u8 xx = 0;
            // imm bytes that follow the displacement feed the PC32 addend
            u32 immTail = 0;
            if (immOp != null && row.immW != 0)
            {
                if (row.immW == 1) immTail = 1;
                else immTail = (u32)row.immW;
            }
            // rip+sym: the in-place disp holds the addend (disp-4-immTail);
            // the ELF writer zeroes the field, COFF keeps it
            i64 wdisp = rmOp.disp;
            if (rmOp.hasSym && rmOp.rip) wdisp = rmOp.disp - 4 - (i64)immTail;
            if (!encodeMem(&tail, base, index, rmOp.scale, rmOp.hasDisp || rmOp.hasSym,
                           wdisp, rmOp.rip, regField, &xb, &xx))
            {
                tail.deinit();
                return false;
            }
            highB = xb;
            highX = xx;
        }
        else
        {
            if (rmReg == null) { tail.deinit(); err.msg = "missing rm operand"; return false; }
            if (!tail.u8b(encodeRegReg(regField, rmReg.num))) { tail.deinit(); return false; }
            highB = (rmReg.num & 8) != 0 ? 1 : 0;
            if (evex) highX = (rmReg.num & 16) != 0 ? 1 : 0;
        }
    }

    // compose and emit the prefix
    u8 mmmmm = row.op2esc == 0x38 ? 2 : (row.op2esc == 0x3A ? 3 : 1);
    bool w = row.wMode == 1 || (row.wMode == 2 && gprIs64(line));
    if (evex)
    {
        X86Evex ev = X86Evex::new();
        ev.r = regExt;
        ev.rp = regExt2;
        ev.x = highX != 0;
        ev.b = highB != 0;
        ev.mmmmm = mmmmm;
        ev.pp = row.vexPp;
        ev.w = w;
        u8 ll = 0;
        if (vsize == 32) ll = 1;
        else if (vsize == 64) ll = 2;
        if (row.llFix == 1) ll = 1;
        ev.ll = ll;
        if (vvvvReg != null) { ev.vvvv = vvvvReg.num & 15; ev.v2 = (vvvvReg.num & 16) != 0; }
        if (dstOp != null && !dstOp.mask.isEmpty())
        {
            X86Reg* m = lookupReg(dstOp.mask);
            if (m == null || (X86RegClass)m.cls != X86RegClass::RcK) { tail.deinit(); err.msg = "bad opmask"; return false; }
            ev.aaa = m.num & 7;
            ev.z = dstOp.maskZero;
        }
        if (!ev.emit(out)) { tail.deinit(); return false; }
    }
    else if ((VecEnc)row.enc == VecEnc::VEncLegacy && !evex)
    {
        // legacy SSE: [mandatory prefix] [REX] 0F [escape] opcode, no VEX
        u8 pfx = row.vexPp == 1 ? 0x66 : (row.vexPp == 2 ? 0xF3 : (row.vexPp == 3 ? 0xF2 : 0));
        if (pfx != 0) { if (!out.u8b(pfx)) { tail.deinit(); return false; } }
        // REX only when the reg/rm needs it (xmm8-15, gpr src/dst)
        if (regExt || highB != 0 || highX != 0 || w)
        {
            X86Rex rex = X86Rex::new();
            rex.r = regExt;
            rex.b = highB != 0;
            rex.x = highX != 0;
            rex.w = w;
            if (!out.u8b(rex.byte())) { tail.deinit(); return false; }
        }
        if (!out.u8b(0x0F)) { tail.deinit(); return false; }
        if (row.op2esc != 0)
        {
            if (!out.u8b(row.op2esc)) { tail.deinit(); return false; }
        }
    }
    else
    {
        X86Vex vx = X86Vex::new();
        vx.r = regExt;
        vx.x = highX != 0;
        vx.b = highB != 0;
        vx.mmmmm = mmmmm;
        vx.pp = row.vexPp;
        vx.w = w;
        u8 ll = 0;
        if (vsize == 32) ll = 1;
        if (row.llFix == 1) ll = 1;
        vx.ll = ll;
        if (vvvvReg != null) vx.vvvv = vvvvReg.num & 15;
        if (!vx.emit(out)) { tail.deinit(); return false; }
    }

    // opcode, then the parked ModRM tail
    if (!out.u8b(row.op)) { tail.deinit(); return false; }
    for (u32 i = 0; i < tail.len; i++)
    {
        if (!out.u8b(tail.data[i])) { tail.deinit(); return false; }
    }
    tail.deinit();

    // rip-relative symbol displacement: the disp is the last 4 bytes
    if (rmOp != null && rmOp.kind == AsmOpKind::Mem && rmOp.hasSym && rmOp.rip && ctx.obj != null)
    {
        u64 at = out.len >= 4 ? (u64)(out.len - 4) : 0;
        i64 addend = rmOp.disp - 4;
        if (immOp != null && row.immW != 0) addend -= (i64)(row.immW == 1 ? 1 : row.immW);
        if (!asmAddReloc(ctx.obj, at, rmOp.sym, (u8)AsmRelocKind::RelPc32, addend, ctx.sec)) return false;
    }

    if (immOp != null && row.immW != 0)
    {
        return out.immv(immOp.imm, (u32)row.immW);
    }
    return true;
}

// walk the vector table; 1 encoded, 0 no match, -1 hard error
pub i32 tryVecTable(AsmLine* line, str base, EncodeCtx* ctx, AsmParseError* err)
{
    u32 n = 182;
    for (u32 i = 0; i < n; i++)
    {
        VecRow* row = &_vforms[i];
        if (!row.base.equals(base)) continue;
        if (!vecSigOk(line, row)) continue;
        if (!encodeVector(line, row, ctx, err)) return -1;
        return 1;
    }
    return 0;
}
