#[[no_drop_all]]
// AVX/AVX2/AVX-512 vector encoder: the vector form table and the VEX/
// EVEX emitter. Rows carry full mnemonic names (vaddpd never collides
// with a hypothetical vadd+pd), the VEX escape (0F / 0F38 / 0F3A), the
// pp prefix field, and a width policy. EncAuto rows take EVEX when the
// operands are zmm or a {k} mask is present, VEX otherwise — the AVX-512
// subset rides the same opcodes. Also home of EncodeCtx, the shared
// encode state the legacy and unit assemblers pass around.
import(lib) wallvm::assembly::common { AsmLine, AsmOperand, AsmOpKind, AsmParseError };
import(lib) wallvm::assembly::x86::common { X86Reg, X86RegClass, lookupReg, isVectorReg, AsmBytes, X86Rex, X86Vex, X86Evex, encodeMem, encodeRegReg };
import(lib) wallvm::assembly::x86::obj { AsmObject, AsmRelocKind, asmAddReloc };

// encode context: byte sink plus the optional object the line is being
// assembled into (null for one-shot encodeLine; carries reloc records)
pub struct EncodeCtx
{
    AsmBytes* out;
    X86Rex rex;
    AsmObject* obj;
    i32 sec;
}

pub EncodeCtx ctxNew(AsmBytes* out, AsmObject* obj, i32 sec)
{
    return EncodeCtx { .out = out, .rex = X86Rex::new(), .obj = obj, .sec = sec };
}

// form signatures shared with the legacy table
pub enum VecFormSig
{
    VFS_NONE,    // no operands (vzeroupper)
    VFS_R_RM,    // rm, dst — 2-op moves/converts
    VFS_RM_R,    // dst, rm — store form
    VFS_RRM,     // rm, vvvv, dst — 3-op arith
    VFS_RRM_I,   // imm, rm, vvvv, dst — 4-op with imm8
    VFS_XRM_I,   // imm, rm, dst — extract form, vvvv unused
    VFS_XRM_V    // imm, rm, dst — shift-imm group; dst feeds vvvv,
                 // ModRM.reg carries row.ext as the /digit
}

pub enum VecEnc
{
    VEncVex,     // VEX only (xmm/ymm)
    VEncEvex,    // EVEX only
    VEncAuto,    // EVEX when zmm or mask present
    VEncLegacy   // legacy SSE: mandatory prefix + 0F escape; EVEX when
                 // a mask is requested (AVX-512VL gives SSE ops masking)
}

// vector row: opcode byte + VEX escape + prefix + width policy
// op2esc: 0 = plain 0F, 0x38 = 0F38, 0x3A = 0F3A
// wMode: 0 W0, 1 W1, 2 W from the GPR operand size
// llFix: 0 from dst size, 1 force L=1 (vzeroall)
// vvvvUse: ops[1] feeds vvvv (arith); false = vvvv unused (moves)
// rmCls: 0 vector/mem, 1 gpr/mem (vmovd, cvt-from-gpr)
// dstCls: 0 vector, 1 gpr (cvt-to-gpr)
pub struct VecRow
{
    str base;
    u8 sizeMask;   // SZ16|SZ32|SZ64 from x86_64's mask constants
    VecFormSig sig;
    u8 op;
    u8 op2esc;
    u8 immW;
    u8 enc;        // VecEnc
    u8 vexPp;
    u8 wMode;
    u8 llFix;
    bool vvvvUse;
    u8 rmCls;
    u8 dstCls;
    u8 ext;        // ModRM.reg /digit for group opcodes; 255 = none
}

const u8 VSZ16 = 16;
const u8 VSZ32 = 32;
const u8 VSZ64 = 64;

// ------------------------------------------------------------------
// vector table. AVX + AVX2 core; AVX-512 coverage is the EncAuto rows
// (same opcode, EVEX prefix, {k} masks on the destination operand).
// ------------------------------------------------------------------
const u8 VF_NONE = 0;
const u8 VF_R_RM = 1;
const u8 VF_RM_R = 2;
const u8 VF_RRM = 3;
const u8 VF_RRM_I = 4;
const u8 VF_XRM_I = 5;
const u8 VF_XRM_V = 6;
const u8 VE_VEX = 0;
const u8 VE_EVEX = 1;
const u8 VE_AUTO = 2;
const u8 VE_LEGACY = 3;

