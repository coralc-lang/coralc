#[[no_drop_all]]
import(lib) std::text::string { String };
import(lib) wallvm::assembly::wasm::core { WasmAssembler, WatNode, WasmFunc, WasmExport, WasmGlobal, WasmType, watParseUnsigned };

void bindingsU32(String* out, u32 v)
{
    u8[10] buf;
    u32 n = 0;
    if (v == 0)
    {
        out->pushChar((u8)'0');
        return;
    }
    u32 x = v;
    while (x != 0)
    {
        buf[n] = (u8)('0' + (x % 10));
        x = x / 10;
        n++;
    }
    while (n > 0)
    {
        n--;
        out->pushChar(buf[n]);
    }
}

void bindingsHex(String* out, u8 b)
{
    str digits = "0123456789abcdef";
    out->pushChar((u8)digits.ptr[(b >> 4) & 0xF]);
    out->pushChar((u8)digits.ptr[b & 0xF]);
}

void bindingsJsString(String* out, str s)
{
    out->pushChar((u8)'"');
    for (usize i = 0; i < s.len; i++)
    {
        u8 c = s.ptr[i];
        if (c == (u8)'"') out->pushView("\\\"");
        else if (c == (u8)'\\') out->pushView("\\\\");
        else if (c == (u8)'\n') out->pushView("\\n");
        else if (c == (u8)'\r') out->pushView("\\r");
        else if (c == (u8)'\t') out->pushView("\\t");
        else if (c < 32)
        {
            out->pushView("\\x");
            bindingsHex(out, c);
        }
        else out->pushChar(c);
    }
    out->pushChar((u8)'"');
}

bool bindingsIdentStart(u8 c)
{
    return (c >= (u8)'a' && c <= (u8)'z') ||
           (c >= (u8)'A' && c <= (u8)'Z') ||
           c == (u8)'_' || c == (u8)'$';
}

bool bindingsIdentChar(u8 c)
{
    return bindingsIdentStart(c) || (c >= (u8)'0' && c <= (u8)'9');
}

void bindingsPascal(String* out, str name)
{
    bool upper = true;
    for (usize i = 0; i < name.len; i++)
    {
        u8 c = name.ptr[i];
        if (!bindingsIdentChar(c))
        {
            upper = true;
            continue;
        }
        if (upper && c >= (u8)'a' && c <= (u8)'z') c = (u8)(c - 32);
        out->pushChar(c);
        upper = false;
    }
    if (out->len == 0) out->pushView("Wasm");
    if (out->ptr[0] >= (u8)'0' && out->ptr[0] <= (u8)'9') 
    {
        String prefixed = String::from("Wasm");
        prefixed.pushView(out->asView());
        out->clear();
        out->pushView(prefixed.asView());
        prefixed.free();
    }
}

void bindingsTsType(String* out, u8 vt)
{
    if (vt == 0x7f) out->pushView("number");
    else if (vt == 0x7e) out->pushView("bigint");
    else if (vt == 0x7d) out->pushView("number");
    else if (vt == 0x7c) out->pushView("number");
    else if (vt == 0x70) out->pushView("Function | null");
    else if (vt == 0x6f) out->pushView("unknown");
    else out->pushView("unknown");
}

void bindingsTsParams(String* out, WasmType* t)
{
    for (usize i = 0; i < t->params.len; i++)
    {
        if (i > 0) out->pushView(", ");
        out->pushView("arg");
        bindingsU32(out, (u32)i);
        out->pushView(": ");
        bindingsTsType(out, t->params.data[i]);
    }
}

void bindingsTsResult(String* out, WasmType* t)
{
    if (t->results.len == 0)
    {
        out->pushView("void");
        return;
    }
    if (t->results.len == 1)
    {
        bindingsTsType(out, t->results.data[0]);
        return;
    }
    out->pushChar((u8)'[');
    for (usize i = 0; i < t->results.len; i++)
    {
        if (i > 0) out->pushView(", ");
        bindingsTsType(out, t->results.data[i]);
    }
    out->pushChar((u8)']');
}

pub extend WasmAssembler
{
    bool prepareBindings()
    {
        WatNode* root = self.parseNode();
        if (!self.ok) return false;
        self.skipSpace();
        if (!self.ok) return false;
        if (!self.atEnd()) { self.fail("trailing input after module", self.line); return false; }
        if (!self.parseModule(root)) return false;
        return self.assignIndices();
    }

    WasmFunc* bindingsFunc(u32 index)
    {
        for (usize i = 0; i < self.funcs.len; i++)
            if (self.funcs.data[i].index == index) return &self.funcs.data[i];
        return null;
    }

    WasmGlobal* bindingsGlobal(u32 index)
    {
        for (usize i = 0; i < self.globals.len; i++)
            if (self.globals.data[i].index == index) return &self.globals.data[i];
        return null;
    }

    bool bindingsHasImports()
    {
        for (usize i = 0; i < self.funcs.len; i++)
            if (self.funcs.data[i].isImport) return true;
        return false;
    }

    bool bindingsSeenImportModule(usize upto, str modName)
    {
        for (usize i = 0; i < upto; i++)
            if (self.funcs.data[i].isImport && self.funcs.data[i].importModule.asView().equals(modName))
                return true;
        return false;
    }

    void bindingsEmitJsExport(String* js, WasmExport* e)
    {
        if (e->kind == 0)
        {
            js->pushView("    ");
            bindingsJsString(js, e->name.asView());
            js->pushView(": (...args) => exports[");
            bindingsJsString(js, e->name.asView());
            js->pushView("](...args),\n");
        }
        else if (e->kind == 1 || e->kind == 2)
        {
            js->pushView("    get ");
            bindingsJsString(js, e->name.asView());
            js->pushView("() { return exports[");
            bindingsJsString(js, e->name.asView());
            js->pushView("]; },\n");
        }
        else if (e->kind == 3)
        {
            WasmGlobal* g = self.bindingsGlobal(e->index);
            js->pushView("    get ");
            bindingsJsString(js, e->name.asView());
            js->pushView("() { return exports[");
            bindingsJsString(js, e->name.asView());
            js->pushView("].value; },\n");
            if (g != null && g->mut)
            {
                js->pushView("    set ");
                bindingsJsString(js, e->name.asView());
                js->pushView("(value) { exports[");
                bindingsJsString(js, e->name.asView());
                js->pushView("].value = value; },\n");
            }
        }
    }

    void bindingsEmitTsRawExport(String* dts, WasmExport* e)
    {
        dts->pushView("  ");
        bindingsJsString(dts, e->name.asView());
        dts->pushView(": ");
        if (e->kind == 0)
        {
            WasmFunc* f = self.bindingsFunc(e->index);
            if (f == null) { dts->pushView("(...args: unknown[]) => unknown;\n"); return; }
            WasmType* t = &self.types.data[f->typeIndex];
            dts->pushChar((u8)'(');
            bindingsTsParams(dts, t);
            dts->pushView(") => ");
            bindingsTsResult(dts, t);
            dts->pushView(";\n");
        }
        else if (e->kind == 1) dts->pushView("WebAssembly.Table;\n");
        else if (e->kind == 2) dts->pushView("WebAssembly.Memory;\n");
        else if (e->kind == 3) dts->pushView("WebAssembly.Global;\n");
        else dts->pushView("unknown;\n");
    }

    void bindingsEmitTsWrapperExport(String* dts, WasmExport* e)
    {
        dts->pushView("  ");
        if (e->kind == 0)
        {
            WasmFunc* f = self.bindingsFunc(e->index);
            if (f == null)
            {
                bindingsJsString(dts, e->name.asView());
                dts->pushView(": (...args: unknown[]) => unknown;\n");
                return;
            }
            WasmType* t = &self.types.data[f->typeIndex];
            bindingsJsString(dts, e->name.asView());
            dts->pushView(": (");
            bindingsTsParams(dts, t);
            dts->pushView(") => ");
            bindingsTsResult(dts, t);
            dts->pushView(";\n");
        }
        else if (e->kind == 1 || e->kind == 2)
        {
            dts->pushView("readonly ");
            bindingsJsString(dts, e->name.asView());
            dts->pushView(": ");
            dts->pushView(e->kind == 1 ? "WebAssembly.Table" : "WebAssembly.Memory");
            dts->pushView(";\n");
        }
        else if (e->kind == 3)
        {
            WasmGlobal* g = self.bindingsGlobal(e->index);
            if (g != null && !g->mut) dts->pushView("readonly ");
            bindingsJsString(dts, e->name.asView());
            dts->pushView(": ");
            bindingsTsType(dts, g != null ? g->type : 0);
            dts->pushView(";\n");
        }
    }

    bool emitBindings(str moduleName, String* js, String* dts)
    {
        String ident = String::new();
        bindingsPascal(&ident, moduleName);
        str identView = ident.asView();

        js->clear();
        js->pushView("/* Generated by coral wasm bindings. Do not edit. */\n");
        js->pushView("export function bind(instance) {\n");
        js->pushView("  const exports = instance.exports;\n");
        js->pushView("  return {\n");
        js->pushView("    instance,\n");
        js->pushView("    exports,\n");
        for (usize i = 0; i < self.exports.len; i++)
            self.bindingsEmitJsExport(js, &self.exports.data[i]);
        js->pushView("  };\n");
        js->pushView("}\n\n");
        js->pushView("export async function instantiate(source, imports = {}) {\n");
        js->pushView("  const result = (typeof Response !== \"undefined\" && source instanceof Response)\n");
        js->pushView("    ? await WebAssembly.instantiateStreaming(source, imports)\n");
        js->pushView("    : await WebAssembly.instantiate(source, imports);\n");
        js->pushView("  return bind(result.instance !== undefined ? result.instance : result);\n");
        js->pushView("}\n\n");
        js->pushView("export default instantiate;\n");

        dts->clear();
        dts->pushView("/* Generated by coral wasm bindings. Do not edit. */\n");
        dts->pushView("export interface ");
        dts->pushView(identView);
        dts->pushView("ModuleImports {\n");
        for (usize i = 0; i < self.funcs.len; i++)
        {
            WasmFunc* f = &self.funcs.data[i];
            if (!f->isImport) continue;
            str modName = f->importModule.asView();
            if (self.bindingsSeenImportModule(i, modName)) continue;
            dts->pushView("  ");
            bindingsJsString(dts, modName);
            dts->pushView(": {\n");
            for (usize j = i; j < self.funcs.len; j++)
            {
                WasmFunc* g = &self.funcs.data[j];
                if (!g->isImport || !g->importModule.asView().equals(modName)) continue;
                WasmType* t = &self.types.data[g->typeIndex];
                dts->pushView("    ");
                bindingsJsString(dts, g->importName.asView());
                dts->pushView(": (");
                bindingsTsParams(dts, t);
                dts->pushView(") => ");
                bindingsTsResult(dts, t);
                dts->pushView(";\n");
            }
            dts->pushView("  };\n");
        }
        dts->pushView("}\n\n");

        dts->pushView("export interface ");
        dts->pushView(identView);
        dts->pushView("ModuleExports {\n");
        for (usize i = 0; i < self.exports.len; i++)
            self.bindingsEmitTsRawExport(dts, &self.exports.data[i]);
        dts->pushView("}\n\n");

        dts->pushView("export interface ");
        dts->pushView(identView);
        dts->pushView("Module {\n");
        dts->pushView("  readonly instance: WebAssembly.Instance;\n");
        dts->pushView("  readonly exports: ");
        dts->pushView(identView);
        dts->pushView("ModuleExports;\n");
        for (usize i = 0; i < self.exports.len; i++)
            self.bindingsEmitTsWrapperExport(dts, &self.exports.data[i]);
        dts->pushView("}\n\n");

        dts->pushView("export function bind(instance: WebAssembly.Instance): ");
        dts->pushView(identView);
        dts->pushView("Module;\n");
        dts->pushView("export function instantiate(source: BufferSource | WebAssembly.Module | Response, imports");
        if (self.bindingsHasImports()) dts->pushView(": ");
        else dts->pushView("?: ");
        dts->pushView(identView);
        dts->pushView("ModuleImports): Promise<");
        dts->pushView(identView);
        dts->pushView("Module>;\n");
        dts->pushView("export default instantiate;\n");

        ident.free();
        return true;
    }
}

pub bool wasmBindings(str wat, str moduleName, String* js, String* dts, String* error, u32* errorLine)
{
    WasmAssembler a = WasmAssembler::new(wat);
    if (!a.prepareBindings())
    {
        if (error != null)
        {
            error->clear();
            error->pushView(a.error.asView());
        }
        if (errorLine != null) *errorLine = a.errLine;
        return false;
    }
    if (js == null || dts == null) return false;
    return a.emitBindings(moduleName, js, dts);
}
