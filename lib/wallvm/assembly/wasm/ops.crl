#[[no_drop_all]]
import(lib) std::string { String };


pub struct WasmMemOp
{
    u16 opcode;
    u8 align;
}

pub struct WasmSimdOp
{
    u32 opcode;
    u8 imm;   // 0 none, 1 memarg, 2 lane, 3 shuffle, 4 const
    u8 align;
}

pub i32 wasmI32Op(str op)
{
    if (op.equals("eqz")) return 0x45;
    if (op.equals("eq")) return 0x46;
    if (op.equals("ne")) return 0x47;
    if (op.equals("lt_s")) return 0x48;
    if (op.equals("lt_u")) return 0x49;
    if (op.equals("gt_s")) return 0x4a;
    if (op.equals("gt_u")) return 0x4b;
    if (op.equals("le_s")) return 0x4c;
    if (op.equals("le_u")) return 0x4d;
    if (op.equals("ge_s")) return 0x4e;
    if (op.equals("ge_u")) return 0x4f;
    if (op.equals("clz")) return 0x67;
    if (op.equals("ctz")) return 0x68;
    if (op.equals("popcnt")) return 0x69;
    if (op.equals("add")) return 0x6a;
    if (op.equals("sub")) return 0x6b;
    if (op.equals("mul")) return 0x6c;
    if (op.equals("div_s")) return 0x6d;
    if (op.equals("div_u")) return 0x6e;
    if (op.equals("rem_s")) return 0x6f;
    if (op.equals("rem_u")) return 0x70;
    if (op.equals("and")) return 0x71;
    if (op.equals("or")) return 0x72;
    if (op.equals("xor")) return 0x73;
    if (op.equals("shl")) return 0x74;
    if (op.equals("shr_s")) return 0x75;
    if (op.equals("shr_u")) return 0x76;
    if (op.equals("rotl")) return 0x77;
    if (op.equals("rotr")) return 0x78;
    if (op.equals("extend8_s")) return 0xc0;
    if (op.equals("extend16_s")) return 0xc1;
    return -1;
}

pub i32 wasmI64Op(str op)
{
    if (op.equals("eqz")) return 0x50;
    if (op.equals("eq")) return 0x51;
    if (op.equals("ne")) return 0x52;
    if (op.equals("lt_s")) return 0x53;
    if (op.equals("lt_u")) return 0x54;
    if (op.equals("gt_s")) return 0x55;
    if (op.equals("gt_u")) return 0x56;
    if (op.equals("le_s")) return 0x57;
    if (op.equals("le_u")) return 0x58;
    if (op.equals("ge_s")) return 0x59;
    if (op.equals("ge_u")) return 0x5a;
    if (op.equals("clz")) return 0x79;
    if (op.equals("ctz")) return 0x7a;
    if (op.equals("popcnt")) return 0x7b;
    if (op.equals("add")) return 0x7c;
    if (op.equals("sub")) return 0x7d;
    if (op.equals("mul")) return 0x7e;
    if (op.equals("div_s")) return 0x7f;
    if (op.equals("div_u")) return 0x80;
    if (op.equals("rem_s")) return 0x81;
    if (op.equals("rem_u")) return 0x82;
    if (op.equals("and")) return 0x83;
    if (op.equals("or")) return 0x84;
    if (op.equals("xor")) return 0x85;
    if (op.equals("shl")) return 0x86;
    if (op.equals("shr_s")) return 0x87;
    if (op.equals("shr_u")) return 0x88;
    if (op.equals("rotl")) return 0x89;
    if (op.equals("rotr")) return 0x8a;
    if (op.equals("extend8_s")) return 0xc2;
    if (op.equals("extend16_s")) return 0xc3;
    if (op.equals("extend32_s")) return 0xc4;
    return -1;
}

pub i32 wasmF32Op(str op)
{
    if (op.equals("eq")) return 0x5b;
    if (op.equals("ne")) return 0x5c;
    if (op.equals("lt")) return 0x5d;
    if (op.equals("gt")) return 0x5e;
    if (op.equals("le")) return 0x5f;
    if (op.equals("ge")) return 0x60;
    if (op.equals("abs")) return 0x8b;
    if (op.equals("neg")) return 0x8c;
    if (op.equals("ceil")) return 0x8d;
    if (op.equals("floor")) return 0x8e;
    if (op.equals("trunc")) return 0x8f;
    if (op.equals("nearest")) return 0x90;
    if (op.equals("sqrt")) return 0x91;
    if (op.equals("add")) return 0x92;
    if (op.equals("sub")) return 0x93;
    if (op.equals("mul")) return 0x94;
    if (op.equals("div")) return 0x95;
    if (op.equals("min")) return 0x96;
    if (op.equals("max")) return 0x97;
    if (op.equals("copysign")) return 0x98;
    return -1;
}

pub i32 wasmF64Op(str op)
{
    if (op.equals("eq")) return 0x61;
    if (op.equals("ne")) return 0x62;
    if (op.equals("lt")) return 0x63;
    if (op.equals("gt")) return 0x64;
    if (op.equals("le")) return 0x65;
    if (op.equals("ge")) return 0x66;
    if (op.equals("abs")) return 0x99;
    if (op.equals("neg")) return 0x9a;
    if (op.equals("ceil")) return 0x9b;
    if (op.equals("floor")) return 0x9c;
    if (op.equals("trunc")) return 0x9d;
    if (op.equals("nearest")) return 0x9e;
    if (op.equals("sqrt")) return 0x9f;
    if (op.equals("add")) return 0xa0;
    if (op.equals("sub")) return 0xa1;
    if (op.equals("mul")) return 0xa2;
    if (op.equals("div")) return 0xa3;
    if (op.equals("min")) return 0xa4;
    if (op.equals("max")) return 0xa5;
    if (op.equals("copysign")) return 0xa6;
    return -1;
}

pub i32 wasmConversionOp(str m)
{
    if (m.equals("i32.wrap_i64")) return 0xa7;
    if (m.equals("i32.trunc_f32_s")) return 0xa8;
    if (m.equals("i32.trunc_f32_u")) return 0xa9;
    if (m.equals("i32.trunc_f64_s")) return 0xaa;
    if (m.equals("i32.trunc_f64_u")) return 0xab;
    if (m.equals("i64.extend_i32_s")) return 0xac;
    if (m.equals("i64.extend_i32_u")) return 0xad;
    if (m.equals("i64.trunc_f32_s")) return 0xae;
    if (m.equals("i64.trunc_f32_u")) return 0xaf;
    if (m.equals("i64.trunc_f64_s")) return 0xb0;
    if (m.equals("i64.trunc_f64_u")) return 0xb1;
    if (m.equals("f32.convert_i32_s")) return 0xb2;
    if (m.equals("f32.convert_i32_u")) return 0xb3;
    if (m.equals("f32.convert_i64_s")) return 0xb4;
    if (m.equals("f32.convert_i64_u")) return 0xb5;
    if (m.equals("f32.demote_f64")) return 0xb6;
    if (m.equals("f64.convert_i32_s")) return 0xb7;
    if (m.equals("f64.convert_i32_u")) return 0xb8;
    if (m.equals("f64.convert_i64_s")) return 0xb9;
    if (m.equals("f64.convert_i64_u")) return 0xba;
    if (m.equals("f64.promote_f32")) return 0xbb;
    if (m.equals("i32.reinterpret_f32")) return 0xbc;
    if (m.equals("i64.reinterpret_f64")) return 0xbd;
    if (m.equals("f32.reinterpret_i32")) return 0xbe;
    if (m.equals("f64.reinterpret_i64")) return 0xbf;
    return -1;
}

pub WasmMemOp wasmMemoryOp(str m)
{
    if (m.equals("i32.load")) return WasmMemOp { .opcode = 0x28, .align = 2 };
    if (m.equals("i64.load")) return WasmMemOp { .opcode = 0x29, .align = 3 };
    if (m.equals("f32.load")) return WasmMemOp { .opcode = 0x2a, .align = 2 };
    if (m.equals("f64.load")) return WasmMemOp { .opcode = 0x2b, .align = 3 };
    if (m.equals("i32.load8_s")) return WasmMemOp { .opcode = 0x2c, .align = 0 };
    if (m.equals("i32.load8_u")) return WasmMemOp { .opcode = 0x2d, .align = 0 };
    if (m.equals("i32.load16_s")) return WasmMemOp { .opcode = 0x2e, .align = 1 };
    if (m.equals("i32.load16_u")) return WasmMemOp { .opcode = 0x2f, .align = 1 };
    if (m.equals("i64.load8_s")) return WasmMemOp { .opcode = 0x30, .align = 0 };
    if (m.equals("i64.load8_u")) return WasmMemOp { .opcode = 0x31, .align = 0 };
    if (m.equals("i64.load16_s")) return WasmMemOp { .opcode = 0x32, .align = 1 };
    if (m.equals("i64.load16_u")) return WasmMemOp { .opcode = 0x33, .align = 1 };
    if (m.equals("i64.load32_s")) return WasmMemOp { .opcode = 0x34, .align = 2 };
    if (m.equals("i64.load32_u")) return WasmMemOp { .opcode = 0x35, .align = 2 };
    if (m.equals("i32.store")) return WasmMemOp { .opcode = 0x36, .align = 2 };
    if (m.equals("i64.store")) return WasmMemOp { .opcode = 0x37, .align = 3 };
    if (m.equals("f32.store")) return WasmMemOp { .opcode = 0x38, .align = 2 };
    if (m.equals("f64.store")) return WasmMemOp { .opcode = 0x39, .align = 3 };
    if (m.equals("i32.store8")) return WasmMemOp { .opcode = 0x3a, .align = 0 };
    if (m.equals("i32.store16")) return WasmMemOp { .opcode = 0x3b, .align = 1 };
    if (m.equals("i64.store8")) return WasmMemOp { .opcode = 0x3c, .align = 0 };
    if (m.equals("i64.store16")) return WasmMemOp { .opcode = 0x3d, .align = 1 };
    if (m.equals("i32.atomic.load")) return WasmMemOp { .opcode = 0xFE10, .align = 2 };
    if (m.equals("i64.atomic.load")) return WasmMemOp { .opcode = 0xFE11, .align = 3 };
    if (m.equals("i32.atomic.load8_u")) return WasmMemOp { .opcode = 0xFE12, .align = 0 };
    if (m.equals("i32.atomic.load16_u")) return WasmMemOp { .opcode = 0xFE13, .align = 1 };
    if (m.equals("i64.atomic.load8_u")) return WasmMemOp { .opcode = 0xFE14, .align = 0 };
    if (m.equals("i64.atomic.load16_u")) return WasmMemOp { .opcode = 0xFE15, .align = 1 };
    if (m.equals("i64.atomic.load32_u")) return WasmMemOp { .opcode = 0xFE16, .align = 2 };
    if (m.equals("i32.atomic.store")) return WasmMemOp { .opcode = 0xFE17, .align = 2 };
    if (m.equals("i64.atomic.store")) return WasmMemOp { .opcode = 0xFE18, .align = 3 };
    if (m.equals("i32.atomic.store8")) return WasmMemOp { .opcode = 0xFE19, .align = 0 };
    if (m.equals("i32.atomic.store16")) return WasmMemOp { .opcode = 0xFE1A, .align = 1 };
    if (m.equals("i64.atomic.store8")) return WasmMemOp { .opcode = 0xFE1B, .align = 0 };
    if (m.equals("i64.atomic.store16")) return WasmMemOp { .opcode = 0xFE1C, .align = 1 };
    if (m.equals("i64.atomic.store32")) return WasmMemOp { .opcode = 0xFE1D, .align = 2 };
    if (m.equals("i32.atomic.rmw.add")) return WasmMemOp { .opcode = 0xFE1E, .align = 2 };
    if (m.equals("i64.atomic.rmw.add")) return WasmMemOp { .opcode = 0xFE1F, .align = 3 };
    if (m.equals("i32.atomic.rmw8.add_u")) return WasmMemOp { .opcode = 0xFE20, .align = 0 };
    if (m.equals("i32.atomic.rmw16.add_u")) return WasmMemOp { .opcode = 0xFE21, .align = 1 };
    if (m.equals("i64.atomic.rmw8.add_u")) return WasmMemOp { .opcode = 0xFE22, .align = 0 };
    if (m.equals("i64.atomic.rmw16.add_u")) return WasmMemOp { .opcode = 0xFE23, .align = 1 };
    if (m.equals("i64.atomic.rmw32.add_u")) return WasmMemOp { .opcode = 0xFE24, .align = 2 };
    if (m.equals("i32.atomic.rmw.sub")) return WasmMemOp { .opcode = 0xFE25, .align = 2 };
    if (m.equals("i64.atomic.rmw.sub")) return WasmMemOp { .opcode = 0xFE26, .align = 3 };
    if (m.equals("i32.atomic.rmw8.sub_u")) return WasmMemOp { .opcode = 0xFE27, .align = 0 };
    if (m.equals("i32.atomic.rmw16.sub_u")) return WasmMemOp { .opcode = 0xFE28, .align = 1 };
    if (m.equals("i64.atomic.rmw8.sub_u")) return WasmMemOp { .opcode = 0xFE29, .align = 0 };
    if (m.equals("i64.atomic.rmw16.sub_u")) return WasmMemOp { .opcode = 0xFE2A, .align = 1 };
    if (m.equals("i64.atomic.rmw32.sub_u")) return WasmMemOp { .opcode = 0xFE2B, .align = 2 };
    if (m.equals("i32.atomic.rmw.and")) return WasmMemOp { .opcode = 0xFE2C, .align = 2 };
    if (m.equals("i64.atomic.rmw.and")) return WasmMemOp { .opcode = 0xFE2D, .align = 3 };
    if (m.equals("i32.atomic.rmw8.and_u")) return WasmMemOp { .opcode = 0xFE2E, .align = 0 };
    if (m.equals("i32.atomic.rmw16.and_u")) return WasmMemOp { .opcode = 0xFE2F, .align = 1 };
    if (m.equals("i64.atomic.rmw8.and_u")) return WasmMemOp { .opcode = 0xFE30, .align = 0 };
    if (m.equals("i64.atomic.rmw16.and_u")) return WasmMemOp { .opcode = 0xFE31, .align = 1 };
    if (m.equals("i64.atomic.rmw32.and_u")) return WasmMemOp { .opcode = 0xFE32, .align = 2 };
    if (m.equals("i32.atomic.rmw.or")) return WasmMemOp { .opcode = 0xFE33, .align = 2 };
    if (m.equals("i64.atomic.rmw.or")) return WasmMemOp { .opcode = 0xFE34, .align = 3 };
    if (m.equals("i32.atomic.rmw8.or_u")) return WasmMemOp { .opcode = 0xFE35, .align = 0 };
    if (m.equals("i32.atomic.rmw16.or_u")) return WasmMemOp { .opcode = 0xFE36, .align = 1 };
    if (m.equals("i64.atomic.rmw8.or_u")) return WasmMemOp { .opcode = 0xFE37, .align = 0 };
    if (m.equals("i64.atomic.rmw16.or_u")) return WasmMemOp { .opcode = 0xFE38, .align = 1 };
    if (m.equals("i64.atomic.rmw32.or_u")) return WasmMemOp { .opcode = 0xFE39, .align = 2 };
    if (m.equals("i32.atomic.rmw.xor")) return WasmMemOp { .opcode = 0xFE3A, .align = 2 };
    if (m.equals("i64.atomic.rmw.xor")) return WasmMemOp { .opcode = 0xFE3B, .align = 3 };
    if (m.equals("i32.atomic.rmw8.xor_u")) return WasmMemOp { .opcode = 0xFE3C, .align = 0 };
    if (m.equals("i32.atomic.rmw16.xor_u")) return WasmMemOp { .opcode = 0xFE3D, .align = 1 };
    if (m.equals("i64.atomic.rmw8.xor_u")) return WasmMemOp { .opcode = 0xFE3E, .align = 0 };
    if (m.equals("i64.atomic.rmw16.xor_u")) return WasmMemOp { .opcode = 0xFE3F, .align = 1 };
    if (m.equals("i64.atomic.rmw32.xor_u")) return WasmMemOp { .opcode = 0xFE40, .align = 2 };
    if (m.equals("i32.atomic.rmw.xchg")) return WasmMemOp { .opcode = 0xFE41, .align = 2 };
    if (m.equals("i64.atomic.rmw.xchg")) return WasmMemOp { .opcode = 0xFE42, .align = 3 };
    if (m.equals("i32.atomic.rmw8.xchg_u")) return WasmMemOp { .opcode = 0xFE43, .align = 0 };
    if (m.equals("i32.atomic.rmw16.xchg_u")) return WasmMemOp { .opcode = 0xFE44, .align = 1 };
    if (m.equals("i64.atomic.rmw8.xchg_u")) return WasmMemOp { .opcode = 0xFE45, .align = 0 };
    if (m.equals("i64.atomic.rmw16.xchg_u")) return WasmMemOp { .opcode = 0xFE46, .align = 1 };
    if (m.equals("i64.atomic.rmw32.xchg_u")) return WasmMemOp { .opcode = 0xFE47, .align = 2 };
    if (m.equals("i32.atomic.rmw.cmpxchg")) return WasmMemOp { .opcode = 0xFE48, .align = 2 };
    if (m.equals("i64.atomic.rmw.cmpxchg")) return WasmMemOp { .opcode = 0xFE49, .align = 3 };
    if (m.equals("i32.atomic.rmw8.cmpxchg_u")) return WasmMemOp { .opcode = 0xFE4A, .align = 0 };
    if (m.equals("i32.atomic.rmw16.cmpxchg_u")) return WasmMemOp { .opcode = 0xFE4B, .align = 1 };
    if (m.equals("i64.atomic.rmw8.cmpxchg_u")) return WasmMemOp { .opcode = 0xFE4C, .align = 0 };
    if (m.equals("i64.atomic.rmw16.cmpxchg_u")) return WasmMemOp { .opcode = 0xFE4D, .align = 1 };
    if (m.equals("i64.atomic.rmw32.cmpxchg_u")) return WasmMemOp { .opcode = 0xFE4E, .align = 2 };
    if (m.equals("memory.atomic.notify")) return WasmMemOp { .opcode = 0xFE00, .align = 2 };
    if (m.equals("memory.atomic.wait32")) return WasmMemOp { .opcode = 0xFE01, .align = 2 };
    if (m.equals("memory.atomic.wait64")) return WasmMemOp { .opcode = 0xFE02, .align = 3 };
    if (m.equals("i64.store32")) return WasmMemOp { .opcode = 0x3e, .align = 2 };
    if (m.equals("v128.load") || m.equals("v128.store")) return WasmMemOp { .opcode = 0, .align = 4 };
    return WasmMemOp { .opcode = 0, .align = 0 };
}

pub WasmSimdOp wasmSimdOp(str m)
{
    WasmSimdOp n = WasmSimdOp { .opcode = 0xFFFFFFFF, .imm = 0, .align = 0 };
    if (m.equals("v128.load")) return WasmSimdOp { .opcode = 0x00, .imm = 1, .align = 4 };
    if (m.equals("v128.store")) return WasmSimdOp { .opcode = 0x0B, .imm = 1, .align = 4 };
    if (m.equals("v128.const")) return WasmSimdOp { .opcode = 0x0C, .imm = 4, .align = 0 };
    if (m.equals("i8x16.shuffle")) return WasmSimdOp { .opcode = 0x0D, .imm = 3, .align = 0 };
    if (m.equals("i8x16.splat")) return WasmSimdOp { .opcode = 0x0F, .imm = 0, .align = 0 };
    if (m.equals("i16x8.splat")) return WasmSimdOp { .opcode = 0x10, .imm = 0, .align = 0 };
    if (m.equals("i32x4.splat")) return WasmSimdOp { .opcode = 0x11, .imm = 0, .align = 0 };
    if (m.equals("i64x2.splat")) return WasmSimdOp { .opcode = 0x12, .imm = 0, .align = 0 };
    if (m.equals("f32x4.splat")) return WasmSimdOp { .opcode = 0x13, .imm = 0, .align = 0 };
    if (m.equals("f64x2.splat")) return WasmSimdOp { .opcode = 0x14, .imm = 0, .align = 0 };
    if (m.equals("i8x16.extract_lane_s")) return WasmSimdOp { .opcode = 0x15, .imm = 2, .align = 0 };
    if (m.equals("i8x16.extract_lane_u")) return WasmSimdOp { .opcode = 0x16, .imm = 2, .align = 0 };
    if (m.equals("i8x16.replace_lane")) return WasmSimdOp { .opcode = 0x17, .imm = 2, .align = 0 };
    if (m.equals("i16x8.extract_lane_s")) return WasmSimdOp { .opcode = 0x18, .imm = 2, .align = 0 };
    if (m.equals("i16x8.extract_lane_u")) return WasmSimdOp { .opcode = 0x19, .imm = 2, .align = 0 };
    if (m.equals("i16x8.replace_lane")) return WasmSimdOp { .opcode = 0x1A, .imm = 2, .align = 0 };
    if (m.equals("i32x4.extract_lane")) return WasmSimdOp { .opcode = 0x1B, .imm = 2, .align = 0 };
    if (m.equals("i32x4.replace_lane")) return WasmSimdOp { .opcode = 0x1C, .imm = 2, .align = 0 };
    if (m.equals("i64x2.extract_lane")) return WasmSimdOp { .opcode = 0x1D, .imm = 2, .align = 0 };
    if (m.equals("i64x2.replace_lane")) return WasmSimdOp { .opcode = 0x1E, .imm = 2, .align = 0 };
    if (m.equals("f32x4.extract_lane")) return WasmSimdOp { .opcode = 0x1F, .imm = 2, .align = 0 };
    if (m.equals("f32x4.replace_lane")) return WasmSimdOp { .opcode = 0x20, .imm = 2, .align = 0 };
    if (m.equals("f64x2.extract_lane")) return WasmSimdOp { .opcode = 0x21, .imm = 2, .align = 0 };
    if (m.equals("f64x2.replace_lane")) return WasmSimdOp { .opcode = 0x22, .imm = 2, .align = 0 };
    if (m.equals("v128.and")) return WasmSimdOp { .opcode = 0x4E, .imm = 0, .align = 0 };
    if (m.equals("i8x16.add")) return WasmSimdOp { .opcode = 0x6E, .imm = 0, .align = 0 };
    if (m.equals("i8x16.sub")) return WasmSimdOp { .opcode = 0x71, .imm = 0, .align = 0 };
    if (m.equals("i8x16.min_s")) return WasmSimdOp { .opcode = 0x76, .imm = 0, .align = 0 };
    if (m.equals("i8x16.min_u")) return WasmSimdOp { .opcode = 0x77, .imm = 0, .align = 0 };
    if (m.equals("i8x16.max_s")) return WasmSimdOp { .opcode = 0x78, .imm = 0, .align = 0 };
    if (m.equals("i8x16.max_u")) return WasmSimdOp { .opcode = 0x79, .imm = 0, .align = 0 };
    if (m.equals("i8x16.narrow_i16x8_u")) return WasmSimdOp { .opcode = 0x66, .imm = 0, .align = 0 };
    if (m.equals("i16x8.extmul_low_i8x16_s")) return WasmSimdOp { .opcode = 0x9B, .imm = 0, .align = 0 };
    if (m.equals("i16x8.extmul_high_i8x16_s")) return WasmSimdOp { .opcode = 0x9C, .imm = 0, .align = 0 };
    if (m.equals("i16x8.add")) return WasmSimdOp { .opcode = 0x8E, .imm = 0, .align = 0 };
    if (m.equals("i16x8.sub")) return WasmSimdOp { .opcode = 0x91, .imm = 0, .align = 0 };
    if (m.equals("i16x8.mul")) return WasmSimdOp { .opcode = 0x95, .imm = 0, .align = 0 };
    if (m.equals("i16x8.min_s")) return WasmSimdOp { .opcode = 0x96, .imm = 0, .align = 0 };
    if (m.equals("i16x8.min_u")) return WasmSimdOp { .opcode = 0x97, .imm = 0, .align = 0 };
    if (m.equals("i16x8.max_s")) return WasmSimdOp { .opcode = 0x98, .imm = 0, .align = 0 };
    if (m.equals("i16x8.max_u")) return WasmSimdOp { .opcode = 0x99, .imm = 0, .align = 0 };
    if (m.equals("i32x4.add")) return WasmSimdOp { .opcode = 0xAE, .imm = 0, .align = 0 };
    if (m.equals("i32x4.sub")) return WasmSimdOp { .opcode = 0xB1, .imm = 0, .align = 0 };
    if (m.equals("i32x4.mul")) return WasmSimdOp { .opcode = 0xB5, .imm = 0, .align = 0 };
    if (m.equals("i32x4.min_s")) return WasmSimdOp { .opcode = 0xB6, .imm = 0, .align = 0 };
    if (m.equals("i32x4.min_u")) return WasmSimdOp { .opcode = 0xB7, .imm = 0, .align = 0 };
    if (m.equals("i32x4.max_s")) return WasmSimdOp { .opcode = 0xB8, .imm = 0, .align = 0 };
    if (m.equals("i32x4.max_u")) return WasmSimdOp { .opcode = 0xB9, .imm = 0, .align = 0 };
    if (m.equals("i64x2.add")) return WasmSimdOp { .opcode = 0xCE, .imm = 0, .align = 0 };
    if (m.equals("i64x2.sub")) return WasmSimdOp { .opcode = 0xD1, .imm = 0, .align = 0 };
    if (m.equals("i64x2.mul")) return WasmSimdOp { .opcode = 0xD5, .imm = 0, .align = 0 };
    if (m.equals("f32x4.add")) return WasmSimdOp { .opcode = 0xE4, .imm = 0, .align = 0 };
    if (m.equals("f32x4.sub")) return WasmSimdOp { .opcode = 0xE5, .imm = 0, .align = 0 };
    if (m.equals("f32x4.mul")) return WasmSimdOp { .opcode = 0xE6, .imm = 0, .align = 0 };
    if (m.equals("f32x4.div")) return WasmSimdOp { .opcode = 0xE7, .imm = 0, .align = 0 };
    if (m.equals("f32x4.min")) return WasmSimdOp { .opcode = 0xE8, .imm = 0, .align = 0 };
    if (m.equals("f32x4.max")) return WasmSimdOp { .opcode = 0xE9, .imm = 0, .align = 0 };
    if (m.equals("f64x2.add")) return WasmSimdOp { .opcode = 0xF0, .imm = 0, .align = 0 };
    if (m.equals("f64x2.sub")) return WasmSimdOp { .opcode = 0xF1, .imm = 0, .align = 0 };
    if (m.equals("f64x2.mul")) return WasmSimdOp { .opcode = 0xF2, .imm = 0, .align = 0 };
    if (m.equals("f64x2.div")) return WasmSimdOp { .opcode = 0xF3, .imm = 0, .align = 0 };
    if (m.equals("f64x2.min")) return WasmSimdOp { .opcode = 0xF4, .imm = 0, .align = 0 };
    if (m.equals("f64x2.max")) return WasmSimdOp { .opcode = 0xF5, .imm = 0, .align = 0 };
    return n;
}

