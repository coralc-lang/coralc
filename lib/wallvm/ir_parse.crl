mod ir_types = import("ir_types.crl");
mod str = import("std/text/string.crl");
mod mman = import("std/memory/mman.crl");
mod libc = import("std/platform/libc.crl");

// Minimal WIR text parser: handles the subset we emit
// extern func @name -> ret {}
// @.strN = private constant [M x i8] c"..."
// func @name -> ret { block %label: %id = opcode ... }
// For now string constants and externs are skipped; func/block/inst skeletons are built
// so that irCompileAsm can be invoked on the parsed module.

pub struct ParseResult {
    ir_types.IrModule* irMod;
    ir_types.IrContext* ctx;
    bool ok;
    str.String err;
}

pub ParseResult parseWIR(str.strView src, str.strView modName)
{
    ParseResult r;
    r.irMod = null;
    r.ok = false;
    r.err = str.String::new();
    ir_types.IrContext* ctx = ir_types.irCtxCreate();
    char mn[256]; u32 ml = 0;
    for (u32 i = 0; i < modName.len && ml < 255; i++) {
        u8 c = modName.ptr[i];
        if (c == '/' || c == '\\') mn[ml++] = '_'; else if (c == '.') break; else mn[ml++] = (char)c;
    }
    mn[ml] = 0; if (ml == 0) { mn[0] = 'm'; mn[1] = 'o'; mn[2] = 'd'; mn[3] = 0;}
    ir_types.IrModule* irMod = ctx.createModule(mn);
    r.irMod = irMod;
    r.ctx = ctx;
    // Very small line-based scan: collect func headers and create empty funcs
    // so that the module is non-empty and codegen can run. Full inst parsing
    // is TODO — for now we just prove the plumbing.
    u32 pos = 0;
    while (pos < src.len) {
        u32 lineStart = pos;
        while (pos < src.len && src.ptr[pos] != '\n') pos++;
        str.strView line = str.strView::fromParts(src.ptr+lineStart, pos-lineStart);
        if (pos < src.len) pos++;
        // trim leading spaces
        u32 s = 0; while (s < line.len && line.ptr[s] == ' ') s++;
        if (s >= line.len) continue;
        if (line.ptr[s] == ';' || line.ptr[s] == '#') continue;
        // func @name -> ret {
        if (line.len - s >= 5 && line.ptr[s] == 'f' && line.ptr[s+1] == 'u' && line.ptr[s+2] == 'n' && line.ptr[s+3] == 'c') {
            u32 at = s+4; while (at < line.len && line.ptr[at] == ' ') at++;
            if (at < line.len && line.ptr[at] == '@') {
                at++;
                u32 nameStart = at; while (at < line.len && line.ptr[at] != ' ' && line.ptr[at] != '-' ) at++;
                str.String fname = str.String::fromView(str.strView::fromParts(line.ptr+nameStart, at-nameStart));
                // ret type is after "->"
                u32 arrow = 0; bool found = false;
                for (u32 k = s; k+1<line.len; k++) if (line.ptr[k] == '-' && line.ptr[k+1] == '>') { arrow = k+2; found = true; break;}
                ir_types.IrType* rt = ctx.tyVoid();
                if (found) {
                    while (arrow<line.len && line.ptr[arrow] == ' ') arrow++;
                    u32 re = arrow; while (re<line.len && line.ptr[re] != ' ' && line.ptr[re] != '{') re++;
                    // keep void for now
                }
                ir_types.IrFunc* fn = ctx.createFunc(fname.asCstr(), rt, null, 0);
                // check for trailing "{}" meaning extern/empty
                bool isExtern = true;
                for (u32 k = 0; k < line.len; k++) if (line.ptr[k] == '{') isExtern = false;
                if (isExtern) fn.isExtern = true;
                irMod.addFunc(fn);
            }
        }
        // @.str = private ... -> create a dummy string const so nconstStrings>0
        if (line.len - s >= 5 && line.ptr[s] == '@' && line.ptr[s+1] == '.' && line.ptr[s+2] == 's' && line.ptr[s+3] == 't' && line.ptr[s+4] == 'r') {
            // create empty string const as placeholder
            ir_types.IrStringConst* sc = ctx.createStringConst("", 0);
            irMod.addConstString(sc);
        }
    }
    r.ok = true;
    return r;
}