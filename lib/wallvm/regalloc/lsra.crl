#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrType, IrTypeKind, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };
import(lib) wallvm::rules::asm_rules { ABIRules };
import(lib) std::mman { alloc, dealloc, copy };
import(lib) std::io::ios { eprintln };

const u32 NO_REG = 0xFFFFFFFF;
const i32 NO_SLOT = -1;
const u64 SPILL_BIT = 0x80000000UL;
const u64 FLOAT_BIT = 0x40000000UL;

// Debug knob: dump the linear order, live intervals and final assignments
// so a bad reg/interval pairing is visible without a gdb session.
pub bool gLsraVerbose = false;

pub struct RegAllocConfig
{
    bool useCalleeSave; // false, caller-save regs only (no prologue/epilogue needed)
    bool backendHandlesSpills; // true, backend decodes SPILL_BIT, no IR spill rewriting
    str* reservedIntRegs;
    u32 numReservedIntRegs;
    str* reservedFloatRegs;
    u32 numReservedFloatRegs;
}

pub RegAllocConfig defaultRegAllocConfig()
{
    RegAllocConfig c;
    c.useCalleeSave = true;
    c.backendHandlesSpills = false;
    c.reservedIntRegs = null;
    c.numReservedIntRegs = 0;
    c.reservedFloatRegs = null;
    c.numReservedFloatRegs = 0;
    return c;
}

bool isReservedName(str name, str* reserved, u32 n)
{
    if (name.ptr == null || reserved == null) return false;
    for (u32 i = 0; i < n; i++)
    {
        str r = reserved[i];
        if (r.ptr == null) continue;
        if (name.equals(r)) return true;
    }
    return false;
}

pub struct LiveInterval
{
    u32 vreg;
    u32 start;
    u32 end;
    u32 physReg;
    i32 spillSlot;
    bool isFloat;
    bool spansCall;
    // Greedy allocator — hotness per unit of register occupancy.
    u32 uses;
    u32 defs;
    f64 spillWeight;
}

pub struct LinearScanRegAlloc
{
    IrContext* ctx;
    u32 numRegs;
    u32 numFloatRegs;
    u32 numCallerSave;
    str* intRegNames;
    str* floatRegNames;
    bool useCalleeSave;
    bool backendHandlesSpills;
    ABIRules* abi;

    u32 numVregs;

    IrValue** vregValues;
    u32 capVregs;

    LiveInterval* intervals;
    u32 numIntervals;
    u32 capIntervals;

    u32* regForVreg;
    i32* slotForVreg;

    IrBlock** blocks;
    u32 numBlocks;

    u32* blockStartInst;
    u32 totalInsts;
    u32* instVreg;
    u32* instBlock;
    IrInst** linearInsts;
    bool* instIsCall;

    // Live-out sets kept from the interval fixpoint, flat [block*numVregs + vreg].
    // Two-address coalescing uses them to confirm that an operand dying at its
    // last use (end == def position) is not live-out of that block — a
    // loop-carried value crossing a backedge can have end == last-use yet still
    // be read on the next iteration, so the interval end alone is not a sound
    // "dead here" signal.
    bool* liveOutSets;
    u32 numLiveOutBlocks;

    u32* active;
    u32 numActive;

    u32* floatActive;
    u32 numFloatActive;

    u32* regIsFree;
    u32* floatRegIsFree;

    i32 nextSpillSlot;
    IrType* wordType;

    // Per-spill-slot alloca, slotAlloca[slot] = alloca instruction base value
    IrValue** slotAllocas;
    u32 numSlots;

    // Incoming parameters — undefined Inst-kind values consumed by entry
    // stores. Each gets its own vreg with an interval starting at 0 so the
    // scanner assigns it a home; the backend seeds that home from the ABI
    // argument register in the prologue.
    IrValue** paramVals;
    u32 numParams;
    u32 capParams;

    static LinearScanRegAlloc new(IrContext* ctx, ABIRules* abi, RegAllocConfig* cfg)
    {
        LinearScanRegAlloc r;
        r.ctx = ctx;
        r.abi = abi;
        r.useCalleeSave = true;
        r.backendHandlesSpills = false;
        if (cfg != null)
        {
            r.useCalleeSave = cfg->useCalleeSave;
            r.backendHandlesSpills = cfg->backendHandlesSpills;
        }
        r.numRegs = 0;
        r.numFloatRegs = 0;
        r.numCallerSave = 0;
        r.intRegNames = null;
        r.floatRegNames = null;
        if (abi != null)
        {
            u32 callerCount = abi->numCallerSaveRegs;
            u32 calleeCount = r.useCalleeSave ? abi->numCalleeSaveRegs : 0;
            u32 keptCaller = 0;
            u32 keptCallee = 0;
            u32 fcount = abi->numFloatArgRegs;
            u32 keptFloat = 0;
            for (u32 i = 0; i < callerCount; i++)
                if (!isReservedName(abi->callerSaveRegs[i], cfg != null ? cfg->reservedIntRegs : null, cfg != null ? cfg->numReservedIntRegs : 0))
                    keptCaller++;
            for (u32 i = 0; i < calleeCount; i++)
                if (!isReservedName(abi->calleeSaveRegs[i], cfg != null ? cfg->reservedIntRegs : null, cfg != null ? cfg->numReservedIntRegs : 0))
                    keptCallee++;
            for (u32 i = 0; i < fcount; i++)
                if (!isReservedName(abi->floatArgRegs[i], cfg != null ? cfg->reservedFloatRegs : null, cfg != null ? cfg->numReservedFloatRegs : 0))
                    keptFloat++;
            r.numRegs = keptCaller + keptCallee;
            r.numFloatRegs = keptFloat;
            r.numCallerSave = keptCaller;
            if (r.numRegs > 0)
            {
                r.intRegNames = alloc<str>((usize)r.numRegs);
                #[[maybe_unused]] u32 k = 0;
                for (u32 i = 0; i < callerCount; i++)
                    if (!isReservedName(abi->callerSaveRegs[i], cfg != null ? cfg->reservedIntRegs : null, cfg != null ? cfg->numReservedIntRegs : 0))
                        r.intRegNames[k++] = abi->callerSaveRegs[i];
                for (u32 i = 0; i < calleeCount; i++)
                    if (!isReservedName(abi->calleeSaveRegs[i], cfg != null ? cfg->reservedIntRegs : null, cfg != null ? cfg->numReservedIntRegs : 0))
                        r.intRegNames[k++] = abi->calleeSaveRegs[i];
            }
            if (r.numFloatRegs > 0)
            {
                r.floatRegNames = alloc<str>((usize)r.numFloatRegs);
                #[[maybe_unused]] u32 k = 0;
                for (u32 i = 0; i < fcount; i++)
                    if (!isReservedName(abi->floatArgRegs[i], cfg != null ? cfg->reservedFloatRegs : null, cfg != null ? cfg->numReservedFloatRegs : 0))
                        r.floatRegNames[k++] = abi->floatArgRegs[i];
            }
        }
        if (r.numRegs == 0 && abi == null) { r.numRegs = 16; r.numCallerSave = 16; }
        if (r.numFloatRegs == 0 && abi == null) r.numFloatRegs = 8;
        r.numVregs = 0;
        r.vregValues = null;
        r.capVregs = 0;
        r.intervals = null;
        r.numIntervals = 0;
        r.capIntervals = 0;
        r.regForVreg = null;
        r.slotForVreg = null;
        r.blocks = null;
        r.numBlocks = 0;
        r.blockStartInst = null;
        r.totalInsts = 0;
        r.instVreg = null;
        r.instBlock = null;
        r.linearInsts = null;
        r.active = null;
        r.numActive = 0;
        r.floatActive = null;
        r.numFloatActive = 0;
        r.regIsFree = null;
        r.floatRegIsFree = null;
        r.nextSpillSlot = 0;
        r.wordType = null;
        r.slotAllocas = null;
        r.numSlots = 0;
        r.paramVals = null;
        r.numParams = 0;
        r.capParams = 0;
        r.liveOutSets = null;
        r.numLiveOutBlocks = 0;
        return r;
    }

    void ensureVregs(u32 vreg)
    {
        if (vreg >= self.capVregs)
        {
            u32 newCap = self.capVregs ? self.capVregs * 2 : 64;
            if (newCap <= vreg) newCap = vreg + 64;
            IrValue** newVals = alloc<IrValue*>((usize)newCap);
            u32* newRegs = alloc<u32>((usize)newCap);
            i32* newSlots = alloc<i32>((usize)newCap);
            if (self.vregValues != null)
            {
                copy<IrValue*>(newVals, self.vregValues, (usize)self.capVregs);
                copy<u32>(newRegs, self.regForVreg, (usize)self.capVregs);
                copy<i32>(newSlots, self.slotForVreg, (usize)self.capVregs);
                dealloc<IrValue*>(self.vregValues);
                dealloc<u32>(self.regForVreg);
                dealloc<i32>(self.slotForVreg);
            }
            for (u32 i = self.capVregs; i < newCap; i++)
            {
                newVals[i] = null;
                newRegs[i] = NO_REG;
                newSlots[i] = NO_SLOT;
            }
            self.vregValues = newVals;
            self.regForVreg = newRegs;
            self.slotForVreg = newSlots;
            self.capVregs = newCap;
        }
    }

    void ensureIntervals()
    {
        if (self.numIntervals >= self.capIntervals)
        {
            u32 newCap = self.capIntervals ? self.capIntervals * 2 : 64;
            LiveInterval* newInts = alloc<LiveInterval>((usize)newCap);
            if (self.intervals != null)
            {
                copy<LiveInterval>(newInts, self.intervals, (usize)self.numIntervals);
                dealloc<LiveInterval>(self.intervals);
            }
            self.intervals = newInts;
            self.capIntervals = newCap;
        }
    }

    void ensureSlotAllocas(i32 slot)
    {
        u32 s = (u32)slot;
        if (s >= self.numSlots)
        {
            u32 oldNum = self.numSlots;
            self.numSlots = s + 1;
            IrValue** newSa = alloc<IrValue*>((usize)self.numSlots);
            if (self.slotAllocas != null)
            {
                copy<IrValue*>(newSa, self.slotAllocas, (usize)oldNum);
                dealloc<IrValue*>(self.slotAllocas);
            }
            for (u32 i = oldNum; i < self.numSlots; i++)
                newSa[i] = null;
            self.slotAllocas = newSa;
        }
    }

    void ensureParams(u32 n)
    {
        if (n < self.capParams) return;
        u32 nc = self.capParams ? self.capParams * 2 : 8;
        while (nc <= n) nc *= 2;
        IrValue** np = alloc<IrValue*>((usize)nc);
        for (u32 i = 0; i < self.numParams; i++) np[i] = self.paramVals[i];
        if (self.paramVals != null) dealloc<IrValue*>(self.paramVals);
        self.paramVals = np;
        self.capParams = nc;
    }

    void assignVregs(IrFunc* func)
    {
        self.blocks = func->blocks;
        self.numBlocks = func->nblocks;

        u32 total = 0;
        for (u32 b = 0; b < self.numBlocks; b++)
            total += self.blocks[b]->ninsts;
        self.totalInsts = total;

        self.blockStartInst = alloc<u32>((usize)self.numBlocks);
        self.instVreg = alloc<u32>((usize)total);
        self.instBlock = alloc<u32>((usize)total);
        self.linearInsts = alloc<IrInst*>((usize)total);
        self.instIsCall = alloc<bool>((usize)total);

        for (u32 i = 0; i < total; i++)
        {
            self.instVreg[i] = NO_REG;
            self.instBlock[i] = 0;
            self.linearInsts[i] = null;
            self.instIsCall[i] = 0;
        }

        u32 idx = 0;
        for (u32 b = 0; b < self.numBlocks; b++)
        {
            IrBlock* bb = self.blocks[b];
            self.blockStartInst[b] = idx;
            for (u32 i = 0; i < bb->ninsts; i++)
            {
                IrInst* inst = bb->insts[i];
                self.linearInsts[idx] = inst;
                self.instBlock[idx] = b;
                self.instIsCall[idx] = inst->opcode == IrOpcode::Call ||
                                        inst->opcode == IrOpcode::InlineAsm;

                IrOpcode op = inst->opcode;
                if (op == IrOpcode::Store || op == IrOpcode::Br ||
                    op == IrOpcode::CondBr || op == IrOpcode::Ret ||
                    op == IrOpcode::Unreachable || op == IrOpcode::Noret)
                {
                }
                else
                {
                    u32 vreg = self.numVregs++;
                    self.ensureVregs(vreg);
                    self.vregValues[vreg] = &inst->base;
                    inst->base.valData = (u64)vreg;
                    self.instVreg[idx] = vreg;
                }
                idx++;
            }
        }

        // Harvest parameters — entry-block stores whose value operand is an
        // Inst-kind value with no defining instruction anywhere in the
        // function. Each becomes a fresh vreg (interval starts at 0).
        {
            u32 maxId = 0;
            for (u32 b = 0; b < self.numBlocks; b++)
                for (u32 i = 0; i < self.blocks[b]->ninsts; i++)
                {
                    u32 rid = self.blocks[b]->insts[i]->base.id;
                    if (rid > maxId) maxId = rid;
                    for (u32 j = 0; j < self.blocks[b]->insts[i]->nops; j++)
                    {
                        IrValue* op = self.blocks[b]->insts[i]->ops[j];
                        if (op != null && op->kind == IrValueKind::Inst && op->id > maxId) maxId = op->id;
                    }
                }
            bool* defined = alloc<bool>((usize)(maxId + 1u));
            for (u32 i = 0; i <= maxId; i++) defined[i] = 0;
            for (u32 b = 0; b < self.numBlocks; b++)
                for (u32 i = 0; i < self.blocks[b]->ninsts; i++)
                    defined[self.blocks[b]->insts[i]->base.id] = 1;

            IrBlock* eb = self.blocks[0];
            for (u32 i = 0; i < eb->ninsts; i++)
            {
                IrInst* inst = eb->insts[i];
                if (inst->opcode != IrOpcode::Store || inst->nops < 1) continue;
                IrValue* src = inst->ops[0];
                if (src == null || src->kind != IrValueKind::Inst) continue;
                if (src->id <= maxId && defined[src->id]) continue;
                bool already = false;
                for (u32 k = 0; k < self.numParams; k++)
                    if (self.paramVals[k] == src) { already = true; break; }
                if (already) continue;
                u32 pv = self.numVregs++;
                self.ensureVregs(pv);
                self.vregValues[pv] = src;
                src->valData = (u64)pv;
                self.ensureParams(self.numParams);
                self.paramVals[self.numParams++] = src;
            }
            // Direct IrValueKind::Arg parameters (parser/IR-builder IR)
            // are values in their own right, not entry-store sources.
            for (u32 ai = 0; ai < func->nargs; ai++)
            {
                IrValue* src = func->args[ai];
                if (src == null) continue;
                bool already = false;
                for (u32 k = 0; k < self.numParams; k++)
                    if (self.paramVals[k] == src) { already = true; break; }
                if (already) continue;
                u32 pv = self.numVregs++;
                self.ensureVregs(pv);
                self.vregValues[pv] = src;
                src->valData = (u64)pv;
                self.ensureParams(self.numParams);
                self.paramVals[self.numParams++] = src;
            }
            dealloc<bool>(defined);
        }
    }

    void computeIntervals(IrFunc* func)
    {
        // Incoming parameters get an interval of their own — start 0,
        // end 0 — but no pre-pinned register. The scan hands each one a
        // home from the free set like any other value, and the
        // backend's emitParamSeeding moves the ABI's incoming argument
        // registers into those homes, staging them through the stack
        // first so that a home which happens to be a later argument's
        // incoming register is safe to overwrite. Keeping the ABI walk
        // out of this file is what lets SysV and Win64 — different
        // argument banks, different register orders — share one
        // allocator: the backend knows the platform (isWindows) and
        // walks its own bank.
        //
        // A pre-pinned home was attempted here before, with per-ABI
        // index tables and an isWin switch, and it could never have
        // taken effect: linearScan assigns physReg for every interval
        // it scans, overwriting the pin, and the tables numbered
        // physical registers rather than the caller-save-minus-
        // reserved order buildRegAlloc builds intRegNames in (so the
        // Win64 table's indices 8/9 did not even exist — Win64's
        // allocatable set is five registers wide). The pin and the
        // tables are gone rather than corrected: emitParamSeeding no
        // longer needs them for correctness, and the fp pins could
        // never work at all — xmm0/xmm1 are reserved scratch, so a
        // float parameter's incoming register is not in floatRegNames
        // to be pinned to.
        //
        // A new architecture therefore needs nothing in this file:
        // give it ABIRules in asm_rules.crl and teach the target
        // backend's prologue/epilogue its argument walk.
        if (func->base.type != null && func->base.type->nparams > 0)
        {
            for (u32 k = 0; k < self.numParams; k++)
            {
                IrValue* pv2 = self.paramVals[k];
                if (pv2 == null) continue;
                u32 vreg = (u32)pv2->valData;
                self.ensureIntervals();
                LiveInterval* li = &self.intervals[self.numIntervals++];
                li->vreg = vreg;
                li->start = 0;
                li->end = 0;
                li->spillSlot = NO_SLOT;
                li->physReg = NO_REG;
                // Every field has to be seeded here. alloc<LiveInterval> does
                // not zero its memory, and these intervals reach sortIntervals
                // via spillWeight — an uninitialised double there can be NaN,
                // which propagates into the ordering and into any spill choice
                // made from it.
                li->uses = 0;
                li->defs = 0;
                li->spillWeight = 0.0;
                li->spansCall = false;
                li->isFloat = pv2->type != null && (pv2->type->kind == IrTypeKind::Float || pv2->type->kind == IrTypeKind::Vector);
            }
        }

        for (u32 i = 0; i < self.totalInsts; i++)
        {
            u32 vreg = self.instVreg[i];
            if (vreg != NO_REG)
            {
                self.ensureIntervals();
                LiveInterval* li = &self.intervals[self.numIntervals++];
                li->vreg = vreg;
                li->start = i;
                li->end = i;
                li->physReg = NO_REG;
                li->spillSlot = NO_SLOT;
                li->isFloat = false;
                li->spansCall = false;
                li->uses = 0;
                li->defs = 1;
                li->spillWeight = 0.0;
                IrValue* vv = self.vregValues[vreg];
                if (vv != null && vv->type != null && (vv->type->kind == IrTypeKind::Float || vv->type->kind == IrTypeKind::Vector))
                    li->isFloat = true;
            }
        }

        for (u32 b = 0; b < self.numBlocks; b++)
        {
            IrBlock* bb = self.blocks[b];
            u32 base = self.blockStartInst[b];
            for (u32 i = 0; i < bb->ninsts; i++)
            {
                IrInst* inst = bb->insts[i];
                u32 linearIdx = base + i;

                // Handle phi, uses occur at the end of predecessor blocks
                if (inst->opcode == IrOpcode::Phi)
                {
                    // For phi, each value operand is "used" at the end of the corresponding predecessor
                    u32 numPairs = inst->nops / 2;
                    for (u32 j = 0; j < numPairs; j++)
                    {
                        IrValue* op = inst->ops[j * 2];
                        if (op == null || op->kind != IrValueKind::Inst) continue;
                        u32 vreg = (u32)op->valData;
                        IrValue* predVal = inst->ops[j * 2 + 1];
                        if (predVal == null || predVal->kind != IrValueKind::Block) continue;
                        IrBlock* predBlock = (IrBlock*)predVal;

                        i32 predEnd = -1;
                        for (u32 pb = 0; pb < self.numBlocks; pb++)
                        {
                            if (self.blocks[pb] == predBlock)
                            {
                                predEnd = (i32)(self.blockStartInst[pb] + self.blocks[pb]->ninsts - 1);
                                break;
                            }
                        }
                        if (predEnd < 0) continue;

                        for (u32 k = 0; k < self.numIntervals; k++)
                        {
                            if (self.intervals[k].vreg == vreg)
                            {
                                if ((u32)predEnd > self.intervals[k].end)
                                    self.intervals[k].end = (u32)predEnd;
                                self.intervals[k].uses++;
                                break;
                            }
                        }
                    }
                }
                else
                {
                    for (u32 j = 0; j < inst->nops; j++)
                    {
                        IrValue* op = inst->ops[j];
                        if (op == null || op->kind != IrValueKind::Inst) continue;
                        u32 vreg = (u32)op->valData;
                        for (u32 k = 0; k < self.numIntervals; k++)
                        {
                            if (self.intervals[k].vreg == vreg)
                            {
                                if (linearIdx > self.intervals[k].end)
                                    self.intervals[k].end = linearIdx;
                                self.intervals[k].uses++;
                                break;
                            }
                        }
                    }
                }
            }
        }

        // Loop-carried liveness fixpoint. The use walk above extends
        // intervals to their last use in *linear order*, which misses
        // values defined before a loop and used inside it: the next
        // iteration re-executes the same linear use position, so the
        // value must stay live across the backedge (a pointer alloca
        // whose register gets recycled at the loop tail would otherwise
        // be dereferenced through garbage on the next iteration).
        // Classic backward dataflow over the CFG — liveIn = use ∪
        // (liveOut − def) to a fixpoint — and every block a value is
        // live-in to extends its interval through that block's last
        // instruction. Per-block use/def sets are conservative (every
        // operand and result in the block, ignoring intra-block order),
        // which only ever over-extends liveness — sound for scan RA.
        {
            u32 nb = self.numBlocks;
            u32 nv = self.numVregs;
            if (nb > 0 && nv > 0)
            {
                usize setLen = (usize)nb * (usize)nv;
                bool* useSet = alloc<bool>(setLen);
                bool* defSet = alloc<bool>(setLen);
                bool* liveIn = alloc<bool>(setLen);
                bool* liveOut = alloc<bool>(setLen);
                for (usize i = 0; i < setLen; i++)
                {
                    useSet[i] = 0;
                    defSet[i] = 0;
                    liveIn[i] = 0;
                    liveOut[i] = 0;
                }
                bool* localDef = alloc<bool>((usize)nv);
                for (u32 b = 0; b < nb; b++)
                {
                    IrBlock* bb = self.blocks[b];
                    usize bo = (usize)b * (usize)nv;
                    for (u32 v = 0; v < nv; v++) localDef[v] = 0;
                    for (u32 i = 0; i < bb->ninsts; i++)
                    {
                        IrInst* inst = bb->insts[i];
                        // Phi value operands are read at the end of each
                        // predecessor, not here; counting them against this block
                        // is the conservative model that makes the predecessor
                        // live-out of itself (carrying the operand to the phi),
                        // matching the interval use-walk. Keep that behaviour.
                        bool isPhi = inst->opcode == IrOpcode::Phi;
                        for (u32 j = 0; j < inst->nops; j++)
                        {
                            IrValue* op = inst->ops[j];
                            if (op == null || op->kind != IrValueKind::Inst) continue;
                            u32 v = (u32)op->valData;
                            if (v >= nv) continue;
                            // A read makes the value live-in to this block ONLY if
                            // it precedes the value's def here. A read after a
                            // local def consumes that def, not an incoming value.
                            // Marking every read (the old behaviour) over-stated
                            // liveIn for loop-local values (a GEP feeding one load),
                            // which then propagated around the backedge into a false
                            // liveOut and over-extended their interval to blockEnd —
                            // inflating interference and evicting/spilling them.
                            if (isPhi || !localDef[v]) useSet[bo + (usize)v] = 1;
                        }
                        u32 dv = self.instVreg[self.blockStartInst[b] + i];
                        if (dv != NO_REG && dv < nv)
                        {
                            defSet[bo + (usize)dv] = 1;
                            localDef[dv] = 1;
                        }
                    }
                }
                dealloc<bool>(localDef);
                loop {
                   bool changed = false;
                    for (u32 b = nb; b-- > 0; )
                    {
                        IrBlock* bb = self.blocks[b];
                        usize bo = (usize)b * (usize)nv;
                        for (u32 s = 0; s < bb->nsuccs; s++)
                        {
                            u32 si = 0;
                            bool found = false;
                            for (u32 k = 0; k < nb; k++)
                            {
                                if (self.blocks[k] == bb->succs[s]) { si = k; found = true; break; }
                            }
                            if (!found) continue;
                            usize so = (usize)si * (usize)nv;
                            for (u32 v = 0; v < nv; v++)
                            {
                                if (liveIn[so + (usize)v] && !liveOut[bo + (usize)v])
                                {
                                    liveOut[bo + (usize)v] = 1;
                                    changed = true;
                                }
                            }
                        }
                        for (u32 v = 0; v < nv; v++)
                        {
                            bool li = useSet[bo + (usize)v] ||
                                      (liveOut[bo + (usize)v] && !defSet[bo + (usize)v]);
                            if (li && !liveIn[bo + (usize)v])
                            {
                                liveIn[bo + (usize)v] = 1;
                                changed = true;
                            }
                        }
                    }
                    if (!changed) break;
                }
                for (u32 b = 0; b < nb; b++)
                {
                    u32 blockEnd = self.blockStartInst[b] + self.blocks[b]->ninsts;
                    if (blockEnd > 0) blockEnd -= 1;
                    usize bo = (usize)b * (usize)nv;
                    for (u32 v = 0; v < nv; v++)
                    {
                        // Extend only values that are live-Out of the block —
                        // these cross the backedge (or a forward edge) and must
                        // survive to blockEnd. A value merely *used* in the block
                        // (liveIn, over-approximated because the per-block use set
                        // ignores intra-block def order) dies at its last use and
                        // must NOT be extended: doing so over-extends loop-local
                        // values (e.g. a GEP feeding one load) to the whole block,
                        // inflating their interval and causing needless
                        // eviction/spill of critical short-lived values.
                        if (!liveOut[bo + (usize)v]) continue;
                        for (u32 k = 0; k < self.numIntervals; k++)
                        {
                            if (self.intervals[k].vreg == v)
                            {
                                if (blockEnd > self.intervals[k].end)
                                    self.intervals[k].end = blockEnd;
                                break;
                            }
                        }
                    }
                }
                dealloc<bool>(useSet);
                dealloc<bool>(defSet);
                dealloc<bool>(liveIn);
                // Keep liveOut for two-address coalescing's live-out guard.
                self.liveOutSets = liveOut;
                self.numLiveOutBlocks = nb;
            }
        }

        for (u32 i = 0; i < self.numVregs; i++)
        {
            self.regForVreg[i] = NO_REG;
            self.slotForVreg[i] = NO_SLOT;
        }

        // A value that is live across a call must live in a callee-save
        // register (or memory), caller-save regs are clobbered by the call.
        for (u32 i = 0; i < self.numIntervals; i++)
        {
            LiveInterval* li = &self.intervals[i];
            li->spansCall = false;
            for (u32 p = li->start + 1; p <= li->end && p < self.totalInsts; p++)
            {
                if (self.instIsCall[p])
                {
                    li->spansCall = true;
                    break;
                }
            }
        }

        // Greedy weight — frequency of definition/use per position of range,
        // multiplied by loop nesting depth for hot path awareness.
        // Range of one still gets full def credit so tiny hot values win.
        for (u32 i = 0; i < self.numIntervals; i++)
        {
            LiveInterval* li = &self.intervals[i];
            u64 len = (u64)(li->end - li->start) + 1;
            f64 baseWeight = ((f64)li->uses + 2.0 * (f64)li->defs) / (f64)len;

            // Loop depth bonus — scan for nested back-edges in the range
            u32 loopDepth = 1;
            for (u32 p = li->start; p <= li->end && p < self.totalInsts; p++)
            {
                IrInst* inst = self.linearInsts[p];
                if (inst == null) continue;
                // Check if instruction is in a loop header block
                if (inst->parent != null)
                {
                    for (u32 b = 0; b < self.numBlocks; b++)
                    {
                        if (self.blocks[b] == inst->parent)
                        {   // Count back-edges — if this block has more preds than 1
                            // and at least one pred is after it in layout, it's a loop header
                            if (self.blocks[b]->npreds > 1)
                            {
                                for (u32 pi = 0; pi < self.blocks[b]->npreds; pi++)
                                {
                                    IrBlock* pred = self.blocks[b]->preds[pi];
                                    for (u32 pb = 0; pb < self.numBlocks; pb++)
                                    {
                                        if (self.blocks[pb] == pred && pb > b)
                                        {
                                            if (loopDepth < 4) loopDepth++;
                                            break;
                                        }
                                    }
                                }
                            }
                            break;
                        }
                    }
                }
            }

            li->spillWeight = baseWeight * (f64)loopDepth;
        }

        self.regIsFree = alloc<u32>((usize)self.numRegs);
        self.active = alloc<u32>((usize)(self.numRegs + 1u));
        self.floatRegIsFree = alloc<u32>((usize)self.numFloatRegs);
        self.floatActive = alloc<u32>((usize)(self.numFloatRegs + 1u));
    }

    // Greedy order — hottest first; ties fall back to program order so
    // allocation stays deterministic.
    static f64 absF64(f64 x)
    {
        if (x < 0) return -x;
        return x;
    }

    // Scan order must be start-ascending: the active-list expiry test
    // (a->end < cur->start) is only sound when intervals are processed
    // in program order — a later-starting interval already in the active
    // list would never expire against an earlier newcomer, and the
    // newcomer could be handed a register an expired-but-still-live
    // value holds. Spill weight stays what drives eviction choice
    // (scanClass), never scan order.
    static void sortIntervals(LiveInterval* intervals, u32 count)
    {
        for (u32 i = 1; i < count; i++)
        {
            LiveInterval key = intervals[i];
            i32 j = (i32)i - 1;
            while (j >= 0 &&
                   (intervals[j].start > key.start ||
                    (intervals[j].start == key.start &&
                     intervals[j].vreg > key.vreg)))
            {
                intervals[j + 1] = intervals[j];
                j--;
            }
            intervals[j + 1] = key;
        }
    }

    static bool isTwoAddressOp(IrOpcode op)
    {
        // Ops the backend emits as `dst = dst OP src` (x86 two-address form),
        // i.e. the ones routed through emitBinOp / emitFloatBinOp that must
        // materialise operand 0 into the destination before the ALU op. When
        // operand 0 dies at the op the result can reuse its register and the
        // backend skips the copy. Div/rem are excluded — they use the fixed
        // rax/rdx (or xmm0) scratch convention, not a free dst register.
        return op == IrOpcode::Add || op == IrOpcode::Sub || op == IrOpcode::Mul
            || op == IrOpcode::And || op == IrOpcode::Or || op == IrOpcode::Xor
            || op == IrOpcode::Shl || op == IrOpcode::Ashr || op == IrOpcode::Lshr
            || op == IrOpcode::FAdd || op == IrOpcode::FSub
            || op == IrOpcode::FMul || op == IrOpcode::FDiv;
    }

    u32 blockOfLinear(u32 pos)
    {
        for (u32 b = 0; b < self.numBlocks; b++)
        {
            u32 start = self.blockStartInst[b];
            u32 end = start + self.blocks[b]->ninsts;
            if (pos >= start && pos < end) return b;
        }
        return ~0u;
    }

    bool valueLiveOutAt(u32 blockIdx, u32 vreg)
    {
        // No live-out info (empty function) — be conservative and report
        // live-out so coalescing stays off.
        if (self.liveOutSets == null || blockIdx == ~0u) return true;
        if (blockIdx >= self.numLiveOutBlocks) return true;
        usize idx = (usize)blockIdx * (usize)self.numVregs + (usize)vreg;
        return self.liveOutSets[idx];
    }

    void scanClass(LiveInterval* cur,
                   u32* freeSet,
                   u32* activeList,
                   u32* numActivePtr,
                   u32 regCount,
                   u32 calleeStart)
    {
        u32 numActive = *numActivePtr;

        // Two-address coalescing. If cur is the result of a two-address op
        // (add/sub/... emitted as `dst = dst OP src`) and operand 0 dies at
        // this instruction — its interval ends exactly here and it is not
        // live-out of the block — then cur can reuse operand 0's register and
        // the backend skips the `movq src1, dst` copy. The live-out guard is
        // required: a loop-carried operand crossing a backedge can have
        // end == last-use yet still be read on the next iteration (the
        // interval fixpoint only extends end to a live-in block's last
        // instruction, which for a loop tail equals the use position).
        u32 coalesceVreg = NO_REG;
        u32 coalescePhysReg = NO_REG;
        {
            u32 defPos = cur->start;
            if (defPos < self.totalInsts && self.instVreg[defPos] == cur->vreg)
            {
                IrInst* defInst = self.linearInsts[defPos];
                if (defInst != null && self.isTwoAddressOp(defInst->opcode) && defInst->nops > 0)
                {
                    IrValue* op0 = defInst->ops[0];
                    if (op0 != null && op0->kind == IrValueKind::Inst)
                    {
                        u32 op0Vreg = (u32)op0->valData;
                        if (op0Vreg != cur->vreg)
                        {
                            for (u32 k = 0; k < self.numIntervals; k++)
                            {
                                if (self.intervals[k].vreg == op0Vreg)
                                {
                                    LiveInterval* op0I = &self.intervals[k];
                                    if (op0I->isFloat == cur->isFloat &&
                                        op0I->end == defPos && op0I->physReg != NO_REG &&
                                        !self.valueLiveOutAt(self.blockOfLinear(defPos), op0Vreg))
                                    {
                                        coalesceVreg = op0Vreg;
                                        coalescePhysReg = op0I->physReg;
                                    }
                                    break;
                                }
                            }
                        }
                    }
                }
            }
        }

        u32 newActive = 0;
        for (u32 j = 0; j < numActive; j++)
        {
            u32 avreg = activeList[j];
            LiveInterval* a = null;
            for (u32 k = 0; k < self.numIntervals; k++)
            {
                if (self.intervals[k].vreg == avreg)
                {
                    a = &self.intervals[k];
                    break;
                }
            }
            if (a != null && a->end < cur->start)
            {
                freeSet[a->physReg] = 1;
                self.regForVreg[a->vreg] = a->physReg;
            }
            else
            {
                activeList[newActive++] = avreg;
            }
        }
        numActive = newActive;

            if (gLsraVerbose)
            {
                eprintln("    scan vreg={} start={} spansCall={} active:", cur->vreg, cur->start, cur->spansCall);
                for (u32 j = 0; j < numActive; j++)
                {
                    u32 av = activeList[j];
                    for (u32 k = 0; k < self.numIntervals; k++)
                        if (self.intervals[k].vreg == av)
                        { eprintln("      active vreg={} [{}..{}] reg={}", av, self.intervals[k].start, self.intervals[k].end, self.intervals[k].physReg); break; }
                }
                for (u32 r = 0; r < regCount; r++)
                    if (freeSet[r]) eprintln("      free reg={}", r);
            }

        // If two-address coalescing applies, expire operand 0 now (it dies at
        // cur->start) and remember its register as the preferred assignment.
        if (coalesceVreg != NO_REG)
        {
            for (u32 j = 0; j < numActive; j++)
            {
                if (activeList[j] == coalesceVreg)
                {
                    freeSet[coalescePhysReg] = 1;
                    for (u32 s = j; s + 1 < numActive; s++) activeList[s] = activeList[s + 1];
                    numActive--;
                    break;
                }
            }
        }

        // An interval live across a call can only use callee-save regs.
        u32 searchStart = cur->spansCall ? calleeStart : 0;

        u32 freeReg = NO_REG;
        if (coalescePhysReg != NO_REG && freeSet[coalescePhysReg] &&
            (!cur->spansCall || coalescePhysReg >= calleeStart))
        {
            // Take the dying operand's register so the backend skips the copy.
            freeReg = coalescePhysReg;
        }
        else
        {
            for (u32 r = searchStart; r < regCount; r++)
            {
                if (freeSet[r])
                {
                    freeReg = r;
                    break;
                }
            }
        }

        if (freeReg != NO_REG)
        {
            if (gLsraVerbose) eprintln("      -> assign vreg={} reg={}", cur->vreg, freeReg);
            cur->physReg = freeReg;
            freeSet[freeReg] = 0;
            activeList[numActive++] = cur->vreg;
            self.regForVreg[cur->vreg] = freeReg;
        }
        else
        {
            // Eviction candidate, for call-spanning intervals, only evict
            // another callee-save occupant; for everything else any active
            // interval qualifies.
            u32 furthestEnd = 0;
            #[[maybe_unused]] u32 furthestIdx = 0;
            #[[maybe_unused]] LiveInterval* furthest = null;
            for (u32 j = 0; j < numActive; j++)
            {
                u32 avreg = activeList[j];
                for (u32 k = 0; k < self.numIntervals; k++)
                {
                    if (self.intervals[k].vreg == avreg)
                    {
                        LiveInterval* a = &self.intervals[k];
                        if (cur->spansCall && a->physReg < calleeStart) break;
                        if (a->end > furthestEnd)
                        {
                            furthestEnd = a->end;
                            furthestIdx = j;
                            furthest = a;
                        }
                        break;
                    }
                }
            }

            // Greedy eviction — find the lowest-weight occupant of a usable
            // register; steal it when the newcomer is hotter, else spill.
            u32 victimIdx = ~0u;
            f64 victimW = 0.0;
            u32 victimReg = NO_REG;
            LiveInterval* victim = null;
            const f64 EPSILON = 0.0001;
            for (u32 j = 0; j < numActive; j++)
            {
                u32 avreg = activeList[j];
                for (u32 k = 0; k < self.numIntervals; k++)
                {
                    if (self.intervals[k].vreg == avreg)
                    {
                        LiveInterval* a = &self.intervals[k];
                        if (a->physReg == NO_REG) break;
                        if (cur->spansCall && a->physReg < calleeStart) break;
                        if (victim == null || a->spillWeight < victimW - EPSILON)
                        {
                            victimW = a->spillWeight;
                            victimIdx = j;
                            victimReg = a->physReg;
                            victim = a;
                        }
                        break;
                    }
                }
            }

            if (victim != null && victimW < cur->spillWeight - EPSILON)
            {
                victim->spillSlot = self.nextSpillSlot++;
                self.slotForVreg[victim->vreg] = victim->spillSlot;
                if (self.nextSpillSlot > 0x7FFFFFFF)
                    self.nextSpillSlot = 0x7FFFFFFF;
                self.regForVreg[victim->vreg] = NO_REG;
                victim->physReg = NO_REG;

                // compact — drop victim, append cur
                for (u32 j = victimIdx; j + 1 < numActive; j++)
                    activeList[j] = activeList[j + 1];
                numActive--;
                cur->physReg = victimReg;
                freeSet[victimReg] = 0;
                activeList[numActive++] = cur->vreg;
                self.regForVreg[cur->vreg] = victimReg;
            }
            else
            {
                cur->spillSlot = self.nextSpillSlot++;
                self.slotForVreg[cur->vreg] = cur->spillSlot;
                if (self.nextSpillSlot > 0x7FFFFFFF)
                    self.nextSpillSlot = 0x7FFFFFFF;
                if (gLsraVerbose) eprintln("      -> SPILL vreg={} (no free reg, freeReg={}) slot={}", cur->vreg, freeReg, cur->spillSlot);
            }
        }
        *numActivePtr = numActive;
    }

    void tryCoalesce()
    {
        // Coalesce phi operands with phi results — ensures a loop counter
        // keeps the same register across iterations.
        for (u32 idx = 0; idx < self.totalInsts; idx++) {
            IrInst* inst = self.linearInsts[idx];
            if (inst == null || inst->opcode != IrOpcode::Phi) continue;
            u32 dstVreg = (u32)inst->base.valData;
            for (u32 j = 0; j + 1 < inst->nops; j += 2) {
                IrValue* srcOp = inst->ops[j];
                if (srcOp == null || srcOp->kind != IrValueKind::Inst) continue;
                u32 srcVreg = (u32)srcOp->valData;
                LiveInterval* srcI = null; LiveInterval* dstI = null;
                for (u32 k2=0; k2<self.numIntervals; k2++) {
                    if (self.intervals[k2].vreg == srcVreg) { srcI=&self.intervals[k2]; break;}
                    if (self.intervals[k2].vreg == dstVreg) { dstI=&self.intervals[k2]; break;}
                }
                if (srcI == null || dstI == null) continue;
                if (srcI->isFloat != dstI->isFloat) continue;
                // Force union — make dst share src's register assignment
                // by extending dst's interval to cover src's range
                if (srcI->start < dstI->start) dstI->start = srcI->start;
                if (srcI->end > dstI->end) dstI->end = srcI->end;
            }
        }

        // Simple coalescing for mov copies — if dest and src are vregs with non-overlapping
        // intervals, they can share the same register. This eliminates the extra moves
        // noted in wallvm_backend_notes.md "Register-relay copies".
        for (u32 idx = 0; idx < self.totalInsts; idx++) {
            IrInst* inst = self.linearInsts[idx];
            if (inst == null || inst->opcode != IrOpcode::Bitcast) continue;
            if (inst->nops < 1) continue;
            IrValue* src = inst->ops[0];
            if (src == null || src->kind != IrValueKind::Inst) continue;
            u32 srcVreg = (u32)src->valData;
            u32 dstVreg = (u32)inst->base.valData;
            // Find intervals
            LiveInterval* srcI = null; LiveInterval* dstI = null;
            for (u32 k=0; k<self.numIntervals; k++) {
                if (self.intervals[k].vreg == srcVreg) srcI=&self.intervals[k];
                if (self.intervals[k].vreg == dstVreg) dstI=&self.intervals[k];
            }
            if (srcI == null || dstI == null) continue;
            if (srcI->isFloat != dstI->isFloat) continue;
            // If intervals overlap, cannot coalesce
            bool overlap = !(srcI->end < dstI->start || dstI->end < srcI->start);
            if (overlap) continue;
            // Try to coalesce — make dst share src's interval range (union)
            // For now, just extend src's interval to cover dst's range and mark dst as coalesced
            // The actual register assignment will happen in linearScan; we just merge intervals
            // by extending src to cover dst and marking dst as needing same reg
            // Simplest — if src interval ends before dst starts, extend src to dst's end
            if (srcI->end < dstI->start) {
                // src is dead before dst starts — can reuse src's register for dst
                dstI->physReg = srcI->physReg;
            }
        }
    }

    void linearScan()
    {
        self.tryCoalesce();
        for (u32 i = 0; i < self.numRegs; i++)
            self.regIsFree[i] = 1;
        for (u32 i = 0; i < self.numFloatRegs; i++)
            self.floatRegIsFree[i] = 1;
        self.numActive = 0;
        self.numFloatActive = 0;

        self.sortIntervals(self.intervals, self.numIntervals);

        if (gLsraVerbose)
        {
            eprintln("; scan order ({} intervals):", self.numIntervals);
            for (u32 i = 0; i < self.numIntervals; i++)
                eprintln("  [{}] vreg={} start={} end={} isFloat={} physReg={}",
                    i, self.intervals[i].vreg, self.intervals[i].start,
                    self.intervals[i].end, self.intervals[i].isFloat, self.intervals[i].physReg);
        }

        for (u32 i = 0; i < self.numIntervals; i++)
        {
            LiveInterval* cur = &self.intervals[i];
            if (cur->isFloat)
                self.scanClass(cur, self.floatRegIsFree, self.floatActive, &self.numFloatActive, self.numFloatRegs, 0);
            else
                self.scanClass(cur, self.regIsFree, self.active, &self.numActive, self.numRegs, self.numCallerSave);
        }

        for (u32 j = 0; j < self.numActive; j++)
        {
            u32 avreg = self.active[j];
            for (u32 k = 0; k < self.numIntervals; k++)
            {
                if (self.intervals[k].vreg == avreg)
                {
                    self.regForVreg[avreg] = self.intervals[k].physReg;
                    break;
                }
            }
        }
        for (u32 j = 0; j < self.numFloatActive; j++)
        {
            u32 avreg = self.floatActive[j];
            for (u32 k = 0; k < self.numIntervals; k++)
            {
                if (self.intervals[k].vreg == avreg)
                {
                    self.regForVreg[avreg] = self.intervals[k].physReg;
                    break;
                }
            }
        }
    }

    static void insertInstAt(IrBlock* bb, u32 idx, IrInst* newInst)
    {
        if (idx > bb->ninsts) return;
        if (bb->ninsts + 1 > bb->capInsts)
        {
            u32 newCap = bb->capInsts ? bb->capInsts * 2 : 8;
            IrInst** newInsts = alloc<IrInst*>((usize)newCap);
            if (bb->insts != null)
            {
                copy<IrInst*>(newInsts, bb->insts, (usize)bb->ninsts);
                dealloc<IrInst*>(bb->insts);
            }
            bb->insts = newInsts;
            bb->capInsts = newCap;
        }
        for (u32 i = bb->ninsts; i > idx; i--)
            bb->insts[i] = bb->insts[i - 1];
        bb->insts[idx] = newInst;
        newInst->parent = bb;
        bb->ninsts++;
    }

    IrValue* getOrCreateSlotAlloca(i32 slot, IrBlock* insertBlock, u32 insertIdx)
    {
        self.ensureSlotAllocas(slot);
        if (self.slotAllocas[slot] != null)
            return self.slotAllocas[slot];

        IrType* ptrTy = self.ctx->tyPtr(self.wordType);
        IrInst* alloca = self.ctx->createInst(IrOpcode::Alloca, ptrTy, null, 0, 0, 0);
        self.insertInstAt(insertBlock, insertIdx, alloca);
        self.slotAllocas[slot] = &alloca->base;
        return &alloca->base;
    }

    void handleSpills(IrFunc* func)
    {
        // When the backend consumes valData directly, it decodes SPILL_BIT
        // itself, no IR-level load/store rewriting.
        if (self.backendHandlesSpills) return;
        if (self.nextSpillSlot == 0) return;

        IrBlock* entryBlock = self.blocks[0];
        for (i32 s = 0; s < self.nextSpillSlot; s++)
        {
            IrType* ptrTy = self.ctx->tyPtr(self.wordType);
            IrInst* alloca =
                self.ctx->createInst(IrOpcode::Alloca, ptrTy, null, 0, 0, 0);
            self.insertInstAt(entryBlock, 0, alloca);
            self.ensureSlotAllocas(s);
            self.slotAllocas[s] = &alloca->base;
        }

        for (u32 v = 0; v < self.numVregs; v++)
        {
            i32 slot = self.slotForVreg[v];
            if (slot == NO_SLOT) continue;

            IrValue* val = self.vregValues[v];
            if (val == null) continue;

            u32 defLinearIdx = self.totalInsts;
            for (u32 i = 0; i < self.totalInsts; i++)
            {
                if (self.instVreg[i] == v) { defLinearIdx = i; break; }
            }
            IrInst* defStore = null;
            if (defLinearIdx < self.totalInsts)
            {
                IrInst* defInst = self.linearInsts[defLinearIdx];
                IrBlock* defBlock = self.blocks[self.instBlock[defLinearIdx]];

                IrValue* slotPtr = self.getOrCreateSlotAlloca(slot, defBlock, 0);
                if (slotPtr == null) slotPtr = self.slotAllocas[(u32)slot];
                if (slotPtr == null) continue;

                IrValue*[2] storeOps;
                storeOps[0] = val;
                storeOps[1] = slotPtr;
                IrInst* storeInst =
                    self.ctx->createInst(IrOpcode::Store, self.ctx->tyVoid(), storeOps, 2, 0, 0);

                u32 defBlockIdx = self.instBlock[defLinearIdx];
                IrBlock* db = self.blocks[defBlockIdx];
                u32 storePos = db->ninsts;
                for (u32 i = 0; i < db->ninsts; i++)
                {
                    if (db->insts[i] == defInst) { storePos = i + 1; break; }
                }
                self.insertInstAt(db, storePos, storeInst);
                storeOps[0]->addUser(storeInst);
                storeOps[1]->addUser(storeInst);
                defStore = storeInst;
            }

            for (u32 b = 0; b < self.numBlocks; b++)
            {
                IrBlock* bb = self.blocks[b];
                for (u32 i = 0; i < bb->ninsts; i++)
                {
                    IrInst* inst = bb->insts[i];
                    // Skip the spill store we just inserted, it is a def, not a
                    // use, and rewriting its operand would clobber the stored value
                    if (inst == defStore) continue;
                    if (inst->opcode == IrOpcode::Phi)
                    {
                        // For phi uses, insert load at end of predecessor block
                        u32 numPairs = inst->nops / 2;
                        for (u32 j = 0; j < numPairs; j++)
                        {
                            IrValue* op = inst->ops[j * 2];
                            if (op == val)
                            {
                                IrValue* predVal = inst->ops[j * 2 + 1];
                                if (predVal == null || predVal->kind != IrValueKind::Block) continue;
                                IrBlock* predBlock = (IrBlock*)predVal;

                                IrValue* slotPtr = self.slotAllocas[(u32)slot];
                                if (slotPtr == null) continue;

                                IrValue*[1] loadOps;
                                loadOps[0] = slotPtr;
                                IrInst* loadInst =
                                    self.ctx->createInst(IrOpcode::Load, val->type, loadOps, 1, 0, 0);
                                loadOps[0]->addUser(loadInst);

                                // Insert before terminator of predecessor block
                                IrInst* term = predBlock->terminator();
                                u32 loadPos = predBlock->ninsts;
                                if (term != null)
                                {
                                    for (u32 k = 0; k < predBlock->ninsts; k++)
                                    {
                                        if (predBlock->insts[k] == term) { loadPos = k; break; }
                                    }
                                }
                                self.insertInstAt(predBlock, loadPos, loadInst);

                                inst->ops[j * 2] = &loadInst->base;
                                loadInst->base.addUser(inst);
                                val->removeUser(inst);
                            }
                        }
                    }
                    else
                    {
                        for (u32 j = 0; j < inst->nops; j++)
                        {
                            IrValue* op = inst->ops[j];
                            if (op == val)
                            {
                                IrValue* slotPtr = self.slotAllocas[(u32)slot];
                                if (slotPtr == null) continue;

                                IrValue*[1] loadOps;
                                loadOps[0] = slotPtr;
                                IrInst* loadInst =
                                    self.ctx->createInst(IrOpcode::Load, val->type, loadOps, 1, 0, 0);
                                loadOps[0]->addUser(loadInst);

                                self.insertInstAt(bb, i, loadInst);
                                i++; // skip over inserted load

                                inst->ops[j] = &loadInst->base;
                                loadInst->base.addUser(inst);
                                val->removeUser(inst);
                            }
                        }
                    }
                }
            }
        }
    }

    void rewrite(IrFunc* func)
    {
        // Store physreg assignments in valData for codegen consumption.
        // Bit 31, spilled (low 31 bits = spill slot index)
        // Bit 30, float register class (low 30 bits = float reg index)
        for (u32 v = 0; v < self.numVregs; v++)
        {
            IrValue* val = self.vregValues[v];
            if (val == null) continue;
            if (self.slotForVreg[v] != NO_SLOT)
            {
                val->valData = SPILL_BIT | (u64)(u32)self.slotForVreg[v];
            }
            else
            {
                u32 reg = self.regForVreg[v];
                if (reg == NO_REG) reg = 0;
                bool isF = val->type != null && (val->type->kind == IrTypeKind::Float || val->type->kind == IrTypeKind::Vector);
                if (isF)
                    val->valData = FLOAT_BIT | (u64)reg;
                else
                    val->valData = (u64)reg;
            }
        }
    }

    bool allocate(IrFunc* func)
    {
        if (func == null || func->nblocks == 0) return false;

        self.wordType = self.ctx->tyInt(64);

        if (gLsraVerbose)
            eprintln("; lsra {}: assignVregs", func->base.name);
        self.assignVregs(func);
        if (self.numVregs == 0) return true;

        if (gLsraVerbose)
            eprintln("; lsra {}: computeIntervals", func->base.name);
        self.computeIntervals(func);
        if (gLsraVerbose)
            eprintln("; lsra {}: linearScan", func->base.name);
        self.linearScan();
        if (gLsraVerbose)
        {
            eprintln("; ---- lsra @{} ----", func->base.name);
            for (u32 i = 0; i < self.totalInsts; i++)
            {
                IrInst* inst = self.linearInsts[i];
                if (inst == null) continue;
                u32 vr = self.instVreg[i];
                if (vr == NO_REG)
                    eprintln("  [{}] %{}", i, inst->base.id);
                else
                    eprintln("  [{}] %{} vreg={} reg={} slot={}",
                        i, inst->base.id, vr,
                        self.regForVreg[vr], self.slotForVreg[vr]);
            }
            for (u32 i = 0; i < self.numIntervals; i++)
            {
                LiveInterval* li = &self.intervals[i];
                eprintln("  iv vreg={} [{}..{}] uses={} w={} fl={} reg={} slot={}",
                    li->vreg, li->start, li->end, li->uses, li->spillWeight,
                    li->isFloat, li->physReg, li->spillSlot);
            }
        }
        if (gLsraVerbose)
            eprintln("; lsra {}: handleSpills", func->base.name);
        self.handleSpills(func);
        if (gLsraVerbose)
            eprintln("; lsra {}: rewrite", func->base.name);
        self.rewrite(func);

        if (self.instVreg != null) dealloc<u32>(self.instVreg);
        if (self.instBlock != null) dealloc<u32>(self.instBlock);
        if (self.linearInsts != null) dealloc<IrInst*>(self.linearInsts);
        if (self.instIsCall != null) dealloc<bool>(self.instIsCall);
        if (self.blockStartInst != null) dealloc<u32>(self.blockStartInst);
        if (self.regIsFree != null) dealloc<u32>(self.regIsFree);
        if (self.floatRegIsFree != null) dealloc<u32>(self.floatRegIsFree);
        if (self.active != null) dealloc<u32>(self.active);
        if (self.floatActive != null) dealloc<u32>(self.floatActive);
        if (self.slotAllocas != null) dealloc<IrValue*>(self.slotAllocas);
        if (self.paramVals != null) dealloc<IrValue*>(self.paramVals);
        if (self.liveOutSets != null) { dealloc<bool>(self.liveOutSets); self.liveOutSets = null; }

        return true;
    }

    void destroy()
    {
        if (self.vregValues != null) dealloc<IrValue*>(self.vregValues);
        if (self.regForVreg != null) dealloc<u32>(self.regForVreg);
        if (self.slotForVreg != null) dealloc<i32>(self.slotForVreg);
        if (self.intervals != null) dealloc<LiveInterval>(self.intervals);
        if (self.intRegNames != null) dealloc<str>(self.intRegNames);
        if (self.floatRegNames != null) dealloc<str>(self.floatRegNames);
    }
}

pub bool irLinearScanRegAlloc(IrFunc* func, rawptr userdata,
                              ABIRules* abi, RegAllocConfig* cfg)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    LinearScanRegAlloc alloc = LinearScanRegAlloc::new(ctx, abi, cfg);
    bool result = alloc.allocate(func);
    alloc.destroy();
    return result;
}
