pub const u32 WALLVM_VERSION_MAJOR = 0;
pub const u32 WALLVM_VERSION_MINOR = 1;
pub const u32 WALLVM_VERSION_PATCH = 0;

// Loop unrolling is opt-in: --funroll. 
pub bool gUnrollEnabled = false;

// Debug knobs for tracking data flow through the pipeline:
// gPipelineVerbose dumps the module once per function around optimization;
// gPrintAfterPass dumps after every pass that reports a mutation, which
// makes any pass's rewrite diffable against the previous dump.
pub bool gPipelineVerbose = false;
pub bool gPrintAfterPass = false;

void irDumpModule(IrModule* modd, str label)
{
    if (modd == null) return;
    IrPrinter pr = IrPrinter::new();
    pr.printModule(modd);
    eprintln("; ---- {} ----", label);
    eprintln("{}", pr.output());
    pr.destroy();
}

typedef PassFn = bool(IrFunc*, rawptr);

pub struct PassPipeline
{
    PassFn* passes;
    str* names;
    u32 count;
    u32 capacity;

    static PassPipeline new()
    {
        return PassPipeline {
            .passes = null,
            .names = null,
            .count = 0,
            .capacity = 0
        };
    }

    void add(PassFn fn, str name)
    {
        if (self.count >= self.capacity)
        {
            u32 nc = self.capacity ? self.capacity * 2 : 8;
            PassFn* np = alloc<PassFn>((usize)nc);
            str* nn = alloc<str>((usize)nc);
            for (u32 i = 0; i < self.count; i++)
            {
                np[i] = self.passes[i];
                nn[i] = self.names[i];
            }
            if (self.passes != null) dealloc<PassFn>(self.passes);
            if (self.names != null) dealloc<str>(self.names);
            self.passes = np;
            self.names = nn;
            self.capacity = nc;
        }
        self.passes[self.count] = fn;
        self.names[self.count] = name;
        self.count++;
    }

    void clear()
    {
        if (self.passes != null) dealloc<PassFn>(self.passes);
        if (self.names != null) dealloc<str>(self.names);
        self.passes = null;
        self.names = null;
        self.count = 0;
        self.capacity = 0;
    }

    bool runOnFunc(IrFunc* func, rawptr ctx)
    {
        bool changed = false;
        for (u32 i = 0; i < self.count; i++)
        {
            if (self.passes[i](func, ctx))
            {
                changed = true;
                // A pass reported a mutation, so every cached analysis keyed
                // off this func is now suspect: bump the generation and let
                // the publishing pass rebuild on its next run.
                ((IrContext*)ctx)->analysisGeneration++;
                if (gPrintAfterPass)
                    irDumpModule(func->parent, self.names[i]);
            }
        }
        return changed;
    }

    // Run the pipeline repeatedly until no pass makes changes.
    // This allows passes that expose new opportunities for each other
    // to converge (e.g., constfold exposes algebraic, which exposes
    // constfold again, etc.)
    bool runOnFuncIterate(IrFunc* func, rawptr ctx, u32 maxIters)
    {
        bool anyChanged = false;
        for (u32 iter = 0; iter < maxIters; iter++)
        {
            bool changed = false;
            for (u32 i = 0; i < self.count; i++)
            {
                if (gPipelineVerbose)
                    eprintln("> pass {} (iter {})", self.names[i], iter);
                if (self.passes[i](func, ctx))
                {
                    changed = true;
                    // See runOnFunc: keep the IR-mutation generation in sync
                    // so cached analyses (AA/MSSA) are rebuilt when stale.
                    ((IrContext*)ctx)->analysisGeneration++;
                    if (gPrintAfterPass)
                        irDumpModule(func->parent, self.names[i]);
                }
            }
            if (!changed) break;
            anyChanged = true;
        }
        return anyChanged;
    }
}

pub PassPipeline pipelineLevel0()
{
    PassPipeline p = PassPipeline::new();
    p.add((PassFn)irPassValidate, "validate");
    p.add((PassFn)irPassSimplify, "simplify");
    p.add((PassFn)irPassConstfold, "constfold");
    p.add((PassFn)irPassSccp, "sccp");
    p.add((PassFn)irPassDce, "dce");
    p.add((PassFn)irPassValidate, "validate");
    return p;
}

// The abi_lower slot at the head of L1-L3 is picked per calling
// convention — Win64/SyscallWin64 run the Microsoft x64 pass, every
// other convention runs System V. Both entries take their module from
// func->parent, so the pipeline keeps passing the context as userdata
// like it does for every other pass.
PassFn abiLowerPassFor(CallingConvention cc)
{
    switch (cc)
    {
        CallingConvention::Win64 |
        CallingConvention::SyscallWin64 => { return (PassFn)abi_lower::irABILower; },
        else => { return (PassFn)irABILower; },
    }
}

pub PassPipeline pipelineLevel1(CallingConvention cc)
{
    PassPipeline p = PassPipeline::new();
    p.add((PassFn)irPassValidate, "validate");
    p.add(abiLowerPassFor(cc), "abi_lower");
    p.add((PassFn)irPassCommCanonicalize, "comm_canon");
    p.add((PassFn)irPassSimplify, "simplify");
    p.add((PassFn)irPassConstfold, "constfold");
    p.add((PassFn)irPassInvolution, "involution");
    p.add((PassFn)irPassSccp, "sccp");
    p.add((PassFn)irPassRange, "range");
    p.add((PassFn)irPassRangeBranchElim, "range_br_elim");
    p.add((PassFn)irPassBranchProp, "branchprop");
    p.add((PassFn)irPassBranchInversionFlat, "branch_inv_flat");
    p.add((PassFn)irPassCse, "cse");
    p.add((PassFn)irPassCastElimination, "cast_elim");
    p.add((PassFn)irPassDse, "dse");
    p.add((PassFn)irPassJumpThread, "jump_thread");
    p.add((PassFn)irPassIdiom, "idiom");
    p.add((PassFn)irPassPeephole, "peephole");
    p.add((PassFn)irPassDce, "dce");
    p.add((PassFn)irPassValidate, "validate");
    return p;
}

pub PassPipeline pipelineLevel2(CallingConvention cc)
{
    PassPipeline p = PassPipeline::new();
