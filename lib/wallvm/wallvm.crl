// The MS x64 pass stays namespace-qualified: both abi_lower files export
// `irABILower` and the bare symbol above is the System V one.
import(lib) wallvm::target::x86_64::windows::abi_lower;

import(lib) wallvm::regalloc {
    lsra::{ defaultRegAllocConfig, irLinearScanRegAlloc, RegAllocConfig },
    graph::{ irGraphRegAlloc }
};

