#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrModule, IrType, IrFunc, IrBlock, IrInst, IrValue, IrTypeKind, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };
import(lib) std::mman { alloc, dealloc };
import(lib) wallvm::irMetadata { attachFuncMetadata, addString, find, MetadataSet };

// ABI Lowering Pass for 32-bit x86 (SysV i386 psABI).
// Rules implemented here, per the i386 psABI:
// 1. All function arguments are passed on the stack; a struct argument
//    is pushed by value, so struct parameters keep their aggregate
//    type — no register-splitting is needed or done
// 2. Aggregates larger than 8 bytes are returned through a hidden
//    sret pointer supplied by the caller
// 3. Aggregates of 8 bytes or less come back in eax:edx — modelled as
//    a single scalar word (i8/i16/i32 for width 1/2/3-4, i64 for
//    width 5-8, i.e. the eax:edx pair), materialised through a
//    scratch-alloca byte round trip so the padding bytes are defined
// 4. Floating point results come back on the x87 FPU stack (st0);
//    SSE does not carry scalar floats on this ABI — the classify
//    helpers keep the FPU class for informational purposes only
//
// The interned IR types are 64-bit flavored (pointers are 8 bytes,
// struct alignment reports 8), so this pass treats pointers and offsets
// as 4 bytes in its own layout math rather than trusting type widths.
//
// Contract for the entry point: `irABILower` treats `userdata` as the
// owning `IrModule*` (falling back to func->parent when null). The
// module is needed to find and rewrite every direct call of the target
// function; `X86ABILowering.run` alone only transforms the one function.
//
// Every function this pass processes gets a `abi.lower` metadata string
// entry, and already-marked functions are skipped — so running the pass
// twice is a no-op (idempotent).
//
// Only direct calls are rewritten (operand 0 of a Call is the Func
// value); indirect calls keep the old convention and are an IR gap.
//
// Extern functions are never transformed themselves (their body is
// signature-only), but their call sites still get ABI-correct
// marshalling. The extern keeps its declared IrFunc signature, so the
// extern's own (unlowered) struct return type stays — call-site
// argument lowering is a no-op on i386 because all args are stack-
// passed, and a struct-returning extern's result stays struct-typed at
// the call; this is a documented IR gap.

str dupStrVal(str s)
{
    u8* b = alloc<u8>((usize)(s.len + 1));
    for (usize i = 0; i < s.len; i++) b[i] = s.ptr[i];
    b[s.len] = 0;
    return str::fromParts((const u8*)b, s.len);
}

pub struct X86ABILowering
{
    IrContext* ctx;
    IrModule* modd;

    static X86ABILowering new(IrContext* ctx)
    {
        return X86ABILowering { .ctx = ctx, .modd = null };
    }

    // Classify a single field type
    // Returns 0 = MEMORY, 1 = INTEGER, 2 = FPU (SSE kept 2 for shape)
    u32 classifyField(IrType* ty)
    {
        if (ty == null) return 0;
        switch (ty->kind)
        {
            IrTypeKind::Int => { return 1; },  // INTEGER
            IrTypeKind::Ptr => { return 1; },  // INTEGER (pointer)

            IrTypeKind::Float => {
                if (ty->width == 32 || ty->width == 64)
                    return 2;  // x87 FPU class, not XMM
                return 0;  // MEMORY for anything else
            },

            IrTypeKind::Array => {
                if (ty->elem == null) return 0;
                u32 elemClass = self.classifyField(ty->elem);
                if (elemClass == 0) return 0;
                u32 totalSize = ty->count * self.ctx->irTypeSizeOf(ty->elem);
                if (totalSize > 8) return 0;
                return elemClass;
            },

            IrTypeKind::Struct => { return self.classifyStructType(ty); },
            else => { return 0; },
        }
    }

    // Natural alignment of a field type on i386: scalars at their size
    // (capped at 4 — doubles are 4-byte aligned in this psABI),
    // pointers at 4, aggregates at their largest member's
    u32 fieldAlign(IrType* ty)
    {
        if (ty == null) return 1;
        switch (ty->kind)
        {
            IrTypeKind::Int | IrTypeKind::Float => {
                u32 a = ty->width / 8;
                if (a == 0) a = 1;
                if (a > 4) a = 4;
                return a;
            },

            IrTypeKind::Ptr => { return 4; },
            IrTypeKind::Array | IrTypeKind::Vector => { return self.fieldAlign(ty->elem); },

            IrTypeKind::Struct => {
                u32 a = 1;
                for (u32 i = 0; i < ty->nparams; i++)
                {
                    u32 fa = self.fieldAlign(ty->params[i]);
                    if (fa > a) a = fa;
                }
                if (a > 4) a = 4;
                return a;
            },

            else => { return 1; },
        }
    }

    // Byte size of a field type, with pointers measured as 4 bytes —
    // the interned IR still says 8, this pass does its own math
    u32 fieldSize(IrType* ty)
    {
        if (ty == null) return 0;
        if (ty->kind == IrTypeKind::Int || ty->kind == IrTypeKind::Float)
            return ty->width / 8;
        if (ty->kind == IrTypeKind::Ptr) return 4;
        if (ty->kind == IrTypeKind::Struct) return ty->width;
        if (ty->kind == IrTypeKind::Array)
            return self.fieldSize(ty->elem) * (ty->count > 0 ? ty->count : 1);
        return 0;
    }

    // Get field byte offsets for a struct
    // For packed structs, no alignment padding
    // For normal structs, fields are aligned to their natural alignment
    u32 getFieldOffset(IrType* ty, u32 fieldIdx, bool isPacked)
    {
        if (ty == null) return 0;

        if (ty->kind == IrTypeKind::Struct)
        {
            u32 off = 0;
            for (u32 i = 0; i < fieldIdx && i < ty->nparams; i++)
            {
                if (!isPacked) {
                    u32 align = self.fieldAlign(ty->params[i]);
                    off = (off + align - 1) / align * align;
                }
                off += self.fieldSize(ty->params[i]);
            }
            // off is the end of field fieldIdx-1; placing field
            // fieldIdx needs one more alignment step by its own
            // alignment — without this {i32,i64} reported b at 4 not 8
            if (!isPacked && fieldIdx < ty->nparams)
            {
                u32 align = self.fieldAlign(ty->params[fieldIdx]);
                off = (off + align - 1) / align * align;
            }
            return off;
        }

        if (ty->kind == IrTypeKind::Array && ty->elem != null)
        {
            u32 elemSize = self.fieldSize(ty->elem);
            if (!isPacked) {
                u32 align = self.fieldAlign(ty->elem);
                return fieldIdx * ((elemSize + align - 1) / align * align);
            }
            return fieldIdx * elemSize;
        }

        return 0;
    }

    // Classify a struct type for ABI purposes
    // Returns 0 = MEMORY, 1 = INTEGER, 2 = FPU, 3 = MIXED
    // Returns never travel in registers beyond eax:edx; anything
    // larger than 8 bytes is MEMORY (sret). A struct made only of
    // floats falls in the FPU class and returns in st0.
    u32 classifyStructType(IrType* ty)
    {
        if (ty == null || ty->kind != IrTypeKind::Struct) return 0;

        u32 sz = ty->width;
        if (sz == 0) return 0;
        if (sz > 8) return 0;  // MEMORY — sret hidden pointer

        bool allFloat = ty->nparams > 0;
        for (u32 i = 0; i < ty->nparams; i++)
        {
            if (self.classifyField(ty->params[i]) != 2)
                allFloat = false;
        }

        if (allFloat) return 2;  // FPU — st0
        return 1;  // INTEGER — eax:edx
    }

    // Count register fields for a struct
    u32 structRegCount(IrType* ty)
    {
        if (ty == null || ty->kind != IrTypeKind::Struct) return 0;
        // eax for a single word, eax:edx for two, sret for anything
        // bigger means no return registers at all
        u32 sz = ty->width;
        if (sz <= 4 && sz > 0) return 1;
        if (sz <= 8) return 2;
        return 0;
    }

    // Check if struct fits in integer registers
    bool isIntegerStruct(IrType* ty)
    {
        u32 cls = self.classifyStructType(ty);
        return cls == 1;
    }

    // Check if struct fits in SSE registers
    // i386 psABI never returns whole structs in XMM; the fp struct is
    // the FPU class, so this only fires for degenerate cases
    bool isSSEStruct(IrType* ty)
    {
        u32 cls = self.classifyStructType(ty);
        return cls == 2;
    }

    // Check if struct must go in memory
    bool isMemoryStruct(IrType* ty)
    {
        u32 cls = self.classifyStructType(ty);
        return cls == 0;
    }

    // Check if struct has mixed integer/SSE fields (per-eightbyte classification)
    // i386 psABI has no MIXED class; mixed-content structs classify
    // INTEGER (returned in eax:edx as raw words), so this stays false
    bool isMixedStruct(IrType* ty)
    {
        u32 cls = self.classifyStructType(ty);
        return cls == 3;
    }

    // Flatten compound structs (recursive)
    // Returns the total number of leaf fields
    u32 flattenStruct(IrType* ty, IrType** outFields, u32 maxFields)
    {
        if (ty == null || maxFields == 0) return 0;

        if (ty->kind == IrTypeKind::Struct)
        {
            // struct field types ride on the interned IrType itself
            // (params/nparams), not elem — elem is null for structs
            u32 count = 0;
            for (u32 i = 0; i < ty->nparams && count < maxFields; i++)
                count += self.flattenStruct(ty->params[i], outFields + count, maxFields - count);
            return count;
        }

        if (ty->kind == IrTypeKind::Array && ty->elem != null)
        {
            u32 count = 0;
            for (u32 i = 0; i < ty->count && count < maxFields; i++)
            {
                if (ty->elem->kind == IrTypeKind::Struct)
                    count += self.flattenStruct(ty->elem, outFields + count, maxFields - count);
                else if (count < maxFields)
                {
                    outFields[count] = ty->elem;
                    count++;
                }
            }
            return count;
        }

        if (outFields != null)
            outFields[0] = ty;
        return 1;
    }

    // scalar word for an aggregate of `sz` bytes on eax:edx — i8 for a
    // single byte, i16 for two, i32 covering the eax word for three to
    // four, i64 spanning the eax:edx pair for five to eight
    IrType* i386WordTy(u32 sz)
    {
        if (sz <= 1) return self.ctx->tyInt(8);
        if (sz == 2) return self.ctx->tyInt(16);
        if (sz <= 4) return self.ctx->tyInt(32);
        return self.ctx->tyInt(64);
    }

    // param lowering kind: struct params always stay by value on i386
    // (cdecl pushes them on the stack), so only the two walk-through
    // kinds exist in practice
    u32 paramKind(IrType* ty)
    {
        if (ty == null || ty->kind != IrTypeKind::Struct) return 0;
        return 0;
    }

    // return lowering kind: 0 keep, 1 sret, 2 single scalar word
    u32 retModel(IrType* sTy)
    {
        u32 sz = sTy->width;
        if (sz == 0 || sz > 8) return 1;
        return 2;
    }

    IrType* retScalar(IrType* sTy)
    {
        return self.i386WordTy(sTy->width);
    }

    IrValue* newArgValue(IrType* ty)
    {
        IrValue* a = alloc<IrValue>((usize)1);
        *a = IrValue { IrValueKind::Arg, ty, self.ctx->nextValueId(), 0, null, null, 0, 0 };
        return a;
    }

    IrInst* emit(IrOpcode op, IrType* ty, IrValue** ops, u32 nops, IrBlock* bb, IrInst* before)
    {
        IrInst* inst = self.ctx->createInst(op, ty, ops, nops, 0, 0);
        for (u32 i = 0; i < nops; i++)
            if (ops != null && ops[i] != null) ops[i]->addUser(inst);
        if (before != null) bb->insertBefore(inst, before);
        else bb->addInst(inst);
        if (ops != null) dealloc<IrValue*>(ops);
        return inst;
    }

    // scratch alloca of `nbytes` raw bytes sitting in block bb
    IrInst* emitRawAlloca(IrBlock* bb, IrInst* before, u32 nbytes)
    {
        IrType* arrTy = self.ctx->tyArray(self.ctx->tyInt(8), nbytes);
        return self.emit(IrOpcode::Alloca, self.ctx->tyPtr(arrTy), null, 0, bb, before);
    }

    // word value: bitcast scratch to the word's ptr type, index it by
    // its byte offset, load the word
    IrValue* emitWordLoad(IrInst* scratch, IrType* wTy, u32 byteOff, IrBlock* bb, IrInst* before)
    {
        IrValue** o1 = alloc<IrValue*>((usize)1);
        o1[0] = &scratch->base;
        IrInst* pw = self.emit(IrOpcode::Bitcast, self.ctx->tyPtr(wTy), o1, 1, bb, before);
        IrValue** o2 = alloc<IrValue*>((usize)2);
        o2[0] = &pw->base;
        o2[1] = self.ctx->constInt(self.ctx->tyInt(64), (u64)(byteOff / self.ctx->irTypeSizeOf(wTy)));
        IrInst* pk = self.emit(IrOpcode::Gep, self.ctx->tyPtr(wTy), o2, 2, bb, before);
        IrValue** o3 = alloc<IrValue*>((usize)1);
        o3[0] = &pk->base;
        return &self.emit(IrOpcode::Load, wTy, o3, 1, bb, before)->base;
    }

    bool isLowered(IrFunc* func)
    {
        if (func == null || func->metadata == null) return false;
        MetadataSet* md = (MetadataSet*)func->metadata;
        return find(md, "abi.lower") != null;
    }

    void markLowered(IrFunc* func)
    {
        MetadataSet* md = attachFuncMetadata(func);
        addString(md, "abi.lower", dupStrVal("sysv_i386"));
    }

    bool run(IrFunc* func)
    {
        if (func == null || func->isExtern) return false;
        if (self.isLowered(func)) return false;

        IrType* oldRet = func->retType;
        u32 rmode = (oldRet != null && oldRet->kind == IrTypeKind::Struct) ? self.retModel(oldRet) : 0;

        u32 nslots = 0;
        if (rmode == 1) nslots++;
        nslots += func->nparams;

        IrType** npt = alloc<IrType*>((usize)(nslots > 0 ? nslots : 1));
        IrValue** nargs = alloc<IrValue*>((usize)(nslots > 0 ? nslots : 1));
        u32 m = 0;
        IrValue* sretArg = null;
        if (rmode == 1)
        {
            npt[m] = self.ctx->tyPtr(oldRet);
            nargs[m] = self.newArgValue(self.ctx->tyPtr(oldRet));
            sretArg = nargs[m];
            m++;
        }
        for (u32 i = 0; i < func->nparams; i++)
        {
            npt[m] = func->paramTypes[i];
            nargs[m] = func->args[i];
            m++;
        }

        IrType* newRet = oldRet;
        if (rmode == 1) newRet = self.ctx->tyVoid();
        else if (rmode == 2) newRet = self.retScalar(oldRet);

        func->paramTypes = npt;
        func->nparams = m;
        func->args = nargs;
        func->nargs = m;
        func->capArgs = m;
        func->retType = newRet;
        func->base.type = self.ctx->tyFunc(newRet, npt, m, false);

        if (func->nblocks > 0)
        {
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                for (u32 ii = 0; ii < bb->ninsts; ii++)
                {
                    IrInst* inst = bb->insts[ii];
                    if (inst->opcode != IrOpcode::Ret || inst->nops < 1) continue;
                    IrValue* v = inst->ops[0];
                    if (v == null || v->type == null || v->type->kind != IrTypeKind::Struct) continue;

                    if (rmode == 1)
                    {
                        IrValue** so = alloc<IrValue*>((usize)2);
                        so[0] = v;
                        so[1] = sretArg;
                        self.emit(IrOpcode::Store, self.ctx->tyVoid(), so, 2, bb, inst);
                        v->removeUser(inst);
                        dealloc<IrValue*>(inst->ops);
                        inst->ops = null;
                        inst->nops = 0;
                        inst->capOps = 0;
                        inst->base.type = self.ctx->tyVoid();
                    }
                    else if (rmode == 2)
                    {
                        u32 nb = (v->type->width + 7) / 8 * 8;
                        IrInst* scratch = self.emitRawAlloca(bb, inst, nb);
                        IrValue** o1 = alloc<IrValue*>((usize)1);
                        o1[0] = &scratch->base;
                        IrInst* pS = self.emit(IrOpcode::Bitcast, self.ctx->tyPtr(v->type), o1, 1, bb, inst);
                        IrValue** o2 = alloc<IrValue*>((usize)2);
                        o2[0] = v;
                        o2[1] = &pS->base;
                        self.emit(IrOpcode::Store, self.ctx->tyVoid(), o2, 2, bb, inst);
                        IrType* wt = self.retScalar(v->type);
                        IrValue* w = self.emitWordLoad(scratch, wt, 0, bb, inst);
                        v->removeUser(inst);
                        inst->ops[0] = w;
                        w->addUser(inst);
                        inst->base.type = wt;
                    }
                }
            }
        }

        self.markLowered(func);
        return true;
    }

    // Rebuild one call site of `callee` so the operands match the
    // lowered signature; results are rebuilt back into the original
    // struct type before any uses see them.
    bool rewriteCall(IrInst* call, IrFunc* callee)
    {
        IrBlock* bb = call->parent;
        IrType* oldRet = call->base.type;
        u32 rmode = (oldRet != null && oldRet->kind == IrTypeKind::Struct) ? self.siteRetModel(callee, oldRet) : 0;

        IrValue* sretCallArg = null;
        IrValue** nargs = alloc<IrValue*>((usize)(call->nops + 2));
        u32 na = 0;
        if (rmode == 1)
        {
            IrInst* sretSlot = self.emit(IrOpcode::Alloca, self.ctx->tyPtr(oldRet), null, 0, bb, call);
            sretCallArg = &sretSlot->base;
            nargs[na++] = sretCallArg;
        }

        for (u32 i = 1; i < call->nops; i++)
        {
            IrValue* arg = call->ops[i];
            if (arg != null && arg->type != null && arg->type->kind == IrTypeKind::Struct)
            {
                u32 pk = self.paramKind(arg->type);
                if (pk == 0)
                {
                    // all args stay aggregate on the stack — pass through
                    nargs[na++] = arg;
                }
                else if (pk == 1)
                {
                    IrInst* slot = self.emit(IrOpcode::Alloca, self.ctx->tyPtr(arg->type), null, 0, bb, call);
                    IrValue** oo = alloc<IrValue*>((usize)2);
                    oo[0] = arg;
                    oo[1] = &slot->base;
                    self.emit(IrOpcode::Store, self.ctx->tyVoid(), oo, 2, bb, call);
                    nargs[na++] = &slot->base;
                }
                else
                {
                    nargs[na++] = arg;
                }
            }
            else
            {
                nargs[na++] = arg;
            }
        }

        IrType* newRet = rmode == 1 ? self.ctx->tyVoid() : rmode == 2 ? self.siteRetScalar(callee, oldRet) : oldRet;
        IrValue** ops = alloc<IrValue*>((usize)(na + 1));
        ops[0] = &callee->base;
        for (u32 i = 0; i < na; i++) ops[i + 1] = nargs[i];
        IrInst* nc = self.emit(IrOpcode::Call, newRet, ops, na + 1, bb, call);

        if (rmode == 1)
        {
            IrValue** oo = alloc<IrValue*>((usize)1);
            oo[0] = sretCallArg;
            IrValue* res = &self.emit(IrOpcode::Load, oldRet, oo, 1, bb, call)->base;
            self.oldCallResultFix(call, res);
        }
        else if (rmode == 2)
        {
            IrType* wt = self.siteRetScalar(callee, oldRet);
            u32 nb = (oldRet->width + 7) / 8 * 8;
            IrInst* scratch = self.emitRawAlloca(bb, call, nb);
            IrValue** o1 = alloc<IrValue*>((usize)1);
            o1[0] = &scratch->base;
            IrInst* pW = self.emit(IrOpcode::Bitcast, self.ctx->tyPtr(wt), o1, 1, bb, call);
            IrValue** o2 = alloc<IrValue*>((usize)2);
            o2[0] = &nc->base;
            o2[1] = &pW->base;
            self.emit(IrOpcode::Store, self.ctx->tyVoid(), o2, 2, bb, call);
            IrValue** o3 = alloc<IrValue*>((usize)1);
            o3[0] = &scratch->base;
            IrInst* pS = self.emit(IrOpcode::Bitcast, self.ctx->tyPtr(oldRet), o3, 1, bb, call);
            IrValue** o4 = alloc<IrValue*>((usize)1);
            o4[0] = &pS->base;
            IrValue* res = &self.emit(IrOpcode::Load, oldRet, o4, 1, bb, call)->base;
            self.oldCallResultFix(call, res);
        }
        else
        {
            // unchanged return: rewire to the new call's result
            IrValue* res = &nc->base;
            self.oldCallResultFix(call, res);
        }

        dealloc<IrValue*>(nargs);
        return true;
    }

    void oldCallResultFix(IrInst* call, IrValue* res)
    {
        call->base.replaceAllUses(res);
        IrBlock* bb = call->parent;
        for (u32 i = 0; i < call->nops; i++)
            if (call->ops[i] != null) call->ops[i]->removeUser(call);
        if (call->capOps > 0) dealloc<IrValue*>(call->ops);
        call->ops = null;
        call->capOps = 0;
        call->nops = 0;
        u32 idx = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
            if (bb->insts[i] == call) { idx = i; break; }
        for (u32 j = idx; j < bb->ninsts - 1; j++)
            bb->insts[j] = bb->insts[j + 1];
        bb->ninsts--;
        if (call->base.capUsers > 0) dealloc<IrInst*>(call->base.users);
        dealloc<IrInst>(call);
    }

    // figure out what happened to the return of the callee that this
    // call site used: 1 sret, 2 single scalar word, 0 kept
    u32 siteRetModel(IrFunc* callee, IrType* oldRet)
    {
        if (oldRet == null || oldRet->kind != IrTypeKind::Struct) return 0;
        IrType* nt = callee != null ? callee->retType : null;
        if (nt == null) return 0;
        if (nt->kind == IrTypeKind::Void) return 1;
        if (nt->kind == IrTypeKind::Struct)
        {
            // a truly different struct return type is unreachable for
            // defined functions (their returns always become void or a
            // word), and externs always keep their declared type — so
            // matching struct means the return is untouched
            return 0;
        }
        return 2;
    }

    IrType* siteRetScalar(IrFunc* callee, IrType* oldRet)
    {
        // the new return word must be the scalar the callee now returns
        IrType* nt = callee->retType;
        return nt;
    }

    // Every direct call of `func` anywhere in the module gets its
    // argument list rebuilt for the lowered signature; results are
    // rewrapped into their original struct type.
    bool lowerCallSites(IrFunc* func)
    {
        if (self.modd == null) return false;
        u32 ncalls = 0;
        for (u32 fi = 0; fi < self.modd->nfuncs; fi++)
        {
            IrFunc* f = self.modd->funcs[fi];
            for (u32 bi = 0; bi < f->nblocks; bi++)
            {
                IrBlock* bb = f->blocks[bi];
                for (u32 ii = 0; ii < bb->ninsts; ii++)
                {
                    IrInst* inst = bb->insts[ii];
                    if (inst->opcode == IrOpcode::Call && inst->nops >= 1 && inst->ops[0] == &func->base)
                        ncalls++;
                }
            }
        }

        bool changed = ncalls > 0;
        IrInst** calls = alloc<IrInst*>((usize)(ncalls > 0 ? ncalls : 1));
        u32 nc = 0;
        for (u32 fi = 0; fi < self.modd->nfuncs; fi++)
        {
            IrFunc* f = self.modd->funcs[fi];
            for (u32 bi = 0; bi < f->nblocks; bi++)
            {
                IrBlock* bb = f->blocks[bi];
                for (u32 ii = 0; ii < bb->ninsts; ii++)
                {
                    IrInst* inst = bb->insts[ii];
                    if (inst->opcode == IrOpcode::Call && inst->nops >= 1 && inst->ops[0] == &func->base)
                        calls[nc++] = inst;
                }
            }
        }
        for (u32 k = 0; k < nc; k++)
            self.rewriteCall(calls[k], func);

        dealloc<IrInst*>(calls);
        return changed;
    }
}

pub bool irABILower(IrFunc* func, rawptr userdata)
{
    if (func == null) return false;
    IrModule* modd = (IrModule*)userdata;
    if (modd == null && func->parent != null) modd = func->parent;
    if (modd == null) return false;
    if (func->parent == null) func->parent = modd;
    X86ABILowering lower = X86ABILowering::new(modd->ctx);
    lower.modd = modd;
    if (lower.isLowered(func)) return false;

    bool changed = false;
    if (!func->isExtern)
        changed = lower.run(func);
    else
        lower.markLowered(func);

    changed = lower.lowerCallSites(func) || changed;
    return changed;
}
