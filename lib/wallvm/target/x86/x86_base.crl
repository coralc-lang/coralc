#[[no_drop_all]]
// reserved registers for the 32-bit x86 allocator — the same contract
// the 64-bit table keeps, in the 32-bit spelling. Same deal as the
// 64-bit base, the drivers share it while verification is outstanding,
// then we split each platform off permanently so no if-comparison
// pile-up rides along asking who is running.
pub str X86_RESERVED_INT[2] = {
    "esp", "ebp"
};

pub str X86_RESERVED_FLOAT[2] = {
    "xmm0", "xmm1"
};

pub str X86_FLOAT_REGS[2] = {
    "st0", "st1"
};

pub str X86_INT_REGS[6] = {
    "eax", "ecx", "edx", "ebx", "esi", "edi"
};

pub str X86_INT_CALLEE_SAVE[4] = {
    "ebx", "esi", "edi", "ebp"
};

pub str X86_INT_CALLER_SAVE[3] = {
    "eax", "ecx", "edx"
};

// I kept the register tables and the split note exactly as they sat at
// the top and put the imports right below them, so their position and
// spelling stay untouched.
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrInst, IrValue };
import(lib) wallvm::irOps { IrOpcode, IrICmpPred };
import(lib) std::mman { alloc, dealloc };
import(lib) std::text::string { String };

// x86 (32-bit/i386) base code generator

static String _textBuf[16];
static u32 _textI = 0;

static String* textBufNext()
{
    String* b = &_textBuf[_textI++ & 15];
    if (b->ptr == null) *b = String::withCap(32);
    b->clear();
    return b;
}

pub struct X86Emitter
{
    IrContext* ctx;
    IrModule* modd;
    bool useAtt;
    String output;
    u32 labelCounter;

    void init(IrContext* ctx, IrModule* modd, bool useAtt)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.useAtt = useAtt;
        self.output = String::new();
        self.labelCounter = 0;
    }

    u32 nextLabel()
    {
        return self.labelCounter++;
    }

    void emit(str s)
    {
        if (s.ptr == null) return;
        self.output.pushView(s);
    }

    void emitLine(str s)
    {
        self.emit(s);
        self.emit("\n");
    }

    void emitTab(str instr)
    {
        self.emit("\t");
        self.emitLine(instr);
    }

    str getOutput() { return self.output.asView(); }
}

pub struct X86CodeGen
{
    IrContext* ctx;
    IrModule* modd;
    X86Emitter emitter;
    bool isWindows;
    bool currentFuncHasFrame;
    bool useRedZone;
    bool savedCalleeSaves[4];
    u32 numCalleeSaves;
    str lastCallTarget;
    IrValue* lastCallResult;
    bool omitFramePointer;
    bool calleeSavesPushed;
    u32 spillSlotCount;
    u32 spillFrameBytes;

    void init(IrContext* ctx, IrModule* modd, bool isWindows, bool useAtt)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.isWindows = isWindows;
        self.omitFramePointer = true;
        self.emitter.init(ctx, modd, useAtt);
    }

    static bool isCalleeSaved(str reg)
    {
        if (reg.equals("ebx")) return true;
        if (reg.equals("esi")) return true;
        if (reg.equals("edi")) return true;
        if (reg.equals("ebp")) return true;
        return false;
    }

    bool funcUsesReg(IrFunc* func, str reg)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                str dst = self.getRegName(&inst->base);
                if (dst.equals(reg)) return true;
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    str op = self.getRegName(inst->ops[oi]);
                    if (op.equals(reg)) return true;
                }
            }
        }
        return false;
    }

    bool blockUsesReg(IrBlock* bb, str reg)
    {
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            str dst = self.getRegName(&inst->base);
            if (dst.equals(reg)) return true;
            for (u32 oi = 0; oi < inst->nops; oi++)
            {
                str op = self.getRegName(inst->ops[oi]);
                if (op.equals(reg)) return true;
            }
        }
        return false;
    }

    void emitPushCalleeSave(str reg)
    {
        if (self.emitter.useAtt)
        {
            self.emitter.emit("\tpushl %");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
        else
        {
            self.emitter.emit("\tpush ");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
    }

    void emitDeferredCalleeSaves(IrBlock* bb)
    {
        if (self.calleeSavesPushed) return;

        str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
        bool needed = false;
        for (u32 i = 0; i < 4; i++)
        {
            if (self.savedCalleeSaves[i])
            {
                if (self.blockUsesReg(bb, calleeSaveRegs[i]))
                {
                    needed = true;
                    break;
                }
            }
        }

        if (!needed) return;

        self.calleeSavesPushed = true;
        for (u32 i = 0; i < 4; i++)
        {
            if (self.savedCalleeSaves[i])
                self.emitPushCalleeSave(calleeSaveRegs[i]);
        }
    }

    void emitPrologue(IrFunc* func)
    {
        if (self.isWindows)
        {
            self.emitter.emit("public _");
            self.emitter.emitLine(func->base.name);
            self.emitter.emit("_");
        }
        else
        {
            self.emitter.emit(".globl ");
            self.emitter.emitLine(func->base.name);
        }
        self.emitter.emit(".type ");
        self.emitter.emit(func->base.name);
        self.emitter.emitLine(", @function");

        self.emitter.emit(func->base.name);
        self.emitter.emitLine(":");

        self.useRedZone = false;
        self.numCalleeSaves = 0;
        self.lastCallTarget = "";
        self.lastCallResult = null;
        self.spillSlotCount = self.countSpillSlots(func);
        self.spillFrameBytes = self.spillSlotCount * 8;

        bool isLeaf = func->isLeaf();

        // the slots hang off ebp, so a leaf keeps its frameless path
        // only when the allocator spilled nothing
        if (isLeaf && !self.isWindows && self.spillSlotCount == 0)
        {
            self.currentFuncHasFrame = false;
            return;
        }

        bool hasFrame = !isLeaf && !self.omitFramePointer;
        bool usesAnyCalleeSave = false;
        str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
        for (u32 i = 0; i < 4; i++)
        {
            str reg = calleeSaveRegs[i];
            if (hasFrame && reg.equals("ebp"))
                continue;
            if (self.funcUsesReg(func, reg))
            {
                self.savedCalleeSaves[i] = true;
                self.numCalleeSaves++;
                usesAnyCalleeSave = true;
            }
            else
            {
                self.savedCalleeSaves[i] = false;
            }
        }

        self.calleeSavesPushed = false;
        // once slots exist the frame cannot shrink-wrap out of the
        // prologue, so the saves go down ahead of it
        bool canShrinkWrap = usesAnyCalleeSave && !hasFrame && self.spillSlotCount == 0;

        if (!canShrinkWrap && (!isLeaf || self.spillSlotCount > 0))
        {
            self.calleeSavesPushed = true;
            for (u32 i = 0; i < 4; i++)
            {
                if (self.savedCalleeSaves[i])
                    self.emitPushCalleeSave(calleeSaveRegs[i]);
            }
        }

        if (self.spillSlotCount > 0)
        {
            // the frame the slots are addressed from — mandatory even
            // for a leaf, since the slot homes are ebp-relative
            if (self.emitter.useAtt)
            {
                self.emitter.emitTab("pushl %ebp");
                self.emitter.emitTab("movl %esp, %ebp");
            }
            else
            {
                self.emitter.emitTab("push ebp");
                self.emitter.emitTab("mov ebp, esp");
            }
            self.currentFuncHasFrame = true;
            self.emitter.emit("\tsubl $");
            self.emitter.emit(u32ToStr(self.spillFrameBytes));
            self.emitter.emitLine(", %esp");
        }
        else if (!isLeaf && self.omitFramePointer)
        {
            self.currentFuncHasFrame = false;
        }
        else if (!isLeaf)
        {
            if (self.emitter.useAtt)
            {
                self.emitter.emitTab("pushl %ebp");
                self.emitter.emitTab("movl %esp, %ebp");
            }
            else
            {
                self.emitter.emitTab("push ebp");
                self.emitter.emitTab("mov ebp, esp");
            }
            self.currentFuncHasFrame = true;
        }
        else
        {
            self.currentFuncHasFrame = false;
        }
    }

    void emitEpilogue()
    {
        if (self.currentFuncHasFrame)
            self.emitter.emitTab("leave");

        if (self.calleeSavesPushed)
        {
            str calleeSaveRegs[4] = {"ebx", "esi", "edi", "ebp"};
            for (u32 i = 4; i > 0; i--)
            {
                u32 idx = i - 1;
                if (self.savedCalleeSaves[idx])
                {
                    str reg = calleeSaveRegs[idx];
                    if (self.emitter.useAtt)
                    {
                        self.emitter.emit("\tpopl %");
                        self.emitter.emit(reg);
                        self.emitter.emit("\n");
                    }
                    else
                    {
                        self.emitter.emit("\tpop ");
                        self.emitter.emit(reg);
                        self.emitter.emit("\n");
                    }
                }
            }
        }

        self.emitter.emitTab("ret");
    }

    void emitRet(IrInst* inst)
    {
        if (inst->nops > 0 && inst->ops[0] != null)
        {
            str src = self.getRegForValue(inst->ops[0]);
            if (!src.equals("eax"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src);
                self.emitter.emitLine(", %eax");
            }
        }
        // G34: the old tail heuristic fired after the call text was
        // already out, so the jmp below ran the callee a second time, and
        // a correct 32-bit tail call needs the callee's stack arguments
        // shifted under the inherited return address, which needs
        // signature knowledge this backend does not have. Off until then,
        // the x86_64 backend has the real shape check.
        self.emitEpilogue();
    }

    static str u32ToStr(u32 val)
    {
        String* b = textBufNext();
        if (val == 0) { b->pushChar('0'); return b->asView(); }
        u8 tmp[10];
        u32 n = 0;
        while (val > 0) { tmp[n++] = (u8)('0' + (val % 10)); val /= 10; }
        while (n > 0) { n--; b->pushChar(tmp[n]); }
        return b->asView();
    }

    str getRegName(IrValue* val)
    {
        if (val == null) return "eax";
        u64 vd = val->valData;
        if (vd & 0x80000000UL)
            return "eax";
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 2) return X86_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        if (reg < 6) return X86_INT_REGS[reg];
        return "eax";
    }

    bool valueIsSpill(IrValue* val)
    {
        if (val == null) return false;
        return (val->valData & 0x80000000UL) != 0;
    }

    // Slot i lives at -8*(i+1)(%ebp). I sized the slots at eight bytes
    // rather than the old decode's four so an f64 fits, and ebp is
    // established whenever anything spilled, so the homes are stable
    // for the whole function. The rotating buffers keep one
    // instruction from overwriting its own operand text.
    str slotText(u32 slot)
    {
        String* b = textBufNext();
        b->pushChar('-');
        b->pushView(u32ToStr((slot + 1) * 8));
        b->pushView("(%ebp)");
        return b->asView();
    }

    // Operand usable in hasAny position that accepts a memory operand —
    // the value's register name, or its spill-slot address text.
    str opFor(IrValue* v)
    {
        if (v == null) return "eax";
        u64 vd = v->valData;
        if (vd & 0x80000000UL)
            return self.slotText((u32)(vd & 0x3FFFFFFF));
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 2) return X86_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        if (reg < 6) return X86_INT_REGS[reg];
        self.emitter.emit("; ERROR: out-of-range register index ");
        self.emitter.emitLine(u32ToStr(reg));
        return "eax";
    }

    // the old name stays as an alias so every unconverted call site is
    // spill-correct for memory-accepting positions; register-only
    // positions go through opForReg instead
    str getRegForValue(IrValue* v)
    {
        return self.opFor(v);
    }

    // Forced register operand — a spill slot reloads into the scratch
    // first. I hand a register-resident value back untouched instead of
    // always moving it like the 64-bit base, because the reserved table
    // here holds only esp/ebp and an idle move into an allocatable
    // scratch would cost a live value for nothing.
    str opForReg(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        return self.opFor(v);
    }

    // A scratch out of the allocatable set that none of this
    // instruction's register operands already sits in. lsra hands out
    // all six of eax..edi — only esp/ebp are reserved — so no scratch
    // is ever free; skipping the operands this instruction still has
    // to read keeps a reload from landing on a sibling value.
    str scratchAvoiding(str a, str b, str c)
    {
        for (u32 i = 0; i < 6; i++)
        {
            str cand = X86_INT_REGS[i];
            if (a.ptr != null && cand.equals(a)) continue;
            if (b.ptr != null && cand.equals(b)) continue;
            if (c.ptr != null && cand.equals(c)) continue;
            return cand;
        }
        return "eax";
    }

    u32 countSpillSlots(IrFunc* func)
    {
        bool hasAny = false;
        u32 max = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u64 vd = inst->base.valData;
                if ((vd & 0x80000000UL) != 0)
                {
                    u32 idx = (u32)(vd & 0x3FFFFFFF);
                    if (!hasAny || idx > max) max = idx;
                    hasAny = true;
                }
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* o = inst->ops[oi];
                    if (o == null) continue;
                    u64 ov = o->valData;
                    if ((ov & 0x80000000UL) != 0)
                    {
                        u32 idx = (u32)(ov & 0x3FFFFFFF);
                        if (!hasAny || idx > max) max = idx;
                        hasAny = true;
                    }
                }
            }
        }
        return hasAny ? max + 1 : 0;
    }

    void emitInst(IrInst* inst)
    {
        switch (inst->opcode)
        {
            IrOpcode::Add => { self.emitBinOp(inst, "addl"); },
            IrOpcode::Sub => { self.emitBinOp(inst, "subl"); },
            IrOpcode::Mul => { self.emitBinOp(inst, "imull"); },
            IrOpcode::SDiv => { self.emitDiv(inst, true); },
            IrOpcode::UDiv => { self.emitDiv(inst, false); },
            IrOpcode::SRem => { self.emitRem(inst, true); },
            IrOpcode::URem => { self.emitRem(inst, false); },
            IrOpcode::And => { self.emitBinOp(inst, "andl"); },
            IrOpcode::Or => { self.emitBinOp(inst, "orl"); },
            IrOpcode::Xor => { self.emitBinOp(inst, "xorl"); },
            IrOpcode::Shl => { self.emitShift(inst, "shll"); },
            IrOpcode::Ashr => { self.emitShift(inst, "sarl"); },
            IrOpcode::Lshr => { self.emitShift(inst, "shrl"); },
            IrOpcode::Load => { self.emitLoad(inst); },
            IrOpcode::Store => { self.emitStore(inst); },
            IrOpcode::ICmp => { self.emitICmp(inst); },
            IrOpcode::Br => { self.emitBr(inst); },
            IrOpcode::CondBr => { self.emitCondBr(inst); },
            IrOpcode::Ret => { self.emitRet(inst); },
            IrOpcode::Call => { self.emitCall(inst); },
            IrOpcode::SiToFp => {
                str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
                // Push integer onto CPU stack, load as FPU, clean up
                self.emitter.emit("\tpushl ");
                self.emitter.emitLine(src);
                self.emitter.emitTab("fildl (%esp)");
                self.emitter.emitTab("addl $4, %esp");
            },
            IrOpcode::FpToSi => {
                str dst = self.getRegForValue(&inst->base);
                // Float value is in ST(0), convert to integer and store to dest
                self.emitter.emitTab("subl $4, %esp");
                self.emitter.emitTab("fistpl (%esp)");
                self.emitter.emit("\tpopl ");
                self.emitter.emitLine(dst);
            },
            else => { self.emitter.emit("; unhandled"); },
        }
    }

    void emitBinOp(IrInst* inst, str op)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ecx";
        // a spilled destination rides a scratch through the op and
        // stores back, x86 has no memory to memory form
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? self.scratchAvoiding(src1, src2, null) : dst;
        if (!src1.equals(work))
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
        }
        self.emitter.emit("\t");
        self.emitter.emit(op);
        self.emitter.emit(" ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        if (dstSpill)
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(work);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    void emitDiv(IrInst* inst, bool isSigned)
    {
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ecx";
        str dst = self.getRegForValue(&inst->base);
        // If divisor is in eax, save it to ecx first before loading dividend
        if (src2.equals("eax"))
        {
            self.emitter.emit("\tmovl %eax, %ecx");
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
        }
        else
        {
            // Load dividend into eax
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
            // Move divisor to ecx if not already there
            if (!src2.equals("ecx"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %ecx");
            }
        }
        // Sign-extend or zero-extend edx:eax
        if (isSigned)
            self.emitter.emitTab("cltd");
        else
            self.emitter.emitTab("xorl %edx, %edx");
        self.emitter.emit("\t");
        self.emitter.emitLine(isSigned ? "idivl %ecx" : "divl %ecx");
        if (!dst.equals("eax"))
        {
            self.emitter.emit("\tmovl %eax, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitRem(IrInst* inst, bool isSigned)
    {
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ecx";
        str dst = self.getRegForValue(&inst->base);
        // If divisor is in eax, save it to ecx first before loading dividend
        if (src2.equals("eax"))
        {
            self.emitter.emit("\tmovl %eax, %ecx");
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
        }
        else
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %eax");
            if (!src2.equals("ecx"))
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %ecx");
            }
        }
        if (isSigned)
            self.emitter.emitTab("cltd");
        else
            self.emitter.emitTab("xorl %edx, %edx");
        self.emitter.emit("\t");
        self.emitter.emitLine(isSigned ? "idivl %ecx" : "divl %ecx");
        if (!dst.equals("edx"))
        {
            self.emitter.emit("\tmovl %edx, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitShift(IrInst* inst, str op)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        str amt = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ecx";
        // a spilled destination rides a scratch through the shift, and
        // that scratch has to dodge %ecx too — the count lands there;
        // a destination parked in %ecx itself would be stomped by the
        // count reload, so it rides a scratch the same way
        bool dstSpill = self.valueIsSpill(&inst->base);
        bool dstIsCountReg = dst.equals("ecx") && !amt.equals("ecx");
        str work = (dstSpill || dstIsCountReg) ? self.scratchAvoiding(src1, amt, "ecx") : dst;
        self.emitter.emit("\tmovl ");
        self.emitter.emit(src1);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        // Shift count must be in %cl
        if (!amt.equals("ecx"))
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(amt);
            self.emitter.emitLine(", %ecx");
        }
        self.emitter.emit("\t");
        self.emitter.emit(op);
        self.emitter.emit(" %cl, ");
        self.emitter.emitLine(work);
        if (dstSpill || dstIsCountReg)
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(work);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    void emitLoad(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        // the address must be a register, and mov has no memory to
        // memory form either, so a spilled destination collects in
        // %eax before the slot store
        if (self.valueIsSpill(&inst->base))
        {
            str src = (inst->nops > 0) ? self.opForReg(inst->ops[0], "eax") : "eax";
            self.emitter.emit("\tmovl (");
            self.emitter.emit(src);
            self.emitter.emit("), %eax");
            self.emitter.emitLine("");
            self.emitter.emit("\tmovl %eax, ");
            self.emitter.emitLine(dst);
        }
        else
        {
            // a spilled address reloads straight into the destination
            str src = (inst->nops > 0) ? self.opForReg(inst->ops[0], dst) : "eax";
            self.emitter.emit("\tmovl (");
            self.emitter.emit(src);
            self.emitter.emit("), ");
            self.emitter.emitLine(dst);
        }
    }

    void emitStore(IrInst* inst)
    {
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        bool srcSpill = inst->nops > 0 && self.valueIsSpill(inst->ops[0]);
        // mov takes one memory operand at most, so a spilled value is
        // reloaded before the store, and when both sides are memory
        // the address takes a second scratch out of its way
        if (srcSpill && inst->nops > 1 && self.valueIsSpill(inst->ops[1]))
        {
            str aReg = self.scratchAvoiding(null, null, null);
            str sReg = self.scratchAvoiding(aReg, null, null);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(self.getRegForValue(inst->ops[1]));
            self.emitter.emit(", ");
            self.emitter.emitLine(aReg);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(sReg);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(sReg);
            self.emitter.emit(", (");
            self.emitter.emit(aReg);
            self.emitter.emitLine(")");
        }
        else if (srcSpill)
        {
            str addr = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ebx";
            str sReg = self.scratchAvoiding(addr, null, null);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(sReg);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(sReg);
            self.emitter.emit(", (");
            self.emitter.emit(addr);
            self.emitter.emitLine(")");
        }
        else
        {
            str addr = (inst->nops > 1) ? self.opForReg(inst->ops[1], self.scratchAvoiding(src, null, null)) : "ebx";
            self.emitter.emit("\tmovl ");
            self.emitter.emit(src);
            self.emitter.emit(", (");
            self.emitter.emit(addr);
            self.emitter.emitLine(")");
        }
    }

    void emitICmp(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "eax";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "ecx";
        // cmp takes one memory operand at most, two spills need a
        // reload — into %eax, which the setcc below burns anyway
        if (self.valueIsSpill(inst->ops[0]) && self.valueIsSpill(inst->ops[1]))
            src1 = self.opForReg(inst->ops[0], "eax");
        self.emitter.emit("\tcmpl ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(src1);
        str setOp;
        switch (inst->icmpPred)
        {
            IrICmpPred::Eq => { setOp = "sete"; },
            IrICmpPred::Ne => { setOp = "setne"; },
            IrICmpPred::Slt => { setOp = "setl"; },
            IrICmpPred::Sle => { setOp = "setle"; },
            IrICmpPred::Sgt => { setOp = "setg"; },
            IrICmpPred::Sge => { setOp = "setge"; },
            IrICmpPred::Ult => { setOp = "setb"; },
            IrICmpPred::Ule => { setOp = "setbe"; },
            IrICmpPred::Ugt => { setOp = "seta"; },
            IrICmpPred::Uge => { setOp = "setae"; },
            else => { setOp = "sete"; },
        }
        self.emitter.emit("\t");
        self.emitter.emit(setOp);
        self.emitter.emitLine(" %al");
        // setcc already wrecked %al, so %eax is the free landing spot
        // for a spilled destination — movzbl cannot write memory
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "eax" : dst;
        self.emitter.emit("\tmovzbl %al, ");
        self.emitter.emitLine(work);
        if (dstSpill)
        {
            self.emitter.emit("\tmovl %eax, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitBr(IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        if (inst->nops > 0 && inst->ops[0] != null)
        {
            self.emitter.emit("\tjmp ");
            self.emitter.emitLine(inst->ops[0]->name);
        }
    }

    void emitCondBr(IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        if (inst->nops >= 3)
        {
            // test takes one memory operand at most, a spilled
            // condition reloads into %eax first
            str cond = self.opForReg(inst->ops[0], "eax");
            self.emitter.emit("\ttestl ");
            self.emitter.emit(cond);
            self.emitter.emit(", ");
            self.emitter.emitLine(cond);
            self.emitter.emit("\tjne ");
            self.emitter.emitLine(inst->ops[1]->name);
            self.emitter.emit("\tjmp ");
            self.emitter.emitLine(inst->ops[2]->name);
        }
    }

    void emitCall(IrInst* inst)
    {
        if (inst->nops > 0 && inst->ops[0] != null)
        {
            IrValue* callee = inst->ops[0];
            u32 nargs = inst->nops - 1;

            self.lastCallTarget = callee->name;
            self.lastCallResult = &inst->base;

            for (u32 i = 0; i < nargs; i++)
            {
                str src = self.getRegForValue(inst->ops[1 + i]);
                self.emitter.emit("\tpushl ");
                self.emitter.emitLine(src);
            }
            self.emitter.emit("\tcall ");
            self.emitter.emitLine(callee->name);
            if (nargs > 0)
            {
                str stackBuf = u32ToStr(nargs * 4);
                self.emitter.emit("\taddl $");
                self.emitter.emitLine(stackBuf);
            }
        }
    }
}
