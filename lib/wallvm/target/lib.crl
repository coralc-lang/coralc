#[[no_drop_all]]
// The CPU target table. Every entry either carries real data the register
// allocator will want (the reserved/register name arrays) or the exact
// entry-point signature wallvm.crl will call; the bodies assert until the
// encoder itself ports alongside regalloc and rules.
pub mod x86_64_V = import linux::linux;
pub mod x86_64_win = import windows::windows;
pub mod x86_64_generic = import generic;
pub mod x86_64_base = import x86_64_base;
pub mod x86_V = import x86::linux::linux;
pub mod x86_base = import x86::x86_base;
pub mod wasm = import wasm::wasm;
