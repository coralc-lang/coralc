pub void emitAvxVecBroadcast256(X86_64Emitter* emitter, const cchar* dst, const cchar* src)
{
    emitter->emit("\tvbroadcastss ");
    emitter->emit(src);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecGather256(X86_64Emitter* emitter,
                             const cchar* dst, const cchar* base,
                             const cchar* indices, u32 scale)
{
    emitter->emit("\tvpgatherdd ");
    emitter->emit(indices);
    emitter->emit(", (");
    emitter->emit(base);
    emitter->emit("), ");
    emitter->emit(dst);
    emitter->emit(", $");
    cchar buf[16];
    u32ToStr(scale, buf);
    emitter->emitLine(buf);
}

pub void emitAvx512VecAdd512(X86_64Emitter* emitter,
                             const cchar* dst, const cchar* src1,
                             const cchar* src2)
{
    if (emitter->features != null && emitter->features->avx512f)
    {
        emitter->emit("\tvpaddd ");
        emitter->emit(src2);
        emitter->emit(", ");
        emitter->emit(src1);
        emitter->emit(", ");
        emitter->emitLine(dst);
    }
}

