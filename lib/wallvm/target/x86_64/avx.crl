#[[no_drop_all]]
import(lib) wallvm::target::x86_64_base { X86_64Emitter };


pub void emitAvxVecAdd256(X86_64Emitter* emitter,
                          str dst, str src1,
                          str src2)
{
    emitter->emit("\tvpaddd ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecSub256(X86_64Emitter* emitter,
                          str dst, str src1,
                          str src2)
{
    emitter->emit("\tvpsubd ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecMul256(X86_64Emitter* emitter,
                          str dst, str src1,
                          str src2)
{
    emitter->emit("\tvpmulld ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecFAdd256(X86_64Emitter* emitter,
                           str dst, str src1,
                           str src2)
{
    emitter->emit("\tvaddps ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

