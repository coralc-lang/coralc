    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecFMul256(X86_64Emitter* emitter,
                           str dst, str src1,
                           str src2)
{
    emitter->emit("\tvmulps ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
