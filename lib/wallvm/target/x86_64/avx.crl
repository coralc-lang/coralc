pub void emitAvx512VecAdd512Masked(X86_64Emitter* emitter,
                                   str dst, str src1,
                                   str src2, str mask)
{
    if (emitter->features != null && emitter->features->avx512f)
    {
        emitter->emit("\tvpaddd ");
        emitter->emit(src2);
        emitter->emit(", ");
        emitter->emit(src1);
        emitter->emit(dst);
        emitter->emit(" {");
        emitter->emit(mask);
        emitter->emitLine("}");
    }
}

pub void emitFma(X86_64Emitter* emitter,
                 str dst, str src1,
                 str src2, str src3)
{
    if (emitter->features != null && emitter->features->fma)
    {
        emitter->emit("\tvfmadd231ss ");
        emitter->emit(src2);
        emitter->emit(", ");
        emitter->emit(src1);
        emitter->emit(", ");
        emitter->emitLine(dst);
    }
}

pub void emitFma256(X86_64Emitter* emitter,
                    str dst, str src1,
                    str src2, str src3)
{
    if (emitter->features != null && emitter->features->fma)
    {
        emitter->emit("\tvfmadd231ps ");
        emitter->emit(src2);
        emitter->emit(", ");
        emitter->emit(src1);
        emitter->emit(", ");
        emitter->emitLine(dst);
    }
}
