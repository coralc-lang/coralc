}

pub void emitAvxVecFDiv256(X86_64Emitter* emitter,
                           str dst, str src1,
                           str src2)
{
    emitter->emit("\tvdivps ");
    emitter->emit(src2);
    emitter->emit(", ");
    emitter->emit(src1);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecBroadcast256(X86_64Emitter* emitter, str dst, str src)
{
    emitter->emit("\tvbroadcastss ");
    emitter->emit(src);
    emitter->emit(", ");
    emitter->emitLine(dst);
}

pub void emitAvxVecGather256(X86_64Emitter* emitter,
                             str dst, str base,
                             str indices, u32 scale)
{
    emitter->emit("\tvpgatherdd ");
    emitter->emit(indices);
    emitter->emit(", (");
    emitter->emit(base);
    emitter->emit("), ");
    emitter->emit(dst);
    emitter->emit(", $");
    emitter->emitU32(scale);
    emitter->emitLine("");
}

pub void emitAvx512VecAdd512(X86_64Emitter* emitter,
                             str dst, str src1,
                             str src2)
{
    if (emitter->features != null && emitter->features->avx512f)
    {
        emitter->emit("\tvpaddd ");
        emitter->emit(src2);
        emitter->emit(", ");
        emitter->emit(src1);
        emitter->emit(", ");
        emitter->emitLine(dst);
    }
}

