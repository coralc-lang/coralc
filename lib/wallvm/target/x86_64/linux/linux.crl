#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock };
import(lib) wallvm::target::x86_64_base { X86_64CodeGen, CpuFeatures, ElfMetadata, defaultCpuFeatures, defaultFuncMeta };

pub bool irLinux_X86_64(IrModule* modd, rawptr userdata, bool useAtt)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || modd == null) return false;

    X86_64CodeGen codegen;
    CpuFeatures features = defaultCpuFeatures();
    features.sse = true;
    features.sse2 = true;
    features.sse3 = true;
    features.ssse3 = true;
    features.sse41 = true;
    features.sse42 = true;
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, false, useAtt, &features);

    codegen.emitElfPrologue();

    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null) continue;
        if (func->isExtern) continue;

        ElfMetadata meta = defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb->base.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb->ninsts; ii++)
                codegen.emitInst(bb->insts[ii]);
        }
    }

    return true;
}

pub str irLinux_X86_64Asm(IrModule* modd, rawptr userdata, bool useAtt)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || modd == null) return str::empty();

    X86_64CodeGen codegen;
    CpuFeatures features = defaultCpuFeatures();
    features.sse = true;
    features.sse2 = true;
    features.sse3 = true;
    features.ssse3 = true;
    features.sse41 = true;
    features.sse42 = true;
    features.avx = true;
    features.avx2 = true;
    features.fma = true;
    features.bmi1 = true;
    features.bmi2 = true;
    features.popcnt = true;
    features.lzcnt = true;
    codegen.init(ctx, modd, false, useAtt, &features);

    codegen.emitElfPrologue();

    for (u32 fi = 0; fi < modd->nfuncs; fi++)
    {
        IrFunc* func = modd->funcs[fi];
        if (func == null) continue;
        if (func->isExtern) continue;

        ElfMetadata meta = defaultFuncMeta();
        codegen.emitPrologue(func, &meta);

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            codegen.emitDeferredCalleeSaves(bb);
            codegen.emitter.emit(".L");
            codegen.emitter.emit(bb->base.name);
            codegen.emitter.emitLine(":");

            for (u32 ii = 0; ii < bb->ninsts; ii++)
                codegen.emitInst(bb->insts[ii]);
        }
    }

    return codegen.emitter.getOutput();
}
