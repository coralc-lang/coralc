#[[no_drop_all]]
// Register names the allocator must never see in a vreg: the frame and
// stack pointer, plus every register this backend needs as scratch for its
// own instruction sequences (VecDiv/Abs/Fcvt walk through r10 and r11,
// spill reloads use xmm0/xmm1/xmm15, shift counts dance through rcx with
// %r11 as the save, and call marshalling's cycle-breaker is r10).
// lsra filters these out of its allocatable set
// via RegAllocConfig.reservedIntRegs/reservedFloatRegs, so the two lists
// below must contain exactly the registers the emitter treats as scratch.
// The platform drivers all come through this one shared base while the
// ports are in flight, and once everything is verified and tested we split them
// apart for good, each platform taking its own copy, so nothing carries
// a pile of if comparisons along the way to ask which platform it is.
pub str[] X86_64_RESERVED_INT = {
    "rsp", "rbp", "rax", "rcx", "rdx", "r10", "r11"
};

pub str[] X86_64_RESERVED_FLOAT = {
    "xmm0", "xmm1", "xmm15"
};

// The allocatable set lsra hands out, in exactly lsra's order:
// caller-save minus the reserved scratch set, then callee-save minus
// the same reserved set (lsra.crl buildRegAlloc: caller-save entries
// first, then callee-save entries, skipping reserved).
//
// SysV caller (rax,rcx,rdx,rsi,rdi,r8,r9,r10,r11) minus reserved
// leaves rsi,rdi,r8,r9; callee (rbx,rbp,r12,r13,r14,r15) minus rbp
// leaves rbx,r12,r13,r14,r15. Win64 caller (rax,rcx,rdx,r8,r9,r10,r11)
// leaves r8,r9; callee (rbx,rbp,rdi,rsi,r12,r13,r14,r15) minus rbp
// leaves rbx,rdi,rsi,r12,r13,r14,r15. Both lists are spelled out
// separately below and picked by `intRegNameFor`, rather than letting
// the two drift apart again.
pub str[] X86_64_INT_REGS = {
    "rsi", "rdi", "r8", "r9", "rbx", "r12", "r13", "r14", "r15"
};

pub str[] X86_64_INT_REGS_WIN64 = {
    "r8", "r9", "rbx", "rdi", "rsi", "r12", "r13", "r14", "r15"
};

pub str[] X86_64_FLOAT_REGS = {
    "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"
};

import wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType, IrTypeKind, IrStringConst, IrGlobal, IrArrayConst, IrStructConst };
import wallvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred };
import wallvm::irMetadata { funcIsEntry, funcIsNaked, hasFuncAttr, funcAttrInt };
import wallvm::assembly::x86::common { lookupReg };
import std::string { String };
import std::mman { alloc, dealloc };
import std::ios { eprintln };
import wallvm::assembly::common { parseConstraints, AsmConstraint, AsmConClass, AsmParseError };


pub struct CpuFeatures
{
    bool sse;
    bool sse2;
    bool sse3;
    bool ssse3;
    bool sse41;
    bool sse42;
    bool avx;
    bool avx2;
    bool avx512f;
    bool fma;
    bool bmi1;
    bool bmi2;
    bool popcnt;
    bool lzcnt;
}

pub CpuFeatures defaultCpuFeatures()
{
    return CpuFeatures {
        .sse = true, .sse2 = true, .sse3 = false, .ssse3 = false,
        .sse41 = false, .sse42 = false, .avx = false, .avx2 = false,
        .avx512f = false, .fma = false, .bmi1 = false, .bmi2 = false,
        .popcnt = false, .lzcnt = false
    };
}

pub struct ElfMetadata
{
    str section;
    bool isGlobal;
}

pub ElfMetadata defaultFuncMeta()
{
    return ElfMetadata { .section = ".text", .isGlobal = true };
}

pub struct X86_64Emitter
{
    IrContext* ctx;
    IrModule* modd;
    CpuFeatures* features;
    bool useAtt;
    String output;
    String dataSection;
    String attOutput;
    u32 labelCounter;
    bool fabMaskDNeeded;
    bool fabMaskSNeeded;
    bool uiToOneNeeded;
    bool dataFlushed;

    void init(IrContext* ctx,
              IrModule* modd,
              bool useAtt, CpuFeatures* feats)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.features = feats;
        self.useAtt = useAtt;
        self.output = String::new();
        self.dataSection = String::new();
        self.attOutput = String::new();
        self.labelCounter = 0;
        self.fabMaskDNeeded = false;
        self.fabMaskSNeeded = false;
        self.uiToOneNeeded = false;
        self.dataFlushed = false;
    }

    u32 nextLabel()
    {
        return self.labelCounter++;
    }

    void emit(str s)
    {
        if (s.ptr == null) return;
        self.output.pushView(s);
    }

    void emitLine(str strv)
    {
        self.emit(strv);
        self.emit("\n");
    }

    void emitTab(str instrv)
    {
        self.emit("\t");
        self.emitLine(instrv);
    }

    void emitComment(str comment)
    {
        self.emit("\t# ");
        self.emitLine(comment);
    }

    void emitData(str s)
    {
        if (s.ptr == null) return;
        self.dataSection.pushView(s);
    }

    void emitDataLine(str strv)
    {
        self.emitData(strv);
        self.emitData("\n");
    }

    // deferred constants: requested during instruction emission, written
    // once at the end of getOutput so the .data switch cannot capture
    // instruction text (and repeated uses cannot redefine the label)
    void needFabsMask(bool isDouble)
    {
        if (isDouble) self.fabMaskDNeeded = true;
        else self.fabMaskSNeeded = true;
    }

    void needUiToOne()
    {
        self.uiToOneNeeded = true;
    }

    void emitU32(u32 val)
    {
        if (val == 0) { self.output.pushChar('0'); return; }
        u8[16] buf;
        u32 n = 0;
        while (val > 0) { buf[n++] = (u8)('0' + (val % 10)); val /= 10; }
        while (n > 0) { n--; self.output.pushChar(buf[n]); }
    }

    str getOutput()
    {
        if (!self.dataFlushed)
        {
            self.dataFlushed = true;
            if (self.fabMaskDNeeded || self.fabMaskSNeeded || self.uiToOneNeeded)
            {
                // after the function stream (and the globals/string pool):
                // switching to .data here cannot capture any instruction text
                self.emitLine(".section .data");
                if (self.fabMaskDNeeded)
                    self.emitLine(".Lfabs_mask_d:\n\t.quad 0x7fffffffffffffff, 0");
                if (self.fabMaskSNeeded)
                    self.emitLine(".Lfabs_mask_s:\n\t.long 0x7fffffff, 0, 0, 0");
                if (self.uiToOneNeeded)
                {
                    // 1.0 as bit patterns: the in-repo assembler has no
                    // .double/.float directive
                    self.emitLine(".Lui_to_fp_one_d:\n\t.quad 0x3ff0000000000000");
                    self.emitLine(".Lui_to_fp_one_s:\n\t.long 0x3f800000");
                }
            }
        }
        if (!self.useAtt) return self.output.asView();
        str src = self.output.asView();
        self.attOutput = String::withCap(src.len + src.len / 4 + 16);
        usize i = 0;
        while (i < src.len)
        {
            u8 c = (u8)src[i];
            if (c == (u8)'#' || c == (u8)';')
            {
                usize start = i;
                while (i < src.len && (u8)src[i] != (u8)'\n') i++;
                if (i < src.len) i++;
                self.attOutput.pushView(str::fromParts(src.ptr + start, i - start));
                continue;
            }
            if (c == (u8)'%')
            {
                usize start = i;
                i++;
                while (i < src.len && regNamePart((u8)src[i])) i++;
                self.attOutput.pushView(str::fromParts(src.ptr + start, i - start));
                continue;
            }
            if (regNameStart(c))
            {
                usize start = i;
                i++;
                while (i < src.len && regNamePart((u8)src[i])) i++;
                str tok = str::fromParts(src.ptr + start, i - start);
                if (lookupReg(tok) != null) self.attOutput.pushChar('%');
                self.attOutput.pushView(tok);
                continue;
            }
            self.attOutput.pushChar(c);
            i++;
        }
        return self.attOutput.asView();
    }
}

static String[16] _textBuf;
static u32 _textI = 0;

static String* textBufNext()
{
    String* b = &_textBuf[_textI++ & 15];
    if (b->ptr == null) *b = String::withCap(64);
    b->clear();
    return b;
}

str u32ToStr(u32 val)
{
    String* b = textBufNext();
    if (val == 0) { b->pushChar('0'); return b->asView(); }
    u8[16] tmp;
    u32 n = 0;
    while (val > 0) { tmp[n++] = (u8)('0' + (val % 10)); val /= 10; }
    while (n > 0) { n--; b->pushChar(tmp[n]); }
    return b->asView();
}

// Full-width immediates print as hex: every u64 fits in 16 digits and
// gas never balks at a 0x-prefixed value the way it can at an
// out-of-range unsigned decimal.
str u64ToHex(u64 val)
{
    String* b = textBufNext();
    b->pushView("0x");
    for (u32 i = 0; i < 16; i++)
    {
        u32 sh = (u32)((15u - i) * 4u);
        u32 nib = ((u32)(val >> (u64)sh)) & 0xFu;
        b->pushChar(nib < 10 ? (u8)('0' + nib) : (u8)('a' + (nib - 10)));
    }
    return b->asView();
}

bool valueIsIntConst(IrValue* v)
{
    return v != null && v->kind == IrValueKind::ConstInt;
}

str intImmText(IrValue* v)
{
    String* b = textBufNext();
    b->pushChar('$');
    b->pushView(u64ToHex(v->valData));
    return b->asView();
}

str i64ToDec(i64 v)
{
    String* b = textBufNext();
    if (v < 0)
    {
        b->pushChar('-');
        u64 mag = (u64)(-(v + 1)) + 1;
        u8[24] tmp;
        u32 n = 0;
        while (mag > 0) { tmp[n++] = (u8)('0' + (mag % 10)); mag /= 10; }
        if (n == 0) b->pushChar('0');
        while (n > 0) { n--; b->pushChar(tmp[n]); }
        return b->asView();
    }
    u64 mag = (u64)v;
    u8[24] tmp;
    u32 n = 0;
    while (mag > 0) { tmp[n++] = (u8)('0' + (mag % 10)); mag /= 10; }
    if (n == 0) b->pushChar('0');
    while (n > 0) { n--; b->pushChar(tmp[n]); }
    return b->asView();
}

str i64ToHex(i64 v)
{
    String* b = textBufNext();
    if (v < 0)
    {
        b->pushChar('-');
        u64 mag = (u64)(-(v + 1)) + 1;
        b->pushView(u64ToHex(mag));
        return b->asView();
    }
    b->pushView(u64ToHex((u64)v));
    return b->asView();
}

bool regNameStart(u8 c)
{
    return (c >= (u8)'a' && c <= (u8)'z') ||
           (c >= (u8)'A' && c <= (u8)'Z') || c == (u8)'_';
}

bool regNamePart(u8 c)
{
    return regNameStart(c) || (c >= (u8)'0' && c <= (u8)'9');
}

// Parameter-seeding staging slot address: "0(%rsp)", "8(%rsp)", ...
str stageText(u32 off)
{
    String* b = textBufNext();
    b->pushView(u32ToStr(off));
    b->pushView("(%rsp)");
    return b->asView();
}

// Scratch-window address below rsp: "-32(%rsp)", "-48(%rsp)", ...
str rspSlotText(u32 disp)
{
    String* b = textBufNext();
    b->pushChar('-');
    b->pushView(u32ToStr(disp));
    b->pushView("(%rsp)");
    return b->asView();
}

// Indexed window address: "-16(%rsp, r10, 4)"
str sibText(u32 disp, str idxReg, u32 scale)
{
    String* b = textBufNext();
    b->pushChar('-');
    b->pushView(u32ToStr(disp));
    b->pushView("(rsp, ");
    b->pushView(idxReg);
    b->pushView(", ");
    b->pushView(u32ToStr(scale));
    b->pushChar(')');
    return b->asView();
}

static String[16] _r32buf;
static u32 _r32i = 0;

// True for the r8-r15 family: 'r' followed by one or two digits. Only
// these get a d/w/b suffix appended by toReg32/16/8; memory operands
// ("-32(%rbp)") and already-sized names ("esi") pass through untouched.
bool isRnReg(str r)
{
    if (r.len < 2 || r.len > 3) return false;
    if (r.ptr[0] != 'r') return false;
    for (usize i = 1; i < r.len; i++)
        if (r.ptr[i] < '0' || r.ptr[i] > '9') return false;
    return true;
}

str toReg32(str r)
{
    String* b = &_r32buf[_r32i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar('e');
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('d');
        return b->asView();
    }
    return r;
}

static String[16] _r16buf;
static u32 _r16i = 0;

str toReg16(str r)
{
    String* b = &_r16buf[_r16i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('w');
        return b->asView();
    }
    return r;
}

// Strip the 32-bit suffix from an opcode and append w/b for narrow work.
str narrowOp(str lOp, u32 width)
{
    if (width == 32) return lOp;
    String* b = textBufNext();
    b->pushView(str::fromParts(lOp.ptr, lOp.len - 1));
    b->pushChar(width == 16 ? 'w' : 'b');
    return b->asView();
}

// predicate ordinals run 0..9, a name table beats a ten-arm switch
static str[10] SETCC_INT = {
    "sete", "setne", "setl", "setle", "setg", "setge", "setb", "setbe", "seta", "setae"
};
// branch forms of the same predicates: TRUE jumps when the condition
// holds, FALSE when it does not — emitCondBr fuses an icmp that only
// feeds it into `cmp` + one of these, skipping the setcc/movzx/testq
// materialization the bool would otherwise take
static str[10] JCC_INT_TRUE = {
    "je", "jne", "jl", "jle", "jg", "jge", "jb", "jbe", "ja", "jae"
};

static str[10] JCC_INT_FALSE = {
    "jne", "je", "jge", "jg", "jle", "jl", "jae", "ja", "jbe", "jb"
};

static String[16] _r8buf;
static u32 _r8i = 0;

str toReg8(str r)
{
    if (r.equals("rax")) return "al";
    if (r.equals("rbx")) return "bl";
    if (r.equals("rcx")) return "cl";
    if (r.equals("rdx")) return "dl";
    String* b = &_r8buf[_r8i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar('l');
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        b->pushChar('l');
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('b');
        return b->asView();
    }
    return r;
}

pub struct X86_64CodeGen
{
    IrContext* ctx;
    IrModule* modd;
    X86_64Emitter emitter;
    bool isWindows;
    bool currentFuncHasFrame;
    bool useRedZone;
    bool[16] savedCalleeSaves;
    u32 numCalleeSaves;
    u32 redZoneSpillOffset;
    str lastCallTarget;
    IrValue* lastCallResult;
    IrInst* tailJmpCall;   // the call that already emitted a tail jmp, its Ret emits nothing
    bool omitFramePointer;
    u32 varargAllocSize;
    u32 shadowAllocSize;
    bool calleeSavesPushed;
    u32 shrinkWrapFirstUseBlock;
    bool hasDeferredFrame;
    u32 spillSlotCount;
    u32 spillFrameBytes;
    bool spillRbpPushed;
    IrFunc* currentFunc;
    u32 allocaBase;
    u32 allocaBytes;
    str[16] asmTaken;
    u32 asmTakenN;

    // Param-seeding plan: classification runs once into these records
    // and both emission walks replay them, so the stage and commit
    // phases can agree on skip decisions and on staging layout. The
    // capacity far exceeds any real signature.
    u32[128] sdKind;
    u32[128] sdReg;
    u32[128] sdOff;
    u32[128] sdWords;
    u32[128] sdSlot;
    bool[128] sdSkip;
    IrValue*[128] sdSrc;
    IrValue*[128] sdDst;
    u32 nSeedsPlanned;
    u32 sdStageBytes;

    void init(IrContext* ctx,
              IrModule* modd,
              bool isWindows, bool useAtt,
              CpuFeatures* feats)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.isWindows = isWindows;
        self.omitFramePointer = true;
        self.currentFunc = null;
        self.allocaBase = 0;
        self.allocaBytes = 0;
        self.emitter.init(ctx, modd, useAtt, feats);
    }

    static bool isCalleeSaved(str reg, bool isWin)
    {
        if (reg.equals("rbx")) return true;
        if (reg.equals("rbp")) return true;
        if (reg.equals("r12")) return true;
        if (reg.equals("r13")) return true;
        if (reg.equals("r14")) return true;
        if (reg.equals("r15")) return true;
        if (isWin)
        {
            if (reg.equals("rdi")) return true;
            if (reg.equals("rsi")) return true;
        }
        return false;
    }

    str intRegNameFor(u32 reg)
    {
        if (self.isWindows)
        {
            if (reg < 9) return X86_64_INT_REGS_WIN64[reg];
            return "";
        }
        if (reg < 9) return X86_64_INT_REGS[reg];
        return "";
    }

    // Register name for a non-spilled value, slot text for a spill,
    // empty string only for out-of-range. Emission sites must go
    // through opFor/opForReg/opForRegF instead of reading this.
    str getRegName(IrValue* val)
    {
        if (val == null) return "rax";
        // Args get their valData rewritten to the encoded reg exactly like
        // Inst results — rejecting them here hid every param's register
        // from funcUsesReg/blockUsesReg, so a callee-save home assigned to
        // a parameter was never pushed/popped.
        if (val->kind != IrValueKind::Inst && val->kind != IrValueKind::Arg) return "";
        u64 vd = val->valData;
        if (vd & 0x80000000UL)
            return "";
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        return self.intRegNameFor(reg);
    }

    bool funcUsesReg(IrFunc* func, str reg)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                str dst = self.getRegName(&inst->base);
                if (dst.equals(reg)) return true;
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    str op = self.getRegName(inst->ops[oi]);
                    if (op.equals(reg)) return true;
                }
            }
        }
        return false;
    }

    bool blockUsesReg(IrBlock* bb, str reg)
    {
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            str dst = self.getRegName(&inst->base);
            if (dst.equals(reg)) return true;
            for (u32 oi = 0; oi < inst->nops; oi++)
            {
                str op = self.getRegName(inst->ops[oi]);
                if (op.equals(reg)) return true;
            }
        }
        return false;
    }

    void emitPushCalleeSave(str reg)
    {
        if (self.emitter.useAtt)
        {
            self.emitter.emit("\tpushq %");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
        else
        {
            self.emitter.emit("\tpush ");
            self.emitter.emit(reg);
            self.emitter.emit("\n");
        }
    }

    void emitDeferredCalleeSaves(IrBlock* bb)
    {
        if (self.calleeSavesPushed) return;

        str[8] calleeSaveRegs;
        u32 nCSaveRegs;
        if (self.isWindows)
        {
            calleeSaveRegs = {"rbx", "rdi", "rsi", "r12", "r13", "r14", "r15", "rbp"};
            nCSaveRegs = 8;
        }
        else
        {
            calleeSaveRegs = {"rbx", "r12", "r13", "r14", "r15", "rbp"};
            nCSaveRegs = 6;
        }
        bool needed = false;
        for (u32 i = 0; i < nCSaveRegs; i++)
        {
            if (self.savedCalleeSaves[i])
            {
                if (self.blockUsesReg(bb, calleeSaveRegs[i]))
                {
                    needed = true;
                    break;
                }
            }
        }

        if (!needed) return;

        self.calleeSavesPushed = true;
        for (u32 i = 0; i < nCSaveRegs; i++)
        {
            if (self.savedCalleeSaves[i])
                self.emitPushCalleeSave(calleeSaveRegs[i]);
        }

        if (self.hasDeferredFrame)
        {
            self.hasDeferredFrame = false;
            self.currentFuncHasFrame = true;
            if (self.emitter.useAtt)
            {
                self.emitter.emitTab("pushq %rbp");
                self.emitter.emitTab("movq %rsp, %rbp");
            }
            else
            {
                self.emitter.emitTab("push rbp");
                self.emitter.emitTab("mov rbp, rsp");
            }
        }
    }

    void emitElfPrologue()
    {
        self.emitter.emitLine(".section .text");
    }

    /* module string constants: one NUL-terminated record per unique
     * literal in a mergeable strings section ("aM" = SHF_MERGE +
     * SHF_STRINGS), so both GAS and the linker can fold equal payloads
     * and the terminator is part of the record the merge key includes */
    void emitConstStrings()
    {
        if (self.modd == null || self.modd->nconstStrings == 0) return;
        // mergeable, read-only, string-sized records: the linker folds
        // identical ones. PE/COFF spells the same idea as .rdata.
        if (self.isWindows)
            self.emitter.emitLine(".section .rdata,\"dr\"");
        else
            self.emitter.emitLine(".section .rodata.str1.1,\"aM\",@progbits,1");
        for (u32 i = 0; i < self.modd->nconstStrings; i++)
        {
            IrStringConst* sc = self.modd->constStrings[i];
            if (sc == null) continue;
            str lbl = self.stringLabel(&sc->base);
            if (lbl.len == 0) continue;
            self.emitter.emit(lbl);
            self.emitter.emitLine(":");
            // one .asciz per string, gas-style: printable ASCII runs
            // literal, quote/backslash escape, everything else exactly
            // three octal digits (unambiguous for gas and our lexer)
            self.emitter.emit("\t.asciz \"");
            for (u32 j = 0; j < sc->length; j++)
            {
                u8 c = sc->data[j];
                if (c == (u8)'"') self.emitter.emit("\\\"");
                else if (c == (u8)'\\') self.emitter.emit("\\\\");
                else if (c >= 0x20 && c < 0x7F)
                {
                    u8[1] piece;
                    piece[0] = c;
                    self.emitter.emit(str::fromParts((const u8*)piece, 1));
                }
                else
                {
                    u8[4] esc;
                    esc[0] = (u8)'\\';
                    esc[1] = (u8)('0' + ((c >> 6) & 7));
                    esc[2] = (u8)('0' + ((c >> 3) & 7));
                    esc[3] = (u8)('0' + (c & 7));
                    self.emitter.emit(str::fromParts((const u8*)esc, 4));
                }
            }
            self.emitter.emitLine("\"");
        }
    }

    /* file-scope variables: one record per defined global, initialised
     * from its IR constant or zero-filled. Emitted after the function
     * stream (like the string pool) so the section switch cannot capture
     * any instruction text, and read back through the same rip-relative
     * folding a literal's address gets. */
    void emitGlobals()
    {
        if (self.modd == null || self.modd->nglobals == 0) return;
        bool started = false;
        u32 i = 0;
        while (i < self.modd->nglobals)
        {
            IrGlobal* g = self.modd->globals[i];
            i++;
            if (g == null || g->isExtern) continue;
            if (!started)
            {
                self.emitter.emitLine(".section .data");
                started = true;
            }
            IrType* dt = g->base.type;
            if (dt != null && dt->kind == IrTypeKind::Ptr && dt->elem != null) dt = dt->elem;
            u32 size = dt != null ? self.ctx->irTypeSizeOf(dt) : 8;
            u32 align = g->alignment != 0 ? g->alignment
                       : (dt != null ? self.ctx->irTypeAlignOf(dt) : 8);
            if (align == 0) align = 1;
            if (align > 64) align = 8;
            self.emitter.emit("\t.balign ");
            self.emitter.emitLine(u32ToStr(align));
            self.emitter.emit(g->base.name);
            self.emitter.emitLine(":");
            self.emitGlobalInit(g->initVal, size);
        }
    }

    /* one global's bytes: a scalar, an aggregate folded at compile
     * time, a byte array, or (when nothing represents it) zero fill */
    void emitGlobalInit(IrValue* iv, u32 size)
    {
        if (iv == null)
        {
            self.emitter.emit("\t.zero ");
            self.emitter.emitLine(u32ToStr(size));
            return;
        }
        if (iv->kind == IrValueKind::StructConst)
        {
            self.emitStructConstData(iv, size);
            return;
        }
        if (iv->kind == IrValueKind::ConstInt)
        {
            self.emitScalarConst(iv, size);
            return;
        }
        if (iv->kind == IrValueKind::ConstFloat)
        {
            if (size == 4)
            {
                /* the constant carries f64 bits: narrow to f32 first */
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&iv->valData, 8);
                f32 f = (f32)d;
                u32 bits = 0;
                copy<u8>((u8*)&bits, (u8*)&f, 4);
                self.emitter.emit("\t.long ");
                self.emitter.emitLine(u64ToHex((u64)bits));
            }
            else
            {
                self.emitter.emit("\t.quad ");
                self.emitter.emitLine(u64ToHex(iv->valData));
            }
            return;
        }
        if (iv->kind == IrValueKind::ConstArray)
        {
            IrArrayConst* ac = (IrArrayConst*)iv;
            IrType* et = iv->type != null ? iv->type->elem : null;
            u32 esz = et != null ? self.ctx->irTypeSizeOf(et) : 1;
            if (esz == 1)
            {
                u32 j = 0;
                while (j < ac->nelems)
                {
                    self.emitter.emit("\t.byte ");
                    u32 row = 0;
                    while (j < ac->nelems && row < 16)
                    {
                        u64 b = 0;
                        if (ac->elems[j] != null && ac->elems[j]->kind == IrValueKind::ConstInt)
                            b = ac->elems[j]->valData & 0xFFUL;
                        if (row > 0) self.emitter.emit(", ");
                        self.emitter.emit(u64ToHex(b));
                        j++;
                        row++;
                    }
                    self.emitter.emitLine("");
                }
                if (size > ac->nelems)
                {
                    self.emitter.emit("\t.zero ");
                    self.emitter.emitLine(u32ToStr(size - ac->nelems));
                }
                return;
            }
            /* multi-byte elements: one directive per element */
            for (u32 j = 0; j < ac->nelems; j++)
            {
                IrValue* ev = ac->elems[j];
                u64 b = 0;
                if (ev != null && ev->kind == IrValueKind::ConstInt) b = ev->valData;
                if (esz == 2) { self.emitter.emit("\t.short "); self.emitter.emitLine(u64ToHex(b & 0xFFFFUL)); }
                else if (esz == 4) { self.emitter.emit("\t.long "); self.emitter.emitLine(u64ToHex(b & 0xFFFFFFFFUL)); }
                else { self.emitter.emit("\t.quad "); self.emitter.emitLine(u64ToHex(b)); }
            }
            if (size > ac->nelems * esz)
            {
                self.emitter.emit("\t.zero ");
                self.emitter.emitLine(u32ToStr(size - ac->nelems * esz));
            }
            return;
        }
        // a symbol initializer stores the address itself — same as
        // emitScalarConst's tail (fixups resolve `= @other` into an
        // IrGlobal/Func/StringConst value)
        if (iv->kind == IrValueKind::Func ||
            iv->kind == IrValueKind::Global ||
            iv->kind == IrValueKind::StringConst)
        {
            str lbl = iv->kind == IrValueKind::StringConst
                ? self.stringLabel(iv) : iv->name;
            if (lbl.len == 0)
            {
                self.emitter.emit("\t.zero ");
                self.emitter.emitLine(u32ToStr(size));
                return;
            }
            self.emitter.emit("\t.quad ");
            self.emitter.emitLine(lbl);
            return;
        }
        self.emitter.emit("\t.zero ");
        self.emitter.emitLine(u32ToStr(size));
    }

    /* an integer scalar at `size` bytes: the directive and the masked
     * value, nothing else */
    void emitScalarConst(IrValue* iv, u32 size)
    {
        u64 v = iv->valData;
        str txt;
        if (size <= 1)
        {
            self.emitter.emit("\t.byte ");
            txt = u64ToHex(v & 0xFFUL);
        }
        else if (size == 2)
        {
            self.emitter.emit("\t.short ");
            txt = u64ToHex(v & 0xFFFFUL);
        }
        else if (size == 4)
        {
            self.emitter.emit("\t.long ");
            txt = u64ToHex(v & 0xFFFFFFFFUL);
        }
        else if (size == 8)
        {
            self.emitter.emit("\t.quad ");
            txt = u64ToHex(v);
        }
        else
        {
            self.emitter.emit("\t.zero ");
            txt = u32ToStr(size);
        }
        self.emitter.emitLine(txt);
    }

    /* a struct constant: each field placed at its aligned offset the
     * same way gepConstOffset walks them, then the tail zero-filled.
     * A function, global or literal address stores as one quad (the
     * linker resolves the symbol), which is exactly what a vtable or
     * allocator slot needs. */
    void emitStructConstData(IrValue* iv, u32 size)
    {
        IrStructConst* sc = (IrStructConst*)iv;
        IrType* st = iv->type;
        u32 off = 0;
        u32 i = 0;
        while (i < sc->nelems && st != null && i < st->nparams)
        {
            IrValue* fv = sc->elems[i];
            IrType* ft = st->params[i];
            if (ft == null) { i++; continue; }
            u32 fal = self.ctx.irTypeAlignOf(ft);
            if (fal == 0) fal = 1;
            u32 fsz = self.ctx.irTypeSizeOf(ft);
            if ((off % fal) != 0)
            {
                u32 pad = fal - (off % fal);
                self.emitter.emit("\t.zero ");
                self.emitter.emitLine(u32ToStr(pad));
                off += pad;
            }
            self.emitGlobalConstValue(fv, ft, fsz);
            off += fsz;
            i++;
        }
        if (size > off)
        {
            self.emitter.emit("\t.zero ");
            self.emitter.emitLine(u32ToStr(size - off));
        }
    }

    /* one entry of a folded aggregate: a scalar, another aggregate, a
     * byte array, or an address the linker resolves */
    void emitGlobalConstValue(IrValue* fv, IrType* ft, u32 fsz)
    {
        if (fv == null)
        {
            self.emitter.emit("\t.zero ");
            self.emitter.emitLine(u32ToStr(fsz));
            return;
        }
        if (fv->kind == IrValueKind::ConstInt) { self.emitScalarConst(fv, fsz); return; }
        if (fv->kind == IrValueKind::ConstFloat)
        {
            if (fsz == 4)
            {
                f64 d = 0;
                copy<u8>((u8*)&d, (u8*)&fv->valData, 8);
                f32 f = (f32)d;
                u32 bits = 0;
                copy<u8>((u8*)&bits, (u8*)&f, 4);
                self.emitter.emit("\t.long ");
                self.emitter.emitLine(u64ToHex((u64)bits));
            }
            else
            {
                self.emitter.emit("\t.quad ");
                self.emitter.emitLine(u64ToHex(fv->valData));
            }
            return;
        }
        if (fv->kind == IrValueKind::StructConst) { self.emitStructConstData(fv, fsz); return; }
        if (fv->kind == IrValueKind::ConstArray) { self.emitGlobalInit(fv, fsz); return; }
        if (fv->kind == IrValueKind::Func ||
            fv->kind == IrValueKind::Global ||
            fv->kind == IrValueKind::StringConst)
        {
            str lbl = fv->kind == IrValueKind::StringConst
                ? self.stringLabel(fv) : fv->name;
            if (lbl.len == 0)
            {
                self.emitter.emit("\t.zero ");
                self.emitter.emitLine(u32ToStr(fsz));
                return;
            }
            self.emitter.emit("\t.quad ");
            self.emitter.emitLine(lbl);
            return;
        }
        self.emitter.emit("\t.zero ");
        self.emitter.emitLine(u32ToStr(fsz));
    }

    // One alloca's frame footprint. The allocated type is compile-time
    // known (the instruction carries no count operand), so the size is
    // static and the whole region can be reserved in the prologue.
    // Rounded to 16 so the reservation cannot disturb the frame's
    // 16-byte alignment.
    u32 allocaSlotSize(IrInst* inst)
    {
        u32 sz = 0;
        if (inst->base.type != null)
        {
            // a pointer alloca sizes to its element; an aggregate alloca
            // (one whose result IS the value's address) sizes to itself
            IrType* at = inst->base.type;
            IrType* st = (at->kind == IrTypeKind::Ptr && at->elem != null) ? at->elem : at;
            sz = self.ctx->irTypeSizeOf(st);
        }
        if (sz == 0) sz = 16;
        if ((sz % 16) != 0) sz = (sz / 16 + 1) * 16;
        return sz;
    }

    // The prologue's total alloca reservation: scanAllocas and
    // allocaSlotOf replay the same walk, so the lea each emitAlloca
    // emits always lands inside the frame the prologue cut out.
    u32 scanAllocas(IrFunc* func)
    {
        u32 total = 0;
        if (func == null) return 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Alloca)
                    total += self.allocaSlotSize(inst);
            }
        }
        return total;
    }

    // The rbp-relative offset of one alloca: walk the same sequence
    // scanAllocas summed, stop at the wanted value, and add the base
    // the reservation started from. No side table, so there is nothing
    // to keep alive across emitRet's mid-function epilogue.
    bool allocaSlotOf(IrFunc* func, IrValue* target, u32* outOff)
    {
        u32 cum = 0;
        if (func == null || target == null) return false;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode != IrOpcode::Alloca) continue;
                cum += self.allocaSlotSize(inst);
                if (&inst->base == target)
                {
                    // the saved callee saves sit between rbp and the
                    // region the prologue subtracted, so the slot's
                    // rbp-relative offset starts past them
                    *outOff = 8 * self.numCalleeSaves + self.allocaBase + cum;
                    return true;
                }
            }
        }
        return false;
    }

    // True when hasAny parameter can land on the stack: the banks are
    // counted exactly the way classifyCallArg assigns them, so an
    // integer word past the int bank or an fp word past the fp bank
    // ends up at 16(%rbp) and forces a frame. Called only for the
    // frame gates, so a false positive merely costs a frame.
    bool funcHasStackParams(IrFunc* func)
    {
        if (func == null || func->base.type == null) return false;
        IrType* ft = func->base.type;
        u32 maxInt = self.isWindows ? 4 : 6;
        u32 maxFp = self.isWindows ? 4 : 8;
        u32 intWords = 0;
        u32 fpWords = 0;
        for (u32 i = 0; i < ft->nparams; i++)
        {
            IrType* p = ft->params[i];
            if (p == null) continue;
            if (p->kind == IrTypeKind::Float || p->kind == IrTypeKind::Vector)
                fpWords += p->width > 64 ? 2 : 1;
            else if (p->kind == IrTypeKind::Struct)
                intWords += (p->width > 8 && p->width <= 16) ? 2 : 1;
            else
                intWords += 1;
        }
        return intWords > maxInt || fpWords > maxFp;
    }

    void emitPrologue(IrFunc* func, ElfMetadata* meta)
    {
        if (meta != null && meta->isGlobal)
        {
            if (self.isWindows)
            {
                self.emitter.emit("public ");
                self.emitter.emitLine(func->base.name);
            }
            else
            {
                self.emitter.emit(".globl ");
                self.emitter.emitLine(func->base.name);
            }
        }
        if (!self.isWindows)
        {
            self.emitter.emit(".type ");
            self.emitter.emit(func->base.name);
            self.emitter.emitLine(", @function");
        }

        self.emitter.emit(func->base.name);
        self.emitter.emitLine(":");

        // Bare-metal entry contract (docs/baremetal-attributes.md):
        // !entry aliases __coral_entry to this function's address;
        // !entry.addr = N emits the absolute __coral_entry_addr symbol.
        // The linker prefers these over its default entry selection.
        if (!self.isWindows)
        {
            if (funcIsEntry(func))
            {
                self.emitter.emit(".globl __coral_entry\n");
                self.emitter.emit(".set __coral_entry, ");
                self.emitter.emitLine(func->base.name);
            }
            if (hasFuncAttr(func, "entry.addr"))
            {
                self.emitter.emit(".globl __coral_entry_addr\n");
                self.emitter.emit(".set __coral_entry_addr, ");
                self.emitter.emitLine(u64ToHex((u64)funcAttrInt(func, "entry.addr", 0)));
            }
        }

        self.useRedZone = false;
        self.numCalleeSaves = 0;
        self.redZoneSpillOffset = 0;
        self.lastCallTarget = "";
        self.lastCallResult = null;
        self.tailJmpCall = null;
        self.varargAllocSize = 0;
        self.shadowAllocSize = 0;
        self.spillSlotCount = self.countSpillSlots(func);
        self.spillFrameBytes = self.spillSlotCount * 16;
        self.spillRbpPushed = false;
        self.currentFunc = func;
        self.allocaBase = 0;
        self.allocaBytes = self.scanAllocas(func);
        self.numCalleeSaves = 0;
        self.spillFrameBytes = 0;
        self.calleeSavesPushed = false;
        for (u32 si = 0; si < 16; si++)
            self.savedCalleeSaves[si] = false;

        // #[[naked]]: no prologue, no frame, no callee saves — the body
        // transfers control itself (docs/baremetal-attributes.md). The
        // spill/alloca scans above still ran, so a body that would need a
        // frame gets caught by the allocator/backend rather than silently
        // emitting rbp-relative accesses into raw code.
        if (funcIsNaked(func))
        {
            self.currentFuncHasFrame = false;
            self.varargAllocSize = 0;
            self.spillFrameBytes = 0;
            self.calleeSavesPushed = false;
            return;
        }

        bool isLeaf = func->isLeaf();
        bool isVararg = func->base.type != null && func->base.type->isVararg;
        bool hasStackParams = self.funcHasStackParams(func);

        if (isVararg)
            isLeaf = false;

        // Callee-save scan runs before ANY early return: every path that
        // writes a home in a callee-save register (param seeding included)
        // must push the caller's value first, so the red-zone and frame
        // gates below all consult usesAnyCalleeSave. The list is the
        // platform's callee set; on Windows rdi/rsi are callee-save too
        // (WIN64_CALLEE_SAVE), and rbp is listed for symmetry even though
        // lsra never assigns it (reserved) — the frame's pushq %rbp covers
        // it whenever a frame exists.
        str[8] calleeSaveRegs;
        u32 nCSaveRegs;
        if (self.isWindows)
        {
            calleeSaveRegs = {"rbx", "rdi", "rsi", "r12", "r13", "r14", "r15", "rbp"};
            nCSaveRegs = 8;
        }
        else
        {
            calleeSaveRegs = {"rbx", "r12", "r13", "r14", "r15", "rbp"};
            nCSaveRegs = 6;
        }
        bool usesAnyCalleeSave = false;
        for (u32 i = 0; i < nCSaveRegs; i++)
        {
            if (self.funcUsesReg(func, calleeSaveRegs[i]))
            {
                self.savedCalleeSaves[i] = true;
                self.numCalleeSaves++;
                usesAnyCalleeSave = true;
            }
            else
            {
                self.savedCalleeSaves[i] = false;
            }
        }

        // The red zone is only safe when nothing needs a frame: no
        // spills (they address rbp-relative), no allocas (their region
        // lives in the frame) and no stack parameters (they are read
        // through rbp too). Callee-save homes disqualify it as well —
        // the pushes below move rsp, and the zone must stay empty.
        if (isLeaf && !self.isWindows && self.spillSlotCount == 0 &&
            self.allocaBytes == 0 && !hasStackParams && !usesAnyCalleeSave)
        {
            self.currentFuncHasFrame = false;
            self.useRedZone = true;
            self.emitParamSeeding(func);
            return;
        }

        if (isVararg)
        {
            // System V ABI: Save registers to a dedicated register save area
            // using rbp-relative offsets. Conditionally save XMM based on AL.
            // Windows x64: va_list is just a pointer to the stack - shadow
            // space handles argument passing.
            if (!self.isWindows)
            {
                // System V: allocate 176 bytes (48 GP save + 128 XMM save)
                // Layout: [gp_save:48] [xmm_save:128]
                self.varargAllocSize = 176;
                self.emitter.emitTab("subq $176, %rsp");

                // Save GP registers to register save area (rbp-relative)
                // Note: rbp is not set yet, so use rsp-relative offsets
                // that will remain valid after frame setup
                self.emitter.emit("\tmovq %rdi, ");
                self.emitter.emitU32(self.varargAllocSize);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovq %rsi, ");
                self.emitter.emitU32(self.varargAllocSize + 8);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovq %rdx, ");
                self.emitter.emitU32(self.varargAllocSize + 16);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovq %rcx, ");
                self.emitter.emitU32(self.varargAllocSize + 24);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovq %r8, ");
                self.emitter.emitU32(self.varargAllocSize + 32);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovq %r9, ");
                self.emitter.emitU32(self.varargAllocSize + 40);
                self.emitter.emitLine("(%rsp)");

                // Conditionally save XMM registers based on AL (count of FP args)
                self.emitter.emitLine("testb %al, %al");
                u32 xmmSkip = self.emitter.nextLabel();
                self.emitter.emit("\tje .Lskip_xmm_");
                self.emitter.emitU32(xmmSkip);
                self.emitter.emitLine("");

                u32 xmmBase = self.varargAllocSize + 48;
                self.emitter.emit("\tmovaps %xmm0, ");
                self.emitter.emitU32(xmmBase);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm1, ");
                self.emitter.emitU32(xmmBase + 16);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm2, ");
                self.emitter.emitU32(xmmBase + 32);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm3, ");
                self.emitter.emitU32(xmmBase + 48);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm4, ");
                self.emitter.emitU32(xmmBase + 64);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm5, ");
                self.emitter.emitU32(xmmBase + 80);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm6, ");
                self.emitter.emitU32(xmmBase + 96);
                self.emitter.emitLine("(%rsp)");
                self.emitter.emit("\tmovaps %xmm7, ");
                self.emitter.emitU32(xmmBase + 112);
                self.emitter.emitLine("(%rsp)");

                self.emitter.emit(".Lskip_xmm_");
                self.emitter.emitU32(xmmSkip);
                self.emitter.emitLine(":");
            }
            else
            {
                // Windows x64: va_list is just a pointer to the stack.
                // Arguments are passed via shadow space (32 bytes).
                // We save all 4 GP + 4 XMM registers to the shadow area.
                self.varargAllocSize = 32;
                self.emitter.emitTab("subq $32, %rsp");
                self.emitter.emitTab("movq %rcx, 0(%rsp)");
                self.emitter.emitTab("movq %rdx, 8(%rsp)");
                self.emitter.emitTab("movq %r8, 16(%rsp)");
                self.emitter.emitTab("movq %r9, 24(%rsp)");
            }
        }

        self.calleeSavesPushed = false;
        self.hasDeferredFrame = false;

        // Spill slots are addressed rbp-relative, so a frame is
        // mandatory whenever the allocator spilled anything — a leaf
        // or an omitFramePointer path cannot use spill slots safely.
        // The alloca region hangs off rbp the same way, and stack
        // parameters are read through rbp too, so both force a frame
        // even in a leaf.
        bool needFrame = !isLeaf || self.spillSlotCount > 0 ||
                         self.allocaBytes > 0 || hasStackParams;

        // Shrink-wrap (deferred pushes at first use) is not enabled: the
        // deferred path runs AFTER param seeding has already written the
        // incoming values into their homes, so a home that landed on a
        // callee-save register would clobber the caller's value before
        // the push saved it. Pushing in the prologue is always correct;
        // the per-block emitDeferredCalleeSaves calls early-return on
        // calleeSavesPushed.
        if (!isLeaf && self.omitFramePointer && self.spillSlotCount == 0 &&
            self.allocaBytes == 0 && !hasStackParams)
        {
            self.currentFuncHasFrame = false;
            if (self.isWindows)
                self.shadowAllocSize = 32;
        }
        else if (needFrame)
        {
            if (self.emitter.useAtt)
            {
                self.emitter.emitTab("pushq %rbp");
                self.emitter.emitTab("movq %rsp, %rbp");
            }
            else
            {
                self.emitter.emitTab("push rbp");
                self.emitter.emitTab("mov rbp, rsp");
            }
            self.currentFuncHasFrame = true;
        }
        else
        {
            self.currentFuncHasFrame = false;
        }

        // Save the caller's registers the allocator handed out, whenever
        // any were handed out — including frameless leaves, which the old
        // !canShrinkWrap && needFrame gate skipped (needFrame is false
        // for a spill-free leaf, so its callee-save homes were silently
        // clobbered).
        if (usesAnyCalleeSave)
        {
            self.calleeSavesPushed = true;
            for (u32 i = 0; i < nCSaveRegs; i++)
            {
                if (self.savedCalleeSaves[i])
                    self.emitPushCalleeSave(calleeSaveRegs[i]);
            }

            // Without a frame nothing else adjusts rsp: the entry value
            // was 8 mod 16, so an even save count leaves the body
            // misaligned at every call site. Take exactly one word —
            // after the pushes, so the epilogue's spill-area addq (which
            // runs before the pops) undoes it in the right order.
            if (!self.currentFuncHasFrame && (self.numCalleeSaves % 2) == 0)
            {
                self.spillFrameBytes = 8;
                self.emitter.emitLine("\tsubq $8, %rsp");
            }
        }

        if (self.currentFuncHasFrame)
        {
            // Reserve the spill slots and the alloca region below the
            // saved callee saves; slots address it rbp-relative, and
            // allocas find their base in allocaBase. Padding to an odd
            // 8 keeps the call instruction's stack 16-byte aligned —
            // allocaBytes is a multiple of 16, so it cannot disturb
            // that.
            u32 n = self.spillSlotCount;
            u32 pad = (self.numCalleeSaves % 2) == 1 ? 8 : 0;
            self.allocaBase = n * 16 + pad;
            self.spillFrameBytes = self.allocaBase + self.allocaBytes;
            if (self.spillFrameBytes > 0)
            {
                str buf2 = u32ToStr(self.spillFrameBytes);
                self.emitter.emit("\tsubq $");
                self.emitter.emit(buf2);
                self.emitter.emitLine(", %rsp");
            }
        }

        self.emitParamSeeding(func);
    }

    // Move the ABI's incoming parameter registers into the homes lsra
    // chose, walking the entry block's parameter stores in order — the
    // same walk the caller makes over its arguments, so register banks
    // and stack slots stay in lockstep on both sides of every call.
    // Called from every non-vararg path; the gate that picked the path
    // already ruled out the cases this walk cannot serve (stack params
    // and allocas without a frame).
    //
    // The walk runs twice over the same stores. Phase one moves every
    // incoming bank word into a staging area on this function's own
    // stack; phase two commits staging into homes and allocas. The
    // split is required for correctness, not tidiness: lsra gives each
    // parameter a home from whatever the scan left free, and that set
    // is drawn from the same bank the caller passes arguments in —
    // SysV's first free homes tend to be rcx/rdx/rsi/rdi, and rdx is
    // argument 2's incoming register, so a one-pass walk can store one
    // parameter over the top of another before it has been read.
    // Reading every bank word before writing hasAny home makes every
    // ordering safe, for either ABI, and also covers a struct whose
    // word0 lands in a home that a later word of the same struct
    // arrives in. Stack parameters read from memory (16(%rbp) upward,
    // past the Win64 shadow), which no home write can clobber, so they
    // commit directly from there.
    void emitParamSeeding(IrFunc* func)
    {
        if (func == null || func->base.type == null) return;
        if (func->base.type->isVararg) return;
        if (func->nblocks == 0 || func->base.type->nparams == 0) return;

        // classifyCallArg never hands out more than maxInt integer
        // words or maxFp fp words from registers, and each word stages
        // in at most 8 (integer) or 16 (fp, vectors included) bytes,
        // so that pair is the ceiling the plan can never exceed. The
        // plan itself sizes the region exactly: seeds whose home
        // already is the register the value arrives in stage nothing,
        // and a function where every seed lands that way gets no
        // region at all. The pair is balanced before hasAny call or
        // return; the only path that touches the red zone is the
        // frameless one, where the gates above guarantee the zone is
        // still empty.
        self.planParamSeeds(func);
        str stageBuf = u32ToStr(self.sdStageBytes);
        if (self.sdStageBytes > 0)
        {
            self.emitter.emit("\tsubq $");
            self.emitter.emit(stageBuf);
            self.emitter.emitLine(", %rsp");
        }

        self.walkParamSeeds(func, true);
        self.walkParamSeeds(func, false);

        if (self.sdStageBytes > 0)
        {
            self.emitter.emit("\taddq $");
            self.emitter.emit(stageBuf);
            self.emitter.emitLine(", %rsp");
        }
    }

    // Incoming ABI bank register by index — the one source both the
    // plan's skip test and the stage walk's source operands read.
    str seedIntReg(u32 idx)
    {
        str[6] sysv = {"rdi", "rsi", "rdx", "rcx", "r8", "r9"};
        str[4] win = {"rcx", "rdx", "r8", "r9"};
        if (self.isWindows)
        {
            if (idx < 4) return win[idx];
            return "";
        }
        if (idx < 6) return sysv[idx];
        return "";
    }

    str seedFpReg(u32 idx)
    {
        str[8] sysv = {"xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"};
        str[4] win = {"xmm0", "xmm1", "xmm2", "xmm3"};
        if (self.isWindows)
        {
            if (idx < 4) return win[idx];
            return "";
        }
        if (idx < 8) return sysv[idx];
        return "";
    }

    // Classification for the seeding walks: resolve every parameter
    // seed once (Arg values today; the entry-store walk covers legacy
    // Inst-kind parameters), classify its ABI placement, then decide
    // which seeds can drop the staging round trip and lay out the slots
    // the survivors use. Both emission walks replay these records, so
    // stage and commit can never disagree.
    void planParamSeeds(IrFunc* func)
    {
        self.nSeedsPlanned = 0;
        self.sdStageBytes = 0;
        if (func == null || func->base.type == null) return;
        if (func->nblocks == 0) return;

        u32 intIdx = 0;
        u32 fpIdx = 0;
        u32 stackOff = self.isWindows ? 32 : 0;
        u32 found = 0;
        IrBlock* eb = func->blocks[0];
        // Current IR models parameters as IrValueKind::Arg values. The
        // entry-store walk below remains for legacy Inst-kind parameters.
        u32 nSeeds = func->nargs > 0 ? func->nargs : eb->ninsts;
        for (u32 i = 0; i < nSeeds && found < func->base.type->nparams; i++)
        {
            IrValue* src = null;
            IrValue* dstv = null;
            if (func->nargs > 0)
            {
                src = func->args[i];
                if (src == null) continue;
            }
            else
            {
                IrInst* inst = eb->insts[i];
                if (inst->opcode != IrOpcode::Store || inst->nops < 1) continue;
                src = inst->ops[0];
                if (src == null || src->kind != IrValueKind::Inst) continue;

                bool srcDefined = false;
                for (u32 b = 0; b < func->nblocks && !srcDefined; b++)
                {
                    IrBlock* bb = func->blocks[b];
                    for (u32 j = 0; j < bb->ninsts && !srcDefined; j++)
                    {
                        if (b == 0 && j == i) continue;
                        IrInst* other = bb->insts[j];
                        if (other->base.id == src->id) srcDefined = true;
                    }
                }
                if (srcDefined) continue;
                dstv = inst->nops > 1 ? inst->ops[1] : null;
            }

            u32 slot = self.nSeedsPlanned;
            if (slot >= 128) break;
            found++;

            u32 outReg = 0;
            u32 outOff = 0;
            u32 outWords = 1;
            u32 kind = self.classifyCallArg(src, &intIdx, &fpIdx, &stackOff,
                                             &outReg, &outOff, &outWords);
            self.sdKind[slot] = kind;
            self.sdReg[slot] = outReg;
            self.sdOff[slot] = outOff;
            self.sdWords[slot] = outWords;
            self.sdSlot[slot] = 0;
            self.sdSkip[slot] = false;
            self.sdSrc[slot] = src;
            self.sdDst[slot] = dstv;
            self.nSeedsPlanned++;
        }

        // A scalar seed can drop staging only when its home already is
        // the register the caller passes it in: the stage and its
        // commit would move the value out of that register and straight
        // back. That stays safe only while NO other seed's register
        // home is that same register — any other commit writing it
        // (including a memory-sourced seed committed straight from the
        // stack) would otherwise overwrite the value we left in place.
        // Struct seeds (kind 3) always stage: their commit also fills
        // the alloca. Memory homes cannot skip either — the value has
        // to reach the slot.
        for (u32 i = 0; i < self.nSeedsPlanned; i++)
        {
            u32 k = self.sdKind[i];
            if (k != 1 && k != 2) continue;
            str home = self.getRegName(self.sdSrc[i]);
            if (home.len == 0) continue;
            str inc = (k == 2) ? self.seedFpReg(self.sdReg[i])
                               : self.seedIntReg(self.sdReg[i]);
            if (!home.equals(inc)) continue;
            bool alone = true;
            for (u32 j = 0; j < self.nSeedsPlanned && alone; j++)
            {
                if (j == i) continue;
                str other = self.getRegName(self.sdSrc[j]);
                if (other.len > 0 && other.equals(home)) alone = false;
            }
            if (alone) self.sdSkip[i] = true;
        }

        // Slot layout over the survivors — both walks read it, so the
        // stage and commit phases agree on where each word lives.
        u32 stageOff = 0;
        for (u32 i = 0; i < self.nSeedsPlanned; i++)
        {
            if (self.sdSkip[i]) continue;
            u32 k = self.sdKind[i];
            if (k == 1)
            {
                self.sdSlot[i] = stageOff;
                stageOff += 8;
            }
            else if (k == 2)
            {
                self.sdSlot[i] = stageOff;
                stageOff += 16;
            }
            else if (k == 3)
            {
                self.sdSlot[i] = stageOff;
                stageOff += 8 * self.sdWords[i];
            }
        }
        self.sdStageBytes = stageOff;
    }

    // One pass of emitParamSeeding. Both walks replay the records
    // planParamSeeds built: stagePhase collects the incoming bank words
    // into their planned slots, the commit pass reads them back out
    // into homes and allocas — same records, same slots, so every stage
    // slot lines up word for word between them, and a seed the plan
    // skipped (its home already is the register it arrives in) emits
    // nothing in either phase.
    void walkParamSeeds(IrFunc* func, bool stagePhase)
    {
        for (u32 si = 0; si < self.nSeedsPlanned; si++)
        {
            if (self.sdSkip[si]) continue;
            IrValue* src = self.sdSrc[si];
            IrValue* dstv = self.sdDst[si];
            u32 kind = self.sdKind[si];
            u32 outReg = self.sdReg[si];
            u32 outOff = self.sdOff[si];
            u32 outWords = self.sdWords[si];
            u32 stageOff = self.sdSlot[si];

            if (stagePhase)
            {
                str stg = "";
                if (kind == 2)
                {
                    stg = stageText(stageOff);
                    self.emitter.emit("\tmovdqu ");
                    self.emitter.emit(self.seedFpReg(outReg));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(stg);
                    stageOff += 16;
                }
                else if (kind == 1)
                {
                    stg = stageText(stageOff);
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(self.seedIntReg(outReg));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(stg);
                    stageOff += 8;
                }
                else if (kind == 3)
                {
                    for (u32 w = 0; w < outWords; w++)
                    {
                        stg = stageText(stageOff);
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(self.seedIntReg(outReg + w));
                        self.emitter.emit(", ");
                        self.emitter.emitLine(stg);
                        stageOff += 8;
                    }
                }
                // kinds 0 and 4 read from memory — nothing to stage
                continue;
            }
            str stg = "";

            if (kind == 2)
            {
                // xmm parameter, committed from staging. movdqu carries
                // the whole register either way; its 16-byte transfer
                // fits a spill slot exactly (slots are 16 apart), and
                // only the bits the type asks for are ever read back.
                stg = stageText(stageOff);
                if (self.valueIsSpill(src))
                {
                    self.emitter.emit("\tmovdqu ");
                    self.emitter.emit(stg);
                    self.emitter.emitLine(", xmm15");
                    self.emitter.emit("\tmovdqu xmm15, ");
                    self.emitter.emitLine(self.opFor(src));
                }
                else
                {
                    self.emitter.emit("\tmovdqu ");
                    self.emitter.emit(stg);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(self.opFor(src));
                }
                stageOff += 16;
            }
            else if (kind == 1)
            {
                // integer parameter — the full 8 bytes the caller put
                // in the register, spill slots included, read back out
                // of staging (the incoming register may already have
                // been consumed as an earlier parameter's home)
                stg = stageText(stageOff);
                if (self.valueIsSpill(src))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(stg);
                    self.emitter.emitLine(", r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitLine(self.opFor(src));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(stg);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(self.opFor(src));
                }
                stageOff += 8;
            }
            else if (kind == 3)
            {
                // struct words in registers: word0 also lands in the
                // value's home, because the body's store rewrites that
                // word of the alloca from there, and every word lands
                // in the alloca itself. All words come out of staging,
                // so word0 sitting in a home that a later word arrives
                // in can no longer eat that word.
                u32 baseOff = stageOff;
                stg = stageText(stageOff);
                if (self.valueIsSpill(src))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(stg);
                    self.emitter.emitLine(", r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitLine(self.opFor(src));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(stg);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(self.opFor(src));
                }
                u32 aoff = 0;
                if (dstv != null && self.allocaSlotOf(func, dstv, &aoff))
                {
                    self.emitter.emit("\tleaq -");
                    self.emitter.emitU32(aoff);
                    self.emitter.emitLine("(%rbp), r10");
                    for (u32 w = 0; w < outWords; w++)
                    {
                        stg = stageText(baseOff + 8 * w);
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(stg);
                        self.emitter.emitLine(", r11");
                        self.emitter.emit("\tmovq r11, ");
                        if (w == 0)
                        {
                            self.emitter.emitLine("(r10)");
                        }
                        else
                        {
                            self.emitter.emitU32(8 * w);
                            self.emitter.emitLine("(r10)");
                        }
                    }
                }
                stageOff = baseOff + 8 * outWords;
            }
            else if (kind == 4)
            {
                // struct words on the stack: word0 into the value's
                // home, every word into the alloca
                if (self.valueIsSpill(src))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emitU32(16 + outOff);
                    self.emitter.emit("(%rbp), r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitLine(self.opFor(src));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emitU32(16 + outOff);
                    self.emitter.emit("(%rbp), ");
                    self.emitter.emitLine(self.opFor(src));
                }
                u32 aoff = 0;
                if (dstv != null && self.allocaSlotOf(func, dstv, &aoff))
                {
                    self.emitter.emit("\tleaq -");
                    self.emitter.emitU32(aoff);
                    self.emitter.emitLine("(%rbp), r10");
                    for (u32 w = 0; w < outWords; w++)
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emitU32(16 + outOff + 8 * w);
                        self.emitter.emit("(%rbp), r11");
                        self.emitter.emit("\tmovq r11, ");
                        if (w == 0)
                        {
                            self.emitter.emitLine("(r10)");
                        }
                        else
                        {
                            self.emitter.emitU32(8 * w);
                            self.emitter.emitLine("(r10)");
                        }
                    }
                }
            }
            else
            {
                // stack-passed scalar: the first stack argument lives
                // at 16(%rbp), the Win64 shadow reserves the first 32
                bool isFp = src->type != null &&
                            (src->type->kind == IrTypeKind::Float ||
                             src->type->kind == IrTypeKind::Vector);
                if (isFp)
                {
                    bool isV = src->type->kind == IrTypeKind::Vector;
                    str mn = isV ? "movdqu " : (src->type->width == 64 ? "movsd " : "movss ");
                    if (self.valueIsSpill(src))
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emitU32(16 + outOff);
                        self.emitter.emitLine("(%rbp), xmm15");
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emit("xmm15, ");
                        self.emitter.emitLine(self.opFor(src));
                    }
                    else
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emitU32(16 + outOff);
                        self.emitter.emit("(%rbp), ");
                        self.emitter.emitLine(self.opFor(src));
                    }
                }
                else if (self.valueIsSpill(src))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emitU32(16 + outOff);
                    self.emitter.emitLine("(%rbp), r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitLine(self.opFor(src));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emitU32(16 + outOff);
                    self.emitter.emit("(%rbp), ");
                    self.emitter.emitLine(self.opFor(src));
                }
            }
        }
    }

    void emitEpilogue()
    {
        // Mirror the prologue's stack adjustments in reverse: spill
        // area first (it sits below the saved callee saves), then the
        // callee-save pops, then the frame teardown frees rbp's slot,
        // then the vararg area that was allocated below the frame.
        if (self.spillFrameBytes > 0)
        {
            str buf3 = u32ToStr(self.spillFrameBytes);
            self.emitter.emit("\taddq $");
            self.emitter.emit(buf3);
            self.emitter.emitLine(", %rsp");
        }

        if (self.calleeSavesPushed)
        {
            // Same list as emitPrologue's scan, popped in reverse so each
            // register comes back in undo order. Windows saves rdi/rsi too.
            str[8] calleeSaveRegs;
            u32 nCSaveRegs;
            if (self.isWindows)
            {
                calleeSaveRegs = {"rbx", "rdi", "rsi", "r12", "r13", "r14", "r15", "rbp"};
                nCSaveRegs = 8;
            }
            else
            {
                calleeSaveRegs = {"rbx", "r12", "r13", "r14", "r15", "rbp"};
                nCSaveRegs = 6;
            }
            for (u32 i = nCSaveRegs; i > 0; i--)
            {
                u32 idx = i - 1;
                if (self.savedCalleeSaves[idx])
                {
                    str reg = calleeSaveRegs[idx];
                    if (self.emitter.useAtt)
                    {
                        self.emitter.emit("\tpopq %");
                        self.emitter.emit(reg);
                        self.emitter.emit("\n");
                    }
                    else
                    {
                        self.emitter.emit("\tpop ");
                        self.emitter.emit(reg);
                        self.emitter.emit("\n");
                    }
                }
            }
        }

        if (self.currentFuncHasFrame)
        {
            self.emitter.emitTab("leave");
        }

        if (self.varargAllocSize > 0)
        {
            str buf2 = u32ToStr(self.varargAllocSize);
            if (self.emitter.useAtt)
            {
                self.emitter.emit("\taddq $");
                self.emitter.emit(buf2);
                self.emitter.emit(", %rsp\n");
            }
            else
            {
                self.emitter.emit("\tadd rsp, ");
                self.emitter.emit(buf2);
                self.emitter.emit("\n");
            }
        }

        self.emitter.emitTab("ret");
    }

    void emitRet(IrInst* inst)
    {
        // G34: a tail-position call already jumped to the callee, so this
        // ret emits nothing — no value sink (the callee's own ret returns
        // to our caller with the result in rax/xmm0), no epilogue
        if (self.tailJmpCall != null && inst->nops > 0 && inst->ops[0] == &self.tailJmpCall->base)
        {
            self.emitter.emitComment("tail call, the jump returns to our caller");
            return;
        }

        if (inst->nops > 0 && inst->ops[0] != null)
        {
            IrValue* retVal = inst->ops[0];
            bool isStruct = retVal->type != null && retVal->type->kind == IrTypeKind::Struct;

            if (isStruct)
            {
                u32 sz = retVal->type->width;
                str src = self.opForReg(retVal, "r10");

                if (sz <= 8)
                {
                    self.emitter.emit("\tmovq (");
                    self.emitter.emit(src);
                    self.emitter.emitLine("), %rax");
                }
                else if (sz <= 16)
                {
                    self.emitter.emit("\tmovq (");
                    self.emitter.emit(src);
                    self.emitter.emitLine("), %rax");
                    self.emitter.emit("\tmovq 8(");
                    self.emitter.emit(src);
                    self.emitter.emitLine("), %rdx");
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emitLine(", %rax");
                }
            }
            else if (self.valueIsFloatClass(retVal))
            {
                str src = self.opFor(retVal);
                if (!src.equals("xmm0"))
                {
                    self.emitter.emit("\tmovsd ");
                    self.emitter.emit(src);
                    self.emitter.emitLine(", %xmm0");
                }
            }
            else
            {
                str src = self.opFor(retVal);
                if (!src.equals("rax"))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", %rax\n");
                }
            }
        }
        self.emitEpilogue();
    }

    // Instruction Selection (ISEL)
    // Pattern-matched emission of optimal x86 instruction sequences.
    // Called from emitInst BEFORE the generic fallback.
    // All methods take pre-fetched register names to avoid side effects.

    static bool iselIsConstInt(IrValue* val, u64* out)
    {
        if (val == null) return false;
        if (val->kind != IrValueKind::ConstInt) return false;
        *out = val->valData;
        return true;
    }

    static bool iselIsPow2(u64 v) { return v != 0 && (v & (v - 1)) == 0; }

    static u32 iselLog2(u64 v)
    {
        u32 r = 0;
        while (v > 1) { v >>= 1; r++; }
        return r;
    }

    bool iselEmitMulConst(IrInst* inst, str dst, str src1)
    {
        if (inst->nops < 2) return false;
        // The shift/lea patterns below print src1 into register and SIB
        // positions — a constant left operand has no register form, and
        // constfold normally rewrites the whole product anyway.
        if (valueIsIntConst(inst->ops[0])) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        // SIB operands and the add/shl-after-lea tails need registers:
        // a spilled left operand reloads into r10 and a spilled result
        // computes in r11, stored back after the pattern matched
        if (self.valueIsSpill(inst->ops[0]))
            src1 = self.opForReg(inst->ops[0], "r10");
        bool needStore = self.valueIsSpill(&inst->base);
        str realDst = needStore ? "r11" : dst;
        if (!self.iselEmitMulConstBody(inst, realDst, src1)) return false;
        if (needStore)
        {
            self.emitter.emit("\tmovq %r11, ");
            self.emitter.emitLine(dst);
        }
        return true;
    }

    bool iselEmitMulConstBody(IrInst* inst, str dst, str src1)
    {
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;

        if (c == 0)
        {
            self.emitter.emit("\txorq ");
            self.emitter.emit(dst);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (c == 1)
        {
            if (!src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            return true;
        }
        if (c == 0xFFFFFFFFFFFFFFFFUL)
        {
            if (!src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            self.emitter.emit("\tnegq ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (self.iselIsPow2(c))
        {
            u32 shift = self.iselLog2(c);
            if (shift == 1)
            {
                self.emitter.emit("\tleaq (");
                self.emitter.emit(src1);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit("), ");
                self.emitter.emitLine(dst);
            }
            else
            {
                if (!src1.equals(dst))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src1);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                str buf = u32ToStr(shift);
                self.emitter.emit("\tshlq $");
                self.emitter.emit(buf);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            return true;
        }
        if (c == 3)
        {
            self.emitter.emit("\tleaq (");
            self.emitter.emit(src1);
            self.emitter.emit(",");
            self.emitter.emit(src1);
            self.emitter.emit(",2), ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (c == 5)
        {
            self.emitter.emit("\tleaq (");
            self.emitter.emit(src1);
            self.emitter.emit(",");
            self.emitter.emit(src1);
            self.emitter.emit(",4), ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (c == 6)
        {
            if (src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tshlq $1, ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tleaq (");
                self.emitter.emit(dst);
                self.emitter.emit(",");
                self.emitter.emit(dst);
                self.emitter.emit(",2), ");
                self.emitter.emitLine(dst);
            }
            else
            {
                self.emitter.emit("\tleaq (");
                self.emitter.emit(src1);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit(",2), ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\taddq ");
                self.emitter.emit(dst);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            return true;
        }
        if (c == 7)
        {
            if (src1.equals(dst))
            {
                self.emitter.emit("\tleaq (");
                self.emitter.emit(src1);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit(",4), ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tsubq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            else
            {
                self.emitter.emit("\tleaq (");
                self.emitter.emit(src1);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit(",2), ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tleaq (");
                self.emitter.emit(dst);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit(",4), ");
                self.emitter.emitLine(dst);
            }
            return true;
        }
        if (c == 9)
        {
            self.emitter.emit("\tleaq (");
            self.emitter.emit(src1);
            self.emitter.emit(",");
            self.emitter.emit(src1);
            self.emitter.emit(",8), ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (c == 10)
        {
            self.emitter.emit("\tleaq (");
            self.emitter.emit(src1);
            self.emitter.emit(",");
            self.emitter.emit(src1);
            self.emitter.emit(",4), ");
            self.emitter.emitLine(dst);
            self.emitter.emit("\taddq ");
            self.emitter.emit(dst);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (c == 12)
        {
            if (src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tshlq $1, ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tleaq (");
                self.emitter.emit(dst);
                self.emitter.emit(",");
                self.emitter.emit(dst);
                self.emitter.emit(",2), ");
                self.emitter.emitLine(dst);
            }
            else
            {
                self.emitter.emit("\tleaq (");
                self.emitter.emit(src1);
                self.emitter.emit(",");
                self.emitter.emit(src1);
                self.emitter.emit(",2), ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tshlq $2, ");
                self.emitter.emitLine(dst);
            }
            return true;
        }
        return false;
    }

    bool iselEmitSDivPow2(IrInst* inst, str dst, str src1)
    {
        if (inst->nops < 2) return false;
        if (self.valueIsSpill(&inst->base)) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        if (!self.iselIsPow2(c) || c <= 1) return false;
        u32 shift = self.iselLog2(c);
        u32 width = inst->base.type != null ? inst->base.type->width : 64;
        if (width != 64 && width != 32) return false;
        if (width == 32 && valueIsIntConst(inst->ops[0]))
            src1 = self.opForReg(inst->ops[0], "r10");
        str buf = "";
        if (width == 32)
        {
            str d32 = toReg32(dst);
            str s32 = toReg32(src1);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(s32);
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            self.emitter.emit("\tsarl $31, ");
            self.emitter.emitLine(d32);
            self.emitter.emit("\tshrl $");
            self.emitter.emit(u32ToStr(32u - shift));
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            self.emitter.emit("\taddl ");
            self.emitter.emit(s32);
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            self.emitter.emit("\tsarl $");
            self.emitter.emit(u32ToStr(shift));
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            return true;
        }

        self.emitter.emit("\tmovq ");
        self.emitter.emit(src1);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);

        buf = u32ToStr(64u - shift);
        self.emitter.emit("\tsarq $63, ");
        self.emitter.emitLine(dst);
        self.emitter.emit("\tshrq $");
        self.emitter.emit(buf);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        self.emitter.emit("\taddq ");
        self.emitter.emit(src1);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        buf = u32ToStr(shift);
        self.emitter.emit("\tsarq $");
        self.emitter.emit(buf);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        return true;
    }

    bool iselEmitUDivPow2(IrInst* inst, str dst, str src1)
    {
        if (inst->nops < 2) return false;
        if (self.valueIsSpill(&inst->base)) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        if (!self.iselIsPow2(c) || c <= 1) return false;
        u32 shift = self.iselLog2(c);
        u32 width = inst->base.type != null ? inst->base.type->width : 64;
        if (width != 64 && width != 32) return false;
        str buf = "";
        if (width == 32)
        {
            if (valueIsIntConst(inst->ops[0]))
                src1 = self.opForReg(inst->ops[0], "r10");
            str d32 = toReg32(dst);
            str s32 = toReg32(src1);
            self.emitter.emit("\tmovl ");
            self.emitter.emit(s32);
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            self.emitter.emit("\tshrl $");
            self.emitter.emit(u32ToStr(shift));
            self.emitter.emit(", ");
            self.emitter.emitLine(d32);
            return true;
        }
        if (!src1.equals(dst))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        buf = u32ToStr(shift);
        self.emitter.emit("\tshrq $");
        self.emitter.emit(buf);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        return true;
    }

    bool iselEmitAddSelf(IrInst* inst, str dst, str src1)
    {
        if (inst->nops < 2) return false;
        if (inst->ops[0] != inst->ops[1]) return false;
        self.emitter.emit("\tleaq (");
        self.emitter.emit(src1);
        self.emitter.emit(",");
        self.emitter.emit(src1);
        self.emitter.emit("), ");
        self.emitter.emitLine(dst);
        return true;
    }

    bool iselEmitIdentityConst(IrInst* inst, str dst, str src1, u64 identityVal)
    {
        if (inst->nops < 2) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        if (c != identityVal) return false;
        if (!src1.equals(dst))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        return true;
    }

    // Main ISEL dispatch. Returns true if pattern matched.
    bool trySelect(IrInst* inst, str dst, str src1, str src2)
    {
        switch (inst->opcode)
        {
            IrOpcode::Add => {
                if (self.iselEmitIdentityConst(inst, dst, src1, 0))
                    return true;
                if (self.iselEmitAddSelf(inst, dst, src1))
                    return true;
            },
            
            IrOpcode::Sub => { if (self.iselEmitIdentityConst(inst, dst, src1, 0)) return true; },
            IrOpcode::Mul => { if (self.iselEmitMulConst(inst, dst, src1)) return true; },
            IrOpcode::SDiv => { if (self.iselEmitSDivPow2(inst, dst, src1)) return true; },
            IrOpcode::UDiv => { if (self.iselEmitUDivPow2(inst, dst, src1)) return true; },
            IrOpcode::And => { if (self.iselEmitIdentityConst(inst, dst, src1, 0xFFFFFFFFFFFFFFFFUL)) return true; },
            
            IrOpcode::Or |
            IrOpcode::Xor => { if (self.iselEmitIdentityConst(inst, dst, src1, 0)) return true; },
            
            IrOpcode::Shl |
            IrOpcode::Ashr |
            IrOpcode::Lshr => { if (self.iselEmitIdentityConst(inst, dst, src1, 0)) return true; },
            else => { },
        }
        return false;
    }

    // Width-aware load/store helpers

    // The address value in a register for an indirect operand: a
    // spilled pointer reloads into r11 first (r11 is reserved, never
    // allocated), a register home goes in as-is.
    /* symbol for a string constant: its stable ".Lcs<id>" name */
    str stringLabel(IrValue* v)
    {
        if (v == null) return str::empty();
        if (v->name.len > 0) return v->name;
        return self.ctx.stringConstLabel(v->id);
    }

    /* label[+-off](%rip) — the RIP-relative spelling every reference to
     * rodata uses; built into the rotating text buffers, consumed by the
     * next line emitted */
    str ripOperand(str label, i64 off)
    {
        String* b = textBufNext();
        b->pushView(label);
        if (off > 0)
        {
            b->pushChar('+');
            b->pushView(u32ToStr((u32)off));
        }
        else if (off < 0)
        {
            b->pushChar('-');
            b->pushView(u32ToStr((u32)(-off)));
        }
        b->pushView("(%rip)");
        return b->asView();
    }

    /* constant byte offset of a Gep whose indices are all constant — the
     * same layout walk emitGep performs (align-then-place struct fields,
     * element strides for arrays), factored out so a literal's address
     * can be folded into one RIP-relative operand */
    bool gepConstOffset(IrInst* g, i64* off)
    {
        if (g == null || g->opcode != IrOpcode::Gep) return false;
        IrType* rt = null;
        if (g->nops > 0 && g->ops[0] != null && g->ops[0]->type != null)
        {
            IrType* pt = g->ops[0]->type;
            rt = pt->kind == IrTypeKind::Ptr ? pt->elem : pt;
        }
        i64 constOff = 0;
        for (u32 k = 1; k < g->nops && rt != null; k++)
        {
            IrValue* iv = g->ops[k];
            if (iv == null || !valueIsIntConst(iv)) return false;
            if (rt->kind == IrTypeKind::Struct)
            {
                u32 fi = (u32)(iv->valData & 0xFFFFFFFF);
                if (fi >= rt->nparams) return false;
                u32 o = 0;
                for (u32 f = 0; f < rt->nparams; f++)
                {
                    u32 al = self.ctx.irTypeAlignOf(rt->params[f]);
                    if (al > 1) o = (o + al - 1u) / al * al;
                    if (f == fi) break;
                    o += self.ctx.irTypeSizeOf(rt->params[f]);
                }
                constOff += (i64)o;
                rt = rt->params[fi];
                continue;
            }
            if (rt->kind != IrTypeKind::Array && rt->kind != IrTypeKind::Vector) return false;
            u32 stride = self.ctx.irTypeSizeOf(rt->elem);
            if (stride == 0) stride = 1;
            i64 c = (i64)iv->valData;
            u32 iw = iv->type != null ? iv->type->width : 64;
            if (iw < 64 && iw > 0 && (c & ((i64)1 << (i64)(iw - 1))) != 0)
                c |= ~(((i64)1 << (i64)iw) - 1);
            constOff += c * (i64)stride;
            rt = rt->elem;
        }
        *off = constOff;
        return true;
    }

    /* a link-time constant address: a string constant itself, or a Gep
     * chain over one with constant indices. Lets a load/store through a
     * literal become a single RIP-relative memory operand instead of a
     * lea into a scratch plus a memory access */
    bool constAddrOf(IrValue* v, str* label, i64* off)
    {
        i64 total = 0;
        while (v != null && v->kind == IrValueKind::Inst)
        {
            IrInst* g = (IrInst*)v;
            if (g->opcode != IrOpcode::Gep) return false;
            i64 o = 0;
            if (!self.gepConstOffset(g, &o)) return false;
            total += o;
            v = g->nops > 0 ? g->ops[0] : null;
        }
        if (v == null) return false;
        if (v->kind == IrValueKind::StringConst)
        {
            *label = self.stringLabel(v);
            *off = total;
            return true;
        }
        /* a file-scope variable is a link-time constant address too, so
         * its references fold into one rip-relative operand the same way
         * a literal's do */
        if (v->kind == IrValueKind::Global)
        {
            *label = v->name;
            *off = total;
            return true;
        }
        return false;
    }

    // Memory operand for a load/store source. A constant address
    // (symbol, or symbol + constant gep) comes back as its rip operand
    // directly — `counter(%rip)` — so the access is one instruction
    // instead of a lea round trip. Every other address materializes the
    // way this code always has: a rip-able symbol still goes through
    // leaq into %rdx (rdx is reserved and never a value home; a raw rip
    // operand would come out as `(counter(%rip))` if a caller wrapped
    // it), and a spilled address value or address constant lands in rdx
    // too. The result is always the full `( … )` / `sym(%rip)` operand
    // the instruction wants — callers emit it verbatim.
    str memOperandFor(IrValue* av, str fallback)
    {
        str lb;
        i64 off = 0;
        if (av != null && self.constAddrOf(av, &lb, &off))
            return self.ripOperand(lb, off);
        String* b = textBufNext();
        b->pushChar('(');
        if (av == null)
        {
            b->pushView(fallback);
        }
        else if (self.valueIsSpill(av) || valueIsIntConst(av))
        {
            b->pushView(self.opForReg(av, "rdx"));
        }
        else
        {
            b->pushView(self.opFor(av));
        }
        b->pushChar(')');
        return b->asView();
    }

    void emitLoadWidth(IrInst* inst)
    {
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        IrValue* dv = &inst->base;
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        u32 width = dv->type != null ? dv->type->width : 64;

        // float and vector results live in xmm homes (or their slot) —
        // an integer register has no movd/movdqu encoding to receive them
        if (self.valueIsFloatClass(dv) || self.valueIsVec(dv))
        {
            str mn = self.valueIsVec(dv)
                ? (width <= 32 ? "movd " : width <= 64 ? "movq " : "movdqu ")
                : (width == 64 ? "movq " : "movd ");
            str work = dstSpill ? "xmm15" : dst;
            str operand = self.memOperandFor(av, "rax");
            self.emitter.emit("\t");
            self.emitter.emit(mn);
            self.emitter.emit(operand);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            if (dstSpill)
            {
                self.emitter.emit("\t");
                self.emitter.emit(mn);
                self.emitter.emit("xmm15, ");
                self.emitter.emitLine(dst);
            }
            return;
        }

        // an integer destination may have spilled — r10 carries it, then
        // sinkInt writes the width-appropriate store back to the slot
        str work = dstSpill ? "r10" : dst;
        str mv = width == 8 ? "movb " : width == 16 ? "movzwl " : width == 32 ? "movl " : "movq ";
        str r = width == 8 ? toReg8(work) : width == 16 ? toReg32(work) : width == 32 ? toReg32(work) : work;
        str operand = self.memOperandFor(av, "rax");
        self.emitter.emit("\t");
        self.emitter.emit(mv);
        self.emitter.emit(operand);
        self.emitter.emit(", ");
        self.emitter.emitLine(r);
        if (dstSpill) self.sinkInt(dv, "r10");
    }

    void emitStoreWidth(IrInst* inst)
    {
        IrValue* sv = (inst->nops > 0) ? inst->ops[0] : null;
        IrValue* av = (inst->nops > 1) ? inst->ops[1] : null;
        u32 width = sv != null && sv->type != null ? sv->type->width : 64;

        if (self.valueIsFloatClass(sv) || self.valueIsVec(sv))
        {
            str mn = self.valueIsVec(sv)
                ? (width <= 32 ? "movd " : width <= 64 ? "movq " : "movdqu ")
                : (width == 64 ? "movq " : "movd ");
            // memory to memory has no encoding — a spilled source
            // reloads into xmm15 first
            str s = self.valueIsSpill(sv) ? self.opForRegF(sv, "xmm15") : self.opFor(sv);
            str operand = self.memOperandFor(av, "rbx");
            self.emitter.emit("\t");
            self.emitter.emit(mn);
            self.emitter.emit(s);
            self.emitter.emit(", ");
            self.emitter.emitLine(operand);
            return;
        }

        str mv = width == 8 ? "movb " : width == 16 ? "movw " : width == 32 ? "movl " : "movq ";
        str operand = self.memOperandFor(av, "rbx");

        // An immediate reaches memory in one instruction — no scratch
        // register and no materialization round trip. Sub-word widths
        // mask the value to what the store keeps (the register-width
        // materialization did that implicitly); a64-bit store only
        // takes the direct path when its encoding has an immediate form
        // at all (the value sign-extends from32 bits) — movq imm→memory
        // has no movabs form, so anything wider falls back to r10.
        if (sv != null && valueIsIntConst(sv))
        {
            u64 imm = sv->valData;
            bool direct = true;
            if (width == 8) imm &= 0xFF;
            else if (width == 16) imm &= 0xFFFF;
            else if (width == 32) imm &= 0xFFFFFFFF;
            else
            {
                // sign-extends from 32 bits?
                u64 hi = imm & 0xFFFFFFFF00000000UL;
                if (hi != 0 && hi != 0xFFFFFFFF00000000UL) direct = false;
            }
            if (direct)
            {
                self.emitter.emit("\t");
                self.emitter.emit(mv);
                self.emitter.emit("$");
                self.emitter.emit(u64ToHex(imm));
                self.emitter.emit(", ");
                self.emitter.emitLine(operand);
                return;
            }
        }

        // an int source spill reloads into r10 — r11 may already hold
        // the address, so the two never share a scratch
        str s = (self.valueIsSpill(sv) || valueIsIntConst(sv))
                        ? self.opForReg(sv, "r10") : self.opFor(sv);
        str r = width == 8 ? toReg8(s) : width == 16 ? toReg16(s) : width == 32 ? toReg32(s) : s;
        self.emitter.emit("\t");
        self.emitter.emit(mv);
        self.emitter.emit(r);
        self.emitter.emit(", ");
        self.emitter.emitLine(operand);
    }

    // Extension folding into load
    // Zext(load byte ptr addr) → movb (addr), reg8; movzbl reg8, reg32
    // Sext(load byte ptr addr) → movsbq (addr), dst (sign-extend in load)
    // Zext(load word ptr addr) → movzwl (addr), dst
    // Sext(load word ptr addr) → movswq (addr), dst
    // self eliminates a separate extension instruction.

    bool iselTryFoldExtLoad(IrInst* inst)
    {
        if (inst->nops < 1 || !inst->ops[0]) return false;
        IrValue* srcVal = inst->ops[0];
        if (srcVal->kind != IrValueKind::Inst) return false;
        IrInst* srcInst = (IrInst*)srcVal;
        if (srcInst->opcode != IrOpcode::Load) return false;
        if (srcInst->nops < 1 || !srcInst->ops[0]) return false;

        str dst = self.getRegForValue(&inst->base);
        str addr = self.getRegForValue(srcInst->ops[0]);
        u32 srcWidth = srcInst->base.type != null ? srcInst->base.type->width : 8;

        switch (inst->opcode)
        {
            IrOpcode::Zext => {
                switch (srcWidth)
                {
                    8 => {
                        self.emitter.emit("\tmovzbl (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(toReg32(dst));
                        return true;
                    },
                    16 => {
                        self.emitter.emit("\tmovzwl (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(toReg32(dst));
                        return true;
                    },
                    32 => {
                        self.emitter.emit("\tmovl (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(toReg32(dst));
                        return true;
                    },
                    else => { },
                }
            },
            IrOpcode::Sext => {
                switch (srcWidth)
                {
                    8 => {
                        self.emitter.emit("\tmovsbq (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(dst);
                        return true;
                    },
                    16 => {
                        self.emitter.emit("\tmovswq (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(dst);
                        return true;
                    },
                    32 => {
                        self.emitter.emit("\tmovslq (");
                        self.emitter.emit(addr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(dst);
                        return true;
                    },
                    else => { },
                }
            },
            else => { },
        }
        return false;
    }

    // Linear position of `at` inside `func` — blocks in order, then each
    // block's instructions — or ~0u when it is not found. The same order
    // regalloc numbers its intervals in, so a value used at or after a
    // point has an interval covering it.
    u32 linearPosOf(IrFunc* func, IrInst* at)
    {
        u32 pos = 0;
        for (u32 b = 0; b < func->nblocks; b++)
        {
            IrBlock* bb = func->blocks[b];
            for (u32 i = 0; i < bb->ninsts; i++)
            {
                if (bb->insts[i] == at) return pos;
                pos++;
            }
        }
        return ~0u;
    }

    // True when `v` still holds its own value at `at`. Regalloc only hands
    // a home (register or spill slot) to another value once the original's
    // last use has passed, so a read at or after that point proves the home
    // is still ours; a value with no such read is already dead here and its
    // home may name something else entirely. This walks the IR operands
    // rather than the maintained user list, so the answer stays tied to the
    // uses actually present.
    bool valueLiveAt(IrValue* v, IrInst* at)
    {
        if (v == null) return false;
        // Constants are materialised as an immediate at each use and keep no
        // home, so they are never stale.
        if (v->kind == IrValueKind::ConstInt || v->kind == IrValueKind::ConstFloat) return true;
        IrFunc* f = self.currentFunc;
        if (f == null) return false;
        u32 atPos = self.linearPosOf(f, at);
        if (atPos == ~0u) return false;
        u32 pos = 0;
        for (u32 b = 0; b < f->nblocks; b++)
        {
            IrBlock* bb = f->blocks[b];
            for (u32 i = 0; i < bb->ninsts; i++)
            {
                if (pos >= atPos)
                {
                    IrInst* u = bb->insts[i];
                    for (u32 oi = 0; oi < u->nops; oi++)
                        if (u->ops[oi] == v) return true;
                }
                pos++;
            }
        }
        return false;
    }

    // Load-Op-Store fusion
    // Pattern: load ptr → op val → store ptr → same ptr
    // Emits: op val, (ptr)  — single memory-operand instruction.
    // Only safe when the Store's address is the same value as the Load's
    // address (same IR value, no GEP in between), and the register operand
    // is still live at the Store — otherwise its home has been reused and
    // the fused form would read an unrelated value.

    // Pure query: does `store` match the fusion? Checks structure (value is
    // a foldable binop whose first operand loads the store's own address),
    // opcode membership, and operand materialisation (64-bit constant, or a
    // value still live at the store) — without emitting anything, so
    // instruction selection can ask before committing to either form.
    bool canFoldLoadOpStore(IrInst* store)
    {
        if (store == null || store->opcode != IrOpcode::Store) return false;
        if (store->nops < 2) return false;

        IrValue* addrVal = store->ops[1];
        IrValue* srcVal = store->ops[0];
        if (srcVal == null || srcVal->kind != IrValueKind::Inst) return false;
        IrInst* srcInst = (IrInst*)srcVal;
        if (srcInst->nops < 2) return false;

        IrValue* loadVal = srcInst->ops[0];
        if (loadVal == null || loadVal->kind != IrValueKind::Inst) return false;
        IrInst* loadInst = (IrInst*)loadVal;
        if (loadInst->opcode != IrOpcode::Load) return false;
        if (loadInst->nops < 1) return false;
        if (loadInst->ops[0] != addrVal) return false;

        switch (srcInst->opcode)
        {
            IrOpcode::Add | IrOpcode::Sub | IrOpcode::And | IrOpcode::Or | IrOpcode::Xor => { },
            else => { return false; }
        }

        u32 width = loadInst->base.type != null ? loadInst->base.type->width : 64;
        IrValue* operandVal = srcInst->ops[1];
        if (valueIsIntConst(operandVal))
        {
            if (width != 64) return false;
        }
        else if (!self.valueLiveAt(operandVal, store))
        {
            return false;
        }
        return true;
    }

    // True when every reader of `op`'s result is a store that fuses. Such an
    // `op` can be omitted entirely: the fusion rebuilds the value in memory
    // from `op`'s own operands, so its register result would be dead once the
    // store folds — the `inc` that precedes `store i+1, i` and becomes
    // `add $1,(i)`. Any other reader keeps `op`: a plain use, or a store
    // where `op` is the address rather than the value being stored.
    bool opFeedsOnlyFusedStores(IrInst* op)
    {
        IrValue* res = &op->base;
        if (res == null || res->nusers == 0) return false;
        for (u32 i = 0; i < res->nusers; i++)
        {
            IrInst* u = res->users[i];
            if (u == null) return false;
            if (u->opcode != IrOpcode::Store) return false;
            if (u->nops < 1 || u->ops[0] != res) return false;
            if (!self.canFoldLoadOpStore(u)) return false;
        }
        return true;
    }

    bool iselTryFoldLoadOpStore(IrInst* inst)
    {
        if (!self.canFoldLoadOpStore(inst)) return false;

        IrValue* addrVal = inst->ops[1];
        IrValue* srcVal = inst->ops[0];
        IrInst* srcInst = (IrInst*)srcVal;
        IrInst* loadInst = (IrInst*)srcInst->ops[0];
        // The memory operand position accepts a register or (at 64-bit)
        // an immediate — a spilled operand reloads through r11 first,
        // because printing the slot text there yields an illegal
        // memory+memory encoding.
        u32 width = loadInst->base.type != null ? loadInst->base.type->width : 64;
        str operand;
        IrValue* operandVal = srcInst->ops[1];
        if (self.valueIsSpill(operandVal))
        {
            operand = self.opForReg(operandVal, "r11");
        }
        else if (valueIsIntConst(operandVal))
        {
            operand = intImmText(operandVal);
        }
        else
        {
            operand = self.getRegForValue(operandVal);
        }

        // the memory operand's address register, a spill reloads first;
        // an address already in a register is used in place
        str addr = self.opForRegInPlace(addrVal, "r10");

        // one switch does both jobs the old two did, membership and naming
        str opName;
        switch (srcInst->opcode)
        {
            IrOpcode::Add => { opName = "add"; },
            IrOpcode::Sub => { opName = "sub"; },
            IrOpcode::And => { opName = "and"; },
            IrOpcode::Or => { opName = "or"; },
            IrOpcode::Xor => { opName = "xor"; },
            else => { return false; }
        }

        self.emitter.emit("\t");
        self.emitter.emit(opName);
        switch (width)
        {
            8 => {
                self.emitter.emit("b ");
                self.emitter.emit(toReg8(operand));
            },
            16 => {
                self.emitter.emit("w ");
                self.emitter.emit(toReg16(operand));
            },
            32 => {
                self.emitter.emit("l ");
                self.emitter.emit(toReg32(operand));
            },
            else => {
                self.emitter.emit("q ");
                self.emitter.emit(operand);
            },
        }
        self.emitter.emit(", (");
        self.emitter.emit(addr);
        self.emitter.emitLine(")");
        return true;
    }

    // GEP + Load folding
    // Pattern: GEP base, idx, scale → Load ptr
    // Emit: load base + idx*scale directly via SIB addressing
    // Only for simple cases: single GEP with constant scale.

    bool iselTryFoldGepLoad(IrInst* inst)
    {
        if (inst->opcode != IrOpcode::Load) return false;
        if (inst->nops < 1 || !inst->ops[0]) return false;

        IrValue* addrVal = inst->ops[0];
        if (addrVal->kind != IrValueKind::Inst) return false;
        IrInst* addrInst = (IrInst*)addrVal;
        if (addrInst->opcode != IrOpcode::Gep) return false;
        if (addrInst->nops < 3) return false;

        // A spilled destination has no register form in the SIB load —
        // emitLoadWidth sinks it through r10 instead.
        if (self.valueIsSpill(&inst->base)) return false;

        str dst = self.getRegForValue(&inst->base);
        // sib parts are register-only, spills reload into the scratches
        str base = self.opForReg(addrInst->ops[0], "r10");
        str idx = self.opForReg(addrInst->ops[1], "r11");
        u32 width = inst->base.type != null ? inst->base.type->width : 64;

        self.emitter.emit("\t");
        switch (width)
        {
            8 => {
                self.emitter.emit("movb (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emit(", 1), ");
                self.emitter.emitLine(toReg8(dst));
                return true;
            },
            16 => {
                self.emitter.emit("movzwl (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emit(", 2), ");
                self.emitter.emitLine(toReg32(dst));
                return true;
            },
            32 => {
                self.emitter.emit("movl (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emit(", 4), ");
                self.emitter.emitLine(toReg32(dst));
                return true;
            },
            else => {
                self.emitter.emit("movq (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emit(", 8), ");
                self.emitter.emitLine(dst);
                return true;
            },
        }
    }

    // GEP + Store folding

    bool iselTryFoldGepStore(IrInst* inst)
    {
        if (inst->opcode != IrOpcode::Store) return false;
        if (inst->nops < 2) return false;

        IrValue* addrVal = inst->ops[1];
        if (addrVal->kind != IrValueKind::Inst) return false;
        IrInst* addrInst = (IrInst*)addrVal;
        if (addrInst->opcode != IrOpcode::Gep) return false;
        if (addrInst->nops < 3) return false;

        // The stored value sits in a register position: a spilled source
        // reloads through rax, and a constant has no register form here
        // (the generic store path emits it as an immediate).
        if (valueIsIntConst(inst->ops[0])) return false;
        str src = self.valueIsSpill(inst->ops[0])
            ? self.opForReg(inst->ops[0], "rax")
            : self.getRegForValue(inst->ops[0]);
        // sib parts are register-only, spills reload into the scratches
        str base = self.opForReg(addrInst->ops[0], "r10");
        str idx = self.opForReg(addrInst->ops[1], "r11");
        u32 width = inst->ops[0] != null && inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;

        self.emitter.emit("\t");
        switch (width)
        {
            8 => {
                self.emitter.emit("movb ");
                self.emitter.emit(toReg8(src));
                self.emitter.emit(", (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emitLine(", 1)");
                return true;
            },
            16 => {
                self.emitter.emit("movw ");
                self.emitter.emit(toReg16(src));
                self.emitter.emit(", (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emitLine(", 2)");
                return true;
            },
            32 => {
                self.emitter.emit("movl ");
                self.emitter.emit(toReg32(src));
                self.emitter.emit(", (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emitLine(", 4)");
                return true;
            },
            else => {
                self.emitter.emit("movq ");
                self.emitter.emit(src);
                self.emitter.emit(", (");
                self.emitter.emit(base);
                self.emitter.emit(", ");
                self.emitter.emit(idx);
                self.emitter.emitLine(", 8)");
                return true;
            },
        }
    }

    // Comparison folding: cmp x, 0 → test x, x
    bool iselTryFoldCmpZero(IrInst* inst)
    {
        if (inst->nops < 2) return false;
        if (inst->opcode != IrOpcode::ICmp) return false;
        IrValue* rhs = inst->ops[1];
        if (rhs == null) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(rhs, &c)) return false;
        if (c != 0) return false;

        IrValue* lhs = inst->ops[0];
        u32 width = lhs != null && lhs->type != null ? lhs->type->width : 64;
        str src1 = valueIsIntConst(lhs) || self.valueIsSpill(lhs)
                          ? self.opForReg(lhs, "r10")
                          : self.getRegForValue(lhs);
        str r1 = width == 64 ? src1
                  : width == 32 ? toReg32(src1)
                  : width == 16 ? toReg16(src1) : toReg8(src1);
        str dst = self.getRegForValue(&inst->base);
        str testOp = width == 64 ? "testq " : width == 32 ? "testl " : width == 16 ? "testw " : "testb ";
        self.emitter.emit("\t");
        self.emitter.emit(testOp);
        self.emitter.emit(r1);
        self.emitter.emit(", ");
        self.emitter.emitLine(r1);
        u32 pred = (u32)inst->icmpPred;
        str setOp = pred < 10 ? SETCC_INT[pred] : "sete";
        self.emitter.emit("\t");
        self.emitter.emit(setOp);
        self.emitter.emitLine(" %r11b");
        // movzb's destination must be a register; a spilled result
        // sinks a full zero-extended qword so the slot's upper bytes
        // never carry garbage into a later wide reload
        if (self.valueIsSpill(&inst->base))
        {
            self.emitter.emit("\tmovzbq %r11b, %r10");
            self.emitter.emitLine("");
            self.emitter.emit("\tmovq %r10, ");
            self.emitter.emitLine(dst);
        }
        else
        {
            self.emitter.emit("\tmovzbq %r11b, ");
            self.emitter.emitLine(dst);
        }
        return true;
    }

    // XOR -1 → NOT

    bool iselTryFoldNot(IrInst* inst, str dst, str src1)
    {
        if (inst->opcode != IrOpcode::Xor) return false;
        if (inst->nops < 2) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        if (c != 0xFFFFFFFFFFFFFFFFUL) return false;
        if (!src1.equals(dst))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        self.emitter.emit("\tnotq ");
        self.emitter.emitLine(dst);
        return true;
    }

    // ADD x, -1 → DEC; SUB x, 1 → DEC

    bool iselTryFoldIncDec(IrInst* inst, str dst, str src1)
    {
        if (inst->nops < 2) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[1], &c)) return false;
        bool isInc = (inst->opcode == IrOpcode::Add && c == 1)
                  || (inst->opcode == IrOpcode::Sub && c == 0xFFFFFFFFFFFFFFFFUL);
        bool isDec = (inst->opcode == IrOpcode::Add && c == 0xFFFFFFFFFFFFFFFFUL)
                  || (inst->opcode == IrOpcode::Sub && c == 1);
        if (!isInc && !isDec) return false;
        str opName = isInc ? "\tincq " : "\tdecq ";
        // both operands spilled: movq mem, mem is invalid, so bounce
        // src1 through r10, inc/dec there, and store back
        if (self.valueIsSpill(inst->ops[0]) && self.valueIsSpill(&inst->base))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %r10");
            self.emitter.emit(opName);
            self.emitter.emitLine("%r10");
            self.emitter.emit("\tmovq %r10, ");
            self.emitter.emitLine(dst);
            return true;
        }
        if (!src1.equals(dst))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        self.emitter.emit(opName);
        self.emitter.emitLine(dst);
        return true;
    }

    // NEG: 0 - x → neg

    bool iselTryFoldNeg(IrInst* inst, str dst, str src1)
    {
        if (inst->opcode != IrOpcode::Sub) return false;
        if (inst->nops < 2) return false;
        u64 c = 0;
        if (!self.iselIsConstInt(inst->ops[0], &c)) return false;
        if (c != 0) return false;
        str src2 = self.getRegForValue(inst->ops[1]);
        if (!src2.equals(dst))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src2);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        self.emitter.emit("\tnegq ");
        self.emitter.emitLine(dst);
        return true;
    }

    bool valueIsSpill(IrValue* val)
    {
        if (val == null) return false;
        if (val->kind != IrValueKind::Inst && val->kind != IrValueKind::Arg) return false;
        return (val->valData & 0x80000000UL) != 0;
    }

    // A value is float-typed either through the FLOAT_BIT (register
    // allocation) or, once spilled, only through its IR type — the spill
    // encoding does not carry the float flag.
    bool valueIsFloatClass(IrValue* val)
    {
        if (val == null || val->type == null) return false;
        return val->type->kind == IrTypeKind::Float;
    }

    bool valueIsVec(IrValue* val)
    {
        if (val == null || val->type == null) return false;
        return val->type->kind == IrTypeKind::Vector;
    }

    // Slot layout: every spilled vreg gets one slot of 16 bytes so vector
    // values fit; scalar ints store their 8-byte register with movq and
    // f32/f64 store 4/8 bytes with movss/movsd into the slot head. The
    // prologue pushes the saved callee saves first, then subtracts the
    // spill+alloca region, so slot i lives at -8*numCalleeSaves-16*(i+1)
    // (%rbp): the saves sit between rbp and the spill region. rbp is
    // established in the prologue whenever hasAny spill slot exists, so
    // the homes are stable for the whole function.
    str slotText(u32 slot)
    {
        String* b = textBufNext();
        b->pushChar('-');
        b->pushView(u32ToStr(8 * self.numCalleeSaves + (slot + 1) * 16));
        b->pushView("(%rbp)");
        return b->asView();
    }

    // Operand usable in hasAny position that accepts a memory operand:
    // the value's register name, or its spill-slot address text.
    str opFor(IrValue* v)
    {
        if (v == null) return "rax";
        if (v->kind == IrValueKind::StringConst)
        {
            // no home is allocated for a constant's address, so it lands
            // in the scratch every register-only consumer can read
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emitLine(", %r11");
            return "r11";
        }
        if (v->kind == IrValueKind::Global)
        {
            // a symbol has no home either: lea it into the same scratch
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(v->name, 0));
            self.emitter.emitLine(", %r11");
            return "r11";
        }
        if (valueIsIntConst(v)) return intImmText(v);
        u64 vd = v->valData;
        if (vd & 0x80000000UL)
            return self.slotText((u32)(vd & 0x3FFFFFFF));
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        str name = self.intRegNameFor(reg);
        if (name.len > 0) return name;
        return "rax";
    }

    // opFor's answer with no emission — for callers that only compare
    // homes (emitCall's parallel-copy planner asks whether a source's
    // home is the destination register). opFor materialises a
    // StringConst/Global with a leaq on every consult, so a query
    // through it produced one dead leaq per scan: three per call site.
    str homeOf(IrValue* v)
    {
        if (v == null) return "rax";
        if (v->kind == IrValueKind::StringConst) return "r11";
        if (v->kind == IrValueKind::Global) return "r11";
        if (valueIsIntConst(v)) return intImmText(v);
        u64 vd = v->valData;
        if (vd & 0x80000000UL)
            return self.slotText((u32)(vd & 0x3FFFFFFF));
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        str name = self.intRegNameFor(reg);
        if (name.len > 0) return name;
        return "rax";
    }

    // Immediate → dst in one short instruction. A value that fits in 32
    // bits moving to a register takes movl (which zeroes the upper half);
    // stack slots and wider values keep movabsq, because movl would leave
    // stale bytes in memory or drop the value's high half.
    void emitImmTo(u64 val, str dst)
    {
        bool paren = false;
        for (usize q = 0; q < dst.len; q++)
            if (dst.ptr[q] == (u8)'(') { paren = true; break; }
        if (!paren && val <= 0xFFFFFFFFUL)
        {
            self.emitter.emit("\tmovl $");
            self.emitter.emit(u64ToHex(val));
            self.emitter.emit(", ");
            self.emitter.emitLine(toReg32(dst));
        }
        else
        {
            self.emitter.emit("\tmovabsq $");
            self.emitter.emit(u64ToHex(val));
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    // the old name stays as an alias so every unconverted call site is
    // spill-correct for memory-accepting positions; register-only positions
    // go through opForReg/opForRegF instead
    str getRegForValue(IrValue* v)
    {
        return self.opFor(v);
    }

    // Forced register operand: a spill slot is loaded into the scratch
    // first, and a register-resident value is moved into the scratch
    // as well, so the caller always gets a value in the scratch register.
    str opForReg(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (v->kind == IrValueKind::StringConst)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (v->kind == IrValueKind::Global)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(v->name, 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (valueIsIntConst(v))
        {
            self.emitImmTo(v->valData, scratch);
            return scratch;
        }
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        str home = self.opFor(v);
        if (!home.equals(scratch))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(home);
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
        }
        return scratch;
    }

    // Register operand for a position that accepts ANY general-purpose
    // register — a lea's SIB base, a memory operand's address. A spill
    // reloads through the scratch and a constant is materialised there
    // (neither can appear directly in a SIB/address encoding), but a
    // register-resident value is used in place: opForReg would emit a
    // mov into the scratch that buys nothing when the home already
    // satisfies the encoding.
    str opForRegInPlace(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (v->kind == IrValueKind::StringConst)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (valueIsIntConst(v))
        {
            self.emitImmTo(v->valData, scratch);
            return scratch;
        }
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        return self.opFor(v);
    }

    str opForRegF(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (self.valueIsSpill(v))
        {
            bool isVec = self.valueIsVec(v);
            bool dbl = v->type != null && v->type->width == 64;
            self.emitter.emit("\t");
            self.emitter.emit(isVec ? "movdqa " : (dbl ? "movsd " : "movss "));
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        str home = self.opFor(v);
        if (!home.equals(scratch))
        {
            bool isVec = self.valueIsVec(v);
            bool dbl = v->type != null && v->type->width == 64;
            self.emitter.emit("\t");
            self.emitter.emit(isVec ? "movdqa " : (dbl ? "movsd " : "movss "));
            self.emitter.emit(home);
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
        }
        return scratch;
    }

    // Destination for producing a value: a spill slot's value is
    // collected in a scratch (the producing op overwrites it, so the
    // old slot content is never worth a reload), while a
    // register-resident value is produced straight into its home.
    str outForInt(IrValue* v, str scratch)
    {
        if (v != null && self.valueIsSpill(v)) return scratch;
        return self.opFor(v);
    }

    str outForF(IrValue* v, str scratch)
    {
        if (v != null && self.valueIsSpill(v)) return scratch;
        return self.opFor(v);
    }

    // Write a register's value back to its home — the slot when the
    // value spilled, otherwise the allocated register (mov only when
    // the homes differ), width-aware so a spilled narrow value isn't
    // written with a full-width mov.
    void sinkInt(IrValue* v, str reg)
    {
        if (v == null) return;
        u32 w = v->type != null ? v->type->width : 64;
        str mv = w == 8 ? "movb " : w == 16 ? "movw " : w == 32 ? "movl " : "movq ";
        str r = w == 8 ? toReg8(reg) : w == 16 ? toReg16(reg) : w == 32 ? toReg32(reg) : reg;
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            return;
        }
        str home = self.opFor(v);
        if (!home.equals(reg))
        {
            str h = w == 8 ? toReg8(home) : w == 16 ? toReg16(home) : w == 32 ? toReg32(home) : home;
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(h);
        }
    }

    u32 countSpillSlots(IrFunc* func)
    {
        bool hasAny = false;
        u32 max = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u64 vd = inst->base.valData;
                if ((vd & 0x80000000UL) != 0)
                {
                    u32 idx = (u32)(vd & 0x3FFFFFFF);
                    if (!hasAny || idx > max) max = idx;
                    hasAny = true;
                }
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* o = inst->ops[oi];
                    if (o == null) continue;
                    if (o->kind != IrValueKind::Inst) continue;
                    u64 ov = o->valData;
                    if ((ov & 0x80000000UL) != 0)
                    {
                        u32 idx = (u32)(ov & 0x3FFFFFFF);
                        if (!hasAny || idx > max) max = idx;
                        hasAny = true;
                    }
                }
            }
        }
        return hasAny ? max + 1 : 0;
    }

    void emitInst(IrInst* inst)
    {
        // A foldable binop whose result is read only by stores that fuse into
        // a memory-operand form is omitted entirely: the store reconstructs
        // the value in memory from this op's own operands, so its register
        // result would be dead (the `inc` before `store i+1, i` that folds to
        // `add $1,(i)` — the unfused `inc` would just be dead work).
        switch (inst->opcode)
        {
            IrOpcode::Add | IrOpcode::Sub | IrOpcode::And | IrOpcode::Or | IrOpcode::Xor => {
                if (self.opFeedsOnlyFusedStores(inst)) return;
            },
            else => { }
        }
        switch (inst->opcode)
        {
            IrOpcode::Add => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.iselTryFoldIncDec(inst, dst, src1))
            {
                if (!self.trySelect(inst, dst, src1, src2))
                    self.emitBinOp(inst, "addq", "addl");
            }
            },
            IrOpcode::Sub => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            if (!self.iselTryFoldNeg(inst, dst, src1))
            {
                if (!self.iselTryFoldIncDec(inst, dst, src1))
                {
                    str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
                    if (!self.trySelect(inst, dst, src1, src2))
                        self.emitBinOp(inst, "subq", "subl");
                }
            }
            },
            IrOpcode::Mul => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitBinOp(inst, "imulq", "imull");
            },
            IrOpcode::SDiv => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitDiv(inst, true);
            },
            IrOpcode::UDiv => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitDiv(inst, false);
            },
            IrOpcode::SRem => { self.emitRem(inst, true); },
            IrOpcode::URem => { self.emitRem(inst, false); },
            IrOpcode::And => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitBinOp(inst, "andq", "andl");
            },
            IrOpcode::Or => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitBinOp(inst, "orq", "orl");
            },
            IrOpcode::Xor => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.iselTryFoldNot(inst, dst, src1))
            {
                if (!self.trySelect(inst, dst, src1, src2))
                    self.emitBinOp(inst, "xorq", "xorl");
            }
            },
            IrOpcode::Shl => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitShift(inst, "shlq", "shll");
            },
            IrOpcode::Ashr => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitShift(inst, "sarq", "sarl");
            },
            IrOpcode::Lshr => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
            if (!self.trySelect(inst, dst, src1, src2))
                self.emitShift(inst, "shrq", "shrl");
            },
            IrOpcode::Neg => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            if (!src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            self.emitter.emit("\tnegq ");
            self.emitter.emitLine(dst);
            },
            IrOpcode::Not => {
            str dst = self.getRegForValue(&inst->base);
            str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
            if (!src1.equals(dst))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            }
            self.emitter.emit("\tnotq ");
            self.emitter.emitLine(dst);
            },
            IrOpcode::Load => {
            if (!self.iselTryFoldGepLoad(inst))
                self.emitLoadWidth(inst);
            },
            IrOpcode::Store => {
            if (!self.iselTryFoldLoadOpStore(inst))
            {
                if (!self.iselTryFoldGepStore(inst))
                    self.emitStoreWidth(inst);
            }
            },
            IrOpcode::Alloca => { self.emitAlloca(inst); },
            IrOpcode::Gep => { self.emitGep(inst); },
            IrOpcode::ICmp => {
            if (!self.iselSkipFusedICmp(inst) && !self.iselTryFoldCmpZero(inst))
                self.emitICmp(inst);
            },
            IrOpcode::FCmp => { self.emitFCmp(inst); },
            IrOpcode::Br => { self.emitBr(inst); },
            IrOpcode::CondBr => { self.emitCondBr(inst); },
            IrOpcode::Ret => { self.emitRet(inst); },
            IrOpcode::Trunc |
            IrOpcode::Zext |
            IrOpcode::Sext |
            IrOpcode::Bitcast => {
            // the ext-load fold reads the ADDRESS register at emission
            // time, but LSRA only keeps that address live until the load
            // — its home may already belong to another value (seen:
            // `movzbl (%rdi), …` after rdi was reused), which either
            // reads through garbage or faults. Emit load + zext
            // separately until the fold runs pre-regalloc or the
            // allocator marks fold-safe sites.
            // if (inst->opcode == IrOpcode::Zext ||
            //     inst->opcode == IrOpcode::Sext)
            // {
            //     if (self.iselTryFoldExtLoad(inst))
            //         break;
            // }
            self.emitCast(inst);
            },
            IrOpcode::SiToFp => { self.emitSiToFp(inst); },
            IrOpcode::FpToSi => { self.emitFpToSi(inst); },
            IrOpcode::FpTrunc |
            IrOpcode::FpExt |
            IrOpcode::UiToFp |
            IrOpcode::FpToUi => { self.emitFcvt(inst); },
            IrOpcode::FAdd => { self.emitFloatBinOp(inst, "addss", "addsd"); },
            IrOpcode::FSub => { self.emitFloatBinOp(inst, "subss", "subsd"); },
            IrOpcode::FMul => { self.emitFloatBinOp(inst, "mulss", "mulsd"); },
            IrOpcode::FDiv => { self.emitFloatBinOp(inst, "divss", "divsd"); },
            IrOpcode::Fma => { self.emitFma(inst); },
            IrOpcode::FAbs => { self.emitFabs(inst); },
            IrOpcode::FSqrt => { self.emitSqrt(inst); },
            IrOpcode::Call => { self.emitCall(inst); },
            IrOpcode::Select => { self.emitSelect(inst); },
            IrOpcode::VecAdd => { self.emitVecBinOp(inst, "add"); },
            IrOpcode::VecSub => { self.emitVecBinOp(inst, "sub"); },
            IrOpcode::VecMul => { self.emitVecBinOp(inst, "mul"); },
            // kind 0 = signed divide: no packed integer divide exists
            // before avx512, so every lane walks the gprs — the operands
            // park in a memory window, which also keeps the path free of
            // the sse41-only pextr/pinsr the old loop needed
            IrOpcode::VecDiv => { self.emitVecLaneOp(inst, 0); },
            IrOpcode::VecFAdd => { self.emitVecFloatBinOp(inst, "addps", "addpd"); },
            IrOpcode::VecFSub => { self.emitVecFloatBinOp(inst, "subps", "subpd"); },
            IrOpcode::VecFMul => { self.emitVecFloatBinOp(inst, "mulps", "mulpd"); },
            IrOpcode::VecFDiv => { self.emitVecFloatBinOp(inst, "divps", "divpd"); },
            IrOpcode::VecMin => { self.emitVecMinMax(inst, true); },
            IrOpcode::VecMax => { self.emitVecMinMax(inst, false); },
            IrOpcode::VecBroadcast => { self.emitBroadcast(inst); },
            IrOpcode::ExtractElement => { self.emitExtractElem(inst); },
            IrOpcode::InsertElement => { self.emitInsertElem(inst); },
            IrOpcode::ShuffleVector => { self.emitShuffle(inst); },
            IrOpcode::Abs => { self.emitAbs(inst); },
            IrOpcode::CtPop => { self.emitCtPop(inst); },
            IrOpcode::CtLz => { self.emitCtLz(inst); },
            IrOpcode::CtTz => { self.emitCtTz(inst); },
            IrOpcode::Bswap => { self.emitBswap(inst); },
            IrOpcode::Rotl => { self.emitRot(inst, "rolq"); },
            IrOpcode::Rotr => { self.emitRot(inst, "rorq"); },
            IrOpcode::InlineAsm => { self.emitInlineAsm(inst); },
            IrOpcode::SMin => { self.emitMinMax(inst, "cmpnless", true, false); },
            IrOpcode::SMax => { self.emitMinMax(inst, "cmpnless", false, false); },
            IrOpcode::UMin => { self.emitMinMax(inst, "cmpnless", true, true); },
            IrOpcode::UMax => { self.emitMinMax(inst, "cmpnless", false, true); },
            else => { self.emitter.emitComment("unhandled opcode"); },
        }
    }

    // Matches lsra's isCommutativeOp: regalloc coalesces the destination
    // with operand 1 only for these opcodes, and the two-address emitters
    // swap the operands back (Option B) so the result is unchanged.
    bool isCommutativeX86(IrOpcode op)
    {
        return op == IrOpcode::Add || op == IrOpcode::Mul
            || op == IrOpcode::And || op == IrOpcode::Or || op == IrOpcode::Xor
            || op == IrOpcode::FAdd || op == IrOpcode::FMul;
    }

    void emitBinOp(IrInst* inst, str qOp, str lOp)
    {
        IrValue* av = inst->nops > 0 ? inst->ops[0] : null;
        IrValue* bv = inst->nops > 1 ? inst->ops[1] : null;
        str dst = self.getRegForValue(&inst->base);
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "r10" : dst;
        u32 width = inst->base.type != null ? inst->base.type->width : 64;
        str src1 = av != null ? self.getRegForValue(av) : "rax";
        str src2 = bv != null ? self.getRegForValue(bv) : "rdx";
        if (width == 64)
        {
            // add with the immediate in operand 0: one lea from operand
            // 1's register instead of a materialized constant plus the
            // two-address op (`movq $1,%rdi; addq %r9,%rdi` →
            // `leaq 1(%r9),%rdi`). lea's displacement is signed 32 bits,
            // so only immediates that fit it take this path; a zero
            // displacement degenerates into the move it would have been.
            if (inst->opcode == IrOpcode::Add && valueIsIntConst(av) &&
                bv != null && !valueIsIntConst(bv))
            {
                u64 imm = av->valData;
                u64 hi = imm & 0xFFFFFFFF00000000UL;
                bool fits = hi == 0 ? (imm <= 0x7FFFFFFFUL)
                          : (hi == 0xFFFFFFFF00000000UL) && (imm >= 0xFFFFFFFF80000000UL);
                if (fits)
                {
                    str sr = self.valueIsSpill(bv)
                           ? self.opForReg(bv, "r11")
                           : self.getRegForValue(bv);
                    if ((i64)imm == 0)
                    {
                        if (!sr.equals(work))
                        {
                            self.emitter.emit("\tmovq ");
                            self.emitter.emit(sr);
                            self.emitter.emit(", ");
                            self.emitter.emitLine(work);
                        }
                    }
                    else
                    {
                        self.emitter.emit("\tleaq ");
                        self.emitter.emit(i64ToDec((i64)imm));
                        self.emitter.emit("(");
                        self.emitter.emit(sr);
                        self.emitter.emit("), ");
                        self.emitter.emitLine(work);
                    }
                    if (dstSpill) self.sinkInt(&inst->base, "r10");
                    return;
                }
            }
            str opSrc = src2;
            if (src1.equals(work))
            {
                // dst already holds operand 0 (operand-0 coalescing) —
                // the plain two-address form applies as-is
            }
            else if (work.equals(src2) && self.isCommutativeX86(inst->opcode))
            {
                // Option B: dst reused operand 1's register. The op is
                // commutative, so `OP src1, work` computes src1 OP src2 —
                // no copy at all instead of a clobbering one
                opSrc = src1;
            }
            else
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            self.emitter.emit("\t");
            self.emitter.emit(qOp);
            self.emitter.emit(" ");
            self.emitter.emit(opSrc);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
        }
        else
        {
            if (av == null || valueIsIntConst(av) || self.valueIsSpill(av))
                src1 = self.opForReg(av, "r10");
            if (bv == null || valueIsIntConst(bv) || self.valueIsSpill(bv))
                src2 = self.opForReg(bv, "r11");
            str w32 = toReg32(work);
            str s1 = toReg32(src1);
            str s2 = toReg32(src2);
            str opSrc = s2;
            if (s1.equals(w32))
            {
                // dst already holds operand 0
            }
            else if (w32.equals(s2) && self.isCommutativeX86(inst->opcode))
            {
                // Option B: dst reused operand 1's register (see 64-bit path)
                opSrc = s1;
            }
            else
            {
                self.emitter.emit("\tmovl ");
                self.emitter.emit(s1);
                self.emitter.emit(", ");
                self.emitter.emitLine(w32);
            }
            self.emitter.emit("\t");
            self.emitter.emit(lOp);
            self.emitter.emit(" ");
            self.emitter.emit(opSrc);
            self.emitter.emit(", ");
            self.emitter.emitLine(w32);
            if (width == 16)
            {
                self.emitter.emit("\tmovzwl ");
                self.emitter.emit(toReg16(work));
                self.emitter.emit(", ");
                self.emitter.emitLine(w32);
            }
            else if (width == 8)
            {
                self.emitter.emit("\tmovzbl ");
                self.emitter.emit(toReg8(work));
                self.emitter.emit(", ");
                self.emitter.emitLine(w32);
            }
        }
        if (dstSpill) self.sinkInt(&inst->base, "r10");
    }

void emitIntExtendTo(str src, str dst32, u32 width, bool isSigned)
{
    if (width == 32)
    {
        self.emitter.emit("\tmovl ");
        self.emitter.emit(toReg32(src));
    }
    else if (width == 16)
    {
        self.emitter.emit(isSigned ? "\tmovswl " : "\tmovzwl ");
        self.emitter.emit(toReg16(src));
    }
    else
    {
        self.emitter.emit(isSigned ? "\tmovsbl " : "\tmovzbl ");
        self.emitter.emit(toReg8(src));
    }
    self.emitter.emit(", ");
    self.emitter.emitLine(dst32);
}

    void emitDiv(IrInst* inst, bool isSigned)
    {
        self.emitDivRemCore(inst, isSigned, false);
    }

    void emitRem(IrInst* inst, bool isSigned)
    {
        self.emitDivRemCore(inst, isSigned, true);
    }

    void emitDivRemCore(IrInst* inst, bool isSigned, bool isRem)
    {
        IrValue* av = inst->nops > 0 ? inst->ops[0] : null;
        IrValue* bv = inst->nops > 1 ? inst->ops[1] : null;
        str dst = self.getRegForValue(&inst->base);
        bool dstSpill = self.valueIsSpill(&inst->base);
        u32 width = inst->base.type != null ? inst->base.type->width : 64;
        if (width == 64)
        {
            str src1 = av != null
                              ? (valueIsIntConst(av) ? self.opForReg(av, "r10")
                                                     : self.getRegForValue(av))
                              : "rax";
            str src2 = bv != null
                              ? (valueIsIntConst(bv) ? self.opForReg(bv, "r11")
                                                     : self.getRegForValue(bv))
                              : "rcx";
            if (src2.equals("rax") || src2.equals("rdx"))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %rcx");
                src2 = "rcx";
            }
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src1);
            self.emitter.emitLine(", %rax");
            if (isSigned) self.emitter.emitTab("cqo");
            else self.emitter.emitTab("xorl %edx, %edx");
            self.emitter.emit("\t");
            self.emitter.emit(isSigned ? "idivq" : "divq");
            self.emitter.emit(" ");
            self.emitter.emitLine(src2);
            self.emitter.emit(isRem ? "\tmovq %rdx, " : "\tmovq %rax, ");
            self.emitter.emitLine(dst);
            return;
        }

        str src1 = av != null
                          ? (valueIsIntConst(av) || self.valueIsSpill(av)
                                     ? self.opForReg(av, "r10")
                                     : self.getRegForValue(av))
                          : "rax";
        str src2 = bv != null
                          ? (valueIsIntConst(bv) || self.valueIsSpill(bv)
                                     ? self.opForReg(bv, "r11")
                                     : self.getRegForValue(bv))
                          : "rcx";
        self.emitIntExtendTo(src1, "%eax", width, isSigned);
        self.emitIntExtendTo(src2, "%ecx", width, isSigned);
        if (isSigned) self.emitter.emitTab("cltd");
        else self.emitter.emitTab("xorl %edx, %edx");
        self.emitter.emit("\t");
        self.emitter.emit(isSigned ? "idivl" : "divl");
        self.emitter.emitLine(" %ecx");
        str res = isRem ? "rdx" : "rax";
        str work = dstSpill ? "r10" : dst;
        if (width == 32)
        {
            self.emitter.emit("\tmovl ");
            self.emitter.emit(toReg32(res));
            self.emitter.emit(", ");
            self.emitter.emitLine(toReg32(work));
        }
        else if (width == 16)
        {
            self.emitter.emit("\tmovzwl ");
            self.emitter.emit(toReg16(res));
            self.emitter.emit(", ");
            self.emitter.emitLine(toReg32(work));
        }
        else
        {
            self.emitter.emit("\tmovzbl ");
            self.emitter.emit(toReg8(res));
            self.emitter.emit(", ");
            self.emitter.emitLine(toReg32(work));
        }
        if (dstSpill) self.sinkInt(&inst->base, "r10");
    }

    void emitShift(IrInst* inst, str qOp, str lOp)
    {
        IrValue* av = inst->nops > 0 ? inst->ops[0] : null;
        IrValue* bv = inst->nops > 1 ? inst->ops[1] : null;
        str dst = self.getRegForValue(&inst->base);
        bool dstSpill = self.valueIsSpill(&inst->base);
        bool needSink = dstSpill || dst.equals("rcx");
        str work = needSink ? "r10" : dst;
        u32 width = inst->base.type != null ? inst->base.type->width : 64;
        str src1 = av != null ? self.getRegForValue(av) : "rax";
        str src2 = bv != null ? self.getRegForValue(bv) : "rcx";
        if (width == 64)
        {
            if (!src1.equals(work))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            if (!src2.equals("rcx"))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %rcx");
            }
            self.emitter.emit("\t");
            self.emitter.emit(qOp);
            self.emitter.emit(" %cl, ");
            self.emitter.emitLine(work);
        }
        else
        {
            if (av == null || valueIsIntConst(av) || self.valueIsSpill(av))
                src1 = self.opForReg(av, "r10");
            if (bv == null || valueIsIntConst(bv) || self.valueIsSpill(bv))
                src2 = self.opForReg(bv, "r11");
            str s1 = toReg32(src1);
            str w32 = toReg32(work);
            str sN = width == 32 ? s1 : width == 16 ? toReg16(src1) : toReg8(src1);
            str wN = width == 32 ? w32 : width == 16 ? toReg16(work) : toReg8(work);
            if (!sN.equals(wN))
            {
                self.emitter.emit("\t");
                self.emitter.emit(width == 32 ? "movl " : width == 16 ? "movw " : "movb ");
                self.emitter.emit(sN);
                self.emitter.emit(", ");
                self.emitter.emitLine(wN);
            }
            if (!src2.equals("rcx"))
            {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src2);
                self.emitter.emitLine(", %rcx");
            }
            self.emitter.emit("\t");
            self.emitter.emit(narrowOp(lOp, width));
            self.emitter.emit(" %cl, ");
            self.emitter.emitLine(wN);
            if (width == 16)
            {
                self.emitter.emit("\tmovzwl ");
                self.emitter.emit(wN);
                self.emitter.emit(", ");
                self.emitter.emitLine(w32);
            }
            else if (width == 8)
            {
                self.emitter.emit("\tmovzbl ");
                self.emitter.emit(wN);
                self.emitter.emit(", ");
                self.emitter.emitLine(w32);
            }
        }
        if (dstSpill) self.sinkInt(&inst->base, "r10");
        else if (needSink)
        {
            self.emitter.emit("\tmovq r10, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitUnOp(IrInst* inst, str qOp, str lOp)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "r10" : dst;
        if (!src.equals(work))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
        }
        self.emitter.emit("\t");
        self.emitter.emit(qOp);
        self.emitter.emit(" ");
        self.emitter.emitLine(work);
        if (dstSpill)
        {
            self.emitter.emit("\tmovq r10, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitLoad(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        // the address must be a register, a spilled address reloads first
        str src = (inst->nops > 0) ? self.opForReg(inst->ops[0], "r10") : "rax";
        self.emitter.emit("\tmovq (");
        self.emitter.emit(src);
        self.emitter.emit("), ");
        self.emitter.emitLine(dst);
    }

    void emitStore(IrInst* inst)
    {
        str src = (inst->nops > 0)
                          ? (valueIsIntConst(inst->ops[0])
                                     ? self.opForReg(inst->ops[0], "r11")
                                     : self.getRegForValue(inst->ops[0]))
                          : "rax";
        str dst = (inst->nops > 1) ? self.opForReg(inst->ops[1], "r10") : "r10";
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src);
        self.emitter.emit(", (");
        self.emitter.emit(dst);
        self.emitter.emitLine(")");
    }

    void emitAlloca(IrInst* inst)
    {
        u32 off = 0;
        if (self.currentFuncHasFrame &&
            self.allocaSlotOf(self.currentFunc, &inst->base, &off))
        {
            // the prologue already cut the region out — just point at
            // this alloca's slice of it
            str dst = self.getRegForValue(&inst->base);
            bool dstSpill = self.valueIsSpill(&inst->base);
            str work = dstSpill ? "r10" : dst;
            self.emitter.emit("\tleaq -");
            self.emitter.emitU32(off);
            self.emitter.emit("(%rbp), ");
            self.emitter.emitLine(work);
            if (dstSpill)
            {
                self.emitter.emit("\tmovq r10, ");
                self.emitter.emitLine(dst);
            }
            return;
        }
        // nothing to hang the region on (no frame, or the walk did not
        // find this alloca): take the bytes straight off rsp; the size
        // is 16-aligned, so the stack stays aligned for calls
        u32 sz = self.allocaSlotSize(inst);
        str buf = u32ToStr(sz);
        self.emitter.emit("\tsubq $");
        self.emitter.emit(buf);
        self.emitter.emitLine(", %rsp");
        self.emitter.emit("\tmovq %rsp, ");
        self.emitter.emitLine(self.getRegForValue(&inst->base));
    }

    void emitGep(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        bool dstSpill0 = self.valueIsSpill(&inst->base);
        // a constant rodata address needs no base materialization: one
        // lea from %rip, straight into the destination (or r10 + sink)
        str constLbl;
        i64 constLblOff = 0;
        if (self.constAddrOf(&inst->base, &constLbl, &constLblOff))
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(constLbl, constLblOff));
            self.emitter.emit(", ");
            self.emitter.emitLine(dstSpill0 ? "r10" : dst);
            if (dstSpill0) self.sinkInt(&inst->base, "r10");
            return;
        }
        // sib parts are register-only, spills reload into the scratches;
        // a base already in a register goes straight into the lea
        str base = (inst->nops > 0) ? self.opForRegInPlace(inst->ops[0], "r10") : "rax";
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "r10" : dst;

        // Strides follow the parser's type walk: each index descends one
        // aggregate level, so an array index steps by the size of the
        // type it lands on — C element indexing. sizeOf(pointee) made
        // every ptr-to-array gep jump the whole array (N elements) per
        // step, which happened to work only while no spill slot shared
        // the mis-strided addresses.
        IrType* rt = null;
        if (inst->nops > 0 && inst->ops[0] != null && inst->ops[0]->type != null)
        {
            IrType* pt = inst->ops[0]->type;
            rt = pt->kind == IrTypeKind::Ptr ? pt->elem : pt;
        }

        i64 constOff = 0;
        bool haveDyn = false;
        u32 leaScale = 1; // SIB scale deferred to the final lea
        str idxReg = "r11"; // where the dynamic index rides (its home when nothing needs the scratch)
        for (u32 k = 1; k < inst->nops && rt != null; k++)
        {
            IrValue* iv = inst->ops[k];
            if (iv == null) break;

            if (rt->kind == IrTypeKind::Struct)
            {
                // parser requires a constant field index; layout offset
                // mirrors createStructType's align-then-place walk
                if (!valueIsIntConst(iv)) break;
                u32 fi = (u32)(iv->valData & 0xFFFFFFFF);
                if (fi >= rt->nparams) break;
                u32 off = 0;
                for (u32 f = 0; f < rt->nparams; f++)
                {
                    u32 al = self.ctx.irTypeAlignOf(rt->params[f]);
                    if (al > 1) off = (off + al - 1u) / al * al;
                    if (f == fi) break;
                    off += self.ctx.irTypeSizeOf(rt->params[f]);
                }
                constOff += (i64)off;
                rt = rt->params[fi];
                continue;
            }
            if (rt->kind != IrTypeKind::Array && rt->kind != IrTypeKind::Vector)
                break; // scalar: parser rejects with "index into non-aggregate"
            u32 stride = self.ctx.irTypeSizeOf(rt->elem);
            if (stride == 0) stride = 1;

            if (valueIsIntConst(iv))
            {
                i64 c = (i64)iv->valData;
                u32 iw = iv->type != null ? iv->type->width : 64;
                if (iw < 64 && iw > 0 && (c & ((i64)1 << (i64)(iw - 1))) != 0)
                    c |= ~(((i64)1 << (i64)iw) - 1);
                constOff += c * (i64)stride;
            }
            else if (!haveDyn)
            {
                u32 iw = iv->type != null ? iv->type->width : 64;
                bool last = (k + 1 == inst->nops);
                bool sibStride = (stride == 2 || stride == 4 || stride == 8);
                // The first dynamic index can ride in its own home: when
                // it is full width (no sign-extension), its stride is one
                // the final lea can express (no pre-lea multiply), and
                // that home collides with neither base, destination, nor
                // rax (the scratch a second dynamic index folds through),
                // nothing downstream needs r11 — one lea, no copy into
                // the scratch.
                bool stay = iw == 64 && !self.valueIsSpill(iv) &&
                            (stride == 1 || (sibStride && last));
                if (stay)
                {
                    str home = self.getRegForValue(iv);
                    if (home.equals(base) || home.equals(work) ||
                        home.equals("rax"))
                        stay = false;
                    else
                        idxReg = home;
                }
                if (stay)
                {
                    if (sibStride && last) leaScale = stride;
                }
                else
                {
                    idxReg = "r11";
                    self.opForReg(iv, "r11");
                    if (iw == 32) self.emitter.emitLine("\tmovslq %r11d, %r11");
                    else if (iw == 16) self.emitter.emitLine("\tmovswq %r11w, %r11");
                    else if (iw == 8) self.emitter.emitLine("\tmovsbq %r11b, %r11");
                    if (sibStride)
                    {
                        // only the last index may ride the lea's SIB scale;
                        // an index behind it needs its product right now
                        if (last) leaScale = stride;
                        else if (stride > 1)
                        {
                            self.emitter.emit("\timulq $");
                            self.emitter.emit(u32ToStr(stride));
                            self.emitter.emitLine(", %r11");
                        }
                    }
                    else if (stride > 1)
                    {
                        self.emitter.emit("\timulq $");
                        self.emitter.emit(u32ToStr(stride));
                        self.emitter.emitLine(", %r11");
                    }
                }
                haveDyn = true;
            }
            else
            {
                // extra dynamic index: scale in rax, fold into r11
                self.opForReg(iv, "rax");
                u32 iw = iv->type != null ? iv->type->width : 64;
                if (iw == 32) self.emitter.emitLine("\tmovslq %eax, %rax");
                else if (iw == 16) self.emitter.emitLine("\tmovswq %ax, %rax");
                else if (iw == 8) self.emitter.emitLine("\tmovsbq %al, %rax");
                if (stride > 1)
                {
                    self.emitter.emit("\timulq $");
                    self.emitter.emit(u32ToStr(stride));
                    self.emitter.emitLine(", %rax");
                }
                self.emitter.emit("\taddq %rax, %");
                self.emitter.emitLine(idxReg);
            }
            rt = rt->elem;
        }

        if (!haveDyn)
        {
            if (constOff >= -2147483648 && constOff <= 2147483647)
            {
                self.emitter.emit("\tleaq ");
                if (constOff != 0) self.emitter.emit(i64ToDec(constOff));
                self.emitter.emit("(");
                self.emitter.emit(base);
                self.emitter.emit("), ");
                self.emitter.emitLine(work);
            }
            else
            {
                self.emitImmTo((u64)constOff, "r11");
                self.emitter.emit("\tleaq (");
                self.emitter.emit(base);
                self.emitter.emit(", %r11, 1), ");
                self.emitter.emitLine(work);
            }
            if (dstSpill) self.sinkInt(&inst->base, "r10");
            return;
        }

        str disp = "";
        if (constOff != 0)
        {
            if (constOff >= -2147483648 && constOff <= 2147483647)
            {
                disp = i64ToDec(constOff);
            }
            else
            {
                self.emitImmTo((u64)constOff, "rax");
                self.emitter.emit("\taddq %rax, %");
                self.emitter.emitLine(idxReg);
            }
        }
        self.emitter.emit("\tleaq ");
        self.emitter.emit(disp);
        self.emitter.emit("(");
        self.emitter.emit(base);
        self.emitter.emit(", %");
        self.emitter.emit(idxReg);
        self.emitter.emit(", ");
        self.emitter.emit(u32ToStr(leaScale));
        self.emitter.emit("), ");
        self.emitter.emitLine(work);
        if (dstSpill) self.sinkInt(&inst->base, "r10");
    }

    void emitICmp(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rdx";
        if (inst->nops > 0 && valueIsIntConst(inst->ops[0]))
            src1 = self.opForReg(inst->ops[0], "r10");
        if (inst->nops > 1 && valueIsIntConst(inst->ops[1]))
            src2 = self.opForReg(inst->ops[1], "r11");
        // cmp takes one memory operand at most, two spills need a reload
        if (self.valueIsSpill(inst->ops[0]) && self.valueIsSpill(inst->ops[1]))
            src1 = self.opForReg(inst->ops[0], "r10");
        u32 width = inst->ops[0] != null && inst->ops[0]->type != null
                          ? inst->ops[0]->type->width : 64;
        str cmpOp = width == 64 ? "cmpq " : width == 32 ? "cmpl "
                          : width == 16 ? "cmpw " : "cmpb ";
        if (width != 64)
        {
            src1 = self.valueIsSpill(inst->ops[0]) ? src1
                          : width == 32 ? toReg32(src1)
                          : width == 16 ? toReg16(src1) : toReg8(src1);
            src2 = self.valueIsSpill(inst->ops[1]) ? src2
                          : width == 32 ? toReg32(src2)
                          : width == 16 ? toReg16(src2) : toReg8(src2);
        }
        self.emitter.emit("\t");
        self.emitter.emit(cmpOp);
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(src1);
        u32 pred = (u32)inst->icmpPred;
        str setOp = pred < 10 ? SETCC_INT[pred] : "sete";
        self.emitter.emit("\t");
        self.emitter.emit(setOp);
        self.emitter.emit(" %r11b");
        self.emitter.emitLine("");
        if (self.valueIsSpill(&inst->base))
        {
            self.emitter.emit("\tmovzbq %r11b, %r10");
            self.emitter.emitLine("");
            self.emitter.emit("\tmovq %r10, ");
            self.emitter.emitLine(dst);
        }
        else
        {
            self.emitter.emit("\tmovzbq %r11b, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitFCmp(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        // the second ucomiss operand must be a register, a spill reloads
        str src1 = (inst->nops > 0) ? self.opForRegF(inst->ops[0], "xmm0") : "xmm0";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "xmm1";
        bool isDouble = inst->ops[0]->type != null && inst->ops[0]->type->width == 64;
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? "ucomisd\t" : "ucomiss\t");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(src1);
        // ucomiss raises PF on unordered, so ordered preds mask it out and
        // unordered preds fold it in; the old one-cc mapping got both wrong
        str cc1;
        u32 mode = 0; // 0 = cc1 alone, 1 = and with setnp, 2 = or with setp
        switch (inst->fcmpPred)
        {
            IrFCmpPred::Oeq => { cc1 = "sete"; mode = 1; },
            IrFCmpPred::One => { cc1 = "setne"; mode = 1; },
            IrFCmpPred::Olt => { cc1 = "setb"; mode = 1; },
            IrFCmpPred::Ole => { cc1 = "setbe"; mode = 1; },
            IrFCmpPred::Ogt => { cc1 = "seta"; mode = 0; },
            IrFCmpPred::Oge => { cc1 = "setae"; mode = 1; },
            IrFCmpPred::Ueq => { cc1 = "sete"; mode = 2; },
            IrFCmpPred::Une => { cc1 = "setne"; mode = 2; },
            IrFCmpPred::Ult => { cc1 = "setb"; mode = 0; },
            IrFCmpPred::Ule => { cc1 = "setbe"; mode = 0; },
            IrFCmpPred::Ugt => { cc1 = "seta"; mode = 2; },
            IrFCmpPred::Uge => { cc1 = "setae"; mode = 2; },
            else => { cc1 = "sete"; mode = 0; }
        }
        self.emitter.emit("\t");
        self.emitter.emit(cc1);
        self.emitter.emitLine(" %r11b");
        if (mode == 1)
        {
            self.emitter.emitLine("\tsetnp %r10b");
            self.emitter.emitLine("\tand %r10b, %r11b");
        }
        else if (mode == 2)
        {
            self.emitter.emitLine("\tsetp %r10b");
            self.emitter.emitLine("\tor %r10b, %r11b");
        }
        // same spill rule as emitICmp: movzb needs a register target,
        // and a spilled i1 must land in its slot zero-extended to 64
        if (self.valueIsSpill(&inst->base))
        {
            self.emitter.emit("\tmovzbq %r11b, %r10");
            self.emitter.emitLine("");
            self.emitter.emit("\tmovq %r10, ");
            self.emitter.emitLine(dst);
        }
        else
        {
            self.emitter.emit("\tmovzbq %r11b, ");
            self.emitter.emitLine(dst);
        }
    }

    // GCC-style local label: a bare .L<number>. Block ids are unique within
    // a compilation (context-wide counter), so the label is file-local,
    // stable across jumps, and carries no IR block names (entry/if-then/...).
    void emitBlockLabel(IrBlock* bb)
    {
        self.emitter.emit(".L");
        self.emitter.emit(i64ToDec((i64)bb->base.id));
    }

    // Definition-site wrapper: the entry block's label is redundant (it sits
    // right under the function symbol) unless a branch targets it.
    void emitBlockDefinition(IrBlock* bb, bool isFirst)
    {
        if (isFirst && bb->npreds == 0) return;
        self.emitBlockLabel(bb);
        self.emitter.emitLine(":");
    }

    void emitBr(IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        self.tailJmpCall = null;
        if (inst->nops > 0 && inst->ops[0] != null)
        {
            IrBlock* target = (IrBlock*)inst->ops[0];
            // Branch to the block emitted directly underneath: control
            // already falls through, so the jmp instruction is omitted.
            if (self.blockFallsThrough(inst, target)) return;
            self.emitter.emit("\tjmp ");
            self.emitBlockLabel(target);
            self.emitter.emitLine("");
        }
    }

    // True when target is the block emitted immediately after inst's own
    // block. Every backend using this emitter walks func->blocks in order,
    // so control reaches target without a jump.
    bool blockFallsThrough(IrInst* inst, IrBlock* target)
    {
        if (inst == null || target == null) return false;
        IrBlock* cur = inst->parent;
        if (cur == null) return false;
        IrFunc* fn = cur->parent;
        if (fn == null) return false;
        for (u32 i = 0; i + 1 < fn->nblocks; i++)
        {
            if (fn->blocks[i] == cur) return fn->blocks[i + 1] == target;
        }
        return false;
    }

    // the cmp half of an icmp whose i1 dies at the next instruction:
    // flags only, no setcc materialization. The second operand folds
    // into the immediate form when it is a constant (`cmpq $2, %rdi`);
    // a constant *first* operand keeps its register, since AT&T has no
    // imm-first encoding and `imm - reg` is not `reg - imm` for the
    // ordered predicates.
    void emitCmpOperands(IrInst* cmp)
    {
        IrValue* a = cmp->nops > 0 ? cmp->ops[0] : null;
        IrValue* b = cmp->nops > 1 ? cmp->ops[1] : null;
        if (a == null || b == null) return;
        bool ca = valueIsIntConst(a);
        bool cb = valueIsIntConst(b);
        str ra = self.getRegForValue(a);
        str rb = self.getRegForValue(b);
        if (ca) ra = self.opForReg(a, "r10");
        // the immediate form only fires for a constant *second* operand;
        // when the first is also constant, both materialize
        if (cb && ca) rb = self.opForReg(b, "r11");
        // cmp takes one memory operand at most, two spills need a reload
        if (self.valueIsSpill(a) && self.valueIsSpill(b))
            ra = self.opForReg(a, "r10");
        u32 width = a->type != null ? a->type->width : 64;
        str mn = width == 64 ? "cmpq " : width == 32 ? "cmpl "
                      : width == 16 ? "cmpw " : "cmpb ";
        if (width != 64)
        {
            if (!self.valueIsSpill(a)) ra = width == 32 ? toReg32(ra) : width == 16 ? toReg16(ra) : toReg8(ra);
            if ((!cb || ca) && !self.valueIsSpill(b)) rb = width == 32 ? toReg32(rb) : width == 16 ? toReg16(rb) : toReg8(rb);
        }
        self.emitter.emit("\t");
        self.emitter.emit(mn);
        if (cb && !ca)
        {
            self.emitter.emit("$");
            self.emitter.emit(u64ToHex(b->valData));
            self.emitter.emit(", ");
            self.emitter.emitLine(ra);
            return;
        }
        self.emitter.emit(rb);
        self.emitter.emit(", ");
        self.emitter.emitLine(ra);
    }

    // true when `icmp` is the instruction right before `br` in the same
    // block — the compared registers cannot have moved in between, so
    // emitCondBr may re-emit the cmp and jump on its flags directly
    bool iselFusedBranchPair(IrInst* icmp, IrInst* br)
    {
        IrBlock* bb = icmp->parent;
        if (bb == null || bb->ninsts < 2) return false;
        if (bb->insts[bb->ninsts - 1] != br) return false;
        return bb->insts[bb->ninsts - 2] == icmp;
    }

    // the icmp half of a fused pair: emitCondBr re-emits the cmp, so the
    // setcc materialization is skipped here
    bool iselSkipFusedICmp(IrInst* inst)
    {
        if (inst->base.nusers != 1 || inst->base.users == null) return false;
        IrInst* u = inst->base.users[0];
        if (u == null || u->opcode != IrOpcode::CondBr || u->nops < 1 || u->ops[0] != &inst->base)
            return false;
        return self.iselFusedBranchPair(inst, u);
    }

    void emitCondBr(IrInst* inst)
    {
        self.lastCallTarget = "";
        self.lastCallResult = null;
        self.tailJmpCall = null;
        if (inst->nops >= 3)
        {
            IrBlock* trueTarget = (IrBlock*)inst->ops[1];
            IrBlock* falseTarget = (IrBlock*)inst->ops[2];
            if (valueIsIntConst(inst->ops[0]))
            {
                IrBlock* chosen = inst->ops[0]->valData != 0 ? trueTarget : falseTarget;
                if (self.blockFallsThrough(inst, chosen)) return;
                self.emitter.emit("\tjmp ");
                self.emitBlockLabel(chosen);
                self.emitter.emitLine("");
                return;
            }
            // an icmp feeding only this branch keeps its flags: the pair
            // fuses into `cmp` + one jcc (see JCC_INT_TRUE/FALSE)
            IrValue* cv = inst->ops[0];
            if (cv != null && cv->kind == IrValueKind::Inst)
            {
                IrInst* cmp = (IrInst*)cv;
                u32 pred = (u32)cmp->icmpPred;
                if (cmp->opcode == IrOpcode::ICmp && cmp->nops >= 2 && pred < 10
                    && cv->nusers == 1 && self.iselFusedBranchPair(cmp, inst))
                {
                    self.emitCmpOperands(cmp);
                    str jt = JCC_INT_TRUE[pred];
                    str jf = JCC_INT_FALSE[pred];
                    // same fallthrough policy as the testq path: branch
                    // only at the edge that does not fall through
                    if (self.blockFallsThrough(inst, falseTarget))
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(jt);
                        self.emitter.emit(" ");
                        self.emitBlockLabel(trueTarget);
                        self.emitter.emitLine("");
                        return;
                    }
                    if (self.blockFallsThrough(inst, trueTarget))
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(jf);
                        self.emitter.emit(" ");
                        self.emitBlockLabel(falseTarget);
                        self.emitter.emitLine("");
                        return;
                    }
                    self.emitter.emit("\t");
                    self.emitter.emit(jt);
                    self.emitter.emit(" ");
                    self.emitBlockLabel(trueTarget);
                    self.emitter.emitLine("");
                    self.emitter.emit("\tjmp ");
                    self.emitBlockLabel(falseTarget);
                    self.emitter.emitLine("");
                    return;
                }
            }
            str cond = self.valueIsSpill(inst->ops[0])
                ? self.opForReg(inst->ops[0], "r10")
                : self.getRegForValue(inst->ops[0]);
            self.emitter.emit("\ttestq ");
            self.emitter.emit(cond);
            self.emitter.emit(", ");
            self.emitter.emitLine(cond);
            // The edge landing on the next block falls through: keep only
            // the branch to the other edge. Invert the condition when the
            // true edge falls through.
            if (self.blockFallsThrough(inst, falseTarget))
            {
                self.emitter.emit("\tjne ");
                self.emitBlockLabel(trueTarget);
                self.emitter.emitLine("");
                return;
            }
            if (self.blockFallsThrough(inst, trueTarget))
            {
                self.emitter.emit("\tje ");
                self.emitBlockLabel(falseTarget);
                self.emitter.emitLine("");
                return;
            }
            self.emitter.emit("\tjne ");
            self.emitBlockLabel(trueTarget);
            self.emitter.emitLine("");
            self.emitter.emit("\tjmp ");
            self.emitBlockLabel(falseTarget);
            self.emitter.emitLine("");
        }
    }

    void emitCast(IrInst* inst)
    {
        str dstHome = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        u32 srcWidth = inst->ops[0] != null && inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
        u32 dstWidth = inst->base.type != null ? inst->base.type->width : 64;
        // x86 has no mem<-mem encoding, and the widen mnemonics
        // (movzbl/movslq/…) write a register only: when the destination
        // renders as memory, stage the finished value in the r11 scratch
        // and store it once below. Same-home moves are skipped entirely.
        bool dstMem = false;
        for (usize q = 0; q < dstHome.len; q++)
            if (dstHome.ptr[q] == (u8)'(') { dstMem = true; break; }
        bool stageDst = dstMem && !dstHome.equals(src);
        str dst = dstHome;
        if (stageDst)
        {
            dst = "r11";
            // movd takes a 32-bit or xmm destination, never r11 itself
            if (inst->opcode == IrOpcode::Bitcast && srcWidth == 32) dst = "r11d";
        }
        switch (inst->opcode)
        {
            IrOpcode::Trunc => {
                if (dst.equals(src))
                {
                    // same home: every reader of a trunc takes the low
                    // bits that are already in place — nothing to emit
                }
                else if (dstWidth == 32)
                {
                    self.emitter.emit("\tmovl ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (dstWidth == 16 && valueIsIntConst(inst->ops[0]))
                {
                    // movzwl's source is a byte/word register or memory, not
                    // an immediate: move the constant with movl and let the
                    // zero-extended 32-bit result carry the low 16 bits.
                    self.emitter.emit("\tmovl ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (dstWidth == 8 && valueIsIntConst(inst->ops[0]))
                {
                    self.emitter.emit("\tmovl ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (dstWidth == 16)
                {
                    self.emitter.emit("\tmovzwl ");
                    self.emitter.emit(toReg16(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (dstWidth == 8)
                {
                    self.emitter.emit("\tmovzbl ");
                    self.emitter.emit(toReg8(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
            },
            IrOpcode::Zext => {
                if (srcWidth == 32)
                {
                    self.emitter.emit("\tmovl ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (srcWidth == 16)
                {
                    self.emitter.emit("\tmovzwl ");
                    self.emitter.emit(toReg16(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else if (srcWidth == 8)
                {
                    self.emitter.emit("\tmovzbl ");
                    self.emitter.emit(toReg8(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg32(dst));
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
            },
            IrOpcode::Sext => {
                if (srcWidth == 32)
                {
                    self.emitter.emit("\tmovslq ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else if (srcWidth == 16)
                {
                    self.emitter.emit("\tmovswq ");
                    self.emitter.emit(toReg16(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else if (srcWidth == 8)
                {
                    self.emitter.emit("\tmovsbq ");
                    self.emitter.emit(toReg8(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
            },
            IrOpcode::Bitcast => {
                if (dst.equals(src))
                {
                    // same home: nothing to move
                }
                else if (srcWidth == 64)
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else if (srcWidth == 32)
                {
                    self.emitter.emit("\tmovd ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else if (srcWidth == 16)
                {
                    self.emitter.emit("\tmovw ");
                    self.emitter.emit(toReg16(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg16(dst));
                }
                else if (srcWidth == 8)
                {
                    self.emitter.emit("\tmovb ");
                    self.emitter.emit(toReg8(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(toReg8(dst));
                }
            },
            else => {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            },
        }
        // Staged casts left the finished value in %r11; a 32-bit write
        // into it already zero/sign-extended the full 64 bits, so one
        // movq stores every width the branches above produce.
        if (stageDst && (inst->opcode != IrOpcode::Bitcast ||
                         srcWidth == 64 || srcWidth == 32 ||
                         srcWidth == 16 || srcWidth == 8))
        {
            self.emitter.emit("\tmovq %r11, ");
            self.emitter.emitLine(dstHome);
        }
    }

    void emitSiToFp(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        bool isDouble = inst->base.type != null && inst->base.type->width == 64;
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? "cvtsi2sd " : "cvtsi2ss ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
    }

    void emitFpToSi(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        bool isDouble = inst->ops[0] != null && inst->ops[0]->type != null && inst->ops[0]->type->width == 64;
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? "cvttsd2si " : "cvttss2si ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
    }

    void emitFloatBinOp(IrInst* inst, str ssOp, str sdOp)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "xmm1";
        bool isDouble = inst->ops[0]->type != null && inst->ops[0]->type->width == 64;
        // float alu wants a register destination, a spill works in xmm0
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "xmm0" : dst;
        str opSrc = src2;
        if (src1.equals(work))
        {
            // dst already holds operand 0 (operand-0 coalescing)
        }
        else if (work.equals(src2) && self.isCommutativeX86(inst->opcode))
        {
            // Option B: dst reused operand 1's register — FAdd/FMul are
            // commutative, so `op src1, work` is the same value, no copy
            opSrc = src1;
        }
        else
        {
            self.emitter.emit("\tmov");
            self.emitter.emit(isDouble ? "sd" : "ss");
            self.emitter.emit("\t");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
        }
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? sdOp : ssOp);
        self.emitter.emit("\t");
        self.emitter.emit(opSrc);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        if (dstSpill)
        {
            self.emitter.emit(isDouble ? "\tmovsd xmm0, " : "\tmovss xmm0, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitFma(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "xmm1";
        str src3 = (inst->nops > 2) ? self.getRegForValue(inst->ops[2]) : "xmm2";

        bool isDouble = inst->base.type != null && inst->base.type->width == 64;

        if (self.emitter.features != null && self.emitter.features.fma)
        {
            if (isDouble)
            {
                self.emitter.emit("\tmovsd ");
                self.emitter.emit(src3);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tvfmadd231sd ");
            }
            else
            {
                self.emitter.emit("\tmovss ");
                self.emitter.emit(src3);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tvfmadd231ss ");
            }
            self.emitter.emit(src2);
            self.emitter.emit(", ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        else
        {
            if (isDouble)
            {
                self.emitter.emit("\tmovsd ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tmulsd ");
                self.emitter.emit(src2);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\taddsd ");
            }
            else
            {
                self.emitter.emit("\tmovss ");
                self.emitter.emit(src1);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\tmulss ");
                self.emitter.emit(src2);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
                self.emitter.emit("\taddss ");
            }
            self.emitter.emit(src3);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    void emitFabs(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        bool isDouble = inst->ops[0] != null && inst->ops[0]->type != null && inst->ops[0]->type->width == 64;
        // Float: mask off sign bit of lower 32-bit element
        // Double: mask off sign bit of lower 64-bit element
        // (distinct labels: one 16-byte andpd/andps read each, and the
        // two masks differ, so a shared label would be wrong for one width)
        self.emitter.needFabsMask(isDouble);
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? "andpd " : "andps ");
        self.emitter.emit(isDouble ? ".Lfabs_mask_d, " : ".Lfabs_mask_s, ");
        self.emitter.emitLine(src);
        if (!src.equals(dst))
        {
            self.emitter.emit("\t");
            self.emitter.emit(isDouble ? "movsd " : "movss ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    void emitFcvt(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        u32 srcWidth = inst->ops[0] != null && inst->ops[0]->type != null ? inst->ops[0]->type->width : 64;
        u32 dstWidth = inst->base.type != null ? inst->base.type->width : 64;
        bool dstIsDouble = dstWidth == 64;
        bool srcIsDouble = srcWidth == 64;
        switch (inst->opcode)
        {
            IrOpcode::FpTrunc => {
                self.emitter.emit("\tcvtsd2ss ");
                self.emitter.emit(src);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            },
            
            IrOpcode::FpExt => {
                self.emitter.emit("\tcvtss2sd ");
                self.emitter.emit(src);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            },
            
            IrOpcode::UiToFp => {
                if (srcWidth == 64)
                {
                    self.emitter.emit("\ttestq ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(src);
                    self.emitter.emitTab("js .Lui_to_fp_neg");
                    self.emitter.emit("\t");
                    self.emitter.emit(dstIsDouble ? "cvtsi2sd " : "cvtsi2ss ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                    self.emitter.emitTab("jmp .Lui_to_fp_done");
                    self.emitter.emitTab(".Lui_to_fp_neg:");
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(src);
                    self.emitter.emitLine(", %r10");
                    self.emitter.emitTab("andq $1, %r10");
                    self.emitter.emit("\tshrq $1, ");
                    self.emitter.emitLine(src);
                    self.emitter.emit("\t");
                    self.emitter.emit(dstIsDouble ? "cvtsi2sd " : "cvtsi2ss ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                    self.emitter.emit("\t");
                    self.emitter.emit(dstIsDouble ? "addsd " : "addss ");
                    self.emitter.emit(dst);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                    self.emitter.emitTab("testq %r10, %r10");
                    self.emitter.emitTab("je .Lui_to_fp_done");
                    self.emitter.needUiToOne();
                    self.emitter.emit("\t");
                    self.emitter.emit(dstIsDouble ? "addsd .Lui_to_fp_one_d" : "addss .Lui_to_fp_one_s");
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                    self.emitter.emitTab(".Lui_to_fp_done:");
                }
                else
                {
                    if (srcWidth == 32)
                    {
                        self.emitter.emit("\tmovl ");
                        self.emitter.emit(toReg32(src));
                        self.emitter.emit(", ");
                        self.emitter.emitLine(toReg32(src));
                    }
                    else if (srcWidth == 16)
                    {
                        self.emitter.emit("\tmovzwl ");
                        self.emitter.emit(toReg16(src));
                        self.emitter.emit(", ");
                        self.emitter.emitLine(toReg32(src));
                    }
                    else if (srcWidth == 8)
                    {
                        self.emitter.emit("\tmovzbl ");
                        self.emitter.emit(toReg8(src));
                        self.emitter.emit(", ");
                        self.emitter.emitLine(toReg32(src));
                    }
                    self.emitter.emit("\t");
                    self.emitter.emit(dstIsDouble ? "cvtsi2sd " : "cvtsi2ss ");
                    self.emitter.emit(toReg32(src));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
            },
            
            IrOpcode::FpToUi => {
                if (dstWidth == 64)
                {
                    self.emitter.emit("\t");
                    self.emitter.emit(srcIsDouble ? "cvttsd2si " : "cvttss2si ");
                    self.emitter.emit(src);
                    self.emitter.emitLine(", %r10");
                    self.emitter.emitTab("movq %r10, %rax");
                    self.emitter.emitTab("shrq $63, %rax");
                    self.emitter.emitTab("addq %rax, %r10");
                    self.emitter.emit("\tmovq %r10, ");
                    self.emitter.emitLine(dst);
                }
                else
                {
                    self.emitter.emit("\t");
                    self.emitter.emit(srcIsDouble ? "cvttsd2si " : "cvttss2si ");
                    self.emitter.emit(src);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
            },
            else => {
                self.emitter.emit("\tmovq ");
                self.emitter.emit(src);
                self.emitter.emit(", ");
                self.emitter.emitLine(dst);
            },
        }
    }

    void emitSqrt(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        bool isDouble = inst->ops[0] != null && inst->ops[0]->type != null && inst->ops[0]->type->width == 64;
        self.emitter.emit("\t");
        self.emitter.emit(isDouble ? "sqrtsd " : "sqrtss ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
    }

    // Which register class / stack slot one argument takes; advances
    // the running indices exactly the way the callee's param seeding
    // walks its stores, so both sides of a call agree word for word.
    // kinds: 0 = stack slot (value itself), 1 = integer register
    // (value itself), 2 = xmm register, 3 = integer register (struct
    // words loaded through their address), 4 = stack slot (struct
    // words loaded through their address).
    u32 classifyCallArg(IrValue* arg, u32* intIdx, u32* fpIdx, u32* stackOff,
                        u32* outReg, u32* outOff, u32* outWords)
    {
        u32 maxInt = self.isWindows ? 4 : 6;
        u32 maxFp = self.isWindows ? 4 : 8;
        *outReg = 0;
        *outOff = 0;
        *outWords = 1;
        if (arg == null)
        {
            if (*intIdx < maxInt)
            {
                *outReg = *intIdx;
                *intIdx += 1;
                return 1;
            }
            *outOff = *stackOff;
            *stackOff += 8;
            return 0;
        }
        bool isFp = arg->type != null &&
                    (arg->type->kind == IrTypeKind::Float ||
                     arg->type->kind == IrTypeKind::Vector);
        bool isStruct = arg->type != null && arg->type->kind == IrTypeKind::Struct;
        if (isStruct && !isFp)
        {
            // a struct is passed all-in-registers or all-on-stack,
            // never split across the boundary
            u32 sz = arg->type->width;
            u32 words = (sz > 8 && sz <= 16) ? 2 : 1;
            bool byValue = sz <= 16;
            u32 need = byValue ? words : 1;
            *outWords = words;
            if (*intIdx + need <= maxInt)
            {
                *outReg = *intIdx;
                *intIdx += need;
                return byValue ? 3 : 1;
            }
            *outOff = *stackOff;
            *stackOff += 8 * words;
            return byValue ? 4 : 0;
        }
        if (isFp)
        {
            u32 words = arg->type->width > 64 ? 2 : 1;
            *outWords = words;
            if (*fpIdx < maxFp)
            {
                *outReg = *fpIdx;
                *fpIdx += 1;
                return 2;
            }
            *outOff = *stackOff;
            *stackOff += 8 * words;
            return 0;
        }
        if (*intIdx < maxInt)
        {
            *outReg = *intIdx;
            *intIdx += 1;
            return 1;
        }
        *outOff = *stackOff;
        *stackOff += 8;
        return 0;
    }

    // ── inline asm ─────────────────────────────────────────────────────
    // The template is substituted and written into the .s text (gas
    // assembles it); constraints bind operands to physical registers
    // around it. lsra treats InlineAsm as a call, so values live across
    // it sit in callee-saves — the pick pools below are the reserved set
    // plus this ABI's caller-save allocatables, all safe to touch.
    void asmHardErr(IrInst* inst, str why)
    {
        eprintln("coralc: inline asm: {}", why);
        self.emitter.emitLine("\tud2");
    }

    bool asmIsTaken(str r)
    {
        for (u32 i = 0; i < self.asmTakenN; i++)
            if (self.asmTaken[i].equals(r)) return true;
        return false;
    }

    void asmTake(str r)
    {
        if (self.asmTakenN < 16)
        {
            self.asmTaken[self.asmTakenN] = r;
            self.asmTakenN++;
        }
    }

    str asmPickFree()
    {
        str[8] poolS = { "rax", "rcx", "rdx", "r10", "rsi", "rdi", "r8", "r9" };
        str[6] poolW = { "rax", "rcx", "rdx", "r10", "r8", "r9" };
        u32 n = 6;
        if (!self.isWindows) n = 8;
        for (u32 i = 0; i < n; i++)
        {
            str r = "rax";
            if (self.isWindows) r = poolW[i];
            else r = poolS[i];
            if (!self.asmIsTaken(r))
            {
                self.asmTake(r);
                return r;
            }
        }
        return str::empty();
    }

    str asmPickQ()
    {
        str[3] pool = { "rax", "rcx", "rdx" };
        for (u32 i = 0; i < 3; i++)
        {
            if (!self.asmIsTaken(pool[i]))
            {
                self.asmTake(pool[i]);
                return pool[i];
            }
        }
        return str::empty();
    }

    str asmFixedReg(str nm)
    {
        if (nm.equals("a")) return "rax";
        if (nm.equals("c")) return "rcx";
        if (nm.equals("d")) return "rdx";
        if (nm.equals("S")) return "rsi";
        if (nm.equals("D")) return "rdi";
        return str::empty();
    }

    str asmR32(str r)
    {
        if (r.equals("rax")) return "eax";
        if (r.equals("rcx")) return "ecx";
        if (r.equals("rdx")) return "edx";
        if (r.equals("r10")) return "r10d";
        if (r.equals("rsi")) return "esi";
        if (r.equals("rdi")) return "edi";
        if (r.equals("r8")) return "r8d";
        if (r.equals("r9")) return "r9d";
        return r;
    }

    str asmR8(str r)
    {
        if (r.equals("rax")) return "al";
        if (r.equals("rcx")) return "cl";
        if (r.equals("rdx")) return "dl";
        if (r.equals("r10")) return "r10b";
        if (r.equals("rsi")) return "sil";
        if (r.equals("rdi")) return "dil";
        if (r.equals("r8")) return "r8b";
        if (r.equals("r9")) return "r9b";
        return r;
    }

    bool asmClobberSafe(str nm)
    {
        if (self.isWindows && (nm.equals("rsi") || nm.equals("rdi"))) return false;
        if (nm.equals("rax") || nm.equals("rcx") || nm.equals("rdx") ||
            nm.equals("r10") || nm.equals("r11") || nm.equals("rsi") ||
            nm.equals("rdi") || nm.equals("r8") || nm.equals("r9") ||
            nm.equals("rsp") || nm.equals("rbp") ||
            nm.equals("xmm0") || nm.equals("xmm1") || nm.equals("xmm15"))
            return true;
        return false;
    }

    void emitInlineAsm(IrInst* inst)
    {
        self.asmTakenN = 0;
        u32 nops = inst->nops;
        if (nops > 24) { self.asmHardErr(inst, "too many operands"); return; }

        AsmConstraint[24] cc;
        AsmParseError perr = AsmParseError { .msg = str::empty(), .lineNo = 0 };
        u32 nc = parseConstraints(inst->asmConstraints, cc, 24, &perr);
        if (nc == 0xFFFF) { self.asmHardErr(inst, perr.msg); return; }
        if (nc != nops) { self.asmHardErr(inst, "constraint and operand counts differ"); return; }

        // value mode: a non-void asm carries its result as the inst
        // value — when that home sits in the caller-save pick pool it is
        // reserved up front so the register output writes it directly
        // and no read-back move is needed
        bool valMode = inst->base.type != null && inst->base.type->kind != IrTypeKind::Void;
        str resPref = str::empty();
        bool resPrefUsed = false;
        if (valMode)
        {
            str h = self.opFor(&inst->base);
            str[8] poolS = { "rax", "rcx", "rdx", "r10", "rsi", "rdi", "r8", "r9" };
            str[6] poolW = { "rax", "rcx", "rdx", "r10", "r8", "r9" };
            u32 pn = 8;
            if (self.isWindows) pn = 6;
            for (u32 i = 0; i < pn; i++)
            {
                str r = poolS[i];
                if (self.isWindows) r = poolW[i];
                if (h.equals(r)) { resPref = h; self.asmTake(h); break; }
            }
        }

        // clobbers: caller-save/reserved regs never hold a value across
        // the asm (lsra pushes those to callee-saves), so they are safe —
        // a callee-save would be silently corrupted, so reject it here
        str cb = inst->asmClobbers;
        usize ci = 0;
        while (ci < cb.len)
        {
            usize st = ci;
            while (ci < cb.len && cb.ptr[ci] != (u8)',') ci++;
            usize en = ci;
            usize a = st;
            while (a < en && (cb.ptr[a] == (u8)' ' || cb.ptr[a] == (u8)'\t')) a++;
            while (en > a && (cb.ptr[en - 1] == (u8)' ' || cb.ptr[en - 1] == (u8)'\t')) en--;
            if (en > a)
            {
                str nm = str::fromParts(cb.ptr + a, en - a);
                if (!nm.equals("memory") && !nm.equals("cc") && !self.asmClobberSafe(nm))
                {
                    self.asmHardErr(inst, "clobber list names a callee-save register");
                    return;
                }
            }
            if (ci < cb.len) ci++;
        }

        u8[24] mode;      // 0 unset, 1 in-reg, 2 out-reg, 3 inout-reg, 4 mem, 5 imm
        str[24] treg;
        for (u32 k = 0; k < 24; k++) { mode[k] = 0; treg[k] = str::empty(); }

        // pass 1: fixed registers, memory operands, immediates
        for (u32 k = 0; k < nops; k++)
        {
            AsmConstraint c = cc[k];
            if (c.cls == AsmConClass::ConTied) continue;
            u8 dir = 1;
            if (c.isInOut) dir = (u8)3;
            else if (c.isOut) dir = (u8)2;
            if (c.cls == AsmConClass::ConMem)
            {
                str a = self.asmPickFree();
                if (a.len == 0) { self.asmHardErr(inst, "out of registers for memory operand"); return; }
                mode[k] = 4;
                treg[k] = a;
            }
            else if (c.cls == AsmConClass::ConImm)
            {
                if (dir != 1) { self.asmHardErr(inst, "immediate operand cannot be an output"); return; }
                mode[k] = 5;
            }
            else if (c.cls == AsmConClass::ConGeneral)
            {
                str a = str::empty();
                if (resPref.len > 0 && !resPrefUsed && dir != 1)
                {
                    a = resPref;
                    resPrefUsed = true;
                }
                else a = self.asmPickFree();
                if (a.len == 0) { self.asmHardErr(inst, "out of registers for operand"); return; }
                mode[k] = dir;
                treg[k] = a;
            }
            else if (c.cls == AsmConClass::ConRegName)
            {
                str r = str::empty();
                if (c.regName.equals("q")) r = self.asmPickQ();
                else
                {
                    r = self.asmFixedReg(c.regName);
                    if (r.len > 0)
                    {
                        if (self.asmIsTaken(r))
                        {
                            // the result's own pinned home still counts
                            if (resPref.len > 0 && !resPrefUsed && dir != 1 && r.equals(resPref))
                                resPrefUsed = true;
                            else { self.asmHardErr(inst, "register assigned to two operands"); return; }
                        }
                        else self.asmTake(r);
                    }
                }
                if (r.len == 0) { self.asmHardErr(inst, "unsupported register constraint"); return; }
                mode[k] = dir;
                treg[k] = r;
            }
            else { self.asmHardErr(inst, "unknown constraint class"); return; }
        }

        // pass 2: tied operands borrow their partner's register
        for (u32 k = 0; k < nops; k++)
        {
            AsmConstraint c = cc[k];
            if (c.cls != AsmConClass::ConTied) continue;
            u32 t = c.tieIdx;
            if (t >= nops || t == k || mode[t] == 0 || mode[t] == 4 || mode[t] == 5)
            { self.asmHardErr(inst, "tied operand points nowhere"); return; }
            treg[k] = treg[t];
            mode[k] = c.isInOut ? (u8)3 : (u8)1;
        }

        // input moves as a parallel copy, staging through r11; the only
        // hazard is writing a register another pending move still reads
        u8[24] mvKind;    // 1 = register, 2 = spill slot, 3 = immediate, 4 = string
        str[24] mvSrc;
        str[24] mvDst;
        u32[24] mvSlot;
        IrValue*[24] mvVal;
        bool[24] mvDone;
        bool[24] mvStaged;
        bool[24] mvDeref; // inout: operand is a variable — load its value
        u32 mvN = 0;
        for (u32 k = 0; k < nops; k++)
        {
            if (mode[k] != 1 && mode[k] != 3) continue;
            IrValue* v = inst->ops[k];
            if (v == null) { self.asmHardErr(inst, "missing input operand"); return; }
            mvDeref[mvN] = false;
            if (valueIsIntConst(v)) { mvKind[mvN] = 3; mvVal[mvN] = v; mvSrc[mvN] = str::empty(); }
            else if (v->kind == IrValueKind::StringConst) { mvKind[mvN] = 4; mvVal[mvN] = v; mvSrc[mvN] = str::empty(); }
            else if (self.valueIsSpill(v))
            {
                mvKind[mvN] = 2;
                mvVal[mvN] = v;
                mvSlot[mvN] = (u32)(v->valData & 0x3FFFFFFF);
                mvSrc[mvN] = str::empty();
            }
            else
            {
                mvKind[mvN] = 1;
                mvVal[mvN] = v;
                if (mode[k] == 3 && !valMode)
                {
                    // pointer model: the inout operand IS the variable's
                    // address — load the pointee into the register
                    if (v->type == null || v->type->kind != IrTypeKind::Ptr)
                    { self.asmHardErr(inst, "inout operand must be an address"); return; }
                    mvDeref[mvN] = true;
                }
                mvSrc[mvN] = self.opFor(v);
            }
            mvDst[mvN] = treg[k];
            mvDone[mvN] = false;
            mvStaged[mvN] = false;
            mvN++;
        }
        u32 doneN = 0;
        u32 guard = 0;
        while (doneN < mvN && guard < 600)
        {
            guard++;
            bool prog = false;
            for (u32 m = 0; m < mvN; m++)
            {
                if (mvDone[m]) continue;
                bool blocked = false;
                for (u32 o = 0; o < mvN; o++)
                {
                    if (mvDone[o] || o == m || mvKind[o] != 1 || mvStaged[o]) continue;
                    if (mvSrc[o].equals(mvDst[m])) { blocked = true; break; }
                }
                if (blocked) continue;
                if (mvStaged[m])
                {
                    self.emitter.emit("\tmovq %r11, ");
                    self.emitter.emitLine(mvDst[m]);
                }
                else if (mvKind[m] == 1)
                {
                    if (mvDeref[m])
                    {
                        for (u32 o = 0; o < mvN; o++)
                            if (mvStaged[o] && !mvDone[o])
                            { self.asmHardErr(inst, "inout load needs a scratch"); return; }
                        bool pr = false;
                        for (usize q = 0; q < mvSrc[m].len; q++)
                            if (mvSrc[m].ptr[q] == (u8)'(') pr = true;
                        str w = "movq";
                        u32 bits = 64;
                        IrValue* av = mvVal[m];
                        if (av->type != null && av->type->elem != null &&
                            av->type->elem->kind == IrTypeKind::Int)
                            bits = av->type->elem->width;
                        str dr = mvDst[m];
                        if (bits <= 8) { w = "movzbl"; dr = self.asmR32(mvDst[m]); }
                        else if (bits <= 32) { w = "movl"; dr = self.asmR32(mvDst[m]); }
                        if (pr)
                        {
                            self.emitter.emit("\tmovq ");
                            self.emitter.emit(mvSrc[m]);
                            self.emitter.emitLine(", %r11");
                            self.emitter.emit("\t");
                            self.emitter.emit(w);
                            self.emitter.emit(" (%r11), ");
                            self.emitter.emitLine(dr);
                        }
                        else
                        {
                            self.emitter.emit("\t");
                            self.emitter.emit(w);
                            self.emitter.emit(" (");
                            self.emitter.emit(mvSrc[m]);
                            self.emitter.emit("), ");
                            self.emitter.emitLine(dr);
                        }
                    }
                    else if (!mvSrc[m].equals(mvDst[m]))
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(mvSrc[m]);
                        self.emitter.emit(", ");
                        self.emitter.emitLine(mvDst[m]);
                    }
                }
                else if (mvKind[m] == 2)
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(self.slotText(mvSlot[m]));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(mvDst[m]);
                }
                else if (mvKind[m] == 3)
                {
                    self.emitImmTo(mvVal[m]->valData, mvDst[m]);
                }
                else
                {
                    self.emitter.emit("\tleaq ");
                    self.emitter.emit(self.ripOperand(self.stringLabel(mvVal[m]), 0));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(mvDst[m]);
                }
                mvDone[m] = true;
                doneN++;
                prog = true;
            }
            if (doneN >= mvN) break;
            if (!prog)
            {
                u32 m = 0;
                while (m < mvN && (mvDone[m] || mvStaged[m] || mvKind[m] != 1)) m++;
                if (m >= mvN) { self.asmHardErr(inst, "input copy cannot be scheduled"); return; }
                for (u32 o = 0; o < mvN; o++)
                    if (mvStaged[o] && !mvDone[o])
                    { self.asmHardErr(inst, "input copy needs a second scratch"); return; }
                self.emitter.emit("\tmovq ");
                self.emitter.emit(mvSrc[m]);
                self.emitter.emit(", %r11");
                self.emitter.emitLine("");
                mvStaged[m] = true;
            }
        }
        if (doneN < mvN) { self.asmHardErr(inst, "input copy did not finish"); return; }

        // memory operands: materialise the address after the copy (their
        // homes are callee-saves, so nothing above could have touched them)
        for (u32 k = 0; k < nops; k++)
        {
            if (mode[k] != 4) continue;
            IrValue* v = inst->ops[k];
            if (v == null) { self.asmHardErr(inst, "missing memory operand"); return; }
            self.opForReg(v, treg[k]);
        }

        // template: %% is a literal %, %N expands to the operand spelling
        str tmpl = inst->asmString;
        usize cap = tmpl.len + 48 + (usize)nops * 8;
        u8* buf = alloc<u8>(cap);
        if (buf == null) { self.asmHardErr(inst, "out of memory"); return; }
        usize k2 = 0;
        usize ti = 0;
        bool subErr = false;
        while (ti < tmpl.len)
        {
            u8 ch = tmpl.ptr[ti];
            if (ch == (u8)'%' && ti + 1 < tmpl.len)
            {
                u8 nx = tmpl.ptr[ti + 1];
                if (nx == (u8)'%') { buf[k2] = '%'; k2++; ti = ti + 2; continue; }
                if (nx >= (u8)'0' && nx <= (u8)'9')
                {
                    u32 idx = 0;
                    ti++;
                    while (ti < tmpl.len && tmpl.ptr[ti] >= (u8)'0' && tmpl.ptr[ti] <= (u8)'9')
                    {
                        idx = idx * 10 + (u32)(tmpl.ptr[ti] - (u8)'0');
                        ti++;
                    }
                    if (idx >= nops || mode[idx] == 0) { subErr = true; break; }
                    if (mode[idx] == 5)
                    {
                        str it = intImmText(inst->ops[idx]);
                        for (usize q = 0; q < it.len; q++) { buf[k2] = it.ptr[q]; k2++; }
                    }
                    else if (mode[idx] == 4)
                    {
                        buf[k2] = '('; k2++;
                        buf[k2] = '%'; k2++;
                        str r = treg[idx];
                        for (usize q = 0; q < r.len; q++) { buf[k2] = r.ptr[q]; k2++; }
                        buf[k2] = ')'; k2++;
                    }
                    else
                    {
                        buf[k2] = '%'; k2++;
                        str r = treg[idx];
                        for (usize q = 0; q < r.len; q++) { buf[k2] = r.ptr[q]; k2++; }
                    }
                    continue;
                }
                if (nx == (u8)'[') { subErr = true; break; }
                /* %rax / %eflags etc: pass the % through verbatim, the
                 * rest of the name is copied by the next round */
                buf[k2] = '%';
                k2++;
                ti++;
                continue;
            }
            buf[k2] = ch;
            k2++;
            ti++;
        }
        if (subErr)
        {
            dealloc<u8>(buf);
            self.asmHardErr(inst, "unsupported % escape in template");
            return;
        }
        if (k2 > 0)
        {
            self.emitter.emit("\t");
            self.emitter.emit(str::fromParts(buf, k2));
            self.emitter.emitLine("");
        }
        dealloc<u8>(buf);

        // register outputs: value mode moves the result into the inst's
        // own home (the value, not a pointer); the pointer model stores
        // through the operand's address at the pointee's width
        bool resMoved = false;
        for (u32 k = 0; k < nops; k++)
        {
            if (mode[k] != 2 && mode[k] != 3) continue;
            IrValue* pv = inst->ops[k];
            bool ptrOut = pv != null && pv->type != null && pv->type->kind == IrTypeKind::Ptr;
            if (!ptrOut)
            {
                if (!valMode || resMoved)
                { self.asmHardErr(inst, "output operand must be an address"); return; }
                resMoved = true;
                str home = self.opFor(&inst->base);
                if (home.equals(treg[k])) continue;
                u32 bits = 64;
                if (inst->base.type != null) bits = inst->base.type->width;
                str ws = "movq";
                str sr = treg[k];
                str dst = home;
                if (bits <= 8) { ws = "movb"; sr = self.asmR8(treg[k]); dst = self.asmR8(home); }
                else if (bits <= 32) { ws = "movl"; sr = self.asmR32(treg[k]); dst = self.asmR32(home); }
                self.emitter.emit("\t");
                self.emitter.emit(ws);
                self.emitter.emit(" ");
                self.emitter.emit(sr);
                self.emitter.emit(", ");
                self.emitter.emit(dst);
                self.emitter.emitLine("");
                continue;
            }
            if (pv == null) continue;
            u32 bits = 64;
            if (pv->type->elem != null && pv->type->elem->kind == IrTypeKind::Int)
                bits = pv->type->elem->width;
            str home = self.opFor(pv);
            str w = "movq";
            str sr = treg[k];
            if (bits <= 8) { w = "movb"; sr = self.asmR8(treg[k]); }
            else if (bits <= 32) { w = "movl"; sr = self.asmR32(treg[k]); }
            bool paren = false;
            for (usize q = 0; q < home.len; q++) if (home.ptr[q] == (u8)'(') paren = true;
            if (paren)
            {
                // spilled pointer: reload it into r11, store through it
                self.emitter.emit("\tmovq ");
                self.emitter.emit(home);
                self.emitter.emitLine(", %r11");
                self.emitter.emit("\t");
                self.emitter.emit(w);
                self.emitter.emit(" ");
                self.emitter.emit(sr);
                self.emitter.emitLine(", (%r11)");
            }
            else
            {
                self.emitter.emit("\t");
                self.emitter.emit(w);
                self.emitter.emit(" ");
                self.emitter.emit(sr);
                self.emitter.emit(", (");
                self.emitter.emit(home);
                self.emitter.emitLine(")");
            }
        }
    }

    void emitCall(IrInst* inst)
    {
        if (inst->nops == 0 || inst->ops[0] == null) return;
        IrValue* callee = inst->ops[0];
        str calleeName = callee->name;

        self.lastCallTarget = calleeName;
        self.lastCallResult = &inst->base;
        // G34: a call in tail position emits a jmp instead, the stack
        // dance below only makes sense for the ordinary call shape
        bool tail = self.inTailPosition(inst);

        str[6] sysvIntRegs = { "rdi", "rsi", "rdx", "rcx", "r8", "r9" };
        str[4] win64IntRegs = { "rcx", "rdx", "r8", "r9" };
        str[8] sysvFpRegs = { "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7" };
        str[4] win64FpRegs = { "xmm0", "xmm1", "xmm2", "xmm3" };
        str* intRegs = sysvIntRegs;
        if (self.isWindows) intRegs = win64IntRegs;
        str* fpRegs = sysvFpRegs;
        if (self.isWindows) fpRegs = win64FpRegs;

        u32 nargs = inst->nops - 1;

        // pass A: classify every argument, collect the register moves.
        // move kinds: 1 int value, 2 xmm value, 3 struct word,
        // 4 immediate int, 5 immediate fp; 0/4 classify to the stack
        // and are pass B's business
        u32 intIdx = 0;
        u32 fpIdx = 0;
        u32 stackOff = self.isWindows ? 32 : 0;   // Win64 shadow first
        u32 mvN = 0;
        u8[32] mvKind;
        u8[32] mvWord;
        u32[32] mvReg;
        IrValue*[32] mvArg;
        for (u32 i = 0; i < nargs; i++)
        {
            IrValue* arg = inst->ops[1 + i];
            u32 outReg = 0;
            u32 outOff = 0;
            u32 outWords = 1;
            u32 kind = self.classifyCallArg(arg, &intIdx, &fpIdx, &stackOff,
                                             &outReg, &outOff, &outWords);
            if (arg != null && arg->kind == IrValueKind::ConstInt && kind == 1)
            {
                mvKind[mvN] = 4; mvWord[mvN] = 0; mvReg[mvN] = outReg; mvArg[mvN] = arg;
                mvN++;
                continue;
            }
            if (arg != null && arg->kind == IrValueKind::ConstFloat && kind == 2)
            {
                mvKind[mvN] = 5; mvWord[mvN] = 0; mvReg[mvN] = outReg; mvArg[mvN] = arg;
                mvN++;
                continue;
            }
            if (kind == 3)
            {
                for (u32 w = 0; w < outWords; w++)
                {
                    mvKind[mvN] = 3; mvWord[mvN] = (u8)w; mvReg[mvN] = outReg + w; mvArg[mvN] = arg;
                    mvN++;
                }
            }
            else if (kind == 1 || kind == 2)
            {
                mvKind[mvN] = (u8)kind; mvWord[mvN] = 0; mvReg[mvN] = outReg; mvArg[mvN] = arg;
                mvN++;
            }
        }

        // resolve the register moves as a parallel copy: a move waits
        // while some pending move still has to read the register it
        // would write, and a stalled move parks its source in a
        // staging slot — memory blocks nobody
        bool[32] mvDone;
        bool[32] mvStaged;
        u32[32] mvScratch;
        for (u32 i = 0; i < 32; i++)
        {
            mvDone[i] = false;
            mvStaged[i] = false;
            mvScratch[i] = 0;
        }
        u32[32] planOp;     // 0 = stage, 1 = move
        u32[32] planA;      // the move index
        u32[32] planB;      // staging offset (stage only)
        u32 planN = 0;
        u32 stageN = 0;
        u32 doneCount = 0;
        while (doneCount < mvN)
        {
            bool progress = false;
            for (u32 m = 0; m < mvN; m++)
            {
                if (mvDone[m]) continue;
                str myDst = (mvKind[m] == 2 || mvKind[m] == 5)
                                   ? fpRegs[mvReg[m]] : intRegs[mvReg[m]];
                bool blocked = false;
                for (u32 o = 0; o < mvN && !blocked; o++)
                {
                    if (o == m || mvDone[o] || mvStaged[o]) continue;
                    if (mvKind[o] == 4 || mvKind[o] == 5) continue;
                    IrValue* a = mvArg[o];
                    if (a == null || self.valueIsSpill(a)) continue;
                    if (self.homeOf(a).equals(myDst)) blocked = true;
                }
                if (!blocked)
                {
                    planOp[planN] = 1; planA[planN] = m; planN++;
                    mvDone[m] = true;
                    doneCount++;
                    progress = true;
                }
            }
            if (doneCount == mvN) break;
            if (!progress)
            {
                u32 m = 0;
                while (m < mvN && (mvDone[m] || mvStaged[m] || mvKind[m] == 4 ||
                                   mvKind[m] == 5 || mvArg[m] == null ||
                                   self.valueIsSpill(mvArg[m])))
                    m++;
                if (m >= mvN) break;
                u32 off = stackOff + stageN * 16;
                stageN++;
                planOp[planN] = 0; planA[planN] = m; planB[planN] = off; planN++;
                mvStaged[m] = true;
                mvScratch[m] = off;
                progress = true;
            }
        }

        // one stack adjustment: Win64 shadow plus every stack
        // argument plus the staging slots, rounded to 16. A tail jump
        // keeps our own entry rsp, staging would need a restore we
        // will not emit, so it gives up the tail shape here; the outer
        // caller's shadow already covers a Win64 callee.
        if (tail && stageN > 0) tail = false;
        u32 total = stackOff + stageN * 16;
        if ((total % 16) != 0) total = (total / 16 + 1) * 16;
        if (!tail && total > 0)
        {
            self.emitter.emit("\tsubq $");
            self.emitter.emitU32(total);
            self.emitter.emitLine(", %rsp");
        }
        if (tail) self.tailJmpCall = inst;

        // pass B: the stack arguments at fixed offsets; none of this
        // touches an argument register, so it runs before the copy
        u32 sInt = 0;
        u32 sFp = 0;
        u32 sOff = self.isWindows ? 32 : 0;
        for (u32 i = 0; i < nargs; i++)
        {
            IrValue* arg = inst->ops[1 + i];
            u32 outReg = 0;
            u32 outOff = 0;
            u32 outWords = 1;
            u32 kind = self.classifyCallArg(arg, &sInt, &sFp, &sOff,
                                             &outReg, &outOff, &outWords);
            if (kind == 4)
            {
                // struct words through their address into the slot
                str addr = self.valueIsSpill(arg)
                                  ? self.opForReg(arg, "r10") : self.opFor(arg);
                for (u32 w = 0; w < outWords; w++)
                {
                    self.emitter.emit("\tmovq ");
                    if (w > 0)
                    {
                        self.emitter.emitU32(8 * w);
                        self.emitter.emit("(");
                        self.emitter.emit(addr);
                        self.emitter.emit("), r11");
                    }
                    else
                    {
                        self.emitter.emit("(");
                        self.emitter.emit(addr);
                        self.emitter.emit("), r11");
                    }
                    self.emitter.emit("\n");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitU32(outOff + 8 * w);
                    self.emitter.emitLine("(%rsp)");
                }
            }
            else if (kind == 0)
            {
                if (arg != null && arg->kind == IrValueKind::ConstInt)
                {
                    str num = u64ToHex(arg->valData);
                    self.emitter.emit("\tmovq $");
                    self.emitter.emit(num);
                    self.emitter.emit(", ");
                    self.emitter.emitU32(outOff);
                    self.emitter.emitLine("(%rsp)");
                }
                else if (arg != null && arg->kind == IrValueKind::ConstFloat)
                {
                    self.emitImmTo(arg->valData, "r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitU32(outOff);
                    self.emitter.emitLine("(%rsp)");
                }
                else if (self.valueIsFloatClass(arg) || self.valueIsVec(arg))
                {
                    bool isV = self.valueIsVec(arg);
                    str mn = isV ? "movdqu "
                                          : (arg->type != null && arg->type->width == 64 ? "movsd " : "movss ");
                    if (self.valueIsSpill(arg))
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emit(self.opFor(arg));
                        self.emitter.emitLine(", xmm15");
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emit("xmm15, ");
                        self.emitter.emitU32(outOff);
                        self.emitter.emitLine("(%rsp)");
                    }
                    else
                    {
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emit(self.opFor(arg));
                        self.emitter.emit(", ");
                        self.emitter.emitU32(outOff);
                        self.emitter.emitLine("(%rsp)");
                    }
                }
                else if (arg != null)
                {
                    if (self.valueIsSpill(arg))
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(self.opFor(arg));
                        self.emitter.emitLine(", r11");
                        self.emitter.emit("\tmovq r11, ");
                        self.emitter.emitU32(outOff);
                        self.emitter.emitLine("(%rsp)");
                    }
                    else
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(self.opFor(arg));
                        self.emitter.emit(", ");
                        self.emitter.emitU32(outOff);
                        self.emitter.emitLine("(%rsp)");
                    }
                }
            }
        }

        // the register copy itself
        for (u32 p = 0; p < planN; p++)
        {
            u32 m = planA[p];
            IrValue* arg = mvArg[m];
            u32 w = (u32)mvWord[m];
            if (planOp[p] == 0)
            {
                // park the source so its register stops blocking others
                if (mvKind[m] == 2)
                {
                    bool isV = arg->type != null && arg->type->kind == IrTypeKind::Vector;
                    str mn = isV ? "movdqu "
                                          : (arg->type != null && arg->type->width == 64 ? "movsd " : "movss ");
                    self.emitter.emit("\t");
                    self.emitter.emit(mn);
                    self.emitter.emit(self.opFor(arg));
                    self.emitter.emit(", ");
                    self.emitter.emitU32(planB[p]);
                    self.emitter.emitLine("(%rsp)");
                }
                else
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(self.opFor(arg));
                    self.emitter.emit(", ");
                    self.emitter.emitU32(planB[p]);
                    self.emitter.emitLine("(%rsp)");
                }
            }
            else
            {
                str dst = (mvKind[m] == 2 || mvKind[m] == 5)
                                 ? fpRegs[mvReg[m]] : intRegs[mvReg[m]];
                if (mvKind[m] == 4)
                {
                    str num = u64ToHex(arg->valData);
                    self.emitter.emit("\tmovq $");
                    self.emitter.emit(num);
                    self.emitter.emit(", ");
                    self.emitter.emitLine(dst);
                }
                else if (mvKind[m] == 5)
                {
                    self.emitImmTo(arg->valData, "r11");
                    self.emitter.emit("\tmovq r11, ");
                    self.emitter.emitLine(dst);
                }
                else if (mvKind[m] == 3)
                {
                    // the address, then the word through it
                    str addr;
                    if (mvStaged[m])
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emitU32(mvScratch[m]);
                        self.emitter.emitLine("(%rsp), r10");
                        addr = "r10";
                    }
                    else if (self.valueIsSpill(arg))
                    {
                        addr = self.opForReg(arg, "r10");
                    }
                    else
                    {
                        addr = self.opFor(arg);
                    }
                    self.emitter.emit("\tmovq ");
                    if (w > 0) self.emitter.emitU32(8 * w);
                    self.emitter.emit("(");
                    self.emitter.emit(addr);
                    self.emitter.emit("), ");
                    self.emitter.emitLine(dst);
                }
                else if (mvKind[m] == 2)
                {
                    if (mvStaged[m])
                    {
                        bool isV = arg->type != null && arg->type->kind == IrTypeKind::Vector;
                        str mn = isV ? "movdqu "
                                              : (arg->type != null && arg->type->width == 64 ? "movsd " : "movss ");
                        self.emitter.emit("\t");
                        self.emitter.emit(mn);
                        self.emitter.emitU32(mvScratch[m]);
                        self.emitter.emit("(%rsp), ");
                        self.emitter.emitLine(dst);
                    }
                    else
                    {
                        self.opForRegF(arg, dst);
                    }
                }
                else
                {
                    if (mvStaged[m])
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emitU32(mvScratch[m]);
                        self.emitter.emit("(%rsp), ");
                        self.emitter.emitLine(dst);
                    }
                    else
                    {
                        self.opForReg(arg, dst);
                    }
                }
            }
        }

        // SysV varargs: the callee reads %al to decide whether to
        // save the xmm registers into its register save area
        if (!self.isWindows && callee->kind == IrValueKind::Func)
        {
            IrFunc* fn = (IrFunc*)callee;
            if (fn->base.type != null && fn->base.type->isVararg)
            {
                self.emitter.emit("\tmovb $");
                self.emitter.emitU32(fpIdx);
                self.emitter.emitLine(", %al");
            }
        }

        self.emitter.emit(tail ? "\tjmp " : "\tcall ");
        self.emitter.emit(calleeName);
        if (!self.isWindows && callee->kind == IrValueKind::Func)
        {
            IrFunc* fn = (IrFunc*)callee;
            if (fn.isExtern)
                self.emitter.emit("@PLT");
        }
        self.emitter.emit("\n");

        if (!tail && total > 0)
        {
            self.emitter.emit("\taddq $");
            self.emitter.emitU32(total);
            self.emitter.emitLine(", %rsp");
        }

        // a tail jump hands the result straight to the Ret after us,
        // which emits nothing, so there is no home to sink it into
        if (tail) return;

        // the result arrives in rax / xmm0 — sink it into the home
        // lsra picked for the call's value
        if (inst->base.type != null)
        {
            str dst = self.opFor(&inst->base);
            if (self.valueIsFloatClass(&inst->base) || self.valueIsVec(&inst->base))
            {
                u32 w = inst->base.type->width;
                str mn;
                if (self.valueIsVec(&inst->base))
                    mn = w > 64 ? "movdqu " : "movq ";
                else
                    mn = w == 64 ? "movsd " : "movss ";
                if (!dst.equals("xmm0"))
                {
                    self.emitter.emit("\t");
                    self.emitter.emit(mn);
                    self.emitter.emit("xmm0, ");
                    self.emitter.emitLine(dst);
                }
            }
            else
            {
                if (!dst.equals("rax"))
                {
                    self.emitter.emit("\tmovq rax, ");
                    self.emitter.emitLine(dst);
                }
            }
        }
    }

    // G34: a direct call whose result feeds only the Ret right behind it
    // can jump instead of calling, so the callee's ret returns straight to
    // our caller. Only the shape that needs no epilogue work and no stack
    // shuffle qualifies: register-only arguments, no frame, no
    // callee-saves, no spill area, no vararg window. The call emits its
    // register moves as usual and a jmp in place of the call; the Ret after
    // it emits nothing (see emitRet).
    bool tailShapeOk(IrInst* inst)
    {
        if (inst->base.nusers != 1) return false;
        IrInst* ret = inst->base.users[0];
        if (ret == null || ret->opcode != IrOpcode::Ret) return false;
        if (ret->nops < 1 || ret->ops[0] != &inst->base) return false;
        IrBlock* bb = inst->parent;
        if (bb == null || bb->ninsts < 2) return false;
        if (bb->insts[bb->ninsts - 1] != ret) return false;
        if (bb->insts[bb->ninsts - 2] != inst) return false;
        if (inst->nops < 1 || inst->ops[0] == null) return false;
        if (inst->ops[0]->kind != IrValueKind::Func) return false;
        if (inst->ops[0]->name.isEmpty()) return false;
        // a stack argument would have to be shuffled under the return
        // address we are about to inherit, register args need nothing
        u32 tInt = 0;
        u32 tFp = 0;
        u32 tStack = self.isWindows ? 32 : 0;
        for (u32 i = 1; i < inst->nops; i++)
        {
            u32 outReg = 0;
            u32 outOff = 0;
            u32 outWords = 1;
            u32 kind = self.classifyCallArg(inst->ops[i], &tInt, &tFp, &tStack,
                                            &outReg, &outOff, &outWords);
            if (kind == 0 || kind == 4) return false;
        }
        return true;
    }

    bool inTailPosition(IrInst* inst)
    {
        if (!self.tailShapeOk(inst)) return false;
        if (self.currentFuncHasFrame) return false;
        if (self.numCalleeSaves > 0) return false;
        if (self.spillSlotCount > 0) return false;
        // Even without a frame, the prologue may reserve an alignment word
        // (spillFrameBytes == 8). A tail jmp must keep rsp at the entry
        // value so the callee's ret finds our caller's return address.
        if (self.spillFrameBytes > 0) return false;
        if (self.varargAllocSize > 0) return false;
        return true;
    }

    void emitSelect(IrInst* inst)
    {
        if (inst->nops >= 3)
        {
            str dst = self.getRegForValue(&inst->base);
            bool dstSpill = self.valueIsSpill(&inst->base);
            str work = dstSpill ? "r10" : dst;
            if (valueIsIntConst(inst->ops[0]))
            {
                IrValue* chosen = inst->ops[0]->valData != 0
                                          ? inst->ops[1] : inst->ops[2];
                if (valueIsIntConst(chosen))
                {
                    self.emitImmTo(chosen->valData, work);
                }
                else
                {
                    str src = self.valueIsSpill(chosen)
                                      ? self.opForReg(chosen, "r11")
                                      : self.opFor(chosen);
                    if (!src.equals(work))
                    {
                        self.emitter.emit("\tmovq ");
                        self.emitter.emit(src);
                        self.emitter.emit(", ");
                        self.emitter.emitLine(work);
                    }
                }
                if (dstSpill)
                {
                    self.emitter.emit("\tmovq r10, ");
                    self.emitter.emitLine(dst);
                }
                return;
            }
            str cond = self.getRegForValue(inst->ops[0]);
            str src1 = self.getRegForValue(inst->ops[1]);
            str src2 = self.getRegForValue(inst->ops[2]);
            self.emitter.emit("\ttestq ");
            self.emitter.emit(cond);
            self.emitter.emit(", ");
            self.emitter.emitLine(cond);
            if (valueIsIntConst(inst->ops[1]))
                src1 = self.opForReg(inst->ops[1], "r11");
            self.emitter.emit("\tcmovne ");
            self.emitter.emit(src1);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            if (valueIsIntConst(inst->ops[2]))
                src2 = self.opForReg(inst->ops[2], "r11");
            self.emitter.emit("\tcmovz ");
            self.emitter.emit(src2);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            if (dstSpill)
            {
                self.emitter.emit("\tmovq r10, ");
                self.emitter.emitLine(dst);
            }
        }
    }

    str xmmToYmm(str xmmReg)
    {
        // Convert xmmN to ymmN by replacing the first character. The
        // rotating String pool gives a three-operand vex op room for
        // three distinct conversions without slots going stale.
        if (xmmReg.len >= 3 && xmmReg.ptr[0] == 'x' && xmmReg.ptr[1] == 'm' && xmmReg.ptr[2] == 'm')
        {
            String* b = textBufNext();
            b->pushChar('y');
            for (u32 i = 1; i < (u32)xmmReg.len && i < 8; i++)
                b->pushChar(xmmReg.ptr[i]);
            return b->asView();
        }
        return xmmReg;
    }

    // Write a float or vector result home: the scratch carries it when
    // the value spilled, width-aware so a narrow value never writes
    // past the head of its slot.
    void sinkF(IrValue* v, str reg)
    {
        if (v == null) return;
        u32 w = v->type != null ? v->type->width : 64;
        str mv = self.valueIsVec(v)
            ? (w <= 32 ? "movd " : w <= 64 ? "movq " : "movdqu ")
            : (w == 64 ? "movq " : "movd ");
        if (self.valueIsSpill(v))
        {
            if (w > 128) self.emitter.emitComment("256-bit value spill truncates to the 16-byte slot");
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(reg);
            self.emitter.emit(", ");
            self.emitter.emitLine(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            return;
        }
        str home = self.opFor(v);
        if (!home.equals(reg))
        {
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(reg);
            self.emitter.emit(", ");
            self.emitter.emitLine(home);
        }
    }

    // Core packed op: the sse form copies src1 into the work register
    // (dst's home when it did not spill, xmm15 when it did) and folds
    // src2 in — lsra keeps dst live until after its srcs' uses, so src1
    // is never the work register and the copy is always safe. A width
    // above 128 takes the three-operand vex form when the feature bit
    // allows it (the middle source must be a register, so a spilled
    // src1 reloads into xmm0); without the bit the low half still
    // computes and a comment marks the truncation.
    void emitVecTwoOp(IrInst* inst, str mn, bool avxReady)
    {
        IrValue* dv = &inst->base;
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        IrValue* bv = (inst->nops > 1) ? inst->ops[1] : null;
        if (av == null || bv == null)
        {
            self.emitter.emitComment("vec op missing an operand");
            return;
        }
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        str work = dstSpill ? "xmm15" : dst;
        u32 w = dv->type != null ? dv->type->width : 128;
        bool vex = w > 128 && avxReady && self.emitter.features != null;
        if (w > 128 && !vex)
            self.emitter.emitComment("256-bit vector op without avx2 — low half only");
        if (vex)
        {
            str s1 = self.valueIsSpill(av) ? self.opForRegF(av, "xmm0") : self.getRegForValue(av);
            str s2 = self.getRegForValue(bv);
            self.emitter.emit("\tv");
            self.emitter.emit(mn);
            self.emitter.emit(" ");
            self.emitter.emit(self.xmmToYmm(s2));
            self.emitter.emit(", ");
            self.emitter.emit(self.xmmToYmm(s1));
            self.emitter.emit(", ");
            self.emitter.emitLine(self.xmmToYmm(work));
        }
        else
        {
            str s1 = self.getRegForValue(av);
            str s2 = self.getRegForValue(bv);
            if (!s1.equals(work))
            {
                self.emitter.emit("\tmovdqa ");
                self.emitter.emit(s1);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            self.emitter.emit("\t");
            self.emitter.emit(mn);
            self.emitter.emit(" ");
            self.emitter.emit(s2);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
        }
        if (dstSpill) self.sinkF(dv, "xmm15");
    }

    // Integer packed op: the mnemonic comes from the element width —
    // paddb/paddw/paddd/paddq and friends — while the muls with no
    // packed form (8-bit, 64-bit, pmulld before sse4.1) walk their
    // lanes instead, because pmuludq is a u32 product, not i64.
    void emitVecBinOp(IrInst* inst, str stem)
    {
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        u32 ew = 32;
        if (av != null && av->type != null && av->type->elem != null && av->type->elem->width > 0)
            ew = av->type->elem->width;
        bool avx2 = self.emitter.features != null && self.emitter.features.avx2;
        bool sse41 = self.emitter.features != null && self.emitter.features.sse41;

        if (stem.equals("mul"))
        {
            if (ew == 16)
            {
                self.emitVecTwoOp(inst, "pmullw", avx2);
                return;
            }
            if (ew == 32 && sse41)
            {
                self.emitVecTwoOp(inst, "pmulld", avx2);
                return;
            }
            self.emitVecLaneOp(inst, 1);
            return;
        }

        char[8] mnbuf;
        mnbuf[0] = 'p';
        u32 i = 1;
        while (stem.ptr[i - 1] != 0 && i < 7)
        {
            mnbuf[i] = (char)stem.ptr[i - 1];
            i++;
        }
        str sfx = ew == 64 ? "q" : ew == 16 ? "w" : ew == 8 ? "b" : "d";
        u32 k = 0;
        while (sfx.ptr[k] != 0 && i < 7)
        {
            mnbuf[i++] = (char)sfx.ptr[k++];
        }
        mnbuf[i] = 0;
        self.emitVecTwoOp(inst, str::fromParts((const u8*)mnbuf, (usize)i), avx2);
    }

    void emitVecFloatBinOp(IrInst* inst, str psOp, str pdOp)
    {
        // the pd spelling belongs to the 64-bit element lanes — the old
        // emitter ignored pdOp and sent <2 x f64> through addps
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        bool isDbl = av != null && av->type != null && av->type->elem != null &&
                     av->type->elem->width == 64;
        self.emitVecTwoOp(inst, isDbl ? pdOp : psOp,
                     self.emitter.features != null && self.emitter.features.avx);
    }

    void emitBroadcast(IrInst* inst)
    {
        // splat the source scalar across every lane. The 256-bit width
        // takes vpbroadcastd/q (xmm/m32 source, ymm is the only
        // destination); narrow int scalars first rebuild a clean dword
        // in r10 — a spilled i8/i16 slot only stores its own bytes, so
        // broadcasting the raw dword would replicate stale slot bytes.
        IrValue* dv = &inst->base;
        IrValue* sv = (inst->nops > 0) ? inst->ops[0] : null;
        if (sv == null)
        {
            self.emitter.emitComment("broadcast missing a source");
            return;
        }
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        str work = dstSpill ? "xmm15" : dst;
        u32 w = dv->type != null ? dv->type->width : 128;
        u32 ew = 32;
        if (sv->type != null && sv->type->width > 0 && sv->type->width <= 64)
            ew = sv->type->width;
        bool isFlt = self.valueIsFloatClass(sv);
        bool vex = w > 128 && self.emitter.features != null && self.emitter.features.avx2;
        if (vex)
        {
            str s;
            if (isFlt)
            {
                s = self.getRegForValue(sv);
            }
            else if (ew == 64)
            {
                s = self.valueIsSpill(sv) ? self.getRegForValue(sv) : "xmm0";
                if (!self.valueIsSpill(sv))
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(self.getRegForValue(sv));
                    self.emitter.emitLine(", xmm0");
                }
            }
            else if (ew == 32)
            {
                s = self.valueIsSpill(sv) ? self.getRegForValue(sv) : "xmm0";
                if (!self.valueIsSpill(sv))
                {
                    self.emitter.emit("\tmovd ");
                    self.emitter.emit(toReg32(self.getRegForValue(sv)));
                    self.emitter.emitLine(", xmm0");
                }
            }
            else
            {
                self.emitBcastDword(sv, ew);
                self.emitter.emitLine("\tmovd r10d, xmm0");
                s = "xmm0";
            }
            self.emitter.emit("\tvpbroadcast");
            self.emitter.emit(ew == 64 ? "q " : "d ");
            self.emitter.emit(s);
            self.emitter.emit(", ");
            self.emitter.emitLine(self.xmmToYmm(work));
        }
        else
        {
            if (w > 128) self.emitter.emitComment("256-bit broadcast without avx2 — low half only");
            if (ew == 64)
            {
                self.emitter.emit(isFlt ? "\tmovsd " : "\tmovq ");
                self.emitter.emit(self.getRegForValue(sv));
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tshufpd $1, ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            else if (ew == 32)
            {
                if (isFlt)
                {
                    self.emitter.emit("\tmovss ");
                    self.emitter.emit(self.getRegForValue(sv));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(work);
                }
                else if (self.valueIsSpill(sv))
                {
                    self.emitter.emit("\tmovd ");
                    self.emitter.emit(self.getRegForValue(sv));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(work);
                }
                else
                {
                    self.emitter.emit("\tmovd ");
                    self.emitter.emit(toReg32(self.getRegForValue(sv)));
                    self.emitter.emit(", ");
                    self.emitter.emitLine(work);
                }
                self.emitter.emit("\tshufps $0, ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            else if (ew == 16)
            {
                // the dword pattern [W W] out of a repeated-word imul,
                // then duplicate it across the qword
                self.emitBcastDword(sv, 16);
                self.emitter.emit("\tmovd r10d, ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tpunpcklqdq ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
            else
            {
                // byte lanes: the 0x01010101 pattern, widened by
                // punpcklbw and then punpcklqdq
                self.emitBcastDword(sv, 8);
                self.emitter.emit("\tmovd r10d, ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tpunpcklbw ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tpunpcklqdq ");
                self.emitter.emit(work);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
            }
        }
        if (dstSpill) self.sinkF(dv, "xmm15");
    }

    // Build the replicated dword for a narrow scalar into r10d: the
    // value zero-extends into r10d, then imul repeats it across all
    // four bytes (8-bit) or two words (16-bit).
    void emitBcastDword(IrValue* sv, u32 ew)
    {
        if (self.valueIsSpill(sv))
        {
            self.emitter.emit(ew == 8 ? "\tmovzbl " : "\tmovzwl ");
            self.emitter.emit(self.opFor(sv));
            self.emitter.emitLine(", r10d");
        }
        else
        {
            str home = self.opFor(sv);
            self.emitter.emit(ew == 8 ? "\tmovzbl " : "\tmovzwl ");
            self.emitter.emit(ew == 8 ? toReg8(home) : toReg16(home));
            self.emitter.emitLine(", r10d");
        }
        if (ew == 8)
            self.emitter.emitLine("\timul $0x01010101, r10d");
        else
            self.emitter.emitLine("\timul $0x00010001, r10d");
    }

    // Lane walk for the packed ops with no hardware form: the operands
    // park in a 16-byte window below rsp (pure sse2 — no pextr/pinsr
    // gate, so no sse4.1 dependency), each lane travels r10/r11 — and
    // rax/rdx for idiv, pushed and popped around the walk because lsra
    // hands those out like hasAny other allocatable — and the result
    // rides back through the window into the work register. The window
    // sits below rsp, inside a leaf's red zone; nothing calls while it
    // is live.
    // kind: 0 = signed divide, 1 = multiply low, 2 = unsigned min, 3 = unsigned max
    void emitVecLaneOp(IrInst* inst, u32 kind)
    {
        IrValue* dv = &inst->base;
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        IrValue* bv = (inst->nops > 1) ? inst->ops[1] : null;
        if (av == null || bv == null)
        {
            self.emitter.emitComment("vec lane op missing an operand");
            return;
        }
        u32 ew = 32;
        if (av->type != null && av->type->elem != null && av->type->elem->width > 0)
            ew = av->type->elem->width;
        u32 lanes = ew == 64 ? 2 : ew == 32 ? 4 : ew == 16 ? 8 : 16;
        u32 esz = ew / 8;
        if (esz == 0) esz = 1;
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        str work = dstSpill ? "xmm15" : dst;
        if (kind == 0)
        {
            self.emitter.emitLine("\tpushq %rax");
            self.emitter.emitLine("\tpushq %rdx");
        }
        str s1 = self.valueIsSpill(av) ? self.opForRegF(av, "xmm0") : self.getRegForValue(av);
        str s2 = self.valueIsSpill(bv) ? self.opForRegF(bv, "xmm1") : self.getRegForValue(bv);
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(s1);
        self.emitter.emitLine(", -32(%rsp)");
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(s2);
        self.emitter.emitLine(", -16(%rsp)");
        for (u32 i = 0; i < lanes; i++)
        {
            str aT = "";
            str bT = "";
            aT = rspSlotText(32 - i * esz);
            bT = rspSlotText(16 - i * esz);
            if (kind == 0)
            {
                // signed divide: narrow lanes sign-extend, the quotient
                // lands in rax/eax, and only the lane's own width goes
                // back so the neighbors survive
                if (ew == 64)
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10");
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11");
                    self.emitter.emitLine("\tmovq r10, rax");
                    self.emitter.emitLine("\tcqto");
                    self.emitter.emitLine("\tidivq r11");
                    self.emitter.emit("\tmovq rax, ");
                    self.emitter.emitLine(aT);
                }
                else
                {
                    str lmv = ew == 32 ? "\tmovl " : ew == 16 ? "\tmovswl " : "\tmovsbl ";
                    self.emitter.emit(lmv);
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10d");
                    self.emitter.emit(lmv);
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11d");
                    self.emitter.emitLine("\tmovl r10d, eax");
                    self.emitter.emitLine("\tcltd");
                    self.emitter.emitLine("\tidivl r11d");
                    str smv = ew == 32 ? "\tmovl eax, " : ew == 16 ? "\tmovw ax, " : "\tmovb al, ";
                    self.emitter.emit(smv);
                    self.emitter.emitLine(aT);
                }
            }
            else if (kind == 1)
            {
                // multiply: only the low bits of the product matter, so
                // zero-extension is enough for hasAny signedness
                if (ew == 64)
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10");
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11");
                    self.emitter.emitLine("\timulq r11, r10");
                    self.emitter.emit("\tmovq r10, ");
                    self.emitter.emitLine(aT);
                }
                else
                {
                    str lmv = ew == 32 ? "\tmovl " : ew == 16 ? "\tmovzwl " : "\tmovzbl ";
                    self.emitter.emit(lmv);
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10d");
                    self.emitter.emit(lmv);
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11d");
                    self.emitter.emitLine("\timul r11d, r10d");
                    str smv = ew == 32 ? "\tmovl r10d, " : ew == 16 ? "\tmovw r10w, " : "\tmovb r10b, ";
                    self.emitter.emit(smv);
                    self.emitter.emitLine(aT);
                }
            }
            else
            {
                // unsigned min/max by compare + cmov: covers 64-bit
                // lanes and hasAny machine without sse4.1's pminuw/pminud
                // (8-bit pminub/pmaxub are sse2 and take the packed path)
                if (ew == 64)
                {
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10");
                    self.emitter.emit("\tmovq ");
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11");
                    self.emitter.emitLine("\tcmpq r10, r11");
                    self.emitter.emitLine(kind == 2 ? "\tcmovb r11, r10" : "\tcmova r11, r10");
                    self.emitter.emit("\tmovq r10, ");
                    self.emitter.emitLine(aT);
                }
                else
                {
                    str lmv = ew == 32 ? "\tmovl " : ew == 16 ? "\tmovzwl " : "\tmovzbl ";
                    self.emitter.emit(lmv);
                    self.emitter.emit(aT);
                    self.emitter.emitLine(", r10d");
                    self.emitter.emit(lmv);
                    self.emitter.emit(bT);
                    self.emitter.emitLine(", r11d");
                    self.emitter.emitLine("\tcmpl r10d, r11d");
                    self.emitter.emitLine(kind == 2 ? "\tcmovb r11d, r10d" : "\tcmova r11d, r10d");
                    str smv = ew == 32 ? "\tmovl r10d, " : ew == 16 ? "\tmovw r10w, " : "\tmovb r10b, ";
                    self.emitter.emit(smv);
                    self.emitter.emitLine(aT);
                }
            }
        }
        self.emitter.emit("\tmovdqu -32(%rsp), ");
        self.emitter.emitLine(work);
        if (kind == 0)
        {
            self.emitter.emitLine("\tpopq %rdx");
            self.emitter.emitLine("\tpopq %rax");
        }
        if (dstSpill) self.sinkF(dv, "xmm15");
    }

    void emitVecMinMax(IrInst* inst, bool isMin)
    {
        IrValue* av = (inst->nops > 0) ? inst->ops[0] : null;
        u32 ew = 32;
        bool isFloat = false;
        if (av != null && av->type != null && av->type->elem != null)
        {
            if (av->type->elem->width > 0) ew = av->type->elem->width;
            isFloat = av->type->elem->kind == IrTypeKind::Float;
        }
        if (isFloat)
        {
            str mn = isMin
                ? (ew == 64 ? "minpd" : "minps")
                : (ew == 64 ? "maxpd" : "maxps");
            self.emitVecTwoOp(inst, mn,
                         self.emitter.features != null && self.emitter.features.avx);
            return;
        }
        // integer lanes compare unsigned — simd_vec must keep signed
        // int min/max out of VecMin/VecMax, the signed packed forms
        // arrived only with sse42
        bool sse41 = self.emitter.features != null && self.emitter.features.sse41;
        bool avx2 = self.emitter.features != null && self.emitter.features.avx2;
        if (ew == 8)
        {
            self.emitVecTwoOp(inst, isMin ? "pminub" : "pmaxub", avx2);
            return;
        }
        if ((ew == 16 || ew == 32) && sse41)
        {
            str mn = ew == 16
                ? (isMin ? "pminuw" : "pmaxuw")
                : (isMin ? "pminud" : "pmaxud");
            self.emitVecTwoOp(inst, mn, avx2);
            return;
        }
        self.emitVecLaneOp(inst, isMin ? 2 : 3);
    }

    void emitShuffle(IrInst* inst)
    {
        // the mask rides in the trailing const operands (irBuilder puts
        // v1, v2, then one ConstInt per lane); fast paths cover what a
        // single pshufd/shufps/shufpd can do and everything else —
        // other element widths, mixed sources, a non-const mask —
        // walks memory. An unsupported shape leaves the result home
        // untouched, the same as an unhandled opcode.
        if (inst->nops < 2)
        {
            self.emitter.emitComment("shufflevector missing operands");
            return;
        }
        IrValue* dv = &inst->base;
        IrValue* v1 = inst->ops[0];
        IrValue* v2 = inst->ops[1];
        u32 nmask = inst->nops - 2;
        u32 ew = 32;
        if (v1->type != null && v1->type->elem != null && v1->type->elem->width > 0)
            ew = v1->type->elem->width;
        u32 lanes = ew == 64 ? 2 : ew == 32 ? 4 : ew == 16 ? 8 : 16;
        if (nmask != lanes)
        {
            self.emitter.emitComment("shufflevector mask length mismatch");
            return;
        }
        u32[16] m;
        bool allOne = true;
        bool allTwo = true;
        for (u32 i = 0; i < nmask; i++)
        {
            IrValue* e = inst->ops[2 + i];
            if (e == null || e->kind != IrValueKind::ConstInt)
            {
                self.emitter.emitComment("shufflevector non-constant mask");
                return;
            }
            u64 val = e->valData;
            if (val >= (u64)(2 * lanes))
            {
                self.emitter.emitComment("shufflevector lane out of range");
                return;
            }
            m[i] = (u32)val;
            if (m[i] >= lanes) allOne = false;
            else allTwo = false;
        }
        u32 w = dv->type != null ? dv->type->width : 128;
        if (w > 128) self.emitter.emitComment("256-bit shuffle handled for the low half only");
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        str work = dstSpill ? "xmm15" : dst;
        str s1 = self.getRegForValue(v1);
        str s2 = self.getRegForValue(v2);

        // one pshufd covers hasAny pattern living in a single source —
        // 32-bit lanes select dwords, 64-bit lanes select dword pairs
        if (lanes <= 4 && (allOne || allTwo))
        {
            u32 imm = 0;
            for (u32 i = 0; i < nmask; i++)
            {
                u32 sel = allOne ? m[i] : m[i] - lanes;
                u32 d0 = ew == 64 ? sel * 2 : sel;
                imm |= (d0 & 3) << (4 * i);
                if (ew == 64) imm |= ((d0 + 1) & 3) << (4 * i + 2);
            }
            self.emitter.emit("\tpshufd $");
            self.emitter.emitU32(imm);
            self.emitter.emit(", ");
            self.emitter.emit(allOne ? s1 : s2);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            if (dstSpill) self.sinkF(dv, "xmm15");
            return;
        }

        // the dword split: v1 supplies lanes 0-1, v2 lanes 2-3, one
        // shufps after a copy of the left half
        if (ew == 32 && lanes == 4 && m[0] < 4 && m[1] < 4 && m[2] >= 4 && m[3] >= 4)
        {
            u32 imm = m[0] | (m[1] << 2) | ((m[2] - 4) << 4) | ((m[3] - 4) << 6);
            self.emitter.emit("\tmovdqa ");
            self.emitter.emit(s1);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            self.emitter.emit("\tshufps $");
            self.emitter.emitU32(imm);
            self.emitter.emit(", ");
            self.emitter.emit(s2);
            self.emitter.emit(", ");
            self.emitter.emitLine(work);
            if (dstSpill) self.sinkF(dv, "xmm15");
            return;
        }

        // the qword split: either side may hold either lane
        if (ew == 64 && lanes == 2)
        {
            if (m[0] < 2)
            {
                u32 imm = m[0] | ((m[1] - 2) << 1);
                self.emitter.emit("\tmovdqa ");
                self.emitter.emit(s1);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tshufpd $");
                self.emitter.emitU32(imm);
                self.emitter.emit(", ");
                self.emitter.emit(s2);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                if (dstSpill) self.sinkF(dv, "xmm15");
                return;
            }
            if (m[1] < 2)
            {
                u32 imm = (m[0] - 2) | (m[1] << 1);
                self.emitter.emit("\tmovdqa ");
                self.emitter.emit(s2);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                self.emitter.emit("\tshufpd $");
                self.emitter.emitU32(imm);
                self.emitter.emit(", ");
                self.emitter.emit(s1);
                self.emitter.emit(", ");
                self.emitter.emitLine(work);
                if (dstSpill) self.sinkF(dv, "xmm15");
                return;
            }
        }

        // general path: park both inputs, copy each selected lane into
        // a result window below them, then lift the result back out —
        // hasAny element width, hasAny const mask, sse2 only
        str s1s = self.valueIsSpill(v1) ? self.opForRegF(v1, "xmm0") : self.getRegForValue(v1);
        str s2s = self.valueIsSpill(v2) ? self.opForRegF(v2, "xmm1") : self.getRegForValue(v2);
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(s1s);
        self.emitter.emitLine(", -32(%rsp)");
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(s2s);
        self.emitter.emitLine(", -16(%rsp)");
        u32 esz = ew / 8;
        if (esz == 0) esz = 1;
        for (u32 i = 0; i < nmask; i++)
        {
            u32 base = m[i] < lanes ? 32 : 16;
            u32 laneIdx = m[i] < lanes ? m[i] : m[i] - lanes;
            str srcA = "";
            str resA = "";
            srcA = rspSlotText(base - laneIdx * esz);
            resA = rspSlotText(48 - i * esz);
            str mv = esz == 1 ? "\tmovb " : esz == 2 ? "\tmovw " : esz == 4 ? "\tmovl " : "\tmovq ";
            str r = esz == 1 ? "r10b" : esz == 2 ? "r10w" : esz == 4 ? "r10d" : "r10";
            self.emitter.emit(mv);
            self.emitter.emit(srcA);
            self.emitter.emit(", ");
            self.emitter.emitLine(r);
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(resA);
        }
        self.emitter.emit("\tmovdqu -48(%rsp), ");
        self.emitter.emitLine(work);
        if (dstSpill) self.sinkF(dv, "xmm15");
    }

    void emitExtractElem(IrInst* inst)
    {
        // the vector parks in a window below rsp so a dynamic index
        // addresses it with a SIB form (an rbp displacement cannot
        // scale), and the loaded lane rides in r11 (int) or xmm15
        // (float) into its home
        if (inst->nops < 2)
        {
            self.emitter.emitComment("extractelement missing operands");
            return;
        }
        IrValue* dv = &inst->base;
        IrValue* vv = inst->ops[0];
        IrValue* iv = inst->ops[1];
        u32 ew = 32;
        if (vv->type != null && vv->type->elem != null && vv->type->elem->width > 0)
            ew = vv->type->elem->width;
        u32 lanes = ew == 64 ? 2 : ew == 32 ? 4 : ew == 16 ? 8 : 16;
        u32 esz = ew / 8;
        if (esz == 0) esz = 1;
        str addr = "";
        if (iv->kind == IrValueKind::Inst)
        {
            str ix = self.opForReg(iv, "r10");
            addr = sibText(16, ix, esz);
        }
        else if (iv->kind == IrValueKind::ConstInt)
        {
            u64 val = iv->valData;
            if (val >= (u64)lanes)
            {
                self.emitter.emitComment("extractelement lane out of range");
                return;
            }
            addr = rspSlotText(16 - (u32)val * esz);
        }
        else
        {
            self.emitter.emitComment("extractelement index not constant");
            return;
        }
        str vs = self.valueIsSpill(vv) ? self.opForRegF(vv, "xmm1") : self.getRegForValue(vv);
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(vs);
        self.emitter.emitLine(", -16(%rsp)");
        if (self.valueIsFloatClass(dv))
        {
            self.emitter.emit(ew == 64 ? "\tmovsd " : "\tmovd ");
            self.emitter.emit(addr);
            self.emitter.emitLine(", xmm15");
            self.sinkF(dv, "xmm15");
            return;
        }
        str lmv = ew == 8 ? "\tmovzbl " : ew == 16 ? "\tmovzwl " : ew == 32 ? "\tmovl " : "\tmovq ";
        str lr = ew == 64 ? "r11" : "r11d";
        self.emitter.emit(lmv);
        self.emitter.emit(addr);
        self.emitter.emit(", ");
        self.emitter.emitLine(lr);
        self.sinkInt(dv, "r11");
    }

    void emitInsertElem(IrInst* inst)
    {
        // symmetric to extract: the vector parks in a window, the
        // element lands at its lane offset (dynamic index in r11, a
        // spilled element reloads through xmm0), and the windowed
        // vector comes back out through the work register
        if (inst->nops < 3)
        {
            self.emitter.emitComment("insertelement missing operands");
            return;
        }
        IrValue* dv = &inst->base;
        IrValue* vv = inst->ops[0];
        IrValue* iv = inst->ops[1];
        IrValue* ev = inst->ops[2];
        u32 ew = 32;
        if (vv->type != null && vv->type->elem != null && vv->type->elem->width > 0)
            ew = vv->type->elem->width;
        u32 lanes = ew == 64 ? 2 : ew == 32 ? 4 : ew == 16 ? 8 : 16;
        u32 esz = ew / 8;
        if (esz == 0) esz = 1;
        str addr = "";
        if (iv->kind == IrValueKind::Inst)
        {
            str ix = self.opForReg(iv, "r11");
            addr = sibText(16, ix, esz);
        }
        else if (iv->kind == IrValueKind::ConstInt)
        {
            u64 val = iv->valData;
            if (val >= (u64)lanes)
            {
                self.emitter.emitComment("insertelement lane out of range");
                return;
            }
            addr = rspSlotText(16 - (u32)val * esz);
        }
        else
        {
            self.emitter.emitComment("insertelement index not constant");
            return;
        }
        str vs = self.valueIsSpill(vv) ? self.opForRegF(vv, "xmm1") : self.getRegForValue(vv);
        self.emitter.emit("\tmovdqu ");
        self.emitter.emit(vs);
        self.emitter.emitLine(", -16(%rsp)");
        if (self.valueIsFloatClass(ev))
        {
            str s = self.valueIsSpill(ev) ? self.opForRegF(ev, "xmm0") : self.opFor(ev);
            self.emitter.emit(ew == 64 ? "\tmovsd " : "\tmovd ");
            self.emitter.emit(s);
            self.emitter.emit(", ");
            self.emitter.emitLine(addr);
        }
        else
        {
            str s = self.valueIsSpill(ev) ? self.opForReg(ev, "r10") : self.opFor(ev);
            str mv = ew == 8 ? "movb " : ew == 16 ? "movw " : ew == 32 ? "movl " : "movq ";
            str r = ew == 8 ? toReg8(s) : ew == 16 ? toReg16(s) : ew == 32 ? toReg32(s) : s;
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(addr);
        }
        str dst = self.getRegForValue(dv);
        bool dstSpill = self.valueIsSpill(dv);
        str work = dstSpill ? "xmm15" : dst;
        self.emitter.emit("\tmovdqu -16(%rsp), ");
        self.emitter.emitLine(work);
        if (dstSpill) self.sinkF(dv, "xmm15");
    }

    void emitAbs(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src);
        self.emitter.emitLine(", %r10");
        self.emitter.emitTab("negq %r10");
        self.emitter.emit("\tcmovns %r10, ");
        self.emitter.emitLine(dst);
    }

    void emitCtPop(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        if (self.emitter.features != null && self.emitter.features.popcnt)
        {
            self.emitter.emit("\tpopcntq ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        else
        {
            // Software fallback: x &= x-1 pattern
            self.emitter.emit("\tmovq ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
            self.emitter.emitTab("xorq %r10, %r10");
            self.emitter.emitTab(".Lctpop:");
            self.emitter.emit("\ttestq ");
            self.emitter.emit(dst);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
            self.emitter.emitTab("jz .Lctpop_done");
            self.emitter.emitTab("incq %r10");
            self.emitter.emit("\tmovq ");
            self.emitter.emit(dst);
            self.emitter.emitLine(", %rcx");
            self.emitter.emitTab("decq %rcx");
            self.emitter.emit("\tandq %rcx, ");
            self.emitter.emitLine(dst);
            self.emitter.emitTab("jmp .Lctpop");
            self.emitter.emitTab(".Lctpop_done:");
            self.emitter.emit("\tmovq %r10, ");
            self.emitter.emitLine(dst);
        }
    }

    void emitCtLz(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        if (self.emitter.features != null && self.emitter.features.lzcnt)
        {
            self.emitter.emit("\tlzcntq ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        else
        {
            // Fallback: use bsr (bit scan reverse)
            self.emitter.emit("\tmovq $63, ");
            self.emitter.emitLine(dst);
            self.emitter.emit("\tbsrq ");
            self.emitter.emit(src);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    void emitCtTz(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        self.emitter.emit("\tbsfq ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
    }

    void emitBswap(IrInst* inst)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        self.emitter.emit("\tbswapq ");
        self.emitter.emitLine(dst);
    }

    void emitRot(IrInst* inst, str op)
    {
        str dst = self.getRegForValue(&inst->base);
        str src = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "rax";
        str amt = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "rcx";
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src);
        self.emitter.emit(", ");
        self.emitter.emitLine(dst);
        // Rotate amount must be in %cl
        if (!amt.equals("rcx") && !amt.equals("cl"))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(amt);
            self.emitter.emitLine(", %rcx");
        }
        self.emitter.emit("\t");
        self.emitter.emit(op);
        self.emitter.emit(" %cl, ");
        self.emitter.emitLine(dst);
    }

    void emitMinMax(IrInst* inst, str cmpOp, bool isMin, bool isUnsigned)
    {
        str dst = self.getRegForValue(&inst->base);
        str src1 = (inst->nops > 0) ? self.getRegForValue(inst->ops[0]) : "xmm0";
        str src2 = (inst->nops > 1) ? self.getRegForValue(inst->ops[1]) : "xmm1";
        // cmp and cmov destinations are register-only, a spill works in r10
        bool dstSpill = self.valueIsSpill(&inst->base);
        str work = dstSpill ? "r10" : dst;
        self.emitter.emit("\tmovq ");
        self.emitter.emit(src1);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        self.emitter.emit("\tcmpq ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        self.emitter.emit("\t");
        // Use unsigned comparison for UMin/UMax
        if (isUnsigned)
            self.emitter.emit(isMin ? "cmovbe " : "cmovae ");
        else
            self.emitter.emit(isMin ? "cmovle " : "cmovge ");
        self.emitter.emit(src2);
        self.emitter.emit(", ");
        self.emitter.emitLine(work);
        if (dstSpill)
        {
            self.emitter.emit("\tmovq r10, ");
            self.emitter.emitLine(dst);
        }
    }
}

void u32ToHex(u32 val, u8* out)
{
    str hex = "0123456789abcdef";
    out[0] = '0';
    out[1] = 'x';
    for (u32 i = 7; i >= 0; i--)
        out[2 + (7 - i)] = hex.ptr[(val >> (i * 4)) & 0xF];
    out[10] = 0;
}
