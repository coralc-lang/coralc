#[[no_drop_all]]
// Register names the allocator must never see in a vreg: the frame and
// stack pointer, plus every register this backend needs as scratch for its
// own instruction sequences (VecDiv/Abs/Fcvt walk through r10 and r11,
// spill reloads use xmm0/xmm1/xmm15, shift counts dance through rcx with
// %r11 as the save, and call marshalling's cycle-breaker is r10).
// lsra filters these out of its allocatable set
// via RegAllocConfig.reservedIntRegs/reservedFloatRegs, so the two lists
// below must contain exactly the registers the emitter treats as scratch.
// The platform drivers all come through this one shared base while the
// ports are in flight, and once everything is verified and tested we split them
// apart for good, each platform taking its own copy, so nothing carries
// a pile of if comparisons along the way to ask which platform it is.
pub str[] X86_64_RESERVED_INT = {
    "rsp", "rbp", "rax", "rcx", "rdx", "r10", "r11"
};

pub str[] X86_64_RESERVED_FLOAT = {
    "xmm0", "xmm1", "xmm15"
};

// The allocatable set lsra hands out, in exactly lsra's order:
// caller-save minus the reserved scratch set, then callee-save minus
// the same reserved set (lsra.crl buildRegAlloc: caller-save entries
// first, then callee-save entries, skipping reserved).
//
// SysV caller (rax,rcx,rdx,rsi,rdi,r8,r9,r10,r11) minus reserved
// leaves rsi,rdi,r8,r9; callee (rbx,rbp,r12,r13,r14,r15) minus rbp
// leaves rbx,r12,r13,r14,r15. Win64 caller (rax,rcx,rdx,r8,r9,r10,r11)
// leaves r8,r9; callee (rbx,rbp,rdi,rsi,r12,r13,r14,r15) minus rbp
// leaves rbx,rdi,rsi,r12,r13,r14,r15. Both lists are spelled out
// separately below and picked by `intRegNameFor`, rather than letting
// the two drift apart again.
pub str[] X86_64_INT_REGS = {
    "rsi", "rdi", "r8", "r9", "rbx", "r12", "r13", "r14", "r15"
};

pub str[] X86_64_INT_REGS_WIN64 = {
    "r8", "r9", "rbx", "rdi", "rsi", "r12", "r13", "r14", "r15"
};

pub str[] X86_64_FLOAT_REGS = {
    "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7"
};

import wallvm::irtypes { IrContext, IrModule, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType, IrTypeKind, IrStringConst, IrGlobal, IrArrayConst, IrStructConst };
import wallvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred };
import wallvm::irMetadata { funcIsEntry, funcIsNaked, hasFuncAttr, funcAttrInt };
import wallvm::assembly::x86::common { lookupReg };
import std::string { String };
import std::mman { alloc, dealloc };
import std::ios { eprintln };
import wallvm::assembly::common { parseConstraints, AsmConstraint, AsmConClass, AsmParseError };


pub struct CpuFeatures
{
    bool sse;
    bool sse2;
    bool sse3;
    bool ssse3;
    bool sse41;
    bool sse42;
    bool avx;
    bool avx2;
    bool avx512f;
    bool avx512bw;
    bool fma;
    bool bmi1;
    bool bmi2;
    bool popcnt;
    bool lzcnt;
}

pub CpuFeatures defaultCpuFeatures()
{
    return CpuFeatures {
        .sse = true, .sse2 = true, .sse3 = false, .ssse3 = false,
        .sse41 = false, .sse42 = false, .avx = false, .avx2 = false,
        .avx512f = false, .avx512bw = false,
        .fma = false, .bmi1 = false, .bmi2 = false,
        .popcnt = false, .lzcnt = false
    };
}

pub struct ElfMetadata
{
    str section;
    bool isGlobal;
}

pub ElfMetadata defaultFuncMeta()
{
    return ElfMetadata { .section = ".text", .isGlobal = true };
}

pub struct X86_64Emitter
{
    IrContext* ctx;
    IrModule* modd;
    CpuFeatures* features;
    bool useAtt;
    String output;
    String dataSection;
    String attOutput;
    u32 labelCounter;
    bool fabMaskDNeeded;
    bool fabMaskSNeeded;
    bool uiToOneNeeded;
    bool dataFlushed;

    void init(IrContext* ctx,
              IrModule* modd,
              bool useAtt, CpuFeatures* feats)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.features = feats;
        self.useAtt = useAtt;
        self.output = String::new();
        self.dataSection = String::new();
        self.attOutput = String::new();
        self.labelCounter = 0;
        self.fabMaskDNeeded = false;
        self.fabMaskSNeeded = false;
        self.uiToOneNeeded = false;
        self.dataFlushed = false;
    }

    u32 nextLabel()
    {
        return self.labelCounter++;
    }

    void emit(str s)
    {
        if (s.ptr == null) return;
        self.output.pushView(s);
    }

    void emitLine(str strv)
    {
        self.emit(strv);
        self.emit("\n");
    }

    void emitTab(str instrv)
    {
        self.emit("\t");
        self.emitLine(instrv);
    }

    void emitComment(str comment)
    {
        self.emit("\t# ");
        self.emitLine(comment);
    }

    void emitData(str s)
    {
        if (s.ptr == null) return;
        self.dataSection.pushView(s);
    }

    void emitDataLine(str strv)
    {
        self.emitData(strv);
        self.emitData("\n");
    }

    // deferred constants: requested during instruction emission, written
    // once at the end of getOutput so the .data switch cannot capture
    // instruction text (and repeated uses cannot redefine the label)
    void needFabsMask(bool isDouble)
    {
        if (isDouble) self.fabMaskDNeeded = true;
        else self.fabMaskSNeeded = true;
    }

    void needUiToOne()
    {
        self.uiToOneNeeded = true;
    }

    void emitU32(u32 val)
    {
        if (val == 0) { self.output.pushChar('0'); return; }
        u8[16] buf;
        u32 n = 0;
        while (val > 0) { buf[n++] = (u8)('0' + (val % 10)); val /= 10; }
        while (n > 0) { n--; self.output.pushChar(buf[n]); }
    }

    str getOutput()
    {
        if (!self.dataFlushed)
        {
            self.dataFlushed = true;
            if (self.fabMaskDNeeded || self.fabMaskSNeeded || self.uiToOneNeeded)
            {
                // after the function stream (and the globals/string pool):
                // switching to .data here cannot capture any instruction text
                self.emitLine(".section .data");
                if (self.fabMaskDNeeded)
                    self.emitLine(".Lfabs_mask_d:\n\t.quad 0x7fffffffffffffff, 0");
                if (self.fabMaskSNeeded)
                    self.emitLine(".Lfabs_mask_s:\n\t.long 0x7fffffff, 0, 0, 0");
                if (self.uiToOneNeeded)
                {
                    // 1.0 as bit patterns: the in-repo assembler has no
                    // .double/.float directive
                    self.emitLine(".Lui_to_fp_one_d:\n\t.quad 0x3ff0000000000000");
                    self.emitLine(".Lui_to_fp_one_s:\n\t.long 0x3f800000");
                }
            }
        }
        if (!self.useAtt) return self.output.asView();
        str src = self.output.asView();
        self.attOutput = String::withCap(src.len + src.len / 4 + 16);
        usize i = 0;
        while (i < src.len)
        {
            u8 c = (u8)src[i];
            if (c == '#' || c == ';')
            {
                usize start = i;
                while (i < src.len && (u8)src[i] != (u8)'\n') i++;
                if (i < src.len) i++;
                self.attOutput.pushView(str::fromParts((const u8*)(src.ptr + start), i - start));
                continue;
            }
            if (c == '%')
            {
                usize start = i;
                i++;
                while (i < src.len)
                {
                    u8 cc = (u8)src[i];
                    if (!((cc >= 'a' && cc <= 'z') || (cc >= 'A' && cc <= 'Z') || cc == '_' || (cc >= '0' && cc <= '9'))) break;
                    i++;
                }
                self.attOutput.pushView(str::fromParts((const u8*)(src.ptr + start), i - start));
                continue;
            }
            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_')
            {
                usize start = i;
                i++;
                while (i < src.len)
                {
                    u8 cc = (u8)src[i];
                    if (!((cc >= 'a' && cc <= 'z') || (cc >= 'A' && cc <= 'Z') || cc == '_' || (cc >= '0' && cc <= '9'))) break;
                    i++;
                }
                str tok = str::fromParts((const u8*)(src.ptr + start), i - start);
                if (lookupReg(tok) != null) self.attOutput.pushChar('%');
                self.attOutput.pushView(tok);
                continue;
            }
            self.attOutput.pushChar(c);
            i++;
        }
        return self.attOutput.asView();
    }
}

static String[16] _textBuf;
static u32 _textI = 0;

static String* textBufNextImpl()
{
    String* b = &_textBuf[_textI++ & 15];
    if (b->ptr == null) *b = String::withCap(64);
    b->clear();
    return b;
}

pub String* textBufNext() { return textBufNextImpl(); }

pub str u32ToStr(u32 val)
{
    String* b = textBufNext();
    if (val == 0) { b->pushChar('0'); return b->asView(); }
    u8[16] tmp;
    u32 n = 0;
    while (val > 0) { tmp[n++] = (u8)('0' + (val % 10)); val /= 10; }
    while (n > 0) { n--; b->pushChar(tmp[n]); }
    return b->asView();
}

// Full-width immediates print as hex: every u64 fits in 16 digits and
// gas never balks at a 0x-prefixed value the way it can at an
// out-of-range unsigned decimal.
pub str u64ToHex(u64 val)
{
    String* b = textBufNext();
    b->pushView("0x");
    for (u32 i = 0; i < 16; i++)
    {
        u32 sh = (u32)((15u - i) * 4u);
        u32 nib = ((u32)(val >> (u64)sh)) & 0xFu;
        b->pushChar(nib < 10 ? (u8)('0' + nib) : (u8)('a' + (nib - 10)));
    }
    return b->asView();
}

pub bool valueIsIntConst(IrValue* v)
{
    return v != null && v->kind == IrValueKind::ConstInt;
}

pub str intImmText(IrValue* v)
{
    String* b = textBufNext();
    b->pushChar('$');
    b->pushView(u64ToHex(v->valData));
    return b->asView();
}

pub str i64ToDec(i64 v)
{
    String* b = textBufNext();
    if (v < 0)
    {
        b->pushChar('-');
        u64 mag = (u64)(-(v + 1)) + 1;
        u8[24] tmp;
        u32 n = 0;
        while (mag > 0) { tmp[n++] = (u8)('0' + (mag % 10)); mag /= 10; }
        if (n == 0) b->pushChar('0');
        while (n > 0) { n--; b->pushChar(tmp[n]); }
        return b->asView();
    }
    u64 mag = (u64)v;
    u8[24] tmp;
    u32 n = 0;
    while (mag > 0) { tmp[n++] = (u8)('0' + (mag % 10)); mag /= 10; }
    if (n == 0) b->pushChar('0');
    while (n > 0) { n--; b->pushChar(tmp[n]); }
    return b->asView();
}

pub str i64ToHex(i64 v)
{
    String* b = textBufNext();
    if (v < 0)
    {
        b->pushChar('-');
        u64 mag = (u64)(-(v + 1)) + 1;
        b->pushView(u64ToHex(mag));
        return b->asView();
    }
    b->pushView(u64ToHex((u64)v));
    return b->asView();
}

// Parameter-seeding staging slot address: "0(%rsp)", "8(%rsp)", ...
pub str stageText(u32 off)
{
    String* b = textBufNext();
    b->pushView(u32ToStr(off));
    b->pushView("(%rsp)");
    return b->asView();
}

// Scratch-window address below rsp: "-32(%rsp)", "-48(%rsp)", ...
pub str rspSlotText(u32 disp)
{
    String* b = textBufNext();
    b->pushChar('-');
    b->pushView(u32ToStr(disp));
    b->pushView("(%rsp)");
    return b->asView();
}

// Scratch-window address at or above rsp: "0(%rsp)", "32(%rsp)", ...
pub str rspPosText(u32 disp)
{
    String* b = textBufNext();
    b->pushView(u32ToStr(disp));
    b->pushView("(%rsp)");
    return b->asView();
}

// Indexed window address: "-16(%rsp, r10, 4)"
pub str sibText(u32 disp, str idxReg, u32 scale)
{
    String* b = textBufNext();
    b->pushChar('-');
    b->pushView(u32ToStr(disp));
    b->pushView("(rsp, ");
    b->pushView(idxReg);
    b->pushView(", ");
    b->pushView(u32ToStr(scale));
    b->pushChar(')');
    return b->asView();
}

static String[16] _r32buf;
static u32 _r32i = 0;

// True for the r8-r15 family: 'r' followed by one or two digits. Only
// these get a d/w/b suffix appended by toReg32/16/8; memory operands
// ("-32(%rbp)") and already-sized names ("esi") pass through untouched.
pub bool isRnReg(str r)
{
    if (r.len < 2 || r.len > 3) return false;
    if (r.ptr[0] != 'r') return false;
    for (usize i = 1; i < r.len; i++)
        if (r.ptr[i] < '0' || r.ptr[i] > '9') return false;
    return true;
}

pub str toReg32(str r)
{
    String* b = &_r32buf[_r32i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar('e');
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('d');
        return b->asView();
    }
    return r;
}

static String[16] _r16buf;
static u32 _r16i = 0;

pub str toReg16(str r)
{
    String* b = &_r16buf[_r16i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('w');
        return b->asView();
    }
    return r;
}

// Strip the 32-bit suffix from an opcode and append w/b for narrow work.
pub str narrowOp(str lOp, u32 width)
{
    if (width == 32) return lOp;
    String* b = textBufNext();
    b->pushView(str::fromParts((const u8*)lOp.ptr, lOp.len - 1));
    b->pushChar(width == 16 ? 'w' : 'b');
    return b->asView();
}

// predicate ordinals run 0..9, a name table beats a ten-arm switch
static str[10] SETCC_INT = {
    "sete", "setne", "setl", "setle", "setg", "setge", "setb", "setbe", "seta", "setae"
};
// branch forms of the same predicates: TRUE jumps when the condition
// holds, FALSE when it does not — emitCondBr fuses an icmp that only
// feeds it into `cmp` + one of these, skipping the setcc/movzx/testq
// materialization the bool would otherwise take
static str[10] JCC_INT_TRUE = {
    "je", "jne", "jl", "jle", "jg", "jge", "jb", "jbe", "ja", "jae"
};

static str[10] JCC_INT_FALSE = {
    "jne", "je", "jge", "jg", "jle", "jl", "jae", "ja", "jbe", "jb"
};

pub str setccIntOp(u32 pred) { return pred < 10 ? SETCC_INT[pred] : "sete"; }
pub str jccIntTrueOp(u32 pred) { return pred < 10 ? JCC_INT_TRUE[pred] : "jne"; }
pub str jccIntFalseOp(u32 pred) { return pred < 10 ? JCC_INT_FALSE[pred] : "je"; }

static String[16] _r8buf;
static u32 _r8i = 0;

pub str toReg8(str r)
{
    if (r.equals("rax")) return "al";
    if (r.equals("rbx")) return "bl";
    if (r.equals("rcx")) return "cl";
    if (r.equals("rdx")) return "dl";
    String* b = &_r8buf[_r8i++ & 15];
    if (b->ptr == null) *b = String::withCap(16);
    b->clear();
    if (r.len == 2 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar('l');
        return b->asView();
    }
    if (r.len == 3 && r.ptr[0] == 'r' && r.ptr[1] >= 'a' && r.ptr[1] <= 'z')
    {
        b->pushChar(r.ptr[1]);
        b->pushChar(r.ptr[2]);
        b->pushChar('l');
        return b->asView();
    }
    if (isRnReg(r))
    {
        b->pushView(r);
        b->pushChar('b');
        return b->asView();
    }
    return r;
}

pub struct X86_64CodeGen
{
    IrContext* ctx;
    IrModule* modd;
    X86_64Emitter emitter;
    bool isWindows;
    bool currentFuncHasFrame;
    bool useRedZone;
    bool[16] savedCalleeSaves;
    u32 numCalleeSaves;
    u32 redZoneSpillOffset;
    str lastCallTarget;
    IrValue* lastCallResult;
    IrInst* tailJmpCall;   // the call that already emitted a tail jmp, its Ret emits nothing
    bool omitFramePointer;
    u32 varargAllocSize;
    u32 shadowAllocSize;
    bool calleeSavesPushed;
    u32 shrinkWrapFirstUseBlock;
    bool hasDeferredFrame;
    u32 spillSlotCount;
    u32 spillFrameBytes;
    u32* spillSlotSizes;
    u32* spillSlotOffsets;
    u32 spillRegionBytes;
    bool spillRbpPushed;
    IrFunc* currentFunc;
    u32 allocaBase;
    u32 allocaBytes;
    str[16] asmTaken;
    u32 asmTakenN;

    // Float constants whose labels the emitters have consulted, in
    // first-use order. The label is id-derived (floatConstLabel), so
    // every consumer and the pool writer spell it the same way without
    // a side table; this array only decides which entries get written.
    // Freed by emitFloatConsts once the pool is out.
    IrValue** fcConsts;
    u32 nfcConsts;
    u32 capfcConsts;

    // Param-seeding plan: classification runs once into these records
    // and both emission walks replay them, so the stage and commit
    // phases can agree on skip decisions and on staging layout. The
    // capacity far exceeds any real signature.
    u32[128] sdKind;
    u32[128] sdReg;
    u32[128] sdOff;
    u32[128] sdWords;
    u32[128] sdSlot;
    bool[128] sdSkip;
    IrValue*[128] sdSrc;
    IrValue*[128] sdDst;
    u32 nSeedsPlanned;
    u32 sdStageBytes;

    void init(IrContext* ctx,
              IrModule* modd,
              bool isWindows, bool useAtt,
              CpuFeatures* feats)
    {
        self.ctx = ctx;
        self.modd = modd;
        self.isWindows = isWindows;
        self.omitFramePointer = true;
        self.currentFunc = null;
        self.allocaBase = 0;
        self.allocaBytes = 0;
        self.fcConsts = null;
        self.nfcConsts = 0;
        self.capfcConsts = 0;
        self.spillSlotSizes = null;
        self.spillSlotOffsets = null;
        self.spillRegionBytes = 0;
        self.emitter.init(ctx, modd, useAtt, feats);
    }

    static bool isCalleeSaved(str reg, bool isWin)
    {
        if (reg.equals("rbx")) return true;
        if (reg.equals("rbp")) return true;
        if (reg.equals("r12")) return true;
        if (reg.equals("r13")) return true;
        if (reg.equals("r14")) return true;
        if (reg.equals("r15")) return true;
        if (isWin)
        {
            if (reg.equals("rdi")) return true;
            if (reg.equals("rsi")) return true;
        }
        return false;
    }

    str intRegNameFor(u32 reg)
    {
        if (self.isWindows)
        {
            if (reg < 9) return X86_64_INT_REGS_WIN64[reg];
            return "";
        }
        if (reg < 9) return X86_64_INT_REGS[reg];
        return "";
    }

    // Register name for a non-spilled value, slot text for a spill,
    // empty string only for out-of-range. Emission sites must go
    // through opFor/opForReg/opForRegF instead of reading this.
    str getRegName(IrValue* val)
    {
        if (val == null) return "rax";
        // Args get their valData rewritten to the encoded reg exactly like
        // Inst results — rejecting them here hid every param's register
        // from funcUsesReg/blockUsesReg, so a callee-save home assigned to
        // a parameter was never pushed/popped.
        if (val->kind != IrValueKind::Inst && val->kind != IrValueKind::Arg) return "";
        u64 vd = val->valData;
        if (vd & 0x80000000UL)
            return "";
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        return self.intRegNameFor(reg);
    }

    bool funcUsesReg(IrFunc* func, str reg)
    {
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                str dst = self.getRegName(&inst->base);
                if (dst.equals(reg)) return true;
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    str op = self.getRegName(inst->ops[oi]);
                    if (op.equals(reg)) return true;
                }
            }
        }
        return false;
    }

    bool blockUsesReg(IrBlock* bb, str reg)
    {
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            str dst = self.getRegName(&inst->base);
            if (dst.equals(reg)) return true;
            for (u32 oi = 0; oi < inst->nops; oi++)
            {
                str op = self.getRegName(inst->ops[oi]);
                if (op.equals(reg)) return true;
            }
        }
        return false;
    }

    /* module string constants: one NUL-terminated record per unique
     * literal in a mergeable strings section ("aM" = SHF_MERGE +
     * SHF_STRINGS), so both GAS and the linker can fold equal payloads
     * and the terminator is part of the record the merge key includes */

    /* label for a float constant's pool entry: id-derived, so opFor,
     * homeOf, call-argument moves and the pool writer all spell it the
     * same way, and a consult registers the constant for emission.
     * constFloat interns per type+bits, so one value == one entry. */
    str floatConstLabel(IrValue* v)
    {
        if (v == null) return str::empty();
        bool seen = false;
        for (u32 i = 0; i < self.nfcConsts; i++)
            if (self.fcConsts[i] == v) { seen = true; break; }
        if (!seen)
        {
            if (self.nfcConsts >= self.capfcConsts)
            {
                u32 newCap = self.capfcConsts ? self.capfcConsts * 2 : 8;
                IrValue** arr = alloc<IrValue*>((usize)newCap);
                if (self.fcConsts != null)
                {
                    copy<IrValue*>(arr, self.fcConsts, (usize)self.nfcConsts);
                    dealloc<IrValue*>(self.fcConsts);
                }
                self.fcConsts = arr;
                self.capfcConsts = newCap;
            }
            self.fcConsts[self.nfcConsts] = v;
            self.nfcConsts++;
        }
        String* b = textBufNext();
        b->pushView(".Lcf");
        b->pushView(u32ToStr(v->id));
        return b->asView();
    }

    /* the float constant pool: every constant the emitters consulted,
     * written after the code the way emitConstStrings writes the string
     * pool (forward rip-relative references resolve at link time).
     * Entries are .quad and 8-aligned for both widths — float bits also
     * travel through GPRs (movq) and over 64-bit slots, and an 8-byte
     * record keeps every one of those loads inside the entry; f32
     * narrows to its low 32 bits first, exactly like emitGlobalConstValue
     * does for initialised data. */

    /* file-scope variables: one record per defined global, initialised
     * from its IR constant or zero-filled. Emitted after the function
     * stream (like the string pool) so the section switch cannot capture
     * any instruction text, and read back through the same rip-relative
     * folding a literal's address gets. */

    /* one global's bytes: a scalar, an aggregate folded at compile
     * time, a byte array, or (when nothing represents it) zero fill */

    /* an integer scalar at `size` bytes: the directive and the masked
     * value, nothing else */

    /* a struct constant: each field placed at its aligned offset the
     * same way gepConstOffset walks them, then the tail zero-filled.
     * A function, global or literal address stores as one quad (the
     * linker resolves the symbol), which is exactly what a vtable or
     * allocator slot needs. */

    /* one entry of a folded aggregate: a scalar, another aggregate, a
     * byte array, or an address the linker resolves */

    static bool iselIsPow2(u64 v) { return v != 0 && (v & (v - 1)) == 0; }

    // Width-aware load/store helpers

    // The address value in a register for an indirect operand: a
    // spilled pointer reloads into r11 first (r11 is reserved, never
    // allocated), a register home goes in as-is.
    /* symbol for a string constant: its stable ".Lcs<id>" name */
    str stringLabel(IrValue* v)
    {
        if (v == null) return str::empty();
        if (v->name.len > 0) return v->name;
        return self.ctx->stringConstLabel(v->id);
    }

    /* label[+-off](%rip) — the RIP-relative spelling every reference to
     * rodata uses; built into the rotating text buffers, consumed by the
     * next line emitted */
    str ripOperand(str label, i64 off)
    {
        String* b = textBufNext();
        b->pushView(label);
        if (off > 0)
        {
            b->pushChar('+');
            b->pushView(u32ToStr((u32)off));
        }
        else if (off < 0)
        {
            b->pushChar('-');
            b->pushView(u32ToStr((u32)(-off)));
        }
        b->pushView("(%rip)");
        return b->asView();
    }

    /* constant byte offset of a Gep whose indices are all constant — the
     * same layout walk emitGep performs (align-then-place struct fields,
     * element strides for arrays), factored out so a literal's address
     * can be folded into one RIP-relative operand */

    /* a link-time constant address: a string constant itself, or a Gep
     * chain over one with constant indices. Lets a load/store through a
     * literal become a single RIP-relative memory operand instead of a
     * lea into a scratch plus a memory access */

    bool valueIsSpill(IrValue* val)
    {
        if (val == null) return false;
        if (val->kind != IrValueKind::Inst && val->kind != IrValueKind::Arg) return false;
        return (val->valData & 0x80000000UL) != 0;
    }

    // A value is float-typed either through the FLOAT_BIT (register
    // allocation) or, once spilled, only through its IR type — the spill
    // encoding does not carry the float flag.
    bool valueIsFloatClass(IrValue* val)
    {
        if (val == null || val->type == null) return false;
        return val->type->kind == IrTypeKind::Float;
    }

    bool valueIsVec(IrValue* val)
    {
        if (val == null || val->type == null) return false;
        return val->type->kind == IrTypeKind::Vector;
    }

    // Slot layout: every spilled vreg gets a slot wide enough for its IR
    // type — 16 bytes for scalars and 128-bit vectors, 32 for 256-bit and
    // 64 for 512-bit vectors. Scalar ints store their 8-byte register with
    // movq, f32/f64 store 4/8 bytes with movss/movsd, and vectors store
    // their whole width. The prologue pushes the saved callee saves first,
    // then subtracts the spill+alloca region, so slot i starts at
    // -8*numCalleeSaves-spillSlotOffsets[i] (%rbp): the saves sit between
    // rbp and the spill region. rbp is established whenever hasAny spill
    // slot exists, so the homes are stable for the whole function.
    str slotText(u32 slot)
    {
        u32 off = 8 * self.numCalleeSaves + (slot + 1) * 16;
        if (self.spillSlotOffsets != null && slot < self.spillSlotCount)
            off = 8 * self.numCalleeSaves + self.spillSlotOffsets[slot];
        String* b = textBufNext();
        b->pushChar('-');
        b->pushView(u32ToStr(off));
        b->pushView("(%rbp)");
        return b->asView();
    }

    // Operand usable in hasAny position that accepts a memory operand:
    // the value's register name, or its spill-slot address text.
    str opFor(IrValue* v)
    {
        if (v == null) return "rax";
        if (v->kind == IrValueKind::StringConst)
        {
            // no home is allocated for a constant's address, so it lands
            // in the scratch every register-only consumer can read
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emitLine(", %r11");
            return "r11";
        }
        if (v->kind == IrValueKind::Global)
        {
            // a symbol has no home either: lea it into the same scratch
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(v->name, 0));
            self.emitter.emitLine(", %r11");
            return "r11";
        }
        if (v->kind == IrValueKind::ConstFloat)
        {
            // the pool entry is a memory operand every float consumer
            // accepts (movsd/movss/addsd read mem directly); the label
            // consult registers the constant for the pool writer
            return self.ripOperand(self.floatConstLabel(v), 0);
        }
        if (valueIsIntConst(v)) return intImmText(v);
        u64 vd = v->valData;
        if (vd & 0x80000000UL)
            return self.slotText((u32)(vd & 0x3FFFFFFF));
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        str name = self.intRegNameFor(reg);
        if (name.len > 0) return name;
        return "rax";
    }

    // opFor's answer with no emission — for callers that only compare
    // homes (emitCall's parallel-copy planner asks whether a source's
    // home is the destination register). opFor materialises a
    // StringConst/Global with a leaq on every consult, so a query
    // through it produced one dead leaq per scan: three per call site.
    str homeOf(IrValue* v)
    {
        if (v == null) return "rax";
        if (v->kind == IrValueKind::StringConst) return "r11";
        if (v->kind == IrValueKind::Global) return "r11";
        if (v->kind == IrValueKind::ConstFloat)
            return self.ripOperand(self.floatConstLabel(v), 0);
        if (valueIsIntConst(v)) return intImmText(v);
        u64 vd = v->valData;
        if (vd & 0x80000000UL)
            return self.slotText((u32)(vd & 0x3FFFFFFF));
        if (vd & 0x40000000UL)
        {
            u32 reg = (u32)(vd & 0x3FFFFFFF);
            if (reg < 6) return X86_64_FLOAT_REGS[reg];
            return "xmm0";
        }
        u32 reg = (u32)(vd & 0x3FFFFFFF);
        str name = self.intRegNameFor(reg);
        if (name.len > 0) return name;
        return "rax";
    }

    // Immediate → dst in one short instruction. A value that fits in 32
    // bits moving to a register takes movl (which zeroes the upper half);
    // stack slots and wider values keep movabsq, because movl would leave
    // stale bytes in memory or drop the value's high half.
    void emitImmTo(u64 val, str dst)
    {
        bool paren = false;
        for (usize q = 0; q < dst.len; q++)
            if (dst.ptr[q] == (u8)'(') { paren = true; break; }
        if (!paren && val <= 0xFFFFFFFFUL)
        {
            self.emitter.emit("\tmovl $");
            self.emitter.emit(u64ToHex(val));
            self.emitter.emit(", ");
            self.emitter.emitLine(toReg32(dst));
        }
        else
        {
            self.emitter.emit("\tmovabsq $");
            self.emitter.emit(u64ToHex(val));
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
    }

    // the old name stays as an alias so every unconverted call site is
    // spill-correct for memory-accepting positions; register-only positions
    // go through opForReg/opForRegF instead
    str getRegForValue(IrValue* v)
    {
        return self.opFor(v);
    }

    // Forced register operand: a spill slot is loaded into the scratch
    // first, and a register-resident value is moved into the scratch
    // as well, so the caller always gets a value in the scratch register.
    str opForReg(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (v->kind == IrValueKind::StringConst)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (v->kind == IrValueKind::Global)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(v->name, 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (valueIsIntConst(v))
        {
            self.emitImmTo(v->valData, scratch);
            return scratch;
        }
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        str home = self.opFor(v);
        if (!home.equals(scratch))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(home);
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
        }
        return scratch;
    }

    // Register operand for a position that accepts ANY general-purpose
    // register — a lea's SIB base, a memory operand's address. A spill
    // reloads through the scratch and a constant is materialised there
    // (neither can appear directly in a SIB/address encoding), but a
    // register-resident value is used in place: opForReg would emit a
    // mov into the scratch that buys nothing when the home already
    // satisfies the encoding.
    str opForRegInPlace(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        if (v->kind == IrValueKind::StringConst)
        {
            self.emitter.emit("\tleaq ");
            self.emitter.emit(self.ripOperand(self.stringLabel(v), 0));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        if (valueIsIntConst(v))
        {
            self.emitImmTo(v->valData, scratch);
            return scratch;
        }
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\tmovq ");
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(scratch);
            return scratch;
        }
        return self.opFor(v);
    }

    str opForRegF(IrValue* v, str scratch)
    {
        if (v == null) return scratch;
        bool isVec = self.valueIsVec(v);
        u32 w = v->type != null ? v->type->width : 64;
        str dst = isVec ? self.vecReg(scratch, w) : scratch;
        if (self.valueIsSpill(v))
        {
            bool dbl = w == 64;
            self.emitter.emit("\t");
            self.emitter.emit(isVec ? self.vecMoveMn(w) : (dbl ? "movsd " : "movss "));
            self.emitter.emit(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
            return dst;
        }
        str home = isVec ? self.vecReg(self.opFor(v), w) : self.opFor(v);
        if (!home.equals(dst))
        {
            bool dbl = w == 64;
            self.emitter.emit("\t");
            self.emitter.emit(isVec ? self.vecMoveMn(w) : (dbl ? "movsd " : "movss "));
            self.emitter.emit(home);
            self.emitter.emit(", ");
            self.emitter.emitLine(dst);
        }
        return dst;
    }

    // Destination for producing a value: a spill slot's value is
    // collected in a scratch (the producing op overwrites it, so the
    // old slot content is never worth a reload), while a
    // register-resident value is produced straight into its home.
    str outForInt(IrValue* v, str scratch)
    {
        if (v != null && self.valueIsSpill(v)) return scratch;
        return self.opFor(v);
    }

    str outForF(IrValue* v, str scratch)
    {
        if (v != null && self.valueIsSpill(v)) return scratch;
        return self.opFor(v);
    }

    // Write a register's value back to its home — the slot when the
    // value spilled, otherwise the allocated register (mov only when
    // the homes differ), width-aware so a spilled narrow value isn't
    // written with a full-width mov.
    void sinkInt(IrValue* v, str reg)
    {
        if (v == null) return;
        u32 w = v->type != null ? v->type->width : 64;
        str mv = w == 8 ? "movb " : w == 16 ? "movw " : w == 32 ? "movl " : "movq ";
        str r = w == 8 ? toReg8(reg) : w == 16 ? toReg16(reg) : w == 32 ? toReg32(reg) : reg;
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            return;
        }
        str home = self.opFor(v);
        if (!home.equals(reg))
        {
            str h = w == 8 ? toReg8(home) : w == 16 ? toReg16(home) : w == 32 ? toReg32(home) : home;
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(h);
        }
    }

    u32 countSpillSlots(IrFunc* func)
    {
        bool hasAny = false;
        u32 max = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u64 vd = inst->base.valData;
                if ((vd & 0x80000000UL) != 0)
                {
                    u32 idx = (u32)(vd & 0x3FFFFFFF);
                    if (!hasAny || idx > max) max = idx;
                    hasAny = true;
                }
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* o = inst->ops[oi];
                    if (o == null) continue;
                    if (o->kind != IrValueKind::Inst) continue;
                    u64 ov = o->valData;
                    if ((ov & 0x80000000UL) != 0)
                    {
                        u32 idx = (u32)(ov & 0x3FFFFFFF);
                        if (!hasAny || idx > max) max = idx;
                        hasAny = true;
                    }
                }
            }
        }
        return hasAny ? max + 1 : 0;
    }

    // A spill slot must hold the whole IR value: 16 bytes covers every
    // scalar and a 128-bit vector, wider vectors take 32/64 bytes.
    u32 spillSlotBytes(IrType* ty)
    {
        u32 bytes = 16;
        if (ty != null && ty->kind == IrTypeKind::Vector && ty->width > 128)
            bytes = (ty->width + 127) / 128 * 16;
        return bytes;
    }

    void freeSpillPlan()
    {
        if (self.spillSlotSizes != null)
        {
            dealloc<u32>(self.spillSlotSizes);
            self.spillSlotSizes = null;
        }
        if (self.spillSlotOffsets != null)
        {
            dealloc<u32>(self.spillSlotOffsets);
            self.spillSlotOffsets = null;
        }
        self.spillRegionBytes = 0;
    }

    // Size each spill slot from the type of the value that owns it and
    // lay the slots out consecutively. Slot indices are vreg indices, so
    // the arrays are sparse-tolerant; unused entries stay at the minimum.
    void planSpillSlots(IrFunc* func, u32 count)
    {
        self.freeSpillPlan();
        if (count == 0 || func == null) return;
        self.spillSlotSizes = alloc<u32>((usize)count);
        self.spillSlotOffsets = alloc<u32>((usize)count);
        for (u32 i = 0; i < count; i++)
            self.spillSlotSizes[i] = 16;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u64 vd = inst->base.valData;
                if ((vd & 0x80000000UL) != 0)
                {
                    u32 idx = (u32)(vd & 0x3FFFFFFF);
                    if (idx < count)
                    {
                        u32 b = self.spillSlotBytes(inst->base.type);
                        if (b > self.spillSlotSizes[idx]) self.spillSlotSizes[idx] = b;
                    }
                }
                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* o = inst->ops[oi];
                    if (o == null || o->kind != IrValueKind::Inst) continue;
                    u64 ov = o->valData;
                    if ((ov & 0x80000000UL) == 0) continue;
                    u32 idx = (u32)(ov & 0x3FFFFFFF);
                    if (idx >= count) continue;
                    u32 b = self.spillSlotBytes(o->type);
                    if (b > self.spillSlotSizes[idx]) self.spillSlotSizes[idx] = b;
                }
            }
        }

        u32 cum = 0;
        for (u32 i = 0; i < count; i++)
        {
            cum += self.spillSlotSizes[i];
            self.spillSlotOffsets[i] = cum;
        }
        self.spillRegionBytes = cum;
    }

void emitIntExtendTo(str src, str dst32, u32 width, bool isSigned)
{
    if (width == 32)
    {
        self.emitter.emit("\tmovl ");
        self.emitter.emit(toReg32(src));
    }
    else if (width == 16)
    {
        self.emitter.emit(isSigned ? "\tmovswl " : "\tmovzwl ");
        self.emitter.emit(toReg16(src));
    }
    else
    {
        self.emitter.emit(isSigned ? "\tmovsbl " : "\tmovzbl ");
        self.emitter.emit(toReg8(src));
    }
    self.emitter.emit(", ");
    self.emitter.emitLine(dst32);
}

    // GCC-style local label: a bare .L<number>. Block ids are unique within
    // a compilation (context-wide counter), so the label is file-local,
    // stable across jumps, and carries no IR block names (entry/if-then/...).
    void emitBlockLabel(IrBlock* bb)
    {
        self.emitter.emit(".L");
        self.emitter.emit(i64ToDec((i64)bb->base.id));
    }

    // Resize a vector register name to the width: xmmN for <=128 bits,
    // ymmN for 256 and zmmN for 512. The rotating String pool gives a
    // three-operand op room for three distinct conversions without slots
    // going stale.
    str vecReg(str reg, u32 bits)
    {
        if (bits <= 128) return reg;
        bool wide = reg.len >= 3 && reg.ptr[1] == 'm' && reg.ptr[2] == 'm';
        if (!wide) return reg;
        u8 first = bits > 256 ? 'z' : 'y';
        String* b = textBufNext();
        b->pushChar(first);
        for (u32 i = 1; i < (u32)reg.len && i < 8; i++)
            b->pushChar(reg.ptr[i]);
        return b->asView();
    }

    str xmmToYmm(str xmmReg)
    {
        return self.vecReg(xmmReg, 256);
    }

    // Full-register move/load/store mnemonic for a vector width. The VEX
    // 256-bit forms are `vmovdqu`; the 512-bit forms use the EVEX
    // `vmovdqu64` (AVX512F covers 32/64-bit lanes without AVX512BW).
    str vecMoveMn(u32 bits)
    {
        if (bits <= 32) return "movd ";
        if (bits <= 64) return "movq ";
        if (bits <= 128) return "movdqu ";
        if (bits <= 256) return "vmovdqu ";
        return "vmovdqu64 ";
    }

    // Write a float or vector result home: the scratch carries it when
    // the value spilled, width-aware so a narrow value never writes
    // past the head of its slot.
    void sinkF(IrValue* v, str reg)
    {
        if (v == null) return;
        u32 w = v->type != null ? v->type->width : 64;
        bool isVec = self.valueIsVec(v);
        str mv = isVec ? self.vecMoveMn(w) : (w == 64 ? "movq " : "movd ");
        str r = isVec ? self.vecReg(reg, w) : reg;
        if (self.valueIsSpill(v))
        {
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(self.slotText((u32)(v->valData & 0x3FFFFFFF)));
            return;
        }
        str home = isVec ? self.vecReg(self.opFor(v), w) : self.opFor(v);
        if (!home.equals(r))
        {
            self.emitter.emit("\t");
            self.emitter.emit(mv);
            self.emitter.emit(r);
            self.emitter.emit(", ");
            self.emitter.emitLine(home);
        }
    }
}

void u32ToHex(u32 val, u8* out)
{
    str hex = "0123456789abcdef";
    out[0] = '0';
    out[1] = 'x';
    for (u32 i = 7; i >= 0; i--)
        out[2 + (7 - i)] = hex.ptr[(val >> (i * 4)) & 0xF];
    out[10] = 0;
}
