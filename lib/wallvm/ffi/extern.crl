#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc };
import(lib) core::cchar { cchar };
import(lib) wallvm::irtypes { IrFunc };
import(lib) wallvm::rules::asm_rules { CallingConvention };

pub struct ExternLib
{
    const cchar* libName; // "c", "kernel32", "m", "pthread", et cetera.
    const cchar* symbol;
    CallingConvention cc;
    bool isNoret;
}

pub struct FfiCtx
{
    ExternLib** libs;
    u32 nlibs;
    u32 capLibs;
    const cchar** linkerFlags;
    u32 nflags;
    u32 capFlags;

    FfiCtx new()
    {
        return FfiCtx {
            .libs = null,
            .nlibs = 0,
            .capLibs = 0,
            .linkerFlags = null,
            .nflags = 0,
            .capFlags = 0
        };
    }

    void addExtern(const cchar* lib, const cchar* sym, CallingConvention cc, bool noret)
    {
        if (self.nlibs >= self.capLibs)
        {
            u32 nc = self.capLibs ? self.capLibs * 2 : 8;
            ExternLib** nl = alloc<ExternLib*>(nc);
            if (self.libs != null)
            {
                for (u32 i = 0; i < self.nlibs; i++) nl[i] = self.libs[i];
                dealloc<ExternLib*>(self.libs);
            }
            self.libs = nl;
            self.capLibs = nc;
        }
        ExternLib* el = alloc<ExternLib>(1);
        u32 ll = 0;
        while (lib[ll] != 0) ll++;
        cchar* lc = alloc<cchar>(ll + 1);
        for (u32 i = 0; i < ll; i++) lc[i] = lib[i]; lc[ll] = 0;
        u32 sl = 0;
        while (sym[sl] != 0) sl++;
        cchar* sc = alloc<cchar>(sl + 1);
        for (u32 i = 0; i < sl; i++) sc[i] = sym[i]; sc[sl] = 0;
        *el = ExternLib { lc, sc, cc, noret };
        self.libs[self.nlibs++] = el;
    }

    void addLinkerFlag(const cchar* flag_)
    {
        if (self.nflags >= self.capFlags)
        {
            u32 nc = self.capFlags ? self.capFlags * 2 : 8;
            const cchar** nf = alloc<const cchar*>(nc);
            if (self.linkerFlags != null)
            {
                for (u32 i = 0; i < self.nflags; i++) nf[i] = self.linkerFlags[i];
                dealloc<const cchar*>(self.linkerFlags);
            }
            self.linkerFlags = nf;
            self.capFlags = nc;
        }
        u32 fl = 0;
        while (flag_[fl] != 0) fl++;
        cchar* fc = alloc<cchar>(fl + 1);
        for (u32 i = 0; i < fl; i++) fc[i] = flag_[i]; fc[fl] = 0;
        self.linkerFlags[self.nflags++] = fc;
    }

    void resolveLinkerFlags()
    {
        for (u32 i = 0; i < self.nlibs; i++)
        {
            ExternLib* el = self.libs[i];
            if (el->libName[0] == 'c' && el->libName[1] == 0)
                self.addLinkerFlag("-lc");
            else if (el->libName[0] == 'm' && el->libName[1] == 0)
                self.addLinkerFlag("-lm");
            else if (el->libName[0] == 'p' && el->libName[1] == 't' && el->libName[2] == 'h' && el->libName[3] == 'r' && el->libName[4] == 'e' && el->libName[5] == 'a' && el->libName[6] == 'd' && el->libName[7] == 0)
                self.addLinkerFlag("-lpthread");
            else if (el->libName[0] == 'd' && el->libName[1] == 'l' && el->libName[2] == 0)
                self.addLinkerFlag("-ldl");
            else if (el->libName[0] == 'k' && el->libName[1] == 'e' && el->libName[2] == 'r' && el->libName[3] == 'n' && el->libName[4] == 'e' && el->libName[5] == 'l' && (el->libName[6] == '3' || el->libName[6] == '2') && el->libName[7] == 0)
            {
                // yeah, windows links against kernel32.lib, so it's gonna handled by the linker automatically
            }
        }
    }

    void clear() // clear. no explanation needed
    {
        if (self.libs != null) dealloc<ExternLib*>(self.libs);
        if (self.linkerFlags != null) dealloc<const cchar*>(self.linkerFlags);
        self.libs = null;
        self.nlibs = 0;
        self.capLibs = 0;
        self.linkerFlags = null; self.nflags = 0; self.capFlags = 0;
    }

}

pub bool irFuncIsExtern(IrFunc* f) // to detect if an wallvm::ir_types::IrFunc is extern.
{ // why am i even writing commments atp?
    if (f == null) return false;
    return f->isExtern;
}

pub CallingConvention externCallingConvention(IrFunc* f, CallingConvention hostCc)
{
    if (f == null || !f->isExtern) return hostCc;

    switch (hostCc)
    {
        CallingConvention::SystemV |
        CallingConvention::SyscallX86_64 |
        CallingConvention::SyscallMacOS => { return CallingConvention::SystemV; },
        CallingConvention::Win64 |
        CallingConvention::SyscallWin64 => { return CallingConvention::Win64; },
        CallingConvention::Cdecl |
        CallingConvention::Stdcall |
        CallingConvention::Fastcall |
        CallingConvention::WinX86_32 => { return CallingConvention::Cdecl; },
        CallingConvention::Aapcs64 |
        CallingConvention::Aapcs64MacOs |
        CallingConvention::Aapcs64Ios => { return CallingConvention::Aapcs64; },
        CallingConvention::Aapcs => { return CallingConvention::Aapcs; },
        CallingConvention::Riscv64 => { return CallingConvention::Riscv64; },
        else => { return hostCc; },
    }
}

pub u32 emitLinkerDirectives(FfiCtx* ffi, cchar* buf, u32 cap, CallingConvention cc)
{
    if (ffi == null || buf == null) return 0;
    u32 pos = 0;
    ffi->resolveLinkerFlags();
    for (u32 i = 0; i < ffi->nlibs; i++)
    {
        const cchar* sym = ffi->libs[i]->symbol;
        bool isNoret = ffi->libs[i]->isNoret;
        // ejaculate .globl directives for extern symbols
        u32 sl = 0; while (sym[sl] != 0) sl++;
        if (pos + sl + 20 > cap) break;
        buf[pos++] = '\t';
        buf[pos++] = '.';
        buf[pos++] = 'g';
        buf[pos++] = 'l';
        buf[pos++] = 'o';
        buf[pos++] = 'b';
        buf[pos++] = 'l';
        buf[pos++] = ' ';
        for (u32 j = 0; j < sl; j++) buf[pos++] = sym[j];
        buf[pos++] = '\n';
    }
    return pos;
}
