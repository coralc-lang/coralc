#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, copy };
import(lib) std::text::string { String };
import irOps { IrOpcode, irOpcodeIsTerminator };

str irDupStr(str s)
{
    String copy = String::from(s);
    return copy.asView();
}

pub enum IrTypeKind
{
    Void,
    Int,
    Float,
    Ptr,
    Array,
    Func,
    Vector,
    Struct
}

pub enum IrValueKind
{
    Inst,
    ConstInt,
    ConstFloat,
    ConstArray,
    Block,
    Func,
    Global,
    Arg,
    StringConst
}

pub struct IrType
{
    IrTypeKind kind;
    u32 width;
    IrType* elem;
    u32 count;
    IrType* ret;
    IrType** params;
    u32 nparams;
    bool isVararg;

    IrTypeKind kind() { return self.kind; }
    u32 width() { return self.width; }
    bool isEqual(IrType* other) { return irTypeEqual(self, other); }
}

pub struct IrDebugLoc
{
    str file;
    u32 line;
    u32 col;
}

pub struct IrVarDebugInfo
{
    str varName;
    IrType* varType;
    u32 line;
    u32 col;
    u32 argIndex; // ~0u if not an argument
}


pub struct IrValue
{
    IrValueKind kind;
    IrType* type;
    u32 id;
    u64 valData;
    str name;
    IrInst** users;
    u32 nusers;
    u32 capUsers;

    void addUser(IrInst* inst)
    {
        if (self.nusers >= self.capUsers)
        {
            u32 newCap = self.capUsers ? self.capUsers * 2 : 4;
            IrInst** newUsers = alloc<IrInst*>((usize)newCap);
            if (self.users)
            {
                copy<IrInst*>(newUsers, self.users, (usize)self.nusers);
                dealloc<IrInst*>(self.users);
            }
            self.users = newUsers;
            self.capUsers = newCap;
        }
        self.users[self.nusers++] = inst;
    }

    void removeUser(IrInst* inst)
    {
        for (u32 i = 0; i < self.nusers; i++)
        {
            if (self.users[i] == inst)
            {
                self.users[i] = self.users[--self.nusers];
                return;
            }
        }
    }

    void replaceAllUses(IrValue* newVal)
    {
        if (self == newVal) return;
        for (u32 ui = 0; ui < self.nusers; ui++)
        {
            IrInst* user = self.users[ui];
            if ((IrValue*)user == newVal) continue;
            for (u32 j = 0; j < user->nops; j++)
                if (user->ops[j] == self)
                    user->ops[j] = newVal;
            newVal->addUser(user);
        }
        if (newVal->kind == IrValueKind::Inst)
        {
            IrInst* newInst = (IrInst*)newVal;
            bool alreadyUser = false;
            for (u32 ui = 0; ui < self.nusers; ui++)
                { if ((IrValue*)self.users[ui] == newVal) { alreadyUser = true; break; } }
            if (alreadyUser)
            {
                // Replace the self reference in newVal's operands
                for (u32 j = 0; j < newInst->nops; j++)
                    if (newInst->ops[j] == self)
                        newInst->ops[j] = newVal;
                newVal->addUser((IrInst*)newVal);
            }
        }
        self.nusers = 0;
    }

    IrValueKind valueKind() { return self.kind; }
    IrType* valueType() { return self.type; }
}

pub struct IrGlobal
{
    IrValue base;
    IrModule* parent;
    bool isConst;
    bool isExtern;
    IrValue* initVal;
    u32 alignment;
    rawptr metadata; // generic metadata pointer
}

pub struct IrStringConst
{
    IrValue base;
    u8* data;
    u32 length;
    rawptr metadata; // generic metadata pointer
}

pub struct IrArrayConst
{
    IrValue base;
    IrValue** elems;
    u32 nelems;
}

pub struct IrStructType
{
    IrType* irType;
    str name;
    IrType** fieldTypes;
    str* fieldNames;
    u32 nfields;
    u32 capFields;
    u32 size;
    u32* offsets;
}

pub struct IrInst
{
    IrValue base;
    IrOpcode opcode;
    IrBlock* parent;
    IrInst* prev;
    IrInst* next;
    IrValue** ops;
    u32 nops;
    u32 capOps;
    IrICmpPred icmpPred;
    IrFCmpPred fcmpPred;
    IrDebugLoc debugLoc;
    IrVarDebugInfo* varDbg;
    u32 nvarDbg;
    u32 capVarDbg;
    // inline asm fields
    str asmString;
    str asmConstraints;
    str asmClobbers;
    u32 asmNumSideEffects;
    // generic metadata pointer
    rawptr metadata;

    IrInst* prevInst() { return self.prev; }
    IrInst* nextInst() { return self.next; }
    IrBlock* instParent() { return self.parent; }

    void setDebugLoc(str file, u32 line, u32 col)
    {
        if (file.isEmpty()) return;
        self.debugLoc.file = irDupStr(file);
        self.debugLoc.line = line;
        self.debugLoc.col = col;
    }

    void addVarDebug(str name, IrType* ty, u32 line, u32 col, u32 argIdx)
    {
        if (self.nvarDbg >= self.capVarDbg)
        {
            u32 nc = self.capVarDbg ? self.capVarDbg * 2 : 4;
            IrVarDebugInfo* nd = alloc<IrVarDebugInfo>((usize)nc);
            if (self.varDbg)
            {
                copy<IrVarDebugInfo>(nd, self.varDbg, (usize)self.nvarDbg);
                dealloc<IrVarDebugInfo>(self.varDbg);
            }
            self.varDbg = nd;
            self.capVarDbg = nc;
        }
        self.varDbg[self.nvarDbg++] = IrVarDebugInfo{ irDupStr(name), ty, line, col, argIdx };
    }

    void erase()
    {
        if (self.parent)
        {
            for (u32 i = 0; i < self.parent->ninsts; i++)
            {
                if (self.parent->insts[i] == self)
                {
                    for (u32 j = i; j < self.parent->ninsts - 1; j++)
                        self.parent->insts[j] = self.parent->insts[j + 1];
                    self.parent->ninsts--;
                    break;
                }
            }
        }

        for (u32 i = 0; i < self.nops; i++)
        {
            if (self.ops[i])
                self.ops[i]->removeUser(self);
        }

        if (self.capOps > 0)
            dealloc<IrValue*>(self.ops);

        if (self.base.capUsers > 0)
            dealloc<IrInst*>(self.base.users);

        if (self.debugLoc.file.ptr)
            dealloc<u8>((u8*)self.debugLoc.file.ptr);
        if (self.varDbg)
        {
            for (u32 i = 0; i < self.nvarDbg; i++)
                if (self.varDbg[i].varName.ptr)
                    dealloc<u8>((u8*)self.varDbg[i].varName.ptr);
            dealloc<IrVarDebugInfo>(self.varDbg);
        }
        dealloc<IrInst>(self);
    }

    IrOpcode instOpcode() { return self.opcode; }
    u32 numOps() { return self.nops; }
    IrValue* operand(u32 i) { if (i < self.nops) return self.ops[i]; return null; }
}

pub struct IrBlock
{
    IrValue base;
    IrFunc* parent;
    IrInst** insts;
    u32 ninsts;
    u32 capInsts;
    IrBlock** preds;
    u32 npreds;
    u32 capPreds;
    IrBlock** succs;
    u32 nsuccs;
    u32 capSuccs;

    void addInst(IrInst* inst)
    {
        if (self.ninsts >= self.capInsts)
        {
            u32 newCap = self.capInsts ? self.capInsts * 2 : 8;
            IrInst** newInsts = alloc<IrInst*>((usize)newCap);
            if (self.insts)
            {
                copy<IrInst*>(newInsts, self.insts, (usize)self.ninsts);
                dealloc<IrInst*>(self.insts);
            }
            self.insts = newInsts;
            self.capInsts = newCap;
        }
        inst->parent = self;
        self.insts[self.ninsts++] = inst;
    }

    void insertBefore(IrInst* inst, IrInst* anchor)
    {
        if (self.ninsts >= self.capInsts)
        {
            u32 newCap = self.capInsts ? self.capInsts * 2 : 8;
            IrInst** newInsts = alloc<IrInst*>((usize)newCap);
            if (self.insts)
            {
                copy<IrInst*>(newInsts, self.insts, (usize)self.ninsts);
                dealloc<IrInst*>(self.insts);
            }
            self.insts = newInsts;
            self.capInsts = newCap;
        }
        u32 idx = self.ninsts;
        for (u32 i = 0; i < self.ninsts; i++) {
            if (self.insts[i] == anchor) { idx = i; break; } }
        for (u32 j = self.ninsts; j > idx; j--)
            self.insts[j] = self.insts[j - 1];
        inst->parent = self;
        self.insts[idx] = inst;
        self.ninsts++;
    }

    void addPred(IrBlock* pred)
    {
        if (self.npreds >= self.capPreds)
        {
            u32 newCap = self.capPreds ? self.capPreds * 2 : 4;
            IrBlock** newPreds = alloc<IrBlock*>((usize)newCap);
            if (self.preds)
            {
                copy<IrBlock*>(newPreds, self.preds, (usize)self.npreds);
                dealloc<IrBlock*>(self.preds);
            }
            self.preds = newPreds;
            self.capPreds = newCap;
        }
        self.preds[self.npreds++] = pred;
    }

    void addSucc(IrBlock* succ)
    {
        if (self.nsuccs >= self.capSuccs)
        {
            u32 newCap = self.capSuccs ? self.capSuccs * 2 : 4;
            IrBlock** newSuccs = alloc<IrBlock*>((usize)newCap);
            if (self.succs)
            {
                copy<IrBlock*>(newSuccs, self.succs, (usize)self.nsuccs);
                dealloc<IrBlock*>(self.succs);
            }
            self.succs = newSuccs;
            self.capSuccs = newCap;
        }
        self.succs[self.nsuccs++] = succ;
        succ->addPred(self);
    }

    void removePred(IrBlock* pred)
    {
        for (u32 i = 0; i < self.npreds; i++) {
            if (self.preds[i] == pred) { self.preds[i] = self.preds[--self.npreds]; return; }
        }
    }

    void removeSucc(IrBlock* succ)
    {
        for (u32 i = 0; i < self.nsuccs; i++) {
            if (self.succs[i] == succ) { self.succs[i] = self.succs[--self.nsuccs]; return; }
        }
    }

    bool hasPred(IrBlock* pred)
    {
        for (u32 i = 0; i < self.npreds; i++)
            if (self.preds[i] == pred) return true;
        return false;
    }

    // I report true when no non-terminator here stores memory, calls out,
    // touches atomics or otherwise escapes, the tail-duplication and
    // jump-threading passes ask me before they steal a block
    bool hasNoSideEffects()
    {
        for (u32 i = 0; i < self.ninsts; i++)
        {
            IrOpcode op = self.insts[i]->opcode;
            if (irOpcodeIsTerminator(op)) continue;
            switch (op)
            {
                IrOpcode::Store |
                IrOpcode::InlineAsm |
                IrOpcode::AtomicStore |
                IrOpcode::AtomicRmw |
                IrOpcode::AtomicCmpXchg |
                IrOpcode::Fence |
                IrOpcode::LandingPad |
                IrOpcode::GcRoot |
                IrOpcode::GcWriteBarrier |
                IrOpcode::GcSafepoint |
                IrOpcode::Call => { return false; },
                else => { },
            }
        }
        return true;
    }

    IrInst* terminator()
    {
        for (u32 i = 0; i < self.ninsts; i++)
        {
            IrOpcode op = self.insts[i]->opcode;
            if (op == IrOpcode::Br || op == IrOpcode::CondBr || op == IrOpcode::Ret ||
                op == IrOpcode::Unreachable || op == IrOpcode::Noret)
                return self.insts[i];
        }
        return null;
    }
}

pub struct IrFunc
{
    IrValue base;
    IrModule* parent;
    IrBlock** blocks;
    u32 nblocks;
    u32 capBlocks;
    IrType* retType;
    IrType** paramTypes;
    u32 nparams;
    bool isExtern;
    str externLib;
    str externSym;
    rawptr metadata; // generic metadata pointer
    IrValue** args;
    u32 nargs;
    u32 capArgs;

    void addBlock(IrBlock* bb)
    {
        if (self.nblocks >= self.capBlocks)
        {
            u32 newCap = self.capBlocks ? self.capBlocks * 2 : 4;
            IrBlock** newBlocks = alloc<IrBlock*>((usize)newCap);
            if (self.blocks)
            {
                copy<IrBlock*>(newBlocks, self.blocks, (usize)self.nblocks);
                dealloc<IrBlock*>(self.blocks);
            }
            self.blocks = newBlocks;
            self.capBlocks = newCap;
        }
        bb->parent = self;
        self.blocks[self.nblocks++] = bb;
    }

    void addArg(IrValue* a)
    {
        if (self.nargs >= self.capArgs)
        {
            u32 newCap = self.capArgs ? self.capArgs * 2 : 4;
            IrValue** newArgs = alloc<IrValue*>((usize)newCap);
            if (self.args)
            {
                copy<IrValue*>(newArgs, self.args, (usize)self.nargs);
                dealloc<IrValue*>(self.args);
            }
            self.args = newArgs;
            self.capArgs = newCap;
        }
        self.args[self.nargs++] = a;
    }

    void removeBlock(IrBlock* bb)
    {
        for (u32 i = 0; i < self.nblocks; i++)
        {
            if (self.blocks[i] == bb)
            {
                for (u32 j = i; j < self.nblocks - 1; j++)
                    self.blocks[j] = self.blocks[j + 1];
                self.nblocks--;
                return;
            }
        }
    }

    bool isLeaf()
    {
        for (u32 bi = 0; bi < self.nblocks; bi++)
        {
            IrBlock* bb = self.blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
                if (bb->insts[ii]->opcode == IrOpcode::Call)
                    return false;
        }
        return true;
    }
}

pub struct IrModule
{
    IrContext* ctx;
    str name;
    IrFunc** funcs;
    u32 nfuncs;
    u32 capFuncs;
    IrGlobal** globals;
    u32 nglobals;
    u32 capGlobals;
    IrStringConst** constStrings;
    u32 nconstStrings;
    u32 capConstStrings;
    IrStructType** structs;
    u32 nstructs;
    u32 capStructs;

    void addFunc(IrFunc* f)
    {
        if (self.nfuncs >= self.capFuncs)
        {
            u32 newCap = self.capFuncs ? self.capFuncs * 2 : 4;
            IrFunc** newFuncs = alloc<IrFunc*>((usize)newCap);
            if (self.funcs)
            {
                copy<IrFunc*>(newFuncs, self.funcs, (usize)self.nfuncs);
                dealloc<IrFunc*>(self.funcs);
            }
            self.funcs = newFuncs;
            self.capFuncs = newCap;
        }
        f->parent = self;
        self.funcs[self.nfuncs++] = f;
    }

    IrFunc* getFunc(str name)
    {
        for (u32 i = 0; i < self.nfuncs; i++)
        {
            if (self.funcs[i]->base.name.equals(name))
                return self.funcs[i];
        }
        return null;
    }

    void addGlobal(IrGlobal* g)
    {
        if (self.nglobals >= self.capGlobals)
        {
            u32 nc = self.capGlobals ? self.capGlobals * 2 : 4;
            IrGlobal** ng = alloc<IrGlobal*>((usize)nc);
            if (self.globals) {
                copy<IrGlobal*>(ng, self.globals, (usize)self.nglobals);
                dealloc<IrGlobal*>(self.globals);
            }
            self.globals = ng;
            self.capGlobals = nc;
        }
        g->parent = self;
        self.globals[self.nglobals++] = g;
    }

    void addConstString(IrStringConst* sc)
    {
        if (self.nconstStrings >= self.capConstStrings)
        {
            u32 nc = self.capConstStrings ? self.capConstStrings * 2 : 4;
            IrStringConst** ns = alloc<IrStringConst*>((usize)nc);
            if (self.constStrings)
            {
                copy<IrStringConst*>(ns, self.constStrings, (usize)self.nconstStrings);
                dealloc<IrStringConst*>(self.constStrings);
            }
            self.constStrings = ns;
            self.capConstStrings = nc;
        }
        self.constStrings[self.nconstStrings++] = sc;
    }

    void addStruct(IrStructType* st)
    {
        if (self.nstructs >= self.capStructs)
        {
            u32 nc = self.capStructs ? self.capStructs * 2 : 4;
            IrStructType** ns = alloc<IrStructType*>((usize)nc);
            if (self.structs)
            {
                copy<IrStructType*>(ns, self.structs, (usize)self.nstructs);
                dealloc<IrStructType*>(self.structs);
            }
            self.structs = ns;
            self.capStructs = nc;
        }
        self.structs[self.nstructs++] = st;
    }
}

// Analysis-cache ownership contract (first-person): each rawptr slot here is
// heap-owned by the cache. The publishing pass (the only one today is
// irAliasAnalysis) transfers ownership of a fresh heap allocation to the
// cache and registers a destroyer for it. clearAnalysisCaches runs every
// registered destroyer before freeing the cache structs, so nothing leaks no
// matter who calls it. memorySSA is optional and currently never published,
// hence always null in practice.
pub struct FunctionAnalysisCache
{
    rawptr aliasAnalysis;
    rawptr memorySSA;
    IrFunc* func;
    // Driver-managed generation at which the cached analyses were built; see
    // IrContext.analysisGeneration. A cache entry whose generation is older
    // than the context is stale and must be rebuilt by the publishing pass.
    u32 generation;
    // Destroyers registered by the publishing passes, invoked by
    // clearAnalysisCaches. Null when the slot was never published.
    void(rawptr) destroyAliasAnalysis;
    void(rawptr) destroyMemorySSA;
}

// consumers (dse, licm, gvn, etc.) check this before creating their own
pub struct IrContext
{
    IrType** types;
    u32 ntypes;
    u32 capTypes;
    u32 nextId;
    IrValue** constInts;
    u32 nconstInts;
    u32 capConstInts;
    IrValue** constFloats;
    u32 nconstFloats;
    u32 capConstFloats;
    IrArrayConst** arrayConsts;
    u32 narrayConsts;
    u32 capArrayConsts;
    FunctionAnalysisCache** analysisCaches;
    u32 nCaches;
    u32 capCaches;
    // Monotonic IR-mutation generation. The pipeline driver bumps this every
    // time a pass reports `changed`; cached analyses stamp themselves with
    // the current value when (re)built and treat a mismatch as stale.
    u32 analysisGeneration;

    u32 nextValueId() { return self.nextId++; }

    FunctionAnalysisCache* getAnalysisCache(IrFunc* func)
    {
        for (u32 i = 0; i < self.nCaches; i++)
            if (self.analysisCaches[i]->func == func)
                return self.analysisCaches[i];
        return null;
    }

    FunctionAnalysisCache* getOrCreateAnalysisCache(IrFunc* func)
    {
        FunctionAnalysisCache* c = self.getAnalysisCache(func);
        if (c) return c;
        if (self.nCaches >= self.capCaches)
        {
            u32 newCap = self.capCaches ? self.capCaches * 2 : 8;
            FunctionAnalysisCache** nc = alloc<FunctionAnalysisCache*>((usize)newCap);
            if (self.analysisCaches)
            {
                copy<FunctionAnalysisCache*>(nc, self.analysisCaches, (usize)self.nCaches);
                dealloc<FunctionAnalysisCache*>(self.analysisCaches);
            }
            self.analysisCaches = nc;
            self.capCaches = newCap;
        }
        c = alloc<FunctionAnalysisCache>((usize)1);
        c->func = func;
        c->aliasAnalysis = null;
        c->memorySSA = null;
        c->generation = 0;
        c->destroyAliasAnalysis = null;
        c->destroyMemorySSA = null;
        self.analysisCaches[self.nCaches++] = c;
        return c;
    }

    void clearAnalysisCaches()
    {
        for (u32 i = 0; i < self.nCaches; i++)
        {
            FunctionAnalysisCache* c = self.analysisCaches[i];
            if (c->aliasAnalysis != null && c->destroyAliasAnalysis != null)
                c->destroyAliasAnalysis(c->aliasAnalysis);
            if (c->memorySSA != null && c->destroyMemorySSA != null)
                c->destroyMemorySSA(c->memorySSA);
            dealloc<FunctionAnalysisCache>(c);
        }
        if (self.analysisCaches)
            dealloc<FunctionAnalysisCache*>(self.analysisCaches);
        self.analysisCaches = null;
        self.nCaches = 0;
        self.capCaches = 0;
    }

    IrType* tyVoid() { return self.tyGetOrCreate(IrTypeKind::Void, 0, null, 0, null, null, 0, false); }
    IrType* tyInt(u32 bits) { return self.tyGetOrCreate(IrTypeKind::Int, bits, null, 0, null, null, 0, false); }
    IrType* tyFloat() { return self.tyGetOrCreate(IrTypeKind::Float, 32, null, 0, null, null, 0, false); }
    IrType* tyDouble() { return self.tyGetOrCreate(IrTypeKind::Float, 64, null, 0, null, null, 0, false); }
    IrType* tyPtr(IrType* elem) { return self.tyGetOrCreate(IrTypeKind::Ptr, 64, elem, 0, null, null, 0, false); }
    IrType* tyArray(IrType* elem, u32 count) { return self.tyGetOrCreate(IrTypeKind::Array, 0, elem, count, null, null, 0, false); }
    IrType* tyFunc(IrType* ret, IrType** params, u32 nparams, bool isVararg) { return self.tyGetOrCreate(IrTypeKind::Func, 0, null, 0, ret, params, nparams, isVararg); }
    IrType* tyVector(IrType* elem, u32 count) { return self.tyGetOrCreate(IrTypeKind::Vector, elem != null ? elem->width * count : 0, elem, count, null, null, 0, false); }
    // the intern key carries the field types: size alone would fold
    // { i32, i32 } and { f32, f32 } into one type and the side-table
    // lookup for gep could not tell them apart
    IrType* tyStruct(IrStructType* st) { return self.tyGetOrCreate(IrTypeKind::Struct, st->size, null, 0, null, st->fieldTypes, st->nfields, false); }

    IrGlobal* createGlobal(str name, IrType* ty, bool isConst, bool isExtern, IrValue* init, u32 alignment)
    {
        IrGlobal* g = alloc<IrGlobal>((usize)1);
        *g = IrGlobal {
            { IrValueKind::Global, ty, self.nextValueId(), 0, irDupStr(name), null, 0, 0 },
            null, isConst, isExtern, init, alignment, null
        };
        return g;
    }

    IrStringConst* createStringConst(str data, u32 length)
    {
        IrStringConst* sc = alloc<IrStringConst>((usize)1);
        IrType* charTy = self.tyInt(8);
        IrType* arrTy = self.tyArray(charTy, length + 1);
        String copy = String::from(str::fromParts(data.ptr, (usize)length));
        *sc = IrStringConst {
            { IrValueKind::StringConst, arrTy, self.nextValueId(), 0, null, null, 0, 0 },
            copy.asU8(), length, null
        };
        return sc;
    }

    u32 irTypeAlignOf(IrType* t)
    {
        if (!t) return 1;
        switch (t->kind)
        {
            IrTypeKind::Int,
            IrTypeKind::Float => {
                u32 a = (t->width + 7) / 8;
                if (a == 0) a = 1;
                return a;
            },
            
            IrTypeKind::Ptr,
            IrTypeKind::Func => { return 8; },
            IrTypeKind::Array,
            IrTypeKind::Vector => { return self.irTypeAlignOf(t->elem); },
            IrTypeKind::Struct => { return 8; },

            else => { return 1; }
        }
    }

    u32 irTypeSizeOf(IrType* t)
    {
        if (!t) return 0;
        switch (t->kind)
        {
            IrTypeKind::Int | IrTypeKind::Float => {
                u32 s = (t->width + 7) / 8;
                if (s == 0) s = 1;
                return s;
            },
            
            IrTypeKind::Ptr | IrTypeKind::Func => { return 8; },
            IrTypeKind::Array | IrTypeKind::Vector => { return self.irTypeSizeOf(t->elem) * (t->count > 0 ? t->count : 1); },
            IrTypeKind::Struct => { return t->width; },
            else => { return 0; }
        }
    }

    static u32 alignUpTo(u32 v, u32 a)
    {
        if (a <= 1) return v;
        return (v + a - 1) / a * a;
    }

    IrStructType* createStructType(str name, IrType** fields, str* fieldNames, u32 nfields)
    {
        IrStructType* st = alloc<IrStructType>((usize)1);
        // alignment aware layout
        u32* offs = alloc<u32>((usize)(nfields > 0u ? (usize)nfields : (usize)1));
        u32 off = 0;
        u32 maxAlign = 1;
        for (u32 i = 0; i < nfields; i++)
        {
            u32 al = self.irTypeAlignOf(fields[i]);
            off = self.alignUpTo(off, al);
            offs[i] = off;
            off += self.irTypeSizeOf(fields[i]);
            if (al > maxAlign) maxAlign = al;
        }
        u32 sz = self.alignUpTo(off, maxAlign);
        IrType* irTy = self.tyGetOrCreate(IrTypeKind::Struct, sz, null, 0, null, fields, nfields, false);

        *st = IrStructType { irTy, name, fields, fieldNames, nfields, nfields, sz, offs };
        return st;
    }

    IrType* tyGetOrCreate(IrTypeKind kind, u32 width,
                          IrType* elem, u32 count,
                          IrType* ret, IrType** params,
                          u32 nparams, bool isVararg)
    {
        for (u32 i = 0; i < self.ntypes; i++)
        {
            IrType* t = self.types[i];
            if (t->kind != kind || t->width != width) continue;
            if (t->count != count || t->nparams != nparams || t->isVararg != isVararg) continue;
            if (kind == IrTypeKind::Ptr || kind == IrTypeKind::Array || kind == IrTypeKind::Vector)
                { if (t->count == count && irTypeEqual(t->elem, elem)) return t; }
            else if (kind == IrTypeKind::Func) {
                if (!irTypeEqual(t->ret, ret)) continue;
                bool match = true;
                for (u32 j = 0; j < nparams; j++)
                    if (!irTypeEqual(t->params[j], params[j])) { match = false; break; }
                if (match) return t;
            }
            else if (kind == IrTypeKind::Struct) {
                bool match = true;
                for (u32 j = 0; j < nparams; j++)
                    if (!irTypeEqual(t->params[j], params[j])) { match = false; break; }
                if (match) return t;
            }
            else return t;
        }

        IrType* t = alloc<IrType>((usize)1);
        *t = IrType { kind, width, elem, count, ret, params, nparams, isVararg };

        u32 idx = self.ntypes;
        if (idx >= self.capTypes)
        {
            u32 newCap = self.capTypes ? self.capTypes * 2 : 16;
            IrType** newTypes = alloc<IrType*>((usize)newCap);
            if (self.types)
                { copy<IrType*>(newTypes, self.types, (usize)self.ntypes); dealloc<IrType*>(self.types); }
            self.types = newTypes; self.capTypes = newCap;
        }
        self.types[idx] = t;
        self.ntypes = idx + 1;
        return t;
    }

    IrValue* constInt(IrType* ty, u64 val)
    {
        for (u32 i = 0; i < self.nconstInts; i++)
            if (self.constInts[i]->type == ty && self.constInts[i]->valData == val)
                return self.constInts[i];

        IrValue* v = alloc<IrValue>((usize)1);
        *v = IrValue { IrValueKind::ConstInt, ty, self.nextValueId(), val, null, null, 0, 0 };
        u32 idx = self.nconstInts;
        if (idx >= self.capConstInts)
        {
            u32 newCap = self.capConstInts ? self.capConstInts * 2 : 16;
            IrValue** newC = alloc<IrValue*>((usize)newCap);
            if (self.constInts)
                { copy<IrValue*>(newC, self.constInts, (usize)self.nconstInts); dealloc<IrValue*>(self.constInts); }
            self.constInts = newC; self.capConstInts = newCap;
        }
        self.constInts[idx] = v;
        self.nconstInts = idx + 1;
        return v;
    }

    IrValue* constFloat(IrType* ty, f64 val)
    {
        u64 raw;
        copy<u8>((u8*)&raw, (u8*)&val, 8);
        for (u32 i = 0; i < self.nconstFloats; i++)
            if (self.constFloats[i]->valData == raw) return self.constFloats[i];

        IrValue* v = alloc<IrValue>((usize)1);
        *v = IrValue { IrValueKind::ConstFloat, ty, self.nextValueId(), raw, null, null, 0, 0 };
        
        u32 idx = self.nconstFloats;
        if (idx >= self.capConstFloats) {
            u32 newCap = self.capConstFloats ? self.capConstFloats * 2 : 8;
            IrValue** newC = alloc<IrValue*>((usize)newCap);
            if (self.constFloats) { copy<IrValue*>(newC, self.constFloats, (usize)self.nconstFloats);
                dealloc<IrValue*>(self.constFloats); }
            self.constFloats = newC; self.capConstFloats = newCap;
        }
        self.constFloats[idx] = v;
        self.nconstFloats = idx + 1;
        return v;
    }

    // ir_strings builds element constants then folds them here; there was no
    // aggregate const in the value table before this, so it just gets one
    IrValue* constArray(IrType* ty, IrValue** elems, u32 nelems)
    {
        IrArrayConst* ac = alloc<IrArrayConst>((usize)1);
        IrValue** els = alloc<IrValue*>((usize)(nelems > 0u ? (usize)nelems : (usize)1));
        for (u32 i = 0; i < nelems; i++) els[i] = elems ? elems[i] : null;
        *ac = IrArrayConst {
            { IrValueKind::ConstArray, ty, self.nextValueId(), 0, null, null, 0, 0 },
            els, nelems
        };
        u32 idx = self.narrayConsts;
        if (idx >= self.capArrayConsts)
        {
            u32 newCap = self.capArrayConsts ? self.capArrayConsts * 2 : 8;
            IrArrayConst** newC = alloc<IrArrayConst*>((usize)newCap);
            if (self.arrayConsts)
                { copy<IrArrayConst*>(newC, self.arrayConsts, (usize)self.narrayConsts); dealloc<IrArrayConst*>(self.arrayConsts); }
            self.arrayConsts = newC; self.capArrayConsts = newCap;
        }
        self.arrayConsts[idx] = ac;
        self.narrayConsts = idx + 1;
        return &ac->base;
    }

    IrInst* createInst(IrOpcode op, IrType* ty, IrValue** ops, u32 nops, u64 icmpP, u64 fcmpP)
    {
        IrInst* inst = alloc<IrInst>((usize)1);
        IrValue** opsCopy = alloc<IrValue*>((usize)(nops > 0u ? (usize)nops : (usize)1));
        for (u32 i = 0; i < nops; i++) opsCopy[i] = ops ? ops[i] : null;

        *inst = IrInst { { IrValueKind::Inst, ty, self.nextValueId(), 0, null, null, 0, 0 },
            op, null, null, null, opsCopy, nops, nops,
            0, 0, { null, 0, 0 }, null, 0, 0,
            "", "", "",
            0, null
        };
        
        // atomics smuggle their ordering (and rmw op) through the same slots
        // the builder already passes them in, so they survive the round trip
        if (op == IrOpcode::ICmp || op == IrOpcode::AtomicLoad || op == IrOpcode::AtomicStore ||
            op == IrOpcode::AtomicRmw || op == IrOpcode::AtomicCmpXchg || op == IrOpcode::Fence)
            inst->icmpPred = (IrICmpPred)icmpP;
        if (op == IrOpcode::FCmp || op == IrOpcode::AtomicRmw || op == IrOpcode::AtomicCmpXchg)
            inst->fcmpPred = (IrFCmpPred)fcmpP;
        return inst;
    }

    IrBlock* createBlock(str name)
    {
        IrBlock* bb = alloc<IrBlock>((usize)1);
        *bb = IrBlock {
            { IrValueKind::Block, null, self.nextValueId(), 0, irDupStr(name), null, 0, 0 },
            null, null, 0, 0, null, 0, 0, null, 0, 0
        };
        return bb;
    }

    IrFunc* createFunc(str name, IrType* ret, IrType** params, u32 nparams)
    {
        IrFunc* f = alloc<IrFunc>((usize)1);
        *f = IrFunc {
            { IrValueKind::Func, self.tyFunc(ret, params, nparams, false), self.nextValueId(), 0, irDupStr(name), null, 0, 0 },
            null, null, 0, 0, ret, params, nparams,
            false, "", "", null, null, 0, 0
        };
        return f;
    }

    IrModule* createModule(str name)
    {
        IrModule* m = alloc<IrModule>((usize)1);
        *m = IrModule { self, name, null, 0, 0, null, 0, 0, null, 0, 0, null, 0, 0 };
        return m;
    }
}

pub IrContext* irCtxCreate()
{
    IrContext* ctx = alloc<IrContext>((usize)1);
    *ctx = IrContext { null, 0, 0, 1, null, 0, 0, null, 0, 0 };
    return ctx;
}

pub void irCtxDestroy(IrContext* ctx)
{
    if (!ctx) return;
    ctx->clearAnalysisCaches();
    if (ctx->constInts) dealloc<IrValue*>(ctx->constInts);
    if (ctx->constFloats) dealloc<IrValue*>(ctx->constFloats);
    if (ctx->arrayConsts) dealloc<IrArrayConst*>(ctx->arrayConsts);
    if (ctx->types) dealloc<IrType*>(ctx->types);
    dealloc<IrContext>(ctx);
}

pub void irGlobalDestroy(IrGlobal* g)
{
    if (!g) return;
    if (g->base.name.ptr) dealloc<u8>((u8*)g->base.name.ptr);
    dealloc<IrGlobal>(g);
}

pub void irStringConstDestroy(IrStringConst* sc)
{
    if (!sc) return;
    if (sc->data) dealloc<u8>(sc->data);
    dealloc<IrStringConst>(sc);
}

pub void irArrayConstDestroy(IrArrayConst* ac)
{
    if (!ac) return;
    if (ac->elems) dealloc<IrValue*>(ac->elems);
    dealloc<IrArrayConst>(ac);
}

pub void irStructTypeDestroy(IrStructType* st)
{
    if (!st) return;
    if (st->offsets) dealloc<u32>(st->offsets);
    dealloc<IrStructType>(st);
}

bool irTypeEqual(IrType* a, IrType* b)
{
    if (!a || !b) return false;
    if (a->kind != b->kind) return false;
    switch (a->kind)
    {
        IrTypeKind::Void => { return true; },
        IrTypeKind::Int,
        IrTypeKind::Float => { return a->width == b->width; },
        IrTypeKind::Ptr => { return irTypeEqual(a->elem, b->elem); },
        IrTypeKind::Array => { return a->count == b->count && irTypeEqual(a->elem, b->elem); },
        IrTypeKind::Vector => { return a->count == b->count && irTypeEqual(a->elem, b->elem); },
        IrTypeKind::Struct => {
            if (a->width != b->width || a->nparams != b->nparams) return false;
            for (u32 i = 0; i < a->nparams; i++)
                if (!irTypeEqual(a->params[i], b->params[i])) return false;
            return true;
        }
        
        IrTypeKind::Func => {
            if (!irTypeEqual(a->ret, b->ret) || a->isVararg != b->isVararg || a->nparams != b->nparams) return false;
            for (u32 i = 0; i < a->nparams; i++)
                if (!irTypeEqual(a->params[i], b->params[i])) return false;
            return true;
        }

        else => {
            return false;
        }
    }
}

pub str irTypeStr(IrType* t)
{
    if (!t) return "void";
    switch (t->kind)
    {
        IrTypeKind::Void => { return "void"; },
        IrTypeKind::Int => {
            if (t->width == 1) return "i1";
            if (t->width == 8) return "i8";
            if (t->width == 16) return "i16";
            if (t->width == 32) return "i32";
            if (t->width == 64) return "i64";
            return "iN";
        },

        IrTypeKind::Float => { return t->width == 64 ? "f64" : "float"; },
        IrTypeKind::Ptr => { return "ptr"; },
        IrTypeKind::Array => { return "array"; },
        IrTypeKind::Vector => { return "vector"; },
        IrTypeKind::Func => { return "func"; }, 
    
        else => { return "unknown"; }
    }
}

pub extern f64 sqrt(f64 x);

pub u32 wallvmClz64(u64 v)
{
    if (v == 0ULL) return 64u;
    u32 n = 0u;
    while ((v & 0x8000000000000000ULL) == 0ULL)
    {
        v <<= 1;
        n++;
    }
    return n;
}

pub u32 wallvmCtz64(u64 v)
{
    if (v == 0ULL) return 64u;
    u32 n = 0u;
    while ((v & 1ULL) == 0ULL)
    {
        v >>= 1;
        n++;
    }
    return n;
}
