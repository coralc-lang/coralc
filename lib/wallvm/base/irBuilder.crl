#[[no_drop_all]]
import(lib) wallvm::irtypes { IrBlock, IrContext, IrInst, IrType, IrTypeKind, IrValue };
import(lib) wallvm::irOps { IrAtomicOrdering, IrAtomicRmwOp, IrFCmpPred, IrICmpPred, IrOpcode };
import(lib) std::mman { alloc, dealloc };

str dupStr(str s)
{
    u8* b = alloc<u8>((usize)(s.len + 1));
    for (usize i = 0; i < s.len; i++) b[i] = s.ptr[i];
    b[s.len] = 0;
    return str::fromParts((const u8*)b, s.len);
}

pub struct IrBuilder
{
    IrContext* ctx;
    IrBlock* block;
    IrInst* insertBefore;

    IrBuilder new(IrContext* ctx)
    {
        return IrBuilder {
            .ctx = ctx,
            .block = null,
            .insertBefore = null
        };
    }

    // Set insertion position
    void pos(IrBlock* block, IrInst* before)
    {
        self.block = block;
        self.insertBefore = before;
    }

    IrInst* retVoid()
    {
        return self.createInst(IrOpcode::Ret, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    IrInst* ret(IrValue* val)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = val;
        return self.createInst(IrOpcode::Ret, val->type, ops, 1, 0, 0);
    }

    IrInst* br(IrBlock* dest)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = &dest->base;
        IrInst* inst = self.createInst(IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
        // sdd successor edge
        if (self.block) self.block->addSucc(dest);
        return inst;
    }

    IrInst* condBr(IrValue* cond, IrBlock* thenBb, IrBlock* elseBb)
    {
        IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = &thenBb->base;
        ops[2] = &elseBb->base;
        IrInst* inst = self.createInst(IrOpcode::CondBr, self.ctx->tyVoid(), ops, 3, 0, 0);
        if (self.block) {
            self.block->addSucc(thenBb);
            self.block->addSucc(elseBb);
        }
        return inst;
    }

    IrInst* unreachable()
    {
        return self.createInst(IrOpcode::Unreachable, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    IrInst* noret()
    {
        return self.createInst(IrOpcode::Noret, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    IrInst* add(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Add, l, r);
    }

    IrInst* sub(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Sub, l, r);
    }

    IrInst* mul(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Mul, l, r);
    }

    IrInst* sdiv(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::SDiv, l, r);
    }

    IrInst* udiv(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::UDiv, l, r);
    }

    IrInst* srem(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::SRem, l, r);
    }

    IrInst* fadd(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::FAdd, l, r);
    }

    IrInst* fsub(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::FSub, l, r);
    }

    IrInst* fmul(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::FMul, l, r);
    }

    IrInst* fdiv(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::FDiv, l, r);
    }

    IrInst* urem(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::URem, l, r);
    }

    IrInst* andOp(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::And, l, r);
    }

    IrInst* orOp(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Or, l, r);
    }

    IrInst* xorOp(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Xor, l, r);
    }

    IrInst* shl(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Shl, l, r);
    }

    IrInst* ashr(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Ashr, l, r);
    }

    IrInst* lshr(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::Lshr, l, r);
    }

    IrInst* neg(IrValue* v)
    {
        return self.createUnary2(IrOpcode::Neg, v);
    }

    IrInst* notOp(IrValue* v)
    {
        return self.createUnary2(IrOpcode::Not, v);
    }

    // Memory
    IrInst* alloca(IrType* ty)
    {
        IrType* ptrTy = self.ctx->tyPtr(ty);
        return self.createInst(IrOpcode::Alloca, ptrTy, null, 0, 0, 0);
    }

    IrInst* load(IrType* ty, IrValue* ptr)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(IrOpcode::Load, ty, ops, 1, 0, 0);
    }

    IrInst* store(IrValue* val, IrValue* ptr)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(IrOpcode::Store, self.ctx->tyVoid(), ops, 2, 0, 0);
    }

    IrInst* gep(IrValue* ptr, IrValue** idxs, u32 nidxs)
    {
        IrValue** ops = self.allocOps(nidxs + 1);
        ops[0] = ptr;
        for (u32 i = 0; i < nidxs; i++)
            ops[i + 1] = idxs[i];
        IrType* elemTy = ptr->type;
        if (elemTy && elemTy->kind == IrTypeKind::Ptr && elemTy->elem)
            elemTy = elemTy->elem;
        return self.createInst(IrOpcode::Gep, self.ctx->tyPtr(elemTy), ops, nidxs + 1, 0, 0);
    }

    // Cast
    IrInst* trunc(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::Trunc, v, dt);
    }

    IrInst* zext(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::Zext, v, dt);
    }

    IrInst* sext(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::Sext, v, dt);
    }

    IrInst* fpTrunc(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::FpTrunc, v, dt);
    }

    IrInst* fpExt(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::FpExt, v, dt);
    }

    IrInst* fpToSi(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::FpToSi, v, dt);
    }

    IrInst* fpToUi(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::FpToUi, v, dt);
    }

    IrInst* siToFp(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::SiToFp, v, dt);
    }

    IrInst* uiToFp(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::UiToFp, v, dt);
    }

    IrInst* bitcast(IrValue* v, IrType* dt)
    {
        return self.createUnary3(IrOpcode::Bitcast, v, dt);
    }

    // Compare
    IrInst* icmp(IrICmpPred p, IrValue* l, IrValue* r)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        IrType* i1Ty = self.ctx->tyInt(1);
        return self.createInst(IrOpcode::ICmp, i1Ty, ops, 2, (u64)p, 0);
    }

    IrInst* fcmp(IrFCmpPred p, IrValue* l, IrValue* r)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        IrType* i1Ty = self.ctx->tyInt(1);
        return self.createInst(IrOpcode::FCmp, i1Ty, ops, 2, 0, (u64)p);
    }

    // bit man
    IrInst* ctPop(IrValue* v)
    {
        return self.createUnary2(IrOpcode::CtPop, v);
    }

    IrInst* ctLz(IrValue* v)
    {
        return self.createUnary2(IrOpcode::CtLz, v);
    }

    IrInst* ctTz(IrValue* v)
    {
        return self.createUnary2(IrOpcode::CtTz, v);
    }

    IrInst* rotl(IrValue* x, IrValue* y)
    {
        return self.createBinary(IrOpcode::Rotl, x, y);
    }

    IrInst* rotr(IrValue* x, IrValue* y)
    {
        return self.createBinary(IrOpcode::Rotr, x, y);
    }

    IrInst* bswap(IrValue* v)
    {
        return self.createUnary2(IrOpcode::Bswap, v);
    }

    // maths shit
    IrInst* smin(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::SMin, l, r);
    }

    IrInst* smax(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::SMax, l, r);
    }

    IrInst* umin(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::UMin, l, r);
    }

    IrInst* umax(IrValue* l, IrValue* r)
    {
        return self.createBinary(IrOpcode::UMax, l, r);
    }

    IrInst* abs(IrValue* v)
    {
        return self.createUnary2(IrOpcode::Abs, v);
    }

    // Floating-point

    IrInst* fma(IrValue* a, IrValue* b, IrValue* c)
    {
        IrValue** ops = self.allocOps(3);
        ops[0] = a;
        ops[1] = b;
        ops[2] = c;
        return self.createInst(IrOpcode::Fma, a->type, ops, 3, 0, 0);
    }

    IrInst* fabs(IrValue* v)
    {
        return self.createUnary2(IrOpcode::FAbs, v);
    }

    IrInst* fsqrt(IrValue* v)
    {
        return self.createUnary2(IrOpcode::FSqrt, v);
    }

    IrInst* shuffleVector(IrValue* v1, IrValue* v2, IrValue** mask, u32 nmask)
    {
        IrValue** ops = self.allocOps(nmask + 2);
        ops[0] = v1;
        ops[1] = v2;
        for (u32 i = 0; i < nmask; i++) ops[i + 2] = mask[i];
        return self.createInst(IrOpcode::ShuffleVector, v1->type, ops, nmask + 2, 0, 0);
    }

    IrInst* extractElement(IrValue* v, IrValue* idx)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = v;
        ops[1] = idx;
        IrType* elemTy = v->type && v->type->kind == IrTypeKind::Vector ? v->type->elem : v->type;
        return self.createInst(IrOpcode::ExtractElement, elemTy, ops, 2, 0, 0);
    }

    IrInst* insertElement(IrValue* v, IrValue* val, IrValue* idx)
    {
        IrValue** ops = self.allocOps(3);
        ops[0] = v;
        ops[1] = val;
        ops[2] = idx;
        return self.createInst(IrOpcode::InsertElement, v->type, ops, 3, 0, 0);
    }

    // the three strings copy into the instruction (matching the parser's
    // owned-buffer convention), and volatile lands in asmNumSideEffects —
    // operands are the values the template may touch, nothing else
    IrInst* inlineAsm(str tmpl, str constraints, str clobbers, bool isVolatile,
                              IrValue** args, u32 nargs, IrType* retTy)
    {
        IrValue** ops = self.allocOps(nargs);
        for (u32 i = 0; i < nargs; i++) ops[i] = args[i];
        IrInst* inst = self.createInst(IrOpcode::InlineAsm, retTy ? retTy : self.ctx->tyVoid(), ops, nargs, 0, 0);
        inst->asmString = dupStr(tmpl);
        inst->asmConstraints = dupStr(constraints);
        inst->asmClobbers = dupStr(clobbers);
        inst->asmNumSideEffects = isVolatile ? 1 : 0;
        return inst;
    }

    // atomics
    IrInst* atomicLoad(IrType* ty, IrValue* ptr, IrAtomicOrdering order)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(IrOpcode::AtomicLoad, ty, ops, 1, (u64)order, 0);
    }

    IrInst* atomicStore(IrValue* val, IrValue* ptr, IrAtomicOrdering order)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(IrOpcode::AtomicStore, self.ctx->tyVoid(), ops, 2, (u64)order, 0);
    }

    IrInst* atomicRmw(IrType* ty,
                               IrAtomicRmwOp op,
                               IrValue* ptr,
                               IrValue* val,
                               IrAtomicOrdering order)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(IrOpcode::AtomicRmw, ty, ops, 2, (u64)op, (u64)order);
    }

    IrInst* atomicCmpXchg(IrType* ty,
                                  IrValue* ptr,
                                  IrValue* cmp,
                                  IrValue* val,
                                  IrAtomicOrdering succ,
                                  IrAtomicOrdering fail)
    {
        IrValue** ops = self.allocOps(3);
        ops[0] = ptr;
        ops[1] = cmp;
        ops[2] = val;
        return self.createInst(IrOpcode::AtomicCmpXchg, ty, ops, 3, (u64)succ, (u64)fail);
    }

    IrInst* fence(IrAtomicOrdering order)
    {
        return self.createInst(IrOpcode::Fence, self.ctx->tyVoid(), null, 0, (u64)order, 0);
    }

    // exception handling
    IrInst* landingPad(IrType* ty, IrValue* personalityFn, u32 numClauses)
    {
        IrValue** ops = self.allocOps(numClauses + 1);
        ops[0] = personalityFn;
        for (u32 i = 0; i < numClauses; i++)
            ops[i + 1] = null; // placeholder for filter/catch clauses
        return self.createInst(IrOpcode::LandingPad, ty, ops, numClauses + 1, 0, 0);
    }

    IrInst* extractValue(IrValue* agg, u32 idx)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = agg;
        IrType* i32Ty = self.ctx->tyInt(32);
        ops[1] = self.ctx->constInt(i32Ty, (u64)idx);
        IrType* elemTy = agg->type;
        if (elemTy && elemTy->kind == IrTypeKind::Array && elemTy->elem)
            elemTy = elemTy->elem;
        return self.createInst(IrOpcode::ExtractValue, elemTy, ops, 2, 0, 0);
    }

    // gc support
    IrInst* gcRoot(IrValue* ptr)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(IrOpcode::GcRoot, ptr->type, ops, 1, 0, 0);
    }

    IrInst* gcWriteBarrier(IrValue* ptr, IrValue* val)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(IrOpcode::GcWriteBarrier, self.ctx->tyVoid(), ops, 2, 0, 0);
    }

    IrInst* gcSafepoint()
    {
        return self.createInst(IrOpcode::GcSafepoint, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    IrInst* call(IrValue* callee, IrValue** args, u32 nargs)
    {
        IrType* retTy = callee->type;
        if (retTy && retTy->kind == IrTypeKind::Func && retTy->ret)
            retTy = retTy->ret;
        else
            retTy = self.ctx->tyVoid();
        IrValue** ops = self.allocOps(nargs + 1);
        ops[0] = callee;
        for (u32 i = 0; i < nargs; i++)
            ops[i + 1] = args[i];
        return self.createInst(IrOpcode::Call, retTy, ops, nargs + 1, 0, 0);
    }

    IrInst* phi(IrType* ty, IrValue** vals, IrBlock** blocks, u32 nincoming)
    {
        // interleave, val, block, val, block, ...
        u32 nops = nincoming * 2;
        IrValue** ops = self.allocOps(nops);
        for (u32 i = 0; i < nincoming; i++)
        {
            ops[i * 2] = vals[i];
            ops[i * 2 + 1] = &blocks[i]->base;
        }
        return self.createInst(IrOpcode::Phi, ty, ops, nops, 0, 0);
    }

    IrInst* select(IrValue* cond, IrValue* t, IrValue* f)
    {
        IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = t;
        ops[2] = f;
        return self.createInst(IrOpcode::Select, t->type, ops, 3, 0, 0);
    }

    IrValue** allocOps(u32 count)
    {
        return (IrValue**)alloc<IrValue*>((usize)count);
    }

    IrInst* createBinary(IrOpcode op, IrValue* l, IrValue* r)
    {
        IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        return self.createInst(op, l->type, ops, 2, 0, 0);
    }

    IrInst* createUnary2(IrOpcode op, IrValue* v)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, v->type, ops, 1, 0, 0);
    }

    IrInst* createUnary3(IrOpcode op, IrValue* v, IrType* dt)
    {
        IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, dt, ops, 1, 0, 0);
    }

    IrInst* createInst(IrOpcode op, IrType* ty, IrValue** ops, u32 nops, u64 icmpP, u64 fcmpP)
    {
        IrInst* inst = self.ctx->createInst(op, ty, ops, nops, icmpP, fcmpP);
        if (inst != null)
        {
            // Insert into current block
            if (self.block)
                self.block->addInst(inst);

            // Track users for each operand (before freeing ops)
            for (u32 i = 0; i < nops; i++)
                if (ops[i] != null)
                    ops[i]->addUser(inst);
        }
        // Free the temp ops array now that createInst copied it
        if (ops) dealloc<IrValue*>(ops);
        return inst;
    }
}