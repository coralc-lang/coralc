#[[no_drop_all]]
import irtypes;
import irOps;
import(lib) std;

str dupStr(str s)
{
    u8* b = std::mman::alloc<u8>((usize)(s.len + 1));
    for (usize i = 0; i < s.len; i++) b[i] = s.ptr[i];
    b[s.len] = 0;
    return str::fromParts((const u8*)b, s.len);
}

pub struct IrBuilder
{
    irtypes::IrContext* ctx;
    irtypes::IrBlock* block;
    irtypes::IrInst* insertBefore;

    IrBuilder new(irtypes::IrContext* ctx)
    {
        return IrBuilder {
            .ctx = ctx,
            .block = null,
            .insertBefore = null
        };
    }

    // Set insertion position
    void pos(irtypes::IrBlock* block, irtypes::IrInst* before)
    {
        self.block = block;
        self.insertBefore = before;
    }

    irtypes::IrInst* retVoid()
    {
        return self.createInst(irOps::IrOpcode::Ret, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    irtypes::IrInst* ret(irtypes::IrValue* val)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = val;
        return self.createInst(irOps::IrOpcode::Ret, val->type, ops, 1, 0, 0);
    }

    irtypes::IrInst* br(irtypes::IrBlock* dest)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = &dest->base;
        irtypes::IrInst* inst = self.createInst(irOps::IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
        // sdd successor edge
        if (self.block) self.block->addSucc(dest);
        return inst;
    }

    irtypes::IrInst* condBr(irtypes::IrValue* cond, irtypes::IrBlock* thenBb, irtypes::IrBlock* elseBb)
    {
        irtypes::IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = &thenBb->base;
        ops[2] = &elseBb->base;
        irtypes::IrInst* inst = self.createInst(irOps::IrOpcode::CondBr, self.ctx->tyVoid(), ops, 3, 0, 0);
        if (self.block) {
            self.block->addSucc(thenBb);
            self.block->addSucc(elseBb);
        }
        return inst;
    }

    irtypes::IrInst* unreachable()
    {
        return self.createInst(irOps::IrOpcode::Unreachable, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    irtypes::IrInst* noret()
    {
        return self.createInst(irOps::IrOpcode::Noret, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    irtypes::IrInst* add(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Add, l, r);
    }

    irtypes::IrInst* sub(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Sub, l, r);
    }

    irtypes::IrInst* mul(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Mul, l, r);
    }

    irtypes::IrInst* sdiv(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::SDiv, l, r);
    }

    irtypes::IrInst* udiv(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::UDiv, l, r);
    }

    irtypes::IrInst* srem(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::SRem, l, r);
    }

    irtypes::IrInst* fadd(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FAdd, l, r);
    }

    irtypes::IrInst* fsub(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FSub, l, r);
    }

    irtypes::IrInst* fmul(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FMul, l, r);
    }

    irtypes::IrInst* fdiv(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::FDiv, l, r);
    }

    irtypes::IrInst* urem(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::URem, l, r);
    }

    irtypes::IrInst* andOp(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::And, l, r);
    }

    irtypes::IrInst* orOp(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Or, l, r);
    }

    irtypes::IrInst* xorOp(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Xor, l, r);
    }

    irtypes::IrInst* shl(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Shl, l, r);
    }

    irtypes::IrInst* ashr(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Ashr, l, r);
    }

    irtypes::IrInst* lshr(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::Lshr, l, r);
    }

    irtypes::IrInst* neg(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::Neg, v);
    }

    irtypes::IrInst* notOp(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::Not, v);
    }

    // Memory
    irtypes::IrInst* alloca(irtypes::IrType* ty)
    {
        irtypes::IrType* ptrTy = self.ctx->tyPtr(ty);
        return self.createInst(irOps::IrOpcode::Alloca, ptrTy, null, 0, 0, 0);
    }

    irtypes::IrInst* load(irtypes::IrType* ty, irtypes::IrValue* ptr)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(irOps::IrOpcode::Load, ty, ops, 1, 0, 0);
    }

    irtypes::IrInst* store(irtypes::IrValue* val, irtypes::IrValue* ptr)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(irOps::IrOpcode::Store, self.ctx->tyVoid(), ops, 2, 0, 0);
    }

    irtypes::IrInst* gep(irtypes::IrValue* ptr, irtypes::IrValue** idxs, u32 nidxs)
    {
        irtypes::IrValue** ops = self.allocOps(nidxs + 1);
        ops[0] = ptr;
        for (u32 i = 0; i < nidxs; i++)
            ops[i + 1] = idxs[i];
        irtypes::IrType* elemTy = ptr->type;
        if (elemTy && elemTy->kind == irtypes::IrTypeKind::Ptr && elemTy->elem)
            elemTy = elemTy->elem;
        return self.createInst(irOps::IrOpcode::Gep, self.ctx->tyPtr(elemTy), ops, nidxs + 1, 0, 0);
    }

    // Cast
    irtypes::IrInst* trunc(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::Trunc, v, dt);
    }

    irtypes::IrInst* zext(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::Zext, v, dt);
    }

    irtypes::IrInst* sext(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::Sext, v, dt);
    }

    irtypes::IrInst* fpTrunc(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::FpTrunc, v, dt);
    }

    irtypes::IrInst* fpExt(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::FpExt, v, dt);
    }

    irtypes::IrInst* fpToSi(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::FpToSi, v, dt);
    }

    irtypes::IrInst* fpToUi(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::FpToUi, v, dt);
    }

    irtypes::IrInst* siToFp(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::SiToFp, v, dt);
    }

    irtypes::IrInst* uiToFp(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::UiToFp, v, dt);
    }

    irtypes::IrInst* bitcast(irtypes::IrValue* v, irtypes::IrType* dt)
    {
        return self.createUnary3(irOps::IrOpcode::Bitcast, v, dt);
    }

    // Compare
    irtypes::IrInst* icmp(irOps::IrICmpPred p, irtypes::IrValue* l, irtypes::IrValue* r)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        irtypes::IrType* i1Ty = self.ctx->tyInt(1);
        return self.createInst(irOps::IrOpcode::ICmp, i1Ty, ops, 2, (u64)p, 0);
    }

    irtypes::IrInst* fcmp(irOps::IrFCmpPred p, irtypes::IrValue* l, irtypes::IrValue* r)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        irtypes::IrType* i1Ty = self.ctx->tyInt(1);
        return self.createInst(irOps::IrOpcode::FCmp, i1Ty, ops, 2, 0, (u64)p);
    }

    // bit man
    irtypes::IrInst* ctPop(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::CtPop, v);
    }

    irtypes::IrInst* ctLz(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::CtLz, v);
    }

    irtypes::IrInst* ctTz(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::CtTz, v);
    }

    irtypes::IrInst* rotl(irtypes::IrValue* x, irtypes::IrValue* y)
    {
        return self.createBinary(irOps::IrOpcode::Rotl, x, y);
    }

    irtypes::IrInst* rotr(irtypes::IrValue* x, irtypes::IrValue* y)
    {
        return self.createBinary(irOps::IrOpcode::Rotr, x, y);
    }

    irtypes::IrInst* bswap(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::Bswap, v);
    }

    // maths shit
    irtypes::IrInst* smin(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::SMin, l, r);
    }

    irtypes::IrInst* smax(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::SMax, l, r);
    }

    irtypes::IrInst* umin(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::UMin, l, r);
    }

    irtypes::IrInst* umax(irtypes::IrValue* l, irtypes::IrValue* r)
    {
        return self.createBinary(irOps::IrOpcode::UMax, l, r);
    }

    irtypes::IrInst* abs(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::Abs, v);
    }

    // Floating-point

    irtypes::IrInst* fma(irtypes::IrValue* a, irtypes::IrValue* b, irtypes::IrValue* c)
    {
        irtypes::IrValue** ops = self.allocOps(3);
        ops[0] = a;
        ops[1] = b;
        ops[2] = c;
        return self.createInst(irOps::IrOpcode::Fma, a->type, ops, 3, 0, 0);
    }

    irtypes::IrInst* fabs(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::FAbs, v);
    }

    irtypes::IrInst* fsqrt(irtypes::IrValue* v)
    {
        return self.createUnary2(irOps::IrOpcode::FSqrt, v);
    }

    irtypes::IrInst* shuffleVector(irtypes::IrValue* v1, irtypes::IrValue* v2, irtypes::IrValue** mask, u32 nmask)
    {
        irtypes::IrValue** ops = self.allocOps(nmask + 2);
        ops[0] = v1;
        ops[1] = v2;
        for (u32 i = 0; i < nmask; i++) ops[i + 2] = mask[i];
        return self.createInst(irOps::IrOpcode::ShuffleVector, v1->type, ops, nmask + 2, 0, 0);
    }

    irtypes::IrInst* extractElement(irtypes::IrValue* v, irtypes::IrValue* idx)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = v;
        ops[1] = idx;
        irtypes::IrType* elemTy = v->type && v->type->kind == irtypes::IrTypeKind::Vector ? v->type->elem : v->type;
        return self.createInst(irOps::IrOpcode::ExtractElement, elemTy, ops, 2, 0, 0);
    }

    irtypes::IrInst* insertElement(irtypes::IrValue* v, irtypes::IrValue* val, irtypes::IrValue* idx)
    {
        irtypes::IrValue** ops = self.allocOps(3);
        ops[0] = v;
        ops[1] = val;
        ops[2] = idx;
        return self.createInst(irOps::IrOpcode::InsertElement, v->type, ops, 3, 0, 0);
    }

    // the three strings copy into the instruction (matching the parser's
    // owned-buffer convention), and volatile lands in asmNumSideEffects —
    // operands are the values the template may touch, nothing else
    irtypes::IrInst* inlineAsm(str tmpl, str constraints, str clobbers, bool isVolatile,
                              irtypes::IrValue** args, u32 nargs, irtypes::IrType* retTy)
    {
        irtypes::IrValue** ops = self.allocOps(nargs);
        for (u32 i = 0; i < nargs; i++) ops[i] = args[i];
        irtypes::IrInst* inst = self.createInst(irOps::IrOpcode::InlineAsm, retTy ? retTy : self.ctx->tyVoid(), ops, nargs, 0, 0);
        inst->asmString = dupStr(tmpl);
        inst->asmConstraints = dupStr(constraints);
        inst->asmClobbers = dupStr(clobbers);
        inst->asmNumSideEffects = isVolatile ? 1 : 0;
        return inst;
    }

    // atomics
    irtypes::IrInst* atomicLoad(irtypes::IrType* ty, irtypes::IrValue* ptr, irOps::IrAtomicOrdering order)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(irOps::IrOpcode::AtomicLoad, ty, ops, 1, (u64)order, 0);
    }

    irtypes::IrInst* atomicStore(irtypes::IrValue* val, irtypes::IrValue* ptr, irOps::IrAtomicOrdering order)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = val;
        ops[1] = ptr;
        return self.createInst(irOps::IrOpcode::AtomicStore, self.ctx->tyVoid(), ops, 2, (u64)order, 0);
    }

    irtypes::IrInst* atomicRmw(irtypes::IrType* ty,
                               irOps::IrAtomicRmwOp op,
                               irtypes::IrValue* ptr,
                               irtypes::IrValue* val,
                               irOps::IrAtomicOrdering order)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(irOps::IrOpcode::AtomicRmw, ty, ops, 2, (u64)op, (u64)order);
    }

    irtypes::IrInst* atomicCmpXchg(irtypes::IrType* ty,
                                  irtypes::IrValue* ptr,
                                  irtypes::IrValue* cmp,
                                  irtypes::IrValue* val,
                                  irOps::IrAtomicOrdering succ,
                                  irOps::IrAtomicOrdering fail)
    {
        irtypes::IrValue** ops = self.allocOps(3);
        ops[0] = ptr;
        ops[1] = cmp;
        ops[2] = val;
        return self.createInst(irOps::IrOpcode::AtomicCmpXchg, ty, ops, 3, (u64)succ, (u64)fail);
    }

    irtypes::IrInst* fence(irOps::IrAtomicOrdering order)
    {
        return self.createInst(irOps::IrOpcode::Fence, self.ctx->tyVoid(), null, 0, (u64)order, 0);
    }

    // exception handling
    irtypes::IrInst* landingPad(irtypes::IrType* ty, irtypes::IrValue* personalityFn, u32 numClauses)
    {
        irtypes::IrValue** ops = self.allocOps(numClauses + 1);
        ops[0] = personalityFn;
        for (u32 i = 0; i < numClauses; i++)
            ops[i + 1] = null; // placeholder for filter/catch clauses
        return self.createInst(irOps::IrOpcode::LandingPad, ty, ops, numClauses + 1, 0, 0);
    }

    irtypes::IrInst* extractValue(irtypes::IrValue* agg, u32 idx)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = agg;
        irtypes::IrType* i32Ty = self.ctx->tyInt(32);
        ops[1] = self.ctx->constInt(i32Ty, (u64)idx);
        irtypes::IrType* elemTy = agg->type;
        if (elemTy && elemTy->kind == irtypes::IrTypeKind::Array && elemTy->elem)
            elemTy = elemTy->elem;
        return self.createInst(irOps::IrOpcode::ExtractValue, elemTy, ops, 2, 0, 0);
    }

    // gc support
    irtypes::IrInst* gcRoot(irtypes::IrValue* ptr)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = ptr;
        return self.createInst(irOps::IrOpcode::GcRoot, ptr->type, ops, 1, 0, 0);
    }

    irtypes::IrInst* gcWriteBarrier(irtypes::IrValue* ptr, irtypes::IrValue* val)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = ptr;
        ops[1] = val;
        return self.createInst(irOps::IrOpcode::GcWriteBarrier, self.ctx->tyVoid(), ops, 2, 0, 0);
    }

    irtypes::IrInst* gcSafepoint()
    {
        return self.createInst(irOps::IrOpcode::GcSafepoint, self.ctx->tyVoid(), null, 0, 0, 0);
    }

    irtypes::IrInst* call(irtypes::IrValue* callee, irtypes::IrValue** args, u32 nargs)
    {
        irtypes::IrType* retTy = callee->type;
        if (retTy && retTy->kind == irtypes::IrTypeKind::Func && retTy->ret)
            retTy = retTy->ret;
        else
            retTy = self.ctx->tyVoid();
        irtypes::IrValue** ops = self.allocOps(nargs + 1);
        ops[0] = callee;
        for (u32 i = 0; i < nargs; i++)
            ops[i + 1] = args[i];
        return self.createInst(irOps::IrOpcode::Call, retTy, ops, nargs + 1, 0, 0);
    }

    irtypes::IrInst* phi(irtypes::IrType* ty, irtypes::IrValue** vals, irtypes::IrBlock** blocks, u32 nincoming)
    {
        // interleave, val, block, val, block, ...
        u32 nops = nincoming * 2;
        irtypes::IrValue** ops = self.allocOps(nops);
        for (u32 i = 0; i < nincoming; i++)
        {
            ops[i * 2] = vals[i];
            ops[i * 2 + 1] = &blocks[i]->base;
        }
        return self.createInst(irOps::IrOpcode::Phi, ty, ops, nops, 0, 0);
    }

    irtypes::IrInst* select(irtypes::IrValue* cond, irtypes::IrValue* t, irtypes::IrValue* f)
    {
        irtypes::IrValue** ops = self.allocOps(3);
        ops[0] = cond;
        ops[1] = t;
        ops[2] = f;
        return self.createInst(irOps::IrOpcode::Select, t->type, ops, 3, 0, 0);
    }

    irtypes::IrValue** allocOps(u32 count)
    {
        return (irtypes::IrValue**)std::mman::alloc<irtypes::IrValue*>((usize)count);
    }

    irtypes::IrInst* createBinary(irOps::IrOpcode op, irtypes::IrValue* l, irtypes::IrValue* r)
    {
        irtypes::IrValue** ops = self.allocOps(2);
        ops[0] = l;
        ops[1] = r;
        return self.createInst(op, l->type, ops, 2, 0, 0);
    }

    irtypes::IrInst* createUnary2(irOps::IrOpcode op, irtypes::IrValue* v)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, v->type, ops, 1, 0, 0);
    }

    irtypes::IrInst* createUnary3(irOps::IrOpcode op, irtypes::IrValue* v, irtypes::IrType* dt)
    {
        irtypes::IrValue** ops = self.allocOps(1);
        ops[0] = v;
        return self.createInst(op, dt, ops, 1, 0, 0);
    }

    irtypes::IrInst* createInst(irOps::IrOpcode op, irtypes::IrType* ty, irtypes::IrValue** ops, u32 nops, u64 icmpP, u64 fcmpP)
    {
        irtypes::IrInst* inst = self.ctx->createInst(op, ty, ops, nops, icmpP, fcmpP);
        if (inst != null)
        {
            // Insert into current block
            if (self.block)
                self.block->addInst(inst);

            // Track users for each operand (before freeing ops)
            for (u32 i = 0; i < nops; i++)
                if (ops[i] != null)
                    ops[i]->addUser(inst);
        }
        // Free the temp ops array now that createInst copied it
        if (ops) std::mman::dealloc<irtypes::IrValue*>(ops);
        return inst;
    }
}