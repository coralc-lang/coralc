pub str irOpcodeStr(IrOpcode op)
{
    str r = irOpcodeStrHelper(op);
    if (!r.isEmpty()) return r;
    str r2 = irOpcodeStrHelper2(op);
    if (!r2.isEmpty()) return r2;
    str r3 = irOpcodeStrHelper3(op);
    if (!r3.isEmpty()) return r3;
    str r4 = irOpcodeStrHelper4(op);
    if (!r4.isEmpty()) return r4;
    str r5 = irOpcodeStrHelper5(op);
    if (!r5.isEmpty()) return r5;
    str r6 = irOpcodeStrHelper6(op);
    if (!r6.isEmpty()) return r6;
    str r7 = irOpcodeStrHelper7(op);
    if (!r7.isEmpty()) return r7;
    str r8 = irOpcodeStrHelper8(op);
    if (!r8.isEmpty()) return r8;
    str r9 = irOpcodeStrHelper9(op);
    if (!r9.isEmpty()) return r9;
    str r10 = irOpcodeStrHelper10(op);
    if (!r10.isEmpty()) return r10;
    str r11 = irOpcodeStrHelper11(op);
    if (!r11.isEmpty()) return r11;
    str r12 = irOpcodeStrHelper12(op);
    if (!r12.isEmpty()) return r12;
    return "unknown";
}

pub str irICmpStr(IrICmpPred p)
{
    switch (p)
    {
        IrICmpPred::Eq => { return "eq"; },
        IrICmpPred::Ne => { return "ne"; },
        IrICmpPred::Slt => { return "slt"; },
        IrICmpPred::Sle => { return "sle"; },
        IrICmpPred::Sgt => { return "sgt"; },
        IrICmpPred::Sge => { return "sge"; },
        IrICmpPred::Ult => { return "ult"; },
        IrICmpPred::Ule => { return "ule"; },
        IrICmpPred::Ugt => { return "ugt"; },
        IrICmpPred::Uge => { return "uge"; },

        else =>  { return "unknown"; }
    }
}

