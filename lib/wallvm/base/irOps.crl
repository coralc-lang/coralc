        IrAtomicRmwOp::Min => { return "min"; },
        IrAtomicRmwOp::UMax => { return "umax"; },
        IrAtomicRmwOp::UMin => { return "umin"; },

        else => { return "unknown"; }
    }
}

pub str irAtomicOrderingStr(IrAtomicOrdering o)
{
    switch (o)
    {
        IrAtomicOrdering::Relaxed => { return "relaxed"; },
        IrAtomicOrdering::Acquire => { return "acquire"; },
        IrAtomicOrdering::Release => { return "release"; },
        IrAtomicOrdering::AcqRel => { return "acq_rel"; },
        IrAtomicOrdering::SeqCst => { return "seq_cst"; },

        else => { return "unknown"; }
    }
}

