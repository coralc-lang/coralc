#[[no_drop_all]]
pub enum IrOpcode
{
    Br, // Terminators
    CondBr,
    Ret,
    Unreachable,
    Noret,

    Neg,  // Unary
    Not,

    Add, // Binary arithmetic
    Sub,
    Mul,
    SDiv,
    UDiv,
    SRem,
    URem,

    And, // Binary bitwise
    Or,
    Xor,
    Shl,
    Ashr,
    Lshr,

    Alloca, // Memory
    Load,
    Store,
    Gep,
    
    Trunc, // Cast
    Zext,
    Sext,
    FpTrunc,
    FpExt,
    FpToSi,
    SiToFp,
    FpToUi,
    UiToFp,
    Bitcast,

    ICmp, // Compare
    FCmp,

    CtPop, // Bit manipulation
    CtLz,
    CtTz,
    Rotl,
    Rotr,
    Bswap,

    SMin, // Integer min/max
    SMax,
    UMin,
    UMax,

    Abs, // Integer abs

    FAdd, // Floating-point
    FSub,
    FMul,
    FDiv,
    Fma,
    FAbs,
    FSqrt,

    VecAdd, // Vector/SIMD
    VecSub,
    VecMul,
    VecDiv,
    VecFAdd,
    VecFSub,
    VecFMul,
    VecFDiv,
    VecMin,
    VecMax,
    VecBroadcast,
    ShuffleVector,
    ExtractElement,
    InsertElement,

    InlineAsm, // Inline assembly

    AtomicLoad, // Atomics
    AtomicStore,
    AtomicRmw,
    AtomicCmpXchg,
    Fence,

    LandingPad, // Exception handling
    ExtractValue,
    InsertValue,

    GcRoot, // GC support
    GcWriteBarrier,
    GcSafepoint,

    Call, // Other
    Phi,
    Select
}

pub enum IrICmpPred
{
    Eq,
    Ne,
    Slt,
    Sle,
    Sgt,
    Sge,
    Ult,
    Ule,
    Ugt,
    Uge
}

pub enum IrFCmpPred
{
    Oeq,
    One,
    Olt,
    Ole,
    Ogt,
    Oge,
    Ueq,
    Une,
    Ult,
    Ule,
    Ugt,
    Uge
}

// Atomic RMW operations
pub enum IrAtomicRmwOp
{
    Xchg,
    Add,
    Sub,
    And,
    Nand,
    Or,
    Xor,
    Max,
    Min,
    UMax,
    UMin
}

// Atomic memory ordering
pub enum IrAtomicOrdering
{
    Relaxed,
    Acquire,
    Release,
    AcqRel,
    SeqCst
}

pub bool irOpcodeIsTerminator(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Br |
        IrOpcode::CondBr |
        IrOpcode::Ret |
        IrOpcode::Unreachable |
        IrOpcode::Noret => { return true; },

        else => { return false; },
    }
}

pub bool irOpcodeIsVector(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::VecAdd |
        IrOpcode::VecSub |
        IrOpcode::VecMul |
        IrOpcode::VecDiv |
        IrOpcode::VecFAdd |
        IrOpcode::VecFSub |
        IrOpcode::VecFMul |
        IrOpcode::VecFDiv |
        IrOpcode::VecMin |
        IrOpcode::VecMax |
        IrOpcode::VecBroadcast |
        IrOpcode::ShuffleVector |
        IrOpcode::ExtractElement |
        IrOpcode::InsertElement => { return true; },
        
        else => { return false; } 
    }
}

pub bool irOpcodeIsAtomic(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::AtomicLoad |
        IrOpcode::AtomicStore |
        IrOpcode::AtomicRmw |
        IrOpcode::AtomicCmpXchg |
        IrOpcode::Fence => { return true; },

        else => { return false; }
    }
}

pub bool irOpcodeIsGc(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::GcRoot |
        IrOpcode::GcWriteBarrier |
        IrOpcode::GcSafepoint => { return true; },

        else => { return false; }
    }
}

pub bool irOpcodeIsBinary(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Add |
        IrOpcode::Sub |
        IrOpcode::Mul |
        IrOpcode::SDiv |
        IrOpcode::UDiv |
        IrOpcode::SRem |
        IrOpcode::URem |
        IrOpcode::And |
        IrOpcode::Or |
        IrOpcode::Xor |
        IrOpcode::Shl |
        IrOpcode::Ashr |
        IrOpcode::Lshr |
        IrOpcode::Rotl |
        IrOpcode::Rotr |
        IrOpcode::SMin |
        IrOpcode::SMax |
        IrOpcode::UMin |
        IrOpcode::UMax |
        IrOpcode::VecAdd |
        IrOpcode::VecSub |
        IrOpcode::VecMul |
        IrOpcode::VecDiv |
        IrOpcode::VecFAdd |
        IrOpcode::VecFSub |
        IrOpcode::VecFMul |
        IrOpcode::VecFDiv |
        IrOpcode::VecMin |
        IrOpcode::VecMax => { return true; },

        else => { return false; }
    }
}

pub bool irOpcodeIsCast(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Trunc |
        IrOpcode::Zext |
        IrOpcode::Sext |
        IrOpcode::FpTrunc |
        IrOpcode::FpExt |
        IrOpcode::FpToSi |
        IrOpcode::SiToFp |
        IrOpcode::FpToUi |
        IrOpcode::UiToFp |
        IrOpcode::Bitcast => { return true; },

        else => { return false; }
    }
}

pub bool irOpcodeIsMemory(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Alloca |
        IrOpcode::Load |
        IrOpcode::Store |
        IrOpcode::Gep |
        IrOpcode::AtomicLoad |
        IrOpcode::AtomicStore => { return true; },
    
        else => { return false; }
    }
}

pub bool irOpcodeIsCommutative(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Add |
        IrOpcode::Mul |
        IrOpcode::And |
        IrOpcode::Or |
        IrOpcode::Xor |
        IrOpcode::SMin |
        IrOpcode::SMax |
        IrOpcode::UMin |
        IrOpcode::UMax => { return true; },
        else => { return false; }
    }
}

// Opcode string names
str irOpcodeStrHelper(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Br => { return "br"; },
        IrOpcode::CondBr => { return "cond_br"; },
        IrOpcode::Ret => { return "ret"; },
        IrOpcode::Unreachable => { return "unreachable"; },
        IrOpcode::Noret => { return "noret"; },

        else => { return ""; }
    }
}

