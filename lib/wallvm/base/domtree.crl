#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock };
import(lib) std::mman { alloc, dealloc };

pub struct IrDomTree
{
    IrBlock** blocks;
    u32 nblocks;
    IrBlock** idoms;
}

// Helper, EVAL operation from Lengauer-Tarjan with path compression.
// Returns the ancestor of v (or v itself) with the minimal semi-dominator.
// The chain is walked up first, then compressed top-down so each label
// comparison uses ancestors whose labels are already final.
u32 _domEval(u32 v, u32 n, u32* ancestor, u32* label, u32* semi, u32* dfn, u32* work)
{
    if (ancestor[v] >= n) return v;
    u32 top = 0;
    u32 x = v;
    while (ancestor[x] < n)
    {
        work[top++] = x;
        x = ancestor[x];
    }
    while (top > 0)
    {
        u32 w = work[--top];
        if (dfn[semi[label[ancestor[w]]]] < dfn[semi[label[w]]])
            label[w] = label[ancestor[w]];
    }
    return label[v];
}

// Lengauer-Tarjan algorithm for computing immediate dominators.
// O(N * alpha(N)) two-pass algorithm.
//
// Phase 1, DFS numbering, build parent/child relationship in DFS tree.
// Phase 2, process vertices in reverse DFS order.
//   - Compute semi-dominator (semi) from predecessors.
//   - Use union-find (ancestor/label) to answer EVAL queries.
//   - Link vertex into forest, process bucket of its parent.
// Phase 3, final pass to set immediate dominators.

pub IrDomTree* irDomtreeNew(IrFunc* func)
{
    if (func == null || func->nblocks == 0) return null;

    u32 n = func->nblocks;

    IrDomTree* dt = alloc<IrDomTree>((usize)1);
    dt->blocks = alloc<IrBlock*>((usize)n);
    dt->idoms = alloc<IrBlock*>((usize)n);
    dt->nblocks = n;

    for (u32 i = 0; i < n; i++)
        dt->blocks[i] = func->blocks[i];

    // arrays indexed by block index
    u32* parent = alloc<u32>((usize)n); // DFS parent
    u32* dfn = alloc<u32>((usize)n); // DFS number (block->index)
    u32* vertex = alloc<u32>((usize)n); // index->block (reverse mapping)
    u32* semi = alloc<u32>((usize)n); // semi-dominator (store block index)
    u32* idom = alloc<u32>((usize)n); // immediate dominator (block index)
    u32* ancestor = alloc<u32>((usize)n); // union-find parent
    u32* label = alloc<u32>((usize)n); // label for EVAL
    u32* bucket = alloc<u32>((usize)n); // bucket head (singly linked list)
    u32* next = alloc<u32>((usize)n); // bucket next pointer

    for (u32 i = 0; i < n; i++)
    {
        parent[i] = n;
        dfn[i] = n;
        vertex[i] = n;
        semi[i] = i;
        idom[i] = n;
        ancestor[i] = n;
        label[i] = i;
        bucket[i] = n;
        next[i] = n;
    }

    // dt->blocks[i] == func->blocks[i] by construction, so indices are
    // their own reverse mapping
    u32* blockIdx = alloc<u32>((usize)n);
    for (u32 i = 0; i < n; i++)
        blockIdx[i] = i;

    u32* revIdx = alloc<u32>((usize)n);
    for (u32 i = 0; i < n; i++) revIdx[i] = n;

    // Iterative DFS from entry (assumes entry is func->blocks[0])
    u32* stack = alloc<u32>((usize)n);
    u32* state = alloc<u32>((usize)n); // 0=unvisited, 1=in-stack, 2=processed
    for (u32 i = 0; i < n; i++) state[i] = 0;

    u32 time = 0;
    u32 sp = 0;
    stack[sp++] = 0;
    state[0] = 1;

    while (sp > 0)
    {
        u32 cur = stack[sp - 1];

        if (state[cur] == 1)
        {
            // First visit, assign DFS number
            state[cur] = 2;
            dfn[cur] = time;
            vertex[time] = cur;
            revIdx[cur] = cur;
            time++;

            IrBlock* curBlock = func->blocks[cur];
            for (u32 j = 0; j < curBlock->nsuccs; j++)
            {
                IrBlock* succBlock = curBlock->succs[j];
                u32 succ = n;
                // Find succ index in func->blocks
                for (u32 k = 0; k < n; k++)
                    if (func->blocks[k] == succBlock) { succ = k; break; }

                if (succ < n && state[succ] == 0)
                {
                    parent[succ] = cur;
                    state[succ] = 1;
                    stack[sp++] = succ;
                }
            }
        }
        else
        {
            sp--;
        }
    }

    // Iterate vertices in reverse DFS order
    for (u32 wIdx = time - 1; wIdx > 0; wIdx--)
    {
        u32 w = vertex[wIdx]; // block index

        // Step 1, compute semi-dominator of w
        IrBlock* wBlock = func->blocks[blockIdx[w]];
        semi[w] = parent[w]; // default semi = parent in DFS tree

        for (u32 j = 0; j < wBlock->npreds; j++)
        {
            IrBlock* vBlock = wBlock->preds[j];
            u32 v = n;
            for (u32 k = 0; k < n; k++)
                if (func->blocks[k] == vBlock) { v = k; break; }
            if (v >= n) continue;

            u32 u;
            if (dfn[v] <= dfn[w])
            {
                u = v; // v is an ancestor of w
            }
            else
            {
                // EVAL(v), find ancestor of v with minimal semi
                u = _domEval(v, n, ancestor, label, semi, dfn, stack);
            }

            if (dfn[semi[u]] < dfn[semi[w]])
                semi[w] = semi[u];
        }

        // Step 2, add w to bucket of semi(w)
        next[w] = bucket[semi[w]];
        bucket[semi[w]] = w;

        // Step 3, LINK(parent[w], w), w becomes child of parent[w]
        ancestor[w] = parent[w];
        label[w] = w;

        // Step 4, process bucket of parent[w]
        u32 v = bucket[parent[w]];
        while (v < n)
        {
            // EVAL(v) with COMPRESS
            u32 uEval = _domEval(v, n, ancestor, label, semi, dfn, stack);

            if (dfn[semi[uEval]] < dfn[semi[v]])
                idom[v] = uEval;
            else
                idom[v] = parent[w];

            u32 tmp = next[v];
            v = tmp;
        }
        bucket[parent[w]] = n;
    }

    // Phase 3, final pass, set idom
    for (u32 wIdx = 1; wIdx < time; wIdx++)
    {
        u32 w = vertex[wIdx];
        if (idom[w] != semi[w])
            idom[w] = idom[idom[w]];
    }
    idom[0] = 0; // entry dominates itself

    // Convert block indices to IrBlock pointers
    for (u32 i = 0; i < n; i++)
    {
        if (i == 0)
            dt->idoms[i] = func->blocks[blockIdx[0]];
        else if (idom[i] < n)
            dt->idoms[i] = func->blocks[blockIdx[idom[i]]];
        else
            dt->idoms[i] = null;
    }

    // Cleanup
    dealloc<u32>(stack);
    dealloc<u32>(state);
    dealloc<u32>(blockIdx);
    dealloc<u32>(parent);
    dealloc<u32>(dfn);
    dealloc<u32>(vertex);
    dealloc<u32>(semi);
    dealloc<u32>(idom);
    dealloc<u32>(ancestor);
    dealloc<u32>(label);
    dealloc<u32>(bucket);
    dealloc<u32>(next);
    dealloc<u32>(revIdx);

    return dt;
}

pub void irDomtreeFree(IrDomTree* dt)
{
    if (dt == null) return;
    if (dt->blocks != null) dealloc<IrBlock*>(dt->blocks);
    if (dt->idoms != null) dealloc<IrBlock*>(dt->idoms);
    dealloc<IrDomTree>(dt);
}

pub IrBlock* irDomtreeIdom(IrDomTree* dt, IrBlock* bb)
{
    if (dt == null || bb == null) return null;
    for (u32 i = 0; i < dt->nblocks; i++)
    {
        if (dt->blocks[i] == bb)
            return dt->idoms[i];
    }
    return null;
}

pub bool irDomtreeDominates(IrDomTree* dt, IrBlock* a, IrBlock* b)
{
    if (dt == null || a == null || b == null) return false;
    if (a == b) return true;
    // The idom chain of the root is the root itself, so walks from a
    // self-dominated block must be bounded or they would never terminate.
    u32 guard = 0;
    IrBlock* current = irDomtreeIdom(dt, b);
    while (current != null && guard <= dt->nblocks)
    {
        if (current == a) return true;
        current = irDomtreeIdom(dt, current);
        guard++;
    }
    return false;
}

pub u32 irDomtreeLevel(IrDomTree* dt, IrBlock* bb)
{
    u32 level = 0;
    u32 guard = 0;
    IrBlock* current = irDomtreeIdom(dt, bb);
    while (current != null && guard <= dt->nblocks)
    {
        level++;
        guard++;
        IrBlock* nxt = irDomtreeIdom(dt, current);
        if (nxt == current) break;
        current = nxt;
    }
    return level;
}
