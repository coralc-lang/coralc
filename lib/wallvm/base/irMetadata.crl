#[[no_drop_all]]
import irtypes { IrValue, IrType, IrFunc, IrInst, IrGlobal, IrStringConst };
import(lib) std::mman { alloc, dealloc };

str dupStr(str s)
{
    u8* b = alloc<u8>((usize)(s.len + 1));
    for (usize i = 0; i < s.len; i++) b[i] = s.ptr[i];
    b[s.len] = 0;
    return str::fromParts((const u8*)b, s.len);
}

pub enum MetadataKind
{
    DebugInfo,
    Profiling,
    Alignment,
    NoAlias,
    NoCapture,
    NoFree,
    NoUnwind,
    ReadNone,
    ReadOnly,
    WriteOnly,
    InlineHint,
    VectorWidth,
    LoopInfo,
    Range,
    BranchWeights,
    Custom
}

// which payload fields are live — without this an empty string and a zero
// int are indistinguishable, and the printer cannot round-trip either
pub enum MetadataValueKind
{
    Int,
    Float,
    Bool,
    String,
    IRValue,
    Type
}

pub struct MetadataValue
{
    MetadataKind kind;
    usize intVal;
    str strVal;
    IrValue* irVal;
    f64 floatVal;
    MetadataValueKind vkind;
    IrType* typeVal;
}

pub struct MetadataEntry
{
    str key;
    MetadataValue value;
}

pub struct MetadataSet
{
    MetadataEntry* entries;
    u32 numEntries;
    u32 capEntries;
}

pub MetadataSet newMetadataSet()
{
    return MetadataSet {
        .entries = null,
        .numEntries = 0,
        .capEntries = 0
    };
}

pub void addInt(MetadataSet* self, str key, usize val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = val;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Int;
    e->value.typeVal = null;
}

pub void addString(MetadataSet* self, str key, str val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    // val's ownership transfers to the set — callers hand over heap buffers
    e->value.strVal = val;
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::String;
    e->value.typeVal = null;
}

pub void addIRValue(MetadataSet* self, str key, IrValue* val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = val;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::IRValue;
    e->value.typeVal = null;
}

pub void addFloat(MetadataSet* self, str key, f64 val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = val;
    e->value.vkind = MetadataValueKind::Float;
    e->value.typeVal = null;
}

pub void addBool(MetadataSet* self, str key, bool val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = val ? 1 : 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Bool;
    e->value.typeVal = null;
}

pub void addType(MetadataSet* self, str key, IrType* val)
{
    if (self.numEntries >= self.capEntries)
    {
        u32 newCap = self.capEntries ? self.capEntries * 2 : 8;
        MetadataEntry* newEntries = alloc<MetadataEntry>((usize)newCap);
        for (u32 i = 0; i < self.numEntries; i++)
            newEntries[i] = self.entries[i];
        if (self.entries) dealloc<MetadataEntry>(self.entries);
        self.entries = newEntries;
        self.capEntries = newCap;
    }

    MetadataEntry* e = &self.entries[self.numEntries++];
    e->key = dupStr(key);
    e->value.kind = MetadataKind::Custom;
    e->value.intVal = 0;
    e->value.strVal = str::empty();
    e->value.irVal = null;
    e->value.floatVal = 0;
    e->value.vkind = MetadataValueKind::Type;
    e->value.typeVal = val;
}

pub MetadataEntry* find(MetadataSet* self, str key)
{
    for (u32 i = 0; i < self.numEntries; i++)
    {
        if (self.entries[i].key.equals(key))
            return &self.entries[i];
    }
    return null;
}

pub void metadataSetFree(MetadataSet* self)
{
    for (u32 i = 0; i < self.numEntries; i++)
    {
        MetadataEntry* e = &self.entries[i];
        if (e->key.ptr) dealloc<u8>((u8*)e->key.ptr);
        if (e->value.vkind == MetadataValueKind::String && e->value.strVal.ptr)
            dealloc<u8>((u8*)e->value.strVal.ptr);
    }
    if (self.entries) dealloc<MetadataEntry>(self.entries);
    self.entries = null;
    self.numEntries = 0;
    self.capEntries = 0;
}

pub struct DebugLocation
{
    str filename;
    u32 line;
    u32 column;
    str scope;
}

pub struct DebugFuncInfo
{
    str name;
    str linkageName;
    DebugLocation loc;
    IrType* type;
}

pub struct DebugVarInfo
{
    str name;
    str linkageName;
    DebugLocation loc;
    IrType* type;
    IrValue* address;
}

pub struct MetadataStore
{
    MetadataSet* funcMetadata;
    u32 numFuncs;
    u32 capFuncs;

    MetadataSet* instMetadata;
    u32 numInsts;
    u32 capInsts;

    DebugFuncInfo* funcDebugInfo;
    DebugVarInfo* varDebugInfo;
    u32 numVars;
    u32 capVars;
}

static MetadataStore gMetadataStore;

pub void metadataInit()
{
    MetadataStore* s = &gMetadataStore;
    s->funcMetadata = null;
    s->numFuncs = 0;
    s->capFuncs = 0;
    s->instMetadata = null;
    s->numInsts = 0;
    s->capInsts = 0;
    s->funcDebugInfo = null;
    s->varDebugInfo = null;
    s->numVars = 0;
    s->capVars = 0;
}

pub void metadataShutdown()
{
    MetadataStore* s = &gMetadataStore;
    for (u32 i = 0; i < s.numFuncs; i++)
        metadataSetFree(&s.funcMetadata[i]);
    if (s.funcMetadata) dealloc<MetadataSet>(s.funcMetadata);

    for (u32 i = 0; i < s.numInsts; i++)
        metadataSetFree(&s.instMetadata[i]);
    if (s.instMetadata) dealloc<MetadataSet>(s.instMetadata);

    if (s.funcDebugInfo) dealloc<DebugFuncInfo>(s.funcDebugInfo);
    if (s.varDebugInfo) dealloc<DebugVarInfo>(s.varDebugInfo);
}

// Attach metadata to a function — the set rides on the function itself so
// printers and passes can find it again (the old global side table was
// write-only: nothing could ever map a set back to its owner)
pub MetadataSet* attachFuncMetadata(IrFunc* func)
{
    if (!func) return null;
    if (!func->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        func->metadata = md;
    }
    return (MetadataSet*)func->metadata;
}

pub MetadataSet* attachInstMetadata(IrInst* inst)
{
    if (!inst) return null;
    if (!inst->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        inst->metadata = md;
    }
    return (MetadataSet*)inst->metadata;
}

pub MetadataSet* attachGlobalMetadata(IrGlobal* g)
{
    if (!g) return null;
    if (!g->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        g->metadata = md;
    }
    return (MetadataSet*)g->metadata;
}

pub MetadataSet* attachStringMetadata(IrStringConst* sc)
{
    if (!sc) return null;
    if (!sc->metadata)
    {
        MetadataSet* md = alloc<MetadataSet>((usize)1);
        *md = newMetadataSet();
        sc->metadata = md;
    }
    return (MetadataSet*)sc->metadata;
}

pub void setDebugLocation(IrInst* inst, str file, u32 line, u32 col)
{
    MetadataSet* md = attachInstMetadata(inst);
    addString(md, "debug.file", file);
    addInt(md, "debug.line", (usize)line);
    addInt(md, "debug.col", (usize)col);
}

pub void setAlignment(IrInst* inst, u32 align)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "alignment", (usize)align);
}

pub void setNoAlias(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "noalias", 1);
}

pub void setNoCapture(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "nocapture", 1);
}

pub void setReadOnly(IrInst* inst)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "readonly", 1);
}

pub void setInlineHint(IrInst* inst, u32 hint)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "inlinehint", (usize)hint);
}

pub void setBranchWeights(IrInst* inst, u32 trueWeight, u32 falseWeight)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "weight.true", (usize)trueWeight);
    addInt(md, "weight.false", (usize)falseWeight);
}

pub void setRange(IrInst* inst, isize min, isize max)
{
    MetadataSet* md = attachInstMetadata(inst);
    addInt(md, "range.min", (usize)min);
    addInt(md, "range.max", (usize)max);
}

pub MetadataSet* getInstMetadata(IrInst* inst)
{
    if (!inst) return null;
    return (MetadataSet*)inst->metadata;
}