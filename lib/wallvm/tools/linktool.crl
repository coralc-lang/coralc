#[[no_drop_all]]
import(lib) wallvm::linker::x86::link { Config, Arch, configFor, Linker };
import(lib) std::text::string { String };
import(lib) std::io::ios { println, eprintln };
import(lib) wallvm::linker::x86::elf { FMT_ELF_EXE, FMT_PE_EXE };

i32 main(i32 argc, cchar** argv)
{
    if (argc < 4)
    {
        eprintln("usage: linktool <entry> <out> [elf|coff] <in>...");
        return 2;
    }
    Config cfg = configFor(Arch::X86_64);
    cfg.entry = str::fromCstr(argv[1]);
    i32 first = 3;
    if (argc > 3 && str::fromCstr(argv[3]).equals("coff"))
    {
        cfg.outFmt = FMT_PE_EXE;
        first = 4;
    }
    else if (argc > 3 && str::fromCstr(argv[3]).equals("elf"))
    {
        cfg.outFmt = FMT_ELF_EXE;
        first = 4;
    }
    Linker lk = Linker::new(cfg);
    String err = String::new();
    for (i32 i = first; i < argc; i++)
    {
        str p = str::fromCstr(argv[i]);
        if (!lk.addObjectFile(p, &err))
        {
            eprintln("add {}: {}", p, err.asView());
            err.free();
            lk.dispose();
            return 1;
        }
    }
    if (!lk.write(str::fromCstr(argv[2]), &err))
    {
        eprintln("link: {}", err.asView());
        err.free();
        lk.dispose();
        return 1;
    }
    println("linked {}", str::fromCstr(argv[2]));
    err.free();
    lk.dispose();
    return 0;
}
