#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import(lib) wallvm::irOps { IrOpcode, IrICmpPred, IrFCmpPred };
import(lib) std::mman { copy };

// Redundant Branch Inversion Flattening
// Detects sequential conditional checks that evaluate overlapping or inverse
// predicates and replaces the second branch with an unconditional jump.

pub bool irPassBranchInversionFlat(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (func == null || func->isExtern) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        if (bb->ninsts < 2) continue;

        // Get the last two instructions
        IrInst* last = bb->insts[bb->ninsts - 1];
        IrInst* prev = bb->insts[bb->ninsts - 2];

        if (prev->opcode != IrOpcode::CondBr) continue;
        if (last->opcode != IrOpcode::CondBr) continue;

        if (prev->nops >= 3 && last->nops >= 3)
        {
            // Same targets, remove second condbr
            if (prev->ops[1] == last->ops[1] && prev->ops[2] == last->ops[2])
            {
                if (prev->ops[0] == last->ops[0])
                {
                    last->ops[0]->removeUser(last);
                    last->ops[1]->removeUser(last);
                    last->ops[2]->removeUser(last);
                    IrInst* brInst = ctx->createInst(
                        IrOpcode::Br, ctx->tyVoid(), &last->ops[1], 1, 0, 0);
                    last->ops[1]->addUser(brInst);
                    bb->insts[bb->ninsts - 1] = brInst;
                    brInst->parent = bb;
                    changed = true;
                    last = bb->insts[bb->ninsts - 1];
                }
            }

            // Inverse targets, condbr always takes true branch
            if (prev->ops[1] == last->ops[2] && prev->ops[2] == last->ops[1])
            {
                if (prev->ops[0] == last->ops[0])
                {
                    last->ops[0]->removeUser(last);
                    last->ops[1]->removeUser(last);
                    last->ops[2]->removeUser(last);
                    IrInst* brInst = ctx->createInst(
                        IrOpcode::Br, ctx->tyVoid(), &last->ops[2], 1, 0, 0);
                    last->ops[2]->addUser(brInst);
                    bb->insts[bb->ninsts - 1] = brInst;
                    brInst->parent = bb;
                    changed = true;
                    last = bb->insts[bb->ninsts - 1];
                }
            }
        }

        // Fold ICmp with constant operands
        if (prev->opcode == IrOpcode::ICmp && last->nops >= 3)
        {
            if (last->ops[0] == &prev->base && prev->nops >= 2 &&
                prev->ops[0] != null && prev->ops[1] != null &&
                prev->ops[0]->kind == IrValueKind::ConstInt &&
                prev->ops[1]->kind == IrValueKind::ConstInt)
            {
                i64 a = (i64)prev->ops[0]->valData;
                i64 b = (i64)prev->ops[1]->valData;
                bool result = false;
                
                #[[fallthrough]]
                switch (prev->icmpPred)
                {
                    IrICmpPred::Eq => { result = (a == b); },
                    IrICmpPred::Ne => { result = (a != b); },
                    IrICmpPred::Slt => { result = (a < b); },
                    IrICmpPred::Sle => { result = (a <= b); },
                    IrICmpPred::Sgt => { result = (a > b); },
                    IrICmpPred::Sge => { result = (a >= b); },
                    IrICmpPred::Ult => { result = ((u64)a < (u64)b); },
                    IrICmpPred::Ule => { result = ((u64)a <= (u64)b); },
                    IrICmpPred::Ugt => { result = ((u64)a > (u64)b); },
                    IrICmpPred::Uge => { result = ((u64)a >= (u64)b); }
                }
                IrValue* target = result ? last->ops[1] : last->ops[2];
                last->ops[0]->removeUser(last);
                last->ops[1]->removeUser(last);
                last->ops[2]->removeUser(last);
                IrInst* brInst = ctx->createInst(
                    IrOpcode::Br, ctx->tyVoid(), &target, 1, 0, 0);
                target->addUser(brInst);
                bb->insts[bb->ninsts - 1] = brInst;
                brInst->parent = bb;
                changed = true;
            }
        }

        // Fold FCmp with constant operands
        if (prev->opcode == IrOpcode::FCmp && last->nops >= 3)
        {
            if (last->ops[0] == &prev->base && prev->nops >= 2 &&
                prev->ops[0] != null && prev->ops[1] != null &&
                prev->ops[0]->kind == IrValueKind::ConstFloat &&
                prev->ops[1]->kind == IrValueKind::ConstFloat)
            {
                f64 a, b;
                copy<f64>(&a, (f64*)&prev->ops[0]->valData, 1);
                copy<f64>(&b, (f64*)&prev->ops[1]->valData, 1);
                bool result = false;

                #[[fallthrough]]
                switch (prev->fcmpPred)
                {
                    IrFCmpPred::Oeq => { result = (a == b); },
                    IrFCmpPred::One => { result = (a != b); },
                    IrFCmpPred::Olt => { result = (a < b); },
                    IrFCmpPred::Ole => { result = (a <= b); },
                    IrFCmpPred::Ogt => { result = (a > b); },
                    IrFCmpPred::Oge => { result = (a >= b); },
                }
                IrValue* target = result ? last->ops[1] : last->ops[2];
                last->ops[0]->removeUser(last);
                last->ops[1]->removeUser(last);
                last->ops[2]->removeUser(last);
                IrInst* brInst = ctx->createInst(
                    IrOpcode::Br, ctx->tyVoid(), &target, 1, 0, 0);
                target->addUser(brInst);
                bb->insts[bb->ninsts - 1] = brInst;
                brInst->parent = bb;
                changed = true;
            }
        }
    }

    return changed;
}
