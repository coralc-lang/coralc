#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock };
import(lib) wallvm::domtree { IrDomTree, irDomtreeNew, irDomtreeDominates, irDomtreeFree };
import(lib) std::mman { alloc, dealloc };

pub struct IrLoop
{
    IrBlock* header;
    IrBlock** blocks;
    u32 nblocks;
    IrBlock* preheader;
    IrBlock* latch;
}

pub IrLoop** irDetectLoops(IrFunc* func, IrDomTree* dt)
{
    bool ownDt = false;
    if (dt == null)
    {
        dt = irDomtreeNew(func);
        ownDt = true;
    }
    if (dt == null) return null;

    u32 n = func->nblocks;
    IrLoop** loops = alloc<IrLoop*>((usize)n + 1);
    u32 nloops = 0;

    for (u32 ai = 1; ai < n; ai++)
    {
        IrBlock* latch = func->blocks[ai];
        for (u32 sj = 0; sj < latch->nsuccs; sj++)
        {
            IrBlock* header = latch->succs[sj];
            if (header == latch) continue;
            if (!irDomtreeDominates(dt, header, latch)) continue;

            bool dup = false;
            for (u32 li = 0; li < nloops; li++)
            {
                if (loops[li]->header == header && loops[li]->latch == latch)
                { dup = true; break; }
            }
            if (dup) continue;

            u32 headerIdx = n;
            u32 latchIdx = n;
            for (u32 i = 0; i < n; i++)
            {
                if (func->blocks[i] == header) headerIdx = i;
                if (func->blocks[i] == latch) latchIdx = i;
            }

            bool* inLoop = alloc<bool>((usize)n);
            for (u32 i = 0; i < n; i++) inLoop[i] = false;
            inLoop[headerIdx] = true;
            u32 count = 1;

            u32* stack = alloc<u32>((usize)n);
            u32 sp = 0;
            if (latchIdx != headerIdx)
            {
                stack[sp++] = latchIdx;
                inLoop[latchIdx] = true;
                count++;
            }

            while (sp > 0)
            {
                u32 curIdx = stack[--sp];
                IrBlock* curBlock = func->blocks[curIdx];
                for (u32 pj = 0; pj < curBlock->npreds; pj++)
                {
                    IrBlock* pred = curBlock->preds[pj];
                    u32 predIdx = n;
                    for (u32 i = 0; i < n; i++)
                        if (func->blocks[i] == pred) { predIdx = i; break; }
                    if (predIdx >= n || predIdx == headerIdx || inLoop[predIdx])
                        continue;
                    inLoop[predIdx] = true;
                    count++;
                    stack[sp++] = predIdx;
                }
            }

            IrBlock** blocks = alloc<IrBlock*>((usize)count);
            #[[maybe_unused]] u32 bi = 0;
            for (u32 i = 0; i < n; i++)
                if (inLoop[i])
                    blocks[bi++] = func->blocks[i];

            IrLoop* lp = alloc<IrLoop>((usize)1);
            lp->header = header;
            lp->blocks = blocks;
            lp->nblocks = count;
            lp->preheader = null;
            lp->latch = latch;
            loops[nloops++] = lp;

            dealloc<bool>(inLoop);
            dealloc<u32>(stack);
        }
    }

    loops[nloops] = null;

    if (ownDt) irDomtreeFree(dt);
    return loops;
}

pub IrLoop** irLoopDetectNatural(IrFunc* func)
{
    IrDomTree* dt = irDomtreeNew(func);
    IrLoop** loops = irDetectLoops(func, dt);
    irDomtreeFree(dt);
    return loops;
}
