#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock, IrInst, IrType, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };

// Redundant Type Cast and Extension Elimination
// Eliminates nested, redundant casting operations.

enum CastKind
{
    Identity,
    Trunc,
    Zext,
    Sext,
    FpTrunc,
    FpExt,
    IntToFp,
    FpToInt,
    Unknown
}

CastKind classifyCast(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Bitcast => { return CastKind::Identity; },
        IrOpcode::Trunc => { return CastKind::Trunc; },
        IrOpcode::Zext => { return CastKind::Zext; },
        IrOpcode::Sext => { return CastKind::Sext; },
        IrOpcode::FpTrunc => { return CastKind::FpTrunc; },
        IrOpcode::FpExt => { return CastKind::FpExt; },
        IrOpcode::SiToFp => { return CastKind::IntToFp; },
        IrOpcode::FpToSi => { return CastKind::FpToInt; },
        IrOpcode::FpToUi => { return CastKind::FpToInt; },
        IrOpcode::UiToFp => { return CastKind::IntToFp; },
        else => { return CastKind::Unknown; },
    }
}

pub bool irPassCastElimination(IrFunc* func, rawptr userdata)
{
    if (func == null || func->isExtern) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            CastKind outerKind = classifyCast(inst->opcode);
            if (outerKind == CastKind::Unknown) continue;
            if (inst->nops < 1 || inst->ops[0] == null) continue;

            // Pattern 9, cast to same type, no-op
            if (outerKind == CastKind::Identity)
            {
                IrType* inputTy = inst->ops[0]->type;
                IrType* outputTy = inst->base.type;
                if (inputTy != null && outputTy != null && inputTy == outputTy)
                {
                    // Intentional null-out, the cleanup loop below compacts the block
                    bb->insts[ii] = null;
                    changed = true;
                }
            }

            // Patterns involving inner cast
            if (inst->ops[0]->kind == IrValueKind::Inst)
            {
                IrInst* inner = (IrInst*)inst->ops[0];
                CastKind innerKind = classifyCast(inner->opcode);
                if (inner->nops < 1 || inner->ops[0] == null) continue;

                // Pattern 8, two identical casts
                // I hand over the instruction itself, the old file wrote &inst
                // and that spelling would now name the pointer variable.
                if (innerKind == outerKind && innerKind != CastKind::Unknown)
                {
                    IrType* innerIn = inner->ops[0]->type;
                    IrType* outerOut = inst->base.type;
                    if (innerIn != null && outerOut != null && innerIn->width == outerOut->width)
                    {
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        inst->base.type = outerOut;
                        changed = true;
                    }
                }

                // Pattern 2, trunc(zext(x)) or trunc(sext(x))
                if (outerKind == CastKind::Trunc &&
                    (innerKind == CastKind::Zext || innerKind == CastKind::Sext))
                {
                    IrType* origTy = inner->ops[0]->type;
                    IrType* outerOut = inst->base.type;
                    if (origTy != null && outerOut != null && origTy->width == outerOut->width)
                    {
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        inst->base.type = outerOut;
                        changed = true;
                    }
                }

                // Pattern 3/4, zext(sext(x)) or sext(zext(x))
                if ((outerKind == CastKind::Zext || outerKind == CastKind::Sext) &&
                    (innerKind == CastKind::Zext || innerKind == CastKind::Sext))
                {
                    IrType* innerOut = inner->base.type;
                    IrType* outerOut = inst->base.type;
                    if (innerOut != null && outerOut != null && innerOut->width == outerOut->width)
                    {
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        inst->base.type = outerOut;
                        changed = true;
                    }
                }

                // Pattern 5/6, fpext(fptrunc(x)) or fptrunc(fpext(x))
                if ((outerKind == CastKind::FpExt || outerKind == CastKind::FpTrunc) &&
                    (innerKind == CastKind::FpExt || innerKind == CastKind::FpTrunc))
                {
                    IrType* innerOut = inner->base.type;
                    IrType* outerOut = inst->base.type;
                    if (innerOut != null && outerOut != null && innerOut->width == outerOut->width)
                    {
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        inst->base.type = outerOut;
                        changed = true;
                    }
                }

                // Pattern 7, sitofp(fptosi(x)) or fptosi(sitofp(x))
                if ((outerKind == CastKind::IntToFp && innerKind == CastKind::FpToInt) ||
                    (outerKind == CastKind::FpToInt && innerKind == CastKind::IntToFp))
                {
                    IrType* origTy = inner->ops[0]->type;
                    IrType* outerOut = inst->base.type;
                    if (origTy != null && outerOut != null && origTy->width == outerOut->width)
                    {
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        inst->base.type = outerOut;
                        changed = true;
                    }
                }

                // Pattern 10, bitcast of bitcast, no-op
                if (outerKind == CastKind::Identity &&
                    inner->opcode == IrOpcode::Bitcast)
                {
                    inner->base.removeUser(inst);
                    inst->ops[0] = inner->ops[0];
                    inst->ops[0]->addUser(inst);
                    changed = true;
                }

                // Pattern 11, trunc(trunc(x)) -> trunc(x) when inner output width >= outer output width
                if (outerKind == CastKind::Trunc && innerKind == CastKind::Trunc)
                {
                    u32 innerOutW = inner->base.type != null ? inner->base.type->width : 64;
                    u32 outerOutW = inst->base.type != null ? inst->base.type->width : 64;
                    if (innerOutW >= outerOutW)
                    {
                        // Inner trunc already narrows to >= outer width, so it's redundant
                        inner->base.removeUser(inst);
                        inst->ops[0] = inner->ops[0];
                        inst->ops[0]->addUser(inst);
                        changed = true;
                    }
                }
            }
        }

        // Remove null instructions
        u32 writeIdx = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            if (bb->insts[i] != null)
            {
                bb->insts[writeIdx] = bb->insts[i];
                writeIdx++;
            }
        }
        bb->ninsts = writeIdx;
    }

    return changed;
}
