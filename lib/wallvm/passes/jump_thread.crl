#[[no_drop_all]]
import wallvm::irtypes { IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrVarDebugInfo };
import wallvm::irOps { IrOpcode };
import std::mman { dealloc };

void freeInst(IrInst* inst)
{
    for (u32 i = 0; i < inst->nops; i++)
        if (inst->ops[i] != null)
            inst->ops[i]->removeUser(inst);
    if (inst->capOps > 0) dealloc<IrValue*>(inst->ops);
    if (inst->base.capUsers > 0) dealloc<IrInst*>(inst->base.users);
    if (inst->debugLoc.file.ptr != null) dealloc<u8>((u8*)inst->debugLoc.file.ptr);
    if (inst->varDbg != null)
    {
        for (u32 i = 0; i < inst->nvarDbg; i++)
            if (inst->varDbg[i].varName.ptr != null)
                dealloc<u8>((u8*)inst->varDbg[i].varName.ptr);
        dealloc<IrVarDebugInfo>(inst->varDbg);
    }
    dealloc<IrInst>(inst);
}

// Jump threading, when a branch target is a block that only contains another
// branch with a known condition, thread through to the final destination.
// Also removes dead blocks that become unreachable after threading.
pub struct JumpThreadPass
{
    u64 threads;

    static JumpThreadPass new()
    {
        return JumpThreadPass {
            .threads = 0
        };
    }

    void removePhiEdge(IrBlock* target, IrBlock* pred)
    {
        if (target == null || pred == null) return;
        for (u32 i = 0; i < target->ninsts; i++)
        {
            IrInst* phi = target->insts[i];
            if (phi->opcode != IrOpcode::Phi) continue;
            u32 j = 0;
            while (j + 1 < phi->nops)
            {
                if (phi->ops[j + 1] != &pred->base) { j += 2; continue; }
                if (phi->ops[j] != null) phi->ops[j]->removeUser(phi);
                phi->ops[j + 1]->removeUser(phi);
                for (u32 k = j; k + 2 < phi->nops; k++)
                    phi->ops[k] = phi->ops[k + 2];
                phi->nops -= 2;
            }
        }
    }

    void replacePhiBlock(IrBlock* block, IrBlock* from, IrBlock* to)
    {
        if (block == null || from == null || to == null) return;
        for (u32 i = 0; i < block->ninsts; i++)
        {
            IrInst* phi = block->insts[i];
            if (phi->opcode != IrOpcode::Phi) continue;
            for (u32 j = 1; j < phi->nops; j += 2)
            {
                if (phi->ops[j] != &from->base) continue;
                from->base.removeUser(phi);
                to->base.addUser(phi);
                phi->ops[j] = &to->base;
            }
        }
    }

    void removeBlock(IrFunc* func, IrBlock* block, u32 at)
    {
        if (func == null || block == null) return;
        func->removeBlock(block);
        if (at < func->nblocks) return;
    }

    bool run(IrFunc* func)
    {
        self.threads = 0;
        #[[maybe_unused]] bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (bb->ninsts == 0) continue;

            IrInst* term = bb->insts[bb->ninsts - 1];

            // Pattern 1, unconditional br to a block that has only a single successor
            if (term->opcode == IrOpcode::Br && term->nops == 1)
            {
                IrBlock* target = (IrBlock*)term->ops[0];
                // `npreds == 1` matters: this pattern empties `target`, so any
                // predecessor other than bb would keep branching into a block
                // that no longer has a terminator. Same guard tail_dup uses.
                if (target != bb && target->ninsts >= 1 &&
                    target->parent == func && target->npreds == 1)
                {
                    IrInst* targetTerm = target->insts[target->ninsts - 1];

                    // If target has no side effects (only simple ops) and ends with br
                    if (targetTerm->opcode == IrOpcode::Br && targetTerm->nops == 1 &&
                        target != (IrBlock*)targetTerm->ops[0])
                    {
                        IrBlock* finalTarget = (IrBlock*)targetTerm->ops[0];
                        // Thread, bb -> finalTarget
                        if (finalTarget != bb && target->hasNoSideEffects())
                        {
                            // target has a single pred (bb), so every phi on it
                            // has exactly one incoming pair naming bb: it is a
                            // copy. Bail if the shape says otherwise — moving
                            // phis along with the block's contents (the old
                            // behavior) landed them after non-phi instructions
                            // and left pairs naming gutted blocks, which
                            // corrupted the unrolled loops.
                            bool phiOk = true;
                            for (u32 si = 0; si + 1 < target->ninsts && phiOk; si++)
                            {
                                IrInst* ph = target->insts[si];
                                if (ph->opcode != IrOpcode::Phi) continue;
                                if (ph->nops != 2 || ph->ops[1] != &bb->base)
                                    phiOk = false;
                            }
                            if (phiOk)
                            {
                                // Move target's non-terminator instructions into bb
                                for (u32 si = 0; si + 1 < target->ninsts; si++)
                                {
                                    IrInst* si2 = target->insts[si];

                                    if (si2->opcode == IrOpcode::Phi)
                                    {
                                        // Single-pred phi: every use sees the one
                                        // incoming value — fold it to that value
                                        // instead of moving it.
                                        IrValue* v = si2->ops[0];
                                        while (si2->base.nusers > 0)
                                        {
                                            IrInst* u = si2->base.users[0];
                                            for (u32 oi = 0; oi < u->nops; oi++)
                                            {
                                                if (u->ops[oi] != &si2->base) continue;
                                                if (v != null) v->addUser(u);
                                                u->ops[oi] = v;
                                            }
                                            si2->base.removeUser(u);
                                        }
                                        freeInst(si2);
                                        continue;
                                    }

                                    si2->parent = bb;
                                    bb->insertBefore(si2, term);
                                }
                                // Rewrite PHI incoming block refs in finalTarget that
                                // named the target we are about to gut
                                self.replacePhiBlock(finalTarget, target, bb);

                                target->ninsts = 0;
                                func->removeBlock(target);

                                // Update terminator, use block's existing operand slot
                                // to avoid dangling pointer to stack local
                                term->ops[0]->removeUser(term);
                                finalTarget->base.addUser(term);
                                term->ops[0] = &finalTarget->base;

                                target->removePred(bb);
                                finalTarget->removePred(target);
                                target->removeSucc(finalTarget);
                                bb->removeSucc(target);
                                bb->addSucc(finalTarget);
                                self.threads++;
                                changed = true;
                            }
                        }
                    }
                }
            }

            // Pattern 2, condbr with known constant condition, thread through
            if (term->opcode == IrOpcode::CondBr && term->nops >= 3)
            {
                IrValue* cond = term->ops[0];
                if (cond->kind == IrValueKind::ConstInt)
                {
                    IrBlock* taken = (cond->valData != 0) ?
                        (IrBlock*)term->ops[1] : (IrBlock*)term->ops[2];
                    IrBlock* notTaken = (cond->valData != 0) ?
                        (IrBlock*)term->ops[2] : (IrBlock*)term->ops[1];

                    // Replace condbr with br to taken
                    term->ops[0]->removeUser(term);
                    term->ops[(cond->valData != 0) ? 2 : 1]->removeUser(term);
                    if (notTaken != taken)
                    {
                        self.removePhiEdge(notTaken, bb);
                        notTaken->removePred(bb);
                    }

                    // Rewrite in place using existing ops array to avoid dangling pointer
                    taken->base.addUser(term);
                    term->nops = 1;
                    term->opcode = IrOpcode::Br;
                    term->ops[0] = &taken->base;

                    for (u32 si = bb->nsuccs; si > 0; si--)
                    {
                        IrBlock* oldSucc = bb->succs[si - 1];
                        if (oldSucc == taken) continue;
                        bb->removeSucc(oldSucc);
                        oldSucc->removePred(bb);
                    }
                    if (bb->nsuccs == 0) bb->addSucc(taken);
                    self.threads++;
                    changed = true;
                }
            }
        }

        return self.threads > 0;
    }
}

pub bool irPassJumpThread(IrFunc* func, rawptr userdata)
{
    if (func == null) return false;
    JumpThreadPass pass = JumpThreadPass::new();
    return pass.run(func);
}
