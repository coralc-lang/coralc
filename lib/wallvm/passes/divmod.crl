#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue };
import(lib) wallvm::irOps { IrOpcode };
import(lib) wallvm::domtree { IrDomTree, irDomtreeNew, irDomtreeDominates };

// Div/rem fusion, when both div(x, y) and rem(x, y) exist, the remainder can
// be computed as x - div(x, y) * y, replacing an expensive division with a
// multiply and subtract. The transform is exact, by definition
// rem(x, y) = x - trunc(x / y) * y. Only fired when the quotient is already
// computed elsewhere (shared), so no division is ever introduced.
pub struct DivModPass
{
    IrContext* ctx;
    u64 fused;

    DivModPass new(IrContext* ctx)
    {
        return DivModPass {
            .ctx = ctx,
            .fused = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.fused = 0;
        bool changed = false;

        IrDomTree* dom = irDomtreeNew(func);
        if (dom == null) return false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                IrOpcode divOp;
                if (inst->opcode == IrOpcode::SRem) divOp = IrOpcode::SDiv;
                else if (inst->opcode == IrOpcode::URem) divOp = IrOpcode::UDiv;
                else {
                    ii++;
                    continue;
                }
                if (inst->nops != 2) { ii++; continue; }
                IrValue* x = inst->ops[0];
                IrValue* y = inst->ops[1];
                if (x == null || y == null) { ii++; continue; }

                IrInst* match = null;
                for (u32 bj = 0; bj < func->nblocks && match == null; bj++)
                {
                    IrBlock* b2 = func->blocks[bj];
                    for (u32 ij = 0; ij < b2->ninsts; ij++)
                    {
                        IrInst* d = b2->insts[ij];
                        if (d->opcode != divOp || d->nops != 2) continue;
                        if (d->ops[0] != x || d->ops[1] != y) continue;
                        if (d->base.nusers < 2) continue;
                        bool ok;
                        if (bj == bi) ok = ij < ii;
                        else ok = irDomtreeDominates(dom, b2, bb);
                        if (ok) { match = d; break; }
                    }
                }
                if (match == null) {
                    ii++;
                    continue;
                }

                IrValue* mulOps[2] = { &match->base, y };
                IrInst* mulInst = self.ctx->createInst(IrOpcode::Mul, inst->base.type, mulOps, 2, 0, 0);
                mulOps[0]->addUser(mulInst);
                mulOps[1]->addUser(mulInst);
                inst->parent->insertBefore(mulInst, inst);

                IrValue* subOps[2] = { x, &mulInst->base };
                IrInst* subInst = self.ctx->createInst(IrOpcode::Sub, inst->base.type, subOps, 2, 0, 0);
                subOps[0]->addUser(subInst);
                subOps[1]->addUser(subInst);
                inst->parent->insertBefore(subInst, inst);

                inst->base.replaceAllUses(&subInst->base);
                inst->erase();
                self.fused++;
                changed = true;
            }
        }

        return changed;
    }
}

pub bool irPassDivMod(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    DivModPass pass = DivModPass::new(ctx);
    return pass.run(func);
}
