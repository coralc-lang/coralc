#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock, IrInst };
import(lib) wallvm::irOps { IrOpcode };

// Control-Flow Tail Duplication, which duplicates the tail of a basic block
// into its incoming jump targets to eliminate unconditional branches and
// expose further constant folding or selection patterns across basic block
// boundaries.
//
// Pattern, A has tail [X, Y, Z, br B]; B starts with [br C]
//          -> Duplicate tail into A, redirect A to C directly.
// Also, A has tail [X, cond_br ...]; B (single predecessor) has tail [Y, br C]
//          -> If B's only content is a copy of A's tail, merge.
pub struct TailDupPass
{
    u64 dups;

    static TailDupPass new()
    {
        return TailDupPass {
            .dups = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.dups = 0;
        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                if (bb->ninsts == 0) continue;

                IrInst* term = bb->insts[bb->ninsts - 1];

                // Pattern 1, unconditional branch to a block that only has an unconditional branch
                if (term->opcode == IrOpcode::Br && term->nops == 1)
                {
                    IrBlock* target = (IrBlock*)term->ops[0];
                    if (target != bb && target->ninsts >= 1 && target->parent == func &&
                        target->npreds == 1)
                    {
                        IrInst* targetTerm = target->insts[target->ninsts - 1];
                        if (targetTerm->opcode == IrOpcode::Br && targetTerm->nops == 1)
                        {
                            IrBlock* finalTarget = (IrBlock*)targetTerm->ops[0];
                            if (finalTarget != bb && target->hasNoSideEffects())
                            {
                                // Move target's instructions into bb (before the terminator)
                                for (u32 si = 0; si < target->ninsts - 1; si++)
                                {
                                    IrInst* si2 = target->insts[si];
                                    si2->parent = bb;
                                    bb->insertBefore(si2, term);
                                }
                                target->ninsts = 0;

                                // Rewrite PHI incoming-block refs in finalTarget
                                // that named the target we gutted
                                for (u32 fi = 0; fi < finalTarget->ninsts; fi++)
                                {
                                    IrInst* fi2 = finalTarget->insts[fi];
                                    if (fi2->opcode == IrOpcode::Phi)
                                    {
                                        for (u32 pi = 1; pi < fi2->nops; pi += 2)
                                        {
                                            if (fi2->ops[pi] == &target->base)
                                                fi2->ops[pi] = &bb->base;
                                        }
                                    }
                                }

                                // Update terminator to point to finalTarget
                                term->ops[0]->removeUser(term);
                                finalTarget->base.addUser(term);
                                term->ops[0] = &finalTarget->base;

                                target->removePred(bb);
                                bb->removeSucc(target);
                                bb->addSucc(finalTarget);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }
                }

                // Pattern 2, condbr where one target is a simple passthrough block
                if (term->opcode == IrOpcode::CondBr && term->nops >= 3)
                {
                    IrBlock* trueTgt = (IrBlock*)term->ops[1];
                    IrBlock* falseTgt = (IrBlock*)term->ops[2];

                    // Check if true target is a simple passthrough
                    if (trueTgt->npreds == 1 && trueTgt->ninsts >= 1 && trueTgt->parent == func)
                    {
                        IrInst* ttTerm = trueTgt->insts[trueTgt->ninsts - 1];
                        if (ttTerm->opcode == IrOpcode::Br && ttTerm->nops == 1)
                        {
                            IrBlock* dest = (IrBlock*)ttTerm->ops[0];
                            if (dest != bb && trueTgt->hasNoSideEffects() && trueTgt->ninsts - 1 <= 8)
                            {
                                // Merge true target's instructions into bb
                                for (u32 si = 0; si < trueTgt->ninsts - 1; si++)
                                {
                                    IrInst* si2 = trueTgt->insts[si];
                                    si2->parent = bb;
                                    bb->insertBefore(si2, term);
                                }
                                trueTgt->ninsts = 0;

                                // Redirect condbr's true arm
                                term->ops[1]->removeUser(term);
                                dest->base.addUser(term);
                                term->ops[1] = &dest->base;

                                trueTgt->removePred(bb);
                                bb->removeSucc(trueTgt);
                                bb->addSucc(dest);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }

                    // Check if false target is a simple passthrough
                    if (falseTgt->npreds == 1 && falseTgt->ninsts >= 1 && falseTgt->parent == func)
                    {
                        IrInst* ftTerm = falseTgt->insts[falseTgt->ninsts - 1];
                        if (ftTerm->opcode == IrOpcode::Br && ftTerm->nops == 1)
                        {
                            IrBlock* dest = (IrBlock*)ftTerm->ops[0];
                            if (dest != bb && falseTgt->hasNoSideEffects() && falseTgt->ninsts - 1 <= 8)
                            {
                                for (u32 si = 0; si < falseTgt->ninsts - 1; si++)
                                {
                                    IrInst* si2 = falseTgt->insts[si];
                                    si2->parent = bb;
                                    bb->insertBefore(si2, term);
                                }
                                falseTgt->ninsts = 0;

                                term->ops[2]->removeUser(term);
                                dest->base.addUser(term);
                                term->ops[2] = &dest->base;

                                falseTgt->removePred(bb);
                                bb->removeSucc(falseTgt);
                                bb->addSucc(dest);
                                self.dups++;
                                changed = true;
                                continue;
                            }
                        }
                    }
                }
            }
        }
        return self.dups > 0;
    }
}

pub bool irPassTailDup(IrFunc* func, rawptr userdata)
{
    if (func == null) return false;
    TailDupPass pass = TailDupPass::new();
    return pass.run(func);
}
