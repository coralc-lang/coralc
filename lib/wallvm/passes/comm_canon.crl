#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };

// Commutative canonicalization, canonicalize operand order for commutative ops
// so that constants are on the right and variables are on the left. This
// enables more CSE/GVN opportunities and simplifies pattern matching.
pub struct CommCanonicalizePass
{
    u64 fixes;

    static CommCanonicalizePass new() { return CommCanonicalizePass { .fixes = 0 }; }

    bool run(IrFunc* func)
    {
        self.fixes = 0;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (!self.isCommutative(inst->opcode) || inst->nops < 2) continue;

                // Ensure constants go to ops[1]
                if (inst->ops[0]->kind == IrValueKind::ConstInt &&
                    inst->ops[1]->kind != IrValueKind::ConstInt)
                {
                    IrValue* tmp = inst->ops[0];
                    inst->ops[0] = inst->ops[1];
                    inst->ops[1] = tmp;
                    self.fixes++;
                }
                else if (inst->ops[0]->kind == IrValueKind::ConstFloat &&
                    inst->ops[1]->kind != IrValueKind::ConstFloat)
                {
                    IrValue* tmp = inst->ops[0];
                    inst->ops[0] = inst->ops[1];
                    inst->ops[1] = tmp;
                    self.fixes++;
                }
                // If both are same kind, sort by ID for deterministic order
                else if (inst->ops[0]->id > inst->ops[1]->id &&
                    ((inst->ops[0]->kind == IrValueKind::ConstInt &&
                      inst->ops[1]->kind == IrValueKind::ConstInt) ||
                     (inst->ops[0]->kind == IrValueKind::ConstFloat &&
                      inst->ops[1]->kind == IrValueKind::ConstFloat)))
                {
                    IrValue* tmp = inst->ops[0];
                    inst->ops[0] = inst->ops[1];
                    inst->ops[1] = tmp;
                    self.fixes++;
                }
                // For same-kind non-constants, sort by ID
                else if (inst->ops[0]->kind == inst->ops[1]->kind &&
                    inst->ops[0]->kind == IrValueKind::Inst &&
                    inst->ops[0]->id > inst->ops[1]->id)
                {
                    IrValue* tmp = inst->ops[0];
                    inst->ops[0] = inst->ops[1];
                    inst->ops[1] = tmp;
                    self.fixes++;
                }
            }
        }

        return self.fixes > 0;
    }

    bool isCommutative(IrOpcode op)
    {
        return op == IrOpcode::Add ||
               op == IrOpcode::Mul ||
               op == IrOpcode::And ||
               op == IrOpcode::Or  ||
               op == IrOpcode::Xor ||
               op == IrOpcode::SMin ||
               op == IrOpcode::SMax ||
               op == IrOpcode::UMin ||
               op == IrOpcode::UMax;
    }
}

pub bool irPassCommCanonicalize(IrFunc* func, rawptr userdata)
{
    if (func == null) return false;
    CommCanonicalizePass pass = CommCanonicalizePass::new();
    return pass.run(func);
}
