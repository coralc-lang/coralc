#[[no_drop_all]]
import(lib) wallvm::irtypes { IrFunc, IrBlock, IrInst, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };

// Involution chain collapse, eliminates pairs of self-inverse operations.
// Examples — not(not(x)) = x, neg(neg(x)) = x, (x^C)^C = x
// Also handles sext(trunc(x)) when width matches, zext(trunc(x))
pub struct InvolutionPass
{
    u64 collapses;

    static InvolutionPass new() { return InvolutionPass { .collapses = 0 }; }

    bool run(IrFunc* func)
    {
        self.collapses = 0;
        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                IrBlock* bb = func->blocks[bi];
                for (u32 ii = 0; ii < bb->ninsts; ii++)
                {
                    IrInst* inst = bb->insts[ii];
                    if (self.collapseChain(inst, bb, ii)) {
                        changed = true;
                        break;
                    }
                }
                if (changed) break;
            }
        }
        return self.collapses > 0;
    }

    bool collapseChain(IrInst* inst, IrBlock* bb, u32 idx)
    {
        // fabs(fabs(x)) -> fabs(x)
        if (inst->opcode == IrOpcode::FAbs && inst->nops == 1 &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::FAbs && inner->nops == 1)
            {
                inst->base.replaceAllUses(inst->ops[0]);
                inst->erase();
                self.collapses++;
                return true;
            }
        }

        // (x ^ C) ^ C -> x  (XOR with same constant twice)
        if (inst->opcode == IrOpcode::Xor && inst->nops == 2 &&
            inst->ops[0]->kind == IrValueKind::Inst &&
            inst->ops[1]->kind == IrValueKind::ConstInt)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Xor && inner->nops == 2 &&
                inner->ops[1]->kind == IrValueKind::ConstInt &&
                inner->ops[1]->valData == inst->ops[1]->valData)
            {
                inst->base.replaceAllUses(inner->ops[0]);
                inst->erase();
                self.collapses++;
                return true;
            }
        }

        // (x + C) + (-C) -> x  (addition with inverse constants)
        if (inst->opcode == IrOpcode::Add && inst->nops == 2 &&
            inst->ops[0]->kind == IrValueKind::Inst &&
            inst->ops[1]->kind == IrValueKind::ConstInt)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Add && inner->nops == 2 &&
                inner->ops[1]->kind == IrValueKind::ConstInt)
            {
                u32 bits = inst->base.type != null ? inst->base.type->width : 64;
                u64 mask = (bits >= 64u) ? (u64)~0ULL : ((1ULL << (u64)bits) - 1ULL);
                u64 sum = (inst->ops[1]->valData + inner->ops[1]->valData) & mask;
                if (sum == 0)
                {
                    inst->base.replaceAllUses(inner->ops[0]);
                    inst->erase();
                    self.collapses++;
                    return true;
                }
            }
        }

        // (x << C) >> C -> x  only when C == 0
        // For C > 0, shl loses the top C bits and the bottom C bits are zeroed,
        // so the shift pair is NOT an identity.
        if ((inst->opcode == IrOpcode::Lshr || inst->opcode == IrOpcode::Ashr) &&
            inst->nops == 2 && inst->ops[1]->kind == IrValueKind::ConstInt &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Shl && inner->nops == 2 &&
                inner->ops[1]->kind == IrValueKind::ConstInt &&
                inner->ops[1]->valData == inst->ops[1]->valData)
            {
                u64 shiftAmt = inst->ops[1]->valData;
                if (shiftAmt == 0)
                {
                    inst->base.replaceAllUses(inner->ops[0]);
                    inst->erase();
                    self.collapses++;
                    return true;
                }
            }
        }

        // fabs(fneg(x)) -> fabs(x)  (fneg under fabs is redundant)
        if (inst->opcode == IrOpcode::FAbs && inst->nops == 1 &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Neg && inner->nops == 1)
            {
                // fneg then fabs = fabs
                inst->base.replaceAllUses(inner->ops[0]);
                inst->erase();
                self.collapses++;
                return true;
            }
        }

        // zext(sext(x)) -> sext(x) when zext width > sext dest width
        // (the sign extension already filled the upper bits)
        if (inst->opcode == IrOpcode::Zext && inst->nops == 1 &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::Sext && inner->nops == 1)
            {
                u32 innerW = inner->base.type != null ? inner->base.type->width : 64;
                u32 outerW = inst->base.type != null ? inst->base.type->width : 64;
                u32 srcW = inner->ops[0]->type != null ? inner->ops[0]->type->width : 64;
                if (innerW == outerW && srcW < innerW)
                {
                    // sext already gives the full-width value
                    inst->base.replaceAllUses(&inner->base);
                    inst->erase();
                    self.collapses++;
                    return true;
                }
            }
        }

        // fptrunc(fpext(x)) -> x when widths match
        if (inst->opcode == IrOpcode::FpTrunc && inst->nops == 1 &&
            inst->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* inner = (IrInst*)inst->ops[0];
            if (inner->opcode == IrOpcode::FpExt && inner->nops == 1)
            {
                u32 outW = inst->base.type != null ? inst->base.type->width : 64;
                u32 innerW = inner->base.type != null ? inner->base.type->width : 64;
                if (outW == innerW)
                {
                    inst->base.replaceAllUses(inner->ops[0]);
                    inst->erase();
                    self.collapses++;
                    return true;
                }
            }
        }
        return false;
    }
}

pub bool irPassInvolution(IrFunc* func, rawptr userdata)
{
    if (func == null) return false;
    InvolutionPass pass = InvolutionPass::new();
    return pass.run(func);
}
