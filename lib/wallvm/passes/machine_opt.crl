#[[no_drop_all]]
import wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, FunctionAnalysisCache };
import wallvm::irOps { IrOpcode };
import wallvm::passes::alias_analysis { AliasAnalysis };
import wallvm::passes::memory_ssa { MemorySSA };
import wallvm::base::domtree { IrDomTree, irDomtreeNew, irDomtreeFree, irDomtreeDominates };

// Machine-level CSE/DSE pass using MemorySSA.
//
// Uses alias analysis and MemorySSA for precise memory optimization:
// 1. Store-to-load forwarding — a load may take a prior store's value only
//    when the store must-aliases it (same address SSA value, equal width),
//    dominates the load, and no aliasing write or barrier sits between
//    them (canForward). Same-block and cross-block share this check.
// 2. Dead store elimination — a store overwritten (killed) by a later
//    must-alias store before any load reads it in the same block is dead
//    and can be removed.
//
// MemorySSA provides precise memory dependency information that replaces
// the naive back-scan approach, handling aliasing correctly.
pub struct MachineOptPass
{
    IrContext* ctx;
    u64 forwardingDone;
    u64 loadsEliminated;
    u64 storesEliminated;

    static MachineOptPass new(IrContext* ctx)
    {
        return MachineOptPass {
            .ctx = ctx,
            .forwardingDone = 0,
            .loadsEliminated = 0,
            .storesEliminated = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.forwardingDone = 0;
        self.loadsEliminated = 0;
        self.storesEliminated = 0;

        // Check for cached AA
        FunctionAnalysisCache* cache = self.ctx->getOrCreateAnalysisCache(func);
        AliasAnalysis* aaPtr = (AliasAnalysis*)cache->aliasAnalysis;

        AliasAnalysis aa;
        MemorySSA mssa;
        bool ownAA = false;

        if (aaPtr != null && cache->generation == self.ctx->analysisGeneration)
        {
            aa = *aaPtr;
        }
        else
        {
            aa = AliasAnalysis::new(self.ctx);
            aa.analyze(func);
            ownAA = true;
        }

        // I rebuild the MSSA per run rather than reading cache->memorySSA: an
        // MSSA points at its AliasAnalysis, so a cached one would dangle once
        // the local AA dies. The local MSSA is torn down before returning.
        mssa = MemorySSA::new(&aa);
        mssa.build(func);

        bool changed = false;

        // Dominance tree shared by every forwarding decision (canForward).
        IrDomTree* dt = irDomtreeNew(func);

        // Pass 1 — store-to-load forwarding, same-block and cross-block
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (self.processBlockWithMemorySSA(bb, &mssa, dt)) changed = true;
        }

        // Pass 2 — dead store elimination using MemorySSA
        if (self.eliminateDeadStores(func, &mssa)) changed = true;

        irDomtreeFree(dt);
        mssa.deinit();
        if (ownAA) aa.deinit();
        return changed;
    }

    // Process a single block — forward stores to loads, eliminate dead stores
    bool processBlockWithMemorySSA(IrBlock* bb, MemorySSA* mssa, IrDomTree* dt)
    {
        bool changed = false;
        u32 i = 0;
        while (i < bb->ninsts)
        {
            IrInst* inst = bb->insts[i];

            // Try to forward store value to load
            if (self.isMemoryRead(inst->opcode) && inst->nops > 0 && inst->ops[0] != null)
            {
                IrValue* loadAddr = inst->ops[0];
                u32 loadWidth = inst->base.type != null ? inst->base.type->width : 0;

                // Use MemorySSA to find the most recent store that may have affected this load
                u32 storeVer = mssa->findNearestDefForLoad(loadAddr, mssa->getVersionAtInst(inst));
                if (storeVer > 0 && storeVer < mssa->numMemVersions)
                {
                    IrInst* killerDef = mssa->memDefInst[storeVer];
                    if (killerDef != null && self.isStoreToAddr(killerDef, loadAddr) && self.storeValueWidth(killerDef) == loadWidth)
                    {
                        // D1: dominance + no-intervening-writer check —
                        // a side-path store must never be forwarded.
                        if (self.canForward(killerDef, inst, bb->parent, dt, mssa))
                        {
                            inst->base.replaceAllUses(killerDef->ops[0]);
                            inst->erase();
                            self.forwardingDone++;
                            changed = true;
                            continue;
                        }
                    }
                }
            }

            // Try to eliminate dead store (store overwritten before read)
            if (inst->opcode == IrOpcode::Store && inst->nops >= 2 && inst->ops[1] != null)
            {
                IrValue* storeAddr = inst->ops[1];
                u32 storeWidth = self.storeValueWidth(inst);

                // Find if this store is killed by a later store before any load reads it
                if (self.isStoreDead(inst, storeAddr, storeWidth, mssa))
                {
                    inst->erase();
                    self.storesEliminated++;
                    changed = true;
                    continue;
                }
            }

            i++;
        }

        return changed;
    }

    // Store base.type is void (width 0) — the value operand carries the
    // real access width. 0 means unknown, never "equal".
    u32 storeValueWidth(IrInst* store)
    {
        if (store->nops < 1 || store->ops[0] == null || store->ops[0]->type == null) return 0;
        return store->ops[0]->type->width;
    }

    // Check if a store is killed by a later store before any load reads it
    bool isStoreDead(IrInst* storeInst, IrValue* addr, u32 width, MemorySSA* mssa)
    {
        if (width == 0) return false;
        IrBlock* bb = storeInst->parent;
        if (bb == null) return false;

        u32 storeIdx = 0;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            if (bb->insts[i] == storeInst) { storeIdx = i; break; }
        }

        // Scan forward from the store
        for (u32 j = storeIdx + 1; j < bb->ninsts; j++)
        {
            IrInst* later = bb->insts[j];

            // If a load may alias with the store address, the store is not dead
            if (self.isMemoryRead(later->opcode) && later->nops > 0 && later->ops[0] != null)
            {
                if (!mssa->aliasAnalysis->isNoAlias(later->ops[0], addr))
                    return false;
            }

            // If a store definitely kills this store (same address, no intervening load), it's dead
            if ((later->opcode == IrOpcode::Store || later->opcode == IrOpcode::AtomicStore) &&
                later->nops >= 2 && later->ops[1] != null)
            {
                if (mssa->aliasAnalysis->isMustAlias(later->ops[1], addr) && self.storeValueWidth(later) >= width)
                    return true;
            }

            // Barriers prevent us from determining death
            if (self.isBarrier(later->opcode))
                return false;
        }

        return false;
    }

    // Position of an instruction inside its block, or bb->ninsts if absent.
    u32 instIndex(IrBlock* bb, IrInst* inst)
    {
        for (u32 i = 0; i < bb->ninsts; i++)
            if (bb->insts[i] == inst) return i;
        return bb->ninsts;
    }

    // May `killer`'s stored value be forwarded to `load`? All conditions
    // are required (D1):
    //   C0 — caller-established must-alias: isStoreToAddr (same address
    //        SSA value) plus equal access widths.
    //   C1 — the killer dominates the load: same block with the killer
    //        earlier (straight-line), or the killer's block dominates the
    //        load's block. Without this a store on a side path that never
    //        executed would be forwarded — the D1 miscompile.
    //   C2 — region scan: no aliasing store or barrier between them. Every
    //        block dominated by the killer's block is scanned — the
    //        killer's block from after the killer, the load's block up to
    //        the load, all others in full. If the killer dominates the
    //        load, any writer on a killer→load path lies in this region:
    //        a path writer whose block the killer did not dominate would
    //        give an entry→load path avoiding the killer, contradicting
    //        dominance. So a clean region means no intervening write can
    //        reach the load. Writers before the killer are irrelevant —
    //        the killer must-aliases the load and overwrites them at the
    //        load's address.
    bool canForward(IrInst* killer, IrInst* load, IrFunc* func, IrDomTree* dt, MemorySSA* mssa)
    {
        if (killer == null || load == null || func == null) return false;
        IrBlock* kb = killer->parent;
        IrBlock* lb = load->parent;
        if (kb == null || lb == null) return false;

        u32 kIdx = self.instIndex(kb, killer);
        u32 lIdx = self.instIndex(lb, load);
        if (kIdx >= kb->ninsts || lIdx >= lb->ninsts) return false;

        if (kb == lb)
        {
            if (kIdx >= lIdx) return false;
        }
        else
        {
            if (dt == null || !irDomtreeDominates(dt, kb, lb)) return false;
        }

        for (u32 pi = 0; pi < func->nblocks; pi++)
        {
            IrBlock* pb = func->blocks[pi];
            if (pb == null) continue;
            if (pb != kb && !irDomtreeDominates(dt, kb, pb)) continue;

            u32 from = 0;
            u32 to = pb->ninsts;
            if (pb == kb)
            {
                from = kIdx + 1;
                if (pb == lb) to = lIdx;
            }
            else if (pb == lb)
            {
                to = lIdx;
            }

            for (u32 ii = from; ii < to; ii++)
            {
                IrInst* s = pb->insts[ii];
                if (self.isBarrier(s->opcode)) return false;
                if (s->opcode == IrOpcode::Store && s->nops >= 2 && s->ops[1] != null)
                {
                    if (mssa->aliasAnalysis == null ||
                        !mssa->aliasAnalysis->isNoAlias(s->ops[1], load->ops[0]))
                        return false;
                }
            }
        }
        return true;
    }

    // Eliminate dead stores across the function
    bool eliminateDeadStores(IrFunc* func, MemorySSA* mssa)
    {
        bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Store && inst->nops >= 2 && inst->ops[1] != null)
                {
                    IrValue* storeAddr = inst->ops[1];
                    u32 storeWidth = self.storeValueWidth(inst);

                    // Check if this store is killed by a later store before any load reads it
                    if (self.isStoreDead(inst, storeAddr, storeWidth, mssa))
                    {
                        inst->erase();
                        self.storesEliminated++;
                        changed = true;
                        continue;
                    }
                }
                ii++;
            }
        }

        return changed;
    }

    bool isBarrier(IrOpcode op)
    {
        switch (op)
        {
            IrOpcode::Call |
            IrOpcode::AtomicStore |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg |
            IrOpcode::Fence |
            IrOpcode::InlineAsm |
            IrOpcode::GcRoot |
            IrOpcode::GcWriteBarrier |
            IrOpcode::GcSafepoint |
            IrOpcode::LandingPad => { return true; },

            else => { return false; },
        }
    }

    bool isMemoryRead(IrOpcode op)
    {
        switch (op)
        {
            IrOpcode::Load |
            IrOpcode::AtomicLoad |
            IrOpcode::Call |
            IrOpcode::AtomicCmpXchg => { return true; },

            else => { return false; },
        }
    }

    bool isStoreToAddr(IrInst* inst, IrValue* addr)
    {
        if (inst->opcode != IrOpcode::Store && inst->opcode != IrOpcode::AtomicStore)
            return false;
        if (inst->nops < 2 || inst->ops[1] == null) return false;
        return inst->ops[1]->id == addr->id;
    }
}

pub bool irMachineOpt(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    MachineOptPass pass = MachineOptPass::new(ctx);
    return pass.run(func);
}
