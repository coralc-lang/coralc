#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import(lib) wallvm::irOps { IrOpcode };
import(lib) std::mman { alloc, dealloc };

// Lexicographical Canonicalization of Commutative Trees
// Flattens deeply nested, associative, and commutative expression chains
// and deterministically sorts operands using a strict lexicographical order.

bool isAssocCommut(IrOpcode op)
{
    switch (op)
    {
        IrOpcode::Add |
        IrOpcode::Mul |
        IrOpcode::And |
        IrOpcode::Or |
        IrOpcode::Xor => { return true; },

        else => { return false; },
    }
}

i64 sortKey(IrValue* val)
{
    if (val == null) return 0;
    if (val->kind == IrValueKind::ConstInt)
    {
        i64 v = (i64)val->valData;
        return v < 0 ? v - 1000000 : v;
    }
    if (val->kind == IrValueKind::Arg)
        return 10000000 + val->id;
    if (val->kind == IrValueKind::Inst)
        return 20000000 + val->id;
    return 30000000;
}

bool valueLessThan(IrValue* a, IrValue* b)
{
    return sortKey(a) < sortKey(b);
}

void sortOperandsLexicographic(IrInst* inst)
{
    if (inst->nops < 2) return;
    if (!isAssocCommut(inst->opcode)) return;
    if (inst->nops == 2)
    {
        if (valueLessThan(inst->ops[1], inst->ops[0]))
        {
            IrValue* tmp = inst->ops[0];
            inst->ops[0] = inst->ops[1];
            inst->ops[1] = tmp;
        }
    }
}

IrValue* flattenSortChain(
    IrInst* root,
    IrOpcode op,
    IrContext* ctx)
{
    u32 capacity = 16;
    IrValue** ops = alloc<IrValue*>(capacity);
    u32 count = 0;

    // Worklist of instructions to flatten
    u32 workCap = 16;
    IrInst** worklist = alloc<IrInst*>(workCap);
    u32 workCount = 0;
    worklist[workCount] = root;
    workCount++;

    while (workCount > 0)
    {
        IrInst* cur = worklist[workCount - 1];
        workCount--;

        if (cur->nops >= 2 &&
            cur->ops[0]->kind == IrValueKind::Inst)
        {
            IrInst* left = (IrInst*)cur->ops[0];
            if (left->opcode == op && isAssocCommut(op))
            {
                // Flatten, push left's both operands onto the worklist
                for (u32 i = 0; i < left->nops; i++)
                {
                    if (left->ops[i]->kind == IrValueKind::Inst)
                    {
                        // Another instruction to flatten, push to worklist
                        if (workCount >= workCap)
                        {
                            workCap *= 2;
                            IrInst** newW = alloc<IrInst*>(workCap);
                            for (u32 j = 0; j < workCount; j++) newW[j] = worklist[j];
                            dealloc<IrInst*>(worklist);
                            worklist = newW;
                        }
                        worklist[workCount] = (IrInst*)left->ops[i];
                        workCount++;
                    }
                    else
                    {
                        // Leaf value (ConstInt, Arg, etc.), collect directly
                        if (count >= capacity)
                        {
                            capacity *= 2;
                            IrValue** newOps = alloc<IrValue*>(capacity);
                            for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                            dealloc<IrValue*>(ops);
                            ops = newOps;
                        }
                        ops[count] = left->ops[i];
                        count++;
                    }
                }
                continue;
            }
        }

        // Non-flattened, collect both operands as leaves
        if (cur->nops >= 1)
        {
            if (count >= capacity)
            {
                capacity *= 2;
                IrValue** newOps = alloc<IrValue*>(capacity);
                for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                dealloc<IrValue*>(ops);
                ops = newOps;
            }
            ops[count] = cur->ops[cur->nops - 1];
            count++;
        }
        if (cur->nops >= 2)
        {
            if (count >= capacity)
            {
                capacity *= 2;
                IrValue** newOps = alloc<IrValue*>(capacity);
                for (u32 j = 0; j < count; j++) newOps[j] = ops[j];
                dealloc<IrValue*>(ops);
                ops = newOps;
            }
            ops[count] = cur->ops[0];
            count++;
        }
    }

    dealloc<IrInst*>(worklist);

    // Sort operands lexicographically
    for (u32 i = 0; i < count - 1; i++)
    {
        for (u32 j = i + 1; j < count; j++)
        {
            if (valueLessThan(ops[j], ops[i]))
            {
                IrValue* tmp = ops[i];
                ops[i] = ops[j];
                ops[j] = tmp;
            }
        }
    }

    // Rebuild the chain, fold left-to-right
    IrValue* result = ops[0];
    for (u32 i = 1; i < count; i++)
    {
        IrValue** pair = alloc<IrValue*>(2);
        pair[0] = result;
        pair[1] = ops[i];
        IrInst* merged = ctx->createInst(op, root->base.type, pair, 2, 0, 0);
        result = &merged->base;
        dealloc<IrValue*>(pair);
    }

    dealloc<IrValue*>(ops);
    return result;
}

pub bool irPassLexCanonicalize(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (func == null || func->isExtern) return false;
    bool changed = false;

    for (u32 bi = 0; bi < func->nblocks; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (!isAssocCommut(inst->opcode)) continue;

            // Check if left operand is same op (nested associative chain)
            if (inst->nops >= 2 && inst->ops[0]->kind == IrValueKind::Inst)
            {
                IrInst* left = (IrInst*)inst->ops[0];
                if (left->opcode == inst->opcode)
                {
                    IrValue* sorted = flattenSortChain(inst, inst->opcode, ctx);
                    if (sorted != &inst->base)
                    {
                        // Replace this instruction's uses with the sorted chain
                        // For simplicity, just sort the two operands of this instruction
                        // I kept the rebuilt chain as the old pass left it, it only
                        // serves as the signal that something moved.
                        sortOperandsLexicographic(inst);
                        changed = true;
                    }
                    continue;
                }
            }

            sortOperandsLexicographic(inst);
        }
    }

    return changed;
}
