#[[no_drop_all]]
import(lib) wallvm::irtypes { IrBlock, IrContext, IrFunc, IrInst, IrType, IrTypeKind, IrValue };
import(lib) wallvm::irOps { IrOpcode };
import(lib) wallvm::domtree { IrDomTree, irDomtreeFree, irDomtreeNew };
import(lib) std::mman { alloc, copy, dealloc };

struct AllocaInfo
{
    IrInst* alloca;
    u32 slot;
    bool promotable;
}

struct DefiningBlock
{
    IrBlock* bb;
    IrValue* value;
}

struct PlacedPhi
{
    IrInst* phi;
    u32 allocaIdx;
}

void blockInsertInst(IrBlock* bb, u32 idx, IrInst* newInst)
{
    if (idx > bb->ninsts) return;
    if (bb->ninsts + 1 > bb->capInsts)
    {
        u32 newCap = bb->capInsts ? bb->capInsts * 2 : 8;
        IrInst** newInsts = alloc<IrInst*>(newCap);
        if (bb->insts != null)
        {
            copy<IrInst*>(newInsts, bb->insts, bb->ninsts);
            dealloc<IrInst*>(bb->insts);
        }
        bb->insts = newInsts;
        bb->capInsts = newCap;
    }
    for (u32 i = bb->ninsts; i > idx; i--)
        bb->insts[i] = bb->insts[i - 1];
    bb->insts[idx] = newInst;
    newInst->parent = bb;
    bb->ninsts++;
}

struct RenameState
{
    IrValue** stack;
    u32 top;
    u32 cap;
}

RenameState rsInit()
{
    RenameState rs;
    rs.stack = alloc<IrValue*>(16);
    rs.top = 0;
    rs.cap = 16;
    return rs;
}

void rsPush(RenameState* rs, IrValue* v)
{
    if (rs->top >= rs->cap)
    {
        u32 nc = rs->cap * 2;
        IrValue** ns = alloc<IrValue*>(nc);
        for (u32 i = 0; i < rs->top; i++) ns[i] = rs->stack[i];
        dealloc<IrValue*>(rs->stack);
        rs->stack = ns;
        rs->cap = nc;
    }
    rs->stack[rs->top++] = v;
}

IrValue* rsTop(RenameState* rs)
{
    if (rs->top == 0) return null;
    return rs->stack[rs->top - 1];
}

void rsPop(RenameState* rs)
{
    if (rs->top > 0) rs->top--;
}

void rsFree(RenameState* rs)
{
    if (rs->stack != null) dealloc<IrValue*>(rs->stack);
}

struct IrDomFrontier
{
    IrBlock** blocks;
    u32 nblocks;
}

IrDomFrontier* computeDomFrontier(IrFunc* func, IrDomTree* dt)
{
    u32 n = func->nblocks;
    IrDomFrontier* df = alloc<IrDomFrontier>(n);
    for (u32 i = 0; i < n; i++)
    {
        df[i].blocks = null;
        df[i].nblocks = 0;
    }

    for (u32 bi = 0; bi < n; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        if (bb->npreds < 2) continue;
        IrBlock* idomBb = null;
        for (u32 k = 0; k < n; k++)
            if (dt->blocks[k] == bb) { idomBb = dt->idoms[k]; break; }

        for (u32 pi = 0; pi < bb->npreds; pi++)
        {
            IrBlock* run = bb->preds[pi];
            IrBlock* idom = null;
            for (u32 k = 0; k < n; k++)
                if (dt->blocks[k] == run) { idom = dt->idoms[k]; break; }

            while (idom != null && run != idomBb)
            {
                u32 rIdx = n;
                for (u32 k = 0; k < n; k++)
                    if (dt->blocks[k] == run) { rIdx = k; break; }

                bool found = false;
                for (u32 di = 0; di < df[rIdx].nblocks; di++)
                    if (df[rIdx].blocks[di] == bb) { found = true; break; }
                if (!found)
                {
                    u32 nc = df[rIdx].nblocks + 1;
                    IrBlock** nb = alloc<IrBlock*>(nc);
                    for (u32 di = 0; di < df[rIdx].nblocks; di++)
                        nb[di] = df[rIdx].blocks[di];
                    nb[df[rIdx].nblocks] = bb;
                    if (df[rIdx].blocks != null) dealloc<IrBlock*>(df[rIdx].blocks);
                    df[rIdx].blocks = nb;
                    df[rIdx].nblocks = nc;
                }

                run = idom;
                for (u32 k = 0; k < n; k++)
                    if (dt->blocks[k] == run) { rIdx = k; idom = dt->idoms[k]; break; }
                if (run == idom) break;
            }
        }
    }
    return df;
}

void freeDomFrontier(IrDomFrontier* df, u32 n)
{
    for (u32 i = 0; i < n; i++)
        if (df[i].blocks != null)
            dealloc<IrBlock*>(df[i].blocks);
    dealloc<IrDomFrontier>(df);
}

void placePhis(IrFunc* func, IrDomFrontier* df, AllocaInfo* ai, u32 nAllocas, IrContext* ctx,
               PlacedPhi** pphis, u32* nphis, u32* capPhis)
{
    for (u32 si = 0; si < nAllocas; si++)
    {
        if (!ai[si].promotable) continue;
        IrInst* alloca = ai[si].alloca;

        u32 n = func->nblocks;
        bool* dfHasPhi = alloc<bool>(n);
        for (u32 i = 0; i < n; i++) dfHasPhi[i] = false;

        bool* workFlags = alloc<bool>(n);
        for (u32 i = 0; i < n; i++) workFlags[i] = false;

        u32 wlCap = n;
        IrBlock** workList = alloc<IrBlock*>(wlCap);
        u32 wlSize = 0;

        for (u32 bi = 0; bi < n; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                if ((bb->insts[ii]->opcode == IrOpcode::Store &&
                     bb->insts[ii]->nops >= 2 &&
                     bb->insts[ii]->ops[1] == &alloca->base) ||
                    (bb->insts[ii]->opcode == IrOpcode::Load &&
                     bb->insts[ii]->nops >= 1 &&
                     bb->insts[ii]->ops[0] == &alloca->base))
                {
                    if (!workFlags[bi])
                    {
                        workFlags[bi] = true;
                        workList[wlSize++] = bb;
                    }
                    break;
                }
            }
        }

        u32 wi = 0;
        while (wi < wlSize)
        {
            IrBlock* bb = workList[wi++];
            u32 bIdx = n;
            for (u32 k = 0; k < n; k++)
                if (func->blocks[k] == bb) { bIdx = k; break; }

            IrDomFrontier* dfb = &df[bIdx];
            for (u32 di = 0; di < dfb->nblocks; di++)
            {
                IrBlock* fBlock = dfb->blocks[di];
                u32 fIdx = n;
                for (u32 k = 0; k < n; k++)
                    if (func->blocks[k] == fBlock) { fIdx = k; break; }

                if (!dfHasPhi[fIdx])
                {
                    dfHasPhi[fIdx] = true;

                    IrType* allocaTy = alloca->base.type;
                    IrType* valTy = allocaTy->kind == IrTypeKind::Ptr && allocaTy->elem != null
                        ? allocaTy->elem : ctx->tyInt(64);

                    IrValue** phiOps = alloc<IrValue*>(fBlock->npreds * 2);
                    u32 nphiOps = 0;

                    for (u32 pi = 0; pi < fBlock->npreds; pi++)
                    {
                        IrBlock* pred = fBlock->preds[pi];
                        phiOps[nphiOps++] = ctx->constInt(valTy, 0);
                        phiOps[nphiOps++] = &pred->base;
                    }

                    IrInst* phiInst = ctx->createInst(IrOpcode::Phi, valTy, phiOps, nphiOps, 0, 0);
                    u32 insertAt = 0;
                    while (insertAt < fBlock->ninsts && fBlock->insts[insertAt]->opcode == IrOpcode::Phi)
                        insertAt++;
                    blockInsertInst(fBlock, insertAt, phiInst);

                    for (u32 oi = 0; oi < nphiOps; oi++)
                        phiOps[oi]->addUser(phiInst);
                    dealloc<IrValue*>(phiOps);

                    if (*nphis >= *capPhis)
                    {
                        u32 nc = *capPhis ? *capPhis * 2 : 16;
                        PlacedPhi* np = alloc<PlacedPhi>(nc);
                        for (u32 i = 0; i < *nphis; i++) np[i] = (*pphis)[i];
                        if (*pphis != null) dealloc<PlacedPhi>(*pphis);
                        *pphis = np;
                        *capPhis = nc;
                    }
                    (*pphis)[*nphis].phi = phiInst;
                    (*pphis)[*nphis].allocaIdx = si;
                    (*nphis)++;

                    if (!workFlags[fIdx])
                    {
                        workFlags[fIdx] = true;
                        if (wlSize >= wlCap)
                        {
                            wlCap *= 2;
                            IrBlock** nwl = alloc<IrBlock*>(wlCap);
                            for (u32 i = 0; i < wlSize; i++) nwl[i] = workList[i];
                            dealloc<IrBlock*>(workList);
                            workList = nwl;
                        }
                        workList[wlSize++] = fBlock;
                    }
                }
            }
        }

        dealloc<bool>(dfHasPhi);
        dealloc<bool>(workFlags);
        dealloc<IrBlock*>(workList);
    }
}

void renameBlock(IrBlock* bb, IrDomFrontier* df, IrDomTree* dt, AllocaInfo* ai, u32 nAllocas,
                 RenameState* stacks, IrFunc* func, u32 n, PlacedPhi* pphis, u32 nphis,
                 IrContext* ctx)
{
    u32* savedTops = alloc<u32>(nAllocas);
    for (u32 si = 0; si < nAllocas; si++)
        savedTops[si] = stacks[si].top;

    for (u32 pi = 0; pi < nphis; pi++)
    {
        if (pphis[pi].phi->parent != bb) continue;
        u32 si = pphis[pi].allocaIdx;
        if (si >= nAllocas || !ai[si].promotable) continue;
        rsPush(&stacks[si], &pphis[pi].phi->base);
    }

    for (u32 si = 0; si < nAllocas; si++)
    {
        if (!ai[si].promotable) continue;

        u32 ii = 0;
        while (ii < bb->ninsts)
        {
            IrInst* inst = bb->insts[ii];
            if (inst->opcode == IrOpcode::Store && inst->nops >= 2 &&
                inst->ops[1] == &ai[si].alloca->base)
            {
                rsPush(&stacks[si], inst->ops[0]);

                for (u32 oi = 0; oi < inst->nops; oi++)
                    if (inst->ops[oi] != null)
                        inst->ops[oi]->removeUser(inst);
                for (u32 j = ii; j < bb->ninsts - 1; j++)
                    bb->insts[j] = bb->insts[j + 1];
                bb->ninsts--;
            }
            else
            {
                ii++;
            }
        }

        ii = 0;
        while (ii < bb->ninsts)
        {
            IrInst* inst = bb->insts[ii];
            if (inst->opcode == IrOpcode::Load && inst->nops >= 1 &&
                inst->ops[0] == &ai[si].alloca->base)
            {
                IrValue* repl = rsTop(&stacks[si]);
                if (repl != null)
                {
                    inst->base.replaceAllUses(repl);
                    for (u32 oi = 0; oi < inst->nops; oi++)
                        if (inst->ops[oi] != null)
                            inst->ops[oi]->removeUser(inst);
                    for (u32 j = ii; j < bb->ninsts - 1; j++)
                        bb->insts[j] = bb->insts[j + 1];
                    bb->ninsts--;
                }
                else
                {
                    IrValue* zero = ctx->constInt(inst->base.type, 0);
                    inst->base.replaceAllUses(zero);
                    for (u32 oi = 0; oi < inst->nops; oi++)
                        if (inst->ops[oi] != null)
                            inst->ops[oi]->removeUser(inst);
                    for (u32 j = ii; j < bb->ninsts - 1; j++)
                        bb->insts[j] = bb->insts[j + 1];
                    bb->ninsts--;
                }
            }
            else
            {
                ii++;
            }
        }
    }

    for (u32 ci = 0; ci < n; ci++)
    {
        if (func->blocks[ci] == bb) continue;
        IrBlock* child = func->blocks[ci];
        IrBlock* childIdom = null;
        for (u32 k = 0; k < n; k++)
            if (dt->blocks[k] == child) { childIdom = dt->idoms[k]; break; }
        if (childIdom == bb)
            renameBlock(child, df, dt, ai, nAllocas, stacks, func, n, pphis, nphis, ctx);
    }

    for (u32 sb = 0; sb < bb->nsuccs; sb++)
    {
        IrBlock* succ = bb->succs[sb];
        for (u32 pi = 0; pi < nphis; pi++)
        {
            if (pphis[pi].phi->parent != succ) continue;
            u32 si = pphis[pi].allocaIdx;
            if (si >= nAllocas || !ai[si].promotable) continue;
            IrInst* phi = pphis[pi].phi;
            for (u32 oi = 1; oi < phi->nops; oi += 2)
            {
                if (phi->ops[oi] == &bb->base)
                {
                    IrValue* v = rsTop(&stacks[si]);
                    if (v != null && phi->ops[oi - 1] != v)
                    {
                        phi->ops[oi - 1]->removeUser(phi);
                        phi->ops[oi - 1] = v;
                        v->addUser(phi);
                    }
                    break;
                }
            }
        }
    }

    for (u32 si = 0; si < nAllocas; si++)
    {
        while (stacks[si].top > savedTops[si])
            rsPop(&stacks[si]);
    }

    dealloc<u32>(savedTops);
}

pub bool irPassMem2Reg(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null || func->nblocks == 0) return false;

    u32 n = func->nblocks;
    u32 capAllocas = 16;
    u32 nAllocas = 0;
    AllocaInfo* allocas = alloc<AllocaInfo>(capAllocas);

    for (u32 bi = 0; bi < n; bi++)
    {
        IrBlock* bb = func->blocks[bi];
        for (u32 ii = 0; ii < bb->ninsts; ii++)
        {
            IrInst* inst = bb->insts[ii];
            if (inst->opcode == IrOpcode::Alloca)
            {
                if (nAllocas >= capAllocas)
                {
                    capAllocas *= 2;
                    AllocaInfo* na = alloc<AllocaInfo>(capAllocas);
                    for (u32 i = 0; i < nAllocas; i++) na[i] = allocas[i];
                    dealloc<AllocaInfo>(allocas);
                    allocas = na;
                }
                allocas[nAllocas].alloca = inst;
                allocas[nAllocas].slot = nAllocas;
                allocas[nAllocas].promotable = true;
                nAllocas++;
            }
        }
    }

    if (nAllocas == 0)
    {
        dealloc<AllocaInfo>(allocas);
        return false;
    }

    // Detect blocks that participate in loops (back-edges).
    // An alloca whose loads/stores all sit OUTSIDE loop blocks is still
    // promotable; only allocas touched inside a loop are held back, because
    // lsra assigns different registers to init vs increment values on
    // opposite sides of the back-edge, causing infinite loops.
    // I kept the anonymous block the old file opened here, it bounds the
    // inLoop scratch array without pulling a helper function out of the pass.
    {
        bool* inLoop = alloc<bool>(n);
        for (u32 i = 0; i < n; i++) inLoop[i] = false;
        for (u32 bi = 0; bi < n; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 si = 0; si < bb->nsuccs; si++)
            {
                IrBlock* succ = bb->succs[si];
                for (u32 sj = 0; sj < n; sj++)
                {
                    if (func->blocks[sj] == succ && sj <= bi)
                    { inLoop[bi] = true; inLoop[sj] = true; break; }
                }
            }
        }
        bool anyLoopAlloca = false;
        for (u32 si = 0; si < nAllocas; si++)
        {
            IrInst* alloca = allocas[si].alloca;
            // The alloca's own block plus the blocks of its users decide.
            u32 abIdx = n;
            if (alloca->parent != null)
            {
                for (u32 k2 = 0; k2 < n; k2++)
                    if (func->blocks[k2] == alloca->parent) { abIdx = k2; break; }
            }
            if (abIdx < n && inLoop[abIdx]) { anyLoopAlloca = true; continue; }
            for (u32 ui = 0; ui < alloca->base.nusers; ui++)
            {
                IrInst* user = alloca->base.users[ui];
                if (user->parent == null) continue;
                u32 ubIdx = n;
                for (u32 k2 = 0; k2 < n; k2++)
                    if (func->blocks[k2] == user->parent) { ubIdx = k2; break; }
                if (ubIdx < n && inLoop[ubIdx]) { anyLoopAlloca = true; break; }
            }
        }
        dealloc<bool>(inLoop);
        if (anyLoopAlloca)
        {
            for (u32 si = 0; si < nAllocas; si++)
            {
                IrInst* alloca = allocas[si].alloca;
                u32 abIdx = n;
                if (alloca->parent != null)
                {
                    for (u32 k2 = 0; k2 < n; k2++)
                        if (func->blocks[k2] == alloca->parent) { abIdx = k2; break; }
                }
                if (abIdx < n && inLoop[abIdx]) { allocas[si].promotable = false; continue; }
                for (u32 ui = 0; ui < alloca->base.nusers; ui++)
                {
                    IrInst* user = alloca->base.users[ui];
                    if (user->parent == null) continue;
                    u32 ubIdx = n;
                    for (u32 k2 = 0; k2 < n; k2++)
                        if (func->blocks[k2] == user->parent) { ubIdx = k2; break; }
                    if (ubIdx < n && inLoop[ubIdx]) { allocas[si].promotable = false; break; }
                }
            }
            dealloc<bool>(inLoop);
        }
    }

    // Check promotability, all uses must be load/store directly on the alloca
    for (u32 si = 0; si < nAllocas; si++)
    {
        IrInst* alloca = allocas[si].alloca;
        for (u32 ui = 0; ui < alloca->base.nusers; ui++)
        {
            IrInst* user = alloca->base.users[ui];
            if (user->opcode != IrOpcode::Load && user->opcode != IrOpcode::Store)
            {
                // Check if it's used in a phi as well (these were placed by us)
                if (user->opcode == IrOpcode::Phi) continue;
                allocas[si].promotable = false;
                break;
            }
            if (user->opcode == IrOpcode::Store && user->nops >= 1 && user->ops[0] == &alloca->base)
            {
                // store alloca, val — this is a store TO the alloca address itself
                // (not a store through the alloca)
                allocas[si].promotable = false;
                break;
            }
        }
    }

    // Build dominator tree
    IrDomTree* dt2 = irDomtreeNew(func);
    if (dt2 == null)
    {
        dealloc<AllocaInfo>(allocas);
        return false;
    }

    // Compute dominance frontiers
    IrDomFrontier* df = computeDomFrontier(func, dt2);

    // Place phi nodes
    PlacedPhi* pphis = null;
    u32 nphis = 0;
    u32 capPhis = 0;
    placePhis(func, df, allocas, nAllocas, ctx, &pphis, &nphis, &capPhis);

    // Rename, walk blocks in dominator tree order
    RenameState* stacks = alloc<RenameState>(nAllocas);
    for (u32 si = 0; si < nAllocas; si++)
        stacks[si] = rsInit();

    IrBlock* entry = func->blocks[0];
    renameBlock(entry, df, dt2, allocas, nAllocas, stacks, func, n, pphis, nphis, ctx);

    // Cleanup, remove the allocas that were promoted
    for (u32 si = 0; si < nAllocas; si++)
    {
        if (allocas[si].promotable)
        {
            IrInst* alloca = allocas[si].alloca;
            IrBlock* parent = alloca->parent;
            for (u32 ii = 0; ii < parent->ninsts; ii++)
            {
                if (parent->insts[ii] == alloca)
                {
                    for (u32 j = ii; j < parent->ninsts - 1; j++)
                        parent->insts[j] = parent->insts[j + 1];
                    parent->ninsts--;
                    break;
                }
            }
            alloca->erase();
        }
        rsFree(&stacks[si]);
    }

    dealloc<RenameState>(stacks);
    if (pphis != null) dealloc<PlacedPhi>(pphis);
    freeDomFrontier(df, n);
    irDomtreeFree(dt2);
    dealloc<AllocaInfo>(allocas);

    return true;
}
