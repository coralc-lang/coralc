#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrType, IrTypeKind };
import(lib) wallvm::irOps { IrOpcode, IrICmpPred };

pub struct IdiomRecognizePass
{
    IrContext* ctx;
    u64 recognized;

    static IdiomRecognizePass new(IrContext* ctx)
    {
        return IdiomRecognizePass {
            .ctx = ctx,
            .recognized = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.recognized = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                if (self.recognizeIdiom(inst))
                {
                    self.recognized++;
                    changed = true;
                }
                else { ii++; }
            }
        }

        return changed;
    }

    // Recognize common code idioms and replace with single instructions
    bool recognizeIdiom(IrInst* inst)
    {
        if (inst->nops < 2) return false;

        IrValue* a = inst->ops[0];
        IrValue* b = inst->ops[1];
        if (a == null || b == null) return false;

        if (self.matchRotate(inst, a, b))
            return true;

        if (self.matchBswap(inst))
            return true;

        if (self.matchMinMax(inst, a, b))
            return true;

        if (self.matchAbs(inst, a, b))
            return true;

        if (self.matchFma(inst, a, b))
            return true;

        return false;
    }

    // Match rotate idiom, or(shl(x, N), lshr(x, M-N)) -> rotl(x, N)
    bool matchRotate(IrInst* inst, IrValue* a, IrValue* b)
    {
        if (inst->opcode != IrOpcode::Or) return false;
        if (a->kind != IrValueKind::Inst || b->kind != IrValueKind::Inst) return false;

        IrInst* aInst = (IrInst*)a;
        IrInst* bInst = (IrInst*)b;

        if (aInst->opcode == IrOpcode::Shl &&
            bInst->opcode == IrOpcode::Lshr &&
            aInst->nops == 2 && bInst->nops == 2)
        {
            IrValue* x1 = aInst->ops[0];
            IrValue* x2 = bInst->ops[0];
            IrValue* n1 = aInst->ops[1];
            IrValue* n2 = bInst->ops[1];

            if (x1 == x2 && n1->kind == IrValueKind::ConstInt &&
                n2->kind == IrValueKind::ConstInt)
            {
                u32 bits = x1->type != null ? x1->type->width : 64;
                u64 shift = n1->valData;
                u64 complement = n2->valData;

                if (complement == (u64)bits - shift || complement == (u64)64 - shift)
                {
                    IrType* ty = x1->type;
                    IrValue*[2] rotlOps = { x1, self.ctx->constInt(ty, shift) };
                    IrInst* rotlInst = self.ctx->createInst(IrOpcode::Rotl, ty, rotlOps, 2, 0, 0);
                    rotlOps[0]->addUser(rotlInst);
                    rotlOps[1]->addUser(rotlInst);
                    inst->parent->insertBefore(rotlInst, inst);
                    inst->base.replaceAllUses(&rotlInst->base);
                    inst->erase();
                    return true;
                }
            }
        }

        if (aInst->opcode == IrOpcode::Lshr &&
            bInst->opcode == IrOpcode::Shl &&
            aInst->nops == 2 && bInst->nops == 2)
        {
            IrValue* x1 = aInst->ops[0];
            IrValue* x2 = bInst->ops[0];
            IrValue* n1 = aInst->ops[1];
            IrValue* n2 = bInst->ops[1];

            if (x1 == x2 && n1->kind == IrValueKind::ConstInt &&
                n2->kind == IrValueKind::ConstInt)
            {
                u32 bits = x1->type != null ? x1->type->width : 64;
                u64 shift = n1->valData;
                u64 complement = n2->valData;

                if (complement == (u64)bits - shift || complement == (u64)64 - shift)
                {
                    IrType* ty = x1->type;
                    IrValue*[2] rotrOps = { x1, self.ctx->constInt(ty, shift) };
                    IrInst* rotrInst = self.ctx->createInst(IrOpcode::Rotr, ty, rotrOps, 2, 0, 0);
                    rotrOps[0]->addUser(rotrInst);
                    rotrOps[1]->addUser(rotrInst);
                    inst->parent->insertBefore(rotrInst, inst);
                    inst->base.replaceAllUses(&rotrInst->base);
                    inst->erase();
                    return true;
                }
            }
        }

        return false;
    }

    bool matchFma(IrInst* inst, IrValue* a, IrValue* b)
    {
        if (inst->opcode != IrOpcode::FAdd) return false;
        if (inst->base.type == null || inst->base.type->kind != IrTypeKind::Float) return false;

        IrInst* mulInst = null;
        IrValue* other = null;

        if (a->kind == IrValueKind::Inst && ((IrInst*)a)->opcode == IrOpcode::FMul)
        {
            mulInst = (IrInst*)a;
            other = b;
        }
        else if (b->kind == IrValueKind::Inst && ((IrInst*)b)->opcode == IrOpcode::FMul)
        {
            mulInst = (IrInst*)b;
            other = a;
        }
        else
        {
            return false;
        }

        if (mulInst == null || mulInst->nops != 2 || other == null) return false;
        if (mulInst->base.type == null || mulInst->base.type != inst->base.type) return false;

        IrValue* x = mulInst->ops[0];
        IrValue* y = mulInst->ops[1];
        if (x == null || y == null) return false;

        IrValue*[3] fmaOps = { x, y, other };
        IrInst* fmaInst = self.ctx->createInst(IrOpcode::Fma, inst->base.type, fmaOps, 3, 0, 0);
        fmaOps[0]->addUser(fmaInst);
        fmaOps[1]->addUser(fmaInst);
        fmaOps[2]->addUser(fmaInst);
        inst->parent->insertBefore(fmaInst, inst);
        inst->base.replaceAllUses(&fmaInst->base);
        inst->erase();
        return true;
    }

    // Match byte-swap idiom, an or-chain of masked byte shifts that places each
    // source byte at its byte-reversed destination.
    bool matchBswap(IrInst* inst)
    {
        if (inst->opcode != IrOpcode::Or) return false;
        if (inst->base.type == null || inst->base.type->kind != IrTypeKind::Int) return false;
        u32 width = inst->base.type->width;
        if (width < 16 || width > 64 || width % 16 != 0) return false;
        u32 nBytes = width / 8;
        if (nBytes > 8) return false;

        IrInst*[8] leaves;
        IrInst* cur = inst;
        u32 n = 0;
        while (true)
        {
            if (cur->opcode != IrOpcode::Or)
            {
                leaves[n++] = cur;
                break;
            }
            if (cur->nops != 2) return false;
            if (cur->ops[1]->kind != IrValueKind::Inst) return false;
            leaves[n++] = (IrInst*)cur->ops[1];
            if (n > nBytes) return false;
            if (cur->ops[0]->kind != IrValueKind::Inst) return false;
            cur = (IrInst*)cur->ops[0];
        }
        if (n != nBytes) return false;

        IrValue* x = null;
        u32[8] ms;
        u32[8] ds;
        for (u32 i = 0; i < n; i++)
        {
            if (!self.bswapTerm(leaves[i], nBytes, &x, &ms[i], &ds[i])) return false;
        }

        // Every byte moves to its mirrored destination, no two share one.
        for (u32 i = 0; i < n; i++)
        {
            if (ds[i] != nBytes - 1 - ms[i]) return false;
            for (u32 j = i + 1; j < n; j++)
                if (ds[i] == ds[j]) return false;
        }

        IrValue*[1] bops = { x };
        IrInst* bs = self.ctx->createInst(IrOpcode::Bswap, inst->base.type, bops, 1, 0, 0);
        bops[0]->addUser(bs);
        inst->parent->insertBefore(bs, inst);
        inst->base.replaceAllUses(&bs->base);
        inst->erase();
        return true;
    }

    // Match one byte-swap term; returns its source byte m and destination byte
    // d, and binds the shared value x on the first call.
    bool bswapTerm(IrInst* leaf, u32 nBytes, IrValue** x, u32* m, u32* d)
    {
        IrInst* shiftInst = leaf;
        u64 mask = 0;
        bool isAnd = false;
        if (leaf->opcode == IrOpcode::And && leaf->nops == 2)
        {
            if (leaf->ops[1]->kind != IrValueKind::ConstInt) return false;
            if (leaf->ops[0]->kind != IrValueKind::Inst) return false;
            mask = leaf->ops[1]->valData;
            shiftInst = (IrInst*)leaf->ops[0];
            isAnd = true;
        }
        if (shiftInst->opcode != IrOpcode::Shl &&
            shiftInst->opcode != IrOpcode::Lshr) return false;
        if (shiftInst->nops != 2) return false;
        IrValue* sx = shiftInst->ops[0];
        IrValue* s = shiftInst->ops[1];
        if (s->kind != IrValueKind::ConstInt) return false;
        u64 shift = s->valData;
        if (shift == 0 || shift % 8 != 0) return false;
        u32 sBytes = (u32)(shift / 8);
        bool isShl = shiftInst->opcode == IrOpcode::Shl;

        if (*x == null) *x = sx;
        else if (*x != sx) return false;

        if (isAnd)
        {
            // The mask must isolate exactly one byte, 0xFF << (d * 8).
            if (mask == 0) return false;
            u32 dpos = 0;
            bool found = false;
            for (u32 k = 0; k < 8; k++)
            {
                if (((mask >> (u64)(k * 8)) & 0xFF) != 0)
                {
                    if (found) return false;
                    found = true;
                    dpos = k;
                }
            }
            if (!found || (mask >> (u64)(dpos * 8)) != 0xFF) return false;
            if (dpos >= nBytes) return false;

            u32 spos;
            if (isShl)
            {
                if (sBytes > dpos) return false;
                spos = dpos - sBytes;
            }
            else
            {
                spos = dpos + sBytes;
            }
            if (spos >= nBytes) return false;
            *m = spos;
            *d = dpos;
            return true;
        }

        // Maskless term, a shift of nBytes-1 bytes isolates the far byte.
        if (isShl)
        {
            if (sBytes != nBytes - 1) return false;
            *m = 0;
            *d = sBytes;
        }
        else
        {
            if (sBytes != nBytes - 1) return false;
            *m = sBytes;
            *d = 0;
        }
        return true;
    }

    // Match min/max idiom, select(icmp_XX(a, b), a, b) -> smin/smax/umin/umax
    bool matchMinMax(IrInst* inst, IrValue* a, IrValue* b)
    {
        if (inst->opcode != IrOpcode::Select) return false;
        if (a->kind != IrValueKind::Inst) return false;
        if (inst->nops < 3) return false;

        IrInst* condInst = (IrInst*)a;
        if (condInst->opcode != IrOpcode::ICmp) return false;
        if (condInst->nops != 2) return false;

        IrValue* cmpA = condInst->ops[0];
        IrValue* cmpB = condInst->ops[1];
        IrValue* trueVal = b;
        IrValue* falseVal = inst->ops[2];

        IrICmpPred pred = condInst->icmpPred;
        IrOpcode minMaxOp;

        if (trueVal == cmpA && falseVal == cmpB)
        {
            switch (pred)
            {
                IrICmpPred::Slt |
                IrICmpPred::Sle => { minMaxOp = IrOpcode::SMin; },
                IrICmpPred::Sgt |
                IrICmpPred::Sge => { minMaxOp = IrOpcode::SMax; },
                IrICmpPred::Ult |
                IrICmpPred::Ule => { minMaxOp = IrOpcode::UMin; },
                IrICmpPred::Ugt |
                IrICmpPred::Uge => { minMaxOp = IrOpcode::UMax; },
                else => { return false; },
            }
        }
        else if (trueVal == cmpB && falseVal == cmpA)
        {
            switch (pred)
            {
                IrICmpPred::Slt |
                IrICmpPred::Sle => { minMaxOp = IrOpcode::SMax; },
                IrICmpPred::Sgt |
                IrICmpPred::Sge => { minMaxOp = IrOpcode::SMin; },
                IrICmpPred::Ult |
                IrICmpPred::Ule => { minMaxOp = IrOpcode::UMax; },
                IrICmpPred::Ugt |
                IrICmpPred::Uge => { minMaxOp = IrOpcode::UMin; },
                else => { return false; },
            }
        }
        else
        {
            return false;
        }

        IrType* ty = cmpA->type;
        IrValue*[2] mmOps = { cmpA, cmpB };
        IrInst* mmInst = self.ctx->createInst(minMaxOp, ty, mmOps, 2, 0, 0);
        mmOps[0]->addUser(mmInst);
        mmOps[1]->addUser(mmInst);
        inst->parent->insertBefore(mmInst, inst);
        inst->base.replaceAllUses(&mmInst->base);
        inst->erase();
        return true;
    }

    // Match abs idiom, select(icmp_slt(x, 0), neg(x), x) -> abs(x)
    bool matchAbs(IrInst* inst, IrValue* a, IrValue* b)
    {
        if (inst->opcode != IrOpcode::Select) return false;
        if (a->kind != IrValueKind::Inst) return false;
        if (inst->nops < 3) return false;

        IrInst* condInst = (IrInst*)a;
        if (condInst->opcode != IrOpcode::ICmp) return false;
        if (condInst->nops != 2) return false;

        #[[maybe_unused]] IrValue* cmpA = condInst->ops[0];
        IrValue* cmpB = condInst->ops[1];

        if (cmpB->kind != IrValueKind::ConstInt || cmpB->valData != 0)
            return false;

        IrValue* trueVal = b;
        IrValue* falseVal = inst->ops[2];
        IrICmpPred pred = condInst->icmpPred;

        IrValue* absOperand = null;

        if (trueVal->kind == IrValueKind::Inst)
        {
            IrInst* negInst = (IrInst*)trueVal;
            if (negInst->opcode == IrOpcode::Neg && negInst->nops == 1 &&
                negInst->ops[0] == falseVal &&
                (pred == IrICmpPred::Slt || pred == IrICmpPred::Sle))
            {
                absOperand = falseVal;
            }
        }

        if (absOperand == null && falseVal->kind == IrValueKind::Inst)
        {
            IrInst* negInst = (IrInst*)falseVal;
            if (negInst->opcode == IrOpcode::Neg && negInst->nops == 1 &&
                negInst->ops[0] == trueVal &&
                (pred == IrICmpPred::Sgt || pred == IrICmpPred::Sge))
            {
                absOperand = trueVal;
            }
        }

        if (absOperand == null) return false;

        IrType* ty = absOperand->type;
        IrValue*[1] absOps = { absOperand };
        IrInst* absInst = self.ctx->createInst(IrOpcode::Abs, ty, absOps, 1, 0, 0);
        absOps[0]->addUser(absInst);
        inst->parent->insertBefore(absInst, inst);
        inst->base.replaceAllUses(&absInst->base);
        inst->erase();
        return true;
    }
}

pub bool irPassIdiom(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    IdiomRecognizePass pass = IdiomRecognizePass::new(ctx);
    return pass.run(func);
}
