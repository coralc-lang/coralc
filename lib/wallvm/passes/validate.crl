#[[no_drop_all]]
import wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrModule, IrGlobal };
import wallvm::irOps { IrOpcode, irOpcodeIsTerminator };

bool blockListContains(IrBlock** blocks, u32 nblocks, IrBlock* target)
{
    for (u32 i = 0; i < nblocks; i++)
        if (blocks[i] == target) return true;
    return false;
}

pub struct IrValidator
{
    IrContext* ctx;
    u32 nerrors;
    str lastError;

    static IrValidator new(IrContext* ctx)
    {
        return IrValidator {
            .ctx = ctx,
            .nerrors = 0,
            .lastError = ""
        };
    }

    void error(str msg)
    {
        self.nerrors++;
        self.lastError = msg;
    }

    bool validateFunc(IrFunc* func)
    {
        // errors are cumulative on purpose (callers may share one validator
        // across a module), so this call's result is measured against the
        // count at entry — one bad function must not poison every later
        // validateFunc call with a false and a stale lastError
        u32 base = self.nerrors;
        if (func == null)
        {
            self.error("null function");
            return false;
        }
        if (func->nblocks == 0 && !func->isExtern)
        {
            self.error("function with no blocks");
            return false;
        }

        // Validate each block
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (bb == null)
            {
                self.error("null block in function");
                return false;
            }

            if (bb->parent != func)
            {
                self.error("block parent mismatch");
                return false;
            }

            if (bb->ninsts == 0)
            {
                self.error("empty block");
                return false;
            }

            bool seenNonPhi = false;
            u32 termCount = 0;
            IrInst* term = null;

            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst == null)
                {
                    self.error("null instruction in block");
                    return false;
                }

                if (inst->parent != bb)
                {
                    self.error("instruction parent mismatch");
                    return false;
                }

                if (inst->opcode == IrOpcode::Phi)
                {
                    if (seenNonPhi)
                    {
                        self.error("phi must appear before non-phi instructions");
                        return false;
                    }
                    if ((inst->nops % 2) != 0)
                    {
                        self.error("phi must have value/block operand pairs");
                        return false;
                    }
                    if ((inst->nops / 2) != bb->npreds)
                    {
                        eprintln("TMPDBG phi in {}: pairs={} npreds={}", bb->base.name, (u32)(inst->nops / 2), bb->npreds);
                        for (u32 pi = 0; pi < bb->npreds; pi++)
                        {
                            str pn = "?";
                            if (bb->preds[pi] != null) pn = bb->preds[pi]->base.name;
                            eprintln("TMPDBG   pred={}", pn);
                        }
                        for (u32 oi = 0; oi < inst->nops; oi += 2)
                        {
                            str bn = "?";
                            if (inst->ops[oi + 1] != null) bn = ((IrBlock*)inst->ops[oi + 1])->base.name;
                            eprintln("TMPDBG   phi-in from {}", bn);
                        }
                        self.error("phi incoming count must match block predecessor count");
                        return false;
                    }
                    for (u32 oi = 0; oi < inst->nops; oi += 2)
                    {
                        IrValue* predVal = inst->ops[oi + 1];
                        if (predVal == null)
                        {
                            self.error("phi has null predecessor operand");
                            return false;
                        }
                        // The old file cast the operand straight to a block, I kept that
                        IrBlock* pred = (IrBlock*)predVal;
                        if (!blockListContains(bb->preds, bb->npreds, pred))
                        {
                            self.error("phi predecessor is not a CFG predecessor");
                            return false;
                        }
                    }
                }
                else
                {
                    seenNonPhi = true;
                }

                for (u32 oi = 0; oi < inst->nops; oi++)
                {
                    IrValue* op = inst->ops[oi];
                    if (op == null) continue;

                    bool found = false;
                    for (u32 ui = 0; ui < op->nusers; ui++)
                    {
                        if (op->users[ui] == inst)
                        {
                            found = true;
                            break;
                        }
                    }
                    if (!found)
                    {
                        self.error("use-def inconsistency: operand does not list this inst as user");
                        return false;
                    }
                }

                if (irOpcodeIsTerminator(inst->opcode))
                {
                    termCount++;
                    term = inst;
                    if (ii != bb->ninsts - 1)
                    {
                        self.error("terminator must be the last instruction in a block");
                        return false;
                    }
                }
            }

            if (termCount == 0)
            {
                self.error("block is missing a terminator");
                return false;
            }
            if (termCount > 1)
            {
                self.error("block has multiple terminators");
                return false;
            }

            switch (term->opcode)
            {
                IrOpcode::Br =>
                {
                    if (term->nops != 1 || bb->nsuccs != 1)
                    {
                        self.error("br must have one target and one successor");
                        return false;
                    }
                    if ((IrBlock*)term->ops[0] != bb->succs[0])
                    {
                        self.error("br target does not match CFG successor");
                        return false;
                    }
                },

                IrOpcode::CondBr =>
                {
                    if (term->nops != 3 || bb->nsuccs != 2)
                    {
                        self.error("cond_br must have condition, two targets, and two successors");
                        return false;
                    }
                    if ((IrBlock*)term->ops[1] != bb->succs[0] || (IrBlock*)term->ops[2] != bb->succs[1])
                    {
                        self.error("cond_br targets do not match CFG successors");
                        return false;
                    }
                },

                IrOpcode::Ret |
                IrOpcode::Unreachable |
                IrOpcode::Noret =>
                {
                    if (bb->nsuccs != 0)
                    {
                        self.error("terminator must not have CFG successors");
                        return false;
                    }
                },

                else =>
                {
                    self.error("unknown terminator kind");
                    return false;
                },
            }
        }

        // Validate successor/predecessor consistency
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 si = 0; si < bb->nsuccs; si++)
            {
                IrBlock* succ = bb->succs[si];
                if (succ == null)
                {
                    self.error("null successor");
                    return false;
                }
                if (!blockListContains(succ->preds, succ->npreds, bb))
                {
                    self.error("successor/predecessor inconsistency");
                    return false;
                }
            }
            for (u32 pi = 0; pi < bb->npreds; pi++)
            {
                IrBlock* pred = bb->preds[pi];
                if (pred == null)
                {
                    self.error("null predecessor");
                    return false;
                }
                if (!blockListContains(pred->succs, pred->nsuccs, bb))
                {
                    eprintln("TMPDBG preds/succs: block={} has pred={} but pred does not list it", bb->base.name, pred->base.name);
                    self.error("predecessor/successor inconsistency");
                    return false;
                }
            }
        }

        return self.nerrors == base;
    }

    bool validateModule(IrModule* modd)
    {
        if (modd == null)
        {
            self.error("null module");
            return false;
        }

        // Validate all functions
        for (u32 i = 0; i < modd->nfuncs; i++)
        {
            if (!self.validateFunc(modd->funcs[i]))
                return false;
        }

        // Validate globals
        for (u32 i = 0; i < modd->nglobals; i++)
        {
            IrGlobal* g = modd->globals[i];
            if (g == null)
            {
                self.error("null global");
                return false;
            }
            if (g->base.type == null)
            {
                self.error("global with null type");
                return false;
            }
        }

        return self.nerrors == 0;
    }
}

pub bool irPassValidate(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    IrValidator v = IrValidator::new(ctx);
    // The validator is a pure oracle — it never mutates the IR, so it must
    // never report "changed". It used to return nerrors == 0 (true when
    // valid), which made every pipeline look perpetually mutated and
    // defeated runOnFuncIterate's early exit: every function at every
    // level burned its full iteration budget, and real non-convergence
    // was masked by the same always-true signal. Failures now surface on
    // stderr instead of dying inside the validator's lastError field.
    if (!v.validateFunc(func))
    {
        eprintln("validate error in {}: {}", func->base.name, v.lastError);
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            eprintln("TMPG   {}:", bb->base.name);
            for (u32 pi = 0; pi < bb->npreds; pi++)
            {
                str pn = "null";
                if (bb->preds[pi] != null) pn = bb->preds[pi]->base.name;
                eprintln("TMPG     pred {}", pn);
            }
            for (u32 si = 0; si < bb->nsuccs; si++)
            {
                str sn = "null";
                if (bb->succs[si] != null) sn = bb->succs[si]->base.name;
                eprintln("TMPG     succ {}", sn);
            }
        }
    }
    return false;
}
