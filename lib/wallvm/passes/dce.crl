#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import(lib) wallvm::irOps { IrOpcode, irOpcodeIsTerminator };
import(lib) std::mman { alloc, dealloc };

pub struct DCEPass
{
    IrContext* ctx;
    u64 removed;

    static DCEPass new(IrContext* ctx)
    {
        return DCEPass {
            .ctx = ctx,
            .removed = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.removed = 0;
        bool changed = false;

        // First pass, remove unreachable blocks
        changed = self.removeUnreachableBlocks(func) || changed;

        // Second pass, remove dead instructions
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                if (self.isDead(inst))
                {
                    inst->erase();
                    self.removed++;
                    changed = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        return changed;
    }

    bool removeUnreachableBlocks(IrFunc* func)
    {
        if (func->nblocks == 0) return false;

        // Mark reachable blocks starting from entry
        u8* reachable = alloc<u8>((usize)func->nblocks);
        for (u32 i = 0; i < func->nblocks; i++) reachable[i] = 0;

        reachable[0] = 1;
        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 bi = 0; bi < func->nblocks; bi++)
            {
                if (!reachable[bi]) continue;
                IrBlock* bb = func->blocks[bi];
                IrInst* term = bb->terminator();
                if (term == null) continue;

                if (term->opcode == IrOpcode::Br)
                {
                    IrBlock* target = (IrBlock*)term->ops[0];
                    for (u32 ti = 0; ti < func->nblocks; ti++)
                    {
                        if (func->blocks[ti] == target && !reachable[ti])
                        {
                            reachable[ti] = 1;
                            changed = true;
                        }
                    }
                }
                else if (term->opcode == IrOpcode::CondBr)
                {
                    for (u32 j = 1; j <= 2; j++)
                    {
                        IrBlock* target = (IrBlock*)term->ops[j];
                        for (u32 ti = 0; ti < func->nblocks; ti++)
                        {
                            if (func->blocks[ti] == target && !reachable[ti])
                            {
                                reachable[ti] = 1;
                                changed = true;
                            }
                        }
                    }
                }
            }
        }

        // Remove unreachable blocks
        bool anyRemoved = false;
        u32 di = 0;
        for (u32 si = 0; si < func->nblocks; si++)
        {
            if (reachable[si])
            {
                if (di != si) func->blocks[di] = func->blocks[si];
                di++;
            }
            else
            {
                // Clear users from instructions in unreachable block
                IrBlock* bb = func->blocks[si];
                for (u32 ii = 0; ii < bb->ninsts; ii++)
                {
                    IrInst* inst = bb->insts[ii];
                    for (u32 ui = 0; ui < inst->base.nusers; ui++)
                    {
                        IrInst* user = inst->base.users[ui];
                        for (u32 j = 0; j < user->nops; j++)
                            if (user->ops[j] == &inst->base)
                                user->ops[j] = null;
                    }
                }
                anyRemoved = true;
            }
        }
        func->nblocks = di;

        dealloc<u8>(reachable);
        return anyRemoved;
    }

    u64 removedCount()
    {
        return self.removed;
    }

    bool isDead(IrInst* inst)
    {
        if (irOpcodeIsTerminator(inst->opcode)) return false;

        // side-effecting ops are never dead
        switch (inst->opcode)
        {
            IrOpcode::Store |
            IrOpcode::Call |
            IrOpcode::Noret |
            IrOpcode::AtomicStore |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg |
            IrOpcode::Fence |
            IrOpcode::InlineAsm |
            IrOpcode::GcWriteBarrier |
            IrOpcode::GcSafepoint |
            IrOpcode::LandingPad => { return false; },

            else => { },
        }

        if (inst->opcode == IrOpcode::Alloca)
            return inst->base.nusers == 0;

        return inst->base.nusers == 0;
    }
}

pub bool irPassDce(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    DCEPass pass = DCEPass::new(ctx);
    return pass.run(func);
}

pub struct ADCEPass
{
    IrContext* ctx;
    u64 removed;

    static ADCEPass new(IrContext* ctx)
    {
        return ADCEPass {
            .ctx = ctx,
            .removed = 0
        };
    }

    bool isCritical(IrInst* inst)
    {
        switch (inst->opcode)
        {
            IrOpcode::Br |
            IrOpcode::CondBr |
            IrOpcode::Ret |
            IrOpcode::Unreachable |
            IrOpcode::Noret |
            IrOpcode::Store |
            IrOpcode::Call |
            IrOpcode::AtomicStore |
            IrOpcode::AtomicRmw |
            IrOpcode::AtomicCmpXchg |
            IrOpcode::Fence |
            IrOpcode::InlineAsm |
            IrOpcode::GcWriteBarrier |
            IrOpcode::GcSafepoint |
            IrOpcode::LandingPad => { return true; },

            else => { return false; },
        }
    }

    bool run(IrFunc* func)
    {
        self.removed = 0;

        u32 totalInsts = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
            totalInsts += func->blocks[bi]->ninsts;

        if (totalInsts == 0) return false;

        IrInst** allInsts = alloc<IrInst*>((usize)totalInsts);
        u32 idx = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                allInsts[idx] = bb->insts[ii];
                // I keep the old file's use of valData as scratch space
                // for the flat index
                bb->insts[ii]->base.valData = (u64)idx;
                idx++;
            }
        }

        u8* live = alloc<u8>((usize)totalInsts);
        for (u32 i = 0; i < totalInsts; i++) live[i] = 0;

        for (u32 i = 0; i < totalInsts; i++)
        {
            if (self.isCritical(allInsts[i]))
                live[i] = 1;
        }

        bool changed = true;
        while (changed)
        {
            changed = false;
            for (u32 i = 0; i < totalInsts; i++)
            {
                if (!live[i]) continue;
                IrInst* inst = allInsts[i];
                for (u32 j = 0; j < inst->nops; j++)
                {
                    IrValue* op = inst->ops[j];
                    if (op == null || op->kind != IrValueKind::Inst) continue;
                    u32 opIdx = (u32)op->valData;
                    if (!live[opIdx])
                    {
                        live[opIdx] = 1;
                        changed = true;
                    }
                }
            }
        }

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                u32 instIdx = (u32)inst->base.valData;
                if (live[instIdx]) continue;
                for (u32 ui = 0; ui < inst->base.nusers; ui++)
                {
                    IrInst* user = inst->base.users[ui];
                    for (u32 j = 0; j < user->nops; j++)
                        if (user->ops[j] == &inst->base)
                            user->ops[j] = null;
                }
            }
        }

        bool anyRemoved = false;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            u32 ii = 0;
            while (ii < bb->ninsts)
            {
                IrInst* inst = bb->insts[ii];
                u32 instIdx = (u32)inst->base.valData;
                if (!live[instIdx])
                {
                    inst->erase();
                    self.removed++;
                    anyRemoved = true;
                }
                else
                {
                    ii++;
                }
            }
        }

        dealloc<IrInst*>(allInsts);
        dealloc<u8>(live);

        return anyRemoved;
    }
}

pub bool irPassAdce(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    ADCEPass pass = ADCEPass::new(ctx);
    return pass.run(func);
}
