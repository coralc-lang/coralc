#[[no_drop_all]]
import wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import wallvm::irOps { IrOpcode, IrICmpPred };
import wallvm::domtree { IrDomTree, irDomtreeNew, irDomtreeDominates };
import std::mman { alloc, dealloc };

// Condition-constraint propagation, for a cond_br whose condition is
// icmp eq/ne (v, const) (optionally negated), the comparison guarantees
// v == const along one side of the branch. Rewrite v with the constant
// in every block reachable only through that side (dominated by the taken
// target and not dominated by the other target).
pub struct BranchPropPass
{
    IrContext* ctx;
    u64 props;

    static BranchPropPass new(IrContext* ctx)
    {
        return BranchPropPass {
            .ctx = ctx,
            .props = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.props = 0;
        bool changed = false;

        IrDomTree* dom = irDomtreeNew(func);
        if (dom == null) return false;

        u8* inRegion = alloc<u8>((usize)(func->nblocks > 0u ? (usize)func->nblocks : (usize)1));

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (bb->ninsts == 0) continue;
            IrInst* term = bb->insts[bb->ninsts - 1];
            if (term->opcode != IrOpcode::CondBr) continue;
            if (term->nops < 3) continue;

            IrValue* cond = term->ops[0];
            IrValue* tgtT = term->ops[1];
            IrValue* tgtF = term->ops[2];
            if (cond == null || tgtT == null || tgtF == null) continue;

            bool invert = false;
            if (cond->kind == IrValueKind::Inst)
            {
                IrInst* ci = (IrInst*)cond;
                if (ci->opcode == IrOpcode::Not && ci->nops == 1) {
                    invert = true;
                    cond = ci->ops[0];
                }
            }
            if (cond->kind != IrValueKind::Inst) continue;
            IrInst* ci = (IrInst*)cond;
            if (ci->opcode != IrOpcode::ICmp || ci->nops != 2) continue;
            if (ci->icmpPred != IrICmpPred::Eq && ci->icmpPred != IrICmpPred::Ne) continue;

            IrValue* a = ci->ops[0];
            IrValue* b = ci->ops[1];
            IrValue* v = null;
            IrValue* cst = null;
            if (a->kind == IrValueKind::Inst && b->kind == IrValueKind::ConstInt) {
                v = a;
                cst = b;
            }
            else if (b->kind == IrValueKind::Inst && a->kind == IrValueKind::ConstInt) {
                v = b;
                cst = a;
            }
            else continue;
            if (v == null || cst == null) continue;

            // One side guarantees v == c, taken target, Not flips the condition.
            bool takeTrue = (ci->icmpPred == IrICmpPred::Eq) != invert;
            IrValue* subV = takeTrue ? tgtT : tgtF;
            if (subV->kind != IrValueKind::Block) continue;
            IrBlock* subBlock = (IrBlock*)subV;
            if (subBlock == bb) continue;

            // A block is in the region when every path from entry reaches it
            // through the taken edge bb -> subBlock. Dominance by the taken
            // target is not enough, a path that skips the edge (through the
            // other target, or a loop back edge) reaches the block with
            // v != c. Compute reachability with that edge removed and take
            // the complement.
            u32 nb = func->nblocks;
            u8* reachable = alloc<u8>((usize)nb);
            u8* notTaken = alloc<u8>((usize)nb);
            u32* queue = alloc<u32>((usize)nb);
            self.markReachable(func, null, null, reachable, queue);
            self.markReachable(func, bb, subBlock, notTaken, queue);

            bool anyHit = false;
            for (u32 k = 0; k < nb; k++)
            {
                if (reachable[k] != 0 && notTaken[k] == 0)
                {
                    inRegion[k] = 1;
                    anyHit = true;
                }
                else {
                    inRegion[k] = 0;
                }
            }
            dealloc<u8>(reachable);
            dealloc<u8>(notTaken);
            dealloc<u32>(queue);
            if (!anyHit) continue;

            IrValue* cval = self.ctx->constInt(v->type, cst->valData);
            for (u32 k = 0; k < func->nblocks; k++)
            {
                if (!inRegion[k]) continue;
                if (self.rewriteBlock(func->blocks[k], v, cval, inRegion, func))
                    changed = true;
            }
        }

        dealloc<u8>(inRegion);
        return changed;
    }

    // Rewrite uses of v with cval inside a region block. Phi operands are
    // only rewritten for incoming edges from blocks inside the region.
    bool rewriteBlock(IrBlock* bb, IrValue* v, IrValue* cval, u8* inRegion, IrFunc* func)
    {
        bool changed = false;
        for (u32 i = 0; i < bb->ninsts; i++)
        {
            IrInst* inst = bb->insts[i];
            if (inst->opcode == IrOpcode::Phi)
            {
                bool replaced = false;
                for (u32 oi = 1; oi + 1 < inst->nops; oi += 2)
                {
                    if (inst->ops[oi]->kind != IrValueKind::Block) continue;
                    IrBlock* pb = (IrBlock*)inst->ops[oi];
                    u32 pbi = 0;
                    for (u32 k = 0; k < func->nblocks; k++)
                        if (func->blocks[k] == pb) { pbi = k; break; }
                    if (pbi < func->nblocks && inRegion[pbi] && inst->ops[oi - 1] == v)
                    {
                        inst->ops[oi - 1] = cval;
                        replaced = true;
                    }
                }
                if (replaced)
                {
                    v->removeUser(inst);
                    cval->addUser(inst);
                    changed = true;
                }
                continue;
            }

            bool replaced = false;
            for (u32 j = 0; j < inst->nops; j++)
            {
                if (inst->ops[j] == v)
                {
                    inst->ops[j] = cval;
                    replaced = true;
                }
            }
            if (replaced)
            {
                v->removeUser(inst);
                cval->addUser(inst);
                changed = true;
            }
        }
        return changed;
    }

    u32 blockIndex(IrFunc* func, IrBlock* b)
    {
        for (u32 k = 0; k < func->nblocks; k++)
            if (func->blocks[k] == b) return k;
        return func->nblocks;
    }

    u32 pushBlock(IrFunc* func, IrBlock* b, u8* seen, u32* queue, u32 qt)
    {
        u32 bi = self.blockIndex(func, b);
        if (bi >= func->nblocks) return qt;
        if (seen[bi] != 0) return qt;
        seen[bi] = 1;
        queue[qt] = bi;
        return qt + 1;
    }

    // Mark every block reachable from entry. When skipFrom/skipTo are set
    // the single edge skipFrom -> skipTo is not traversed.
    void markReachable(IrFunc* func, IrBlock* skipFrom, IrBlock* skipTo, u8* seen, u32* queue)
    {
        for (u32 k = 0; k < func->nblocks; k++) seen[k] = 0;
        if (func->nblocks == 0) return;
        u32 qt = 0;
        seen[0] = 1;
        queue[qt] = 0;
        qt++;
        u32 qh = 0;
        while (qh < qt)
        {
            IrBlock* cb = func->blocks[queue[qh]];
            qh++;
            IrInst* term = cb->terminator();
            if (term == null) continue;
            if (term->opcode == IrOpcode::Br && term->nops >= 1)
            {
                if (term->ops[0]->kind == IrValueKind::Block &&
                    !(cb == skipFrom && (IrBlock*)term->ops[0] == skipTo))
                    qt = self.pushBlock(func, (IrBlock*)term->ops[0], seen, queue, qt);
            }
            else if (term->opcode == IrOpcode::CondBr && term->nops >= 3)
            {
                if (term->ops[1]->kind == IrValueKind::Block &&
                    !(cb == skipFrom && (IrBlock*)term->ops[1] == skipTo))
                    qt = self.pushBlock(func, (IrBlock*)term->ops[1], seen, queue, qt);
                if (term->ops[2]->kind == IrValueKind::Block &&
                    !(cb == skipFrom && (IrBlock*)term->ops[2] == skipTo))
                    qt = self.pushBlock(func, (IrBlock*)term->ops[2], seen, queue, qt);
            }
        }
    }
}

pub bool irPassBranchProp(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    BranchPropPass pass = BranchPropPass::new(ctx);
    return pass.run(func);
}
