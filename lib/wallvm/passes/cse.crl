#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst };
import(lib) wallvm::irOps { IrOpcode, irOpcodeIsCommutative };

pub struct CSEPass
{
    IrContext* ctx;
    u64 eliminated;

    static CSEPass new(IrContext* ctx)
    {
        return CSEPass {
            .ctx = ctx,
            .eliminated = 0
        };
    }
    // Local CSE within each basic block
    // This pass only removes redundant pure instructions already available
    // earlier in the same block. Calls invalidate all prior entries since they
    // may have side effects on memory.
    bool run(IrFunc* func)
    {
        self.eliminated = 0;
        bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            if (self.processBlock(bb)) changed = true;
        }

        return changed;
    }

    bool processBlock(IrBlock* bb)
    {
        bool changed = false;
        u32 i = 0;
        u32 cseStart = 0;
        while (i < bb->ninsts)
        {
            IrInst* inst = bb->insts[i];

            // Calls may have side effects, invalidate all prior CSE candidates
            if (inst->opcode == IrOpcode::Call)
            {
                cseStart = i + 1;
                i++;
                continue;
            }

            if (!self.isCseCandidate(inst))
            {
                i++;
                continue;
            }

            bool removed = false;
            for (u32 j = cseStart; j < i; j++)
            {
                IrInst* prev = bb->insts[j];
                if (self.areEquivalent(inst, prev))
                {
                    inst->base.replaceAllUses(&prev.base);
                    inst->erase();
                    self.eliminated++;
                    changed = true;
                    removed = true;
                    break;
                }
            }

            if (!removed) i++;
        }
        return changed;
    }

    bool isCseCandidate(IrInst* inst)
    {
        switch (inst->opcode)
        {
            IrOpcode::Add |
            IrOpcode::Sub |
            IrOpcode::Mul |
            IrOpcode::And |
            IrOpcode::Or |
            IrOpcode::Xor |
            IrOpcode::Shl |
            IrOpcode::Lshr |
            IrOpcode::Ashr |
            IrOpcode::SMin |
            IrOpcode::SMax |
            IrOpcode::UMin |
            IrOpcode::UMax |
            IrOpcode::ICmp |
            IrOpcode::FAdd |
            IrOpcode::FSub |
            IrOpcode::FMul |
            IrOpcode::FDiv |
            IrOpcode::FCmp |
            IrOpcode::Trunc |
            IrOpcode::Zext |
            IrOpcode::Sext |
            IrOpcode::FpTrunc |
            IrOpcode::FpExt |
            IrOpcode::FpToSi |
            IrOpcode::SiToFp |
            IrOpcode::FpToUi |
            IrOpcode::UiToFp |
            IrOpcode::Bitcast |
            IrOpcode::Neg |
            IrOpcode::Not |
            IrOpcode::Abs |
            IrOpcode::FAbs |
            IrOpcode::FSqrt |
            IrOpcode::CtPop |
            IrOpcode::CtLz |
            IrOpcode::CtTz |
            IrOpcode::Rotl |
            IrOpcode::Rotr |
            IrOpcode::Bswap |
            IrOpcode::Select => { return true; },

            else => { return false; },
        }
    }

    bool sameOperands(IrInst* a, IrInst* b)
    {
        if (a->nops != b->nops) return false;
        for (u32 i = 0; i < a->nops; i++)
            if (a->ops[i] != b->ops[i]) return false;
        return true;
    }

    bool areEquivalent(IrInst* a, IrInst* b)
    {
        if (a->opcode != b->opcode) return false;
        if (a->base.type != b->base.type) return false;
        if (a->nops != b->nops) return false;
        if (a->opcode == IrOpcode::ICmp && a->icmpPred != b->icmpPred) return false;
        if (a->opcode == IrOpcode::FCmp && a->fcmpPred != b->fcmpPred) return false;

        if (self.sameOperands(a, b)) return true;

        if (a->nops == 2 && irOpcodeIsCommutative(a->opcode))
        {
            if (a->ops[0] == b->ops[1] && a->ops[1] == b->ops[0])
                return true;
        }

        return false;
    }

    u64 eliminatedCount() { return self.eliminated; }
}

pub bool irPassCse(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    CSEPass pass = CSEPass::new(ctx);
    return pass.run(func);
}
