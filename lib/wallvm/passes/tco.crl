#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind, IrTypeKind, IrVarDebugInfo };
import(lib) wallvm::irOps { IrOpcode };
import(lib) std::mman { alloc, dealloc };

// Value map used for remapping during the transform.
struct TcoValMap
{
    IrValue** keys;
    IrValue** vals;
    u32 count;
    u32 cap;

    void init()
    {
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }

    void put(IrValue* k, IrValue* v)
    {
        if (self.count >= self.cap)
        {
            u32 nc = self.cap ? self.cap * 2 : 8;
            IrValue** nk = alloc<IrValue*>((usize)nc);
            IrValue** nv = alloc<IrValue*>((usize)nc);
            for (u32 i = 0; i < self.count; i++)
            {
                nk[i] = self.keys[i];
                nv[i] = self.vals[i];
            }
            if (self.keys != null) dealloc<IrValue*>(self.keys);
            if (self.vals != null) dealloc<IrValue*>(self.vals);
            self.keys = nk;
            self.vals = nv;
            self.cap = nc;
        }
        self.keys[self.count] = k;
        self.vals[self.count] = v;
        self.count++;
    }

    IrValue* get(IrValue* k)
    {
        for (u32 i = 0; i < self.count; i++)
            if (self.keys[i] == k) return self.vals[i];
        return null;
    }

    void free()
    {
        if (self.keys != null) dealloc<IrValue*>(self.keys);
        if (self.vals != null) dealloc<IrValue*>(self.vals);
        self.keys = null;
        self.vals = null;
        self.count = 0;
        self.cap = 0;
    }
}

void destroyInst(IrInst* inst)
{
    if (inst->capOps > 0) dealloc<IrValue*>(inst->ops);
    if (inst->base.capUsers > 0) dealloc<IrInst*>(inst->base.users);
    if (inst->debugLoc.file.ptr != null) dealloc<u8>((u8*)inst->debugLoc.file.ptr);
    if (inst->varDbg != null)
    {
        for (u32 i = 0; i < inst->nvarDbg; i++)
            if (inst->varDbg[i].varName.ptr != null)
                dealloc<u8>((u8*)inst->varDbg[i].varName.ptr);
        dealloc<IrVarDebugInfo>(inst->varDbg);
    }
    dealloc<IrInst>(inst);
}

// unhook + destroy. Only safe when every operand value is still alive;
// batch teardown must unhook everything first (see transform) and then
// destroy, because consumers reference their producers and freeing in
// program order chases freed operands.
void freeInst(IrInst* inst)
{
    for (u32 i = 0; i < inst->nops; i++)
        if (inst->ops[i] != null)
            inst->ops[i]->removeUser(inst);
    destroyInst(inst);
}

void unhookInst(IrInst* inst)
{
    for (u32 i = 0; i < inst->nops; i++)
        if (inst->ops[i] != null)
            inst->ops[i]->removeUser(inst);
}

// Accumulator tail-call transform, converts a self-recursive tail call
// wrapped in one associative combine into a loop with an accumulator.
// Requires the recursive call to be the tail of its block with exactly the
// function's parameters as arguments.
pub struct AccumulatorTcoPass
{
    IrContext* ctx;
    u64 transformed;

    static AccumulatorTcoPass new(IrContext* ctx)
    {
        return AccumulatorTcoPass {
            .ctx = ctx,
            .transformed = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.transformed = 0;
        bool changed = false;
        if (func->nparams == 0) return false;
        if (func->retType == null || func->retType->kind == IrTypeKind::Void) return false;
        if (func->isExtern) return false;
        if (func->nblocks == 0) return false;
        if (self.transform(func))
        {
            self.transformed++;
            changed = true;
        }
        return changed;
    }

    IrValue* remap(IrValue* v, TcoValMap* valMap, TcoValMap* blkMap)
    {
        if (v == null) return null;
        if (v->kind == IrValueKind::Block)
        {
            IrValue* m = blkMap->get(v);
            if (m != null) return m;
            return v;
        }
        // valMap keys inst results and the function's Arg values, so a
        // lookup must not be gated on kind == Inst (params are Args).
        IrValue* m = valMap->get(v);
        if (m != null) return m;
        return v;
    }

    bool transform(IrFunc* func)
    {
        IrBlock* e = func->blocks[0];
        if (e->ninsts == 0) return false;

        IrInst* callInst = null;
        IrBlock* cb = null;
        u32 cbBi = 0;
        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            for (u32 ii = 0; ii < bb->ninsts; ii++)
            {
                IrInst* inst = bb->insts[ii];
                if (inst->opcode == IrOpcode::Call && inst->nops >= 1 &&
                    inst->ops[0] == &func->base)
                {
                    if (callInst != null) return false;
                    callInst = inst;
                    cb = bb;
                    cbBi = bi;
                }
            }
        }
        if (callInst == null || cb == null) return false;
        if (cb->ninsts < 3) return false;

        if (cb->insts[cb->ninsts - 3] != callInst) return false;
        IrInst* comb = cb->insts[cb->ninsts - 2];
        IrInst* retInst = cb->insts[cb->ninsts - 1];
        if (retInst->opcode != IrOpcode::Ret || retInst->nops < 1) return false;
        if (comb->opcode != IrOpcode::Add && comb->opcode != IrOpcode::Mul) return false;
        if (comb->nops != 2) return false;
        IrValue* callRes = &callInst->base;
        if (comb->ops[0] != callRes && comb->ops[1] != callRes) return false;
        if (retInst->ops[0] != &comb->base) return false;
        if (comb->base.nusers != 1) return false;

        IrValue* v = comb->ops[0] == callRes ? comb->ops[1] : comb->ops[0];
        if (v == callRes) return false;

        u32 nargs = callInst->nops > 0 ? callInst->nops - 1 : 0;
        if (nargs != func->nparams) return false;

        for (u32 i = 1; i < callInst->nops; i++)
        {
            IrValue* a = callInst->ops[i];
            if (a == null || a == callRes || a == &comb->base || a == &retInst->base) return false;
        }
        if (v == &comb->base || v == &retInst->base) return false;

        IrValue* ident = (comb->opcode == IrOpcode::Add)
            ? self.ctx->constInt(comb->base.type, 0)
            : self.ctx->constInt(comb->base.type, 1);

        // Capture the original block count before acc_loop is appended: the
        // clone pass below must cover only the originals, and the teardown
        // walks this fixed range.
        u32 nblocks = func->nblocks;

        IrBlock* ne = self.ctx->createBlock("acc_loop");
        func->addBlock(ne);

        IrInst* accPhi = null;
        {
            IrValue*[4] ops = { ident, &e->base, &e->base, &e->base };
            accPhi = self.ctx->createInst(IrOpcode::Phi, comb->base.type, ops, 4, 0, 0);
            ident->addUser(accPhi);
            e->base.addUser(accPhi);
            ne->addInst(accPhi);
        }
        IrInst** argPhi = alloc<IrInst*>((usize)func->nparams);
        for (u32 i = 0; i < func->nparams; i++)
        {
            IrValue* arg = func->args[i];
            IrValue*[4] ops = { arg, &e->base, &e->base, &e->base };
            argPhi[i] = self.ctx->createInst(IrOpcode::Phi, arg->type, ops, 4, 0, 0);
            arg->addUser(argPhi[i]);
            e->base.addUser(argPhi[i]);
            ne->addInst(argPhi[i]);
        }

        TcoValMap valMap;
        valMap.init();
        TcoValMap blkMap;
        blkMap.init();
        // The entry block does not define the params (they are Arg values);
        // map them so every cloned use branches through the loop phi.
        for (u32 i = 0; i < func->nparams; i++)
            valMap.put(func->args[i], &argPhi[i]->base);

        IrBlock** clones = alloc<IrBlock*>((usize)nblocks);
        for (u32 bi = 0; bi < nblocks; bi++)
        {
            IrBlock* ob = func->blocks[bi];
            IrBlock* nb = self.ctx->createBlock(ob->base.name);
            func->addBlock(nb);
            clones[bi] = nb;
            blkMap.put(&ob->base, &nb->base);
        }

        for (u32 bi = 0; bi < nblocks; bi++)
        {
            IrBlock* ob = func->blocks[bi];
            IrBlock* nb = clones[bi];
            // Params are Arg values, not entry insts: clone the entry body whole.
            u32 start = 0;
            u32 end = (ob == cb) ? ob->ninsts - 3 : ob->ninsts;
            for (u32 ii = start; ii < end; ii++)
                self.cloneInst(ob->insts[ii], nb, &valMap, &blkMap);

            if (ob != cb && nb->ninsts > 0)
            {
                IrInst* term = nb->insts[nb->ninsts - 1];
                if (term->opcode == IrOpcode::Br && term->nops >= 1)
                {
                    IrValue* tgt = self.remap(term->ops[0], &valMap, &blkMap);
                    if (tgt != null && tgt->kind == IrValueKind::Block)
                        nb->addSucc((IrBlock*)tgt);
                }
                else if (term->opcode == IrOpcode::CondBr && term->nops >= 3)
                {
                    IrValue* t1 = self.remap(term->ops[1], &valMap, &blkMap);
                    IrValue* t2 = self.remap(term->ops[2], &valMap, &blkMap);
                    if (t1 != null && t1->kind == IrValueKind::Block)
                        nb->addSucc((IrBlock*)t1);
                    if (t2 != null && t2->kind == IrValueKind::Block)
                        nb->addSucc((IrBlock*)t2);
                }
            }
        }

        {
            IrValue*[1] ops = { &clones[0]->base };
            IrInst* brInst = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
            ops[0]->addUser(brInst);
            ne->addInst(brInst);
            ne->addSucc(clones[0]);
        }

        if (cb != e)
        {
            IrInst* capterm = e->insts[e->ninsts - 1];
            for (u32 i = e->nsuccs; i > 0; i--)
                e->succs[i - 1]->removePred(e);
            if (e->succs != null) dealloc<IrBlock*>(e->succs);
            e->succs = null;
            e->nsuccs = 0;
            e->capSuccs = 0;
            freeInst(capterm);
            e->ninsts--;
        }
        {
            IrValue*[1] ops = { &ne->base };
            IrInst* brInst = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
            ops[0]->addUser(brInst);
            e->addInst(brInst);
            e->addSucc(ne);
        }

        IrBlock* cbClone = clones[cbBi];
        IrValue* vv = self.remap(v, &valMap, &blkMap);
        IrValue*[2] accOps = { &accPhi->base, vv };
        IrInst* accNext = self.ctx->createInst(comb->opcode, comb->base.type, accOps, 2, 0, 0);
        accOps[0]->addUser(accNext);
        accOps[1]->addUser(accNext);
        cbClone->addInst(accNext);

        for (u32 i = 0; i < func->nparams; i++)
        {
            IrValue* an = self.remap(callInst->ops[i + 1], &valMap, &blkMap);
            argPhi[i]->ops[2] = an;
            argPhi[i]->ops[3] = &cbClone->base;
            an->addUser(argPhi[i]);
            cbClone->base.addUser(argPhi[i]);
        }
        accPhi->ops[2] = &accNext->base;
        accPhi->ops[3] = &cbClone->base;
        accNext->base.addUser(accPhi);
        cbClone->base.addUser(accPhi);

        {
            IrValue*[1] ops = { &ne->base };
            IrInst* brInst = self.ctx->createInst(IrOpcode::Br, self.ctx->tyVoid(), ops, 1, 0, 0);
            ops[0]->addUser(brInst);
            cbClone->addInst(brInst);
            cbClone->addSucc(ne);
        }

        for (u32 bi = 0; bi < nblocks; bi++)
        {
            IrBlock* ob = func->blocks[bi];
            if (ob == cb) continue;
            IrBlock* nb = clones[bi];
            // Walk backwards: insertBefore(final, inst) shifts insts right, so a
            // forward walk would re-visit the shifted Ret forever.
            for (u32 ii = nb->ninsts; ii > 0; ii--)
            {
                IrInst* inst = nb->insts[ii - 1];
                if (inst->opcode != IrOpcode::Ret || inst->nops < 1) continue;
                IrValue* baseVal = inst->ops[0];
                IrValue*[2] fops = { &accPhi->base, baseVal };
                IrInst* final = self.ctx->createInst(comb->opcode, comb->base.type, fops, 2, 0, 0);
                fops[0]->addUser(final);
                fops[1]->addUser(final);
                baseVal->removeUser(inst);
                inst->ops[0] = &final->base;
                final->base.addUser(inst);
                nb->insertBefore(final, inst);
            }
        }

        // removeBlock shift-lefts func->blocks, so iterating indices would skip
        // every other original. Walk a snapshot of the originals instead; block 0
        // (the entry, now branching to acc_loop) is kept. Unhook every edge first:
        // originals reference each other (loop back-edges), so freeing as we go
        // would chase dead pointers. Nothing below points at the originals from
        // outside (entry/acc_loop/clones are all already rewired).
        IrBlock** origs = alloc<IrBlock*>((usize)nblocks);
        for (u32 bi = 0; bi < nblocks; bi++) origs[bi] = func->blocks[bi];
        for (u32 bi = 1; bi < nblocks; bi++)
        {
            IrBlock* ob = origs[bi];
            for (u32 si = 0; si < ob->nsuccs; si++)
                ob->succs[si]->removePred(ob);
            for (u32 pi = 0; pi < ob->npreds; pi++)
                ob->preds[pi]->removeSucc(ob);
        }
        // Unhook every inst's operand user-links while all values are still
        // alive: consumers reference their producers, so freeing in program
        // order would make removeUser chase freed operands.
        for (u32 bi = 1; bi < nblocks; bi++)
        {
            IrBlock* ob = origs[bi];
            for (u32 ii = 0; ii < ob->ninsts; ii++)
                unhookInst(ob->insts[ii]);
        }
        for (u32 bi = 1; bi < nblocks; bi++)
        {
            IrBlock* ob = origs[bi];
            for (u32 ii = 0; ii < ob->ninsts; ii++)
                destroyInst(ob->insts[ii]);
            if (ob->insts != null) dealloc<IrInst*>(ob->insts);
            if (ob->preds != null) dealloc<IrBlock*>(ob->preds);
            if (ob->succs != null) dealloc<IrBlock*>(ob->succs);
            func->removeBlock(ob);
            dealloc<IrBlock>(ob);
        }
        dealloc<IrBlock*>(origs);

        // e keeps only its trailing `br acc_loop`; its body was cloned into
        // the entry clone (params are Arg values, not insts to slice off).
        {
            IrInst* eBr = e->insts[e->ninsts - 1];
            for (u32 ii = 0; ii < e->ninsts - 1; ii++)
                unhookInst(e->insts[ii]);
            for (u32 ii = 0; ii < e->ninsts - 1; ii++)
                destroyInst(e->insts[ii]);
            e->insts[0] = eBr;
            e->ninsts = 1;
        }

        valMap.free();
        blkMap.free();
        dealloc<IrBlock*>(clones);
        dealloc<IrInst*>(argPhi);
        return true;
    }

    IrInst* cloneInst(IrInst* old, IrBlock* nb, TcoValMap* valMap, TcoValMap* blkMap)
    {
        IrValue** newOps = alloc<IrValue*>((usize)(old->nops > 0u ? (usize)old->nops : (usize)1));
        for (u32 i = 0; i < old->nops; i++)
        {
            IrValue* op = old->ops[i];
            if (op == null) { newOps[i] = null; continue; }
            if (op->kind == IrValueKind::Block)
            {
                IrValue* m = blkMap->get(op);
                if (m != null) { newOps[i] = m; continue; }
            }
            else
            {
                // inst results and Arg params both live in valMap
                IrValue* m = valMap->get(op);
                if (m != null) { newOps[i] = m; continue; }
            }
            newOps[i] = op;
        }
        IrInst* ni = self.ctx->createInst(old->opcode, old->base.type, newOps, old->nops,
                                          (u64)old->icmpPred, (u64)old->fcmpPred);
        nb->addInst(ni);
        valMap->put(&old->base, &ni->base);
        for (u32 i = 0; i < old->nops; i++)
            if (newOps[i] != null)
                newOps[i]->addUser(ni);
        dealloc<IrValue*>(newOps);
        return ni;
    }
}

pub bool irPassAccumulate(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    AccumulatorTcoPass pass = AccumulatorTcoPass::new(ctx);
    return pass.run(func);
}
