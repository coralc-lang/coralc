#[[no_drop_all]]
import(lib) wallvm::irtypes { IrContext, IrFunc, IrBlock, IrInst, IrValue, IrValueKind };
import(lib) wallvm::irOps { IrOpcode, IrICmpPred };
import(lib) std::mman { alloc };

// Peephole optimizer, local pattern-matching rewrites on adjacent instructions.
// Runs after the main optimization pipeline and before register allocation to
// catch patterns exposed by earlier passes.
pub struct PeepholePass
{
    IrContext* ctx;
    u64 rewrites;

    static PeepholePass new(IrContext* ctx)
    {
        return PeepholePass {
            .ctx = ctx,
            .rewrites = 0
        };
    }

    bool run(IrFunc* func)
    {
        self.rewrites = 0;
        #[[maybe_unused]] bool changed = false;

        for (u32 bi = 0; bi < func->nblocks; bi++)
        {
            IrBlock* bb = func->blocks[bi];
            bool blockChanged = true;
            while (blockChanged)
            {
                blockChanged = false;
                u32 ii = 0;
                while (ii < bb->ninsts)
                {
                    IrInst* inst = bb->insts[ii];

                    // Every fold here erases in place, so I leave the index alone
                    // and let the loop reread whatever slid into this slot.

                    // Pattern, add x, 0 -> x  (catches post-constfold residual)
                    if (inst->opcode == IrOpcode::Add && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst->ops[0]->kind ==
                            IrValueKind::ConstInt && inst->ops[0]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[1]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, x + x -> x << 1 (strength reduction)
                    if (inst->opcode == IrOpcode::Add && inst->nops == 2 &&
                        inst->ops[0] == inst->ops[1])
                    {
                        IrValue* shiftVal = self.ctx->constInt(inst->base.type, 1);
                        IrValue*[2] shiftOps = { inst->ops[0], shiftVal };
                        IrInst* shl =
                            self.ctx->createInst(IrOpcode::Shl, inst->base.type, shiftOps, 2, 0, 0);
                        shiftOps[0]->addUser(shl);
                        shiftOps[1]->addUser(shl);
                        inst->parent->insertBefore(shl, inst);
                        inst->base.replaceAllUses(&shl->base);
                        inst->erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern, sub x, 0 -> x
                    if (inst->opcode == IrOpcode::Sub && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, mul x, 1 -> x
                    if (inst->opcode == IrOpcode::Mul && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == 1)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst->ops[0]->kind ==
                            IrValueKind::ConstInt && inst->ops[0]->valData == 1)
                        {
                            inst->base.replaceAllUses(inst->ops[1]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, x * -1 -> neg(x) (strength reduction)
                    if (inst->opcode == IrOpcode::Mul && inst->nops == 2)
                    {
                        u32 bits = inst->base.type != null ? inst->base.type->width : 64;
                        u64 allOnes = (bits >= 64u) ? (u64)~0 : (((u64)1 << (u64)bits) - (u64)1);
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == allOnes)
                        {
                            IrValue*[1] ops = { inst->ops[0] };
                            IrInst* neg =
                                self.ctx->createInst(IrOpcode::Neg, inst->base.type, ops, 1, 0, 0);
                            ops[0]->addUser(neg);
                            inst->parent->insertBefore(neg, inst);
                            inst->base.replaceAllUses(&neg->base);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        if (inst->ops[0]->kind ==
                            IrValueKind::ConstInt && inst->ops[0]->valData == allOnes)
                        {
                            IrValue*[1] ops = { inst->ops[1] };
                            IrInst* neg =
                                self.ctx->createInst(IrOpcode::Neg, inst->base.type, ops, 1, 0, 0);
                            ops[0]->addUser(neg);
                            inst->parent->insertBefore(neg, inst);
                            inst->base.replaceAllUses(&neg->base);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, and x, -1 -> x
                    if (inst->opcode == IrOpcode::And && inst->nops == 2)
                    {
                        u32 bits = inst->base.type != null ? inst->base.type->width : 64;
                        u64 allOnes = (bits >= 64u) ? (u64)~0 : (((u64)1 << (u64)bits) - (u64)1);
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == allOnes)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // Pattern, and x, 0 -> 0
                        // I keep this fold nested under the -1 check where the old
                        // file grouped both And patterns in one block.
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            IrValue* zero = self.ctx->constInt(inst->base.type, 0);
                            inst->base.replaceAllUses(zero);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, or x, 0 -> x
                    if (inst->opcode == IrOpcode::Or && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // Pattern, or x, -1 -> -1
                        u32 bits = inst->base.type != null ? inst->base.type->width : 64;
                        u64 allOnes = (bits >= 64u) ? (u64)~0 : (((u64)1 << (u64)bits) - (u64)1);
                        if (inst->ops[1]->kind ==
                            IrValueKind::ConstInt && inst->ops[1]->valData == allOnes)
                        {
                            IrValue* ones = self.ctx->constInt(inst->base.type, allOnes);
                            inst->base.replaceAllUses(ones);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, shl x, 0 -> x
                    if (inst->opcode == IrOpcode::Shl && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind
                            == IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, lshr x, 0 -> x, ashr x, 0 -> x
                    if ((inst->opcode ==
                        IrOpcode::Lshr || inst->opcode ==
                        IrOpcode::Ashr) && inst->nops == 2)
                    {
                        if (inst->ops[1]->kind == IrValueKind::ConstInt && inst->ops[1]->valData == 0)
                        {
                            inst->base.replaceAllUses(inst->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, icmp eq x, x -> true (1), icmp ne x, x -> false (0)
                    if (inst->opcode == IrOpcode::ICmp && inst->nops == 2)
                    {
                        if (inst->ops[0] == inst->ops[1])
                        {
                            u64 result = (inst->icmpPred == IrICmpPred::Eq ||
                                          inst->icmpPred == IrICmpPred::Sle ||
                                          inst->icmpPred == IrICmpPred::Ule ||
                                          inst->icmpPred == IrICmpPred::Sge ||
                                          inst->icmpPred == IrICmpPred::Uge) ? 1 : 0;
                            IrValue* cval = self.ctx->constInt(inst->base.type, result);
                            inst->base.replaceAllUses(cval);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, select(true, x, y) -> x, select(false, x, y) -> y
                    if (inst->opcode == IrOpcode::Select && inst->nops >= 3)
                    {
                        if (inst->ops[0]->kind == IrValueKind::ConstInt)
                        {
                            IrValue* result = (inst->ops[0]->valData != 0) ? inst->ops[1] : inst->ops[2];
                            inst->base.replaceAllUses(result);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                        // select(cond, x, x) -> x
                        if (inst->ops[1] == inst->ops[2])
                        {
                            inst->base.replaceAllUses(inst->ops[1]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, neg(neg(x)) -> x
                    if (inst->opcode == IrOpcode::Neg && inst->nops == 1 &&
                        inst->ops[0]->kind == IrValueKind::Inst)
                    {
                        IrInst* inner = (IrInst*)inst->ops[0];
                        if (inner->opcode == IrOpcode::Neg && inner->nops == 1)
                        {
                            inst->base.replaceAllUses(inner->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, not(not(x)) -> x
                    if (inst->opcode == IrOpcode::Not && inst->nops == 1 &&
                        inst->ops[0]->kind == IrValueKind::Inst)
                    {
                        IrInst* inner = (IrInst*)inst->ops[0];
                        if (inner->opcode == IrOpcode::Not && inner->nops == 1)
                        {
                            inst->base.replaceAllUses(inner->ops[0]);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, x ^ x -> 0
                    if (inst->opcode == IrOpcode::Xor && inst->nops == 2 && inst->ops[0] == inst->ops[1])
                    {
                        IrValue* zero = self.ctx->constInt(inst->base.type, 0);
                        inst->base.replaceAllUses(zero);
                        inst->erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern, x - x -> 0
                    if (inst->opcode == IrOpcode::Sub && inst->nops == 2 && inst->ops[0] == inst->ops[1])
                    {
                        IrValue* zero = self.ctx->constInt(inst->base.type, 0);
                        inst->base.replaceAllUses(zero);
                        inst->erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern, smin(x, x) -> x, smax(x, x) -> x, umin(x, x) -> x, umax(x, x) -> x
                    if ((inst->opcode == IrOpcode::SMin ||
                         inst->opcode == IrOpcode::SMax ||
                         inst->opcode == IrOpcode::UMin ||
                         inst->opcode == IrOpcode::UMax) &&
                        inst->nops == 2 && inst->ops[0] == inst->ops[1])
                    {
                        inst->base.replaceAllUses(inst->ops[0]);
                        inst->erase();
                        self.rewrites++;
                        blockChanged = true;
                        continue;
                    }

                    // Pattern, sext(zext(x)) -> zext(x) if sext width matches
                    if (inst->opcode == IrOpcode::Sext && inst->nops == 1 &&
                        inst->ops[0]->kind == IrValueKind::Inst)
                    {
                        IrInst* inner = (IrInst*)inst->ops[0];
                        if (inner->opcode == IrOpcode::Zext && inner->nops == 1)
                        {
                            // The sign bit is 0 from zext, so sext is same as zext
                            IrValue*[1] ops = { inner->ops[0] };
                            IrInst* ni =
                                self.ctx->createInst(IrOpcode::Zext, inst->base.type, ops, 1, 0, 0);
                            ops[0]->addUser(ni);
                            inst->parent->insertBefore(ni, inst);
                            inst->base.replaceAllUses(&ni->base);
                            inst->erase();
                            self.rewrites++;
                            blockChanged = true;
                            continue;
                        }
                    }

                    // Pattern, trunc(zext(x)) -> x if widths match
                    if (inst->opcode == IrOpcode::Trunc && inst->nops == 1 &&
                        inst->ops[0]->kind == IrValueKind::Inst)
                    {
                        IrInst* inner = (IrInst*)inst->ops[0];
                        if (inner->opcode == IrOpcode::Zext && inner->nops == 1)
                        {
                            u32 outW = inst->base.type != null ? inst->base.type->width : 64;
                            u32 innerW = inner->ops[0]->type != null ? inner->ops[0]->type->width : 64;
                            if (outW == innerW)
                            {
                                inst->base.replaceAllUses(inner->ops[0]);
                                inst->erase();
                                self.rewrites++;
                                blockChanged = true;
                                continue;
                            }
                        }
                    }

                    // Pattern, br to block that only contains br -> redirect
                    if (inst->opcode == IrOpcode::Br && inst->nops == 1 &&
                        inst->ops[0]->kind == IrValueKind::Block)
                    {
                        IrBlock* target = (IrBlock*)inst->ops[0];
                        if (target->ninsts == 1)
                        {
                            IrInst* targetTerm = target->insts[0];
                            if (targetTerm->opcode == IrOpcode::Br && targetTerm->nops == 1)
                            {
                                IrBlock* finalTarget = (IrBlock*)targetTerm->ops[0];
                                if (finalTarget != target)
                                {
                                    // Dominance check, skip if target is a PHI predecessor
                                    bool isPhiPred = false;
                                    for (u32 pi = 0; pi < func->nblocks && !isPhiPred; pi++)
                                    {
                                        IrBlock* pb = func->blocks[pi];
                                        for (u32 pj = 0; pj < pb->ninsts && !isPhiPred; pj++)
                                        {
                                            IrInst* phi = pb->insts[pj];
                                            if (phi->opcode == IrOpcode::Phi)
                                            {
                                                for (u32 pk = 1; pk < phi->nops; pk += 2)
                                                {
                                                    if (phi->ops[pk] == &target->base)
                                                    {
                                                        isPhiPred = true;
                                                        break;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if (!isPhiPred)
                                    {
                                        inst->ops[0]->removeUser(inst);
                                        target->removePred(bb);
                                        targetTerm->ops[0]->addUser(inst);
                                        inst->ops[0] = &finalTarget->base;
                                        finalTarget->addPred(bb);

                                        // Update PHI nodes in finalTarget to include the new predecessor
                                        for (u32 pi = 0; pi < finalTarget->ninsts; pi++)
                                        {
                                            IrInst* phi = finalTarget->insts[pi];
                                            if (phi->opcode != IrOpcode::Phi) break;

                                            // Add a default incoming value for the new predecessor
                                            // The old file wrote bare ctx on this line, I read
                                            // it as this pass's own field.
                                            u32 newOpsCount = phi->nops + 2;
                                            IrValue** newOps = alloc<IrValue*>((usize)newOpsCount);
                                            for (u32 oi = 0; oi < phi->nops; oi++)
                                                newOps[oi] = phi->ops[oi];
                                            newOps[phi->nops] = phi->base.type != null ? self.ctx->constInt(phi->base.type, 0) : null;
                                            newOps[phi->nops + 1] = &bb->base;
                                            if (newOps[phi->nops] != null) newOps[phi->nops]->addUser(phi);
                                            bb->base.addUser(phi);
                                            phi->ops = newOps;
                                            phi->nops = newOpsCount;
                                        }

                                        bb->succs[0] = finalTarget;
                                        self.rewrites++;
                                        blockChanged = true;
                                        continue;
                                    }
                                }
                            }
                        }
                    }

                    ii++;
                }
            }
        }

        return self.rewrites > 0;
    }
}

pub bool irPassPeephole(IrFunc* func, rawptr userdata)
{
    IrContext* ctx = (IrContext*)userdata;
    if (ctx == null || func == null) return false;
    PeepholePass pass = PeepholePass::new(ctx);
    return pass.run(func);
}
