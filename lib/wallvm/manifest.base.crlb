# wallvm base manifest — mirrors std's. wallvm has no platform files of
# its own, so there is no platform_root here; platform selection happens
# when `import(lib) std` inside these sources resolves through std's own
# manifests (manifest.linux.crlb / manifest.windows.crlb).
#
# See coral-docs/builder_incomplete.md — include/extends/platform_root
# resolution is not implemented in the builder yet.

schema = 1;
strict = true;

build "wallvm" {
    root          = "lib/wallvm/";
    modules       = ["wallvm"];
    platform_root = "";
}
