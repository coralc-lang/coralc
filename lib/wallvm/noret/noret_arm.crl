#[[no_drop_all]]
import(lib) std::string { String };

pub struct NoretArm
{
    u64 exitCode;
    String out;

    NoretArm new(u64 exitCode)
    {
        return NoretArm {
            .exitCode = exitCode,
            .out = String::new()
        };
    }

    void c(u8 ch)
    {
        self.out.pushChar(ch);
    }

    void s(str s) // on sum '.s()' shit
    {
        self.out.pushView(s);
    }

    str getString()
    {
        return self.out.asView();
    }

    void clear()
    {
        self.out.clear();
    }

    void destroy()
    {
        self.out.free();
    }

    void emitLinuxSyscall()
    {
        self.emitMovImm("r0", self.exitCode);
        self.c('\n');
        self.emitMovImm("r7", 1);
        self.c('\n');
        self.s("\tsvc #0");
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovImm("r0", self.exitCode);
        self.c('\n');
        self.s("\tbl ExitProcess");
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.s(".halt:");
        self.c('\n');
        self.s("\twfi");
        self.c('\n');
        self.s("\tb .halt");
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, "LINUX"))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, "WINDOWS"))
            self.emitWindowsTerminate();
        else
            self.emitBareMetalHalt();
    }

    void emitMovImm(str reg, u64 imm)
    {
        self.s("\tmov ");
        self.s(reg);
        self.s(", #");
        u64 val = imm;
        u8[24] buf;
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (u8)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }
}

bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (usize i = 0; i < platform.len; i++)
    {
        u8 a = (u8)platform.ptr[i];
        u8 k = (u8)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
