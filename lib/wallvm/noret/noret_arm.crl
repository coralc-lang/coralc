#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, copy };

pub struct NoretArm
{
    u64 exitCode;
    u8* out;
    u32 outLen;
    u32 outCap;

    NoretArm new(u64 exitCode)
    {
        return NoretArm {
            .exitCode = exitCode,
            .out = null,
            .outLen = 0,
            .outCap = 0
        };
    }

    void ensureCap(u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        u8* newOut = alloc<u8>((usize)newCap);
        if (self.out != null)
        {
            copy<u8>(newOut, self.out, (usize)self.outLen);
            dealloc<u8>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(u8 ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(str s) // on sum '.s()' shit
    {
        self.ensureCap((u32)s.len);
        for (usize i = 0; i < s.len; i++)
            self.out[self.outLen++] = (u8)s.ptr[i];
    }

    str getString()
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return str::fromParts((const u8*)self.out, (usize)self.outLen);
    }

    void clear()
    {
        self.outLen = 0;
    }

    void destroy()
    {
        if (self.out != null) dealloc<u8>(self.out);
    }

    void emitLinuxSyscall()
    {
        self.emitMovImm("r0", self.exitCode);
        self.c('\n');
        self.emitMovImm("r7", 1);
        self.c('\n');
        self.s("\tsvc #0");
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovImm("r0", self.exitCode);
        self.c('\n');
        self.s("\tbl ExitProcess");
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.s(".halt:");
        self.c('\n');
        self.s("\twfi");
        self.c('\n');
        self.s("\tb .halt");
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, "LINUX"))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, "WINDOWS"))
            self.emitWindowsTerminate();
        else
            self.emitBareMetalHalt();
    }

    void emitMovImm(str reg, u64 imm)
    {
        self.s("\tmov ");
        self.s(reg);
        self.s(", #");
        u64 val = imm;
        u8 buf[24];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (u8)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }
}

bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (usize i = 0; i < platform.len; i++)
    {
        u8 a = (u8)platform.ptr[i];
        u8 k = (u8)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
