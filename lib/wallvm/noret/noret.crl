#[[no_drop_all]]
import(lib) std::mman { alloc };
import(lib) wallvm::irtypes { IrInst };
import(lib) wallvm::irOps { IrOpcode };
import(lib) wallvm::rules::asm_rules { CallingConvention, ABIRules, sysvAbi, win64Abi, aapcs64Abi, aapcs64MacOsAbi, aapcsAbi, cdeclAbi, riscv64Abi, ppc64Abi, ppcAbi, mips64Abi, mipsAbi, sparcV9Abi, winX86_32Abi, x86_64SyscallAbi, x86SyscallAbi, arm64SyscallAbi, armSyscallAbi, riscv64SyscallAbi, wasm32Abi, wasm64Abi, noretTemplate };

pub str KNOWN_ARCHS[] = {
    "x86_64", "x86", "x86_32",
    "arm64", "arm",
    "riscv64",
    "ppc64", "ppc",
    "mips64", "mips",
    "sparcv9",
    "wasm32", "wasm64",
    ""
};

bool archMatch(str arch, str known)
{
    if (arch.isEmpty() || known.isEmpty()) return false;
    if (arch.len != known.len) return false;
    for (u32 i = 0; i < arch.len; i++)
    {
        u8 a = arch.ptr[i];
        u8 k = known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}

pub bool hasNoretSupport(str arch)
{
    if (arch.isEmpty()) return false;
    u32 count = sizeof(KNOWN_ARCHS) / sizeof(KNOWN_ARCHS[0]);
    for (u32 i = 0; i < count; i++)
        if (!KNOWN_ARCHS[i].isEmpty() && archMatch(arch, KNOWN_ARCHS[i])) return true;
    return false;
}

pub bool isNoret(IrInst* inst)
{
    if (inst == null) return false;
    return inst->opcode == IrOpcode::Noret;
}

struct ArchCcEntry { str name; CallingConvention cc; }

static ArchCcEntry ARCH_CC_MAP[] = {
    { "x86_64", CallingConvention::SystemV },
    { "x86_32", CallingConvention::Cdecl },
    { "x86", CallingConvention::Cdecl },
    { "arm64", CallingConvention::Aapcs64 },
    { "arm", CallingConvention::Aapcs },
    { "riscv64", CallingConvention::Riscv64 },
    { "ppc64", CallingConvention::Ppc64 },
    { "ppc", CallingConvention::Ppc },
    { "mips64", CallingConvention::Mips64 },
    { "mips", CallingConvention::Mips },
    { "sparcv9", CallingConvention::SparcV9 },
    { "wasm32", CallingConvention::Wasm32 },
    { "wasm64", CallingConvention::Wasm64 },
    { "", CallingConvention::SystemV }
};

CallingConvention archToCallingConvention(str arch)
{
    if (arch.isEmpty()) return CallingConvention::SystemV;
    for (u32 i = 0; !ARCH_CC_MAP[i].name.isEmpty(); i++)
        if (archMatch(arch, ARCH_CC_MAP[i].name))
            return ARCH_CC_MAP[i].cc;
    return CallingConvention::SystemV;
}

ABIRules abiForArch(str arch)
{
    switch (archToCallingConvention(arch))
    {
        CallingConvention::SystemV => { return sysvAbi(); },
        CallingConvention::Win64 => { return win64Abi(); },
        CallingConvention::Aapcs64 => { return aapcs64Abi(); },
        CallingConvention::Aapcs64MacOs => { return aapcs64MacOsAbi(); },
        CallingConvention::Aapcs => { return aapcsAbi(); },
        CallingConvention::Cdecl => { return cdeclAbi(); },
        CallingConvention::Riscv64 => { return riscv64Abi(); },
        CallingConvention::Ppc64 => { return ppc64Abi(); },
        CallingConvention::Ppc => { return ppcAbi(); },
        CallingConvention::Mips64 => { return mips64Abi(); },
        CallingConvention::Mips => { return mipsAbi(); },
        CallingConvention::SparcV9 => { return sparcV9Abi(); },
        CallingConvention::WinX86_32 => { return winX86_32Abi(); },
        CallingConvention::SyscallX86_64 => { return x86_64SyscallAbi(); },
        CallingConvention::SyscallX86 => { return x86SyscallAbi(); },
        CallingConvention::SyscallArm64 => { return arm64SyscallAbi(); },
        CallingConvention::SyscallArm => { return armSyscallAbi(); },
        CallingConvention::SyscallRiscv64 => { return riscv64SyscallAbi(); },
        CallingConvention::Wasm32 => { return wasm32Abi(); },
        CallingConvention::Wasm64 => { return wasm64Abi(); },
        else => { return sysvAbi(); },
    }
}

pub str emitNoret(str arch, i32 exitCode)
{
    ABIRules abi = abiForArch(arch);
    str tmpl = noretTemplate(&abi);

    u32 len = 0;
    for (u32 i = 0; i < tmpl.len; i++)
    {
        if (i + 9 < tmpl.len && tmpl.ptr[i] == '$' && tmpl.ptr[i+1] == 'e' && tmpl.ptr[i+2] == 'x' && tmpl.ptr[i+3] == 'i' &&
            tmpl.ptr[i+4] == 't' && tmpl.ptr[i+5] == '_' && tmpl.ptr[i+6] == 'c' && tmpl.ptr[i+7] == 'o' &&
            tmpl.ptr[i+8] == 'd' && tmpl.ptr[i+9] == 'e')
        {
            u32 code = (u32)(exitCode >= 0 ? exitCode : -exitCode);
            len++;
            while (code >= 10) { code /= 10; len++; }
            if (exitCode < 0) len++;
            i += 9;
        }
        else if (i + 1 < tmpl.len && tmpl.ptr[i] == '\\' && tmpl.ptr[i+1] == 'n')
        {
            len++;
            i++;
        }
        else {
            len++;
        }
    }

    u8* result = alloc<u8>((usize)(len + 1));
    u32 pos = 0;
    for (u32 i = 0; i < tmpl.len; i++)
    {
        if (i + 9 < tmpl.len && tmpl.ptr[i] == '$' && tmpl.ptr[i+1] == 'e' && tmpl.ptr[i+2] == 'x' && tmpl.ptr[i+3] == 'i' &&
            tmpl.ptr[i+4] == 't' && tmpl.ptr[i+5] == '_' && tmpl.ptr[i+6] == 'c' && tmpl.ptr[i+7] == 'o' &&
            tmpl.ptr[i+8] == 'd' && tmpl.ptr[i+9] == 'e')
        {
            i += 9;
            i32 code = exitCode;
            if (code < 0) { result[pos++] = '-'; code = -code; }
            u32 c = (u32)code;
            u32 digits[16];
            u32 nd = 0;
            if (c == 0) digits[nd++] = 0;
            else while (c != 0) { digits[nd++] = c % 10; c /= 10; }
            for (i32 d = (i32)nd - 1; d >= 0; d--)
                result[pos++] = (u8)('0' + digits[d]);
        }
        else if (i + 1 < tmpl.len && tmpl.ptr[i] == '\\' && tmpl.ptr[i+1] == 'n')
        {
            result[pos++] = '\n';
            i++;
        }
        else {
            result[pos++] = tmpl.ptr[i];
        }
    }
    result[pos] = 0;
    return str::fromParts((const u8*)result, len);
}
