#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, copy };

pub struct NoretBare
{
    u64 exitCode;
    u8* out;
    u32 outLen;
    u32 outCap;

    NoretBare new(u64 exitCode)
    {
        return NoretBare {
            .exitCode = exitCode,
            .out = null,
            .outLen = 0,
            .outCap = 0
        };
    }

    void ensureCap(u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        u8* newOut = alloc<u8>((usize)newCap);
        if (self.out != null)
        {
            copy<u8>(newOut, self.out, self.outLen);
            dealloc<u8>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(u8 ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(str s)
    {
        self.ensureCap(s.len);
        for (u32 i = 0; i < s.len; i++)
            self.out[self.outLen++] = (u8)s.ptr[i];
    }

    str getString()
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return str::fromParts((const u8*)self.out, self.outLen);
    }

    void clear()
    {
        self.outLen = 0;
    }

    void destroy()
    {
        if (self.out != null) dealloc<u8>(self.out);
    }

    void emitHalt(str arch)
    {
        if (bareArchMatch(arch, "x86_64") || bareArchMatch(arch, "x86") || bareArchMatch(arch, "x86_32"))
        {
            self.s("\tcli");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\thlt");
            self.c('\n');
            self.s("\tjmp .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "arm64"))
        {
            self.s("\tmsr daifset, #2");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "arm"))
        {
            self.s("\tcpsid i");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "riscv64"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tj .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "ppc64") || bareArchMatch(arch, "ppc"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "mips64") || bareArchMatch(arch, "mips"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tj .halt");
            self.c('\n');
            self.s("\tnop");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "sparcv9") || bareArchMatch(arch, "sparc64"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tba .halt");
            self.c('\n');
            self.s("\tnop");
            self.c('\n');
        }
        else
        {
            self.s("\tcli");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\thlt");
            self.c('\n');
            self.s("\tjmp .halt");
            self.c('\n');
        }
    }
}

bool bareArchMatch(str arch, str known)
{
    if (arch.isEmpty() || known.isEmpty()) return false;
    if (arch.len != known.len) return false;
    for (u32 i = 0; i < arch.len; i++)
    {
        u8 a = (u8)arch.ptr[i];
        u8 k = (u8)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
