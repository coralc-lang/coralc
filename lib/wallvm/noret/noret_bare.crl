#[[no_drop_all]]
import(lib) std::string { String };

pub struct NoretBare
{
    u64 exitCode;
    String out;

    NoretBare new(u64 exitCode)
    {
        return NoretBare {
            .exitCode = exitCode,
            .out = String::new()
        };
    }

    void c(u8 ch)
    {
        self.out.pushChar(ch);
    }

    void s(str s)
    {
        self.out.pushView(s);
    }

    str getString()
    {
        return self.out.asView();
    }

    void clear()
    {
        self.out.clear();
    }

    void destroy()
    {
        self.out.free();
    }

    void emitHalt(str arch)
    {
        if (bareArchMatch(arch, "x86_64") || bareArchMatch(arch, "x86") || bareArchMatch(arch, "x86_32"))
        {
            self.s("\tcli");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\thlt");
            self.c('\n');
            self.s("\tjmp .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "arm64"))
        {
            self.s("\tmsr daifset, #2");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "arm"))
        {
            self.s("\tcpsid i");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "riscv64"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\twfi");
            self.c('\n');
            self.s("\tj .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "ppc64") || bareArchMatch(arch, "ppc"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tb .halt");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "mips64") || bareArchMatch(arch, "mips"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tj .halt");
            self.c('\n');
            self.s("\tnop");
            self.c('\n');
        }
        else if (bareArchMatch(arch, "sparcv9") || bareArchMatch(arch, "sparc64"))
        {
            self.s(".halt:");
            self.c('\n');
            self.s("\tba .halt");
            self.c('\n');
            self.s("\tnop");
            self.c('\n');
        }
        else
        {
            self.s("\tcli");
            self.c('\n');
            self.s(".halt:");
            self.c('\n');
            self.s("\thlt");
            self.c('\n');
            self.s("\tjmp .halt");
            self.c('\n');
        }
    }
}

bool bareArchMatch(str arch, str known)
{
    if (arch.isEmpty() || known.isEmpty()) return false;
    if (arch.len != known.len) return false;
    for (usize i = 0; i < arch.len; i++)
    {
        u8 a = (u8)arch.ptr[i];
        u8 k = (u8)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
