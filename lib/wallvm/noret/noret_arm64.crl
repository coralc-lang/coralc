#[[no_drop_all]]
import(lib) std::text::string { String };

pub struct NoretArm64
{
    u64 exitCode;
    String out;

    NoretArm64 new(u64 exitCode)
    {
        return NoretArm64 {
            .exitCode = exitCode,
            .out = String::new()
        };
    }

    void c(u8 ch)
    {
        self.out.pushChar(ch);
    }

    void s(str s)
    {
        self.out.pushView(s);
    }

    str getString()
    {
        return self.out.asView();
    }

    void clear()
    {
        self.out.clear();
    }

    void destroy()
    {
        self.out.free();
    }

    void emitLinuxSyscall()
    {
        self.emitMovRegImm64("x0", self.exitCode);
        self.c('\n');
        self.emitMovRegImm64("x8", 93);
        self.c('\n');
        self.emitSvc(0);
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovRegImm64("w0", self.exitCode);
        self.c('\n');
        self.emitCall("ExitProcess");
        self.c('\n');
    }

    void emitMacOSExit()
    {
        self.emitMovRegImm64("x0", self.exitCode);
        self.c('\n');
        self.emitMovRegImm64("x16", 1);
        self.c('\n');
        self.emitSvc(0x80);
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.emitLabel(".halt");
        self.c('\n');
        self.emitWfi();
        self.c('\n');
        self.emitB(".halt");
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, "LINUX"))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, "WINDOWS"))
            self.emitWindowsTerminate();
        else if (platformMatch(platform, "MACOS"))
            self.emitMacOSExit();
        else
            self.emitBareMetalHalt();
    }

    void emitMovRegImm64(str reg, u64 imm)
    {
        self.s("\tmov ");
        self.s(reg);
        self.s(", #");
        u64 val = imm;
        u8 buf[24];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (u8)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }

    void emitSvc(u32 imm)
    {
        self.s("\tsvc #");
        u8 buf[8];
        u32 n = 0;
        u32 val = imm;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (u8)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }

    void emitLabel(str label)
    {
        self.s(label);
        self.c(':');
    }

    void emitWfi()
    {
        self.s("\twfi");
    }

    void emitB(str target)
    {
        self.s("\tb ");
        self.s(target);
    }

    void emitCall(str target)
    {
        self.s("\tcall ");
        self.s(target);
    }
}

bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (usize i = 0; i < platform.len; i++)
    {
        u8 a = (u8)platform.ptr[i];
        u8 k = (u8)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
