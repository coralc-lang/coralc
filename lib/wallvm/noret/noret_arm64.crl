#[[no_drop_all]]
import(lib) std::mman { alloc, dealloc, copy };
import(lib) core::cchar { cchar };

pub struct NoretArm64
{
    u64 exitCode;
    cchar* out;
    u32 outLen;
    u32 outCap;

    NoretArm64 new(u64 exitCode)
    {
        return NoretArm64 {
            .exitCode = exitCode,
            .out = null,
            .outLen = 0,
            .outCap = 0
        };
    }

    void ensureCap(u32 needed)
    {
        if (self.outLen + needed <= self.outCap) return;
        u32 newCap = self.outCap ? self.outCap * 2 : 64;
        while (self.outLen + needed > newCap) newCap *= 2;
        cchar* newOut = alloc<cchar>(newCap);
        if (self.out != null)
        {
            copy<cchar>(newOut, self.out, self.outLen);
            dealloc<cchar>(self.out);
        }
        self.out = newOut;
        self.outCap = newCap;
    }

    void c(cchar ch)
    {
        self.ensureCap(1);
        self.out[self.outLen++] = ch;
    }

    void s(str s)
    {
        self.ensureCap(s.len);
        for (u32 i = 0; i < s.len; i++)
            self.out[self.outLen++] = (cchar)s.ptr[i];
    }

    str getString()
    {
        self.ensureCap(1);
        self.out[self.outLen] = 0;
        return str::fromParts((const u8*)self.out, self.outLen);
    }

    void clear()
    {
        self.outLen = 0;
    }

    void destroy()
    {
        if (self.out != null) dealloc<cchar>(self.out);
    }

    void emitLinuxSyscall()
    {
        self.emitMovRegImm64("x0", self.exitCode);
        self.c('\n');
        self.emitMovRegImm64("x8", 93);
        self.c('\n');
        self.emitSvc(0);
        self.c('\n');
    }

    void emitWindowsTerminate()
    {
        self.emitMovRegImm64("w0", self.exitCode);
        self.c('\n');
        self.emitCall("ExitProcess");
        self.c('\n');
    }

    void emitMacOSExit()
    {
        self.emitMovRegImm64("x0", self.exitCode);
        self.c('\n');
        self.emitMovRegImm64("x16", 1);
        self.c('\n');
        self.emitSvc(0x80);
        self.c('\n');
    }

    void emitBareMetalHalt()
    {
        self.emitLabel(".halt");
        self.c('\n');
        self.emitWfi();
        self.c('\n');
        self.emitB(".halt");
        self.c('\n');
    }

    void emitNoretPlatform(str platform)
    {
        if (platformMatch(platform, "LINUX"))
            self.emitLinuxSyscall();
        else if (platformMatch(platform, "WINDOWS"))
            self.emitWindowsTerminate();
        else if (platformMatch(platform, "MACOS"))
            self.emitMacOSExit();
        else
            self.emitBareMetalHalt();
    }

    void emitMovRegImm64(str reg, u64 imm)
    {
        self.s("\tmov ");
        self.s(reg);
        self.s(", #");
        u64 val = imm;
        cchar buf[24];
        u32 n = 0;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (cchar)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }

    void emitSvc(u32 imm)
    {
        self.s("\tsvc #");
        cchar buf[8];
        u32 n = 0;
        u32 val = imm;
        if (val == 0) buf[n++] = '0';
        else { while (val != 0) { buf[n++] = (cchar)('0' + val % 10); val /= 10; } }
        for (i32 i = (i32)n - 1; i >= 0; i--) self.c(buf[i]);
    }

    void emitLabel(str label)
    {
        self.s(label);
        self.c(':');
    }

    void emitWfi()
    {
        self.s("\twfi");
    }

    void emitB(str target)
    {
        self.s("\tb ");
        self.s(target);
    }

    void emitCall(str target)
    {
        self.s("\tcall ");
        self.s(target);
    }
}

bool platformMatch(str platform, str known)
{
    if (platform.isEmpty() || known.isEmpty()) return false;
    if (platform.len != known.len) return false;
    for (u32 i = 0; i < platform.len; i++)
    {
        cchar a = (cchar)platform.ptr[i];
        cchar k = (cchar)known.ptr[i];
        if (a >= 'A' && a <= 'Z') a += 32;
        if (a != k) return false;
    }
    return true;
}
