// Platform-specific rule tables

pub struct AsmRuleTable
{
    AsmRule* rules;
    u32 numRules;
    ABIRules abi;
    AsmFormat format;
    str platform; // "x86_64", "arm64", etc.

    AsmRule* findRule(IrOpcode op)
    {
        for (u32 i = 0; i < self.numRules; i++)
            if (self.rules[i].irOpcode == op) return &self.rules[i];
        return null;
    }

    void deinit()
    {
        if (self.rules != null) dealloc<AsmRule>(self.rules);
        self.rules = null;
        self.numRules = 0;
    }
}

// Predefined ABI configurations

pub ABIRules sysvAbi()
{
    return ABIRules {
        .cc = CallingConvention::SystemV,
        .name = "sysv",
        .argRegs = SYSV_ARG_REGS,
        .numArgRegs = 6,
        .floatArgRegs = SYSV_FLOAT_ARG_REGS,
        .numFloatArgRegs = 8,
        .returnReg = "rax",
        .floatReturnReg = "xmm0",
        .stackArgReg = "rsp",
        .calleeSaveRegs = SYSV_CALLEE_SAVE,
        .numCalleeSaveRegs = 6,
        .callerSaveRegs = SYSV_CALLER_SAVE,
        .numCallerSaveRegs = 9,
        .frameReg = "rbp",
        .stackAlignment = 16,
        .hasRedZone = true,
        .calleeCleanupStack = false,
        .shadowSpaceBytes = 0,
        .syscallInst = "syscall",
        .syscallNumberReg = "rax",
        .syscallArgRegs = SYSV_SYSCALL_ARG_REGS,
        .numSyscallArgRegs = 6,
        .syscallNumberShift = 0
    };
}

