#[[no_drop_all]]
import(lib) wallvm::irOps { IrOpcode };
import(lib) std::mman { alloc, dealloc };

// Each platform defines rules mapping IR opcodes to target instructions.

pub enum AsmFormat
{
    Att, // AT&T syntax, mov %src, %dst
    Intel // Intel syntax, mov dst, src
}

pub enum OperandKind
{
    Reg,
    Imm,
    Mem,
    Label
}

pub struct AsmRuleOperand
{
    OperandKind kind;
    str name; // register name or label
    u64 immediate;
    i32 displacement;
    str baseReg;
    str indexReg;
    u32 scale;
}

pub struct AsmRule
{
    IrOpcode irOpcode; // IR opcode this rule matches
    str mnemonic; // assembly mnemonic — "mov", "add", etc.
    str template; // template — "mov $op0, $op1"
    u32 numOperands;
    bool hasSideEffects;
    bool isTerminator;
    str constraints; // register constraints — "op0:rax, op1:rbx"
    str latency; // latency in cycles (for scheduling)
}

// Platform ABI Rules

pub enum CallingConvention
{
    SystemV, // Linux x86-64
    Win64, // Windows x64
    Aapcs, // ARM ABI
    Aapcs64, // ARM64 ABI
    Cdecl, // x86-32 cdecl
    Stdcall, // x86-32 stdcall
    Fastcall, // x86-32 fastcall (ecx, edx)
    Riscv64, // RISC-V 64 LP64
    // Syscall variants
    SyscallX86_64, // Linux x86-64 syscall
    SyscallX86, // Linux x86-32 int 0x80
    SyscallArm64, // Linux ARM64 svc #0
    SyscallArm, // Linux ARM32 svc #0
    SyscallRiscv64, // Linux RISC-V 64 ecall
    SyscallMacOS, // macOS x86-64 syscall
    SyscallWin64, // Windows x64 syscall
    // Additional architectures
    Ppc64, // PowerPC 64-bit ELF v2
    Ppc, // PowerPC 32-bit SVR4
    Mips64, // MIPS 64-bit N64
    Mips, // MIPS 32-bit O32
    SparcV9, // SPARC V9 LP64
    Aapcs64MacOs, // ARM64 macOS (Apple Silicon)
    Aapcs64Ios, // ARM64 iOS
    WinX86_32, // Windows x86-32 (stdcall-like)
    SyscallPpc64, // PowerPC 64 syscall
    SyscallPpc, // PowerPC 32 syscall
    SyscallMips64, // MIPS 64 syscall
    SyscallMips, // MIPS 32 syscall
    SyscallSparc64, // SPARC V9 syscall
    Wasm32, // WebAssembly 32-bit
    Wasm64 // WebAssembly 64-bit (memory64)
}

pub struct RegisterInfo
{
    str name;
    u32 number;
    u32 width;
    bool callerSave; // scratch register
    bool calleeSave; // preserved across calls
    bool isArgument; // used for argument passing
    u32 argIndex; // which argument slot (if isArgument)
}

pub struct ABIRules
{
    CallingConvention cc;
    str name;
    // Argument passing (function calls)
    str* argRegs; // registers for integer args
    u32 numArgRegs;
    str* floatArgRegs;
    u32 numFloatArgRegs;
    str returnReg; // integer return register
    str floatReturnReg;
    str stackArgReg; // stack pointer for extra args
    // Callee-save
    str* calleeSaveRegs;
    u32 numCalleeSaveRegs;
    // Caller-save (scratch)
    str* callerSaveRegs;
    u32 numCallerSaveRegs;
    // Frame
    str frameReg; // rbp on x86, x29 on ARM64
    u32 stackAlignment;
    bool hasRedZone; // 128-byte red zone (x86-64 SysV)
    bool calleeCleanupStack; // stdcall, callee pops arguments
    u32 shadowSpaceBytes; // Win64 — 32 bytes of shadow space
    // Syscall
    str syscallInst; // "syscall", "svc #0", "ecall"
    str syscallNumberReg; // register for syscall number
    str* syscallArgRegs; // registers for syscall args (differs on x86-64)
    u32 numSyscallArgRegs;
    u32 syscallNumberShift; // macOS adds 0x2000000 to syscall number
}

// Register lists per ABI. Order matters, the first register receives the
