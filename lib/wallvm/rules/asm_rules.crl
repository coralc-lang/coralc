    rules[n++] = AsmRule { IrOpcode::Or, "or", "or $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Xor, "xor", "xor $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Neg, "neg", "neg $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Not, "not", "not $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Shl, "sll", "sll $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Ashr,"sra", "sra $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Lshr,"srl", "srl $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Br, "ba", "ba $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = AsmRule { IrOpcode::CondBr,"be","be $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = AsmRule { IrOpcode::Ret, "retl", "retl", 0, false, true, "", "4" };
    rules[n++] = AsmRule { IrOpcode::Noret,"","mov 1, %g1; mov 0, %o0; ta 0x6d", 0, true, true,"exit_code:o0", "100" };
    rules[n++] = AsmRule { IrOpcode::Call,"call","call $op0", 1, true, false, "op0:label", "1-5" };
    rules[n++] = AsmRule { IrOpcode::Load,"ldx","ldx [$op1], $op0", 2, false, false,"op0:reg,op1:mem", "1-4" };
    rules[n++] = AsmRule { IrOpcode::Store,"stx","stx $op0, [$op1]", 2, true, false,"op0:reg,op1:mem", "1-2" };
    rules[n++] = AsmRule { IrOpcode::ICmp,"cmp","cmp $op0, $op1", 2, false, false,"op0:reg,op1:reg", "1" };

    AsmRuleTable table;
    table.rules = rules;
    table.numRules = n;
    table.abi = sparcV9Abi();
    table.format = AsmFormat::Att;
    table.platform = "sparc64";
