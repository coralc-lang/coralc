{
    ABIRules a;
    a.cc = CallingConvention::Cdecl;
    a.name = "cdecl";
    a.argRegs = null;
    a.numArgRegs = 0;
    a.floatArgRegs = X86_SSE_FLOAT_ARG_REGS;
    a.numFloatArgRegs = 8;
    a.returnReg = "eax";
    a.floatReturnReg = "xmm0";
    a.stackArgReg = "esp";
    a.calleeSaveRegs = X86_CALLEE_SAVE;
    a.numCalleeSaveRegs = 4;
    a.callerSaveRegs = X86_CALLER_SAVE;
    a.numCallerSaveRegs = 3;
    a.frameReg = "ebp";
    a.stackAlignment = 4;
    a.hasRedZone = false;
    a.calleeCleanupStack = false;
    a.shadowSpaceBytes = 0;
    a.syscallInst = "int 0x80";
    a.syscallNumberReg = "eax";
    a.syscallArgRegs = X86_SYSCALL_ARG_REGS;
    a.numSyscallArgRegs = 6;
    a.syscallNumberShift = 0;
    return a;
}

pub ABIRules stdcallAbi()
{
    ABIRules a = cdeclAbi();
    a.cc = CallingConvention::Stdcall;
    a.name = "stdcall";
    a.calleeCleanupStack = true;
    return a;
}

