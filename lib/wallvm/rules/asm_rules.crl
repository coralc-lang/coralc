    table.platform = "mips64";
    return table;
}

pub AsmRuleTable mipsLinuxRules()
{
    u32 cap = 24;
    AsmRule* rules = alloc<AsmRule>((usize)cap);
    u32 n = 0;

    rules[n++] = AsmRule { IrOpcode::Add, "add", "add $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Sub, "sub", "sub $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Mul, "mul", "mul $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "4" };
    rules[n++] = AsmRule { IrOpcode::SDiv,"div", "div $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "12" };
    rules[n++] = AsmRule { IrOpcode::And, "and", "and $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Or, "or", "or $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Xor, "xor", "xor $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Neg, "neg", "neg $op0, $op1", 2, false, false, "op0:reg,op1:reg", "1" };
    rules[n++] = AsmRule { IrOpcode::Shl, "sll", "sll $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:imm", "1" };
    rules[n++] = AsmRule { IrOpcode::Ashr,"sra", "sra $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:imm", "1" };
    rules[n++] = AsmRule { IrOpcode::Lshr,"srl", "srl $op0, $op1, $op2", 3, false, false, "op0:reg,op1:reg,op2:imm", "1" };
    rules[n++] = AsmRule { IrOpcode::Br, "b", "b $op0", 1, false, true, "op0:label", "1" };
    rules[n++] = AsmRule { IrOpcode::CondBr,"beq","beq $op0, $op1, $op2", 1, false, true, "op0:label", "1" };
    rules[n++] = AsmRule { IrOpcode::Ret, "jr", "jr $ra", 0, false, true, "", "4" };
    rules[n++] = AsmRule { IrOpcode::Noret,"","li $a0, 0; li $v0, 4001; syscall", 0, true, true,"exit_code:a0", "100" };
    rules[n++] = AsmRule { IrOpcode::Call,"jal","jal $op0", 1, true, false, "op0:label", "1-5" };
    rules[n++] = AsmRule { IrOpcode::Alloca,"addiu","addiu sp, sp, -$op0", 1, false, false,"op0:imm", "1" };
    rules[n++] = AsmRule { IrOpcode::Load,"lw","lw $op0, 0($op1)", 2, false, false,"op0:reg,op1:mem", "1-4" };
    rules[n++] = AsmRule { IrOpcode::Store,"sw","sw $op0, 0($op1)", 2, true, false,"op0:reg,op1:mem", "1-2" };
    rules[n++] = AsmRule { IrOpcode::ICmp,"slt","slt $op0, $op1, $op2", 3, false, false,"op0:reg,op1:reg,op2:reg", "1" };

    AsmRuleTable table;
    table.rules = rules;
    table.numRules = n;
    table.abi = mipsAbi();
    table.format = AsmFormat::Att;
    table.platform = "mips";
    return table;
}

pub AsmRuleTable sparc64LinuxRules()
{
