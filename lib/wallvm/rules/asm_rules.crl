pub ABIRules aapcs64MacOsAbi()
{
    ABIRules a = aapcs64Abi();
    a.cc = CallingConvention::Aapcs64MacOs;
    a.name = "aapcs64_macos";
    a.calleeSaveRegs = AAPCS64_MACOS_CALLEE_SAVE;
    a.numCalleeSaveRegs = 11;
    a.hasRedZone = false;
    a.syscallInst = "svc #0x80";
    a.syscallNumberReg = "x16";
    a.syscallNumberShift = 0;
    return a;
}

