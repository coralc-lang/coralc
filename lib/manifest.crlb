schema = 1;

# installed-library registry for the Coral toolchain.
#
# The builder (`coralc build`) and the single-file loader both consult
# this file: every `module` entry is registered so `use std::x`
# resolves without the project listing lib modules. This is also the
# marker an online registry would publish.
#
# `default` selects the platform triple ("arch/os") the compiler builds
# for when neither --platform/--flag platform= nor CORAL_PLATFORM is
# given — it replaces the baked-in host fallback. Other platforms are
# only built when explicitly requested.
manifest "lib" {
    default = "x86_64/linux";

    module "core"     { path = "core"; }
    module "std"      { path = "std"; }
    module "platform" { path = "platform"; }
    module "muvm"     { path = "muvm"; }
    module "wallvm"   { path = "wallvm"; }
}
