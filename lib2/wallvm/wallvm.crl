mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

pub const u32 WALLVM_VERSION_MAJOR = 0;
pub const u32 WALLVM_VERSION_MINOR = 1;
pub const u32 WALLVM_VERSION_PATCH = 0;

// Native-builtin mapping pass is opt-in: --fbuiltinmap.
pub bool gBuiltinMapEnabled = false;

pub bool(wallvm.ir_types.IrFunc*, void*) PassFn;

pub struct PassPipeline
{
    PassFn** passes;
    char** names;
    u32 count;
    u32 capacity;

    PassPipeline new()
    {
        PassPipeline p;
        p.passes = null;
        p.names = null;
        p.count = 0;
        p.capacity = 0;
        return p;
    }

    void add(PassFn* fn, const char* name)
    {
        if (self.count >= self.capacity)
        {
            u32 nc = self.capacity ? self.capacity * 2 : 8;
            PassFn** np = std.mman.alloc<PassFn*>(nc);
            char** nn = std.mman.alloc<char*>(nc);
            for (u32 i = 0; i < self.count; i++)
            {
                np[i] = self.passes[i];
                nn[i] = self.names[i];
            }
            if (self.passes) std.mman.dealloc<PassFn*>(self.passes);
            if (self.names) std.mman.dealloc<char*>(self.names);
            self.passes = np;
            self.names = nn;
            self.capacity = nc;
        }
        self.passes[self.count] = fn;
        self.names[self.count] = name;
        self.count++;
    }

    void clear()
    {
        if (self.passes) std.mman.dealloc<PassFn*>(self.passes);
        if (self.names) std.mman.dealloc<char*>(self.names);
        self.passes = null;
        self.names = null;
        self.count = 0;
        self.capacity = 0;
    }

    bool runOnFunc(wallvm.ir_types.IrFunc* func, void* ctx)
    {
        bool changed = false;
        for (u32 i = 0; i < self.count; i++)
        {
            if (self.passes[i](func, ctx))
                changed = true;
        }
        return changed;
    }
}

pub PassPipeline pipelineLevel0()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    if (gBuiltinMapEnabled) p.add(wallvm.passes.builtinmap.irPassBuiltinMap, "builtinmap");
    p.add(wallvm.passes.algepraic.irPassSimplify, "simplify");
    p.add(wallvm.passes.dce.irPassDce, "dce");
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    return p;
}

pub PassPipeline pipelineLevel1()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    p.add(wallvm.passes.builtinmap.irPassBuiltinMap, "builtinmap");
    p.add(wallvm.passes.algepraic.irPassSimplify, "simplify");
    p.add(wallvm.passes.constfold.irPassConstfold, "constfold");
    p.add(wallvm.passes.range.irPassRange, "range");
    p.add(wallvm.passes.cse.irPassCse, "cse");
    p.add(wallvm.passes.idiom.irPassIdiom, "idiom");
    p.add(wallvm.passes.dce.irPassDce, "dce");
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    return p;
}

pub PassPipeline pipelineLevel2()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    p.add(wallvm.passes.builtinmap.irPassBuiltinMap, "builtinmap");
    p.add(wallvm.passes.algepraic.irPassSimplify, "simplify");
    p.add(wallvm.passes.constfold.irPassConstfold, "constfold");
    p.add(wallvm.passes.range.irPassRange, "range");
    p.add(wallvm.passes.branchprop.irPassBranchProp, "branchprop");
    p.add(wallvm.passes.divmod.irPassDivMod, "divmod");
    p.add(wallvm.passes.gvn.irPassGvn, "gvn");
    p.add(wallvm.passes.licm.irPassLicm, "licm");
    p.add(wallvm.passes.loopcse.irPassLoopCse, "loopcse");
    p.add(wallvm.passes.sccp.irPassSccp, "sccp");
    p.add(wallvm.passes.idiom.irPassIdiom, "idiom");
    p.add(wallvm.passes.dce.irPassAdce, "adce");
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    return p;
}

pub PassPipeline pipelineLevel3()
{
    PassPipeline p = PassPipeline::new();
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    p.add(wallvm.passes.builtinmap.irPassBuiltinMap, "builtinmap");
    p.add(wallvm.passes.algepraic.irPassSimplify, "simplify");
    // mem2reg gated: SSA phis break lsra at loop back-edges (init/increment
    // get different regs → infinite loop). Re-enable after phi coalescing verified.
    // p.add({pref}mem2reg.irPassMem2Reg, "mem2reg");
    // p.add(wallvm.passes.lower_phis.irLowerPhis, "lowrphis");
    p.add(wallvm.passes.constfold.irPassConstfold, "constfold");
    p.add(wallvm.passes.range.irPassRange, "range");
    p.add(wallvm.passes.branchprop.irPassBranchProp, "branchprop");
    p.add(wallvm.passes.divmod.irPassDivMod, "divmod");
    p.add(wallvm.passes.gvn.irPassGvn, "gvn");
    p.add(wallvm.passes.licm.irPassLicm, "licm");
    p.add(wallvm.passes.loopcse.irPassLoopCse, "loopcse");
    p.add(wallvm.passes.sccp.irPassSccp, "sccp");
    // DISABLED: // // p.add(wallvm.passes.inline.irPassInline, "inl");
    p.add(wallvm.passes.tco.irPassAccumulate, "tco");
    p.add(wallvm.passes.idiom.irPassIdiom, "idiom");
    p.add(wallvm.passes.dce.irPassAdce, "adce");
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    return p;
}

pub bool irOptimize(wallvm.ir_types.IrFunc* func, wallvm.ir_types.IrContext* ctx, u32 optLevel)
{
    PassPipeline p;
    switch (optLevel)
    {
    case 0: p = pipelineLevel0(); break;
    case 1: p = pipelineLevel1(); break;
    case 2: p = pipelineLevel2(); break;
    default: p = pipelineLevel3(); break;
    }
    bool r = p.runOnFunc(func, (void*)ctx);
    p.clear();
    return r;
}

// Structure lane, passes that reshape or police the CFG/IR rather than
// tuning it for speed. Kept out of the numbered pipelines so their ordering
// relative to the optimizer stays fixed regardless of -O level.
pub bool irStructureLane(wallvm.ir_types.IrFunc* func, wallvm.ir_types.IrContext* ctx)
{
    if (!func || !ctx) return false;

    // Borrow checking is semantic, not an optimization, run it before any
    // pass that could move or remove loads/stores around.
    if (borrowcheck.irPassBorrowCheck(func, (void*)ctx)) {
        // Diagnostic only, do not fail the structure lane
        // The caller will emit TC-BORROW if --fborrowcheck is enabled
    }

    PassPipeline p = PassPipeline::new();
    p.add(wallvm.passes.unroll.irPassUnroll, "unroll");
    p.add(wallvm.passes.dse.irPassDse, "dse");
    p.add(wallvm.passes.validate.irPassValidate, "validate");
    p.runOnFunc(func, (void*)ctx);
    p.clear();
    // Returns success (a pass's changed-flag is not an error signal); the
    // borrow check above is the only failure mode.
    return true;
}

pub struct CompileResult
{
    bool success;
    const char* errorMsg;
    u32 errorLine;
}

pub CompileResult compileSuccess()
{
    CompileResult r;
    r.success = true;
    r.errorMsg = null;
    r.errorLine = 0;
    return r;
}

pub CompileResult compileError(const char* msg, u32 line)
{
    CompileResult r;
    r.success = false;
    r.errorMsg = msg;
    r.errorLine = line;
    return r;
}

// True when the target's backend decodes lsra's valData assignments
// (SPILL_BIT/FLOAT_BIT/reg index) directly. Until a backend is upgraded it
// stays slot-based and lsra keeps rewriting spills in the IR.
static bool targetConsumesRegAlloc(wallvm.asm_rules.CallingConvention cc)
{
    switch (cc)
    {
    case wallvm.asm_rules.CallingConvention::SystemV:
    case wallvm.asm_rules.CallingConvention::Win64:
    case wallvm.asm_rules.CallingConvention::SyscallWin64:
    case wallvm.asm_rules.CallingConvention::SyscallX86_64:
    case wallvm.asm_rules.CallingConvention::SyscallMacOS:
    case wallvm.asm_rules.CallingConvention::Cdecl:
    case wallvm.asm_rules.CallingConvention::Stdcall:
    case wallvm.asm_rules.CallingConvention::Fastcall:
    case wallvm.asm_rules.CallingConvention::SyscallX86:
    case wallvm.asm_rules.CallingConvention::WinX86_32:
        return true;
    default:
        return false;
    }
}

static wallvm.target.regalloc.RegAllocConfig regallocConfigFor(wallvm.asm_rules.CallingConvention cc)
{
    wallvm.target.regalloc.RegAllocConfig cfg = wallvm.target.regalloc.defaultRegAllocConfig();
    // Caller-save registers only: values live across calls in spill slots,
    // and no backend needs callee-save prologue/epilogue work. The callee
    // set of every ABI stays free for the calling convention itself.
    cfg.useCalleeSave = false;
    cfg.backendHandlesSpills = targetConsumesRegAlloc(cc);
    if (!cfg.backendHandlesSpills) return cfg;

    // Reserved registers are the ones the backend's own instruction
    // sequences need as scratch; lsra never allocates them to values.
    switch (cc)
    {
    case wallvm.asm_rules.CallingConvention::SystemV:
    case wallvm.asm_rules.CallingConvention::Win64:
    case wallvm.asm_rules.CallingConvention::SyscallWin64:
    case wallvm.asm_rules.CallingConvention::SyscallX86_64:
    case wallvm.asm_rules.CallingConvention::SyscallMacOS:
        cfg.reservedIntRegs = wallvm.target.x86_64.X86_64_RESERVED_INT;
        cfg.numReservedIntRegs = 3;
        cfg.reservedFloatRegs = wallvm.target.x86_64.X86_64_RESERVED_FLOAT;
        cfg.numReservedFloatRegs = 3;
        break;
    case wallvm.asm_rules.CallingConvention::Cdecl:
    case wallvm.asm_rules.CallingConvention::Stdcall:
    case wallvm.asm_rules.CallingConvention::Fastcall:
    case wallvm.asm_rules.CallingConvention::SyscallX86:
    case wallvm.asm_rules.CallingConvention::WinX86_32:
        // Caller-save set (eax/ecx/edx) is all backend scratch and ebp is
        // the frame pointer, so the allocatable int pool is the callee-save
        // set ebx/esi/edi. Floats use xmm3-7.
        cfg.useCalleeSave = true;
        cfg.reservedIntRegs = wallvm.target.x86.X86_RESERVED_INT;
        cfg.numReservedIntRegs = 4;
        cfg.reservedFloatRegs = wallvm.target.x86.X86_RESERVED_FLOAT;
        cfg.numReservedFloatRegs = 3;
        break;
    default:
        break;
    }
    return cfg;
}

// Syntax for a calling convention's target, from the rules tables.
static bool ccUsesAtt(wallvm.asm_rules.CallingConvention cc)
{
    return wallvm.asm_rules.formatForCc(cc) == wallvm.asm_rules.AsmFormat::Att;
}

pub CompileResult irCompile(wallvm.ir_types.IrModule* modd, wallvm.ir_types.IrContext* ctx, wallvm.asm_rules.CallingConvention cc, u32 optLevel)
{
    if (!modd) return compileError("null module", 0);
    if (!ctx) return compileError("null context", 0);

    // WASM is a stack machine — no register allocation needed
    bool isWasm = (cc == wallvm.asm_rules.CallingConvention::Wasm32 || cc == wallvm.asm_rules.CallingConvention::Wasm64);
    wallvm.asm_rules.ABIRules abi = wallvm.asm_rules.abiForCc(cc);

    // The register-allocation contract is chosen per target by switch, not
    // by a global. Each CPU target either consumes lsra's valData
    // assignments itself (backendHandlesSpills) or keeps IR-level spill
    // rewriting until its backend is upgraded.
    wallvm.target.regalloc.RegAllocConfig cfg = regallocConfigFor(cc);

    // Run register allocation on all functions
    for (u32 fi = 0; fi < modd.nfuncs; fi++)
    {
        wallvm.ir_types.IrFunc* func = modd.funcs[fi];
        if (!func) continue;
        if (func.isExtern) continue;

        // Optimize
        irOptimize(func, ctx, optLevel);

        // Structure lane (borrow check + unroll + dse)
        if (!irStructureLane(func, ctx))
            return compileError("structure lane failed", 0);

        // Allocate registers (skip for WASM — stack machine)
        if (!isWasm && !wallvm.target.regalloc.irLinearScanRegAlloc(func, (void*)ctx, &abi, &cfg))
            return compileError("register allocation failed", 0);
    }

    // Generate code
    if (!irCodegen(modd, (void*)ctx, cc))
        return compileError("codegen failed", 0);

    return compileSuccess();
}

// Same pipeline as irCompile, but returns the generated assembly text
// instead of emitting it to a sink. Test-support export; the buffer lives
// for the program lifetime.
pub const char* irCompileAsm(wallvm.ir_types.IrModule* modd, wallvm.ir_types.IrContext* ctx, wallvm.asm_rules.CallingConvention cc, u32 optLevel)
{
    if (!modd || !ctx) return null;
    bool isWasm = (cc == wallvm.asm_rules.CallingConvention::Wasm32 || cc == wallvm.asm_rules.CallingConvention::Wasm64);
    wallvm.asm_rules.ABIRules abi = wallvm.asm_rules.abiForCc(cc);
    wallvm.target.regalloc.RegAllocConfig cfg = regallocConfigFor(cc);

    for (u32 fi = 0; fi < modd.nfuncs; fi++)
    {
        wallvm.ir_types.IrFunc* func = modd.funcs[fi];
        if (!func) continue;
        if (func.isExtern) continue;
        // Skip second optimize: buildModule already ran the pipeline
        // irOptimize(func, ctx, optLevel);
        if (!irStructureLane(func, ctx)) { std.libc.write(2, "[structureLane failed]\n", 23); return null; }
        if (!isWasm && !wallvm.target.regalloc.irLinearScanRegAlloc(func, (void*)ctx, &abi, &cfg)) { std.libc.write(2, "[lsra failed]\n", 14); return null; }
    }

    switch (cc)
    {
    case wallvm.asm_rules.CallingConvention::SystemV:
    case wallvm.asm_rules.CallingConvention::Win64:
    case wallvm.asm_rules.CallingConvention::SyscallWin64:
    case wallvm.asm_rules.CallingConvention::SyscallX86_64:
    case wallvm.asm_rules.CallingConvention::SyscallMacOS:
        return wallvm.target.x86_64.irCodegenX86_64Asm(modd, (void*)ctx, ccUsesAtt(cc));
    default:
        return null;
    }
}

pub bool irCodegen(wallvm.ir_types.IrModule* modd, void* userdata, wallvm.asm_rules.CallingConvention cc)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !modd) return false;
    switch (cc)
    {
    case wallvm.asm_rules.CallingConvention::SystemV:
    case wallvm.asm_rules.CallingConvention::Win64:
    case wallvm.asm_rules.CallingConvention::SyscallWin64:
    case wallvm.asm_rules.CallingConvention::SyscallX86_64:
    case wallvm.asm_rules.CallingConvention::SyscallMacOS:
        return wallvm.target.x86_64.irCodegenX86_64(modd, userdata, ccUsesAtt(cc));
    case wallvm.asm_rules.CallingConvention::Aapcs64:
    case wallvm.asm_rules.CallingConvention::SyscallArm64:
        return wallvm.target.arm64.irCodegenArm64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Aapcs64MacOs:
        return wallvm.target.arm64.irCodegenArm64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Aapcs64Ios:
        return wallvm.target.arm64.irCodegenArm64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Aapcs:
    case wallvm.asm_rules.CallingConvention::SyscallArm:
        return wallvm.target.arm.irCodegenArm(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Riscv64:
    case wallvm.asm_rules.CallingConvention::SyscallRiscv64:
        return wallvm.target.riscv.irCodegenRiscv(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Cdecl:
    case wallvm.asm_rules.CallingConvention::Stdcall:
    case wallvm.asm_rules.CallingConvention::Fastcall:
    case wallvm.asm_rules.CallingConvention::SyscallX86:
        return wallvm.target.x86.irCodegenX86(modd, userdata);
    case wallvm.asm_rules.CallingConvention::WinX86_32:
        return wallvm.target.x86.irCodegenX86(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Ppc64:
    case wallvm.asm_rules.CallingConvention::SyscallPpc64:
        return wallvm.target.ppc64.irCodegenPpc64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Ppc:
    case wallvm.asm_rules.CallingConvention::SyscallPpc:
        return wallvm.target.ppc.irCodegenPpc(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Mips64:
    case wallvm.asm_rules.CallingConvention::SyscallMips64:
        return wallvm.target.mips64.irCodegenMips64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Mips:
    case wallvm.asm_rules.CallingConvention::SyscallMips:
        return wallvm.target.mips.irCodegenMips(modd, userdata);
    case wallvm.asm_rules.CallingConvention::SparcV9:
    case wallvm.asm_rules.CallingConvention::SyscallSparc64:
        return wallvm.target.sparc64.irCodegenSparc64(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Wasm32:
        return wallvm.target.wasm32.irCodegenWasm32(modd, userdata);
    case wallvm.asm_rules.CallingConvention::Wasm64:
        return wallvm.target.wasm64.irCodegenWasm64(modd, userdata);
    }
    return false;
}
