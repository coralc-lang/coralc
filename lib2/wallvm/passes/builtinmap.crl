// lib2 mirror of builtinmap — see lib/ copy for the full header comment.
@[[no_warn_unsafe]]

mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

// Builtin-call mapping: rewrites calls to well-known libc / gcc-builtin
// functions into native IR opcodes so every backend lowers them directly
// instead of going through the C library. Pure rewrite — runs before
// simplify in every pipeline level.
//
//   sqrt/__builtin_sqrt        -> FSqrt
//   fabs/__builtin_fabs        -> FAbs
//   bswap16/32/64 (+U forms)   -> Bswap
//   __builtin_ctz[ll]/ctz      -> CtTz
//   __builtin_clz[ll]/clz      -> CtLz
//   popcount[ll]/__builtin_*   -> CtPop
//   rotl/rotl32/rotl64         -> Rotl
//   rotr/rotr32/rotr64         -> Rotr
//   abs/labs/llabs             -> Abs
//   __sync_synchronize         -> Fence
//
// Atomics are deliberately NOT mapped here: their ordering semantics need
// explicit flags at the source level before the rewrite is sound.
pub struct BuiltinMapPass
{
    wallvm.ir_types.IrContext* ctx;
    u64 mapped;

    BuiltinMapPass new(wallvm.ir_types.IrContext* ctx)
    {
        BuiltinMapPass p;
        p.ctx = ctx;
        p.mapped = 0;
        return p;
    }

    bool nameEq(const char* a, const char* b)
    {
        if (!a || !b) return false;
        u32 i = 0;
        while (a[i] != 0 && b[i] != 0)
        {
            if (a[i] != b[i]) return false;
            i++;
        }
        return a[i] == b[i];
    }

    // Map a callee name to an opcode; IrOpcode::Call (=0? use Count sentinel)
    // returned as Call when unmapped. Call is never produced by createInst
    // here, so it is a safe "no match" marker.
    wallvm.irOps.IrOpcode map(const char* n)
    {
        if (self.nameEq(n, "sqrt") || self.nameEq(n, "__builtin_sqrt")) return wallvm.irOps.IrOpcode::FSqrt;
        if (self.nameEq(n, "fabs") || self.nameEq(n, "__builtin_fabs")) return wallvm.irOps.IrOpcode::FAbs;
        if (self.nameEq(n, "bswap") || self.nameEq(n, "bswap16") || self.nameEq(n, "bswapU16")
 || self.nameEq(n, "bswap32") || self.nameEq(n, "bswapU32")
 || self.nameEq(n, "bswap64") || self.nameEq(n, "bswapU64")) return wallvm.irOps.IrOpcode::Bswap;
        if (self.nameEq(n, "__builtin_ctzll") || self.nameEq(n, "__builtin_ctz")
 || self.nameEq(n, "ctz") || self.nameEq(n, "ctzll")) return wallvm.irOps.IrOpcode::CtTz;
        if (self.nameEq(n, "__builtin_clzll") || self.nameEq(n, "__builtin_clz")
 || self.nameEq(n, "clz") || self.nameEq(n, "clzll")) return wallvm.irOps.IrOpcode::CtLz;
        if (self.nameEq(n, "__builtin_popcountll") || self.nameEq(n, "__builtin_popcount")
 || self.nameEq(n, "popcount") || self.nameEq(n, "popcountll")) return wallvm.irOps.IrOpcode::CtPop;
        if (self.nameEq(n, "rotl") || self.nameEq(n, "rotl32") || self.nameEq(n, "rotl64")) return wallvm.irOps.IrOpcode::Rotl;
        if (self.nameEq(n, "rotr") || self.nameEq(n, "rotr32") || self.nameEq(n, "rotr64")) return wallvm.irOps.IrOpcode::Rotr;
        if (self.nameEq(n, "abs") || self.nameEq(n, "labs") || self.nameEq(n, "llabs")
 || self.nameEq(n, "__builtin_abs")) return wallvm.irOps.IrOpcode::Abs;
        if (self.nameEq(n, "__sync_synchronize")) return wallvm.irOps.IrOpcode::Fence;
        return wallvm.irOps.IrOpcode::Call;
    }

    bool run(wallvm.ir_types.IrFunc* func)
    {
        self.mapped = 0;
        bool changed = false;
        for (u32 bi = 0; bi < func.nblocks; bi++)
        {
            wallvm.ir_types.IrBlock* bb = func.blocks[bi];
            u32 ii = 0;
            while (ii < bb.ninsts)
            {
                wallvm.ir_types.IrInst* inst = bb.insts[ii];
                if (inst.opcode != wallvm.irOps.IrOpcode::Call || inst.nops < 1)
                {
                    ii++;
                    continue;
                }
                wallvm.ir_types.IrValue* calleeVal = inst.ops[0];
                if (!calleeVal || calleeVal.kind != wallvm.ir_types.IrValueKind::Func
                    || !calleeVal.name || !calleeVal.name[0])
                {
                    ii++;
                    continue;
                }
                wallvm.irOps.IrOpcode op = self.map(calleeVal.name);
                if (op == wallvm.irOps.IrOpcode::Call)
                {
                    ii++;
                    continue;
                }

                wallvm.ir_types.IrValue** ops = null;
                u32 nops = 0;
                if (op == wallvm.irOps.IrOpcode::Fence)
                {
                    ops = null;
                    nops = 0;
                }
                else
                {
                    if (inst.nops < 2) { ii++; continue; }
                    if (op == wallvm.irOps.IrOpcode::Rotl || op == wallvm.irOps.IrOpcode::Rotr)
                    {
                        if (inst.nops < 3) { ii++; continue; }
                        ops = std.mman.alloc<wallvm.ir_types.IrValue*>(2);
                        ops[0] = inst.ops[1];
                        ops[1] = inst.ops[2];
                        nops = 2;
                    }
                    else
                    {
                        ops = std.mman.alloc<wallvm.ir_types.IrValue*>(1);
                        ops[0] = inst.ops[1];
                        nops = 1;
                    }
                }

                wallvm.ir_types.IrType* ty = inst.base.type;
                if (ty == null && nops > 0 && ops[0] != null) ty = ops[0].type;
                if (op == wallvm.irOps.IrOpcode::Fence) ty = self.ctx.tyVoid();

                wallvm.ir_types.IrInst* ni = self.ctx.createInst(op, ty, ops, nops, 0, 0);
                bb.insertBefore(ni, inst);
                for (u32 oi = 0; oi < nops; oi++)
                    if (ni.ops[oi] != null)
                        ni.ops[oi].addUser(ni);

                inst.base.replaceAllUses(&ni.base);
                inst.erase();
                self.mapped++;
                changed = true;
                // ii stays: erase compacted the array
            }
        }
        return changed;
    }
}

pub bool irPassBuiltinMap(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func) return false;
    BuiltinMapPass p = BuiltinMapPass::new(ctx);
    bool ch = p.run(func);
    return ch;
}
