mod wallvm = import(lib, "wallvm");
mod std = import(lib, "std");

// LowerPhis: eliminate all Phi instructions by inserting Store(src,
// alloca) on each incoming edge and replacing the phi with Load(alloca).
// This runs immediately after mem2reg so lsra never sees a Phi opcode.
pub bool irLowerPhis(wallvm.ir_types.IrFunc* func, void* userdata)
{
    wallvm.ir_types.IrContext* ctx = (wallvm.ir_types.IrContext*)userdata;
    if (!ctx || !func || func.nblocks == 0) return false;

    // Count phis
    u32 nphis = 0;
    for (u32 bi = 0; bi < func.nblocks; bi++)
    {
        wallvm.ir_types.IrBlock* bb = func.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts; ii++)
        {
            if (bb.insts[ii].opcode == wallvm.irOps.IrOpcode.Phi) { nphis++; break; }
        }
    }
    if (nphis == 0) return false;

    // Collect unique phis
    wallvm.ir_types.IrInst** phis = std.mman.alloc<wallvm.ir_types.IrInst*>(nphis);
    wallvm.ir_types.IrInst** phiAllocas = std.mman.alloc<wallvm.ir_types.IrInst*>(nphis);
    u32 numPhis = 0;

    for (u32 bi = 0; bi < func.nblocks && numPhis < nphis; bi++)
    {
        wallvm.ir_types.IrBlock* bb = func.blocks[bi];
        for (u32 ii = 0; ii < bb.ninsts && numPhis < nphis; ii++)
        {
            if (bb.insts[ii].opcode == wallvm.irOps.IrOpcode.Phi)
            {
                phis[numPhis] = bb.insts[ii];
                numPhis++;
            }
            else if (numPhis > 0)
            {
                break; // past leading phis
            }
        }
    }

    // Step 1: Create alloca for each phi at top of entry block
    for (u32 k = 0; k < numPhis; k++)
    {
        wallvm.ir_types.IrType* elemTy = phis[k].base.type;
        if (!elemTy) elemTy = ctx.tyInt(64);
        wallvm.ir_types.IrType* ptrTy = ctx.tyPtr(elemTy);
        wallvm.ir_types.IrInst* alloca = ctx.createInst(
            wallvm.irOps.IrOpcode.Alloca, ptrTy, null, 0, 0, 0);
        phiAllocas[k] = alloca;

        wallvm.ir_types.IrBlock* entry = func.blocks[0];
        u32 insIdx = entry.ninsts;
        // Insert after existing allocas
        for (u32 z = 0; z < entry.ninsts; z++)
        {
            if (entry.insts[z].opcode == wallvm.irOps.IrOpcode.Alloca)
            {
                insIdx = z + 1;
            }
            else
            {
                break;
            }
        }

        // Grow array if needed
        if (entry.ninsts + 1 > entry.capInsts)
        {
            u32 nc = entry.capInsts ? entry.capInsts * 2 : 16;
            wallvm.ir_types.IrInst** ni = std.mman.alloc<wallvm.ir_types.IrInst*>(nc);
            for (u32 z = 0; z < entry.ninsts; z++) ni[z] = entry.insts[z];
            if (entry.insts) std.mman.dealloc<wallvm.ir_types.IrInst*>(entry.insts);
            entry.insts = ni;
            entry.capInsts = nc;
        }
        for (u32 z = entry.ninsts; z > insIdx; z--)
            entry.insts[z] = entry.insts[z - 1];
        entry.insts[insIdx] = alloca;
        alloca.parent = entry;
        entry.ninsts++;
    }

    // Step 2: For each phi operand pair, insert Store(src, alloca) in pred
    for (u32 k = 0; k < numPhis; k++)
    {
        wallvm.ir_types.IrInst* phi = phis[k];
        wallvm.ir_types.IrInst* alloca = phiAllocas[k];

        for (u32 j = 0; j + 1 < phi.nops; j += 2)
        {
            wallvm.ir_types.IrValue* srcVal = phi.ops[j];
            wallvm.ir_types.IrValue* predVal = phi.ops[j + 1];
            if (!predVal || predVal.kind != wallvm.ir_types.IrValueKind.Block) continue;
            wallvm.ir_types.IrBlock* predBlk = (wallvm.ir_types.IrBlock*)predVal;
            if (!srcVal) continue;

            // Find terminator index in predecessor
            u32 termIdx = predBlk.ninsts;
            for (u32 ti = 0; ti < predBlk.ninsts; ti++)
            {
                wallvm.irOps.IrOpcode op = predBlk.insts[ti].opcode;
                if (op == wallvm.irOps.IrOpcode.Br || op == wallvm.irOps.IrOpcode.CondBr ||
                    op == wallvm.irOps.IrOpcode.Ret || op == wallvm.irOps.IrOpcode.Unreachable ||
                    op == wallvm.irOps.IrOpcode.Noret)
                { termIdx = ti; break; }
            }

            // Create Store
            wallvm.ir_types.IrValue** sOps = std.mman.alloc<wallvm.ir_types.IrValue*>(2);
            sOps[0] = srcVal;
            sOps[1] = &alloca.base;
            wallvm.ir_types.IrInst* storeInst = ctx.createInst(
                wallvm.irOps.IrOpcode.Store, ctx.tyVoid(), sOps, 2, 0, 0);
            srcVal.addUser(storeInst);
            alloca.base.addUser(storeInst);

            // Insert before terminator
            if (predBlk.ninsts + 1 > predBlk.capInsts)
            {
                u32 nc3 = predBlk.capInsts ? predBlk.capInsts * 2 : 16;
                wallvm.ir_types.IrInst** ni3 = std.mman.alloc<wallvm.ir_types.IrInst*>(nc3);
                for (u32 z = 0; z < predBlk.ninsts; z++) ni3[z] = predBlk.insts[z];
                if (predBlk.insts) std.mman.dealloc<wallvm.ir_types.IrInst*>(predBlk.insts);
                predBlk.insts = ni3;
                predBlk.capInsts = nc3;
            }
            for (u32 z = predBlk.ninsts; z > termIdx; z--)
                predBlk.insts[z] = predBlk.insts[z - 1];
            predBlk.insts[termIdx] = storeInst;
            storeInst.parent = predBlk;
            predBlk.ninsts++;
        }
    }

    // Step 3: Replace each phi with Load(alloca), remove phi.
    // Process in REVERSE order so position shifts don't break later replacements.
    u32 idx = numPhis;
    while (idx > 0)
    {
        idx--;
        wallvm.ir_types.IrInst* phi = phis[idx];
        wallvm.ir_types.IrInst* alloca = phiAllocas[idx];
        wallvm.ir_types.IrBlock* parent = phi.parent;
        if (!parent) continue;

        wallvm.ir_types.IrType* elemTy = phi.base.type;
        if (!elemTy) elemTy = ctx.tyInt(64);

        wallvm.ir_types.IrValue** lOps = std.mman.alloc<wallvm.ir_types.IrValue*>(1);
        lOps[0] = &alloca.base;
        wallvm.ir_types.IrInst* loadInst = ctx.createInst(
            wallvm.irOps.IrOpcode.Load, elemTy, lOps, 1, 0, 0);
        alloca.base.addUser(loadInst);

        // Replace all uses of phi with load result
        phi.base.replaceAllUses(&loadInst.base);

        // Remove phi's user links from operands
        for (u32 oi = 0; oi < phi.nops; oi++)
        {
            if (phi.ops[oi])
                phi.ops[oi].removeUser(phi);
        }

        // Find phi position in parent
        u32 phiPos = 0;
        for (u32 pi = 0; pi < parent.ninsts; pi++)
        {
            if (parent.insts[pi] == phi) { phiPos = pi; break; }
        }

        // Replace phi slot with load instruction
        if (phiPos < parent.ninsts)
        {
            // Free old ops
            if (phi.capOps > 0)
                std.mman.dealloc<wallvm.ir_types.IrValue*>(phi.ops);
            loadInst.parent = parent;
            parent.insts[phiPos] = loadInst;
        }
    }

    return true;
}