pub struct option<T>
{
    bool some;
    T value;

    option<T> some(T value)
    {
        option<T> o;
        o.some = true;
        o.value = value;
        return o;
    }

    option<T> none()
    {
        option<T> o;
        o.some = false;
        return o;
    }

    bool isSome()
    {
        return self->some;
    }

    bool isNone()
    {
        return !self.some;
    }

    T unwrap()
    {
        assert(self.some);
        return self.value;
    }

    T unwrapOr(T defaultVal)
    {
        if (self.some) return self.value;
        return defaultVal;
    }

    T* ptr(self*)
    {
        if (self->some) return &self->value;
        return null;
    }

    const T* constPtr(const self*)
    {
        if (self->some) return &self->value;
        return null;
    }

    void map(T(T) fn)
    {
        if (self->some) self->value = fn(self->value);
    }

    void andThen(option<T>(T) fn)
    {
        if (self->some) *self = fn(self->value);
    }

    void orElse(option<T>() fn)
    {
        if (!self->some) *self = fn();
    }

    T take()
    {
        assert(self.some);
        self.some = false;
        return self.value;
    }
}