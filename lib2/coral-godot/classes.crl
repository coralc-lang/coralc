// TextServer  (inherits RefCounted, api=core, refcounted=True, instantiable=False)

// enum FontAntialiasing
pub enum FontAntialiasing
{
    TextServerAntialiasingNone = 0,
    TextServerAntialiasingGray = 1,
    TextServerAntialiasingLcd = 2
}
// enum FontLCDSubpixelLayout
pub enum FontLcdsubpixelLayout
{
    TextServerLcdSubpixelLayoutNone = 0,
    TextServerLcdSubpixelLayoutHrgb = 1,
    TextServerLcdSubpixelLayoutHbgr = 2,
    TextServerLcdSubpixelLayoutVrgb = 3,
    TextServerLcdSubpixelLayoutVbgr = 4,
    TextServerLcdSubpixelLayoutMax = 5
}
// enum Direction
pub enum Direction
{
    TextServerAuto = 0,
    TextServerLtr = 1,
    TextServerRtl = 2,
    TextServerInherited = 3
}
// enum Orientation
pub enum Orientation
{
    TextServerHorizontal = 0,
    TextServerVertical = 1
}
// enum JustificationFlag
pub const u32 TextServerJustificationNone = 0;
pub const u32 TextServerJustificationKashida = 1;
pub const u32 TextServerJustificationWordBound = 2;
pub const u32 TextServerJustificationTrimEdgeSpaces = 4;
pub const u32 TextServerJustificationAfterLastTab = 8;
pub const u32 TextServerJustificationConstrainEllipsis = 16;
pub const u32 TextServerJustificationSkipLastLine = 32;
pub const u32 TextServerJustificationSkipLastLineWithVisibleChars = 64;
pub const u32 TextServerJustificationDoNotSkipSingleLine = 128;
// enum AutowrapMode
pub enum AutowrapMode
{
    TextServerOff = 0,
    TextServerArbitrary = 1,
    TextServerWord = 2,
    TextServerWordSmart = 3
}
// enum LineBreakFlag
pub const u32 TextServerBreakNone = 0;
pub const u32 TextServerBreakMandatory = 1;
pub const u32 TextServerBreakWordBound = 2;
pub const u32 TextServerBreakGraphemeBound = 4;
pub const u32 TextServerBreakAdaptive = 8;
pub const u32 TextServerBreakTrimEdgeSpaces = 16;
pub const u32 TextServerBreakTrimIndent = 32;
pub const u32 TextServerBreakTrimStartEdgeSpaces = 64;
pub const u32 TextServerBreakTrimEndEdgeSpaces = 128;
// enum VisibleCharactersBehavior
pub enum VisibleCharactersBehavior
{
    TextServerVcCharsBeforeShaping = 0,
    TextServerVcCharsAfterShaping = 1,
    TextServerVcGlyphsAuto = 2,
    TextServerVcGlyphsLtr = 3,
    TextServerVcGlyphsRtl = 4
}
// enum OverrunBehavior
pub enum OverrunBehavior
{
    TextServerNoTrimming = 0,
    TextServerTrimChar = 1,
    TextServerTrimWord = 2,
    TextServerTrimEllipsis = 3,
    TextServerTrimWordEllipsis = 4,
    TextServerTrimEllipsisForce = 5,
    TextServerTrimWordEllipsisForce = 6
}
// enum TextOverrunFlag
