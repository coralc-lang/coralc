{
    AnimationNearest = 0,
    AnimationLinear = 1,
    AnimationCubic = 2,
    AnimationLinearAngle = 3,
    AnimationCubicAngle = 4
}
// enum UpdateMode
pub enum UpdateMode
{
    AnimationContinuous = 0,
    AnimationDiscrete = 1,
    AnimationCapture = 2
}
// enum LoopMode
