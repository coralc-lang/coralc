; WallVM IR

func @isBig -> i1 {
  block %entry:
    %7 = alloca ptr
    %9 = store void [%8(s), %7]
    %10 = load array [%7]
    %11 = call void [%10]
    %14 = fcmp i1 [0, float]
    %15 = ret i1 [%14]
}

func @mySprite__wrap -> array {
  block %entry:
    %17 = alloca ptr
    %19 = store void [%18, %17]
    %20 = alloca ptr
    %22 = store void [%21, %20]
    %23 = alloca ptr
    %25 = store void [%24(h), %23]
    %26 = alloca ptr
    %27 = load i64 [%23]
    %28 = bitcast ptr [%26]
    %29 = gep ptr [%28, 0]
    %30 = bitcast ptr [%29]
    %31 = store void [%27, %30]
    %32 = ret ptr [%26]
}

func @mySprite___size -> f64 {
  block %entry:
    %34 = alloca ptr
    %36 = store void [%35, %34]
    %38 = ret f64 [float]
}

func @mySprite__body -> i64 {
  block %entry:
    %40 = alloca ptr
    %42 = store void [%41, %40]
    %43 = load ptr [%40]
    %44 = bitcast ptr [%43]
    %45 = gep ptr [%44, 0]
    %46 = bitcast ptr [%45]
    %47 = load i64 [%46]
    %48 = ret i64 [%47]
}

func @mySprite__size -> f64 {
  block %entry:
    %50 = alloca ptr
    %52 = store void [%51, %50]
    %53 = load ptr [%50]
    %54 = call void [%53]
    %55 = ret void
}

