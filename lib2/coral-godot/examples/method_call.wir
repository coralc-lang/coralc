; WallVM IR
global @g_interface : i64
global @snBuf : array

func @makeName -> i64 {
  block %entry:
    %8 = alloca ptr
    %10 = store void [%9(text), %8]
    %11 = alloca ptr
    %12 = store void [%1(g_interface), %11]
    %13 = alloca ptr
    %14 = sext i64 [%2(snBuf)]
    %15 = store void [%14, %13]
    %16 = load ptr [%11]
    %17 = load i64 [%13]
    %18 = load ptr [%8]
    %19 = call void [%16, %17, %18]
    %20 = load i64 [%13]
    %21 = ret i64 [%20]
}
func @resolveBind -> i64 {
  block %entry:
    %23 = alloca ptr
    %24 = store void [%1(g_interface), %23]
    %25 = alloca ptr
    %27 = call i64 [%3(makeName), 0]
    %28 = store void [%27, %25]
    %29 = alloca ptr
    %31 = call i64 [%3(makeName), 0]
    %32 = store void [%31, %29]
    %33 = load i64 [%25]
    %35 = icmp i1 [%33, 0]
    %36 = load i64 [%29]
    %37 = icmp i1 [%36, 0]
    %39 = icmp i1 [%35, 0]
    %40 = icmp i1 [%37, 0]
    %41 = or i1 [%39, %40]
    %44 = cond_br void [%41, %42(if.then), %43(if.join)]
  block %if.then:
    %45 = ret ptr [0]
  block %if.join:
    %46 = load ptr [%23]
    %47 = load i64 [%25]
    %48 = load i64 [%29]
    %50 = call void [%46, %47, %48, 0]
    %51 = ret void
}
func @callGetName -> void {
  block %entry:
    %53 = alloca ptr
    %55 = store void [%54(node), %53]
    %56 = alloca ptr
    %58 = store void [%57(bind), %56]
    %59 = alloca ptr
    %60 = store void [%1(g_interface), %59]
    %61 = alloca ptr
    %62 = alloca ptr
    %63 = load ptr [%59]
    %64 = load i64 [%56]
    %65 = load i64 [%53]
    %66 = load i64 [%62]
    %67 = call void [%63, %64, %65, 0, 0, %66, %61]
    %68 = load ptr [%59]
    %69 = load i64 [%62]
    %70 = call void [%68, %69]
    %71 = ret void
}
func @callGetNamePtr -> void {
  block %entry:
    %73 = alloca ptr
    %75 = store void [%74(node), %73]
    %76 = alloca ptr
    %78 = store void [%77(bind), %76]
    %79 = alloca ptr
    %80 = store void [%1(g_interface), %79]
    %81 = alloca ptr
    %82 = load ptr [%79]
    %83 = load i64 [%76]
    %84 = load i64 [%73]
    %85 = load i64 [%81]
    %86 = call void [%82, %83, %84, 0, %85]
    %87 = ret void
}
