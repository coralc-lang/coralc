; WallVM IR
global @snBuf : array
global @g_interface : i64

func @makeName -> i64 {
  block %entry:
    %7 = alloca ptr
    %9 = store void [%8(text), %7]
    %10 = alloca ptr
    %11 = store void [%2(g_interface), %10]
    %12 = alloca ptr
    %13 = sext i64 [%1(snBuf)]
    %14 = store void [%13, %12]
    %15 = load ptr [%10]
    %16 = load i64 [%12]
    %17 = load ptr [%7]
    %18 = call void [%15, %16, %17]
    %19 = load i64 [%12]
    %20 = ret i64 [%19]
}

func @engine -> i64 {
  block %entry:
    %22 = alloca ptr
    %23 = store void [%2(g_interface), %22]
    %24 = load ptr [%22]
    %26 = call i64 [%3(makeName), 0]
    %27 = call void [%24, %26]
    %28 = ret void
}

func @engineFps -> f64 {
  block %entry:
    %30 = alloca ptr
    %31 = store void [%2(g_interface), %30]
    %32 = alloca ptr
    %34 = call i64 [%3(makeName), 0]
    %35 = store void [%34, %32]
    %36 = alloca ptr
    %38 = call i64 [%3(makeName), 0]
    %39 = store void [%38, %36]
    %40 = alloca ptr
    %41 = load ptr [%30]
    %42 = load i64 [%32]
    %43 = load i64 [%36]
    %45 = call void [%41, %42, %43, 0]
    %46 = load i64 [%40]
    %48 = icmp i1 [%46, 0]
    %51 = cond_br void [%48, %49(if.then), %50(if.join)]
  block %if.then:
    %55 = ret f64 [float]
  block %if.join:
    %56 = alloca ptr
    %57 = load ptr [%30]
    %58 = load i64 [%40]
    %59 = call i64 [%4(engine)]
    %60 = load i64 [%56]
    %61 = call void [%57, %58, %59, 0, %60]
    %62 = load i64 [%56]
    %63 = bitcast ptr [%62]
    %64 = load f64 [%63]
    %65 = ret f64 [%64]
}

