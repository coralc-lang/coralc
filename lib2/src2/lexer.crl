// DFA lexer for src2 — direct-coded, zero parser state.
// Follows src2.md spec. Uses `*.` for pointer member access (not `->`).
// `>>` is always RSHIFT; the parser handles generic nesting.

mod std = import(lib, "std");
mod mman = import("std/memory/mman.crl");

pub enum TokenKind
{
    // Sentinel
    EOF,
    // Literals / words
    IDENT,
    NUMBER,
    STRING,
    // Keywords (text-matched after IDENT)
    KW_PUB,
    KW_STRUCT,
    KW_TRAIT,
    KW_DISTINCT,
    KW_STATIC,
    KW_EXTERN,
    KW_FLAG,
    KW_CONSTEXPR,
    KW_CONST,
    KW_NULL,
    KW_TRUE,
    KW_FALSE,
    KW_IF,
    KW_ELSE,
    KW_FOR,
    KW_WHILE,
    KW_RETURN,
    KW_ASSERT,
    KW_MOD,
    KW_IMPORT,
    KW_ASM,
    KW_VOLATILE,
    // Single-char operators
    PLUS, // +
    MINUS, // -
    STAR, // *
    SLASH, // /
    PERCENT, // %
    AMP, // &
    PIPE, // |
    CARET, // ^
    TILDE, // ~
    BANG, // !
    ASSIGN, // =
    DOT, // .
    COMMA, // ,
    SEMI, // ;
    COLON, // :
    LPAREN, // (
    RPAREN, // )
    LBRACE, // {
    RBRACE, // }
    LBRACKET, // [
    RBRACKET, // ]
    // Two-char operators
    PTR_DOT, // *.  (pointer member access)
    COLON_COLON, // ::
    PLUS_PLUS, // ++
    MINUS_MINUS, // --
    LT_LT, // <<
    GT_GT, // >> (always RSHIFT, context-free)
    LT_EQ, // <=
    GT_EQ, // >=
    EQ_EQ, // ==
    BANG_EQ, // !=
    AMP_AMP, // &&
    PIPE_PIPE, // ||
    // Compound assignment
    PLUS_EQ, // +=
    MINUS_EQ, // -=
    STAR_EQ, // *=
    SLASH_EQ, // /=
    PERCENT_EQ, // %=
    AMP_EQ, // &=
    PIPE_EQ, // |=
    CARET_EQ, // ^=
    LT_LT_EQ, // <<=
    GT_GT_EQ, // >>=
}

pub struct Token
{
    TokenKind kind;
    u32 start; // byte offset into source
    u32 len; // byte length
    u32 line;
    u32 col;
}

pub struct Lexer
{
    const u8* src;
    u32 srcLen;
    u32 pos;
    u32 line;
    u32 col;
    Token* tokens;
    u32 tokenCount;
    u32 tokenCap;

    Lexer new(const u8* src, u32 srcLen)
    {
        Lexer l;
        l.src = src;
        l.srcLen = srcLen;
        l.pos = 0;
        l.line = 1;
        l.col = 1;
        l.tokens = null;
        l.tokenCount = 0;
        l.tokenCap = 0;
        return l;
    }

    void ensureTokenCap(u32 needed)
    {
        if (needed <= self.tokenCap) return;
        u32 nc = self.tokenCap ? self.tokenCap * 2 : 256;
        while (nc < needed) nc *= 2;
        Token* nb = mman.alloc<Token>(nc);
        for (u32 i = 0; i < self.tokenCount; i++) nb[i] = self.tokens[i];
        if (self.tokens) mman.dealloc<Token>(self.tokens);
        self.tokens = nb;
        self.tokenCap = nc;
    }

    u8 peek(u32 offset)
    {
        u32 idx = self.pos + offset;
        if (idx >= self.srcLen) return 0;
        return self.src[idx];
    }

    u8 advance()
    {
        u8 ch = self.src[self.pos];
        self.pos++;
        if (ch == '\n') { self.line++; self.col = 1; }
        else { self.col++; }
        return ch;
    }

    void emit(TokenKind kind, u32 start, u32 len)
    {
        self.ensureTokenCap(self.tokenCount + 1);
        Token* t = &self.tokens[self.tokenCount];
        t.kind = kind;
        t.start = start;
        t.len = len;
        t.line = self.line;
        t.col = self.col - len;
        self.tokenCount++;
    }

    void skipWhitespace()
    {
        while (self.pos < self.srcLen)
        {
            u8 ch = self.src[self.pos];
            if (ch == ' ' || ch == '\t' || ch == '\r' || ch == '\n'
 || ch == '\v' || ch == '\f')
            {
                self.advance();
                continue;
            }
            // Line comment
            if (ch == '/' && self.peek(1) == '/')
            {
                while (self.pos < self.srcLen && self.src[self.pos] != '\n')
                    self.advance();
                continue;
            }
            // Block comment
            if (ch == '/' && self.peek(1) == '*')
            {
                self.advance(); self.advance();
                while (self.pos + 1 < self.srcLen)
                {
                    if (self.src[self.pos] == '*' && self.src[self.pos + 1] == '/')
                    {
                        self.advance(); self.advance();
                        break;
                    }
                    self.advance();
                }
                continue;
            }
            break;
        }
    }

    bool isAlpha(u8 c)
    {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
    }

    bool isDigit(u8 c) { return c >= '0' && c <= '9'; }

    bool isAlnum(u8 c) { return self.isAlpha(c) || self.isDigit(c); }

    void lexIdent()
    {
        u32 start = self.pos;
        while (self.pos < self.srcLen && self.isAlnum(self.src[self.pos]))
            self.advance();
        u32 len = self.pos - start;

        // Check keywords
        TokenKind kw = self.matchKeyword(start, len);
        if (kw != TokenKind::IDENT)
            self.emit(kw, start, len);
        else
            self.emit(TokenKind::IDENT, start, len);
    }

    TokenKind matchKeyword(u32 start, u32 len)
    {
        const u8* s = self.src + start;
        // Match by length first, then compare bytes
        if (len == 3)
        {
            if (s[0] == 'f' && s[1] == 'o' && s[2] == 'r') return TokenKind::KW_FOR;
            if (s[0] == 'a' && s[1] == 's' && s[2] == 'm') return TokenKind::KW_ASM;
            if (s[0] == 'u' && s[1] == 'n' && s[2] == 'd') return TokenKind::IDENT; // not a keyword
            if (s[0] == 'p' && s[1] == 'u' && s[2] == 'b') return TokenKind::KW_PUB;
        }
        if (len == 2)
        {
            if (s[0] == 'i' && s[1] == 'f') return TokenKind::KW_IF;
            if (s[0] == 'o' && s[1] == 'r') return TokenKind::IDENT;
        }
        if (len == 4)
        {
            if (s[0] == 'e' && s[1] == 'l' && s[2] == 's' && s[3] == 'e') return TokenKind::KW_ELSE);
            if (s[0] == 't' && s[1] == 'r' && s[2] == 'u' && s[3] == 'e') return TokenKind::KW_TRUE;
            if (s[0] == 'n' && s[1] == 'u' && s[2] == 'l' && s[3] == 'l') return TokenKind::KW_NULL;
            if (s[0] == 'm' && s[1] == 'o' && s[2] == 'd' && s[3] == ' ') return TokenKind::IDENT;
            if (s[0] == 'f' && s[1] == 'l' && s[2] == 'a' && s[3] == 'g') return TokenKind::KW_FLAG;
            if (s[0] == 'c' && s[1] == 'a' && s[2] == 's' && s[3] == 't') return TokenKind::IDENT;
        }
        if (len == 5)
        {
            if (s[0] == 'c' && s[1] == 'o' && s[2] == 'n' && s[3] == 's' && s[4] == 't') return TokenKind::KW_CONST;
            if (s[0] == 'f' && s[1] == 'a' && s[2] == 'l' && s[3] == 's' && s[4] == 'e') return TokenKind::KW_FALSE;
            if (s[0] == 'w' && s[1] == 'h' && s[2] == 'i' && s[3] == 'l' && s[4] == 'e') return TokenKind::KW_WHILE;
            if (s[0] == 'i' && s[1] == 'm' && s[2] == 'p' && s[3] == 'o' && s[4] == 'r') // import
            {
                if (len == 6 && s[5] == 't') return TokenKind::KW_IMPORT;
            }
            if (s[0] == 's' && s[1] == 't' && s[2] == 'a' && s[3] == 'r' && s[4] == 't') return TokenKind::IDENT;
            if (s[0] == 'v' && s[1] == 'a' && s[2] == 'l' && s[3] == 'u' && s[4] == 'e') return TokenKind::IDENT;
        }
        if (len == 6)
        {
            if (s[0] == 'r' && s[1] == 'e' && s[2] == 't' && s[3] == 'u' && s[4] == 'r' && s[5] == 'n') return TokenKind::KW_RETURN;
            if (s[0] == 's' && s[1] == 't' && s[2] == 'a' && s[3] == 't' && s[4] == 'i' && s[5] == 'c') return TokenKind::KW_STATIC;
            if (s[0] == 's' && s[1] == 't' && s[2] == 'r' && s[3] == 'u' && s[4] == 'c' && s[5] == 't') return TokenKind::KW_STRUCT;
            if (s[0] == 'e' && s[1] == 'x' && s[2] == 't' && s[3] == 'e' && s[4] == 'r' && s[5] == 'n') return TokenKind::KW_EXTERN;
            if (s[0] == 'i' && s[1] == 'm' && s[2] == 'p' && s[3] == 'o' && s[4] == 'r' && s[5] == 't') return TokenKind::KW_IMPORT;
            if (s[0] == 'a' && s[1] == 's' && s[2] == 's' && s[3] == 'e' && s[4] == 'r' && s[5] == 't') return TokenKind::KW_ASSERT;
            if (s[0] == 's' && s[1] == 'i' && s[2] == 'z' && s[3] == 'e' && s[4] == 'o' && s[5] == 'f') return TokenKind::IDENT;
        }
        if (len == 7)
        {
            if (s[0] == 'e' && s[1] == 'x' && s[2] == 't' && s[3] == 'e' && s[4] == 'r' && s[5] == 'n' && s[6] == ' ') return TokenKind::IDENT;
            if (s[0] == 't' && s[1] == 'r' && s[2] == 'a' && s[3] == 'i' && s[4] == 't' && s[5] == 'e' && s[6] == 'r') return TokenKind::IDENT;
            if (s[0] == 'd' && s[1] == 'e' && s[2] == 'f' && s[3] == 'e' && s[4] == 'r' && s[5] == 'e' && s[6] == 'd') return TokenKind::IDENT;
            if (s[0] == 'v' && s[1] == 'o' && s[2] == 'l' && s[3] == 'a' && s[4] == 't' && s[5] == 'i' && s[6] == 'l') // volatile
            {
                // len would be 8, handled below
            }
        }
        if (len == 8)
        {
            if (s[0] == 'c' && s[1] == 'o' && s[2] == 'n' && s[3] == 's' && s[4] == 't' && s[5] == 'e' && s[6] == 'x' && s[7] == 'p') return TokenKind::KW_CONSTEXPR;
            if (s[0] == 'd' && s[1] == 'i' && s[2] == 's' && s[3] == 't' && s[4] == 'i' && s[5] == 'n' && s[6] == 'c' && s[7] == 't') return TokenKind::KW_DISTINCT;
            if (s[0] == 'v' && s[1] == 'o' && s[2] == 'l' && s[3] == 'a' && s[4] == 't' && s[5] == 'i' && s[6] == 'l' && s[7] == 'e') return TokenKind::KW_VOLATILE;
        }
        if (len == 5 && s[0] == 't' && s[1] == 'r' && s[2] == 'a' && s[3] == 'i' && s[4] == 't') return TokenKind::KW_TRAIT;
        return TokenKind::IDENT;
    }

    void lexNumber()
    {
        u32 start = self.pos;
        // Hex
        if (self.src[self.pos] == '0' && self.pos + 1 < self.srcLen
 && (self.src[self.pos + 1] == 'x' || self.src[self.pos + 1] == 'X'))
        {
            self.advance(); self.advance();
            while (self.pos < self.srcLen && self.isHexDig(self.src[self.pos]))
                self.advance();
        }
        else
        {
            while (self.pos < self.srcLen && (self.isDigit(self.src[self.pos]) || self.src[self.pos] == '_'))
                self.advance();
            // Fraction
            if (self.pos < self.srcLen && self.src[self.pos] == '.'
 && self.pos + 1 < self.srcLen && self.isDigit(self.src[self.pos + 1]))
            {
                self.advance(); // skip .
                while (self.pos < self.srcLen && (self.isDigit(self.src[self.pos]) || self.src[self.pos] == '_'))
                    self.advance();
            }
            // Exponent
            if (self.pos < self.srcLen && (self.src[self.pos] == 'e' || self.src[self.pos] == 'E'))
            {
                self.advance();
                if (self.pos < self.srcLen && (self.src[self.pos] == '+' || self.src[self.pos] == '-'))
                    self.advance();
                while (self.pos < self.srcLen && self.isDigit(self.src[self.pos]))
                    self.advance();
            }
        }
        // Suffix
        while (self.pos < self.srcLen && self.isAlpha(self.src[self.pos]))
            self.advance();
        self.emit(TokenKind::NUMBER, start, self.pos - start);
    }

    bool isHexDig(u8 c)
    {
        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F');
    }

    void lexString()
    {
        u32 start = self.pos;
        self.advance(); // skip opening "
        while (self.pos < self.srcLen && self.src[self.pos] != '"')
        {
            if (self.src[self.pos] == '\\') self.advance();
            self.advance();
        }
        if (self.pos < self.srcLen) self.advance(); // skip closing "
        self.emit(TokenKind::STRING, start, self.pos - start);
    }

    void lexOperator()
    {
        u32 start = self.pos;
        u8 ch = self.advance();

        switch (ch)
        {
        case '+':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::PLUS_EQ, start, 2); }
            else if (self.peek(0) == '+') { self.advance(); self.emit(TokenKind::PLUS_PLUS, start, 2); }
            else self.emit(TokenKind::PLUS, start, 1);
            break;
        case '-':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::MINUS_EQ, start, 2); }
            else if (self.peek(0) == '-') { self.advance(); self.emit(TokenKind::MINUS_MINUS, start, 2); }
            else if (self.peek(0) == '>') { self.advance(); self.emit(TokenKind::PTR_DOT, start, 2); }
            else self.emit(TokenKind::MINUS, start, 1);
            break;
        case '*':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::STAR_EQ, start, 2); }
            else if (self.peek(0) == '.') { self.advance(); self.emit(TokenKind::PTR_DOT, start, 2); }
            else self.emit(TokenKind::STAR, start, 1);
            break;
        case '/':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::SLASH_EQ, start, 2); }
            else self.emit(TokenKind::SLASH, start, 1);
            break;
        case '%':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::PERCENT_EQ, start, 2); }
            else self.emit(TokenKind::PERCENT, start, 1);
            break;
        case '&':
            if (self.peek(0) == '&') { self.advance(); self.emit(TokenKind::AMP_AMP, start, 2); }
            else if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::AMP_EQ, start, 2); }
            else self.emit(TokenKind::AMP, start, 1);
            break;
        case '|':
            if (self.peek(0) == '|') { self.advance(); self.emit(TokenKind::PIPE_PIPE, start, 2); }
            else if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::PIPE_EQ, start, 2); }
            else self.emit(TokenKind::PIPE, start, 1);
            break;
        case '^':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::CARET_EQ, start, 2); }
            else self.emit(TokenKind::CARET, start, 1);
            break;
        case '~': self.emit(TokenKind::TILDE, start, 1); break;
        case '!':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::BANG_EQ, start, 2); }
            else self.emit(TokenKind::BANG, start, 1);
            break;
        case '=':
            if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::EQ_EQ, start, 2); }
            else self.emit(TokenKind::ASSIGN, start, 1);
            break;
        case '.': self.emit(TokenKind::DOT, start, 1); break;
        case ',': self.emit(TokenKind::COMMA, start, 1); break;
        case ';': self.emit(TokenKind::SEMI, start, 1); break;
        case ':':
            if (self.peek(0) == ':') { self.advance(); self.emit(TokenKind::COLON_COLON, start, 2); }
            else self.emit(TokenKind::COLON, start, 1);
            break;
        case '(': self.emit(TokenKind::LPAREN, start, 1); break;
        case ')': self.emit(TokenKind::RPAREN, start, 1); break;
        case '{': self.emit(TokenKind::LBRACE, start, 1); break;
        case '}': self.emit(TokenKind::RBRACE, start, 1); break;
        case '[': self.emit(TokenKind::LBRACKET, start, 1); break;
        case ']': self.emit(TokenKind::RBRACKET, start, 1); break;
        case '<':
            if (self.peek(0) == '<')
            {
                self.advance();
                if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::LT_LT_EQ, start, 3); }
                else self.emit(TokenKind::LT_LT, start, 2);
            }
            else if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::LT_EQ, start, 2); }
            else self.emit(TokenKind::LT, start, 1);
            break;
        case '>':
            if (self.peek(0) == '>')
            {
                self.advance();
                if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::GT_GT_EQ, start, 3); }
                else self.emit(TokenKind::GT_GT, start, 2);
            }
            else if (self.peek(0) == '=') { self.advance(); self.emit(TokenKind::GT_EQ, start, 2); }
            else self.emit(TokenKind::GT, start, 1);
            break;
        default:
            // Unknown character — emit as-is, parser will report
            break;
        }
    }

    pub Token* tokenize(u32* outCount)
    {
        while (self.pos < self.srcLen)
        {
            self.skipWhitespace();
            if (self.pos >= self.srcLen) break;

            u8 ch = self.src[self.pos];

            if (self.isAlpha(ch)) { self.lexIdent(); continue; }
            if (self.isDigit(ch)) { self.lexNumber(); continue; }
            if (ch == '"') { self.lexString(); continue; }

            self.lexOperator();
        }
        self.emit(TokenKind::EOF, self.pos, 0);
        *outCount = self.tokenCount;
        return self.tokens;
    }
}