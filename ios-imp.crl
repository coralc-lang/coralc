mod std = import(lib, "std");

// extern i32 printf(const char* fmt, ...);



trait drop {
    void drop();
}

struct foo {
    char* str;
    usize len;

    static foo new() {
        foo s;
        s.str = std.mman.alloc<char*>();
        return s;
    }
}

foo::drop {
    void drop() {
        self.str = std.mman.dealloc<char*>();
    }
}

i32 main() {
    foo loo = foo::new();
    loo.str = "rererer";
    std.ios.nprint(std.math.pow(2, 10), " this is 2^10", loo.str);
    std.ios.nprint(10000000);
    return 0;
}