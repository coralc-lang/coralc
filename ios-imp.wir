; WallVM IR

func @main -> i32 {
  block %entry:
    %11 = sitofp f64 [2]
    %12 = sitofp f64 [10]
    %13 = call f64 [%2(pow), %11, %12]
    %15 = call void [0, %13, 0]
    %17 = call void [0, 10000000]
    %18 = ret i64 [0]
}

extern func @pow -> f64 {}

func @_fprintNewline -> void {
  block %entry:
    %20 = alloca ptr
    %22 = store void [%21(fd), %20]
    %23 = load i32 [%20]
    %26 = call i64 [%4(write), %23, 0, 1]
    %27 = ret void
}

extern func @write -> i64 {}

func @nprint_______nprint -> void {
  block %entry:
    %29 = alloca ptr
    %31 = store void [%30(args), %29]
    %32 = load i64 [%29]
    %33 = alloca ptr
    %34 = store void [0, %33]
    %35 = alloca ptr
    %39 = br void [%36(forin.head)]
  block %forin.head:
    %40 = load i64 [%33]
    %41 = icmp i1 [%40, 0]
    %42 = cond_br void [%41, %37(forin.body), %38(forin.exit)]
  block %forin.body:
    %43 = gep ptr [%32, %40]
    %44 = load i64 [%43]
    %45 = store void [%44, %35]
    %46 = load i64 [%35]
    %47 = call void [0, 1, %46]
    %48 = load i64 [%33]
    %49 = add i64 [%48, 1]
    %50 = store void [%49, %33]
    %51 = br void [%36(forin.head)]
  block %forin.exit:
    %52 = call void [%3(_fprintNewline), 1]
    %53 = ret void
}

func @nprint_____nprint -> void {
  block %entry:
    %55 = alloca ptr
    %57 = store void [%56(args), %55]
    %58 = load i64 [%55]
    %59 = alloca ptr
    %60 = store void [0, %59]
    %61 = alloca ptr
    %65 = br void [%62(forin.head)]
  block %forin.head:
    %66 = load i64 [%59]
    %67 = icmp i1 [%66, 0]
    %68 = cond_br void [%67, %63(forin.body), %64(forin.exit)]
  block %forin.body:
    %69 = gep ptr [%58, %66]
    %70 = load i64 [%69]
    %71 = store void [%70, %61]
    %72 = load i64 [%61]
    %73 = call void [0, 1, %72]
    %74 = load i64 [%59]
    %75 = add i64 [%74, 1]
    %76 = store void [%75, %59]
    %77 = br void [%62(forin.head)]
  block %forin.exit:
    %78 = call void [%3(_fprintNewline), 1]
    %79 = ret void
}

