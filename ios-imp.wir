; WallVM IR

func @pow -> f64 {
  block %entry:
    %5 = alloca ptr
    %7 = store void [%6(base), %5]
    %8 = alloca ptr
    %10 = store void [%9(exponent), %8]
    %11 = alloca ptr
    %13 = store void [1, %11]
    %14 = alloca ptr
    %16 = store void [0, %14]
    %20 = br void [%17(for.head)]
  block %for.head:
    %21 = load i32 [%14]
    %22 = load i64 [%8]
    %23 = icmp i1 [%21, %22]
    %24 = cond_br void [%23, %18(for.body), %19(for.exit)]
  block %for.body:
    %25 = load f64 [%11]
    %26 = load f64 [%5]
    %27 = fadd f64 [%25, %26]
    %28 = store void [%27, %11]
    %29 = load i32 [%14]
    %31 = add i32 [%29, 1]
    %32 = store void [%31, %14]
    %33 = br void [%17(for.head)]
  block %for.exit:
    %34 = load f64 [%11]
    %35 = ret f64 [%34]
}
extern func @printf -> i32 {}

func @main -> i32 {
  block %entry:
    %38 = sext ptr [0]
    %41 = call f64 [%1(pow), 2, 10]
    %42 = call i32 [%2(printf), %38, %41]
    %43 = ret i64 [0]
}
