; WallVM IR

func @pow -> f64 {
  block %entry:
    %5 = alloca ptr
    %7 = store void [%6(base), %5]
    %8 = alloca ptr
    %10 = store void [%9(exponent), %8]
    %11 = alloca ptr
    %13 = sitofp f64 [1]
    %14 = store void [%13, %11]
    %15 = alloca ptr
    %17 = store void [0, %15]
    %21 = br void [%18(for.head)]
  block %for.head:
    %22 = load i32 [%15]
    %23 = load i64 [%8]
    %24 = icmp i1 [%22, %23]
    %25 = cond_br void [%24, %19(for.body), %20(for.exit)]
  block %for.body:
    %26 = load f64 [%11]
    %27 = load f64 [%5]
    %28 = fadd f64 [%26, %27]
    %29 = store void [%28, %11]
    %30 = load i32 [%15]
    %32 = add i32 [%30, 1]
    %33 = store void [%32, %15]
    %34 = br void [%18(for.head)]
  block %for.exit:
    %35 = load f64 [%11]
    %36 = ret f64 [%35]
}

extern func @printf -> i32 {}

func @main -> i32 {
  block %entry:
    %41 = sitofp f64 [2]
    %42 = call f64 [%1(pow), %41, 10]
    %43 = call i32 [%2(printf), 0, %42]
    %44 = ret i64 [0]
}

