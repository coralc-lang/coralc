# example build file for the coral compiler tree
schema = 1;
strict = true;

build "coralc" {
    root       = "/home/cerie/Documents/coral/compiler";
    entry      = "coral-frontend/coralc.crl";
    target     = "x86_64";
    opt        = "debug";
    output     = "/home/cerie/Documents/coral/dist/coralc-linux";
    module_map = "/home/cerie/Documents/coral/dist/.linux.map";
    cache_dir  = "/home/cerie/Documents/coral/dist/.linux-cache";

    flags = ["--strict", "host=linux", "platform=linux"];

    modules = [
        "coral-ast",
        "coral-backend",
        "coral-build",
        "coral-common",
        "coral-context",
        "coral-diagnostics",
        "coral-frontend",
        "coral-hir",
        "coral-lexer",
        "coral-lsp",
        "coral-module",
        "coral-mono",
        "coral-parser",
        "coral-semantics",
        "coral-source",
    ];

    skip = ["vendor"];
}

# short names for imports
alias lexer   = "coral-lexer";
alias lsp     = "coral-lsp";
alias parser  = "coral-parser";
alias common  = "coral-common";
alias diag    = "coral-diagnostics";
alias ast     = "coral-ast";
alias sem     = "coral-semantics";
alias context = "coral-context";
alias build   = "coral-build";
alias backend = "coral-backend";
alias hir     = "coral-hir";
alias mono    = "coral-mono";
alias module  = "coral-module";
alias source  = "coral-source";

task "run" {
    after = ["build"];
    exec  = "build/coralc";
}
