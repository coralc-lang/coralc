module "coral"

func @crl$loc$foo$div(%a: f32, %b: f32) f32 {
entry:
    %5 = alloca f32
    store f32 %a, %5
    %8 = alloca f32
    store f32 %b, %8
    %10 = load f32 %8
    %12 = fcmp one f32 %10, 0
    cond_br %12, if.then, if.end
if.then:
    %16 = load f32 %5
    %17 = load f32 %8
    %18 = fdiv f32 %16, %17
    %19 = ret f32 %18
if.end:
    %21 = fptrunc f64 0.0 to f32
    %22 = ret f32 %21
}

func @main() {
entry:
    %24 = alloca f32
    %26 = fptrunc f64 300.3 to f32
    %28 = call f32 @crl$loc$foo$div(f32 %26, i32 1024)
    store f32 %28, %24
    %30 = load f32 %24
    %32 = call f32 @crl$loc$foo$div(f32 %30, i32 3)
    store f32 %32, %24
    ret
}
