module "larger_valid_clean"

// External declarations
func @printf(...) i32 extern

// String pool and globals
string @str_banner: "=== Starting IR Execution ===\n";
string @str_step:   "Iteration %d: value = %d\n";
string @str_result: "Final Result: %d\n";

global @g_factor: i32 = 3

// Helper function
func @compute_step(%iter: i32, %current: i32) i32 {
entry:
    %factor = load i32 @g_factor
    %product = mul i32 %current, %factor
    %fmt = gep @str_step, 0
    call @printf(%fmt, %iter, %product)
    ret i32 %product
}

// Main entry point
func @main() i32 {
entry:
    %banner = gep @str_banner, 0
    call @printf(%banner)

    %acc = alloca i32
    store i32 0, %acc

    %i = alloca i32
    store i32 1, %i
    br loop_head

loop_head:
    %curr_i = load i32 %i
    %cond = icmp sle i32 %curr_i, 4
    cond_br %cond, loop_body, loop_exit

loop_body:
    %acc_val = load i32 %acc
    %step_res = call @compute_step(%curr_i, %acc_val)
    
    %new_acc = add i32 %acc_val, %step_res
    store i32 %new_acc, %acc

    %next_i = add i32 %curr_i, 1
    store i32 %next_i, %i
    br loop_head

loop_exit:
    %final_val = load i32 %acc
    %res_ptr = gep @str_result, 0
    call @printf(%res_ptr, %final_val)

    ret i32 0
}