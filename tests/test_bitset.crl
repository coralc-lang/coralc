mod std = import(lib, "std");

i32 main() {
    std.bit.bitset b = std.bit.bitset::new(100);
    b.set(5);
    b.set(63);
    b.set(64);
    std.ios.nprint(b.test(5));
    std.ios.nprint(b.test(6));
    std.ios.nprint(b.countOnes());
    std.ios.nprint(b.all());
    std.ios.nprint(b.any());
    b.dispose();
    return 0;
}