; WallVM IR


extern func @memcpy -> void {}

func @bad1 -> void {
  block %entry:
    %12 = bitcast ptr [%9(buf)]
    %15 = add ptr [%9(buf), 1]
    %17 = call void [%1(memcpy), %12, %15, 32]
    %18 = ret void
}

func @bad2 -> i32 {
  block %entry:
    %28 = load i32 [%21(p)]
    %32 = store void [42, %21(p)]
    %34 = ret i32 [%28]
}

extern func @writeThrough -> void {}

func @bad3 -> i32 {
  block %entry:
    %44 = gep ptr [%37(arr), 0]
    %45 = load i32 [%44]
    %48 = call void [%4(writeThrough), %37(arr)]
    %50 = add i32 [%45, 1]
    %51 = ret i32 [%50]
}

func @main -> i32 {
  block %entry:
    %53 = alloca ptr
    %55 = store void [5, %53]
    %56 = call void [%2(bad1), %53]
    %57 = alloca ptr
    %58 = bitcast ptr [%53]
    %59 = call i32 [%3(bad2), %58]
    %60 = store void [%59, %57]
    %61 = alloca ptr
    %62 = call i32 [%5(bad3), %57]
    %63 = store void [%62, %61]
    %64 = call i32 [%3(bad2), %61]
    %65 = ret i64 [0]
}

