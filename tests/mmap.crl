void* _mmap(void* addr,
           u64 length,
           i32 prot,
           i32 flags,
           i32 fd,
           i64 offset)
{
    u64 ret;
    asm volatile {
        "\n\tmovq   %2, %rdi\n\t"
        "movq   %3, %rsi\n\t"
        "movq   %4, %rdx\n\t"
        "movq   %5, %r10\n\t"
        "movq   %6, %r8\n\t"
        "movq   %7, %r9\n\t"
        "syscall\n\t"
        "movq %%rax, %0"
        : "=a"(ret)
        : "0"(9u), "D"((u64)addr), "S"(length), "d"((u64)prot),
          "r"((u64)flags), "r"((u64)fd), "r"((u64)offset)
        : "rcx", "r8", "r9", "r10", "r11", "memory"
    }
    if ((i64)ret < 0 && (i64)ret >= -4095) return null;
    return (void*)ret;
}
