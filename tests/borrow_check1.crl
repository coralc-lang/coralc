extern void memcpy(void* src, void* dst, usize size);

void bad1(u64* buf)
{
    memcpy((void*)buf, (voiid*)(buf + 1), 32);
}

i32 bad2(i32* p)
{
    i32* q = p;
    i32 tmp = *q;
    *p = 42;
    return tmp;
}

void writeThrough(i32* p) { p++; };

i32 bad3(i32* arr)
{
    i32 x = arr[0];
    writeThrough(arr);
    return x + 1;
}

pub i32 main()
{
    u64 buf = 5;
    bad1(&buf);
    i32 g = bad2((i32*)&buf);
    i32 h = bad3(&g);
    bad2(&h);
    return 0;
}