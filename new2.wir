; WallVM IR
extern func printf -> i32 {
}
func @main -> i32 {
  block %entry:
    %4 = alloca ptr
    %6 = store void [45, %4]
    %7 = alloca ptr
    %9 = store void [0, %7]
    %13 = br void [%10(for.head)]
  block %for.head:
    %14 = load i32 [%7]
    %15 = load i32 [%4]
    %16 = icmp i1 [%14, %15]
    %17 = cond_br void [%16, %11(for.body), %12(for.exit)]
  block %for.body:
    %18 = load i32 [%4]
    %19 = load i32 [%7]
    %20 = add i32 [%18, %19]
    %21 = store void [%20, %4]
    %22 = load i32 [%7]
    %24 = add i32 [%22, 1]
    %25 = store void [%24, %7]
    %26 = br void [%10(for.head)]
  block %for.exit:
    %28 = load i32 [%4]
    %29 = call i32 [%1(printf), 0, %28]
    %30 = ret i64 [0]
}
